(define (domain repo-closure-hddl)
  (:requirements :hierarchy :typing)
  (:types
    repository chore outcome - object
  )

  (:predicates
    (clean-worktree ?r - repository)
    (code-generated ?r - repository)
    (compiled ?r - repository)
    (inspected ?r - repository)
    (receipted ?r - repository)
  )

  ;; Compound Task: complete repository closure
  (:task ensure_repo_closure
    :parameters (?r - repository)
  )

  ;; Method: Standard closure pipeline
  (:method m_standard_closure
    :task (ensure_repo_closure ?r)
    :subtasks (and
      (task_regenerate ?r)
      (task_compile ?r)
      (task_inspect ?r)
      (task_emit_receipt ?r)
    )
  )

  ;; Primitive actions
  (:action task_regenerate
    :parameters (?r - repository)
    :precondition ()
    :effect (code-generated ?r)
  )

  (:action task_compile
    :parameters (?r - repository)
    :precondition (code-generated ?r)
    :effect (compiled ?r)
  )

  (:action task_inspect
    :parameters (?r - repository)
    :precondition (compiled ?r)
    :effect (inspected ?r)
  )

  (:action task_emit_receipt
    :parameters (?r - repository)
    :precondition (and (compiled ?r) (inspected ?r))
    :effect (receipted ?r)
  )
)
