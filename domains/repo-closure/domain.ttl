@prefix rc:    <https://ggen.dev/domains/repo-closure#> .
@prefix fhmxl: <https://ggen.dev/patterns/fond-hddl-mx-loop#> .
@prefix pp:    <https://ggen.dev/ontology/planning-policy#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .

<https://ggen.dev/domains/repo-closure#v26.9.13> a rc:ClosureDomain ;
    dct:identifier "repo-closure@v26.9.13" ;
    rdfs:label "Repository Closure Domain Instantiation" ;
    rc:calVer "v26.9.13" ;
    fhmxl:conformsTo <https://ggen.dev/patterns/fond-hddl-mx-loop#v26.9.13> ;
    dct:description "First domain instantiation of the fond-hddl-mx-loop pattern, governing repository closure chores: regeneration, compilation, package inspection, test verification, and receipting." .

# ===== DOMAIN CHORE CLASSES =====
rc:ClosureDomain a rdfs:Class .
rc:ChoreTask a rdfs:Class ; rdfs:subClassOf pp:CompoundTask .

rc:RegenerateChore a rdfs:Class ; rdfs:subClassOf rc:ChoreTask ; rdfs:label "Regenerate code from ontology" .
rc:CompileChore a rdfs:Class ; rdfs:subClassOf rc:ChoreTask ; rdfs:label "Compile source and check warnings" .
rc:PackageInspectChore a rdfs:Class ; rdfs:subClassOf rc:ChoreTask ; rdfs:label "Inspect package artifacts" .
rc:TestVerifyChore a rdfs:Class ; rdfs:subClassOf rc:ChoreTask ; rdfs:label "Run test suite" .
rc:DocVerifyChore a rdfs:Class ; rdfs:subClassOf rc:ChoreTask ; rdfs:label "Verify Diataxis documentation" .
rc:ReceiptEmitChore a rdfs:Class ; rdfs:subClassOf rc:ChoreTask ; rdfs:label "Emit verifiable execution receipt" .

rc:calVer a rdf:Property ; rdfs:range xsd:string .
