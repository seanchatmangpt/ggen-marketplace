<https://seanchatmangpt.github.io/ggen-marketplace/> a mdp:Book, prov:Entity ;
    dcterms:title "ggen Marketplace" ;
    dcterms:description "An executable research monograph and operational reference for ontology-first deterministic software manufacture, Level-5 pack maturity, Diátaxis closure, reusable ggen packs, exact-subject qualification, receipts, replay, standing, class closure, composition, and bounded authority." ;
    dcterms:creator "ggen Marketplace contributors" ;
    dcterms:language "en" ;
    mdp:srcDir "docs" ;
    mdp:buildDir "book" ;
    mdp:repositoryUrl "https://github.com/seanchatmangpt/ggen-marketplace" ;
    prov:wasDerivedFrom mdp:PatternLanguage .

