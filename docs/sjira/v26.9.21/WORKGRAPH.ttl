@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix wd: <urn:seanchatmangpt:wd-fa:v26.9.21:> .

# Canonical sJira shape (v26.9.22 fold, GGMKT-26922-07).
#
# This graph previously declared its own provisional work-item vocabulary and
# was refused as hand-written parallel vocabulary. It is now folded into the
# canonical semantic-jira-pack shape (ggen_igniter's priv/ggen/semantic-jira-pack,
# prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#>): every work
# item is an sj:WorkOrder with sj:standing/sj:repository/sj:acceptance.
# Graph-local documentation properties that have no canonical counterpart
# (wd:disposition, wd:reusesPack, wd:targetArtifact) remain, declared here
# and used only by this graph; they never shadow sj: properties.
# Epics and the milestone are groupings, not work orders: prov:Activity.



wd:Milestone a prov:Activity ;
  dcterms:title "WD Semantic Failure Analysis — v26.9.21" ;
  sj:standing "CANDIDATE" ;
  sj:authorityCeiling "OBSERVE|SELECT|CONSTRUCT|VERIFY" ;
  sj:evidenceCeiling "Work graph only; no runtime, live Jira, production SA2A, deployment, merge, or DO standing." ;
  prov:wasDerivedFrom <https://github.com/seanchatmangpt/ggen-marketplace/commit/616e93d1e6f9566e4b5eb4e2c3d1400746786e50> .

wd:Epic-Semantics a prov:Activity ;
  dcterms:title "Canonical semantics and domain overlay" ;
  sj:standing "CANDIDATE" .

wd:Epic-Projections a prov:Activity ;
  dcterms:title "Generated Python/API/Next.js projections" ;
  sj:standing "CANDIDATE" .

wd:Epic-Process a prov:Activity ;
  dcterms:title "OCEL, PM4Py, POWL, TPOT, and AutoFDE analytical spine" ;
  sj:standing "CANDIDATE" .

wd:Epic-Protocol a prov:Activity ;
  dcterms:title "sJira and SA2A protocol surfaces" ;
  sj:standing "CANDIDATE" .

wd:Epic-Evidence a prov:Activity ;
  dcterms:title "Verification, receipts, replay, and MachineExperience" ;
  sj:standing "CANDIDATE" .

wd:Epic-Demo a prov:Activity ;
  dcterms:title "Synthetic four-case demonstration" ;
  sj:standing "CANDIDATE" .

wd:SJIRA-WDFA-001 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-001" ;
  dcterms:title "Compose canonical marketplace platform packs" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "COMPOSE" ;
  sj:repository "seanchatmangpt/ggen-marketplace" ;
  wd:reusesPack "ggen-platform-pack" , "process-intelligence-pack" , "protocol-integration-pack" ,
    "semantic-projection-pack" , "evidence-standing-pack" , "planning-policy-pack" ,
    "decision-optionality-pack" , "experience-projection-pack" , "state-transition-pack" ,
    "repository-lifecycle-pack" ;
  sj:acceptance "Consumer graph composes existing capability semantics without redefining them." .

wd:SJIRA-WDFA-002 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-002" ;
  dcterms:title "Admit public ontology and source inventory" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "EXTEND" ;
  sj:repository "seanchatmangpt/ggen-marketplace" ;
  wd:reusesPack "autofde-semantic-registry-pack" ;
  sj:dependsOn wd:SJIRA-WDFA-001 ;
  sj:acceptance "Every reused external ontology has canonical location, version/license observation, retrieval identity, digest, projection identity, and independent validation state." .

wd:SJIRA-WDFA-003 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-003" ;
  dcterms:title "Create wd-failure-analysis-pack domain overlay" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "BUILD" ;
  sj:repository "seanchatmangpt/ggen-marketplace" ;
  sj:dependsOn wd:SJIRA-WDFA-002 ;
  wd:targetArtifact "packs/wd-failure-analysis-pack/" ;
  sj:acceptance "Defines only irreducible WD FA terms after public-ontology alignment; includes applicability, exclusions, falsifiers, evidence links, and WorkOrder subjects." .

wd:SJIRA-WDFA-004 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-004" ;
  dcterms:title "Define SHACL shapes for WD FA semantic state" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "BUILD" ;
  sj:repository "seanchatmangpt/ggen-marketplace" ;
  sj:dependsOn wd:SJIRA-WDFA-003 ;
  wd:reusesPack "shacl-projection-pack" ;
  sj:acceptance "Shapes fail closed on missing identifiers, invalid standing transitions, absent falsifiers/evidence requirements where required, and authority contradictions." .

wd:SJIRA-WDFA-005 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-005" ;
  dcterms:title "Generate Pydantic models from SHACL" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "REUSE" ;
  sj:repository "seanchatmangpt/ggen-marketplace" ;
  sj:dependsOn wd:SJIRA-WDFA-004 ;
  wd:reusesPack "shacl-projection-pack" , "shacl-to-pydantic-pack" ;
  sj:acceptance "Generated Pydantic fields are a deterministic projection of admitted SHACL shapes." .

wd:SJIRA-WDFA-006 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-006" ;
  dcterms:title "Manufacture shacl-to-fastapi-pack" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "BUILD" ;
  sj:repository "seanchatmangpt/ggen-marketplace" ;
  sj:dependsOn wd:SJIRA-WDFA-005 ;
  wd:targetArtifact "packs/shacl-to-fastapi-pack/" ;
  sj:acceptance "Generates FastAPI router/request/response contracts from admitted shapes/Pydantic models; no independent domain schema." .

wd:SJIRA-WDFA-007 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-007" ;
  dcterms:title "Manufacture shacl-to-zod-jsdoc-pack" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "BUILD" ;
  sj:repository "seanchatmangpt/ggen-marketplace" ;
  sj:dependsOn wd:SJIRA-WDFA-004 ;
  wd:targetArtifact "packs/shacl-to-zod-jsdoc-pack/" ;
  sj:acceptance "Generates JavaScript Zod schemas and JSDoc typedefs without TypeScript and without duplicating canonical field definitions." .

wd:SJIRA-WDFA-008 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-008" ;
  dcterms:title "Manufacture sa2a-fastapi-pack" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "BUILD" ;
  sj:repository "seanchatmangpt/ggen-marketplace" ;
  sj:dependsOn wd:SJIRA-WDFA-001 , wd:SJIRA-WDFA-006 ;
  wd:reusesPack "protocol-integration-pack" ;
  wd:targetArtifact "packs/sa2a-fastapi-pack/" ;
  sj:acceptance "Projects existing capability semantics into Python/FastAPI SA2A envelopes; consequential capabilities default to requiring authority." .

wd:SJIRA-WDFA-009 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-009" ;
  dcterms:title "Manufacture HDD OCEL 2.0 projection" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "EXTEND" ;
  sj:repository "seanchatmangpt/ggen-marketplace" ;
  sj:dependsOn wd:SJIRA-WDFA-003 ;
  wd:reusesPack "process-intelligence-pack" , "ggen-ecosystem-ocel-pack" ;
  sj:acceptance "Synthetic HDD object/event graph round-trips with exact identities and multi-object event relations." .

wd:SJIRA-WDFA-010 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-010" ;
  dcterms:title "Integrate PM4Py process analysis" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "DOWNSTREAM" ;
  sj:repository "seanchatmangpt/autofde-lab" ;
  sj:dependsOn wd:SJIRA-WDFA-009 ;
  sj:acceptance "PM4Py consumes the reconstructed OCEL evidence and emits identified process/conformance features, not a parallel hand-authored truth source." .

wd:SJIRA-WDFA-011 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-011" ;
  dcterms:title "Integrate POWL v2 process representation" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "DOWNSTREAM" ;
  sj:repository "seanchatmangpt/autofde-lab" ;
  sj:dependsOn wd:SJIRA-WDFA-010 ;
  wd:reusesPack "ontostar-mustar-powlv2-agent-pack" ;
  sj:acceptance "POWL is used as process/workflow semantics; no POWL plan gains execution authority." .

wd:SJIRA-WDFA-012 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-012" ;
  dcterms:title "Integrate TPOT candidate-model search" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "DOWNSTREAM" ;
  sj:repository "seanchatmangpt/autofde-lab" ;
  sj:dependsOn wd:SJIRA-WDFA-010 ;
  sj:acceptance "TPOT searches deterministic admitted features and returns CANDIDATE_MODEL only; false-known rate is measured separately." .

wd:SJIRA-WDFA-013 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-013" ;
  dcterms:title "Integrate AutoFDE hypothesis and discriminating experiment selection" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "DOWNSTREAM" ;
  sj:repository "seanchatmangpt/autofde-lab" ;
  sj:dependsOn wd:SJIRA-WDFA-011 , wd:SJIRA-WDFA-012 ;
  wd:reusesPack "planning-policy-pack" , "decision-optionality-pack" ;
  sj:acceptance "Remaining hypotheses are explicit; next action is SELECT only and is chosen under evidence/cost/authority constraints." .

wd:SJIRA-WDFA-014 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-014" ;
  dcterms:title "Build sJira semantic WorkOrder projection" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "BUILD" ;
  sj:repository "cross-repo consumer" ;
  sj:dependsOn wd:SJIRA-WDFA-003 , wd:SJIRA-WDFA-005 , wd:SJIRA-WDFA-013 ;
  wd:reusesPack "semantic-projection-pack" , "state-transition-pack" ;
  sj:acceptance "WorkOrder binds exact subject, observations, hypotheses, evidence, exclusions, falsifiers, next actions, authority requirements, acceptance predicates, and standing." .

wd:SJIRA-WDFA-015 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-015" ;
  dcterms:title "Build Next.js FA workbench in JavaScript/JSDoc/Zod" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "DOWNSTREAM" ;
  sj:repository "consumer application" ;
  sj:dependsOn wd:SJIRA-WDFA-006 , wd:SJIRA-WDFA-007 , wd:SJIRA-WDFA-014 ;
  wd:reusesPack "nextjs-ai-sdk-pack (reference only)" , "nextjs-ai-sdk-ui-shadcn-pack (reference only)" ;
  sj:acceptance "Frontend renders/query commands only; standing/admission logic remains behind FastAPI/sJira." .

wd:SJIRA-WDFA-016 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-016" ;
  dcterms:title "Bind receipts, provenance, and replay" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "COMPOSE" ;
  sj:repository "cross-repo" ;
  sj:dependsOn wd:SJIRA-WDFA-014 ;
  wd:reusesPack "evidence-standing-pack" , "receipt-provenance-unification-pack" , "state-transition-pack" ;
  sj:acceptance "Verified disposition binds subject/evidence/action/authority/consequence/verifier identities and can be replay-checked." .

wd:SJIRA-WDFA-017 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-017" ;
  dcterms:title "Add known/partial/unknown witness court" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "COMPOSE" ;
  sj:repository "seanchatmangpt/ggen-marketplace + seanchatmangpt/autofde-lab" ;
  sj:dependsOn wd:SJIRA-WDFA-013 , wd:SJIRA-WDFA-016 ;
  wd:reusesPack "semantic-gate-witness-court-pack" , "autofde-lab-standing-vocabulary-pack" ;
  sj:acceptance "Known A, misleading Known B, incomplete evidence, Novel X, tampered evidence, and self-certification fixtures all produce expected standing/refusal." .

wd:SJIRA-WDFA-018 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-018" ;
  dcterms:title "Add evidence-lineage independence court" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "REUSE" ;
  sj:repository "cross-repo" ;
  sj:dependsOn wd:SJIRA-WDFA-016 ;
  wd:reusesPack "evidence-lineage-independence-pack" ;
  sj:acceptance "Independent verifier evidence is not merely a restatement of the producer lineage." .

wd:SJIRA-WDFA-019 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-019" ;
  dcterms:title "Close UNKNOWN to MachineExperience to KNOWN replay loop" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "BUILD" ;
  sj:repository "cross-repo" ;
  sj:dependsOn wd:SJIRA-WDFA-017 , wd:SJIRA-WDFA-018 ;
  wd:reusesPack "experience-projection-pack" ;
  sj:acceptance "A verified novel Episode N becomes reusable MachineExperience; equivalent Episode N+1 requires less exploratory reasoning and lawfully reaches KNOWN." .

wd:SJIRA-WDFA-020 a sj:WorkOrder ;
  dcterms:identifier "SJIRA-WDFA-020" ;
  dcterms:title "Demonstrate four-case synthetic FA court end to end" ;
  sj:standing "CANDIDATE" ;
  wd:disposition "BUILD" ;
  sj:repository "cross-repo" ;
  sj:dependsOn wd:SJIRA-WDFA-008 , wd:SJIRA-WDFA-015 , wd:SJIRA-WDFA-019 ;
  sj:acceptance "One bounded demo emits OCEL/process/model/planner/WorkOrder/verifier/receipt/replay identities while preserving zero production actuation." .
