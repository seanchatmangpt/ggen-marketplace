@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sjira: <urn:seanchatmangpt:sjira:> .
@prefix wd: <urn:seanchatmangpt:wd-fa:v26.9.21:> .

# Provisional documentation vocabulary for this work graph.
# It is not asserted to be the canonical production sJira ontology.

sjira:WorkItem a rdfs:Class .
sjira:Epic a rdfs:Class ; rdfs:subClassOf sjira:WorkItem .
sjira:Milestone a rdfs:Class .
sjira:status a rdf:Property .
sjira:disposition a rdf:Property .
sjira:ownerRepo a rdf:Property .
sjira:dependsOn a rdf:Property .
sjira:reusesPack a rdf:Property .
sjira:targetArtifact a rdf:Property .
sjira:acceptance a rdf:Property .
sjira:authorityCeiling a rdf:Property .
sjira:evidenceCeiling a rdf:Property .

sjira:CANDIDATE a skos:Concept .
sjira:REUSE a skos:Concept .
sjira:COMPOSE a skos:Concept .
sjira:EXTEND a skos:Concept .
sjira:BUILD a skos:Concept .
sjira:DOWNSTREAM a skos:Concept .
sjira:DEFER a skos:Concept .

wd:Milestone a sjira:Milestone ;
  dcterms:title "WD Semantic Failure Analysis — v26.9.21" ;
  sjira:status sjira:CANDIDATE ;
  sjira:authorityCeiling "OBSERVE|SELECT|CONSTRUCT|VERIFY" ;
  sjira:evidenceCeiling "Work graph only; no runtime, live Jira, production SA2A, deployment, merge, or DO standing." ;
  prov:wasDerivedFrom <https://github.com/seanchatmangpt/ggen-marketplace/commit/616e93d1e6f9566e4b5eb4e2c3d1400746786e50> .

wd:Epic-Semantics a sjira:Epic ;
  dcterms:title "Canonical semantics and domain overlay" ;
  sjira:status sjira:CANDIDATE .

wd:Epic-Projections a sjira:Epic ;
  dcterms:title "Generated Python/API/Next.js projections" ;
  sjira:status sjira:CANDIDATE .

wd:Epic-Process a sjira:Epic ;
  dcterms:title "OCEL, PM4Py, POWL, TPOT, and AutoFDE analytical spine" ;
  sjira:status sjira:CANDIDATE .

wd:Epic-Protocol a sjira:Epic ;
  dcterms:title "sJira and SA2A protocol surfaces" ;
  sjira:status sjira:CANDIDATE .

wd:Epic-Evidence a sjira:Epic ;
  dcterms:title "Verification, receipts, replay, and MachineExperience" ;
  sjira:status sjira:CANDIDATE .

wd:Epic-Demo a sjira:Epic ;
  dcterms:title "Synthetic four-case demonstration" ;
  sjira:status sjira:CANDIDATE .

wd:SJIRA-WDFA-001 a sjira:WorkItem ;
  dcterms:title "Compose canonical marketplace platform packs" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:COMPOSE ;
  sjira:ownerRepo "seanchatmangpt/ggen-marketplace" ;
  sjira:reusesPack "ggen-platform-pack" , "process-intelligence-pack" , "protocol-integration-pack" ,
    "semantic-projection-pack" , "evidence-standing-pack" , "planning-policy-pack" ,
    "decision-optionality-pack" , "experience-projection-pack" , "state-transition-pack" ,
    "repository-lifecycle-pack" ;
  sjira:acceptance "Consumer graph composes existing capability semantics without redefining them." .

wd:SJIRA-WDFA-002 a sjira:WorkItem ;
  dcterms:title "Admit public ontology and source inventory" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:EXTEND ;
  sjira:ownerRepo "seanchatmangpt/ggen-marketplace" ;
  sjira:reusesPack "autofde-semantic-registry-pack" ;
  sjira:dependsOn wd:SJIRA-WDFA-001 ;
  sjira:acceptance "Every reused external ontology has canonical location, version/license observation, retrieval identity, digest, projection identity, and independent validation state." .

wd:SJIRA-WDFA-003 a sjira:WorkItem ;
  dcterms:title "Create wd-failure-analysis-pack domain overlay" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:BUILD ;
  sjira:ownerRepo "seanchatmangpt/ggen-marketplace" ;
  sjira:dependsOn wd:SJIRA-WDFA-002 ;
  sjira:targetArtifact "packs/wd-failure-analysis-pack/" ;
  sjira:acceptance "Defines only irreducible WD FA terms after public-ontology alignment; includes applicability, exclusions, falsifiers, evidence links, and WorkOrder subjects." .

wd:SJIRA-WDFA-004 a sjira:WorkItem ;
  dcterms:title "Define SHACL shapes for WD FA semantic state" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:BUILD ;
  sjira:ownerRepo "seanchatmangpt/ggen-marketplace" ;
  sjira:dependsOn wd:SJIRA-WDFA-003 ;
  sjira:reusesPack "shacl-projection-pack" ;
  sjira:acceptance "Shapes fail closed on missing identifiers, invalid standing transitions, absent falsifiers/evidence requirements where required, and authority contradictions." .

wd:SJIRA-WDFA-005 a sjira:WorkItem ;
  dcterms:title "Generate Pydantic models from SHACL" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:REUSE ;
  sjira:ownerRepo "seanchatmangpt/ggen-marketplace" ;
  sjira:dependsOn wd:SJIRA-WDFA-004 ;
  sjira:reusesPack "shacl-projection-pack" , "shacl-to-pydantic-pack" ;
  sjira:acceptance "Generated Pydantic fields are a deterministic projection of admitted SHACL shapes." .

wd:SJIRA-WDFA-006 a sjira:WorkItem ;
  dcterms:title "Manufacture shacl-to-fastapi-pack" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:BUILD ;
  sjira:ownerRepo "seanchatmangpt/ggen-marketplace" ;
  sjira:dependsOn wd:SJIRA-WDFA-005 ;
  sjira:targetArtifact "packs/shacl-to-fastapi-pack/" ;
  sjira:acceptance "Generates FastAPI router/request/response contracts from admitted shapes/Pydantic models; no independent domain schema." .

wd:SJIRA-WDFA-007 a sjira:WorkItem ;
  dcterms:title "Manufacture shacl-to-zod-jsdoc-pack" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:BUILD ;
  sjira:ownerRepo "seanchatmangpt/ggen-marketplace" ;
  sjira:dependsOn wd:SJIRA-WDFA-004 ;
  sjira:targetArtifact "packs/shacl-to-zod-jsdoc-pack/" ;
  sjira:acceptance "Generates JavaScript Zod schemas and JSDoc typedefs without TypeScript and without duplicating canonical field definitions." .

wd:SJIRA-WDFA-008 a sjira:WorkItem ;
  dcterms:title "Manufacture sa2a-fastapi-pack" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:BUILD ;
  sjira:ownerRepo "seanchatmangpt/ggen-marketplace" ;
  sjira:dependsOn wd:SJIRA-WDFA-001 , wd:SJIRA-WDFA-006 ;
  sjira:reusesPack "protocol-integration-pack" ;
  sjira:targetArtifact "packs/sa2a-fastapi-pack/" ;
  sjira:acceptance "Projects existing capability semantics into Python/FastAPI SA2A envelopes; consequential capabilities default to requiring authority." .

wd:SJIRA-WDFA-009 a sjira:WorkItem ;
  dcterms:title "Manufacture HDD OCEL 2.0 projection" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:EXTEND ;
  sjira:ownerRepo "seanchatmangpt/ggen-marketplace" ;
  sjira:dependsOn wd:SJIRA-WDFA-003 ;
  sjira:reusesPack "process-intelligence-pack" , "ggen-ecosystem-ocel-pack" ;
  sjira:acceptance "Synthetic HDD object/event graph round-trips with exact identities and multi-object event relations." .

wd:SJIRA-WDFA-010 a sjira:WorkItem ;
  dcterms:title "Integrate PM4Py process analysis" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:DOWNSTREAM ;
  sjira:ownerRepo "seanchatmangpt/autofde-lab" ;
  sjira:dependsOn wd:SJIRA-WDFA-009 ;
  sjira:acceptance "PM4Py consumes the reconstructed OCEL evidence and emits identified process/conformance features, not a parallel hand-authored truth source." .

wd:SJIRA-WDFA-011 a sjira:WorkItem ;
  dcterms:title "Integrate POWL v2 process representation" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:DOWNSTREAM ;
  sjira:ownerRepo "seanchatmangpt/autofde-lab" ;
  sjira:dependsOn wd:SJIRA-WDFA-010 ;
  sjira:reusesPack "ontostar-mustar-powlv2-agent-pack" ;
  sjira:acceptance "POWL is used as process/workflow semantics; no POWL plan gains execution authority." .

wd:SJIRA-WDFA-012 a sjira:WorkItem ;
  dcterms:title "Integrate TPOT candidate-model search" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:DOWNSTREAM ;
  sjira:ownerRepo "seanchatmangpt/autofde-lab" ;
  sjira:dependsOn wd:SJIRA-WDFA-010 ;
  sjira:acceptance "TPOT searches deterministic admitted features and returns CANDIDATE_MODEL only; false-known rate is measured separately." .

wd:SJIRA-WDFA-013 a sjira:WorkItem ;
  dcterms:title "Integrate AutoFDE hypothesis and discriminating experiment selection" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:DOWNSTREAM ;
  sjira:ownerRepo "seanchatmangpt/autofde-lab" ;
  sjira:dependsOn wd:SJIRA-WDFA-011 , wd:SJIRA-WDFA-012 ;
  sjira:reusesPack "planning-policy-pack" , "decision-optionality-pack" ;
  sjira:acceptance "Remaining hypotheses are explicit; next action is SELECT only and is chosen under evidence/cost/authority constraints." .

wd:SJIRA-WDFA-014 a sjira:WorkItem ;
  dcterms:title "Build sJira semantic WorkOrder projection" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:BUILD ;
  sjira:ownerRepo "cross-repo consumer" ;
  sjira:dependsOn wd:SJIRA-WDFA-003 , wd:SJIRA-WDFA-005 , wd:SJIRA-WDFA-013 ;
  sjira:reusesPack "semantic-projection-pack" , "state-transition-pack" ;
  sjira:acceptance "WorkOrder binds exact subject, observations, hypotheses, evidence, exclusions, falsifiers, next actions, authority requirements, acceptance predicates, and standing." .

wd:SJIRA-WDFA-015 a sjira:WorkItem ;
  dcterms:title "Build Next.js FA workbench in JavaScript/JSDoc/Zod" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:DOWNSTREAM ;
  sjira:ownerRepo "consumer application" ;
  sjira:dependsOn wd:SJIRA-WDFA-006 , wd:SJIRA-WDFA-007 , wd:SJIRA-WDFA-014 ;
  sjira:reusesPack "nextjs-ai-sdk-pack (reference only)" , "nextjs-ai-sdk-ui-shadcn-pack (reference only)" ;
  sjira:acceptance "Frontend renders/query commands only; standing/admission logic remains behind FastAPI/sJira." .

wd:SJIRA-WDFA-016 a sjira:WorkItem ;
  dcterms:title "Bind receipts, provenance, and replay" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:COMPOSE ;
  sjira:ownerRepo "cross-repo" ;
  sjira:dependsOn wd:SJIRA-WDFA-014 ;
  sjira:reusesPack "evidence-standing-pack" , "receipt-provenance-unification-pack" , "state-transition-pack" ;
  sjira:acceptance "Verified disposition binds subject/evidence/action/authority/consequence/verifier identities and can be replay-checked." .

wd:SJIRA-WDFA-017 a sjira:WorkItem ;
  dcterms:title "Add known/partial/unknown witness court" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:COMPOSE ;
  sjira:ownerRepo "seanchatmangpt/ggen-marketplace + seanchatmangpt/autofde-lab" ;
  sjira:dependsOn wd:SJIRA-WDFA-013 , wd:SJIRA-WDFA-016 ;
  sjira:reusesPack "semantic-gate-witness-court-pack" , "autofde-lab-standing-vocabulary-pack" ;
  sjira:acceptance "Known A, misleading Known B, incomplete evidence, Novel X, tampered evidence, and self-certification fixtures all produce expected standing/refusal." .

wd:SJIRA-WDFA-018 a sjira:WorkItem ;
  dcterms:title "Add evidence-lineage independence court" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:REUSE ;
  sjira:ownerRepo "cross-repo" ;
  sjira:dependsOn wd:SJIRA-WDFA-016 ;
  sjira:reusesPack "evidence-lineage-independence-pack" ;
  sjira:acceptance "Independent verifier evidence is not merely a restatement of the producer lineage." .

wd:SJIRA-WDFA-019 a sjira:WorkItem ;
  dcterms:title "Close UNKNOWN to MachineExperience to KNOWN replay loop" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:BUILD ;
  sjira:ownerRepo "cross-repo" ;
  sjira:dependsOn wd:SJIRA-WDFA-017 , wd:SJIRA-WDFA-018 ;
  sjira:reusesPack "experience-projection-pack" ;
  sjira:acceptance "A verified novel Episode N becomes reusable MachineExperience; equivalent Episode N+1 requires less exploratory reasoning and lawfully reaches KNOWN." .

wd:SJIRA-WDFA-020 a sjira:WorkItem ;
  dcterms:title "Demonstrate four-case synthetic FA court end to end" ;
  sjira:status sjira:CANDIDATE ;
  sjira:disposition sjira:BUILD ;
  sjira:ownerRepo "cross-repo" ;
  sjira:dependsOn wd:SJIRA-WDFA-008 , wd:SJIRA-WDFA-015 , wd:SJIRA-WDFA-019 ;
  sjira:acceptance "One bounded demo emits OCEL/process/model/planner/WorkOrder/verifier/receipt/replay identities while preserving zero production actuation." .
