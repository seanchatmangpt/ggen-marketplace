@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sjira: <urn:seanchatmangpt:sjira:> .
@prefix closure: <urn:seanchatmangpt:ecosystem-closure:v26.9.21:> .

# Canonical closure ledger for work discussed on 2026-09-21.
# Status is checkpoint-scoped. ALIVE never implies merge/release/deployment/runtime
# unless that consequence is named explicitly by the checkpoint.

sjira:ClosureWorkItem a rdf:Class .
sjira:repository a rdf:Property .
sjira:pullRequest a rdf:Property .
sjira:headSha a rdf:Property .
sjira:checkpoint a rdf:Property .
sjira:standing a rdf:Property .
sjira:evidenceRun a rdf:Property .
sjira:evidenceNote a rdf:Property .
sjira:dependsOn a rdf:Property .
sjira:authorityCeiling a rdf:Property .
sjira:evidenceCeiling a rdf:Property .
sjira:workOrderIri a rdf:Property .
sjira:checkpointIri a rdf:Property .
sjira:graphDigest a rdf:Property .
sjira:repositoryIdentity a rdf:Property .
sjira:baseSha a rdf:Property .
sjira:transportInvariant a rdf:Property .

closure:Milestone a sjira:ClosureWorkItem ;
  dcterms:title "2026-09-21 ecosystem closure" ;
  sjira:standing "PARTIAL_ALIVE" ;
  sjira:authorityCeiling "OBSERVE|SELECT|CONSTRUCT|VERIFY" ;
  sjira:evidenceCeiling "No merge, publication, deployment, live Jira SaaS mutation, or production consequence is admitted by this graph." ;
  sjira:transportInvariant "work_order_iri + checkpoint_iri + graph_digest + repository_identity + base_sha must survive sJira -> SA2A -> XaaS -> zcode -> receipt unchanged." .

