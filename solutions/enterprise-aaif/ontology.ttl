@prefix aaif:  <https://aaif.io/ontology#> .
@prefix aaift: <https://aaif.io/profile-tailoring#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Consumer facts for the enterprise-aaif solution. This graph satisfies the
# union of the aaif-vanilla-pack and aaif-profile-tailoring-pack contracts.
#
# The enum individuals below are declared LOCALLY so this standalone graph is
# closed; the pack ontology
# (packs/aaif-profile-tailoring-pack/ontology.ttl) is AUTHORITATIVE and any
# divergence is a defect in this file, not in the pack.

# --- Agent (aaif-vanilla-pack contract) -------------------------------------

aaif:EnterpriseAaifAgent a aaif:Agent ;
    aaif:name "Enterprise AAIF Agent" ;
    aaif:description "Fortune 5 enterprise agent delivered via the AAIF solution: zero-trust identity, CMEK, FinOps guardrails, SIEM egress, and post-quantum affidavit sealing." ;
    aaif:url "https://agent.enterprise-aaif.example.com" ;
    aaif:version "1.0.0" ;
    aaif:hasSecurityScheme aaif:EnterpriseAaifBearerAuth ;
    aaif:hasSkill aaif:EnterpriseAaifSkill ;
    aaif:enforcesOwnerScoping true ;
    aaif:enforcesContextIsolation true ;
    aaif:stripsInternalKeys true ;
    aaif:jwsCardSigning true .

aaif:EnterpriseAaifBearerAuth a aaif:BearerAuthScheme ;
    aaif:schemeName "bearer_auth" ;
    aaif:authType "Bearer" .

aaif:EnterpriseAaifSkill a aaif:Skill ;
    aaif:skillId "enterprise_task_execution" ;
    aaif:skillName "Enterprise Task Execution" ;
    aaif:skillDescription "Execute enterprise support and task workflows under AAIF compliance gates." ;
    aaif:skillTag "enterprise" ;
    aaif:skillAttestationDigest "sha256:enterprise-aaif-skill-v1" .

# --- Deployment profile (aaif-profile-tailoring-pack contract) ---------------

aaift:EnterpriseAaifProfile a aaift:DeploymentProfile ;
    aaift:namespace "enterprise-aaif" ;
    aaift:replicas 3 ;
    aaift:cmekProvider aaift:GCP_CMEK ;
    aaift:finopsTier aaift:HARDENED ;
    aaift:siemMode aaift:SPLUNK_HEC ;
    aaift:spiffeTrustDomain "enterprise-aaif.example.com" ;
    aaift:pqcSuite aaift:HYBRID_ES256_ML_DSA_65 .

# --- Local enum individuals (pack ontology is authoritative) -----------------

aaift:CmekProvider a owl:Class ;
    rdfs:label "CmekProvider" .

aaift:GCP_CMEK a aaift:CmekProvider ;
    rdfs:label "GCP_CMEK" .

aaift:FinopsTier a owl:Class ;
    rdfs:label "FinopsTier" .

aaift:BASIC a aaift:FinopsTier ;
    rdfs:label "BASIC" .

aaift:STANDARD a aaift:FinopsTier ;
    rdfs:label "STANDARD" .

aaift:HARDENED a aaift:FinopsTier ;
    rdfs:label "HARDENED" .

aaift:SiemMode a owl:Class ;
    rdfs:label "SiemMode" .

aaift:SPLUNK_HEC a aaift:SiemMode ;
    rdfs:label "SPLUNK_HEC" .

aaift:CHRONICLE a aaift:SiemMode ;
    rdfs:label "CHRONICLE" .

aaift:PqcSuite a owl:Class ;
    rdfs:label "PqcSuite" .

aaift:ML_DSA_65 a aaift:PqcSuite ;
    rdfs:label "ML-DSA-65" .

aaift:HYBRID_ES256_ML_DSA_65 a aaift:PqcSuite ;
    rdfs:label "HYBRID-ES256-ML-DSA-65" .
