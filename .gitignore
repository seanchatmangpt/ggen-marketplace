# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# scripts/marketplace.py archive: built pack .tar.gz output, reproducible
# from packs/ on demand (see docs/reference/catalog-command.md).
/dist/

# Python bytecode cache -- untracked noise every scripts/*.py invocation
# leaves behind (validate/catalog/fingerprint/qualify_packs.py), confirmed
# unversioned before this entry via `git status --porcelain` after a real
# local run.
__pycache__/
*.pyc

# ggen local signing keys -- never commit, generated by local ggen runs
.ggen/keys/
**/.ggen/keys/
signing.key
**/signing.key

# ggen local signing key material — never commit (repeat offender across repos)
.ggen/keys/
**/.ggen/keys/
signing.key
**/signing.key

# ggen signing key material -- never commit (found leaking from merged branch runs)
.ggen/keys/
**/.ggen/keys/
signing.key
**/signing.key

# ggen v2 pipeline build cache -- left behind by every real `ggen sync run`
# against a self-hosted example/consumer project (confirmed: real run against
# dfcm-pack left packs/dfcm-pack/.ggen-v2/ untracked before this entry).
# Not source; safe and reproducible to regenerate on demand.
.ggen-v2/
**/.ggen-v2/
