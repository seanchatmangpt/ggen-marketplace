@prefix fhmxl: <https://ggen.dev/patterns/fond-hddl-mx-loop#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

fhmxl:LoopPatternShape a sh:NodeShape ;
    sh:targetClass fhmxl:LoopPattern ;
    sh:property [
        sh:path fhmxl:calVer ;
        sh:datatype xsd:string ;
        sh:pattern "^v2[0-9]\\.[0-9]+\\.[0-9]+$" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A LoopPattern must declare an explicit CalVer string matching vYY.M.D" ;
    ] .

fhmxl:MXEpisodeShape a sh:NodeShape ;
    sh:targetClass fhmxl:MachineExperience ;
    sh:property [
        sh:path fhmxl:subjectHead ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An MXEpisode must bind to an exact subject commit head." ;
    ] ;
    sh:property [
        sh:path fhmxl:receiptHash ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An MXEpisode must reference a verifiable receipt hash." ;
    ] .
