# MESSAGE: "SELECT != DO" -- in the fond-hddl-mx-loop pattern, planner proposals,
# task decompositions, and MX candidate methods must remain SELECT / CONSTRUCT only.
# Ambient or asserted DO authority on loop proposals is strictly refused.
PREFIX pp:    <https://ggen.dev/ontology/planning-policy#>
PREFIX fhmxl: <https://ggen.dev/patterns/fond-hddl-mx-loop#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

SELECT ?output WHERE {
  ?output a pp:PlannerOutput ;
          pp:hasDOAuthority true .
}
ORDER BY ?output
