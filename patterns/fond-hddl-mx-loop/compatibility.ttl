@prefix fhmxl: <https://ggen.dev/patterns/fond-hddl-mx-loop#> .
@prefix pp:    <https://ggen.dev/ontology/planning-policy#> .
@prefix xp:    <https://ggen.dev/ontology/experience-projection#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# ===== COMPATIBILITY PREDICATES (Semantic Relations, NOT SemVer-Inferred) =====
fhmxl:compatibleWith a rdf:Property ;
    rdfs:label "compatibleWith" ;
    rdfs:comment "Asserts bidirectional or backward semantic compatibility between identities." .

fhmxl:supersedes a rdf:Property ;
    rdfs:label "supersedes" ;
    rdfs:comment "Asserts that a newer CalVer identity supersedes an earlier identity." .

fhmxl:requires a rdf:Property ;
    rdfs:label "requires" ;
    rdfs:comment "Asserts an exact required capability or contract dependency." .

fhmxl:projects a rdf:Property ;
    rdfs:label "projects" ;
    rdfs:comment "Asserts a projection relation from pattern to domain or machine experience." .

fhmxl:conformsTo a rdf:Property ;
    rdfs:label "conformsTo" ;
    rdfs:comment "Asserts conformance to a formal contract or schema." .

fhmxl:breakingAgainst a rdf:Property ;
    rdfs:label "breakingAgainst" ;
    rdfs:comment "Explicitly asserts a breaking boundary against a historical identity." .

# ===== EXPLICIT COMPATIBILITY TRIPLES FOR v26.9.13 =====
<https://ggen.dev/patterns/fond-hddl-mx-loop#v26.9.13>
    fhmxl:requires <https://ggen.dev/ontology/planning-policy#v26.9.12> ;
    fhmxl:requires <https://ggen.dev/ontology/experience-projection#v26.9.12> ;
    fhmxl:requires <https://ggen.dev/consequence-ir#v0.2.0> ;
    fhmxl:projects <https://ggen.dev/domains/repo-closure#v26.9.13> ;
    fhmxl:conformsTo <https://ggen.dev/patterns/fond-hddl-mx-loop/contracts/mx#v26.9.13> .
