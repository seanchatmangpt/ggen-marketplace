@prefix fhmxl: <https://ggen.dev/patterns/fond-hddl-mx-loop#> .
@prefix pp:    <https://ggen.dev/ontology/planning-policy#> .
@prefix xp:    <https://ggen.dev/ontology/experience-projection#> .
@prefix cci:   <https://ggen.dev/consequence-ir#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .

<https://ggen.dev/patterns/fond-hddl-mx-loop#v26.9.13> a fhmxl:LoopPattern ;
    dct:identifier "fond-hddl-mx-loop@v26.9.13" ;
    rdfs:label "FOND-HDDL Machine Experience Closed-Loop Pattern" ;
    fhmxl:calVer "v26.9.13" ;
    dct:description "Reusable architectural pattern establishing the closed loop: O_t -> HDDL -> FOND -> SELECT -> CONSTRUCT -> BRCE -> R_t -> Replay -> MX -> O_{t+1}. Separates version identity from compatibility semantics." .

# ===== CORE CLASSES =====
fhmxl:LoopPattern a rdfs:Class ;
    rdfs:label "Closed-Loop Architectural Pattern" .

fhmxl:LoopState a rdfs:Class ;
    rdfs:label "Admitted Observation State O_t" .

fhmxl:HierarchicalDecomposition a rdfs:Class ;
    rdfs:subClassOf pp:CompoundTask ;
    rdfs:label "HDDL Hierarchical Task Decomposition" .

fhmxl:ContingentPolicy a rdfs:Class ;
    rdfs:subClassOf pp:Policy ;
    rdfs:label "FOND Contingent Policy for Non-Deterministic Outcomes" .

fhmxl:ExecutionBoundary a rdfs:Class ;
    rdfs:subClassOf cci:Execution ;
    rdfs:label "Consequential DO Boundary (BRCE / Reactor)" .

fhmxl:ReceiptContract a rdfs:Class ;
    rdfs:subClassOf cci:Receipt ;
    rdfs:label "Verifiable Execution Receipt R_t" .

fhmxl:MachineExperience a rdfs:Class ;
    rdfs:subClassOf xp:MachineExperienceProjection ;
    rdfs:label "Machine Experience Episode Record" .

fhmxl:KnowledgePromotion a rdfs:Class ;
    rdfs:label "Promotion from Experience Episode to Admitted Machinery" .

# ===== RELATIONS =====
fhmxl:decomposesState a rdf:Property ;
    rdfs:domain fhmxl:HierarchicalDecomposition ;
    rdfs:range fhmxl:LoopState .

fhmxl:governsBranching a rdf:Property ;
    rdfs:domain fhmxl:ContingentPolicy ;
    rdfs:range fhmxl:HierarchicalDecomposition .

fhmxl:executesUnder a rdf:Property ;
    rdfs:domain fhmxl:ExecutionBoundary ;
    rdfs:range fhmxl:ContingentPolicy .

fhmxl:producesReceipt a rdf:Property ;
    rdfs:domain fhmxl:ExecutionBoundary ;
    rdfs:range fhmxl:ReceiptContract .

fhmxl:recordsToMX a rdf:Property ;
    rdfs:domain fhmxl:ReceiptContract ;
    rdfs:range fhmxl:MachineExperience .

fhmxl:promotesCandidate a rdf:Property ;
    rdfs:domain fhmxl:MachineExperience ;
    rdfs:range fhmxl:KnowledgePromotion .

fhmxl:calVer a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Explicit CalVer release token indicating admission date." .
