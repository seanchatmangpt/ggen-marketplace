@prefix fhmxl: <https://ggen.dev/patterns/fond-hddl-mx-loop#> .
@prefix xp:    <https://ggen.dev/ontology/experience-projection#> .
@prefix pp:    <https://ggen.dev/ontology/planning-policy#> .
@prefix cci:   <https://ggen.dev/consequence-ir#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .

<https://ggen.dev/patterns/fond-hddl-mx-loop/contracts/surface_mx#v26.9.13> a fhmxl:SurfaceMXContract ;
    fhmxl:calVer "v26.9.13" ;
    rdfs:label "AshSurface Machine Experience (MX) Consumer Surface Contract" ;
    dct:description "Formal contract for XaaS/Ash -> AshSurface_MX -> ZOELA projection. Replaces loose Action+Profile blobs with typed observation projections, action authority boundaries, planning episode projections, realtime event streams, and reconciliation." .

# ===== SURFACE CONTRACT CLASSES =====
fhmxl:SurfaceMXContract a rdfs:Class .

fhmxl:SurfaceAction a rdfs:Class ;
    rdfs:subClassOf xp:MachineExperienceProjection ;
    rdfs:label "Typed Surface Action with Explicit Authority Boundary" .

fhmxl:ObservationProjection a rdfs:Class ;
    rdfs:subClassOf xp:MachineExperienceProjection ;
    rdfs:label "Machine-Readable World State Snapshot Observation(W_t)" .

fhmxl:PlanningEpisodeProjection a rdfs:Class ;
    rdfs:subClassOf xp:MachineExperienceProjection ;
    rdfs:label "Projected FOND/HDDL Planning Candidate from Backend Planner" .

fhmxl:EventProjection a rdfs:Class ;
    rdfs:subClassOf xp:MachineExperienceProjection ;
    rdfs:label "Server-to-Client Read-Only Event Projection via Channels" .

fhmxl:ReconciliationProtocol a rdfs:Class ;
    rdfs:label "Unknown-After-Dispatch Safe Command Reconciliation Protocol" .

# ===== SURFACE ACTION PROPERTIES =====
fhmxl:semanticActionId a rdf:Property ; rdfs:domain fhmxl:SurfaceAction ; rdfs:range xsd:string .
fhmxl:authorityBoundary a rdf:Property ; rdfs:domain fhmxl:SurfaceAction ;
    rdfs:comment "Closed vocabulary: OBSERVE | SELECT | CONSTRUCT | DO" .
fhmxl:doAuthority a rdf:Property ; rdfs:domain fhmxl:SurfaceAction ; rdfs:range xsd:boolean .
fhmxl:consequenceClass a rdf:Property ; rdfs:domain fhmxl:SurfaceAction ; rdfs:range xsd:string .
fhmxl:evidenceRequired a rdf:Property ; rdfs:domain fhmxl:SurfaceAction ; rdfs:range xsd:boolean .
fhmxl:receiptRequired a rdf:Property ; rdfs:domain fhmxl:SurfaceAction ; rdfs:range xsd:boolean .
fhmxl:reversible a rdf:Property ; rdfs:domain fhmxl:SurfaceAction ; rdfs:range xsd:boolean .
fhmxl:idempotencyScope a rdf:Property ; rdfs:domain fhmxl:SurfaceAction ; rdfs:range xsd:string .
fhmxl:stateTransitionRef a rdf:Property ; rdfs:domain fhmxl:SurfaceAction ; rdfs:range xsd:string .
fhmxl:refusalSchemaRef a rdf:Property ; rdfs:domain fhmxl:SurfaceAction ; rdfs:range xsd:string .

# ===== OBSERVATION PROJECTION PROPERTIES =====
fhmxl:observationId a rdf:Property ; rdfs:domain fhmxl:ObservationProjection ; rdfs:range xsd:string .
fhmxl:exactSubject a rdf:Property ; rdfs:domain fhmxl:ObservationProjection ; rdfs:range xsd:string .
fhmxl:observedAt a rdf:Property ; rdfs:domain fhmxl:ObservationProjection ; rdfs:range xsd:dateTime .
fhmxl:stateDigest a rdf:Property ; rdfs:domain fhmxl:ObservationProjection ; rdfs:range xsd:string .
fhmxl:projectionPurpose a rdf:Property ; rdfs:domain fhmxl:ObservationProjection ; rdfs:range xsd:string .

# ===== PLANNING EPISODE PROJECTION PROPERTIES =====
fhmxl:planningEpisodeId a rdf:Property ; rdfs:domain fhmxl:PlanningEpisodeProjection ; rdfs:range xsd:string .
fhmxl:worldStateRef a rdf:Property ; rdfs:domain fhmxl:PlanningEpisodeProjection ; rdfs:range xsd:string .
fhmxl:taskNetworkRef a rdf:Property ; rdfs:domain fhmxl:PlanningEpisodeProjection ; rdfs:range xsd:string .
fhmxl:plannerIdentity a rdf:Property ; rdfs:domain fhmxl:PlanningEpisodeProjection ; rdfs:range xsd:string .
fhmxl:policyIdentity a rdf:Property ; rdfs:domain fhmxl:PlanningEpisodeProjection ; rdfs:range xsd:string .
fhmxl:policyStanding a rdf:Property ; rdfs:domain fhmxl:PlanningEpisodeProjection ;
    rdfs:comment "VALID_STRONG | VALID_STRONG_CYCLIC | REFUSED" .
fhmxl:candidateActions a rdf:Property ; rdfs:domain fhmxl:PlanningEpisodeProjection .
fhmxl:authorityCeiling a rdf:Property ; rdfs:domain fhmxl:PlanningEpisodeProjection ;
    rdfs:comment "Must be SELECT or CONSTRUCT; never DO" .

# ===== EVENT PROJECTION PROPERTIES =====
fhmxl:eventId a rdf:Property ; rdfs:domain fhmxl:EventProjection ; rdfs:range xsd:string .
fhmxl:sequenceNumber a rdf:Property ; rdfs:domain fhmxl:EventProjection ; rdfs:range xsd:integer .
fhmxl:eventType a rdf:Property ; rdfs:domain fhmxl:EventProjection ; rdfs:range xsd:string .
fhmxl:receiptRef a rdf:Property ; rdfs:domain fhmxl:EventProjection ; rdfs:range xsd:string .

# ===== RECONCILIATION PROTOCOL PROPERTIES =====
fhmxl:reconcileCommandId a rdf:Property ; rdfs:domain fhmxl:ReconciliationProtocol ; rdfs:range xsd:string .
fhmxl:reconcileOutcome a rdf:Property ; rdfs:domain fhmxl:ReconciliationProtocol ;
    rdfs:comment "COMPLETED | NOT_OBSERVED | STILL_UNKNOWN (zero second actuation)" .
