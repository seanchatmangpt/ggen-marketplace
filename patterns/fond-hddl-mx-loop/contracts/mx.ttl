@prefix fhmxl: <https://ggen.dev/patterns/fond-hddl-mx-loop#> .
@prefix xp:    <https://ggen.dev/ontology/experience-projection#> .
@prefix cci:   <https://ggen.dev/consequence-ir#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<https://ggen.dev/patterns/fond-hddl-mx-loop/contracts/mx#v26.9.13> a fhmxl:MXContract ;
    fhmxl:calVer "v26.9.13" ;
    rdfs:label "MX Episode Schema and Promotion Calculus Contract" .

fhmxl:MXEpisode a rdfs:Class ;
    rdfs:subClassOf xp:MachineExperienceProjection ;
    rdfs:label "Immutable Experience Record of one Closed-Loop Execution" .

fhmxl:episodeId a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range xsd:string .
fhmxl:subjectRepo a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range xsd:string .
fhmxl:subjectHead a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range xsd:string .
fhmxl:patternVersion a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range xsd:string .
fhmxl:domainVersion a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range xsd:string .
fhmxl:hddlVersion a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range xsd:string .
fhmxl:fondVersion a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range xsd:string .
fhmxl:verifierVersion a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range xsd:string .

fhmxl:selectedDecomposition a rdf:Property ; rdfs:domain fhmxl:MXEpisode .
fhmxl:observedTransition a rdf:Property ; rdfs:domain fhmxl:MXEpisode .
fhmxl:costScore a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range xsd:decimal .
fhmxl:receiptHash a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range xsd:string .
fhmxl:resultingStanding a rdf:Property ; rdfs:domain fhmxl:MXEpisode ; rdfs:range cci:Standing .

# ===== PROMOTION CALCULUS =====
# Experience != Authority
# LearnedCandidate != AdmittedMethod
fhmxl:PromotionState a rdfs:Class .
fhmxl:EPISODE a fhmxl:PromotionState ; rdfs:label "Raw immutable episode data" .
fhmxl:CANDIDATE_KNOWLEDGE a fhmxl:PromotionState ; rdfs:label "Extracted candidate knowledge pattern" .
fhmxl:EVIDENCE_ACCUMULATING a fhmxl:PromotionState ; rdfs:label "Multiple episodes validating candidate" .
fhmxl:ADMITTED_METHOD a fhmxl:PromotionState ; rdfs:label "Formally verified and admitted into new CalVer machinery" .
