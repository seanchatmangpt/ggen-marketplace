@prefix fhmxl: <https://ggen.dev/patterns/fond-hddl-mx-loop#> .
@prefix cci:   <https://ggen.dev/consequence-ir#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

<https://ggen.dev/patterns/fond-hddl-mx-loop/contracts/mx_receipt#v26.9.13> a fhmxl:MXReceiptContract ;
    fhmxl:calVer "v26.9.13" ;
    rdfs:label "MX Composed Receipt Contract" ;
    rdfs:comment "Separates transport receipts from backend consequence receipts: TransportReceipt != ConsequenceReceipt." .

fhmxl:MXReceiptContract a rdfs:Class .

fhmxl:ComposedMXReceipt a rdfs:Class ;
    rdfs:subClassOf cci:Receipt ;
    rdfs:label "Composed MX Receipt binding transport execution to backend domain consequence" .

fhmxl:TransportReceipt a rdfs:Class ;
    rdfs:label "Transport Disposition Receipt (HTTP / Phoenix Channel)" .

fhmxl:ConsequenceReceipt a rdfs:Class ;
    rdfs:label "Authoritative Domain Consequence Receipt emitted by XaaS/BRCE" .

fhmxl:hasTransportReceipt a rdf:Property ;
    rdfs:domain fhmxl:ComposedMXReceipt ;
    rdfs:range fhmxl:TransportReceipt .

fhmxl:hasConsequenceReceipt a rdf:Property ;
    rdfs:domain fhmxl:ComposedMXReceipt ;
    rdfs:range fhmxl:ConsequenceReceipt .

fhmxl:preStateDigest a rdf:Property ; rdfs:domain fhmxl:ComposedMXReceipt ; rdfs:range xsd:string .
fhmxl:postStateDigest a rdf:Property ; rdfs:domain fhmxl:ComposedMXReceipt ; rdfs:range xsd:string .
fhmxl:standingBefore a rdf:Property ; rdfs:domain fhmxl:ComposedMXReceipt ; rdfs:range cci:Standing .
fhmxl:standingAfter a rdf:Property ; rdfs:domain fhmxl:ComposedMXReceipt ; rdfs:range cci:Standing .
fhmxl:replayKey a rdf:Property ; rdfs:domain fhmxl:ComposedMXReceipt ; rdfs:range xsd:string .
