{%- if is_tagged %}
      kind: Decode.variant(map, {{ tagged.variant_tag_field | json_encode }}, [{% for v in vs %}{{ v.variant_tag | json_encode }}{% if not loop.last %}, {% endif %}{% endfor %}]),
{%- endif %}
{%- for f in fs %}
      {{ f.field_name }}: Decode.get(map, {{ f.field_name | json_encode }}, {{ f.field_type | json_encode }}),
{%- endfor %}
      raw: map
    }
