---
to: "lib/ash_graphlaw/result/{{ op_name }}.ex"
for_each: "result_ops"
sparql:
  result_ops: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Capabilities whose result struct is generated: those with no bindingResultModule override.
    SELECT ?op_name ?op_order ?op_summary
    WHERE {
      ?capability a gac:Capability ;
        gac:opName ?op_name ;
        gac:opOrder ?op_order ;
        gac:opSummary ?op_summary .
      FILTER NOT EXISTS {
        ?binding a gac:OpBinding ;
          gac:bindingOp ?op_name ;
          gac:bindingResultModule ?override_module .
      }
    }
    ORDER BY ?op_order
  variants: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Response variants per op; an untagged op has exactly one variant with an empty tag.
    SELECT ?variant_iri ?op_name ?variant_order ?variant_tag ?variant_tag_field
    WHERE {
      ?variant_iri a gac:ResponseVariant ;
        gac:variantOf ?capability ;
        gac:variantOrder ?variant_order ;
        gac:variantTag ?variant_tag ;
        gac:variantTagField ?variant_tag_field .
      ?capability a gac:Capability ;
        gac:opName ?op_name .
    }
    ORDER BY ?op_name ?variant_order
  union_fields: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Union of the response fields of all variants of an op (first-seen order). A field is
    # required only if every variant requires it and nullable if any variant allows null.
    SELECT ?op_name ?field_name
           (MIN(?variant_order) AS ?first_variant_order)
           (MIN(?field_order) AS ?first_field_order)
           (SAMPLE(?ftype) AS ?field_type)
           (MIN(?freq) AS ?field_required)
           (MAX(?fnull) AS ?field_nullable)
           (SAMPLE(?fdoc) AS ?field_doc)
           (SAMPLE(?fdefault) AS ?field_default)
    WHERE {
      ?field_iri a gac:CapabilityField ;
        gac:fieldOwner ?variant_iri ;
        gac:fieldSide "response" ;
        gac:fieldOrder ?field_order ;
        gac:fieldName ?field_name ;
        gac:fieldType ?ftype ;
        gac:fieldRequired ?required ;
        gac:fieldNullable ?nullable ;
        gac:fieldDoc ?fdoc .
      OPTIONAL { ?field_iri gac:fieldDefault ?fdefault }
      ?variant_iri a gac:ResponseVariant ;
        gac:variantOf ?capability ;
        gac:variantOrder ?variant_order .
      ?capability a gac:Capability ;
        gac:opName ?op_name .
      BIND(STR(?required) AS ?freq)
      BIND(STR(?nullable) AS ?fnull)
    }
    GROUP BY ?op_name ?field_name
    ORDER BY ?op_name ?first_variant_order ?first_field_order
---
