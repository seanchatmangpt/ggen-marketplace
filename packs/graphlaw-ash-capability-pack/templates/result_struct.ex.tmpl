#
# SPDX-License-Identifier: MIT
# GENERATED by ggen from ontology.ttl (graphlaw-ash-capability-pack, graphlaw capability registry). DO NOT EDIT.
{# Result struct for one registry operation without a bindingResultModule override. Keys are the union
   of the operation's response fields (first-seen order), plus :kind for a tagged operation and :raw
   (the whole decoded response, so decoding is lossless and forward compatible). #}
{%- set vs = variants | filter(attribute="op_name", value=op_name) %}
{%- set tagged = vs | first %}
{%- set is_tagged = tagged.variant_tag_field != "" %}
{%- set fs = union_fields | filter(attribute="op_name", value=op_name) %}
defmodule AshGraphLaw.Result.{{ op_name | capitalize }} do
  @moduledoc ~S"""
  Decoded result of the `{{ op_name }}` capability.

  {{ op_summary }}

  One key per response field of the registry (`:raw` is reserved and never a registry field):

{% for f in fs %}  - `:{{ f.field_name }}` (`{{ f.field_type }}`): {{ f.field_doc }}
{% endfor %}{% if is_tagged %}
  `:kind` names the response variant selected by the wire field `{{ tagged.variant_tag_field }}`:
  {% for v in vs %}`{% if v.variant_tag is matching("^[a-z][a-z0-9_]*$") %}:{{ v.variant_tag }}{% else %}:"{{ v.variant_tag }}"{% endif %}`{% if not loop.last %},{% endif %}{% endfor %}, or `{:unknown, tag}` for a variant this
  library version does not know.
{% endif %}
  `:raw` is the entire decoded response map (including `"ok"`), so `from_map(m).raw == m` for every
  `m`, including responses that carry fields this version does not model. `from_map/1` never raises:
  missing, extra or mistyped keys leave the corresponding field `nil` or the value untouched.
  """

  alias AshGraphLaw.Capability.Decode

  defstruct [
{%- if is_tagged %}
    :kind,
{%- endif %}
{%- for f in fs %}
    :{{ f.field_name }},
{%- endfor %}
    :raw
  ]

  @type t :: %__MODULE__{
{%- if is_tagged %}
          kind: {% for v in vs %}{% if v.variant_tag is matching("^[a-z][a-z0-9_]*$") %}:{{ v.variant_tag }}{% else %}:"{{ v.variant_tag }}"{% endif %} | {% endfor %}{:unknown, String.t()} | nil,
{%- endif %}
{%- for f in fs %}
          {{ f.field_name }}: term(),
{%- endfor %}
          raw: term()
        }

  @doc """
  Builds a result from a decoded engine response. Never raises; the input is kept untouched in
  `:raw`, and a value whose type does not match its registry type is returned as it arrived.
  """
  @spec from_map(term()) :: t()
  def from_map(map) when is_map(map) do
