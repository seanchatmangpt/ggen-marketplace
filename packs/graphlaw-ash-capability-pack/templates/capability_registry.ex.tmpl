---
to: "lib/ash_graphlaw/capability/registry.ex"
sparql:
  registry: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # One row: the registry identity the projection is stamped with.
    SELECT ?schema_id ?graphlaw_version ?abi_version ?surface_sha256 ?registry_sha256 ?op_count ?dialect_count
    WHERE {
      ?registry a gac:Registry ;
        gac:schemaId ?schema_id ;
        gac:graphlawVersion ?graphlaw_version ;
        gac:abiVersion ?abi_version ;
        gac:surfaceSha256 ?surface_sha256 ;
        gac:registrySha256 ?registry_sha256 ;
        gac:opCount ?op_count ;
        gac:dialectCount ?dialect_count .
    }
    ORDER BY ?registry_sha256
  ops: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # One row per capability in registry order, with the consumer's optional OpBinding.
    SELECT ?op_name ?op_order ?op_summary ?result_module ?binding_legacy
    WHERE {
      ?capability a gac:Capability ;
        gac:opName ?op_name ;
        gac:opOrder ?op_order ;
        gac:opSummary ?op_summary .
      OPTIONAL {
        ?binding a gac:OpBinding ;
          gac:bindingOp ?op_name .
        OPTIONAL { ?binding gac:bindingResultModule ?result_module }
        OPTIONAL { ?binding gac:bindingLegacy ?legacy_flag }
      }
      BIND(COALESCE(STR(?legacy_flag), "false") AS ?binding_legacy)
    }
    ORDER BY ?op_order
  variants: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Response variants per op; an untagged op has exactly one variant with an empty tag.
    SELECT ?variant_iri ?op_name ?variant_order ?variant_tag ?variant_tag_field
    WHERE {
      ?variant_iri a gac:ResponseVariant ;
        gac:variantOf ?capability ;
        gac:variantOrder ?variant_order ;
        gac:variantTag ?variant_tag ;
        gac:variantTagField ?variant_tag_field .
      ?capability a gac:Capability ;
        gac:opName ?op_name .
    }
    ORDER BY ?op_name ?variant_order
  request_fields: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Request fields per op, in registry order.
    SELECT ?op_name ?field_iri ?field_order ?field_name ?field_type ?field_required ?field_nullable ?field_doc ?field_default
    WHERE {
      ?field_iri a gac:CapabilityField ;
        gac:fieldOwner ?capability ;
        gac:fieldSide "request" ;
        gac:fieldOrder ?field_order ;
        gac:fieldName ?field_name ;
        gac:fieldType ?field_type ;
        gac:fieldRequired ?required ;
        gac:fieldNullable ?nullable ;
        gac:fieldDoc ?field_doc .
      OPTIONAL { ?field_iri gac:fieldDefault ?field_default }
      ?capability a gac:Capability ;
        gac:opName ?op_name .
      BIND(STR(?required) AS ?field_required)
      BIND(STR(?nullable) AS ?field_nullable)
    }
    ORDER BY ?op_name ?field_order
  response_fields: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Response fields per op and variant, in registry order.
    SELECT ?op_name ?variant_iri ?variant_order ?field_iri ?field_order ?field_name ?field_type ?field_required ?field_nullable ?field_doc ?field_default
    WHERE {
      ?field_iri a gac:CapabilityField ;
        gac:fieldOwner ?variant_iri ;
        gac:fieldSide "response" ;
        gac:fieldOrder ?field_order ;
        gac:fieldName ?field_name ;
        gac:fieldType ?field_type ;
        gac:fieldRequired ?required ;
        gac:fieldNullable ?nullable ;
        gac:fieldDoc ?field_doc .
      OPTIONAL { ?field_iri gac:fieldDefault ?field_default }
      ?variant_iri a gac:ResponseVariant ;
        gac:variantOf ?capability ;
        gac:variantOrder ?variant_order .
      ?capability a gac:Capability ;
        gac:opName ?op_name .
      BIND(STR(?required) AS ?field_required)
      BIND(STR(?nullable) AS ?field_nullable)
    }
    ORDER BY ?op_name ?variant_order ?field_order
  field_enums: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Informational enum values of any field (request, response, detail or law step).
    SELECT ?field_iri ?enum_order ?enum_value
    WHERE {
      ?enum a gac:EnumValue ;
        gac:enumOf ?field_iri ;
        gac:enumOrder ?enum_order ;
        gac:enumValue ?enum_value .
    }
    ORDER BY ?field_iri ?enum_order
  op_refusal_kinds: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Refusal kinds each op can emit (a set: ordered by name, the registry keeps no order here).
    SELECT ?op_name ?refusal_kind
    WHERE {
      ?capability a gac:Capability ;
        gac:opName ?op_name ;
        gac:opRefusalKind ?refusal_kind .
    }
    ORDER BY ?op_name ?refusal_kind
  op_refusal_codes: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Refusal detail codes each op can emit (a set: ordered by name).
    SELECT ?op_name ?refusal_code
    WHERE {
      ?capability a gac:Capability ;
        gac:opName ?op_name ;
        gac:opRefusalCode ?refusal_code .
    }
    ORDER BY ?op_name ?refusal_code
  dialects: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Dialects in global order (rdf first, then other).
    SELECT ?dialect_name ?dialect_order ?dialect_kind ?dialect_response_name ?dialect_media_type
    WHERE {
      ?dialect a gac:Dialect ;
        gac:dialectName ?dialect_name ;
        gac:dialectOrder ?dialect_order ;
        gac:dialectKind ?dialect_kind ;
        gac:dialectResponseName ?dialect_response_name .
      OPTIONAL { ?dialect gac:dialectMediaType ?dialect_media_type }
    }
    ORDER BY ?dialect_order
  dialect_aliases: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Accepted aliases per dialect (a set: ordered by alias).
    SELECT ?dialect_name ?dialect_alias
    WHERE {
      ?dialect a gac:Dialect ;
        gac:dialectName ?dialect_name ;
        gac:dialectAlias ?dialect_alias .
    }
    ORDER BY ?dialect_name ?dialect_alias
  law_steps: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Steps of the law op in registry order, keyed by wire name.
    SELECT ?step_wire ?step_order ?step_ceiling
    WHERE {
      ?step a gac:LawStep ;
        gac:lawStepName ?step_wire ;
        gac:lawStepOrder ?step_order .
      OPTIONAL { ?step gac:lawStepCeiling ?step_ceiling }
    }
    ORDER BY ?step_order
  step_fields: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Fields of each law step.
    SELECT ?step_wire ?field_iri ?field_order ?field_name ?field_type ?field_required ?field_nullable ?field_doc ?field_default
    WHERE {
      ?field_iri a gac:CapabilityField ;
        gac:fieldOwner ?step ;
        gac:fieldSide "law_step" ;
        gac:fieldOrder ?field_order ;
        gac:fieldName ?field_name ;
        gac:fieldType ?field_type ;
        gac:fieldRequired ?required ;
        gac:fieldNullable ?nullable ;
        gac:fieldDoc ?field_doc .
      OPTIONAL { ?field_iri gac:fieldDefault ?field_default }
      ?step a gac:LawStep ;
        gac:lawStepName ?step_wire .
      BIND(STR(?required) AS ?field_required)
      BIND(STR(?nullable) AS ?field_nullable)
    }
    ORDER BY ?step_wire ?field_order
  refusal_codes: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Engine refusal detail codes (details.code values) in registry order.
    SELECT ?code_name ?code_order ?code_kind
    WHERE {
      ?code a gac:RefusalCode ;
        gac:refusalCodeName ?code_name ;
        gac:refusalCodeOrder ?code_order .
      OPTIONAL { ?code gac:refusalCodeKind ?code_kind }
    }
    ORDER BY ?code_order
  code_fields: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Detail fields of each refusal code.
    SELECT ?code_name ?field_iri ?field_order ?field_name ?field_type ?field_required ?field_nullable ?field_doc ?field_default
    WHERE {
      ?field_iri a gac:CapabilityField ;
        gac:fieldOwner ?code ;
        gac:fieldSide "detail" ;
        gac:fieldOrder ?field_order ;
        gac:fieldName ?field_name ;
        gac:fieldType ?field_type ;
        gac:fieldRequired ?required ;
        gac:fieldNullable ?nullable ;
        gac:fieldDoc ?field_doc .
      OPTIONAL { ?field_iri gac:fieldDefault ?field_default }
      ?code a gac:RefusalCode ;
        gac:refusalCodeName ?code_name .
      BIND(STR(?required) AS ?field_required)
      BIND(STR(?nullable) AS ?field_nullable)
    }
    ORDER BY ?code_name ?field_order
  vocab: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Closed vocabularies: engines, refusal_kinds, regimes, lease_ceilings, lease_reasons, ...
    SELECT ?vocab_name ?vocab_order ?vocab_value
    WHERE {
      ?entry a gac:VocabularyEntry ;
        gac:vocabOf ?vocab_name ;
        gac:vocabOrder ?vocab_order ;
        gac:vocabValue ?vocab_value .
    }
    ORDER BY ?vocab_name ?vocab_order
  limits: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Engine resource limits.
    SELECT ?limit_name ?limit_value
    WHERE {
      ?limit a gac:Limit ;
        gac:limitName ?limit_name ;
        gac:limitValue ?limit_value .
    }
    ORDER BY ?limit_name
