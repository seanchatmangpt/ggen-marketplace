# GENERATED by ggen from ontology.ttl (graphlaw-ash-capability-pack, graphlaw capability registry). DO NOT EDIT.
{# Pure surface court (no wasm, no engine, no doubles): the generated modules exist, export the
   behaviour, agree with the registry literals, decode losslessly and refuse bad requests. Nothing
   here hardcodes the operation count; it is compared against the ontology's gac:opCount. #}
defmodule AshGraphLaw.Generated.CapabilitySurfaceTest do
  @moduledoc """
  Generated pure surface test for the typed capability API. It calls real generated modules only;
  running an operation on the engine is covered by the parity court, not here.
  """

  use ExUnit.Case, async: true

  alias AshGraphLaw.Capability.API
  alias AshGraphLaw.Capability.Registry
  alias AshGraphLaw.Refusal
  alias AshGraphLaw.Result.Term

  @registry_op_count {{ registry[0].op_count }}
  @registry_digest {{ registry[0].registry_sha256 | json_encode }}
  @surface_digest {{ registry[0].surface_sha256 | json_encode }}

  # name, capability module, generated result module (nil when overridden), tag field (nil when
  # untagged), response field keys, required request field names, minimal valid args
  @surface [
{%- for o in ops %}
    %{
      name: {{ o.op_name | json_encode }},
      module: AshGraphLaw.Capability.{{ o.op_name | capitalize }},
      function: :{{ o.op_name }},
      result: {% if o.result_module is defined %}nil{% else %}AshGraphLaw.Result.{{ o.op_name | capitalize }}{% endif %},
      tag_field: {% set fv = variants | filter(attribute="op_name", value=o.op_name) | first %}{% if fv.variant_tag_field == "" %}nil{% else %}{{ fv.variant_tag_field | json_encode }}{% endif %},
      keys: [{% for f in union_fields | filter(attribute="op_name", value=o.op_name) %}:{{ f.field_name }}{% if not loop.last %}, {% endif %}{% endfor %}],
      required: [{% for f in request_fields | filter(attribute="op_name", value=o.op_name) | filter(attribute="field_required", value="true") %}{{ f.field_name | json_encode }}{% if not loop.last %}, {% endif %}{% endfor %}],
      args: [{% for f in request_fields | filter(attribute="op_name", value=o.op_name) | filter(attribute="field_required", value="true") %}{{ f.field_name }}: {% if f.field_type == "integer" %}1{% elif f.field_type == "boolean" %}true{% elif f.field_type == "object" or f.field_type == "term" %}%{}{% elif f.field_type is starting_with("list<") %}[]{% else %}"x"{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}]
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]

  describe "positive control: the registry surface is present" do
    test "the registry lists the ontology's operations, in order, with the declared digests" do
      names = Registry.names()

      assert length(names) == @registry_op_count
      assert names == Enum.map(@surface, & &1.name)
      assert Registry.digest() == @registry_digest
      assert Registry.surface_digest() == @surface_digest
      assert Registry.ops() |> Enum.map(& &1.name) == names
    end

    test "every operation module exports the behaviour and the API exports both forms" do
      for %{name: name, module: module, function: function} <- @surface do
        assert Code.ensure_loaded?(module), "#{module} is not loaded"
        assert module.op() == name
        assert {:ok, ^module} = Registry.module_for(name)
        assert function_exported?(module, :build_request, 1)
        assert function_exported?(module, :decode, 1)
        assert function_exported?(module, :run, 2)
        assert function_exported?(module, :fields, 1)
        assert Code.ensure_loaded?(API), "#{API} is not loaded"
        assert function_exported?(API, function, 2)
        assert function_exported?(API, :"#{function}!", 2)
      end
    end

    test "build_request injects the op key for minimal valid args" do
      for %{name: name, module: module, args: args} <- @surface do
        assert {:ok, request} = module.build_request(args)
        assert request["op"] == name
      end
    end

    test "the field lists agree with the registry" do
      for %{name: name, module: module, keys: keys} <- @surface do
        {:ok, op} = Registry.op(name)

        assert module.fields(:request) == op.request
        assert module.fields(:response) |> Enum.map(&String.to_atom(&1.name)) == keys
      end
    end
  end

  describe "result structs decode losslessly" do
    test "from_map keeps the whole response in raw and tolerates extra and missing keys" do
      for %{result: result, keys: keys} when not is_nil(result) <- @surface do
        assert Code.ensure_loaded?(result)

        struct_keys = Map.keys(struct(result)) -- [:__struct__, :raw, :kind]
        assert Enum.sort(struct_keys) == Enum.sort(keys)

        empty = result.from_map(%{})
        assert empty.raw == %{}

        injected = %{"ok" => true, "future_field" => %{"a" => [1, 2]}}
        assert result.from_map(injected).raw == injected
        assert result.from_map("not a map").raw == "not a map"
        assert result.from_map(nil).raw == nil
      end
    end

    test "a mistyped value is returned untouched and never raises" do
      for %{result: result, keys: [key | _]} when not is_nil(result) <- @surface do
        mistyped = %{Atom.to_string(key) => %{"unexpected" => ["shape", 1, nil]}, "ok" => true}
        decoded = result.from_map(mistyped)

        assert decoded.raw == mistyped
      end
    end

    test "tagged operations expose :kind and an unknown tag stays open" do
      for %{result: result, tag_field: tag_field} <- @surface,
          not is_nil(result) and not is_nil(tag_field) do
        assert {:unknown, "brand_new_variant"} ==
                 result.from_map(%{tag_field => "brand_new_variant"}).kind
      end
    end

    test "Result.Term maps xml:lang to lang and keeps the raw map" do
      term = %{"type" => "literal", "value" => "hola", "xml:lang" => "es"}
      decoded = Term.from_map(term)

      assert %Term{type: "literal", value: "hola", lang: "es", raw: ^term} = decoded
      assert Term.from_map(:not_a_map).raw == :not_a_map
    end
  end

  describe "requests refuse with a typed refusal" do
    test "an unknown key refuses, and so does supplying the op key" do
      for %{module: module, args: args} <- @surface do
        assert {:error, %Refusal{code: :invalid_capability_request}} =
                 module.build_request(Keyword.put(args, :no_such_field, "x"))

        assert {:error, %Refusal{code: :invalid_capability_request}} =
                 module.build_request(Keyword.put(args, :op, "other"))
      end
    end

    test "a missing required field refuses" do
      for %{module: module, required: [_ | _]} <- @surface do
        assert {:error, %Refusal{code: :invalid_capability_request}} = module.build_request([])
      end
    end

    test "an unknown capability name refuses through the dispatcher" do
      assert {:error, %Refusal{code: :unknown_capability}} = API.run("no_such_capability", [])
      assert Registry.module_for("no_such_capability") == :error
      assert Registry.op("no_such_capability") == :error
    end
  end
end
