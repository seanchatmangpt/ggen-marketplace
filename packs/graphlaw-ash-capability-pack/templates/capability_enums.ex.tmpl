  @doc "The informational values of one enum, or `[]` for an unknown enum."
  @spec values(String.t()) :: [String.t()]
  def values(enum), do: Map.get(@enums, enum, [])

  @doc "True when `value` is one of the informational values of `enum`."
  @spec member?(String.t(), term()) :: boolean()
  def member?(enum, value), do: value in values(enum)
end
