---
to: "documentation/reference/capabilities/{{ op_name }}.md"
for_each: "ops"
sparql:
  ops: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # One row per capability in registry order, with the consumer's optional OpBinding.
    SELECT ?op_name ?op_order ?op_summary ?result_module ?binding_legacy
    WHERE {
      ?capability a gac:Capability ;
        gac:opName ?op_name ;
        gac:opOrder ?op_order ;
        gac:opSummary ?op_summary .
      OPTIONAL {
        ?binding a gac:OpBinding ;
          gac:bindingOp ?op_name .
        OPTIONAL { ?binding gac:bindingResultModule ?result_module }
        OPTIONAL { ?binding gac:bindingLegacy ?legacy_flag }
      }
      BIND(COALESCE(STR(?legacy_flag), "false") AS ?binding_legacy)
    }
    ORDER BY ?op_order
  request_fields: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Request fields per op, in registry order.
    SELECT ?op_name ?field_iri ?field_order ?field_name ?field_type ?field_required ?field_nullable ?field_doc ?field_default
    WHERE {
      ?field_iri a gac:CapabilityField ;
        gac:fieldOwner ?capability ;
        gac:fieldSide "request" ;
        gac:fieldOrder ?field_order ;
        gac:fieldName ?field_name ;
        gac:fieldType ?field_type ;
        gac:fieldRequired ?required ;
        gac:fieldNullable ?nullable ;
        gac:fieldDoc ?field_doc .
      OPTIONAL { ?field_iri gac:fieldDefault ?field_default }
      ?capability a gac:Capability ;
        gac:opName ?op_name .
      BIND(STR(?required) AS ?field_required)
      BIND(STR(?nullable) AS ?field_nullable)
    }
    ORDER BY ?op_name ?field_order
  variants: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Response variants per op; an untagged op has exactly one variant with an empty tag.
    SELECT ?variant_iri ?op_name ?variant_order ?variant_tag ?variant_tag_field
    WHERE {
      ?variant_iri a gac:ResponseVariant ;
        gac:variantOf ?capability ;
        gac:variantOrder ?variant_order ;
        gac:variantTag ?variant_tag ;
        gac:variantTagField ?variant_tag_field .
      ?capability a gac:Capability ;
        gac:opName ?op_name .
    }
    ORDER BY ?op_name ?variant_order
  response_fields: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Response fields per op and variant, in registry order.
    SELECT ?op_name ?variant_iri ?variant_order ?field_iri ?field_order ?field_name ?field_type ?field_required ?field_nullable ?field_doc ?field_default
    WHERE {
      ?field_iri a gac:CapabilityField ;
        gac:fieldOwner ?variant_iri ;
        gac:fieldSide "response" ;
        gac:fieldOrder ?field_order ;
        gac:fieldName ?field_name ;
        gac:fieldType ?field_type ;
        gac:fieldRequired ?required ;
        gac:fieldNullable ?nullable ;
        gac:fieldDoc ?field_doc .
      OPTIONAL { ?field_iri gac:fieldDefault ?field_default }
      ?variant_iri a gac:ResponseVariant ;
        gac:variantOf ?capability ;
        gac:variantOrder ?variant_order .
      ?capability a gac:Capability ;
        gac:opName ?op_name .
      BIND(STR(?required) AS ?field_required)
      BIND(STR(?nullable) AS ?field_nullable)
    }
    ORDER BY ?op_name ?variant_order ?field_order
  field_enums: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Informational enum values of any field (request, response, detail or law step).
    SELECT ?field_iri ?enum_order ?enum_value
    WHERE {
      ?enum a gac:EnumValue ;
        gac:enumOf ?field_iri ;
        gac:enumOrder ?enum_order ;
        gac:enumValue ?enum_value .
    }
    ORDER BY ?field_iri ?enum_order
  op_refusal_kinds: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Refusal kinds each op can emit (a set: ordered by name, the registry keeps no order here).
    SELECT ?op_name ?refusal_kind
    WHERE {
      ?capability a gac:Capability ;
        gac:opName ?op_name ;
        gac:opRefusalKind ?refusal_kind .
    }
    ORDER BY ?op_name ?refusal_kind
  op_refusal_codes: |
    PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

    # Refusal detail codes each op can emit (a set: ordered by name).
    SELECT ?op_name ?refusal_code
    WHERE {
      ?capability a gac:Capability ;
        gac:opName ?op_name ;
        gac:opRefusalCode ?refusal_code .
    }
    ORDER BY ?op_name ?refusal_code
