# Witness: 080_dialect_kind_contract (pass): small self-consistent registry
@prefix gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://graphlaw.dev/registry#registry> a gac:Registry ;
    gac:schemaId "graphlaw.capability-registry/1" ;
    gac:graphlawVersion "26.9.29" ;
    gac:abiVersion "1"^^xsd:integer ;
    gac:surfaceSha256 "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
    gac:registrySha256 "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
    gac:opCount "2"^^xsd:integer ;
    gac:dialectCount "2"^^xsd:integer .

<https://graphlaw.dev/registry#op/sniff> a gac:Capability ;
    gac:capabilityOf <https://graphlaw.dev/registry#registry> ;
    gac:opName "sniff" ;
    gac:opOrder "1"^^xsd:integer ;
    gac:opSummary "Detect the RDF dialect of a text." .

<https://graphlaw.dev/registry#op/sniff/request/text> a gac:CapabilityField ;
    gac:fieldOwner <https://graphlaw.dev/registry#op/sniff> ;
    gac:fieldSide "request" ;
    gac:fieldOrder "1"^^xsd:integer ;
    gac:fieldName "text" ;
    gac:fieldType "string" ;
    gac:fieldRequired "true"^^xsd:boolean ;
    gac:fieldNullable "false"^^xsd:boolean ;
    gac:fieldDoc "Text to sniff." .

<https://graphlaw.dev/registry#op/sniff/request/hint> a gac:CapabilityField ;
    gac:fieldOwner <https://graphlaw.dev/registry#op/sniff> ;
    gac:fieldSide "request" ;
    gac:fieldOrder "2"^^xsd:integer ;
    gac:fieldName "hint" ;
    gac:fieldType "string" ;
    gac:fieldRequired "false"^^xsd:boolean ;
    gac:fieldNullable "false"^^xsd:boolean ;
    gac:fieldDoc "Dialect hint." .

<https://graphlaw.dev/registry#op/sniff/response/default> a gac:ResponseVariant ;
    gac:variantOf <https://graphlaw.dev/registry#op/sniff> ;
    gac:variantTag "" ;
    gac:variantTagField "" ;
    gac:variantOrder "1"^^xsd:integer .

<https://graphlaw.dev/registry#op/sniff/response/default/dialect> a gac:CapabilityField ;
    gac:fieldOwner <https://graphlaw.dev/registry#op/sniff/response/default> ;
    gac:fieldSide "response" ;
    gac:fieldOrder "1"^^xsd:integer ;
    gac:fieldName "dialect" ;
    gac:fieldType "string" ;
    gac:fieldRequired "false"^^xsd:boolean ;
    gac:fieldNullable "false"^^xsd:boolean ;
    gac:fieldDoc "Response field dialect." .

<https://graphlaw.dev/registry#op/sniff/response/default/engine> a gac:CapabilityField ;
    gac:fieldOwner <https://graphlaw.dev/registry#op/sniff/response/default> ;
    gac:fieldSide "response" ;
    gac:fieldOrder "2"^^xsd:integer ;
    gac:fieldName "engine" ;
    gac:fieldType "string" ;
    gac:fieldRequired "false"^^xsd:boolean ;
    gac:fieldNullable "false"^^xsd:boolean ;
    gac:fieldDoc "Response field engine." .

<https://graphlaw.dev/registry#op/sparql> a gac:Capability ;
    gac:capabilityOf <https://graphlaw.dev/registry#registry> ;
    gac:opName "sparql" ;
    gac:opOrder "2"^^xsd:integer ;
    gac:opSummary "Run a SPARQL query." .

<https://graphlaw.dev/registry#op/sparql/request/data> a gac:CapabilityField ;
    gac:fieldOwner <https://graphlaw.dev/registry#op/sparql> ;
    gac:fieldSide "request" ;
    gac:fieldOrder "1"^^xsd:integer ;
    gac:fieldName "data" ;
    gac:fieldType "data_spec" ;
    gac:fieldRequired "true"^^xsd:boolean ;
    gac:fieldNullable "false"^^xsd:boolean ;
    gac:fieldDoc "Dataset." .

<https://graphlaw.dev/registry#op/sparql/request/query> a gac:CapabilityField ;
    gac:fieldOwner <https://graphlaw.dev/registry#op/sparql> ;
    gac:fieldSide "request" ;
    gac:fieldOrder "2"^^xsd:integer ;
    gac:fieldName "query" ;
    gac:fieldType "string" ;
    gac:fieldRequired "true"^^xsd:boolean ;
    gac:fieldNullable "false"^^xsd:boolean ;
    gac:fieldDoc "Query text." .

<https://graphlaw.dev/registry#op/sparql/response/solutions> a gac:ResponseVariant ;
    gac:variantOf <https://graphlaw.dev/registry#op/sparql> ;
    gac:variantTag "solutions" ;
    gac:variantTagField "kind" ;
    gac:variantOrder "1"^^xsd:integer .

<https://graphlaw.dev/registry#op/sparql/response/solutions/variables> a gac:CapabilityField ;
    gac:fieldOwner <https://graphlaw.dev/registry#op/sparql/response/solutions> ;
    gac:fieldSide "response" ;
    gac:fieldOrder "1"^^xsd:integer ;
    gac:fieldName "variables" ;
    gac:fieldType "list<string>" ;
    gac:fieldRequired "false"^^xsd:boolean ;
    gac:fieldNullable "false"^^xsd:boolean ;
    gac:fieldDoc "Response field variables." .

<https://graphlaw.dev/registry#op/sparql/response/solutions/rows> a gac:CapabilityField ;
    gac:fieldOwner <https://graphlaw.dev/registry#op/sparql/response/solutions> ;
    gac:fieldSide "response" ;
    gac:fieldOrder "2"^^xsd:integer ;
    gac:fieldName "rows" ;
    gac:fieldType "list<list<term>>" ;
    gac:fieldRequired "false"^^xsd:boolean ;
    gac:fieldNullable "false"^^xsd:boolean ;
    gac:fieldDoc "Response field rows." .

<https://graphlaw.dev/registry#op/sparql/response/boolean> a gac:ResponseVariant ;
    gac:variantOf <https://graphlaw.dev/registry#op/sparql> ;
    gac:variantTag "boolean" ;
    gac:variantTagField "kind" ;
    gac:variantOrder "2"^^xsd:integer .

<https://graphlaw.dev/registry#op/sparql/response/boolean/value> a gac:CapabilityField ;
    gac:fieldOwner <https://graphlaw.dev/registry#op/sparql/response/boolean> ;
    gac:fieldSide "response" ;
    gac:fieldOrder "1"^^xsd:integer ;
    gac:fieldName "value" ;
    gac:fieldType "boolean" ;
    gac:fieldRequired "false"^^xsd:boolean ;
    gac:fieldNullable "false"^^xsd:boolean ;
    gac:fieldDoc "Response field value." .

<https://graphlaw.dev/registry#dialect/turtle> a gac:Dialect ;
    gac:dialectOf <https://graphlaw.dev/registry#registry> ;
    gac:dialectName "turtle" ;
    gac:dialectOrder "1"^^xsd:integer ;
    gac:dialectKind "rdf" ;
    gac:dialectResponseName "Turtle" ;
    gac:dialectMediaType "text/turtle" ;
    gac:dialectAlias "ttl" .

<https://graphlaw.dev/registry#dialect/json> a gac:Dialect ;
    gac:dialectOf <https://graphlaw.dev/registry#registry> ;
    gac:dialectName "json" ;
    gac:dialectOrder "2"^^xsd:integer ;
    gac:dialectKind "other" ;
    gac:dialectResponseName "Json" .

<https://graphlaw.dev/registry#law-step/shacl> a gac:LawStep ;
    gac:lawStepName "shacl" ;
    gac:lawStepOrder "1"^^xsd:integer ;
    gac:lawStepCeiling "observe" .

<https://graphlaw.dev/registry#law-step/record-receipts> a gac:LawStep ;
    gac:lawStepName "record-receipts" ;
    gac:lawStepOrder "2"^^xsd:integer .

<https://graphlaw.dev/registry#binding/sniff> a gac:OpBinding ;
    gac:bindingOp "sniff" ;
    gac:bindingLegacy "true"^^xsd:boolean ;
    gac:bindingResultModule "AshGraphLaw.Admitted" .
