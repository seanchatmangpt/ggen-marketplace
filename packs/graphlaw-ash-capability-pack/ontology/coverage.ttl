@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix gac:  <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#> .

# Coverage-ledger vocabulary: every GraphLaw capability (op) and every native module is either
# GENERATED by a pack artifact or ledgered UNSUPPORTED with a closed reason. Declarations only;
# individuals live in qualification/coverage-consumer.ttl and coverage/coverage_block.ttl.
# coverageReason closed set: generator-capability | ontology-gap | authority-ceiling.

gac:CapabilityCoverage a rdfs:Class ;
    rdfs:label "CapabilityCoverage" ;
    rdfs:comment "One ledger row stating whether a GraphLaw op or native module is GENERATED or UNSUPPORTED." .

gac:NativeModule a rdfs:Class ;
    rdfs:label "NativeModule" ;
    rdfs:comment "One native GraphLaw engine module whose behavior must be ledgered even when its data is projected." .

gac:coverageSubject a rdf:Property ;
    rdfs:label "coverage subject" ;
    rdfs:comment "Wire name of the op or module the row accounts for." ;
    rdfs:domain gac:CapabilityCoverage ;
    rdfs:range xsd:string .

gac:coverageSubjectKind a rdf:Property ;
    rdfs:label "coverage subject kind" ;
    rdfs:comment "Closed set: op or module." ;
    rdfs:domain gac:CapabilityCoverage ;
    rdfs:range xsd:string .

gac:coverageStatus a rdf:Property ;
    rdfs:label "coverage status" ;
    rdfs:comment "Closed set: GENERATED or UNSUPPORTED." ;
    rdfs:domain gac:CapabilityCoverage ;
    rdfs:range xsd:string .

gac:coverageArtifact a rdf:Property ;
    rdfs:label "coverage artifact" ;
    rdfs:comment "Pack template stem that produces the artifact; required when status is GENERATED; multi-valued." ;
    rdfs:domain gac:CapabilityCoverage ;
    rdfs:range xsd:string .

gac:coverageReason a rdf:Property ;
    rdfs:label "coverage reason" ;
    rdfs:comment "Closed reason for UNSUPPORTED: generator-capability, ontology-gap, or authority-ceiling." ;
    rdfs:domain gac:CapabilityCoverage ;
    rdfs:range xsd:string .

gac:coverageNote a rdf:Property ;
    rdfs:label "coverage note" ;
    rdfs:comment "Non-empty explanation; required when status is UNSUPPORTED." ;
    rdfs:domain gac:CapabilityCoverage ;
    rdfs:range xsd:string .

gac:moduleName a rdf:Property ;
    rdfs:label "module name" ;
    rdfs:comment "Native module name, e.g. attest." ;
    rdfs:domain gac:NativeModule ;
    rdfs:range xsd:string .

gac:moduleSource a rdf:Property ;
    rdfs:label "module source" ;
    rdfs:comment "Repository-relative source path of the native module." ;
    rdfs:domain gac:NativeModule ;
    rdfs:range xsd:string .
