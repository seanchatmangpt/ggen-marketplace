@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix gac:  <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#> .

# Positive render fixture for graphlaw-ash-capability-pack (verify/render_check.exs): a REDUCED 3-operation
# registry (sniff, sparql with 3 tagged variants, law bound to AshGraphLaw.Admitted).
# FIXTURE: gac:surfaceSha256 and gac:registrySha256 below are syntactically valid dummy sha256
# strings (all 0s / all 1s), not real GraphLaw registry digests. gac:opCount and
# gac:dialectCount equal the individuals present in this file.
# Individuals use full IRIs under <https://graphlaw.dev/registry#...> per the registry IRI scheme.

<https://graphlaw.dev/registry#binding/law> a gac:OpBinding ;
    gac:bindingOp "law" ;
    gac:bindingResultModule "AshGraphLaw.Admitted" ;
    gac:bindingLegacy true .

<https://graphlaw.dev/registry#binding/sniff> a gac:OpBinding ;
    gac:bindingOp "sniff" ;
    gac:bindingLegacy true .

<https://graphlaw.dev/registry#binding/sparql> a gac:OpBinding ;
    gac:bindingOp "sparql" ;
    gac:bindingLegacy false .

<https://graphlaw.dev/registry#dialect/n3> a gac:Dialect ;
    gac:dialectOf <https://graphlaw.dev/registry#registry> ;
    gac:dialectName "n3" ;
    gac:dialectOrder 3 ;
    gac:dialectKind "other" ;
    gac:dialectResponseName "N3" ;
    gac:dialectMediaType "text/n3" .

<https://graphlaw.dev/registry#dialect/ntriples> a gac:Dialect ;
    gac:dialectOf <https://graphlaw.dev/registry#registry> ;
    gac:dialectName "ntriples" ;
    gac:dialectOrder 2 ;
    gac:dialectKind "rdf" ;
    gac:dialectResponseName "NTriples" ;
    gac:dialectMediaType "application/n-triples" ;
    gac:dialectAlias "nt" .

<https://graphlaw.dev/registry#dialect/turtle> a gac:Dialect ;
    gac:dialectOf <https://graphlaw.dev/registry#registry> ;
    gac:dialectName "turtle" ;
    gac:dialectOrder 1 ;
    gac:dialectKind "rdf" ;
    gac:dialectResponseName "Turtle" ;
    gac:dialectMediaType "text/turtle" ;
    gac:dialectAlias "ttl" .

<https://graphlaw.dev/registry#law-step/record-receipts> a gac:LawStep ;
    gac:lawStepName "record-receipts" ;
    gac:lawStepOrder 2 .

<https://graphlaw.dev/registry#law-step/shacl> a gac:LawStep ;
    gac:lawStepName "shacl" ;
    gac:lawStepOrder 1 ;
    gac:lawStepCeiling "observe" .

<https://graphlaw.dev/registry#op/law/request/data> a gac:CapabilityField ;
    gac:fieldOwner <https://graphlaw.dev/registry#op/law> ;
    gac:fieldSide "request" ;
    gac:fieldOrder 1 ;
    gac:fieldName "data" ;
    gac:fieldType "data_spec" ;
    gac:fieldRequired true ;
    gac:fieldNullable false ;
    gac:fieldDoc "Data to admit." .

