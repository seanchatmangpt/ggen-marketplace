# Typed models, enums and scoped limits: copied from the GraphLaw 26.9.29 capability registry
# (graphlaw-registry --print-ttl) so the fixture exercises the same shapes the engine emits.

<https://graphlaw.dev/registry#limit/hooks_max_firings> a gac:Limit ;
    gac:limitName "hooks_max_firings" ;
    gac:limitScope "hooks" ;
    gac:limitSource "src/hooks.rs" ;
    gac:limitUnit "firings" ;
    gac:limitValue 10000 .

<https://graphlaw.dev/registry#limit/hooks_max_rounds> a gac:Limit ;
    gac:limitName "hooks_max_rounds" ;
    gac:limitScope "hooks" ;
    gac:limitSource "src/hooks.rs" ;
    gac:limitUnit "rounds" ;
    gac:limitValue 64 .

