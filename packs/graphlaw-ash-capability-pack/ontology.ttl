@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix gac:  <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#> .

# Vocabulary for projecting a typed Elixir capability surface from the GraphLaw capability registry.
# No sample individuals: fixtures live in qualification/ and verify/fixtures.

gac:Registry a rdfs:Class ;
    rdfs:label "Registry" ;
    rdfs:comment "One GraphLaw capability registry (schema graphlaw.capability-registry/1)." .

gac:Capability a rdfs:Class ;
    rdfs:label "Capability" ;
    rdfs:comment "One public GraphLaw ABI operation exposed as a typed capability." .

gac:ResponseVariant a rdfs:Class ;
    rdfs:label "ResponseVariant" ;
    rdfs:comment "One response shape of a capability; untagged operations have exactly one, tagged operations one per tag." .

gac:CapabilityField a rdfs:Class ;
    rdfs:label "CapabilityField" ;
    rdfs:comment "One field of a capability request, response variant, refusal-code detail, or law step." .

gac:EnumValue a rdfs:Class ;
    rdfs:label "EnumValue" ;
    rdfs:comment "One informational enum value of a field; never enforced client-side." .

gac:Dialect a rdfs:Class ;
    rdfs:label "Dialect" ;
    rdfs:comment "One RDF or non-RDF serialization dialect accepted by the engine." .

gac:RefusalCode a rdfs:Class ;
    rdfs:label "RefusalCode" ;
    rdfs:comment "One details.code value the engine can emit in a typed refusal." .

gac:LawStep a rdfs:Class ;
    rdfs:label "LawStep" ;
    rdfs:comment "One step kind accepted by the law operation." .

gac:VocabularyEntry a rdfs:Class ;
    rdfs:label "VocabularyEntry" ;
    rdfs:comment "One value of a closed registry vocabulary such as engines or regimes." .

gac:Limit a rdfs:Class ;
    rdfs:label "Limit" ;
    rdfs:comment "One named engine resource limit." .

gac:OpBinding a rdfs:Class ;
    rdfs:label "OpBinding" ;
    rdfs:comment "Consumer-supplied binding of an operation to result-module and legacy-surface choices; not emitted by GraphLaw." .

gac:schemaId a rdf:Property ;
    rdfs:label "schema id" ;
    rdfs:comment "Registry schema identifier, e.g. graphlaw.capability-registry/1." ;
    rdfs:domain gac:Registry ;
    rdfs:range xsd:string .

gac:graphlawVersion a rdf:Property ;
    rdfs:label "GraphLaw version" ;
    rdfs:comment "GraphLaw crate version that emitted the registry." ;
    rdfs:domain gac:Registry ;
    rdfs:range xsd:string .

gac:abiVersion a rdf:Property ;
    rdfs:label "ABI version" ;
    rdfs:comment "GraphLaw wasm ABI version (1 for v26.9.29)." ;
    rdfs:domain gac:Registry ;
    rdfs:range xsd:integer .

gac:surfaceSha256 a rdf:Property ;
    rdfs:label "surface digest" ;
    rdfs:comment "sha256:<hex> over the canonical surface document (abi_version, ops, other_dialects, rdf_dialects)." ;
    rdfs:domain gac:Registry ;
    rdfs:range xsd:string .

gac:registrySha256 a rdf:Property ;
    rdfs:label "registry digest" ;
    rdfs:comment "sha256:<hex> over the canonical registry document with registry_sha256 removed." ;
    rdfs:domain gac:Registry ;
    rdfs:range xsd:string .

gac:opCount a rdf:Property ;
    rdfs:label "operation count" ;
    rdfs:comment "Number of gac:Capability individuals; gates compare against this instead of a literal." ;
    rdfs:domain gac:Registry ;
    rdfs:range xsd:integer .

gac:dialectCount a rdf:Property ;
    rdfs:label "dialect count" ;
    rdfs:comment "Number of gac:Dialect individuals." ;
    rdfs:domain gac:Registry ;
    rdfs:range xsd:integer .

gac:capabilityOf a rdf:Property ;
    rdfs:label "capability of" ;
    rdfs:comment "Registry the capability belongs to." ;
    rdfs:domain gac:Capability ;
    rdfs:range gac:Registry .

gac:opName a rdf:Property ;
    rdfs:label "operation name" ;
    rdfs:comment "Wire name of the operation, e.g. sparql." ;
    rdfs:domain gac:Capability ;
    rdfs:range xsd:string .

gac:opOrder a rdf:Property ;
    rdfs:label "operation order" ;
    rdfs:comment "Position of the operation in the registry, starting at 1." ;
    rdfs:domain gac:Capability ;
    rdfs:range xsd:integer .

gac:opSummary a rdf:Property ;
    rdfs:label "operation summary" ;
    rdfs:comment "One-line summary of the operation." ;
    rdfs:domain gac:Capability ;
    rdfs:range xsd:string .

gac:opRefusalKind a rdf:Property ;
    rdfs:label "operation refusal kind" ;
    rdfs:comment "A refusal kind the operation source can emit; multi-valued." ;
    rdfs:domain gac:Capability ;
    rdfs:range xsd:string .

gac:opRefusalCode a rdf:Property ;
    rdfs:label "operation refusal code" ;
    rdfs:comment "A details.code the operation source can emit; multi-valued." ;
    rdfs:domain gac:Capability ;
    rdfs:range xsd:string .

gac:variantOf a rdf:Property ;
    rdfs:label "variant of" ;
    rdfs:comment "Capability the response variant belongs to." ;
    rdfs:domain gac:ResponseVariant ;
    rdfs:range gac:Capability .

gac:variantTag a rdf:Property ;
    rdfs:label "variant tag" ;
    rdfs:comment "Discriminator value of the variant; the empty string when the operation is untagged." ;
    rdfs:domain gac:ResponseVariant ;
    rdfs:range xsd:string .

gac:variantTagField a rdf:Property ;
    rdfs:label "variant tag field" ;
    rdfs:comment "Response field carrying the discriminator; the empty string when none." ;
    rdfs:domain gac:ResponseVariant ;
    rdfs:range xsd:string .

gac:variantOrder a rdf:Property ;
    rdfs:label "variant order" ;
    rdfs:comment "Position of the variant within its capability." ;
    rdfs:domain gac:ResponseVariant ;
    rdfs:range xsd:integer .

gac:fieldOwner a rdf:Property ;
    rdfs:label "field owner" ;
    rdfs:comment "Owner of the field: a capability, response variant, refusal code, or law step." ;
    rdfs:domain gac:CapabilityField .

gac:fieldSide a rdf:Property ;
    rdfs:label "field side" ;
    rdfs:comment "One of request, response, detail, law_step." ;
    rdfs:domain gac:CapabilityField ;
    rdfs:range xsd:string .

gac:fieldOrder a rdf:Property ;
    rdfs:label "field order" ;
    rdfs:comment "Position of the field within its owner, starting at 1." ;
    rdfs:domain gac:CapabilityField ;
    rdfs:range xsd:integer .

gac:fieldName a rdf:Property ;
    rdfs:label "field name" ;
    rdfs:comment "snake_case wire name of the field." ;
    rdfs:domain gac:CapabilityField ;
    rdfs:range xsd:string .

gac:fieldType a rdf:Property ;
    rdfs:label "field type" ;
    rdfs:comment "Member of the closed type vocabulary: string integer boolean object any data_spec term json_or_string list<string> list<object> list<any> list<term> list<list<string>> list<list<term>>." ;
    rdfs:domain gac:CapabilityField ;
    rdfs:range xsd:string .

gac:fieldRequired a rdf:Property ;
    rdfs:label "field required" ;
    rdfs:comment "Whether the field must be present." ;
    rdfs:domain gac:CapabilityField ;
    rdfs:range xsd:boolean .

gac:fieldNullable a rdf:Property ;
    rdfs:label "field nullable" ;
    rdfs:comment "Whether the field may be null." ;
    rdfs:domain gac:CapabilityField ;
    rdfs:range xsd:boolean .

gac:fieldDoc a rdf:Property ;
    rdfs:label "field documentation" ;
    rdfs:comment "Human-readable field description." ;
    rdfs:domain gac:CapabilityField ;
    rdfs:range xsd:string .

gac:fieldDefault a rdf:Property ;
    rdfs:label "field default" ;
    rdfs:comment "JSON-encoded default value; absent when the default is null." ;
    rdfs:domain gac:CapabilityField ;
    rdfs:range xsd:string .

gac:enumOf a rdf:Property ;
    rdfs:label "enum of" ;
    rdfs:comment "Field the enum value belongs to." ;
    rdfs:domain gac:EnumValue ;
    rdfs:range gac:CapabilityField .

gac:enumOrder a rdf:Property ;
    rdfs:label "enum order" ;
    rdfs:comment "Position of the value within the field enum." ;
    rdfs:domain gac:EnumValue ;
    rdfs:range xsd:integer .

gac:enumValue a rdf:Property ;
    rdfs:label "enum value" ;
    rdfs:comment "The informational enum value." ;
    rdfs:domain gac:EnumValue ;
    rdfs:range xsd:string .

gac:dialectOf a rdf:Property ;
    rdfs:label "dialect of" ;
    rdfs:comment "Registry the dialect belongs to." ;
    rdfs:domain gac:Dialect ;
    rdfs:range gac:Registry .

gac:dialectName a rdf:Property ;
    rdfs:label "dialect name" ;
    rdfs:comment "Lowercase wire name, e.g. turtle." ;
    rdfs:domain gac:Dialect ;
    rdfs:range xsd:string .

gac:dialectOrder a rdf:Property ;
    rdfs:label "dialect order" ;
    rdfs:comment "Global position, RDF dialects first then other dialects." ;
    rdfs:domain gac:Dialect ;
    rdfs:range xsd:integer .

gac:dialectKind a rdf:Property ;
    rdfs:label "dialect kind" ;
    rdfs:comment "rdf or other." ;
    rdfs:domain gac:Dialect ;
    rdfs:range xsd:string .

gac:dialectResponseName a rdf:Property ;
    rdfs:label "dialect response name" ;
    rdfs:comment "Name the engine uses in responses, e.g. Turtle." ;
    rdfs:domain gac:Dialect ;
    rdfs:range xsd:string .

gac:dialectMediaType a rdf:Property ;
    rdfs:label "dialect media type" ;
    rdfs:comment "Optional IANA media type." ;
    rdfs:domain gac:Dialect ;
    rdfs:range xsd:string .

gac:dialectAlias a rdf:Property ;
    rdfs:label "dialect alias" ;
    rdfs:comment "Accepted alias; multi-valued." ;
    rdfs:domain gac:Dialect ;
    rdfs:range xsd:string .

gac:refusalCodeName a rdf:Property ;
    rdfs:label "refusal code name" ;
    rdfs:comment "details.code value, e.g. ReceiptRefused." ;
    rdfs:domain gac:RefusalCode ;
    rdfs:range xsd:string .

gac:refusalCodeOrder a rdf:Property ;
    rdfs:label "refusal code order" ;
    rdfs:comment "Position of the code in the registry." ;
    rdfs:domain gac:RefusalCode ;
    rdfs:range xsd:integer .

gac:refusalCodeKind a rdf:Property ;
    rdfs:label "refusal code kind" ;
    rdfs:comment "Optional refusal kind associated with the code." ;
    rdfs:domain gac:RefusalCode ;
    rdfs:range xsd:string .

gac:lawStepName a rdf:Property ;
    rdfs:label "law step name" ;
    rdfs:comment "Wire name of the step, e.g. require-receipt." ;
    rdfs:domain gac:LawStep ;
    rdfs:range xsd:string .

gac:lawStepOrder a rdf:Property ;
    rdfs:label "law step order" ;
    rdfs:comment "Position of the step in the registry." ;
    rdfs:domain gac:LawStep ;
    rdfs:range xsd:integer .

gac:lawStepCeiling a rdf:Property ;
    rdfs:label "law step ceiling" ;
    rdfs:comment "Optional lease ceiling: observe, select or construct." ;
    rdfs:domain gac:LawStep ;
    rdfs:range xsd:string .

gac:vocabOf a rdf:Property ;
    rdfs:label "vocabulary of" ;
    rdfs:comment "Vocabulary name: engines, refusal_kinds, regimes, lease_ceilings, lease_reasons, receipt_reasons, policy_refusal_kinds." ;
    rdfs:domain gac:VocabularyEntry ;
    rdfs:range xsd:string .

gac:vocabOrder a rdf:Property ;
    rdfs:label "vocabulary order" ;
    rdfs:comment "Position of the value within its vocabulary." ;
    rdfs:domain gac:VocabularyEntry ;
    rdfs:range xsd:integer .

gac:vocabValue a rdf:Property ;
    rdfs:label "vocabulary value" ;
    rdfs:comment "The vocabulary value." ;
    rdfs:domain gac:VocabularyEntry ;
    rdfs:range xsd:string .

gac:limitName a rdf:Property ;
    rdfs:label "limit name" ;
    rdfs:comment "Limit name, e.g. max_request_bytes." ;
    rdfs:domain gac:Limit ;
    rdfs:range xsd:string .

gac:limitValue a rdf:Property ;
    rdfs:label "limit value" ;
    rdfs:comment "Integer limit value." ;
    rdfs:domain gac:Limit ;
    rdfs:range xsd:integer .

gac:bindingOp a rdf:Property ;
    rdfs:label "binding operation" ;
    rdfs:comment "Wire name of the operation this binding applies to." ;
    rdfs:domain gac:OpBinding ;
    rdfs:range xsd:string .

gac:bindingResultModule a rdf:Property ;
    rdfs:label "binding result module" ;
    rdfs:comment "Optional existing Elixir module that replaces the generated Result struct for the operation." ;
    rdfs:domain gac:OpBinding ;
    rdfs:range xsd:string .

gac:bindingLegacy a rdf:Property ;
    rdfs:label "binding legacy" ;
    rdfs:comment "True when the operation is on the legacy root surface, whose typed form lives only under Capability.API." ;
    rdfs:domain gac:OpBinding ;
    rdfs:range xsd:boolean .

# ---- Typed models (26.9.30) -------------------------------------------------------------------
# Declarations only: model individuals come from the registry emitted by graphlaw-registry
# (IRIs https://graphlaw.dev/registry#model/<Name>, .../model/<Name>/<field>, .../model-enum/<Name>).
# gac:enumOf / gac:enumOrder / gac:enumValue (declared above for gac:EnumValue) are reused:
# a gac:ModelEnumValue points at its gac:ModelEnum with gac:enumOf.

gac:Model a rdfs:Class ;
    rdfs:label "Model" ;
    rdfs:comment "One typed GraphLaw value model (Lease, SignedLease, Receipt, Attestation, Plan, Action, PolicyEntry, PolicyOutcome) projected as an Elixir struct." .

gac:ModelField a rdfs:Class ;
    rdfs:label "ModelField" ;
    rdfs:comment "One field of a gac:Model." .

gac:ModelEnum a rdfs:Class ;
    rdfs:label "ModelEnum" ;
    rdfs:comment "One named closed value set (Ceiling, LeaseReason, ReceiptReason, PolicyRefusalKind) referenced by model fields typed enum:<Name>; informational, never enforced client-side." .

gac:ModelEnumValue a rdfs:Class ;
    rdfs:label "ModelEnumValue" ;
    rdfs:comment "One value of a gac:ModelEnum; linked to the enum by gac:enumOf." .

gac:modelName a rdf:Property ;
    rdfs:label "model name" ;
    rdfs:comment "UpperCamelCase name of a gac:Model or gac:ModelEnum, e.g. SignedLease; matches ^[A-Z][A-Za-z0-9]*$." ;
    rdfs:range xsd:string .

gac:modelOrder a rdf:Property ;
    rdfs:label "model order" ;
    rdfs:comment "Position of a gac:Model or gac:ModelEnum within its own kind in the registry, starting at 1." ;
    rdfs:range xsd:integer .

gac:modelElixirModule a rdf:Property ;
    rdfs:label "model Elixir module" ;
    rdfs:comment "Fully qualified Elixir module the struct is generated as, e.g. AshGraphLaw.Model.SignedLease." ;
    rdfs:domain gac:Model ;
    rdfs:range xsd:string .

gac:modelRustPath a rdf:Property ;
    rdfs:label "model Rust path" ;
    rdfs:comment "Rust path of the engine type the model mirrors, e.g. graphlaw::law::SignedLease." ;
    rdfs:domain gac:Model ;
    rdfs:range xsd:string .

gac:modelDoc a rdf:Property ;
    rdfs:label "model documentation" ;
    rdfs:comment "Human-readable model description." ;
    rdfs:domain gac:Model ;
    rdfs:range xsd:string .

gac:modelFieldOf a rdf:Property ;
    rdfs:label "model field of" ;
    rdfs:comment "Model the field belongs to." ;
    rdfs:domain gac:ModelField ;
    rdfs:range gac:Model .

gac:modelFieldName a rdf:Property ;
    rdfs:label "model field name" ;
    rdfs:comment "snake_case wire name of the model field." ;
    rdfs:domain gac:ModelField ;
    rdfs:range xsd:string .

gac:modelFieldOrder a rdf:Property ;
    rdfs:label "model field order" ;
    rdfs:comment "Position of the field within its model, starting at 1." ;
    rdfs:domain gac:ModelField ;
    rdfs:range xsd:integer .

gac:modelFieldType a rdf:Property ;
    rdfs:label "model field type" ;
    rdfs:comment "Member of the closed field-type vocabulary (see gac:fieldType), or model:<ModelName>, list<model:<ModelName>>, or enum:<EnumName>." ;
    rdfs:domain gac:ModelField ;
    rdfs:range xsd:string .

gac:modelFieldRequired a rdf:Property ;
    rdfs:label "model field required" ;
    rdfs:comment "Whether the field must be present on the wire." ;
    rdfs:domain gac:ModelField ;
    rdfs:range xsd:boolean .

gac:modelFieldNullable a rdf:Property ;
    rdfs:label "model field nullable" ;
    rdfs:comment "Whether the field may be null." ;
    rdfs:domain gac:ModelField ;
    rdfs:range xsd:boolean .

gac:modelFieldDoc a rdf:Property ;
    rdfs:label "model field documentation" ;
    rdfs:comment "Human-readable field description." ;
    rdfs:domain gac:ModelField ;
    rdfs:range xsd:string .

gac:limitScope a rdf:Property ;
    rdfs:label "limit scope" ;
    rdfs:comment "Engine component one limit bounds: abi, hooks, n3, plan or wasm." ;
    rdfs:domain gac:Limit ;
    rdfs:range xsd:string .

gac:limitUnit a rdf:Property ;
    rdfs:label "limit unit" ;
    rdfs:comment "Unit of the limit value: bytes, count, steps, firings, rounds or quads." ;
    rdfs:domain gac:Limit ;
    rdfs:range xsd:string .

gac:limitSource a rdf:Property ;
    rdfs:label "limit source" ;
    rdfs:comment "Engine source file (relative to the GraphLaw repository) that enforces the limit." ;
    rdfs:domain gac:Limit ;
    rdfs:range xsd:string .

gac:limitCount a rdf:Property ;
    rdfs:label "limit count" ;
    rdfs:comment "Number of gac:Limit individuals; gate 170 compares against this instead of a literal." ;
    rdfs:domain gac:Registry ;
    rdfs:range xsd:integer .
