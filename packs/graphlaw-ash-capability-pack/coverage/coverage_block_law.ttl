# Coverage block: extra op row for registries that also carry the law op (verify fixtures).
@prefix gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://graphlaw.dev/registry#coverage/op/law> a gac:CapabilityCoverage ;
    gac:coverageSubject "law" ;
    gac:coverageSubjectKind "op" ;
    gac:coverageStatus "GENERATED" ;
    gac:coverageArtifact "capability_module.ex" , "result_struct.ex" , "capability_doc.md" .
