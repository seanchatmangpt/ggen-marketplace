<https://graphlaw.dev/registry#module/policy> a gac:NativeModule ;
    gac:moduleName "policy" ;
    gac:moduleSource "src/policy.rs" .

<https://graphlaw.dev/registry#module/hooks> a gac:NativeModule ;
    gac:moduleName "hooks" ;
    gac:moduleSource "src/hooks.rs" .

<https://graphlaw.dev/registry#coverage/module/LawState> a gac:CapabilityCoverage ;
    gac:coverageSubject "LawState" ;
    gac:coverageSubjectKind "module" ;
    gac:coverageStatus "UNSUPPORTED" ;
    gac:coverageReason "generator-capability" ;
    gac:coverageNote "LawState parse/step behavior (law.rs) has no generator; typed data is projected by the pack model templates." .

