# Coverage block: reusable ledger rows for the sniff/sparql registries.
@prefix gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://graphlaw.dev/registry#coverage/op/sniff> a gac:CapabilityCoverage ;
    gac:coverageSubject "sniff" ;
    gac:coverageSubjectKind "op" ;
    gac:coverageStatus "GENERATED" ;
    gac:coverageArtifact "capability_module.ex" , "result_struct.ex" , "capability_doc.md" .

<https://graphlaw.dev/registry#coverage/op/sparql> a gac:CapabilityCoverage ;
    gac:coverageSubject "sparql" ;
    gac:coverageSubjectKind "op" ;
    gac:coverageStatus "GENERATED" ;
    gac:coverageArtifact "capability_module.ex" , "result_struct.ex" , "capability_doc.md" .

<https://graphlaw.dev/registry#module/LawState> a gac:NativeModule ;
    gac:moduleName "LawState" ;
    gac:moduleSource "src/law.rs" .

<https://graphlaw.dev/registry#module/attest> a gac:NativeModule ;
    gac:moduleName "attest" ;
    gac:moduleSource "src/attest.rs" .

<https://graphlaw.dev/registry#module/ReceiptStore> a gac:NativeModule ;
    gac:moduleName "ReceiptStore" ;
    gac:moduleSource "src/receipt_store.rs" .

<https://graphlaw.dev/registry#module/qualification> a gac:NativeModule ;
    gac:moduleName "qualification" ;
    gac:moduleSource "src/qualification.rs" .

<https://graphlaw.dev/registry#module/smon> a gac:NativeModule ;
    gac:moduleName "smon" ;
    gac:moduleSource "src/smon.rs" .

<https://graphlaw.dev/registry#module/capability_intake> a gac:NativeModule ;
    gac:moduleName "capability_intake" ;
    gac:moduleSource "src/capability_intake.rs" .

<https://graphlaw.dev/registry#module/plan> a gac:NativeModule ;
