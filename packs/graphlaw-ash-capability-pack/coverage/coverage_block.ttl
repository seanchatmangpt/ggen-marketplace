    gac:coverageSubjectKind "module" ;
    gac:coverageStatus "UNSUPPORTED" ;
    gac:coverageReason "generator-capability" ;
    gac:coverageNote "Lease signing and signature verification (attest.rs) has no generator; typed Lease/SignedLease/Attestation data is projected by the pack model templates." .

