PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

# Refusal detail codes each op can emit (a set: ordered by name).
SELECT ?op_name ?refusal_code
WHERE {
  ?capability a gac:Capability ;
    gac:opName ?op_name ;
    gac:opRefusalCode ?refusal_code .
}
ORDER BY ?op_name ?refusal_code
