PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

# Informational values of each named model enum, in registry order.
SELECT ?enum_name ?enum_order ?value_order ?enum_value
WHERE {
  ?enum a gac:ModelEnum ;
    gac:modelName ?enum_name ;
    gac:modelOrder ?enum_order .
  ?value a gac:ModelEnumValue ;
    gac:enumOf ?enum ;
    gac:enumOrder ?value_order ;
    gac:enumValue ?enum_value .
}
ORDER BY ?enum_order ?value_order
