PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

# One row per coverage-ledger entry: kind, subject, status, artifacts, reason and note.
SELECT ?subject_kind ?subject ?status
       (GROUP_CONCAT(DISTINCT ?artifact; separator=", ") AS ?artifacts)
       ?reason ?note
WHERE {
  ?row a gac:CapabilityCoverage ;
    gac:coverageSubject ?subject ;
    gac:coverageSubjectKind ?subject_kind ;
    gac:coverageStatus ?status .
  OPTIONAL { ?row gac:coverageArtifact ?artifact }
  OPTIONAL { ?row gac:coverageReason ?reason }
  OPTIONAL { ?row gac:coverageNote ?note }
}
GROUP BY ?subject_kind ?subject ?status ?reason ?note
ORDER BY ?subject_kind ?subject
