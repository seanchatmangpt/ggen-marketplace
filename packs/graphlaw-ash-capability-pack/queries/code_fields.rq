PREFIX gac: <http://seanchatmangpt.github.io/packs/graphlaw-ash-capability#>

# Detail fields of each refusal code.
SELECT ?code_name ?field_iri ?field_order ?field_name ?field_type ?field_required ?field_nullable ?field_doc ?field_default
WHERE {
  ?field_iri a gac:CapabilityField ;
    gac:fieldOwner ?code ;
    gac:fieldSide "detail" ;
    gac:fieldOrder ?field_order ;
    gac:fieldName ?field_name ;
    gac:fieldType ?field_type ;
    gac:fieldRequired ?required ;
    gac:fieldNullable ?nullable ;
    gac:fieldDoc ?field_doc .
  OPTIONAL { ?field_iri gac:fieldDefault ?field_default }
  ?code a gac:RefusalCode ;
    gac:refusalCodeName ?code_name .
  BIND(STR(?required) AS ?field_required)
  BIND(STR(?nullable) AS ?field_nullable)
}
ORDER BY ?code_name ?field_order
