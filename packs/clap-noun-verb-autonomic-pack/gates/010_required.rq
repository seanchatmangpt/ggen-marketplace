# MESSAGE: every cnv-autonomic:Config node must contain the fields required to render a real autonomic.rs; any row is a refusal.
PREFIX cnv-autonomic: <https://clap-noun-verb.dev/ontology/autonomic#>
SELECT ?subject ?missing WHERE {
  ?subject a cnv-autonomic:Config .
  VALUES ?missing { cnv-autonomic:envPathVar cnv-autonomic:defaultRelativePath cnv-autonomic:fallbackFileName }
  FILTER NOT EXISTS { ?subject ?missing ?value }
}
ORDER BY ?subject ?missing
