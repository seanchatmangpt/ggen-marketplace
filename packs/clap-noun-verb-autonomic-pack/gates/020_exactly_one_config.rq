# MESSAGE: exactly one cnv-autonomic:Config individual must be admitted; any row (0 or >1 groups with count != 1) is a refusal.
PREFIX cnv-autonomic: <https://clap-noun-verb.dev/ontology/autonomic#>
SELECT (COUNT(?subject) AS ?count) WHERE {
  ?subject a cnv-autonomic:Config .
}
HAVING (COUNT(?subject) != 1)
