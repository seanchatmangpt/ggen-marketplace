@prefix cnv-autonomic: <https://clap-noun-verb.dev/ontology/autonomic#> .

# Synthetic consumer fixture: the one cnv-autonomic:Config a consuming project admits.
# Values are the documented examples from ontology.ttl.
<https://clap-noun-verb.dev/qualification/autonomic#config> a cnv-autonomic:Config ;
    cnv-autonomic:envPathVar "CLAP_NOUN_VERB_RECEIPT_PATH" ;
    cnv-autonomic:defaultRelativePath ".clap-noun-verb/receipts.jsonl" ;
    cnv-autonomic:fallbackFileName "clap-noun-verb-receipts.jsonl" ;
    cnv-autonomic:delegationEnvPathVar "CLAP_NOUN_VERB_DELEGATION_PATH" ;
    cnv-autonomic:delegationDefaultRelativePath ".clap-noun-verb/delegations.jsonl" ;
    cnv-autonomic:delegationFallbackFileName "clap-noun-verb-delegations.jsonl" .
