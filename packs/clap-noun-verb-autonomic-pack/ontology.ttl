# Vocabulary for cnv-autonomic:Config -- the one admitted individual a
# consuming project declares to generate its src/autonomic.rs. This pack
# ships no example individual of its own (FM-PACK-004 requires an
# ontology.ttl to exist, not that it populate one) -- the consuming
# project's own ontology.ttl supplies the real cnv-autonomic:Config.
@prefix cnv-autonomic: <https://clap-noun-verb.dev/ontology/autonomic#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cnv-autonomic:Config a rdfs:Class ;
    rdfs:comment "One consuming project's Autonomic Layer configuration -- the knobs clap-noun-verb-autonomic-pack's template substitutes into a generated src/autonomic.rs." .

cnv-autonomic:envPathVar a rdf:Property ;
    rdfs:domain cnv-autonomic:Config ;
    rdfs:comment "Environment variable name that overrides the receipt ledger's primary path (e.g. \"CLAP_NOUN_VERB_RECEIPT_PATH\")." .

cnv-autonomic:defaultRelativePath a rdf:Property ;
    rdfs:domain cnv-autonomic:Config ;
    rdfs:comment "Default cwd-relative path for the receipt ledger when envPathVar is unset (e.g. \".clap-noun-verb/receipts.jsonl\")." .

cnv-autonomic:fallbackFileName a rdf:Property ;
    rdfs:domain cnv-autonomic:Config ;
    rdfs:comment "File name used in the system temp directory when the primary path is unwritable (e.g. \"clap-noun-verb-receipts.jsonl\")." .
