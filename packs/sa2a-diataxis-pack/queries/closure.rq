PREFIX sa2a: <https://seanchatmangpt.github.io/sa2a/diataxis#>
SELECT ?capability WHERE {
  ?profile a sa2a:RepositoryProfile ; sa2a:exports ?capability .
  FILTER (
    NOT EXISTS { ?capability sa2a:learnedBy ?t } ||
    NOT EXISTS { ?capability sa2a:executedBy ?h } ||
    NOT EXISTS { ?capability sa2a:specifiedBy ?r } ||
    NOT EXISTS { ?capability sa2a:constrainedBy ?e } ||
    NOT EXISTS { ?capability sa2a:verifiedBy ?v } ||
    NOT EXISTS { ?capability sa2a:repairedBy ?x } ||
    NOT EXISTS { ?capability sa2a:evidencedBy ?p }
  )
}
ORDER BY ?capability
