@prefix sa2a: <https://seanchatmangpt.github.io/sa2a/diataxis#> .
@prefix pack: <https://seanchatmangpt.github.io/ggen/pack#> .

<urn:ggen:pack:sa2a-diataxis> a pack:Pack ;
  sa2a:version "26.9.29" ;
  sa2a:generator "ggen_igniter" .

<urn:ggen:capability:sa2a-diataxis-project> a sa2a:Capability ;
  sa2a:specifiedBy <https://github.com/seanchatmangpt/engineering-standards/tree/main/semantic/sa2a-diataxis> .

# Reference repository profile: the subject the manifest projection renders for qualification.
# It declares identity only. No Diataxis closure relations (learnedBy/executedBy/...) are asserted,
# so queries/closure.rq reports its capability as open rather than closed.
<urn:ggen:repository:ggen-marketplace> a sa2a:RepositoryProfile ;
  sa2a:repository "seanchatmangpt/ggen-marketplace" ;
  sa2a:role "reference-projection-subject" ;
  sa2a:exports <urn:ggen:capability:sa2a-diataxis-project> .
