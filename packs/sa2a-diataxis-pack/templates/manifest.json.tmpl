---
to: ".sa2a/manifest.json"
sparql:
  profile: |
    PREFIX sa2a: <https://seanchatmangpt.github.io/sa2a/diataxis#>
    SELECT ?repository ?role ?capability WHERE {
      ?p a sa2a:RepositoryProfile ;
        sa2a:repository ?repository ;
        sa2a:role ?role ;
        sa2a:exports ?capability .
    } ORDER BY ?repository ?capability
---
{
  "schema": "sa2a-diataxis/v1",
  "repository": "{{ profile[0].repository }}",
  "role": "{{ profile[0].role }}",
  "authority": ["engineering-standards/semantic/sa2a-diataxis"],
  "generator": "ggen-marketplace/sa2a-diataxis-pack",
  "capabilities": ["{{ profile[0].capability }}"],
  "generated_paths": [".sa2a/bootstrap", ".sa2a/manifest.json", ".sa2a/diataxis.ttl"]
}
