---
to: scripts/agent-preamble.sh
sparql:
  agents: |
    PREFIX fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#>
    SELECT ?name ?worktreePath WHERE {
      ?a a fleet:Agent ;
         fleet:name ?name ;
         fleet:worktreePath ?worktreePath .
    } ORDER BY ?name
---
{% raw %}#!/usr/bin/env bash
# GENERATED by `ggen sync` from packs/agent-fleet-isolation-pack
# (agent_preamble_sh.tmpl). MANDATORY first action for every dispatched
# agent: usage: scripts/agent-preamble.sh <agent-name>
#
# Runs the real cwd/toplevel/HEAD triple, compares the real toplevel
# against this agent's declared worktreePath (an ontology fact, not
# hand-maintained here), and appends a real fleet:CwdAssertion fact to
# evidence/ontology.ttl. This script judges nothing itself on mismatch
# beyond printing it loudly and exiting nonzero -- gates/040 is what
# refuses `ggen sync run` on a recorded mismatch, the same emit-facts /
# gate-facts split as ggen-verify-pack.
set -uo pipefail

agent_name="${1:?usage: agent-preamble.sh <agent-name>}"
{% endraw %}
declare -A EXPECTED_WORKTREE=(
{%- for row in agents %}
  ["{{ row.name }}"]="{{ row.worktreePath }}"
{%- endfor %}
)
{% raw %}
expected="${EXPECTED_WORKTREE[$agent_name]:-}"
if [ -z "$expected" ]; then
  echo "REFUSED: no fleet:Agent named '$agent_name' in the declared plan" >&2
  exit 1
fi

actual_pwd="$(pwd)"
actual_toplevel="$(git rev-parse --show-toplevel 2>/dev/null || echo "NOT_A_GIT_REPO")"
actual_head="$(git log -1 --oneline 2>/dev/null || echo "NO_HEAD")"

matches="false"
if [ "$actual_toplevel" = "$expected" ]; then
  matches="true"
else
  echo "MISMATCH: agent '$agent_name' expected worktree '$expected', actual toplevel '$actual_toplevel' (pwd '$actual_pwd')" >&2
fi

mkdir -p evidence
name_safe="$(echo "$agent_name" | tr -c 'a-zA-Z0-9_-' '_')"
cat >> evidence/ontology.ttl <<EOF
@prefix fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#> .
fleet:assertion-${name_safe} a fleet:CwdAssertion ;
    fleet:agentName "${agent_name}" ;
    fleet:actualToplevel "${actual_toplevel}" ;
    fleet:actualHeadOneline "${actual_head}" ;
    fleet:matchesAssigned ${matches} .
EOF

echo "agent '$agent_name' cwd assertion recorded: matchesAssigned=${matches}"
if [ "$matches" != "true" ]; then
  exit 1
fi
{% endraw %}
