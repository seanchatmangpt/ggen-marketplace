---
to: scripts/fleet-manifest.sh
sparql:
  agents: |
    PREFIX fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#>
    SELECT ?name ?assignedRepo ?worktreePath ?buildCacheDir WHERE {
      ?a a fleet:Agent ;
         fleet:name ?name ;
         fleet:assignedRepo ?assignedRepo ;
         fleet:worktreePath ?worktreePath ;
         fleet:buildCacheDir ?buildCacheDir .
    } ORDER BY ?name
---
{% raw %}#!/usr/bin/env bash
# GENERATED by `ggen sync` from packs/agent-fleet-isolation-pack
# (fleet_manifest_sh.tmpl). Creates one git worktree per declared
# fleet:Agent, at exactly the worktreePath/buildCacheDir the ontology
# declares -- these are ontology facts, not hand-maintained here. Refuses
# (rather than silently proceeding) if a target path already exists, since
# reusing a path defeats the isolation contract this pack enforces.
set -euo pipefail
{% endraw %}
{%- for row in agents %}
echo "=== agent: {{ row.name }} -> {{ row.assignedRepo }} ==="
if [ -e "{{ row.worktreePath }}" ]; then
  echo "REFUSED: worktreePath already exists: {{ row.worktreePath }}" >&2
  exit 1
fi
git -C "{{ row.assignedRepo }}" worktree add "{{ row.worktreePath }}"
mkdir -p "{{ row.buildCacheDir }}"
echo "  worktree:   {{ row.worktreePath }}"
echo "  buildCache: {{ row.buildCacheDir }}"
{% endfor -%}
{% raw %}echo "fleet manifest applied."
{% endraw %}
