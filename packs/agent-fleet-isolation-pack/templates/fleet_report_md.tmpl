---
to: FLEET_REPORT.md
sparql:
  agents: |
    PREFIX fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#>
    SELECT ?name ?assignedRepo ?worktreePath WHERE {
      ?a a fleet:Agent ;
         fleet:name ?name ;
         fleet:assignedRepo ?assignedRepo ;
         fleet:worktreePath ?worktreePath .
    } ORDER BY ?name
  assertions: |
    PREFIX fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#>
    SELECT ?agentName ?matchesAssigned WHERE {
      ?c a fleet:CwdAssertion ;
         fleet:agentName ?agentName ;
         fleet:matchesAssigned ?matchesAssigned .
    }
  jidoka: |
    PREFIX fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#>
    SELECT ?agentName ?reason ?resolved WHERE {
      ?j a fleet:JidokaStop ;
         fleet:agentName ?agentName ;
         fleet:reason ?reason .
      OPTIONAL { ?j fleet:resolved ?resolved }
    }
---
