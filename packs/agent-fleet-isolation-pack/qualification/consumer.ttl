@prefix fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#> .

# Synthetic green fixture for testing the pack's compile/gate semantics.
# Two agents, disjoint worktrees, disjoint build caches, both with a
# matching cwd assertion and no open jidoka stops -- must pass all 5 gates.

fleet:q-fleet a fleet:Fleet ;
    fleet:name "qualification-fleet" ;
    fleet:task "synthetic qualification fixture" .

fleet:q-agent-a a fleet:Agent ;
    fleet:name "agent-a" ;
    fleet:assignedRepo "/tmp/repo-a" ;
    fleet:worktreePath "/tmp/fleet-a" ;
    fleet:buildCacheDir "/tmp/fleet-a-cache" ;
    fleet:partOf fleet:q-fleet .

fleet:q-agent-b a fleet:Agent ;
    fleet:name "agent-b" ;
    fleet:assignedRepo "/tmp/repo-b" ;
    fleet:worktreePath "/tmp/fleet-b" ;
    fleet:buildCacheDir "/tmp/fleet-b-cache" ;
    fleet:partOf fleet:q-fleet .

fleet:q-assert-a a fleet:CwdAssertion ;
    fleet:agentName "agent-a" ;
    fleet:actualToplevel "/tmp/fleet-a" ;
    fleet:actualHeadOneline "abc1234 synthetic commit" ;
    fleet:matchesAssigned true .

fleet:q-assert-b a fleet:CwdAssertion ;
    fleet:agentName "agent-b" ;
    fleet:actualToplevel "/tmp/fleet-b" ;
    fleet:actualHeadOneline "def5678 synthetic commit" ;
    fleet:matchesAssigned true .
