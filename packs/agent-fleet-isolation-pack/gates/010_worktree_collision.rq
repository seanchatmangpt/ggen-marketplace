# MESSAGE: two fleet:Agent individuals declare the same fleet:worktreePath -- every agent must work in its OWN git worktree; give the colliding agent a distinct worktreePath before dispatch
PREFIX fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#>
SELECT ?worktreePath ?agentA ?agentB WHERE {
  ?a a fleet:Agent ; fleet:name ?agentA ; fleet:worktreePath ?worktreePath .
  ?b a fleet:Agent ; fleet:name ?agentB ; fleet:worktreePath ?worktreePath .
  FILTER(?agentA < ?agentB)
}
ORDER BY ?worktreePath ?agentA ?agentB
