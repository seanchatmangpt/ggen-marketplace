# MESSAGE: two fleet:Agent individuals declare the same fleet:buildCacheDir -- shared build caches produce lock contention and stale-artifact false positives; give the colliding agent a distinct buildCacheDir before dispatch
PREFIX fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#>
SELECT ?buildCacheDir ?agentA ?agentB WHERE {
  ?a a fleet:Agent ; fleet:name ?agentA ; fleet:buildCacheDir ?buildCacheDir .
  ?b a fleet:Agent ; fleet:name ?agentB ; fleet:buildCacheDir ?buildCacheDir .
  FILTER(?agentA < ?agentB)
}
ORDER BY ?buildCacheDir ?agentA ?agentB
