# MESSAGE: a declared fleet:Agent has no matching fleet:CwdAssertion -- the agent must run scripts/agent-preamble.sh as its FIRST action and let it emit the assertion before doing any other work; a missing assertion is a refusal, never a silent skip
PREFIX fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#>
SELECT ?agentName WHERE {
  ?a a fleet:Agent ; fleet:name ?agentName .
  FILTER NOT EXISTS {
    ?c a fleet:CwdAssertion ; fleet:agentName ?agentName .
  }
}
ORDER BY ?agentName
