# MESSAGE: an agent raised a jidoka stop that is still unresolved -- the fleet must not be reported done while any agent halted on ambiguity rather than guessing; resolve it (record fleet:resolved true and a fleet:resolution) or explicitly re-dispatch before closing the fleet
PREFIX fleet: <http://seanchatmangpt.github.io/packs/agent-fleet-isolation#>
SELECT ?agentName ?reason WHERE {
  ?j a fleet:JidokaStop ;
     fleet:agentName ?agentName ;
     fleet:reason ?reason .
  FILTER NOT EXISTS { ?j fleet:resolved true }
}
ORDER BY ?agentName
