# NEGATIVE fixture for gates/050_receipt_missing_field.rq (fires it, two
# branches). ex:claim1 asserts a receipt carrying identity, authority, replay
# and standing but NO consequence digest — a four-field artifact is not a
# receipt. ex:claim2 asserts nothing at all. Missing any one of the five
# fields: not a receipt.
@prefix ecap: <https://ggen.dev/ontology/evidence-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix aps: <https://w3id.org/chatman/aps#> .
@prefix ex: <https://example.test/ecap/> .

ex:claim1 a ecap:ReceiptClaim ;
    ecap:assertsReceipt ex:receipt1 .

ex:receipt1 a qce:QualificationReceipt ;
    qce:subjectCommit "0123456789abcdef0123456789abcdef01234567" ;
    qce:authorityDigest "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
    qce:replayReceipt ex:replay1 ;
    ecap:standing aps:PARTIAL_ALIVE .

ex:replay1 a qce:ReplayReceipt ;
    qce:replayDigest "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
    qce:replayVerified true .

ex:claim2 a ecap:ReceiptClaim .
