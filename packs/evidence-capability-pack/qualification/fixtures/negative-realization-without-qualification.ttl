# NEGATIVE fixture for gates/040_realization_without_qualification.rq (fires
# it). A realization with provider metadata but no version-pin policy, no
# qualification conditions, and no ceiling: an unqualified promotion of an
# implementation to a capability.
@prefix ecap: <https://ggen.dev/ontology/evidence-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/ecap/> .

ex:cap a ecap:Capability ;
    dcterms:identifier "Evidence.Corroborate" ;
    ecap:capabilityFamily "evidence" ;
    ecap:input "second-source observation" ;
    ecap:output "corroboration verdict" ;
    ecap:outcome ex:o ;
    ecap:authorityCeiling "observe" ;
    ecap:realization ex:r .

ex:o a ecap:Outcome ;
    ecap:outcomeKind "success" .

ex:r a ecap:Realization ;
    dcterms:identifier "corroborate-r" ;
    ecap:providerRepo "somewhere" ;
    ecap:bindingModule "Somewhere.Corroborate" ;
    ecap:sourceFile "lib/somewhere/corroborate.ex" .
