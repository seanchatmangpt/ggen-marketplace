# PASS witness for gates/010_pinned_capability_identity.rq: every pinned
# identifier is on a typed ecap:Capability individual, no duplicates.
@prefix ecap: <https://ggen.dev/ontology/evidence-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/ecap/> .

ex:establish a ecap:Capability ;
    dcterms:identifier "Evidence.Establish" .
ex:bind a ecap:Capability ;
    dcterms:identifier "Evidence.Bind" .
ex:sign a ecap:Capability ;
    dcterms:identifier "Receipt.Sign" .
ex:record a ecap:Capability ;
    dcterms:identifier "Provenance.Record" .
