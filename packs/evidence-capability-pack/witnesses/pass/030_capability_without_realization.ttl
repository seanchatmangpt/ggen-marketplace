# PASS witness for gates/030_capability_without_realization.rq: a complete
# capability backed by a qualified realization.
@prefix ecap: <https://ggen.dev/ontology/evidence-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/ecap/> .

ex:cap a ecap:Capability ;
    dcterms:identifier "Evidence.Bind" ;
    ecap:capabilityFamily "evidence" ;
    ecap:input "observation" ;
    ecap:output "bound evidence" ;
    ecap:outcome ex:o ;
    ecap:authorityCeiling "observe" ;
    ecap:realization ex:r .

ex:o a ecap:Outcome ;
    ecap:outcomeKind "success" .

ex:r a ecap:Realization ;
    dcterms:identifier "bind-r" ;
    ecap:authorityCeiling "observe" ;
    ecap:providerRepo "ash_graphlaw" ;
    ecap:bindingModule "AshGraphLaw.Evidence" ;
    ecap:sourceFile "lib/ash_graphlaw/evidence.ex" ;
    ecap:versionPinPolicy "pin by exact release tag" ;
    ecap:qualificationCondition "SHA-256 binding to the exact input digest" .
