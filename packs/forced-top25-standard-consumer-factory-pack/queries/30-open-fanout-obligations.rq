PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
PREFIX fts: <https://ggen.dev/ontology/forced-top25-standard-consumer#>
SELECT ?rank ?repo ?head ?state WHERE {
  ?t a fta:FanoutTarget ; fta:rank ?rank ; fta:repo ?repo ; fta:exactHead ?head ; fta:compatibilityState ?state .
  FILTER(?state = "COMPATIBLE_READY" || ?state = "COMPATIBLE_NOT_READY")
  FILTER NOT EXISTS { ?t fts:mergedToDefault true }
}
ORDER BY ?rank ?repo
