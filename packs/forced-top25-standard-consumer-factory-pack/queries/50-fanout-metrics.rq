PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
PREFIX fts: <https://ggen.dev/ontology/forced-top25-standard-consumer#>
SELECT ?repo ?compat ?fanout ?qualification WHERE {
  ?t a fta:FanoutTarget ; fta:repo ?repo ; fta:compatibilityState ?compat .
  OPTIONAL { ?t fts:fanoutState ?fanout }
  OPTIONAL { ?t fta:qualificationState ?qualification }
}
ORDER BY ?repo
