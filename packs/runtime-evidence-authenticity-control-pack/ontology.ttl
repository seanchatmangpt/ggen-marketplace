@prefix reac: <https://chatman.ai/ontology/runtime-evidence-authenticity-control#> .
@prefix rea: <https://chatman.ai/ontology/runtime-evidence-authenticity#> .

# Identity, evidence, receipt and authority vocabulary is single-owner: it is
# declared by the canonical runtime-evidence-authenticity-pack (rea:). This
# control pack only USES those terms (FM-PACK-003: RDF needs no imports to use
# a term) and declares its genuine control vocabulary below (reac:).
reac:RuntimeEvidenceAuthenticityControlPack a reac:ControlPack ; rea:authority "SELECT|CONSTRUCT|VERIFY" ; rea:consequentialDo "BRCE_ONLY" ; rea:requiresExactSubject true .
reac:AuthenticityMeasurement a rea:EvidenceClass .
reac:AdmissionPolicy a reac:PolicyClass .
reac:ControlDecision a reac:DecisionClass .
reac:ControlReceipt a rea:ReceiptClass .
reac:generation a rea:IdentityProperty .
reac:authenticityRate a reac:MetricProperty .
reac:falseAuthenticUpper a reac:MetricProperty .
reac:independentRoots a reac:MetricProperty .
reac:ownerState a reac:StandingProperty .
