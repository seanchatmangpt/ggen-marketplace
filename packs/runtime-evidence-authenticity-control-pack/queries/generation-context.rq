PREFIX reac: <https://chatman.ai/ontology/runtime-evidence-authenticity-control#>
SELECT ?subject ?generation ?standing ?reason WHERE {
  ?measurement a reac:AuthenticityMeasurement .
  OPTIONAL { ?measurement reac:subjectSha ?sha . }
  OPTIONAL { ?measurement reac:generation ?generation0 . }
  OPTIONAL { ?measurement reac:ownerState ?owner . }
  BIND(COALESCE(?sha, "UNKNOWN") AS ?subject)
  BIND(COALESCE(?generation0, 0) AS ?generation)
  BIND(COALESCE(?owner, "UNKNOWN") AS ?standing)
  BIND("generated from admitted authenticity measurement" AS ?reason)
}
ORDER BY ?subject ?generation
