PREFIX reac: <https://chatman.ai/ontology/runtime-evidence-authenticity-control#>
SELECT ?m ?rate ?upper ?roots WHERE { ?m a reac:AuthenticityMeasurement ; reac:authenticityRate ?rate ; reac:falseAuthenticUpper ?upper ; reac:independentRoots ?roots . FILTER(?rate>=0.0 && ?rate<=1.0 && ?upper>=0.0 && ?upper<=1.0 && ?roots>=1) } ORDER BY DESC(?rate) ?upper
