---
to: "docs/strategy/VALUE_INNOVATION_ERRC.md"
sparql:
  grids: |
    PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?grid ?title ?domain ?subject ?complete WHERE {
      ?grid a vi:StrategyGrid ;
            dcterms:title ?title ;
            vi:domain ?domain ;
            vi:subject ?subject ;
            vi:complete ?complete .
    }
    ORDER BY ?title
  findings: |
    PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?grid ?order ?action ?factor ?baseline ?target ?rationale ?owner ?consumer ?metric WHERE {
      ?finding a vi:Finding ;
               vi:grid ?grid ;
               vi:action ?actionNode ;
               vi:factor ?factorNode ;
               vi:baseline ?baseline ;
               vi:target ?target ;
               vi:rationale ?rationale ;
               vi:owner ?owner ;
               vi:consumer ?consumer .
      ?actionNode skos:prefLabel ?action ; vi:actionOrder ?order .
      ?factorNode rdfs:label ?factor .
      OPTIONAL { ?finding vi:metric ?metric }
    }
    ORDER BY ?grid ?order ?factor
  hypotheses: |
    PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
    SELECT ?grid ?value ?waste ?test WHERE {
      ?grid vi:hypothesis ?h .
      ?h vi:valueRaised ?value ; vi:wasteReduced ?waste ; vi:test ?test .
    }
