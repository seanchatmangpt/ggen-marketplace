# MESSAGE: VALUE_INNOVATION_PARETO_REQUIRED -- Pareto claims require finding, witness, invariant and at least one delta
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
SELECT ?claim ?missing WHERE {
  ?claim a vi:ParetoClaim .
  VALUES (?property ?missing) {
    (vi:forFinding "forFinding")
    (vi:witness "witness")
    (vi:protectsInvariant "protectsInvariant")
    (vi:hasDelta "hasDelta")
  }
  FILTER NOT EXISTS { ?claim ?property ?value }
}
