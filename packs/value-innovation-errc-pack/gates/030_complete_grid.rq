# MESSAGE: VALUE_INNOVATION_ERRC_GRID_INCOMPLETE -- a grid marked complete must cover all four actions
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
SELECT ?grid ?missingAction WHERE {
  ?grid a vi:StrategyGrid ; vi:complete true .
  VALUES (?missingAction) { (vi:Eliminate) (vi:Reduce) (vi:Raise) (vi:Create) }
  FILTER NOT EXISTS {
    ?finding a vi:Finding ; vi:grid ?grid ; vi:action ?missingAction .
  }
}
