# MESSAGE: VALUE_INNOVATION_CANVAS_BASELINE_NOT_UNIQUE
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
SELECT ?canvas WHERE { ?a a vi:ValueCurve ; vi:canvas ?canvas ; vi:curveRole vi:BaselineCurve . ?b a vi:ValueCurve ; vi:canvas ?canvas ; vi:curveRole vi:BaselineCurve . FILTER (?a != ?b) }