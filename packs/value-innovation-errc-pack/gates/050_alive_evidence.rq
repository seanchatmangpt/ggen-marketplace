# MESSAGE: VALUE_INNOVATION_ERRC_ALIVE_UNPROVEN -- ALIVE standing requires a verified evidence reference
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
SELECT ?subject WHERE {
  ?subject vi:standing vi:Alive .
  FILTER NOT EXISTS {
    ?subject vi:evidenceRef ?evidence .
    ?evidence vi:verified true .
  }
}
