# MESSAGE: VALUE_INNOVATION_ERRC_REQUIRED -- every ERRC finding must be bounded, owned and falsifiable
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
SELECT ?finding ?missing WHERE {
  ?finding a vi:Finding .
  VALUES (?property ?missing) {
    (vi:grid "grid")
    (vi:action "action")
    (vi:factor "factor")
    (vi:baseline "baseline")
    (vi:target "target")
    (vi:rationale "rationale")
    (vi:owner "owner")
    (vi:consumer "consumer")
    (vi:evidenceObligation "evidenceObligation")
    (vi:falsifier "falsifier")
    (vi:directActuation "directActuation")
  }
  FILTER NOT EXISTS { ?finding ?property ?value }
}
