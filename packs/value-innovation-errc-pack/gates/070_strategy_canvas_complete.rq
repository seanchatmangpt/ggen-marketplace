# MESSAGE: VALUE_INNOVATION_STRATEGY_CANVAS_INCOMPLETE -- a complete canvas needs baseline and target curves
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
SELECT ?canvas ?missingRole WHERE {
  ?canvas a vi:StrategyCanvas ; vi:complete true .
  VALUES ?missingRole { vi:BaselineCurve vi:TargetCurve }
  FILTER NOT EXISTS {
    ?curve a vi:ValueCurve ; vi:canvas ?canvas ; vi:curveRole ?missingRole .
  }
}
