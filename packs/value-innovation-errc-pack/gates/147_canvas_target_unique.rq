# MESSAGE: VALUE_INNOVATION_CANVAS_TARGET_NOT_UNIQUE
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
SELECT ?canvas WHERE { ?a a vi:ValueCurve ; vi:canvas ?canvas ; vi:curveRole vi:TargetCurve . ?b a vi:ValueCurve ; vi:canvas ?canvas ; vi:curveRole vi:TargetCurve . FILTER (?a != ?b) }