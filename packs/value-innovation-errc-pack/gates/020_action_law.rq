# MESSAGE: VALUE_INNOVATION_ERRC_ACTION_REFUSED -- findings may use only the four canonical ERRC actions
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
SELECT ?finding ?action WHERE {
  ?finding a vi:Finding ; vi:action ?action .
  FILTER (?action NOT IN (vi:Eliminate, vi:Reduce, vi:Raise, vi:Create))
}
