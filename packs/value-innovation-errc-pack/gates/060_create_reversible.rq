# MESSAGE: VALUE_INNOVATION_ERRC_CREATE_IRREVERSIBLE -- Create findings must remain explicitly reversible proposals
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
SELECT ?finding WHERE {
  ?finding a vi:Finding ; vi:action vi:Create .
  FILTER NOT EXISTS { ?finding vi:reversibleProposal true }
}
