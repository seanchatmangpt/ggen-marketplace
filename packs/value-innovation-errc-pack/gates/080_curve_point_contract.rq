# MESSAGE: VALUE_INNOVATION_CURVE_POINT_REFUSED -- curve points require curve/factor and a numeric 0..10 offering level
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
SELECT ?point ?reason WHERE {
  ?point a vi:CurvePoint .
  {
    FILTER NOT EXISTS { ?point vi:curve ?curve }
    BIND("curve" AS ?reason)
  } UNION {
    FILTER NOT EXISTS { ?point vi:factor ?factor }
    BIND("factor" AS ?reason)
  } UNION {
    FILTER NOT EXISTS { ?point vi:offeringLevel ?level }
    BIND("offeringLevel" AS ?reason)
  } UNION {
    ?point vi:offeringLevel ?level .
    FILTER (!isNumeric(?level) || ?level < 0 || ?level > 10)
    BIND("offeringLevelRange" AS ?reason)
  }
}
