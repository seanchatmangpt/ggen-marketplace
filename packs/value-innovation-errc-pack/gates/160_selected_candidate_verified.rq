# MESSAGE: VALUE_INNOVATION_SELECTED_CANDIDATE_NOT_VERIFIED
PREFIX vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#>
PREFIX cmd: <https://chatmangpt.com/ontology/cmd#>
SELECT ?finding ?candidate WHERE { ?finding a vi:Finding ; vi:selectedCandidate ?candidate . FILTER NOT EXISTS { ?candidate a cmd:Candidate ; cmd:standing "VERIFIED" } }