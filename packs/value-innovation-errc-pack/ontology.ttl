@prefix vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Domain-neutral ERRC / value-innovation kernel.
# This vocabulary generalizes the evidence discipline first proven by
# gh-actions-errc-pack without inheriting that pack's GitHub Actions subject boundary.

vi:StrategyGrid a rdfs:Class ;
  rdfs:label "ERRC strategy grid" .
vi:Finding a rdfs:Class ;
  rdfs:label "Evidence-bounded ERRC finding" .
vi:Action a rdfs:Class, skos:Concept ;
  rdfs:label "ERRC action" .
vi:Factor a rdfs:Class ;
  rdfs:label "Factor whose value or presence is intentionally changed" .
vi:EvidenceObligation a rdfs:Class ;
  rdfs:label "Evidence required before a proposed value-innovation consequence may claim standing" .
vi:Falsifier a rdfs:Class ;
  rdfs:label "Observation that would falsify the finding or its claimed consequence" .
vi:DecisionReceipt a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Replayable receipt for one admitted ERRC decision set" .
vi:ValueInnovationHypothesis a rdfs:Class ;
  rdfs:label "Hypothesis that the admitted ERRC set raises stakeholder value while reducing avoidable cost, friction, risk or complexity" .

vi:Eliminate a vi:Action ; skos:prefLabel "Eliminate" ; vi:actionOrder 1 .
vi:Reduce a vi:Action ; skos:prefLabel "Reduce" ; vi:actionOrder 2 .
vi:Raise a vi:Action ; skos:prefLabel "Raise" ; vi:actionOrder 3 .
vi:Create a vi:Action ; skos:prefLabel "Create" ; vi:actionOrder 4 .

vi:grid a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:StrategyGrid .
vi:action a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:Action .
vi:factor a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:Factor .
vi:baseline a rdf:Property ; rdfs:domain vi:Finding .
vi:target a rdf:Property ; rdfs:domain vi:Finding .
vi:rationale a rdf:Property ; rdfs:domain vi:Finding .
vi:owner a rdf:Property ; rdfs:domain vi:Finding .
vi:consumer a rdf:Property ; rdfs:domain vi:Finding .
vi:evidenceObligation a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:EvidenceObligation .
vi:falsifier a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:Falsifier .
vi:metric a rdf:Property ; rdfs:domain vi:Finding .
vi:priority a rdf:Property ; rdfs:domain vi:Finding .
vi:complete a rdf:Property ; rdfs:domain vi:StrategyGrid ; rdfs:range xsd:boolean .
vi:subject a rdf:Property ; rdfs:domain vi:StrategyGrid .
vi:domain a rdf:Property ; rdfs:domain vi:StrategyGrid .
vi:directActuation a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range xsd:boolean .
vi:reversibleProposal a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range xsd:boolean .
vi:standing a rdf:Property .
vi:evidenceRef a rdf:Property .
vi:verified a rdf:Property ; rdfs:range xsd:boolean .
vi:supersedes a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:Finding .
vi:actionOrder a rdf:Property ; rdfs:domain vi:Action ; rdfs:range xsd:integer .
vi:replayCommand a rdf:Property ; rdfs:domain vi:DecisionReceipt .
vi:digest a rdf:Property ; rdfs:domain vi:DecisionReceipt .
vi:digestAlgorithm a rdf:Property ; rdfs:domain vi:DecisionReceipt .
vi:forGrid a rdf:Property ; rdfs:domain vi:DecisionReceipt ; rdfs:range vi:StrategyGrid .
vi:hypothesis a rdf:Property ; rdfs:domain vi:StrategyGrid ; rdfs:range vi:ValueInnovationHypothesis .
vi:valueRaised a rdf:Property ; rdfs:domain vi:ValueInnovationHypothesis .
vi:wasteReduced a rdf:Property ; rdfs:domain vi:ValueInnovationHypothesis .
vi:test a rdf:Property ; rdfs:domain vi:ValueInnovationHypothesis .

# Standing vocabulary. Consumer ontologies may add domain-specific states, but these
# generic states provide a portable floor for decision evidence.
vi:Proposed a skos:Concept ; skos:prefLabel "PROPOSED" .
vi:PartialAlive a skos:Concept ; skos:prefLabel "PARTIAL_ALIVE" .
vi:Alive a skos:Concept ; skos:prefLabel "ALIVE" .
vi:Refused a skos:Concept ; skos:prefLabel "REFUSED" .

# Kernel law: ERRC selects and constructs strategy consequences. It does not own DO.
vi:ERRCAuthorityLaw a prov:Entity ;
  dcterms:title "ERRC is SELECT/CONSTRUCT, never ambient DO" ;
  dcterms:description "Every Create finding is a reversible proposal until a separate authorized actuator accepts it. Evidence can promote standing; strategy authorship cannot self-authorize execution." .

# Kernel law: a complete grid has coverage of all four actions. This is a completeness
# statement about the decision exercise, not an assertion that every action must contain
# the same number of findings or that every finding is accepted for execution.
vi:ERRCCompletenessLaw a prov:Entity ;
  dcterms:title "Complete grids cover Eliminate, Reduce, Raise and Create" .

# Kernel law: value innovation is falsifiable. A strategy grid may link one hypothesis;
# consumer-specific evidence must establish whether value actually rose and waste fell.
vi:ValueInnovationLaw a prov:Entity ;
  dcterms:title "Value innovation requires a falsifiable value/waste hypothesis" .

# ── v0.2 strategy-canvas + Pareto + DfCM composition ─────────────────────────
# W3C RDF Data Cube gives the strategy canvas a public observation model.
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix cmd: <https://chatmangpt.com/ontology/cmd#> .

vi:StrategyCanvas a rdfs:Class ;
  rdfs:subClassOf qb:DataSet ;
  rdfs:label "Evidence-bounded strategy canvas" ;
  rdfs:comment "A comparable set of baseline and target value curves across strategic factors." .

vi:ValueCurve a rdfs:Class ;
  rdfs:label "Value curve" .

vi:CurvePoint a rdfs:Class ;
  rdfs:subClassOf qb:Observation ;
  rdfs:label "One factor/curve offering-level observation" .

vi:ParetoClaim a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Evidence-bounded claim that a proposal dominates its baseline on protected dimensions" .

vi:ParetoDelta a rdfs:Class ;
  rdfs:label "One dimension delta contributing to a Pareto claim" .

vi:ProtectedInvariant a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Invariant that a strategy proposal may not worsen without explicit refusal/re-admission" .

vi:EvidenceWitness a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Witness supporting a strategic delta or dominance claim" .

vi:BaselineCurve a skos:Concept ; skos:prefLabel "Baseline" .
vi:TargetCurve a skos:Concept ; skos:prefLabel "Target" .
vi:Better a skos:Concept ; skos:prefLabel "BETTER" .
vi:Same a skos:Concept ; skos:prefLabel "SAME" .
vi:Worse a skos:Concept ; skos:prefLabel "WORSE" .

vi:canvas a rdf:Property ; rdfs:domain vi:ValueCurve ; rdfs:range vi:StrategyCanvas .
vi:curve a rdf:Property ; rdfs:domain vi:CurvePoint ; rdfs:range vi:ValueCurve .
vi:curveRole a rdf:Property ; rdfs:domain vi:ValueCurve ; rdfs:range skos:Concept .
vi:offeringLevel a rdf:Property ; rdfs:domain vi:CurvePoint ; rdfs:range xsd:decimal .
vi:strategyCanvas a rdf:Property ; rdfs:domain vi:StrategyGrid ; rdfs:range vi:StrategyCanvas .

vi:paretoClaim a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:ParetoClaim .
vi:forFinding a rdf:Property ; rdfs:domain vi:ParetoClaim ; rdfs:range vi:Finding .
vi:hasDelta a rdf:Property ; rdfs:domain vi:ParetoClaim ; rdfs:range vi:ParetoDelta .
vi:dimension a rdf:Property ; rdfs:domain vi:ParetoDelta .
vi:direction a rdf:Property ; rdfs:domain vi:ParetoDelta ; rdfs:range skos:Concept .
vi:protected a rdf:Property ; rdfs:domain vi:ParetoDelta ; rdfs:range xsd:boolean .
vi:witness a rdf:Property ; rdfs:range vi:EvidenceWitness .
vi:protectsInvariant a rdf:Property ; rdfs:domain vi:ParetoClaim ; rdfs:range vi:ProtectedInvariant .

# Optional DfCM composition. The value-innovation kernel does not duplicate CMD
# DesignSpace/Candidate semantics; consumers may link admitted selection evidence.
vi:designSpace a rdf:Property ; rdfs:domain vi:StrategyGrid ; rdfs:range cmd:DesignSpace .
vi:selectedCandidate a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range cmd:Candidate .

vi:CreateReversibilityLaw a prov:Entity ;
  dcterms:title "Create remains a reversible proposal" ;
  dcterms:description "A Create finding must explicitly assert reversibleProposal true; construction cannot smuggle irreversible DO authority into strategy." .

vi:StrategyCanvasLaw a prov:Entity ;
  dcterms:title "Complete strategy canvases contain baseline and target value curves" ;
  dcterms:description "Every complete canvas has both curve roles and each curve point is a bounded 0..10 observation linked to a factor." .

vi:ParetoEvidenceLaw a prov:Entity ;
  dcterms:title "Pareto claims require witnesses, protected dimensions, and at least one improvement" ;
  dcterms:description "A Pareto claim is refused if a protected delta is worse, if no delta is better, or if the claim lacks an evidence witness." .

vi:DfCMCompositionLaw a prov:Entity ;
  dcterms:title "ERRC selection may reference CMD candidates without absorbing CMD authority" ;
  dcterms:description "Strategy can select a verified reversible candidate from a CMD design space, but candidate verification and actuation remain governed by the CMD pack." .
