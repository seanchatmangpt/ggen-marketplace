@prefix vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Domain-neutral ERRC / value-innovation kernel.
# This vocabulary generalizes the evidence discipline first proven by
# gh-actions-errc-pack without inheriting that pack's GitHub Actions subject boundary.

vi:StrategyGrid a rdfs:Class ;
  rdfs:subClassOf prov:Plan ;
  rdfs:label "ERRC strategy grid" .
vi:Finding a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Evidence-bounded ERRC finding" .
vi:Action a rdfs:Class, skos:Concept ;
  rdfs:label "ERRC action" .
vi:Factor a rdfs:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "Factor whose value or presence is intentionally changed" .
vi:EvidenceObligation a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Evidence required before a proposed value-innovation consequence may claim standing" .
vi:Falsifier a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Observation that would falsify the finding or its claimed consequence" .
vi:DecisionReceipt a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Replayable receipt for one admitted ERRC decision set" .
vi:ValueInnovationHypothesis a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Hypothesis that the admitted ERRC set raises stakeholder value while reducing avoidable cost, friction, risk or complexity" .

vi:ERRCActions a skos:ConceptScheme ;
  dcterms:title "Eliminate Reduce Raise Create" .
vi:Eliminate a vi:Action ; skos:inScheme vi:ERRCActions ; skos:prefLabel "Eliminate" ; vi:actionOrder 1 .
vi:Reduce a vi:Action ; skos:inScheme vi:ERRCActions ; skos:prefLabel "Reduce" ; vi:actionOrder 2 .
vi:Raise a vi:Action ; skos:inScheme vi:ERRCActions ; skos:prefLabel "Raise" ; vi:actionOrder 3 .
vi:Create a vi:Action ; skos:inScheme vi:ERRCActions ; skos:prefLabel "Create" ; vi:actionOrder 4 .

vi:grid a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:StrategyGrid .
vi:action a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:Action .
vi:factor a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:Factor .
vi:baseline a rdf:Property ; rdfs:domain vi:Finding .
vi:target a rdf:Property ; rdfs:domain vi:Finding .
# Optional normalized 0..10 strategy-canvas levels. Consumers that supply one
# must supply both; the native directionality court checks their ERRC meaning.
vi:baselineLevel a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range xsd:decimal .
vi:targetLevel a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range xsd:decimal .
vi:rationale a rdf:Property ; rdfs:domain vi:Finding ; rdfs:subPropertyOf dcterms:description .
vi:owner a rdf:Property ; rdfs:domain vi:Finding ; rdfs:subPropertyOf dcterms:contributor .
vi:consumer a rdf:Property ; rdfs:domain vi:Finding .
vi:evidenceObligation a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:EvidenceObligation ; rdfs:subPropertyOf prov:wasDerivedFrom .
vi:falsifier a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:Falsifier .
vi:metric a rdf:Property ; rdfs:domain vi:Finding .
vi:priority a rdf:Property ; rdfs:domain vi:Finding .
vi:complete a rdf:Property ; rdfs:domain vi:StrategyGrid ; rdfs:range xsd:boolean .
vi:subject a rdf:Property ; rdfs:domain vi:StrategyGrid ; rdfs:subPropertyOf dcterms:subject .
vi:domain a rdf:Property ; rdfs:domain vi:StrategyGrid .
vi:directActuation a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range xsd:boolean .
vi:reversibleProposal a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range xsd:boolean .
vi:standing a rdf:Property .
vi:evidenceRef a rdf:Property ; rdfs:subPropertyOf prov:wasDerivedFrom .
vi:verified a rdf:Property ; rdfs:range xsd:boolean .
vi:supersedes a rdf:Property ; rdfs:domain vi:Finding ; rdfs:range vi:Finding ; rdfs:subPropertyOf prov:wasRevisionOf .
vi:actionOrder a rdf:Property ; rdfs:domain vi:Action ; rdfs:range xsd:integer .
vi:replayCommand a rdf:Property ; rdfs:domain vi:DecisionReceipt .
vi:digest a rdf:Property ; rdfs:domain vi:DecisionReceipt ; rdfs:subPropertyOf dcterms:identifier .
vi:digestAlgorithm a rdf:Property ; rdfs:domain vi:DecisionReceipt .
vi:forGrid a rdf:Property ; rdfs:domain vi:DecisionReceipt ; rdfs:range vi:StrategyGrid ; rdfs:subPropertyOf prov:wasDerivedFrom .
vi:hypothesis a rdf:Property ; rdfs:domain vi:StrategyGrid ; rdfs:range vi:ValueInnovationHypothesis .
vi:valueRaised a rdf:Property ; rdfs:domain vi:ValueInnovationHypothesis .
vi:wasteReduced a rdf:Property ; rdfs:domain vi:ValueInnovationHypothesis .
vi:test a rdf:Property ; rdfs:domain vi:ValueInnovationHypothesis .

# Standing vocabulary. Consumer ontologies may add domain-specific states, but these
# generic states provide a portable floor for decision evidence.
vi:Standing a skos:ConceptScheme ; dcterms:title "ERRC standing" .
vi:Proposed a skos:Concept ; skos:inScheme vi:Standing ; skos:prefLabel "PROPOSED" .
vi:PartialAlive a skos:Concept ; skos:inScheme vi:Standing ; skos:prefLabel "PARTIAL_ALIVE" .
vi:Alive a skos:Concept ; skos:inScheme vi:Standing ; skos:prefLabel "ALIVE" .
vi:Refused a skos:Concept ; skos:inScheme vi:Standing ; skos:prefLabel "REFUSED" .

# Kernel law: ERRC selects and constructs strategy consequences. It does not own DO.
vi:ERRCAuthorityLaw a prov:Entity ;
  dcterms:title "ERRC is SELECT/CONSTRUCT, never ambient DO" ;
  dcterms:description "Every Create finding is a reversible proposal until a separate authorized actuator accepts it. Evidence can promote standing; strategy authorship cannot self-authorize execution." .

# Kernel law: a complete grid has coverage of all four actions. This is a completeness
# statement about the decision exercise, not an assertion that every action must contain
# the same number of findings or that every finding is accepted for execution.
vi:ERRCCompletenessLaw a prov:Entity ;
  dcterms:title "Complete grids cover Eliminate, Reduce, Raise and Create" .

# Kernel law: value innovation is falsifiable. A strategy grid may link one hypothesis;
# consumer-specific evidence must establish whether value actually rose and waste fell.
vi:ValueInnovationLaw a prov:Entity ;
  dcterms:title "Value innovation requires a falsifiable value/waste hypothesis" .

# Optional quantitative strategy-canvas law. The normalized levels are not required
# for qualitative ERRC, but when present they must obey Eliminate/Reduce/Raise/Create
# directionality and remain a reversible planning projection.
vi:StrategyCanvasLaw a prov:Entity ;
  dcterms:title "Normalized ERRC levels preserve directional meaning" ;
  dcterms:description "Eliminate drives a positive baseline to zero; Reduce lowers it; Raise increases it; Create starts at zero and establishes a positive target." .
