@prefix ex: <https://example.org/errc/> .
@prefix vi: <http://seanchatmangpt.github.io/packs/value-innovation-errc#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:grid a vi:StrategyGrid ;
  dcterms:title "Marketplace qualification ERRC" ;
  vi:domain "software manufacturing" ;
  vi:subject "reusable strategy manufacture" ;
  vi:complete true ;
  vi:hypothesis ex:hypothesis .

ex:hypothesis a vi:ValueInnovationHypothesis ;
  vi:valueRaised "More reusable evidence-bound strategy" ;
  vi:wasteReduced "Less duplicated hand-authored strategy logic" ;
  vi:test "Generated grid replays deterministically and all native courts admit it" .

ex:factor-eliminate a vi:Factor ; rdfs:label "Duplicate strategy documents" .
ex:factor-reduce a vi:Factor ; rdfs:label "Bespoke strategy logic" .
ex:factor-raise a vi:Factor ; rdfs:label "Evidence and replay coverage" .
ex:factor-create a vi:Factor ; rdfs:label "Marketplace-native ERRC manufacture" .

ex:evidence-eliminate a vi:EvidenceObligation ; dcterms:description "Inventory duplicate projections and their canonical sources" .
ex:evidence-reduce a vi:EvidenceObligation ; dcterms:description "Measure consumer-specific logic remaining after pack adoption" .
ex:evidence-raise a vi:EvidenceObligation ; dcterms:description "Verify exact-subject receipts and replay" .
ex:evidence-create a vi:EvidenceObligation ; dcterms:description "Execute ggen against the marketplace pack in a real consumer" .

ex:falsifier-eliminate a vi:Falsifier ; dcterms:description "A removed document is the only authoritative source" .
ex:falsifier-reduce a vi:Falsifier ; dcterms:description "Generic packing increases consumer-specific code" .
ex:falsifier-raise a vi:Falsifier ; dcterms:description "Standing is promoted without observed evidence" .
ex:falsifier-create a vi:Falsifier ; dcterms:description "A consumer cannot reproduce the projection from RDF" .

ex:eliminate a vi:Finding ;
  vi:grid ex:grid ; vi:action vi:Eliminate ; vi:factor ex:factor-eliminate ;
  vi:baseline "multiple hand-maintained copies" ; vi:target "none" ;
  vi:baselineLevel "7"^^xsd:decimal ; vi:targetLevel "0"^^xsd:decimal ;
  vi:rationale "Remove duplicated projections when canonical semantics already exist" ;
  vi:owner "platform architecture" ; vi:consumer "ggen consumer" ;
  vi:evidenceObligation ex:evidence-eliminate ; vi:falsifier ex:falsifier-eliminate ;
  vi:metric "duplicate authoritative projections" ;
  vi:directActuation false ; vi:reversibleProposal true ; vi:standing vi:Proposed .

ex:reduce a vi:Finding ;
  vi:grid ex:grid ; vi:action vi:Reduce ; vi:factor ex:factor-reduce ;
  vi:baseline "domain-specific orchestration" ; vi:target "thin domain facts" ;
  vi:baselineLevel "8"^^xsd:decimal ; vi:targetLevel "3"^^xsd:decimal ;
  vi:rationale "Move reusable strategy calculus into the marketplace while retaining domain facts in consumers" ;
  vi:owner "pack maintainer" ; vi:consumer "application team" ;
  vi:evidenceObligation ex:evidence-reduce ; vi:falsifier ex:falsifier-reduce ;
  vi:metric "consumer-specific strategy code" ;
  vi:directActuation false ; vi:reversibleProposal true ; vi:standing vi:Proposed .

ex:raise a vi:Finding ;
  vi:grid ex:grid ; vi:action vi:Raise ; vi:factor ex:factor-raise ;
  vi:baseline "informal validation" ; vi:target "exact-subject courts and receipts" ;
  vi:baselineLevel "4"^^xsd:decimal ; vi:targetLevel "9"^^xsd:decimal ;
  vi:rationale "Increase evidence density and replayability before strategic standing is promoted" ;
  vi:owner "verification court" ; vi:consumer "decision maker" ;
  vi:evidenceObligation ex:evidence-raise ; vi:falsifier ex:falsifier-raise ;
  vi:metric "evidence-backed decisions" ;
  vi:directActuation false ; vi:reversibleProposal true ; vi:standing vi:Proposed .

ex:create a vi:Finding ;
  vi:grid ex:grid ; vi:action vi:Create ; vi:factor ex:factor-create ;
  vi:baseline "absent" ; vi:target "reusable ontology-first ERRC pack" ;
  vi:baselineLevel "0"^^xsd:decimal ; vi:targetLevel "10"^^xsd:decimal ;
  vi:rationale "Manufacture ERRC projections from portable graph facts instead of rebuilding the method per repository" ;
  vi:owner "ggen marketplace" ; vi:consumer "cross-domain software factory" ;
  vi:evidenceObligation ex:evidence-create ; vi:falsifier ex:falsifier-create ;
  vi:metric "successful external consumers" ;
  vi:directActuation false ; vi:reversibleProposal true ; vi:standing vi:Proposed .
