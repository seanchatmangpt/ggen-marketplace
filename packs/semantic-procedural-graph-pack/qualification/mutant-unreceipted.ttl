@prefix spg: <https://seanchatmangpt.github.io/ggen-marketplace/spg#> .

_:a a spg:Node ; spg:nodeId "a" ; spg:nodeClass spg:SELECT ; spg:capability "select" .
_:b a spg:Node ; spg:nodeId "b" ; spg:nodeClass spg:DO ; spg:capability "do" .

_:bad a spg:Edge ;
  spg:edgeId "bad" ;
  spg:from _:a ;
  spg:to _:b ;
  spg:relation spg:TRIGGERS ;
  spg:guard "always" ;
  spg:evidenceRequired "candidate" ;
  spg:authorityRequired "NONE" ;
  spg:consequence spg:Consequential ;
  spg:receiptRequired false .
