@prefix ex:  <https://ggen.dev/qualification/spg#> .
@prefix spg: <https://ggen.dev/ontology/semantic-procedural-graph#> .

ex:g a spg:ProcedureGraph ;
  spg:state "CANDIDATE" ;
  spg:standing "NONE" ;
  spg:hasNode ex:observe, ex:actuate ;
  spg:hasEdge ex:e1 .

ex:observe a spg:ProcedureNode .
ex:actuate a spg:ProcedureNode .

ex:e1 a spg:ProcedureEdge ;
  spg:sourceNode ex:observe ;
  spg:targetNode ex:actuate ;
  spg:relation "TRIGGERS" ;
  spg:guard "command.admitted" ;
  spg:evidenceRequirement "authority-grant" ;
  spg:evidenceRequirement "admission-receipt" ;
  spg:authorityRequirement "BRCE_GRANT" ;
  spg:consequenceClass "consequential" ;
  spg:receiptRequired true ;
  spg:falsifier "actuation occurs without admitted authority or a consequence receipt" .
