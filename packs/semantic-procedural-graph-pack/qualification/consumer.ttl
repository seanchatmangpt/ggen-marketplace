@prefix spg: <https://seanchatmangpt.github.io/ggen-marketplace/spg#> .
@prefix pa: <https://seanchatmangpt.github.io/ggen-marketplace/prior-art#> .

pa:hddl a pa:Reference ;
  pa:referenceId "prior:hddl" ;
  pa:name "HDDL" ;
  pa:retrievalUri "https://www.hddl.info/" ;
  pa:semanticCapability "hierarchical-planning" ;
  pa:exactVersionRequiredBeforeProjection true .

_:search a pa:Search, spg:PriorArtClaim ;
  pa:requiredSemantics "hierarchical-planning" ;
  pa:searched pa:hddl ;
  pa:selected pa:hddl ;
  pa:disposition pa:REUSE ;
  pa:falsifier "HDDL cannot encode this bounded hierarchy" ;
  spg:requiresSemantics "hierarchical-planning" ;
  spg:searchedPriorArt pa:hddl ;
  spg:selectedPriorArt pa:hddl ;
  spg:disposition pa:REUSE ;
  spg:falsifier "HDDL cannot encode this bounded hierarchy" .

_:select a spg:Node ; spg:nodeId "select" ; spg:nodeClass spg:SELECT ; spg:capability "capability.select" .
_:do a spg:Node ; spg:nodeId "do" ; spg:nodeClass spg:DO ; spg:capability "brce.do" .

_:edge a spg:Edge ;
  spg:edgeId "e1" ;
  spg:from _:select ;
  spg:to _:do ;
  spg:relation spg:TRIGGERS ;
  spg:guard "admitted" ;
  spg:evidenceRequired "authority-grant" ;
  spg:authorityRequired "BRCE_GRANT" ;
  spg:consequence spg:Consequential ;
  spg:receiptRequired true ;
  spg:falsifier "consequence without receipt" .

_:graph a spg:Graph ;
  spg:graphId "spg:qualification" ;
  spg:version "0.1.0" ;
  spg:state spg:CANDIDATE ;
  spg:standing spg:NONE ;
  spg:node _:select, _:do ;
  spg:edge _:edge ;
  spg:priorArt _:search .
