@prefix spg: <https://seanchatmangpt.github.io/ggen-marketplace/spg#> .
@prefix pa: <https://seanchatmangpt.github.io/ggen-marketplace/prior-art#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

spg:Graph a rdfs:Class .
spg:Node a rdfs:Class .
spg:Edge a rdfs:Class .
spg:ProjectionBinding a rdfs:Class .
spg:PriorArtClaim a rdfs:Class .

spg:State a rdfs:Class .
spg:CANDIDATE a spg:State .
spg:ADMITTED_STRUCTURE a spg:State .
spg:REFUSED a spg:State .

spg:Standing a rdfs:Class .
spg:NONE a spg:Standing .
spg:PARTIAL_ALIVE a spg:Standing .
spg:ALIVE a spg:Standing .
spg:BLOCKED a spg:Standing .
spg:UNSUPPORTED a spg:Standing .

spg:NodeClass a rdfs:Class .
spg:OBSERVE a spg:NodeClass .
spg:SELECT a spg:NodeClass .
spg:CONSTRUCT a spg:NodeClass .
spg:DO a spg:NodeClass .

spg:Relation a rdfs:Class .
spg:LEADS_TO a spg:Relation .
spg:TRIGGERS a spg:Relation .
spg:PROVIDES_INPUT_FOR a spg:Relation .
spg:CONVERGES_TO a spg:Relation .

spg:ConsequenceClass a rdfs:Class .
spg:Observational a spg:ConsequenceClass .
spg:Constructive a spg:ConsequenceClass .
spg:Consequential a spg:ConsequenceClass .

spg:graphId a rdf:Property ; rdfs:domain spg:Graph .
spg:version a rdf:Property ; rdfs:domain spg:Graph .
spg:state a rdf:Property ; rdfs:domain spg:Graph ; rdfs:range spg:State .
spg:standing a rdf:Property ; rdfs:domain spg:Graph ; rdfs:range spg:Standing .
spg:node a rdf:Property ; rdfs:domain spg:Graph ; rdfs:range spg:Node .
spg:edge a rdf:Property ; rdfs:domain spg:Graph ; rdfs:range spg:Edge .
spg:projection a rdf:Property ; rdfs:domain spg:Graph ; rdfs:range spg:ProjectionBinding .
spg:priorArt a rdf:Property ; rdfs:domain spg:Graph ; rdfs:range spg:PriorArtClaim .

spg:nodeId a rdf:Property ; rdfs:domain spg:Node .
spg:nodeClass a rdf:Property ; rdfs:domain spg:Node ; rdfs:range spg:NodeClass .
spg:capability a rdf:Property ; rdfs:domain spg:Node .

spg:edgeId a rdf:Property ; rdfs:domain spg:Edge .
spg:from a rdf:Property ; rdfs:domain spg:Edge ; rdfs:range spg:Node .
spg:to a rdf:Property ; rdfs:domain spg:Edge ; rdfs:range spg:Node .
spg:relation a rdf:Property ; rdfs:domain spg:Edge ; rdfs:range spg:Relation .
spg:guard a rdf:Property ; rdfs:domain spg:Edge .
spg:evidenceRequired a rdf:Property ; rdfs:domain spg:Edge .
spg:authorityRequired a rdf:Property ; rdfs:domain spg:Edge .
spg:consequence a rdf:Property ; rdfs:domain spg:Edge ; rdfs:range spg:ConsequenceClass .
spg:receiptRequired a rdf:Property ; rdfs:domain spg:Edge .
spg:falsifier a rdf:Property ; rdfs:domain spg:Edge .

spg:projectionFamily a rdf:Property ; rdfs:domain spg:ProjectionBinding .
spg:projectionNode a rdf:Property ; rdfs:domain spg:ProjectionBinding ; rdfs:range spg:Node .
spg:projectionIdentity a rdf:Property ; rdfs:domain spg:ProjectionBinding .

spg:requiresSemantics a rdf:Property ; rdfs:domain spg:PriorArtClaim .
spg:searchedPriorArt a rdf:Property ; rdfs:domain spg:PriorArtClaim ; rdfs:range pa:Reference .
spg:selectedPriorArt a rdf:Property ; rdfs:domain spg:PriorArtClaim ; rdfs:range pa:Reference .
spg:disposition a rdf:Property ; rdfs:domain spg:PriorArtClaim ; rdfs:range pa:Disposition .
spg:candidateFailure a rdf:Property ; rdfs:domain spg:PriorArtClaim ; rdfs:range pa:CandidateFailure .
