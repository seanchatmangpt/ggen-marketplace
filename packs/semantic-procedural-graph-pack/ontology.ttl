@prefix spg:     <https://ggen.dev/ontology/semantic-procedural-graph#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix p-plan:  <http://purl.org/net/p-plan#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

spg:ProcedureGraph a owl:Class ;
  rdfs:subClassOf p-plan:Plan ;
  rdfs:label "Semantic Procedural Graph" ;
  rdfs:comment "Versioned semantic identity for one procedure. It is a plan description, not execution standing or authority." .

spg:ProcedureNode a owl:Class ;
  rdfs:subClassOf p-plan:Step ;
  rdfs:label "Procedure node" .

spg:ProcedureEdge a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Typed procedural transition" ;
  rdfs:comment "Reified transition carrying guard, evidence, authority, consequence and receipt semantics." .

spg:ProjectionBinding a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Projection binding" ;
  rdfs:comment "Binds one SPG semantic identity to one specialized formal/runtime representation without asserting equivalence beyond declared preserved semantics." .

spg:PriorArtClaim a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Prior-art search claim" .

spg:CandidateFailure a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Typed failure of one prior-art candidate against required semantics." .

spg:NovelGap a owl:Class ;
  rdfs:subClassOf spg:PriorArtClaim ;
  rdfs:label "Irreducible novelty residual" ;
  rdfs:comment "May be admitted only after searched prior-art candidates are individually discharged by typed missing semantics and an explicit falsifier." .

spg:sourceNode a owl:ObjectProperty ;
  rdfs:domain spg:ProcedureEdge ; rdfs:range spg:ProcedureNode .
spg:targetNode a owl:ObjectProperty ;
  rdfs:domain spg:ProcedureEdge ; rdfs:range spg:ProcedureNode .
spg:hasEdge a owl:ObjectProperty ;
  rdfs:domain spg:ProcedureGraph ; rdfs:range spg:ProcedureEdge .
spg:hasNode a owl:ObjectProperty ;
  rdfs:domain spg:ProcedureGraph ; rdfs:range spg:ProcedureNode .
spg:hasProjection a owl:ObjectProperty ;
  rdfs:domain spg:ProcedureGraph ; rdfs:range spg:ProjectionBinding .
spg:hasPriorArtClaim a owl:ObjectProperty ;
  rdfs:domain spg:ProcedureGraph ; rdfs:range spg:PriorArtClaim .
spg:hasCandidateFailure a owl:ObjectProperty ;
  rdfs:domain spg:PriorArtClaim ; rdfs:range spg:CandidateFailure .

spg:relation a owl:DatatypeProperty ; rdfs:domain spg:ProcedureEdge ; rdfs:range xsd:string .
spg:guard a owl:DatatypeProperty ; rdfs:domain spg:ProcedureEdge ; rdfs:range xsd:string .
spg:evidenceRequirement a owl:DatatypeProperty ; rdfs:domain spg:ProcedureEdge ; rdfs:range xsd:string .
spg:authorityRequirement a owl:DatatypeProperty ; rdfs:domain spg:ProcedureEdge ; rdfs:range xsd:string .
spg:consequenceClass a owl:DatatypeProperty ; rdfs:domain spg:ProcedureEdge ; rdfs:range xsd:string .
spg:receiptRequired a owl:DatatypeProperty ; rdfs:domain spg:ProcedureEdge ; rdfs:range xsd:boolean .
spg:falsifier a owl:DatatypeProperty ; rdfs:range xsd:string .
spg:state a owl:DatatypeProperty ; rdfs:domain spg:ProcedureGraph ; rdfs:range xsd:string .
spg:standing a owl:DatatypeProperty ; rdfs:domain spg:ProcedureGraph ; rdfs:range xsd:string .

spg:projectionFamily a owl:DatatypeProperty ; rdfs:domain spg:ProjectionBinding ; rdfs:range xsd:string .
spg:externalIdentity a owl:DatatypeProperty ; rdfs:domain spg:ProjectionBinding ; rdfs:range xsd:string .
spg:preservesSemantic a owl:DatatypeProperty ; rdfs:domain spg:ProjectionBinding ; rdfs:range xsd:string .
spg:unsupportedSemantic a owl:DatatypeProperty ; rdfs:domain spg:ProjectionBinding ; rdfs:range xsd:string .

spg:requiredSemantic a owl:DatatypeProperty ; rdfs:domain spg:PriorArtClaim ; rdfs:range xsd:string .
spg:searchedPriorArt a owl:DatatypeProperty ; rdfs:domain spg:PriorArtClaim ; rdfs:range xsd:string .
spg:selectedPriorArt a owl:DatatypeProperty ; rdfs:domain spg:PriorArtClaim ; rdfs:range xsd:string .
spg:disposition a owl:DatatypeProperty ; rdfs:domain spg:PriorArtClaim ; rdfs:range xsd:string .
spg:candidate a owl:DatatypeProperty ; rdfs:domain spg:CandidateFailure ; rdfs:range xsd:string .
spg:missingSemantic a owl:DatatypeProperty ; rdfs:domain spg:CandidateFailure ; rdfs:range xsd:string .

spg:CANDIDATE a skos:Concept ; skos:prefLabel "CANDIDATE" .
spg:ADMITTED a skos:Concept ; skos:prefLabel "ADMITTED" .
spg:REFUSED a skos:Concept ; skos:prefLabel "REFUSED" .

spg:REUSE a skos:Concept ; skos:prefLabel "REUSE" .
spg:COMPOSE a skos:Concept ; skos:prefLabel "COMPOSE" .
spg:EXTEND a skos:Concept ; skos:prefLabel "EXTEND" .
spg:NOVEL_GAP a skos:Concept ; skos:prefLabel "NOVEL_GAP" .
