@prefix rea: <https://chatman.ai/ontology/runtime-evidence-authenticity#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rea:RuntimeEvidenceAuthenticityPack a rea:MeasurementPack ;
  rea:authority "OBSERVE|VERIFY" ;
  rea:consequentialDo "BRCE_ONLY" ;
  rea:requiresExactSubject true .

rea:ExactSubject a rea:SubjectClass .
rea:RuntimeObservation a rea:EvidenceClass .
rea:GroundTruthObservation a rea:EvidenceClass .
rea:CrossSurfaceWitness a rea:EvidenceClass .
rea:AuthenticityReceipt a rea:ReceiptClass .

rea:subjectSha a rea:IdentityProperty .
rea:semanticDigest a rea:IdentityProperty .
rea:originKind a rea:EvidenceProperty .
rea:sourceDigest a rea:EvidenceProperty .
rea:observedValue a rea:EvidenceProperty .
rea:groundTruthValue a rea:EvidenceProperty .
rea:surface a rea:EvidenceProperty .
rea:observedAt a rea:TemporalProperty .
rea:currentGeneration a rea:TemporalProperty .
rea:dynamicSource a rea:AuthenticityProperty .
rea:hardcodedLiteral a rea:AuthenticityProperty .
rea:crossSurfaceMatch a rea:AuthenticityProperty .
rea:groundTruthMatch a rea:AuthenticityProperty .
rea:actuationPerformed a rea:AuthorityProperty .
rea:authority a rea:AuthorityProperty .
