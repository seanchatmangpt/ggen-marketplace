PREFIX rea: <https://chatman.ai/ontology/runtime-evidence-authenticity#>
SELECT ?repo ?sha ?semantic_digest ?origin ?dynamic ?ground_truth_match WHERE {
  ?subject a rea:ExactSubject ;
    rea:subjectSha ?sha ;
    rea:semanticDigest ?semantic_digest .
  ?evidence a rea:RuntimeObservation ;
    rea:originKind ?origin ;
    rea:dynamicSource ?dynamic ;
    rea:groundTruthMatch ?ground_truth_match .
  BIND("unknown/unknown" AS ?repo)
}
ORDER BY ?sha ?origin
