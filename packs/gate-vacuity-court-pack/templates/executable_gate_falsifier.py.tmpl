#!/usr/bin/env python3
"""Executable gate falsifier -- really runs ggen, does not classify fixtures.

GENERATED by gate-vacuity-court-pack from ontology.ttl. Do not hand-edit.

Contrast with a fixture court that reads JSON files carrying both the observed
and the expected value and compares them in-process: such a court makes no
subprocess call and cannot detect a real regression in the generator. This
falsifier copies a real pack into a temp dir, mutates the real ontology so a
real gate's precondition is violated, and runs the real `ggen sync run`
binary twice:

  A. gate present on disk but NOT listed in `[validation] gates` -> must exit 0
     (proving the unwired gate is vacuous)
  B. same mutation, gate wired into `[validation] gates`        -> must exit 1
     with the FM-LAW-018 refusal (proving the wired gate is load-bearing)

If A fails or B passes, the generator's gate contract has changed and this
court reports BUILD_BROKEN. Chicago style: real subprocess, real files, real
exit codes, state-based assertions, no mocks.

AUTHORITY BOUNDARY: runs ggen only inside a throwaway temp directory. It never
writes to the source pack and carries no runtime actuation authority.
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# Refusal codes observed from the real generator (from ontology.ttl).
KNOWN_REFUSAL_CODES = {
{% for row in codes %}    "{{ row.notation }}": "{{ row.label }}",
{% endfor %}}

GGEN = os.environ.get("GGEN_BIN", str(Path.home() / ".local" / "bin" / "ggen"))


def _strip_predicate(ttl: Path, predicate: str) -> tuple[int, int]:
    text = ttl.read_text(encoding="utf-8")
    before = text.count(predicate)
    kept = "\n".join(l for l in text.split("\n") if predicate not in l)
    ttl.write_text(kept, encoding="utf-8")
    return before, kept.count(predicate)


def _run_ggen(cwd: Path) -> tuple[int, str]:
    proc = subprocess.run(
        [GGEN, "sync", "run"], cwd=str(cwd),
        capture_output=True, text=True, timeout=300,
    )
    return proc.returncode, (proc.stdout + proc.stderr)


def falsify(pack: Path, gate: str, predicate: str) -> dict:
    """Return a state-based report for one pack/gate/predicate triple."""
    out: dict = {"pack": pack.name, "gate": gate, "predicate": predicate}
    if not Path(GGEN).exists():
        return {**out, "standing": "BLOCKED[GGEN_BINARY_MISSING]", "ggen": GGEN}

    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp)
        for arm, wire in (("A_unwired", False), ("B_wired", True)):
            work = base / arm
            shutil.copytree(pack, work)
            manifest = work / "ggen.toml"
            b, a = _strip_predicate(work / "ontology.ttl", predicate)
            out[f"{arm}_mutation"] = {"predicate": predicate, "before": b, "after": a}
            if b == 0:
                return {**out, "standing": "REFUSED[MUTATION_NO_OP]",
                        "detail": f"{predicate} not present in {pack.name}/ontology.ttl"}
            if wire:
                manifest.write_text(
                    manifest.read_text(encoding="utf-8")
                    + f'\n[validation]\ngates = ["gates/{gate}"]\n',
                    encoding="utf-8",
                )
            rc, log = _run_ggen(work)
            emitted = sum(1 for p in work.rglob("*") if p.is_file())
            out[f"{arm}_exit"] = rc
            out[f"{arm}_refusal"] = next(
                (c for c in KNOWN_REFUSAL_CODES if c in log), None
            )
            out[f"{arm}_files"] = emitted

    unwired_passes = out["A_unwired_exit"] == 0
    wired_refuses = out["B_wired_exit"] != 0 and out["B_wired_refusal"] == "FM-LAW-018"
    out["unwired_gate_is_vacuous"] = unwired_passes
    out["wired_gate_is_load_bearing"] = wired_refuses
    out["standing"] = "ALIVE" if (unwired_passes and wired_refuses) else "BUILD_BROKEN"
    return out


def main(argv: list[str]) -> int:
    if len(argv) < 4:
        print("usage: executable_gate_falsifier.py <pack-dir> <gate-file> <predicate> [--json]",
              file=sys.stderr)
        return 2
    report = falsify(Path(argv[1]).resolve(), argv[2], argv[3])
    if "--json" in argv:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print(f"== executable gate falsifier: {report['pack']} / {report['gate']} ==")
        for k in ("A_unwired_exit", "A_unwired_refusal", "A_unwired_files",
                  "B_wired_exit", "B_wired_refusal", "B_wired_files"):
            if k in report:
                print(f"  {k} = {report[k]}")
        print(f"  unwired_gate_is_vacuous   = {report.get('unwired_gate_is_vacuous')}")
        print(f"  wired_gate_is_load_bearing= {report.get('wired_gate_is_load_bearing')}")
        print(f"  STANDING: {report['standing']}")
    return 0 if report["standing"] == "ALIVE" else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
