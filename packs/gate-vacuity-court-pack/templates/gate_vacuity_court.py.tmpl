---
to: src/gate_vacuity_court.py
sparql:
  checks: |
    PREFIX gvc: <https://ggen.dev/ontology/gate-vacuity-court#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?order ?slug ?label ?vtrue ?vfalse WHERE {
      ?c a gvc:CourtCheck ;
         gvc:order ?order ; gvc:slug ?slug ; rdfs:label ?label ;
         gvc:verdictWhenTrue ?vtrue ; gvc:verdictWhenFalse ?vfalse .
    } ORDER BY ?order
  keys: |
    PREFIX gvc: <https://ggen.dev/ontology/gate-vacuity-court#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?path ?enforcing WHERE {
      ?k a gvc:ManifestKey ; rdfs:label ?label ; gvc:tomlPath ?path ; gvc:enforcing ?enforcing .
    } ORDER BY ?label
  codes: |
    PREFIX gvc: <https://ggen.dev/ontology/gate-vacuity-court#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?notation ?label ?where WHERE {
      ?r a gvc:RefusalCode ; skos:notation ?notation ; rdfs:label ?label ; gvc:observedIn ?where .
    } ORDER BY ?notation
---
#!/usr/bin/env python3
"""Gate-vacuity court for a ggen pack tree.

GENERATED by gate-vacuity-court-pack from ontology.ttl. Do not hand-edit.

A gate that the generator never loads can never refuse, so it is vacuous.
ggen 26.8.28 loads SPARQL gates ONLY from the ggen.toml key
`[validation] gates = [...]`; a `gates/*.rq` file absent from that list is
dead weight. This court reads manifests only. It has NO runtime actuation
authority: it reports, it never repairs, publishes, or executes a pack.
"""
from __future__ import annotations

import json
import re
import sys
from pathlib import Path

# --- manifest keys ggen really honors (from ontology.ttl) -------------------
MANIFEST_KEYS = [
{% for row in keys %}    {"label": "{{ row.label }}", "toml_path": "{{ row.path }}", "enforcing": {% if row.enforcing == "true" %}True{% else %}False{% endif %}},
{% endfor %}]

# --- refusal codes really emitted by ggen 26.8.28 ---------------------------
OBSERVED_REFUSAL_CODES = [
{% for row in codes %}    {"code": "{{ row.notation }}", "label": "{{ row.label }}", "observed_in": "{{ row.where }}"},
{% endfor %}]

# --- court checks ----------------------------------------------------------
CHECKS = [
{% for row in checks %}    {"order": {{ row.order }}, "slug": "{{ row.slug }}", "label": "{{ row.label }}", "true_verdict": "{{ row.vtrue }}", "false_verdict": "{{ row.vfalse }}"},
{% endfor %}]

_VALIDATION_GATES = re.compile(
    r"^\[validation\][^\[]*?^\s*gates\s*=\s*\[(?P<body>.*?)\]",
    re.MULTILINE | re.DOTALL,
)
_LAW_RULES = re.compile(
    r"^\[law\][^\[]*?^\s*rules\s*=\s*\[(?P<body>.*?)\]",
    re.MULTILINE | re.DOTALL,
)


def _listed(pattern: re.Pattern, text: str):
    """Return the string entries of a TOML array, or None if the key is absent."""
    m = pattern.search(text)
    if m is None:
        return None
    return re.findall(r'"([^"]+)"', m.group("body"))


def audit_pack(pack_dir: Path) -> dict:
    manifest = pack_dir / "ggen.toml"
    shipped = sorted(p.name for p in (pack_dir / "gates").glob("*.rq")) if (pack_dir / "gates").is_dir() else []
    result = {
        "pack": pack_dir.name,
        "manifest_present": manifest.is_file(),
        "shipped_gates": shipped,
        "wired_gates": [],
        "law_rules": None,
        "verdicts": {},
    }
    text = manifest.read_text(encoding="utf-8", errors="replace") if manifest.is_file() else ""
    wired = _listed(_VALIDATION_GATES, text) or []
    result["wired_gates"] = wired
    result["law_rules"] = _listed(_LAW_RULES, text)

    wired_names = {Path(g).name for g in wired}
    unwired = [g for g in shipped if g not in wired_names]
    result["unwired_gates"] = unwired

    for check in CHECKS:
        slug = check["slug"]
        if slug == "manifest_present":
            ok = result["manifest_present"]
        elif slug == "gates_present":
            ok = bool(shipped)
        elif slug == "gates_wired":
            if not shipped:
                # No gates shipped: nothing to enforce, so nothing to be vacuous about.
                result["verdicts"][slug] = "NOT_APPLICABLE"
                continue
            ok = not unwired
        elif slug == "law_non_empty":
            ok = result["law_rules"] is None or bool(result["law_rules"])
        else:  # unknown check slug -> refuse rather than silently pass
            result["verdicts"][slug] = "REFUSED[UNKNOWN_CHECK]"
            continue
        result["verdicts"][slug] = check["true_verdict"] if ok else check["false_verdict"]

    bad = {"VACUOUS_GATE", "VACUOUS_LAW", "NOT_CONSUMABLE"}
    result["standing"] = "REFUSED" if bad & set(result["verdicts"].values()) else "ALIVE"
    return result


def audit_tree(root: Path) -> dict:
    rows = [audit_pack(d) for d in sorted(root.iterdir()) if d.is_dir()]
    return {
        "root": str(root),
        "ggen_contract": "26.8.28",
        "manifest_keys": MANIFEST_KEYS,
        "observed_refusal_codes": OBSERVED_REFUSAL_CODES,
        "totals": {
            "packs": len(rows),
            "with_manifest": sum(1 for r in rows if r["manifest_present"]),
            "shipping_rq_gates": sum(1 for r in rows if r["shipped_gates"]),
            "wiring_validation_gates": sum(1 for r in rows if r["wired_gates"]),
            "vacuous_gate": sum(1 for r in rows if "VACUOUS_GATE" in r["verdicts"].values()),
            "vacuous_law": sum(1 for r in rows if "VACUOUS_LAW" in r["verdicts"].values()),
            "not_consumable": sum(1 for r in rows if not r["manifest_present"]),
        },
        "packs": rows,
    }


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("usage: gate_vacuity_court.py <packs-root> [--json]", file=sys.stderr)
        return 2
    root = Path(argv[1]).resolve()
    if not root.is_dir():
        print(f"REFUSED[ROOT_MISSING] {root}", file=sys.stderr)
        return 2
    report = audit_tree(root)
    if "--json" in argv:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        t = report["totals"]
        print(f"== gate-vacuity court over {report['root']} (ggen {report['ggen_contract']}) ==")
        print(f"  packs={t['packs']} with_manifest={t['with_manifest']} "
              f"shipping_rq_gates={t['shipping_rq_gates']} wiring_validation_gates={t['wiring_validation_gates']}")
        print(f"  VACUOUS_GATE={t['vacuous_gate']} VACUOUS_LAW={t['vacuous_law']} NOT_CONSUMABLE={t['not_consumable']}")
        for r in report["packs"]:
            if r["unwired_gates"] and r["manifest_present"]:
                print(f"  [VACUOUS_GATE] {r['pack']}: {len(r['unwired_gates'])} unwired -> {', '.join(r['unwired_gates'][:4])}")
            if r["law_rules"] == []:
                print(f"  [VACUOUS_LAW]  {r['pack']}: [law] rules = [] enforces nothing")
    # Reporting court: exit 0. Refusal authority stays with GymAct/BRCE admission.
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
