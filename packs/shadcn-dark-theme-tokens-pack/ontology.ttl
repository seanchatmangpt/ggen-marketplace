@prefix pack: <urn:ggen-marketplace:shadcn-dark-theme-tokens-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pack:GlobalsCss a pack:StylesheetArtifact ;
    rdfs:label "ops-dashboard-theme.css" ;
    pack:defaultMode "dark" ;
    pack:outputPath "styles/ops-dashboard-theme.css" ;
    pack:importedFrom "app/ops-dashboard/page.tsx (ops-dashboard-legend-pack)" ;
    rdfs:comment "CSS-variable :root override matching nextjs-ai-sdk-pack's own oklch token scheme (app/globals.css), so deck.gl canvases read against a dark background by default before next-themes adds .dark on first paint. Deliberately NOT written to app/globals.css: nextjs-ai-sdk-pack already owns that path (and its own @tailwind import + @theme wiring), so this pack emits a separate stylesheet -- variable overrides only, no @tailwind/@apply -- imported explicitly by ops-dashboard-legend-pack's page.tsx. Avoids both the FM-WRITE-008 output-path collision and a doubled Tailwind base layer found when composing >1 pack in one consumer. Requires nai:tailwindVersion to be a real v4.x release: nextjs-ai-sdk-pack's globals.css template is hardcoded to Tailwind v4 CSS syntax (@import \"tailwindcss\"; @theme inline) regardless of the version string a consumer declares." .

pack:ThemeProvider a pack:ReactComponent ;
    rdfs:label "ThemeProvider" ;
    pack:library "next-themes" ;
    pack:defaultTheme "dark" ;
    rdfs:comment "Wraps next-themes' ThemeProvider with attribute=\"class\" and defaultTheme=\"dark\"." .

pack:ThemeToggle a pack:ReactComponent ;
    rdfs:label "ThemeToggle" ;
    rdfs:comment "Button toggling next-themes' resolved theme between light and dark." .
