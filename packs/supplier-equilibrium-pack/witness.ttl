@prefix se: <https://ggen.io/ontology/supplier-equilibrium#> .
se:rule a se:SupplierProfile ; se:exactSubject "rules-immutable" ; se:intelligenceRank 1 .
se:model a se:SupplierProfile ; se:exactSubject "model-immutable" ; se:intelligenceRank 9 .
se:o1 a se:Observation ; se:supplier se:rule ; se:workloadDigest "w" ; se:outputDigest "o" ; se:consequenceDigest "c" ; se:verifierDigest "v1" .
se:o2 a se:Observation ; se:supplier se:model ; se:workloadDigest "w" ; se:outputDigest "o" ; se:consequenceDigest "c" ; se:verifierDigest "v2" .
se:s a se:Selection ; se:observation se:o1, se:o2 ; se:selectedSupplier se:rule ; se:authority "none" ; se:receiptDigest "r" .
