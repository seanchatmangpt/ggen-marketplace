# MESSAGE: header offset abutment chain violated — each field's _OFFSET + _LEN
# must equal the next field's _OFFSET; the last must end at PDU_HEADER_LEN (64);
# all offsets must be distinct. Any row indicates a broken wire layout.
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX pdu:  <https://strata.chatman.ai/ontology/pdu#>

SELECT (COALESCE(?f1,?f2,?f3,?f4,?f5,?f6,?f7,?f8,?f9,?f10) AS ?field)
       (COALESCE(?p1,?p2,?p3,?p4,?p5,?p6,?p7,?p8,?p9,?p10) AS ?problem)
       ?offA ?offB WHERE {
  {
    FILTER(xsd:integer(?magicOff) + xsd:integer(?magicLen) != xsd:integer(?verOff))
    BIND("MAGIC" AS ?f1) BIND("offset+length != next offset" AS ?p1)
    ?m rdfs:label "MAGIC_OFFSET" ; pdu:value ?magicOff .
    ?ml rdfs:label "MAGIC_LEN" ; pdu:value ?magicLen .
    ?v rdfs:label "VERSION_OFFSET" ; pdu:value ?verOff .
    BIND(?magicOff AS ?offA) BIND(?verOff AS ?offB)
  } UNION {
    FILTER(xsd:integer(?verOff) + xsd:integer(?verLen) != xsd:integer(?permOff))
    BIND("VERSION" AS ?f2) BIND("offset+length != next offset" AS ?p2)
    ?v rdfs:label "VERSION_OFFSET" ; pdu:value ?verOff .
    ?vl rdfs:label "VERSION_LEN" ; pdu:value ?verLen .
    ?p rdfs:label "PERMUTATION_OFFSET" ; pdu:value ?permOff .
    BIND(?verOff AS ?offA) BIND(?permOff AS ?offB)
  } UNION {
    FILTER(xsd:integer(?permOff) + xsd:integer(?permLen) != xsd:integer(?resOff))
    BIND("PERMUTATION" AS ?f3) BIND("offset+length != next offset" AS ?p3)
    ?p rdfs:label "PERMUTATION_OFFSET" ; pdu:value ?permOff .
    ?pl rdfs:label "PERMUTATION_LEN" ; pdu:value ?permLen .
    ?r rdfs:label "RESERVED_OFFSET" ; pdu:value ?resOff .
    BIND(?permOff AS ?offA) BIND(?resOff AS ?offB)
  } UNION {
    FILTER(xsd:integer(?resOff) + xsd:integer(?resLen) != xsd:integer(?epochOff))
    BIND("RESERVED" AS ?f4) BIND("offset+length != next offset" AS ?p4)
    ?r rdfs:label "RESERVED_OFFSET" ; pdu:value ?resOff .
    ?rl rdfs:label "RESERVED_LEN" ; pdu:value ?resLen .
    ?e rdfs:label "EPOCH_NONCE_OFFSET" ; pdu:value ?epochOff .
    BIND(?resOff AS ?offA) BIND(?epochOff AS ?offB)
  } UNION {
    FILTER(xsd:integer(?epochOff) != 8)
    BIND("EPOCH_NONCE" AS ?f5)
    BIND("FUEL_LEASE_OFFSET must be 8 (abutment sentinel)" AS ?p5)
    ?e rdfs:label "EPOCH_NONCE_OFFSET" ; pdu:value ?epochOff .
    BIND(?epochOff AS ?offA) BIND("8" AS ?offB)
  } UNION {
    FILTER(xsd:integer(?fuelOff) != 16)
    BIND("FUEL_LEASE" AS ?f6)
    BIND("FUEL_LEASE_OFFSET must be 16 (abutment sentinel)" AS ?p6)
    ?f rdfs:label "FUEL_LEASE_OFFSET" ; pdu:value ?fuelOff .
    BIND(?fuelOff AS ?offA) BIND("16" AS ?offB)
  } UNION {
    FILTER(xsd:integer(?fuelOff) + xsd:integer(?fuelLen) != xsd:integer(?parentOff))
    BIND("FUEL_LEASE" AS ?f7) BIND("offset+length != next offset" AS ?p7)
    ?f rdfs:label "FUEL_LEASE_OFFSET" ; pdu:value ?fuelOff .
    ?fl rdfs:label "FUEL_LEASE_LEN" ; pdu:value ?fuelLen .
    ?pa rdfs:label "PARENT_RECEIPT_DIGEST_OFFSET" ; pdu:value ?parentOff .
    BIND(?fuelOff AS ?offA) BIND(?parentOff AS ?offB)
  } UNION {
    FILTER(xsd:integer(?parentOff) + xsd:integer(?parentLen) != xsd:integer(?histOff))
    BIND("PARENT_RECEIPT_DIGEST" AS ?f8) BIND("offset+length != next offset" AS ?p8)
    ?pa rdfs:label "PARENT_RECEIPT_DIGEST_OFFSET" ; pdu:value ?parentOff .
    ?pal rdfs:label "PARENT_RECEIPT_DIGEST_LEN" ; pdu:value ?parentLen .
    ?h rdfs:label "HISTORY_QUAD_COUNT_OFFSET" ; pdu:value ?histOff .
    BIND(?parentOff AS ?offA) BIND(?histOff AS ?offB)
  } UNION {
    FILTER(xsd:integer(?histOff) + xsd:integer(?histLen) != xsd:integer(?candOff))
    BIND("HISTORY_QUAD_COUNT" AS ?f9) BIND("offset+length != next offset" AS ?p9)
    ?h rdfs:label "HISTORY_QUAD_COUNT_OFFSET" ; pdu:value ?histOff .
    ?hl rdfs:label "HISTORY_QUAD_COUNT_LEN" ; pdu:value ?histLen .
    ?c rdfs:label "CANDIDATE_QUAD_COUNT_OFFSET" ; pdu:value ?candOff .
    BIND(?histOff AS ?offA) BIND(?candOff AS ?offB)
  } UNION {
    FILTER(xsd:integer(?candOff) + xsd:integer(?candLen) != xsd:integer(?hdrLen))
    BIND("CANDIDATE_QUAD_COUNT" AS ?f10) BIND("offset+length != PDU_HEADER_LEN" AS ?p10)
    ?c rdfs:label "CANDIDATE_QUAD_COUNT_OFFSET" ; pdu:value ?candOff .
    ?cl rdfs:label "CANDIDATE_QUAD_COUNT_LEN" ; pdu:value ?candLen .
    ?hd rdfs:label "PDU_HEADER_LEN" ; pdu:value ?hdrLen .
    BIND(?candOff AS ?offA) BIND(?hdrLen AS ?offB)
  }
}
ORDER BY ?field ?problem
