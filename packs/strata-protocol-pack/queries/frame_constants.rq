PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX pdu:  <https://strata.chatman.ai/ontology/pdu#>

SELECT ?label ?rustType ?value ?comment
WHERE {
  ?c a pdu:FrameConstant ;
     rdfs:label ?label ;
     pdu:rustType ?rustType ;
     pdu:value ?value ;
     rdfs:comment ?comment .
}
ORDER BY ?label
