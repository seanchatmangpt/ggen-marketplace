@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pdu:  <https://strata.chatman.ai/ontology/pdu#> .
@prefix wire: <https://strata.chatman.ai/ontology/wire#> .

# ---------------------------------------------------------------------------
# Ground truth: ~/strata/strata_protocol/src/pdu.rs (CLAP/1.0, 64-byte header)
# Every generated constant is a pdu:FrameConstant with label/rustType/value.
# ---------------------------------------------------------------------------

pdu:PduHeader a rdfs:Class ;
    rdfs:label "PduHeader" ;
    rdfs:comment "CLAP/1.0 64-byte frame header, strict fail-closed (de)serialization." .

pdu:FrameConstant a rdfs:Class ;
    rdfs:label "FrameConstant" ;
    rdfs:comment "One generated wire constant of the CLAP/1.0 64-byte frame header." .

pdu:PDU_MAGIC a pdu:FrameConstant ;
    rdfs:label "PDU_MAGIC" ;
    pdu:rustType "u32" ;
    pdu:value "0x434C_4150" ;
    rdfs:comment "Magic bytes \"CLAP\", big-endian; bytes 0..4." .

pdu:PDU_VERSION a pdu:FrameConstant ;
    rdfs:label "PDU_VERSION" ;
    pdu:rustType "u8" ;
    pdu:value "0x01" ;
    rdfs:comment "Protocol version; byte 4." .

pdu:PDU_HEADER_LEN a pdu:FrameConstant ;
    rdfs:label "PDU_HEADER_LEN" ;
    pdu:rustType "usize" ;
    pdu:value "64" ;
    rdfs:comment "Fixed header length in bytes." .

pdu:PDU_PERMUTATION_MAX a pdu:FrameConstant ;
    rdfs:label "PDU_PERMUTATION_MAX" ;
    pdu:rustType "u8" ;
    pdu:value "5" ;
    rdfs:comment "Maximum valid QLever index permutation; >5 fails closed at parse." .

# --- Header field offsets (big-endian layout) ---

pdu:MAGIC_OFFSET a pdu:FrameConstant ;
    rdfs:label "MAGIC_OFFSET" ; pdu:rustType "usize" ; pdu:value "0" ;
    rdfs:comment "Magic field offset; length 4." .
pdu:MAGIC_LEN a pdu:FrameConstant ;
    rdfs:label "MAGIC_LEN" ; pdu:rustType "usize" ; pdu:value "4" ;
    rdfs:comment "Magic field length." .
pdu:VERSION_OFFSET a pdu:FrameConstant ;
    rdfs:label "VERSION_OFFSET" ; pdu:rustType "usize" ; pdu:value "4" ;
    rdfs:comment "Version field offset; length 1." .
pdu:VERSION_LEN a pdu:FrameConstant ;
    rdfs:label "VERSION_LEN" ; pdu:rustType "usize" ; pdu:value "1" ;
    rdfs:comment "Version field length." .
pdu:PERMUTATION_OFFSET a pdu:FrameConstant ;
    rdfs:label "PERMUTATION_OFFSET" ; pdu:rustType "usize" ; pdu:value "5" ;
    rdfs:comment "Permutation field offset; length 1." .
pdu:PERMUTATION_LEN a pdu:FrameConstant ;
    rdfs:label "PERMUTATION_LEN" ; pdu:rustType "usize" ; pdu:value "1" ;
    rdfs:comment "Permutation field length." .
pdu:RESERVED_OFFSET a pdu:FrameConstant ;
    rdfs:label "RESERVED_OFFSET" ; pdu:rustType "usize" ; pdu:value "6" ;
    rdfs:comment "Reserved bytes offset; must be zero." .
pdu:RESERVED_LEN a pdu:FrameConstant ;
    rdfs:label "RESERVED_LEN" ; pdu:rustType "usize" ; pdu:value "2" ;
    rdfs:comment "Reserved bytes length." .
pdu:EPOCH_NONCE_OFFSET a pdu:FrameConstant ;
    rdfs:label "EPOCH_NONCE_OFFSET" ; pdu:rustType "usize" ; pdu:value "8" ;
    rdfs:comment "u64 epoch nonce offset." .
pdu:EPOCH_NONCE_LEN a pdu:FrameConstant ;
    rdfs:label "EPOCH_NONCE_LEN" ; pdu:rustType "usize" ; pdu:value "8" ;
    rdfs:comment "u64 epoch nonce length." .
pdu:FUEL_LEASE_OFFSET a pdu:FrameConstant ;
    rdfs:label "FUEL_LEASE_OFFSET" ; pdu:rustType "usize" ; pdu:value "16" ;
    rdfs:comment "u64 fuel lease offset." .
pdu:FUEL_LEASE_LEN a pdu:FrameConstant ;
    rdfs:label "FUEL_LEASE_LEN" ; pdu:rustType "usize" ; pdu:value "8" ;
    rdfs:comment "u64 fuel lease length." .
pdu:PARENT_RECEIPT_DIGEST_OFFSET a pdu:FrameConstant ;
    rdfs:label "PARENT_RECEIPT_DIGEST_OFFSET" ; pdu:rustType "usize" ; pdu:value "24" ;
    rdfs:comment "32B parent receipt digest offset." .
pdu:PARENT_RECEIPT_DIGEST_LEN a pdu:FrameConstant ;
    rdfs:label "PARENT_RECEIPT_DIGEST_LEN" ; pdu:rustType "usize" ; pdu:value "32" ;
    rdfs:comment "32B parent receipt digest length." .
pdu:HISTORY_QUAD_COUNT_OFFSET a pdu:FrameConstant ;
    rdfs:label "HISTORY_QUAD_COUNT_OFFSET" ; pdu:rustType "usize" ; pdu:value "56" ;
    rdfs:comment "u32 history quad count N offset." .
pdu:HISTORY_QUAD_COUNT_LEN a pdu:FrameConstant ;
    rdfs:label "HISTORY_QUAD_COUNT_LEN" ; pdu:rustType "usize" ; pdu:value "4" ;
    rdfs:comment "u32 history quad count N length." .
pdu:CANDIDATE_QUAD_COUNT_OFFSET a pdu:FrameConstant ;
    rdfs:label "CANDIDATE_QUAD_COUNT_OFFSET" ; pdu:rustType "usize" ; pdu:value "60" ;
    rdfs:comment "u32 candidate quad count M offset." .
pdu:CANDIDATE_QUAD_COUNT_LEN a pdu:FrameConstant ;
    rdfs:label "CANDIDATE_QUAD_COUNT_LEN" ; pdu:rustType "usize" ; pdu:value "4" ;
    rdfs:comment "u32 candidate quad count M length." .

# --- Wire classes (receipt/refusal) — ground truth: receipt.rs / refusal.rs ---

wire:WireClass a rdfs:Class ;
    rdfs:label "WireClass" ;
    rdfs:comment "A fixed-length wire-format class with a ground-truth byte length (wire:fixedLen)." .

wire:ReceiptDigest a rdfs:Class, wire:WireClass ;
    rdfs:label "ReceiptDigest" ;
    wire:fixedLen "32"^^xsd:integer ;
    rdfs:comment "32-byte BLAKE3 parent receipt digest carried at bytes 24..56." .

wire:RefusalReceipt a rdfs:Class, wire:WireClass ;
    rdfs:label "RefusalReceipt" ;
    wire:fixedLen "32"^^xsd:integer ;
    rdfs:comment "Opaque constant-time refusal receipt: fixed 32 bytes, no structure, no cause channel. Strict parse fails closed on any other length." .

# --- Refusal taxonomy closure (wire-level law; ground truth: refusal.rs
# --- and strata-valve-pack's projected taxonomy — same 4 atoms) ---

wire:RefusalTaxonomy a rdfs:Class ;
    rdfs:label "RefusalTaxonomy" ;
    rdfs:comment "An atom of the CLAP refusal taxonomy. Each atom carries the opaque receipt length law (wire:receiptLen), which must equal wire:RefusalReceipt's wire:fixedLen. The enum is exhaustive: exactly these four atoms; any fifth atom must fail gate 030." .

wire:MalformedFrame a wire:RefusalTaxonomy ;
    rdfs:label "MalformedFrame" ;
    wire:receiptLen "32"^^xsd:integer ;
    rdfs:comment "Frame failed strict (de)serialization; refuses with the opaque 32-byte receipt." .

wire:FuelExhausted a wire:RefusalTaxonomy ;
    rdfs:label "FuelExhausted" ;
    wire:receiptLen "32"^^xsd:integer ;
    rdfs:comment "Metered fuel exhausted mid-reduction; refuses with the opaque 32-byte receipt." .

wire:ParentDiscontinuity a wire:RefusalTaxonomy ;
    rdfs:label "ParentDiscontinuity" ;
    wire:receiptLen "32"^^xsd:integer ;
    rdfs:comment "Parent receipt digest does not chain; refuses with the opaque 32-byte receipt." .

wire:ArenaFailure a wire:RefusalTaxonomy ;
    rdfs:label "ArenaFailure" ;
    wire:receiptLen "32"^^xsd:integer ;
    rdfs:comment "Allocation arena failure; refuses with the opaque 32-byte receipt." .

pdu:REFUSAL_RECEIPT_LEN a pdu:FrameConstant ;
    rdfs:label "REFUSAL_RECEIPT_LEN" ; pdu:rustType "usize" ; pdu:value "32" ;
    rdfs:comment "Wire length of the opaque refusal receipt (RefusalReceipt::LEN)." .
