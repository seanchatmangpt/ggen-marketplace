---
to: "generated/ocel-digest-binding-plan.json"
sparql:
  binding: |
    PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
    SELECT ?objectId ?algorithm ?target ?phase WHERE {
      ?binding a geocel:DigestBindingObject ;
        geocel:objectId ?objectId ;
        geocel:digestAlgorithm ?algorithm ;
        geocel:digestTarget ?target ;
        geocel:digestBindingPhase ?phase .
    } ORDER BY ?objectId
---
{
  "schema": "ggen-ecosystem-ocel-digest-binding/v1",
  "bindings": [{% for row in binding %}{"object_id":"{{ row.objectId }}","algorithm":"{{ row.algorithm }}","target":"{{ row.target }}","phase":"{{ row.phase }}"}{% if not loop.last %},{% endif %}{% endfor %}],
  "law": "Generate OCEL first; compute the declared digest over the exact generated bytes; bind that digest into the admitted run graph; invoke GGEN again to emit the canonical Project2 request. The Project2 request itself remains a GGEN consequence."
}
