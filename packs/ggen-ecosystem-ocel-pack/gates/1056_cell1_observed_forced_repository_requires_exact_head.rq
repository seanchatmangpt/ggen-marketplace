# MESSAGE: an observed ForcedTop25 repository is not O-capable evidence unless the related RepositoryObject is exact-head bound.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?event ?repo WHERE {
  ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" .
  ?event a geocel:ManufacturingEvent ; geocel:inRun ?run ; geocel:eventType geocel:Observe ; geocel:relatesTo ?repo .
  ?repo a geocel:RepositoryObject ; geocel:repository ?name .
  FILTER(STRSTARTS(STR(?name), "seanchatmangpt/"))
  FILTER NOT EXISTS { ?repo geocel:exactHead ?head . }
}
