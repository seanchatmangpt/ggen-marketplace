# TPS93: CELL1 must state its admitted WIP limit rather than imply unlimited inventory.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" . FILTER NOT EXISTS { ?run geocel:expectedFanout ?limit . FILTER(?limit >= 1) } }