# MESSAGE: CELL1 must state ash_r2rml standing explicitly.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?r WHERE { ?run a geocel:ManufacturingRun; geocel:cell "CELL1". ?r a geocel:RepositoryObject; geocel:repository "seanchatmangpt/ash_r2rml". FILTER NOT EXISTS { ?r geocel:standing ?s. } }
