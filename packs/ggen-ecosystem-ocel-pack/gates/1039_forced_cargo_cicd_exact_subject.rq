# MESSAGE: CELL1 must bind cargo-cicd to an exact Git subject even when repository-local mutation authority is separately refused.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run WHERE { ?run a geocel:ManufacturingRun; geocel:cell "CELL1". FILTER NOT EXISTS { ?r a geocel:RepositoryObject; geocel:repository "seanchatmangpt/cargo-cicd"; geocel:exactHead ?h. FILTER(STRLEN(STR(?h))>0) } }
