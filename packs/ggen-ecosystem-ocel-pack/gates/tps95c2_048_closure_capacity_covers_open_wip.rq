PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:closureCapacity ?capacity ; geocel:admittedCount ?admitted ; geocel:terminalCount ?terminal . FILTER(xsd:integer(?capacity) < (xsd:integer(?admitted) - xsd:integer(?terminal))) } LIMIT 1
