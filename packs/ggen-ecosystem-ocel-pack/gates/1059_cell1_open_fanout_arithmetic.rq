# MESSAGE: CELL1 OpenFanoutObligations must equal U-M; the control plane may not hide unassimilated compatible consumers behind a stale aggregate.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run ?u ?m ?open WHERE {
  ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" ; geocel:uCount ?u ; geocel:mCount ?m ; geocel:openFanoutObligations ?open .
  FILTER(xsd:integer(?open) != (xsd:integer(?u) - xsd:integer(?m)))
}
