# TPS93: terminal_count must equal admitted_count for a completed TPS cycle.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?a ?m WHERE { ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" ; geocel:standing "COMPLETE" ; geocel:compatibleCount ?a ; geocel:mergedCount ?m . FILTER(?a != ?m) }