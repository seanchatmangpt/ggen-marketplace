# MESSAGE: terminal process evidence without an OCEL digest is not replay-bound.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run WHERE {
  ?run a geocel:ManufacturingRun ; geocel:standing ?standing .
  FILTER(?standing IN ("ALIVE", "PARTIAL_ALIVE", "BUILD_BROKEN", "REFUSED"))
  FILTER NOT EXISTS { ?run geocel:ocelDigest ?digest }
}
