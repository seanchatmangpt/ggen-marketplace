PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run ?count ?floor WHERE { ?run a geocel:ManufacturingRun ; geocel:semanticCommitCount ?count ; geocel:productionFloor ?floor . FILTER(xsd:integer(?count) < xsd:integer(?floor)) } LIMIT 1
