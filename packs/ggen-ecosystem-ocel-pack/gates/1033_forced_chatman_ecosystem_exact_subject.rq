# MESSAGE: CELL1 must bind chatman-ecosystem to an exact Git subject.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run WHERE { ?run a geocel:ManufacturingRun; geocel:cell "CELL1". FILTER NOT EXISTS { ?r a geocel:RepositoryObject; geocel:repository "seanchatmangpt/chatman-ecosystem"; geocel:exactHead ?h. FILTER(STRLEN(STR(?h))>0) } }
