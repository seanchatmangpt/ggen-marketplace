# MESSAGE: CELL1 must state ex4pm standing explicitly; repository presence or an exact SHA is not itself U, G, O, Q, or M evidence.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?repo WHERE {
  ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" .
  ?repo a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/ex4pm" .
  FILTER NOT EXISTS { ?repo geocel:standing ?standing . }
}
