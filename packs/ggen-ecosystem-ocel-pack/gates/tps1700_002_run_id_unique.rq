# MESSAGE: duplicate run identifiers collapse distinct production cycles and are refused.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?runId (COUNT(DISTINCT ?run) AS ?count) WHERE {
  ?run a geocel:ManufacturingRun ; geocel:runId ?runId .
}
GROUP BY ?runId
HAVING(COUNT(DISTINCT ?run) > 1)
