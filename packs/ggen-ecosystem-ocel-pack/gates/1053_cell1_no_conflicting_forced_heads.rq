# MESSAGE: a ForcedTop25 repository cannot carry two different exact heads in one CELL1 graph; that is stale parallel truth.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?name ?h1 ?h2 WHERE {
  ?r a geocel:RepositoryObject ; geocel:repository ?name ; geocel:exactHead ?h1, ?h2 .
  FILTER(?h1 != ?h2)
  FILTER(STRSTARTS(STR(?name), "seanchatmangpt/"))
}
