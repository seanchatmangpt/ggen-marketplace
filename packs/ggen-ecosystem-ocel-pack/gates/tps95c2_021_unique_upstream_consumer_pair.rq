PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?primitive ?subject WHERE { ?a a geocel:TPSPullObject ; geocel:upstreamPrimitive ?primitive ; geocel:consumerSubject ?subject . ?b a geocel:TPSPullObject ; geocel:upstreamPrimitive ?primitive ; geocel:consumerSubject ?subject . FILTER(?a != ?b) } LIMIT 1
