# MESSAGE: GGEN realization cannot exceed compatible/admissible population.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run ?u ?g WHERE {
  ?run a geocel:ManufacturingRun ; geocel:uCount ?u ; geocel:gCount ?g .
  FILTER(xsd:decimal(?g) > xsd:decimal(?u))
}
