# MESSAGE: a Project2-current run may not treat its OCEL digest as ambient input; it must declare the deterministic two-phase binding that hashes the generated OCEL before the final GGEN Project2 projection.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?reason WHERE {
  ?run a geocel:ManufacturingRun ;
       geocel:projectMemoryKey "ggen/ecosystem/ocel/current" .
  FILTER NOT EXISTS {
    ?binding a geocel:DigestBindingObject ;
      geocel:objectId ?bindingId ;
      geocel:digestAlgorithm "sha256" ;
      geocel:digestTarget "generated/ggen-ecosystem-ocel.json" ;
      geocel:digestBindingPhase "POST_OCEL_PRE_PROJECT2" .
  }
  BIND("OCEL_DIGEST_BINDING_PROTOCOL_MISSING" AS ?reason)
}
