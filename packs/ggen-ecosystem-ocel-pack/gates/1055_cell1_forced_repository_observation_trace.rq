# MESSAGE: each represented ForcedTop25 repository must participate in at least one CELL1 event; static inventory without an observation/admission/refusal trace is not execution evidence.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repo ?name WHERE {
  ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" .
  ?repo a geocel:RepositoryObject ; geocel:repository ?name .
  FILTER(STRSTARTS(STR(?name), "seanchatmangpt/"))
  FILTER NOT EXISTS { ?event a geocel:ManufacturingEvent ; geocel:inRun ?run ; geocel:relatesTo ?repo . }
}
