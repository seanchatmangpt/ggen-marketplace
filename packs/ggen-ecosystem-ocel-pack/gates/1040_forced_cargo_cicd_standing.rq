# MESSAGE: CELL1 must state cargo-cicd standing explicitly so authority refusal is not confused with incompatibility or absence.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?r WHERE { ?run a geocel:ManufacturingRun; geocel:cell "CELL1". ?r a geocel:RepositoryObject; geocel:repository "seanchatmangpt/cargo-cicd". FILTER NOT EXISTS { ?r geocel:standing ?s. } }
