# MESSAGE: CELL1 must state chatgpt-cloud-elixir standing explicitly; control-plane presence alone is not lifecycle evidence.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?repo WHERE { ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" . ?repo a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/chatgpt-cloud-elixir" . FILTER NOT EXISTS { ?repo geocel:standing ?standing . } }
