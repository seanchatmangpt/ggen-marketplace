# MESSAGE: CELL1 standing values must be explicit non-empty evidence states; empty strings are not typed standing.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repo ?standing WHERE {
  ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" .
  ?repo a geocel:RepositoryObject ; geocel:repository ?name ; geocel:standing ?standing .
  FILTER(STRSTARTS(STR(?name), "seanchatmangpt/"))
  FILTER(STRLEN(STR(?standing)) = 0)
}
