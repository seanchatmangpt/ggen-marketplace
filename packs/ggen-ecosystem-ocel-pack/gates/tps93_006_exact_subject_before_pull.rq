# TPS93: a selected repository object requires an immutable exact head before admission.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repo WHERE { ?repo a geocel:RepositoryObject ; geocel:standing "SELECTED" . FILTER NOT EXISTS { ?repo geocel:exactHead ?head . FILTER(REGEX(STR(?head), "^[0-9a-f]{40}$")) } }