# TPS93: merged/default-lineage standing requires a qualification event.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repo WHERE { ?repo a geocel:RepositoryObject ; geocel:standing "M" . FILTER NOT EXISTS { ?event a geocel:ManufacturingEvent ; geocel:eventType "qualify" ; geocel:relatesTo ?repo . } }