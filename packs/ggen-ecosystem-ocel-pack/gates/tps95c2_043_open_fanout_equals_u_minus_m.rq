PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:uCount ?u ; geocel:mCount ?m ; geocel:openFanoutObligations ?open . FILTER(xsd:integer(?open) != (xsd:integer(?u) - xsd:integer(?m))) } LIMIT 1
