# MESSAGE: qualification cannot exceed independently observed/exercised consequences.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run ?o ?q WHERE {
  ?run a geocel:ManufacturingRun ; geocel:oCount ?o ; geocel:qCount ?q .
  FILTER(xsd:decimal(?q) > xsd:decimal(?o))
}
