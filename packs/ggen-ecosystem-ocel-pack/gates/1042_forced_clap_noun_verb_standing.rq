# MESSAGE: CELL1 must state clap-noun-verb standing explicitly.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?r WHERE { ?run a geocel:ManufacturingRun; geocel:cell "CELL1". ?r a geocel:RepositoryObject; geocel:repository "seanchatmangpt/clap-noun-verb". FILTER NOT EXISTS { ?r geocel:standing ?s. } }
