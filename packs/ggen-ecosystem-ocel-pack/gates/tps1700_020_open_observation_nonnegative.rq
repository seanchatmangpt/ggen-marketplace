# MESSAGE: open observation inventory cannot be negative.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run ?open WHERE {
  ?run a geocel:ManufacturingRun ; geocel:openObservationObligations ?open .
  FILTER(xsd:decimal(?open) < 0)
}
