# TPS93: aggregate lifecycle counts must satisfy U>=G>=O>=Q>=M.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run WHERE { ?run geocel:compatibleCount ?u ; geocel:generatedCount ?g ; geocel:observedCount ?o ; geocel:qualifiedCount ?q ; geocel:mergedCount ?m . FILTER(?u<?g || ?g<?o || ?o<?q || ?q<?m) }