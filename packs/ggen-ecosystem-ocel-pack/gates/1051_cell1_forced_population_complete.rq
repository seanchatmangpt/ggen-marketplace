# MESSAGE: a CELL1 graph that claims ForcedTop25 coverage must represent all 25 distinct forced repository identities; partial census is not complete frontier evidence.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run (COUNT(DISTINCT ?name) AS ?forced_count) WHERE {
  ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" .
  VALUES ?name { "seanchatmangpt/ex4pm" "seanchatmangpt/gymact" "seanchatmangpt/autofde-lab" "seanchatmangpt/autofde" "seanchatmangpt/xaas" "seanchatmangpt/chatgpt-cloud-elixir" "seanchatmangpt/process-intelligence" "seanchatmangpt/ash_r2rml" "seanchatmangpt/wasm4pm" "seanchatmangpt/pm4wasm" "seanchatmangpt/mfact" "seanchatmangpt/mfact-command-center" "seanchatmangpt/mfw" "seanchatmangpt/SREGym" "seanchatmangpt/fdegym" "seanchatmangpt/revops" "seanchatmangpt/chatman-ecosystem" "seanchatmangpt/POWL" "seanchatmangpt/swarmsh-v2" "seanchatmangpt/cargo-cicd" "seanchatmangpt/clap-noun-verb" "seanchatmangpt/unrdf" "seanchatmangpt/dspygen" "seanchatmangpt/yawl" "seanchatmangpt/a2a-rs" }
  ?repo a geocel:RepositoryObject ; geocel:repository ?name .
}
GROUP BY ?run
HAVING(COUNT(DISTINCT ?name) < 25)
