# MESSAGE: CELL1 must state unrdf standing explicitly so a transport failure is not silently promoted to lifecycle success.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?r WHERE { ?run a geocel:ManufacturingRun; geocel:cell "CELL1". ?r a geocel:RepositoryObject; geocel:repository "seanchatmangpt/unrdf". FILTER NOT EXISTS { ?r geocel:standing ?s. } }
