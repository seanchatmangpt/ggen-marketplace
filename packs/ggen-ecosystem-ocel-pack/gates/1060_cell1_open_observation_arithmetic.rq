# MESSAGE: CELL1 OpenObservationObligations must equal G-O; generated consumers are not observed merely because manufacture completed.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run ?g ?o ?open WHERE {
  ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" ; geocel:gCount ?g ; geocel:oCount ?o ; geocel:openObservationObligations ?open .
  FILTER(xsd:integer(?open) != (xsd:integer(?g) - xsd:integer(?o)))
}
