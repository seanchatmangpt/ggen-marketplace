# MESSAGE: CELL1 must bind unrdf to an exact Git subject even when qualification transport has failed historically.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run WHERE { ?run a geocel:ManufacturingRun; geocel:cell "CELL1". FILTER NOT EXISTS { ?r a geocel:RepositoryObject; geocel:repository "seanchatmangpt/unrdf"; geocel:exactHead ?h. FILTER(STRLEN(STR(?h))>0) } }
