# MESSAGE: a ForcedTop25 repository cannot carry contradictory standings in one CELL1 graph without an explicit supersession model.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?name ?s1 ?s2 WHERE {
  ?r a geocel:RepositoryObject ; geocel:repository ?name ; geocel:standing ?s1, ?s2 .
  FILTER(?s1 != ?s2)
  FILTER(STRSTARTS(STR(?name), "seanchatmangpt/"))
}
