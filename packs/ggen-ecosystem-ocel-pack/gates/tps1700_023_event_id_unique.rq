# MESSAGE: duplicate event identifiers collapse process history and are refused.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?eventId (COUNT(DISTINCT ?event) AS ?count) WHERE {
  ?event a geocel:ManufacturingEvent ; geocel:eventId ?eventId .
}
GROUP BY ?eventId
HAVING(COUNT(DISTINCT ?event) > 1)
