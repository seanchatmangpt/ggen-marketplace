# MESSAGE: generic marketplace qualification may contain zero run instances; an actual generation graph must never contain more than one ManufacturingRun, so one Project-memory request cannot ambiguously bind multiple runs.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT (COUNT(DISTINCT ?run) AS ?run_count) WHERE {
  ?run a geocel:ManufacturingRun .
}
HAVING(COUNT(DISTINCT ?run) > 1)
