# TPS93: completed cycles cannot leave admitted repository objects UNKNOWN.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repo WHERE { ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" ; geocel:standing "COMPLETE" . ?repo a geocel:RepositoryObject ; geocel:standing "UNKNOWN" . }