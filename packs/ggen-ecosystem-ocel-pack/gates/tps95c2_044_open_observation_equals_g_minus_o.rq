PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:gCount ?g ; geocel:oCount ?o ; geocel:openObservationObligations ?open . FILTER(xsd:integer(?open) != (xsd:integer(?g) - xsd:integer(?o))) } LIMIT 1
