# TPS93: lifecycle and obligation counts cannot be negative.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?v WHERE { ?run ?p ?v . VALUES ?p { geocel:compatibleCount geocel:generatedCount geocel:observedCount geocel:qualifiedCount geocel:mergedCount geocel:openFanoutObligations geocel:openObservationObligations } FILTER(?v < 0) }