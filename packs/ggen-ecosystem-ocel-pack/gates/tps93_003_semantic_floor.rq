# TPS93: completed CELL1 cycles may not claim completion below the 50-semantic-unit floor.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?count WHERE { ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" ; geocel:standing "COMPLETE" ; geocel:generatedCount ?count . FILTER(?count < 50) }