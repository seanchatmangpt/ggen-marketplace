# MESSAGE: CELL1 must bind yawl to an exact Git subject even when hosted qualification has failed historically.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run WHERE { ?run a geocel:ManufacturingRun; geocel:cell "CELL1". FILTER NOT EXISTS { ?r a geocel:RepositoryObject; geocel:repository "seanchatmangpt/yawl"; geocel:exactHead ?h. FILTER(STRLEN(STR(?h))>0) } }
