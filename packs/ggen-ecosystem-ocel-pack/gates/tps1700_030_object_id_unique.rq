# MESSAGE: duplicate object identifiers collapse independent manufacturing subjects.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?objectId (COUNT(DISTINCT ?object) AS ?count) WHERE {
  ?object a geocel:ManufacturingObject ; geocel:objectId ?objectId .
}
GROUP BY ?objectId
HAVING(COUNT(DISTINCT ?object) > 1)
