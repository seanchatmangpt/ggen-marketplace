# MESSAGE: expected fanout is a nonnegative planning quantity.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run ?expected WHERE {
  ?run a geocel:ManufacturingRun ; geocel:expectedFanout ?expected .
  FILTER(xsd:decimal(?expected) < 0)
}
