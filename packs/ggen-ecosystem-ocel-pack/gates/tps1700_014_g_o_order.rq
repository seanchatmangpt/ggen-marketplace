# MESSAGE: observed execution cannot exceed realized GGEN consequences.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run ?g ?o WHERE {
  ?run a geocel:ManufacturingRun ; geocel:gCount ?g ; geocel:oCount ?o .
  FILTER(xsd:decimal(?o) > xsd:decimal(?g))
}
