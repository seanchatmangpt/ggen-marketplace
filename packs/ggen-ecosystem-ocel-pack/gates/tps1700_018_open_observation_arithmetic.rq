# MESSAGE: open observation obligations must equal G minus O.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?run ?g ?o ?open WHERE {
  ?run a geocel:ManufacturingRun ; geocel:gCount ?g ; geocel:oCount ?o ; geocel:openObservationObligations ?open .
  FILTER(xsd:decimal(?open) != xsd:decimal(?g) - xsd:decimal(?o))
}
