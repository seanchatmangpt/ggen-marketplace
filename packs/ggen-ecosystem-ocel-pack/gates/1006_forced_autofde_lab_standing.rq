# MESSAGE: CELL1 must state autofde-lab standing explicitly; exact identity alone is not lifecycle evidence.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?repo WHERE { ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" . ?repo a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/autofde-lab" . FILTER NOT EXISTS { ?repo geocel:standing ?standing . } }
