# MESSAGE: CELL1 must bind ForcedTop25 consumer ex4pm to an explicit exact Git subject before any fanout standing can be trusted.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run WHERE {
  ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" .
  FILTER NOT EXISTS {
    ?repo a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/ex4pm" ; geocel:exactHead ?head .
    FILTER(STRLEN(STR(?head)) > 0)
  }
}
