# TPS93: Q may not exist without O for the same repository object.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repo WHERE { ?repo a geocel:RepositoryObject ; geocel:standing "Q" . FILTER NOT EXISTS { ?event a geocel:ManufacturingEvent ; geocel:eventType "observe" ; geocel:relatesTo ?repo . } }