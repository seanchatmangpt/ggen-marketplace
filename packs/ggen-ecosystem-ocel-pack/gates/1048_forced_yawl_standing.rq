# MESSAGE: CELL1 must state yawl standing explicitly so hosted pre-execution failure is not conflated with lifecycle success or incompatibility.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?r WHERE { ?run a geocel:ManufacturingRun; geocel:cell "CELL1". ?r a geocel:RepositoryObject; geocel:repository "seanchatmangpt/yawl". FILTER NOT EXISTS { ?r geocel:standing ?s. } }
