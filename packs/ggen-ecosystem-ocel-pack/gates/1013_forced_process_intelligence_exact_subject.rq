# MESSAGE: CELL1 must bind process-intelligence to an exact Git subject.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run WHERE { ?run a geocel:ManufacturingRun; geocel:cell "CELL1". FILTER NOT EXISTS { ?r a geocel:RepositoryObject; geocel:repository "seanchatmangpt/process-intelligence"; geocel:exactHead ?h. FILTER(STRLEN(STR(?h))>0) } }
