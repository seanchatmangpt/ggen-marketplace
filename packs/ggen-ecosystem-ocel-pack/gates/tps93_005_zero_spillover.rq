# TPS93: completed CELL1 cycles must close all admitted fanout obligations.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?run ?open WHERE { ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" ; geocel:standing "COMPLETE" ; geocel:openFanoutObligations ?open . FILTER(?open != 0) }