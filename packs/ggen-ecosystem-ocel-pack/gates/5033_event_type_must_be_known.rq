PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?event ?type WHERE {
  ?event a geocel:ManufacturingEvent ; geocel:eventType ?type .
  FILTER(?type NOT IN (geocel:Observe, geocel:Admit, geocel:Select, geocel:Generate, geocel:Realize, geocel:Qualify, geocel:Merge, geocel:Receipt, geocel:Replay, geocel:Refuse))
}
