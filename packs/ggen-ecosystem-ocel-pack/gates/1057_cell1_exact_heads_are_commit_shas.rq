# MESSAGE: CELL1 exact-head bindings must be immutable 40-hex Git commit identities, not mutable branch labels or prose.
PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repo ?head WHERE {
  ?run a geocel:ManufacturingRun ; geocel:cell "CELL1" .
  ?repo a geocel:RepositoryObject ; geocel:repository ?name ; geocel:exactHead ?head .
  FILTER(STRSTARTS(STR(?name), "seanchatmangpt/"))
  FILTER(!REGEX(STR(?head), "^[0-9a-f]{40}$"))
}
