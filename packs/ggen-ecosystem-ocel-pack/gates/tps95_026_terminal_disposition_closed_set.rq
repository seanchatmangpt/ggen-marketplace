PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?pull ?d WHERE { ?pull a geocel:TPSPullObject ; geocel:closureDisposition ?d . FILTER(str(?d) NOT IN ("MERGED_ALIVE","MERGED_PARTIAL_ALIVE","SUPERSEDED_CLOSED","DUPLICATE_CLOSED","REFUSED_TYPED","PARKED[IRREDUCIBLE_AUTHORITY]")) } LIMIT 1
