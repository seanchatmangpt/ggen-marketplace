PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?head ?merge WHERE {
  ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/gymact" ; geocel:exactHead ?head .
  ?merge a geocel:ManufacturingEvent ; geocel:eventType geocel:Merge ; geocel:relatesTo ?repoObject ; geocel:inRun ?run .
  FILTER NOT EXISTS {
    ?receipt a geocel:ManufacturingEvent ; geocel:eventType geocel:Receipt ; geocel:relatesTo ?repoObject ; geocel:inRun ?run .
    ?replay a geocel:ManufacturingEvent ; geocel:eventType geocel:Replay ; geocel:relatesTo ?repoObject ; geocel:inRun ?run .
  }
}
