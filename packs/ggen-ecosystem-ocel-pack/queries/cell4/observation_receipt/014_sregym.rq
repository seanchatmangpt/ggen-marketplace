PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?head ?observe WHERE {
  ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/SREGym" ; geocel:exactHead ?head .
  ?observe a geocel:ManufacturingEvent ; geocel:eventType geocel:Observe ; geocel:relatesTo ?repoObject ; geocel:inRun ?run .
  FILTER NOT EXISTS { ?receipt a geocel:ManufacturingEvent ; geocel:eventType geocel:Receipt ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . }
}
