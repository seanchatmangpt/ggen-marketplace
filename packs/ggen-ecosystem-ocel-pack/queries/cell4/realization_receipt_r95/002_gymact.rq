PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?head ?realize WHERE {
  ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/gymact" ; geocel:exactHead ?head .
  ?realize a geocel:ManufacturingEvent ; geocel:eventType geocel:Realize ; geocel:relatesTo ?repoObject ; geocel:inRun ?run .
  FILTER NOT EXISTS { ?receipt a geocel:ManufacturingEvent ; geocel:eventType geocel:Receipt ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . }
}
