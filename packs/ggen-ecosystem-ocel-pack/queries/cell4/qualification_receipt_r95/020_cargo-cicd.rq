PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?head ?qualify WHERE {
  ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/cargo-cicd" ; geocel:exactHead ?head .
  ?qualify a geocel:ManufacturingEvent ; geocel:eventType geocel:Qualify ; geocel:relatesTo ?repoObject ; geocel:inRun ?run .
  FILTER NOT EXISTS { ?receipt a geocel:ManufacturingEvent ; geocel:eventType geocel:Receipt ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . }
}
