PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?merge ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:cycleId ?cycle . FILTER(CONTAINS(STR(?cycle), "R110")) ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/lifegym" . ?merge a geocel:ManufacturingEvent ; geocel:eventType geocel:Merge ; geocel:relatesTo ?repoObject ; geocel:inRun ?run ; geocel:sequence ?mseq . FILTER NOT EXISTS { ?q a geocel:ManufacturingEvent ; geocel:eventType geocel:Qualify ; geocel:relatesTo ?repoObject ; geocel:inRun ?run ; geocel:sequence ?qseq . FILTER(?qseq < ?mseq) } }
