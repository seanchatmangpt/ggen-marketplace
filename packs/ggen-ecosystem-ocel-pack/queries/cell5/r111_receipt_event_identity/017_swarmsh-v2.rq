PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?receipt ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:cycleId ?cycle . FILTER(CONTAINS(STR(?cycle), "R111")) ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/swarmsh-v2" . ?receipt a geocel:ManufacturingEvent ; geocel:eventType geocel:Receipt ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . FILTER NOT EXISTS { ?receipt geocel:eventId ?eventId . FILTER(STRLEN(STR(?eventId)) > 0) } }
