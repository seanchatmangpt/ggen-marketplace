PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?repoObject ?run ?terminalSeq WHERE { ?run a geocel:ManufacturingRun ; geocel:cycleId ?cycle . FILTER(CONTAINS(STR(?cycle), "R96")) ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/yawl" . ?terminal a geocel:ManufacturingEvent ; geocel:eventType ?tt ; geocel:relatesTo ?repoObject ; geocel:inRun ?run ; geocel:sequence ?terminalSeq . FILTER(?tt IN (geocel:Merge, geocel:Refuse)) FILTER NOT EXISTS { ?receipt a geocel:ManufacturingEvent ; geocel:eventType geocel:Receipt ; geocel:relatesTo ?repoObject ; geocel:inRun ?run ; geocel:sequence ?receiptSeq . FILTER(xsd:integer(?receiptSeq) > xsd:integer(?terminalSeq)) } }
