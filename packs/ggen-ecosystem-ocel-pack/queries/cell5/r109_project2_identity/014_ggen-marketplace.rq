PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?q ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:cycleId ?cycle . FILTER(CONTAINS(STR(?cycle), "R109")) ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/ggen-marketplace" . ?q a geocel:ManufacturingEvent ; geocel:eventType geocel:Qualify ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . FILTER NOT EXISTS { ?run geocel:projectNumber ?projectNumber . FILTER(STR(?projectNumber) = "2") } }