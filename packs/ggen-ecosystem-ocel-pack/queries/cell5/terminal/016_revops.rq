PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?head WHERE {
  ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/revops" ; geocel:exactHead ?head .
  FILTER NOT EXISTS { ?terminal a geocel:ManufacturingEvent ; geocel:eventType ?terminalType ; geocel:relatesTo ?repoObject . FILTER(?terminalType IN (geocel:Merge, geocel:Refuse)) }
}
