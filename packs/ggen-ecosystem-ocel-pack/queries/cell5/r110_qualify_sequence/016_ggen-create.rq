PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?q ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:cycleId ?cycle . FILTER(CONTAINS(STR(?cycle), "R110")) ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/ggen-create" . ?q a geocel:ManufacturingEvent ; geocel:eventType geocel:Qualify ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . FILTER NOT EXISTS { ?q geocel:sequence ?seq . FILTER(?seq >= 0) } }
