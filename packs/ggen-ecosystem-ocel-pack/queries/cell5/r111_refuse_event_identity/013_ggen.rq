PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?refuse ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:cycleId ?cycle . FILTER(CONTAINS(STR(?cycle), "R111")) ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/ggen" . ?refuse a geocel:ManufacturingEvent ; geocel:eventType geocel:Refuse ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . FILTER NOT EXISTS { ?refuse geocel:eventId ?eventId . FILTER(STRLEN(STR(?eventId)) > 0) } }
