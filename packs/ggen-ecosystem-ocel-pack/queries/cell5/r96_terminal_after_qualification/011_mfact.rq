PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:cycleId ?cycle . FILTER(CONTAINS(STR(?cycle), "R96")) ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/mfact" . FILTER EXISTS { ?q a geocel:ManufacturingEvent ; geocel:eventType geocel:Qualify ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . } FILTER NOT EXISTS { ?t a geocel:ManufacturingEvent ; geocel:eventType ?tt ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . FILTER(?tt IN (geocel:Merge, geocel:Refuse)) } }
