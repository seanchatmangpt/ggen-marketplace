PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?run ?qualifySeq WHERE { ?run a geocel:ManufacturingRun ; geocel:cycleId ?cycle . FILTER(CONTAINS(STR(?cycle), "R106")) ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/ex4pm" . ?q a geocel:ManufacturingEvent ; geocel:eventType geocel:Qualify ; geocel:relatesTo ?repoObject ; geocel:inRun ?run ; geocel:sequence ?qualifySeq . FILTER NOT EXISTS { ?t a geocel:ManufacturingEvent ; geocel:eventType ?tt ; geocel:relatesTo ?repoObject ; geocel:inRun ?run ; geocel:sequence ?terminalSeq . FILTER(?tt IN (geocel:Merge, geocel:Refuse)) FILTER(xsd:integer(?terminalSeq) > xsd:integer(?qualifySeq)) } }