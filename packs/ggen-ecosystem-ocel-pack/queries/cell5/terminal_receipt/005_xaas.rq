PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?head ?terminal ?run WHERE {
  ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/xaas" ; geocel:exactHead ?head .
  ?terminal a geocel:ManufacturingEvent ; geocel:eventType ?terminalType ; geocel:relatesTo ?repoObject ; geocel:inRun ?run .
  FILTER(?terminalType IN (geocel:Merge, geocel:Refuse))
  FILTER NOT EXISTS { ?receipt a geocel:ManufacturingEvent ; geocel:eventType geocel:Receipt ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . }
}
