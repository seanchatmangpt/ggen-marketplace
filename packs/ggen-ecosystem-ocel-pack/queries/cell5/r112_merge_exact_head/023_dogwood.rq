PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?merge ?run WHERE { ?run a geocel:ManufacturingRun ; geocel:cycleId ?cycle . FILTER(CONTAINS(STR(?cycle), "R112")) ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/dogwood" . ?merge a geocel:ManufacturingEvent ; geocel:eventType geocel:Merge ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . FILTER NOT EXISTS { ?repoObject geocel:exactHead ?head . FILTER(STRLEN(STR(?head)) > 0) } }