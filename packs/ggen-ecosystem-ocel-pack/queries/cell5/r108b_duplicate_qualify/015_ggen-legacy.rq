PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?run (COUNT(?q) AS ?qualifyCount) WHERE { ?run a geocel:ManufacturingRun ; geocel:cycleId ?cycle . FILTER(CONTAINS(STR(?cycle), "R108")) ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/ggen-legacy" . ?q a geocel:ManufacturingEvent ; geocel:eventType geocel:Qualify ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . } GROUP BY ?repoObject ?run HAVING(COUNT(?q) > 1)
