PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?head WHERE {
  ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/autofde" ; geocel:exactHead ?head .
  FILTER EXISTS { ?realize a geocel:ManufacturingEvent ; geocel:eventType geocel:Realize ; geocel:relatesTo ?repoObject . }
  FILTER NOT EXISTS { ?observe a geocel:ManufacturingEvent ; geocel:eventType geocel:Observe ; geocel:relatesTo ?repoObject . }
}
