PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?head WHERE {
  ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/swarmsh-v2" ; geocel:exactHead ?head .
  FILTER EXISTS { ?qualify a geocel:ManufacturingEvent ; geocel:eventType geocel:Qualify ; geocel:relatesTo ?repoObject . }
  FILTER NOT EXISTS { ?merge a geocel:ManufacturingEvent ; geocel:eventType geocel:Merge ; geocel:relatesTo ?repoObject . }
}
