PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repository ?head ?refusal ?reason WHERE {
  ?repo a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/xaas" ; geocel:exactHead ?head .
  ?refusal a geocel:RefusalObject ; geocel:repository "seanchatmangpt/xaas" ; geocel:reason ?reason .
  FILTER NOT EXISTS { ?receipt a geocel:ManufacturingEvent ; geocel:eventType geocel:Receipt ; geocel:relatesTo ?refusal . }
  BIND("seanchatmangpt/xaas" AS ?repository)
}