PREFIX geocel: <https://ggen.dev/ontology/ggen-ecosystem-ocel#>
SELECT ?repoObject ?head ?terminal WHERE {
  ?repoObject a geocel:RepositoryObject ; geocel:repository "seanchatmangpt/ex4pm" ; geocel:exactHead ?head .
  ?terminal a geocel:ManufacturingEvent ; geocel:eventType geocel:Terminal ; geocel:relatesTo ?repoObject ; geocel:inRun ?run .
  FILTER NOT EXISTS { ?contain a geocel:ManufacturingEvent ; geocel:eventType geocel:Containment ; geocel:relatesTo ?repoObject ; geocel:inRun ?run . }
}
