# Any row = violation. Lifetime priors in [1,150] years; cost min <= max.
PREFIX el: <urn:trade:reticle:electrical:>
SELECT ?subject ?why
WHERE {
  {
    ?subject el:typicalLifetimeYears ?y .
    FILTER(?y < 1.0 || ?y > 150.0)
    BIND(CONCAT("lifetime out of range: ", STR(?y)) AS ?why)
  }
  UNION
  {
    ?subject el:costMinUsd ?lo .
    ?subject el:costMaxUsd ?hi .
    FILTER(?lo < 0.0 || ?lo > ?hi)
    BIND(CONCAT("cost range invalid: ", STR(?lo), " > ", STR(?hi)) AS ?why)
  }
}
