@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix el: <urn:trade:reticle:electrical:> .

# SHACL shapes over the claim corpus, complementing the SPARQL gates.
# Gates refuse (rows = violation); shapes declare the structural contract.

el:ClaimShape a sh:NodeShape ;
    sh:targetClass el:DiagnosticTree ;
    sh:property [
        sh:path el:claimType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[a-z_]+$" ;
    ] ;
    sh:property [
        sh:path el:requiredTelemetry ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

el:EquipmentPriorShape a sh:NodeShape ;
    sh:targetClass el:EquipmentPrior ;
    sh:property [
        sh:path el:equipmentClass ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path el:typicalLifetimeYears ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal ;
        sh:maxInclusive "150.0"^^xsd:decimal ;
    ] .

el:CostBaselineShape a sh:NodeShape ;
    sh:targetClass el:CostBaseline ;
    sh:property [
        sh:path el:costMinUsd ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "0.0"^^xsd:decimal ;
    ] ;
    sh:property [
        sh:path el:costMaxUsd ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

el:RefusalShape a sh:NodeShape ;
    sh:targetClass el:Refusal ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:pattern "^Refused" ;
    ] .
