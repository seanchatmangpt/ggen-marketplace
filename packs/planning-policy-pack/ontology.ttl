@prefix pp: <https://ggen.dev/ontology/planning-policy#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pp:Planner a rdfs:Class .
pp:Policy a rdfs:Class .
pp:Role a rdfs:Class .
pp:Agent a rdfs:Class .
pp:World a rdfs:Class .
pp:Observation a rdfs:Class .
pp:ActionProjection a rdfs:Class .
pp:InformationPartition a rdfs:Class .
pp:Episode a rdfs:Class .

pp:PlanningFormalism a rdfs:Class .
pp:HDDLFormalism a rdfs:Class ;
  rdfs:subClassOf pp:PlanningFormalism ;
  rdfs:comment "Hierarchical task decomposition formalism. It decomposes admitted intent; it does not grant execution authority." .
pp:FONDFormalism a rdfs:Class ;
  rdfs:subClassOf pp:PlanningFormalism ;
  rdfs:comment "Fully observable nondeterministic planning formalism for policies over uncertain outcomes. Recovery branches may vary the path but may not weaken admission, disclosure, or authority fences." .
pp:PlanningState a rdfs:Class .
pp:Task a rdfs:Class .
pp:CompoundTask a rdfs:Class ; rdfs:subClassOf pp:Task .
pp:PrimitiveTask a rdfs:Class ; rdfs:subClassOf pp:Task .
pp:Method a rdfs:Class .
pp:Action a rdfs:Class .
pp:Outcome a rdfs:Class .
pp:NonDeterministicOutcome a rdfs:Class ; rdfs:subClassOf pp:Outcome .
pp:RecoveryBranch a rdfs:Class .
pp:AdmissionCheck a rdfs:Class .
pp:AuthorityCheck a rdfs:Class .
pp:Refusal a rdfs:Class .
pp:Block a rdfs:Class .

pp:planner a rdf:Property .
pp:parameters a rdf:Property .
pp:objective a rdf:Property .
pp:observationProjection a rdf:Property .
pp:actionProjection a rdf:Property .
pp:role a rdf:Property .
pp:policy a rdf:Property .
pp:world a rdf:Property .

pp:usesFormalism a rdf:Property .
pp:decomposesTask a rdf:Property .
pp:hasSubtask a rdf:Property .
pp:orderedBefore a rdf:Property .
pp:hasPrecondition a rdf:Property .
pp:hasEffect a rdf:Property .
pp:hasOutcome a rdf:Property .
pp:selectsAction a rdf:Property .
pp:realizesAction a rdf:Property .
pp:recoversFrom a rdf:Property .
pp:recoveryAction a rdf:Property .
pp:requiresAdmission a rdf:Property .
pp:requiresAuthority a rdf:Property .
pp:preservesFence a rdf:Property .
pp:terminalStanding a rdf:Property .

pp:HDDL a pp:HDDLFormalism .
pp:FOND a pp:FONDFormalism .
