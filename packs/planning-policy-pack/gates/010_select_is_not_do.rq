# MESSAGE: "SELECT != DO" -- planner/policy output (pp:PlannerOutput) is
# SELECT-scope only: an admissible, bounded, explainable candidate for
# work, never itself actuation authority. Any pp:PlannerOutput individual
# asserted with pp:hasDOAuthority "true"^^xsd:boolean is refused outright;
# actuation authority requires a separate, receipted BRCE admission step
# that this pack's vocabulary deliberately does not and cannot grant.
#
# Each row names the offending PlannerOutput individual.
PREFIX pp: <https://ggen.dev/ontology/planning-policy#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?output WHERE {
  ?output a pp:PlannerOutput ;
          pp:hasDOAuthority true .
}
ORDER BY ?output
