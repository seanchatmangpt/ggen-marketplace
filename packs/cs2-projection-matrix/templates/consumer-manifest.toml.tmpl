---
to: "generated/{{ consumer_slug }}/projection.toml"
for_each: "projection_matrix"
sparql:
  projection_matrix: |
    PREFIX pm: <https://ggen.dev/marketplace/projection-matrix#>
    SELECT ?projection ?subject_id ?consumer ?source_repository ?source_sha ?source_digest
           ?consumer_repository ?consumer_slug ?target_path ?adapter_kind ?package_name ?module_name
    WHERE {
      ?projection a pm:Projection ;
        pm:subject ?subject_id ;
        pm:consumer ?consumer ;
        pm:targetPath ?target_path ;
        pm:adapterKind ?adapter_kind ;
        pm:enabled true .
      ?subject_id a pm:Subject ;
        pm:sourceRepository ?source_repository ;
        pm:sourceSha ?source_sha ;
        pm:sourceDigest ?source_digest .
      ?consumer a pm:Consumer ;
        pm:consumerRepository ?consumer_repository ;
        pm:consumerSlug ?consumer_slug .
      OPTIONAL { ?projection pm:packageName ?package_name }
      OPTIONAL { ?projection pm:moduleName ?module_name }
    }
    ORDER BY ?subject_id ?consumer ?target_path ?adapter_kind
---
# Generated from canonical projection RDF. Do not edit.
[projection]
subject = "{{ subject_id }}"
consumer = "{{ consumer_slug }}"
adapter_kind = "{{ adapter_kind }}"
target_path = "{{ target_path }}"
source_sha = "{{ source_sha }}"
source_digest = "{{ source_digest }}"

[package]
name = "{{ package_name | default(value="") }}"
module = "{{ module_name | default(value="") }}"
