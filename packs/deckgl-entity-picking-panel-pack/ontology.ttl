@prefix pack: <urn:ggen-marketplace:deckgl-entity-picking-panel-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pack:EntityDetailPanel a pack:ReactComponent ;
    rdfs:label "EntityDetailPanel" ;
    pack:pickingSource "DeckGL onHover/onClick info.object" ;
    pack:handMaintainedHitTest false ;
    rdfs:comment "Docked shadcn Card panel that renders whichever entity OpsDeckCanvas reports as picked, or an empty-selection state." .

pack:DependsOnCanvas a pack:PackDependency ;
    rdfs:label "deckgl-orthographic-layers-pack" ;
    pack:importedSymbol "DeckEntity, OpsDeckCanvasProps.onPick" ;
    rdfs:comment "Consumes the DeckEntity type and onPick callback contract exported by OpsDeckCanvas." .
