---
to: "src/index.css"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_observatory_ui_deckgl_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}:root {
  --bg-color: #050510;
  --panel-bg: rgba(10, 10, 20, 0.7);
  --border-color: rgba(0, 255, 255, 0.3);
  --text-primary: #e0f0ff;
  --text-secondary: #8ab4f8;
  
  /* Cyberpunk Neons */
  --neon-cyan: #0ff;
  --neon-magenta: #f0f;
  --neon-blue: #0088ff;
  --neon-green: #0f0;
  --neon-orange: #ff8800;
  --neon-red: #f00;

  font-family: 'Courier New', Courier, monospace; /* Tech/Terminal feel */
  background-color: var(--bg-color);
  color: var(--text-primary);
  margin: 0;
  padding: 0;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

body {
  margin: 0;
  padding: 0;
  background-image: radial-gradient(circle at 50% 50%, #111 0%, #000 100%);
}

* {
  box-sizing: border-box;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: rgba(0,0,0,0.5);
}
::-webkit-scrollbar-thumb {
  background: var(--neon-cyan);
  border-radius: 3px;
}
{% endraw %}