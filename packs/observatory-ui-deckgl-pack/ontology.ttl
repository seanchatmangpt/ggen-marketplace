gc:gc_subject_observatory_ui_deckgl_pack a gc:GenerationSubject ;
    gc:name "vite" ;
    gc:upper "VITE" ;
    gc:lower "vite" ;
    gc:capitalized "Vite" ;
    gc:pascal "Vite" ;
    gc:camel "vite" ;
    gc:snake "vite" ;
    gc:upper_snake "VITE" ;
    gc:kebab "vite" ;
