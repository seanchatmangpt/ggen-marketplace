@prefix pack: <urn:ggen-marketplace:observatory-ui-deckgl-pack:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:project a pack:SourceProject ;
    rdfs:label "observatory-ui" ;
    pack:sourcePath "/Users/sac/bcinr/observatory-ui"^^xsd:string ;
    pack:framework "React 19 + Vite + TypeScript" ;
    pack:packageManager "npm (package.json, no lockfile-specific evidence scanned)" ;
    rdfs:comment "Admitted from a real scan of package.json and src/ contents on 2026-08-17. This is a fresh Vite+React scaffold, not a built-out application." .

pack:deckglDependency a pack:ListedDependency ;
    rdfs:label "deck.gl" ;
    pack:declaredIn "package.json dependencies" ;
    pack:version "^9.3.7" ;
    pack:relatedPackage "@deck.gl/react ^9.3.7, @deck.gl/layers ^9.3.7, mapbox-gl ^3.26.0, react-map-gl ^8.1.1" ;
    pack:usageStatus "UNUSED" ;
    rdfs:comment "deck.gl and its companion packages are declared in package.json but grep across src/**/*.{ts,tsx,js,jsx} for 'deck.gl', 'DeckGL', 'Layer(' and named layer classes (ScatterplotLayer, GeoJsonLayer, HexagonLayer, ArcLayer) found zero matches. No deck.gl import, component, or viewport/view-state code exists in the scanned source tree." .

pack:cmcaMockData a pack:SourceArtifact ;
    rdfs:label "CMCAObject mock data generator" ;
    pack:filePath "src/data.ts" ;
    rdfs:comment "Defines a CMCAObject type with a 3D `position: [number, number, number]` field and a generateMockData() function producing 200 mock records. Shape is consistent with data that could feed a future deck.gl 3D scatter/point visualization, but data.ts itself contains no deck.gl API calls and is not deck.gl usage." .

pack:appScaffold a pack:SourceArtifact ;
    rdfs:label "App.tsx" ;
    pack:filePath "src/App.tsx" ;
    rdfs:comment "Unmodified default Vite+React starter component: a counter button and Vite/React documentation links. Contains no deck.gl or shadcn/ui code." .

pack:shadcnEvidence a pack:AbsentTechnology ;
    rdfs:label "shadcn/ui" ;
    pack:usageStatus "ABSENT" ;
    rdfs:comment "No components.json (shadcn config) exists at the project root. No components/ui directory, no class-variance-authority or radix-ui imports, and no cn() helper were found anywhere in src/. shadcn/ui is not present in this project at all, neither as a dependency nor as source evidence." .
