---
to: "src/{{ row.capitalized }}/GifSection.tsx"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_remotion_y6f9kf_react_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}import { AbsoluteFill, spring, useCurrentFrame, useVideoConfig } from "remotion";
import { staticFile } from "remotion";

const gifs = [
  {
    url: staticFile("gifs/it-crowd-typing.gif"),
    alt: "IT Crowd Typing",
  },
  {
    url: staticFile("gifs/dog-typing.gif"),
    alt: "Dog Typing",
  },
  {
    url: staticFile("gifs/mind-blown.gif"),
    alt: "Mind Blown",
  },
  {
    url: staticFile("gifs/it-crowd-typing.gif"),
    alt: "IT Crowd Typing Again",
  },
  {
    url: staticFile("gifs/dog-typing.gif"),
    alt: "Dog Typing Again",
  },
];

export const GifSection: React.FC<{
  index: number;
}> = ({ index }) => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();

  const scale = spring({
    frame,
    fps,
    config: {
      mass: 0.5,
    },
  });

  const gif = gifs[index % gifs.length];

  return (
    <AbsoluteFill
      style={{
        backgroundColor: "#0f172a",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
      }}
    >
      <img
        src={gif.url}
        alt={gif.alt}
        style={{
          width: "60%",
          height: "auto",
          transform: `scale(${scale})`,
          borderRadius: "12px",
          boxShadow: "0 4px 6px rgba(0, 0, 0, 0.1)",
        }}
      />
    </AbsoluteFill>
  );
};{% endraw %}