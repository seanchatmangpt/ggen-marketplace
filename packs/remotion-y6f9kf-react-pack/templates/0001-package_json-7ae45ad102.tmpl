---
to: "package.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_remotion_y6f9kf_react_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "name": "nitro-tutorials",
  "version": "1.0.0",
  "description": "Advanced Nitro Tutorials",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts Root out/video.mp4",
    "upgrade": "remotion upgrade",
    "test": "eslint src --ext ts,tsx,js,jsx && tsc"
  },
  "dependencies": {
    "@remotion/cli": "4.0.79",
    "@remotion/zod-types": "4.0.79",
    "@types/react": "18.2.38",
    "prism-react-renderer": "^2.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "remotion": "4.0.79",
    "zod": "^3.22.4",
    "@giphy/js-fetch-api": "^5.1.0",
    "@giphy/react-components": "^9.2.3"
  },
  "devDependencies": {
    "@remotion/eslint-config": "4.0.79",
    "@types/web": "^0.0.130",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  }
}{% endraw %}