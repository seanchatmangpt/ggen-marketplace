---
to: "src/NitroTasks/TaskDemo.tsx"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_remotion_y6f9kf_react_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}import { AbsoluteFill, spring, useCurrentFrame, useVideoConfig } from "remotion";

const demos = [
  {
    animation: "task-definition",
    color: "#82AAFF",
  },
  {
    animation: "scheduler",
    color: "#C792EA",
  },
  {
    animation: "api-execution",
    color: "#7FDBCA",
  },
];

export const TaskDemo: React.FC<{
  section: number;
  title: string;
}> = ({ section, title }) => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();

  const progress = spring({
    frame,
    fps,
    config: {
      damping: 200,
    },
  });

  const scale = spring({
    frame,
    fps,
    config: {
      mass: 0.5,
    },
  });

  const renderAnimation = () => {
    const demo = demos[section];
    const center = { x: 960, y: 540 };
    const radius = 100;

    switch (demo.animation) {
      case "task-definition":
        return (
          <>
            <circle
              cx={center.x}
              cy={center.y}
              r={radius}
              fill="none"
              stroke={demo.color}
              strokeWidth={8}
              strokeDasharray={2 * Math.PI * radius}
              strokeDashoffset={2 * Math.PI * radius * (1 - progress)}
            />
            <line
              x1={center.x - 50}
              y1={center.y}
              x2={center.x - 50 + 100 * progress}
              y2={center.y}
              stroke={demo.color}
              strokeWidth={8}
            />
          </>
        );
      case "scheduler":
        return (
          <>
            {[0, 120, 240].map((angle) => {
              const x = center.x + Math.cos((angle * Math.PI) / 180) * radius;
              const y = center.y + Math.sin((angle * Math.PI) / 180) * radius;
              return (
                <circle
                  key={angle}
                  cx={x}
                  cy={y}
                  r={30}
                  fill="none"
                  stroke={demo.color}
                  strokeWidth={8}
                  strokeDasharray={2 * Math.PI * 30}
                  strokeDashoffset={2 * Math.PI * 30 * (1 - progress)}
                />
              );
            })}
          </>
        );
      case "api-execution":
        return (
          <>
            <line
              x1={center.x - 100}
              y1={center.y - 100}
              x2={center.x - 100 + 200 * progress}
              y2={center.y - 100 + 200 * progress}
              stroke={demo.color}
              strokeWidth={8}
            />
            <line
              x1={center.x + 100}
              y1={center.y - 100}
              x2={center.x + 100 - 200 * progress}
              y2={center.y - 100 + 200 * progress}
              stroke={demo.color}
              strokeWidth={8}
            />
          </>
        );
    }
  };

  return (
    <AbsoluteFill
      style={{
        backgroundColor: "#0f172a",
        transform: `scale(${scale})`,
      }}
    >
      <svg width="1920" height="1080" style={{ position: "absolute" }}>
        {renderAnimation()}
      </svg>
    </AbsoluteFill>
  );
};{% endraw %}