---
to: "src/Root.tsx"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_remotion_y6f9kf_react_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}import { Composition } from "remotion";
import { NitroTasks } from "./NitroTasks";
import { NitroJobs } from "./NitroJobs";
import { AgentSwarm } from "./AgentSwarm";
import { {% endraw %}{{ row.capitalized }}{% raw %} } from "./{% endraw %}{{ row.capitalized }}{% raw %}";

export const RemotionRoot: React.FC = () => {
  return (
    <>
      <Composition
        id="NitroTasks"
        component={NitroTasks}
        durationInFrames={900}
        fps={30}
        width={1920}
        height={1080}
      />
      <Composition
        id="NitroJobs"
        component={NitroJobs}
        durationInFrames={900}
        fps={30}
        width={1920}
        height={1080}
      />
      <Composition
        id="AgentSwarm"
        component={AgentSwarm}
        durationInFrames={900}
        fps={30}
        width={1920}
        height={1080}
      />
      <Composition
        id="{% endraw %}{{ row.capitalized }}{% raw %}"
        component={{% endraw %}{{ row.capitalized }}{% raw %}}
        durationInFrames={1080}
        fps={30}
        width={1920}
        height={1080}
      />
    </>
  );
};{% endraw %}