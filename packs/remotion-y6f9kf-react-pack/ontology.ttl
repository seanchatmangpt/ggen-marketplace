@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:Project a pack:AdmittedProject ;
    rdfs:label "nitro-tutorials" ;
    pack:originZip "~/Downloads/project-bolt-bolt-remotion-y6f9kf (2).zip"^^xsd:string ;
    pack:extractedPath "/tmp/dl-extract/remotion-y6f9kf/project"^^xsd:string ;
    pack:framework "Remotion 4.0.79 programmatic-video project (React 18.2.0, TypeScript), exported from bolt.new" ;
    pack:packageName "nitro-tutorials" ;
    rdfs:comment "Project extracted from the named bolt.new export zip and scanned in place under /tmp/dl-extract; package.json name is \"nitro-tutorials\", description \"Advanced Nitro Tutorials\"." .

pack:RemotionUsage a pack:TechnologyFinding ;
    rdfs:label "remotion" ;
    pack:status "real" ;
    pack:remotionVersion "4.0.79" ;
    pack:compositionCount 5 ;
    rdfs:comment "Remotion is genuinely used: package.json depends on remotion, @remotion/cli, and @remotion/zod-types (all 4.0.79); src/Root.tsx registers 5 <Composition> elements (NitroTasks, NitroJobs, AgentSwarm, AgentEcosystem, HelloWorld) each 1920x1080 at 30fps; scripts start/build invoke `remotion studio` and `remotion render`." .

pack:GiphyUsage a pack:TechnologyFinding ;
    rdfs:label "giphy" ;
    pack:status "real" ;
    rdfs:comment "@giphy/js-fetch-api and @giphy/react-components are real dependencies; GifSection.tsx components exist per-composition (AgentEcosystem/GifSection.tsx, AgentSwarm/GifSection.tsx, NitroJobs/GifSection.tsx, NitroTasks/GifSection.tsx, components/GifSection.tsx) and public/gifs/ holds real GIF assets (dog-typing.gif, it-crowd-typing.gif, mind-blown.gif)." .

pack:ShadcnUsage a pack:TechnologyFinding ;
    rdfs:label "shadcn/ui" ;
    pack:status "absent" ;
    rdfs:comment "No shadcn/ui, @radix-ui/*, or class-variance-authority (cva) usage found anywhere in source or package.json; a source-wide grep found zero matches." .

pack:DeckGlUsage a pack:TechnologyFinding ;
    rdfs:label "deck.gl" ;
    pack:status "absent" ;
    rdfs:comment "deck.gl is NOT used and NOT a dependency: no deck.gl/@deck.gl package in package.json, zero source matches for DeckGL/layer classes." .

pack:FileRoot a pack:SourceFile ;
    rdfs:label "src/Root.tsx" ;
    pack:filePath "src/Root.tsx" ;
    rdfs:comment "RemotionRoot: registers all 5 Compositions (NitroTasks, NitroJobs, AgentSwarm, AgentEcosystem, HelloWorld) consumed by `remotion studio`/`remotion render`." .

pack:FileAgentEcosystemIndex a pack:SourceFile ;
    rdfs:label "src/AgentEcosystem/index.tsx" ;
    pack:filePath "src/AgentEcosystem/index.tsx" ;
    rdfs:comment "Largest per-composition entry file (180 lines); composes TitleScreen, Subtitle, CodeSection, GifSection, GitHubLink into the AgentEcosystem video timeline." .

pack:FileAgentEcosystemTitleScreen a pack:SourceFile ;
    rdfs:label "src/AgentEcosystem/TitleScreen.tsx" ;
    pack:filePath "src/AgentEcosystem/TitleScreen.tsx" ;
    rdfs:comment "Title-card sequence component for the AgentEcosystem composition." .

pack:FileAgentSwarmIndex a pack:SourceFile ;
    rdfs:label "src/AgentSwarm/index.tsx" ;
    pack:filePath "src/AgentSwarm/index.tsx" ;
    rdfs:comment "Entry component for the AgentSwarm composition, mirrors AgentEcosystem's sub-component structure (TitleScreen/Subtitle/CodeSection/GifSection/GitHubLink)." .

pack:FileNitroTasksTaskDemo a pack:SourceFile ;
    rdfs:label "src/NitroTasks/TaskDemo.tsx" ;
    pack:filePath "src/NitroTasks/TaskDemo.tsx" ;
    rdfs:comment "NitroTasks-specific demo component not present in the other three compositions (they use CodeSection instead in that slot)." .

pack:FileHelloWorld a pack:SourceFile ;
    rdfs:label "src/HelloWorld.tsx" ;
    pack:filePath "src/HelloWorld.tsx" ;
    rdfs:comment "Stock Remotion starter composition (Logo/Title/Subtitle/Arc/Atom), using spring/interpolate/useCurrentFrame and a zod+zColor schema (myCompSchema); left in place from the Remotion project template." .

pack:FileAppTsx a pack:SourceFile ;
    rdfs:label "src/App.tsx" ;
    pack:filePath "src/App.tsx" ;
    rdfs:comment "Separate non-Remotion demo shell using react-query's QueryClientProvider, rendering MarketplaceUI/SubscriptionUI/ComputeMarketUI/IntegrationsUI components under an \"Agent Ecosystem\" header." .

