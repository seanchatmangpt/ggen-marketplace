# PASS witness for 020_realization_requires_qualification: realization WITH a qualification condition.
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .

pcap:w-real a pcap:CapabilityRealization ;
    pcap:bindingModule "Witness.Binding.*" ;
    pcap:qualificationCondition "qualified when a receipted run observes the bound outcome" .
