# PASS witness for 010_capability_requires_realization: capability WITH a realization.
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcap:w-cap a pcap:Capability ; dcterms:identifier "Process.Witness" ; rdfs:label "Process.Witness" .
pcap:w-real a pcap:CapabilityRealization ; pcap:realizes pcap:w-cap .
