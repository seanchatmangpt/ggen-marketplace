# FIRES gates/010_capability_requires_realization.rq (only).
# Process.Register is a real OTP primitive (register/2) left without any
# realization: the capability is unresolvable and must be refused.
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcap:f-neg-register a pcap:Capability ;
    dcterms:identifier "Process.Register" ;
    rdfs:label "Process.Register" ;
    skos:prefLabel "Register a name for a local process" ;
    pcap:capabilityFamily "process-lifecycle" ;
    pcap:consequence "DO" ;
    pcap:inputContract "name + pid" ;
    pcap:outputContract "name resolves to the pid on the local node" ;
    pcap:precondition "name not already registered; pid alive" ;
    pcap:postcondition "send via the name reaches the pid" ;
    pcap:authorityRequirement "Requires an authority envelope naming the registration scope on the target node." ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject: name-based send observed to reach the pid" ;
    pcap:outcome pcap:f-neg-register-ok .

pcap:f-neg-register-ok a pcap:Outcome ;
    skos:prefLabel "success:registered" ;
    pcap:outcomeKind "success" .
