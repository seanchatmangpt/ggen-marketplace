# FIRES gates/040_consequential_requires_authority.rq (only).
# send/2 is a real, consequential OTP primitive; as a consequence-DO
# capability it carries NO authorityRequirement, which would admit ambient
# execution authority (ProviderAvailable != Authorized).
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcap:f-neg-send a pcap:Capability ;
    dcterms:identifier "Process.Send" ;
    rdfs:label "Process.Send" ;
    skos:prefLabel "Deliver a message to a process (real OTP primitive send/2)" ;
    pcap:capabilityFamily "process-signaling" ;
    pcap:consequence "DO" ;
    pcap:inputContract "destination (pid | registered name | {name, node}) + message term" ;
    pcap:outputContract "message enqueued in the target's mailbox (or delivered per distribution semantics)" ;
    pcap:precondition "destination resolvable for the chosen delivery mode" ;
    pcap:postcondition "message available to the target's receive" ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject: the target observed receiving the message" ;
    pcap:outcome pcap:f-neg-send-ok .
# Deliberately missing: pcap:authorityRequirement.

pcap:f-neg-send-ok a pcap:Outcome ;
    skos:prefLabel "success:delivered-to-mailbox" ;
    pcap:outcomeKind "success" .

pcap:real-otp-stdlib pcap:realizes pcap:f-neg-send .
