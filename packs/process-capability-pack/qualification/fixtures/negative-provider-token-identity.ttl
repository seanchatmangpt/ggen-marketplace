# FIRES gates/050_capability_identity_impl_free.rq (only).
# "Reactor.Spawn" names the implementing package family inside the
# capability identity: CAPABILITY != IMPLEMENTATION violated.
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcap:f-neg-reactor-spawn a pcap:Capability ;
    dcterms:identifier "Reactor.Spawn" ;
    rdfs:label "Reactor.Spawn" ;
    skos:prefLabel "Implementation-named capability (fixture: must be refused)" ;
    pcap:capabilityFamily "process-lifecycle" ;
    pcap:consequence "DO" ;
    pcap:inputContract "fun" ;
    pcap:outputContract "pid" ;
    pcap:precondition "caller alive" ;
    pcap:postcondition "child running" ;
    pcap:authorityRequirement "Requires an authority envelope naming the target node." ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject" ;
    pcap:outcome pcap:f-neg-reactor-spawn-ok .

pcap:f-neg-reactor-spawn-ok a pcap:Outcome ;
    skos:prefLabel "success:pid" ;
    pcap:outcomeKind "success" .

pcap:real-otp-stdlib pcap:realizes pcap:f-neg-reactor-spawn .
