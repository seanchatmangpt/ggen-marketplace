# FIRES gates/030_supervision_semantics_required.rq (only, capability branch).
# supervisor restart_child/2 is a real OTP primitive; as a
# process-supervision capability it MUST declare restart-intensity,
# isolation and link-failure-propagation semantics. It declares none.
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcap:f-neg-restart-child a pcap:Capability ;
    dcterms:identifier "Process.RestartChild" ;
    rdfs:label "Process.RestartChild" ;
    skos:prefLabel "Restart one child of a supervisor (real OTP primitive supervisor:restart_child/2)" ;
    pcap:capabilityFamily "process-supervision" ;
    pcap:consequence "DO" ;
    pcap:inputContract "supervisor pid/name + child id" ;
    pcap:outputContract "child restarted under the supervisor's strategy" ;
    pcap:precondition "supervisor alive; child id present in the spec" ;
    pcap:postcondition "child running again; restart counted against the intensity window" ;
    pcap:authorityRequirement "Requires an authority envelope binding the supervision-tree scope." ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject: the child observed restarted" ;
    pcap:outcome pcap:f-neg-restart-child-ok .
# Deliberately missing: pcap:supervisionSemantics.

pcap:f-neg-restart-child-ok a pcap:Outcome ;
    skos:prefLabel "success:child-restarted" ;
    pcap:outcomeKind "success" .

pcap:real-otp-stdlib pcap:realizes pcap:f-neg-restart-child .
