# MESSAGE: implementation token inside a capability identity — CAPABILITY != IMPLEMENTATION; an identity naming a provider package or ecosystem leaks the realization into the requirement and forecloses interchangeable realizations; rename the capability.
PREFIX pcap: <https://ggen.dev/ontology/process-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?id WHERE {
  ?cap a pcap:Capability ;
       dcterms:identifier ?id .
  FILTER (
    CONTAINS(LCASE(?id), "reactor") ||
    CONTAINS(LCASE(?id), "oban") ||
    CONTAINS(LCASE(?id), "quantum") ||
    CONTAINS(LCASE(?id), "erlang") ||
    CONTAINS(LCASE(?id), "elixir") ||
    CONTAINS(LCASE(?id), "hex.pm")
  )
}
ORDER BY ?id
