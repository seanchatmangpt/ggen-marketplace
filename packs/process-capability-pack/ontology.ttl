# process-capability-pack — qualified capability contracts for the OTP/BEAM
# process family. Lane 3, v26.9.30 capability ecology wave.
#
# Search-ladder record (REUSE -> COMPOSE -> EXTEND -> INVENT):
# - REUSE failed for this family: no admitted pack expresses OTP process
#   capability contracts. Nearest families and their failed edges:
#   beam4pm-process-model-pack = BEAM record-type projection vocabulary
#   (bpm:RecordType/bpm:Field) for process MINING records — no capability,
#   realization, qualification or supervision-semantics machinery;
#   process-intelligence-pack = OCEL-flavored mining chain (pi:Event /
#   pi:ProcessModel / pi:ConformanceCheck / pi:Drift) — models observations
#   of past executions, not executable process capabilities;
#   process-mining-proof-pack = mining proofs, same class. Each failed edge
#   is a topology fact, not a graph failure: this pack is the additive
#   family, none of those packs is rewritten.
# - COMPOSE: qce: (canonical qualified-capability-ecology contract) for the
#   capability-lifecycle base class and admission flag; public prov:, earl:,
#   dcterms:, skos:, xsd:. dcp:'s closed consequence convention ("READ"|"DO")
#   is reused as a convention, not re-invented.
# - INVENT (custom terms, each against a recorded failed edge in README):
#   the provider-metadata and semantic-contract properties below. The public
#   set has no declarative qualification-condition, supervision-semantics or
#   missed-fire slot (earl:Assertion is an evidence INSTANCE, not a
#   condition), and qce: carries provider digests but no provider coordinates.

@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Encoded invariants (lane contract rule 9). Mechanical enforcement
# lives in gates/; these skos anchors name the law each gate guards.
#################################################################

pcap:plan-not-execution a skos:Concept ;
    skos:prefLabel "Plan != Execution" ;
    skos:definition "A capability named in a plan is a requirement, never a running process; ALIVE requires observed execution on the exact admitted subject (gates/060)." .

pcap:policy-not-authority a skos:Concept ;
    skos:prefLabel "Policy != Authority" ;
    skos:definition "A supervision or restart policy in this graph constrains manufacture; it grants no execution authority. Authority exists only as a bound requirement (gates/040)." .

pcap:provider-available-not-authorized a skos:Concept ;
    skos:prefLabel "ProviderAvailable != Authorized" ;
    skos:definition "reactor_process or OTP being installed/available on PATH or in deps confers zero authority to spawn, signal or supervise; realization availability never satisfies the authority requirement (gates/040)." .

pcap:projection-not-source a skos:Concept ;
    skos:prefLabel "Projection != Source" ;
    skos:definition "This ontology is the source; any resolver catalog, index or rendered table derived from it is a projection and is never hand-edited." .

pcap:generated-not-admitted a skos:Concept ;
    skos:prefLabel "Generated != Admitted" ;
    skos:definition "A realization rendered or declared is not qualified; qce:admitted true requires an evidence reference to a replayable assertion (gates/060)." .

#################################################################
# Vocabulary — capability side
#################################################################

pcap:Capability a rdfs:Class, prov:Entity ;
    rdfs:subClassOf qce:CapabilityVersion ;
    rdfs:label "Process capability" ;
    rdfs:comment "A semantic identity in the OTP process family (Family.Name via dcterms:identifier), never an implementation. Typed as a qce:CapabilityVersion subclass so the canonical qualification lifecycle applies unchanged." .

pcap:capabilityFamily a rdf:Property ;
    rdfs:domain pcap:Capability ;
    rdfs:range xsd:string ;
    rdfs:comment "Closed family tag: process-lifecycle | process-supervision | process-signaling | process-linking | process-monitoring. Supervision-family subjects are bound by gates/030." .

pcap:consequence a rdf:Property ;
    rdfs:domain pcap:Capability ;
    rdfs:range xsd:string ;
    rdfs:comment "Closed set READ | DO (convention reused from dcp:). DO capabilities are consequential and MUST carry pcap:authorityRequirement (gates/040)." .

pcap:inputContract a rdf:Property ; rdfs:domain pcap:Capability ; rdfs:range xsd:string .
pcap:outputContract a rdf:Property ; rdfs:domain pcap:Capability ; rdfs:range xsd:string .
pcap:precondition a rdf:Property ; rdfs:domain pcap:Capability ; rdfs:range xsd:string .
pcap:postcondition a rdf:Property ; rdfs:domain pcap:Capability ; rdfs:range xsd:string .

pcap:Outcome a rdfs:Class ;
    rdfs:label "Typed outcome" ;
    rdfs:comment "One outcome of executing the capability: success, a typed failure, or a member of the nondeterministic outcome set." .

pcap:outcome a rdf:Property ; rdfs:domain pcap:Capability ; rdfs:range pcap:Outcome .
pcap:outcomeKind a rdf:Property ;
    rdfs:domain pcap:Outcome ;
    rdfs:range xsd:string ;
    rdfs:comment "Closed set: success | typed_failure | nondeterministic." .

pcap:evidenceRequirement a rdf:Property ;
    rdfs:domain pcap:Capability ;
    rdfs:range xsd:string ;
    rdfs:comment "What evidence a qualifying run must emit (earl:-anchored): observed execution on the exact subject. inspection != execution." .

pcap:authorityRequirement a rdf:Property ;
    rdfs:domain pcap:Capability ;
    rdfs:range xsd:string ;
    rdfs:comment "The authority envelope a DO execution requires. Presence on every consequence-DO capability is enforced by gates/040. A request naming authority is not that authority." .

pcap:executionProperty a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "durability / isolation / concurrency / link-failure-propagation facts. On a Capability: properties the consumer must assume. On a CapabilityRealization: properties the provider provides." .

pcap:supervisionSemantics a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:comment "Restart-intensity, failure-isolation and link-failure-propagation semantics. Required on every process-supervision capability and every realization realizing one (gates/030). Failed edge: no public or qce property expresses supervision semantics." .

#################################################################
# Vocabulary — realization side (provider metadata; cite, never fabricate)
#################################################################

pcap:CapabilityRealization a rdfs:Class, prov:Entity ;
    rdfs:label "Qualified capability realization" ;
    rdfs:comment "A provider binding that realizes one or more capabilities. Carries provider metadata + qualification conditions. CAPABILITY != IMPLEMENTATION: realizations name packages; capabilities never do (gates/050)." .

pcap:realizes a rdf:Property ; rdfs:domain pcap:CapabilityRealization ; rdfs:range pcap:Capability .

pcap:providerRepo a rdf:Property ; rdfs:domain pcap:CapabilityRealization ; rdfs:range xsd:string .
pcap:hexPackage a rdf:Property ; rdfs:domain pcap:CapabilityRealization ; rdfs:range xsd:string ;
    rdfs:comment "Hex coordinate only (e.g. reactor_process). reactor_* packages have NO local checkout in this wave; nothing here claims local inspection of them." .
pcap:hexVersion a rdf:Property ; rdfs:domain pcap:CapabilityRealization ; rdfs:range xsd:string .
pcap:hexUrl a rdf:Property ; rdfs:domain pcap:CapabilityRealization ; rdfs:range xsd:string .
pcap:bindingModule a rdf:Property ; rdfs:domain pcap:CapabilityRealization ; rdfs:range xsd:string ;
    rdfs:comment "The implementing step/module family (e.g. Reactor.Process.*)." .
pcap:versionPinPolicy a rdf:Property ; rdfs:domain pcap:CapabilityRealization ; rdfs:range xsd:string .
pcap:providerMetadataBasis a rdf:Property ; rdfs:domain pcap:CapabilityRealization ; rdfs:range xsd:string ;
    rdfs:comment "Exactly what was observed to ground the provider metadata (hex.pm page citation), so no fact here is fabricated inspection." .

pcap:qualificationCondition a rdf:Property ;
    rdfs:domain pcap:CapabilityRealization ;
    rdfs:range xsd:string ;
    rdfs:comment "Declarative condition under which the realization qualifies. Required on every realization (gates/020). Failed edge: qce: carries qualification receipts/digests but no declarative condition slot; public set has none." .

pcap:evidenceReference a rdf:Property ;
    rdfs:domain pcap:CapabilityRealization ;
    rdfs:range xsd:string ;
    rdfs:comment "Reference to the replayable earl:-anchored assertion that witnessed admission. Required whenever qce:admitted is true (gates/060)." .

#################################################################
# Worked instances — capabilities (pinned IDs + minted siblings)
#################################################################

# --- Process.Spawn (pinned) ---

pcap:cap-spawn a pcap:Capability ;
    dcterms:identifier "Process.Spawn" ;
    rdfs:label "Process.Spawn" ;
    skos:prefLabel "Start a new, heap-isolated BEAM process" ;
    pcap:capabilityFamily "process-lifecycle" ;
    pcap:consequence "DO" ;
    pcap:inputContract "zero-arity fun or {module, function, args} MFA; optional link flag selecting spawn vs spawn_link semantics" ;
    pcap:outputContract "pid of the new process; the child's result is never returned to the spawner" ;
    pcap:precondition "caller process alive on the target node; no ambient authority implied by the call itself" ;
    pcap:postcondition "child running concurrently, heap-isolated from the caller; communication only via explicit messages or an explicit link" ;
    pcap:authorityRequirement "Requires an authority envelope binding the target node and spawn scope. ProviderAvailable != Authorized: reactor_process or OTP presence confers zero authority." ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject: spawned pid liveness observed (process_info non-nil); inspection != execution" ;
    pcap:executionProperty "durability: none — the process dies with its node" ;
    pcap:executionProperty "isolation: heap isolation by default; no shared state" ;
    pcap:executionProperty "concurrency: unsynchronized — spawn returns before the child makes progress" ;
    pcap:outcome pcap:out-spawn-success, pcap:out-spawn-child-exit, pcap:out-spawn-link-exit .

pcap:out-spawn-success a pcap:Outcome ;
    skos:prefLabel "success:pid" ;
    pcap:outcomeKind "success" .

pcap:out-spawn-child-exit a pcap:Outcome ;
    skos:prefLabel "nondeterministic:child-exit:{normal|shutdown|killed|term}" ;
    pcap:outcomeKind "nondeterministic" ;
    rdfs:comment "The child may exit at any time for any reason; the spawner observes it only via link or monitor." .

pcap:out-spawn-link-exit a pcap:Outcome ;
    skos:prefLabel "typed_failure:link-exit-propagation" ;
    pcap:outcomeKind "typed_failure" ;
    rdfs:comment "Under the linked variant, child termination propagates to the spawner as an exit signal with the child's reason." .

# --- Process.Supervise (pinned) ---

pcap:cap-supervise a pcap:Capability ;
    dcterms:identifier "Process.Supervise" ;
    rdfs:label "Process.Supervise" ;
    skos:prefLabel "Supervise child processes under a restart strategy and intensity" ;
    pcap:capabilityFamily "process-supervision" ;
    pcap:consequence "DO" ;
    pcap:inputContract "child specs (start module + args) + restart strategy (one_for_one | one_for_all | rest_for_all) + restart intensity (max_restarts within max_seconds)" ;
    pcap:outputContract "supervisor pid holding the started children under the declared strategy" ;
    pcap:precondition "child start modules resolvable; supervisor flags within OTP-valid ranges" ;
    pcap:postcondition "children running, or the restart loop engaged within the declared intensity; intensity breach escalates to the supervisor's own exit" ;
    pcap:supervisionSemantics "restart intensity: more than max_restarts child restarts within max_seconds escalates to a supervisor exit with reason shutdown; isolation: a child failure is contained to the supervised subtree; link-failure propagation: the supervisor's own exit propagates to its supervisor via links" ;
    pcap:authorityRequirement "Requires an authority envelope binding the supervision-tree scope and node. Policy != Authority: a declared restart policy constrains manufacture but grants no execution authority." ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject: child restart observed AND intensity-breach behavior observed (or the breach path exercised by mutation)" ;
    pcap:executionProperty "durability: supervision state is in-memory; a restarted node starts a fresh tree from the spec" ;
    pcap:executionProperty "isolation: per-subtree" ;
    pcap:executionProperty "concurrency: restarts are asynchronous; order is not guaranteed across siblings" ;
    pcap:outcome pcap:out-sup-success, pcap:out-sup-breach, pcap:out-sup-restart-loop .

pcap:out-sup-success a pcap:Outcome ;
    skos:prefLabel "success:supervisor-up" ;
    pcap:outcomeKind "success" .

pcap:out-sup-breach a pcap:Outcome ;
    skos:prefLabel "typed_failure:shutdown-intensity-breach" ;
    pcap:outcomeKind "typed_failure" .

pcap:out-sup-restart-loop a pcap:Outcome ;
    skos:prefLabel "nondeterministic:restart-loop" ;
    pcap:outcomeKind "nondeterministic" ;
    rdfs:comment "Crash-looping children restart at scheduler-driven times; the count, not the rhythm, is contractual." .

# --- Process.Signal (pinned) ---

pcap:cap-signal a pcap:Capability ;
    dcterms:identifier "Process.Signal" ;
    rdfs:label "Process.Signal" ;
    skos:prefLabel "Deliver an exit signal to a process" ;
    pcap:capabilityFamily "process-signaling" ;
    pcap:consequence "DO" ;
    pcap:inputContract "target pid or registered name + exit reason (normal | shutdown | kill | term)" ;
    pcap:outputContract "signal delivery; no value is returned for delivery to a live pid" ;
    pcap:precondition "target resolvable: pid alive, or registered name present on the local node" ;
    pcap:postcondition "signal delivered to the target, subject to the target's trap-exits handling" ;
    pcap:authorityRequirement "Requires an authority envelope naming the target process scope. Signalling a process this lane does not own is a consequential actuation." ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject: the exit reason observed at the target (or its trap handler)" ;
    pcap:executionProperty "durability: none — signals are in-flight events, not durable records" ;
    pcap:executionProperty "isolation: kill with reason kill is untrappable; other reasons respect trapping" ;
    pcap:outcome pcap:out-sig-delivered, pcap:out-sig-noproc, pcap:out-sig-trap .

pcap:out-sig-delivered a pcap:Outcome ;
    skos:prefLabel "success:delivered" ;
    pcap:outcomeKind "success" .

pcap:out-sig-noproc a pcap:Outcome ;
    skos:prefLabel "typed_failure:noproc" ;
    pcap:outcomeKind "typed_failure" ;
    rdfs:comment "Named local target not registered (or pid dead for a name-based delivery)." .

pcap:out-sig-trap a pcap:Outcome ;
    skos:prefLabel "nondeterministic:trap-absorption" ;
    pcap:outcomeKind "nondeterministic" ;
    rdfs:comment "A trapping target converts the exit into a message; whether it terminates is the target's decision." .

# --- Process.Link (pinned) ---

pcap:cap-link a pcap:Capability ;
    dcterms:identifier "Process.Link" ;
    rdfs:label "Process.Link" ;
    skos:prefLabel "Establish a bidirectional exit-propagation link" ;
    pcap:capabilityFamily "process-linking" ;
    pcap:consequence "DO" ;
    pcap:inputContract "target pid" ;
    pcap:outputContract "bidirectional link between caller and target" ;
    pcap:precondition "both processes alive at link time" ;
    pcap:postcondition "exit of either party propagates to the other as an exit signal (unless the receiver traps)" ;
    pcap:authorityRequirement "Requires an authority envelope naming both link endpoints' scopes; linking into another component's supervision domain couples failure domains." ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject: terminating one end observed at the other end" ;
    pcap:executionProperty "durability: none — links die with their processes" ;
    pcap:executionProperty "isolation: deliberately REDUCED — the link couples failure domains" ;
    pcap:outcome pcap:out-link-linked, pcap:out-link-noproc, pcap:out-link-propagation .

pcap:out-link-linked a pcap:Outcome ;
    skos:prefLabel "success:linked" ;
    pcap:outcomeKind "success" .

pcap:out-link-noproc a pcap:Outcome ;
    skos:prefLabel "typed_failure:noproc" ;
    pcap:outcomeKind "typed_failure" .

pcap:out-link-propagation a pcap:Outcome ;
    skos:prefLabel "nondeterministic:propagation-timing" ;
    pcap:outcomeKind "nondeterministic" ;
    rdfs:comment "Propagation ordering between concurrent exits is not defined." .

# --- Process.Monitor (minted sibling; observation-flavored) ---

pcap:cap-monitor a pcap:Capability ;
    dcterms:identifier "Process.Monitor" ;
    rdfs:label "Process.Monitor" ;
    skos:prefLabel "Observe a process without coupling its failure domain" ;
    pcap:capabilityFamily "process-monitoring" ;
    pcap:consequence "READ" ;
    rdfs:comment "Minted sibling (lane 3), recorded in README. Unlike Link, the target is unaware and its failure domain is not coupled: the monitor receives a DOWN message instead of an exit signal." ;
    pcap:inputContract "target pid, name, or {name, node}" ;
    pcap:outputContract "monitor reference; exactly one DOWN message on target termination or nil on demonitor" ;
    pcap:precondition "monitoring process alive; target resolvable for named monitors" ;
    pcap:postcondition "caller receives :DOWN with the target's exit reason; target behavior unchanged" ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject: a :DOWN message observed with the target's reason" ;
    pcap:executionProperty "isolation: observation-only; no failure coupling" ;
    pcap:outcome pcap:out-mon-down, pcap:out-mon-noproc .

pcap:out-mon-down a pcap:Outcome ;
    skos:prefLabel "success:down-message" ;
    pcap:outcomeKind "success" .

pcap:out-mon-noproc a pcap:Outcome ;
    skos:prefLabel "typed_failure:noproc" ;
    pcap:outcomeKind "typed_failure" ;
    rdfs:comment "Immediate :DOWN when the named target is not alive at monitor time." .

# --- Process.Unlink (minted sibling) ---

pcap:cap-unlink a pcap:Capability ;
    dcterms:identifier "Process.Unlink" ;
    rdfs:label "Process.Unlink" ;
    skos:prefLabel "Remove an existing bidirectional link" ;
    pcap:capabilityFamily "process-linking" ;
    pcap:consequence "DO" ;
    pcap:inputContract "target pid of an existing link" ;
    pcap:outputContract "link removed; future exits no longer propagate between the two" ;
    pcap:precondition "caller alive; unlink is safe regardless of target state" ;
    pcap:postcondition "no further exit propagation in either direction between the pair" ;
    pcap:authorityRequirement "Requires an authority envelope naming the link endpoints' scopes; unlinking changes a failure-domain boundary." ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject: exit of one end observed NOT to terminate the other" ;
    pcap:outcome pcap:out-ulink-removed .

pcap:out-ulink-removed a pcap:Outcome ;
    skos:prefLabel "success:link-removed" ;
    pcap:outcomeKind "success" .

#################################################################
# Worked instances — realizations (provider metadata: cite, never fabricate)
#################################################################

pcap:real-reactor-process a pcap:CapabilityRealization ;
    rdfs:label "Reactor.Process.* via hex reactor_process" ;
    pcap:realizes pcap:cap-spawn, pcap:cap-supervise ;
    pcap:providerRepo "https://github.com/ash-project/reactor_process" ;
    pcap:hexPackage "reactor_process" ;
    pcap:hexVersion "0.5.0" ;
    pcap:hexUrl "https://hex.pm/packages/reactor_process" ;
    pcap:bindingModule "Reactor.Process.* step family (supervisor-oriented steps)" ;
    pcap:versionPinPolicy "~> 0.5 in the consumer's mix.exs; re-run this pack's gates and the consumer qualification on any bump" ;
    pcap:providerMetadataBasis "cited from https://hex.pm/packages/reactor_process (v0.5.0, ash-project): 'A Reactor extension which provides steps for working with supervisors.' No local checkout exists; no local inspection is claimed." ;
    pcap:qualificationCondition "qualified only when the consumer's Reactor composition registers the extension per its documentation AND a receipted run on the exact subject exercises the spawned/supervised path end to end" ;
    pcap:evidenceReference "pending: to be bound to the consumer qualification run's earl: assertion id at admission time (qce:admitted stays false until then)" ;
    pcap:supervisionSemantics "the step family performs supervision WORK via the OTP supervisor underneath; restart intensity and strategy arrive as step arguments — the policy stays in this contract, the execution stays in the step (Plan != Execution)" ;
    pcap:executionProperty "composition: executes inside the consumer's Reactor engine; durability follows the engine, not the step" ;
    qce:admitted false .

pcap:real-otp-stdlib a pcap:CapabilityRealization ;
    rdfs:label "OTP/stdlib process primitives" ;
    pcap:realizes pcap:cap-spawn, pcap:cap-supervise, pcap:cap-signal, pcap:cap-link, pcap:cap-monitor, pcap:cap-unlink ;
    pcap:providerRepo "https://github.com/erlang/otp" ;
    pcap:bindingModule "spawn/1, spawn_link/1, Process.link/1, Process.unlink/1, Process.monitor/1, Process.exit/2, Supervisor (child specs + restart intensity)" ;
    pcap:versionPinPolicy "OTP 26+ per consumer release; Supervisor flag semantics stable across OTP 26-28" ;
    pcap:providerMetadataBasis "public Erlang/OTP stdlib API surface (kernel/stdlib documentation); no local OTP checkout claimed" ;
    pcap:qualificationCondition "qualified when a receipted run on the exact subject observes the primitive's outcome (spawned pid liveness, delivered exit reason, observed link propagation, supervisor restart)" ;
    pcap:evidenceReference "pending: to be bound to the consumer runtime receipt's earl: assertion id at admission time" ;
    pcap:supervisionSemantics "OTP Supervisor: declared strategy with max_restarts/max_seconds intensity; intensity breach exits the supervisor with reason shutdown; failures isolated to the supervised subtree; propagation to the parent via links" ;
    pcap:executionProperty "durability: none (in-memory process space)" ;
    pcap:executionProperty "concurrency: scheduler-preempted, per-process reduction budgets" ;
    qce:admitted false .
