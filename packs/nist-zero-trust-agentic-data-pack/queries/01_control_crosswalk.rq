PREFIX zta: <https://seanchatmangpt.github.io/ggen-marketplace/nist-zero-trust-agentic-data#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?pattern ?sourceKind ?source ?sourceId ?fragment ?reuse WHERE {
  ?pattern a zta:ControlPattern ;
           zta:sourceKind ?sourceKind ;
           prov:wasDerivedFrom ?source ;
           zta:sourceFragment ?fragment .
  OPTIONAL { ?source dct:identifier ?sourceId . }
  OPTIONAL { ?pattern zta:reusesPack ?reuse . }
}
ORDER BY ?sourceKind ?pattern ?source
