@prefix zta: <https://seanchatmangpt.github.io/ggen-marketplace/nist-zero-trust-agentic-data#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Provenance anchors only. This pack does not republish NIST normative text or
# claim that paper-derived extensions are NIST requirements.
zta:Source a rdfs:Class .
zta:NISTSource a rdfs:Class ; rdfs:subClassOf zta:Source .
zta:ResearchSource a rdfs:Class ; rdfs:subClassOf zta:Source .

zta:NIST_SP_800_207 a zta:NISTSource ;
  dct:identifier "NIST SP 800-207" ;
  dct:title "Zero Trust Architecture" ;
  zta:sourceUri "https://doi.org/10.6028/NIST.SP.800-207"^^xsd:anyURI .

zta:NIST_SP_800_207A a zta:NISTSource ;
  dct:identifier "NIST SP 800-207A" ;
  dct:title "A Zero Trust Architecture Model for Access Control in Cloud-Native Applications in Multi-Cloud Environments" ;
  zta:sourceUri "https://doi.org/10.6028/NIST.SP.800-207A"^^xsd:anyURI .

zta:NIST_SP_800_53r5 a zta:NISTSource ;
  dct:identifier "NIST SP 800-53 Rev. 5" ;
  dct:title "Security and Privacy Controls for Information Systems and Organizations" ;
  zta:sourceUri "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI .

zta:NIST_SP_800_218 a zta:NISTSource ;
  dct:identifier "NIST SP 800-218" ;
  dct:title "Secure Software Development Framework (SSDF) Version 1.1" ;
  zta:sourceUri "https://doi.org/10.6028/NIST.SP.800-218"^^xsd:anyURI .

zta:NIST_OSCAL a zta:NISTSource ;
  dct:identifier "NIST OSCAL" ;
  dct:title "Open Security Controls Assessment Language" ;
  zta:sourceUri "https://github.com/usnistgov/OSCAL"^^xsd:anyURI .

zta:ARXIV_2609_29668 a zta:ResearchSource ;
  dct:identifier "arXiv:2609.29668v1" ;
  dct:title "Graph, Loop, and Harness Engineering for Zero-Trust Agentic Data Engineering and Analytical Processing" ;
  zta:sourceUri "https://arxiv.org/abs/2609.29668"^^xsd:anyURI .

zta:ControlPattern a rdfs:Class .
zta:NISTDerivedPattern a rdfs:Class ; rdfs:subClassOf zta:ControlPattern .
zta:PaperExtensionPattern a rdfs:Class ; rdfs:subClassOf zta:ControlPattern .
zta:sourceUri a rdf:Property .
zta:sourceKind a rdf:Property .
zta:sourceFragment a rdf:Property .
zta:mapsToControl a rdf:Property .
zta:reusesPack a rdf:Property .
zta:verificationPredicate a rdf:Property .

zta:NISTDerived a skos:Concept ; skos:prefLabel "NIST-derived" .
zta:PaperExtension a skos:Concept ; skos:prefLabel "paper-derived extension" .

zta:ResourceCentricProtection a zta:NISTDerivedPattern ;
  zta:sourceKind zta:NISTDerived ;
  prov:wasDerivedFrom zta:NIST_SP_800_207 ;
  zta:sourceFragment "resource-centric protection; no implicit trust from network location" .

zta:ExplicitAuthenticationAuthorization a zta:NISTDerivedPattern ;
  zta:sourceKind zta:NISTDerived ;
  prov:wasDerivedFrom zta:NIST_SP_800_207 ;
  zta:sourceFragment "authentication and authorization precede access to enterprise resources" .

zta:PolicyDecisionEnforcement a zta:NISTDerivedPattern ;
  zta:sourceKind zta:NISTDerived ;
  prov:wasDerivedFrom zta:NIST_SP_800_207 ;
  zta:sourceFragment "policy decision and policy enforcement mediate resource access" .

zta:ServiceWorkloadIdentity a zta:NISTDerivedPattern ;
  zta:sourceKind zta:NISTDerived ;
  prov:wasDerivedFrom zta:NIST_SP_800_207A ;
  zta:sourceFragment "application and service identity participates in granular access policy" .

zta:EvidenceGatedProgression a zta:PaperExtensionPattern ;
  zta:sourceKind zta:PaperExtension ;
  prov:wasDerivedFrom zta:ARXIV_2609_29668 ;
  zta:sourceFragment "workflow progression is conditioned on independently established verification evidence" ;
  zta:reusesPack "receipt-provenance-unification-pack" .

zta:BoundedRecovery a zta:PaperExtensionPattern ;
  zta:sourceKind zta:PaperExtension ;
  prov:wasDerivedFrom zta:ARXIV_2609_29668 ;
  zta:sourceFragment "diagnosis, repair, re-planning, retry, and re-verification are explicitly bounded" ;
  zta:reusesPack "governed-runtime-adapter-pack" .

zta:TrustedDeliveryEvidence a zta:PaperExtensionPattern ;
  zta:sourceKind zta:PaperExtension ;
  prov:wasDerivedFrom zta:ARXIV_2609_29668, zta:NIST_SP_800_218 ;
  zta:sourceFragment "immutable source revision, independent rebuild, validation, SBOM, and build provenance precede delivery" ;
  zta:reusesPack "supply-chain-evidence-pack" .

zta:EvidenceGatedProductionPromotion a zta:PaperExtensionPattern ;
  zta:sourceKind zta:PaperExtension ;
  prov:wasDerivedFrom zta:ARXIV_2609_29668 ;
  zta:sourceFragment "promotion binds immutable source, preparation artifacts, executed SQL, sandbox output, validation result, and a least-privilege writer identity" ;
  zta:reusesPack "governed-runtime-adapter-pack" .

zta:SameSnapshotExactEquivalence a zta:PaperExtensionPattern ;
  zta:sourceKind zta:PaperExtension ;
  prov:wasDerivedFrom zta:ARXIV_2609_29668 ;
  zta:sourceFragment "candidate and independently derived canonical queries execute against one fixed snapshot and must produce exactly equivalent results" .

zta:IndependentTerminalVerification a zta:PaperExtensionPattern ;
  zta:sourceKind zta:PaperExtension ;
  prov:wasDerivedFrom zta:ARXIV_2609_29668 ;
  zta:sourceFragment "terminal success is determined by retained independent evidence, not agent-reported success" ;
  zta:reusesPack "receipt-provenance-unification-pack" .

zta:Workflow a rdfs:Class .
zta:TerminalTransition a rdfs:Class .
zta:EvidenceArtifact a rdfs:Class .
zta:RepositoryEvidence a rdfs:Class ; rdfs:subClassOf zta:EvidenceArtifact .
zta:DeploymentEvidence a rdfs:Class ; rdfs:subClassOf zta:EvidenceArtifact .
zta:RuntimeEvidence a rdfs:Class ; rdfs:subClassOf zta:EvidenceArtifact .
zta:PolicyEvidence a rdfs:Class ; rdfs:subClassOf zta:EvidenceArtifact .
zta:ValidationEvidence a rdfs:Class ; rdfs:subClassOf zta:EvidenceArtifact .
zta:AgentAttestation a rdfs:Class ; rdfs:subClassOf zta:EvidenceArtifact .
zta:RecoveryLoop a rdfs:Class .
zta:ConsequentialOperation a rdfs:Class .
zta:PolicyEnforcementPoint a rdfs:Class .
zta:WorkloadIdentity a rdfs:Class .
zta:ProductionPromotion a rdfs:Class .
zta:ApprovalBinding a rdfs:Class .
zta:VerifiedAnswer a rdfs:Class .
zta:TrustedBuild a rdfs:Class .

zta:VerifiedCompletion a skos:Concept ; skos:prefLabel "verified completion" .
zta:Permit a skos:Concept ; skos:prefLabel "permit" .
zta:Deny a skos:Concept ; skos:prefLabel "deny" .

zta:terminalStanding a rdf:Property .
zta:requiresEvidence a rdf:Property .
zta:independentlyVerified a rdf:Property .
zta:evidenceDigest a rdf:Property .
zta:maxAttempts a rdf:Property .
zta:maxWallClockSeconds a rdf:Property .
zta:maxModelTokens a rdf:Property .
zta:maxToolCalls a rdf:Property .
zta:maxCost a rdf:Property .
zta:maxPrivilegeScope a rdf:Property .
zta:maxBlastRadius a rdf:Property .
zta:subjectIdentity a rdf:Property .
zta:targetResource a rdf:Property .
zta:requestedAction a rdf:Property .
zta:executionContextDigest a rdf:Property .
zta:authorizationDecision a rdf:Property .
zta:policyDigest a rdf:Property .
zta:enforcedBy a rdf:Property .
zta:leastPrivilege a rdf:Property .
zta:immutableSourceDigest a rdf:Property .
zta:validationEvidence a rdf:Property .
zta:approvalBinding a rdf:Property .
zta:bindingDigest a rdf:Property .
zta:productionWriter a rdf:Property .
zta:snapshotDigest a rdf:Property .
zta:candidateResultDigest a rdf:Property .
zta:canonicalResultDigest a rdf:Property .
zta:exactResultEquivalent a rdf:Property .
zta:groundingDigest a rdf:Property .
zta:verificationEvidence a rdf:Property .
zta:sourceRevisionDigest a rdf:Property .
zta:independentRebuildDigest a rdf:Property .
zta:sbomDigest a rdf:Property .
zta:buildProvenanceDigest a rdf:Property .
zta:securityValidationDigest a rdf:Property .
zta:iacValidationDigest a rdf:Property .

zta:BenchmarkMetric a rdfs:Class .
zta:VDECR a zta:BenchmarkMetric ; skos:prefLabel "Verified Data-Engineering Completion Rate" .
zta:DERTR a zta:BenchmarkMetric ; skos:prefLabel "Data-Engineering Recovery and Termination Rate" .
zta:DEZTER a zta:BenchmarkMetric ; skos:prefLabel "Data-Engineering Zero-Trust Execution Rate" .
zta:GDPCR a zta:BenchmarkMetric ; skos:prefLabel "Governed Data Product Completion Rate" .
zta:VAR a zta:BenchmarkMetric ; skos:prefLabel "Verified Answer Rate" .
zta:OZTRR a zta:BenchmarkMetric ; skos:prefLabel "OLAP Zero-Trust and Recovery Rate" .
