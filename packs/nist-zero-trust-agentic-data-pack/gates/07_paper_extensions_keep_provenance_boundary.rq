PREFIX zta: <https://seanchatmangpt.github.io/ggen-marketplace/nist-zero-trust-agentic-data#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?pattern ?reason WHERE {
  ?pattern a zta:PaperExtensionPattern .
  FILTER NOT EXISTS {
    ?pattern zta:sourceKind zta:PaperExtension ;
             prov:wasDerivedFrom zta:ARXIV_2609_29668 .
  }
  BIND("paper-derived control pattern is missing explicit paper-extension classification and provenance" AS ?reason)
}
