PREFIX zta: <https://seanchatmangpt.github.io/ggen-marketplace/nist-zero-trust-agentic-data#>
SELECT ?transition ?evidenceType ?reason WHERE {
  ?transition a zta:TerminalTransition ;
              zta:terminalStanding zta:VerifiedCompletion .
  VALUES (?evidenceType ?reason) {
    (zta:RepositoryEvidence "verified completion missing independently verified repository evidence")
    (zta:DeploymentEvidence "verified completion missing independently verified deployment evidence")
    (zta:RuntimeEvidence "verified completion missing independently verified runtime evidence")
    (zta:PolicyEvidence "verified completion missing independently verified policy evidence")
  }
  FILTER NOT EXISTS {
    ?transition zta:requiresEvidence ?evidence .
    ?evidence a ?evidenceType ;
              zta:independentlyVerified true ;
              zta:evidenceDigest ?digest .
  }
}
