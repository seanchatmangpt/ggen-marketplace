PREFIX zta: <https://seanchatmangpt.github.io/ggen-marketplace/nist-zero-trust-agentic-data#>
SELECT ?build ?reason WHERE {
  ?build a zta:TrustedBuild .
  FILTER NOT EXISTS {
    ?build zta:sourceRevisionDigest ?source ;
           zta:independentRebuildDigest ?rebuild ;
           zta:sbomDigest ?sbom ;
           zta:buildProvenanceDigest ?provenance ;
           zta:securityValidationDigest ?security ;
           zta:iacValidationDigest ?iac .
  }
  BIND("trusted build missing immutable source, independent rebuild, SBOM, provenance, security, or IaC validation evidence" AS ?reason)
}
