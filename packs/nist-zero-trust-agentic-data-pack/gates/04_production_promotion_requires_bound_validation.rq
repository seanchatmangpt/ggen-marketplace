PREFIX zta: <https://seanchatmangpt.github.io/ggen-marketplace/nist-zero-trust-agentic-data#>
SELECT ?promotion ?reason WHERE {
  ?promotion a zta:ProductionPromotion .
  FILTER NOT EXISTS {
    ?promotion zta:immutableSourceDigest ?sourceDigest ;
               zta:validationEvidence ?validation ;
               zta:approvalBinding ?binding ;
               zta:productionWriter ?writer .
    ?validation a zta:ValidationEvidence ;
                zta:independentlyVerified true ;
                zta:evidenceDigest ?validationDigest .
    ?binding a zta:ApprovalBinding ;
             zta:bindingDigest ?bindingDigest .
    ?writer a zta:WorkloadIdentity ;
            zta:leastPrivilege true .
  }
  BIND("production promotion lacks immutable-source, independently verified validation, approval binding, or least-privilege writer evidence" AS ?reason)
}
