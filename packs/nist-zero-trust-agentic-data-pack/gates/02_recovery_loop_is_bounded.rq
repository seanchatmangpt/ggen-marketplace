PREFIX zta: <https://seanchatmangpt.github.io/ggen-marketplace/nist-zero-trust-agentic-data#>
SELECT ?loop ?property ?reason WHERE {
  ?loop a zta:RecoveryLoop .
  VALUES (?property ?reason) {
    (zta:maxAttempts "recovery loop missing max attempts")
    (zta:maxWallClockSeconds "recovery loop missing wall-clock bound")
    (zta:maxModelTokens "recovery loop missing model-token bound")
    (zta:maxToolCalls "recovery loop missing tool-call bound")
    (zta:maxCost "recovery loop missing cost bound")
    (zta:maxPrivilegeScope "recovery loop missing privilege bound")
    (zta:maxBlastRadius "recovery loop missing blast-radius bound")
  }
  FILTER NOT EXISTS { ?loop ?property ?value . }
}
