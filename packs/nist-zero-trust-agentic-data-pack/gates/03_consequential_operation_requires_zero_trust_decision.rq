PREFIX zta: <https://seanchatmangpt.github.io/ggen-marketplace/nist-zero-trust-agentic-data#>
SELECT ?operation ?reason WHERE {
  ?operation a zta:ConsequentialOperation .
  FILTER NOT EXISTS {
    ?operation zta:subjectIdentity ?identity ;
               zta:targetResource ?resource ;
               zta:requestedAction ?action ;
               zta:executionContextDigest ?context ;
               zta:authorizationDecision zta:Permit ;
               zta:policyDigest ?policy ;
               zta:enforcedBy ?pep .
    ?identity a zta:WorkloadIdentity .
    ?pep a zta:PolicyEnforcementPoint .
  }
  BIND("consequential operation lacks explicit identity/resource/action/context policy decision enforced by a PEP" AS ?reason)
}
