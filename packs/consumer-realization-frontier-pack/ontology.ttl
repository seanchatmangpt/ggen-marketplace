@prefix crf: <https://ggen.dev/ontology/consumer-realization-frontier#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

crf:DimensionValue a skos:Concept .
crf:RealizationSurface a skos:ConceptScheme .
crf:VerifierStrategy a skos:ConceptScheme .
crf:DependencyRelief a skos:ConceptScheme .
crf:ReceiptStrategy a skos:ConceptScheme .
crf:ResilienceStrategy a skos:ConceptScheme .
crf:AuthorityStrategy a skos:ConceptScheme .
crf:RepositoryTarget a skos:ConceptScheme .
crf:factor a rdf:Property .
crf:reversible a rdf:Property .
crf:requiresAuthority a rdf:Property .
crf:independentConsumer a rdf:Property .
crf:zeroUnreceiptedActuation a rdf:Property .

crf:contract a prov:Entity ;
  skos:prefLabel "Consumer realization frontier contract" ;
  crf:zeroUnreceiptedActuation true .
