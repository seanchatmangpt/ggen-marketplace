PREFIX crf: <https://ggen.dev/ontology/consumer-realization-frontier#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?surface ?verifier ?relief WHERE { ?surface skos:inScheme crf:RealizationSurface ; crf:reversible true . ?verifier skos:inScheme crf:VerifierStrategy ; crf:reversible true . ?relief skos:inScheme crf:DependencyRelief ; crf:reversible true . } ORDER BY ?surface ?verifier ?relief
