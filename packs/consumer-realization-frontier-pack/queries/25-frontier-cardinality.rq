PREFIX crf: <https://ggen.dev/ontology/consumer-realization-frontier#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT (COUNT(*) AS ?candidateCount) WHERE {
  ?surface skos:inScheme crf:RealizationSurface .
  ?verifier skos:inScheme crf:VerifierStrategy .
  ?relief skos:inScheme crf:DependencyRelief .
  ?receipt skos:inScheme crf:ReceiptStrategy .
  ?resilience skos:inScheme crf:ResilienceStrategy .
}
ORDER BY ?candidateCount
