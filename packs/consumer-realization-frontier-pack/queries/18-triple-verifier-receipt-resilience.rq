PREFIX crf: <https://ggen.dev/ontology/consumer-realization-frontier#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?verifier ?receipt ?resilience WHERE { ?verifier skos:inScheme crf:VerifierStrategy . ?receipt skos:inScheme crf:ReceiptStrategy . ?resilience skos:inScheme crf:ResilienceStrategy . } ORDER BY ?verifier ?receipt ?resilience
