PREFIX crf: <https://ggen.dev/ontology/consumer-realization-frontier#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?consumer ?surface ?verifier ?relief WHERE { ?consumer crf:independentConsumer true . ?surface skos:inScheme crf:RealizationSurface . ?verifier skos:inScheme crf:VerifierStrategy . ?relief skos:inScheme crf:DependencyRelief . } ORDER BY ?consumer ?surface ?verifier ?relief
