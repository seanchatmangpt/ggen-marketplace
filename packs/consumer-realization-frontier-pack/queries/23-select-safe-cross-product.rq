PREFIX crf: <https://ggen.dev/ontology/consumer-realization-frontier#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?surface ?verifier WHERE { ?surface skos:inScheme crf:RealizationSurface ; crf:requiresAuthority "SELECT" . ?verifier skos:inScheme crf:VerifierStrategy ; crf:requiresAuthority "SELECT" . } ORDER BY ?surface ?verifier
