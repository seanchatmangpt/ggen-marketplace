# MESSAGE: Cyberpunk TV SHACL minimum-cardinality law failed.
PREFIX tv: <https://ggen.dev/ontology/cyberpunk-tv#>

SELECT ?focus ?predicate ?required (COUNT(DISTINCT ?value) AS ?count) WHERE {
  VALUES (?class ?predicate ?required) {
    (tv:Platform tv:hasMode 6)
    (tv:Platform tv:hasProjection 3)
    (tv:Platform tv:hasRuntimeBody 1)
    (tv:Platform tv:receiptedBy 1)
    (tv:Mode tv:requiresCapability 1)
    (tv:Projection tv:requiresCapability 1)
    (tv:DeviceProfile tv:hasCapability 3)
    (tv:WatchSession tv:hasMediaBinding 1)
    (tv:WatchSession tv:receiptedBy 1)
    (tv:Motion tv:hasProposal 2)
  }
  ?focus a ?class .
  OPTIONAL { ?focus ?predicate ?value . }
}
GROUP BY ?focus ?predicate ?required
HAVING(COUNT(DISTINCT ?value) < ?required)
ORDER BY ?focus ?predicate
