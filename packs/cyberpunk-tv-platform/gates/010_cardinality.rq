# MESSAGE: Cyberpunk TV SHACL cardinality law failed.
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX tv: <https://ggen.dev/ontology/cyberpunk-tv#>

# Exact-one constraints compiled from sh:minCount 1 + sh:maxCount 1.
SELECT ?focus ?predicate (COUNT(?value) AS ?count) WHERE {
  VALUES (?class ?predicate) {
    (tv:Platform tv:title)
    (tv:Platform tv:subtitle)
    (tv:Capability tv:capabilityId)
    (tv:Mode tv:modeId)
    (tv:Mode tv:nextMode)
    (tv:Projection tv:projectionId)
    (tv:Projection tv:projectionKind)
    (tv:DeviceProfile tv:deviceId)
    (tv:DeviceProfile tv:runtimeKind)
    (tv:WorldNode schema:name)
    (tv:WorldNode tv:longitude)
    (tv:WorldNode tv:latitude)
    (tv:WorldNode tv:weight)
    (tv:WorldEdge tv:sourceNode)
    (tv:WorldEdge tv:targetNode)
    (tv:WorldEdge tv:weight)
    (tv:WatchSession tv:sessionId)
    (tv:WatchSession tv:sessionState)
    (tv:WatchSession tv:driftToleranceMillis)
    (tv:Motion dct:title)
    (tv:Motion tv:motionState)
    (tv:Motion tv:quorumRequired)
    (tv:EscrowProposal tv:constructText)
    (tv:EscrowProposal tv:proposalDigest)
    (tv:ReceiptPolicy tv:receiptAlgorithm)
    (tv:ReceiptPolicy tv:standing)
  }
  ?focus a ?class .
  OPTIONAL { ?focus ?predicate ?value . }
}
GROUP BY ?focus ?predicate
HAVING(COUNT(?value) != 1)
ORDER BY ?focus ?predicate
