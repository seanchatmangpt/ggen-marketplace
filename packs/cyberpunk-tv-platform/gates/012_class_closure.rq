# MESSAGE: Cyberpunk TV SHACL class constraint failed.
PREFIX tv: <https://ggen.dev/ontology/cyberpunk-tv#>

SELECT ?focus ?predicate ?value ?expectedClass WHERE {
  VALUES (?class ?predicate ?expectedClass) {
    (tv:Platform tv:hasMode tv:Mode)
    (tv:Platform tv:hasProjection tv:Projection)
    (tv:Platform tv:hasRuntimeBody tv:RuntimeBody)
    (tv:Platform tv:receiptedBy tv:ReceiptPolicy)
    (tv:Mode tv:nextMode tv:Mode)
    (tv:Mode tv:requiresCapability tv:Capability)
    (tv:Projection tv:requiresCapability tv:Capability)
    (tv:DeviceProfile tv:hasCapability tv:Capability)
    (tv:WorldEdge tv:sourceNode tv:WorldNode)
    (tv:WorldEdge tv:targetNode tv:WorldNode)
    (tv:WatchSession tv:hasMediaBinding tv:MediaBinding)
    (tv:WatchSession tv:receiptedBy tv:ReceiptPolicy)
    (tv:Motion tv:hasProposal tv:EscrowProposal)
  }
  ?focus a ?class ; ?predicate ?value .
  FILTER NOT EXISTS { ?value a ?expectedClass }
}
ORDER BY ?focus ?predicate ?value
