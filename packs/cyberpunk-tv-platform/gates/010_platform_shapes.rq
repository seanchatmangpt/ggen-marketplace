# MESSAGE: Cyberpunk TV semantic authority violates ontology/platform-shapes.ttl.
# This gate is a parser-safe SPARQL projection of every SHACL property law.
# It uses only VALUES, ordinary graph patterns, FILTER NOT EXISTS, UNION, and
# scalar FILTER expressions already exercised by ggen v26.8.8 gates.
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX schema: <https://schema.org/>
PREFIX tv: <https://ggen.dev/ontology/cyberpunk-tv#>

SELECT ?focus ?constraint WHERE {
  {
    # Every SHACL property in this shape set has minCount >= 1.
    VALUES (?class ?predicate) {
      (tv:Platform tv:title)
      (tv:Platform tv:subtitle)
      (tv:Platform tv:hasMode)
      (tv:Platform tv:hasProjection)
      (tv:Platform tv:hasRuntimeBody)
      (tv:Platform tv:receiptedBy)
      (tv:Capability tv:capabilityId)
      (tv:Mode tv:modeId)
      (tv:Mode tv:nextMode)
      (tv:Mode tv:requiresCapability)
      (tv:Projection tv:projectionId)
      (tv:Projection tv:projectionKind)
      (tv:Projection tv:requiresCapability)
      (tv:DeviceProfile tv:deviceId)
      (tv:DeviceProfile tv:runtimeKind)
      (tv:DeviceProfile tv:hasCapability)
      (tv:WorldNode schema:name)
      (tv:WorldNode tv:longitude)
      (tv:WorldNode tv:latitude)
      (tv:WorldNode tv:weight)
      (tv:WorldEdge tv:sourceNode)
      (tv:WorldEdge tv:targetNode)
      (tv:WorldEdge tv:weight)
      (tv:WatchSession tv:sessionId)
      (tv:WatchSession tv:sessionState)
      (tv:WatchSession tv:driftToleranceMillis)
      (tv:WatchSession tv:hasMediaBinding)
      (tv:WatchSession tv:receiptedBy)
      (tv:Motion dct:title)
      (tv:Motion tv:motionState)
      (tv:Motion tv:quorumRequired)
      (tv:Motion tv:hasProposal)
      (tv:EscrowProposal tv:constructText)
      (tv:EscrowProposal tv:proposalDigest)
      (tv:ReceiptPolicy tv:receiptAlgorithm)
      (tv:ReceiptPolicy tv:standing)
    }
    ?focus a ?class .
    FILTER NOT EXISTS { ?focus ?predicate ?value . }
    BIND("minCount>=1" AS ?constraint)
  }
  UNION {
    # SHACL maxCount 1 constraints.
    VALUES (?class ?predicate) {
      (tv:Platform tv:title)
      (tv:Platform tv:subtitle)
      (tv:Capability tv:capabilityId)
      (tv:Mode tv:modeId)
      (tv:Mode tv:nextMode)
      (tv:Projection tv:projectionId)
      (tv:Projection tv:projectionKind)
      (tv:DeviceProfile tv:deviceId)
      (tv:DeviceProfile tv:runtimeKind)
      (tv:WorldNode schema:name)
      (tv:WorldNode tv:longitude)
      (tv:WorldNode tv:latitude)
      (tv:WorldNode tv:weight)
      (tv:WorldEdge tv:sourceNode)
      (tv:WorldEdge tv:targetNode)
      (tv:WorldEdge tv:weight)
      (tv:WatchSession tv:sessionId)
      (tv:WatchSession tv:sessionState)
      (tv:WatchSession tv:driftToleranceMillis)
      (tv:Motion dct:title)
      (tv:Motion tv:motionState)
      (tv:Motion tv:quorumRequired)
      (tv:EscrowProposal tv:constructText)
      (tv:EscrowProposal tv:proposalDigest)
      (tv:ReceiptPolicy tv:receiptAlgorithm)
      (tv:ReceiptPolicy tv:standing)
    }
    ?focus a ?class ; ?predicate ?left, ?right .
    FILTER(?left != ?right)
    BIND("maxCount=1" AS ?constraint)
  }
  UNION {
    ?focus a tv:Platform .
    FILTER NOT EXISTS {
      ?focus tv:hasMode ?a, ?b, ?c, ?d, ?e, ?f .
      FILTER(STR(?a) < STR(?b) && STR(?b) < STR(?c) && STR(?c) < STR(?d) && STR(?d) < STR(?e) && STR(?e) < STR(?f))
    }
    BIND("Platform.hasMode minCount=6" AS ?constraint)
  }
  UNION {
    ?focus a tv:Platform .
    FILTER NOT EXISTS {
      ?focus tv:hasProjection ?a, ?b, ?c .
      FILTER(STR(?a) < STR(?b) && STR(?b) < STR(?c))
    }
    BIND("Platform.hasProjection minCount=3" AS ?constraint)
  }
  UNION {
    ?focus a tv:DeviceProfile .
    FILTER NOT EXISTS {
      ?focus tv:hasCapability ?a, ?b, ?c .
      FILTER(STR(?a) < STR(?b) && STR(?b) < STR(?c))
    }
    BIND("DeviceProfile.hasCapability minCount=3" AS ?constraint)
  }
  UNION {
    ?focus a tv:Motion .
    FILTER NOT EXISTS {
      ?focus tv:hasProposal ?a, ?b .
      FILTER(STR(?a) < STR(?b))
    }
    BIND("Motion.hasProposal minCount=2" AS ?constraint)
  }
  UNION {
    VALUES (?class ?predicate ?expectedClass) {
      (tv:Platform tv:hasMode tv:Mode)
      (tv:Platform tv:hasProjection tv:Projection)
      (tv:Platform tv:hasRuntimeBody tv:RuntimeBody)
      (tv:Platform tv:receiptedBy tv:ReceiptPolicy)
      (tv:Mode tv:nextMode tv:Mode)
      (tv:Mode tv:requiresCapability tv:Capability)
      (tv:Projection tv:requiresCapability tv:Capability)
      (tv:DeviceProfile tv:hasCapability tv:Capability)
      (tv:WorldEdge tv:sourceNode tv:WorldNode)
      (tv:WorldEdge tv:targetNode tv:WorldNode)
      (tv:WatchSession tv:hasMediaBinding tv:MediaBinding)
      (tv:WatchSession tv:receiptedBy tv:ReceiptPolicy)
      (tv:Motion tv:hasProposal tv:EscrowProposal)
    }
    ?focus a ?class ; ?predicate ?value .
    FILTER NOT EXISTS { ?value a ?expectedClass . }
    BIND("sh:class" AS ?constraint)
  }
  UNION {
    VALUES (?class ?predicate) {
      (tv:Platform tv:title)
      (tv:Platform tv:subtitle)
      (tv:Capability tv:capabilityId)
      (tv:Mode tv:modeId)
      (tv:Projection tv:projectionId)
      (tv:DeviceProfile tv:deviceId)
      (tv:DeviceProfile tv:runtimeKind)
      (tv:WatchSession tv:sessionId)
      (tv:EscrowProposal tv:constructText)
      (tv:EscrowProposal tv:proposalDigest)
      (tv:ReceiptPolicy tv:standing)
    }
    ?focus a ?class ; ?predicate ?value .
    FILTER(datatype(?value) != xsd:string)
    BIND("datatype=xsd:string" AS ?constraint)
  }
  UNION {
    ?focus a tv:Capability ; tv:capabilityId ?value .
    FILTER(STRLEN(STR(?value)) < 2)
    BIND("Capability.capabilityId minLength=2" AS ?constraint)
  }
  UNION {
    ?focus a tv:Projection ; tv:projectionKind ?value .
    FILTER(STR(?value) != "deck.gl" && STR(?value) != "mermaid" && STR(?value) != "unrdf")
    BIND("Projection.projectionKind sh:in" AS ?constraint)
  }
  UNION {
    ?focus a tv:WorldNode ; tv:longitude ?value .
    FILTER(?value < -180 || ?value > 180)
    BIND("WorldNode.longitude [-180,180]" AS ?constraint)
  }
  UNION {
    ?focus a tv:WorldNode ; tv:latitude ?value .
    FILTER(?value < -90 || ?value > 90)
    BIND("WorldNode.latitude [-90,90]" AS ?constraint)
  }
  UNION {
    VALUES (?class ?predicate) {
      (tv:WorldNode tv:weight)
      (tv:WorldEdge tv:weight)
      (tv:Motion tv:quorumRequired)
    }
    ?focus a ?class ; ?predicate ?value .
    FILTER(?value < 1)
    BIND("minInclusive=1" AS ?constraint)
  }
  UNION {
    ?focus a tv:WatchSession ; tv:sessionState ?value .
    FILTER(STR(?value) != "scheduled" && STR(?value) != "ready" && STR(?value) != "playing" && STR(?value) != "paused" && STR(?value) != "completed" && STR(?value) != "refused")
    BIND("WatchSession.sessionState sh:in" AS ?constraint)
  }
  UNION {
    ?focus a tv:WatchSession ; tv:driftToleranceMillis ?value .
    FILTER(?value < 0 || ?value > 5000)
    BIND("WatchSession.driftToleranceMillis [0,5000]" AS ?constraint)
  }
  UNION {
    ?focus a tv:Motion ; tv:motionState ?value .
    FILTER(STR(?value) != "introduced" && STR(?value) != "seconded" && STR(?value) != "debating" && STR(?value) != "amended" && STR(?value) != "voting" && STR(?value) != "adopted" && STR(?value) != "defeated" && STR(?value) != "adjourned")
    BIND("Motion.motionState sh:in" AS ?constraint)
  }
  UNION {
    ?focus a tv:EscrowProposal ; tv:constructText ?value .
    FILTER(!REGEX(STR(?value), "^CONSTRUCT", "i"))
    BIND("EscrowProposal.constructText pattern=^CONSTRUCT/i" AS ?constraint)
  }
  UNION {
    ?focus a tv:ReceiptPolicy ; tv:receiptAlgorithm ?value .
    FILTER(STR(?value) != "blake3-256")
    BIND("ReceiptPolicy.receiptAlgorithm hasValue=blake3-256" AS ?constraint)
  }
}
ORDER BY ?focus ?constraint
