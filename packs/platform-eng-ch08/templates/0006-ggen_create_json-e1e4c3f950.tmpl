---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch08",
  "files_and_dirs": {
    ".github/actions/container-build/action.yml": true,
    ".github/workflows/backend-pipeline.yml": true,
    ".github/workflows/main.yaml": true,
    "README.md": true,
    "blue-green-deployment.yaml": true,
    "canary-deployment.yaml": true,
    "ggen-create.json": true,
    "load-secrets.sh": true,
    "pipeline-composer.py": true,
    "pipeline-config.yaml": true,
    "reusable-workflows/build-and-test.yaml": true,
    "reusable-workflows/deploy.yaml": true,
    "reusable-workflows/security-scan.yaml": true,
    "rollback-controller.py": true,
    "scripts/analyze_workflows.py": true,
    "scripts/ci_metrics.py": true,
    "test-pipelines.py": true
  },
  "templatize_using_name": "{% endraw %}{{ row.capitalized }}{% raw %}",
  "gen_parent_dir": false
}
{% endraw %}