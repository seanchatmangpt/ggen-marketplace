@prefix tps: <https://ggen.dev/ontology/tps-cell3#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Source ontology for the Cell3 allocation calculus. Queries are executable
# projections over consumer RDF facts; this source owns allocation semantics
# only. Process-mining algorithms remain owned by wasm4pm/wasm4pm-compat.

tps:Cycle a skos:Concept ; skos:prefLabel "TPS production cycle" .
tps:KanbanCard a skos:Concept ; skos:prefLabel "Current-cycle Kanban card" .
tps:AllocationEvent a skos:Concept ; skos:prefLabel "Ready-set allocation event" .
tps:AndonEvent a skos:Concept ; skos:prefLabel "Jidoka Andon event" .
tps:SelectionReceipt a skos:Concept ; skos:prefLabel "Replayable selection receipt" .
tps:ManufacturingEvent a skos:Concept ; skos:prefLabel "Manufacturing evidence event" .
tps:ConsumerFamily a skos:Concept ; skos:prefLabel "Independent consumer family" .
tps:Repository a skos:Concept ; skos:prefLabel "Repository load subject" .

tps:READY_NOW a skos:Concept ; skos:prefLabel "READY_NOW" .
tps:READY_AFTER_BOUNDED_REPAIR a skos:Concept ; skos:prefLabel "READY_AFTER_BOUNDED_REPAIR" .
tps:CLOSE_EARLY a skos:Concept ; skos:prefLabel "CLOSE_EARLY" .
tps:REFUSE_NOW a skos:Concept ; skos:prefLabel "REFUSE_NOW" .

tps:activeCard a prov:Property ; dcterms:description "Card currently consuming a WIP slot." .
tps:base a prov:Property ; dcterms:description "Exact admitted base SHA for a card." .
tps:currentBase a prov:Property ; dcterms:description "Current default-lineage base SHA used for admission." .
tps:head a prov:Property ; dcterms:description "Exact immutable consumer head SHA." .
tps:upstreamPrimitive a prov:Property ; dcterms:description "Exact GGEN primitive used by the workstream." .
tps:authority a prov:Property ; dcterms:description "Explicit bounded authority admitted for the card." .
tps:qualificationCommand a prov:Property ; dcterms:description "Executable qualification command or court." .
tps:integrationCommand a prov:Property ; dcterms:description "Bounded integration command supplied to Cell4." .
tps:ocelEvidenceContract a prov:Property ; dcterms:description "Evidence emission contract; process analysis remains wasm4pm-owned." .
tps:expectedTerminalState a prov:Property ; dcterms:description "Expected same-cycle terminal standing." .
tps:qualificationWitness a prov:Property ; dcterms:description "Observed exact-head qualification witness." .
tps:failureCondition a prov:Property ; dcterms:description "Negative condition that revokes readiness." .
tps:replayReceipt a prov:Property ; dcterms:description "Receipt binding replay identity to an exact card/head." .
tps:wipCount a prov:Property ; dcterms:description "Current active WIP cardinality." .
tps:wipLimit a prov:Property ; dcterms:description "Maximum admitted Cell4/5 closure load." .
tps:spilloverCount a prov:Property ; dcterms:description "Items admitted in-cycle but not terminalized in-cycle." .
tps:admittedCount a prov:Property ; dcterms:description "Cards admitted to the cycle." .
tps:terminalCount a prov:Property ; dcterms:description "Cards terminalized in the cycle." .
tps:remainingTaktMinutes a prov:Property ; dcterms:description "Remaining same-hour closure budget." .
tps:repairBudgetMinutes a prov:Property ; dcterms:description "Explicit bounded repair budget." .
tps:andonCode a prov:Property ; dcterms:description "Typed Jidoka Andon classification." .
tps:replenishmentQueue a prov:Property ; dcterms:description "Ordered lawful READY replenishment inventory." .
tps:searchedCommitEnvelope a prov:Property ; dcterms:description "Explicitly examined semantic manufacturing envelope." .
