@prefix tps: <https://ggen.dev/tps#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Minimal source ontology for the Cell3 allocation calculus. Queries are
# executable projections over consumer RDF facts; this source establishes the
# semantic ownership boundary rather than embedding process-mining algorithms.

tps:Cycle a skos:Concept ; skos:prefLabel "TPS production cycle" .
tps:KanbanCard a skos:Concept ; skos:prefLabel "Current-cycle Kanban card" .
tps:AllocationEvent a skos:Concept ; skos:prefLabel "Ready-set allocation event" .
tps:AndonEvent a skos:Concept ; skos:prefLabel "Jidoka Andon event" .
tps:SelectionReceipt a skos:Concept ; skos:prefLabel "Replayable selection receipt" .

tps:READY_NOW a skos:Concept ; skos:prefLabel "READY_NOW" .
tps:READY_AFTER_BOUNDED_REPAIR a skos:Concept ; skos:prefLabel "READY_AFTER_BOUNDED_REPAIR" .
tps:CLOSE_EARLY a skos:Concept ; skos:prefLabel "CLOSE_EARLY" .
tps:REFUSE_NOW a skos:Concept ; skos:prefLabel "REFUSE_NOW" .

tps:consumerHead a prov:Property ; dcterms:description "Exact consumer subject bound to a card." .
tps:upstreamPrimitive a prov:Property ; dcterms:description "Exact GGEN primitive used by the workstream." .
tps:authority a prov:Property ; dcterms:description "Explicit bounded authority admitted for the card." .
tps:qualificationCommand a prov:Property ; dcterms:description "Executable qualification command or court." .
tps:ocelEvidenceContract a prov:Property ; dcterms:description "Evidence emission contract; process analysis remains owned by wasm4pm/wasm4pm-compat." .
tps:expectedTerminalState a prov:Property ; dcterms:description "Expected same-cycle terminal standing." .
