# Cycle manifest must expose commit count, leveled order, WIP state, readiness, Andons, replacements, and Cell4 load.
ASK WHERE { ?cycle <https://ggen.dev/tps#semanticCommitCount> ?commits ; <https://ggen.dev/tps#leveledOrder> ?order ; <https://ggen.dev/tps#activeWip> ?wip ; <https://ggen.dev/tps#wipLimit> ?limit ; <https://ggen.dev/tps#readinessSummary> ?ready ; <https://ggen.dev/tps#andonSummary> ?andons ; <https://ggen.dev/tps#replacementSummary> ?replacements ; <https://ggen.dev/tps#cell4Load> ?load . }