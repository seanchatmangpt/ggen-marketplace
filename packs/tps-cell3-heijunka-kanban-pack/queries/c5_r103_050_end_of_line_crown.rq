# Cell5 R103: a line crown requires production floor, terminal conservation, zero spillover, and exact receipt identity together.
ASK WHERE {
  ?cycle <https://ggen.dev/tps#cell5SemanticCommits> ?c5 ;
         <https://ggen.dev/tps#admittedCount> ?admitted ;
         <https://ggen.dev/tps#terminalCount> ?terminal ;
         <https://ggen.dev/tps#spilloverCount> 0 ;
         <https://ggen.dev/tps#closureReceipt> ?receipt .
  ?receipt <https://ggen.dev/tps#cycleId> ?cycleId .
  FILTER(?c5 >= 50 && ?terminal = ?admitted && STRLEN(STR(?cycleId)) > 0)
}
