# R102 Cell5 crown: production floor, exact terminal conservation, zero spillover/WIP and receipt completeness must all hold.
ASK WHERE { ?cycle <https://ggen.dev/tps#cycleId> "R102" ; <https://ggen.dev/tps#totalSemanticCommits> ?n ; <https://ggen.dev/tps#admittedCount> ?a ; <https://ggen.dev/tps#terminalCount> ?a ; <https://ggen.dev/tps#spillover> 0 ; <https://ggen.dev/tps#wipEnd> 0 ; <https://ggen.dev/tps#closureReceiptComplete> true . FILTER(?n >= 250) }
