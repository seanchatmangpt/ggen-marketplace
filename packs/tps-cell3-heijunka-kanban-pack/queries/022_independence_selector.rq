# Surface independent candidates whose dependency sets do not intersect active WIP.
SELECT ?card WHERE { ?card <https://ggen.dev/tps#candidate> true . FILTER NOT EXISTS { ?card <https://ggen.dev/tps#dependency> ?d . ?active <https://ggen.dev/tps#active> true ; <https://ggen.dev/tps#dependency> ?d . FILTER(?active != ?card) } }