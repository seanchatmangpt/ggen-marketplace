PREFIX tps: <https://ggen.dev/ontology/tps-cell3#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?cycle WHERE { ?cycle a tps:Cycle ; tps:admittedCount ?a ; tps:terminalCount ?t ; tps:wipCount ?w ; tps:spilloverCount ?s . FILTER(xsd:integer(?t) != xsd:integer(?a) || xsd:integer(?w) != 0 || xsd:integer(?s) != 0) }
