PREFIX tps: <https://ggen.dev/ontology/tps-cell3#>
SELECT ?cycle WHERE {
  ?cycle a tps:Cycle ;
    tps:admittedCount ?admitted ;
    tps:terminalCount ?terminal ;
    tps:spilloverCount ?spillover ;
    tps:wipCount ?wip ;
    tps:wipLimit ?limit .
  FILTER(?terminal != ?admitted || ?spillover != 0 || ?wip != 0 || ?wip > ?limit)
}
