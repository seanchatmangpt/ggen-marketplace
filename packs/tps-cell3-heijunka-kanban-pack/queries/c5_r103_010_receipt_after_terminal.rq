# Cell5 R103: terminal receipt sequence must follow the terminal event sequence.
ASK WHERE {
  ?terminal <https://ggen.dev/tps#sequence> ?terminalSeq ;
            <https://ggen.dev/tps#receipt> ?receipt .
  ?receipt <https://ggen.dev/tps#sequence> ?receiptSeq .
  FILTER(?receiptSeq > ?terminalSeq)
}
