PREFIX tps: <https://ggen.dev/ontology/tps-cell3#>
ASK WHERE { ?cycle a tps:Cycle ; tps:admittedCount ?a ; tps:terminalCount ?t ; tps:spilloverCount 0 ; tps:wipCount 0 ; tps:wipLimit ?limit ; tps:remainingTaktMinutes ?takt ; tps:searchedCommitEnvelope ?envelope . FILTER (?a = ?t && ?limit >= 0 && ?takt >= 0 && ?envelope >= 500) }
