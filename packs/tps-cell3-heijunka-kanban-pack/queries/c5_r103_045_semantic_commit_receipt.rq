# Cell5 R103: Cell5 production must bind the semantic commit range and count.
ASK WHERE {
  ?receipt <https://ggen.dev/tps#semanticBase> ?base ;
           <https://ggen.dev/tps#semanticHead> ?head ;
           <https://ggen.dev/tps#semanticCommitCount> ?count .
  FILTER(?count >= 50 && ?base != ?head)
}
