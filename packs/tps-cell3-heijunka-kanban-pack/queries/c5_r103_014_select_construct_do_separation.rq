# Cell5 R103: the closure card must declare distinct SELECT, CONSTRUCT, and DO authority classes.
ASK WHERE {
  ?card <https://ggen.dev/tps#selectAuthority> ?select ;
        <https://ggen.dev/tps#constructAuthority> ?construct ;
        <https://ggen.dev/tps#doAuthority> ?do .
  FILTER(?select != ?construct && ?construct != ?do && ?select != ?do)
}
