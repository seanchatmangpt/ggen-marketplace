PREFIX tps: <https://ggen.dev/ontology/tps-cell3#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?cycle WHERE { ?cycle a tps:Cycle ; tps:admittedCount ?a ; tps:terminalCount ?t ; tps:wipCount ?w ; tps:spilloverCount ?s ; tps:activeCard ?card . FILTER(xsd:integer(?a)!=xsd:integer(?t) || xsd:integer(?w)!=0 || xsd:integer(?s)!=0) UNION { ?cycle tps:activeCard ?card . FILTER NOT EXISTS { ?card tps:qualificationWitness ?q ; tps:replayReceipt ?r ; tps:authority ?auth ; tps:head ?head ; tps:base ?base } } }
