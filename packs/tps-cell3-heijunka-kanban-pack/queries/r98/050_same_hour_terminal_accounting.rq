PREFIX tps: <https://ggen.dev/ontology/tps-cell3#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK { ?cycle a tps:Cycle ; tps:admittedCount ?a ; tps:terminalCount ?t ; tps:spillover 0 ; tps:deadline ?deadline ; tps:closedAt ?closed . FILTER(xsd:integer(?a) = xsd:integer(?t) && ?closed <= ?deadline) }
