PREFIX tps: <https://ggen.dev/ontology/tps-cell3#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK { ?cycle a tps:Cycle ; tps:healthyCapacity ?capacity ; tps:leveledLoad ?load ; tps:candidateCount ?candidates . FILTER(xsd:integer(?candidates) >= xsd:integer(?capacity) && xsd:integer(?load) >= xsd:integer(?capacity)) }
