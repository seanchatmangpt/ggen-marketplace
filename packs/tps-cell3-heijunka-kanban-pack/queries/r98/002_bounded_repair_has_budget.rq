PREFIX tps: <https://ggen.dev/ontology/tps-cell3#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK { ?card a tps:KanbanCard ; tps:readiness tps:READY_AFTER_BOUNDED_REPAIR ; tps:repairBudget ?budget ; tps:remainingTakt ?takt . FILTER(xsd:decimal(?budget) >= 0 && xsd:decimal(?budget) <= xsd:decimal(?takt)) }
