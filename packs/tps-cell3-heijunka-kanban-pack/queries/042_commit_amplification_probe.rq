# Estimate lawful same-hour semantic-commit amplification from each candidate family.
SELECT ?family (SUM(?expectedSemanticCommits) AS ?amplification) WHERE { ?card <https://ggen.dev/tps#consumerFamily> ?family ; <https://ggen.dev/tps#expectedSemanticCommits> ?expectedSemanticCommits ; <https://ggen.dev/tps#eligible> true . } GROUP BY ?family ORDER BY DESC(?amplification)