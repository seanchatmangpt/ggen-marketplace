PREFIX tps: <https://ggen.dev/ontology/tps-cell3#>
ASK WHERE { FILTER NOT EXISTS { ?card a tps:KanbanCard ; tps:terminal true . FILTER NOT EXISTS { ?card tps:terminalReceipt ?r . ?r tps:subjectHead ?h ; tps:standing ?s ; tps:replayIdentity ?id . FILTER(STRLEN(?h)>0 && STRLEN(?s)>0 && STRLEN(?id)>0) } } }
