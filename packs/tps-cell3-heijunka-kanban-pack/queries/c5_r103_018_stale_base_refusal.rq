# Cell5 R103: a card whose admitted base differs from current base must carry a typed stale-base refusal.
ASK WHERE {
  ?card <https://ggen.dev/tps#base> ?base ;
        <https://ggen.dev/tps#currentBase> ?current ;
        <https://ggen.dev/tps#terminalDisposition> "REFUSED_TYPED[STALE_BASE]" .
  FILTER(?base != ?current)
}
