PREFIX tps: <https://ggen.dev/ontology/tps-cell3#>
ASK WHERE {
  ?cycle a tps:Cycle ; tps:activeCard ?card .
  ?card tps:repository "seanchatmangpt/ggen-marketplace" ;
        tps:head "b46d1abaa0cb1cb1c39653ce2c006215b33f283f" .
  FILTER NOT EXISTS { ?card tps:head ?other . FILTER(?other != "b46d1abaa0cb1cb1c39653ce2c006215b33f283f") }
}
