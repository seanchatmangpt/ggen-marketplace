PREFIX tps: <https://ggen.dev/ontology/tps-cell3#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?cycle WHERE { ?cycle a tps:Cycle ; tps:wipCount ?w ; tps:admittedCount ?a ; tps:terminalCount ?t ; tps:spilloverCount ?s . FILTER(xsd:integer(?w)<0 || xsd:integer(?a)<0 || xsd:integer(?t)<0 || xsd:integer(?s)<0) }
