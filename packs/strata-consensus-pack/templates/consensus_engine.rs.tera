/// Digest width in bytes for every consensus hash (SHA-256).
pub const DIGEST_LEN: usize = 32;

pub type Hash = [u8; DIGEST_LEN];

// ── SHA-256 (FIPS 180-4) — provenance-copied strata-hash-pack pattern ──

const K: [u32; 64] = [
0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

const H0: [u32; 8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

/// SHA-256 of `data`, per FIPS 180-4 §6.2.
pub fn sha256(data: &[u8]) -> Hash {
    let mut h = H0;
    let bit_len = (data.len() as u64).wrapping_mul(8);
    let mut msg = data.to_vec();
    msg.push(0x80);
    while msg.len() % 64 != 56 {
        msg.push(0);
    }
    msg.extend_from_slice(&bit_len.to_be_bytes());

    for block in msg.chunks_exact(64) {
        let mut w = [0u32; 64];
        for (i, word) in block.chunks_exact(4).enumerate() {
            w[i] = u32::from_be_bytes([word[0], word[1], word[2], word[3]]);
        }
        for i in 16..64 {
            let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
            let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16]
                .wrapping_add(s0)
                .wrapping_add(w[i - 7])
                .wrapping_add(s1);
        }
        let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh) =
            (h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);
        for i in 0..64 {
            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            let ch = (e & f) ^ ((!e) & g);
            let t1 = hh
                .wrapping_add(s1)
                .wrapping_add(ch)
                .wrapping_add(K[i])
                .wrapping_add(w[i]);
            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = s0.wrapping_add(maj);
            hh = g;
            g = f;
            f = e;
            e = d.wrapping_add(t1);
            d = c;
            c = b;
            b = a;
            a = t1.wrapping_add(t2);
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        h[5] = h[5].wrapping_add(f);
        h[6] = h[6].wrapping_add(g);
        h[7] = h[7].wrapping_add(hh);
    }
    let mut out = [0u8; DIGEST_LEN];
    for (i, word) in h.iter().enumerate() {
        out[i * 4..i * 4 + 4].copy_from_slice(&word.to_be_bytes());
    }
    out
}

// ── Block model — provenance-copied strata-chain-pack (S5) shape ──────

/// One consensus-relevant block (the chain-pack header subset the
/// selection law reads: no tx set — the Merkle commitment is validated by
/// the chain layer before consensus ever sees the block).
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Block {
    /// Height: exactly parent.height + 1 for a valid child.
    pub height: u64,
    /// SHA-256 of the parent's header encoding; genesis carries all zeros.
    pub parent_hash: Hash,
    /// Required leading zero bits in the PoW digest.
    pub difficulty_target: u32,
    /// PoW nonce; also the fork-choice tiebreaker (lower wins).
    pub nonce: u64,
    /// Monotonic logical slot — never wall-clock (determinism law).
    pub timestamp_slot: u64,
}

impl Block {
    /// Canonical header encoding: height(u64 BE) || parentHash ||
    /// difficulty(u32 BE) || slot(u64 BE).
    pub fn header_bytes(&self) -> Vec<u8> {
        let mut b = Vec::with_capacity(8 + DIGEST_LEN + 4 + 8);
        b.extend_from_slice(&self.height.to_be_bytes());
        b.extend_from_slice(&self.parent_hash);
        b.extend_from_slice(&self.difficulty_target.to_be_bytes());
        b.extend_from_slice(&self.timestamp_slot.to_be_bytes());
        b
    }

    /// PoW digest: SHA-256(header encoding || nonce u64 BE) — the
    /// chain-pack digest law, self-contained here.
    pub fn pow_hash(&self) -> Hash {
        let mut buf = self.header_bytes();
        buf.extend_from_slice(&self.nonce.to_be_bytes());
        sha256(&buf)
    }
}

/// Leading zero bit count of a digest (the deterministic PoW metric).
pub fn leading_zero_bits(h: &Hash) -> u32 {
    let mut n = 0u32;
    for byte in h {
        if *byte == 0 {
            n += 8;
        } else {
            n += byte.leading_zeros();
            break;
        }
    }
    n
}

// ── Work accounting (st:chainWork law) ────────────────────────────────

/// Work of one block under WORK_UNIT = "sha256-double-tick":
/// 2^(difficulty leading zeros) — the expected number of hash ticks to
/// find a block whose PoW digest carries `difficulty_target` leading zero
/// bits. Computed from the TARGET (not the found digest's actual zero
/// count) so work is a function of the block's declared difficulty alone:
/// equal-difficulty chains are exactly tied and the tie-break law is
/// reachable. Saturating at 2^63 so absurd targets cannot overflow.
pub fn block_work(b: &Block) -> u64 {
    let exp = b.difficulty_target.min(63);
    1u64 << exp
}

/// Total accumulated chain work: the sum of per-block work over the whole
/// chain (the PN64-style transition lattice's accumulated weight).
pub fn chain_work(chain: &[Block]) -> u64 {
    chain.iter().map(block_work).fold(0u64, u64::saturating_add)
}

// ── Valid-extension law (chain-pack validate shape, 3 arms) ──────────

/// Typed consensus refusal — every rejection is a named variant, never a bool.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ConsensusRefusal {
    /// Child height is not exactly parent.height + 1.
    HeightContinuity { expected: u64, got: u64 },
    /// parent_hash does not equal SHA-256 of the parent header encoding.
    ParentHashMismatch,
    /// The candidate's PoW digest does not meet its difficulty target.
    PoWTargetNotMet { required_bits: u32, got_bits: u32 },
}

/// Validate `candidate` as a direct child of `parent` — the
/// InvalidBlockGossip refusal path (gate-020 corpus): re-check height
/// continuity, parent-hash binding, and the PoW target before any
/// gossiped block is ever considered by fork choice.
pub fn is_valid_extension(parent: &Block, candidate: &Block) -> Result<(), ConsensusRefusal> {
    if candidate.height != parent.height + 1 {
        return Err(ConsensusRefusal::HeightContinuity {
            expected: parent.height + 1,
            got: candidate.height,
        });
    }
    if candidate.parent_hash != sha256(&parent.header_bytes()) {
        return Err(ConsensusRefusal::ParentHashMismatch);
    }
    let bits = leading_zero_bits(&candidate.pow_hash());
    if bits < candidate.difficulty_target {
        return Err(ConsensusRefusal::PoWTargetNotMet {
            required_bits: candidate.difficulty_target,
            got_bits: bits,
        });
    }
    Ok(())
}

// ── Tip selection (st:ForkChoice law) ─────────────────────────────────

/// Deterministic tip selection over competing candidate chains: the
/// HEAVIEST total chain work wins; an exact equal-work tie resolves to the
/// chain whose TIP has the LOWER nonce (TIE_BREAK = "lower-nonce"). Returns
/// the index of the winner; `None` only for an empty candidate set.
pub fn select_tip(candidates: &[Vec<Block>]) -> Option<usize> {
    if candidates.is_empty() {
        return None;
    }
    let work: Vec<u64> = candidates.iter().map(|c| chain_work(c)).collect();
    let mut best = 0usize;
    for i in 1..candidates.len() {
        let a = work[i];
        let b = work[best];
        let wins = a > b
            || (a == b
                && match (candidates[i].last(), candidates[best].last()) {
                    (Some(x), Some(y)) => x.nonce < y.nonce,
                    (Some(_), None) => true,
                    _ => false,
                });
        if wins {
            best = i;
        }
    }
    Some(best)
}

// ── Adversarial module (st:AdversarialCase corpus, gate 020) ─────────

/// Gossip observation fed to selfish-mining detection.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum GossipEvent {
    /// A block was mined but not announced (withheld from the public tip).
    Withheld,
    /// A previously withheld suffix was released to the network.
    Released,
}

/// SelfishMining refusal path (gate-020 corpus): a `Released` event
/// preceded by a run of >= SELFISH_WITHHOLD_THRESHOLD consecutive
/// `Withheld` events is the withhold-then-release report pattern.
/// Detection is advisory evidence for peer scoring; the tip law itself
/// stays deterministic.
pub const SELFISH_WITHHOLD_THRESHOLD: usize = 2;

pub fn selfish_mining_detected(pattern: &[GossipEvent]) -> bool {
    let mut run = 0usize;
    for ev in pattern {
        match ev {
            GossipEvent::Withheld => run += 1,
            GossipEvent::Released => {
                if run >= SELFISH_WITHHOLD_THRESHOLD {
                    return true;
                }
                run = 0;
            }
        }
    }
    false
}

/// Eclipse refusal path (gate-020 corpus): `peer_table` is the set of
/// (subnet_id, peer_id) currently admitted; any peer beyond the
/// ECLIPSE_MAX_PEERS_PER_SUBNET cap for its subnet is refused. Returns
/// the refused peer ids in table order (deterministic).
pub fn eclipse_guard(peer_table: &[(u32, u64)]) -> Vec<u64> {
    let mut seen: Vec<u32> = Vec::new();
    let mut counts: Vec<u64> = Vec::new();
    let mut refused = Vec::new();
    for &(subnet, peer) in peer_table {
        match seen.iter().position(|&s| s == subnet) {
            Some(idx) => {
                counts[idx] += 1;
                if counts[idx] > ECLIPSE_MAX_PEERS_PER_SUBNET {
                    refused.push(peer);
                }
            }
            None => {
                seen.push(subnet);
                counts.push(1);
            }
        }
    }
    refused
}

/// SpamFlood refusal path (gate-020 corpus): fires (`true`) the moment a
/// slot's gossip message count exceeds SPAM_LIMIT; the admission valve
/// must refuse all further messages in that slot.
pub fn spam_limit(slot_count: u64) -> bool {
    slot_count > SPAM_LIMIT
}

// ── Tests ─────────────────────────────────────────────────────────────

#[cfg(test)]
mod tests {
    use super::*;

    /// FIPS 180-4 published vectors — pins the zero-crate SHA-256.
    #[test]
    fn sha256_fips_vectors() {
        assert_eq!(
            sha256(b"abc"),
            [
                0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea, 0x41, 0x41, 0x40, 0xde, 0x5d,
                0xae, 0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10,
                0xff, 0x61, 0xf2, 0x00, 0x15, 0xad
            ]
        );
        assert_eq!(
            sha256(b""),
            [
                0xe3, 0xb0, 0xc4, 0x42, 0x98, 0xfc, 0x1c, 0x14, 0x9a, 0xfb, 0xf4, 0xc8, 0x99,
                0x6f, 0xb9, 0x24, 0x27, 0xae, 0x41, 0xe4, 0x64, 0x9b, 0x93, 0x4c, 0xa4, 0x95,
                0x99, 0x1b, 0x78, 0x52, 0xb8, 0x55
            ]
        );
    }

    const TEST_DIFFICULTY: u32 = 8; // ~256 expected ticks — fast, deterministic

    fn mine(mut b: Block) -> Block {
        let mut nonce: u64 = 0;
        loop {
            b.nonce = nonce;
            if leading_zero_bits(&b.pow_hash()) >= b.difficulty_target {
                return b;
            }
            nonce = nonce.wrapping_add(1);
        }
    }

    fn genesis() -> Block {
        mine(Block {
            height: 0,
            parent_hash: [0u8; DIGEST_LEN],
            difficulty_target: TEST_DIFFICULTY,
            nonce: 0,
            timestamp_slot: 0,
        })
    }

    fn child(parent: &Block, slot: u64, salt: u8) -> Block {
        let mut b = Block {
            height: parent.height + 1,
            parent_hash: sha256(&parent.header_bytes()),
            difficulty_target: TEST_DIFFICULTY,
            nonce: 0,
            timestamp_slot: slot,
        };
        // Distinct blocks: fold the salt into the slot bytes of the header
        // via a distinct timestamp slot bump (monotonic slot law holds).
        b.timestamp_slot = slot + salt as u64;
        mine(b)
    }

    fn chain_of(n: usize) -> Vec<Block> {
        let mut chain = vec![genesis()];
        for i in 0..n {
            let parent = chain.last().unwrap().clone();
            chain.push(child(&parent, i as u64, 0));
        }
        chain
    }

    #[test]
    fn work_sums_over_five_chain() {
        let chain = chain_of(5);
        assert_eq!(chain.len(), 6); // genesis + 5
        // Every block meets difficulty 8, so every block contributes 2^8.
        assert_eq!(chain_work(&chain), 6 * (1u64 << TEST_DIFFICULTY));
        // Work is strictly monotone under extension.
        assert!(chain_work(&chain) > chain_work(&chain[..5]));
    }

    #[test]
    fn heaviest_tip_among_three_competing_chains() {
        let g = genesis();
        let b1 = child(&g, 1, 0);
        let short = vec![g.clone(), b1.clone()];
        let mid = vec![g.clone(), b1.clone(), child(&b1, 2, 0)];
        let b1x = child(&g, 1, 1);
        let b2x = child(&b1x, 2, 1);
        let b3x = child(&b2x, 3, 1);
        let three = vec![g.clone(), b1x, b2x, b3x];
        let cands = [short, mid.clone(), three.clone()];
        assert_eq!(select_tip(&cands), Some(2)); // heaviest work wins
        // A strict prefix has strictly less work than its extension.
        assert!(chain_work(&three) > chain_work(&mid));
        assert_eq!(select_tip(&[]), None);
    }

    #[test]
    fn equal_work_tie_resolves_to_lower_nonce() {
        let g = genesis();
        // Two equal-length children of the same genesis: identical work.
        let a = child(&g, 1, 0);
        let b = child(&g, 1, 1);
        assert_ne!(a.nonce, b.nonce); // deterministic mining keeps them distinct
        let expected = if a.nonce < b.nonce { 0usize } else { 1usize };
        let cands = [vec![g.clone(), a.clone()], vec![g.clone(), b.clone()]];
        assert_eq!(select_tip(&cands), Some(expected));
        // The winner's tip nonce is exactly the lower one.
        let winner = cands[expected].last().unwrap().clone();
        assert_eq!(winner.nonce, a.nonce.min(b.nonce));
    }

    #[test]
    fn invalid_extension_wrong_height_refused() {
        let g = genesis();
        let mut bad = child(&g, 1, 0);
        bad.height = g.height + 2; // skip a block
        assert_eq!(
            is_valid_extension(&g, &bad),
            Err(ConsensusRefusal::HeightContinuity {
                expected: g.height + 1,
                got: g.height + 2,
            })
        );
    }

    #[test]
    fn invalid_extension_parent_hash_refused() {
        let g = genesis();
        let mut bad = child(&g, 1, 0);
        bad.parent_hash = [0xAA; DIGEST_LEN]; // unbound parent claim
        assert_eq!(
            is_valid_extension(&g, &bad),
            Err(ConsensusRefusal::ParentHashMismatch)
        );
    }

    #[test]
    fn invalid_extension_pow_refused() {
        let g = genesis();
        let bad = Block {
            height: g.height + 1,
            parent_hash: sha256(&g.header_bytes()),
            difficulty_target: 40, // unreachable within the test budget
            nonce: 0,
            timestamp_slot: 1,
        };
        assert!(matches!(
            is_valid_extension(&g, &bad),
            Err(ConsensusRefusal::PoWTargetNotMet { .. })
        ));
    }

    #[test]
    fn eclipse_cap_fires() {
        let mut table = Vec::new();
        for peer in 0..10u64 {
            table.push((7u32, 100u64 + peer)); // 10 peers, one subnet
        }
        let refused = eclipse_guard(&table);
        assert_eq!(refused, vec![108u64, 109]); // exactly the 2 beyond the cap of 8
        // A second subnet under the cap loses nothing.
        table.push((9u32, 200));
        table.push((9u32, 201));
        let refused = eclipse_guard(&table);
        assert_eq!(refused, vec![108u64, 109]);
    }

    #[test]
    fn spam_limit_fires() {
        assert_eq!(SPAM_LIMIT, 32);
        assert!(!spam_limit(SPAM_LIMIT)); // 32 msgs — admitted
        assert!(spam_limit(SPAM_LIMIT + 1)); // 33 msgs — refused
    }

    #[test]
    fn selfish_mining_pattern_detected() {
        // Withhold-then-release with a run of 2: detected.
        let attack = vec![
            GossipEvent::Withheld,
            GossipEvent::Withheld,
            GossipEvent::Released,
        ];
        assert!(selfish_mining_detected(&attack));
        // Extended withhold runs are also detected.
        let long = vec![GossipEvent::Withheld; 5]
            .into_iter()
            .chain(std::iter::once(GossipEvent::Released))
            .collect::<Vec<_>>();
        assert!(selfish_mining_detected(&long));
        // A single withhold before release is below threshold: not flagged.
        let benign = vec![GossipEvent::Withheld, GossipEvent::Released];
        assert!(!selfish_mining_detected(&benign));
        // Pure withholding with no release is not a report pattern.
        assert!(!selfish_mining_detected(&[GossipEvent::Withheld; 3]));
        // Empty observation: nothing detected.
        assert!(!selfish_mining_detected(&[]));
    }

    // ── S8/X18 hardening: adversarial fork-choice simulation courts ─────
    //
    // Deterministic simulations over seeded xorshift randomness — no
    // wall-clock, no OS entropy, no flaky loops. Hashtate is modeled as a
    // deterministic per-round block quota (a 1.3x hashrate adversary wins
    // exactly 13 of every 10 mining rounds), so every court is a pure
    // function of the seed.

    /// xorshift64star — deterministic seeded PRNG for the simulations.
    struct Xorshift(u64);

    impl Xorshift {
        fn new(seed: u64) -> Self {
            Xorshift(seed.max(1))
        }
        fn next(&mut self) -> u64 {
            let mut x = self.0;
            x ^= x << 13;
            x ^= x >> 7;
            x ^= x << 17;
            self.0 = x;
            x
        }
    }

    /// Mine an n-block chain whose blocks are salted by `salt`, with
    /// per-block nonce-search start points drawn from the seeded PRNG —
    /// deterministic for a fixed seed, distinct across chains.
    fn chain_of_seeded(n: usize, salt: u8, seed: u64) -> Vec<Block> {
        let mut rng = Xorshift::new(seed);
        let mut chain = vec![genesis()];
        for i in 0..n {
            let parent = chain.last().unwrap().clone();
            let mut b = Block {
                height: parent.height + 1,
                parent_hash: sha256(&parent.header_bytes()),
                difficulty_target: TEST_DIFFICULTY,
                nonce: rng.next(),
                timestamp_slot: (i as u64) + salt as u64,
            };
            // Distinct chains get distinct header bytes via the slot salt.
            b.timestamp_slot += rng.next() % 2;
            chain.push(mine(b));
        }
        chain
    }

    /// Simulate a withheld selfish-mining fork over `rounds` mining rounds.
    ///
    /// Hashrate is a deterministic quota: the honest miner wins exactly
    /// `h_per_period` of every `period` rounds, the adversary the rest.
    /// The fork starts 3 blocks BACK: the adversary skips its first 3
    /// mining rounds (it began 3 blocks behind the public tip), then mines
    /// privately on its own chain (independent salted slots off the same
    /// genesis). The seeded PRNG drives nonce-search start points only —
    /// the whole simulation is a pure function of `seed`.
    fn withheld_fork_sim(rounds: u64, period: u64, h_per_period: u64, seed: u64) -> (Vec<Block>, Vec<Block>) {
        assert!(h_per_period < period);
        let mut rng = Xorshift::new(seed);
        let mut mine_on = |chain: &mut Vec<Block>, round: u64, slot_salt: u64| {
            let parent = chain.last().unwrap().clone();
            let mut b = Block {
                height: parent.height + 1,
                parent_hash: sha256(&parent.header_bytes()),
                difficulty_target: TEST_DIFFICULTY,
                nonce: rng.next(),
                timestamp_slot: round + slot_salt,
            };
            b.timestamp_slot += rng.next() % 2;
            chain.push(mine(b));
        };
        let mut honest = vec![genesis()];
        let mut fork = vec![genesis()];
        let mut adv_rounds = 0u64;
        for round in 0..rounds {
            if round % period < h_per_period {
                mine_on(&mut honest, round, 0);
            } else {
                adv_rounds += 1;
                if adv_rounds > 3 {
                    // Withheld start: the first 3 adversarial rounds are
                    // the 3-block deficit; mining begins after them.
                    mine_on(&mut fork, round, 100);
                }
            }
        }
        (honest, fork)
    }


    #[test]
    fn fork_choice_honest_chain_beats_equal_hashrate_withheld_fork() {
        // 40 rounds, honest quota 10/20 (half the rounds), equal hashrate,
        // adversary withheld for its first 3 rounds (fork starts 3 blocks
        // back): honest mines 20 blocks, the fork only 17 — heaviest-chain
        // MUST select the honest chain.
        let (honest, fork) = withheld_fork_sim(40, 20, 10, 0xDEAD_BEEF);
        assert_eq!(honest.len(), 21); // genesis + 20
        assert_eq!(fork.len(), 18); // genesis + 17 (3 withheld)
        assert!(chain_work(&honest) > chain_work(&fork));
        let cands = [honest.clone(), fork.clone()];
        assert_eq!(
            select_tip(&cands),
            Some(0),
            "honest chain must win at equal hashrate"
        );
        // The other direction of the same court: order-independent choice.
        let flipped = [fork, honest.clone()];
        assert_eq!(select_tip(&flipped), Some(1));
    }

    #[test]
    fn fork_choice_adversarial_1_3x_hashrate_overtakes_honest() {
        // Exact integer 1.3x schedule: honest wins 10 of every 23 rounds,
        // the adversary the other 13. After 90 rounds (minus the 3-round
        // withheld start) the private fork outweighs the honest chain and
        // heaviest-chain MUST flip to the adversarial fork.
        let (honest, fork) = withheld_fork_sim(90, 23, 10, 0xC0F_FEE);
        let h_blocks = honest.len() as u64 - 1;
        let a_blocks = fork.len() as u64 - 1;
        // Deterministic quotas over 90 rounds: 40 honest-quota rounds and
        // 50 adversarial rounds, 3 of them withheld → 47 fork blocks.
        assert_eq!(h_blocks, 40);
        assert_eq!(a_blocks, 47);
        // Nominal schedule rate is exactly 13/10 = 1.3x; the realized
        // advantage is 1.3x minus the 3-block withheld head start
        // (47/40 = 1.175x) — still enough to overtake, which is the
        // security-relevant fact the court pins.
        assert!(chain_work(&fork) > chain_work(&honest));
        let cands = [honest, fork];
        assert_eq!(
            select_tip(&cands),
            Some(1),
            "a 1.3x adversarial fork that overtakes MUST be selected"
        );
    }

    #[test]
    fn tie_break_equal_work_is_a_pure_function_of_lower_nonce() {
        // Ontology law check: st:tipTieBreak / st:tieBreak declare
        // "lower-nonce" (TIE_BREAK constant). The court pins that exact
        // rule: equal total work ⇒ winner is a pure function of the tip
        // nonces, independent of candidate order or repetition.
        assert_eq!(TIE_BREAK, "lower-nonce");
        let g = genesis();
        let f1 = child(&g, 1, 1);
        let f2 = child(&g, 1, 7);
        let f3 = child(&g, 1, 42);
        assert_eq!(
            chain_work(&[g.clone(), f1.clone()]),
            chain_work(&[g.clone(), f2.clone()])
        );
        // All orderings of the three equal-work forks resolve to the same
        // winning tip nonce: the lowest one.
        let chains: Vec<Vec<Block>> = vec![
            vec![g.clone(), f1.clone()],
            vec![g.clone(), f2.clone()],
            vec![g.clone(), f3.clone()],
        ];
        let min_nonce = f1.nonce.min(f2.nonce).min(f3.nonce);
        let mut order = vec![0usize, 1, 2];
        // Deterministic permutations (xorshift-driven rotations, all 6).
        let mut rng = Xorshift::new(7);
        for _ in 0..6 {
            let picked: Vec<Vec<Block>> = order.iter().map(|&i| chains[i].clone()).collect();
            let winner = select_tip(&picked).unwrap();
            assert_eq!(picked[winner].last().unwrap().nonce, min_nonce);
            // Rotate deterministically.
            let k = (rng.next() % 3) as usize;
            order.rotate_left(k.max(1));
        }
    }

    #[test]
    fn sabotage_block_count_fork_choice_is_caught() {
        // Sabotage twin (X18 discrimination court, strata-net corpus
        // pattern): a weakened fork-choice that selects on total block
        // COUNT instead of total chain WORK. The courts must distinguish
        // it — there exist candidate sets where the two laws disagree, and
        // on every such set the work law's answer is the admitted one.
        fn select_tip_sabotaged(candidates: &[Vec<Block>]) -> Option<usize> {
            if candidates.is_empty() {
                return None;
            }
            let mut best = 0usize;
            for i in 1..candidates.len() {
                let a = candidates[i].len();
                let b = candidates[best].len();
                let wins = a > b
                    || (a == b
                        && match (candidates[i].last(), candidates[best].last()) {
                            (Some(x), Some(y)) => x.nonce < y.nonce,
                            _ => false,
                        });
                if wins {
                    best = i;
                }
            }
            Some(best)
        }

        // Discriminating corpus case 1: MORE blocks, far LESS work.
        // chain_heavy: 3 blocks (genesis + 2 at difficulty 20 → work
        // 2^8 + 2*2^20). chain_long: 6 blocks at difficulty 8 (work
        // 6 * 2^8). Work law → chain_heavy; count law → chain_long.
        let g = genesis();
        let heavy_mid = Block {
            height: g.height + 1,
            parent_hash: sha256(&g.header_bytes()),
            difficulty_target: 20,
            nonce: 11,
            timestamp_slot: 1,
        };
        let heavy_tip = Block {
            height: heavy_mid.height + 1,
            parent_hash: sha256(&heavy_mid.header_bytes()),
            difficulty_target: 20,
            nonce: 22,
            timestamp_slot: 2,
        };
        let chain_heavy = vec![g.clone(), heavy_mid, heavy_tip];
        let chain_long = chain_of_seeded(5, 9, 99);
        assert_eq!(chain_heavy.len(), 3);
        assert_eq!(chain_long.len(), 6); // the count twin's favorite
        assert!(chain_work(&chain_heavy) > chain_work(&chain_long));
        let cands1 = [chain_heavy, chain_long];
        assert_eq!(
            select_tip(&cands1),
            Some(0),
            "work law must pick the heavier chain"
        );
        assert_eq!(
            select_tip_sabotaged(&cands1),
            Some(1),
            "sabotage twin must disagree here — that disagreement is the witness"
        );

        // Discriminating corpus case 2: the honest/1.3x sim itself. The
        // count twin, fed the 1.3x overtaking fork, agrees with the work
        // law only by accident of length; the equal-hashrate case shows it
        // sabotaged: equal work sums, nonce tie-break preserved. The key
        // discrimination is case 1 — a court that cannot tell the two
        // selectors apart proves nothing.
        let (honest, fork) = withheld_fork_sim(40, 20, 10, 0xDEAD_BEEF);
        let cands2 = [honest, fork];
        assert_eq!(select_tip(&cands2), select_tip_sabotaged(&cands2));
    }
}
