PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX st:   <https://strata.chatman.ai/ontology#>

SELECT ?name ?rustType ?value ?comment
WHERE {
  ?c a st:ConsensusConstant ; rdfs:label "CONSENSUS_CONSTANTS" .
  {
    ?c st:workUnit ?value .
    BIND("WORK_UNIT" AS ?name)
    BIND("&str" AS ?rustType)
    BIND("unit of work per mined block (sha256-double-tick)" AS ?comment)
  } UNION {
    ?c st:tieBreak ?value .
    BIND("TIE_BREAK" AS ?name)
    BIND("&str" AS ?rustType)
    BIND("equal-work tip resolution rule (lower-nonce)" AS ?comment)
  } UNION {
    ?c st:eclipseMaxPeersPerSubnet ?value .
    BIND("ECLIPSE_MAX_PEERS_PER_SUBNET" AS ?name)
    BIND("u64" AS ?rustType)
    BIND("hard cap on concurrent peers from any single subnet" AS ?comment)
  } UNION {
    ?c st:spamLimit ?value .
    BIND("SPAM_LIMIT" AS ?name)
    BIND("u64" AS ?rustType)
    BIND("hard cap on gossip messages admitted per slot" AS ?comment)
  }
}
ORDER BY ?name
