# MESSAGE: consensus layout violated — fail-closed presence + typed/
# malformed arms over the CONSENSUS_CONSTANTS individual and the
# HEAVIEST_CHAIN ForkChoice law individual (V7 pattern, reused by S2/S4/S5
# packs). Every required constant property must be present with the right
# datatype and lexical form; the ForkChoice individual must carry both the
# chain-work law and the deterministic tie-break. Any row indicates a broken
# consensus layout.
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX st:   <https://strata.chatman.ai/ontology#>

SELECT DISTINCT (COALESCE(?f1,?f2,?f3,?f4,?f5,?f6,?f7) AS ?field)
       (COALESCE(?p1,?p2,?p3,?p4,?p5,?p6,?p7) AS ?problem)
WHERE {
  {
    ?c a st:ConsensusConstant ; rdfs:label "CONSENSUS_CONSTANTS" .
    FILTER NOT EXISTS { ?c st:workUnit ?anyW }
    BIND("WORK_UNIT" AS ?f1) BIND("missing_constant: no st:workUnit on CONSENSUS_CONSTANTS" AS ?p1)
  } UNION {
    ?c a st:ConsensusConstant ; rdfs:label "CONSENSUS_CONSTANTS" .
    FILTER NOT EXISTS { ?c st:tieBreak ?anyT }
    BIND("TIE_BREAK" AS ?f2) BIND("missing_constant: no st:tieBreak on CONSENSUS_CONSTANTS" AS ?p2)
  } UNION {
    ?c a st:ConsensusConstant ; rdfs:label "CONSENSUS_CONSTANTS" .
    FILTER NOT EXISTS { ?c st:eclipseMaxPeersPerSubnet ?anyE }
    BIND("ECLIPSE_MAX_PEERS_PER_SUBNET" AS ?f3) BIND("missing_constant: no st:eclipseMaxPeersPerSubnet on CONSENSUS_CONSTANTS" AS ?p3)
  } UNION {
    ?c a st:ConsensusConstant ; rdfs:label "CONSENSUS_CONSTANTS" .
    FILTER NOT EXISTS { ?c st:spamLimit ?anyS }
    BIND("SPAM_LIMIT" AS ?f4) BIND("missing_constant: no st:spamLimit on CONSENSUS_CONSTANTS" AS ?p4)
  } UNION {
    ?c a st:ConsensusConstant ; rdfs:label "CONSENSUS_CONSTANTS" ; st:eclipseMaxPeersPerSubnet ?v .
    FILTER(datatype(?v) != xsd:integer || !REGEX(STR(?v), "^[0-9]+$"))
    BIND("ECLIPSE_MAX_PEERS_PER_SUBNET" AS ?f5) BIND("malformed_integer" AS ?p5)
  } UNION {
    ?c a st:ConsensusConstant ; rdfs:label "CONSENSUS_CONSTANTS" ; st:spamLimit ?v .
    FILTER(datatype(?v) != xsd:integer || !REGEX(STR(?v), "^[0-9]+$"))
    BIND("SPAM_LIMIT" AS ?f6) BIND("malformed_integer" AS ?p6)
  } UNION {
    ?f a st:ForkChoice ; rdfs:label "HEAVIEST_CHAIN" .
    FILTER NOT EXISTS { ?f st:chainWork ?anyCW }
    BIND("FORK_CHOICE_LAW" AS ?f7) BIND("missing_law: no st:chainWork on HEAVIEST_CHAIN" AS ?p7)
  }
}
ORDER BY ?field ?problem
