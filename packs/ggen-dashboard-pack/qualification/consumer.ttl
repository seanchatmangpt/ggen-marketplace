@prefix dash: <https://ggen.io/ontology/dashboard#> .
@prefix ex: <https://ggen.io/qualification/dashboard-consumer#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex:overview
  a dash:Projection ;
  dash:projectionId "overview" ;
  dash:label "System overview" ;
  dash:description "Cross-plane standing, evidence, and recent receipts." ;
  dash:route "/" ;
  dash:plane "SYSTEM" ;
  dash:icon "activity" .

ex:evidence
  a dash:Projection ;
  dash:projectionId "evidence" ;
  dash:label "Evidence" ;
  dash:description "Observed/admitted/executed/verified evidence without standing collapse." ;
  dash:route "/evidence" ;
  dash:plane "EVIDENCE" ;
  dash:icon "shield-check" .

ex:receipts
  a dash:Projection ;
  dash:projectionId "receipts" ;
  dash:label "Receipts" ;
  dash:description "Digest-bound consequence identities and their exact admitted subjects." ;
  dash:route "/receipts" ;
  dash:plane "RECEIPT" ;
  dash:icon "fingerprint" .

ex:replay
  a dash:Projection ;
  dash:projectionId "replay" ;
  dash:label "Replay" ;
  dash:description "Receipt DAG replay and equivalence witnesses." ;
  dash:route "/replay" ;
  dash:plane "REPLAY" ;
  dash:icon "git-branch" .

ex:qualificationRun
  a prov:Activity ;
  prov:used dash:DashboardContract ;
  prov:generated ex:overview, ex:evidence, ex:receipts, ex:replay .
