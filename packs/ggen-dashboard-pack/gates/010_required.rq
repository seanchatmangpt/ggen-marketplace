# MESSAGE: dashboard contracts and projections are incomplete; any row is a refusal.
PREFIX dash: <https://ggen.io/ontology/dashboard#>
SELECT ?subject ?violation WHERE {
  {
    BIND(dash:DashboardContract AS ?subject)
    FILTER NOT EXISTS { dash:DashboardContract dash:requiresBRCE true }
    BIND("dashboard-contract-must-require-brce" AS ?violation)
  } UNION {
    ?subject a dash:StandingState .
    FILTER NOT EXISTS { ?subject dash:code ?code }
    BIND("standing-code-required" AS ?violation)
  } UNION {
    ?subject a dash:StandingState .
    FILTER NOT EXISTS { ?subject dash:rank ?rank }
    BIND("standing-rank-required" AS ?violation)
  } UNION {
    ?subject a dash:Projection .
    FILTER NOT EXISTS { ?subject dash:projectionId ?id }
    BIND("projection-id-required" AS ?violation)
  } UNION {
    ?subject a dash:Projection .
    FILTER NOT EXISTS { ?subject dash:label ?label }
    BIND("projection-label-required" AS ?violation)
  } UNION {
    ?subject a dash:Projection .
    FILTER NOT EXISTS { ?subject dash:description ?description }
    BIND("projection-description-required" AS ?violation)
  } UNION {
    ?subject a dash:Projection .
    FILTER NOT EXISTS { ?subject dash:route ?route }
    BIND("projection-route-required" AS ?violation)
  } UNION {
    ?subject a dash:Projection .
    FILTER NOT EXISTS { ?subject dash:plane ?plane }
    BIND("projection-plane-required" AS ?violation)
  } UNION {
    ?subject a dash:Projection .
    FILTER NOT EXISTS { ?subject dash:icon ?icon }
    BIND("projection-icon-required" AS ?violation)
  }
}
ORDER BY ?subject ?violation
