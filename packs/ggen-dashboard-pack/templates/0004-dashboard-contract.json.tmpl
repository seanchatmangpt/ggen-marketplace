---
to: "src/generated/dashboard-contract.json"
sparql:
  contract: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?version ?requiresBRCE
    WHERE {
      dash:DashboardContract dash:contractVersion ?version ;
                             dash:requiresBRCE ?requiresBRCE .
    }
  states: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?code ?rank ?label ?cssToken ?allowsDo
    WHERE {
      ?state a dash:StandingState ;
             dash:code ?code ;
             dash:rank ?rank ;
             dash:label ?label ;
             dash:cssToken ?cssToken ;
             dash:allowsDo ?allowsDo .
    }
    ORDER BY ?rank ?code
  stages: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?code ?stageOrder ?label ?allowsDo
    WHERE {
      ?stage a dash:AuthorityStage ;
             dash:code ?code ;
             dash:stageOrder ?stageOrder ;
             dash:label ?label ;
             dash:allowsDo ?allowsDo .
    }
    ORDER BY ?stageOrder
  intents: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?code ?label ?allowsDo
    WHERE {
      ?intent a dash:IntentKind ;
              dash:code ?code ;
              dash:label ?label ;
              dash:allowsDo ?allowsDo .
    }
    ORDER BY ?code
  projections: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?id ?label ?description ?route ?plane ?icon
    WHERE {
      ?projection a dash:Projection ;
                  dash:projectionId ?id ;
                  dash:label ?label ;
                  dash:description ?description ;
                  dash:route ?route ;
                  dash:plane ?plane ;
                  dash:icon ?icon .
    }
    ORDER BY ?route ?id
---
{
  "schema": "https://ggen.io/schema/dashboard-contract/v1",
  "contractVersion": "{{ contract[0].version }}",
  "brceRequired": {{ contract[0].requiresBRCE }},
  "standing": [
{% for state in states %}    {"code":"{{ state.code }}","rank":{{ state.rank }},"label":"{{ state.label }}","cssToken":"{{ state.cssToken }}","allowsDo":{{ state.allowsDo }}}{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "authorityStages": [
{% for stage in stages %}    {"code":"{{ stage.code }}","order":{{ stage.stageOrder }},"label":"{{ stage.label }}","allowsDo":{{ stage.allowsDo }}}{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "intentKinds": [
{% for intent in intents %}    {"code":"{{ intent.code }}","label":"{{ intent.label }}","allowsDo":{{ intent.allowsDo }}}{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "projections": [
{% for projection in projections %}    {"id":"{{ projection.id }}","label":"{{ projection.label }}","description":"{{ projection.description }}","route":"{{ projection.route }}","plane":"{{ projection.plane }}","icon":"{{ projection.icon }}"}{% if not loop.last %},{% endif %}
{% endfor %}  ]
}
