---
to: "src/generated/semantic-tokens.css"
sparql:
  tokens: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?name ?value
    WHERE {
      ?token a dash:SemanticToken ;
             dash:tokenName ?name ;
             dash:tokenValue ?value .
    }
    ORDER BY ?name
  states: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?code ?cssToken
    WHERE {
      ?state a dash:StandingState ;
             dash:code ?code ;
             dash:cssToken ?cssToken .
    }
    ORDER BY ?code
---
/* GENERATED BY ggen-dashboard-pack. DO NOT EDIT. */
:root {
{% for token in tokens %}  --ggen-{{ token.name }}: {{ token.value }};
{% endfor %}
  --ggen-radius-sm: 0.375rem;
  --ggen-radius-md: 0.625rem;
  --ggen-space-1: 0.25rem;
  --ggen-space-2: 0.5rem;
  --ggen-space-3: 0.75rem;
  --ggen-space-4: 1rem;
  --ggen-space-6: 1.5rem;
  --ggen-space-8: 2rem;
  --ggen-font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  --ggen-font-sans: Inter, ui-sans-serif, system-ui, sans-serif;
}

{% for state in states %}[data-standing="{{ state.code }}"],
[data-standing^="{{ state.code }}:"] {
  --standing-token: var(--ggen-{{ state.cssToken }}-color, var(--ggen-text-muted));
}
{% endfor %}

:root {
  --ggen-standing-unknown-color: var(--ggen-text-muted);
  --ggen-standing-unsupported-color: var(--ggen-text-muted);
  --ggen-standing-blocked-color: var(--ggen-warning);
  --ggen-standing-build-broken-color: var(--ggen-negative);
  --ggen-standing-partial-alive-color: var(--ggen-accent);
  --ggen-standing-alive-color: var(--ggen-positive);
  --ggen-standing-refused-color: var(--ggen-negative);
}
