---
to: "src/generated/dashboard-contract.ts"
sparql:
  contract: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?version ?requiresBRCE
    WHERE {
      dash:DashboardContract dash:contractVersion ?version ;
                             dash:requiresBRCE ?requiresBRCE .
    }
  states: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?code ?rank ?label ?cssToken ?allowsDo
    WHERE {
      ?state a dash:StandingState ;
             dash:code ?code ;
             dash:rank ?rank ;
             dash:label ?label ;
             dash:cssToken ?cssToken ;
             dash:allowsDo ?allowsDo .
    }
    ORDER BY ?rank ?code
  stages: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?code ?stageOrder ?label ?allowsDo
    WHERE {
      ?stage a dash:AuthorityStage ;
             dash:code ?code ;
             dash:stageOrder ?stageOrder ;
             dash:label ?label ;
             dash:allowsDo ?allowsDo .
    }
    ORDER BY ?stageOrder
  intents: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?code ?label ?allowsDo
    WHERE {
      ?intent a dash:IntentKind ;
              dash:code ?code ;
              dash:label ?label ;
              dash:allowsDo ?allowsDo .
    }
    ORDER BY ?code
---
/* GENERATED BY ggen-dashboard-pack. DO NOT EDIT. */

export const DASHBOARD_CONTRACT_VERSION = "{{ contract[0].version }}" as const;
export const BRCE_REQUIRED = {{ contract[0].requiresBRCE }} as const;

export const STANDING_STATES = [
{% for state in states %}  { code: "{{ state.code }}", rank: {{ state.rank }}, label: "{{ state.label }}", cssToken: "{{ state.cssToken }}", allowsDo: {{ state.allowsDo }} },
{% endfor %}] as const;

export type StandingCode = (typeof STANDING_STATES)[number]["code"];
export type RefusedStanding = `REFUSED:${string}`;
export type Standing = StandingCode | RefusedStanding;

export const AUTHORITY_STAGES = [
{% for stage in stages %}  { code: "{{ stage.code }}", order: {{ stage.stageOrder }}, label: "{{ stage.label }}", allowsDo: {{ stage.allowsDo }} },
{% endfor %}] as const;

export type AuthorityStage = (typeof AUTHORITY_STAGES)[number]["code"];

export const INTENT_KINDS = [
{% for intent in intents %}  { code: "{{ intent.code }}", label: "{{ intent.label }}", allowsDo: {{ intent.allowsDo }} },
{% endfor %}] as const;

export type IntentKind = (typeof INTENT_KINDS)[number]["code"];

export type EvidenceKind =
  | "observed"
  | "admitted"
  | "executed"
  | "changed"
  | "verified"
  | "inferred"
  | "refused"
  | "blocked"
  | "unsupported";

export interface SubjectIdentity {
  repository?: string;
  ref?: string;
  sha?: string;
  digest?: string;
  environment?: string;
}

export interface EvidenceRecord {
  id: string;
  kind: EvidenceKind;
  subject: SubjectIdentity;
  claim: string;
  source: string;
  observedAt?: string;
}

export interface ReceiptIdentity {
  id: string;
  digest: string;
  algorithm: "blake3" | "sha256";
}

export interface Receipt {
  identity: ReceiptIdentity;
  subject: SubjectIdentity;
  intentId: string;
  authority: string;
  consequence: string;
  standing: Standing;
  replayOf?: string;
  evidenceIds: readonly string[];
}

export interface ConstructedIntent<TPayload = unknown> {
  id: string;
  kind: IntentKind;
  stage: "CONSTRUCT";
  subject: SubjectIdentity;
  payload: TPayload;
  requestedBy: string;
  expectedConsequence: string;
}

export interface BrcePreflight<TPayload = unknown> {
  intent: ConstructedIntent<TPayload>;
  stage: "PREFLIGHT";
  admitted: boolean;
  authority: string | null;
  policyWitnesses: readonly string[];
  refusal?: RefusedStanding;
}

export interface ReplayNode {
  receiptId: string;
  parents: readonly string[];
  subject: SubjectIdentity;
  standing: Standing;
}

export function standingDefinition(standing: Standing) {
  const family = standing.startsWith("REFUSED:") ? "REFUSED" : standing;
  return STANDING_STATES.find((candidate) => candidate.code === family);
}

export function mayCrossDo(stage: AuthorityStage): boolean {
  return AUTHORITY_STAGES.find((candidate) => candidate.code === stage)?.allowsDo === true;
}
