---
to: "src/generated/projections.ts"
sparql:
  projections: |
    PREFIX dash: <https://ggen.io/ontology/dashboard#>
    SELECT ?id ?label ?description ?route ?plane ?icon
    WHERE {
      ?projection a dash:Projection ;
                  dash:projectionId ?id ;
                  dash:label ?label ;
                  dash:description ?description ;
                  dash:route ?route ;
                  dash:plane ?plane ;
                  dash:icon ?icon .
    }
    ORDER BY ?route ?id
---
/* GENERATED BY ggen-dashboard-pack. DO NOT EDIT. */

export interface DashboardProjection {
  id: string;
  label: string;
  description: string;
  route: string;
  plane: string;
  icon: string;
}

export const DASHBOARD_PROJECTIONS: readonly DashboardProjection[] = [
{% for projection in projections %}  {
    id: "{{ projection.id }}",
    label: "{{ projection.label }}",
    description: "{{ projection.description }}",
    route: "{{ projection.route }}",
    plane: "{{ projection.plane }}",
    icon: "{{ projection.icon }}",
  },
{% endfor %}];

export const PROJECTION_BY_ID = Object.fromEntries(
  DASHBOARD_PROJECTIONS.map((projection) => [projection.id, projection]),
) as Readonly<Record<string, DashboardProjection>>;

export function projectionForRoute(pathname: string): DashboardProjection | undefined {
  return DASHBOARD_PROJECTIONS.find((projection) => projection.route === pathname);
}
