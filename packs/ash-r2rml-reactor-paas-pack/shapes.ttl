@prefix rpaas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rpaas:AshResourceSpecShape a sh:NodeShape ;
  sh:targetClass rpaas:AshResourceSpec ;
  sh:property [ sh:path rpaas:resourceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("service" "intent" "policy" "receipt") ] ;
  sh:property [ sh:path rpaas:module ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path rpaas:domainModule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path rpaas:classIri ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path rpaas:subjectTemplate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "\\{id\\}" ] ;
  sh:property [ sh:path rpaas:tableName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

rpaas:ReactorWorkflowSpecShape a sh:NodeShape ;
  sh:targetClass rpaas:ReactorWorkflowSpec ;
  sh:property [ sh:path rpaas:module ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path rpaas:domainModule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path rpaas:contractModule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path rpaas:actuatorModule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path rpaas:ashR2rmlRef ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{40}$" ] ;
  sh:property [ sh:path rpaas:zeroUnreceiptedActuation ; sh:hasValue true ] ;
  sh:property [ sh:path rpaas:defaultActuator ; sh:hasValue "GgenPaaS.Actuator.Refuse" ] .
