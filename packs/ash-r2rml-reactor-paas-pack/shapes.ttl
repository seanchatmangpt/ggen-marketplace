@prefix paas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

paas:AshResourceSpecShape a sh:NodeShape ;
  sh:targetClass paas:AshResourceSpec ;
  sh:property [ sh:path paas:resourceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("service" "intent" "policy" "receipt") ] ;
  sh:property [ sh:path paas:module ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path paas:domainModule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path paas:classIri ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path paas:subjectTemplate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "\\{id\\}" ] ;
  sh:property [ sh:path paas:tableName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

paas:ReactorWorkflowSpecShape a sh:NodeShape ;
  sh:targetClass paas:ReactorWorkflowSpec ;
  sh:property [ sh:path paas:module ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path paas:domainModule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path paas:contractModule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path paas:actuatorModule ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path paas:ashR2rmlRef ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{40}$" ] ;
  sh:property [ sh:path paas:zeroUnreceiptedActuation ; sh:hasValue true ] ;
  sh:property [ sh:path paas:defaultActuator ; sh:hasValue "GgenPaaS.Actuator.Refuse" ] .
