PREFIX rpaas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#>
SELECT ?kind ?module ?domainModule ?classIri ?subjectTemplate ?tableName
WHERE {
  ?spec a rpaas:AshResourceSpec ;
        rpaas:resourceKind ?kind ;
        rpaas:module ?module ;
        rpaas:domainModule ?domainModule ;
        rpaas:classIri ?class ;
        rpaas:subjectTemplate ?subjectTemplate ;
        rpaas:tableName ?tableName .
  BIND(STR(?class) AS ?classIri)
}
ORDER BY ?kind ?module
