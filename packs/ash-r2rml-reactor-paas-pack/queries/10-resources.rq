PREFIX paas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#>
SELECT ?kind ?module ?domainModule ?classIri ?subjectTemplate ?tableName
WHERE {
  ?spec a paas:AshResourceSpec ;
        paas:resourceKind ?kind ;
        paas:module ?module ;
        paas:domainModule ?domainModule ;
        paas:classIri ?class ;
        paas:subjectTemplate ?subjectTemplate ;
        paas:tableName ?tableName .
  BIND(STR(?class) AS ?classIri)
}
ORDER BY ?kind
