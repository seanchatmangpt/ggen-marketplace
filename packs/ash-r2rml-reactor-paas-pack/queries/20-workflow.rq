PREFIX paas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?workflowModule ?workflowLabel ?domainModule ?contractModule ?actuatorModule ?ashR2rmlRef ?ashFloor ?reactorFloor ?authority ?consequentialDo ?defaultActuator
       ?serviceModule ?serviceSubject ?intentModule ?intentSubject ?policyModule ?receiptModule ?receiptSubject
WHERE {
  ?workflow a paas:ReactorWorkflowSpec ;
    skos:prefLabel ?workflowLabel ;
    paas:module ?workflowModule ;
    paas:domainModule ?domainModule ;
    paas:contractModule ?contractModule ;
    paas:actuatorModule ?actuatorModule ;
    paas:ashR2rmlRef ?ashR2rmlRef ;
    paas:ashFloor ?ashFloor ;
    paas:reactorFloor ?reactorFloor ;
    paas:authority ?authority ;
    paas:consequentialDo ?consequentialDoValue ;
    paas:zeroUnreceiptedActuation true ;
    paas:defaultActuator ?defaultActuator .
  BIND(STR(?consequentialDoValue) AS ?consequentialDo)
  ?service a paas:AshResourceSpec ; paas:resourceKind "service" ; paas:domainModule ?domainModule ;
    paas:module ?serviceModule ; paas:subjectTemplate ?serviceSubject .
  ?intent a paas:AshResourceSpec ; paas:resourceKind "intent" ; paas:domainModule ?domainModule ;
    paas:module ?intentModule ; paas:subjectTemplate ?intentSubject .
  ?policy a paas:AshResourceSpec ; paas:resourceKind "policy" ; paas:domainModule ?domainModule ;
    paas:module ?policyModule .
  ?receipt a paas:AshResourceSpec ; paas:resourceKind "receipt" ; paas:domainModule ?domainModule ;
    paas:module ?receiptModule ; paas:subjectTemplate ?receiptSubject .
}
ORDER BY ?workflowModule
