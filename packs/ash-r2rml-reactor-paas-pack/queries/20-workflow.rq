PREFIX rpaas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#>
SELECT ?workflowModule ?domainModule ?contractModule ?actuatorModule ?ashR2rmlRef ?ashFloor ?reactorFloor ?defaultActuator
WHERE {
  rpaas:ProvisionWorkflow a rpaas:ReactorWorkflowSpec ;
    rpaas:module ?workflowModule ;
    rpaas:domainModule ?domainModule ;
    rpaas:contractModule ?contractModule ;
    rpaas:actuatorModule ?actuatorModule ;
    rpaas:ashR2rmlRef ?ashR2rmlRef ;
    rpaas:ashFloor ?ashFloor ;
    rpaas:reactorFloor ?reactorFloor ;
    rpaas:zeroUnreceiptedActuation true ;
    rpaas:defaultActuator ?defaultActuator .
}
