PREFIX paas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#>
SELECT ?workflowModule ?domainModule ?contractModule ?actuatorModule ?ashR2rmlRef ?ashFloor ?reactorFloor ?defaultActuator
WHERE {
  paas:ProvisionWorkflow a paas:ReactorWorkflowSpec ;
    paas:module ?workflowModule ;
    paas:domainModule ?domainModule ;
    paas:contractModule ?contractModule ;
    paas:actuatorModule ?actuatorModule ;
    paas:ashR2rmlRef ?ashR2rmlRef ;
    paas:ashFloor ?ashFloor ;
    paas:reactorFloor ?reactorFloor ;
    paas:zeroUnreceiptedActuation true ;
    paas:defaultActuator ?defaultActuator .
}
