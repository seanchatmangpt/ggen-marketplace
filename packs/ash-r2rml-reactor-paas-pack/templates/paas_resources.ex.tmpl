# G2 FIX (2026-10-17, lane G2 / PUBLISH_RECORD B2): the AshR2RML.Resource
# extension may be a dev-only dep in consumer apps; the emitted resources
# now guard it at compile time so MIX_ENV=prod compiles without ash_r2rml.
# When ash_r2rml IS loaded, expansion is identical to the previous
# unconditional form (receipt: docs receipt lane G2).
defmodule AshR2RMLCompat.Guard do
  @moduledoc "Compile-time guard: drops the `r2rml` section WITHOUT expansion when ash_r2rml is not a loaded compile-time dep; extensions option stays a compile-time LITERAL (Spark derives section imports from it)."
  defmacro if_r2rml(do: block) do
    if Code.ensure_loaded?(AshR2RML.Resource) do
      # raw AST splice, no quote/hygiene context
      block
    else
      :ok
    end
  end
end

require AshR2RMLCompat.Guard
import AshR2RMLCompat.Guard, only: [if_r2rml: 1]

{% for row in results %}
{% if row.kind == "service" %}
defmodule {{ row.module }} do
  @moduledoc "Generated platform-service resource grounded in schema:SoftwareApplication."
  use Ash.Resource, domain: {{ row.domainModule }}, data_layer: Ash.DataLayer.Ets, extensions: [AshR2RML.Resource]

  if_r2rml do
    r2rml do
      table_name "{{ row.tableName }}"
      class "{{ row.classIri }}"
      subject do
        template "{{ row.subjectTemplate }}"
        term_type :iri
      end
      property :name, "https://schema.org/name"
      property :description, "https://schema.org/description"
      property :version, "https://schema.org/softwareVersion"
    end
  end

  attributes do
    uuid_primary_key :id
    attribute :name, :string, allow_nil?: false, public?: true
    attribute :description, :string, allow_nil?: false, public?: true
    attribute :version, :string, allow_nil?: false, public?: true
    timestamps()
  end

  actions do
    defaults [:read, :update, :destroy]
    create :register do
      primary? true
      accept [:name, :description, :version]
    end
  end
end
{% elif row.kind == "intent" %}
defmodule {{ row.module }} do
  @moduledoc "Generated deployment-intent resource grounded in prov:Plan."
  use Ash.Resource, domain: {{ row.domainModule }}, data_layer: Ash.DataLayer.Ets, extensions: [AshR2RML.Resource]

  if_r2rml do
    r2rml do
      table_name "{{ row.tableName }}"
      class "{{ row.classIri }}"
      subject do
        template "{{ row.subjectTemplate }}"
        term_type :iri
      end
      property :service_ref, "https://ggen.dev/ontology/ash-r2rml-reactor-paas#serviceRef"
      property :target, "https://ggen.dev/ontology/ash-r2rml-reactor-paas#target"
      property :requested_by, "https://ggen.dev/ontology/ash-r2rml-reactor-paas#requestedBy"
      property :status, "https://ggen.dev/ontology/ash-r2rml-reactor-paas#status"
    end
  end

  attributes do
    uuid_primary_key :id
    attribute :service_ref, :string, allow_nil?: false, public?: true
    attribute :target, :string, allow_nil?: false, public?: true
    attribute :requested_by, :string, allow_nil?: false, public?: true
    attribute :status, :atom, allow_nil?: false, default: :pending, constraints: [one_of: [:pending, :admitted, :refused, :executed]], public?: true
    timestamps()
  end

  actions do
    defaults [:read, :destroy]
    create :request do
      primary? true
      accept [:service_ref, :target, :requested_by]
    end
    update :mark_admitted do
      accept []
      change set_attribute(:status, :admitted)
    end
    update :mark_refused do
      accept []
      change set_attribute(:status, :refused)
    end
    update :mark_executed do
      accept []
      change set_attribute(:status, :executed)
    end
  end
end
