{% elif row.kind == "receipt" %}
defmodule {{ row.module }} do
  @moduledoc "Generated execution-receipt resource grounded in prov:Entity."
  use Ash.Resource, domain: {{ row.domainModule }}, data_layer: Ash.DataLayer.Ets, extensions: [AshR2RML.Resource]

  r2rml do
    table_name "{{ row.tableName }}"
    class "{{ row.classIri }}"
    subject do
      template "{{ row.subjectTemplate }}"
      term_type :iri
    end
    property :intent_ref, "https://ggen.dev/ontology/ash-r2rml-reactor-paas#intentRef"
    property :status, "https://ggen.dev/ontology/ash-r2rml-reactor-paas#status"
    property :semantic_hash, "https://ggen.dev/ontology/ash-r2rml-reactor-paas#semanticHash"
    property :artifact_hash, "https://ggen.dev/ontology/ash-r2rml-reactor-paas#artifactHash"
    property :result, "https://ggen.dev/ontology/ash-r2rml-reactor-paas#result"
  end

  attributes do
    uuid_primary_key :id
    attribute :intent_ref, :string, allow_nil?: false, public?: true
    attribute :status, :atom, allow_nil?: false, constraints: [one_of: [:started, :succeeded, :failed]], public?: true
    attribute :semantic_hash, :string, allow_nil?: false, public?: true
    attribute :artifact_hash, :string, allow_nil?: true, public?: true
    attribute :result, :string, allow_nil?: true, public?: true
    timestamps()
  end

  actions do
    defaults [:read]
    create :start do
      primary? true
      accept [:intent_ref, :status, :semantic_hash]
    end
    update :seal do
      accept [:status, :artifact_hash, :result]
    end
  end
