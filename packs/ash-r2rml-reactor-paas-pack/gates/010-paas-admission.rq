PREFIX paas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#>
ASK {
  {
    FILTER NOT EXISTS {
      paas:ProvisionWorkflow a paas:ReactorWorkflowSpec ;
        paas:zeroUnreceiptedActuation true ;
        paas:defaultActuator "GgenPaaS.Actuator.Refuse" .
    }
  }
  UNION
  {
    ?resource a paas:AshResourceSpec .
    FILTER NOT EXISTS {
      ?resource paas:resourceKind ?kind ;
                paas:module ?module ;
                paas:domainModule ?domain ;
                paas:classIri ?class ;
                paas:subjectTemplate ?subject ;
                paas:tableName ?table .
    }
  }
}
