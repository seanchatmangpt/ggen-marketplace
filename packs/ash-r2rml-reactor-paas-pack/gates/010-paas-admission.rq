PREFIX rpaas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#>
ASK {
  {
    FILTER NOT EXISTS {
      rpaas:ProvisionWorkflow a rpaas:ReactorWorkflowSpec ;
        rpaas:zeroUnreceiptedActuation true ;
        rpaas:defaultActuator "GgenPaaS.Actuator.Refuse" .
    }
  }
  UNION
  {
    ?resource a rpaas:AshResourceSpec .
    FILTER NOT EXISTS {
      ?resource rpaas:resourceKind ?kind ;
                rpaas:module ?module ;
                rpaas:domainModule ?domain ;
                rpaas:classIri ?class ;
                rpaas:subjectTemplate ?subject ;
                rpaas:tableName ?table .
    }
  }
}
