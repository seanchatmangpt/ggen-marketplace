@prefix rpaas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rpaas: a owl:Ontology ;
  dcterms:title "ggen AshR2RML Reactor PaaS operational profile" ;
  dcterms:description "Thin operational closure over public ontologies for deterministic ggen manufacture. Public classes remain public authority; local terms encode only implementation choices that those ontologies do not choose." ;
  dcterms:conformsTo <https://www.w3.org/TR/prov-o/>, <https://www.w3.org/TR/vocab-dcat-3/>, <https://www.w3.org/TR/odrl-model/>, <https://schema.org/> .

rpaas:AshResourceSpec a rdfs:Class ; skos:prefLabel "Ash resource specification" .
rpaas:ReactorWorkflowSpec a rdfs:Class ; skos:prefLabel "Reactor workflow specification" .

rpaas:resourceKind a rdf:Property .
rpaas:module a rdf:Property .
rpaas:domainModule a rdf:Property .
rpaas:contractModule a rdf:Property .
rpaas:actuatorModule a rdf:Property .
rpaas:classIri a rdf:Property .
rpaas:subjectTemplate a rdf:Property .
rpaas:tableName a rdf:Property .
rpaas:ashR2rmlRef a rdf:Property .
rpaas:ashFloor a rdf:Property .
rpaas:reactorFloor a rdf:Property .
rpaas:authority a rdf:Property .
rpaas:consequentialDo a rdf:Property .
rpaas:zeroUnreceiptedActuation a rdf:Property .
rpaas:defaultActuator a rdf:Property .
rpaas:target a rdf:Property .
rpaas:requestedBy a rdf:Property .
rpaas:status a rdf:Property .
rpaas:serviceRef a rdf:Property .
rpaas:actor a rdf:Property .
rpaas:action a rdf:Property .
rpaas:decision a rdf:Property .
rpaas:intentRef a rdf:Property .
rpaas:semanticHash a rdf:Property .
rpaas:artifactHash a rdf:Property .
rpaas:result a rdf:Property .

rpaas:PlatformServiceSpec a rpaas:AshResourceSpec ;
  skos:prefLabel "Platform service" ;
  rpaas:resourceKind "service" ;
  rpaas:module "GgenPaaS.PlatformService" ;
  rpaas:domainModule "GgenPaaS.Domain" ;
  rpaas:classIri schema:SoftwareApplication ;
  rpaas:subjectTemplate "https://ggen.dev/paas/services/{id}" ;
  rpaas:tableName "ggen_paas_services" .

rpaas:DeploymentIntentSpec a rpaas:AshResourceSpec ;
  skos:prefLabel "Deployment intent" ;
  rpaas:resourceKind "intent" ;
  rpaas:module "GgenPaaS.DeploymentIntent" ;
  rpaas:domainModule "GgenPaaS.Domain" ;
  rpaas:classIri prov:Plan ;
  rpaas:subjectTemplate "https://ggen.dev/paas/intents/{id}" ;
  rpaas:tableName "ggen_paas_intents" .

rpaas:AuthorityPolicySpec a rpaas:AshResourceSpec ;
  skos:prefLabel "Authority policy" ;
  rpaas:resourceKind "policy" ;
  rpaas:module "GgenPaaS.AuthorityPolicy" ;
  rpaas:domainModule "GgenPaaS.Domain" ;
  rpaas:classIri odrl:Policy ;
  rpaas:subjectTemplate "https://ggen.dev/paas/policies/{id}" ;
  rpaas:tableName "ggen_paas_policies" .

rpaas:ExecutionReceiptSpec a rpaas:AshResourceSpec ;
  skos:prefLabel "Execution receipt" ;
  rpaas:resourceKind "receipt" ;
  rpaas:module "GgenPaaS.ExecutionReceipt" ;
  rpaas:domainModule "GgenPaaS.Domain" ;
  rpaas:classIri prov:Entity ;
  rpaas:subjectTemplate "https://ggen.dev/paas/receipts/{id}" ;
  rpaas:tableName "ggen_paas_receipts" .

rpaas:ProvisionWorkflow a rpaas:ReactorWorkflowSpec ;
  skos:prefLabel "Receipted PaaS provision workflow" ;
  rpaas:module "GgenPaaS.ProvisionReactor" ;
  rpaas:domainModule "GgenPaaS.Domain" ;
  rpaas:contractModule "GgenPaaS.Contract" ;
  rpaas:actuatorModule "GgenPaaS.Actuator" ;
  rpaas:ashR2rmlRef "067954ad406fd637fd47646bdb10c4580809c79d" ;
  rpaas:ashFloor ">= 3.28.0" ;
  rpaas:reactorFloor ">= 1.0.0" ;
  rpaas:authority "SELECT|CONSTRUCT|DO-via-injected-actuator" ;
  rpaas:consequentialDo true ;
  rpaas:zeroUnreceiptedActuation true ;
  rpaas:defaultActuator "GgenPaaS.Actuator.Refuse" ;
  dcterms:conformsTo <https://www.w3.org/TR/prov-o/>, <https://www.w3.org/TR/odrl-model/> .

rpaas:MarketplaceCatalog a dcat:Catalog ;
  dcterms:title "ggen PaaS manufacturing catalog" ;
  dcterms:description "Catalog anchor for generated platform-service capability descriptions." .
