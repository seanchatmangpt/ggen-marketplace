@prefix paas: <https://ggen.dev/ontology/ash-r2rml-reactor-paas#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

paas: a owl:Ontology ;
  dcterms:title "ggen AshR2RML Reactor PaaS operational profile" ;
  dcterms:description "Thin operational closure over public ontologies for deterministic ggen manufacture. Public classes remain public authority; local terms encode only implementation choices that those ontologies do not choose." ;
  dcterms:conformsTo <https://www.w3.org/TR/prov-o/>, <https://www.w3.org/TR/vocab-dcat-3/>, <https://www.w3.org/TR/odrl-model/>, <https://schema.org/> .

paas:AshResourceSpec a rdfs:Class ; skos:prefLabel "Ash resource specification" .
paas:ReactorWorkflowSpec a rdfs:Class ; skos:prefLabel "Reactor workflow specification" .

paas:resourceKind a rdf:Property .
paas:module a rdf:Property .
paas:domainModule a rdf:Property .
paas:contractModule a rdf:Property .
paas:actuatorModule a rdf:Property .
paas:classIri a rdf:Property .
paas:subjectTemplate a rdf:Property .
paas:tableName a rdf:Property .
paas:ashR2rmlRef a rdf:Property .
paas:ashFloor a rdf:Property .
paas:reactorFloor a rdf:Property .
paas:authority a rdf:Property .
paas:consequentialDo a rdf:Property .
paas:zeroUnreceiptedActuation a rdf:Property .
paas:defaultActuator a rdf:Property .
paas:target a rdf:Property .
paas:requestedBy a rdf:Property .
paas:status a rdf:Property .
paas:serviceRef a rdf:Property .
paas:actor a rdf:Property .
paas:action a rdf:Property .
paas:decision a rdf:Property .
paas:intentRef a rdf:Property .
paas:semanticHash a rdf:Property .
paas:artifactHash a rdf:Property .
paas:result a rdf:Property .

paas:PlatformServiceSpec a paas:AshResourceSpec ;
  skos:prefLabel "Platform service" ;
  paas:resourceKind "service" ;
  paas:module "GgenPaaS.PlatformService" ;
  paas:domainModule "GgenPaaS.Domain" ;
  paas:classIri schema:SoftwareApplication ;
  paas:subjectTemplate "https://ggen.dev/paas/services/{id}" ;
  paas:tableName "ggen_paas_services" .

paas:DeploymentIntentSpec a paas:AshResourceSpec ;
  skos:prefLabel "Deployment intent" ;
  paas:resourceKind "intent" ;
  paas:module "GgenPaaS.DeploymentIntent" ;
  paas:domainModule "GgenPaaS.Domain" ;
  paas:classIri prov:Plan ;
  paas:subjectTemplate "https://ggen.dev/paas/intents/{id}" ;
  paas:tableName "ggen_paas_intents" .

paas:AuthorityPolicySpec a paas:AshResourceSpec ;
  skos:prefLabel "Authority policy" ;
  paas:resourceKind "policy" ;
  paas:module "GgenPaaS.AuthorityPolicy" ;
  paas:domainModule "GgenPaaS.Domain" ;
  paas:classIri odrl:Policy ;
  paas:subjectTemplate "https://ggen.dev/paas/policies/{id}" ;
  paas:tableName "ggen_paas_policies" .

paas:ExecutionReceiptSpec a paas:AshResourceSpec ;
  skos:prefLabel "Execution receipt" ;
  paas:resourceKind "receipt" ;
  paas:module "GgenPaaS.ExecutionReceipt" ;
  paas:domainModule "GgenPaaS.Domain" ;
  paas:classIri prov:Entity ;
  paas:subjectTemplate "https://ggen.dev/paas/receipts/{id}" ;
  paas:tableName "ggen_paas_receipts" .

paas:ProvisionWorkflow a paas:ReactorWorkflowSpec ;
  skos:prefLabel "Receipted PaaS provision workflow" ;
  paas:module "GgenPaaS.ProvisionReactor" ;
  paas:domainModule "GgenPaaS.Domain" ;
  paas:contractModule "GgenPaaS.Contract" ;
  paas:actuatorModule "GgenPaaS.Actuator" ;
  paas:ashR2rmlRef "067954ad406fd637fd47646bdb10c4580809c79d" ;
  paas:ashFloor ">= 3.28.0" ;
  paas:reactorFloor ">= 1.0.0" ;
  paas:authority "SELECT|CONSTRUCT|DO-via-injected-actuator" ;
  paas:consequentialDo true ;
  paas:zeroUnreceiptedActuation true ;
  paas:defaultActuator "GgenPaaS.Actuator.Refuse" ;
  dcterms:conformsTo <https://www.w3.org/TR/prov-o/>, <https://www.w3.org/TR/odrl-model/> .

paas:MarketplaceCatalog a dcat:Catalog ;
  dcterms:title "ggen PaaS manufacturing catalog" ;
  dcterms:description "Catalog anchor for generated platform-service capability descriptions." .
