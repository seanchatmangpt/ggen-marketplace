PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:usesTechnique cr:AdaptiveResponse ; cr:hasPolicy ?policy .
  ?policy a cr:AdaptiveResponsePolicy .
  FILTER NOT EXISTS {
    ?policy cr:maxAttempts ?attempts ; cr:maxPrivilegeScope ?privilege ; cr:maxBlastRadius ?blast ;
            cr:responseReceiptRequired true .
    FILTER(?attempts > 0 && STRLEN(STR(?privilege)) > 0 && STRLEN(STR(?blast)) > 0)
  }
  BIND("adaptive response requires bounded attempts, privilege, blast radius, and receipts" AS ?reason)
}
