PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:usesTechnique cr:Diversity ; cr:hasPolicy ?policy .
  ?policy a cr:DiversityPolicy .
  FILTER NOT EXISTS {
    ?policy cr:variantCount ?count ; cr:variantSetDigest ?digest .
    FILTER(?count >= 2 && STRLEN(STR(?digest)) > 0)
  }
  BIND("diversity requires at least two explicitly identity-bound variants" AS ?reason)
}
