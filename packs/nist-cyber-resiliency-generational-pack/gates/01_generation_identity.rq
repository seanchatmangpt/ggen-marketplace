PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile .
  FILTER NOT EXISTS {
    ?profile cr:generation ?generation ;
             cr:semanticAuthorityDigest ?semantic ;
             cr:sourceSnapshotDigest ?source ;
             cr:manufacturePolicyDigest ?policy ;
             cr:receiptDigest ?receipt .
    ?generation a cr:Generation ; cr:generationId ?generationId .
    FILTER(STRLEN(STR(?semantic)) > 0 && STRLEN(STR(?source)) > 0 &&
           STRLEN(STR(?policy)) > 0 && STRLEN(STR(?receipt)) > 0 &&
           STRLEN(STR(?generationId)) > 0)
  }
  BIND("generational resiliency profile lacks generation identity, semantic/source/manufacture identity, or receipt identity" AS ?reason)
}
