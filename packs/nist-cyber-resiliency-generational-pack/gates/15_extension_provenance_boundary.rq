PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?pattern ?reason WHERE {
  ?pattern a cr:ArchitectureExtensionPattern .
  FILTER NOT EXISTS {
    ?pattern cr:sourceKind cr:MarketplaceExtension ; prov:wasDerivedFrom cr:MarketplaceGenerationalProfileSource .
  }
  BIND("Marketplace architecture extension is missing explicit non-NIST provenance" AS ?reason)
}
