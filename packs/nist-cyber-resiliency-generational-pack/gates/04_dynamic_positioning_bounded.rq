PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:usesTechnique cr:DynamicPositioning ; cr:hasPolicy ?policy .
  ?policy a cr:DynamicPositioningPolicy .
  FILTER NOT EXISTS {
    ?policy cr:changeDimension ?dimension ; cr:maxStaticDurationSeconds ?seconds ; cr:strategyDigest ?strategy .
    FILTER(STRLEN(STR(?dimension)) > 0 && ?seconds > 0 && STRLEN(STR(?strategy)) > 0)
  }
  BIND("dynamic positioning requires an explicit change dimension, bounded static duration, and strategy identity" AS ?reason)
}
