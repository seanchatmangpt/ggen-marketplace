PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:usesTechnique cr:NonPersistence ; cr:hasPolicy ?policy .
  ?policy a cr:NonPersistencePolicy .
  FILTER NOT EXISTS { ?policy cr:maxArtifactLifetimeSeconds ?seconds . FILTER(?seconds > 0) }
  BIND("non-persistence requires a positive maximum artifact lifetime" AS ?reason)
}
