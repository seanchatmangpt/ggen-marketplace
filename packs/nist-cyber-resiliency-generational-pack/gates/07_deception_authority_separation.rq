PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?resource ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:usesTechnique cr:Deception ; cr:hasPolicy ?policy .
  ?policy a cr:DeceptionPolicy .
  {
    FILTER NOT EXISTS { ?policy cr:deceptionBoundaryDigest ?digest . }
    BIND(?policy AS ?resource)
    BIND("deception requires an identity-bound deception boundary" AS ?reason)
  }
  UNION
  {
    ?resource a cr:DeceptionResource ; cr:productionAuthority true .
    BIND("deception resource claims production authority" AS ?reason)
  }
}
