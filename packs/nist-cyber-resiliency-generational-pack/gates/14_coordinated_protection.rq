PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:usesTechnique cr:CoordinatedProtection ; cr:hasPolicy ?policy .
  ?policy a cr:CoordinatedProtectionPolicy .
  FILTER NOT EXISTS {
    ?policy cr:safeguardCount ?count ; cr:safeguardIndependenceDigest ?digest .
    FILTER(?count >= 2 && STRLEN(STR(?digest)) > 0)
  }
  BIND("coordinated protection requires multiple safeguards plus independence evidence" AS ?reason)
}
