PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:usesTechnique cr:Realignment ; cr:hasPolicy ?policy ;
           cr:semanticAuthorityDigest ?semantic ; cr:compatibilityObligation false .
  ?policy a cr:RealignmentPolicy .
  FILTER NOT EXISTS {
    ?policy cr:beforeTopologyDigest ?before ; cr:afterTopologyDigest ?after .
    FILTER(STRLEN(STR(?before)) > 0 && STRLEN(STR(?after)) > 0 && ?before != ?after)
  }
  BIND("realignment requires distinct before/after topology identities under current semantic authority" AS ?reason)
}
