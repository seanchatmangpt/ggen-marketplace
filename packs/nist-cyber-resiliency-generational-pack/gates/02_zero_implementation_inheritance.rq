PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile .
  {
    FILTER NOT EXISTS { ?profile cr:inheritsImplementation false . }
    BIND("generation does not explicitly refuse implementation inheritance" AS ?reason)
  }
  UNION
  {
    FILTER NOT EXISTS { ?profile cr:compatibilityObligation false . }
    BIND("generation does not explicitly refuse compatibility obligation" AS ?reason)
  }
}
