PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:usesTechnique cr:SubstantiatedIntegrity ; cr:hasPolicy ?policy .
  ?policy a cr:IntegrityPolicy .
  FILTER NOT EXISTS {
    ?policy cr:immutableSourceDigest ?source ; cr:buildProvenanceDigest ?provenance ;
            cr:sbomDigest ?sbom ; cr:securityValidationDigest ?validation .
  }
  BIND("substantiated integrity requires immutable-source, provenance, SBOM, and security-validation evidence" AS ?reason)
}
