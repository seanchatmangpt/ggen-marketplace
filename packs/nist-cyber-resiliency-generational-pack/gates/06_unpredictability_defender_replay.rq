PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:usesTechnique cr:Unpredictability ; cr:hasPolicy ?policy .
  ?policy a cr:UnpredictabilityPolicy .
  FILTER NOT EXISTS {
    ?policy cr:strategyDigest ?strategy ; cr:defenderReplayDigest ?replay .
    FILTER(STRLEN(STR(?strategy)) > 0 && STRLEN(STR(?replay)) > 0)
  }
  BIND("unpredictability requires strategy identity plus defender-side deterministic replay evidence" AS ?reason)
}
