PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:usesTechnique cr:Redundancy ; cr:hasPolicy ?policy .
  ?policy a cr:RedundancyPolicy .
  FILTER NOT EXISTS {
    ?policy cr:replicaCount ?replicas ; cr:failureDomainCount ?domains ; cr:failureDomainDigest ?digest .
    FILTER(?replicas >= 2 && ?domains >= 2 && STRLEN(STR(?digest)) > 0)
  }
  BIND("redundancy requires at least two replicas across at least two identity-bound failure domains" AS ?reason)
}
