PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?policy ?reason WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:hasPolicy ?policy .
  ?policy a cr:MonitoringContextPolicy .
  FILTER(EXISTS { ?profile cr:usesTechnique cr:AnalyticMonitoring } || EXISTS { ?profile cr:usesTechnique cr:ContextualAwareness })
  FILTER NOT EXISTS {
    ?policy cr:eventModelDigest ?eventModel ; cr:monitoringEvidenceDigest ?monitoring ; cr:contextEvidenceDigest ?context .
  }
  BIND("analytic monitoring/contextual awareness requires event-model, monitoring-evidence, and context-evidence identities" AS ?reason)
}
