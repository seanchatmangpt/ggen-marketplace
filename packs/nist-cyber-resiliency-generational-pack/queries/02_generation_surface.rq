PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?profile ?generationId ?technique ?semantic ?source ?policy ?receipt WHERE {
  ?profile a cr:GenerationalResiliencyProfile ; cr:generation ?generation ;
           cr:semanticAuthorityDigest ?semantic ; cr:sourceSnapshotDigest ?source ;
           cr:manufacturePolicyDigest ?policy ; cr:receiptDigest ?receipt ; cr:usesTechnique ?technique .
  ?generation cr:generationId ?generationId .
}
ORDER BY ?profile ?technique
