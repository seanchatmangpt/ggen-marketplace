PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?technique ?label ?source ?sourceId WHERE {
  ?technique a cr:NISTDerivedTechnique ; skos:prefLabel ?label ; prov:wasDerivedFrom ?source .
  OPTIONAL { ?source dct:identifier ?sourceId . }
}
ORDER BY ?label
