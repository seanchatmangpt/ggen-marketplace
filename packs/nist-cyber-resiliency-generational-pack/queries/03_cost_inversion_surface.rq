PREFIX cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#>
SELECT ?assessment ?technique ?costClass ?rationale WHERE {
  ?assessment a cr:CostAssessment ; cr:sourceKind cr:MarketplaceExtension ;
              cr:assessesTechnique ?technique ; cr:costClass ?costClass ; cr:rationale ?rationale .
}
ORDER BY ?costClass ?technique
