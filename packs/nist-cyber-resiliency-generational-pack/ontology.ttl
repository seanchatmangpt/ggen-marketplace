@prefix cr: <https://seanchatmangpt.github.io/ggen-marketplace/nist-cyber-resiliency-generational#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cr:Source a rdfs:Class .
cr:NISTSource a rdfs:Class ; rdfs:subClassOf cr:Source .
cr:MarketplaceSource a rdfs:Class ; rdfs:subClassOf cr:Source .

cr:NIST_SP_800_160_V2R1 a cr:NISTSource ;
  dct:identifier "NIST SP 800-160 Vol. 2 Rev. 1" ;
  dct:title "Developing Cyber-Resilient Systems: A Systems Security Engineering Approach" ;
  cr:sourceUri "https://doi.org/10.6028/NIST.SP.800-160v2r1"^^xsd:anyURI .

cr:NIST_SP_800_53R5 a cr:NISTSource ;
  dct:identifier "NIST SP 800-53 Rev. 5" ;
  dct:title "Security and Privacy Controls for Information Systems and Organizations" ;
  cr:sourceUri "https://doi.org/10.6028/NIST.SP.800-53r5"^^xsd:anyURI .

cr:NIST_OSCAL a cr:NISTSource ;
  dct:identifier "NIST OSCAL" ;
  dct:title "Open Security Controls Assessment Language" ;
  cr:sourceUri "https://github.com/usnistgov/OSCAL"^^xsd:anyURI .

cr:MarketplaceGenerationalProfileSource a cr:MarketplaceSource ;
  dct:identifier "ggen-marketplace generational resiliency profile v26.9.26" ;
  dct:title "Marketplace generation-bound resiliency manufacturing policy" ;
  cr:sourceUri "https://github.com/seanchatmangpt/ggen-marketplace/tree/main/packs/nist-cyber-resiliency-generational-pack"^^xsd:anyURI .

cr:sourceUri a rdf:Property .
cr:sourceKind a rdf:Property .
cr:sourceFragment a rdf:Property .
cr:reusesPack a rdf:Property .

cr:NISTDerived a skos:Concept ; skos:prefLabel "NIST-derived" .
cr:MarketplaceExtension a skos:Concept ; skos:prefLabel "Marketplace extension" .

cr:CyberResiliencyTechnique a rdfs:Class .
cr:NISTDerivedTechnique a rdfs:Class ; rdfs:subClassOf cr:CyberResiliencyTechnique .

cr:AdaptiveResponse a cr:NISTDerivedTechnique ; skos:prefLabel "Adaptive Response" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:AnalyticMonitoring a cr:NISTDerivedTechnique ; skos:prefLabel "Analytic Monitoring" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:ContextualAwareness a cr:NISTDerivedTechnique ; skos:prefLabel "Contextual Awareness" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:CoordinatedProtection a cr:NISTDerivedTechnique ; skos:prefLabel "Coordinated Protection" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:Deception a cr:NISTDerivedTechnique ; skos:prefLabel "Deception" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:Diversity a cr:NISTDerivedTechnique ; skos:prefLabel "Diversity" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:DynamicPositioning a cr:NISTDerivedTechnique ; skos:prefLabel "Dynamic Positioning" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:NonPersistence a cr:NISTDerivedTechnique ; skos:prefLabel "Non-Persistence" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:PrivilegeRestriction a cr:NISTDerivedTechnique ; skos:prefLabel "Privilege Restriction" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:Realignment a cr:NISTDerivedTechnique ; skos:prefLabel "Realignment" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:Redundancy a cr:NISTDerivedTechnique ; skos:prefLabel "Redundancy" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:Segmentation a cr:NISTDerivedTechnique ; skos:prefLabel "Segmentation" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:SubstantiatedIntegrity a cr:NISTDerivedTechnique ; skos:prefLabel "Substantiated Integrity" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .
cr:Unpredictability a cr:NISTDerivedTechnique ; skos:prefLabel "Unpredictability" ; cr:sourceKind cr:NISTDerived ; prov:wasDerivedFrom cr:NIST_SP_800_160_V2R1 .

cr:ArchitectureExtensionPattern a rdfs:Class .
cr:GenerationalRemanufacture a cr:ArchitectureExtensionPattern ;
  cr:sourceKind cr:MarketplaceExtension ;
  prov:wasDerivedFrom cr:MarketplaceGenerationalProfileSource ;
  cr:sourceFragment "manufacture a bounded current generation from admitted semantic/source capital; prior implementation has no inheritance standing" ;
  cr:reusesPack "governed-runtime-adapter-pack", "supply-chain-evidence-pack", "receipt-provenance-unification-pack" .

cr:ImplementationNonInheritance a cr:ArchitectureExtensionPattern ;
  cr:sourceKind cr:MarketplaceExtension ;
  prov:wasDerivedFrom cr:MarketplaceGenerationalProfileSource ;
  cr:sourceFragment "prior implementation existence creates no future implementation obligation" .

cr:ZeroCompatibilityObligation a cr:ArchitectureExtensionPattern ;
  cr:sourceKind cr:MarketplaceExtension ;
  prov:wasDerivedFrom cr:MarketplaceGenerationalProfileSource ;
  cr:sourceFragment "compatibility is not admitted merely because an earlier generation exposed a surface" .

cr:GenerationalResiliencyProfile a rdfs:Class .
cr:Generation a rdfs:Class .
cr:TechniquePolicy a rdfs:Class .
cr:NonPersistencePolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:DynamicPositioningPolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:DiversityPolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:UnpredictabilityPolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:DeceptionPolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:RealignmentPolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:RedundancyPolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:SegmentationPolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:PrivilegePolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:MonitoringContextPolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:IntegrityPolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:AdaptiveResponsePolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:CoordinatedProtectionPolicy a rdfs:Class ; rdfs:subClassOf cr:TechniquePolicy .
cr:DeceptionResource a rdfs:Class .

cr:generation a rdf:Property .
cr:generationId a rdf:Property .
cr:semanticAuthorityDigest a rdf:Property .
cr:sourceSnapshotDigest a rdf:Property .
cr:manufacturePolicyDigest a rdf:Property .
cr:receiptDigest a rdf:Property .
cr:inheritsImplementation a rdf:Property .
cr:compatibilityObligation a rdf:Property .
cr:usesTechnique a rdf:Property .
cr:hasPolicy a rdf:Property .
cr:maxArtifactLifetimeSeconds a rdf:Property .
cr:changeDimension a rdf:Property .
cr:maxStaticDurationSeconds a rdf:Property .
cr:variantCount a rdf:Property .
cr:variantSetDigest a rdf:Property .
cr:strategyDigest a rdf:Property .
cr:defenderReplayDigest a rdf:Property .
cr:deceptionBoundaryDigest a rdf:Property .
cr:productionAuthority a rdf:Property .
cr:beforeTopologyDigest a rdf:Property .
cr:afterTopologyDigest a rdf:Property .
cr:replicaCount a rdf:Property .
cr:failureDomainCount a rdf:Property .
cr:failureDomainDigest a rdf:Property .
cr:segmentationBoundaryDigest a rdf:Property .
cr:capabilitySetDigest a rdf:Property .
cr:leastPrivilege a rdf:Property .
cr:eventModelDigest a rdf:Property .
cr:monitoringEvidenceDigest a rdf:Property .
cr:contextEvidenceDigest a rdf:Property .
cr:immutableSourceDigest a rdf:Property .
cr:buildProvenanceDigest a rdf:Property .
cr:sbomDigest a rdf:Property .
cr:securityValidationDigest a rdf:Property .
cr:maxAttempts a rdf:Property .
cr:maxPrivilegeScope a rdf:Property .
cr:maxBlastRadius a rdf:Property .
cr:responseReceiptRequired a rdf:Property .
cr:safeguardCount a rdf:Property .
cr:safeguardIndependenceDigest a rdf:Property .

cr:CostAssessment a rdfs:Class .
cr:HighManufacturingLeverage a skos:Concept ; skos:prefLabel "high manufacturing leverage" .
cr:IntrinsicResourceCost a skos:Concept ; skos:prefLabel "intrinsic independent-resource cost" .
cr:assessesTechnique a rdf:Property .
cr:costClass a rdf:Property .
cr:rationale a rdf:Property .

cr:CostDynamicPositioning a cr:CostAssessment ; cr:sourceKind cr:MarketplaceExtension ; prov:wasDerivedFrom cr:MarketplaceGenerationalProfileSource ; cr:assessesTechnique cr:DynamicPositioning ; cr:costClass cr:HighManufacturingLeverage ; cr:rationale "generated placement/topology changes can be manufacture parameters rather than hand migrations" .
cr:CostNonPersistence a cr:CostAssessment ; cr:sourceKind cr:MarketplaceExtension ; prov:wasDerivedFrom cr:MarketplaceGenerationalProfileSource ; cr:assessesTechnique cr:NonPersistence ; cr:costClass cr:HighManufacturingLeverage ; cr:rationale "replaceable generated artifacts reduce marginal software persistence cost" .
cr:CostRealignment a cr:CostAssessment ; cr:sourceKind cr:MarketplaceExtension ; prov:wasDerivedFrom cr:MarketplaceGenerationalProfileSource ; cr:assessesTechnique cr:Realignment ; cr:costClass cr:HighManufacturingLeverage ; cr:rationale "architecture can be re-projected from current semantic authority instead of migrated in place" .
cr:CostDiversity a cr:CostAssessment ; cr:sourceKind cr:MarketplaceExtension ; prov:wasDerivedFrom cr:MarketplaceGenerationalProfileSource ; cr:assessesTechnique cr:Diversity ; cr:costClass cr:HighManufacturingLeverage ; cr:rationale "multiple implementation projections can share one admitted semantic source" .
cr:CostUnpredictability a cr:CostAssessment ; cr:sourceKind cr:MarketplaceExtension ; prov:wasDerivedFrom cr:MarketplaceGenerationalProfileSource ; cr:assessesTechnique cr:Unpredictability ; cr:costClass cr:HighManufacturingLeverage ; cr:rationale "observer-visible variation can be generated while defender replay remains digest-bound" .
cr:CostRedundancy a cr:CostAssessment ; cr:sourceKind cr:MarketplaceExtension ; prov:wasDerivedFrom cr:MarketplaceGenerationalProfileSource ; cr:assessesTechnique cr:Redundancy ; cr:costClass cr:IntrinsicResourceCost ; cr:rationale "independent compute, storage, regions, and failure domains remain real resource costs" .
