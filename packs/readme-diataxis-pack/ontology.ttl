@prefix rdx: <https://seanchatmangpt.github.io/ggen-marketplace/readme-diataxis#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# A flat README conflates four distinct kinds of documentation (Diataxis:
# tutorial, how-to, reference, explanation) plus project meta-info that sits
# outside Diataxis entirely (license, contributing, support). This pack
# models each README section's semantic content as RDF individuals typed by
# their real Diataxis destination, and projects them deterministically.

rdx:Project a rdfs:Class ;
    rdfs:label "Project" ;
    rdfs:comment "The singleton project identity a README describes (title, description, license)." .

rdx:RunStep a rdfs:Class ;
    rdfs:label "Run step" ;
    rdfs:comment "One ordered step, filtered per template by kind: {clone,install,start} power the tutorial page, {deploy,test} power the how-to pages." .

rdx:UsageExample a rdfs:Class ;
    rdfs:label "Usage example" ;
    rdfs:comment "One task-recipe code example, projected into the how-to quadrant." .

rdx:ApiEndpoint a rdfs:Class ;
    rdfs:label "API endpoint" ;
    rdfs:comment "One documented HTTP endpoint, projected into the reference quadrant as an exact contract." .

rdx:ApiParameter a rdfs:Class ;
    rdfs:label "API parameter" ;
    rdfs:comment "One parameter of an ApiEndpoint." .

rdx:EnvVar a rdfs:Class ;
    rdfs:label "Environment variable" ;
    rdfs:comment "One environment variable the project reads, projected into the reference quadrant." .

rdx:TechStackItem a rdfs:Class ;
    rdfs:label "Tech stack item" ;
    rdfs:comment "One technology used by the project. layer in {client,server}." .

rdx:FaqEntry a rdfs:Class ;
    rdfs:label "FAQ entry" ;
    rdfs:comment "One question/answer pair, projected into the explanation quadrant (rationale, not instruction)." .

rdx:RoadmapItem a rdfs:Class ;
    rdfs:label "Roadmap item" ;
    rdfs:comment "One planned/shipped feature line, projected into the meta page (outside the four Diataxis quadrants)." .

rdx:ContactChannel a rdfs:Class ;
    rdfs:label "Contact channel" ;
    rdfs:comment "One support/feedback contact route (email, chat, issue tracker). kind in {support,feedback,contributing}." .

rdx:position a rdf:Property .
rdx:kind a rdf:Property .
rdx:layer a rdf:Property .
rdx:command a rdf:Property .
rdx:label a rdf:Property .
rdx:method a rdf:Property .
rdx:path a rdf:Property .
rdx:forEndpoint a rdf:Property .
rdx:paramName a rdf:Property .
rdx:paramType a rdf:Property .
rdx:required a rdf:Property .
rdx:varName a rdf:Property .
rdx:techName a rdf:Property .
rdx:question a rdf:Property .
rdx:answer a rdf:Property .
rdx:license a rdf:Property .
rdx:language a rdf:Property .
rdx:code a rdf:Property .
rdx:text a rdf:Property .
rdx:url a rdf:Property .
rdx:value a rdf:Property .
