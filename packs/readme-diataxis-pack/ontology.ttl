@prefix rdx: <https://seanchatmangpt.github.io/ggen-marketplace/readme-diataxis#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Classes -------------------------------------------------------------

rdx:Project a rdfs:Class ;
    rdfs:label "Project" ;
    rdfs:comment "Singleton: the project this README documents. dcterms:title, dcterms:description, rdx:license, rdx:repositoryUrl (optional)." .

rdx:RunStep a rdfs:Class ;
    rdfs:label "Run step" ;
    rdfs:comment "One shell step. rdx:kind partitions it into a Diataxis quadrant: clone/install/start -> tutorials/getting-started.md (one guided learning path); deploy/test -> how-to/*.md (independent task recipes). Same class, filtered per template, mirroring mdbook-pattern-language-pack's mdp:NavigationEntry.kind branch." .

rdx:ApiEndpoint a rdfs:Class ;
    rdfs:label "API endpoint" ;
    rdfs:comment "One HTTP endpoint -> reference/api.md table row." .

rdx:ApiParameter a rdfs:Class ;
    rdfs:label "API parameter" ;
    rdfs:comment "One parameter of one rdx:ApiEndpoint (rdx:forEndpoint), or of one rdx:FunctionRef (rdx:forFunction) -> reference/api.md or reference/functions.md sub-table row." .

rdx:FunctionRef a rdfs:Class ;
    rdfs:label "Function reference" ;
    rdfs:comment "One function signature (e.g. add(num1, num2)) -> reference/functions.md." .

rdx:EnvVar a rdfs:Class ;
    rdfs:label "Environment variable" ;
    rdfs:comment "One required/optional env var -> reference/environment-variables.md." .

rdx:TechStackItem a rdfs:Class ;
    rdfs:label "Tech stack item" ;
    rdfs:comment "One technology at one layer (client/server) -> reference/tech-stack.md." .

rdx:UsageExample a rdfs:Class ;
    rdfs:label "Usage example" ;
    rdfs:comment "One runnable code example -> how-to/usage-examples.md (a task recipe: how to use this, not how to learn it)." .

rdx:FaqEntry a rdfs:Class ;
    rdfs:label "FAQ entry" ;
    rdfs:comment "One question/answer pair -> explanation/faq.md." .

rdx:LessonLearned a rdfs:Class ;
    rdfs:label "Lesson learned" ;
    rdfs:comment "One free-text retrospective note -> explanation/lessons-and-optimizations.md." .

rdx:Optimization a rdfs:Class ;
    rdfs:label "Optimization" ;
    rdfs:comment "One free-text optimization note -> explanation/lessons-and-optimizations.md." .

rdx:RelatedLink a rdfs:Class ;
    rdfs:label "Related link" ;
    rdfs:comment "One related-project link -> explanation/related.md." .

rdx:RoadmapItem a rdfs:Class ;
    rdfs:label "Roadmap item" ;
    rdfs:comment "One planned-future-work line -> docs/meta.md." .

rdx:Feature a rdfs:Class ;
    rdfs:label "Feature" ;
    rdfs:comment "One shipped-feature bullet -> docs/meta.md." .

rdx:ContactChannel a rdfs:Class ;
    rdfs:label "Contact channel" ;
    rdfs:comment "One support/feedback contact (kind=email|slack) -> docs/meta.md." .

rdx:CodeExample a rdfs:Class ;
    rdfs:label "Code example" ;
    rdfs:comment "One real, runnable example directory under examples/. rdx:position (nav order), rdx:exampleName (the directory name under examples/), dcterms:description. Its files are separate rdx:ExampleFile individuals (rdx:forExample); this class itself owns no file content so index.md's Examples nav section can list one entry per directory without depending on file count." .

rdx:ExampleFile a rdfs:Class ;
    rdfs:label "Example file" ;
    rdfs:comment "One real file inside one rdx:CodeExample's directory -> examples/{{ exampleName }}/{{ relPath }}. rdx:forExample links to the owning rdx:CodeExample; rdx:relPath is the file's path relative to that directory; rdx:content is the file's real, complete body (no placeholders); rdx:language is the file's language/format (json, javascript, markdown, ...); rdx:position orders files within one example for deterministic generation. Fanned out by one generic template (templates/example-file.tmpl) via ggen's confirmed one-template-many-files row projection: an unbounded SPARQL SELECT with an interpolated to: path, one output file per row -- see /tmp/ggen-multifile-test experiment, corroborated by packs/azure-terraform-pack/templates/main.tf.tmpl's row-based to: fan-out." .

rdx:PlaygroundFile a rdfs:Class ;
    rdfs:label "Playground file" ;
    rdfs:comment "One real file under playground/ -- a runnable scratch environment the reader can open and edit live (not doc prose). rdx:relPath, rdx:content, rdx:language, rdx:position. Fanned out the same row-projection way as rdx:ExampleFile, via templates/playground-file.tmpl." .

# Properties ------------------------------------------------------------

rdx:position a rdf:Property ; rdfs:comment "Integer sort key. Required on every ordered class; see gates/020_ordering_integrity.rq." .
rdx:kind a rdf:Property .
rdx:command a rdf:Property .
rdx:label a rdf:Property .
rdx:method a rdf:Property .
rdx:path a rdf:Property .
rdx:forEndpoint a rdf:Property .
rdx:forFunction a rdf:Property .
rdx:paramName a rdf:Property .
rdx:paramType a rdf:Property .
rdx:required a rdf:Property .
rdx:signature a rdf:Property .
rdx:varName a rdf:Property .
rdx:layer a rdf:Property .
rdx:techName a rdf:Property .
rdx:language a rdf:Property .
rdx:code a rdf:Property .
rdx:question a rdf:Property .
rdx:answer a rdf:Property .
rdx:text a rdf:Property .
rdx:url a rdf:Property .
rdx:value a rdf:Property .
rdx:license a rdf:Property .
rdx:repositoryUrl a rdf:Property .
rdx:exampleName a rdf:Property .
rdx:forExample a rdf:Property .
rdx:relPath a rdf:Property .
rdx:content a rdf:Property .

# Pattern language (descriptive, not consumed by templates) -------------

rdx:PatternLanguage a skos:ConceptScheme ;
    dcterms:title "README-to-Diataxis Pattern Language" ;
    dcterms:description "Patterns for splitting a flat README into a correctly-quadranted Diataxis doc set instead of one undifferentiated file." .

rdx:SectionIsNotQuadrant a skos:Concept ;
    skos:inScheme rdx:PatternLanguage ;
    skos:prefLabel "A README section heading is not a Diataxis quadrant" ;
    skos:definition "A heading like \"Usage/Examples\" or \"FAQ\" names a topic, not a documentation type. Classify by what the reader is doing (learning / achieving a task / looking up a fact / understanding why), not by the section's original heading." .

rdx:MetaIsNotAQuadrant a skos:Concept ;
    skos:inScheme rdx:PatternLanguage ;
    skos:prefLabel "Project meta-info sits outside the four quadrants" ;
    skos:definition "License, contributing, support contacts, roadmap, and feature lists are project identity/process information, not tutorial/how-to/reference/explanation content. Diataxis keeps them out of the four quadrants; this pack projects them into one docs/meta.md instead of force-fitting them into a quadrant." .

rdx:OneRunStepClassTwoQuadrants a skos:Concept ;
    skos:inScheme rdx:PatternLanguage ;
    skos:prefLabel "One RunStep class, filtered into two quadrants" ;
    skos:definition "Clone/install/start steps are one ordered learning path (tutorial). Deploy/test steps are independent task recipes (how-to) -- not a step in the same walkthrough. Same rdx:RunStep class, partitioned by rdx:kind per template, rather than two unrelated classes." .
