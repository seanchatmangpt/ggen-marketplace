# MESSAGE: every ordered/table-shaped individual this pack's templates
# project must carry the properties its owning template's SELECT reads
# with no OPTIONAL/COALESCE fallback -- a missing one produces an opaque
# template-render failure rather than a clear admission refusal. Any row
# below = a subject missing a property its projection depends on.
PREFIX rdx: <https://seanchatmangpt.github.io/ggen-marketplace/readme-diataxis#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?s ?missing WHERE {
  { ?s a rdx:Project . BIND(dcterms:title AS ?missing) }
  UNION { ?s a rdx:Project . BIND(dcterms:description AS ?missing) }
  UNION { ?s a rdx:Project . BIND(rdx:license AS ?missing) }
  UNION { ?s a rdx:RunStep . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:RunStep . BIND(rdx:kind AS ?missing) }
  UNION { ?s a rdx:RunStep . BIND(rdx:label AS ?missing) }
  UNION { ?s a rdx:RunStep . BIND(rdx:command AS ?missing) }
  UNION { ?s a rdx:ApiEndpoint . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:ApiEndpoint . BIND(rdx:method AS ?missing) }
  UNION { ?s a rdx:ApiEndpoint . BIND(rdx:path AS ?missing) }
  UNION { ?s a rdx:ApiEndpoint . BIND(dcterms:description AS ?missing) }
  UNION { ?s a rdx:ApiParameter . BIND(rdx:forEndpoint AS ?missing) }
  UNION { ?s a rdx:ApiParameter . BIND(rdx:paramName AS ?missing) }
  UNION { ?s a rdx:ApiParameter . BIND(rdx:paramType AS ?missing) }
  UNION { ?s a rdx:ApiParameter . BIND(rdx:required AS ?missing) }
  UNION { ?s a rdx:ApiParameter . BIND(dcterms:description AS ?missing) }
  UNION { ?s a rdx:FunctionRef . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:FunctionRef . BIND(rdx:signature AS ?missing) }
  UNION { ?s a rdx:FunctionRef . BIND(dcterms:description AS ?missing) }
  UNION { ?s a rdx:EnvVar . BIND(rdx:varName AS ?missing) }
  UNION { ?s a rdx:EnvVar . BIND(rdx:required AS ?missing) }
  UNION { ?s a rdx:EnvVar . BIND(dcterms:description AS ?missing) }
  UNION { ?s a rdx:TechStackItem . BIND(rdx:layer AS ?missing) }
  UNION { ?s a rdx:TechStackItem . BIND(rdx:techName AS ?missing) }
  UNION { ?s a rdx:UsageExample . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:UsageExample . BIND(rdx:language AS ?missing) }
  UNION { ?s a rdx:UsageExample . BIND(rdx:code AS ?missing) }
  UNION { ?s a rdx:FaqEntry . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:FaqEntry . BIND(rdx:question AS ?missing) }
  UNION { ?s a rdx:FaqEntry . BIND(rdx:answer AS ?missing) }
  UNION { ?s a rdx:LessonLearned . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:LessonLearned . BIND(rdx:text AS ?missing) }
  UNION { ?s a rdx:Optimization . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:Optimization . BIND(rdx:text AS ?missing) }
  UNION { ?s a rdx:RelatedLink . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:RelatedLink . BIND(dcterms:title AS ?missing) }
  UNION { ?s a rdx:RelatedLink . BIND(rdx:url AS ?missing) }
  UNION { ?s a rdx:RoadmapItem . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:RoadmapItem . BIND(rdx:text AS ?missing) }
  UNION { ?s a rdx:Feature . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:Feature . BIND(rdx:text AS ?missing) }
  UNION { ?s a rdx:ContactChannel . BIND(rdx:kind AS ?missing) }
  UNION { ?s a rdx:ContactChannel . BIND(rdx:value AS ?missing) }
  UNION { ?s a rdx:CodeExample . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:CodeExample . BIND(rdx:exampleName AS ?missing) }
  UNION { ?s a rdx:CodeExample . BIND(dcterms:description AS ?missing) }
  UNION { ?s a rdx:ExampleFile . BIND(rdx:forExample AS ?missing) }
  UNION { ?s a rdx:ExampleFile . BIND(rdx:relPath AS ?missing) }
  UNION { ?s a rdx:ExampleFile . BIND(rdx:content AS ?missing) }
  UNION { ?s a rdx:ExampleFile . BIND(rdx:language AS ?missing) }
  UNION { ?s a rdx:ExampleFile . BIND(rdx:position AS ?missing) }
  UNION { ?s a rdx:PlaygroundFile . BIND(rdx:relPath AS ?missing) }
  UNION { ?s a rdx:PlaygroundFile . BIND(rdx:content AS ?missing) }
  UNION { ?s a rdx:PlaygroundFile . BIND(rdx:language AS ?missing) }
  UNION { ?s a rdx:PlaygroundFile . BIND(rdx:position AS ?missing) }
  FILTER NOT EXISTS { ?s ?missing ?any }
}
ORDER BY ?s ?missing
