# Deterministic qualification fixture -- transcribes the standard-readme
# boilerplate template (the exact document this pack was designed against)
# into real RDF facts. Doubles as the pack's own worked example.

<urn:readme-diataxis:project> a rdx:Project ;
    dcterms:title "Project Title" ;
    dcterms:description "A brief description of what this project does and who it's for" ;
    rdx:license "MIT" .

# Run steps -- clone/install/start partition into the tutorial;
# deploy/test partition into how-to task recipes.
<urn:readme-diataxis:run:000> a rdx:RunStep ; rdx:position 0 ; rdx:kind "clone" ; rdx:label "Clone the project" ; rdx:command "git clone https://link-to-project" .
<urn:readme-diataxis:run:001> a rdx:RunStep ; rdx:position 1 ; rdx:kind "install" ; rdx:label "Go to the project directory" ; rdx:command "cd my-project" .
<urn:readme-diataxis:run:002> a rdx:RunStep ; rdx:position 2 ; rdx:kind "install" ; rdx:label "Install dependencies" ; rdx:command "npm install" .
<urn:readme-diataxis:run:003> a rdx:RunStep ; rdx:position 3 ; rdx:kind "start" ; rdx:label "Start the server" ; rdx:command "npm run start" .
<urn:readme-diataxis:run:010> a rdx:RunStep ; rdx:position 10 ; rdx:kind "deploy" ; rdx:label "Deploy this project" ; rdx:command "npm run deploy" .
<urn:readme-diataxis:run:020> a rdx:RunStep ; rdx:position 20 ; rdx:kind "test" ; rdx:label "Run tests" ; rdx:command "npm run test" .

# API reference
<urn:readme-diataxis:api:000> a rdx:ApiEndpoint ; rdx:position 0 ; rdx:method "GET" ; rdx:path "/api/items" ; dcterms:description "Get all items" .
<urn:readme-diataxis:api:000:p0> a rdx:ApiParameter ; rdx:forEndpoint <urn:readme-diataxis:api:000> ; rdx:paramName "api_key" ; rdx:paramType "string" ; rdx:required true ; dcterms:description "Your API key" .

<urn:readme-diataxis:api:001> a rdx:ApiEndpoint ; rdx:position 1 ; rdx:method "GET" ; rdx:path "/api/items/${id}" ; dcterms:description "Get item" .
<urn:readme-diataxis:api:001:p0> a rdx:ApiParameter ; rdx:forEndpoint <urn:readme-diataxis:api:001> ; rdx:paramName "id" ; rdx:paramType "string" ; rdx:required true ; dcterms:description "Id of item to fetch" .

