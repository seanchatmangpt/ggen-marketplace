    rdx:relPath "scratch.js" ; rdx:language "javascript" ;
    rdx:content """// GENERATED by ggen from readme-diataxis-pack's rdx:PlaygroundFile
// urn:readme-diataxis:playground:000. This is a scratch environment --
// edit it freely and re-run; a re-sync will overwrite it back to this
// baseline. Run with: node playground/scratch.js

function add(num1, num2) {
  return num1 + num2;
}

console.log("add(10, 32) =", add(10, 32));
""" .
