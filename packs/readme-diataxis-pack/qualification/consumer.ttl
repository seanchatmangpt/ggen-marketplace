@prefix rdx: <https://seanchatmangpt.github.io/ggen-marketplace/readme-diataxis#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:readme-diataxis:qualification-project> a rdx:Project ;
    dcterms:title "Awesome Project" ;
    dcterms:description "A generic project scaffolded from the standard-readme template, converted to a Diataxis docs tree." ;
    rdx:license "MIT" .

<urn:readme-diataxis:step-clone> a rdx:RunStep ;
    rdx:position 0 ;
    rdx:kind "clone" ;
    rdx:label "Clone the repository" ;
    rdx:command "git clone https://link-to-project" .

<urn:readme-diataxis:step-cd> a rdx:RunStep ;
    rdx:position 1 ;
    rdx:kind "clone" ;
    rdx:label "Enter the project directory" ;
    rdx:command "cd my-project" .

<urn:readme-diataxis:step-install> a rdx:RunStep ;
    rdx:position 2 ;
    rdx:kind "install" ;
    rdx:label "Install dependencies" ;
    rdx:command "npm install" .

<urn:readme-diataxis:step-start> a rdx:RunStep ;
    rdx:position 3 ;
    rdx:kind "start" ;
    rdx:label "Start the server" ;
    rdx:command "npm run start" .

<urn:readme-diataxis:endpoint-add> a rdx:ApiEndpoint ;
    rdx:position 0 ;
    rdx:method "GET" ;
    rdx:path "/api/items" ;
    dcterms:description "Returns all items." .

<urn:readme-diataxis:param-limit> a rdx:ApiParameter ;
    rdx:forEndpoint <urn:readme-diataxis:endpoint-add> ;
    rdx:paramName "limit" ;
    rdx:paramType "integer" ;
    rdx:required false ;
    dcterms:description "Maximum number of items to return." .

<urn:readme-diataxis:env-port> a rdx:EnvVar ;
    rdx:varName "PORT" ;
    rdx:required true ;
    dcterms:description "Port the server listens on." .

<urn:readme-diataxis:env-api-key> a rdx:EnvVar ;
    rdx:varName "API_KEY" ;
    rdx:required true ;
    dcterms:description "Key used to authenticate outbound requests." .

<urn:readme-diataxis:tech-react> a rdx:TechStackItem ;
    rdx:layer "client" ;
    rdx:techName "React" .

<urn:readme-diataxis:tech-node> a rdx:TechStackItem ;
    rdx:layer "server" ;
    rdx:techName "Node.js" .

<urn:readme-diataxis:faq-support> a rdx:FaqEntry ;
    rdx:position 0 ;
    rdx:question "Does this project support X?" ;
    rdx:answer "See the reference documentation for the current admitted feature set." .

<urn:readme-diataxis:step-deploy> a rdx:RunStep ;
    rdx:position 0 ;
    rdx:kind "deploy" ;
    rdx:label "Build a production image" ;
    rdx:command "docker build -t my-project:latest ." .

<urn:readme-diataxis:step-test> a rdx:RunStep ;
    rdx:position 0 ;
    rdx:kind "test" ;
    rdx:label "Run the test suite" ;
    rdx:command "npm test" .

<urn:readme-diataxis:usage-fetch> a rdx:UsageExample ;
    rdx:position 0 ;
    rdx:language "javascript" ;
    rdx:code "fetch('/api/items').then(r => r.json())" ;
    dcterms:description "Fetch all items from the client." .

<urn:readme-diataxis:roadmap-v2> a rdx:RoadmapItem ;
    rdx:position 0 ;
    rdx:text "Add pagination to /api/items." .

<urn:readme-diataxis:contact-support> a rdx:ContactChannel ;
    rdx:kind "support" ;
    rdx:value "support@example.invalid" .

<urn:readme-diataxis:contact-contributing> a rdx:ContactChannel ;
    rdx:kind "contributing" ;
    rdx:value "See CONTRIBUTING.md" .
