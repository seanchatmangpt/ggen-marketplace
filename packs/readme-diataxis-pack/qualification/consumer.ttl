# Code example -- real, runnable Node.js project calling this fixture's own
# add(num1, num2) (see rdx:FunctionRef fn:000 above). Three real files fanned
# out by templates/example-file.tmpl into examples/add-numbers/.
<urn:readme-diataxis:example:000> a rdx:CodeExample ; rdx:position 0 ; rdx:exampleName "add-numbers" ;
    dcterms:description "Minimal runnable Node.js project that imports and calls add(num1, num2)." .

<urn:readme-diataxis:example:000:package-json> a rdx:ExampleFile ;
    rdx:forExample <urn:readme-diataxis:example:000> ; rdx:position 0 ;
    rdx:relPath "package.json" ; rdx:language "json" ;
    rdx:content """{
  "name": "add-numbers-example",
  "version": "1.0.0",
  "description": "Minimal runnable example calling add(num1, num2) from the readme-diataxis-pack qualification fixture.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js"
  },
  "license": "MIT"
}
""" .

<urn:readme-diataxis:example:000:index-js> a rdx:ExampleFile ;
    rdx:forExample <urn:readme-diataxis:example:000> ; rdx:position 1 ;
    rdx:relPath "index.js" ; rdx:language "javascript" ;
    rdx:content """// GENERATED by ggen from readme-diataxis-pack's rdx:ExampleFile
// urn:readme-diataxis:example:000:index-js. Edit that individual, not this
// file -- a re-sync overwrites it.
//
// Real, runnable example: calls add(num1, num2) (see reference/functions.md)
// and prints the result. Run with: node index.js

function add(num1, num2) {
  return num1 + num2;
}

const result = add(2, 3);
console.log(`add(2, 3) = ${result}`);

module.exports = { add };
""" .

<urn:readme-diataxis:example:000:readme-md> a rdx:ExampleFile ;
    rdx:forExample <urn:readme-diataxis:example:000> ; rdx:position 2 ;
    rdx:relPath "README.md" ; rdx:language "markdown" ;
    rdx:content """# add-numbers example

Real, runnable Node.js example for this project's `add(num1, num2)`
function (see [reference/functions.md](../../reference/functions.md)).

## Run it

```
node index.js
```

## Expected output

```
add(2, 3) = 5
```
""" .

