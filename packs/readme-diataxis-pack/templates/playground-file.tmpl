---
to: "playground/{{ row.relPath }}"
sparql:
  rows: |
    PREFIX rdx: <https://seanchatmangpt.github.io/ggen-marketplace/readme-diataxis#>
    SELECT ?relPath ?content WHERE {
      ?f a rdx:PlaygroundFile ; rdx:relPath ?relPath ; rdx:content ?content ; rdx:position ?position .
    } ORDER BY ?position
---
{{ row.content }}
