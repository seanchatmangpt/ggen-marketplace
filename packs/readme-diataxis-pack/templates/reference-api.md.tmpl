    SELECT ?position ?method ?path ?description WHERE {
      ?e a rdx:ApiEndpoint ;
         rdx:position ?position ;
         rdx:method ?method ;
         rdx:path ?path ;
         dcterms:description ?description .
    } ORDER BY ?position
  params: |
    PREFIX rdx: <https://seanchatmangpt.github.io/ggen-marketplace/readme-diataxis#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?path ?paramName ?paramType ?required ?description WHERE {
      ?e a rdx:ApiEndpoint ; rdx:path ?path .
      ?p a rdx:ApiParameter ; rdx:forEndpoint ?e ;
         rdx:paramName ?paramName ; rdx:paramType ?paramType ;
         rdx:required ?required ; dcterms:description ?description .
    } ORDER BY ?path ?paramName
  envvars: |
    PREFIX rdx: <https://seanchatmangpt.github.io/ggen-marketplace/readme-diataxis#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?varName ?required ?description WHERE {
      ?v a rdx:EnvVar ; rdx:varName ?varName ; rdx:required ?required ;
         dcterms:description ?description .
    } ORDER BY ?varName
