---
to: "examples/{{ row.exampleName }}/{{ row.relPath }}"
sparql:
  rows: |
    PREFIX rdx: <https://seanchatmangpt.github.io/ggen-marketplace/readme-diataxis#>
    SELECT ?exampleName ?relPath ?content WHERE {
      ?f a rdx:ExampleFile ; rdx:forExample ?ex ; rdx:relPath ?relPath ; rdx:content ?content ; rdx:position ?position .
      ?ex a rdx:CodeExample ; rdx:exampleName ?exampleName .
    } ORDER BY ?exampleName ?position
---
{{ row.content }}
