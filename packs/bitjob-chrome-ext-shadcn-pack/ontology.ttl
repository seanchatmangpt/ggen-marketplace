@prefix pack: <urn:ggen-marketplace:bitjob-chrome-ext-shadcn-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:Project a pack:ScannedProject ;
    rdfs:label "bitjob-chrome-ext" ;
    pack:sourcePath "/Users/sac/cns/integrations/bitjob-chrome-ext"^^xsd:string ;
    pack:framework "vue" ;
    pack:frameworkVersion "^3.5.18" ;
    pack:buildTool "vite@^7.0.6 via @crxjs/vite-plugin" ;
    pack:packageManager "npm (package-lock.json present); pnpm-lock.yaml also present" ;
    pack:packageJsonName "bitjob-chrome-ext" ;
    rdfs:comment "Chrome extension project (webextension-polyfill, chrome-types) built with Vue 3 + Vite, not React; no deck.gl or React found anywhere in the repo." .

pack:ShadcnConfig a pack:ShadcnConfiguration ;
    rdfs:label "shadcn-vue components.json" ;
    pack:filePath "components.json" ;
    pack:style "new-york" ;
    pack:baseColor "stone" ;
    pack:uiAlias "@/components/ui" ;
    rdfs:comment "components.json is present and configures shadcn-vue, but no files exist under the configured @/components/ui alias anywhere in the project -- the config was never scaffolded into actual components." .

pack:CnUtility a pack:ShadcnArtifact ;
    rdfs:label "cn() helper" ;
    pack:filePath "src/lib/utils.ts" ;
    pack:usesDependencies "clsx@^2.1.1, tailwind-merge@^3.3.1" ;
    pack:usedInSourceFiles "0"^^xsd:integer ;
    rdfs:comment "The only shadcn-convention artifact actually present on disk: a cn(...) = twMerge(clsx(inputs)) helper. Confirmed via grep -rn 'cn(' across all .vue/.ts files that it is defined but never called from any .vue component -- dead scaffolding, not real usage." .

pack:ClassVarianceAuthorityDependency a pack:UnusedDependency ;
    rdfs:label "class-variance-authority" ;
    pack:declaredVersion "^0.7.1" ;
    pack:usageSitesFound "0"^^xsd:integer ;
    rdfs:comment "Listed in package.json dependencies but zero cva( calls found anywhere in src via grep -- no variant-driven shadcn components exist." .

pack:ShadcnUiComponentsDirectory a pack:AbsentArtifact ;
    rdfs:label "components/ui directory" ;
    pack:searchedPaths "src/components, src/ui, repo-wide" ;
    pack:found false ;
    rdfs:comment "No components/ui directory (the conventional home for shadcn primitives like button.tsx/card.tsx/dialog.tsx) exists anywhere in the repository. Zero shadcn component files are present." .

pack:RadixOrRekaUi a pack:AbsentArtifact ;
    rdfs:label "radix-vue / reka-ui imports" ;
    pack:usageSitesFound "0"^^xsd:integer ;
    rdfs:comment "grep -rl 'radix-vue|reka-ui' across src returned zero matches; neither package is even declared in package.json." .

pack:DeckGl a pack:AbsentArtifact ;
    rdfs:label "deck.gl" ;
    pack:searchedTerms "deck.gl, DeckGL, ScatterplotLayer, GeoJsonLayer, HexagonLayer, ArcLayer" ;
    pack:found false ;
    rdfs:comment "No deck.gl dependency, import, layer class, or viewport/view-state code found anywhere in the repository (grep run repo-wide excluding node_modules and .git). deck.gl is not used in this project." .
@prefix gc: <https://ggen.io/ontology/ggen-create#> .

gc:gc_subject_bitjob_chrome_ext_shadcn_pack a gc:GenerationSubject ;
    gc:name "bitjob" ;
    gc:upper "BITJOB" ;
    gc:lower "bitjob" ;
    gc:capitalized "Bitjob" ;
    gc:pascal "Bitjob" ;
    gc:camel "bitjob" ;
    gc:snake "bitjob" ;
    gc:upper_snake "BITJOB" ;
    gc:kebab "bitjob" ;
    gc:title "Bitjob" .
