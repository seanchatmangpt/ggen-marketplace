---
to: "src/components/AppHeader.vue"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_bitjob_chrome_ext_shadcn_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}<script setup lang="ts">
import { useLocalStorage } from "@vueuse/core"
const autoRefresh = useLocalStorage<boolean>("{% endraw %}{{ row.lower }}{% raw %}.autoRefresh", true)
const ollamaEnabled = useLocalStorage<boolean>("{% endraw %}{{ row.lower }}{% raw %}.ollamaEnabled", false)
</script>

<template>
  <div class="flex justify-between gap-4 p-2 bg-neutral">
    <RouterLink
      to="/"
      class="flex gap-2 items-center"
    >
      <img
        src="@assets/logo.png"
        alt="logo"
        class="h-8 w-auto"
      />
      <div class="font-semibold text-primary">Vite Vue 3 Chrome Extension</div>
    </RouterLink>
    <div class="flex gap-2 justify-center">
      <label class="text-xs text-gray-600 flex items-center gap-1">
        <input
          v-model="autoRefresh"
          type="checkbox"
        />
        Auto Refresh
      </label>
      <label class="text-xs text-gray-600 flex items-center gap-1">
        Ollama
        <input
          v-model="ollamaEnabled"
          type="checkbox"
        />
      </label>
      <UButton
        to="/common/about"
        icon="ph:question"
        variant="ghost"
      ></UButton>
      <UButton
        to="/options-page"
        icon="ph:gear"
        variant="ghost"
      ></UButton>
      <ThemeSwitch />
    </div>
  </div>
</template>

<style scoped></style>
{% endraw %}