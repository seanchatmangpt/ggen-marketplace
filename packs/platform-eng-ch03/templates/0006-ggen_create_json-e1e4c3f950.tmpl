---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch03",
  "files_and_dirs": {
    "README.md": true,
    "cert-manager-config.yaml": true,
    "clusterrole-image-reader.yaml": true,
    "constraint-namespace-labels.yaml": true,
    "constraint-resource-limits.yaml": true,
    "demo-app-deployment.yaml": true,
    "ggen-create.json": true,
    "keycloak-realm-config.py": true,
    "load-secrets.sh": true,
    "prometheus-rule-violations.yaml": true,
    "rbac-developer-role.yaml": true,
    "rbac-platform-admin.yaml": true,
    "role-minimal-deployer.yaml": true,
    "rolebinding.yaml": true,
    "security-audit.sh": true,
    "service-account.yaml": true,
    "template-required-labels.yaml": true,
    "template-resource-limits.yaml": true,
    "test-rbac-permissions.py": true,
    "test-write.txt": true
  },
  "templatize_using_name": "{% endraw %}{{ row.capitalized }}{% raw %}",
  "gen_parent_dir": false
}
{% endraw %}