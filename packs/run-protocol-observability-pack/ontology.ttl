@prefix rpo: <https://chatman.ai/ontology/run-protocol-observability#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rpo:RunProtocolObservabilityPack a dcat:Resource ;
  dct:title "Run Protocol Observability Pack" ;
  odrl:permission [ odrl:action odrl:read ] ;
  rpo:authority "OBSERVE|VERIFY|CONSTRUCT" ;
  rpo:consequentialDo "BRCE_ONLY" .

rpo:Run a rpo:RunClass .
rpo:Request a rpo:RequestClass .
rpo:Receipt a rpo:ReceiptClass .
rpo:MemoryOperation a rpo:OperationClass .
rpo:RepositoryMutation a rpo:OperationClass .
rpo:Qualification a rpo:OperationClass .
rpo:Merge a rpo:OperationClass .
rpo:Opportunity a rpo:OpportunityClass .
rpo:Failure a rpo:FailureClass .

rpo:requestId a rdf:Property .
rpo:operation a rdf:Property .
rpo:standing a rdf:Property .
rpo:phase a rdf:Property .
rpo:key a rdf:Property .
rpo:exactHead a rdf:Property .
rpo:exactBase a rdf:Property .
rpo:transportHead a rdf:Property .
rpo:projectId a rdf:Property .
rpo:itemCount a rdf:Property .
rpo:startedAt a rdf:Property .
rpo:endedAt a rdf:Property .
rpo:observedAt a rdf:Property .
rpo:receiptLatencySeconds a dqv:Metric .
rpo:hasReceipt a rdf:Property .
rpo:forRequest a rdf:Property .
rpo:consumedMemoryKey a rdf:Property .
rpo:qualifiedHead a rdf:Property .
rpo:mergedHead a rdf:Property .
rpo:containsHead a rdf:Property .
rpo:failureType a rdf:Property .
rpo:repairHypothesis a rdf:Property .
rpo:retryChangedHypothesis a rdf:Property .
rpo:frontierSize a dqv:Metric .
rpo:eMultiplier a dqv:Metric .
rpo:mMultiplier a dqv:Metric .
rpo:weakestMultiplier a dqv:Metric .
rpo:observedMultiplier a dqv:Metric .
rpo:inferredMultiplier a dqv:Metric .
rpo:actionableHandoff a rdf:Property .
rpo:actuationPerformed a rdf:Property .
rpo:jsonValid a dqv:Metric .
rpo:current a dqv:Metric .
rpo:required a rdf:Property .
rpo:completed a rdf:Property .
rpo:archived a rdf:Property .
rpo:contradicted a rdf:Property .
rpo:provenanceBound a rdf:Property .
rpo:changedProject a rdf:Property .
rpo:changedFrontier a rdf:Property .
rpo:changedRepository a rdf:Property .
rpo:changedQualificationHead a rdf:Property .
