PREFIX rpo: <https://chatman.ai/ontology/run-protocol-observability#>
SELECT ?run WHERE { ?run a rpo:Run ; rpo:standing "RUNNING" ; rpo:projectId ?project ; rpo:itemCount ?items ; rpo:frontierSize ?frontier ; rpo:weakestMultiplier ?weakest ; rpo:transportHead ?transport . FILTER NOT EXISTS { ?request a rpo:Request ; rpo:jsonValid false } }