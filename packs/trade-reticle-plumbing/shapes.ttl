@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tr: <urn:trade:reticle:plumbing:> .

# SHACL shapes over the claim corpus, complementing the SPARQL gates.
# Gates refuse (rows = violation); shapes declare the structural contract.

tr:ClaimShape a sh:NodeShape ;
    sh:targetClass tr:DiagnosticTree ;
    sh:property [
        sh:path tr:claimType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[a-z_]+$" ;
    ] ;
    sh:property [
        sh:path tr:requiredTelemetry ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

tr:PipeMaterialPriorShape a sh:NodeShape ;
    sh:targetClass tr:PipeMaterialPrior ;
    sh:property [
        sh:path tr:pipeMaterial ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path tr:typicalLifetimeYears ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "1.0"^^xsd:decimal ;
        sh:maxInclusive "150.0"^^xsd:decimal ;
    ] .

tr:CostBaselineShape a sh:NodeShape ;
    sh:targetClass tr:CostBaseline ;
    sh:property [
        sh:path tr:costMinUsd ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "0.0"^^xsd:decimal ;
    ] ;
    sh:property [
        sh:path tr:costMaxUsd ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

tr:RefusalShape a sh:NodeShape ;
    sh:targetClass tr:Refusal ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:pattern "^Refused" ;
    ] .
