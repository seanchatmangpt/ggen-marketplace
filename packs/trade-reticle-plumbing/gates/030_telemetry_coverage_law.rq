# Any row = violation. THE LAW: a claim instance may only assert telemetry
# fields its claim type requires; and every claim instance providing telemetry
# must cover ALL of its claim type's required fields (no partial provision on
# a record that stands). Vacuity falsifier: verify.py deletes one provided
# telemetry field from the positive control and PROVES this gate flips.
PREFIX tr: <urn:trade:reticle:plumbing:>
SELECT ?claim ?missing
WHERE {
  ?claim tr:providedTelemetry ?provided .
  ?claim tr:claimType ?ct .
  ?table a tr:DiagnosticTree ;
         tr:claimType ?ct ;
         tr:requiredTelemetry ?req .
  FILTER NOT EXISTS {
    ?claim tr:providedTelemetry ?req .
  }
  BIND(?req AS ?missing)
}
