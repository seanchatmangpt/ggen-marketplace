<http://seanchatmangpt.github.io/packs/toolchain-unify-pack#choice-2026-10-01>
    a tu:ToolchainChoice ;
    dcterms:date "2026-10-01"^^xsd:date ;
    dcterms:title "BEAM toolchain unification 2026-10-01" ;
    tu:elixirVersion "1.20.4-otp-29" ;
    tu:elixirPlain "1.20.4" ;
    tu:otpVersion "29.1.1" ;
    tu:source "asdf list all elixir/erlang (stable, non-RC); both already installed locally via asdf and verified runnable" ;
    tu:note "Ambient local VM is Elixir 1.19.5 / OTP 28.3; choice is strictly newer, non-RC, verified via asdf exec elixir --version." .

# Per-repo adoption evidence observed 2026-10-01 (evidence, not actuation).

