---
to: "toolchain-ci-matrix-snippet.yml"
for_each: "choice"
sparql:
  choice: |
    PREFIX tu: <http://seanchatmangpt.github.io/packs/toolchain-unify-pack#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?elixir_plain ?otp_version WHERE {
      ?choice a tu:ToolchainChoice ;
        dcterms:date ?date ;
        tu:elixirPlain ?elixir_plain ;
        tu:otpVersion ?otp_version .
    }
    ORDER BY DESC(?date)
    LIMIT 1
---
# GENERATED CI matrix snippet (toolchain-unify-pack/templates/ci_matrix_snippet.yml.tmpl). Do not edit.
# Reference only: consumer repos adopt it manually; the pack never edits consumer workflows.
      - uses: erlef/setup-beam@54075bcc5e249e4758d363f27d099f55d843f124 # v1
        with:
          otp-version: '{{ otp_version }}'
          elixir-version: '{{ elixir_plain }}'
          version-type: strict
