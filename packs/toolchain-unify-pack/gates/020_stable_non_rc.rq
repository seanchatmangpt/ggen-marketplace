# MESSAGE: chosen toolchain is an RC/dev/main build, or elixir/otp versions missing
PREFIX tu: <http://seanchatmangpt.github.io/packs/toolchain-unify-pack#>
SELECT ?subject ?value WHERE {
  ?choice a tu:ToolchainChoice ;
          tu:elixirVersion ?value .
  FILTER(REGEX(STR(?value), "(?i)(rc|dev|main|master)"))
}
