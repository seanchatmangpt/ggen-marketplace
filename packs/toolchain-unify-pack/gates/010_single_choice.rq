# MESSAGE: more than one tu:ToolchainChoice exists -- ambiguity in the version source of truth
PREFIX tu: <http://seanchatmangpt.github.io/packs/toolchain-unify-pack#>
SELECT ?choice WHERE {
  ?choice a tu:ToolchainChoice .
  FILTER(?choice != <http://seanchatmangpt.github.io/packs/toolchain-unify-pack#choice-2026-10-01>)
}
