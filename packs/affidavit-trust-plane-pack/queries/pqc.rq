# pqc.rq — consumed by templates/crypto_trust_pqc.rs.tmpl (affidavit-trust-plane-pack)
#
# Single-row aggregate rule; single-file module -> single-row projection.
# Projected columns (MUST equal crypto_trust_pqc.rs.tmpl's {{ }} vars):
#   mldsa_spec    - specRef of the ML-DSA parameter set ("FIPS 204")
#   slh_spec      - specRef of the SLH-DSA parameter set ("FIPS 205")
#   hybrid_spec   - specRef of the hybrid parameter set
#                   ("draft-ietf-lamps-pq-composite-sig")
#   pk_len        - ML-DSA-65 public key length in bytes (ctp:publicKeyLength,
#                   1952 = FIPS 204)
#   sig_len       - ML-DSA-65 signature length in bytes (ctp:signatureLength,
#                   3309 = FIPS 204)
#   seed_len      - ML-DSA-65 seed length in bytes (ctp:seedLength, 32)
#   slh_seed_len  - SLH-DSA-SHA2-128s seed length in bytes (ctp:seedLength, 48
#                   = sk_seed || sk_prf || pk_seed, 3 x n with n = 16)
#   domain_tag    - trust-plane policy domain tag (ctp:policy-v1
#                   ctp:domainTag), e.g. "affidavit.crypto-trust-plane.v1"
#
# Algorithms are bound by their PARAMETER-SET specRef VALUE (not by class IRI
# or algorithm name), so the query survives lane-side renames of the alg-*
# individuals as long as the pinned specRef contract holds. Each specRef value
# matches exactly one admitted algorithm, and exactly one subject carries
# ctp:domainTag, so the cross-product is exactly one row; ORDER BY + LIMIT 1
# (pack strict mode) keeps the projection deterministic if the graph ever
# grows a duplicate. A missing fact (no publicKeyLength/signatureLength/
# seedLength on the FIPS 204 algorithm, no FIPS 205 seedLength, no domain
# tag) fails loudly with ZERO rows rather than rendering an empty module.

PREFIX ctp: <https://ggen.dev/ontology/affidavit-trust-plane#>

SELECT ?mldsa_spec ?slh_spec ?hybrid_spec ?pk_len ?sig_len ?seed_len ?slh_seed_len ?domain_tag
WHERE {
  # ML-DSA-65: the algorithm whose parameter set cites FIPS 204.
  ?alg_mldsa ctp:parameterSet ?ps_mldsa .
  ?ps_mldsa ctp:specRef ?mldsa_spec_raw .
  FILTER(STR(?mldsa_spec_raw) = "FIPS 204")
  ?alg_mldsa ctp:publicKeyLength  ?pk_len_raw ;
             ctp:signatureLength  ?sig_len_raw ;
             ctp:seedLength       ?seed_len_raw .

  # SLH-DSA-SHA2-128s: the algorithm whose parameter set cites FIPS 205.
  ?alg_slh ctp:parameterSet ?ps_slh .
  ?ps_slh ctp:specRef ?slh_spec_raw .
  FILTER(STR(?slh_spec_raw) = "FIPS 205")
  ?alg_slh ctp:seedLength ?slh_seed_len_raw .

  # Hybrid ES256+ML-DSA-65: the algorithm whose parameter set cites the
  # LAMPS composite-signature draft.
  ?alg_hybrid ctp:parameterSet ?ps_hybrid .
  ?ps_hybrid ctp:specRef ?hybrid_spec_raw .
  FILTER(STR(?hybrid_spec_raw) = "draft-ietf-lamps-pq-composite-sig")

  # Trust-plane policy domain tag (pinned predicate, canonical.rq precedent).
  ?policy ctp:domainTag ?domain_tag_raw .

  BIND(STR(?mldsa_spec_raw) AS ?mldsa_spec)
  BIND(STR(?slh_spec_raw) AS ?slh_spec)
  BIND(STR(?hybrid_spec_raw) AS ?hybrid_spec)
  BIND(STR(?pk_len_raw) AS ?pk_len)
  BIND(STR(?sig_len_raw) AS ?sig_len)
  BIND(STR(?seed_len_raw) AS ?seed_len)
  BIND(STR(?slh_seed_len_raw) AS ?slh_seed_len)
  BIND(STR(?domain_tag_raw) AS ?domain_tag)
}
ORDER BY ?domain_tag
LIMIT 1
