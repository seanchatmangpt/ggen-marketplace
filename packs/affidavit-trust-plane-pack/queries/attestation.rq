# attestation.rq — consumed by templates/crypto_trust_attestation.rs.tmpl (affidavit-trust-plane-pack)
#
# Single-row projection (single-file module -> single row).
# Projected columns (MUST equal crypto_trust_attestation.rs.tmpl's {{ }} vars):
#   attestation_format - wire format identifier stamped in every rendered
#                        attestation record (ctp:attest-v1
#                        ctp:attestationFormat), e.g. "CTP-ATTEST-v1"
#   domain_tag         - trust-plane policy domain tag (ctp:policy-v1
#                        ctp:domainTag), e.g. "affidavit.crypto-trust-plane.v1"
#
# Binding is by pinned PREDICATE (ctp:attestationFormat, ctp:domainTag), not
# class IRI, per the keys.rq rule, so the query survives lane-side class
# renames as long as the contract predicates are used. Each pattern matches
# exactly one policy individual, so the join is exactly one row; a missing
# graph fact fails loudly with zero rows rather than rendering an empty
# module. SELECT projection: no ORDER BY required (pack strict mode binds
# CONSTRUCT/ASK only).

PREFIX ctp: <https://ggen.dev/ontology/affidavit-trust-plane#>

SELECT ?attestation_format ?domain_tag
WHERE {
  ?attestPolicy ctp:attestationFormat ?formatRaw .
  BIND(STR(?formatRaw) AS ?attestation_format)

  ?trustPolicy ctp:domainTag ?tagRaw .
  BIND(STR(?tagRaw) AS ?domain_tag)
}
