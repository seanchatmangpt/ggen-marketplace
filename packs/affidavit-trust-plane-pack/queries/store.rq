# store.rq — consumed by templates/crypto_trust_store.rs.tmpl (affidavit-trust-plane-pack)
#
# Single-row rule; single-file module -> single-row projection.
# Projected columns (MUST equal crypto_trust_store.rs.tmpl's {{ }} vars):
#   domain_tag   - trust-plane policy domain tag (ctp:policy-v1 ctp:domainTag),
#                  mixed into the store checksum digest; conformance-tested
#                  equal to crypto_trust_keys::DOMAIN_TAG at render time.
#   digest_alg   - digest algorithm over the domain-separated checksum
#                  pre-image (ctp:canon-JCS ctp:digestAlgorithm), e.g. "BLAKE3".
#   store_format - store format/version identity stamped in the file
#                  (ctp:store-v1 ctp:storeFormat); load refuses any other
#                  value (typed WrongFormat refusal). Doubles as the store
#                  version: the value IS the format identity ("CTP-STORE-v1").
#   store_file   - store file location (ctp:store-v1 ctp:storeFile),
#                  e.g. ".affi/keys.json".
#
# Binding is by pinned PREDICATE, not class IRI, so the query survives
# lane-side class renames as long as the contract predicates are used:
#   domain_tag:   subjects carrying ctp:domainTag
#   digest_alg:   subjects carrying ctp:digestAlgorithm
#   store_format: subjects carrying ctp:storeFormat
#   store_file:   subjects carrying ctp:storeFile
# Each binding is single-valued over the graph, so the join is exactly one
# row; a missing storeFormat/storeFile fact fails loudly with zero rows
# rather than rendering a module with an empty format identity.

PREFIX ctp: <https://ggen.dev/ontology/affidavit-trust-plane#>

SELECT
  ?domain_tag
  ?digest_alg
  ?store_format
  ?store_file
WHERE {
  ?policy ctp:domainTag ?domainTagRaw .
  BIND(STR(?domainTagRaw) AS ?domain_tag)

  ?canon ctp:digestAlgorithm ?digestAlgRaw .
  BIND(STR(?digestAlgRaw) AS ?digest_alg)

  ?store ctp:storeFormat ?storeFormatRaw ;
         ctp:storeFile ?storeFileRaw .
  BIND(STR(?storeFormatRaw) AS ?store_format)
  BIND(STR(?storeFileRaw) AS ?store_file)
}
ORDER BY ?store_format
