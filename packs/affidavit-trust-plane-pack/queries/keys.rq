# keys.rq — consumed by templates/crypto_trust_keys.rs.tmpl (affidavit-trust-plane-pack)
#
# Single-row aggregate rule; single-file module -> single-row projection.
# Projected columns (MUST equal crypto_trust_keys.rs.tmpl's {{ }} vars):
#   domain_tag - trust-plane policy domain tag (ctp:policy-v1 ctp:domainTag),
#                e.g. "affidavit.crypto-trust-plane.v1"
#   algs       - GROUP_CONCAT of per-algorithm specs, one alg per "@@" group,
#                fields within a group separated by "|":
#                  rustVariant | algorithmName | publicKeyLength
#                e.g. "Es256|ES256|65@@MlDsa65|ML-DSA-65|1952"
#                Ordered by ctp:algorithmName (ordered sub-SELECT feeding the
#                aggregate). An algorithm with NO ctp:publicKeyLength triple
#                projects as 0 (= variable/undeclared fixed length); the
#                template renders Option<usize> = None for those. The length
#                is OPTIONAL so an algorithm can never be silently pruned
#                from the enum for omitting one optional fact.
#   origins    - GROUP_CONCAT of key-origin rustVariants ("@@"-separated):
#                Generated | Imported | HardwareAttested
#   providers  - GROUP_CONCAT of per-provider specs, "@@"-separated:
#                  rustVariant | providerKind | keyMaterialExportable
#                e.g. "Software|SOFTWARE|true"
#
# Binding is by pinned PREDICATE, not class IRI, so the query survives lane-side
# class renames as long as the contract predicates are used:
#   algorithms: subjects carrying ctp:algorithmName
#   origins:    subjects carrying ctp:rustVariant with a contract origin value
#   providers:  subjects carrying ctp:providerKind
# Each aggregate sub-SELECT yields exactly one row (GROUP_CONCAT over no
# matches yields ""), so the outer join is single-row; a missing policy tag
# fails loudly with zero rows rather than rendering an empty module.

PREFIX ctp: <https://ggen.dev/ontology/affidavit-trust-plane#>

SELECT
  ?domain_tag
  ?algs
  ?origins
  ?providers
WHERE {
  ?policy ctp:domainTag ?policyTagRaw .
  BIND(STR(?policyTagRaw) AS ?domain_tag)

  {
    SELECT (GROUP_CONCAT(?spec ; separator="@@") AS ?algs)
    WHERE {
      {
        SELECT ?spec
        WHERE {
          ?alg ctp:algorithmName ?name ;
               ctp:rustVariant ?variant .
          OPTIONAL { ?alg ctp:publicKeyLength ?declaredLen . }
          BIND(COALESCE(STR(?declaredLen), "0") AS ?pklen)
          BIND(CONCAT(STR(?variant), "|", STR(?name), "|", ?pklen) AS ?spec)
        }
        ORDER BY ?name
      }
    }
  }

  {
    SELECT (GROUP_CONCAT(?originVariant ; separator="@@") AS ?origins)
    WHERE {
      {
        SELECT ?originVariant
        WHERE {
          ?origin ctp:rustVariant ?originVariant .
          FILTER(STR(?originVariant) IN ("Generated", "Imported", "HardwareAttested"))
        }
        ORDER BY ?originVariant
      }
    }
  }

  {
    SELECT (GROUP_CONCAT(?provSpec ; separator="@@") AS ?providers)
    WHERE {
      {
        SELECT ?provSpec
        WHERE {
          ?provider ctp:providerKind ?kind ;
                    ctp:rustVariant ?provVariant ;
                    ctp:keyMaterialExportable ?exportable .
          BIND(CONCAT(STR(?provVariant), "|", STR(?kind), "|", STR(?exportable)) AS ?provSpec)
        }
        ORDER BY ?provSpec
      }
    }
  }
}
