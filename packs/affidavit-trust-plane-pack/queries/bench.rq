# bench.rq — consumed by templates/crypto_trust_bench.rs.tmpl (affidavit-trust-plane-pack)
#
# Single-row aggregate rule; the bench is one file -> single-row projection.
# Projected columns (MUST equal crypto_trust_bench.rs.tmpl's {{ }} vars):
#   domain_tag       - trust-plane policy domain tag (ctp:policy-v1
#                      ctp:domainTag). Rendered into the bench's graph-fact
#                      teeth module and held equal to
#                      crypto_trust_canonical::DOMAIN_TAG.
#   envelope_version - signed-envelope version (ctp:policy-v1
#                      ctp:envelopeVersion). Rendered as a top-level const and
#                      used as the benched envelope's version field, then held
#                      equal to crypto_trust_envelope::ENVELOPE_VERSION.
#   canon_name       - canonicalization identity (ctp:canon-JCS
#                      ctp:canonicalizationName, "JCS-RFC8785"). Held equal to
#                      crypto_trust_canonical::CANONICALIZATION.
#   digest_alg       - digest algorithm over domain-separated bytes
#                      (ctp:canon-JCS ctp:digestAlgorithm, "BLAKE3"). Held
#                      equal to crypto_trust_canonical::DIGEST_ALGORITHM.
#   algs             - GROUP_CONCAT of the admitted signature algorithms, one
#                      "@@" group per algorithm, "name|rustVariant" within a
#                      group, ordered by ctp:algorithmName (kat.rq precedent).
#                      The bench must cover every admitted algorithm; the
#                      registry test refuses a render that does not.
#
# The ordered sub-SELECT feeds the aggregate (rotation.rq/envelope.rq
# precedent) so the GROUP_CONCAT fold is deterministic. Any missing policy or
# canonicalization fact yields zero rows — the engine refuses, defaults never
# render.

PREFIX ctp: <https://ggen.dev/ontology/affidavit-trust-plane#>

SELECT
  ?domain_tag
  ?envelope_version
  ?canon_name
  ?digest_alg
  ?algs
WHERE {
  ?policy ctp:domainTag       ?domainTagRaw ;
          ctp:envelopeVersion ?envelopeVersionRaw ;
          ctp:canonicalization ?canon .
  ?canon ctp:canonicalizationName ?canonNameRaw ;
         ctp:digestAlgorithm      ?digestAlgRaw .
  BIND(STR(?domainTagRaw) AS ?domain_tag)
  BIND(STR(?envelopeVersionRaw) AS ?envelope_version)
  BIND(STR(?canonNameRaw) AS ?canon_name)
  BIND(STR(?digestAlgRaw) AS ?digest_alg)

  {
    SELECT (GROUP_CONCAT(?spec ; separator="@@") AS ?algs)
    WHERE {
      {
        SELECT ?spec
        WHERE {
          ?alg ctp:algorithmName ?name ;
               ctp:rustVariant  ?variant .
          BIND(CONCAT(STR(?name), "|", STR(?variant)) AS ?spec)
        }
        ORDER BY ?name
      }
    }
  }
}
ORDER BY ?domain_tag
LIMIT 1
