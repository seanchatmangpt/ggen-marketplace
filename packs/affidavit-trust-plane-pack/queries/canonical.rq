# canonical.rq — single-row binding for the canonical serialization module
# (crypto_trust_canonical.rs). Binds the trust plane policy's domain tag and
# envelope version from ctp:policy-v1, and the canonicalization name + digest
# algorithm from its ctp:Canonicalization individual (ctp:canon-JCS).
# Columns are consumed by ggen sync as plain Tera variables:
#   {{ domain_tag }} {{ canon_name }} {{ digest_alg }} {{ envelope_version }}
PREFIX ctp: <https://ggen.dev/ontology/affidavit-trust-plane#>

SELECT ?domain_tag ?canon_name ?digest_alg ?envelope_version
WHERE {
  ctp:policy-v1
      ctp:domainTag         ?domain_tag ;
      ctp:envelopeVersion   ?envelope_version ;
      ctp:canonicalization  ?canon .
  ?canon
      ctp:canonicalizationName  ?canon_name ;
      ctp:digestAlgorithm       ?digest_alg .
}
ORDER BY ?domain_tag
LIMIT 1
