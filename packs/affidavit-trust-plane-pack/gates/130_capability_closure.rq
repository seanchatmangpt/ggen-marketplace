# MESSAGE: Capability closure over signing providers. Every ctp:SigningProvider
# individual must be CLASSIFIED: it carries ctp:admitted with a boolean — true
# (an admitted provider) or false (typed UNSUPPORTED; consuming code must
# refuse, never fake). An unclassified provider is an orphan capability: the
# graph grew a provider without deciding its admission standing, so downstream
# consumers cannot route to it lawfully. This keeps the provider set closed as
# the pack grows (wave-4 W4-L10).
PREFIX ctp: <https://ggen.dev/ontology/affidavit-trust-plane#>
SELECT ?provider ?problem WHERE {
  ?provider a ctp:SigningProvider .
  OPTIONAL { ?provider ctp:admitted ?admitted }
  FILTER(!BOUND(?admitted))
  BIND("unclassified_provider_missing_ctp:admitted_true_or_false" AS ?problem)
}
ORDER BY ?provider ?problem
