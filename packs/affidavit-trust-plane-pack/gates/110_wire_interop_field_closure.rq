# MESSAGE: SA2A wire closure. Every ctp:SignatureEnvelopeField that declares a
# ctp:wireFieldName (its RFC-SA2A-007-errata counterpart name) must appear inside
# ctp:sa2a-interop-v1 ctp:targetFieldSet. Fields without a wireFieldName are
# local-only by law (see ontology note); targetFieldSet may carry SA2A-only extras.
# A mapped field missing from the wire set is a broken interlock.
PREFIX ctp: <https://ggen.dev/ontology/affidavit-trust-plane#>
SELECT ?field ?wireName ?problem WHERE {
  ?interop a ctp:WireInterop ; ctp:targetFieldSet ?set .
  ?field a ctp:SignatureEnvelopeField ; ctp:wireFieldName ?wireName .
  FILTER(!CONTAINS(?set, ?wireName))
  BIND("mapped_field_missing_from_wire_set" AS ?problem)
}
ORDER BY ?field ?problem
