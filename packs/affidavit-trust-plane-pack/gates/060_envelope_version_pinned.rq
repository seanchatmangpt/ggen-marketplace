# MESSAGE: the envelope wire format is pinned: exactly one ctp:TrustPlanePolicy carries ctp:envelopeVersion "CTP-ENVELOPE-v1". Zero policies (unpinned plane) or more than one (forked wire format) is refused.
PREFIX ctp: <https://ggen.dev/ontology/affidavit-trust-plane#>
SELECT ?problem ?detail WHERE {
  { SELECT (COUNT(?p) AS ?n) WHERE { ?p a ctp:TrustPlanePolicy ; ctp:envelopeVersion "CTP-ENVELOPE-v1" } }
  FILTER(?n != 1)
  BIND("envelope_version_not_pinned_to_exactly_one_policy" AS ?problem)
  BIND(CONCAT("policies_with_CTP-ENVELOPE-v1=", STR(?n)) AS ?detail)
}
ORDER BY ?detail
