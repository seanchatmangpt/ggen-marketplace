{
  "affidavit": "build-provenance",
  "version": "CTP-BUILD-PROVENANCE-v1",
  "subject": {
    "name": "{{ image_name }}",
    "digest": { "sha256": "{{ image_sha256 }}" }
  },
  "statement": {
    "predicateType": "{{ predicate_type }}",
    "digest": { "sha256": "{{ statement_sha256 }}" }
  },
  "binding": "sha256:{{ image_sha256 }}<-sha256:{{ statement_sha256 }}"
}
