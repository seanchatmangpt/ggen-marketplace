@prefix pack: <urn:ggen-marketplace:kgc-4d-playground-shadcn-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:Project a pack:SourceProject ;
    rdfs:label "kgc-4d-playground" ;
    pack:sourcePath "/Users/sac/unrdf/packages/kgc-4d-playground"^^xsd:string ;
    pack:framework "Next.js 16 (React 19.2.1)" ;
    pack:packageManager "pnpm workspace (workspace:* deps on @unrdf/*)" ;
    rdfs:comment "Private (\"private\": true) internal playground app, package name @unrdf/kgc-4d-playground, version 26.6.12, scanned directly from package.json and directory listing." .

pack:ShadcnUsage a pack:TechnologyFinding ;
    rdfs:label "shadcn/ui" ;
    pack:status "confirmed-real" ;
    rdfs:comment "components.json present at project root with style=new-york, baseColor=slate, cssVariables=true, aliases components=@/components and utils=@/lib/utils. Eight shadcn primitive files exist under components/ui/ and each imports cn() from @/lib/utils, and 13 real files under app/ and components/use-cases/ import from components/ui. class-variance-authority and @radix-ui/* are NOT in package.json and not imported anywhere in source, so these primitives are a hand-rolled shadcn-style variant, not the canonical CVA/Radix implementation." .

pack:ButtonComponent a pack:ShadcnComponentFile ;
    rdfs:label "button" ;
    pack:relativePath "components/ui/button.jsx" ;
    rdfs:comment "Uses cn() from @/lib/utils; variant/size prop maps (default, destructive, outline, secondary, ghost, link)." .

pack:CardComponent a pack:ShadcnComponentFile ;
    rdfs:label "card" ;
    pack:relativePath "components/ui/card.jsx" .

pack:BadgeComponent a pack:ShadcnComponentFile ;
    rdfs:label "badge" ;
    pack:relativePath "components/ui/badge.jsx" .

pack:AlertComponent a pack:ShadcnComponentFile ;
    rdfs:label "alert" ;
    pack:relativePath "components/ui/alert.jsx" .

pack:InputComponent a pack:ShadcnComponentFile ;
    rdfs:label "input" ;
    pack:relativePath "components/ui/input.jsx" .

pack:SelectComponent a pack:ShadcnComponentFile ;
    rdfs:label "select" ;
    pack:relativePath "components/ui/select.jsx" .

pack:SeparatorComponent a pack:ShadcnComponentFile ;
    rdfs:label "separator" ;
    pack:relativePath "components/ui/separator.jsx" .

pack:TabsComponent a pack:ShadcnComponentFile ;
    rdfs:label "tabs" ;
    pack:relativePath "components/ui/tabs.jsx" .

pack:DeckGlUsage a pack:TechnologyFinding ;
    rdfs:label "deck.gl" ;
    pack:status "absent" ;
    rdfs:comment "No deck.gl or @deck.gl/* package appears in package.json dependencies or devDependencies, and no source file references DeckGL, ScatterplotLayer, GeoJsonLayer, HexagonLayer, ArcLayer, or any deck.gl viewport/view-state API. This is a plain absence, not an unused listed dependency: deck.gl is not referenced anywhere in this project." .

pack:ForceGraph3DUsage a pack:TechnologyFinding ;
    rdfs:label "react-force-graph-3d" ;
    pack:status "confirmed-real" ;
    pack:relativePath "components/visualizations" ;
    rdfs:comment "react-force-graph-3d (^1.29.0) is listed as a real dependency and is the project's actual 3D graph visualization technology, used in place of deck.gl." .

pack:XyflowUsage a pack:TechnologyFinding ;
    rdfs:label "@xyflow/react" ;
    pack:status "confirmed-real" ;
    rdfs:comment "@xyflow/react (^12.10.0) is listed as a real dependency, providing node/edge flow-graph layout used alongside react-force-graph-3d." .
@prefix gc: <https://ggen.io/ontology/ggen-create#> .

gc:gc_subject_kgc_4d_playground_shadcn_pack a gc:GenerationSubject ;
    gc:name "Button" ;
    gc:upper "BUTTON" ;
    gc:lower "button" ;
    gc:capitalized "Button" ;
    gc:pascal "Button" ;
    gc:camel "button" ;
    gc:snake "button" ;
    gc:upper_snake "BUTTON" ;
    gc:kebab "button" ;
    gc:title "Button" .
