PREFIX fd: <https://ggen.dev/ontology/frontier-derivative#>
SELECT DISTINCT ?candidate WHERE { ?candidate a fd:Candidate ; fd:standing "ALIVE" ; fd:authority "SELECT" ; fd:reversible true . FILTER NOT EXISTS { ?candidate fd:unlocks ?target . FILTER NOT EXISTS { ?target a fd:Candidate ; fd:standing "ALIVE" ; fd:authority "SELECT" ; fd:reversible true } } FILTER NOT EXISTS { ?candidate fd:requires ?dependency . FILTER NOT EXISTS { ?dependency a fd:Candidate ; fd:standing "ALIVE" ; fd:authority "SELECT" ; fd:reversible true } } }
