---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch13",
  "files_and_dirs": {
    "README.md": true,
    "backup-automation.py": true,
    "backup-config-annotation.yaml": true,
    "backup-self-service.yaml": true,
    "chaos-experiment-network.yaml": true,
    "chaos-experiment-pod-kill.yaml": true,
    "chaos-mesh-pod-failure.yaml": true,
    "chaos-network-delay.yaml": true,
    "chaos-runner.py": true,
    "chaos-workflow.yaml": true,
    "disaster-recovery-plan.py": true,
    "generate-slo-rules.sh": true,
    "ggen-create.json": true,
    "platform-backup-config/values.yaml": true,
    "prometheus-slo-rules.yaml": true,
    "restore-validation.sh": true,
    "slo-dashboard.json": true,
    "slo-definitions.yaml": true,
    "sloth-auth-service-slo.yaml": true,
    "sloth-slo-spec.yaml": true,
    "test-resilience.py": true,
    "velero-dr-commands.sh": true,
    "velero-schedule.yaml": true,
    "velero-storage-location.yaml": true
  },
  "templatize_using_name": "{% endraw %}{{ row.capitalized }}{% raw %}",
  "gen_parent_dir": false
}
{% endraw %}