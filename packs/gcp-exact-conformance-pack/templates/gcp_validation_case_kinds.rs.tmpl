---
to: "src/gcp_validation_case_kinds.rs"
sparql:
  cases: |
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX gcp: <urn:ggen:pack:gcp-exact:>
    SELECT ?id ?label
    WHERE {
      ?case a skos:Concept ;
            skos:inScheme gcp:validation-case-kinds ;
            dcterms:identifier ?id ;
            skos:prefLabel ?label .
    }
    ORDER BY ?id
---
//! GENERATED from the admitted GCP validation-case graph. Do not edit.
//!
//! A case kind is a falsifier dimension, not evidence that a concrete
//! method×case has executed. Runtime standing still requires paired receipts.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ValidationCaseKind {
    pub id: &'static str,
    pub label: &'static str,
}

pub const VALIDATION_CASE_KINDS: &[ValidationCaseKind] = &[
{% for row in cases -%}
    ValidationCaseKind { id: "{{ row.id }}", label: "{{ row.label }}" },
{% endfor -%}
];

pub const REQUIRED_VALIDATION_CASE_KIND_COUNT: usize = 15;
pub const CATALOG_PRESENCE_ESTABLISHES_CASE_EXECUTION: bool = false;

pub fn validation_case_calculus_complete() -> bool {
    VALIDATION_CASE_KINDS.len() == REQUIRED_VALIDATION_CASE_KIND_COUNT
        && VALIDATION_CASE_KINDS.iter().any(|case| case.id == "EXACT_REPLAY")
}
