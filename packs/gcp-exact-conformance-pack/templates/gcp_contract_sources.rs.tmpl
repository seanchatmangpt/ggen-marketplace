---
to: "src/gcp_contract_sources.rs"
sparql:
  sources: |
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX gcp: <urn:ggen:pack:gcp-exact:>
    SELECT ?id ?label
    WHERE {
      ?source a skos:Concept ;
              skos:inScheme gcp:contract-sources ;
              skos:prefLabel ?label .
      BIND(STRAFTER(STR(?source), "urn:ggen:pack:gcp-exact:") AS ?id)
    }
    ORDER BY ?id
---
//! GENERATED from the admitted GCP exact-conformance semantic graph. Do not edit.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ContractSource {
    pub id: &'static str,
    pub label: &'static str,
}

pub const CONTRACT_SOURCES: &[ContractSource] = &[
{% for row in sources -%}
    ContractSource { id: "{{ row.id }}", label: "{{ row.label }}" },
{% endfor -%}
];

pub const REQUIRED_SOURCE_COUNT: usize = 10;

pub fn source_census_complete() -> bool {
    CONTRACT_SOURCES.len() == REQUIRED_SOURCE_COUNT
}
