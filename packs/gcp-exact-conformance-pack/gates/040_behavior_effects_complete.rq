# MESSAGE: GCP simulator behavior calculus is incomplete; all generic control-plane effect families plus CUSTOM must remain represented.
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gcp: <urn:ggen:pack:gcp-exact:>
SELECT ?required WHERE {
  VALUES ?required {
    "READ_ONE" "READ_MANY" "CREATE" "REPLACE" "PATCH" "DELETE"
    "IAM_GET" "IAM_SET" "IAM_TEST"
    "SERVICE_ENABLE" "SERVICE_DISABLE"
    "OPERATION_GET" "OPERATION_LIST" "OPERATION_CANCEL" "OPERATION_DELETE" "OPERATION_WAIT"
    "CUSTOM"
  }
  FILTER NOT EXISTS {
    ?effect a skos:Concept ;
            skos:inScheme gcp:behavior-effects ;
            dcterms:identifier ?required .
  }
}
ORDER BY ?required
