# MESSAGE: GCP exactness source census is incomplete; every admitted public/empirical source family must remain represented.
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gcp: <urn:ggen:pack:gcp-exact:>
SELECT ?required WHERE {
  VALUES ?required {
    gcp:discovery
    gcp:googleapis-proto
    gcp:service-config
    gcp:asset-inventory
    gcp:audit-logs
    gcp:iam
    gcp:quota
    gcp:long-running-operations
    gcp:human-docs
    gcp:empirical-observation
  }
  FILTER NOT EXISTS {
    ?required a skos:Concept ;
              skos:inScheme gcp:contract-sources .
  }
}
ORDER BY ?required
