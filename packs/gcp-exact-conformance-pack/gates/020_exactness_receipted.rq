# MESSAGE: a true GCP exactness measurement without at least two distinct provenance sources is refused; exactness must be manufactured from paired real/simulator receipts.
PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX gcp: <urn:ggen:pack:gcp-exact:>
SELECT ?measurement WHERE {
  ?measurement a dqv:QualityMeasurement ;
               dqv:isMeasurementOf gcp:exactness-metric ;
               dqv:value true .
  FILTER NOT EXISTS {
    ?measurement prov:wasDerivedFrom ?real, ?simulator .
    FILTER (?real != ?simulator)
  }
}
ORDER BY ?measurement
