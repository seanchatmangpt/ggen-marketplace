# MESSAGE: GCP validation-case calculus is incomplete; exactness requires every universal and behavior-specific falsifier kind.
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gcp: <urn:ggen:pack:gcp-exact:>
SELECT ?required WHERE {
  VALUES ?required {
    "HAPPY_PATH" "INVALID_ARGUMENT" "PERMISSION_DENIED" "SERVICE_DISABLED"
    "NOT_FOUND" "ALREADY_EXISTS" "QUOTA_EXHAUSTED" "PAGINATION" "UPDATE_MASK"
    "LRO_SUBMIT" "LRO_POLL" "LRO_CANCEL" "LRO_DELETE" "LRO_WAIT" "EXACT_REPLAY"
  }
  FILTER NOT EXISTS {
    ?case a skos:Concept ;
          skos:inScheme gcp:validation-case-kinds ;
          dcterms:identifier ?required .
  }
}
ORDER BY ?required
