# MESSAGE: this pack is an ABox/profile projection over public vocabularies; custom classes/properties under its URN are refused.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?term ?kind WHERE {
  VALUES ?kind { owl:Class rdfs:Class rdf:Property owl:ObjectProperty owl:DatatypeProperty }
  ?term a ?kind .
  FILTER (STRSTARTS(STR(?term), "urn:ggen:pack:gcp-exact:"))
}
ORDER BY ?term ?kind
