@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gcp: <urn:ggen:pack:gcp-exact:> .

# ABox-only semantic profile. No pack-owned OWL/RDFS classes or properties.

gcp:profile
    a dcat:Dataset ;
    dcterms:title "GCP exact externally observable conformance profile" ;
    dcterms:description "Manufacturing input contract for a complete, fail-closed GymAct GCP differential conformance run." ;
    dcterms:identifier "gcp-exact-conformance-v26.8.19" .

gcp:contract-sources
    a skos:ConceptScheme ;
    dcterms:title "Admitted GCP contract source families" .

gcp:discovery a skos:Concept ; skos:inScheme gcp:contract-sources ; skos:prefLabel "Google Discovery REST contracts" .
gcp:googleapis-proto a skos:Concept ; skos:inScheme gcp:contract-sources ; skos:prefLabel "googleapis proto/RPC contracts" .
gcp:service-config a skos:Concept ; skos:inScheme gcp:contract-sources ; skos:prefLabel "Google Service Config" .
gcp:asset-inventory a skos:Concept ; skos:inScheme gcp:contract-sources ; skos:prefLabel "Cloud Asset Inventory" .
gcp:audit-logs a skos:Concept ; skos:inScheme gcp:contract-sources ; skos:prefLabel "Cloud Audit Logs" .
gcp:iam a skos:Concept ; skos:inScheme gcp:contract-sources ; skos:prefLabel "IAM and policy behavior" .
gcp:quota a skos:Concept ; skos:inScheme gcp:contract-sources ; skos:prefLabel "Quota and limit behavior" .
gcp:long-running-operations a skos:Concept ; skos:inScheme gcp:contract-sources ; skos:prefLabel "Long-running operation semantics" .
gcp:human-docs a skos:Concept ; skos:inScheme gcp:contract-sources ; skos:prefLabel "Published Google Cloud documentation" .
gcp:empirical-observation a skos:Concept ; skos:inScheme gcp:contract-sources ; skos:prefLabel "Receipted empirical observations" .

# The executable semantic calculus projected into GymAct. These are SKOS
# instances, not a pack-owned TBox; ggen manufactures the static catalog while
# GymAct owns execution and receipts.
gcp:behavior-effects
    a skos:ConceptScheme ;
    dcterms:title "GCP contract-driven behavior effects" .

gcp:read-one a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "READ_ONE" ; skos:prefLabel "Read one resource" .
gcp:read-many a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "READ_MANY" ; skos:prefLabel "Read a resource collection" .
gcp:create a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "CREATE" ; skos:prefLabel "Create resource" .
gcp:replace a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "REPLACE" ; skos:prefLabel "Replace resource" .
gcp:patch a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "PATCH" ; skos:prefLabel "Patch resource" .
gcp:delete a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "DELETE" ; skos:prefLabel "Delete resource" .
gcp:iam-get a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "IAM_GET" ; skos:prefLabel "Get IAM policy" .
gcp:iam-set a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "IAM_SET" ; skos:prefLabel "Set IAM policy" .
gcp:iam-test a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "IAM_TEST" ; skos:prefLabel "Test IAM permissions" .
gcp:service-enable a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "SERVICE_ENABLE" ; skos:prefLabel "Enable service" .
gcp:service-disable a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "SERVICE_DISABLE" ; skos:prefLabel "Disable service" .
gcp:operation-get a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "OPERATION_GET" ; skos:prefLabel "Get long-running operation" .
gcp:operation-list a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "OPERATION_LIST" ; skos:prefLabel "List long-running operations" .
gcp:operation-cancel a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "OPERATION_CANCEL" ; skos:prefLabel "Cancel long-running operation" .
gcp:operation-delete a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "OPERATION_DELETE" ; skos:prefLabel "Delete long-running operation" .
gcp:operation-wait a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "OPERATION_WAIT" ; skos:prefLabel "Wait for long-running operation" .
gcp:custom a skos:Concept ; skos:inScheme gcp:behavior-effects ; dcterms:identifier "CUSTOM" ; skos:prefLabel "Custom behavior requiring empirical admission" .

# Every method expands into a behavior-dependent validation topology. The case
# identities are public ABox facts; concrete method×case instances are generated
# at qualification/runtime from the admitted method graph.
gcp:validation-case-kinds
    a skos:ConceptScheme ;
    dcterms:title "GCP exactness validation case kinds" .

gcp:case-happy-path a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "HAPPY_PATH" ; skos:prefLabel "Happy path" .
gcp:case-invalid-argument a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "INVALID_ARGUMENT" ; skos:prefLabel "Invalid argument" .
gcp:case-permission-denied a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "PERMISSION_DENIED" ; skos:prefLabel "Permission denied" .
gcp:case-service-disabled a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "SERVICE_DISABLED" ; skos:prefLabel "Service disabled" .
gcp:case-not-found a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "NOT_FOUND" ; skos:prefLabel "Not found" .
gcp:case-already-exists a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "ALREADY_EXISTS" ; skos:prefLabel "Already exists" .
gcp:case-quota-exhausted a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "QUOTA_EXHAUSTED" ; skos:prefLabel "Quota exhausted" .
gcp:case-pagination a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "PAGINATION" ; skos:prefLabel "Pagination" .
gcp:case-update-mask a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "UPDATE_MASK" ; skos:prefLabel "Update mask" .
gcp:case-lro-submit a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "LRO_SUBMIT" ; skos:prefLabel "Long-running operation submit" .
gcp:case-lro-poll a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "LRO_POLL" ; skos:prefLabel "Long-running operation poll" .
gcp:case-lro-cancel a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "LRO_CANCEL" ; skos:prefLabel "Long-running operation cancel" .
gcp:case-lro-delete a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "LRO_DELETE" ; skos:prefLabel "Long-running operation delete" .
gcp:case-lro-wait a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "LRO_WAIT" ; skos:prefLabel "Long-running operation wait" .
gcp:case-exact-replay a skos:Concept ; skos:inScheme gcp:validation-case-kinds ; dcterms:identifier "EXACT_REPLAY" ; skos:prefLabel "Exact empirical replay" .

gcp:evidence-kinds
    a skos:ConceptScheme ;
    dcterms:title "GCP simulator behavior evidence kinds" .

gcp:discovery-inferred a skos:Concept ; skos:inScheme gcp:evidence-kinds ; skos:prefLabel "DISCOVERY_INFERRED" .
gcp:empirical-replay a skos:Concept ; skos:inScheme gcp:evidence-kinds ; skos:prefLabel "EMPIRICAL_REPLAY" .

gcp:behavior-compiler
    a prov:Plan ;
    dcterms:title "Discovery-to-behavior compiler plan" ;
    dcterms:description "Compile public GCP method shapes into reversible structural behavior rules; custom transitions require empirical evidence." ;
    prov:wasDerivedFrom gcp:profile .

gcp:validation-plan
    a prov:Plan ;
    dcterms:title "Behavior-to-validation-case expansion plan" ;
    dcterms:description "Expand every admitted method into universal and behavior-specific falsifier cases; unique paired equivalent receipts are required for promotion." ;
    prov:wasDerivedFrom gcp:behavior-compiler .

gcp:simulator-runtime
    a prov:SoftwareAgent ;
    dcterms:title "GymAct contract-driven GCP simulator" ;
    dcterms:description "Executes admitted structural rules and exact empirical request/response replays without cloud credentials or network access." .

gcp:structural-simulation
    a prov:Activity ;
    dcterms:title "Structural GCP simulation" ;
    prov:used gcp:profile, gcp:behavior-compiler ;
    prov:wasAssociatedWith gcp:simulator-runtime .

gcp:empirical-replay-activity
    a prov:Activity ;
    dcterms:title "Exact empirical GCP request replay" ;
    prov:used gcp:empirical-observation ;
    prov:wasAssociatedWith gcp:simulator-runtime .

gcp:standing
    a skos:ConceptScheme ;
    dcterms:title "Conformance standing" .

gcp:unknown a skos:Concept ; skos:inScheme gcp:standing ; skos:prefLabel "UNKNOWN" .
gcp:partial-alive a skos:Concept ; skos:inScheme gcp:standing ; skos:prefLabel "PARTIAL_ALIVE" .
gcp:alive a skos:Concept ; skos:inScheme gcp:standing ; skos:prefLabel "ALIVE" .
gcp:blocked a skos:Concept ; skos:inScheme gcp:standing ; skos:prefLabel "BLOCKED" .
gcp:unsupported a skos:Concept ; skos:inScheme gcp:standing ; skos:prefLabel "UNSUPPORTED" .
gcp:refused a skos:Concept ; skos:inScheme gcp:standing ; skos:prefLabel "REFUSED" .

gcp:differential-validation
    a prov:Activity ;
    dcterms:title "Paired real-GCP versus GymAct differential validation" ;
    prov:used gcp:profile, gcp:validation-plan .

gcp:exactness-metric
    a dqv:Metric ;
    dcterms:title "Whole admitted GCP surface exactness" ;
    dcterms:description "True only when source topology, executable behavior coverage, method-level differential evidence, and every generated validation case are closed with unique paired real/simulator receipts and equivalent projected observations; discovery-inferred execution alone never establishes exactness." .
