# The guide's verified mapping table (section 1), one row per individual.
PREFIX ahm: <http://seanchatmangpt.github.io/packs/a2a-hex-migration#>

SELECT ?old_ref ?new_ref ?old_module ?new_module ?grounding WHERE {
  ?m a ahm:ModuleMapping ; ahm:oldRef ?old_ref ; ahm:newRef ?new_ref ;
     ahm:oldModule ?old_module ; ahm:newModule ?new_module ; ahm:grounding ?grounding .
} ORDER BY DESC(STRLEN(?old_ref))
