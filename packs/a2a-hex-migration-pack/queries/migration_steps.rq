# The migration steps in guide order, with the guide section each cites.
PREFIX ahm: <http://seanchatmangpt.github.io/packs/a2a-hex-migration#>

SELECT ?order ?step ?name ?guide_section WHERE {
  ?step a ahm:MigrationStep ; ahm:stepOrder ?order ; ahm:stepName ?name ;
        ahm:guideSection ?guide_section .
} ORDER BY ?order
