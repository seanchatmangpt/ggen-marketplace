# MESSAGE: the guide's section-1 table (docs/how-to/migrate-from-a2a-hex.md)
# is the verified mapping set: A2A.Message, A2A.Part, A2A.Plug, A2A.Plug.Auth,
# A2A.AgentSupervisor, A2A.Agent. Any row below is one of those guide modules
# that the pack's ModuleMapping individuals do NOT cover -- i.e. the template's
# rendered mapping table would silently miss a module the guide verified.
# Empty result = pass.
PREFIX ahm: <http://seanchatmangpt.github.io/packs/a2a-hex-migration#>

SELECT ?guide_module WHERE {
  VALUES ?guide_module { "A2A.Message" "A2A.Part" "A2A.Plug" "A2A.Plug.Auth" "A2A.AgentSupervisor" "A2A.Agent" }
  FILTER NOT EXISTS {
    ?m a ahm:ModuleMapping ; ahm:oldModule ?guide_module .
  }
}
ORDER BY ?guide_module
