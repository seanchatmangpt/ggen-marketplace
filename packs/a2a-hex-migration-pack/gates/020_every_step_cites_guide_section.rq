# MESSAGE: every MigrationStep must cite the exact guide heading that defines
# it (ahm:guideSection), matching the guide's numbered-heading shape
# ("N. Title"). A step without a guide citation is an ungrounded assertion,
# not capital. Empty result = pass.
PREFIX ahm: <http://seanchatmangpt.github.io/packs/a2a-hex-migration#>

SELECT ?step WHERE {
  ?step a ahm:MigrationStep .
  OPTIONAL { ?step ahm:guideSection ?gs }
  FILTER ( !BOUND(?gs) || !REGEX(STR(?gs), "^[0-9]+\\. ") )
}
