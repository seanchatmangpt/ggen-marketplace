# MESSAGE: every ModuleMapping's grounding citation must point into the new
# side of the vendored protocol surface (lib/ash_a2a/...), per the guide's
# grounding column ("Grounding paths are relative to lib/ash_a2a/"). A mapping
# grounded anywhere else is not verified against ash_a2a 26.10.3. Empty
# result = pass.
PREFIX ahm: <http://seanchatmangpt.github.io/packs/a2a-hex-migration#>

SELECT ?m ?bad_grounding WHERE {
  ?m a ahm:ModuleMapping ; ahm:grounding ?bad_grounding .
  FILTER ( !STRSTARTS(STR(?bad_grounding), "lib/ash_a2a/") )
}
