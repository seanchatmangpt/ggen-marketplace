---
to: "lib/mix/tasks/a2a_hex_migrate.ex"
force: true
for_each: "spec"
sparql:
  spec: |
    PREFIX ahm: <http://seanchatmangpt.github.io/packs/a2a-hex-migration#>
    SELECT ?task_module_segment ?guide_doc ?from_package ?to_package ?alias_pattern WHERE {
      ?s a ahm:MigrationSpec ; ahm:taskModuleSegment ?task_module_segment ;
         ahm:guideDoc ?guide_doc ; ahm:fromPackage ?from_package ;
         ahm:toPackage ?to_package ; ahm:aliasPattern ?alias_pattern .
    }
  mappings: |
    PREFIX ahm: <http://seanchatmangpt.github.io/packs/a2a-hex-migration#>
    SELECT ?old_ref ?new_ref ?old_module ?new_module ?grounding WHERE {
      ?m a ahm:ModuleMapping ; ahm:oldRef ?old_ref ; ahm:newRef ?new_ref ;
         ahm:oldModule ?old_module ; ahm:newModule ?new_module ; ahm:grounding ?grounding .
    } ORDER BY ?old_ref
  deltas: |
    PREFIX ahm: <http://seanchatmangpt.github.io/packs/a2a-hex-migration#>
    SELECT ?order ?title ?doc WHERE {
      ?d a ahm:WireShapeDelta ; ahm:deltaOrder ?order ; ahm:deltaTitle ?title ; ahm:deltaDoc ?doc .
    } ORDER BY ?order
  steps: |
    PREFIX ahm: <http://seanchatmangpt.github.io/packs/a2a-hex-migration#>
    SELECT ?order ?name ?guide_section WHERE {
      ?st a ahm:MigrationStep ; ahm:specOf ?s ; ahm:stepOrder ?order ;
         ahm:stepName ?name ; ahm:guideSection ?guide_section .
    } ORDER BY ?order
---

{#
  Generated by ggen-marketplace pack a2a-hex-migration-pack. This file is a
  projection of ash_a2a's migration guide ({{ guide_doc }}); the guide is the
  authority, this task is manufactured capital. Do not hand-edit generated
  output -- edit the pack ontology and re-render.

  `mix {{ task_module_segment | lower }}` performs, in one pass:
    1. removes the {:a2a, ...} dependency from mix.exs (guide section 1),
    2. rewrites A2A.* refs across lib/ test/ config/ per the guide's verified
       mapping table ({{ mappings | length }} literal rows), flagging any rename
       that falls outside the table as unverified,
    3. prints the raw-JSON wire-shape delta checklist ({{ deltas | length }} deltas,
       guide section 2),
    4. prints the migration steps with their guide citations,
    5. runs the guide's final sweep (guide section 7) and refuses (exit 1) if
       any A2A. reference or {:a2a, ...} dep survives.

  Pass gate (guide section 7): zero matches on both sweeps.

  Dual-branch shape mirrors ash-extension-pack's install.ex.tmpl: the
  Igniter.Mix.Task branch runs when Igniter is a dependency of the consumer
  project; otherwise the plain Mix.Task fallback runs with zero extra
  dependencies, because a mid-migration consumer cannot be asked to fetch a
  new dep in order to run its own migration. QUALIFICATION STATUS: the
  falsifier run exercises the plain Mix.Task branch end to end; the Igniter
  branch is exercised only when Igniter is loaded -- treat it as qualified
  only after such a run. #}

defmodule {{ task_module_segment }}.Engine do
  @moduledoc false

  # Verified mapping table (guide section 1, all rows). Applied as literal
  # longest-first replacements. Grounding citations are the guide's, verbatim.
  @mappings [
{% for m in mappings %}    {"{{ m.old_ref }}", "{{ m.new_ref }}"}, # {{ m.grounding }}
{% endfor %}  ]

  # Raw-JSON wire-shape deltas (guide section 2). Checklist only -- the task
  # never rewrites raw-frame assertions; a human reads these against their own
  # test/client code.
  @wire_shape_deltas [
{% for d in deltas %}    {"{{ d.title }}",
     """
     {{ d.doc }}
     """},
{% endfor %}  ]

  @steps [
{% for st in steps %}    {"{{ st.order }}. {{ st.name }}", "guide: {{ st.guide_section }}"},
{% endfor %}  ]

  def mappings, do: @mappings
  def wire_shape_deltas, do: @wire_shape_deltas
  def steps, do: @steps

  # The dep-tuple matcher: {:a2a, ...} with no nested braces, spans lines.
  def dep_pattern, do: ~r/\{\s*:a2a\s*,[^{}]*\}/

  # Anything NOT preceded by a word character (excludes AshA2A., whose
  # trailing "hA2A." would otherwise false-positive) followed by the
  # namespace dot.
  def ref_pattern, do: ~r/(?<!\w)A2A\./

  # Bare `alias A2A` at end of line (guide: "Grep your tree for `alias A2A`
  # too"). `alias A2A.Something` is handled by ref_pattern.
  def bare_alias_pattern, do: ~r/(?<![\w.])alias\s+A2A\s*$/m

  @candidate_dirs ["lib", "test", "config"]

  # This task's own file. Excluded from both rewriting and the final sweep:
  # its @mappings/@wire_shape_deltas literals ARE the verified table and the
  # checklist, so "A2A." occurrences here are migration capital, not consumer
  # references. Rewriting them would corrupt the table (observed in the first
  # falsifier run); sweeping them would false-fail the pass gate.
  @generated_task "lib/mix/tasks/a2a_hex_migrate.ex"

  @doc "Recursive .ex/.exs listing of lib/ test/ config/ plus mix.exs, excluding this task's own file."
  def candidate_files do
    files =
      @candidate_dirs
      |> Enum.flat_map(&walk/1)
      |> Enum.reject(&(&1 == @generated_task))

    if File.exists?("mix.exs"), do: ["mix.exs" | files], else: files
  end

  defp walk(dir) do
    dir
    |> File.ls!()
    |> Enum.sort()
    |> Enum.flat_map(fn name ->
      path = Path.join(dir, name)
      cond do
        File.dir?(path) -> walk(path)
        String.ends_with?(path, [".ex", ".exs"]) -> [path]
        true -> []
      end
    end)
  end

  @doc """
  Rewrites one file's content. Returns `{content, report}`: `covered` lists
  verified table rows that fired; `generic` counts refs that fell to the
  generic word-boundary rename -- each such rename is UNVERIFIED by the
  guide's table and is surfaced, never silently absorbed.
  """
  def rewrite(content) do
    sorted = Enum.sort_by(@mappings, fn {old, _} -> -String.length(old) end)

    {content, covered} =
      Enum.reduce(sorted, {content, []}, fn {old, new}, {c, covered} ->
        if String.contains?(c, old) do
          {String.replace(c, old, new), [{old, new} | covered]}
        else
          {c, covered}
        end
      end)

    generic = length(Regex.scan(ref_pattern(), content))
    content = Regex.replace(ref_pattern(), content, "AshA2A.Protocol.")
    content = Regex.replace(bare_alias_pattern(), content, "alias AshA2A.Protocol")

    {content, %{covered: Enum.reverse(covered), generic: generic}}
  end

  @doc "Removes the {:a2a, ...} tuple. Returns {content, removed_tuple_or_nil}."
  def remove_dep(content) do
    case Regex.run(dep_pattern(), content) do
      nil ->
        {content, nil}

      [tuple] ->
        new =
          content
          |> String.replace(tuple, "")
          |> then(fn c -> Regex.replace(~r/\[\s*,/, c, "[") end)
          |> then(fn c -> Regex.replace(~r/,\s*\]/, c, "]") end)

        {new, String.trim(tuple)}
    end
  end

  @doc """
  The guide's section-7 pass gate over the current tree: residual A2A. refs,
  bare `alias A2A` lines, and any surviving {:a2a, ...} dep, as
  `{path, line_no, text}` rows.
  """
  def sweep do
    ref = ref_pattern()
    alias_re = bare_alias_pattern()

    files = candidate_files()

    ref_rows =
      for path <- files,
          content = File.read!(path),
          lines = String.split(content, "\n"),
          {line, i} <- Enum.with_index(lines, 1),
          Regex.match?(ref, line),
          do: {path, i, String.trim(line)}

    alias_rows =
      for path <- files,
          content = File.read!(path),
          lines = String.split(content, "\n"),
          {line, i} <- Enum.with_index(lines, 1),
          Regex.match?(alias_re, line),
          do: {path, i, String.trim(line)}

    dep_rows =
      case File.exists?("mix.exs") do
        false ->
          []

        true ->
          mix = File.read!("mix.exs")

          case Regex.run(dep_pattern(), mix) do
            nil -> []
            [tuple] -> [{"mix.exs", 0, String.trim(tuple)}]
          end
      end

    %{refs: ref_rows, bare_aliases: alias_rows, deps: dep_rows}
  end
end

if Code.ensure_loaded?(Igniter) do
  defmodule Mix.Tasks.A2aHexMigrate do
    @moduledoc """
    Migrates the current project off the `{:a2a, "~> 0.2"}` hex package onto
    ash_a2a's vendored `AshA2A.Protocol.*` surface ({{ to_package }}).

    Projection of {{ guide_doc }}; the guide is the authority.

    Igniter branch: rewrites are Igniter-managed (diffable, confirmable);
    --dry-run isIgniter's own diff-and-confirm, so it is not re-implemented here.
    """

    use Igniter.Mix.Task

    @impl Igniter.Mix.Task
    def info(_argv, _composing_task) do
      %Igniter.Mix.Task.Info{
        group: :a2a_hex_migration,
        example: "mix a2a_hex_migrate",
        positional: [],
        schema: [],
        required: []
      }
    end

    @impl Igniter.Mix.Task
    def igniter(igniter) do
      igniter =
        igniter
        |> Igniter.Project.Deps.remove_dep(:a2a)
        |> rewrite_all()
        |> Igniter.add_notice(checklist_text())
        |> Igniter.add_notice(steps_text())
        |> Igniter.add_notice("""
        Now run the guide's section-7 verification yourself:

            grep -rn --include='*.ex' --include='*.exs' 'A2A\\.' lib test config
            grep -rn --include='*.ex' --include='*.exs' '{:a2a' mix.exs

        Zero matches on both is the pass gate. Then `mix deps.unlock a2a`,
        `mix deps.get`, and run your suite.
        """)
    end

    defp rewrite_all(igniter) do
      Enum.reduce({{ task_module_segment }}.Engine.candidate_files(), igniter, fn path, ign ->
        cond do
          path == "mix.exs" or not File.exists?(path) ->
            ign

          true ->
            ign
            |> Igniter.include_existing_file(path)
            |> Igniter.update_file(path, fn source ->
              content = Rewrite.Source.get(source, :content)
              {new, _report} = {{ task_module_segment }}.Engine.rewrite(content)
              Rewrite.Source.update(source, :content, new)
            end)
        end
      end)
    end

    defp checklist_text do
      "Wire-shape deltas to check by hand (raw-JSON assertions only):\n\n" <>
        Enum.map_join({{ task_module_segment }}.Engine.wire_shape_deltas(), "\n", fn {title, doc} ->
          "  * #{title}\n#{doc}\n"
        end)
    end

    defp steps_text do
      "Migration steps:\n\n" <>
        Enum.map_join({{ task_module_segment }}.Engine.steps(), "\n", fn {name, guide} ->
          "  #{name}  (#{guide})"
        end)
    end
  end
else
  defmodule Mix.Tasks.A2aHexMigrate do
    @moduledoc """
    Migrates the current project off the `{:a2a, "~> 0.2"}` hex package onto
    ash_a2a's vendored `AshA2A.Protocol.*` surface ({{ to_package }}).

    Projection of {{ guide_doc }}; the guide is the authority.

    Plain Mix.Task fallback (Igniter not loaded). Supports --dry-run.
    """

    use Mix.Task

    @shortdoc "Migrate off the a2a hex package onto AshA2A.Protocol.*"

    @impl Mix.Task
    def run(argv) do
      dry_run? = "--dry-run" in argv

      print_steps()

      mix_exs = File.read!("mix.exs")
      {new_mix, removed} = {{ task_module_segment }}.Engine.remove_dep(mix_exs)

      cond do
        removed ->
          Mix.shell().info([:green, "  removed dep: #{removed}", :reset])

        true ->
          Mix.shell().info("  no {:a2a, ...} dep found in mix.exs (already dropped?)")
      end

      unless dry_run? or new_mix == mix_exs do
        File.write!("mix.exs", new_mix)
      end

      {ref_writes, generic_total} = rewrite_tree(dry_run?)

      print_checklist()

      report_sweep()

      {ref_writes, generic_total}
    end

    defp rewrite_tree(dry_run?) do
      files = {{ task_module_segment }}.Engine.candidate_files()

      Enum.reduce(files, {0, 0}, fn path, {writes, generics} ->
        content = File.read!(path)
        {new, report} = {{ task_module_segment }}.Engine.rewrite(content)

        if new == content do
          {writes, generics}
        else
          Mix.shell().info("")

          Enum.each(report.covered, fn {old, new_ref} ->
            Mix.shell().info("  #{path}: #{old} -> #{new_ref}")
          end)

          if report.generic > 0 do
            Mix.shell().info([
              :yellow,
              "  #{path}: #{report.generic} ref(s) renamed OUTSIDE the verified table -- check against lib/ash_a2a/protocol/",
              :reset
            ])
          end

          unless dry_run? do
            File.write!(path, new)
          end

          {writes + 1, generics + report.generic}
        end
      end)
    end

    defp print_steps do
      Mix.shell().info("Migration steps ({{ guide_doc }}):")

      Enum.each({{ task_module_segment }}.Engine.steps(), fn {name, guide} ->
        Mix.shell().info("  #{name}  (#{guide})")
      end)
    end

    defp print_checklist do
      Mix.shell().info("")
      Mix.shell().info("Wire-shape deltas to check by hand (raw-JSON assertions only):")

      Enum.each({{ task_module_segment }}.Engine.wire_shape_deltas(), fn {title, doc} ->
        Mix.shell().info("  * #{title}")
        Mix.shell().info(String.replace(doc, "\n", "\n    "))
      end)
    end

    defp report_sweep do
      sweep = {{ task_module_segment }}.Engine.sweep()
      rows = sweep.refs ++ sweep.bare_aliases ++ sweep.deps

      case rows do
        [] ->
          Mix.shell().info([
            :green,
            "PASS: sweep reports zero A2A. refs and zero {:a2a, ...} deps (guide section 7 pass gate)",
            :reset
          ])

        rows ->
          Mix.shell().info("RESIDUAL A2A references (guide section 7):")

          Enum.each(rows, fn {path, line, text} ->
            Mix.shell().info("  #{path}:#{line}: #{text}")
          end)

          Mix.raise("residual A2A references remain -- port them per the guide, then rerun")
      end
    end
  end
end
