# PASS witness: ai_010_required must be SILENT here (complete ContractType + Field,
# mined from qualification/consumer/ai.ttl's evidence_envelope shape).
@prefix aic: <https://ggen.dev/ontology/beam4pm-ai#> .
@prefix w: <https://ggen.dev/witness/ai010pass/> .
w:rt a aic:ContractType ; aic:contractName "evidence_envelope" ;
  aic:contractDoc "One admitted, sourced observation." ;
  aic:hasField w:f1 .
w:f1 a aic:Field ; aic:fieldName "evidence_id" ; aic:fieldType "string" ;
  aic:fieldDoc "Unique evidence identifier." ; aic:fieldRequired "true" ; aic:fieldOrder 1 .
