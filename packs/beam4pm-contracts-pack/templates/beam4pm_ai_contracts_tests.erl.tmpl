---
to: test/beam4pm_ai_contracts_tests.erl
sparql:
  records: |
    PREFIX aic: <https://ggen.dev/ontology/beam4pm-ai#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a aic:ContractType ; aic:contractName ?record_name ; aic:contractDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX aic: <https://ggen.dev/ontology/beam4pm-ai#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order ?sample_min_erlang WHERE {
      ?rt a aic:ContractType ; aic:contractName ?record_name ; aic:hasField ?f .
      ?f aic:fieldName ?field_name ; aic:fieldType ?field_type ; aic:fieldDoc ?field_doc ;
         aic:fieldRequired ?field_required ; aic:fieldOrder ?field_order .
      ?ft a aic:FieldType ; aic:fieldTypeName ?field_type ; aic:sampleMinErlang ?sample_min_erlang .
    } ORDER BY ?record_name ?field_order
---
%% GENERATED by ggen from the admitted aic:ContractType graph. Do not edit.

-module(beam4pm_ai_contracts_tests).

-include_lib("eunit/include/eunit.hrl").

%% No explicit -export here: EUnit's own parse transform auto-exports every
%% *_test/0 function in this module, and an explicit -export of the same
%% functions produces a real "already exported" compiler warning (which
%% would become a hard failure under warnings_as_errors).

{% for r in records -%}
{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) -%}
{%- set required_fields = rfields | filter(attribute="field_required", value="true") -%}
{%- set n_required = required_fields | length -%}
{{ r.record_name }}_ok_test() ->
    ?assertMatch({ok, _}, beam4pm_ai_contracts:new_{{ r.record_name }}(#{
{%- for f in rfields %}
        {{ f.field_name }} => {{ f.sample_min_erlang }}{% if not loop.last %},{% endif %}
{%- endfor %}
    })).

{% if n_required > 0 -%}
{{ r.record_name }}_missing_field_test() ->
    ?assertMatch({error, {missing_field, _}}, beam4pm_ai_contracts:new_{{ r.record_name }}(#{})).
{% else -%}
{{ r.record_name }}_empty_ok_test() ->
    ?assertMatch({ok, _}, beam4pm_ai_contracts:new_{{ r.record_name }}(#{})).
{% endif %}
{% endfor -%}
