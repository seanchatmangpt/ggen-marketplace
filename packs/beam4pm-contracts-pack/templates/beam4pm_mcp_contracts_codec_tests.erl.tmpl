---
to: test/beam4pm_mcp_contracts_codec_tests.erl
sparql:
  records: |
    PREFIX mcp: <https://ggen.dev/ontology/beam4pm-mcp#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a mcp:MessageType ; mcp:messageName ?record_name ; mcp:messageDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX mcp: <https://ggen.dev/ontology/beam4pm-mcp#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order ?wire_name WHERE {
      ?rt a mcp:MessageType ; mcp:messageName ?record_name ; mcp:hasField ?f .
      ?f mcp:fieldName ?field_name ; mcp:fieldType ?field_type ; mcp:fieldDoc ?field_doc ;
         mcp:fieldRequired ?field_required ; mcp:fieldOrder ?field_order .
      OPTIONAL { ?f mcp:wireName ?wn }
      BIND(COALESCE(?wn, ?field_name) AS ?wire_name)
    } ORDER BY ?record_name ?field_order
---
%% GENERATED by ggen from the admitted mcp:MessageType graph. Do not edit.

-module(beam4pm_mcp_contracts_codec_tests).

-include_lib("eunit/include/eunit.hrl").

%% No explicit -export here: EUnit's own parse transform auto-exports every
%% *_test/0 function in this module, and an explicit -export of the same
%% functions produces a real "already exported" compiler warning (which
%% would become a hard failure under warnings_as_errors).

%% Deterministic full-variant sample values, keyed by mcp:fieldType:
%% string -> <<"sample_" field_name>>, datetime -> <<"2026-08-29T12:00:00Z">>,
%% integer -> 42, float -> 3.5, boolean -> true, atom -> sample_atom,
%% list_string -> [<<"alpha">>, <<"beta">>], map -> #{<<"k">> => <<"v">>}.
%% JSON keys on the wire side are the field's mcp:wireName (falls back to
%% mcp:fieldName when absent) -- see beam4pm_mcp_contracts_codec.erl.

{% for r in records -%}
{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) -%}
{%- set required_fields_str = rfields | filter(attribute="field_required", value="true") -%}
{%- set required_fields_bool = rfields | filter(attribute="field_required", value=true) -%}
{%- set required_fields = required_fields_str | concat(with=required_fields_bool) -%}
{%- set bool_fields = rfields | filter(attribute="field_type", value="boolean") -%}
{{ r.record_name }}_map_roundtrip_test() ->
    {ok, Rec} = beam4pm_mcp_contracts:new_{{ r.record_name }}(#{
{%- for f in rfields %}
        {{ f.field_name }} => {% if f.field_type == "string" %}<<"sample_{{ f.field_name }}">>{% elif f.field_type == "integer" %}42{% elif f.field_type == "float" %}3.5{% elif f.field_type == "boolean" %}true{% elif f.field_type == "datetime" %}<<"2026-08-29T12:00:00Z">>{% elif f.field_type == "atom" %}sample_atom{% elif f.field_type == "list_string" %}[<<"alpha">>, <<"beta">>]{% elif f.field_type == "map" %}#{<<"k">> => <<"v">>}{% endif %}{% if not loop.last %},{% endif %}
{%- endfor %}
    }),
    Map = beam4pm_mcp_contracts_codec:to_map(Rec),
{%- for f in rfields %}
    ?assertEqual({% if f.field_type == "string" %}<<"sample_{{ f.field_name }}">>{% elif f.field_type == "integer" %}42{% elif f.field_type == "float" %}3.5{% elif f.field_type == "boolean" %}true{% elif f.field_type == "datetime" %}<<"2026-08-29T12:00:00Z">>{% elif f.field_type == "atom" %}<<"sample_atom">>{% elif f.field_type == "list_string" %}[<<"alpha">>, <<"beta">>]{% elif f.field_type == "map" %}#{<<"k">> => <<"v">>}{% endif %}, maps:get(<<"{{ f.wire_name }}">>, Map)),
{%- endfor %}
    {ok, Rec2} = beam4pm_mcp_contracts_codec:from_map({{ r.record_name }},
        Map#{<<"totally_unknown_key_zz">> => <<"dropped">>}),
    ?assertEqual(Rec, Rec2).

{{ r.record_name }}_json_roundtrip_test() ->
    {ok, Rec} = beam4pm_mcp_contracts:new_{{ r.record_name }}(#{
{%- for f in rfields %}
        {{ f.field_name }} => {% if f.field_type == "string" %}<<"sample_{{ f.field_name }}">>{% elif f.field_type == "integer" %}42{% elif f.field_type == "float" %}3.5{% elif f.field_type == "boolean" %}true{% elif f.field_type == "datetime" %}<<"2026-08-29T12:00:00Z">>{% elif f.field_type == "atom" %}sample_atom{% elif f.field_type == "list_string" %}[<<"alpha">>, <<"beta">>]{% elif f.field_type == "map" %}#{<<"k">> => <<"v">>}{% endif %}{% if not loop.last %},{% endif %}
{%- endfor %}
    }),
    Json = beam4pm_mcp_contracts_codec:encode(Rec),
    ?assert(is_binary(Json)),
    {ok, Rec2} = beam4pm_mcp_contracts_codec:decode({{ r.record_name }}, Json),
    ?assertEqual(Rec, Rec2).

{% if bool_fields | length > 0 -%}
{% for bf in bool_fields -%}
{{ r.record_name }}_{{ bf.field_name }}_false_is_not_omitted_test() ->
    %% is_error/false must round-trip distinctly from the field being
    %% entirely absent (undefined): to_map/1 filters on `Value =/= undefined`,
    %% not on truthiness, so an explicit `false` must survive the wrapped
    %% map/JSON round trip as `false`, never be dropped like `undefined` is.
    {ok, Rec} = beam4pm_mcp_contracts:new_{{ r.record_name }}(#{
{%- for f in rfields %}
        {{ f.field_name }} => {% if f.field_name == bf.field_name %}false{% elif f.field_type == "string" %}<<"sample_{{ f.field_name }}">>{% elif f.field_type == "integer" %}42{% elif f.field_type == "float" %}3.5{% elif f.field_type == "boolean" %}true{% elif f.field_type == "datetime" %}<<"2026-08-29T12:00:00Z">>{% elif f.field_type == "atom" %}sample_atom{% elif f.field_type == "list_string" %}[<<"alpha">>, <<"beta">>]{% elif f.field_type == "map" %}#{<<"k">> => <<"v">>}{% endif %}{% if not loop.last %},{% endif %}
{%- endfor %}
    }),
    Map = beam4pm_mcp_contracts_codec:to_map(Rec),
    ?assert(maps:is_key(<<"{{ bf.wire_name }}">>, Map)),
    ?assertEqual(false, maps:get(<<"{{ bf.wire_name }}">>, Map)),
    {ok, Rec2} = beam4pm_mcp_contracts_codec:from_map({{ r.record_name }}, Map),
    ?assertEqual(Rec, Rec2).

{% endfor -%}
{% endif -%}
{% if required_fields | length > 0 -%}
{%- set first_req = required_fields | first -%}
{{ r.record_name }}_missing_field_test() ->
    %% {{ r.record_name }} requires {{ first_req.field_name }}; an empty map
    %% must surface the constructor's own missing-field validation unchanged.
    ?assertMatch({error, {missing_field, _}},
                 beam4pm_mcp_contracts_codec:from_map({{ r.record_name }}, #{})).

{% endif -%}
{% endfor -%}
{%- set req_fields_str = fields | filter(attribute="field_required", value="true") -%}
{%- set req_fields_bool = fields | filter(attribute="field_required", value=true) -%}
{%- set req_fields = req_fields_str | concat(with=req_fields_bool) -%}
{%- set mf = req_fields | first -%}
unknown_record_test() ->
    ?assertEqual({error, {unknown_record, not_a_known_record}},
                 beam4pm_mcp_contracts_codec:from_map(not_a_known_record, #{})).

invalid_json_test() ->
    ?assertMatch({error, _},
                 beam4pm_mcp_contracts_codec:decode({{ mf.record_name }}, <<"not json at all">>)).
