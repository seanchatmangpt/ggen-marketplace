# MESSAGE: no two mcp:Field siblings of the same mcp:MessageType may share an identical mcp:fieldOrder value; any duplicate is a refusal.
PREFIX mcp: <https://ggen.dev/ontology/beam4pm-mcp#>
SELECT ?message_type ?field_order (COUNT(?field) AS ?count) WHERE {
  ?message_type a mcp:MessageType ; mcp:hasField ?field .
  ?field mcp:fieldOrder ?field_order .
}
GROUP BY ?message_type ?field_order
HAVING (COUNT(?field) > 1)
ORDER BY ?message_type ?field_order
