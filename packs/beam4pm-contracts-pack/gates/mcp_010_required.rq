# MESSAGE: every admitted mcp:MessageType and mcp:Field must contain the fields required by its class; any row is a refusal.
PREFIX mcp: <https://ggen.dev/ontology/beam4pm-mcp#>
SELECT ?subject ?missing WHERE {
  {
    ?subject a mcp:MessageType .
    VALUES ?missing { mcp:messageName mcp:messageDoc mcp:hasField }
  } UNION {
    ?subject a mcp:Field .
    VALUES ?missing { mcp:fieldName mcp:fieldType mcp:fieldDoc mcp:fieldRequired mcp:fieldOrder }
  }
  FILTER NOT EXISTS { ?subject ?missing ?value }
}
ORDER BY ?subject ?missing
