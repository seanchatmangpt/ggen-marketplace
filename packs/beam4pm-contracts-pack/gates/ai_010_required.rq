# MESSAGE: every admitted aic:ContractType and aic:Field must contain the fields required by its class; any row is a refusal.
PREFIX aic: <https://ggen.dev/ontology/beam4pm-ai#>
SELECT ?subject ?missing WHERE {
  {
    ?subject a aic:ContractType .
    VALUES ?missing { aic:contractName aic:contractDoc aic:hasField }
  } UNION {
    ?subject a aic:Field .
    VALUES ?missing { aic:fieldName aic:fieldType aic:fieldDoc aic:fieldRequired aic:fieldOrder }
  }
  FILTER NOT EXISTS { ?subject ?missing ?value }
}
ORDER BY ?subject ?missing
