# MESSAGE: every mcp:Field's mcp:fieldType must name an admitted shared
# beam4pm FieldType individual; any row is a refusal.
#
# Adopted (consolidation 2026-10-01) from beam4pm-ai-contracts-pack's
# anti-join archetype as THE single field-type gate form for both family
# modules: this gate anti-joins against ontology/ai.ttl's aic:FieldType
# closed reference vocabulary (the same closed 8-value set both ontologies'
# own field comments declare). The predecessor's hardcoded
# STR(?value) NOT IN ("string", ...) form is RETIRED — admitting a 9th
# field type now touches exactly ONE site (the aic:FieldType block in
# ontology/ai.ttl), never this file and never a duplicated enum.
PREFIX mcp: <https://ggen.dev/ontology/beam4pm-mcp#>
PREFIX aic: <https://ggen.dev/ontology/beam4pm-ai#>
SELECT ?subject ?value WHERE {
  ?subject a mcp:Field ; mcp:fieldType ?value .
  FILTER NOT EXISTS { ?ft a aic:FieldType ; aic:fieldTypeName ?value . }
}
ORDER BY ?subject
