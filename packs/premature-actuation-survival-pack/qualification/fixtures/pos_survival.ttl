@prefix pas: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/premature-actuation-survival#> .

pas:scenario a pas:Scenario ;
  pas:subject "git:fixture/positive@0123456789abcdef" ;
  pas:workloadId "sha256:positive" ;
  pas:horizon 2 .

pas:policy a pas:Policy ;
  pas:policyId "formal" ;
  pas:machinery "formal-generated" ;
  pas:informationTopology "receipt-only" ;
  pas:toolPolicy "optional" ;
  pas:authorityCeiling "OBSERVE|SELECT|CONSTRUCT" ;
  pas:grantsDoAuthority false .

pas:episode a pas:Episode ;
  pas:scenario pas:scenario ;
  pas:policy pas:policy ;
  pas:step pas:s1 , pas:s2 .

pas:s1 a pas:Step ;
  pas:stepNumber 1 ;
  pas:phase "VERIFY" ;
  pas:exactSubject true ;
  pas:authorized true ;
  pas:admitted true ;
  pas:terminalReady false .

pas:s2 a pas:Step ;
  pas:stepNumber 2 ;
  pas:phase "DO" ;
  pas:exactSubject true ;
  pas:authorized true ;
  pas:admitted true ;
  pas:receiptId "receipt:positive" ;
  pas:terminalReady true .
