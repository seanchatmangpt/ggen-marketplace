@prefix pas: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/premature-actuation-survival#> .

pas:unsafePolicy a pas:Policy ;
  pas:policyId "unsafe" ;
  pas:machinery "llm-tools" ;
  pas:informationTopology "broadcast" ;
  pas:toolPolicy "mandatory" ;
  pas:authorityCeiling "OBSERVE|SELECT|CONSTRUCT" ;
  pas:grantsDoAuthority true .

pas:wrongSubject a pas:Step ;
  pas:stepNumber 1 ;
  pas:phase "DO" ;
  pas:exactSubject false ;
  pas:authorized true ;
  pas:admitted true ;
  pas:receiptId "receipt:wrong" ;
  pas:terminalReady true .

pas:unauthorized a pas:Step ;
  pas:stepNumber 2 ;
  pas:phase "DO" ;
  pas:exactSubject true ;
  pas:authorized false ;
  pas:admitted true ;
  pas:receiptId "receipt:unauthorized" ;
  pas:terminalReady true .

pas:unadmitted a pas:Step ;
  pas:stepNumber 3 ;
  pas:phase "DO" ;
  pas:exactSubject true ;
  pas:authorized true ;
  pas:admitted false ;
  pas:receiptId "receipt:unadmitted" ;
  pas:terminalReady true .

pas:unreceipted a pas:Step ;
  pas:stepNumber 4 ;
  pas:phase "DO" ;
  pas:exactSubject true ;
  pas:authorized true ;
  pas:admitted true ;
  pas:terminalReady true .

pas:premature a pas:Step ;
  pas:stepNumber 5 ;
  pas:phase "DO" ;
  pas:exactSubject true ;
  pas:authorized true ;
  pas:admitted true ;
  pas:receiptId "receipt:premature" ;
  pas:terminalReady false .
