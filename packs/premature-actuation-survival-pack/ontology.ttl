@prefix pas: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/premature-actuation-survival#> .
@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:ggen:pack:premature-actuation-survival-pack>
    a gp:Pack ;
    gp:name "premature-actuation-survival-pack" ;
    gp:version "26.9.25" .

# The pack describes experiment evidence. It grants no actuation authority.
pas:Scenario a rdfs:Class ; rdfs:subClassOf prov:Entity .
pas:Policy a rdfs:Class ; rdfs:subClassOf prov:Entity .
pas:Episode a rdfs:Class ; rdfs:subClassOf prov:Activity .
pas:Step a rdfs:Class ; rdfs:subClassOf prov:Activity .

pas:scenario a rdf:Property ; rdfs:domain pas:Episode ; rdfs:range pas:Scenario .
pas:policy a rdf:Property ; rdfs:domain pas:Episode ; rdfs:range pas:Policy .
pas:step a rdf:Property ; rdfs:domain pas:Episode ; rdfs:range pas:Step .
pas:subject a rdf:Property ; rdfs:range xsd:string .
pas:workloadId a rdf:Property ; rdfs:range xsd:string .
pas:policyId a rdf:Property ; rdfs:range xsd:string .
pas:horizon a rdf:Property ; rdfs:range xsd:integer .
pas:stepNumber a rdf:Property ; rdfs:range xsd:integer .
pas:phase a rdf:Property ; rdfs:range xsd:string .
pas:exactSubject a rdf:Property ; rdfs:range xsd:boolean .
pas:authorized a rdf:Property ; rdfs:range xsd:boolean .
pas:admitted a rdf:Property ; rdfs:range xsd:boolean .
pas:receiptId a rdf:Property ; rdfs:range xsd:string .
pas:terminalReady a rdf:Property ; rdfs:range xsd:boolean .
pas:toolInvoked a rdf:Property ; rdfs:range xsd:boolean .
pas:llmTokens a rdf:Property ; rdfs:range xsd:integer .
pas:machinery a rdf:Property ; rdfs:range xsd:string .
pas:informationTopology a rdf:Property ; rdfs:range xsd:string .
pas:toolPolicy a rdf:Property ; rdfs:range xsd:string .
pas:grantsDoAuthority a rdf:Property ; rdfs:range xsd:boolean .
pas:authorityCeiling a rdf:Property ; rdfs:range xsd:string .

pas:contractV1
    a prov:Entity ;
    dcterms:title "Premature Actuation Survival Contract v1" ;
    pas:authorityCeiling "OBSERVE|SELECT|CONSTRUCT" ;
    pas:grantsDoAuthority false .

# Worked positive fixture: survives the horizon because the only DO is exact,
# authorized, admitted, receipted, and terminal-ready.
pas:scenarioFixture
    a pas:Scenario ;
    pas:subject "git:example/repo@0123456789abcdef" ;
    pas:workloadId "sha256:fixed-survival-workload" ;
    pas:horizon 3 .

pas:formalPolicy
    a pas:Policy ;
    pas:policyId "formal-generated" ;
    pas:machinery "formal-generated" ;
    pas:informationTopology "receipt-only" ;
    pas:toolPolicy "optional" ;
    pas:authorityCeiling "OBSERVE|SELECT|CONSTRUCT" ;
    pas:grantsDoAuthority false .

pas:episodeFixture
    a pas:Episode ;
    pas:scenario pas:scenarioFixture ;
    pas:policy pas:formalPolicy ;
    pas:step pas:step1 , pas:step3 .

pas:step1
    a pas:Step ;
    pas:stepNumber 1 ;
    pas:phase "OBSERVE" ;
    pas:exactSubject true ;
    pas:authorized true ;
    pas:admitted true ;
    pas:terminalReady false ;
    pas:toolInvoked false ;
    pas:llmTokens 0 .

pas:step3
    a pas:Step ;
    pas:stepNumber 3 ;
    pas:phase "DO" ;
    pas:exactSubject true ;
    pas:authorized true ;
    pas:admitted true ;
    pas:receiptId "receipt:fixture:3" ;
    pas:terminalReady true ;
    pas:toolInvoked false ;
    pas:llmTokens 0 .


# ============================================================================
# Recurrent failure -> powerless guard candidate projection
# ============================================================================

pas:GuardCandidate a rdfs:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "survival guard candidate" ;
    rdfs:comment "A powerless proposed permanent guard manufactured from recurrent observed failures. Candidate is not installation, authority, or production standing." .

pas:failureType a rdf:Property ; rdfs:domain pas:GuardCandidate ; rdfs:range xsd:string .
pas:guardId a rdf:Property ; rdfs:domain pas:GuardCandidate ; rdfs:range xsd:string .
pas:occurrences a rdf:Property ; rdfs:domain pas:GuardCandidate ; rdfs:range xsd:integer .
pas:standing a rdf:Property ; rdfs:domain pas:GuardCandidate ; rdfs:range xsd:string .
pas:authority a rdf:Property ; rdfs:domain pas:GuardCandidate ; rdfs:range xsd:string .
pas:installation a rdf:Property ; rdfs:domain pas:GuardCandidate ; rdfs:range xsd:string .
pas:evidenceEpisode a rdf:Property ; rdfs:domain pas:GuardCandidate ; rdfs:range pas:Episode .

pas:wrongSubjectGuard a pas:GuardCandidate ;
    pas:failureType "WRONG_SUBJECT_DO" ;
    pas:guardId "require_exact_subject_before_do" ;
    pas:occurrences 0 ;
    pas:standing "CANDIDATE" ;
    pas:authority "none" ;
    pas:installation "NOT_PERFORMED" .

pas:unauthorizedGuard a pas:GuardCandidate ;
    pas:failureType "UNAUTHORIZED_DO" ;
    pas:guardId "require_authority_before_do" ;
    pas:occurrences 0 ;
    pas:standing "CANDIDATE" ;
    pas:authority "none" ;
    pas:installation "NOT_PERFORMED" .

pas:unadmittedGuard a pas:GuardCandidate ;
    pas:failureType "UNADMITTED_DO" ;
    pas:guardId "require_admission_before_do" ;
    pas:occurrences 0 ;
    pas:standing "CANDIDATE" ;
    pas:authority "none" ;
    pas:installation "NOT_PERFORMED" .

pas:unreceiptedGuard a pas:GuardCandidate ;
    pas:failureType "UNRECEIPTED_DO" ;
    pas:guardId "require_receipt_before_do" ;
    pas:occurrences 0 ;
    pas:standing "CANDIDATE" ;
    pas:authority "none" ;
    pas:installation "NOT_PERFORMED" .

pas:prematureGuard a pas:GuardCandidate ;
    pas:failureType "PREMATURE_DO" ;
    pas:guardId "require_terminal_predicate_before_do" ;
    pas:occurrences 0 ;
    pas:standing "CANDIDATE" ;
    pas:authority "none" ;
    pas:installation "NOT_PERFORMED" .
