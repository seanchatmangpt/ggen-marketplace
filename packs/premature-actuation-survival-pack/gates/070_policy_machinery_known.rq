PREFIX pas: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/premature-actuation-survival#>

SELECT ?policy ?reason
WHERE {
  ?policy a pas:Policy .
  {
    FILTER NOT EXISTS { ?policy pas:machinery ?machinery . }
    BIND("MACHINERY_MISSING" AS ?reason)
  }
  UNION
  {
    ?policy pas:machinery ?machinery .
    FILTER(
      STR(?machinery) NOT IN (
        "llm-native",
        "llm-tools",
        "selective-llm",
        "planner-llm-residue",
        "formal-generated"
      )
    )
    BIND("MACHINERY_UNKNOWN" AS ?reason)
  }
}
ORDER BY ?policy ?reason
