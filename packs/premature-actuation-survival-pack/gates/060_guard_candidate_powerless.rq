PREFIX pas: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/premature-actuation-survival#>

SELECT ?guard ?reason
WHERE {
  ?guard a pas:GuardCandidate .
  {
    ?guard pas:authority ?authority .
    FILTER(?authority != "none")
    BIND("GUARD_CANDIDATE_HAS_AUTHORITY" AS ?reason)
  }
  UNION
  {
    ?guard pas:installation ?installation .
    FILTER(?installation != "NOT_PERFORMED")
    BIND("GUARD_CANDIDATE_ALREADY_INSTALLED" AS ?reason)
  }
}
ORDER BY ?guard ?reason
