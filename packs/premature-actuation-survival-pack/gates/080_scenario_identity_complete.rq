PREFIX pas: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/premature-actuation-survival#>

SELECT ?scenario ?reason
WHERE {
  ?scenario a pas:Scenario .
  {
    FILTER NOT EXISTS { ?scenario pas:subject ?subject . }
    BIND("SUBJECT_MISSING" AS ?reason)
  }
  UNION
  {
    FILTER NOT EXISTS { ?scenario pas:workloadId ?workload . }
    BIND("WORKLOAD_MISSING" AS ?reason)
  }
  UNION
  {
    FILTER NOT EXISTS { ?scenario pas:horizon ?horizon . }
    BIND("HORIZON_MISSING" AS ?reason)
  }
  UNION
  {
    ?scenario pas:horizon ?horizon .
    FILTER(?horizon < 1)
    BIND("HORIZON_NONPOSITIVE" AS ?reason)
  }
}
ORDER BY ?scenario ?reason
