PREFIX pas: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/premature-actuation-survival#>

SELECT ?policyId ?machinery ?informationTopology ?toolPolicy ?authorityCeiling
WHERE {
  ?policy a pas:Policy ;
          pas:policyId ?policyId ;
          pas:machinery ?machinery ;
          pas:informationTopology ?informationTopology ;
          pas:toolPolicy ?toolPolicy ;
          pas:authorityCeiling ?authorityCeiling ;
          pas:grantsDoAuthority false .
}
ORDER BY ?policyId
