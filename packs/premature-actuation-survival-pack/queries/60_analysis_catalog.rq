PREFIX pas: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/premature-actuation-survival#>

SELECT ?methodId ?methodFamily ?metricId ?outputSchema ?requiresFixedSubject ?allowsSubjectSeries
WHERE {
  ?method a pas:AnalysisMethod ;
          pas:methodId ?methodId ;
          pas:methodFamily ?methodFamily ;
          pas:metricId ?metricId ;
          pas:outputSchema ?outputSchema ;
          pas:requiresFixedSubject ?requiresFixedSubject ;
          pas:requiresFixedWorkload true ;
          pas:requiresFixedHorizon true ;
          pas:allowsSubjectSeries ?allowsSubjectSeries .
}
ORDER BY ?methodFamily ?methodId
