PREFIX pas: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/premature-actuation-survival#>

SELECT ?factorName ?levelId
WHERE {
  ?factor a pas:Factor ;
          pas:factorName ?factorName .
  ?level a pas:FactorLevel ;
         pas:levelOf ?factor ;
         pas:levelId ?levelId .
}
ORDER BY ?factorName ?levelId
