{
  "schema": "ggen.survival-analysis-catalog/1",
  "authority": "none",
  "methods": [
{% for row in rows %}
    {
      "methodId": "{{ row.methodId }}",
      "family": "{{ row.methodFamily }}",
      "metricId": "{{ row.metricId }}",
      "outputSchema": "{{ row.outputSchema }}",
      "requiresFixedSubject": {{ row.requiresFixedSubject }},
      "requiresFixedWorkload": true,
      "requiresFixedHorizon": true,
      "allowsSubjectSeries": {{ row.allowsSubjectSeries }}
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}
