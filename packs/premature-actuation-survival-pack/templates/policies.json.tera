{
  "schema": "ggen.survival-policy-catalog/1",
  "authority": "none",
  "policies": [
{% for row in rows %}
    {
      "policyId": "{{ row.policyId }}",
      "machinery": "{{ row.machinery }}",
      "informationTopology": "{{ row.informationTopology }}",
      "toolPolicy": "{{ row.toolPolicy }}",
      "authorityCeiling": "{{ row.authorityCeiling }}",
      "grantsDoAuthority": false
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}
