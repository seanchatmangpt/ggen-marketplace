@prefix pas: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/premature-actuation-survival#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pas:PolicyShape
    a sh:NodeShape ;
    sh:targetClass pas:Policy ;
    sh:property [ sh:path pas:policyId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [
        sh:path pas:machinery ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "llm-native" "llm-tools" "selective-llm" "planner-llm-residue" "formal-generated" )
    ] ;
    sh:property [ sh:path pas:informationTopology ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:toolPolicy ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [
        sh:path pas:authorityCeiling ;
        sh:hasValue "OBSERVE|SELECT|CONSTRUCT" ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path pas:grantsDoAuthority ;
        sh:hasValue false ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

pas:ScenarioShape
    a sh:NodeShape ;
    sh:targetClass pas:Scenario ;
    sh:property [ sh:path pas:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path pas:workloadId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [
        sh:path pas:horizon ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1
    ] .

pas:StepShape
    a sh:NodeShape ;
    sh:targetClass pas:Step ;
    sh:property [
        sh:path pas:stepNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1
    ] ;
    sh:property [
        sh:path pas:phase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "OBSERVE" "SELECT" "CONSTRUCT" "VERIFY" "DO" )
    ] .

pas:GuardCandidateShape
    a sh:NodeShape ;
    sh:targetClass pas:GuardCandidate ;
    sh:property [ sh:path pas:failureType ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:guardId ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [
        sh:path pas:occurrences ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ] ;
    sh:property [ sh:path pas:standing ; sh:hasValue "CANDIDATE" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:authority ; sh:hasValue "none" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:installation ; sh:hasValue "NOT_PERFORMED" ; sh:minCount 1 ; sh:maxCount 1 ] .

pas:FactorShape
    a sh:NodeShape ;
    sh:targetClass pas:Factor ;
    sh:property [ sh:path pas:factorName ; sh:minCount 1 ; sh:maxCount 1 ] .

pas:FactorLevelShape
    a sh:NodeShape ;
    sh:targetClass pas:FactorLevel ;
    sh:property [ sh:path pas:levelId ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:levelOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pas:Factor ] .

pas:FaultKindShape
    a sh:NodeShape ;
    sh:targetClass pas:FaultKind ;
    sh:property [ sh:path pas:faultKindId ; sh:minCount 1 ; sh:maxCount 1 ] .

pas:AnalysisMethodShape
    a sh:NodeShape ;
    sh:targetClass pas:AnalysisMethod ;
    sh:property [ sh:path pas:methodId ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:methodFamily ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:metricId ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:outputSchema ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:requiresFixedSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path pas:requiresFixedWorkload ; sh:hasValue true ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:requiresFixedHorizon ; sh:hasValue true ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:allowsSubjectSeries ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .

pas:CampaignProfileShape
    a sh:NodeShape ;
    sh:targetClass pas:CampaignProfile ;
    sh:property [ sh:path pas:syntheticExplicit ; sh:hasValue true ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:authorityCeiling ; sh:hasValue "OBSERVE|SELECT|CONSTRUCT" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:grantsDoAuthority ; sh:hasValue false ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:receiptRequiredForDo ; sh:hasValue true ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pas:replayEvidenceSupported ; sh:hasValue true ; sh:minCount 1 ; sh:maxCount 1 ] .
