@prefix eap: <https://seanchatmangpt.github.io/ggen-marketplace/ea-projection-admission#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
eap:SemanticRootShape a sh:NodeShape ; sh:targetClass eap:SemanticRoot ;
 sh:property [ sh:path eap:exactSubject ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path eap:sourceStanding ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path eap:semanticOwner ; sh:minCount 1 ; sh:maxCount 1 ] .
eap:ProjectionShape a sh:NodeShape ; sh:targetClass eap:ConsumerProjection ;
 sh:property [ sh:path eap:exactSubject ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path eap:consumerRepo ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path eap:mappingDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
 sh:property [ sh:path eap:authority ; sh:hasValue eap:NONE ] .
