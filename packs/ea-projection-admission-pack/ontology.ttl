@prefix eap: <https://seanchatmangpt.github.io/ggen-marketplace/ea-projection-admission#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eap:SemanticRoot a rdfs:Class .
eap:ConsumerProjection a rdfs:Class .
eap:ProjectionMapping a rdfs:Class .
eap:ProjectionQualification a rdfs:Class .
eap:ProjectionReceipt a rdfs:Class .
eap:Standing a rdfs:Class .
eap:Authority a rdfs:Class .

eap:exactSubject a rdf:Property ; rdfs:range xsd:string .
eap:sourceStanding a rdf:Property ; rdfs:range eap:Standing .
eap:claimsStanding a rdf:Property ; rdfs:range eap:Standing .
eap:semanticOwner a rdf:Property ; rdfs:range xsd:string .
eap:consumerRepo a rdf:Property ; rdfs:range xsd:string .
eap:requiresTerm a rdf:Property .
eap:projectsTerm a rdf:Property .
eap:mappingDigest a rdf:Property ; rdfs:range xsd:string .
eap:authority a rdf:Property ; rdfs:range eap:Authority .
eap:receiptDigest a rdf:Property ; rdfs:range xsd:string .
eap:qualifiedBy a rdf:Property ; rdfs:range eap:ProjectionQualification .

eap:UNKNOWN a eap:Standing .
eap:CANDIDATE a eap:Standing .
eap:ADMITTED a eap:Standing .
eap:QUALIFIED a eap:Standing .
eap:ALIVE a eap:Standing .
eap:NONE a eap:Authority .

eap:EnterpriseArchitectureCandidateRoot a eap:SemanticRoot ;
  eap:exactSubject "seanchatmangpt/chatman-ecosystem@cf1713d30ac711808a2782b66992dd5aa2074f59" ;
  eap:sourceStanding eap:CANDIDATE ;
  eap:semanticOwner "seanchatmangpt/chatman-ecosystem" ;
  prov:wasDerivedFrom <https://github.com/seanchatmangpt/chatman-ecosystem/pull/296> .

# Projection qualification is evidence only. It has no relation that grants DO.
eap:ProjectionCourt a eap:ProjectionQualification ;
  eap:authority eap:NONE .
