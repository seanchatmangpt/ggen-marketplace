PREFIX ex: <https://ggen.dev/ontology/dfcm-explore#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?candidate ?title ?family ?rollback ?falsifier WHERE {
  ?candidate a ex:Candidate ; dct:title ?title ; ex:family ?family ; ex:rollbackCost ?rollback ; ex:falsifier ?falsifier .
}
ORDER BY ?family ?rollback ?candidate
