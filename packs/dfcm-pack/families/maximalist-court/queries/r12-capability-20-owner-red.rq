PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller ?rule (COUNT(?r) AS ?red) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationControllerDigest ?controller ; dmc:realizationCapabilityRule ?rule ; dmc:realizationOwnerStanding ?owner . FILTER(?owner IN ("FAIL","BUILD_BROKEN","BLOCKED")) } GROUP BY ?controller ?rule HAVING(COUNT(?r)>0)
