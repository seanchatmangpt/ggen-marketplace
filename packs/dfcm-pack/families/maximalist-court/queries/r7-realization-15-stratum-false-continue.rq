PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?stratum (SUM(IF(?decision="CONTINUE" && ?value<=0,1,0))/COUNT(?o) AS ?falseContinueRate) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:stratum ?stratum ; dmc:realizedDecision ?decision ; dmc:observedNetValue ?value ; dmc:currentGeneration true .
} GROUP BY ?stratum ORDER BY DESC(?falseContinueRate) ?stratum
