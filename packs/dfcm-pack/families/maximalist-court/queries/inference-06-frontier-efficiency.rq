PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ((?before - ?after) / IF(?cost > 0, ?cost, 1) AS ?frontierEfficiency) WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:frontierBefore ?before ; dmc:frontierAfter ?after ; dmc:experimentCost ?cost .
  FILTER(?before >= 0 && ?after >= 0 && ?cost >= 0)
} ORDER BY DESC(?frontierEfficiency)
