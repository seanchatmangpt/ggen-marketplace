PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?before ?after WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:frontierBefore ?before ; dmc:frontierAfter ?after ; dmc:currentGeneration true .
  FILTER(?after < ?before)
} ORDER BY (?after - ?before) ?experiment
