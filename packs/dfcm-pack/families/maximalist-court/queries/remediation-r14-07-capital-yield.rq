PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate ((xsd:decimal(?capacity) + xsd:decimal(?relief) + xsd:decimal(?gain)) / (1 + xsd:decimal(?rollback) + xsd:decimal(?authority))) AS ?yield WHERE {
  ?candidate a dmc:RemediationCandidate ; dmc:futureManufacturingCapacity ?capacity ; dmc:expectedRelief ?relief ; dmc:informationGain ?gain ; dmc:rollbackCost ?rollback ; dmc:authorityCost ?authority .
} ORDER BY DESC(?yield) ?candidate
