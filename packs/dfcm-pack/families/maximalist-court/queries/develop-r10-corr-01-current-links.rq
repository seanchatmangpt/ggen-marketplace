PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?link ?controller ?pack ?rule WHERE {
 ?link a dmc:ControllerGenerationCorrespondence ; dmc:correspondenceControllerDigest ?controller ; dmc:correspondenceCapabilityPack ?pack ; dmc:correspondenceCapabilityRule ?rule ; dmc:correspondenceCurrent true .
} ORDER BY ?controller ?pack ?rule ?link
