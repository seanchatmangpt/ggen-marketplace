PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?current (AVG(xsd:decimal(?loss)) AS ?meanLoss) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:decisionLoss ?loss ; dmc:currentGeneration ?current .
} GROUP BY ?current ORDER BY DESC(?current)
