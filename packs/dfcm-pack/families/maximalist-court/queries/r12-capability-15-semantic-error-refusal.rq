PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?c ?error ?maximum WHERE {
 ?c a dmc:ControllerGenerationCapability ; dmc:capabilityControllerDigest ?controller ; dmc:capabilityRule ?rule ; dmc:capabilityMaxSemanticMismatchRate ?maximum .
 { SELECT ?controller ?rule (AVG(IF(?expected=?actual,0,1)) AS ?error) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationControllerDigest ?controller ; dmc:realizationCapabilityRule ?rule ; dmc:realizationExpectedSemanticDigest ?expected ; dmc:realizationActualSemanticDigest ?actual . } GROUP BY ?controller ?rule }
 FILTER(?error > ?maximum)
}
