PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index ?step ?candidate WHERE {
  ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:candidate ?candidate .
  ?candidate dmc:requiresReceipt true .
  FILTER NOT EXISTS { ?step dmc:receiptDigest ?receipt }
} ORDER BY ?sequence ?index
