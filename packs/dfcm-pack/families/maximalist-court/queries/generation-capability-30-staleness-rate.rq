PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (AVG(IF(?current,0.0,1.0)) AS ?stalenessRate) WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityCurrent ?current .
} GROUP BY ?pack ?rule ORDER BY DESC(?stalenessRate) ?pack ?rule
