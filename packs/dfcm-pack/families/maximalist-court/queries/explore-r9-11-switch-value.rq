PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?switched (COUNT(?obs) AS ?support) (AVG(xsd:decimal(?value)) AS ?meanValue) WHERE {
  ?obs a dmc:PolicyCalibrationObservation ; dmc:policySwitch ?switched ; dmc:observedNetValue ?value ; dmc:currentGeneration true .
} GROUP BY ?switched ORDER BY DESC(?switched)
