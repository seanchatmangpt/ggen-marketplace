PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence (COUNT(?step) AS ?falseContinues) WHERE {
  ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:policyDecision "CONTINUE" ; dmc:realizedGain ?gain ; dmc:stepCost ?cost .
  FILTER((?gain - ?cost) <= 0)
} GROUP BY ?sequence ORDER BY DESC(?falseContinues)
