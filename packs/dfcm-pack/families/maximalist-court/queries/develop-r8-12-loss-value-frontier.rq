PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?o ?decision ?value ?loss WHERE { ?o a dmc:PolicyCalibrationObservation ; dmc:realizedDecision ?decision ; dmc:observedNetValue ?value ; dmc:decisionLoss ?loss ; dmc:currentGeneration true . FILTER(xsd:decimal(?value) > 0 && xsd:decimal(?loss) <= 0.2) } ORDER BY DESC(?value) ?loss
