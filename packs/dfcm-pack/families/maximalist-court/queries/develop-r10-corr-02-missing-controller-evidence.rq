PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?link ?controller WHERE {
 ?link a dmc:ControllerGenerationCorrespondence ; dmc:correspondenceControllerDigest ?controller ; dmc:correspondenceCurrent true .
 FILTER NOT EXISTS { ?obs a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?controller ; dmc:currentGeneration true }
} ORDER BY ?controller ?link
