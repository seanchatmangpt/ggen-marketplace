PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?r ?rule ?output ?digest ?receipt WHERE {
  ?r a dmc:GenerationRealization ; dmc:realizesRule ?rule ; dmc:realizationState "PASS" ; dmc:outputCurrent true ; dmc:deterministicReplay true ; dmc:outputCollision false ; dmc:realizedOutput ?output ; dmc:realizedOutputDigest ?digest ; dmc:receiptDigest ?receipt ; dmc:realizationAuthority "OBSERVE|VERIFY" ; dmc:actuationPerformed false .
} ORDER BY ?rule ?output
