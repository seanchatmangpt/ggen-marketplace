PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?stratum (AVG(xsd:decimal(?loss)) AS ?meanLoss) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:stratum ?stratum ; dmc:decisionLoss ?loss ; dmc:currentGeneration true .
} GROUP BY ?stratum ORDER BY DESC(?meanLoss) ?stratum
