PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (COUNT(?obs) AS ?collisions) WHERE {
 ?obs a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityCollision true .
} GROUP BY ?pack ?rule HAVING(COUNT(?obs) > 0) ORDER BY DESC(?collisions) ?pack ?rule
