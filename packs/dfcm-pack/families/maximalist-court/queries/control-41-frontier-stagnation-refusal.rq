PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?gain ?before ?after WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:realizedInformationGain ?gain ; dmc:frontierBefore ?before ; dmc:frontierAfter ?after ; dmc:currentGeneration true .
  FILTER(?gain > 0 && ?after >= ?before)
} ORDER BY DESC(?gain) ?experiment
