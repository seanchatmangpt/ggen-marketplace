PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?rule ?name (COUNT(DISTINCT ?required) AS ?requiredCount) (COUNT(DISTINCT ?projected) AS ?projectedCount) WHERE {
  ?rule a dmc:GenerationRule ; dmc:ruleName ?name .
  OPTIONAL { ?rule dmc:requiredVariable ?required }
  OPTIONAL { ?rule dmc:projectedVariable ?projected }
}
GROUP BY ?rule ?name
ORDER BY DESC(?requiredCount) ?name
