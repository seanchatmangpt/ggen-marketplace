PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?c ?controller ?rule ?support ?minimum WHERE {
 ?c a dmc:ControllerGenerationCapability ; dmc:capabilityControllerDigest ?controller ; dmc:capabilityRule ?rule ; dmc:capabilityMinSupport ?minimum .
 { SELECT ?controller ?rule (COUNT(?r) AS ?support) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationControllerDigest ?controller ; dmc:realizationCapabilityRule ?rule . } GROUP BY ?controller ?rule }
 FILTER(?support < ?minimum)
}
