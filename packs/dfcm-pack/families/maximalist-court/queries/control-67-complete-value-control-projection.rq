PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?predicted ?realized ?cost
       ((?realized - ?cost) AS ?netValue)
       (ABS(?predicted - ?realized) AS ?absoluteError)
       ((?predicted - ?realized) AS ?signedBias)
WHERE {
  ?experiment a dmc:ExperimentRealization ;
              dmc:currentGeneration true ;
              dmc:predictedInformationGain ?predicted ;
              dmc:realizedInformationGain ?realized ;
              dmc:experimentCost ?cost .
}
ORDER BY DESC(?netValue) ASC(?absoluteError) ?experiment
