PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT (AVG(IF(?terminal && ?decision="STOP" && ?value<=0,1,0)) AS ?terminalStopQuality) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:sequenceTerminal ?terminal ; dmc:realizedDecision ?decision ; dmc:observedNetValue ?value ; dmc:currentGeneration true .
}
