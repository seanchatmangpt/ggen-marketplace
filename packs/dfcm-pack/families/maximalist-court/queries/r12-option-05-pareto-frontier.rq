PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?reuse ?delta ?reversibility WHERE { ?candidate a dmc:ExecutableCandidate ; dmc:nonDominated true ; dmc:expectedReuse ?reuse ; dmc:expectedCapabilitySpaceDelta ?delta ; dmc:reversibility ?reversibility . } ORDER BY DESC(?delta) DESC(?reuse)
