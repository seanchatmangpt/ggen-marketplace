PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack (COUNT(?required) AS ?required) (COUNT(?missing) AS ?missing) WHERE {
  ?rule a dmc:GenerationRule ; dmc:sourcePack ?pack .
  OPTIONAL { ?rule dmc:requiredVariable ?required }
  OPTIONAL { ?rule dmc:missingVariable ?missing }
} GROUP BY ?pack ORDER BY DESC(?missing) ?pack
