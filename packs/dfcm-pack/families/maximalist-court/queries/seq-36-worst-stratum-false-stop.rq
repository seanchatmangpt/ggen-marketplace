PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?stratum (COUNT(?step) AS ?falseStops) WHERE {
  ?step a dmc:ExperimentStep ; dmc:stratum ?stratum ; dmc:policyDecision "STOP" ; dmc:realizedGain ?gain ; dmc:stepCost ?cost .
  FILTER((?gain - ?cost) > 0)
} GROUP BY ?stratum ORDER BY DESC(?falseStops)
