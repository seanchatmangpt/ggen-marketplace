PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?family (SUM(IF(?decision="STOP" && ?value>0,1,0))/COUNT(?o) AS ?falseStopRate) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:candidate ?candidate ; dmc:realizedDecision ?decision ; dmc:observedNetValue ?value ; dmc:currentGeneration true .
 ?candidate dmc:family ?family .
} GROUP BY ?family ORDER BY DESC(?falseStopRate) ?family
