PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (COUNT(?o) AS ?support) WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityCurrent true ; dmc:capabilityDeterministic true .
} GROUP BY ?pack ?rule ORDER BY ?support ?pack ?rule
