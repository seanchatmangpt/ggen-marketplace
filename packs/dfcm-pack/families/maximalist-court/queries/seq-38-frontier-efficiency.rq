PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index ?step ((?before - ?after) / ?cost AS ?frontierImprovementPerCost) WHERE {
  ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:frontierBefore ?before ; dmc:frontierAfter ?after ; dmc:stepCost ?cost .
  FILTER(?cost > 0 && ?after < ?before)
} ORDER BY DESC(?frontierImprovementPerCost)
