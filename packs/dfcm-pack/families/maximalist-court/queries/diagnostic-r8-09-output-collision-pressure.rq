PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?output (COUNT(DISTINCT ?rule) AS ?ruleCount) (GROUP_CONCAT(DISTINCT ?name; separator=",") AS ?rules) WHERE {
  ?rule a dmc:GenerationRule ; dmc:ruleName ?name ; dmc:outputFile ?output .
}
GROUP BY ?output
HAVING (COUNT(DISTINCT ?rule) > 1)
ORDER BY DESC(?ruleCount) ?output
