PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?output ?ruleCount ?rules WHERE {
  {
    SELECT ?output (COUNT(DISTINCT ?rule) AS ?ruleCount) (GROUP_CONCAT(DISTINCT ?name; separator=",") AS ?rules)
    WHERE {
      {
        SELECT ?rule ?name ?output
        WHERE {
          ?rule a dmc:GenerationRule ; dmc:ruleName ?name ; dmc:outputFile ?output .
        }
        ORDER BY ?name
      }
    }
    GROUP BY ?output
    HAVING (COUNT(DISTINCT ?rule) > 1)
  }
}
ORDER BY DESC(?ruleCount) ?output
