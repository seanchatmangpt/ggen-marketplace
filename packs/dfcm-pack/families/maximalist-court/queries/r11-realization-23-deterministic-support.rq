PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller ?rule (COUNT(?r) AS ?support) WHERE {
  ?r a dmc:ControllerGenerationRealization ;
     dmc:realizationControllerDigest ?controller ;
     dmc:realizationCapabilityRule ?rule ;
     dmc:realizationDeterministic true .
} GROUP BY ?controller ?rule ORDER BY DESC(?support) ?controller ?rule
