PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (AVG(IF(?current,1.0,0.0)) AS ?currentRate) WHERE {
 ?obs a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityCurrent ?current .
} GROUP BY ?pack ?rule HAVING(COUNT(?obs) >= 5 && AVG(IF(?current,1.0,0.0)) >= 0.95) ORDER BY DESC(?currentRate) ?pack ?rule
