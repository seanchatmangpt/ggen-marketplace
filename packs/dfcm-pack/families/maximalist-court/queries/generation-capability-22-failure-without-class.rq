PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?o ?pack ?rule WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilitySuccess false .
  FILTER NOT EXISTS { ?o dmc:capabilityFailureClass ?failureClass }
} ORDER BY ?pack ?rule ?o
