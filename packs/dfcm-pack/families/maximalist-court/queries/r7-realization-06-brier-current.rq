PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (AVG((xsd:decimal(?p)-IF(?decision="STOP",1,0))*(xsd:decimal(?p)-IF(?decision="STOP",1,0))) AS ?brier) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:predictedStopProbability ?p ; dmc:realizedDecision ?decision ; dmc:currentGeneration true .
}
