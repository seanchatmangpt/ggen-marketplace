PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller ?rule (COUNT(DISTINCT ?actual) AS ?outputs) WHERE {
  ?r a dmc:ControllerGenerationRealization ;
     dmc:realizationControllerDigest ?controller ;
     dmc:realizationCapabilityRule ?rule ;
     dmc:realizationActualOutputDigest ?actual ;
     dmc:realizationCurrent true .
} GROUP BY ?controller ?rule
HAVING(COUNT(DISTINCT ?actual) > 1)
