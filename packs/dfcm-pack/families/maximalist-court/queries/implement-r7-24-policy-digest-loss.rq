PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?digest (AVG(xsd:decimal(?loss)) AS ?meanLoss) WHERE { ?obs a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?digest ; dmc:decisionLoss ?loss . } GROUP BY ?digest HAVING(AVG(xsd:decimal(?loss)) > 0)
