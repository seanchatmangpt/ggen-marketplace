PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?rollback ?evidence ?novelty WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:rollbackCost ?rollback ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty .
  FILTER(?family IN ("bandit", "mcts"))
}
ORDER BY ?family
