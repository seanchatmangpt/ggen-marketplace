PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (COUNT(?o) AS ?unstableSwitches) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:policySwitch true ; dmc:observedNetValue ?value ; dmc:decisionLoss ?loss ; dmc:currentGeneration true .
 FILTER(ABS(xsd:decimal(?value)) < 0.05 && xsd:decimal(?loss) > 0)
}
