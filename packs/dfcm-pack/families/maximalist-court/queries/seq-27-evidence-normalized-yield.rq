PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate (AVG(?gain / ?evidence) AS ?evidenceNormalizedGain) WHERE {
  ?step a dmc:ExperimentStep ; dmc:candidate ?candidate ; dmc:realizedGain ?gain .
  ?candidate dmc:ctqEvidence ?evidence .
  FILTER(?evidence > 0)
} GROUP BY ?candidate ORDER BY DESC(?evidenceNormalizedGain)
