PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index ?step (ABS(?predicted - ?realized) AS ?absoluteError) WHERE {
  ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:predictedGain ?predicted ; dmc:realizedGain ?realized .
} ORDER BY DESC(?absoluteError)
