PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?c ?rate ?maximum WHERE {
 ?c a dmc:ControllerGenerationCapability ; dmc:capabilityControllerDigest ?controller ; dmc:capabilityMaxFalseContinueRate ?maximum .
 { SELECT ?controller (AVG(IF(?decision="CONTINUE" && xsd:decimal(?value)<=0,1,0)) AS ?rate) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationControllerDigest ?controller ; dmc:realizationControllerDecision ?decision ; dmc:realizationNetValue ?value . } GROUP BY ?controller }
 FILTER(?rate > ?maximum)
}
