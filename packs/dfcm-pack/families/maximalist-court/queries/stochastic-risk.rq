PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?rollback ?evidence ?falsifier WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:deterministic false ; dmc:rollbackCost ?rollback ; dmc:ctqEvidence ?evidence ; dmc:falsifier ?falsifier .
}
ORDER BY DESC(?rollback) ?evidence ?family
