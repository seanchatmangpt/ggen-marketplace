PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?bin (AVG(?p) AS ?meanPredicted) (AVG(?y) AS ?observedStopRate) (COUNT(?o) AS ?support) WHERE {
  ?o a dmc:PolicyCalibrationObservation ; dmc:predictedStopProbability ?p ; dmc:realizedDecision ?d .
  BIND(FLOOR(?p * 10) AS ?bin)
  BIND(IF(?d = "STOP", 1.0, 0.0) AS ?y)
} GROUP BY ?bin ORDER BY ?bin
