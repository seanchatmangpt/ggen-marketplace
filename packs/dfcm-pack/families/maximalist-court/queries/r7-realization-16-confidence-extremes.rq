PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (COUNT(?o) AS ?extremeErrors) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:predictedStopProbability ?p ; dmc:realizedDecision ?d ; dmc:currentGeneration true .
 FILTER((xsd:decimal(?p)>=0.9 && ?d="CONTINUE") || (xsd:decimal(?p)<=0.1 && ?d="STOP"))
}
