PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate WHERE {
  ?candidate a dmc:RemediationCandidate ; dmc:repairQuery ?query ; dmc:repairTemplate ?template ; dmc:repairOutput ?output .
  FILTER(STRLEN(STR(?query)) > 0 && STRLEN(STR(?template)) > 0 && STRLEN(STR(?output)) > 0)
}
ORDER BY ?candidate
