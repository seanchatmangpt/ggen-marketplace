PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?c ?observed ?maximum WHERE {
 ?c a dmc:ControllerGenerationCapability ; dmc:capabilityControllerDigest ?controller ; dmc:capabilityRule ?rule ; dmc:capabilityMaxLatencyMs ?maximum .
 { SELECT ?controller ?rule (MAX(?latency) AS ?observed) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationControllerDigest ?controller ; dmc:realizationCapabilityRule ?rule ; dmc:realizationLatencyMs ?latency . } GROUP BY ?controller ?rule }
 FILTER(?observed > ?maximum)
}
