PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index ?step (?alternative - (?gain - ?cost) AS ?observedRegret) WHERE {
  ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:realizedGain ?gain ; dmc:stepCost ?cost ; dmc:observedAlternative ?alternative .
  FILTER(?alternative > (?gain - ?cost))
} ORDER BY DESC(?observedRegret)
