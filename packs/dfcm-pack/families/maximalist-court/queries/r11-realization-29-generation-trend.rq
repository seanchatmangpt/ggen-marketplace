PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?generation (COUNT(?r) AS ?support) (AVG(?value) AS ?meanNetValue) WHERE {
  ?r a dmc:ControllerGenerationRealization ;
     dmc:realizationGeneration ?generation ;
     dmc:realizationNetValue ?value .
} GROUP BY ?generation ORDER BY ?generation
