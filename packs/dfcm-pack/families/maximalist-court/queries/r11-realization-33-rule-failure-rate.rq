PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?rule ?failure (COUNT(?r) AS ?count) WHERE {
  ?r a dmc:ControllerGenerationRealization ;
     dmc:realizationCapabilityRule ?rule ;
     dmc:realizationFailureClass ?failure .
  FILTER(?failure != "NONE")
} GROUP BY ?rule ?failure ORDER BY DESC(?count) ?rule ?failure
