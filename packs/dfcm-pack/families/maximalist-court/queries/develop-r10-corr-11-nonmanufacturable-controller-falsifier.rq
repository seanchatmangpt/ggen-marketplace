PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT DISTINCT ?controller WHERE {
 ?p a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?controller ; dmc:currentGeneration true ; dmc:receiptDigest ?policyReceipt .
 FILTER NOT EXISTS {
   ?link a dmc:ControllerGenerationCorrespondence ; dmc:correspondenceControllerDigest ?controller ; dmc:correspondenceCapabilityPack ?pack ; dmc:correspondenceCapabilityRule ?rule ; dmc:correspondenceCurrent true ; dmc:correspondenceReceiptDigest ?corrReceipt .
   ?g a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityCurrent true ; dmc:capabilitySuccess true ; dmc:capabilityDeterministic true ; dmc:capabilityReceiptDigest ?genReceipt .
 }
} ORDER BY ?controller
