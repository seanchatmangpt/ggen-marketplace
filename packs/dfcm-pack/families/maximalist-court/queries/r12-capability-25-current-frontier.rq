PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?c ?controller ?rule ?generation WHERE { ?c a dmc:ControllerGenerationCapability ; dmc:capabilityControllerDigest ?controller ; dmc:capabilityRule ?rule ; dmc:capabilityGeneration ?generation ; dmc:capabilityCurrent true . } ORDER BY ?controller ?rule ?generation
