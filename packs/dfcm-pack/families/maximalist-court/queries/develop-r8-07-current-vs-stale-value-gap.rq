PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?current (COUNT(?o) AS ?support) (AVG(xsd:decimal(?value)) AS ?meanValue) WHERE { ?o a dmc:PolicyCalibrationObservation ; dmc:currentGeneration ?current ; dmc:observedNetValue ?value . } GROUP BY ?current ORDER BY DESC(?current)
