PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?standing ?evidence ?novelty ?rollback WHERE { ?candidate a dmc:Candidate ; dmc:standing ?standing ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty ; dmc:rollbackCost ?rollback . FILTER(CONTAINS(UCASE(STR(?standing)), "PARTIAL_ALIVE")) } ORDER BY DESC(?evidence) DESC(?novelty) ?rollback ?candidate
