PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?novelty ?rollback ?efficiency WHERE {
  ?candidate a dmc:Candidate ; dmc:ctqNovelty ?novelty ; dmc:rollbackCost ?rollback .
  FILTER(?rollback > 0)
  BIND(?novelty / ?rollback AS ?efficiency)
}
ORDER BY DESC(?efficiency) ?candidate
