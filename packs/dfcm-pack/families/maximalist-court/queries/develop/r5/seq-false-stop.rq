PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index ?step WHERE { ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:policyDecision ?decision ; dmc:realizedGain ?gain ; dmc:stepCost ?cost . FILTER(UCASE(STR(?decision)) = "STOP" && ?gain > ?cost) } ORDER BY ?sequence ?index
