PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence (COUNT(?step) AS ?continues) WHERE { ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:policyDecision ?decision . FILTER(UCASE(STR(?decision)) = "CONTINUE") } GROUP BY ?sequence ORDER BY DESC(?continues) ?sequence
