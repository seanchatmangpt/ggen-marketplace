PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?evidence ?novelty ?rollback WHERE {
  ?candidate a dmc:Candidate ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty ; dmc:rollbackCost ?rollback .
  FILTER(?evidence >= 5 && ?novelty >= 3 && ?rollback <= 2)
  FILTER EXISTS { ?candidate dmc:requiresReceipt true }
  FILTER EXISTS { ?candidate dmc:assumption ?a }
  FILTER EXISTS { ?candidate dmc:falsifier ?f }
}
ORDER BY DESC(?evidence) DESC(?novelty) ?rollback ?candidate
