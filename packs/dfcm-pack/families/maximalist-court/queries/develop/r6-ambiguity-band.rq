PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?left ?right ?leftScore ?rightScore (ABS(?leftScore - ?rightScore) AS ?gap)
WHERE {
  { SELECT ?left ((?le + ?ln) / (?lr + 1) AS ?leftScore) WHERE { ?left a dmc:Candidate ; dmc:ctqEvidence ?le ; dmc:ctqNovelty ?ln ; dmc:rollbackCost ?lr . } }
  { SELECT ?right ((?re + ?rn) / (?rr + 1) AS ?rightScore) WHERE { ?right a dmc:Candidate ; dmc:ctqEvidence ?re ; dmc:ctqNovelty ?rn ; dmc:rollbackCost ?rr . } }
  FILTER(STR(?left) < STR(?right) && ABS(?leftScore - ?rightScore) <= 0.25)
}
ORDER BY ?gap ?left ?right
