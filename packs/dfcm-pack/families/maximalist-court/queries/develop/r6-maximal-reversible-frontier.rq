PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?novelty ?rollback
WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty ; dmc:rollbackCost ?rollback .
  FILTER NOT EXISTS {
    ?other a dmc:Candidate ; dmc:ctqEvidence ?oe ; dmc:ctqNovelty ?on ; dmc:rollbackCost ?or .
    FILTER(?other != ?candidate && ?oe >= ?evidence && ?on >= ?novelty && ?or <= ?rollback && (?oe > ?evidence || ?on > ?novelty || ?or < ?rollback))
  }
}
ORDER BY ?rollback DESC(?evidence) DESC(?novelty) ?candidate
