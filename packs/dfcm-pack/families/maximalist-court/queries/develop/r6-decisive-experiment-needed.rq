PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?evidence ?novelty ?rollback
WHERE {
  ?candidate a dmc:Candidate ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty ; dmc:rollbackCost ?rollback .
  FILTER(?evidence < 3 || ABS(?evidence - ?novelty) <= 1)
}
ORDER BY ?evidence ?rollback DESC(?novelty) ?candidate
