PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?rollback (?evidence / ?rollback AS ?density)
WHERE { ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:rollbackCost ?rollback . FILTER(?rollback > 0) }
ORDER BY DESC(?density) ?family ?candidate
