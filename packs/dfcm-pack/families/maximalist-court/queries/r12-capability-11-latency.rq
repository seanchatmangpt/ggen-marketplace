PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller ?rule (AVG(?latency) AS ?meanLatencyMs) (MAX(?latency) AS ?maxLatencyMs) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationControllerDigest ?controller ; dmc:realizationCapabilityRule ?rule ; dmc:realizationLatencyMs ?latency . } GROUP BY ?controller ?rule
