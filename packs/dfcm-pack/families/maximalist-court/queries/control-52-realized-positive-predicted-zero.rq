PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?realized ?cost WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:currentGeneration true ; dmc:predictedInformationGain 0 ; dmc:realizedInformationGain ?realized ; dmc:experimentCost ?cost .
  FILTER(?realized > 0)
} ORDER BY DESC(?realized) ?experiment
