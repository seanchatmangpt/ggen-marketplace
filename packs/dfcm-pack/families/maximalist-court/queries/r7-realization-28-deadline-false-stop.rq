PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (COUNT(?o) AS ?deadlineFalseStops) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:realizedDecision "STOP" ; dmc:observedNetValue ?value ; dmc:deadlineMs ?deadline ; dmc:stepLatencyMs ?latency ; dmc:currentGeneration true .
 FILTER(xsd:decimal(?latency) <= xsd:decimal(?deadline) && xsd:decimal(?value) > 0)
}
