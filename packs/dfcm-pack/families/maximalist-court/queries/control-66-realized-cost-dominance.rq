PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?dominator ?dominated ?gainA ?gainB ?costA ?costB WHERE {
  ?dominator a dmc:ExperimentRealization ; dmc:currentGeneration true ; dmc:realizedInformationGain ?gainA ; dmc:experimentCost ?costA .
  ?dominated a dmc:ExperimentRealization ; dmc:currentGeneration true ; dmc:realizedInformationGain ?gainB ; dmc:experimentCost ?costB .
  FILTER(?dominator != ?dominated)
  FILTER(?gainA >= ?gainB && ?costA <= ?costB)
  FILTER(?gainA > ?gainB || ?costA < ?costB)
} ORDER BY ?dominated ?dominator
