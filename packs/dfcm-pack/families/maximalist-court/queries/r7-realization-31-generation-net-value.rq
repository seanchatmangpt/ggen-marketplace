PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?generation (COUNT(?o) AS ?support) (AVG(xsd:decimal(?value)) AS ?meanNetValue) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:policyGeneration ?generation ; dmc:observedNetValue ?value .
} GROUP BY ?generation ORDER BY DESC(?generation)
