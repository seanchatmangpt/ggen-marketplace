PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?novelty ((?evidence + ?novelty) AS ?balance) WHERE { ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty . } ORDER BY DESC(?balance) DESC(?evidence) STR(?candidate)
