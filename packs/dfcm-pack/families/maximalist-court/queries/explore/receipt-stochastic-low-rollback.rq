PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?rollback ?novelty
WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:requiresReceipt true ; dmc:deterministic false ; dmc:rollbackCost ?rollback ; dmc:ctqNovelty ?novelty .
  FILTER(?rollback <= 2)
}
ORDER BY DESC(?novelty) ?family ?candidate
