PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?family (MAX(?evidence) AS ?bestEvidence) (MAX(?novelty) AS ?bestNovelty) WHERE { ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty . } GROUP BY ?family ORDER BY DESC(?bestEvidence) DESC(?bestNovelty)