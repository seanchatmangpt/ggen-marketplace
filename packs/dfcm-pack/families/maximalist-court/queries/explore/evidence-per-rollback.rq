PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?rollback ((?evidence / (?rollback + 1)) AS ?ratio) WHERE { ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:rollbackCost ?rollback . } ORDER BY DESC(?ratio) STR(?candidate)
