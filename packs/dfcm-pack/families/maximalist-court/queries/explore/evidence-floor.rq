PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?rollback
WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:rollbackCost ?rollback .
  FILTER(?evidence >= 7)
}
ORDER BY DESC(?evidence) ?rollback ?family ?candidate
