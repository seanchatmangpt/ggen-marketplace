PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?rollback ?evidence
WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:requiresReceipt true ; dmc:deterministic true ; dmc:rollbackCost ?rollback ; dmc:ctqEvidence ?evidence .
  FILTER(?rollback <= 1)
}
ORDER BY DESC(?evidence) ?family ?candidate
