PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?digest (COUNT(?obs) AS ?support) WHERE {
 ?obs a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?digest ; dmc:counterfactualObserved true ; dmc:currentGeneration true .
} GROUP BY ?digest HAVING(COUNT(?obs) >= 3) ORDER BY DESC(?support) ?digest
