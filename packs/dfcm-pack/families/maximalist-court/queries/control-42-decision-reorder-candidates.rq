PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?predicted ?realized ?cost WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:predictedInformationGain ?predicted ; dmc:realizedInformationGain ?realized ; dmc:experimentCost ?cost ; dmc:currentGeneration true .
  FILTER((?predicted > 0 && ?realized = 0) || (?realized - ?cost < 0))
} ORDER BY DESC(?predicted) ?experiment
