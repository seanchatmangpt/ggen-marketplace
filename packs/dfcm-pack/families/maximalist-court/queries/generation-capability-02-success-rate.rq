PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (AVG(IF(?ok,1.0,0.0)) AS ?successRate) WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilitySuccess ?ok .
} GROUP BY ?pack ?rule ORDER BY ?successRate ?pack ?rule
