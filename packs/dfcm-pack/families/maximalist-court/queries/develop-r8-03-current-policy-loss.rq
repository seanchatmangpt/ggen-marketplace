PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?digest (COUNT(?o) AS ?support) (AVG(xsd:decimal(?loss)) AS ?meanLoss) WHERE { ?o a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?digest ; dmc:decisionLoss ?loss ; dmc:currentGeneration true . } GROUP BY ?digest ORDER BY ?meanLoss
