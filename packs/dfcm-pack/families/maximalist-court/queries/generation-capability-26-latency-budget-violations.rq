PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?o ?pack ?rule ?latency WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityLatencyMs ?latency .
  FILTER(?latency > 30000)
} ORDER BY DESC(?latency) ?pack ?rule
