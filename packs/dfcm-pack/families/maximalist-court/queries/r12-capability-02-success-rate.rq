PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller ?rule (AVG(IF(?standing="PASS",1,0)) AS ?successRate) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationControllerDigest ?controller ; dmc:realizationCapabilityRule ?rule ; dmc:realizationStanding ?standing . } GROUP BY ?controller ?rule
