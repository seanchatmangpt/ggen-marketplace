PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?plan WHERE {
  ?plan a dmc:RemediationPlan ; dmc:planDigest ?digest ; dmc:sourceSubject ?subject ; dmc:ggenSubject ?ggen ; dmc:authority ?authority ; dmc:actuationPerformed false .
  FILTER(STRLEN(STR(?digest)) = 64 && STRLEN(STR(?subject)) > 40 && STRLEN(STR(?ggen)) > 40)
  FILTER(STR(?authority) != "DO")
}
ORDER BY ?plan
