PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?rule ?name WHERE {
  ?rule a dmc:GenerationRule ; dmc:ruleName ?name .
  FILTER (
    NOT EXISTS { ?rule dmc:queryDigest ?qd } ||
    NOT EXISTS { ?rule dmc:templateDigest ?td } ||
    NOT EXISTS { ?rule dmc:contextDigest ?cd }
  )
}
ORDER BY ?name
