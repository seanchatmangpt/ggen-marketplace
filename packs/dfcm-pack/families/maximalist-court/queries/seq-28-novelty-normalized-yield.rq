PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate (AVG(?gain / ?novelty) AS ?noveltyNormalizedGain) WHERE {
  ?step a dmc:ExperimentStep ; dmc:candidate ?candidate ; dmc:realizedGain ?gain .
  ?candidate dmc:ctqNovelty ?novelty .
  FILTER(?novelty > 0)
} GROUP BY ?candidate ORDER BY DESC(?noveltyNormalizedGain)
