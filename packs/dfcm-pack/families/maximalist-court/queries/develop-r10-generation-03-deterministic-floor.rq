PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (AVG(IF(?det,1.0,0.0)) AS ?deterministicRate) WHERE {
 ?obs a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityDeterministic ?det .
} GROUP BY ?pack ?rule HAVING(COUNT(?obs) >= 5 && AVG(IF(?det,1.0,0.0)) = 1.0) ORDER BY ?pack ?rule
