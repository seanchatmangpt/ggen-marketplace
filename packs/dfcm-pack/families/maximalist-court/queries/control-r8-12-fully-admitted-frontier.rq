PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?rule ?name ?mode ?subject WHERE {
  ?rule a dmc:GenerationRule ; dmc:ruleName ?name ; dmc:generationMode ?mode ; dmc:exactSubject ?subject ; dmc:currentGeneration true ; dmc:queryDigest ?qd ; dmc:templateDigest ?td ; dmc:contextDigest ?cd ; dmc:sourcePack ?pack ; dmc:queryFile ?q ; dmc:templateFile ?t ; dmc:outputFile ?o .
  FILTER NOT EXISTS { ?rule dmc:missingVariable ?missing }
}
ORDER BY ?name
