PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate ?relief WHERE {
  ?candidate a dmc:RemediationCandidate ; dmc:expectedRelief ?relief .
  FILTER(xsd:decimal(?relief) > 0)
}
ORDER BY DESC(xsd:decimal(?relief)) ?candidate
