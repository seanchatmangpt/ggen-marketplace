PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate WHERE { ?candidate a dmc:ExecutableCandidate ; dmc:executable true ; dmc:nonDominated true ; dmc:authority "CONSTRUCT|VERIFY" ; dmc:actuationPerformed false ; dmc:standing "PASS" ; dmc:receiptDigest ?receipt . } ORDER BY ?candidate
