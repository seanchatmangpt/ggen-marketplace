PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?step ?sha ?digest WHERE {
  ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:subjectSha ?sha ; dmc:semanticDigest ?digest .
  FILTER(!regex(str(?sha), "^[0-9a-f]{40}$") || !regex(str(?digest), "^[0-9a-f]{64}$"))
} ORDER BY ?sequence ?step
