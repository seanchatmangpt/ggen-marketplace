PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?predicted ?realized (ABS(?predicted - ?realized) AS ?absoluteError) WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:currentGeneration true ; dmc:predictedInformationGain ?predicted ; dmc:realizedInformationGain ?realized .
} ORDER BY DESC(?absoluteError) ?experiment LIMIT 1
