PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?rule (AVG(IF(?current && ?det,1.0,0.0)) AS ?currentDeterministicRate) WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityRule ?rule ; dmc:capabilityCurrent ?current ; dmc:capabilityDeterministic ?det .
} GROUP BY ?rule ORDER BY ?currentDeterministicRate ?rule
