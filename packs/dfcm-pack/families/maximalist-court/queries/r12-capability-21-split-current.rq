PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller ?rule ?generation (COUNT(?c) AS ?models) WHERE { ?c a dmc:ControllerGenerationCapability ; dmc:capabilityControllerDigest ?controller ; dmc:capabilityRule ?rule ; dmc:capabilityGeneration ?generation ; dmc:capabilityCurrent true . } GROUP BY ?controller ?rule ?generation HAVING(COUNT(?c)>1)
