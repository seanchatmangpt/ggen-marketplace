PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?digest (COUNT(?obs) AS ?support) (AVG(xsd:decimal(?value)) AS ?meanValue) WHERE {
  ?obs a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?digest ; dmc:observedNetValue ?value ; dmc:currentGeneration true .
} GROUP BY ?digest ORDER BY DESC(?meanValue) ?digest
