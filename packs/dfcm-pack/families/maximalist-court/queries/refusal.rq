PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?falsifier ?evidence WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:falsifier ?falsifier ; dmc:ctqEvidence ?evidence .
  FILTER(CONTAINS(LCASE(STR(?family)), "refusal") || CONTAINS(LCASE(STR(?falsifier)), "unadmitted"))
}
