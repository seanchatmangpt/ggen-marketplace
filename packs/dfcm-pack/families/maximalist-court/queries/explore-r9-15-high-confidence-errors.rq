PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?obs ?p ?decision ?value WHERE {
  ?obs a dmc:PolicyCalibrationObservation ; dmc:predictedStopProbability ?p ; dmc:realizedDecision ?decision ; dmc:observedNetValue ?value ; dmc:currentGeneration true .
  FILTER((xsd:decimal(?p) >= 0.9 && ?decision = "STOP" && ?value > 0) || (xsd:decimal(?p) <= 0.1 && ?decision = "CONTINUE" && ?value <= 0))
} ORDER BY DESC(?p) ?obs
