PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (AVG(IF(?collision,1.0,0.0)) AS ?collisionRate) WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityCollision ?collision .
} GROUP BY ?pack ?rule ORDER BY DESC(?collisionRate) ?pack ?rule
