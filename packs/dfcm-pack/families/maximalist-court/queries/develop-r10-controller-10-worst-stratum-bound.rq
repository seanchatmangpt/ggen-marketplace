PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?digest ?stratum (AVG(xsd:decimal(?loss)) AS ?meanLoss) WHERE {
 ?obs a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?digest ; dmc:calibrationLabel ?stratum ; dmc:decisionLoss ?loss ; dmc:currentGeneration true .
} GROUP BY ?digest ?stratum HAVING(COUNT(?obs) >= 3 && AVG(xsd:decimal(?loss)) <= 0.3) ORDER BY ?digest DESC(?meanLoss) ?stratum
