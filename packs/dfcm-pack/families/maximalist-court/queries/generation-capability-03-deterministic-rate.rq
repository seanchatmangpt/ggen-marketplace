PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (AVG(IF(?det,1.0,0.0)) AS ?deterministicRate) WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityDeterministic ?det .
} GROUP BY ?pack ?rule ORDER BY ?deterministicRate ?pack ?rule
