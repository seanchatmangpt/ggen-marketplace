PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?sha ?digest WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:subjectSha ?sha ; dmc:semanticDigest ?digest .
  FILTER(!regex(str(?sha),"^[0-9a-f]{40}$") || !regex(str(?digest),"^[0-9a-f]{64}$"))
} ORDER BY ?experiment
