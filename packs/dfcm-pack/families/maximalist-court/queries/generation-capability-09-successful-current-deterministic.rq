PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?o ?pack ?rule WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilitySuccess true ; dmc:capabilityDeterministic true ; dmc:capabilityCurrent true ; dmc:capabilityCollision false .
} ORDER BY ?pack ?rule ?o
