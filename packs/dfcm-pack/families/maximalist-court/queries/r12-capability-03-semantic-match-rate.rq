PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller ?rule (AVG(IF(?expected=?actual,1,0)) AS ?matchRate) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationControllerDigest ?controller ; dmc:realizationCapabilityRule ?rule ; dmc:realizationExpectedSemanticDigest ?expected ; dmc:realizationActualSemanticDigest ?actual . } GROUP BY ?controller ?rule
