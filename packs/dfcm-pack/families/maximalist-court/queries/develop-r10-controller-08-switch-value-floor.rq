PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?digest (AVG(xsd:decimal(?value)) AS ?switchValue) WHERE {
 ?obs a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?digest ; dmc:policySwitch true ; dmc:observedNetValue ?value ; dmc:currentGeneration true .
} GROUP BY ?digest HAVING(COUNT(?obs) >= 3 && AVG(xsd:decimal(?value)) > 0) ORDER BY DESC(?switchValue) ?digest
