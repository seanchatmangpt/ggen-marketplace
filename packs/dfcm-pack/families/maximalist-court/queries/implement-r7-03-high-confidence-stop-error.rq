PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?obs ?p ?loss WHERE {
  ?obs a dmc:PolicyCalibrationObservation ; dmc:predictedStopProbability ?p ; dmc:realizedDecision "STOP" ; dmc:decisionLoss ?loss .
  FILTER(xsd:decimal(?p) >= 0.9 && xsd:decimal(?loss) > 0)
}
