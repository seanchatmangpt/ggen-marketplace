PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (FLOOR(xsd:decimal(?p) * 10) AS ?bin) (COUNT(?obs) AS ?support) (AVG(xsd:decimal(?loss)) AS ?meanLoss) WHERE {
  ?obs a dmc:PolicyCalibrationObservation ; dmc:predictedStopProbability ?p ; dmc:decisionLoss ?loss ; dmc:currentGeneration true .
} GROUP BY (FLOOR(xsd:decimal(?p) * 10)) ORDER BY ?bin
