PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?family (AVG(?gain) AS ?meanGain) WHERE { ?r a dmc:ExperimentRealization ; dmc:experimentId ?id ; dmc:realizedInformationGain ?gain . ?c a dmc:Candidate ; dmc:family ?family . FILTER(CONTAINS(str(?id), str(?family))) } GROUP BY ?family ORDER BY DESC(?meanGain)
