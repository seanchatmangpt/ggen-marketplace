PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?family ?novelty (AVG(?gain) AS ?meanGain) WHERE { ?c a dmc:Candidate ; dmc:family ?family ; dmc:ctqNovelty ?novelty . ?r a dmc:ExperimentRealization ; dmc:experimentId ?id ; dmc:realizedInformationGain ?gain . FILTER(CONTAINS(str(?id),str(?family))) } GROUP BY ?family ?novelty ORDER BY DESC(?novelty)
