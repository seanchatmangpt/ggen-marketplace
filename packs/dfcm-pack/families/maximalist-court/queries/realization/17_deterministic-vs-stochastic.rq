PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?deterministic (AVG(?gain) AS ?meanGain) WHERE { ?c a dmc:Candidate ; dmc:deterministic ?deterministic ; dmc:family ?family . ?r a dmc:ExperimentRealization ; dmc:experimentId ?id ; dmc:realizedInformationGain ?gain . FILTER(CONTAINS(str(?id),str(?family))) } GROUP BY ?deterministic ORDER BY ?deterministic
