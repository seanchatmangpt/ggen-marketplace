PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?stratum (COUNT(?r) AS ?falseUseful) WHERE { ?r a dmc:ExperimentRealization ; dmc:stratum ?stratum ; dmc:predictedInformationGain ?predicted ; dmc:realizedInformationGain ?realized . FILTER(?predicted > 0 && ?realized = 0) } GROUP BY ?stratum ORDER BY DESC(?falseUseful)
