PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence (SUM(?gain - ?cost) AS ?currentNetValue) WHERE {
  ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:realizedGain ?gain ; dmc:stepCost ?cost ; dmc:currentGeneration true .
} GROUP BY ?sequence ORDER BY DESC(?currentNetValue)
