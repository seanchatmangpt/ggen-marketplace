def test_generated_selection_evidence_acquisition_boundary():
    plan = {
        "schema": "chatman.selection-evidence-acquisition/1",
        "source": "ontology.ttl",
        "experiment": "{{ results[0]["experiment"] }}",
        "authority": "SELECT",
        "actuation_performed": False,
    }
    assert plan["authority"] == "SELECT"
    assert plan["actuation_performed"] is False
    assert plan["experiment"]
