# Family fixture plane: sfe:SelectionRun moved here at consolidation (2026-10-01).
# The individual is a policy/exemplar declaration (authority ceiling, evidence minimums),
# not an exact-subject execution run: dsfe_exact_subject requires subjectRepository +
# subjectSha, and stamping a fabricated SHA onto a policy individual is not evidence.
# Kept OUT of the ontology/ union; the dsfe_exact_subject pass fixture re-injects a
# properly subject-keyed execution run.
@prefix sfe: <https://seanchatmangpt.dev/ontology/selection-frontier-execution#> .

sfe:SelectionRun a sfe:SelectionExecution ;
  sfe:authority "SELECT" ;
  sfe:actuationPerformed false ;
  sfe:minimumMeaningfulEvidence 1 ;
  sfe:requiresExactSubject true ;
  sfe:preservesAlternatives true ;
  sfe:failureDominant true .

