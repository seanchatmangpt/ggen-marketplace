PREFIX ex: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm-explore#>
SELECT ?candidate ?family ?method ?rollback WHERE { ?candidate a ex:Candidate ; ex:family ?family ; ex:method ?method ; ex:deterministic true ; ex:rollback ?rollback ; ex:standing ex:retained . FILTER(?rollback <= 2) } ORDER BY ?rollback ?family ?method
