PREFIX ex: <https://ggen.dev/ontology/dfcm-explore#>
SELECT ?candidate ?novelty ?reversibility ?evidence (IF(?novelty <= ?reversibility && ?novelty <= ?evidence, ?novelty, IF(?reversibility <= ?evidence, ?reversibility, ?evidence)) AS ?balancedFloor) WHERE {
  ?candidate a ex:Candidate ; ex:ctqNovelty ?novelty ; ex:ctqReversibility ?reversibility ; ex:ctqEvidence ?evidence .
} ORDER BY DESC(?balancedFloor) ?candidate
