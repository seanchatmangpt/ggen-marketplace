PREFIX ex: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm-explore#>
SELECT ?candidate ?method ?deterministic ?rollback ?falsifier WHERE { ?candidate a ex:Candidate ; ex:family "bandit" ; ex:method ?method ; ex:deterministic ?deterministic ; ex:rollback ?rollback ; ex:falsifier ?falsifier . } ORDER BY DESC(?deterministic) ?rollback
