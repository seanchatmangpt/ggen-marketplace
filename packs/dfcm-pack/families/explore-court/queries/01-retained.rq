PREFIX ex: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm-explore#>
SELECT ?candidate ?family ?method ?rollback ?evidence ?falsifier WHERE { ?candidate a ex:Candidate ; ex:family ?family ; ex:method ?method ; ex:rollback ?rollback ; ex:evidence ?evidence ; ex:falsifier ?falsifier ; ex:standing ex:retained . } ORDER BY ?rollback ?family ?method
