# GENERATED by ggen from the canonical DfCM ontology. Do not hand-edit.
[fortune5]
profile = "dfcm-fortune5-readiness"
required_controls = 50
required_domains = 10
controls_per_domain = 5
exact_subject_required = true
brce_only_actuation = true
zero_unreceipted_actuation = true
replay_required = true
falsifier_required = true
explicit_as_of_time = true
digest_algorithm = "blake3"
certification_claim = false

[frameworks]
core = ["NIST-CSF-2.0", "NIST-SP-800-53-Rev5-5.2.0", "NIST-SSDF-1.1"]
conditional = ["PCI-DSS", "FedRAMP", "HIPAA", "SOX", "GDPR", "ISO-27001"]
conditional_frameworks_require_separate_admission = true

[proof]
control_inventory = "consumer/dfcm/enterprise/fortune5-controls.json"
readiness_document = "consumer/dfcm/enterprise/FORTUNE5_READINESS.md"
evidence_schema = "consumer/dfcm/enterprise/evidence.schema.json"
verifier = "consumer/dfcm/enterprise/verify_fortune5.py"
mfact_required = true
mfact_surfaces = ["ontology", "admission", "runtime_receipt", "replay", "standing", "enterprise_controls", "evidence_snapshot"]

{% for row in results %}[[control]]
order = {{ row["order"] }}
slug = "{{ row["slug"] }}"
domain = "{{ row["domain"] }}"
criticality = "{{ row["criticality"] }}"
accountable_role = "{{ row["accountableRole"] }}"
evidence_kind = "{{ row["evidenceKind"] }}"
framework_ref = "{{ row["frameworkRef"] }}"
max_age_hours = {{ row["maxAgeHours"] }}
automation_level = "{{ row["automationLevel"] }}"
verifier = "{{ row["verifier"] }}"
falsifier = "{{ row["falsifier"] }}"

{% endfor %}
