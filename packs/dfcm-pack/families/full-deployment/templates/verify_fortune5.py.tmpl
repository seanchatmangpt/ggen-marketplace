from __future__ import annotations

import argparse
import copy
import json
import re
from datetime import datetime, timezone
from pathlib import Path

REQUIRED_CONTROLS = (
{% for row in results %}    {
        "order": {{ row["order"] }},
        "slug": "{{ row["slug"] }}",
        "domain": "{{ row["domain"] }}",
        "criticality": "{{ row["criticality"] }}",
        "max_age_hours": {{ row["maxAgeHours"] }},
        "verifier": "{{ row["verifier"] }}",
        "falsifier": "{{ row["falsifier"] }}",
    },
{% endfor %})
HEX64 = re.compile(r"^[0-9a-f]{64}$")
REQUIRED_TRUE = (
    "observed",
    "admitted",
    "executed",
    "verified",
    "replay_verified",
    "falsifier_checked",
)


def parse_time(value: str) -> datetime:
    if not isinstance(value, str) or not value:
        raise ValueError("missing timestamp")
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    parsed = datetime.fromisoformat(value)
    if parsed.tzinfo is None:
        raise ValueError("timestamp must include timezone")
    return parsed.astimezone(timezone.utc)


def evaluate(snapshot: dict, exact_subject: str) -> dict:
    reasons: list[str] = []
    refused: list[str] = []
    blocked: list[str] = []
    partial: list[str] = []

    if not isinstance(snapshot, dict):
        return {"standing": "REFUSED", "reason": "REFUSED_EVIDENCE_SHAPE"}

    if snapshot.get("subject") != exact_subject:
        return {
            "standing": "REFUSED",
            "reason": "REFUSED_SUBJECT_MISMATCH",
            "expected_subject": exact_subject,
            "observed_subject": snapshot.get("subject"),
        }

    try:
        as_of = parse_time(snapshot["as_of"])
    except (KeyError, TypeError, ValueError) as exc:
        return {"standing": "REFUSED", "reason": "REFUSED_AS_OF", "detail": str(exc)}

    controls = snapshot.get("controls")
    if not isinstance(controls, dict):
        return {"standing": "BLOCKED", "reason": "MISSING_CONTROL_MAP"}

    for requirement in REQUIRED_CONTROLS:
        slug = requirement["slug"]
        record = controls.get(slug)
        if not isinstance(record, dict):
            blocked.append(f"{slug}:missing")
            continue

        if record.get("subject") != exact_subject:
            refused.append(f"{slug}:subject")
            continue

        if record.get("standing") != "ALIVE":
            partial.append(f"{slug}:standing")
        for field in REQUIRED_TRUE:
            if record.get(field) is not True:
                partial.append(f"{slug}:{field}")

        if record.get("digest_algorithm") != "blake3":
            refused.append(f"{slug}:digest_algorithm")
        for digest_field in ("evidence_digest", "receipt_digest"):
            value = record.get(digest_field)
            if not isinstance(value, str) or HEX64.fullmatch(value) is None:
                refused.append(f"{slug}:{digest_field}")

        try:
            observed_at = parse_time(record["observed_at"])
            if observed_at > as_of:
                refused.append(f"{slug}:future_evidence")
            max_age = int(requirement["max_age_hours"])
            if max_age > 0:
                age_hours = (as_of - observed_at).total_seconds() / 3600.0
                if age_hours > max_age:
                    partial.append(f"{slug}:stale")
        except (KeyError, TypeError, ValueError) as exc:
            refused.append(f"{slug}:observed_at:{exc}")

    claims = snapshot.get("certification_claims", [])
    if claims is None:
        claims = []
    if not isinstance(claims, list):
        refused.append("certification_claims:shape")
        claims = []
    for claim in claims:
        if not isinstance(claim, dict):
            refused.append("certification_claim:shape")
            continue
        for field in ("claim", "scope", "verifier"):
            if not isinstance(claim.get(field), str) or not claim[field]:
                refused.append(f"certification_claim:{field}")
        receipt = claim.get("external_receipt_digest")
        if not isinstance(receipt, str) or HEX64.fullmatch(receipt) is None:
            refused.append("certification_claim:external_receipt_digest")

    if refused:
        reasons.extend(sorted(set(refused)))
        standing = "REFUSED"
    elif blocked:
        reasons.extend(sorted(set(blocked)))
        standing = "BLOCKED"
    elif partial:
        reasons.extend(sorted(set(partial)))
        standing = "PARTIAL_ALIVE"
    else:
        standing = "ALIVE"

    return {
        "standing": standing,
        "subject": exact_subject,
        "required_controls": len(REQUIRED_CONTROLS),
        "evaluated_controls": len(controls),
        "required_domains": len({c["domain"] for c in REQUIRED_CONTROLS}),
        "reasons": reasons,
        "certification_status": (
            "EXTERNALLY_RECEIPTED_CLAIMS_PRESENT" if claims else "NOT_ASSERTED"
        ),
    }


def _fixture_snapshot() -> dict:
    subject = "fixture://fortune5/readiness"
    as_of = "2026-08-14T12:00:00Z"
    records = {}
    for index, control in enumerate(REQUIRED_CONTROLS, start=1):
        records[control["slug"]] = {
            "subject": subject,
            "standing": "ALIVE",
            "observed_at": as_of,
            "observed": True,
            "admitted": True,
            "executed": True,
            "verified": True,
            "replay_verified": True,
            "falsifier_checked": True,
            "digest_algorithm": "blake3",
            "evidence_digest": f"{index:064x}",
            "receipt_digest": f"{index + 1000:064x}",
        }
    return {"subject": subject, "as_of": as_of, "controls": records, "certification_claims": []}


def self_test() -> dict:
    subject = "fixture://fortune5/readiness"
    fixture = _fixture_snapshot()
    positive = evaluate(fixture, subject)
    assert positive["standing"] == "ALIVE"

    missing = copy.deepcopy(fixture)
    missing["controls"].pop(REQUIRED_CONTROLS[0]["slug"])
    assert evaluate(missing, subject)["standing"] == "BLOCKED"

    wrong_subject = copy.deepcopy(fixture)
    wrong_subject["subject"] = "fixture://other"
    assert evaluate(wrong_subject, subject)["standing"] == "REFUSED"

    stale = copy.deepcopy(fixture)
    freshness_control = next(c for c in REQUIRED_CONTROLS if int(c["max_age_hours"]) > 0)
    stale["controls"][freshness_control["slug"]]["observed_at"] = "2020-01-01T00:00:00Z"
    assert evaluate(stale, subject)["standing"] == "PARTIAL_ALIVE"

    unreceipted_claim = copy.deepcopy(fixture)
    unreceipted_claim["certification_claims"] = [
        {"claim": "SOC 2", "scope": subject, "verifier": "external-auditor"}
    ]
    assert evaluate(unreceipted_claim, subject)["standing"] == "REFUSED"

    no_replay = copy.deepcopy(fixture)
    no_replay["controls"][REQUIRED_CONTROLS[1]["slug"]]["replay_verified"] = False
    assert evaluate(no_replay, subject)["standing"] == "PARTIAL_ALIVE"

    return {
        "standing": "VERIFIER_ALIVE",
        "fixture_subject": subject,
        "required_controls": len(REQUIRED_CONTROLS),
        "required_domains": len({c["domain"] for c in REQUIRED_CONTROLS}),
        "positive_exact_subject": "ALIVE",
        "negative_missing_control": "BLOCKED",
        "negative_subject_mismatch": "REFUSED",
        "negative_stale_evidence": "PARTIAL_ALIVE",
        "negative_unreceipted_certification_claim": "REFUSED",
        "negative_missing_replay": "PARTIAL_ALIVE",
        "subject_alive": False,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description="Verify DfCM Fortune 5 exact-subject readiness evidence")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--subject")
    parser.add_argument("--evidence", type=Path)
    args = parser.parse_args()

    if args.self_test:
        print(json.dumps(self_test(), sort_keys=True))
        return 0

    if not args.subject or args.evidence is None:
        parser.error("--subject and --evidence are required unless --self-test is used")

    snapshot = json.loads(args.evidence.read_text())
    result = evaluate(snapshot, args.subject)
    print(json.dumps(result, sort_keys=True))
    return 0 if result["standing"] == "ALIVE" else 2


if __name__ == "__main__":
    raise SystemExit(main())
