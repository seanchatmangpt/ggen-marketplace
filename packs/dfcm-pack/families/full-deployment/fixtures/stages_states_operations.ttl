# Family fixture plane: the satellite's dfcm:Stage / dfcm:State / dfcm:Operation
# individuals (7+7+13), moved verbatim at consolidation (2026-10-01). The base
# deployment ontology already carries the same governing sequence as dfcm:Phase and
# dfcm:Operation individuals; re-injecting both populations into one union
# double-lists them in queries/pipeline.rq's render (REPLAY.md), so this population
# lives outside the ggen union. The dfd_ court witnesses remain intact.
@prefix dfcm: <https://ggen.dev/ontology/dfcm#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

dfcm:Preserve a dfcm:Stage ; dfcm:order 1 ; dfcm:slug "preserve" ; rdfs:label "Preserve" .
dfcm:Fence a dfcm:Stage ; dfcm:order 2 ; dfcm:slug "fence" ; rdfs:label "Fence / Chesterton" .
dfcm:Calculus a dfcm:Stage ; dfcm:order 3 ; dfcm:slug "calculus" ; rdfs:label "Calculus" .
dfcm:Exclusions a dfcm:Stage ; dfcm:order 4 ; dfcm:slug "exclusions" ; rdfs:label "Exclusions" .
dfcm:FalsifierStage a dfcm:Stage ; dfcm:order 5 ; dfcm:slug "falsifier" ; rdfs:label "Falsifier" .
dfcm:Extension a dfcm:Stage ; dfcm:order 6 ; dfcm:slug "extension" ; rdfs:label "Extension" .
dfcm:Operationalization a dfcm:Stage ; dfcm:order 7 ; dfcm:slug "operationalization" ; rdfs:label "Operationalization" .
dfcm:UNKNOWN a dfcm:State ; rdfs:label "UNKNOWN" .
dfcm:PARTIAL_ALIVE a dfcm:State ; rdfs:label "PARTIAL_ALIVE" .
dfcm:ALIVE a dfcm:State ; rdfs:label "ALIVE" .
dfcm:BLOCKED a dfcm:State ; rdfs:label "BLOCKED" .
dfcm:BUILD_BROKEN a dfcm:State ; rdfs:label "BUILD_BROKEN" .
dfcm:UNSUPPORTED a dfcm:State ; rdfs:label "UNSUPPORTED" .
dfcm:REFUSED a dfcm:State ; rdfs:label "REFUSED" .
dfcm:Parse a dfcm:Operation ; dfcm:order 1 ; dfcm:slug "parse" ; dfcm:actuationAllowed false .
dfcm:Route a dfcm:Operation ; dfcm:order 2 ; dfcm:slug "route" ; dfcm:actuationAllowed false .
dfcm:Admit a dfcm:Operation ; dfcm:order 3 ; dfcm:slug "admit" ; dfcm:actuationAllowed false .
dfcm:Refuse a dfcm:Operation ; dfcm:order 4 ; dfcm:slug "refuse" ; dfcm:actuationAllowed false .
dfcm:Diagnose a dfcm:Operation ; dfcm:order 5 ; dfcm:slug "diagnose" ; dfcm:actuationAllowed false .
dfcm:Repair a dfcm:Operation ; dfcm:order 6 ; dfcm:slug "repair" ; dfcm:actuationAllowed false .
dfcm:Select a dfcm:Operation ; dfcm:order 7 ; dfcm:slug "select" ; dfcm:actuationAllowed false .
dfcm:Construct a dfcm:Operation ; dfcm:order 8 ; dfcm:slug "construct" ; dfcm:actuationAllowed false .
dfcm:Do a dfcm:Operation ; dfcm:order 9 ; dfcm:slug "do" ; dfcm:actuationAllowed true ; dfcm:authority "BRCE" .
dfcm:ReceiptOp a dfcm:Operation ; dfcm:order 10 ; dfcm:slug "receipt" ; dfcm:actuationAllowed false .
dfcm:Replay a dfcm:Operation ; dfcm:order 11 ; dfcm:slug "replay" ; dfcm:actuationAllowed false .
dfcm:Hook a dfcm:Operation ; dfcm:order 12 ; dfcm:slug "hook" ; dfcm:actuationAllowed false .
dfcm:Standing a dfcm:Operation ; dfcm:order 13 ; dfcm:slug "standing" ; dfcm:actuationAllowed false .
