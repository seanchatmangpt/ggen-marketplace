PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?order ?slug ?name ?domain ?criticality ?accountableRole ?evidenceKind ?frameworkRef ?maxAgeHours ?automationLevel ?verifier ?falsifier
WHERE {
  ?control a dfcm:EnterpriseControl ;
    dfcm:order ?order ;
    dfcm:slug ?slug ;
    rdfs:label ?name ;
    dfcm:domain ?domain ;
    dfcm:criticality ?criticality ;
    dfcm:accountableRole ?accountableRole ;
    dfcm:evidenceKind ?evidenceKind ;
    dfcm:frameworkRef ?frameworkRef ;
    dfcm:maxAgeHours ?maxAgeHours ;
    dfcm:automationLevel ?automationLevel ;
    dfcm:required true ;
    dfcm:verifier ?verifier ;
    dfcm:falsifier ?falsifier .
}
ORDER BY ?order
