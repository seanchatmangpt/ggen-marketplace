PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?order ?slug ?name ?kind ?outcome ?verifier ?falsifier
WHERE {
  ?component a dfcm:DeploymentComponent ;
    dfcm:order ?order ;
    dfcm:slug ?slug ;
    rdfs:label ?name ;
    dfcm:kind ?kind ;
    dfcm:required true ;
    dfcm:outcome ?outcome ;
    dfcm:verifier ?verifier ;
    dfcm:falsifier ?falsifier .
}
ORDER BY ?order
