PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?n ?e ?r WHERE {
  ?candidate a dfcm:Candidate ; dfcm:ctqNovelty ?n ; dfcm:ctqEvidence ?e ; dfcm:ctqRollback ?r .
  FILTER(?n >= 4 && ?e >= 4 && ?r >= 4)
} ORDER BY DESC(?e) DESC(?r) DESC(?n) STR(?candidate)
