PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?evidence ?rollback ?novelty WHERE {
  ?candidate a dfcm:Candidate ; dfcm:ctqEvidence ?evidence ; dfcm:ctqRollback ?rollback ; dfcm:ctqNovelty ?novelty .
} ORDER BY DESC(?evidence) DESC(?rollback) DESC(?novelty) STR(?candidate)
