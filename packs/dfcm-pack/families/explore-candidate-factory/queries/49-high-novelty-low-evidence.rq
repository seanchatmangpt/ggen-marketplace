PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?family ?novelty ?evidence WHERE {
  ?candidate a dfcm:Candidate ; dfcm:family ?family ; dfcm:ctqNovelty ?novelty ; dfcm:ctqEvidence ?evidence .
  FILTER(?novelty >= 5 && ?evidence <= 3)
} ORDER BY DESC(?novelty) ?evidence ?family STR(?candidate)
