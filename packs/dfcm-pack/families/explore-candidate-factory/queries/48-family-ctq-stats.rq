PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?family (AVG(?n) AS ?avgNovelty) (AVG(?e) AS ?avgEvidence) (AVG(?r) AS ?avgRollback) WHERE { ?candidate a dfcm:Candidate ; dfcm:family ?family ; dfcm:ctqNovelty ?n ; dfcm:ctqEvidence ?e ; dfcm:ctqRollback ?r . }
GROUP BY ?family ORDER BY DESC(?avgEvidence) DESC(?avgRollback) DESC(?avgNovelty)