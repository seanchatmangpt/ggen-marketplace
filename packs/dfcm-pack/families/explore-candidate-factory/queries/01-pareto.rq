PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?novelty ?evidence ?rollback WHERE {
  ?candidate a dfcm:Candidate ; dfcm:ctqNovelty ?novelty ; dfcm:ctqEvidence ?evidence ; dfcm:ctqRollback ?rollback .
  FILTER NOT EXISTS { ?other a dfcm:Candidate ; dfcm:ctqNovelty ?n2 ; dfcm:ctqEvidence ?e2 ; dfcm:ctqRollback ?r2 . FILTER((?n2>=?novelty && ?e2>=?evidence && ?r2>=?rollback) && (?n2>?novelty || ?e2>?evidence || ?r2>?rollback)) }
} ORDER BY DESC(?novelty) DESC(?evidence) DESC(?rollback)
