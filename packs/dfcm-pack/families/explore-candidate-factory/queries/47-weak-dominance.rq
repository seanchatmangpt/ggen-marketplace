PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?dominant ?dominated WHERE {
 ?dominant a dfcm:Candidate ; dfcm:ctqNovelty ?dn ; dfcm:ctqEvidence ?de ; dfcm:ctqRollback ?dr .
 ?dominated a dfcm:Candidate ; dfcm:ctqNovelty ?xn ; dfcm:ctqEvidence ?xe ; dfcm:ctqRollback ?xr .
 FILTER(?dominant != ?dominated && ?dn>=?xn && ?de>=?xe && ?dr>=?xr && (?dn>?xn || ?de>?xe || ?dr>?xr))
}
ORDER BY ?dominant ?dominated