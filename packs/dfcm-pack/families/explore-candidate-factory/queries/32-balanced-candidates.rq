PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?n ?e ?r WHERE { ?candidate a dfcm:Candidate ; dfcm:ctqNovelty ?n ; dfcm:ctqEvidence ?e ; dfcm:ctqRollback ?r . FILTER(ABS(?n-?e) <= 1 && ABS(?e-?r) <= 1 && ABS(?n-?r) <= 1) }
ORDER BY DESC(?e) ?candidate