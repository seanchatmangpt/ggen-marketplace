PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?rollback ?evidence ?novelty WHERE {
  ?candidate a dfcm:Candidate ; dfcm:ctqRollback ?rollback ; dfcm:ctqEvidence ?evidence ; dfcm:ctqNovelty ?novelty .
  FILTER(?rollback >= 5)
} ORDER BY DESC(?evidence) DESC(?novelty) STR(?candidate)
