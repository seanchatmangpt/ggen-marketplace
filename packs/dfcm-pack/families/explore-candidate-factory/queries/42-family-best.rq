PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?family ?score WHERE {
  ?candidate a dfcm:Candidate ; dfcm:family ?family ; dfcm:ctqNovelty ?n ; dfcm:ctqEvidence ?e ; dfcm:ctqRollback ?r .
  BIND((?n+?e+?r) AS ?score)
  FILTER NOT EXISTS { ?other a dfcm:Candidate ; dfcm:family ?family ; dfcm:ctqNovelty ?n2 ; dfcm:ctqEvidence ?e2 ; dfcm:ctqRollback ?r2 . FILTER((?n2+?e2+?r2) > ?score) }
} ORDER BY ?family STR(?candidate)
