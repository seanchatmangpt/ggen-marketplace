PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?family ?evidence ?standing WHERE { ?candidate a dfcm:Candidate ; dfcm:family ?family ; dfcm:ctqEvidence ?evidence ; dfcm:standing ?standing . FILTER(?standing != "ALIVE" || ?evidence < 5) }
ORDER BY ?evidence ?family ?candidate