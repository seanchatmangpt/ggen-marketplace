PREFIX dms: <https://ggen.dev/ontology/dfcm-maximalist-selection-control#>
SELECT ?c ?e ?u ?r ?d ?k WHERE {
  ?c a dms:Candidate ; dms:evidence ?e ; dms:uncertainty ?u ; dms:rollbackCost ?r ; dms:dependencyRelief ?d ; dms:reuseCapital ?k .
  FILTER NOT EXISTS {
    ?other a dms:Candidate ; dms:evidence ?oe ; dms:uncertainty ?ou ; dms:rollbackCost ?or ; dms:dependencyRelief ?od ; dms:reuseCapital ?ok .
    FILTER(?other != ?c && ?oe >= ?e && ?ou <= ?u && ?or <= ?r && ?od >= ?d && ?ok >= ?k && (?oe > ?e || ?ou < ?u || ?or < ?r || ?od > ?d || ?ok > ?k))
  }
}
ORDER BY DESC(?d) DESC(?k) DESC(?e) ?u ?r ?c
