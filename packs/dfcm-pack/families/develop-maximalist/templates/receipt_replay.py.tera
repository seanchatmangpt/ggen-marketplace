import hashlib, json

def digest(body):
    return hashlib.sha256(json.dumps(body,sort_keys=True,separators=(",",":")).encode()).hexdigest()

def replay(body, expected):
    if body.get("actuation_performed") is not False:
        raise ValueError("REFUSED[REPORTED_ACTUATION]")
    actual=digest(body)
    if actual != expected:
        raise ValueError("REFUSED[RECEIPT_DIGEST_MISMATCH]")
    return "REPLAY_MATCH"
