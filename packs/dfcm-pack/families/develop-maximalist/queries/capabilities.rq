PREFIX dev: <https://ggen.dev/ontology/dfcm-develop#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?capability ?title ?family ?authority ?falsifier WHERE {
  ?capability a dev:Capability ; dct:title ?title ; dev:family ?family ; dev:authority ?authority ; dev:falsifier ?falsifier .
}
ORDER BY ?family ?capability
