PREFIX dfcm: <https://chatman.ai/dfcm#>
SELECT ?candidate ?uncertainty ?missing WHERE {
  ?candidate a dfcm:SelectionCandidate ; dfcm:uncertaintyWidth ?uncertainty ; dfcm:closureRequired ?required ; dfcm:closurePassed ?passed .
  BIND(?required - ?passed AS ?missing)
  FILTER(?uncertainty > 0.20 || ?missing > 0)
}
ORDER BY DESC(?missing) DESC(?uncertainty) ?candidate
