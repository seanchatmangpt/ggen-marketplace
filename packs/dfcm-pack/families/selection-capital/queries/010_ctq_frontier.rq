PREFIX sel: <https://seanchatman.github.io/ggen/selection#>
SELECT ?candidate ?commitYield ?mergeYield ?dependencyRelief ?qualifiedCapability WHERE {
  ?candidate a sel:Candidate ;
    sel:newMeaningfulCommitYield ?commitYield ;
    sel:independentMergeYield ?mergeYield ;
    sel:dependencyRelief ?dependencyRelief ;
    sel:qualifiedCapability ?qualifiedCapability .
}
ORDER BY DESC(?commitYield) DESC(?mergeYield) DESC(?dependencyRelief) DESC(?qualifiedCapability) ?candidate
