PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?order ?slug ?label (COUNT(?control) AS ?controls) WHERE {
  ?domain a dfcm:AssuranceDomain ; dfcm:order ?order ; dfcm:slug ?slug ; skos:prefLabel ?label .
  OPTIONAL { ?control a dfcm:EnterpriseControl ; dfcm:assuranceDomain ?domain . }
}
GROUP BY ?order ?slug ?label
ORDER BY ?order
