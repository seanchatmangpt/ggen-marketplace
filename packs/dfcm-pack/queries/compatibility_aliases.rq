PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?kind ?canonical ?legacy WHERE {
  {
    ?canonicalIri owl:equivalentClass ?legacyIri .
    FILTER(STRSTARTS(STR(?canonicalIri), "https://ggen.dev/ontology/dfcm#"))
    BIND("class" AS ?kind)
  }
  UNION
  {
    ?canonicalIri owl:equivalentProperty ?legacyIri .
    FILTER(STRSTARTS(STR(?canonicalIri), "https://ggen.dev/ontology/dfcm#"))
    BIND("property" AS ?kind)
  }
  BIND(STRAFTER(STR(?canonicalIri), "#") AS ?canonical)
  BIND(STR(?legacyIri) AS ?legacy)
}
ORDER BY ?kind ?canonical ?legacy
