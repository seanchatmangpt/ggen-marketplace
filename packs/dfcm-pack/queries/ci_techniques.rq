PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?order ?action ?slug ?label ?condition WHERE {
  ?technique a dfcm:CITechnique ;
    dfcm:order ?order ;
    dfcm:slug ?slug ;
    skos:prefLabel ?label ;
    dfcm:errcAction ?actionNode .
  ?actionNode dfcm:slug ?action .
  OPTIONAL { ?technique dfcm:condition ?condition . }
}
ORDER BY ?order ?slug
