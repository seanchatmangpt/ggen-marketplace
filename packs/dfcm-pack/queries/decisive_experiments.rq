PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?experiment ?title ?member ?falsifier ?authority WHERE {
  ?e a dfcm:DecisiveExperiment ; dcterms:title ?title ; dfcm:member ?m ; dfcm:falsifier ?falsifier ; dfcm:authority ?authorityIri .
  ?m dfcm:slug ?member .
  BIND(STRAFTER(STR(?e), "#") AS ?experiment)
  BIND(STRAFTER(STR(?authorityIri), "#") AS ?authority)
}
ORDER BY ?experiment ?member
