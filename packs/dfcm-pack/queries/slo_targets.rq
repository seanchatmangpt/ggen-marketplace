PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?slug ?tier ?availability ?errorBudget ?rto ?rpo WHERE {
  dfcm:Fortune5SLO a dfcm:RecoveryObjective ; dfcm:slug ?slug ; dfcm:serviceTier ?tierNode ;
    dfcm:availabilityTarget ?availability ; dfcm:errorBudgetMinutes30d ?errorBudget ;
    dfcm:rtoSeconds ?rto ; dfcm:rpoSeconds ?rpo .
  ?tierNode dfcm:slug ?tier .
}
ORDER BY ?slug
