PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?order ?slug ?reversibility (IF(?actuate, "true", "false") AS ?mayActuateJson) (COALESCE(?authority0, "") AS ?authority) (COALESCE(?receipt0, "") AS ?receipt) WHERE { ?x a dfcm:Operation ; dfcm:order ?order ; dfcm:slug ?slug ; dfcm:reversibility ?reversibility ; dfcm:mayActuate ?actuate . OPTIONAL { ?x dfcm:authorityRoute ?a . ?a dfcm:slug ?authority0 } OPTIONAL { ?x dfcm:receiptRoute ?r . ?r dfcm:slug ?receipt0 } } ORDER BY ?order
