PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?portfolio ?policy ?member WHERE {
  ?p a dfcm:Portfolio ; dfcm:selectionPolicy ?policyIri ; dfcm:member ?m .
  ?m dfcm:slug ?member .
  BIND(STRAFTER(STR(?p), "#") AS ?portfolio)
  BIND(STRAFTER(STR(?policyIri), "#") AS ?policy)
}
ORDER BY ?portfolio ?member
