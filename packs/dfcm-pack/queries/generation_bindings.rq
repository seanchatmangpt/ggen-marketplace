PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?rule ?sourcePack ?queryFile ?templateFile ?outputFile ?mode ?skipEmpty ?bindingState ?timeout WHERE {
  ?r a dfcm:GenerationRule ;
    dfcm:ruleName ?rule ;
    dfcm:sourcePack ?sourcePack ;
    dfcm:queryFile ?queryFile ;
    dfcm:templateFile ?templateFile ;
    dfcm:outputFile ?outputFile ;
    dfcm:generationMode ?mode ;
    dfcm:skipEmpty ?skipEmpty ;
    dfcm:bindingState ?bindingState ;
    dfcm:qualificationTimeoutSeconds ?timeout .
}
ORDER BY ?rule
