PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?slug ?minimumControls ?populationCeiling ?interruptLatency ?blast WHERE {
  dfcm:PostAGIProfile a dfcm:EnterpriseReadinessProfile ; dfcm:slug ?slug ;
    dfcm:minimumControls ?minimumControls ; dfcm:agentPopulationCeiling ?populationCeiling ;
    dfcm:interruptibilityLatencyMs ?interruptLatency ; dfcm:maxBlastRadiusPercent ?blast .
}
ORDER BY ?slug
