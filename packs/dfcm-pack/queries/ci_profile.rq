PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?slug ?policyVersion ?primaryObjective ?secondaryObjective ?costFormula ?utilityFormula WHERE {
  dfcm:CIOptimizationProfile a dfcm:OptimizationProfile ;
    dfcm:slug ?slug ;
    dfcm:policyVersion ?policyVersion ;
    dfcm:primaryObjective ?primaryObjective ;
    dfcm:secondaryObjective ?secondaryObjective ;
    dfcm:costFormula ?costFormula ;
    dfcm:utilityFormula ?utilityFormula .
}
ORDER BY ?slug
