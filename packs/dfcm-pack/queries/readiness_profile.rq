PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?slug ?minimumControls ?regions ?zones ?providers ?availability ?rto ?rpo ?blast ?retention WHERE {
  dfcm:Fortune5Baseline a dfcm:EnterpriseReadinessProfile ; dfcm:slug ?slug ;
    dfcm:minimumControls ?minimumControls ; dfcm:regionsRequired ?regions ; dfcm:zonesPerRegion ?zones ;
    dfcm:providersRequired ?providers ; dfcm:availabilityTarget ?availability ; dfcm:rtoSeconds ?rto ;
    dfcm:rpoSeconds ?rpo ; dfcm:maxBlastRadiusPercent ?blast ; dfcm:auditRetentionDays ?retention .
}
ORDER BY ?slug
