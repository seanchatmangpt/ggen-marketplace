PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?slug ?family ?standing ?ctqNovelty ?ctqEvidence ?ctqReversibility ?rollbackCost ?uncertainty ?deterministic ?authority ?sourcePack ?assumption ?falsifier WHERE {
  ?candidate a dfcm:Candidate ;
    dfcm:slug ?slug ;
    dfcm:family ?family ;
    dfcm:standing ?standingIri ;
    dfcm:ctqNovelty ?ctqNovelty ;
    dfcm:ctqEvidence ?ctqEvidence ;
    dfcm:ctqReversibility ?ctqReversibility ;
    dfcm:rollbackCost ?rollbackCost ;
    dfcm:uncertainty ?uncertainty ;
    dfcm:deterministic ?deterministic ;
    dfcm:authority ?authorityIri ;
    dfcm:sourcePack ?sourcePack ;
    dfcm:assumption ?assumption ;
    dfcm:falsifier ?falsifier .
  BIND(STRAFTER(STR(?standingIri), "#") AS ?standing)
  BIND(STRAFTER(STR(?authorityIri), "#") AS ?authority)
}
ORDER BY DESC(?ctqReversibility) DESC(?ctqEvidence) DESC(?ctqNovelty) ASC(?rollbackCost) ASC(?uncertainty) ?family ?slug
