PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?order ?slug ?label ?layer (IF(?required, "true", "false") AS ?requiredJson) WHERE { ?component a dfcm:Component ; dfcm:order ?order ; dfcm:slug ?slug ; rdfs:label ?label ; dfcm:layer ?layer ; dfcm:required ?required . } ORDER BY ?order
