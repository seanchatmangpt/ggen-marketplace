PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?order ?code ?slug ?title ?domain ?criticality ?automated ?evidence WHERE {
  ?control a dfcm:EnterpriseControl ; dfcm:order ?order ; dfcm:ruleCode ?code ; dfcm:slug ?slug ;
    dcterms:title ?title ; dfcm:assuranceDomain ?domainNode ; dfcm:criticality ?criticality ;
    dfcm:automated ?automated ; dfcm:evidenceType ?evidence .
  ?domainNode dfcm:slug ?domain .
}
ORDER BY ?order
