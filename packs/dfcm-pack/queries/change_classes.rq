PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?order ?slug ?quorum ?domains ?machine ?canary ?rollback ?maxConcurrent WHERE {
  ?change a dfcm:ChangeClass ; dfcm:order ?order ; dfcm:slug ?slug ; dfcm:approvalQuorum ?quorum ;
    dfcm:independentAuthorityDomains ?domains ; dfcm:machineEligible ?machine ;
    dfcm:canaryRequired ?canary ; dfcm:rollbackRequired ?rollback .
  OPTIONAL { ?change dfcm:maxConcurrentChangePercent ?maxConcurrent . }
}
ORDER BY ?order
