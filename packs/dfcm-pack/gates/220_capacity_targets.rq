PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?target ?problem WHERE {
  VALUES ?target { dfcm:Fortune5Capacity dfcm:Fortune5WorkflowConcurrency dfcm:Fortune5ActuationRate }
  { FILTER NOT EXISTS { ?target a dfcm:ScaleTarget ; dfcm:targetOnly true ; dfcm:targetValue ?v ; dfcm:targetUnit ?u . FILTER(?v > 0) } BIND("scale-target-missing-or-self-crowned" AS ?problem) }
}
