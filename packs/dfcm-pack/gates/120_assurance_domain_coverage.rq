PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?domain ?problem WHERE {
  VALUES ?domain { dfcm:IdentityAuthority dfcm:ChangeRelease dfcm:AvailabilityResilience dfcm:DisasterRecovery
    dfcm:CapacityPerformance dfcm:ObservabilitySLO dfcm:IncidentResponse dfcm:DataGovernance dfcm:CryptoSecrets
    dfcm:SupplyChain dfcm:TenancyIsolation dfcm:AuditEvidence dfcm:FinOps dfcm:PortabilityExit
    dfcm:PolicyCompliance dfcm:ChaosSafety dfcm:LifecycleDeprecation dfcm:OperationalReadiness }
  FILTER NOT EXISTS { ?control a dfcm:EnterpriseControl ; dfcm:assuranceDomain ?domain ; dfcm:automated true ; dfcm:evidenceType ?evidence . }
  BIND("mandatory-domain-without-evidence-control" AS ?problem)
}
