PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?operation ?problem WHERE { VALUES ?operation { dfcm:SELECT dfcm:CONSTRUCT dfcm:DO } { FILTER NOT EXISTS { ?operation a dfcm:Operation } BIND("missing-operation" AS ?problem) } UNION { ?operation dfcm:slug ?slug . FILTER(?operation != dfcm:DO) FILTER EXISTS { ?operation dfcm:mayActuate true } BIND("non-DO-may-actuate" AS ?problem) } }
