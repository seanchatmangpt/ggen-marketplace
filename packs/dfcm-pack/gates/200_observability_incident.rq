PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE {
  { FILTER NOT EXISTS { dfcm:C008 dfcm:telemetryMetrics true ; dfcm:telemetryLogs true ; dfcm:telemetryTraces true . } BIND("three-pillar-telemetry-incomplete" AS ?problem) }
  UNION { FILTER NOT EXISTS { dfcm:C009 dfcm:incidentReceiptRequired true ; dfcm:postIncidentReplayRequired true . } BIND("incident-receipt-replay-incomplete" AS ?problem) }
}
