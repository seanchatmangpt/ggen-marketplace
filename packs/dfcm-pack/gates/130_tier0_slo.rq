PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE {
  { FILTER NOT EXISTS { dfcm:Fortune5SLO dfcm:targetOnly true ; dfcm:availabilityTarget ?a ; dfcm:errorBudgetMinutes30d ?e ; dfcm:rtoSeconds ?rto ; dfcm:rpoSeconds ?rpo . FILTER(?a >= 0.9999 && ?e <= 4.32 && ?rto <= 900 && ?rpo <= 300) } BIND("tier0-slo-below-baseline" AS ?problem) }
}
