# Converted from ASK to violation-row SELECT at consolidation (2026-10-01); law unchanged:
# every dmc:Candidate requires a receipt.
PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate WHERE {
  ?candidate a dmc:Candidate .
  FILTER NOT EXISTS { ?candidate dmc:requiresReceipt true }
}
ORDER BY ?candidate
