PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?change ?problem WHERE {
  VALUES ?change { dfcm:HighRiskChange dfcm:EmergencyChange }
  { FILTER NOT EXISTS { ?change dfcm:approvalQuorum ?q ; dfcm:independentAuthorityDomains ?d ; dfcm:machineEligible true ; dfcm:requiresReceipt true . FILTER(?q >= 2 && ?d >= 2) } BIND("production-authority-not-segregated" AS ?problem) }
}
