PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE { { FILTER NOT EXISTS { dfcm:ReceiptDAG a dfcm:ReceiptContract } BIND("missing-receipt-contract" AS ?problem) } UNION { FILTER NOT EXISTS { dfcm:ActuationToReceipt dfcm:requires dfcm:ReceiptDAG } BIND("actuation-not-bound-to-receipt" AS ?problem) } UNION { FILTER NOT EXISTS { dfcm:ReceiptToReplay a dfcm:Morphism } BIND("missing-replay-morphism" AS ?problem) } }
