PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE {
  { FILTER NOT EXISTS { dfcm:Fortune5Resilience dfcm:chaosRequired true ; dfcm:drExerciseDays ?days . FILTER(?days <= 30) } BIND("chaos-or-dr-cadence-missing" AS ?problem) }
  UNION { FILTER NOT EXISTS { dfcm:C018 dfcm:chaosRequired true ; dfcm:maxBlastRadiusPercent ?b . FILTER(?b <= 5) } BIND("chaos-not-bounded" AS ?problem) }
}
