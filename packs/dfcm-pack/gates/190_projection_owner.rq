# MESSAGE: every DfCM projection pack must name dfcm-pack as semantic owner; sibling packs may project or qualify but cannot mint competing foundational law.
PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?projection ?owner WHERE {
  ?projection a dfcm:ProjectionPack .
  OPTIONAL { ?projection dfcm:semanticOwner ?owner }
  FILTER(!BOUND(?owner) || STR(?owner) != "dfcm-pack")
}
ORDER BY ?projection
