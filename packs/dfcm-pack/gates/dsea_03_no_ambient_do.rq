# Converted from ASK to violation-row SELECT at consolidation (2026-10-01); law unchanged:
# the acquisition pack declares consequential_do "BRCE_ONLY", so any recorded
# dea:actuationPerformed true is a refusal.
PREFIX dea: <https://chatman.ai/ontology/dfcm-selection-evidence-acquisition#>
SELECT ?actor WHERE {
  ?actor dea:actuationPerformed true .
}
ORDER BY ?actor
