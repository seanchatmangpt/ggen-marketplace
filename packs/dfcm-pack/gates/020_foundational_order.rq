PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?phase ?problem WHERE { ?phase a dfcm:Phase ; dfcm:order ?order . { FILTER NOT EXISTS { ?phase dfcm:slug ?slug } BIND("missing-slug" AS ?problem) } UNION { ?other a dfcm:Phase ; dfcm:order ?order . FILTER(?other != ?phase) BIND("duplicate-order" AS ?problem) } }
