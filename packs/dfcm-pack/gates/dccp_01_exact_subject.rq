# Converted from ASK to violation-row SELECT at consolidation (2026-10-01); law unchanged:
# candidate subjects are repo/name@40-hex exact subjects.
PREFIX dfcm: <https://seanchatman.dev/ontology/dfcm#>
SELECT ?candidate ?subject WHERE {
  ?candidate dfcm:subject ?subject .
  FILTER(!REGEX(STR(?subject), "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}$"))
}
ORDER BY ?candidate ?subject
