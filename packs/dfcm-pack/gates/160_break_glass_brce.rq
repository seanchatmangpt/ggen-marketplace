PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE {
  { FILTER NOT EXISTS { dfcm:Fortune5BreakGlass a dfcm:BreakGlassPolicy ; dfcm:authorityRoute dfcm:BRCE ; dfcm:receiptRoute dfcm:ReceiptDAG ; dfcm:requiresReceipt true ; dfcm:requiresReplay true . } BIND("break-glass-bypasses-brce-or-replay" AS ?problem) }
}
