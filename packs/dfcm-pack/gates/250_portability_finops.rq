PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE {
  { FILTER NOT EXISTS { dfcm:C015 dfcm:budgetGuardrailRequired true ; dfcm:unitEconomicsRequired true . } BIND("finops-guardrails-missing" AS ?problem) }
  UNION { FILTER NOT EXISTS { dfcm:C016 dfcm:providerPortable true ; dfcm:exitPlanRequired true . } BIND("provider-exit-edge-missing" AS ?problem) }
}
