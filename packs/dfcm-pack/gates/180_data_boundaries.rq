PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE {
  { FILTER NOT EXISTS { dfcm:C010 dfcm:residencyEnforced true . } BIND("residency-boundary-not-enforced" AS ?problem) }
  UNION { FILTER NOT EXISTS { dfcm:C011 dfcm:encryptionAtRest true ; dfcm:encryptionInTransit true ; dfcm:keyIsolation true . } BIND("crypto-boundary-incomplete" AS ?problem) }
  UNION { FILTER NOT EXISTS { dfcm:C013 dfcm:tenantIsolation true ; dfcm:maxBlastRadiusPercent ?b . FILTER(?b <= 5) } BIND("tenant-isolation-incomplete" AS ?problem) }
}
