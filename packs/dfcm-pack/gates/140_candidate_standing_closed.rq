# MESSAGE: DfCM candidate standing must use the canonical standing lattice; free-form standing strings create parallel truth and are refused.
PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?candidate ?standing WHERE {
  ?candidate a dfcm:Candidate ; dfcm:standing ?standing .
  FILTER(?standing NOT IN (
    dfcm:UNKNOWN,
    dfcm:PARTIAL_ALIVE,
    dfcm:ALIVE,
    dfcm:BLOCKED,
    dfcm:BUILD_BROKEN,
    dfcm:UNSUPPORTED,
    dfcm:REFUSED
  ))
}
ORDER BY ?candidate
