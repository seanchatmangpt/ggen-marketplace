PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
SELECT ?class ?problem WHERE { VALUES (?class ?parent) { (dfcm:DeploymentProfile prov:Entity) (dfcm:Component prov:Entity) (dfcm:Phase skos:Concept) (dfcm:Stage skos:Concept) (dfcm:Status skos:Concept) (dfcm:AuthorityRoute odrl:Policy) } FILTER NOT EXISTS { ?class <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?parent } BIND("public-ontology-alignment-missing" AS ?problem) }
