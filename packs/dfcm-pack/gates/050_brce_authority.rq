PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE { { FILTER NOT EXISTS { dfcm:DO dfcm:authorityRoute dfcm:BRCE } BIND("DO-without-BRCE" AS ?problem) } UNION { FILTER NOT EXISTS { dfcm:DO dfcm:receiptRoute dfcm:ReceiptDAG } BIND("DO-without-receipt-route" AS ?problem) } UNION { FILTER EXISTS { dfcm:DirectExecution dfcm:mayActuate true } BIND("direct-execution-authorized" AS ?problem) } UNION { FILTER EXISTS { dfcm:IntentHook dfcm:mayActuate true } BIND("hook-actuation-authorized" AS ?problem) } }
