PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE {
  { FILTER NOT EXISTS { dfcm:Wave1 dfcm:releasePercent 1 . dfcm:Wave2 dfcm:releasePercent 5 ; dfcm:requiresPriorWave dfcm:Wave1 . dfcm:Wave3 dfcm:releasePercent 25 ; dfcm:requiresPriorWave dfcm:Wave2 . dfcm:Wave4 dfcm:releasePercent 100 ; dfcm:requiresPriorWave dfcm:Wave3 . } BIND("progressive-wave-chain-invalid" AS ?problem) }
  UNION { FILTER NOT EXISTS { dfcm:C003 dfcm:canaryRequired true ; dfcm:rollbackRequired true . } BIND("canary-or-rollback-not-required" AS ?problem) }
}
