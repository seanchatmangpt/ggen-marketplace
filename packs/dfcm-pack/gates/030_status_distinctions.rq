PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE { { FILTER NOT EXISTS { dfcm:UNKNOWN a dfcm:Status } BIND("missing-UNKNOWN" AS ?problem) } UNION { FILTER NOT EXISTS { dfcm:UNSUPPORTED a dfcm:Status } BIND("missing-UNSUPPORTED" AS ?problem) } UNION { FILTER NOT EXISTS { dfcm:REFUSED a dfcm:Status } BIND("missing-REFUSED" AS ?problem) } UNION { FILTER(dfcm:UNKNOWN = dfcm:UNSUPPORTED || dfcm:UNSUPPORTED = dfcm:REFUSED) BIND("collapsed-status-identity" AS ?problem) } }
