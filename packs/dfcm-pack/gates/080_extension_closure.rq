PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?component ?problem WHERE { dfcm:FullChatmanEcosystem dfcm:includesComponent ?component . { FILTER NOT EXISTS { ?component a dfcm:Component } BIND("profile-member-not-component" AS ?problem) } UNION { FILTER NOT EXISTS { ?component dfcm:slug ?slug } BIND("component-missing-slug" AS ?problem) } UNION { FILTER NOT EXISTS { ?component dfcm:required ?required } BIND("component-missing-required-classification" AS ?problem) } }
