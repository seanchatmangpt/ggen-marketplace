PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE {
  { FILTER NOT EXISTS { dfcm:Fortune5Resilience dfcm:targetOnly true ; dfcm:regionsRequired ?r ; dfcm:zonesPerRegion ?z ; dfcm:providersRequired ?p ; dfcm:activeActive true ; dfcm:maxBlastRadiusPercent ?b . FILTER(?r >= 3 && ?z >= 3 && ?p >= 2 && ?b <= 5) } BIND("resilience-envelope-below-baseline" AS ?problem) }
}
