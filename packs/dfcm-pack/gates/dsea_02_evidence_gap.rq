# Converted from positive-existence ASK to per-gap violation-row SELECT at
# consolidation (2026-10-01): every recorded dea:EvidenceGap carries a positive
# uncertaintyWidth (an unmeasured gap cannot be acquired against).
PREFIX dea: <https://chatman.ai/ontology/dfcm-selection-evidence-acquisition#>
SELECT ?gap WHERE {
  ?gap a dea:EvidenceGap .
  OPTIONAL { ?gap dea:uncertaintyWidth ?width }
  FILTER(!BOUND(?width) || ?width <= 0.0)
}
ORDER BY ?gap
