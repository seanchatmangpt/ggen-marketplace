# Converted from positive-existence ASK to per-candidate violation-row SELECT at
# consolidation (2026-10-01): every dea:Candidate subject is an exact 40-hex SHA.
PREFIX dea: <https://chatman.ai/ontology/dfcm-selection-evidence-acquisition#>
SELECT ?candidate ?sha WHERE {
  ?candidate a dea:Candidate .
  OPTIONAL { ?candidate dea:subjectSha ?sha }
  FILTER(!BOUND(?sha) || strlen(str(?sha)) != 40)
}
ORDER BY ?candidate
