# MESSAGE: DfCM selection policy is a closed executable vocabulary; unclassified policy IRIs cannot silently control option reduction.
PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?policy WHERE {
  ?policy a dfcm:SelectionPolicy .
  FILTER(?policy NOT IN (
    dfcm:ParetoPolicy,
    dfcm:MaximinPolicy,
    dfcm:DecisiveExperimentPolicy,
    dfcm:PortfolioPolicy,
    dfcm:EpsilonDominancePolicy,
    dfcm:DiversityPreservingPolicy,
    dfcm:DependencyReliefPolicy,
    dfcm:FalsifierPressurePolicy
  ))
}
ORDER BY ?policy
