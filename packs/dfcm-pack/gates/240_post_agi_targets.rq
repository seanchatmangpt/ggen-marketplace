# MESSAGE: PostAGIProfile must carry a real, positive agent-population ceiling,
# a real, positive interruptibility-latency bound, and an explicit human
# authority floor requirement -- a profile that self-crowns "post-AGI ready"
# without these bounds set is the same self-crowning failure Fortune5Baseline's
# FEnterpriseTargetCrowned falsifier already refuses, applied to the agent
# governance extension instead of the enterprise SLO extension.
PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?target ?problem WHERE {
  VALUES ?target { dfcm:PostAGIProfile }
  {
    FILTER NOT EXISTS {
      ?target dfcm:agentPopulationCeiling ?c . FILTER(?c > 0)
    }
    BIND("post-agi-profile-missing-population-ceiling" AS ?problem)
  } UNION {
    FILTER NOT EXISTS {
      ?target dfcm:interruptibilityLatencyMs ?l . FILTER(?l > 0)
    }
    BIND("post-agi-profile-missing-interruptibility-bound" AS ?problem)
  } UNION {
    FILTER NOT EXISTS {
      ?target dfcm:humanAuthorityFloorRequired true
    }
    BIND("post-agi-profile-missing-human-authority-floor" AS ?problem)
  }
}
