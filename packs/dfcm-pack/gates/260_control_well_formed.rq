PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?control ?problem WHERE {
  ?control a dfcm:EnterpriseControl .
  { FILTER NOT EXISTS { ?control dfcm:ruleCode ?code . } BIND("missing-rule-code" AS ?problem) }
  UNION { FILTER NOT EXISTS { ?control dfcm:slug ?slug . } BIND("missing-slug" AS ?problem) }
  UNION { FILTER NOT EXISTS { ?control dcterms:title ?title . } BIND("missing-title" AS ?problem) }
  UNION { FILTER NOT EXISTS { ?control dfcm:assuranceDomain ?domain . } BIND("missing-domain" AS ?problem) }
  UNION { FILTER NOT EXISTS { ?control dfcm:criticality ?criticality . } BIND("missing-criticality" AS ?problem) }
  UNION { FILTER NOT EXISTS { ?control dfcm:automated true . } BIND("not-automated" AS ?problem) }
  UNION { FILTER NOT EXISTS { ?control dfcm:evidenceType ?evidence . } BIND("missing-evidence-type" AS ?problem) }
}
