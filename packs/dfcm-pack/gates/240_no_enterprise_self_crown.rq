PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?subject ?problem WHERE {
  VALUES ?subject { dfcm:Fortune5Baseline dfcm:Fortune5SLO dfcm:Fortune5Resilience dfcm:Fortune5Capacity dfcm:Fortune5WorkflowConcurrency dfcm:Fortune5ActuationRate }
  FILTER NOT EXISTS { ?subject dfcm:targetOnly true . }
  BIND("enterprise-target-missing-target-only-fence" AS ?problem)
}
