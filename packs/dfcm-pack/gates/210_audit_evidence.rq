PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE {
  { FILTER NOT EXISTS { dfcm:C014 dfcm:immutableEvidence true ; dfcm:auditRetentionDays ?d . FILTER(?d >= 2555) } BIND("audit-evidence-baseline-incomplete" AS ?problem) }
  UNION { FILTER NOT EXISTS { dfcm:C023 dfcm:requiresReplay true . } BIND("capsule-replay-identity-missing" AS ?problem) }
}
