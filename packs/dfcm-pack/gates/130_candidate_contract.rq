# MESSAGE: every DfCM candidate must carry the complete reversible-option contract; missing CTQ, falsifier, standing, receipt, or authority data refuses generation.
PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?candidate ?missing WHERE {
  ?candidate a dfcm:Candidate .
  VALUES (?property ?missing) {
    (dfcm:slug "slug")
    (dfcm:family "family")
    (dfcm:standing "standing")
    (dfcm:assumption "assumption")
    (dfcm:falsifier "falsifier")
    (dfcm:ctqNovelty "ctqNovelty")
    (dfcm:ctqEvidence "ctqEvidence")
    (dfcm:ctqReversibility "ctqReversibility")
    (dfcm:rollbackCost "rollbackCost")
    (dfcm:uncertainty "uncertainty")
    (dfcm:requiresReceipt "requiresReceipt")
    (dfcm:authority "authority")
  }
  FILTER NOT EXISTS { ?candidate ?property ?value }
}
ORDER BY ?candidate ?missing
