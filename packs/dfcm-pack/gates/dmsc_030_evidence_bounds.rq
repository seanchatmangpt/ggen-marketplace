# Converted from ASK to violation-row SELECT at consolidation (2026-10-01); law unchanged:
# every dms:Candidate carries evidence, uncertainty, and rollback cost.
PREFIX dms: <https://ggen.dev/ontology/dfcm-maximalist-selection-control#>
SELECT ?candidate ?missing WHERE {
  ?candidate a dms:Candidate .
  {
    FILTER NOT EXISTS { ?candidate dms:evidence ?e }
    BIND("evidence" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?candidate dms:uncertainty ?u }
    BIND("uncertainty" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?candidate dms:rollbackCost ?r }
    BIND("rollbackCost" AS ?missing)
  }
}
ORDER BY ?candidate ?missing
