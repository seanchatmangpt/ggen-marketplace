PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?problem WHERE {
  { FILTER NOT EXISTS { dfcm:C012 a dfcm:EnterpriseControl ; dfcm:sbomRequired true ; dfcm:provenanceRequired true ; dfcm:signatureRequired true ; dfcm:dependencyPinningRequired true . } BIND("supply-chain-identity-incomplete" AS ?problem) }
}
