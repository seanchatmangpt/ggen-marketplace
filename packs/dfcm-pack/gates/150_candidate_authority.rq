# MESSAGE: option candidates may SELECT or CONSTRUCT evidence but never possess ambient DO authority, and every option requires a receipt path.
PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?candidate ?authority ?requiresReceipt WHERE {
  ?candidate a dfcm:Candidate ;
    dfcm:authority ?authority ;
    dfcm:requiresReceipt ?requiresReceipt .
  FILTER(?authority NOT IN (dfcm:SELECT, dfcm:CONSTRUCT) || ?requiresReceipt != true)
}
ORDER BY ?candidate
