def standing(evidence: Evidence, exact_subject: bool) -> Standing:
    if evidence.refused:
        return Standing.REFUSED
    if evidence.blocked:
        return Standing.BLOCKED
    if evidence.unsupported:
        return Standing.UNSUPPORTED
    if (exact_subject and evidence.observed and evidence.admitted and evidence.executed
            and evidence.verified and evidence.receipted):
        return Standing.ALIVE
    if evidence.observed or evidence.admitted or evidence.executed or evidence.verified:
        return Standing.PARTIAL_ALIVE
    return Standing.UNKNOWN
