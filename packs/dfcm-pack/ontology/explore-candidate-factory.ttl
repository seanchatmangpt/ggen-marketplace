@prefix dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dfcm:Candidate a prov:Entity ; dct:description "A reversible EXPLORE candidate with bounded standing." .
dfcm:family a prov:Entity .
dfcm:assumption a prov:Entity .
dfcm:dependency a prov:Entity .
dfcm:ctqNovelty a prov:Entity .
dfcm:ctqEvidence a prov:Entity .
dfcm:ctqRollback a prov:Entity .
dfcm:falsifier a prov:Entity .
dfcm:standing a prov:Entity .

dfcm:pareto a dfcm:Candidate ; dfcm:family "pareto" ; dfcm:assumption "multi-objective scores are comparable by dominance" ; dfcm:dependency "objective-vector" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 4 ; dfcm:ctqRollback 5 ; dfcm:falsifier "frontier collapses under exact tie policy" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:mcts a dfcm:Candidate ; dfcm:family "mcts" ; dfcm:assumption "bounded rollout oracle exists" ; dfcm:dependency "simulation-world" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqRollback 5 ; dfcm:falsifier "rollouts are nondeterministic without seed receipt" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:bandit a dfcm:Candidate ; dfcm:family "bandit" ; dfcm:assumption "reward observations are bounded" ; dfcm:dependency "reward-ledger" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 4 ; dfcm:ctqRollback 5 ; dfcm:falsifier "confidence policy cannot replay" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:evolutionary a dfcm:Candidate ; dfcm:family "evolutionary" ; dfcm:assumption "mutation operators preserve admission" ; dfcm:dependency "candidate-genome" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqRollback 4 ; dfcm:falsifier "mutation escapes admitted ontology" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:psro a dfcm:Candidate ; dfcm:family "psro" ; dfcm:assumption "policy-response game is finite enough to bound" ; dfcm:dependency "policy-payoff-matrix" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqRollback 4 ; dfcm:falsifier "best-response oracle lacks deterministic witness" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:temporal a dfcm:Candidate ; dfcm:family "temporal-logic" ; dfcm:assumption "trace propositions are observable" ; dfcm:dependency "trace-ledger" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "property references unobserved proposition" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:fixedpoint a dfcm:Candidate ; dfcm:family "fixed-point" ; dfcm:assumption "transfer function is monotone" ; dfcm:dependency "lattice-domain" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "monotonicity counterexample" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:causal a dfcm:Candidate ; dfcm:family "causal" ; dfcm:assumption "intervention variables are explicitly modeled" ; dfcm:dependency "causal-graph" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqRollback 5 ; dfcm:falsifier "observational equivalence defeats claimed intervention" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:process a dfcm:Candidate ; dfcm:family "process-intelligence" ; dfcm:assumption "event identities and ordering are admitted" ; dfcm:dependency "ocel-log" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "conformance result changes under equivalent serialization" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:distributed a dfcm:Candidate ; dfcm:family "distributed" ; dfcm:assumption "failure model is explicit" ; dfcm:dependency "topology-model" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 4 ; dfcm:ctqRollback 4 ; dfcm:falsifier "safety depends on unstated synchrony" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:runtime a dfcm:Candidate ; dfcm:family "runtime-verification" ; dfcm:assumption "monitor state is receiptable" ; dfcm:dependency "event-stream" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "monitor misses admitted bad prefix" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:security a dfcm:Candidate ; dfcm:family "refusal-security" ; dfcm:assumption "authority is explicit and deny-by-default" ; dfcm:dependency "authority-contract" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "consequential path bypasses BRCE" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:replay a dfcm:Candidate ; dfcm:family "deterministic-replay" ; dfcm:assumption "all entropy inputs are identified" ; dfcm:dependency "receipt-dag" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "same subject and seed yield distinct receipt" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:hypergraph a dfcm:Candidate ; dfcm:family "hypergraph" ; dfcm:assumption "multi-way dependencies are semantically first-class" ; dfcm:dependency "typed-hyperedges" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 4 ; dfcm:ctqRollback 5 ; dfcm:falsifier "binary projection preserves all queried semantics" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:category a dfcm:Candidate ; dfcm:family "categorical-composition" ; dfcm:assumption "morphisms preserve admitted interfaces" ; dfcm:dependency "composition-laws" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqRollback 5 ; dfcm:falsifier "composition breaks identity or associativity on admitted objects" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:metric a dfcm:Candidate ; dfcm:family "metric-topology" ; dfcm:assumption "distance is meaningful on candidate semantics" ; dfcm:dependency "feature-embedding" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqRollback 5 ; dfcm:falsifier "distance violates required metric law" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:constraint a dfcm:Candidate ; dfcm:family "constraint-optimization" ; dfcm:assumption "hard and soft constraints are separable" ; dfcm:dependency "constraint-set" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "solver accepts a hard-constraint violation" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:stochastic a dfcm:Candidate ; dfcm:family "stochastic-process" ; dfcm:assumption "transition kernel is bounded and receipted" ; dfcm:dependency "transition-model" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqRollback 4 ; dfcm:falsifier "distributional replay exceeds admitted tolerance" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:differential a dfcm:Candidate ; dfcm:family "differential-oracle" ; dfcm:assumption "independent reference implementation exists" ; dfcm:dependency "reference-oracle" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "candidate and oracle diverge on admitted corpus" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:metamorphic a dfcm:Candidate ; dfcm:family "metamorphic-testing" ; dfcm:assumption "semantic-preserving transforms are known" ; dfcm:dependency "metamorphic-relations" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "relation fails for admitted transform" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:recovery a dfcm:Candidate ; dfcm:family "recovery" ; dfcm:assumption "rollback boundary is explicit" ; dfcm:dependency "checkpoint-ledger" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "recovery changes pre-failure standing" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:compatibility a dfcm:Candidate ; dfcm:family "compatibility" ; dfcm:assumption "both protocol versions are identified" ; dfcm:dependency "protocol-fixtures" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqRollback 5 ; dfcm:falsifier "roundtrip loses admitted semantics" ; dfcm:standing "PARTIAL_ALIVE" .
dfcm:simulation a dfcm:Candidate ; dfcm:family "simulation-world" ; dfcm:assumption "world dynamics have bounded fidelity claims" ; dfcm:dependency "world-model" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 4 ; dfcm:ctqRollback 5 ; dfcm:falsifier "policy ranking reverses under admitted real trace" ; dfcm:standing "PARTIAL_ALIVE" .
