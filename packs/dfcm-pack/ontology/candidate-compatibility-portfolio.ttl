@prefix dfcm: <https://seanchatman.dev/ontology/dfcm#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dfcm:CandidatePortfolio a dfcm:Capability ;
  dfcm:authority "SELECT" ;
  dfcm:requiresExactSubject true ;
  dfcm:preservesReversibility true .

dfcm:CompatibilityEdge a dfcm:Relation ; dfcm:symmetric true .
dfcm:EvidenceFloor a dfcm:AdmissionInvariant ; dfcm:minEvidence "1"^^xsd:integer .
dfcm:RollbackBound a dfcm:AdmissionInvariant ; dfcm:maxRollback "1.0"^^xsd:decimal .
dfcm:UncertaintyBound a dfcm:AdmissionInvariant ; dfcm:maxWidth "1.0"^^xsd:decimal .
dfcm:ConsequentialDo a dfcm:Authority ; dfcm:exclusiveBroker "BRCE" .
