@prefix ddui: <https://chatman.ai/ontology/dd-ui#> .
@prefix dfcm: <https://chatman.ai/ontology/dfcm#> .
@prefix brce: <https://chatman.ai/ontology/brce#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Canonical DfCM dynamic-UI contract.
ddui:Projection a prov:Entity .
ddui:PresentationCandidate a prov:Entity .
ddui:PresentationFrontier a prov:Entity .
ddui:ScreenReceipt a prov:Entity .
ddui:IntentReceipt a prov:Entity .

ddui:worldDigest a sh:PropertyShape ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 .
ddui:grammarDigest a sh:PropertyShape ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 .
ddui:frontierDigest a sh:PropertyShape ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 .
ddui:screenDigest a sh:PropertyShape ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 .
ddui:irreversibleSelections a sh:PropertyShape ; sh:datatype xsd:integer ; sh:hasValue 0 .
ddui:actuation a sh:PropertyShape ; sh:datatype xsd:boolean ; sh:hasValue false .

ddui:ScreenReceiptShape a sh:NodeShape ;
  sh:targetClass ddui:ScreenReceipt ;
  sh:property ddui:worldDigest, ddui:grammarDigest, ddui:frontierDigest, ddui:screenDigest, ddui:irreversibleSelections .

ddui:IntentReceiptShape a sh:NodeShape ;
  sh:targetClass ddui:IntentReceipt ;
  sh:property ddui:screenDigest, ddui:actuation .

# Constitutional separation: presentation SELECT is reversible; rendered controls may
# manufacture intent but never obtain CONSTRUCT or DO authority by being rendered.
ddui:SELECT dfcm:authorityCeiling ddui:PresentationOnly .
ddui:CONSTRUCT dfcm:requiresExplicitAdmission true .
ddui:DO brce:requiresReceipt true .
