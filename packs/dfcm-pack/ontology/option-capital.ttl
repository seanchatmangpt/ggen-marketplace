@prefix dfcm: <https://ggen.dev/ontology/dfcm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sel: <https://seanchatman.github.io/ggen/selection#> .
@prefix dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#> .
@prefix dms: <https://ggen.dev/ontology/dfcm-maximalist-selection-control#> .
@prefix ex: <https://ggen.dev/ontology/dfcm-explore#> .
@prefix exf: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#> .

# Canonical DfCM option-capital ontology. This file absorbs the reusable semantic
# law previously reminted by selection/explore/court/control packs while leaving
# those packs available as compatibility projections and qualification surfaces.
dfcm:OptionCapitalGraph a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:Candidate a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:CandidateFamily a rdfs:Class ; rdfs:subClassOf skos:Concept .
dfcm:Criterion a rdfs:Class ; rdfs:subClassOf dqv:Metric .
dfcm:Evidence a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:Assumption a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:SelectionPolicy a rdfs:Class ; rdfs:subClassOf prov:Plan .
dfcm:Portfolio a rdfs:Class ; rdfs:subClassOf prov:Collection .
dfcm:DecisiveExperiment a rdfs:Class ; rdfs:subClassOf prov:Plan .
dfcm:GenerationRule a rdfs:Class ; rdfs:subClassOf prov:Plan .
dfcm:TemplateBinding a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:ProjectionPack a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:CompatibilityAlias a rdfs:Class ; rdfs:subClassOf prov:Entity .

dfcm:family a rdf:Property .
dfcm:inFamily a rdf:Property .
dfcm:standing a rdf:Property .
dfcm:assumption a rdf:Property .
dfcm:dependency a rdf:Property .
dfcm:ctqNovelty a rdf:Property .
dfcm:ctqEvidence a rdf:Property .
dfcm:ctqReversibility a rdf:Property .
dfcm:rollbackCost a rdf:Property .
dfcm:uncertainty a rdf:Property .
dfcm:falsifier a rdf:Property .
dfcm:deterministic a rdf:Property .
dfcm:requiresReceipt a rdf:Property .
dfcm:compatibleWith a rdf:Property .
dfcm:dependencyRelief a rdf:Property .
dfcm:reuseCapital a rdf:Property .
dfcm:authority a rdf:Property .
dfcm:member a rdf:Property .
dfcm:selectionPolicy a rdf:Property .
dfcm:sourcePack a rdf:Property .
dfcm:semanticOwner a rdf:Property .
dfcm:canonicalTerm a rdf:Property .
dfcm:legacyTerm a rdf:Property .
dfcm:ruleName a rdf:Property .
dfcm:queryFile a rdf:Property .
dfcm:templateFile a rdf:Property .
dfcm:outputFile a rdf:Property .
dfcm:requiredVariable a rdf:Property .
dfcm:projectedVariable a rdf:Property .
dfcm:missingVariable a rdf:Property .
dfcm:unusedVariable a rdf:Property .
dfcm:generationMode a rdf:Property .
dfcm:skipEmpty a rdf:Property .
dfcm:queryDigest a rdf:Property .
dfcm:templateDigest a rdf:Property .
dfcm:contextDigest a rdf:Property .
dfcm:exactSubject a rdf:Property .
dfcm:currentGeneration a rdf:Property .
dfcm:bindingState a rdf:Property .
dfcm:qualificationTimeoutSeconds a rdf:Property .

# Canonical semantic ownership.
dfcm:OptionCapitalAuthority a prov:Entity ;
  dcterms:title "DfCM option-capital semantic authority" ;
  dfcm:semanticOwner "dfcm-pack" ;
  dfcm:authority dfcm:CONSTRUCT ;
  dfcm:requiresReceipt true ;
  skos:note "Selection and generation describe options. Consequential DO remains BRCE-only." .

# CTQ dimensions are independent axes; scalar collapse is a policy choice, never ontology law.
dfcm:Novelty a dfcm:Criterion ; skos:prefLabel "Novelty" .
dfcm:EvidenceStrength a dfcm:Criterion ; skos:prefLabel "Evidence strength" .
dfcm:ReversibilityStrength a dfcm:Criterion ; skos:prefLabel "Reversibility" .
dfcm:RollbackCost a dfcm:Criterion ; skos:prefLabel "Rollback cost" .
dfcm:Uncertainty a dfcm:Criterion ; skos:prefLabel "Uncertainty" .
dfcm:DependencyRelief a dfcm:Criterion ; skos:prefLabel "Dependency relief" .
dfcm:ReuseCapital a dfcm:Criterion ; skos:prefLabel "Reusable manufacturing capital" .

# Closed selection-policy family. Multi-winner preservation is first-class.
dfcm:ParetoPolicy a dfcm:SelectionPolicy ; skos:prefLabel "Pareto frontier" .
dfcm:MaximinPolicy a dfcm:SelectionPolicy ; skos:prefLabel "Maximin robustness" .
dfcm:DecisiveExperimentPolicy a dfcm:SelectionPolicy ; skos:prefLabel "Decisive experiment" .
dfcm:PortfolioPolicy a dfcm:SelectionPolicy ; skos:prefLabel "Portfolio preservation" .
dfcm:EpsilonDominancePolicy a dfcm:SelectionPolicy ; skos:prefLabel "Epsilon-dominance archive" .
dfcm:DiversityPreservingPolicy a dfcm:SelectionPolicy ; skos:prefLabel "Diversity-preserving archive" .
dfcm:DependencyReliefPolicy a dfcm:SelectionPolicy ; skos:prefLabel "Dependency-relief maximizing" .
dfcm:FalsifierPressurePolicy a dfcm:SelectionPolicy ; skos:prefLabel "Falsifier-pressure maximizing" .

# Candidate families retained from the existing candidate-factory corpus.
# Each family remains a candidate itself: DfCM permits selecting an exploration
# family before selecting a concrete technique within it.
dfcm:FamilyPareto a dfcm:Candidate, dfcm:CandidateFamily ; dfcm:slug "pareto" ; dfcm:family "pareto" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 4 ; dfcm:ctqReversibility 5 ; dfcm:rollbackCost 1 ; dfcm:uncertainty 2 ; dfcm:assumption "multi-objective scores are comparable by dominance" ; dfcm:dependency "objective-vector" ; dfcm:falsifier "frontier collapses under exact tie policy" ; dfcm:standing dfcm:PARTIAL_ALIVE ; dfcm:deterministic true ; dfcm:requiresReceipt true ; dfcm:authority dfcm:SELECT ; dfcm:sourcePack "dfcm-explore-candidate-factory-pack" .
dfcm:FamilyMCTS a dfcm:Candidate, dfcm:CandidateFamily ; dfcm:slug "mcts" ; dfcm:family "mcts" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqReversibility 5 ; dfcm:rollbackCost 2 ; dfcm:uncertainty 4 ; dfcm:assumption "bounded rollout oracle exists" ; dfcm:dependency "simulation-world" ; dfcm:falsifier "rollouts are nondeterministic without seed receipt" ; dfcm:standing dfcm:PARTIAL_ALIVE ; dfcm:deterministic false ; dfcm:requiresReceipt true ; dfcm:authority dfcm:SELECT ; dfcm:sourcePack "dfcm-explore-candidate-factory-pack" .
dfcm:FamilyBandit a dfcm:Candidate, dfcm:CandidateFamily ; dfcm:slug "bandit" ; dfcm:family "bandit" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 4 ; dfcm:ctqReversibility 5 ; dfcm:rollbackCost 1 ; dfcm:uncertainty 3 ; dfcm:assumption "reward observations are bounded" ; dfcm:dependency "reward-ledger" ; dfcm:falsifier "confidence policy cannot replay" ; dfcm:standing dfcm:PARTIAL_ALIVE ; dfcm:deterministic false ; dfcm:requiresReceipt true ; dfcm:authority dfcm:SELECT ; dfcm:sourcePack "dfcm-explore-candidate-factory-pack" .
dfcm:FamilyEvolutionary a dfcm:Candidate, dfcm:CandidateFamily ; dfcm:slug "evolutionary" ; dfcm:family "evolutionary" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqReversibility 4 ; dfcm:rollbackCost 2 ; dfcm:uncertainty 4 ; dfcm:assumption "mutation operators preserve admission" ; dfcm:dependency "candidate-genome" ; dfcm:falsifier "mutation escapes admitted ontology" ; dfcm:standing dfcm:PARTIAL_ALIVE ; dfcm:deterministic false ; dfcm:requiresReceipt true ; dfcm:authority dfcm:SELECT ; dfcm:sourcePack "dfcm-explore-candidate-factory-pack" .
dfcm:FamilyPSRO a dfcm:Candidate, dfcm:CandidateFamily ; dfcm:slug "psro" ; dfcm:family "psro" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqReversibility 4 ; dfcm:rollbackCost 2 ; dfcm:uncertainty 4 ; dfcm:assumption "policy-response game is finite enough to bound" ; dfcm:dependency "policy-payoff-matrix" ; dfcm:falsifier "best-response oracle lacks deterministic witness" ; dfcm:standing dfcm:PARTIAL_ALIVE ; dfcm:deterministic false ; dfcm:requiresReceipt true ; dfcm:authority dfcm:SELECT ; dfcm:sourcePack "dfcm-explore-candidate-factory-pack" .
