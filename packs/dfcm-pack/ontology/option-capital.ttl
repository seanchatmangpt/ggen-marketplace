# Portfolios preserve multiple winners instead of forcing premature scalar selection.
dfcm:ExplorationPortfolio a dfcm:Portfolio ; dfcm:selectionPolicy dfcm:PortfolioPolicy ;
  dfcm:member dfcm:FamilyPareto, dfcm:FamilyMCTS, dfcm:FamilyBandit, dfcm:FamilyEvolutionary, dfcm:FamilyPSRO, dfcm:FamilyTemporalLogic, dfcm:FamilyFixedPoint, dfcm:FamilyCausal, dfcm:FamilyProcessIntelligence, dfcm:FamilyDistributed, dfcm:FamilyRuntimeVerification, dfcm:FamilyRefusalSecurity, dfcm:FamilyReplay, dfcm:FamilyHypergraph, dfcm:FamilyCategorical, dfcm:FamilyMetricTopology, dfcm:FamilyConstraint, dfcm:FamilyStochastic, dfcm:FamilyDifferential, dfcm:FamilyMetamorphic, dfcm:FamilyRecovery, dfcm:FamilyCompatibility, dfcm:FamilySimulation .
dfcm:AlgorithmicPortfolio a dfcm:Portfolio ; dfcm:selectionPolicy dfcm:ParetoPolicy ; dfcm:member dfcm:TechniqueParetoFrontier, dfcm:TechniqueEpsilonDominance, dfcm:TechniqueUCB, dfcm:TechniqueThompson, dfcm:TechniqueMCTS, dfcm:TechniquePSRO, dfcm:TechniqueEvolutionaryArchive, dfcm:TechniqueConstraintSolver .
dfcm:SemanticPortfolio a dfcm:Portfolio ; dfcm:selectionPolicy dfcm:PortfolioPolicy ; dfcm:member dfcm:TechniqueLatticeFixedPoint, dfcm:TechniqueCategoryComposition, dfcm:TechniqueHypergraph, dfcm:TechniqueTemporalLogic .
dfcm:RuntimePortfolio a dfcm:Portfolio ; dfcm:selectionPolicy dfcm:MaximinPolicy ; dfcm:member dfcm:TechniqueEventSourcedReplay, dfcm:TechniqueContentAddressedState, dfcm:TechniqueCRDTArchive, dfcm:TechniqueSnapshotDelta .
dfcm:VerifierPortfolio a dfcm:Portfolio ; dfcm:selectionPolicy dfcm:FalsifierPressurePolicy ; dfcm:member dfcm:TechniqueMetamorphicOracle, dfcm:TechniqueDifferentialOracle, dfcm:TechniquePropertyOracle, dfcm:TechniqueProcessConformance, dfcm:TechniqueCausalIntervention, dfcm:TechniqueRefusalKernel .

# Concrete decisive experiments retain reversible evidence generation before selection.
dfcm:ReplayDecisiveExperiment a dfcm:DecisiveExperiment ; dcterms:title "Replay determinism court" ; dfcm:member dfcm:FamilyReplay, dfcm:TechniqueEventSourcedReplay, dfcm:TechniqueContentAddressedState ; dfcm:falsifier "same admitted capsule produces divergent consequence digest" ; dfcm:authority dfcm:CONSTRUCT ; dfcm:requiresReceipt true .
dfcm:AuthorityDecisiveExperiment a dfcm:DecisiveExperiment ; dcterms:title "Authority bypass court" ; dfcm:member dfcm:FamilyRefusalSecurity, dfcm:TechniqueRefusalKernel ; dfcm:falsifier "unadmitted intent reaches DO" ; dfcm:authority dfcm:CONSTRUCT ; dfcm:requiresReceipt true .
dfcm:ProcessDecisiveExperiment a dfcm:DecisiveExperiment ; dcterms:title "OCEL conformance correspondence court" ; dfcm:member dfcm:FamilyProcessIntelligence, dfcm:TechniqueProcessConformance ; dfcm:falsifier "equivalent admitted OCEL serialization changes analysis result" ; dfcm:authority dfcm:CONSTRUCT ; dfcm:requiresReceipt true ; skos:note "Executed by wasm4pm/wasm4pm-compat." .
dfcm:RecoveryDecisiveExperiment a dfcm:DecisiveExperiment ; dcterms:title "Recovery equivalence court" ; dfcm:member dfcm:FamilyRecovery, dfcm:TechniqueSnapshotDelta ; dfcm:falsifier "recovered state diverges from uninterrupted replay" ; dfcm:authority dfcm:CONSTRUCT ; dfcm:requiresReceipt true .

# Generation-context closure promoted from the maximalist court into canonical DfCM law.
dfcm:OptionCapitalProjectionRule a dfcm:GenerationRule ; dfcm:ruleName "option-capital" ; dfcm:sourcePack "dfcm-pack" ; dfcm:queryFile "queries/option_candidates.rq" ; dfcm:templateFile "templates/OPTION_CAPITAL.json.tmpl" ; dfcm:outputFile "consumer/dfcm/maximalism/OPTION_CAPITAL.json" ; dfcm:requiredVariable "slug", "family", "standing", "ctqNovelty", "ctqEvidence", "ctqReversibility", "rollbackCost", "uncertainty", "falsifier" ; dfcm:generationMode "Overwrite" ; dfcm:skipEmpty false ; dfcm:bindingState "CLOSED" ; dfcm:qualificationTimeoutSeconds 15 .
dfcm:PortfolioProjectionRule a dfcm:GenerationRule ; dfcm:ruleName "option-portfolios" ; dfcm:sourcePack "dfcm-pack" ; dfcm:queryFile "queries/option_portfolios.rq" ; dfcm:templateFile "templates/OPTION_PORTFOLIOS.md.tmpl" ; dfcm:outputFile "consumer/dfcm/maximalism/OPTION_PORTFOLIOS.md" ; dfcm:requiredVariable "portfolio", "policy", "member" ; dfcm:generationMode "Overwrite" ; dfcm:skipEmpty false ; dfcm:bindingState "CLOSED" ; dfcm:qualificationTimeoutSeconds 15 .

# Cross-pack compatibility map. Old terms remain readable; dfcm-pack owns future semantics.
dfcm:Candidate owl:equivalentClass dmc:Candidate, dms:Candidate, ex:Candidate, exf:Candidate, sel:CandidateClass .
dfcm:SelectionPolicy owl:equivalentClass dms:SelectionPolicy .
dfcm:family owl:equivalentProperty dmc:family, exf:family .
dfcm:standing owl:equivalentProperty dmc:standing, ex:standing, exf:standing .
dfcm:assumption owl:equivalentProperty dmc:assumption, ex:assumption, exf:assumption .
dfcm:dependency owl:equivalentProperty dmc:dependency, exf:dependency .
dfcm:ctqNovelty owl:equivalentProperty dmc:ctqNovelty, ex:ctqNovelty, exf:ctqNovelty .
dfcm:ctqEvidence owl:equivalentProperty dmc:ctqEvidence, ex:ctqEvidence, exf:ctqEvidence .
dfcm:ctqReversibility owl:equivalentProperty ex:ctqReversibility .
dfcm:rollbackCost owl:equivalentProperty dmc:rollbackCost, dms:rollbackCost, ex:rollbackCost .
dfcm:falsifier owl:equivalentProperty dmc:falsifier, ex:falsifier, exf:falsifier .
dfcm:deterministic owl:equivalentProperty dmc:deterministic .
dfcm:requiresReceipt owl:equivalentProperty dmc:requiresReceipt, dms:requiresReceipt .
dfcm:compatibleWith owl:equivalentProperty dms:compatibleWith .
dfcm:uncertainty owl:equivalentProperty dms:uncertainty .
dfcm:dependencyRelief owl:equivalentProperty dms:dependencyRelief .
dfcm:reuseCapital owl:equivalentProperty dms:reuseCapital .
dfcm:authority owl:equivalentProperty dms:authority .
dfcm:GenerationRule owl:equivalentClass dmc:GenerationRule .
dfcm:TemplateBinding owl:equivalentClass dmc:TemplateBinding .
dfcm:ruleName owl:equivalentProperty dmc:ruleName .
dfcm:sourcePack owl:equivalentProperty dmc:sourcePack .
dfcm:queryFile owl:equivalentProperty dmc:queryFile .
dfcm:templateFile owl:equivalentProperty dmc:templateFile .
dfcm:outputFile owl:equivalentProperty dmc:outputFile .
dfcm:requiredVariable owl:equivalentProperty dmc:requiredVariable .
dfcm:projectedVariable owl:equivalentProperty dmc:projectedVariable .
dfcm:missingVariable owl:equivalentProperty dmc:missingVariable .
dfcm:unusedVariable owl:equivalentProperty dmc:unusedVariable .
dfcm:generationMode owl:equivalentProperty dmc:generationMode .
dfcm:skipEmpty owl:equivalentProperty dmc:skipEmpty .
dfcm:exactSubject owl:equivalentProperty dmc:exactSubject .
dfcm:bindingState owl:equivalentProperty dmc:bindingState .
dfcm:qualificationTimeoutSeconds owl:equivalentProperty dmc:qualificationTimeoutSeconds .

# Projection-pack registry makes specialization explicit and machine-readable.
dfcm:SelectionCapitalProjection a dfcm:ProjectionPack ; dfcm:slug "dfcm-selection-capital-pack" ; dfcm:semanticOwner "dfcm-pack" ; skos:note "CTQ/selection projection; compatibility namespace retained." .
dfcm:MaximalistCourtProjection a dfcm:ProjectionPack ; dfcm:slug "dfcm-maximalist-court-pack" ; dfcm:semanticOwner "dfcm-pack" ; skos:note "Candidate qualification/select court over canonical option capital." .
dfcm:ExploreCourtProjection a dfcm:ProjectionPack ; dfcm:slug "dfcm-explore-court-pack" ; dfcm:semanticOwner "dfcm-pack" ; skos:note "Rich technique comparison court over canonical candidate semantics." .
dfcm:ExploreFactoryProjection a dfcm:ProjectionPack ; dfcm:slug "dfcm-explore-candidate-factory-pack" ; dfcm:semanticOwner "dfcm-pack" ; skos:note "Candidate-family seed corpus and discovery projection." .
dfcm:SelectionControlProjection a dfcm:ProjectionPack ; dfcm:slug "dfcm-maximalist-selection-control-pack" ; dfcm:semanticOwner "dfcm-pack" ; skos:note "Multi-winner bounded SELECT policy projection." .
dfcm:FullDeploymentProfile a dfcm:ProjectionPack ; dfcm:slug "dfcm-full-deployment-pack" ; dfcm:semanticOwner "dfcm-pack" ; skos:note "Fortune-5 deployment profile; does not own base DfCM law." .
dfcm:GgenRuntimeProjection a dfcm:ProjectionPack ; dfcm:slug "ggen-combinatorial-maximalism-pack" ; dfcm:semanticOwner "dfcm-pack" ; skos:note "Executable GGEN broker/verifier realization of canonical DfCM law." .
