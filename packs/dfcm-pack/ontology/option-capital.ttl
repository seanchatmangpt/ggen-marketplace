dfcm:FamilyFixedPoint a dfcm:Candidate, dfcm:CandidateFamily ; dfcm:slug "fixed-point" ; dfcm:family "fixed-point" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqReversibility 5 ; dfcm:rollbackCost 1 ; dfcm:uncertainty 1 ; dfcm:assumption "transfer function is monotone" ; dfcm:dependency "lattice-domain" ; dfcm:falsifier "monotonicity counterexample" ; dfcm:standing dfcm:PARTIAL_ALIVE ; dfcm:deterministic true ; dfcm:requiresReceipt true ; dfcm:authority dfcm:SELECT ; dfcm:sourcePack "dfcm-explore-candidate-factory-pack" .
dfcm:FamilyCausal a dfcm:Candidate, dfcm:CandidateFamily ; dfcm:slug "causal" ; dfcm:family "causal" ; dfcm:ctqNovelty 5 ; dfcm:ctqEvidence 3 ; dfcm:ctqReversibility 5 ; dfcm:rollbackCost 2 ; dfcm:uncertainty 4 ; dfcm:assumption "intervention variables are explicitly modeled" ; dfcm:dependency "causal-graph" ; dfcm:falsifier "observational equivalence defeats claimed intervention" ; dfcm:standing dfcm:PARTIAL_ALIVE ; dfcm:deterministic false ; dfcm:requiresReceipt true ; dfcm:authority dfcm:SELECT ; dfcm:sourcePack "dfcm-explore-candidate-factory-pack" .
dfcm:FamilyProcessIntelligence a dfcm:Candidate, dfcm:CandidateFamily ; dfcm:slug "process-intelligence" ; dfcm:family "process-intelligence" ; dfcm:ctqNovelty 4 ; dfcm:ctqEvidence 5 ; dfcm:ctqReversibility 5 ; dfcm:rollbackCost 1 ; dfcm:uncertainty 2 ; dfcm:assumption "event identities and ordering are admitted" ; dfcm:dependency "ocel-log" ; dfcm:falsifier "conformance result changes under equivalent serialization" ; dfcm:standing dfcm:PARTIAL_ALIVE ; dfcm:deterministic true ; dfcm:requiresReceipt true ; dfcm:authority dfcm:SELECT ; dfcm:sourcePack "dfcm-explore-candidate-factory-pack" ; skos:note "Analysis executes in wasm4pm/wasm4pm-compat; DfCM retains only selection semantics and evidence references." .
