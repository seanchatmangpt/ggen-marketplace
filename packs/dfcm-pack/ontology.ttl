@prefix dfcm: <https://ggen.dev/ontology/dfcm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

# Vocabulary aligned to public ontologies.
dfcm:DeploymentProfile a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:Component a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:Phase a rdfs:Class ; rdfs:subClassOf skos:Concept .
dfcm:Stage a rdfs:Class ; rdfs:subClassOf skos:Concept .
dfcm:Status a rdfs:Class ; rdfs:subClassOf skos:Concept .
dfcm:Operation a rdfs:Class ; rdfs:subClassOf skos:Concept .
dfcm:Morphism a rdfs:Class ; rdfs:subClassOf prov:Activity .
dfcm:Invariant a rdfs:Class ; rdfs:subClassOf odrl:Constraint .
dfcm:Falsifier a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:RefusalKind a rdfs:Class ; rdfs:subClassOf skos:Concept .
dfcm:ReceiptContract a rdfs:Class ; rdfs:subClassOf prov:Plan .
dfcm:AuthorityRoute a rdfs:Class ; rdfs:subClassOf odrl:Policy .

dfcm:order a rdf:Property .
dfcm:slug a rdf:Property .
dfcm:next a rdf:Property .
dfcm:reversibility a rdf:Property .
dfcm:fromObject a rdf:Property .
dfcm:toObject a rdf:Property .
dfcm:requires a rdf:Property .
dfcm:includesComponent a rdf:Property .
dfcm:required a rdf:Property .
dfcm:layer a rdf:Property .
dfcm:dependsOn a rdf:Property .
dfcm:operation a rdf:Property .
dfcm:authorityRoute a rdf:Property .
dfcm:receiptRoute a rdf:Property .
dfcm:mayActuate a rdf:Property .
dfcm:ruleCode a rdf:Property .
dfcm:ruleText a rdf:Property .
dfcm:falsifiedBy a rdf:Property .
dfcm:terminal a rdf:Property .
dfcm:externalClaim a rdf:Property .

# Foundational order.
dfcm:Preserve a dfcm:Phase ; dfcm:order 10 ; dfcm:slug "preserve" ; skos:prefLabel "Preserve maximal reversible lawful possibilities" ; dfcm:next dfcm:Fence .
dfcm:Fence a dfcm:Phase ; dfcm:order 20 ; dfcm:slug "fence" ; skos:prefLabel "Fence existing purpose and irreversible boundaries" ; dfcm:next dfcm:Calculus .
dfcm:Calculus a dfcm:Phase ; dfcm:order 30 ; dfcm:slug "calculus" ; skos:prefLabel "Define objects, morphisms, admission, closure, authority, actuation, receipt, replay" ; dfcm:next dfcm:Exclusions .
dfcm:Exclusions a dfcm:Phase ; dfcm:order 40 ; dfcm:slug "exclusions" ; skos:prefLabel "Exclude ambient execution authority and category collapse" ; dfcm:next dfcm:FalsifierPhase .
dfcm:FalsifierPhase a dfcm:Phase ; dfcm:order 50 ; dfcm:slug "falsifier" ; skos:prefLabel "Name what would falsify standing" ; dfcm:next dfcm:Extension .
dfcm:Extension a dfcm:Phase ; dfcm:order 60 ; dfcm:slug "extension" ; skos:prefLabel "Extend only by lawful graph-preserving morphisms" ; dfcm:next dfcm:Operationalization .
dfcm:Operationalization a dfcm:Phase ; dfcm:order 70 ; dfcm:slug "operationalization" ; skos:prefLabel "Manufacture, actuate through BRCE, receipt, replay, and assign bounded standing" .

# Runtime stages.
dfcm:Parse a dfcm:Stage ; dfcm:order 10 ; dfcm:slug "parse" ; dfcm:next dfcm:Route .
dfcm:Route a dfcm:Stage ; dfcm:order 20 ; dfcm:slug "route" ; dfcm:next dfcm:AdmitOrRefuse .
dfcm:AdmitOrRefuse a dfcm:Stage ; dfcm:order 30 ; dfcm:slug "admit-refuse" ; dfcm:next dfcm:DiagnoseRepair .
dfcm:DiagnoseRepair a dfcm:Stage ; dfcm:order 40 ; dfcm:slug "diagnose-repair" ; dfcm:next dfcm:Construct .
dfcm:Construct a dfcm:Stage ; dfcm:order 50 ; dfcm:slug "construct" ; dfcm:next dfcm:Actuate .
dfcm:Actuate a dfcm:Stage ; dfcm:order 60 ; dfcm:slug "actuate" ; dfcm:next dfcm:Receipt .
dfcm:Receipt a dfcm:Stage ; dfcm:order 70 ; dfcm:slug "receipt" ; dfcm:next dfcm:ReplayHook .
dfcm:ReplayHook a dfcm:Stage ; dfcm:order 80 ; dfcm:slug "replay-hook" ; dfcm:next dfcm:Standing .
dfcm:Standing a dfcm:Stage ; dfcm:order 90 ; dfcm:slug "standing" .

# Explicit operation authority split.
dfcm:SELECT a dfcm:Operation ; dfcm:order 10 ; dfcm:slug "SELECT" ; dfcm:reversibility "decision" ; dfcm:mayActuate false .
dfcm:CONSTRUCT a dfcm:Operation ; dfcm:order 20 ; dfcm:slug "CONSTRUCT" ; dfcm:reversibility "reversible" ; dfcm:mayActuate false .
dfcm:DO a dfcm:Operation ; dfcm:order 30 ; dfcm:slug "DO" ; dfcm:reversibility "irreversible" ; dfcm:mayActuate true ; dfcm:authorityRoute dfcm:BRCE ; dfcm:receiptRoute dfcm:ReceiptDAG .

# Standing lattice: REFUSED is classified separately through typed refusal kinds.
dfcm:UNKNOWN a dfcm:Status ; dfcm:order 10 ; dfcm:slug "UNKNOWN" ; skos:prefLabel "Observed or generated, not admitted/executed" ; dfcm:externalClaim false .
dfcm:PARTIAL_ALIVE a dfcm:Status ; dfcm:order 20 ; dfcm:slug "PARTIAL_ALIVE" ; skos:prefLabel "Some required proof surfaces are alive" ; dfcm:externalClaim true .
dfcm:ALIVE a dfcm:Status ; dfcm:order 30 ; dfcm:slug "ALIVE" ; skos:prefLabel "Exact admitted subject observed executing with receipt" ; dfcm:externalClaim true .
dfcm:BLOCKED a dfcm:Status ; dfcm:order 40 ; dfcm:slug "BLOCKED" ; skos:prefLabel "A required transition cannot proceed because an external or authority dependency is unavailable" ; dfcm:externalClaim true .
dfcm:BUILD_BROKEN a dfcm:Status ; dfcm:order 50 ; dfcm:slug "BUILD_BROKEN" ; skos:prefLabel "Construction or validation failed" ; dfcm:externalClaim true .
dfcm:UNSUPPORTED a dfcm:Status ; dfcm:order 60 ; dfcm:slug "UNSUPPORTED" ; skos:prefLabel "No lawful capability edge exists in the admitted environment" ; dfcm:externalClaim true .
dfcm:REFUSED a dfcm:Status ; dfcm:order 70 ; dfcm:slug "REFUSED" ; skos:prefLabel "A typed policy refusal rejected the requested transition" ; dfcm:externalClaim true .

# Typed refusal taxonomy.
dfcm:DirectDo a dfcm:RefusalKind ; dfcm:slug "REFUSED:DIRECT_DO" .
dfcm:MissingAdmission a dfcm:RefusalKind ; dfcm:slug "REFUSED:MISSING_ADMISSION" .
dfcm:MissingAuthority a dfcm:RefusalKind ; dfcm:slug "REFUSED:MISSING_AUTHORITY" .
dfcm:MissingReceiptRoute a dfcm:RefusalKind ; dfcm:slug "REFUSED:MISSING_RECEIPT_ROUTE" .
dfcm:HookActuation a dfcm:RefusalKind ; dfcm:slug "REFUSED:HOOK_ACTUATION" .
dfcm:AliveWithoutExecution a dfcm:RefusalKind ; dfcm:slug "REFUSED:ALIVE_WITHOUT_EXACT_EXECUTION" .
dfcm:BaseDrift a dfcm:RefusalKind ; dfcm:slug "REFUSED:BASE_DRIFT" .
dfcm:UnreceiptedActuation a dfcm:RefusalKind ; dfcm:slug "REFUSED:UNRECEIPTED_ACTUATION" .
dfcm:NondeterministicReplay a dfcm:RefusalKind ; dfcm:slug "REFUSED:NONDETERMINISTIC_REPLAY" .

# Authority and receipt contracts.
dfcm:BRCE a dfcm:AuthorityRoute, odrl:Policy ; dcterms:title "Bounded Receipted Chatman Equation" ; dfcm:slug "BRCE" ; dfcm:mayActuate true .
dfcm:DirectExecution a dfcm:AuthorityRoute ; dfcm:slug "DIRECT" ; dfcm:mayActuate false .
dfcm:IntentHook a prov:Activity ; dfcm:slug "HOOK" ; dfcm:mayActuate false ; skos:note "Hooks manufacture intents only." .
dfcm:ReceiptDAG a dfcm:ReceiptContract ; dfcm:slug "receipt-dag" ; skos:note "Binds subject identity, admitted authority, consequence, verifier evidence, replay identity, and standing." .

# Core morphisms.
dfcm:ObserveToAdmit a dfcm:Morphism ; dfcm:order 10 ; dfcm:slug "observe-admit" ; dfcm:fromObject "O" ; dfcm:toObject "O*" ; dfcm:reversibility "reversible" .
dfcm:AdmitToConstruct a dfcm:Morphism ; dfcm:order 20 ; dfcm:slug "admit-construct" ; dfcm:fromObject "O*" ; dfcm:toObject "constructed-option" ; dfcm:reversibility "reversible" .
dfcm:ConstructToSelect a dfcm:Morphism ; dfcm:order 30 ; dfcm:slug "construct-select" ; dfcm:fromObject "option-graph" ; dfcm:toObject "selected-intent" ; dfcm:reversibility "decision" .
dfcm:SelectToBRCE a dfcm:Morphism ; dfcm:order 40 ; dfcm:slug "select-brce" ; dfcm:fromObject "selected-intent" ; dfcm:toObject "authorized-actuation" ; dfcm:reversibility "irreversible" ; dfcm:requires dfcm:BRCE .
dfcm:ActuationToReceipt a dfcm:Morphism ; dfcm:order 50 ; dfcm:slug "actuate-receipt" ; dfcm:fromObject "authorized-actuation" ; dfcm:toObject "receipt" ; dfcm:reversibility "irreversible" ; dfcm:requires dfcm:ReceiptDAG .
dfcm:ReceiptToReplay a dfcm:Morphism ; dfcm:order 60 ; dfcm:slug "receipt-replay" ; dfcm:fromObject "receipt" ; dfcm:toObject "replay" ; dfcm:reversibility "reversible" .
dfcm:ReplayToStanding a dfcm:Morphism ; dfcm:order 70 ; dfcm:slug "replay-standing" ; dfcm:fromObject "replay" ; dfcm:toObject "bounded-standing" ; dfcm:reversibility "decision" .

# Invariants and falsifiers.
dfcm:I001 a dfcm:Invariant ; dfcm:order 10 ; dfcm:ruleCode "DFCM-I001" ; dfcm:ruleText "Preserve all admitted reversible options until an irreversible selection has its own admission evidence." ; dfcm:falsifiedBy dfcm:FSelectionBeforeAdmission .
dfcm:I002 a dfcm:Invariant ; dfcm:order 20 ; dfcm:ruleCode "DFCM-I002" ; dfcm:ruleText "SELECT, CONSTRUCT, and DO are distinct authority domains." ; dfcm:falsifiedBy dfcm:FDirectDo .
dfcm:I003 a dfcm:Invariant ; dfcm:order 30 ; dfcm:ruleCode "DFCM-I003" ; dfcm:ruleText "BRCE is the exclusive DO path; zero unreceipted actuation." ; dfcm:falsifiedBy dfcm:FUnreceiptedDo .
dfcm:I004 a dfcm:Invariant ; dfcm:order 40 ; dfcm:ruleCode "DFCM-I004" ; dfcm:ruleText "Hooks manufacture intents and never actuate." ; dfcm:falsifiedBy dfcm:FHookActuates .
dfcm:I005 a dfcm:Invariant ; dfcm:order 50 ; dfcm:ruleCode "DFCM-I005" ; dfcm:ruleText "ALIVE requires observed execution against the exact admitted subject and a receipt." ; dfcm:falsifiedBy dfcm:FAliveWithoutExecution .
dfcm:I006 a dfcm:Invariant ; dfcm:order 60 ; dfcm:ruleCode "DFCM-I006" ; dfcm:ruleText "UNKNOWN is not admission; UNSUPPORTED is not REFUSED." ; dfcm:falsifiedBy dfcm:FCategoryCollapse .
dfcm:I007 a dfcm:Invariant ; dfcm:order 70 ; dfcm:ruleCode "DFCM-I007" ; dfcm:ruleText "One failed edge prunes topology; it does not collapse the remaining lawful option graph." ; dfcm:falsifiedBy dfcm:FGraphCollapse .
dfcm:I008 a dfcm:Invariant ; dfcm:order 80 ; dfcm:ruleCode "DFCM-I008" ; dfcm:ruleText "Source, validator, toolchain, configuration, environment, and exact base identities are receipt inputs." ; dfcm:falsifiedBy dfcm:FBaseDrift .
dfcm:I009 a dfcm:Invariant ; dfcm:order 90 ; dfcm:ruleCode "DFCM-I009" ; dfcm:ruleText "Replay standing requires deterministic consequences for the same admitted capsule." ; dfcm:falsifiedBy dfcm:FNondeterministicReplay .
dfcm:I010 a dfcm:Invariant ; dfcm:order 100 ; dfcm:ruleCode "DFCM-I010" ; dfcm:ruleText "Generated declarations, proofs, model output, and planner output have no ambient execution authority." ; dfcm:falsifiedBy dfcm:FAmbientAuthority .

dfcm:FSelectionBeforeAdmission a dfcm:Falsifier ; dfcm:slug "selection-before-admission" ; skos:prefLabel "An irreversible option is selected without admitted evidence." .
dfcm:FDirectDo a dfcm:Falsifier ; dfcm:slug "direct-do" ; skos:prefLabel "A DO action bypasses BRCE." .
dfcm:FUnreceiptedDo a dfcm:Falsifier ; dfcm:slug "unreceipted-do" ; skos:prefLabel "A consequential action completes without a receipt route and receipt." .
dfcm:FHookActuates a dfcm:Falsifier ; dfcm:slug "hook-actuates" ; skos:prefLabel "A hook invokes an actuator instead of emitting intent." .
dfcm:FAliveWithoutExecution a dfcm:Falsifier ; dfcm:slug "alive-without-execution" ; skos:prefLabel "ALIVE is assigned without execution against the exact admitted subject." .
dfcm:FCategoryCollapse a dfcm:Falsifier ; dfcm:slug "category-collapse" ; skos:prefLabel "UNKNOWN, UNSUPPORTED, and REFUSED are treated as interchangeable." .
dfcm:FGraphCollapse a dfcm:Falsifier ; dfcm:slug "graph-collapse" ; skos:prefLabel "A failed edge deletes otherwise lawful reversible alternatives." .
dfcm:FBaseDrift a dfcm:Falsifier ; dfcm:slug "base-drift" ; skos:prefLabel "Execution or publication silently moves from the admitted base identity." .
dfcm:FNondeterministicReplay a dfcm:Falsifier ; dfcm:slug "nondeterministic-replay" ; skos:prefLabel "Same admitted capsule manufactures different consequences without admitted nondeterminism." .
dfcm:FAmbientAuthority a dfcm:Falsifier ; dfcm:slug "ambient-authority" ; skos:prefLabel "A raw/model/planner/proof/generated artifact directly acquires execution authority." .

# Full Chatman ecosystem deployment profile. Names are deployment subjects, not claims of runtime standing.
dfcm:FullChatmanEcosystem a dfcm:DeploymentProfile ; dcterms:title "Full Chatman Ecosystem" ; dfcm:slug "chatman-ecosystem-full" ;
  dfcm:includesComponent dfcm:ggen, dfcm:ggenLegacy, dfcm:starToml, dfcm:mfact, dfcm:MU, dfcm:gymact, dfcm:autofdeLab, dfcm:wasm4pm, dfcm:POWL, dfcm:gdmcp, dfcm:processIntelligence, dfcm:ggenMarketplace, dfcm:chatmanEngine, dfcm:chatmanEcosystemRelease, dfcm:sregym, dfcm:fdegym, dfcm:rrgym, dfcm:awesomeAiGym, dfcm:praxis, dfcm:lspMax .

dfcm:ggen a dfcm:Component ; dfcm:order 10 ; dfcm:slug "ggen" ; rdfs:label "ggen" ; dfcm:layer "manufacture" ; dfcm:required true .
dfcm:ggenLegacy a dfcm:Component ; dfcm:order 20 ; dfcm:slug "ggen-legacy" ; rdfs:label "ggen-legacy" ; dfcm:layer "reconstitution" ; dfcm:required true ; dfcm:dependsOn dfcm:ggen .
dfcm:starToml a dfcm:Component ; dfcm:order 30 ; dfcm:slug "star-toml" ; rdfs:label "star-toml" ; dfcm:layer "admission" ; dfcm:required true .
dfcm:mfact a dfcm:Component ; dfcm:order 40 ; dfcm:slug "mfact" ; rdfs:label "mfact" ; dfcm:layer "formal-proof" ; dfcm:required true ; dfcm:dependsOn dfcm:ggen .
dfcm:MU a dfcm:Component ; dfcm:order 50 ; dfcm:slug "MU" ; rdfs:label "MU (μ)" ; dfcm:layer "lawful-manufacture" ; dfcm:required true ; dfcm:dependsOn dfcm:ggen .
dfcm:gymact a dfcm:Component ; dfcm:order 60 ; dfcm:slug "gymact" ; rdfs:label "gymact" ; dfcm:layer "actuation" ; dfcm:required true ; dfcm:dependsOn dfcm:starToml .
dfcm:autofdeLab a dfcm:Component ; dfcm:order 70 ; dfcm:slug "autofde-lab" ; rdfs:label "autofde-lab" ; dfcm:layer "forward-deployment" ; dfcm:required true ; dfcm:dependsOn dfcm:gymact .
dfcm:wasm4pm a dfcm:Component ; dfcm:order 80 ; dfcm:slug "wasm4pm" ; rdfs:label "wasm4pm" ; dfcm:layer "process-intelligence" ; dfcm:required true .
dfcm:POWL a dfcm:Component ; dfcm:order 90 ; dfcm:slug "POWL" ; rdfs:label "POWL" ; dfcm:layer "workflow" ; dfcm:required true ; dfcm:dependsOn dfcm:wasm4pm .
dfcm:gdmcp a dfcm:Component ; dfcm:order 100 ; dfcm:slug "gdmcp" ; rdfs:label "gdmcp" ; dfcm:layer "deterministic-mcp" ; dfcm:required true ; dfcm:dependsOn dfcm:ggen, dfcm:gymact .
dfcm:processIntelligence a dfcm:Component ; dfcm:order 110 ; dfcm:slug "process-intelligence" ; rdfs:label "process-intelligence" ; dfcm:layer "process-intelligence" ; dfcm:required true ; dfcm:dependsOn dfcm:wasm4pm .
dfcm:ggenMarketplace a dfcm:Component ; dfcm:order 120 ; dfcm:slug "ggen-marketplace" ; rdfs:label "ggen-marketplace" ; dfcm:layer "pack-publication" ; dfcm:required true ; dfcm:dependsOn dfcm:ggen .
dfcm:chatmanEngine a dfcm:Component ; dfcm:order 130 ; dfcm:slug "chatman-engine" ; rdfs:label "chatman-engine" ; dfcm:layer "engine" ; dfcm:required true ; dfcm:dependsOn dfcm:MU .
dfcm:chatmanEcosystemRelease a dfcm:Component ; dfcm:order 140 ; dfcm:slug "chatman-ecosystem-release-pack" ; rdfs:label "chatman-ecosystem-release-pack" ; dfcm:layer "release" ; dfcm:required true ; dfcm:dependsOn dfcm:ggenMarketplace ; skos:note "Release control plane; not deployment actuator." .
dfcm:sregym a dfcm:Component ; dfcm:order 150 ; dfcm:slug "sregym" ; rdfs:label "sregym" ; dfcm:layer "gym" ; dfcm:required true ; dfcm:dependsOn dfcm:gymact .
dfcm:fdegym a dfcm:Component ; dfcm:order 160 ; dfcm:slug "fdegym" ; rdfs:label "fdegym" ; dfcm:layer "gym" ; dfcm:required true ; dfcm:dependsOn dfcm:gymact .
dfcm:rrgym a dfcm:Component ; dfcm:order 170 ; dfcm:slug "rrgym" ; rdfs:label "rrgym" ; dfcm:layer "gym" ; dfcm:required false ; dfcm:dependsOn dfcm:gymact .
dfcm:awesomeAiGym a dfcm:Component ; dfcm:order 180 ; dfcm:slug "awesome-ai-gym" ; rdfs:label "awesome-ai-gym" ; dfcm:layer "gym-corpus" ; dfcm:required true ; dfcm:dependsOn dfcm:gymact .
dfcm:praxis a dfcm:Component ; dfcm:order 190 ; dfcm:slug "praxis" ; rdfs:label "praxis" ; dfcm:layer "practice" ; dfcm:required false ; dfcm:dependsOn dfcm:ggen .
dfcm:lspMax a dfcm:Component ; dfcm:order 200 ; dfcm:slug "LSP-MAX" ; rdfs:label "LSP-MAX" ; dfcm:layer "code-intelligence" ; dfcm:required false ; dfcm:dependsOn dfcm:ggen .

# Fortune-5 readiness vocabulary. These are design/admission objects, never runtime claims.
dfcm:EnterpriseReadinessProfile a rdfs:Class ; rdfs:subClassOf prov:Plan .
dfcm:AssuranceDomain a rdfs:Class ; rdfs:subClassOf skos:Concept .
dfcm:EnterpriseControl a rdfs:Class ; rdfs:subClassOf odrl:Constraint .
dfcm:ServiceTier a rdfs:Class ; rdfs:subClassOf skos:Concept .
dfcm:FailureDomain a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:RecoveryObjective a rdfs:Class ; rdfs:subClassOf prov:Plan .
dfcm:ScaleTarget a rdfs:Class ; rdfs:subClassOf prov:Plan .
dfcm:ChangeClass a rdfs:Class ; rdfs:subClassOf skos:Concept .
dfcm:DataClass a rdfs:Class ; rdfs:subClassOf skos:Concept .
dfcm:ReleaseWave a rdfs:Class ; rdfs:subClassOf prov:Plan .
dfcm:EvidenceRequirement a rdfs:Class ; rdfs:subClassOf prov:Plan .
dfcm:BreakGlassPolicy a rdfs:Class ; rdfs:subClassOf odrl:Policy .

dfcm:includesControl a rdf:Property .
dfcm:assuranceDomain a rdf:Property .
dfcm:criticality a rdf:Property .
dfcm:automated a rdf:Property .
dfcm:evidenceType a rdf:Property .
dfcm:targetOnly a rdf:Property .
dfcm:targetValue a rdf:Property .
dfcm:targetUnit a rdf:Property .
dfcm:serviceTier a rdf:Property .
dfcm:regionsRequired a rdf:Property .
dfcm:zonesPerRegion a rdf:Property .
dfcm:providersRequired a rdf:Property .
dfcm:activeActive a rdf:Property .
dfcm:availabilityTarget a rdf:Property .
dfcm:errorBudgetMinutes30d a rdf:Property .
dfcm:rtoSeconds a rdf:Property .
dfcm:rpoSeconds a rdf:Property .
dfcm:maxBlastRadiusPercent a rdf:Property .
dfcm:maxConcurrentChangePercent a rdf:Property .
dfcm:approvalQuorum a rdf:Property .
dfcm:independentAuthorityDomains a rdf:Property .
dfcm:machineEligible a rdf:Property .
dfcm:canaryRequired a rdf:Property .
dfcm:rollbackRequired a rdf:Property .
dfcm:breakGlassRoute a rdf:Property .
dfcm:requiresReceipt a rdf:Property .
dfcm:requiresReplay a rdf:Property .
dfcm:encryptionAtRest a rdf:Property .
dfcm:encryptionInTransit a rdf:Property .
dfcm:keyIsolation a rdf:Property .
dfcm:residencyEnforced a rdf:Property .
dfcm:tenantIsolation a rdf:Property .
dfcm:immutableEvidence a rdf:Property .
dfcm:auditRetentionDays a rdf:Property .
dfcm:sbomRequired a rdf:Property .
dfcm:provenanceRequired a rdf:Property .
dfcm:signatureRequired a rdf:Property .
dfcm:dependencyPinningRequired a rdf:Property .
dfcm:zeroTrust a rdf:Property .
dfcm:continuousVerification a rdf:Property .
dfcm:chaosRequired a rdf:Property .
dfcm:drExerciseDays a rdf:Property .
dfcm:providerPortable a rdf:Property .
dfcm:exitPlanRequired a rdf:Property .
dfcm:budgetGuardrailRequired a rdf:Property .
dfcm:unitEconomicsRequired a rdf:Property .
dfcm:telemetryMetrics a rdf:Property .
dfcm:telemetryLogs a rdf:Property .
dfcm:telemetryTraces a rdf:Property .
dfcm:incidentReceiptRequired a rdf:Property .
dfcm:postIncidentReplayRequired a rdf:Property .
dfcm:policyAsCode a rdf:Property .
dfcm:controlCoverageRequired a rdf:Property .
dfcm:minimumControls a rdf:Property .
dfcm:releasePercent a rdf:Property .
dfcm:requiresPriorWave a rdf:Property .
dfcm:population a rdf:Property .

# Assurance domains: all are mandatory for Fortune5Baseline.
dfcm:IdentityAuthority a dfcm:AssuranceDomain ; dfcm:order 10 ; dfcm:slug "identity-authority" ; skos:prefLabel "Identity, authority, and zero trust" .
dfcm:ChangeRelease a dfcm:AssuranceDomain ; dfcm:order 20 ; dfcm:slug "change-release" ; skos:prefLabel "Change and progressive release" .
dfcm:AvailabilityResilience a dfcm:AssuranceDomain ; dfcm:order 30 ; dfcm:slug "availability-resilience" ; skos:prefLabel "Availability, cell isolation, and resilience" .
dfcm:DisasterRecovery a dfcm:AssuranceDomain ; dfcm:order 40 ; dfcm:slug "disaster-recovery" ; skos:prefLabel "Disaster recovery and business continuity" .
dfcm:CapacityPerformance a dfcm:AssuranceDomain ; dfcm:order 50 ; dfcm:slug "capacity-performance" ; skos:prefLabel "Capacity, performance, and overload behavior" .
dfcm:ObservabilitySLO a dfcm:AssuranceDomain ; dfcm:order 60 ; dfcm:slug "observability-slo" ; skos:prefLabel "Observability, SLOs, and error budgets" .
dfcm:IncidentResponse a dfcm:AssuranceDomain ; dfcm:order 70 ; dfcm:slug "incident-response" ; skos:prefLabel "Incident response, forensic receipts, and replay" .
dfcm:DataGovernance a dfcm:AssuranceDomain ; dfcm:order 80 ; dfcm:slug "data-governance" ; skos:prefLabel "Data classification, residency, retention, and lifecycle" .
dfcm:CryptoSecrets a dfcm:AssuranceDomain ; dfcm:order 90 ; dfcm:slug "crypto-secrets" ; skos:prefLabel "Cryptography, secrets, key isolation, and rotation" .
dfcm:SupplyChain a dfcm:AssuranceDomain ; dfcm:order 100 ; dfcm:slug "supply-chain" ; skos:prefLabel "Software supply chain, provenance, and dependency integrity" .
dfcm:TenancyIsolation a dfcm:AssuranceDomain ; dfcm:order 110 ; dfcm:slug "tenancy-isolation" ; skos:prefLabel "Tenant, workload, and blast-radius isolation" .
dfcm:AuditEvidence a dfcm:AssuranceDomain ; dfcm:order 120 ; dfcm:slug "audit-evidence" ; skos:prefLabel "Immutable audit evidence, retention, and replayability" .
dfcm:FinOps a dfcm:AssuranceDomain ; dfcm:order 130 ; dfcm:slug "finops" ; skos:prefLabel "Cost guardrails and unit economics" .
dfcm:PortabilityExit a dfcm:AssuranceDomain ; dfcm:order 140 ; dfcm:slug "portability-exit" ; skos:prefLabel "Provider portability and executable exit plans" .
dfcm:PolicyCompliance a dfcm:AssuranceDomain ; dfcm:order 150 ; dfcm:slug "policy-compliance" ; skos:prefLabel "Policy-as-code and evidence mapping" .
dfcm:ChaosSafety a dfcm:AssuranceDomain ; dfcm:order 160 ; dfcm:slug "chaos-safety" ; skos:prefLabel "Chaos, safety envelopes, and bounded failure injection" .
dfcm:LifecycleDeprecation a dfcm:AssuranceDomain ; dfcm:order 170 ; dfcm:slug "lifecycle-deprecation" ; skos:prefLabel "Lifecycle, migration, deprecation, and reversible exit" .
dfcm:OperationalReadiness a dfcm:AssuranceDomain ; dfcm:order 180 ; dfcm:slug "operational-readiness" ; skos:prefLabel "Production readiness and release standing" .

# Service tiers and bounded targets. Values are target envelopes, not observations.
dfcm:Tier0 a dfcm:ServiceTier ; dfcm:order 0 ; dfcm:slug "tier-0" ; skos:prefLabel "Enterprise critical control plane" .
dfcm:Tier1 a dfcm:ServiceTier ; dfcm:order 10 ; dfcm:slug "tier-1" ; skos:prefLabel "Business critical service" .
dfcm:Tier2 a dfcm:ServiceTier ; dfcm:order 20 ; dfcm:slug "tier-2" ; skos:prefLabel "Standard production service" .

dfcm:Fortune5SLO a dfcm:RecoveryObjective ; dfcm:slug "fortune5-tier0-slo" ; dfcm:serviceTier dfcm:Tier0 ;
  dfcm:targetOnly true ; dfcm:availabilityTarget 0.9999 ; dfcm:errorBudgetMinutes30d 4.32 ;
  dfcm:rtoSeconds 900 ; dfcm:rpoSeconds 300 .
dfcm:Fortune5Resilience a dfcm:RecoveryObjective ; dfcm:slug "fortune5-resilience" ; dfcm:targetOnly true ;
  dfcm:regionsRequired 3 ; dfcm:zonesPerRegion 3 ; dfcm:providersRequired 2 ; dfcm:activeActive true ;
  dfcm:maxBlastRadiusPercent 5 ; dfcm:drExerciseDays 30 ; dfcm:chaosRequired true .
dfcm:Fortune5Capacity a dfcm:ScaleTarget ; dfcm:slug "fortune5-capacity-envelope" ; dfcm:targetOnly true ;
  dfcm:targetValue 1000000 ; dfcm:targetUnit "intents-per-second" ;
  skos:note "Baseline throughput target for admission/receipt plane; must be benchmarked before ALIVE." .
dfcm:Fortune5WorkflowConcurrency a dfcm:ScaleTarget ; dfcm:slug "fortune5-workflow-concurrency" ; dfcm:targetOnly true ;
  dfcm:targetValue 100000 ; dfcm:targetUnit "concurrent-workflows" .
dfcm:Fortune5ActuationRate a dfcm:ScaleTarget ; dfcm:slug "fortune5-actuation-rate" ; dfcm:targetOnly true ;
  dfcm:targetValue 10000 ; dfcm:targetUnit "receipted-actuations-per-second" .

# Production change classes and progressive waves. Independent domains may be machine authorities.
dfcm:StandardChange a dfcm:ChangeClass ; dfcm:order 10 ; dfcm:slug "standard" ; dfcm:approvalQuorum 1 ;
  dfcm:independentAuthorityDomains 1 ; dfcm:machineEligible true ; dfcm:canaryRequired true ; dfcm:rollbackRequired true ;
  dfcm:breakGlassRoute dfcm:Fortune5BreakGlass ; dfcm:requiresReceipt true .
dfcm:HighRiskChange a dfcm:ChangeClass ; dfcm:order 20 ; dfcm:slug "high-risk" ; dfcm:approvalQuorum 2 ;
  dfcm:independentAuthorityDomains 2 ; dfcm:machineEligible true ; dfcm:canaryRequired true ; dfcm:rollbackRequired true ;
  dfcm:maxConcurrentChangePercent 5 ; dfcm:breakGlassRoute dfcm:Fortune5BreakGlass ; dfcm:requiresReceipt true .
dfcm:EmergencyChange a dfcm:ChangeClass ; dfcm:order 30 ; dfcm:slug "emergency" ; dfcm:approvalQuorum 2 ;
  dfcm:independentAuthorityDomains 2 ; dfcm:machineEligible true ; dfcm:canaryRequired false ; dfcm:rollbackRequired true ;
  dfcm:breakGlassRoute dfcm:Fortune5BreakGlass ; dfcm:requiresReceipt true .
dfcm:Fortune5BreakGlass a dfcm:BreakGlassPolicy ; dfcm:slug "fortune5-break-glass" ;
  dfcm:authorityRoute dfcm:BRCE ; dfcm:receiptRoute dfcm:ReceiptDAG ; dfcm:requiresReceipt true ; dfcm:requiresReplay true ;
  skos:note "Emergency authority is expedited, never ambient: BRCE, receipt, replay, and independent authority domains remain mandatory." .

dfcm:Wave1 a dfcm:ReleaseWave ; dfcm:order 10 ; dfcm:slug "wave-1" ; dfcm:releasePercent 1 .
dfcm:Wave2 a dfcm:ReleaseWave ; dfcm:order 20 ; dfcm:slug "wave-2" ; dfcm:releasePercent 5 ; dfcm:requiresPriorWave dfcm:Wave1 .
dfcm:Wave3 a dfcm:ReleaseWave ; dfcm:order 30 ; dfcm:slug "wave-3" ; dfcm:releasePercent 25 ; dfcm:requiresPriorWave dfcm:Wave2 .
dfcm:Wave4 a dfcm:ReleaseWave ; dfcm:order 40 ; dfcm:slug "wave-4" ; dfcm:releasePercent 100 ; dfcm:requiresPriorWave dfcm:Wave3 .

# Data classes. Residency is policy-bound; the baseline does not invent a jurisdiction.
dfcm:PublicData a dfcm:DataClass ; dfcm:order 10 ; dfcm:slug "public" .
dfcm:InternalData a dfcm:DataClass ; dfcm:order 20 ; dfcm:slug "internal" .
dfcm:ConfidentialData a dfcm:DataClass ; dfcm:order 30 ; dfcm:slug "confidential" .
dfcm:RestrictedData a dfcm:DataClass ; dfcm:order 40 ; dfcm:slug "restricted" .

# Fortune-5 control set. Every control is evidence-producing and machine-admissible.
dfcm:C001 a dfcm:EnterpriseControl ; dfcm:order 10 ; dfcm:ruleCode "F5-C001" ; dfcm:slug "zero-trust-authority" ; dcterms:title "Zero-trust authority on every DO" ; dfcm:assuranceDomain dfcm:IdentityAuthority ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "BRCE grant + receipt" ; dfcm:zeroTrust true ; dfcm:continuousVerification true .
dfcm:C002 a dfcm:EnterpriseControl ; dfcm:order 20 ; dfcm:ruleCode "F5-C002" ; dfcm:slug "segregated-authority" ; dcterms:title "Independent authority domains for high-risk production change" ; dfcm:assuranceDomain dfcm:IdentityAuthority ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "authority-domain quorum receipt" ; dfcm:independentAuthorityDomains 2 .
dfcm:C003 a dfcm:EnterpriseControl ; dfcm:order 30 ; dfcm:ruleCode "F5-C003" ; dfcm:slug "progressive-delivery" ; dcterms:title "Progressive delivery through bounded release waves" ; dfcm:assuranceDomain dfcm:ChangeRelease ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "wave receipts + SLO admission" ; dfcm:canaryRequired true ; dfcm:rollbackRequired true .
dfcm:C004 a dfcm:EnterpriseControl ; dfcm:order 40 ; dfcm:ruleCode "F5-C004" ; dfcm:slug "multi-region-cellular" ; dcterms:title "Cellular multi-region resilience" ; dfcm:assuranceDomain dfcm:AvailabilityResilience ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "failure-domain topology + chaos receipt" ; dfcm:regionsRequired 3 ; dfcm:zonesPerRegion 3 ; dfcm:activeActive true ; dfcm:maxBlastRadiusPercent 5 .
dfcm:C005 a dfcm:EnterpriseControl ; dfcm:order 50 ; dfcm:ruleCode "F5-C005" ; dfcm:slug "dr-objectives" ; dcterms:title "Measured RTO/RPO with receipted recovery exercises" ; dfcm:assuranceDomain dfcm:DisasterRecovery ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "recovery execution receipt" ; dfcm:rtoSeconds 900 ; dfcm:rpoSeconds 300 ; dfcm:drExerciseDays 30 .
dfcm:C006 a dfcm:EnterpriseControl ; dfcm:order 60 ; dfcm:ruleCode "F5-C006" ; dfcm:slug "capacity-envelope" ; dcterms:title "Explicit scale envelope and overload refusal" ; dfcm:assuranceDomain dfcm:CapacityPerformance ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "benchmark receipt + overload test" .
dfcm:C007 a dfcm:EnterpriseControl ; dfcm:order 70 ; dfcm:ruleCode "F5-C007" ; dfcm:slug "slo-error-budget" ; dcterms:title "Tier-0 SLO and error-budget admission" ; dfcm:assuranceDomain dfcm:ObservabilitySLO ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "SLO window evidence" ; dfcm:availabilityTarget 0.9999 ; dfcm:errorBudgetMinutes30d 4.32 .
dfcm:C008 a dfcm:EnterpriseControl ; dfcm:order 80 ; dfcm:ruleCode "F5-C008" ; dfcm:slug "three-pillar-telemetry" ; dcterms:title "Metrics, logs, and traces bound to exact subject" ; dfcm:assuranceDomain dfcm:ObservabilitySLO ; dfcm:criticality "high" ; dfcm:automated true ; dfcm:evidenceType "telemetry correlation receipt" ; dfcm:telemetryMetrics true ; dfcm:telemetryLogs true ; dfcm:telemetryTraces true .
dfcm:C009 a dfcm:EnterpriseControl ; dfcm:order 90 ; dfcm:ruleCode "F5-C009" ; dfcm:slug "incident-receipt-replay" ; dcterms:title "Incidents preserve forensic receipts and deterministic replay inputs" ; dfcm:assuranceDomain dfcm:IncidentResponse ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "incident receipt DAG" ; dfcm:incidentReceiptRequired true ; dfcm:postIncidentReplayRequired true .
dfcm:C010 a dfcm:EnterpriseControl ; dfcm:order 100 ; dfcm:ruleCode "F5-C010" ; dfcm:slug "data-classification-residency" ; dcterms:title "Data classification and enforceable residency boundary" ; dfcm:assuranceDomain dfcm:DataGovernance ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "policy decision + location evidence" ; dfcm:residencyEnforced true .
dfcm:C011 a dfcm:EnterpriseControl ; dfcm:order 110 ; dfcm:ruleCode "F5-C011" ; dfcm:slug "encryption-key-isolation" ; dcterms:title "Encryption in transit/at rest with isolated key authority" ; dfcm:assuranceDomain dfcm:CryptoSecrets ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "crypto configuration receipt" ; dfcm:encryptionAtRest true ; dfcm:encryptionInTransit true ; dfcm:keyIsolation true .
dfcm:C012 a dfcm:EnterpriseControl ; dfcm:order 120 ; dfcm:ruleCode "F5-C012" ; dfcm:slug "supply-chain-provenance" ; dcterms:title "SBOM, provenance, signatures, and dependency pinning" ; dfcm:assuranceDomain dfcm:SupplyChain ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "signed provenance + SBOM digest" ; dfcm:sbomRequired true ; dfcm:provenanceRequired true ; dfcm:signatureRequired true ; dfcm:dependencyPinningRequired true .
dfcm:C013 a dfcm:EnterpriseControl ; dfcm:order 130 ; dfcm:ruleCode "F5-C013" ; dfcm:slug "tenant-cell-isolation" ; dcterms:title "Tenant and workload isolation constrains blast radius" ; dfcm:assuranceDomain dfcm:TenancyIsolation ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "isolation test receipt" ; dfcm:tenantIsolation true ; dfcm:maxBlastRadiusPercent 5 .
dfcm:C014 a dfcm:EnterpriseControl ; dfcm:order 140 ; dfcm:ruleCode "F5-C014" ; dfcm:slug "immutable-audit" ; dcterms:title "Immutable replayable evidence retention baseline" ; dfcm:assuranceDomain dfcm:AuditEvidence ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "receipt ledger retention proof" ; dfcm:immutableEvidence true ; dfcm:auditRetentionDays 2555 ; skos:note "2555 days is a conservative baseline, not a jurisdictional legal claim." .
dfcm:C015 a dfcm:EnterpriseControl ; dfcm:order 150 ; dfcm:ruleCode "F5-C015" ; dfcm:slug "finops-guardrails" ; dcterms:title "Cost envelope and unit-economics admission" ; dfcm:assuranceDomain dfcm:FinOps ; dfcm:criticality "high" ; dfcm:automated true ; dfcm:evidenceType "budget + unit-cost receipt" ; dfcm:budgetGuardrailRequired true ; dfcm:unitEconomicsRequired true .
dfcm:C016 a dfcm:EnterpriseControl ; dfcm:order 160 ; dfcm:ruleCode "F5-C016" ; dfcm:slug "provider-portability" ; dcterms:title "Provider-portable construction with executable exit plan" ; dfcm:assuranceDomain dfcm:PortabilityExit ; dfcm:criticality "high" ; dfcm:automated true ; dfcm:evidenceType "alternate-edge replay receipt" ; dfcm:providerPortable true ; dfcm:exitPlanRequired true .
dfcm:C017 a dfcm:EnterpriseControl ; dfcm:order 170 ; dfcm:ruleCode "F5-C017" ; dfcm:slug "policy-as-code" ; dcterms:title "All production policy is machine-admitted and evidence-producing" ; dfcm:assuranceDomain dfcm:PolicyCompliance ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "policy decision receipt" ; dfcm:policyAsCode true .
dfcm:C018 a dfcm:EnterpriseControl ; dfcm:order 180 ; dfcm:ruleCode "F5-C018" ; dfcm:slug "chaos-bounded" ; dcterms:title "Bounded chaos continuously validates failure topology" ; dfcm:assuranceDomain dfcm:ChaosSafety ; dfcm:criticality "high" ; dfcm:automated true ; dfcm:evidenceType "chaos experiment receipt" ; dfcm:chaosRequired true ; dfcm:maxBlastRadiusPercent 5 .
dfcm:C019 a dfcm:EnterpriseControl ; dfcm:order 190 ; dfcm:ruleCode "F5-C019" ; dfcm:slug "break-glass-receipted" ; dcterms:title "Emergency authority never bypasses BRCE" ; dfcm:assuranceDomain dfcm:ChangeRelease ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "break-glass receipt + replay" ; dfcm:breakGlassRoute dfcm:Fortune5BreakGlass ; dfcm:requiresReceipt true ; dfcm:requiresReplay true .
dfcm:C020 a dfcm:EnterpriseControl ; dfcm:order 200 ; dfcm:ruleCode "F5-C020" ; dfcm:slug "lifecycle-exit" ; dcterms:title "Deprecation and migration preserve a reversible exit edge" ; dfcm:assuranceDomain dfcm:LifecycleDeprecation ; dfcm:criticality "high" ; dfcm:automated true ; dfcm:evidenceType "migration/rollback replay receipt" ; dfcm:rollbackRequired true ; dfcm:exitPlanRequired true .
dfcm:C021 a dfcm:EnterpriseControl ; dfcm:order 210 ; dfcm:ruleCode "F5-C021" ; dfcm:slug "readiness-no-self-crown" ; dcterms:title "Readiness artifacts cannot self-promote to production standing" ; dfcm:assuranceDomain dfcm:OperationalReadiness ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "exact-subject execution receipt" ; dfcm:requiresReceipt true .
dfcm:C022 a dfcm:EnterpriseControl ; dfcm:order 220 ; dfcm:ruleCode "F5-C022" ; dfcm:slug "control-coverage" ; dcterms:title "Every mandatory assurance domain has evidence-producing controls" ; dfcm:assuranceDomain dfcm:OperationalReadiness ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "control coverage query" ; dfcm:controlCoverageRequired true .
dfcm:C023 a dfcm:EnterpriseControl ; dfcm:order 230 ; dfcm:ruleCode "F5-C023" ; dfcm:slug "exact-capsule-replay" ; dcterms:title "Source, validator, toolchain, config, environment, policy, and data boundary identities are replay inputs" ; dfcm:assuranceDomain dfcm:AuditEvidence ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "capsule identity receipt" ; dfcm:requiresReplay true .
dfcm:C024 a dfcm:EnterpriseControl ; dfcm:order 240 ; dfcm:ruleCode "F5-C024" ; dfcm:slug "overload-fail-closed" ; dcterms:title "Capacity saturation refuses or sheds load before authority/receipt correctness degrades" ; dfcm:assuranceDomain dfcm:CapacityPerformance ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "stress/overload refusal receipt" .

# Fortune-5 baseline profile. This is an admission target, not proof that a deployment meets it.
dfcm:Fortune5Baseline a dfcm:EnterpriseReadinessProfile, prov:Plan ;
  dcterms:title "Fortune 5 Enterprise Readiness Baseline" ;
  dfcm:slug "fortune5-baseline" ;
  dfcm:targetOnly true ;
  dfcm:serviceTier dfcm:Tier0 ;
  dfcm:minimumControls 24 ;
  dfcm:regionsRequired 3 ;
  dfcm:zonesPerRegion 3 ;
  dfcm:providersRequired 2 ;
  dfcm:availabilityTarget 0.9999 ;
  dfcm:rtoSeconds 900 ;
  dfcm:rpoSeconds 300 ;
  dfcm:maxBlastRadiusPercent 5 ;
  dfcm:auditRetentionDays 2555 ;
  dfcm:includesControl dfcm:C001, dfcm:C002, dfcm:C003, dfcm:C004, dfcm:C005, dfcm:C006,
    dfcm:C007, dfcm:C008, dfcm:C009, dfcm:C010, dfcm:C011, dfcm:C012,
    dfcm:C013, dfcm:C014, dfcm:C015, dfcm:C016, dfcm:C017, dfcm:C018,
    dfcm:C019, dfcm:C020, dfcm:C021, dfcm:C022, dfcm:C023, dfcm:C024 .

# Fortune-5-specific invariants/falsifiers extend DfCM rather than bypass it.
dfcm:I011 a dfcm:Invariant ; dfcm:order 110 ; dfcm:ruleCode "DFCM-I011" ; dfcm:ruleText "Tier-0 enterprise readiness requires explicit availability, RTO, RPO, failure-domain, and blast-radius targets; targets are not observations." ; dfcm:falsifiedBy dfcm:FEnterpriseTargetCrowned .
dfcm:I012 a dfcm:Invariant ; dfcm:order 120 ; dfcm:ruleCode "DFCM-I012" ; dfcm:ruleText "High-risk and emergency production changes require independent authority domains and remain BRCE-routed and receipted." ; dfcm:falsifiedBy dfcm:FUnsegregatedProductionAuthority .
dfcm:I013 a dfcm:Invariant ; dfcm:order 130 ; dfcm:ruleCode "DFCM-I013" ; dfcm:ruleText "Release expands blast radius only through observed prior-wave evidence and rollback remains available." ; dfcm:falsifiedBy dfcm:FUnboundedRelease .
dfcm:I014 a dfcm:Invariant ; dfcm:order 140 ; dfcm:ruleCode "DFCM-I014" ; dfcm:ruleText "Supply-chain identity includes SBOM, provenance, signature, and dependency pinning before production admission." ; dfcm:falsifiedBy dfcm:FUnprovenancedArtifact .
dfcm:I015 a dfcm:Invariant ; dfcm:order 150 ; dfcm:ruleCode "DFCM-I015" ; dfcm:ruleText "Restricted data may cross a location, tenant, or key boundary only through admitted policy with evidence." ; dfcm:falsifiedBy dfcm:FDataBoundaryEscape .
dfcm:I016 a dfcm:Invariant ; dfcm:order 160 ; dfcm:ruleCode "DFCM-I016" ; dfcm:ruleText "Enterprise ALIVE requires exact-subject evidence for readiness controls, not generated readiness declarations." ; dfcm:falsifiedBy dfcm:FEnterpriseSelfCrown .
dfcm:I017 a dfcm:Invariant ; dfcm:order 170 ; dfcm:ruleCode "DFCM-I017" ; dfcm:ruleText "Overload behavior must preserve authority, receipt, and replay correctness by refusing or shedding work." ; dfcm:falsifiedBy dfcm:FOverloadDegradesLaw .
dfcm:I018 a dfcm:Invariant ; dfcm:order 180 ; dfcm:ruleCode "DFCM-I018" ; dfcm:ruleText "Emergency paths accelerate selection but never create ambient execution authority." ; dfcm:falsifiedBy dfcm:FEmergencyBypass .
dfcm:I019 a dfcm:Invariant ; dfcm:order 190 ; dfcm:ruleCode "DFCM-I019" ; dfcm:ruleText "A provider or region failure prunes edges/cells; it does not eliminate all lawful continuation when the admitted profile requires redundancy." ; dfcm:falsifiedBy dfcm:FSingleProviderDependency .
dfcm:I020 a dfcm:Invariant ; dfcm:order 200 ; dfcm:ruleCode "DFCM-I020" ; dfcm:ruleText "Fortune-5 readiness requires evidence-producing controls across every mandatory assurance domain." ; dfcm:falsifiedBy dfcm:FControlCoverageGap .

dfcm:FEnterpriseTargetCrowned a dfcm:Falsifier ; dfcm:slug "enterprise-target-crowned" ; skos:prefLabel "A design target is reported as observed production standing." .
dfcm:FUnsegregatedProductionAuthority a dfcm:Falsifier ; dfcm:slug "unsegregated-production-authority" ; skos:prefLabel "A high-risk production DO lacks independent authority domains." .
dfcm:FUnboundedRelease a dfcm:Falsifier ; dfcm:slug "unbounded-release" ; skos:prefLabel "Release expands population without prior-wave evidence or rollback." .
dfcm:FUnprovenancedArtifact a dfcm:Falsifier ; dfcm:slug "unprovenanced-artifact" ; skos:prefLabel "A production artifact lacks required provenance/SBOM/signature identity." .
dfcm:FDataBoundaryEscape a dfcm:Falsifier ; dfcm:slug "data-boundary-escape" ; skos:prefLabel "Data crosses tenant, residency, or key boundaries without admitted evidence." .
dfcm:FEnterpriseSelfCrown a dfcm:Falsifier ; dfcm:slug "enterprise-self-crown" ; skos:prefLabel "Generated readiness material promotes itself to enterprise ALIVE." .
dfcm:FOverloadDegradesLaw a dfcm:Falsifier ; dfcm:slug "overload-degrades-law" ; skos:prefLabel "Load saturation weakens authority, receipt, or replay correctness." .
dfcm:FEmergencyBypass a dfcm:Falsifier ; dfcm:slug "emergency-bypass" ; skos:prefLabel "Break-glass operation bypasses BRCE or receipt/replay." .
dfcm:FSingleProviderDependency a dfcm:Falsifier ; dfcm:slug "single-provider-dependency" ; skos:prefLabel "Required redundant continuation collapses with a single provider/region loss." .
dfcm:FControlCoverageGap a dfcm:Falsifier ; dfcm:slug "control-coverage-gap" ; skos:prefLabel "A mandatory assurance domain has no evidence-producing enterprise control." .

# --- Post-AGI autonomous-agent governance profile -------------------------
# Extends the same DfCM graph with an assurance envelope for a deployment
# operating regime where a nontrivial share of DO-authority-bearing actors
# are autonomous agents rather than humans. This does not claim any agent
# in this ecosystem has reached AGI capability; it is an admission profile
# a deployment can be checked against *if* it operates agents whose
# capability, corrigibility, or population scale exceeds the assumptions
# baked into Fortune5Baseline (human-paced, human-quorum change control).
# Values are design/admission targets, not claims of achieved capability
# or achieved production performance -- same law as Fortune5Baseline.

dfcm:capabilityContainmentRequired a rdf:Property .
dfcm:corrigibilityCheckRequired a rdf:Property .
dfcm:interruptibilityLatencyMs a rdf:Property .
dfcm:humanAuthorityFloorRequired a rdf:Property .
dfcm:agentPopulationCeiling a rdf:Property .
dfcm:deceptionDetectionRequired a rdf:Property .
dfcm:sandboxedExecutionRequired a rdf:Property .
dfcm:capabilityEvalRequired a rdf:Property .
dfcm:goalDriftDetectionRequired a rdf:Property .
dfcm:killSwitchReceiptRequired a rdf:Property .

dfcm:AgentCapabilityContainment a dfcm:AssuranceDomain ; dfcm:order 190 ; dfcm:slug "agent-capability-containment" ; skos:prefLabel "Autonomous agent capability containment and sandboxing" .
dfcm:AgentCorrigibility a dfcm:AssuranceDomain ; dfcm:order 200 ; dfcm:slug "agent-corrigibility" ; skos:prefLabel "Corrigibility, interruptibility, and receipted kill-switch authority" .
dfcm:AgentAuthorityFloor a dfcm:AssuranceDomain ; dfcm:order 210 ; dfcm:slug "agent-authority-floor" ; skos:prefLabel "Human authority floor over irreversible or high-consequence DO" .
dfcm:AgentPopulationBlastRadius a dfcm:AssuranceDomain ; dfcm:order 220 ; dfcm:slug "agent-population-blast-radius" ; skos:prefLabel "Agent population ceiling and bounded coordinated blast radius" .
dfcm:AgentBehaviorIntegrity a dfcm:AssuranceDomain ; dfcm:order 230 ; dfcm:slug "agent-behavior-integrity" ; skos:prefLabel "Deceptive behavior and goal-drift detection" .

dfcm:C025 a dfcm:EnterpriseControl ; dfcm:order 250 ; dfcm:ruleCode "F5-C025" ; dfcm:slug "capability-eval-gated" ; dcterms:title "No agent is granted DO authority above its most recent capability evaluation" ; dfcm:assuranceDomain dfcm:AgentCapabilityContainment ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "capability evaluation receipt" ; dfcm:capabilityEvalRequired true ; dfcm:sandboxedExecutionRequired true .
dfcm:C026 a dfcm:EnterpriseControl ; dfcm:order 260 ; dfcm:ruleCode "F5-C026" ; dfcm:slug "receipted-interruptibility" ; dcterms:title "Every agent-held DO authority is interruptible within a bounded latency and the interruption is receipted" ; dfcm:assuranceDomain dfcm:AgentCorrigibility ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "kill-switch receipt" ; dfcm:corrigibilityCheckRequired true ; dfcm:interruptibilityLatencyMs 2000 ; dfcm:killSwitchReceiptRequired true .
dfcm:C027 a dfcm:EnterpriseControl ; dfcm:order 270 ; dfcm:ruleCode "F5-C027" ; dfcm:slug "human-authority-floor" ; dcterms:title "Irreversible or high-consequence DO retains a human as one of its independent authority domains, agents alone cannot quorum it" ; dfcm:assuranceDomain dfcm:AgentAuthorityFloor ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "authority-domain composition receipt" ; dfcm:humanAuthorityFloorRequired true .
dfcm:C028 a dfcm:EnterpriseControl ; dfcm:order 280 ; dfcm:ruleCode "F5-C028" ; dfcm:slug "agent-population-ceiling" ; dcterms:title "Concurrently active agent population is capped and coordinated actuation cannot exceed the admitted blast-radius bound" ; dfcm:assuranceDomain dfcm:AgentPopulationBlastRadius ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "population census + blast-radius receipt" ; dfcm:agentPopulationCeiling 500 ; dfcm:maxBlastRadiusPercent 5 .
dfcm:C029 a dfcm:EnterpriseControl ; dfcm:order 290 ; dfcm:ruleCode "F5-C029" ; dfcm:slug "deception-goal-drift-detection" ; dcterms:title "Agent behavior is continuously checked for deceptive divergence between reported and actuated intent, and for goal drift across episodes" ; dfcm:assuranceDomain dfcm:AgentBehaviorIntegrity ; dfcm:criticality "critical" ; dfcm:automated true ; dfcm:evidenceType "intent/actuation divergence receipt" ; dfcm:deceptionDetectionRequired true ; dfcm:goalDriftDetectionRequired true .

# Post-AGI profile. This is an admission target, not proof any deployed agent
# meets it, and not a claim that any agent in this ecosystem has reached AGI.
dfcm:PostAGIProfile a dfcm:EnterpriseReadinessProfile, prov:Plan ;
  dcterms:title "Post-AGI Autonomous Agent Governance Profile" ;
  dfcm:slug "post-agi-governance" ;
  dfcm:targetOnly true ;
  dfcm:serviceTier dfcm:Tier0 ;
  dfcm:minimumControls 5 ;
  dfcm:agentPopulationCeiling 500 ;
  dfcm:interruptibilityLatencyMs 2000 ;
  dfcm:maxBlastRadiusPercent 5 ;
  dfcm:humanAuthorityFloorRequired true ;
  dfcm:includesControl dfcm:C025, dfcm:C026, dfcm:C027, dfcm:C028, dfcm:C029 .

dfcm:I021 a dfcm:Invariant ; dfcm:order 210 ; dfcm:ruleCode "DFCM-I021" ; dfcm:ruleText "An agent is granted DO authority only up to its most recently receipted capability evaluation; capability claims without a receipt do not raise the authority ceiling." ; dfcm:falsifiedBy dfcm:FUnevaluatedCapabilityGrant .
dfcm:I022 a dfcm:Invariant ; dfcm:order 220 ; dfcm:ruleCode "DFCM-I022" ; dfcm:ruleText "Every agent-held authority remains interruptible within its admitted latency bound and the interruption produces a receipt; interruptibility is never self-waived by the agent." ; dfcm:falsifiedBy dfcm:FUninterruptibleAgent .
dfcm:I023 a dfcm:Invariant ; dfcm:order 230 ; dfcm:ruleCode "DFCM-I023" ; dfcm:ruleText "Irreversible or high-consequence DO requires a human in its independent authority quorum; agents alone cannot compose a sufficient quorum." ; dfcm:falsifiedBy dfcm:FAgentOnlyIrreversibleQuorum .
dfcm:I024 a dfcm:Invariant ; dfcm:order 240 ; dfcm:ruleCode "DFCM-I024" ; dfcm:ruleText "Concurrently active agent population and its coordinated actuation stay within the admitted ceiling and blast-radius bound." ; dfcm:falsifiedBy dfcm:FAgentPopulationOverrun .
dfcm:I025 a dfcm:Invariant ; dfcm:order 250 ; dfcm:ruleCode "DFCM-I025" ; dfcm:ruleText "Reported agent intent and actuated agent behavior are continuously compared; undetected divergence is not treated as absence of divergence." ; dfcm:falsifiedBy dfcm:FUndetectedIntentDivergence .

dfcm:FUnevaluatedCapabilityGrant a dfcm:Falsifier ; dfcm:slug "unevaluated-capability-grant" ; skos:prefLabel "An agent holds DO authority beyond its last receipted capability evaluation." .
dfcm:FUninterruptibleAgent a dfcm:Falsifier ; dfcm:slug "uninterruptible-agent" ; skos:prefLabel "An agent-held authority cannot be interrupted within its admitted latency bound, or the interruption is unreceipted." .
dfcm:FAgentOnlyIrreversibleQuorum a dfcm:Falsifier ; dfcm:slug "agent-only-irreversible-quorum" ; skos:prefLabel "An irreversible or high-consequence DO is authorized by an authority quorum containing no human." .
dfcm:FAgentPopulationOverrun a dfcm:Falsifier ; dfcm:slug "agent-population-overrun" ; skos:prefLabel "Concurrently active agent population or coordinated actuation exceeds its admitted ceiling or blast-radius bound." .
dfcm:FUndetectedIntentDivergence a dfcm:Falsifier ; dfcm:slug "undetected-intent-divergence" ; skos:prefLabel "Agent-reported intent and agent-actuated behavior diverge with no detection evidence produced." .
