---
to: "infra/terraform/github/orgs/{{ alias }}/variables.tf"
sparql:
  rows: |
    PREFIX ghtf: <http://seanchatmangpt.github.io/packs/gh-terraform#>
    SELECT ?alias ?owner ?prefix WHERE {
      ?org a ghtf:OrgTenant ; ghtf:orgAlias ?alias ; ghtf:orgOwner ?owner ; ghtf:appAuthVarPrefix ?prefix .
      ?repoInd a ghtf:ManagedRepo ; ghtf:org ?org .
    } GROUP BY ?alias ?owner ?prefix ORDER BY ?alias
---
# GENERATED by `ggen sync` from packs/gh-terraform-pack/ontology.ttl — org: {{ alias }}, family: variables
# Do not edit; edit the ontology.

variable "github_owner" {
  description = "GitHub org/user that owns the managed repository."
  type        = string
  default     = "seanchatmangpt"
}

variable "repository" {
  description = "Repository name to manage."
  type        = string
  default     = "ggen"
}

variable "ggen_signing_key_value" {
  description = "Value for the GGEN_SIGNING_KEY actions secret. Supplied at apply time only."
  type        = string
  sensitive   = true
  default     = ""
}

{% for row in rows %}variable "{{ row.prefix }}_app_id" {
  description = "GitHub App ID for the {{ row.alias }} tenant."
  type        = string
  default     = ""
}

variable "{{ row.prefix }}_app_installation_id" {
  description = "GitHub App installation ID for the {{ row.alias }} tenant."
  type        = string
  default     = ""
}

variable "{{ row.prefix }}_app_pem_file" {
  description = "GitHub App PEM private key for the {{ row.alias }} tenant."
  type        = string
  sensitive   = true
  default     = ""
}
{% endfor %}
