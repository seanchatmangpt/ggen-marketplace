@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fa: <urn:forensic:audit:> .

# SHACL shapes over the fa: vocabulary. Every class carries a NodeShape
# (gate 010 refuses an uncovered class); required properties are minCount 1.

fa:EventShape a sh:NodeShape ;
    sh:targetClass fa:Event ;
    sh:property [
        sh:path fa:eventId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path fa:activity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path fa:timestamp ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path fa:eventAttributes ;
        sh:minCount 0 ;
    ] .

fa:ObjectShape a sh:NodeShape ;
    sh:targetClass fa:Object ;
    sh:property [
        sh:path fa:objectId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path fa:objectType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path fa:objectAttributes ;
        sh:minCount 0 ;
    ] .

fa:RelationshipShape a sh:NodeShape ;
    sh:targetClass fa:Relationship ;
    sh:property [
        sh:path fa:relEventId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path fa:relObjectId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path fa:qualifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .

fa:DossierConfigShape a sh:NodeShape ;
    sh:targetClass fa:DossierConfig ;
    sh:property [
        sh:path fa:exportModule ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path fa:digestAlgorithm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path fa:canonicalization ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path fa:subjectIdField ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path fa:refuseOnDanglingObjectRef ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] .
