@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fa: <urn:forensic:audit:> .

<urn:forensic:audit>
    a owl:Ontology ;
    rdfs:label "Forensic Audit Dossier Ontology" ;
    rdfs:comment """
    OCEL 2.0-aligned event/object/relationship vocabulary for content-addressed
    forensic audit dossiers. Semantics aligned with ash_pplan
    ProcessEvidence.Event (lib/ash_pplan/process_evidence/event.ex): events
    carry id/activity/timestamp/objects/attributes/subject_id; objects are
    unique-id'd; relationships reference event+object ids with a qualifier.
    """ .

# --- Classes ------------------------------------------------------------------

fa:Event a rdfs:Class ;
    rdfs:label "OCEL Event" ;
    rdfs:comment "One process-evidence event: activity over qualified objects, bound to a subject." .

fa:Object a rdfs:Class ;
    rdfs:label "OCEL Object" ;
    rdfs:comment "A unique process object; its id must be unique across the dossier." .

fa:Relationship a rdfs:Class ;
    rdfs:label "OCEL Relationship" ;
    rdfs:comment "A typed edge from an event to an object with a qualifier (OCEL 2.0 relationship)." .

fa:DossierConfig a rdfs:Class ;
    rdfs:label "Dossier Config" ;
    rdfs:comment "Consumer bindings resolved by queries/exporter.rq to render the exporter; never hardcoded in templates." .

# --- Event properties ---------------------------------------------------------

fa:eventId a rdf:Property ;
    rdfs:domain fa:Event ;
    rdfs:label "event id" .

fa:activity a rdf:Property ;
    rdfs:domain fa:Event ;
    rdfs:label "activity" .

fa:timestamp a rdf:Property ;
    rdfs:domain fa:Event ;
    rdfs:label "timestamp" .

fa:eventAttributes a rdf:Property ;
    rdfs:domain fa:Event ;
    rdfs:label "event attributes" .

# --- Object properties --------------------------------------------------------

fa:objectId a rdf:Property ;
    rdfs:domain fa:Object ;
    rdfs:label "object id" .

fa:objectType a rdf:Property ;
    rdfs:domain fa:Object ;
    rdfs:label "object type" .

fa:objectAttributes a rdf:Property ;
    rdfs:domain fa:Object ;
    rdfs:label "object attributes" .

# --- Relationship properties --------------------------------------------------

fa:relEventId a rdf:Property ;
    rdfs:domain fa:Relationship ;
    rdfs:label "relationship event id" .

fa:relObjectId a rdf:Property ;
    rdfs:domain fa:Relationship ;
    rdfs:label "relationship object id" .

fa:qualifier a rdf:Property ;
    rdfs:domain fa:Relationship ;
    rdfs:label "qualifier" .

# --- Dossier assembly ---------------------------------------------------------

fa:exportModule a rdf:Property ;
    rdfs:label "export module" .

fa:digestAlgorithm a rdf:Property ;
    rdfs:label "digest algorithm" .

fa:canonicalization a rdf:Property ;
    rdfs:label "canonicalization" .

fa:subjectIdField a rdf:Property ;
    rdfs:label "subject id field" .

fa:refuseOnDanglingObjectRef a rdf:Property ;
    rdfs:label "refuse on dangling object ref" .

# --- Pack-local self-verification DossierConfig individual --------------------

<urn:forensic:audit:config:default> a fa:DossierConfig ;
    fa:exportModule "dossier_exporter.py" ;
    fa:digestAlgorithm "sha256" ;
    fa:canonicalization "sorted-keys-canonical-json" ;
    fa:subjectIdField "subject_id" ;
    fa:refuseOnDanglingObjectRef true .
