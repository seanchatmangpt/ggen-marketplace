# One row per fa:DossierConfig; the template renders these bindings,
# never hardcoded values.
PREFIX fa: <urn:forensic:audit:>
SELECT ?exportModule ?digestAlgorithm ?canonicalization ?subjectIdField ?refuseOnDangling WHERE {
  ?config a fa:DossierConfig ;
    fa:exportModule ?exportModule ;
    fa:digestAlgorithm ?digestAlgorithm ;
    fa:canonicalization ?canonicalization ;
    fa:subjectIdField ?subjectIdField ;
    fa:refuseOnDanglingObjectRef ?refuseOnDangling .
}
ORDER BY ?exportModule
