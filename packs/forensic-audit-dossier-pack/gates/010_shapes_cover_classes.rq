# ASK true = violation (gate refuses). Every declared fa: class must carry
# an sh:NodeShape targeting it in shapes.ttl.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX fa: <urn:forensic:audit:>
ASK {
  ?class a rdfs:Class .
  FILTER NOT EXISTS { ?shape sh:targetClass ?class . }
}
