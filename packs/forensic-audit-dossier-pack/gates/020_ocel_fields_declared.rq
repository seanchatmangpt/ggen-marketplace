# ASK true = violation (gate refuses). OCEL 2.0 alignment pinned as a gate.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX fa: <urn:forensic:audit:>
ASK {
  {
    ?e rdfs:domain fa:Event .
    FILTER(?e NOT IN (fa:eventId, fa:activity, fa:timestamp, fa:eventAttributes))
  }
  UNION
  {
    ?o rdfs:domain fa:Object .
    FILTER(?o NOT IN (fa:objectId, fa:objectType, fa:objectAttributes))
  }
  UNION
  {
    ?r rdfs:domain fa:Relationship .
    FILTER(?r NOT IN (fa:relEventId, fa:relObjectId, fa:qualifier))
  }
}
