{
  "schema": "ggen.dfcm.explore.candidate-matrix.v1",
  "standing": "PARTIAL_ALIVE",
  "candidates": [
{%- for row in rows %}
    {"id":"{{ row.candidate }}","title":"{{ row.title }}","family":"{{ row.family }}","rollback_cost":{{ row.rollback }},"falsifier":"{{ row.falsifier }}"}{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
