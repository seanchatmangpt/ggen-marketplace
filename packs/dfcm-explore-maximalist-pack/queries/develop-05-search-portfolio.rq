PREFIX ex: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?kind ?rollback WHERE {
  ?candidate ex:standing ex:retained ; ex:kind ?kind ; ex:rollbackCost ?rollback .
  FILTER(?kind IN ("graph-search","tree-search","bandit","bayesian-bandit"))
} ORDER BY ?rollback ?kind ?candidate
