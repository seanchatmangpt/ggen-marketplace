PREFIX ex: <https://ggen.dev/ontology/dfcm-explore#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?candidate ?title ?rollback ?falsifier WHERE {
  ?candidate a ex:Candidate ; dct:title ?title ; ex:family "receipt" ; ex:rollbackCost ?rollback ; ex:falsifier ?falsifier .
}
ORDER BY ?rollback ?candidate
