PREFIX ex: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?rollback WHERE {
  ?candidate ex:standing ex:retained ; ex:rollbackCost ?rollback .
  FILTER NOT EXISTS {
    ?other ex:standing ex:retained ; ex:rollbackCost ?otherRollback .
    FILTER(?otherRollback < ?rollback)
  }
} ORDER BY ?candidate
