@prefix ex: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Candidate a prov:Entity .
ex:retained a prov:Entity .
ex:rejected a prov:Entity .

ex:pareto ex:kind "multi-objective" ; ex:assumption "partial order over CTQ vectors" ; ex:rollbackCost 1 ; ex:standing ex:retained .
ex:mcts ex:kind "tree-search" ; ex:assumption "simulatable transitions" ; ex:rollbackCost 2 ; ex:standing ex:retained .
ex:ucb ex:kind "bandit" ; ex:assumption "bounded reward observations" ; ex:rollbackCost 1 ; ex:standing ex:retained .
ex:thompson ex:kind "bayesian-bandit" ; ex:assumption "posterior family available" ; ex:rollbackCost 2 ; ex:standing ex:retained .
ex:nsga2 ex:kind "evolutionary" ; ex:assumption "population fitness evaluable" ; ex:rollbackCost 3 ; ex:standing ex:retained .
ex:psro ex:kind "game-theoretic" ; ex:assumption "best-response oracle available" ; ex:rollbackCost 4 ; ex:standing ex:retained .
ex:astar ex:kind "graph-search" ; ex:assumption "admissible heuristic optional" ; ex:rollbackCost 1 ; ex:standing ex:retained .
ex:dijkstra ex:kind "graph-search" ; ex:assumption "nonnegative edge costs" ; ex:rollbackCost 1 ; ex:standing ex:retained .
ex:fixedpoint ex:kind "lattice-dataflow" ; ex:assumption "monotone transfer over finite-height lattice" ; ex:rollbackCost 2 ; ex:standing ex:retained .
ex:ltl ex:kind "temporal-verification" ; ex:assumption "trace semantics available" ; ex:rollbackCost 2 ; ex:standing ex:retained .
ex:metamorphic ex:kind "oracle-strategy" ; ex:assumption "relations known without exact oracle" ; ex:rollbackCost 1 ; ex:standing ex:retained .
ex:differential ex:kind "oracle-strategy" ; ex:assumption "independent reference implementation exists" ; ex:rollbackCost 1 ; ex:standing ex:retained .
