@prefix ex: <https://ggen.dev/ontology/dfcm-explore#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Candidate a ex:CandidateClass .
ex:ComparisonCourt a ex:CourtClass .
ex:ctqNovelty a ex:CTQ .
ex:ctqMergeability a ex:CTQ .
ex:ctqBreadth a ex:CTQ .
ex:ctqEvidence a ex:CTQ .

ex:pareto a ex:Candidate ; dct:title "Pareto frontier" ; ex:family "multi-objective" ; ex:rollbackCost 1 ; ex:falsifier "dominated" .
ex:bandit a ex:Candidate ; dct:title "UCB bandit" ; ex:family "search" ; ex:rollbackCost 1 ; ex:falsifier "regret-bound-violation" .
ex:mcts a ex:Candidate ; dct:title "MCTS" ; ex:family "search" ; ex:rollbackCost 2 ; ex:falsifier "rollout-instability" .
ex:evolutionary a ex:Candidate ; dct:title "Evolutionary search" ; ex:family "search" ; ex:rollbackCost 2 ; ex:falsifier "population-collapse" .
ex:psro a ex:Candidate ; dct:title "PSRO" ; ex:family "game-theory" ; ex:rollbackCost 3 ; ex:falsifier "non-improving-oracle" .
ex:hypergraph a ex:Candidate ; dct:title "Hypergraph alternatives" ; ex:family "graph" ; ex:rollbackCost 1 ; ex:falsifier "projection-loss" .
ex:lattice a ex:Candidate ; dct:title "Admission lattice" ; ex:family "order-theory" ; ex:rollbackCost 1 ; ex:falsifier "non-monotone-join" .
ex:fixedPoint a ex:Candidate ; dct:title "Fixed-point dataflow" ; ex:family "semantics" ; ex:rollbackCost 2 ; ex:falsifier "non-convergence" .
ex:temporal a ex:Candidate ; dct:title "Temporal logic court" ; ex:family "formal" ; ex:rollbackCost 2 ; ex:falsifier "trace-counterexample" .
ex:causal a ex:Candidate ; dct:title "Causal process court" ; ex:family "process-intelligence" ; ex:rollbackCost 2 ; ex:falsifier "intervention-mismatch" .
ex:crdt a ex:Candidate ; dct:title "CRDT evidence state" ; ex:family "distributed" ; ex:rollbackCost 2 ; ex:falsifier "merge-nonconvergence" .
ex:raft a ex:Candidate ; dct:title "Consensus evidence state" ; ex:family "distributed" ; ex:rollbackCost 3 ; ex:falsifier "quorum-unavailable" .
ex:metamorphic a ex:Candidate ; dct:title "Metamorphic oracle" ; ex:family "verification" ; ex:rollbackCost 1 ; ex:falsifier "relation-violation" .
ex:differential a ex:Candidate ; dct:title "Differential oracle" ; ex:family "verification" ; ex:rollbackCost 1 ; ex:falsifier "reference-divergence" .
ex:replay a ex:Candidate ; dct:title "Deterministic replay" ; ex:family "receipt" ; ex:rollbackCost 1 ; ex:falsifier "identity-drift" .
ex:refusal a ex:Candidate ; dct:title "Typed refusal calculus" ; ex:family "security" ; ex:rollbackCost 1 ; ex:falsifier "ambient-authority" .
