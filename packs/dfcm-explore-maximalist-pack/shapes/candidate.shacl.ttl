@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#> .

ex:CandidateShape a sh:NodeShape ;
  sh:targetSubjectsOf ex:kind ;
  sh:property [ sh:path ex:kind ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:assumption ; sh:minCount 1 ] ;
  sh:property [ sh:path ex:rollbackCost ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ;
  sh:property [ sh:path ex:standing ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( ex:retained ex:rejected ) ] .
