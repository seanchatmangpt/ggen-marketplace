# Any row = violation. THE LAW: gross margin (nte - quote)/nte >= floor.
# Vacuity falsifier: verify.py mutates the graph (raises the quote above the
# floor threshold) and PROVES this gate flips to violation. A gate that cannot
# flip is vacuous and the verifier fails.
PREFIX fme: <urn:fin:margin-envelope:>
SELECT ?env ?margin ?floor
WHERE {
  ?env a fme:MarginEnvelope ;
       fme:nte/fme:hasAmount/fme:decimalValue ?nteAmt ;
       fme:hasQuote/fme:hasAmount/fme:decimalValue ?qAmt ;
       fme:hasInvariant/fme:floor ?floor .
  BIND((?nteAmt - ?qAmt) / ?nteAmt AS ?margin)
  FILTER(?margin < ?floor)
}
