# One row per envelope: all bindings the template renders; no literal module
# names in the template (the envelope id and amounts come from the graph).
PREFIX fme: <urn:fin:margin-envelope:>
SELECT ?envelopeId ?nteAmount ?quoteAmount ?floor ?currency
WHERE {
  ?env a fme:MarginEnvelope ;
      fme:envelopeId ?envelopeId ;
      fme:nte ?nte .
  ?nte fme:hasAmount ?nteAmt .
  ?nteAmt fme:decimalValue ?nteAmount ;
          fme:currency ?currency .
  ?env fme:hasQuote ?q .
  ?q fme:hasAmount ?qAmt .
  ?qAmt fme:decimalValue ?quoteAmount .
  ?env fme:hasInvariant ?inv .
  ?inv fme:floor ?floor .
}
ORDER BY ?envelopeId
