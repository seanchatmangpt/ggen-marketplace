@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix fme: <urn:fin:margin-envelope:> .

# SHACL shapes over the envelope corpus, complementing the SPARQL gates.
# Gates refuse (rows = violation); shapes declare the structural contract.

fme:MarginEnvelopeShape a sh:NodeShape ;
    sh:targetClass fme:MarginEnvelope ;
    sh:property [
        sh:path fme:envelopeId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path fme:nte ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path fme:hasQuote ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path fme:hasInvariant ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

fme:GrossMarginInvariantShape a sh:NodeShape ;
    sh:targetClass fme:GrossMarginInvariant ;
    sh:property [
        sh:path fme:floor ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive "0.0"^^xsd:decimal ;
        sh:maxInclusive "1.0"^^xsd:decimal ;
    ] .

fme:MonetaryAmountShape a sh:NodeShape ;
    sh:targetClass fme:MonetaryAmount ;
    sh:property [
        sh:path fme:decimalValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path fme:currency ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:pattern "^[A-Z]{3}$" ;
    ] .

fme:BreachEventShape a sh:NodeShape ;
    sh:targetClass fme:BreachEvent ;
    sh:property [
        sh:path fme:breachedEnvelope ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path fme:breachKind ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "below_floor" "nte_exceeded" ) ;
    ] .

fme:RefusalShape a sh:NodeShape ;
    sh:targetClass fme:Refusal ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:pattern "^Refused|^Escalate" ;
    ] .
