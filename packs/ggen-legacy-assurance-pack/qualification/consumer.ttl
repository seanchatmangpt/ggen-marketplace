<https://chatmangpt.com/ggen-legacy/program/v26.8.1>
    a gla:AssuranceProgram ;
    dcterms:title "ggen-legacy Verifier Appliance v26.8.1" ;
    dcterms:identifier "ggen-legacy-verifier-appliance-v26.8.1" ;
    gla:ggenSourceRevision "0f39227c102e0ac7519f0f27561356227a518653" ;
    gla:claimScope "bounded observable-contract equivalence and repository standing" ;
    gla:executionOwner "customer" ;
    gla:networkEgressAllowed false ;
    gla:vendorSourceAccess false ;
    gla:implementerIdentity "https://chatmangpt.com/actors/ggen-manufacturer" ;
    gla:verifierIdentity "https://chatmangpt.com/actors/customer-independent-verifier" ;
    gla:decisionAuthority "https://chatmangpt.com/actors/customer-release-authority" ;
    gla:signatureRequired true ;
    gla:transparencyLogRequired true ;
    gla:minimumReplayEnvironments 3 ;
    gla:legalRecourseRequired true ;
    gla:independentAssessmentRequired true .

gla:layer-01 a gla:AssuranceLayer ; gla:layerId "01" ; skos:prefLabel "Bounded claim" ; gla:required true .
gla:layer-02 a gla:AssuranceLayer ; gla:layerId "02" ; skos:prefLabel "Customer-controlled execution" ; gla:required true .
gla:layer-03 a gla:AssuranceLayer ; gla:layerId "03" ; skos:prefLabel "Independent verifier" ; gla:required true .
gla:layer-04 a gla:AssuranceLayer ; gla:layerId "04" ; skos:prefLabel "Customer-hidden challenges" ; gla:required true .
gla:layer-05 a gla:AssuranceLayer ; gla:layerId "05" ; skos:prefLabel "Cryptographic identity and provenance" ; gla:required true .
gla:layer-06 a gla:AssuranceLayer ; gla:layerId "06" ; skos:prefLabel "Signed evidence and transparency" ; gla:required true .
gla:layer-07 a gla:AssuranceLayer ; gla:layerId "07" ; skos:prefLabel "Deterministic cross-environment replay" ; gla:required true .
gla:layer-08 a gla:AssuranceLayer ; gla:layerId "08" ; skos:prefLabel "Independent testing authority" ; gla:required true .
gla:layer-09 a gla:AssuranceLayer ; gla:layerId "09" ; skos:prefLabel "Organizational control assurance" ; gla:required true .
gla:layer-10 a gla:AssuranceLayer ; gla:layerId "10" ; skos:prefLabel "Legal accountability and recourse" ; gla:required true .

gla:hidden-history a gla:ChallengeClass ; gla:challengeId "hidden-history" ; gla:visibility "customer-hidden" .
gla:hidden-refusal a gla:ChallengeClass ; gla:challengeId "hidden-refusal" ; gla:visibility "customer-hidden" .
gla:hidden-recovery a gla:ChallengeClass ; gla:challengeId "hidden-recovery" ; gla:visibility "customer-hidden" .

gla:legacy-revision-binding a gla:RequiredBinding ; gla:bindingField "legacy_revision" .
gla:replacement-revision-binding a gla:RequiredBinding ; gla:bindingField "replacement_revision" .
gla:authority-digest-binding a gla:RequiredBinding ; gla:bindingField "authority_digest" .
gla:verifier-digest-binding a gla:RequiredBinding ; gla:bindingField "verifier_digest" .
gla:fixture-digest-binding a gla:RequiredBinding ; gla:bindingField "fixture_set_digest" .
gla:environment-digest-binding a gla:RequiredBinding ; gla:bindingField "environment_digest" .
