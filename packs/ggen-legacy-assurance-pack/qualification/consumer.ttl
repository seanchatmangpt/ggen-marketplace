gla:independent-lab a gla:ReplayEnvironment ; gla:environmentId "independent-lab" .
gla:recovery-site a gla:ReplayEnvironment ; gla:environmentId "recovery-site" .

gla:testing-authority a gla:TestingAuthority ;
    gla:methodId "GLA-METHOD-001" ;
    gla:competencePolicy "personnel qualification and method validation required" ;
    gla:conflictPolicy "implementer cannot be final certifier" ;
    gla:appealsProcess "customer appeal and reassessment process" ;
    gla:revocationProcess "signed certificate revocation and supersession" .

gla:legal-recourse a gla:LegalRecourse ;
    gla:auditRights "customer and independent assessor audit rights" ;
    gla:warrantyBoundary "bounded claim warranty tied to certificate scope" ;
    gla:insuranceReference "professional-liability-policy-reference-required" ;
    gla:remediationObligation "retest, repair, revoke, and reissue" ;
    gla:terminationExport "complete evidence and key export on termination" .
