PREFIX gla: <https://chatmangpt.com/ggen-legacy#>
SELECT ?program ?owner ?egress ?vendorAccess WHERE {
  ?program a gla:AssuranceProgram ; gla:executionOwner ?owner ; gla:networkEgressAllowed ?egress ; gla:vendorSourceAccess ?vendorAccess .
  FILTER (?owner != "customer" || ?egress != false || ?vendorAccess != false)
}
