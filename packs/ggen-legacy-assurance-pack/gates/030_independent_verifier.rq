PREFIX gla: <https://chatmangpt.com/ggen-legacy#>
SELECT ?program ?implementer ?verifier ?authority WHERE {
  ?program a gla:AssuranceProgram ; gla:implementerIdentity ?implementer ; gla:verifierIdentity ?verifier ; gla:decisionAuthority ?authority .
  FILTER (?implementer = ?verifier || ?implementer = ?authority)
}
