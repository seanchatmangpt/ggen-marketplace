PREFIX gla: <https://chatmangpt.com/ggen-legacy#>
SELECT ?authority WHERE {
  ?authority a gla:TestingAuthority .
  FILTER NOT EXISTS {
    ?authority gla:methodId ?method ; gla:competencePolicy ?competence ; gla:conflictPolicy ?conflict ; gla:appealsProcess ?appeals ; gla:revocationProcess ?revocation .
  }
}
