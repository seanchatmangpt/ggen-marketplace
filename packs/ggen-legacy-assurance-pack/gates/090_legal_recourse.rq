PREFIX gla: <https://chatmangpt.com/ggen-legacy#>
SELECT ?recourse WHERE {
  ?recourse a gla:LegalRecourse .
  FILTER NOT EXISTS {
    ?recourse gla:auditRights ?audit ; gla:warrantyBoundary ?warranty ; gla:insuranceReference ?insurance ; gla:remediationObligation ?remediation ; gla:terminationExport ?export .
  }
}
