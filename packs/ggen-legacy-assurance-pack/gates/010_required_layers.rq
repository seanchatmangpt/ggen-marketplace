PREFIX gla: <https://chatmangpt.com/ggen-legacy#>
SELECT ?required WHERE {
  VALUES ?required { gla:layer-01 gla:layer-02 gla:layer-03 gla:layer-04 gla:layer-05 gla:layer-06 gla:layer-07 gla:layer-08 gla:layer-09 gla:layer-10 }
  FILTER NOT EXISTS { ?required a gla:AssuranceLayer ; gla:required true . }
}
