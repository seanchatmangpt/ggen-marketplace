PREFIX gla: <https://chatmangpt.com/ggen-legacy#>
SELECT ?field WHERE {
  VALUES ?field { "legacy_revision" "replacement_revision" "authority_digest" "verifier_digest" "fixture_set_digest" "environment_digest" "toolchain_digest" "evidence_digest" }
  FILTER NOT EXISTS { ?binding a gla:RequiredBinding ; gla:bindingField ?field . }
}
