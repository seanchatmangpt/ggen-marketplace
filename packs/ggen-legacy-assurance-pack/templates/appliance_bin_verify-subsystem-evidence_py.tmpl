{% raw %}#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
from pathlib import Path
from typing import Any


VERIFIER_PATH = "appliance/bin/verify-subsystem-evidence.py"


def canonical(value: Any) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def exact_head(root: Path) -> str:
    completed = subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=root, capture_output=True, text=True
    )
    return completed.stdout.strip() if completed.returncode == 0 else "UNKNOWN"


def read_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text())


def digest_sources(root: Path, sources: list[str]) -> tuple[str, list[str]]:
    digest = hashlib.sha256()
    missing: list[str] = []
    for rel in sorted(sources):
        path = root / rel
        digest.update(rel.encode("utf-8"))
        digest.update(b"\0")
        if path.is_file():
            digest.update(path.read_bytes())
        else:
            missing.append(rel)
            digest.update(b"MISSING")
        digest.update(b"\0")
    return digest.hexdigest(), missing


def check_map(report: dict[str, Any]) -> dict[str, dict[str, Any]]:
    return {
        item["id"]: item
        for item in report.get("checks", [])
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    }


def expected_primary(
    check_id: str,
    verifier_checks: dict[str, dict[str, Any]],
    cross_check: dict[str, Any],
    replay: dict[str, Any],
    release: dict[str, Any],
    sunset: dict[str, Any],
    observation: dict[str, Any],
    document_index: dict[str, Any],
) -> bool:
    if check_id in verifier_checks:
        return verifier_checks[check_id].get("passed") is True
    if check_id == "cross-check":
        return cross_check.get("standing") == "ALIVE"
    if check_id == "replay-match":
        return replay.get("status") == "REPLAY_MATCH"
    if check_id == "release-admitted":
        return release.get("admitted") is True
    if check_id == "sunset-refused-without-authorization":
        return sunset.get("admitted") is False
    if check_id == "document-index":
        return (
            document_index.get("standing") == "ALIVE"
            and len(document_index.get("records", [])) >= 14
            and all(item.get("complete") is True for item in document_index.get("records", []))
        )
    if check_id == "observer-closure":
        observers = observation.get("observers", [])
        return (
            observation.get("standing") == "ALIVE"
            and len(observers) == 5
            and all(item.get("attempted") is True and not item.get("errors") for item in observers)
        )
    return False


def expected_negative(
    control_id: str,
    tamper: dict[str, Any],
    independence: dict[str, Any],
) -> bool:
    if control_id == "evidence-tamper":
        checks = check_map(tamper)
        return (
            tamper.get("standing") != "ALIVE"
            and checks.get("evidence-digests", {}).get("passed") is False
        )
    if control_id == "self-certification":
        checks = check_map(independence)
        return (
            independence.get("standing") != "ALIVE"
            and checks.get("independent-verifier", {}).get("passed") is False
        )
    return False


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", default=".")
    parser.add_argument(
        "--manifest",
        default="evidence/appliance/subsystem-evidence-manifest.json",
    )
    parser.add_argument(
        "--authority", default="authority/assurance-subsystems.json"
    )
    parser.add_argument(
        "--output",
        default="evidence/appliance/subsystem-verifier-report.json",
    )
    args = parser.parse_args()
    root = Path(args.root).resolve()

    manifest = read_json(root / args.manifest)
    authority = read_json(root / args.authority)
    verifier_report = read_json(root / "evidence/appliance/reference-verifier-report.json")
    cross_check = read_json(root / "evidence/appliance/reference-cross-check-report.json")
    replay = read_json(root / "evidence/appliance/reference-replay-report.json")
    release = read_json(root / "evidence/appliance/reference-release-admission.json")
    sunset = read_json(root / "evidence/appliance/reference-sunset-admission.json")
    tamper = read_json(root / "evidence/appliance/reference-tamper-report.json")
    independence = read_json(root / "evidence/appliance/reference-independence-report.json")
    observation = read_json(root / "evidence/appliance/observation-report.json")
    document_index = read_json(root / "evidence/appliance/document-evidence-index.json")
    verifier_checks = check_map(verifier_report)

    global_checks: list[dict[str, Any]] = []
    head = exact_head(root)
    global_checks.append({
        "id": "exact-source-head",
        "passed": manifest.get("exact_source_head") == head,
        "detail": {"manifest": manifest.get("exact_source_head"), "observed": head},
    })
    generator = manifest.get("generator", {})
    generator_path = root / str(generator.get("path", ""))
    global_checks.append({
        "id": "generator-identity",
        "passed": (
            generator_path.is_file()
            and generator.get("sha256") == sha256_file(generator_path)
            and generator.get("role") == "manifest-generator"
        ),
        "detail": generator,
    })
    receipt_claim = manifest.get("receipt_digest")
    unsigned = dict(manifest)
    unsigned.pop("receipt_digest", None)
    receipt_observed = hashlib.sha256(canonical(unsigned)).hexdigest()
    global_checks.append({
        "id": "manifest-receipt",
        "passed": receipt_claim == receipt_observed,
        "detail": {"claimed": receipt_claim, "observed": receipt_observed},
    })
    global_checks.append({
        "id": "verifier-separation",
        "passed": generator.get("path") != VERIFIER_PATH,
        "detail": {
            "generator": generator.get("path"),
            "verifier": VERIFIER_PATH,
            "verifier_sha256": sha256_file(root / VERIFIER_PATH),
        },
    })

    declarations = {
        item["id"]: item for item in authority.get("subsystems", [])
    }
    claims = {
        item["id"]: item for item in manifest.get("subsystems", [])
    }
    global_checks.append({
        "id": "subsystem-cardinality",
        "passed": len(declarations) == 10 and set(declarations) == set(claims),
        "detail": {
            "authority": sorted(declarations),
            "manifest": sorted(claims),
        },
    })

    subsystem_results: list[dict[str, Any]] = []
    for subsystem_id in sorted(declarations):
        declaration = declarations[subsystem_id]
        claim = claims.get(subsystem_id, {})
        checks: list[dict[str, Any]] = []

        authority_digest, missing_authority = digest_sources(
            root, declaration.get("authority_sources", [])
        )
        implementation_digest, missing_implementation = digest_sources(
            root, declaration.get("implementation_sources", [])
        )
        checks.append({
            "id": "authority-digest",
            "passed": (
                claim.get("authority_digest") == authority_digest
                and claim.get("authority_sources") == declaration.get("authority_sources", [])
            ),
            "detail": {"claimed": claim.get("authority_digest"), "observed": authority_digest},
        })
        checks.append({
            "id": "implementation-digest",
            "passed": (
                claim.get("implementation_digest") == implementation_digest
                and claim.get("implementation_sources") == declaration.get("implementation_sources", [])
            ),
            "detail": {"claimed": claim.get("implementation_digest"), "observed": implementation_digest},
        })
        expected_missing = sorted(missing_authority + missing_implementation)
        checks.append({
            "id": "source-closure",
            "passed": claim.get("missing_sources") == expected_missing and not expected_missing,
            "detail": expected_missing,
        })

        claimed_primary = {
            item.get("id"): item for item in claim.get("primary_checks", [])
        }
        for check_id in declaration.get("primary_checks", []):
            observed = expected_primary(
                check_id,
                verifier_checks,
                cross_check,
                replay,
                release,
                sunset,
                observation,
                document_index,
            )
            checks.append({
                "id": f"primary:{check_id}",
                "passed": (
                    observed
                    and claimed_primary.get(check_id, {}).get("passed") is True
                ),
                "detail": {
                    "independently_observed": observed,
                    "manifest_claim": claimed_primary.get(check_id),
                },
            })

        claimed_negative = {
            item.get("id"): item for item in claim.get("negative_controls", [])
        }
        for control_id in declaration.get("negative_controls", []):
            observed = expected_negative(control_id, tamper, independence)
            checks.append({
                "id": f"negative:{control_id}",
                "passed": (
                    observed
                    and claimed_negative.get(control_id, {}).get("passed") is True
                ),
                "detail": {
                    "independently_observed": observed,
                    "manifest_claim": claimed_negative.get(control_id),
                },
            })

        standing = "ALIVE" if checks and all(item["passed"] for item in checks) else "PARTIAL_ALIVE"
        subsystem_results.append({
            "id": subsystem_id,
            "checks": checks,
            "standing": standing,
        })

    standing = (
        "ALIVE"
        if all(item["passed"] for item in global_checks)
        and len(subsystem_results) == 10
        and all(item["standing"] == "ALIVE" for item in subsystem_results)
        else "PARTIAL_ALIVE"
    )
    report = {
        "schema": "ggen.legacy.subsystem.verifier.report.v1",
        "release": "v26.8.1",
        "scope": "verifier-appliance-reference",
        "exact_source_head": head,
        "verifier": {
            "path": VERIFIER_PATH,
            "sha256": sha256_file(root / VERIFIER_PATH),
            "independent_of_manifest_generator": True,
        },
        "global_checks": global_checks,
        "subsystems": subsystem_results,
        "standing": standing,
        "nonclaims": [
            "complete ggen-legacy product ALIVE",
            "external Fortune 5 production standing",
            "real predecessor Sunset Admission",
        ],
    }
    output = root / args.output
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
    print(json.dumps({
        "subsystems": len(subsystem_results),
        "alive": sum(1 for item in subsystem_results if item["standing"] == "ALIVE"),
        "standing": standing,
    }, sort_keys=True))
    return 0 if standing == "ALIVE" else 2


if __name__ == "__main__":
    raise SystemExit(main())
