{% raw %}#!/usr/bin/env python3
from __future__ import annotations
import argparse, hashlib, json, os, shutil, subprocess, sys, tempfile
from pathlib import Path

def canonical(obj):
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()

def sha256_bytes(data): return hashlib.sha256(data).hexdigest()
def sha256_file(path):
    h=hashlib.sha256()
    with open(path,"rb") as f:
        for chunk in iter(lambda:f.read(1024*1024),b""): h.update(chunk)
    return h.hexdigest()
def read_json(path): return json.loads(Path(path).read_text())
def write_json(path,obj):
    p=Path(path); p.parent.mkdir(parents=True,exist_ok=True)
    p.write_text(json.dumps(obj,indent=2,sort_keys=True)+"\n")
def tree_inventory(root):
    root=Path(root); out=[]
    for p in sorted(x for x in root.rglob("*") if x.is_file()):
        out.append({"path":p.relative_to(root).as_posix(),"sha256":sha256_file(p),"bytes":p.stat().st_size})
    return out
def tree_digest(root):
    inv=tree_inventory(root)
    return sha256_bytes("\n".join(f"{x['path']}:{x['sha256']}" for x in inv).encode())


def main():
    ap=argparse.ArgumentParser(); ap.add_argument("--portfolio",required=True); ap.add_argument("--verifier-report",required=True); ap.add_argument("--replay-report",required=True); ap.add_argument("--cross-check-report",required=True)
    a=ap.parse_args(); root=Path(a.portfolio); m=read_json(root/"claim-manifest.json"); v=read_json(a.verifier_report); r=read_json(a.replay_report); cross=read_json(a.cross_check_report)
    release=v.get("standing")=="ALIVE" and cross.get("standing")=="ALIVE" and r.get("status")=="REPLAY_MATCH"
    closure=m.get("capability_closure",{}); closed=all(closure.get(k)==0 for k in ["unknown_capabilities","unknown_dispositions","unknown_standings","unassigned_verifiers","missing_equivalence_cases","equivalence_failures","replay_differences"])
    sunset=release and closed and m.get("customer_authorized_retirement") is True
    write_json(root/"release-admission.json",{"schema":"ggen.legacy.release.admission.v1","admitted":release,"state":"ALIVE" if release else "REFUSED","basis":{"verifier_standing":v.get("standing"),"replay":r.get("status"),"cross_check":cross.get("standing")}})
    write_json(root/"sunset-admission.json",{"schema":"ggen.legacy.sunset.admission.v1","admitted":sunset,"state":"ALIVE" if sunset else "REFUSED","basis":{"release_admitted":release,"capability_closure":closed,"customer_authorized_retirement":m.get("customer_authorized_retirement") is True}})
    print(json.dumps({"release_admitted":release,"sunset_admitted":sunset},sort_keys=True))
if __name__=="__main__": main()
