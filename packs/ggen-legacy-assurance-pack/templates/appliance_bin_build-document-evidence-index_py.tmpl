{% raw %}#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
from pathlib import Path


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def exact_head(root: Path) -> str:
    completed = subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=root, capture_output=True, text=True
    )
    return completed.stdout.strip() if completed.returncode == 0 else "UNKNOWN"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", default=".")
    parser.add_argument("--authority", default="authority/document-evidence.json")
    parser.add_argument("--output", default="evidence/appliance/document-evidence-index.json")
    args = parser.parse_args()

    root = Path(args.root).resolve()
    authority_path = root / args.authority
    authority = json.loads(authority_path.read_text())
    records: list[dict[str, object]] = []

    for source in authority.get("records", []):
        document = root / source["document"]
        reference_fields = ("authority_ref", "implementation_ref", "verifier_ref", "legacy_ref")
        missing_refs = [
            source[field] for field in reference_fields if not (root / source[field]).is_file()
        ]
        if not document.is_file():
            missing_refs.insert(0, source["document"])
        records.append({
            "document": source["document"],
            "document_sha256": sha256_file(document) if document.is_file() else None,
            "authority_ref": source["authority_ref"],
            "implementation_ref": source["implementation_ref"],
            "verifier_ref": source["verifier_ref"],
            "legacy_ref": source["legacy_ref"],
            "missing_refs": missing_refs,
            "complete": document.is_file() and not missing_refs,
        })

    standing = "ALIVE" if records and all(item["complete"] for item in records) else "PARTIAL_ALIVE"
    report = {
        "schema": "ggen.legacy.document.evidence.index.v1",
        "release": "v26.8.1",
        "exact_source_head": exact_head(root),
        "authority_digest": sha256_file(authority_path),
        "records": records,
        "standing": standing,
    }
    output = root / args.output
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n")
    print(json.dumps({
        "documents": len(records),
        "complete": sum(1 for item in records if item["complete"]),
        "standing": standing,
    }, sort_keys=True))
    return 0 if standing == "ALIVE" else 2


if __name__ == "__main__":
    raise SystemExit(main())
