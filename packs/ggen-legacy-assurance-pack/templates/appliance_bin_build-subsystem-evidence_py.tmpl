{% raw %}#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
from pathlib import Path
from typing import Any


GENERATOR_PATH = "appliance/bin/build-subsystem-evidence.py"


def canonical(value: Any) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=False
    ).encode("utf-8")


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def exact_head(root: Path) -> str:
    completed = subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=root, capture_output=True, text=True
    )
    return completed.stdout.strip() if completed.returncode == 0 else "UNKNOWN"


def read_json(path: Path) -> dict[str, Any]:
    return json.loads(path.read_text())


def digest_sources(root: Path, sources: list[str]) -> tuple[str, list[str]]:
    digest = hashlib.sha256()
    missing: list[str] = []
    for rel in sorted(sources):
        path = root / rel
        digest.update(rel.encode("utf-8"))
        digest.update(b"\0")
        if path.is_file():
            digest.update(path.read_bytes())
        else:
            missing.append(rel)
            digest.update(b"MISSING")
        digest.update(b"\0")
    return digest.hexdigest(), missing


def check_map(report: dict[str, Any]) -> dict[str, dict[str, Any]]:
    return {
        item["id"]: item
        for item in report.get("checks", [])
        if isinstance(item, dict) and isinstance(item.get("id"), str)
    }


def primary_result(
    check_id: str,
    verifier_checks: dict[str, dict[str, Any]],
    cross_check: dict[str, Any],
    replay: dict[str, Any],
    release: dict[str, Any],
    sunset: dict[str, Any],
    observation: dict[str, Any],
    document_index: dict[str, Any],
) -> dict[str, Any]:
    if check_id in verifier_checks:
        item = verifier_checks[check_id]
        return {
            "id": check_id,
            "passed": bool(item.get("passed")),
            "detail": item.get("detail"),
        }
    if check_id == "document-index":
        return {
            "id": check_id,
            "passed": document_index.get("standing") == "ALIVE",
            "detail": {
                "standing": document_index.get("standing"),
                "records": len(document_index.get("records", [])),
            },
        }
    if check_id == "observer-closure":
        observers = observation.get("observers", [])
        return {
            "id": check_id,
            "passed": (
                observation.get("standing") == "ALIVE"
                and len(observers) == 5
                and all(item.get("attempted") is True for item in observers)
            ),
            "detail": {
                "standing": observation.get("standing"),
                "observers": [item.get("id") for item in observers],
            },
        }
    if check_id == "cross-check":
        return {
            "id": check_id,
            "passed": cross_check.get("standing") == "ALIVE",
            "detail": cross_check.get("standing"),
        }
    if check_id == "replay-match":
        return {
            "id": check_id,
            "passed": replay.get("status") == "REPLAY_MATCH",
            "detail": replay.get("status"),
        }
    if check_id == "release-admitted":
        return {
            "id": check_id,
            "passed": release.get("admitted") is True,
            "detail": release.get("reason") or release.get("admitted"),
        }
    if check_id == "sunset-refused-without-authorization":
        return {
            "id": check_id,
            "passed": sunset.get("admitted") is False,
            "detail": sunset.get("reason") or sunset.get("admitted"),
        }
    return {"id": check_id, "passed": False, "detail": "UNKNOWN_CHECK"}


def negative_result(
    control_id: str,
    tamper_report: dict[str, Any],
    independence_report: dict[str, Any],
) -> dict[str, Any]:
    if control_id == "evidence-tamper":
        checks = check_map(tamper_report)
        caught = (
            tamper_report.get("standing") != "ALIVE"
            and checks.get("evidence-digests", {}).get("passed") is False
        )
        return {
            "id": control_id,
            "passed": caught,
            "detail": checks.get("evidence-digests"),
        }
    if control_id == "self-certification":
        checks = check_map(independence_report)
        caught = (
            independence_report.get("standing") != "ALIVE"
            and checks.get("independent-verifier", {}).get("passed") is False
        )
        return {
            "id": control_id,
            "passed": caught,
            "detail": checks.get("independent-verifier"),
        }
    return {"id": control_id, "passed": False, "detail": "UNKNOWN_CONTROL"}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", default=".")
    parser.add_argument(
        "--authority", default="authority/assurance-subsystems.json"
    )
    parser.add_argument(
        "--output",
        default="evidence/appliance/subsystem-evidence-manifest.json",
    )
    args = parser.parse_args()
    root = Path(args.root).resolve()

    authority = read_json(root / args.authority)
    verifier_report = read_json(
        root / "evidence/appliance/reference-verifier-report.json"
    )
    cross_check = read_json(
        root / "evidence/appliance/reference-cross-check-report.json"
    )
    replay = read_json(root / "evidence/appliance/reference-replay-report.json")
    release = read_json(
        root / "evidence/appliance/reference-release-admission.json"
    )
    sunset = read_json(
        root / "evidence/appliance/reference-sunset-admission.json"
    )
    tamper = read_json(root / "evidence/appliance/reference-tamper-report.json")
    independence = read_json(
        root / "evidence/appliance/reference-independence-report.json"
    )
    observation = read_json(
        root / "evidence/appliance/observation-report.json"
    )
    document_index = read_json(
        root / "evidence/appliance/document-evidence-index.json"
    )
    verifier_checks = check_map(verifier_report)

    records: list[dict[str, Any]] = []
    for declaration in authority.get("subsystems", []):
        authority_digest, missing_authority = digest_sources(
            root, declaration.get("authority_sources", [])
        )
        implementation_digest, missing_implementation = digest_sources(
            root, declaration.get("implementation_sources", [])
        )
        primary = [
            primary_result(
                check_id,
                verifier_checks,
                cross_check,
                replay,
                release,
                sunset,
                observation,
                document_index,
            )
            for check_id in declaration.get("primary_checks", [])
        ]
        negative = [
            negative_result(control_id, tamper, independence)
            for control_id in declaration.get("negative_controls", [])
        ]
        missing_sources = sorted(missing_authority + missing_implementation)
        standing = (
            "ALIVE"
            if primary
            and all(item["passed"] for item in primary)
            and all(item["passed"] for item in negative)
            and not missing_sources
            else "PARTIAL_ALIVE"
        )
        records.append({
            "id": declaration["id"],
            "authority_sources": declaration.get("authority_sources", []),
            "authority_digest": authority_digest,
            "implementation_sources": declaration.get("implementation_sources", []),
            "implementation_digest": implementation_digest,
            "missing_sources": missing_sources,
            "primary_checks": primary,
            "negative_controls": negative,
            "provisional_standing": standing,
        })

    generator_path = root / GENERATOR_PATH
    manifest: dict[str, Any] = {
        "schema": "ggen.legacy.assurance.subsystem-evidence.v1",
        "release": "v26.8.1",
        "exact_source_head": exact_head(root),
        "generator": {
            "path": GENERATOR_PATH,
            "sha256": sha256_file(generator_path),
            "role": "manifest-generator",
        },
        "subsystems": records,
    }
    manifest["receipt_digest"] = hashlib.sha256(canonical(manifest)).hexdigest()

    output = root / args.output
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
    print(json.dumps({
        "subsystems": len(records),
        "provisional_alive": sum(
            1 for item in records if item["provisional_standing"] == "ALIVE"
        ),
        "receipt_digest": manifest["receipt_digest"],
    }, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
