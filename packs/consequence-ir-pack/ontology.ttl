@prefix cci: <https://ggen.dev/consequence-ir#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ggen.dev/consequence-ir> a prov:Entity ;
  dct:title "Chatman Consequence IR" ;
  dct:description "Protocol-neutral semantic kernel for admitted observation to independently verified consequence." ;
  dct:hasVersion "0.1.0" .

cci:Observation a rdfs:Class ; rdfs:subClassOf prov:Entity, sosa:Observation ; rdfs:label "Observation" .
cci:AdmittedObservation a rdfs:Class ; rdfs:subClassOf cci:Observation ; rdfs:label "Admitted observation" .
cci:Intent a rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Intent" .
cci:Plan a rdfs:Class ; rdfs:subClassOf prov:Plan ; rdfs:label "Plan" .
cci:Artifact a rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Manufactured artifact" .
cci:Execution a rdfs:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Authorized execution" .
cci:ObservedConsequence a rdfs:Class ; rdfs:subClassOf cci:Observation ; rdfs:label "Independently observed consequence" .
cci:Verification a rdfs:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Verification" .
cci:Receipt a rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Receipt" .
cci:AuthorityGrant a rdfs:Class ; rdfs:subClassOf odrl:Permission ; rdfs:label "Bounded authority grant" .
cci:Capability a rdfs:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Capability" .
cci:Promotion a rdfs:Class ; rdfs:subClassOf prov:Activity ; rdfs:label "Capability promotion" .
cci:Standing a rdfs:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Standing" .
cci:Phase a rdfs:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Production phase" .

cci:UNKNOWN a cci:Standing ; skos:prefLabel "UNKNOWN" .
cci:PARTIAL_ALIVE a cci:Standing ; skos:prefLabel "PARTIAL_ALIVE" .
cci:ALIVE a cci:Standing ; skos:prefLabel "ALIVE" .
cci:BUILD_BROKEN a cci:Standing ; skos:prefLabel "BUILD_BROKEN" .
cci:BLOCKED a cci:Standing ; skos:prefLabel "BLOCKED" .
cci:UNSUPPORTED a cci:Standing ; skos:prefLabel "UNSUPPORTED" .
cci:REFUSED a cci:Standing ; skos:prefLabel "REFUSED" .
cci:SELECT a cci:Phase ; skos:prefLabel "SELECT" .
cci:CONSTRUCT a cci:Phase ; skos:prefLabel "CONSTRUCT" .
cci:DO a cci:Phase ; skos:prefLabel "DO" .

cci:admittedFrom a rdf:Property ; rdfs:domain cci:AdmittedObservation ; rdfs:range cci:Observation .
cci:selectsPlan a rdf:Property ; rdfs:range cci:Plan .
cci:manufactures a rdf:Property ; rdfs:domain prov:Activity ; rdfs:range cci:Artifact .
cci:usesArtifact a rdf:Property ; rdfs:domain cci:Execution ; rdfs:range cci:Artifact .
cci:requiresAuthority a rdf:Property ; rdfs:domain cci:Execution ; rdfs:range cci:AuthorityGrant .
cci:hasPhase a rdf:Property ; rdfs:range cci:Phase .
cci:observesConsequence a rdf:Property ; rdfs:domain cci:Execution ; rdfs:range cci:ObservedConsequence .
cci:verifiedBy a rdf:Property ; rdfs:range cci:Verification .
cci:hasReceipt a rdf:Property ; rdfs:range cci:Receipt .
cci:bindsSubject a rdf:Property ; rdfs:domain cci:Receipt ; rdfs:range prov:Entity .
cci:bindsActivity a rdf:Property ; rdfs:domain cci:Receipt ; rdfs:range prov:Activity .
cci:bindsConsequence a rdf:Property ; rdfs:domain cci:Receipt ; rdfs:range cci:ObservedConsequence .
cci:bindsVerification a rdf:Property ; rdfs:domain cci:Receipt ; rdfs:range cci:Verification .
cci:standing a rdf:Property ; rdfs:domain cci:Receipt ; rdfs:range cci:Standing .
cci:digest a rdf:Property ; rdfs:domain cci:Receipt ; rdfs:range xsd:string .
cci:replayOf a rdf:Property ; rdfs:domain cci:Execution ; rdfs:range cci:Receipt .
cci:authorityPrincipal a rdf:Property ; rdfs:domain cci:AuthorityGrant ; rdfs:range prov:Agent .
cci:authorityAction a rdf:Property ; rdfs:domain cci:AuthorityGrant ; rdfs:range cci:Capability .
cci:authorityScope a rdf:Property ; rdfs:domain cci:AuthorityGrant .
cci:authorityEvidence a rdf:Property ; rdfs:domain cci:AuthorityGrant ; rdfs:range prov:Entity .
cci:expectedEffect a rdf:Property ; rdfs:range prov:Entity .
cci:promotesCapability a rdf:Property ; rdfs:domain cci:Promotion ; rdfs:range cci:Capability .
cci:promotionEvidence a rdf:Property ; rdfs:domain cci:Promotion ; rdfs:range cci:Receipt .
cci:informationLoss a rdf:Property ; rdfs:range qudt:QuantityValue ; rdfs:label "declared information loss" .
