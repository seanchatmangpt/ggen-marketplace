@prefix cci: <https://ggen.dev/consequence-ir#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:qualification:raw-observation> a cci:Observation .
<urn:qualification:admitted-observation> a cci:AdmittedObservation ;
  cci:admittedFrom <urn:qualification:raw-observation> .

<urn:qualification:capability> a cci:Capability .
<urn:qualification:principal> a prov:Agent .
<urn:qualification:authority-evidence> a prov:Entity .
<urn:qualification:subject> a prov:Entity .
<urn:qualification:policy> a cci:Policy .
<urn:qualification:environment> a prov:Entity .

<urn:qualification:grant> a cci:AuthorityGrant ;
  cci:authorityPrincipal <urn:qualification:principal> ;
  cci:authorityAction <urn:qualification:capability> ;
  cci:authoritySubject <urn:qualification:subject> ;
  cci:authorityScope <urn:qualification:environment> ;
  cci:authorityPolicy <urn:qualification:policy> ;
  cci:authorityEvidence <urn:qualification:authority-evidence> .

<urn:qualification:intent> a cci:Intent .
<urn:qualification:hook> a cci:KnowledgeHook ;
  cci:hasPhase cci:SELECT ;
  cci:evaluatesEvidence <urn:qualification:admitted-observation> ;
  cci:manufacturesIntent <urn:qualification:intent> .

<urn:qualification:artifact> a cci:Artifact .
<urn:qualification:consequence> a cci:ObservedConsequence .
<urn:qualification:verification> a cci:Verification .

<urn:qualification:execution> a cci:Execution ;
  cci:hasPhase cci:DO ;
  cci:usesArtifact <urn:qualification:artifact> ;
  cci:executesIntent <urn:qualification:intent> ;
  cci:requiresAuthority <urn:qualification:grant> ;
  cci:hasReversibility cci:REVERSIBLE ;
  cci:observesConsequence <urn:qualification:consequence> ;
  cci:verifiedBy <urn:qualification:verification> ;
  cci:hasReceipt <urn:qualification:receipt> .

<urn:qualification:receipt> a cci:Receipt ;
  cci:bindsSubject <urn:qualification:artifact> ;
  cci:bindsActivity <urn:qualification:execution> ;
  cci:bindsIntent <urn:qualification:intent> ;
  cci:bindsConsequence <urn:qualification:consequence> ;
  cci:bindsVerification <urn:qualification:verification> ;
  cci:standing cci:ALIVE ;
  cci:standingCeiling cci:ALIVE ;
  cci:digest "sha256:qualification-only-1" .

<urn:qualification:replay-consequence> a cci:ObservedConsequence .
<urn:qualification:replay-verification> a cci:Verification .
<urn:qualification:replay> a cci:Execution ;
  cci:hasPhase cci:DO ;
  cci:usesArtifact <urn:qualification:artifact> ;
  cci:executesIntent <urn:qualification:intent> ;
  cci:requiresAuthority <urn:qualification:grant> ;
  cci:hasReversibility cci:REVERSIBLE ;
  cci:replayOf <urn:qualification:receipt> ;
  cci:observesConsequence <urn:qualification:replay-consequence> ;
  cci:verifiedBy <urn:qualification:replay-verification> ;
  cci:hasReceipt <urn:qualification:replay-receipt> .

<urn:qualification:replay-receipt> a cci:Receipt ;
  cci:bindsSubject <urn:qualification:artifact> ;
  cci:bindsActivity <urn:qualification:replay> ;
  cci:bindsIntent <urn:qualification:intent> ;
  cci:bindsConsequence <urn:qualification:replay-consequence> ;
  cci:bindsVerification <urn:qualification:replay-verification> ;
  cci:parentReceipt <urn:qualification:receipt> ;
  cci:standing cci:ALIVE ;
  cci:standingCeiling cci:ALIVE ;
  cci:digest "sha256:qualification-only-2" .

<urn:qualification:falsifier> a cci:Falsifier .
<urn:qualification:promoted-artifact> a cci:Artifact .
<urn:qualification:promotion> a cci:Promotion ;
  cci:promotesCapability <urn:qualification:capability> ;
  cci:promotionEvidence <urn:qualification:receipt>, <urn:qualification:replay-receipt> ;
  cci:promotionFalsifier <urn:qualification:falsifier> ;
  cci:promotedArtifact <urn:qualification:promoted-artifact> .
