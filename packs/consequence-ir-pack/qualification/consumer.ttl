@prefix cci: <https://ggen.dev/consequence-ir#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:qualification:raw-observation> a cci:Observation .
<urn:qualification:admitted-observation> a cci:AdmittedObservation ; cci:admittedFrom <urn:qualification:raw-observation> .
<urn:qualification:capability> a cci:Capability .
<urn:qualification:principal> a prov:Agent .
<urn:qualification:authority-evidence> a prov:Entity .
<urn:qualification:grant> a cci:AuthorityGrant ; cci:authorityPrincipal <urn:qualification:principal> ; cci:authorityAction <urn:qualification:capability> ; cci:authorityScope <urn:qualification:environment> ; cci:authorityEvidence <urn:qualification:authority-evidence> .
<urn:qualification:artifact> a cci:Artifact .
<urn:qualification:consequence> a cci:ObservedConsequence .
<urn:qualification:verification> a cci:Verification .
<urn:qualification:execution> a cci:Execution ; cci:hasPhase cci:DO ; cci:usesArtifact <urn:qualification:artifact> ; cci:requiresAuthority <urn:qualification:grant> ; cci:observesConsequence <urn:qualification:consequence> ; cci:verifiedBy <urn:qualification:verification> ; cci:hasReceipt <urn:qualification:receipt> .
<urn:qualification:receipt> a cci:Receipt ; cci:bindsSubject <urn:qualification:artifact> ; cci:bindsActivity <urn:qualification:execution> ; cci:bindsConsequence <urn:qualification:consequence> ; cci:bindsVerification <urn:qualification:verification> ; cci:standing cci:ALIVE ; cci:digest "sha256:qualification-only" .
<urn:qualification:promotion> a cci:Promotion ; cci:promotesCapability <urn:qualification:capability> ; cci:promotionEvidence <urn:qualification:receipt> .
