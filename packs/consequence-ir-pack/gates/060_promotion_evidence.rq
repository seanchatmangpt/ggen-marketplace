# MESSAGE: cognition-to-determinism promotion must name the promoted capability and at least one prior receipt; any row is a refusal.
PREFIX cci: <https://ggen.dev/consequence-ir#>
SELECT ?promotion ?missing WHERE {
  ?promotion a cci:Promotion .
  VALUES ?missing { cci:promotesCapability cci:promotionEvidence }
  FILTER NOT EXISTS { ?promotion ?missing ?value }
}
ORDER BY ?promotion ?missing
