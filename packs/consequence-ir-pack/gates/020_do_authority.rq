# MESSAGE: execution is the only Consequence IR activity allowed to carry the DO phase, and every DO execution must bind authority; any row is a refusal.
PREFIX cci: <https://ggen.dev/consequence-ir#>
SELECT ?subject ?reason WHERE {
  {
    ?subject cci:hasPhase cci:DO .
    FILTER NOT EXISTS { ?subject a cci:Execution }
    BIND("NON_EXECUTION_DO" AS ?reason)
  }
  UNION
  {
    ?subject a cci:Execution ; cci:hasPhase cci:DO .
    FILTER NOT EXISTS { ?subject cci:requiresAuthority ?grant }
    BIND("DO_WITHOUT_AUTHORITY" AS ?reason)
  }
}
ORDER BY ?subject ?reason
