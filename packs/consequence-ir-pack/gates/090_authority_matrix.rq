# MESSAGE: authority is a bounded principal × action × subject × scope × policy × evidence relation, never an ambient token; any row is a refusal.
PREFIX cci: <https://ggen.dev/consequence-ir#>
SELECT ?grant ?missing WHERE {
  ?grant a cci:AuthorityGrant .
  VALUES ?missing {
    cci:authorityPrincipal
    cci:authorityAction
    cci:authoritySubject
    cci:authorityScope
    cci:authorityPolicy
    cci:authorityEvidence
  }
  FILTER NOT EXISTS { ?grant ?missing ?value }
}
ORDER BY ?grant ?missing
