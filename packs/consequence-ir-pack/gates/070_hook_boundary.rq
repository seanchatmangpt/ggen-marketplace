# MESSAGE: Knowledge Hooks may evaluate evidence and manufacture intents, but they never own DO or execution authority; any row is a refusal.
PREFIX cci: <https://ggen.dev/consequence-ir#>
SELECT ?hook ?violation WHERE {
  ?hook a cci:KnowledgeHook .
  {
    ?hook cci:hasPhase cci:DO .
    BIND("HOOK_DO_FORBIDDEN" AS ?violation)
  }
  UNION
  {
    ?hook a cci:Execution .
    BIND("HOOK_EXECUTION_FORBIDDEN" AS ?violation)
  }
  UNION
  {
    FILTER NOT EXISTS { ?hook cci:manufacturesIntent ?intent . ?intent a cci:Intent . }
    BIND("HOOK_INTENT_REQUIRED" AS ?violation)
  }
}
ORDER BY ?hook ?violation
