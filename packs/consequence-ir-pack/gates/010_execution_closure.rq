# MESSAGE: every consequential execution must be explicit DO, consume an artifact, bind an authority grant, expose independent consequence observation, verification, and a receipt; any row is a refusal.
PREFIX cci: <https://ggen.dev/consequence-ir#>
SELECT ?execution ?missing WHERE {
  ?execution a cci:Execution .
  VALUES ?missing { cci:hasPhase cci:usesArtifact cci:requiresAuthority cci:observesConsequence cci:verifiedBy cci:hasReceipt }
  FILTER NOT EXISTS { ?execution ?missing ?value }
}
ORDER BY ?execution ?missing
