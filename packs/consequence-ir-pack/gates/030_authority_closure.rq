# MESSAGE: every authority grant must identify principal, capability/action, scope, and independent evidence; any row is a refusal.
PREFIX cci: <https://ggen.dev/consequence-ir#>
SELECT ?grant ?missing WHERE {
  ?grant a cci:AuthorityGrant .
  VALUES ?missing { cci:authorityPrincipal cci:authorityAction cci:authorityScope cci:authorityEvidence }
  FILTER NOT EXISTS { ?grant ?missing ?value }
}
ORDER BY ?grant ?missing
