# MESSAGE: every receipt must bind exact subject, causal activity, standing, and digest; ALIVE receipts additionally require independently observed consequence and verification; any row is a refusal.
PREFIX cci: <https://ggen.dev/consequence-ir#>
SELECT ?receipt ?missing WHERE {
  {
    ?receipt a cci:Receipt .
    VALUES ?missing { cci:bindsSubject cci:bindsActivity cci:standing cci:digest }
    FILTER NOT EXISTS { ?receipt ?missing ?value }
  }
  UNION
  {
    ?receipt a cci:Receipt ; cci:standing cci:ALIVE .
    VALUES ?missing { cci:bindsConsequence cci:bindsVerification }
    FILTER NOT EXISTS { ?receipt ?missing ?value }
  }
}
ORDER BY ?receipt ?missing
