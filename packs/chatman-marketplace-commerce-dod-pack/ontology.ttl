@prefix cmc: <https://ggen.dev/marketplace/commerce-dod#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

cmc:MarketplaceCommerceDoD a rdfs:Class ;
  rdfs:label "Marketplace commerce Definition of Done" ;
  rdfs:comment "A bounded proof obligation for marketplace commercial standing. Generated adapters and static fixtures cannot establish ALIVE." .

cmc:CommercialAgreement a rdfs:Class ;
  rdfs:label "Commercial agreement" ;
  rdfs:comment "Canonical commercial subject independent of provider-specific billing objects." .

cmc:BillingAuthority a rdfs:Class ;
  rdfs:label "Billing authority" ;
  rdfs:comment "Authority permitted to cause a financial consequence for one admitted agreement." .

cmc:CommercialIntent a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Commercial intent" .

cmc:CommercialReceipt a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Commercial receipt" ;
  rdfs:comment "Evidence binding exact subject, authority, operation identity, consequence, provider effect, and replay lineage." .

cmc:FailureBoundaryEvidence a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Failure-boundary evidence" .

cmc:Standing a rdfs:Class ; rdfs:label "Standing" .
cmc:UNKNOWN a cmc:Standing .
cmc:PARTIAL_ALIVE a cmc:Standing .
cmc:ALIVE a cmc:Standing .
cmc:BLOCKED a cmc:Standing .
cmc:BUILD_BROKEN a cmc:Standing .
cmc:UNSUPPORTED a cmc:Standing .

cmc:AWS_MARKETPLACE a cmc:BillingAuthority .
cmc:MICROSOFT_MARKETPLACE a cmc:BillingAuthority .
cmc:GOOGLE_CLOUD_MARKETPLACE a cmc:BillingAuthority .
cmc:ORACLE_MARKETPLACE a cmc:BillingAuthority .
cmc:IBM_MARKETPLACE a cmc:BillingAuthority .
cmc:SAP_MARKETPLACE a cmc:BillingAuthority .
cmc:SALESFORCE_APPEXCHANGE a cmc:BillingAuthority .
cmc:DIRECT_STRIPE a cmc:BillingAuthority .
cmc:GENERIC_MARKETPLACE a cmc:BillingAuthority .

cmc:hasBillingAuthority a rdf:Property ;
  rdfs:domain cmc:CommercialAgreement ;
  rdfs:range cmc:BillingAuthority .
cmc:operationIdentity a rdf:Property ; rdfs:domain cmc:CommercialIntent .
cmc:providerEffectIdentity a rdf:Property ; rdfs:domain cmc:CommercialReceipt .
cmc:receiptParent a rdf:Property ; rdfs:domain cmc:CommercialReceipt ; rdfs:range cmc:CommercialReceipt .
cmc:standing a rdf:Property ; rdfs:range cmc:Standing .

cmc:ExactlyOneBillingAuthority a odrl:Constraint ;
  skos:definition "For one admitted commercial agreement at one time, exactly one billing authority may be active." .
cmc:ZeroUnreceiptedActuation a odrl:Constraint ;
  skos:definition "Every consequential financial DO crosses BRCE and yields a durable receipt before the workflow can claim completion." .
cmc:ExactSubjectStanding a odrl:Constraint ;
  skos:definition "ALIVE requires observed execution against the exact admitted source, marketplace contract, environment, and configuration." .
cmc:ReplayIdentity a odrl:Constraint ;
  skos:definition "Retry or replay of a commercial intent must resolve to the same provider effect and must not create an additional external consequence." .
cmc:ReceiptDAG a odrl:Constraint ;
  skos:definition "Commercial receipts form an acyclic provenance graph whose referenced phase receipts exist and bind the same admitted subject." .

cmc:purchase a skos:Concept ; skos:prefLabel "purchase accepted" .
cmc:entitlement a skos:Concept ; skos:prefLabel "entitlement admitted" .
cmc:provision a skos:Concept ; skos:prefLabel "provisioning consequence" .
cmc:usage a skos:Concept ; skos:prefLabel "usage observed" .
cmc:billing a skos:Concept ; skos:prefLabel "billing intent admitted" .
cmc:providerAcceptance a skos:Concept ; skos:prefLabel "provider accepted financial DO" .
cmc:lifecycleTransition a skos:Concept ; skos:prefLabel "suspend, cancel, change, or renewal transition" .
cmc:reconciliation a skos:Concept ; skos:prefLabel "provider consequence reconciled" .

cmc:providerAcceptBeforeLocalPersist a skos:Concept ;
  skos:definition "Crash after provider acceptance and before local persistence replays to the same external effect." .
cmc:entitlementBeforeCapabilityGrant a skos:Concept ;
  skos:definition "Failure between entitlement resolution and capability grant does not grant unadmitted capability." .
cmc:meterAcceptBeforeReceiptPersist a skos:Concept ;
  skos:definition "Crash after meter acceptance and before receipt persistence does not double-report billable usage." .
cmc:duplicateOutOfOrderEvents a skos:Concept ;
  skos:definition "Duplicate and out-of-order marketplace events converge without duplicated financial consequence." .
cmc:monetaryAdjustmentAcceptBeforeReceiptPersist a skos:Concept ;
  skos:definition "Crash after a monetary adjustment is accepted and before receipt persistence replays to the same external adjustment." .
cmc:cancellationWithUsageInFlight a skos:Concept ;
  skos:definition "Cancellation racing with usage cannot create post-cancellation unauthorized billing." .
cmc:privateOfferReplacement a skos:Concept ;
  skos:definition "Private-offer replacement preserves one admitted agreement lineage and one billing authority." .
cmc:concurrentAgreements a skos:Concept ;
  skos:definition "Multiple concurrent agreements remain independently identifiable without collapsing commercial state." .
cmc:lateRejectedMetering a skos:Concept ;
  skos:definition "Late or rejected metering produces explicit reconciliation evidence and cannot be silently promoted to billed usage." .

cmc:UNSUPPORTED_MARKETPLACE_PRICING_MODEL a skos:Concept .
cmc:UNSUPPORTED_PRIVATE_OFFER_SEMANTICS a skos:Concept .
cmc:UNSUPPORTED_METERING_GRANULARITY a skos:Concept .
cmc:UNSUPPORTED_IDENTITY_BINDING a skos:Concept .
cmc:UNSUPPORTED_CONTRACT_TRANSITION a skos:Concept .

cmc:definitionOfDone a cmc:MarketplaceCommerceDoD ;
  dcterms:identifier "chatman-marketplace-commerce-dod/v1" ;
  rdfs:comment "ALIVE iff exact-provider execution, canonical subject admission, singular billing authority, BRCE consequence receipt, receipt DAG integrity, replay identity, core failure-boundary evidence, lifecycle closure, and reconciliation are all proven." .
