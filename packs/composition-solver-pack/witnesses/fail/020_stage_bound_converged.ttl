@prefix p: <https://seanchatmangpt.github.io/packs/composition-solver-pack#> .
@prefix ex: <https://example.org/composition-solver-pack/fail/> .

# Requirement derivable but atom not enabled: a further stage would change the graph.
ex:g p:given true ; p:derivable true .
ex:a a p:CapabilityAtom ; p:authorityClass "SELECT" ; p:requires ex:g ; p:provides ex:q .
