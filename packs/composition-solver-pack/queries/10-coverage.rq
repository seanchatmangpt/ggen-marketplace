PREFIX p: <https://seanchatmangpt.github.io/packs/composition-solver-pack#>
SELECT ?reqId ?propId ?status WHERE {
  ?req a p:Requirement ; p:reqId ?reqId ; p:needs ?prop .
  ?prop p:propId ?propId .
  BIND(IF(EXISTS { ?prop p:derivable true }, "COVERED",
       IF(EXISTS { ?a p:provides ?prop ; p:authorityClass "DO" }, "BLOCKED_AUTHORITY", "UNCOVERED")) AS ?status)
}
ORDER BY ?reqId ?propId
