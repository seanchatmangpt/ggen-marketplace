PREFIX p: <https://seanchatmangpt.github.io/packs/composition-solver-pack#>
SELECT DISTINCT ?reqId ?atomId ?pack ?class WHERE {
  ?req a p:Requirement ; p:reqId ?reqId ; p:needs ?prop .
  ?top p:provides ?prop ; p:enabled true .
  ?top (p:requires/^p:provides)* ?a .
  ?a p:enabled true ; p:atomId ?atomId ; p:fromPack ?pack ; p:authorityClass ?class .
}
ORDER BY ?reqId ?atomId
