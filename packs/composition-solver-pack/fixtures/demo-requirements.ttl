@prefix p: <https://seanchatmangpt.github.io/packs/composition-solver-pack#> .
@prefix b: <https://seanchatmangpt.github.io/packs/composition-solver-pack/basis#> .
@prefix r: <https://seanchatmangpt.github.io/packs/composition-solver-pack/demo#> .

# REQ-1: derivable only through the full depth-4 chain (non-vacuity of the stage bound).
r:req1 a p:Requirement ; p:reqId "REQ-1" ; p:needs b:residual-feedback-routed .
# REQ-2: reachable only through a DO atom, so it must stay in the residual as BLOCKED.
r:req2 a p:Requirement ; p:reqId "REQ-2" ; p:needs b:consequence-actuated .
# REQ-3: no atom provides it, so it must stay in the residual as UNCOVERED.
r:req3 a p:Requirement ; p:reqId "REQ-3" ; p:needs r:customer-outcome-observed .
r:customer-outcome-observed a p:Proposition ; p:propId "customer-outcome-observed" .
