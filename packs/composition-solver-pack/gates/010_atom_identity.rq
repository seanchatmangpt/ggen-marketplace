# MESSAGE: capability atom lacks identity, owning pack, or a lawful authority class.
# Every atom needs atomId, fromPack, one provides, and authorityClass in SELECT/CONSTRUCT/DO.
PREFIX p: <https://seanchatmangpt.github.io/packs/composition-solver-pack#>
SELECT ?atom ?field WHERE {
  ?atom a p:CapabilityAtom .
  {
    FILTER NOT EXISTS { ?atom p:atomId ?x }
    BIND("atomId" AS ?field)
  } UNION {
    FILTER NOT EXISTS { ?atom p:fromPack ?x }
    BIND("fromPack" AS ?field)
  } UNION {
    FILTER NOT EXISTS { ?atom p:provides ?x }
    BIND("provides" AS ?field)
  } UNION {
    ?atom p:authorityClass ?c . FILTER(?c NOT IN ("SELECT", "CONSTRUCT", "DO"))
    BIND("authorityClass" AS ?field)
  } UNION {
    FILTER NOT EXISTS { ?atom p:authorityClass ?x }
    BIND("authorityClass" AS ?field)
  }
}
ORDER BY ?atom ?field
