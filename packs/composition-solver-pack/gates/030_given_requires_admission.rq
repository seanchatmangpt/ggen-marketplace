# MESSAGE: a given proposition has no named admitting public source.
# Prose never originates a given. p:given true requires p:admittedFrom.
PREFIX p: <https://seanchatmangpt.github.io/packs/composition-solver-pack#>
SELECT ?prop WHERE {
  ?prop p:given true .
  FILTER NOT EXISTS { ?prop p:admittedFrom ?s }
}
ORDER BY ?prop
