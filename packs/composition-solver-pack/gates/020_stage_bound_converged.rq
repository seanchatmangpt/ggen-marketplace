# MESSAGE: derivation depth exceeds the unrolled stage bound.
# A non-DO atom whose requirements are all derivable but which is not enabled means a
# further stage would still change the graph. The cover is incomplete, so refuse rather
# than report a false residual. See composition-solver-contract.md L1.
PREFIX p: <https://seanchatmangpt.github.io/packs/composition-solver-pack#>
SELECT ?atom WHERE {
  ?atom a p:CapabilityAtom ; p:authorityClass ?c .
  FILTER(?c != "DO")
  FILTER NOT EXISTS { ?atom p:enabled true }
  FILTER NOT EXISTS { ?atom p:requires ?r . FILTER NOT EXISTS { ?r p:derivable true } }
}
ORDER BY ?atom
