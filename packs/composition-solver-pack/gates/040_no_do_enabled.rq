# MESSAGE: authority fence breach: a DO atom was enabled or made derivable.
# DO atoms are never selected; existence of a plan grants no DO authority.
PREFIX p: <https://seanchatmangpt.github.io/packs/composition-solver-pack#>
SELECT ?atom WHERE {
  ?atom a p:CapabilityAtom ; p:authorityClass "DO" ; p:enabled true .
}
ORDER BY ?atom
