@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix p: <https://seanchatmangpt.github.io/packs/composition-solver-pack#> .

# composition-solver-pack vocabulary.
#
# A bounded, stratified cover computation: which propositions are derivable from the
# admitted given propositions by composing capability atoms. SELECT/CONSTRUCT only.
# No DO individual, class or property is declared here; an atom whose authorityClass
# is DO is never selected, only reported as authority-blocked.

p:Proposition a rdfs:Class ;
    rdfs:label "Proposition" ;
    rdfs:comment "A statement that is or becomes true. Identified by propId. Given propositions are admitted from a named public source, never from prose." .

p:CapabilityAtom a rdfs:Class ;
    rdfs:label "Capability atom" ;
    rdfs:comment "A reusable semantic part: provides one proposition, requires zero or more, and names the marketplace pack that owns it." .

p:Requirement a rdfs:Class ;
    rdfs:label "Requirement" ;
    rdfs:comment "A consumer-supplied obligation naming the propositions that must become derivable." .

p:CandidatePlan a rdfs:Class ;
    rdfs:label "Candidate plan" ;
    rdfs:comment "Generated cover result. Standing UNKNOWN, authority NONE. Never an approval and never an execution." .

p:propId a rdf:Property ; rdfs:domain p:Proposition ; rdfs:range xsd:string .
p:given a rdf:Property ; rdfs:domain p:Proposition ; rdfs:range xsd:boolean ;
    rdfs:comment "True only with admittedFrom." .
p:admittedFrom a rdf:Property ; rdfs:domain p:Proposition ; rdfs:range xsd:string ;
    rdfs:comment "Named public source that admits a given proposition." .

p:atomId a rdf:Property ; rdfs:domain p:CapabilityAtom ; rdfs:range xsd:string .
p:fromPack a rdf:Property ; rdfs:domain p:CapabilityAtom ; rdfs:range xsd:string ;
    rdfs:comment "Marketplace pack (or named external boundary) that owns the atom." .
p:provides a rdf:Property ; rdfs:domain p:CapabilityAtom ; rdfs:range p:Proposition .
p:requires a rdf:Property ; rdfs:domain p:CapabilityAtom ; rdfs:range p:Proposition .
p:authorityClass a rdf:Property ; rdfs:domain p:CapabilityAtom ; rdfs:range xsd:string ;
    rdfs:comment "SELECT, CONSTRUCT or DO. DO atoms are never selected." .

p:reqId a rdf:Property ; rdfs:domain p:Requirement ; rdfs:range xsd:string .
p:needs a rdf:Property ; rdfs:domain p:Requirement ; rdfs:range p:Proposition .

# Materialized by [[inference.rules]]; never authored.
p:derivable a rdf:Property ; rdfs:domain p:Proposition ; rdfs:range xsd:boolean ;
    rdfs:comment "Materialized: derivable within the stage bound." .
p:enabled a rdf:Property ; rdfs:domain p:CapabilityAtom ; rdfs:range xsd:boolean ;
    rdfs:comment "Materialized: every requirement of a non-DO atom is derivable." .
