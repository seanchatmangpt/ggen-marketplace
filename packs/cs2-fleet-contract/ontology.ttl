@prefix cs2: <https://chatman.ai/cs2#> .
@prefix pack: <https://chatman.ai/cs2/pack#> .

pack:cs2-fleet-contract a pack:FleetContractPack ;
  pack:subject cs2:RFC-CS2-001 ;
  pack:contractSchema <https://chatman.ai/cs2/fleet-contract/v1> ;
  pack:producerRepository "seanchatmangpt/ggen" ;
  pack:producerFamily "examples/cs2-projections" ;
  pack:binding pack:marketplace, pack:ash-a2a, pack:xaas .

pack:marketplace a pack:ConsumerBinding ;
  pack:consumer cs2:ggen-marketplace ;
  pack:workId "CS2-WRK-003" ;
  pack:targetRepository "seanchatmangpt/ggen-marketplace" ;
  pack:targetPath "packs/cs2-fleet-contract/generated/fleet-contract.json" .

pack:ash-a2a a pack:ConsumerBinding ;
  pack:consumer cs2:ash-a2a ;
  pack:workId "CS2-WRK-012" ;
  pack:targetRepository "seanchatmangpt/ash_a2a" ;
  pack:targetPath "lib/ash_a2a/cs2/generated_fleet_contract.ex" .

pack:xaas a pack:ConsumerBinding ;
  pack:consumer cs2:xaas ;
  pack:workId "CS2-WRK-013" ;
  pack:targetRepository "seanchatmangpt/xaas" ;
  pack:targetPath "lib/xaas/cs2/generated_fleet_contract.ex" .
