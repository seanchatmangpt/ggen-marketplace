PREFIX pack: <https://chatman.ai/cs2/pack#>

SELECT ?subject ?schema ?consumer ?work_id ?repository ?target
WHERE {
  pack:cs2-fleet-contract
    pack:subject ?subject ;
    pack:contractSchema ?schema ;
    pack:binding ?binding .

  ?binding
    pack:consumer ?consumer ;
    pack:workId ?work_id ;
    pack:targetRepository ?repository ;
    pack:targetPath ?target .
}
ORDER BY STR(?repository) STR(?target)
