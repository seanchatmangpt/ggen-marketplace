{
  "schema": "https://chatman.ai/cs2/fleet-contract/v1",
  "bindings": [
{% for row in sparql_results %}
    {
      "subject": "{{ row["subject"] }}",
      "contract_schema": "{{ row["schema"] }}",
      "consumer": "{{ row["consumer"] }}",
      "work_id": "{{ row["work_id"] }}",
      "repository": "{{ row["repository"] }}",
      "target": "{{ row["target"] }}"
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}
