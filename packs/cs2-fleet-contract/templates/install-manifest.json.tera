{
  "schema": "https://chatman.ai/cs2/fleet-install/v1",
  "artifacts": [
{% for row in sparql_results %}
    {
      "subject": "{{ row["subject"] }}",
      "work_id": "{{ row["work_id"] }}",
      "repository": "{{ row["repository"] }}",
      "target": "{{ row["target"] }}",
      "source_contract": "generated/fleet-contract.json",
      "replace_local_semantics": true
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}
