{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatman.ai/cs2/fleet-contract/v1",
  "type": "object",
  "required": ["contract_schema", "consumers"],
  "properties": {
    "contract_schema": {"const": "https://chatman.ai/cs2/fleet-contract/v1"},
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "authority_ceiling", "consumer", "work_id", "target_repository", "target_path", "contract_version"],
        "properties": {
          "subject": {"const": "https://chatman.ai/cs2#RFC-CS2-001"},
          "authority_ceiling": {"const": "CONSTRUCT"},
          "consumer": {"type": "string"},
          "work_id": {"type": "string"},
          "target_repository": {"type": "string"},
          "target_path": {"type": "string"},
          "contract_version": {"const": "v1"}
        }
      }
    }
  }
}
