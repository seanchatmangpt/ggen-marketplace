@prefix cs2: <https://chatman.ai/cs2#> .
@prefix pack: <https://chatman.ai/ggen-marketplace/cs2-fleet-contract#> .

pack:CS2FleetContract a pack:Pack ;
  pack:subject cs2:RFC-CS2-001 ;
  pack:producer "seanchatmangpt/ggen" ;
  pack:consumer pack:Marketplace, pack:AshA2A, pack:XaaS .

pack:Marketplace pack:repository "seanchatmangpt/ggen-marketplace" ;
  pack:workId "CS2-WRK-003" ;
  pack:projection "pack" .

pack:AshA2A pack:repository "seanchatmangpt/ash_a2a" ;
  pack:workId "CS2-WRK-012" ;
  pack:projection "evidence_triage" .

pack:XaaS pack:repository "seanchatmangpt/xaas" ;
  pack:workId "CS2-WRK-013" ;
  pack:projection "engineer_workflow" .
