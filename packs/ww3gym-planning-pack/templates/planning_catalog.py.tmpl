---
to: "src/ww3gym/generated_catalog.py"
force: true
sparql:
  phases: |
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?notation ?label WHERE { ?item a skos:Concept ; skos:inScheme <urn:ww3gym:scheme-phase> ; skos:notation ?notation ; skos:prefLabel ?label . } ORDER BY ?notation
  domains: |
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?notation ?label WHERE { ?item a skos:Concept ; skos:inScheme <urn:ww3gym:scheme-domain> ; skos:notation ?notation ; skos:prefLabel ?label . } ORDER BY ?notation
  profiles: |
    PREFIX prov: <http://www.w3.org/ns/prov#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?notation ?label ?source WHERE { ?item a skos:Concept ; skos:inScheme <urn:ww3gym:scheme-profile-2030> ; skos:notation ?notation ; skos:prefLabel ?label ; prov:hadPrimarySource ?source . } ORDER BY ?notation ?source
  baselines: |
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?notation ?label WHERE { ?item a skos:Concept ; skos:inScheme <urn:ww3gym:scheme-resilience-baseline> ; skos:notation ?notation ; skos:prefLabel ?label . } ORDER BY ?notation
  capabilities: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?notation ?label ?iri ?phase WHERE { ?cap a sosa:Procedure ; skos:notation ?notation ; skos:prefLabel ?label ; dct:identifier ?iri ; dct:type ?phase ; dct:conformsTo <urn:ww3gym:policy-safe-scope> . } ORDER BY ?notation
---
"""Generated by ggen from ww3gym-planning-pack. Do not hand edit."""

PHASES = (
{% for row in phases -%}
    ("{{ row.notation }}", "{{ row.label }}"),
{% endfor -%}
)

DOMAINS = (
{% for row in domains -%}
    ("{{ row.notation }}", "{{ row.label }}"),
{% endfor -%}
)

PROFILES_2030 = (
{% for row in profiles -%}
    ("{{ row.notation }}", "{{ row.label }}", "{{ row.source }}"),
{% endfor -%}
)

RESILIENCE_BASELINES = (
{% for row in baselines -%}
    ("{{ row.notation }}", "{{ row.label }}"),
{% endfor -%}
)

CAPABILITIES = (
{% for row in capabilities -%}
    ("{{ row.notation }}", "{{ row.label }}", "{{ row.iri }}", "{{ row.phase }}"),
{% endfor -%}
)
