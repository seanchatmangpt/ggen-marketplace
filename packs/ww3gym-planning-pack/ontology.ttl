@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix w3: <urn:ww3gym:> .

# Public sources are provenance anchors for classification only.
w3:source-ndpp a dct:BibliographicResource ;
  dct:title "NATO Defence Planning Process — public topic page" ;
  dct:identifier "https://www.nato.int/en/what-we-do/introduction-to-nato/nato-defence-planning-process" .

w3:source-human-interoperability a dct:BibliographicResource ;
  dct:title "NATO ACT — Interoperability Starts with People" ;
  dct:identifier "https://www.act.nato.int/article/interoperability-starts-with-people/" .

w3:source-cax a dct:BibliographicResource ;
  dct:title "NCI Agency — Simulation and computer-assisted exercises" ;
  dct:identifier "https://www.ncia.nato.int/about-us/newsroom/simulation-and-computerassisted-exercises" .

w3:scheme-phase a skos:ConceptScheme ; dct:title "ww3gym planning phases" .
w3:phase-political-guidance a skos:Concept ; skos:inScheme w3:scheme-phase ; skos:notation "1" ; skos:prefLabel "Political guidance" ; prov:hadPrimarySource w3:source-ndpp .
w3:phase-determine-requirements a skos:Concept ; skos:inScheme w3:scheme-phase ; skos:notation "2" ; skos:prefLabel "Determine requirements" ; prov:hadPrimarySource w3:source-ndpp .
w3:phase-apportion-targets a skos:Concept ; skos:inScheme w3:scheme-phase ; skos:notation "3" ; skos:prefLabel "Apportion capability targets" ; prov:hadPrimarySource w3:source-ndpp .
w3:phase-facilitate-implementation a skos:Concept ; skos:inScheme w3:scheme-phase ; skos:notation "4" ; skos:prefLabel "Facilitate implementation" ; prov:hadPrimarySource w3:source-ndpp .
w3:phase-review-results a skos:Concept ; skos:inScheme w3:scheme-phase ; skos:notation "5" ; skos:prefLabel "Review results" ; prov:hadPrimarySource w3:source-ndpp .

w3:scheme-domain a skos:ConceptScheme ; dct:title "ww3gym admitted non-kinetic planning domains" .
w3:domain-civil-preparedness a skos:Concept ; skos:inScheme w3:scheme-domain ; skos:notation "civil_preparedness" ; skos:prefLabel "Civil preparedness" ; prov:hadPrimarySource w3:source-ndpp .
w3:domain-consultation-c2 a skos:Concept ; skos:inScheme w3:scheme-domain ; skos:notation "consultation_c2" ; skos:prefLabel "Consultation and C2 interoperability" ; prov:hadPrimarySource w3:source-ndpp .
w3:domain-cyber-defence a skos:Concept ; skos:inScheme w3:scheme-domain ; skos:notation "cyber_defence" ; skos:prefLabel "Cyber defence and resilience" ; prov:hadPrimarySource w3:source-ndpp .
w3:domain-logistics a skos:Concept ; skos:inScheme w3:scheme-domain ; skos:notation "logistics" ; skos:prefLabel "Logistics" ; prov:hadPrimarySource w3:source-ndpp .
w3:domain-medical a skos:Concept ; skos:inScheme w3:scheme-domain ; skos:notation "medical" ; skos:prefLabel "Medical" ; prov:hadPrimarySource w3:source-ndpp .
w3:domain-resources a skos:Concept ; skos:inScheme w3:scheme-domain ; skos:notation "resources" ; skos:prefLabel "Resources" ; prov:hadPrimarySource w3:source-ndpp .
w3:domain-science-technology a skos:Concept ; skos:inScheme w3:scheme-domain ; skos:notation "science_technology" ; skos:prefLabel "Science and technology" ; prov:hadPrimarySource w3:source-ndpp .
w3:domain-standardization a skos:Concept ; skos:inScheme w3:scheme-domain ; skos:notation "standardization_interoperability" ; skos:prefLabel "Standardization and interoperability" ; prov:hadPrimarySource w3:source-ndpp .

w3:scheme-action a skos:ConceptScheme ; dct:title "ww3gym admitted actions" .

# Each procedure is an abstract tabletop planning capability, never a grant of authority.
w3:cap-propose-requirement a sosa:Procedure, skos:Concept ;
  skos:inScheme w3:scheme-action ; skos:notation "propose_requirement" ; skos:prefLabel "Propose capability requirement" ;
  dct:type w3:phase-determine-requirements ; dct:conformsTo w3:policy-safe-scope ; dct:identifier "urn:ww3gym:capability:propose_requirement" ;
  dct:relation "DO" ; prov:hadPrimarySource w3:source-ndpp .

w3:cap-allocate-capacity a sosa:Procedure, skos:Concept ;
  skos:inScheme w3:scheme-action ; skos:notation "allocate_capacity" ; skos:prefLabel "Allocate abstract capacity" ;
  dct:type w3:phase-apportion-targets ; dct:conformsTo w3:policy-safe-scope ; dct:identifier "urn:ww3gym:capability:allocate_capacity" ;
  dct:relation "DO" ; prov:hadPrimarySource w3:source-ndpp .

w3:cap-record-consensus a sosa:Procedure, skos:Concept ;
  skos:inScheme w3:scheme-action ; skos:notation "record_consensus" ; skos:prefLabel "Record exercise consensus" ;
  dct:type w3:phase-political-guidance ; dct:conformsTo w3:policy-safe-scope ; dct:identifier "urn:ww3gym:capability:record_consensus" ;
  dct:relation "DO" ; prov:hadPrimarySource w3:source-human-interoperability .

w3:cap-inject-resilience-stressor a sosa:Procedure, skos:Concept ;
  skos:inScheme w3:scheme-action ; skos:notation "inject_resilience_stressor" ; skos:prefLabel "Inject synthetic resilience stressor" ;
  dct:type w3:phase-facilitate-implementation ; dct:conformsTo w3:policy-safe-scope ; dct:identifier "urn:ww3gym:capability:inject_resilience_stressor" ;
  dct:relation "DO" ; prov:hadPrimarySource w3:source-cax .

w3:cap-review-readiness a sosa:Procedure, skos:Concept ;
  skos:inScheme w3:scheme-action ; skos:notation "review_readiness" ; skos:prefLabel "Review readiness" ;
  dct:type w3:phase-review-results ; dct:conformsTo w3:policy-safe-scope ; dct:identifier "urn:ww3gym:capability:review_readiness" ;
  dct:relation "DO" ; prov:hadPrimarySource w3:source-ndpp .

w3:policy-safe-scope a odrl:Policy ;
  dct:title "Synthetic capability-planning only" ;
  rdfs:comment "Refuses real-world targeting, coordinates, weapons/munitions employment, strike sequencing, attack routes, fire missions, kill chains, weaponeering, and battle-damage assessment." .

# Projection oracle: every capability must carry the facts the ggen template consumes.
w3:CatalogCapabilityShape a sh:NodeShape ;
  sh:targetClass sosa:Procedure ;
  sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path dct:type ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path dct:conformsTo ; sh:hasValue w3:policy-safe-scope ] .

# Chatman ecosystem composition anchors. These are provenance/alignment facts,
# not executable dependencies and not grants of authority.
w3:ecosystem-gymact a dct:BibliographicResource ;
  dct:title "GymAct semantic actuation boundary" ;
  dct:identifier "https://github.com/seanchatmangpt/gymact" .

w3:ecosystem-autofde a dct:BibliographicResource ;
  dct:title "AutoFDE Lab planner registry and DfCM exploration surface" ;
  dct:identifier "https://github.com/seanchatmangpt/autofde-lab" .

w3:ecosystem-wasm4pm a dct:BibliographicResource ;
  dct:title "wasm4pm-compatible process-mining receipt projection" ;
  dct:identifier "urn:ww3gym:integration:wasm4pm-compatible-ocel" .

w3:scheme-planner-role a skos:ConceptScheme ; dct:title "ww3gym non-actuating planner roles" .
w3:role-capability-planner a skos:Concept ; skos:inScheme w3:scheme-planner-role ; skos:notation "capability_planner" ; skos:prefLabel "Capability planner" .
w3:role-coalition-coordinator a skos:Concept ; skos:inScheme w3:scheme-planner-role ; skos:notation "coalition_coordinator" ; skos:prefLabel "Coalition coordinator" .
w3:role-resilience-falsifier a skos:Concept ; skos:inScheme w3:scheme-planner-role ; skos:notation "resilience_falsifier" ; skos:prefLabel "Resilience falsifier" .
w3:role-readiness-reviewer a skos:Concept ; skos:inScheme w3:scheme-planner-role ; skos:notation "readiness_reviewer" ; skos:prefLabel "Readiness reviewer" .

w3:scheme-dfcm-dimension a skos:ConceptScheme ; dct:title "AutoFDE-aligned DfCM decision dimensions" .
w3:dfcm-model a skos:Concept ; skos:inScheme w3:scheme-dfcm-dimension ; skos:notation "model" ; skos:prefLabel "Model" .
w3:dfcm-planner a skos:Concept ; skos:inScheme w3:scheme-dfcm-dimension ; skos:notation "planner" ; skos:prefLabel "Planner" .
w3:dfcm-tool-policy a skos:Concept ; skos:inScheme w3:scheme-dfcm-dimension ; skos:notation "tool_policy" ; skos:prefLabel "Tool policy" .
w3:dfcm-repair-policy a skos:Concept ; skos:inScheme w3:scheme-dfcm-dimension ; skos:notation "repair_policy" ; skos:prefLabel "Repair policy" .
w3:dfcm-replanning-policy a skos:Concept ; skos:inScheme w3:scheme-dfcm-dimension ; skos:notation "replanning_policy" ; skos:prefLabel "Replanning policy" .
w3:dfcm-verification-policy a skos:Concept ; skos:inScheme w3:scheme-dfcm-dimension ; skos:notation "verification_policy" ; skos:prefLabel "Verification policy" .
w3:dfcm-projection-policy a skos:Concept ; skos:inScheme w3:scheme-dfcm-dimension ; skos:notation "projection_policy" ; skos:prefLabel "Projection policy" .
w3:dfcm-memory-policy a skos:Concept ; skos:inScheme w3:scheme-dfcm-dimension ; skos:notation "memory_policy" ; skos:prefLabel "Memory policy" .
w3:dfcm-budget a skos:Concept ; skos:inScheme w3:scheme-dfcm-dimension ; skos:notation "budget" ; skos:prefLabel "Budget" .
