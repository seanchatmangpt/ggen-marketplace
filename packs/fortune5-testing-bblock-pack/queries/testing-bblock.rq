PREFIX tb: <https://ggen.io/ontology/testing-bblock#>

SELECT ?version ?consumerRootMarker ?consumerBinaryCommand ?consumerTestCommand
       ?consumerForbiddenTokenFiles ?consumerForbiddenTokens
WHERE {
  tb:TestingBBlock tb:version ?version .
  OPTIONAL { tb:TestingBBlock tb:consumerRootMarker ?consumerRootMarker . }
  OPTIONAL { tb:TestingBBlock tb:consumerBinaryCommand ?consumerBinaryCommand . }
  OPTIONAL { tb:TestingBBlock tb:consumerTestCommand ?consumerTestCommand . }
  OPTIONAL { tb:TestingBBlock tb:consumerForbiddenTokenFiles ?consumerForbiddenTokenFiles . }
  OPTIONAL { tb:TestingBBlock tb:consumerForbiddenTokens ?consumerForbiddenTokens . }
}
ORDER BY ?version
LIMIT 1
