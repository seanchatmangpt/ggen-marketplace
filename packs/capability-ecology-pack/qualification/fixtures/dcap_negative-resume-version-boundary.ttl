# FIRES gates/dcap_050_resume_across_version_without_requalification.rq (and nothing else):
# a resume that CROSSES a projection-version boundary yet claims outcome "ALIVE" —
# the silent continue. Neither lawful ending is present: no typed
# REFUSED_VERSION_BOUNDARY, no REQUALIFIED receipt. The workflow has no HaltClaim,
# so gate 060 stays clean.
@prefix dcap: <https://ggen.dev/ontology/durability-capability#> .

dcap:wf-crossed a dcap:WorkflowSubject ;
    dcap:workflowIdentity "urn:wf:demo:crossed" ;
    dcap:projectionVersion "v26.9.30" .

dcap:rc-crossed-alive a dcap:ResumeClaim ;
    dcap:resumesWorkflow dcap:wf-crossed ;
    dcap:versionBoundaryCrossed true ;
    dcap:resumeOutcome "ALIVE" .
