# FIRES gates/pcap_020_realization_requires_qualification.rq (only).
# A realization with provider metadata but NO qualificationCondition can
# never be refused, which makes qualification vacuous.
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcap:f-neg-unqualified a pcap:CapabilityRealization ;
    rdfs:label "Unqualified fixture realization" ;
    pcap:realizes pcap:cap-signal ;
    pcap:providerRepo "https://example.test/fixture" ;
    pcap:bindingModule "Fixture.Unqualified.*" ;
    pcap:evidenceReference "none claimed" ;
    qce:admitted false .
# Deliberately missing: pcap:qualificationCondition.
