# NEGATIVE fixture: fires gate ocap_040_observation_requires_evidence shape A.
# A tap realization of Observation.Tap with qualification conditions but NO
# evidence requirement: a tap that cannot show what it saw is a rumor
# generator. REFUSED.
@prefix ocap: <https://ggen.dev/ontology/observation-capability#> .

ocap:realization-blind-tap a ocap:Realization ;
    ocap:realizes ocap:observation-tap ;
    ocap:providerRepo "example-blind" ;
    ocap:providerModule "tap that claims occurrences but records nothing" ;
    ocap:versionPinPolicy "none" ;
    ocap:providerAvailable true ;
    ocap:qualificationCondition ocap:qc-tap-env-gated .
