# NEGATIVE fixture for gates/ecap_010_pinned_capability_identity.rq (fires it).
# ex:fake claims the pinned identifier "Receipt.Sign" without the ecap:Capability
# type; ex:twin duplicates the pinned identifier "Evidence.Establish" across a
# second capability individual. Both are resolution-breaking identity violations.
@prefix ecap: <https://ggen.dev/ontology/evidence-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/ecap/> .

ex:fake dcterms:identifier "Receipt.Sign" .

ex:twin a ecap:Capability ;
    dcterms:identifier "Evidence.Establish" .
