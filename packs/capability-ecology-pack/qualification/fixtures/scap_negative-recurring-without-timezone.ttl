# FIRES gates/scap_060_recurring_requires_timezone_anchoring.rq (only,
# capability branch). A recurring capability with NO timezoneAnchoring:
# wall-clock calendar semantics are exactly what breaks silently across DST
# boundaries.
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

scap:f-neg-nightly a scap:Capability ;
    dcterms:identifier "Schedule.Nightly" ;
    rdfs:label "Schedule.Nightly" ;
    skos:prefLabel "Fire a target on nightly occurrences" ;
    scap:capabilityFamily "scheduling-calendar" ;
    scap:consequence "DO" ;
    scap:temporalKind "recurring" ;
    scap:missedFirePolicy "catch_up" ;
    scap:inputContract "target + nightly pattern" ;
    scap:outputContract "one firing per nightly occurrence in the (undeclared!) anchor" ;
    scap:precondition "target consequential actuation only with bound authority" ;
    scap:postcondition "occurrences fired nightly" ;
    scap:authorityRequirement "Requires an authority envelope binding the scheduled target's consequence scope." ;
    scap:evidenceRequirement "earl: assertion from observed execution on the exact subject: nightly firings observed" ;
    scap:outcome scap:f-neg-nightly-ok .
# Deliberately missing: scap:timezoneAnchoring.

scap:f-neg-nightly-ok a scap:Outcome ;
    skos:prefLabel "success:nightly-occurrence-fired" ;
    scap:outcomeKind "success" .

scap:real-oban scap:realizes scap:f-neg-nightly .
