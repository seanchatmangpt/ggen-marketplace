# NEGATIVE fixture for gates/authcap_050_actuation_without_envelope.rq (fires it).
# A consequential capability with a complete contract (including a first-class
# REFUSED_NO_AUTHORITY outcome and an authorizing capability) that declares NO
# authority envelope precondition: a consequential act claiming authority is
# not even required — ProviderAvailable != Authorized violated at the contract
# level.
@prefix authcap: <https://ggen.dev/ontology/authority-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/authcap/> .

ex:cap a authcap:Capability, authcap:ConsequentialCapability ;
    dcterms:identifier "Actuation.Audit" ;
    authcap:capabilityFamily "authority" ;
    authcap:input "admitted audit work order" ;
    authcap:output "sealed audit receipt" ;
    authcap:outcome ex:o-refused ;
    authcap:authorityCeiling "observe" ;
    authcap:authorizingCapability ex:verifier ;
    authcap:realization ex:r .

ex:verifier a authcap:Capability ;
    dcterms:identifier "Authority.Audit" ;
    authcap:capabilityFamily "authority" ;
    authcap:input "envelope material" ;
    authcap:output "verification verdict" ;
    authcap:outcome ex:o-ok ;
    authcap:authorityCeiling "observe" ;
    authcap:realization ex:r2 .

ex:o-refused a authcap:Outcome ;
    authcap:outcomeKind "refusal" ;
    authcap:refusalCode "REFUSED_NO_AUTHORITY" .
ex:o-ok a authcap:Outcome ;
    authcap:outcomeKind "success" .

ex:r a authcap:Realization ;
    dcterms:identifier "audit-do" ;
    authcap:authorityCeiling "observe" ;
    authcap:providerRepo "somewhere" ;
    authcap:bindingModule "Somewhere.AuditDo" ;
    authcap:sourceFile "lib/somewhere/audit_do.ex" ;
    authcap:versionPinPolicy "pin by release tag" ;
    authcap:qualificationCondition "audit-only consequence" .
ex:r2 a authcap:Realization ;
    dcterms:identifier "audit-verify" ;
    authcap:authorityCeiling "observe" ;
    authcap:providerRepo "somewhere" ;
    authcap:bindingModule "Somewhere.AuditVerify" ;
    authcap:sourceFile "lib/somewhere/audit_verify.ex" ;
    authcap:versionPinPolicy "pin by release tag" ;
    authcap:qualificationCondition "presentation check only" .
