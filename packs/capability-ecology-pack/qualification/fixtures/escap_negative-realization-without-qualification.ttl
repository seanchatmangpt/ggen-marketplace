# NEGATIVE fixture: fires gate escap_020_realization_requires_qualification.
# A realization offered for Event.Emit with provider metadata but NO
# qualification condition: an unqualified offer is a hope, not a contract.
@prefix escap: <https://ggen.dev/ontology/event-state-capability#> .

escap:realization-unqualified-emit a escap:Realization ;
    escap:realizes escap:event-emit ;
    escap:providerRepo "example-unqualified" ;
    escap:providerModule "emit offer with no stated qualification conditions" ;
    escap:versionPinPolicy "none" ;
    escap:providerAvailable true ;
    escap:evidenceRequirement "emit receipt" .
