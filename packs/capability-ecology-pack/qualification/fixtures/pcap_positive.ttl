# Positive fixture: one additional fully-lawful capability + realization
# binding, proving the gate set stays clean under lawful composition (a
# gate that passed on an empty patch would be vacuous).
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcap:f-pos-demonitor a pcap:Capability ;
    dcterms:identifier "Process.Demonitor" ;
    rdfs:label "Process.Demonitor" ;
    skos:prefLabel "Remove an existing monitor (real OTP primitive demonitor/1)" ;
    pcap:capabilityFamily "process-monitoring" ;
    pcap:consequence "READ" ;
    pcap:inputContract "monitor reference from a prior Process.Monitor" ;
    pcap:outputContract "monitor disabled; no further :DOWN delivery for that reference" ;
    pcap:precondition "monitoring process alive; reference belongs to the caller" ;
    pcap:postcondition ":DOWN for the reference never delivered (or already flushed by option)" ;
    pcap:evidenceRequirement "earl: assertion from observed execution on the exact subject: target termination after demonitor observed NOT to deliver :DOWN" ;
    pcap:executionProperty "isolation: observation-only; no failure coupling" ;
    pcap:outcome pcap:f-pos-demonitor-ok .

pcap:f-pos-demonitor-ok a pcap:Outcome ;
    skos:prefLabel "success:demonitored" ;
    pcap:outcomeKind "success" .

pcap:real-otp-stdlib pcap:realizes pcap:f-pos-demonitor .
