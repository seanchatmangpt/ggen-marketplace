# FIRES gates/scap_010_capability_requires_realization.rq (only).
# A lawful-in-every-other-respect capability left without any provider
# binding: unresolvable, therefore refused.
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

scap:f-neg-window a scap:Capability ;
    dcterms:identifier "Schedule.Window" ;
    rdfs:label "Schedule.Window" ;
    skos:prefLabel "Fire a target only within an allowed time window" ;
    scap:capabilityFamily "scheduling-instant" ;
    scap:consequence "DO" ;
    scap:temporalKind "one-shot" ;
    scap:timezoneAnchoring "utc" ;
    scap:missedFirePolicy "skip" ;
    scap:inputContract "target + anchor instant + allowed window bounds" ;
    scap:outputContract "one firing inside the window, or the policy-declared missed outcome" ;
    scap:precondition "window bounds ordered; anchor resolvable as UTC instant" ;
    scap:postcondition "firing occurred within the window or the window lapsed per policy" ;
    scap:authorityRequirement "Requires an authority envelope binding the scheduled target's consequence scope." ;
    scap:evidenceRequirement "earl: assertion from observed execution on the exact subject: firing observed with an in-window timestamp" ;
    scap:outcome scap:f-neg-window-ok .
# Deliberately: no realization realizes scap:f-neg-window.

scap:f-neg-window-ok a scap:Outcome ;
    skos:prefLabel "success:in-window-firing" ;
    scap:outcomeKind "success" .
