# POSITIVE fixture: clean complement to ontology.ttl. Adds a COMPLETE
# five-field receipt claim (identity / authority / consequence / replay /
# standing over a reused qce:QualificationReceipt), a subject-bound evidence
# claim, and qce qualification + replay receipts qualifying each admitted
# realization. Evaluated together with ontology.ttl, every gate in gates/
# MUST return zero rows (verify.py refuses otherwise).
@prefix ecap: <https://ggen.dev/ontology/evidence-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix aps: <https://w3id.org/chatman/aps#> .
@prefix ex: <https://example.test/ecap/> .

ex:claim a ecap:ReceiptClaim ;
    ecap:assertsReceipt ex:receipt .

ex:receipt a qce:QualificationReceipt ;
    dcterms:identifier "qual-1" ;
    qce:subjectCommit "0123456789abcdef0123456789abcdef01234567" ;
    qce:authorityDigest "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
    qce:consequenceDigest "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
    qce:replayReceipt ex:replay ;
    ecap:standing aps:PARTIAL_ALIVE .

ex:replay a qce:ReplayReceipt ;
    qce:replayDigest "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" ;
    qce:replayVerified true .

ex:ev a ecap:EvidenceClaim ;
    ecap:subjectDigest "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" ;
    ecap:standing aps:PARTIAL_ALIVE .

ex:qual-verify a qce:QualificationReceipt ;
    qce:qualifies ecap:realization-affidavit-verify ;
    qce:qualificationDigest "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-1 .

ex:replay-1 a qce:ReplayReceipt ;
    qce:replayDigest "1111111111111111111111111111111111111111111111111111111111111111" ;
    qce:replayVerified true .

ex:qual-certify a qce:QualificationReceipt ;
    qce:qualifies ecap:realization-affidavit-certify-authzen ;
    qce:qualificationDigest "2222222222222222222222222222222222222222222222222222222222222222" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-2 .

ex:replay-2 a qce:ReplayReceipt ;
    qce:replayDigest "3333333333333333333333333333333333333333333333333333333333333333" ;
    qce:replayVerified true .

ex:qual-bind a qce:QualificationReceipt ;
    qce:qualifies ecap:realization-graphlaw-evidence ;
    qce:qualificationDigest "4444444444444444444444444444444444444444444444444444444444444444" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-3 .

ex:replay-3 a qce:ReplayReceipt ;
    qce:replayDigest "5555555555555555555555555555555555555555555555555555555555555555" ;
    qce:replayVerified true .

ex:qual-assemble a qce:QualificationReceipt ;
    qce:qualifies ecap:realization-affidavit-assemble ;
    qce:qualificationDigest "6666666666666666666666666666666666666666666666666666666666666666" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-4 .

ex:replay-4 a qce:ReplayReceipt ;
    qce:replayDigest "7777777777777777777777777777777777777777777777777777777777777777" ;
    qce:replayVerified true .

ex:qual-siginput a qce:QualificationReceipt ;
    qce:qualifies ecap:realization-affidavit-signature-input ;
    qce:qualificationDigest "8888888888888888888888888888888888888888888888888888888888888888" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-5 .

ex:replay-5 a qce:ReplayReceipt ;
    qce:replayDigest "9999999999999999999999999999999999999999999999999999999999999999" ;
    qce:replayVerified true .

ex:qual-greceipt a qce:QualificationReceipt ;
    qce:qualifies ecap:realization-graphlaw-receipt ;
    qce:qualificationDigest "aaaa111111111111111111111111111111111111111111111111111111111111" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-6 .

ex:replay-6 a qce:ReplayReceipt ;
    qce:replayDigest "bbbb222222222222222222222222222222222222222222222222222222222222" ;
    qce:replayVerified true .

ex:qual-commit a qce:QualificationReceipt ;
    qce:qualifies ecap:realization-affidavit-commit ;
    qce:qualificationDigest "cccc333333333333333333333333333333333333333333333333333333333333" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-7 .

ex:replay-7 a qce:ReplayReceipt ;
    qce:replayDigest "dddd444444444444444444444444444444444444444444444444444444444444" ;
    qce:replayVerified true .

ex:qual-standing a qce:QualificationReceipt ;
    qce:qualifies ecap:realization-graphlaw-standing ;
    qce:qualificationDigest "eeee555555555555555555555555555555555555555555555555555555555555" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-8 .

ex:replay-8 a qce:ReplayReceipt ;
    qce:replayDigest "ffff666666666666666666666666666666666666666666666666666666666666" ;
    qce:replayVerified true .
