# FIRES gates/dcap_030_checkpoint_without_subject_digest.rq (and nothing else):
# a checkpoint with an identity and a bound subject but NO qce:closureDigest —
# the state digest that would pin it to its workflow subject's exact state.
# Content identity is unproven; the checkpoint claims a binding it cannot witness.
@prefix dcap:    <https://ggen.dev/ontology/durability-capability#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

dcap:wf-digestless a dcap:WorkflowSubject ;
    dcap:workflowIdentity "urn:wf:demo:digestless" ;
    dcap:projectionVersion "v26.9.30" .

dcap:cp-digestless a dcap:Checkpoint ;
    dcap:checkpointIdentity "urn:gall:checkpoint:demo:digestless-ep-1" ;
    dcap:boundSubject dcap:wf-digestless ;
    dcap:baseSha "3333333333333333333333333333333333333333" ;
    dcap:capturedProjectionVersion "v26.9.30" .
