# NEGATIVE fixture: fires gate ocap_040_observation_requires_evidence shape B.
# A realization of Observation.Sample that explicitly declares
# ocap:evidenceCapable false: a tap that cannot produce evidence must be
# REFUSED outright, not tolerated with a promise to try.
@prefix ocap: <https://ggen.dev/ontology/observation-capability#> .

ocap:realization-incapable-sample a ocap:Realization ;
    ocap:realizes ocap:observation-sample ;
    ocap:providerRepo "example-incapable" ;
    ocap:providerModule "sampler explicitly incapable of producing evidence" ;
    ocap:versionPinPolicy "none" ;
    ocap:providerAvailable true ;
    ocap:qualificationCondition ocap:qc-poller-measures-declared ;
    ocap:evidenceRequirement "none possible: this sampler cannot persist records" ;
    ocap:evidenceCapable false .
