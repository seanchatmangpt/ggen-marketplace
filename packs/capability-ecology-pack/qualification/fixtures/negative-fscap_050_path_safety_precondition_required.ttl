# FIRES ONLY gates/fscap_050_path_safety_precondition_required.rq:
# File.Stat carries an 'authority'-kind precondition instead of the required
# 'path-safety' kind, so a resolver could admit it against a path outside the
# workspace root (path-traversal falsifier).
@prefix fscap:   <https://ggen.dev/ontology/filesystem-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

fscap:neg-unsafe-paths a fscap:Capability ;
    dcterms:identifier "File.Stat" ;
    fscap:consequenceClass "READ" ;
    fscap:input "path" ;
    fscap:output "file-info" ;
    fscap:hasPrecondition fscap:neg-precondition-authority-only ;
    fscap:hasOutcome fscap:outcome-success, fscap:failure-enoent, fscap:failure-eacces ;
    fscap:requiresEvidence "earl:request-receipt" ;
    fscap:requiresAuthority false ;
    fscap:idempotent true ;
    fscap:realizedBy fscap:neg-unsafe-realization .

fscap:neg-precondition-authority-only a fscap:Precondition ;
    fscap:preconditionKind "authority" ;
    fscap:statement "fixture: authority precondition present, path-safety precondition absent" .

fscap:neg-unsafe-realization a fscap:Realization ;
    dcterms:identifier "fixture.stat-step-unsafe-paths" ;
    fscap:qualificationCondition "fixture-scoped provider pinned by consumer lock" .
