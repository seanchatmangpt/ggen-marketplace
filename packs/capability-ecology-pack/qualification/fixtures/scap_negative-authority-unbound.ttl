# FIRES gates/scap_040_consequential_requires_authority.rq (only).
# A consequence-DO scheduling capability with NO authorityRequirement:
# launders actuation through time; ProviderAvailable != Authorized.
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

scap:f-neg-reminder a scap:Capability ;
    dcterms:identifier "Schedule.Reminder" ;
    rdfs:label "Schedule.Reminder" ;
    skos:prefLabel "Fire a reminder target once at an instant" ;
    scap:capabilityFamily "scheduling-instant" ;
    scap:consequence "DO" ;
    scap:temporalKind "one-shot" ;
    scap:timezoneAnchoring "utc" ;
    scap:missedFirePolicy "skip" ;
    scap:inputContract "target + anchor instant" ;
    scap:outputContract "one firing at/after the anchor" ;
    scap:precondition "anchor resolvable as UTC instant" ;
    scap:postcondition "target fired once" ;
    scap:evidenceRequirement "earl: assertion from observed execution on the exact subject: firing observed at/after the anchor" ;
    scap:outcome scap:f-neg-reminder-ok .
# Deliberately missing: scap:authorityRequirement.

scap:f-neg-reminder-ok a scap:Outcome ;
    skos:prefLabel "success:fired" ;
    scap:outcomeKind "success" .

scap:real-otp-timer scap:realizes scap:f-neg-reminder .
