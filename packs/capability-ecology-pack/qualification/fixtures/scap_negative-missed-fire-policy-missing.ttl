# FIRES gates/scap_030_missed_fire_policy_required.rq (only, capability branch).
# A recurring capability with timezone anchoring declared but NO
# missed-fire policy: behavior across downtime is undefined, so plans and
# executions may silently diverge.
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

scap:f-neg-hourly a scap:Capability ;
    dcterms:identifier "Schedule.Hourly" ;
    rdfs:label "Schedule.Hourly" ;
    skos:prefLabel "Fire a target on hourly occurrences" ;
    scap:capabilityFamily "scheduling-instant" ;
    scap:consequence "DO" ;
    scap:temporalKind "recurring" ;
    scap:timezoneAnchoring "utc" ;
    scap:inputContract "target job/action" ;
    scap:outputContract "a firing per hourly occurrence, per the (undeclared!) missed-fire policy" ;
    scap:precondition "target consequential actuation only with bound authority" ;
    scap:postcondition "occurrences fired at the hourly cadence" ;
    scap:authorityRequirement "Requires an authority envelope binding the scheduled target's consequence scope." ;
    scap:evidenceRequirement "earl: assertion from observed execution on the exact subject: consecutive hourly firings observed" ;
    scap:outcome scap:f-neg-hourly-ok .
# Deliberately missing: scap:missedFirePolicy.

scap:f-neg-hourly-ok a scap:Outcome ;
    skos:prefLabel "success:hourly-occurrence-fired" ;
    scap:outcomeKind "success" .

scap:real-otp-timer scap:realizes scap:f-neg-hourly .
