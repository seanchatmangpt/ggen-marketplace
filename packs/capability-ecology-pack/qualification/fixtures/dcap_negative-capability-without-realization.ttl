# FIRES gates/dcap_020_capability_without_realization.rq (and nothing else):
# a capability demanding "Durability.Orphan" that NO realization realizes.
# All 010-required fields present, so only 020 fires.
@prefix dcap:    <https://ggen.dev/ontology/durability-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

dcap:capability-orphan a dcap:Capability ;
    rdfs:label "Durability.Orphan" ;
    dcterms:identifier "Durability.Orphan" ;
    rdfs:comment "Deliberately unrealized: the resolver must report UNSUPPORTED for it, never silently resolve nothing." ;
    dcap:declaredOutcome "ALIVE" ;
    dcap:compensatable true ;
    dcap:reversible false .
