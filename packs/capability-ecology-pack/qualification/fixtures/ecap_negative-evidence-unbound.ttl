# NEGATIVE fixture for gates/ecap_060_evidence_unbound_to_subject.rq (fires it,
# both branches). ex:ev1 carries no subject digest at all (unbound evidence);
# ex:ev2 carries a subject digest that is not 64 lowercase hex characters
# (binds to nothing).
@prefix ecap: <https://ggen.dev/ontology/evidence-capability#> .
@prefix aps: <https://w3id.org/chatman/aps#> .
@prefix ex: <https://example.test/ecap/> .

ex:ev1 a ecap:EvidenceClaim ;
    ecap:standing aps:UNKNOWN .

ex:ev2 a ecap:EvidenceClaim ;
    ecap:subjectDigest "not-a-digest" ;
    ecap:standing aps:UNKNOWN .
