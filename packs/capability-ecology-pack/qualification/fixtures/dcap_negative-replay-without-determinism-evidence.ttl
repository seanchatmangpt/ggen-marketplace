# FIRES gates/dcap_040_replay_without_determinism_evidence.rq (and nothing else):
# a realization claiming Durability.Replay with complete provider metadata and a
# qualification condition, but NO dcap:DeterminismContract demanding byte-identical
# replay witnessed by a qce:ReplayReceipt.
@prefix dcap: <https://ggen.dev/ontology/durability-capability#> .

dcap:real-naked-replay a dcap:Realization ;
    dcap:realizes dcap:capability-replay ;
    dcap:providerRepo "demo" ;
    dcap:providerModule "Demo.NakedReplay" ;
    dcap:sourceCoordinates "lib/demo/naked_replay.ex" ;
    dcap:versionPinPolicy "demo pin" ;
    dcap:inspected false ;
    dcap:qualificationCondition dcap:qual-naked-replay .

dcap:qual-naked-replay a dcap:QualificationCondition ;
    dcap:conditionStatement "Demo-only condition so gate 070 stays clean; the fixture is about the missing determinism contract." .
