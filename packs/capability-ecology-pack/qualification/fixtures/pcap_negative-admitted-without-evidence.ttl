# FIRES gates/pcap_060_admitted_requires_evidence.rq (only).
# qce:admitted true with no evidenceReference: Generated != Admitted, and
# ALIVE requires observed execution on the exact subject.
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcap:f-neg-admitted a pcap:CapabilityRealization ;
    rdfs:label "Admitted-without-evidence fixture realization" ;
    pcap:realizes pcap:cap-signal ;
    pcap:providerRepo "https://example.test/fixture" ;
    pcap:bindingModule "Fixture.AdmittedNoEvidence.*" ;
    pcap:qualificationCondition "qualified when a receipted run observes delivery on the exact subject" .
# Deliberately missing: pcap:evidenceReference, while qce:admitted is true.

pcap:f-neg-admitted qce:admitted true .
