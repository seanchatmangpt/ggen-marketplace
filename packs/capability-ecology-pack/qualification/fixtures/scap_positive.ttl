# Positive fixture: one additional fully-lawful capability + realization
# binding, proving the gate set stays clean under lawful composition (a
# gate that passed on an empty patch would be vacuous).
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

scap:f-pos-weekdays a scap:Capability ;
    dcterms:identifier "Schedule.Weekdays" ;
    rdfs:label "Schedule.Weekdays" ;
    skos:prefLabel "Fire a target on weekday calendar occurrences in a named zone" ;
    scap:capabilityFamily "scheduling-calendar" ;
    scap:consequence "DO" ;
    scap:temporalKind "recurring" ;
    scap:timezoneAnchoring "named-zone" ;
    scap:missedFirePolicy "skip" ;
    scap:durability "durable-store" ;
    scap:inputContract "weekday pattern (Mon-Fri) + target job/action + IANA zone" ;
    scap:outputContract "one firing per weekday calendar occurrence in the anchor zone" ;
    scap:precondition "zone resolvable; target consequential actuation only with bound authority" ;
    scap:postcondition "occurrences fired per weekday pattern, DST-aware" ;
    scap:authorityRequirement "Requires an authority envelope binding the scheduled target's consequence scope." ;
    scap:evidenceRequirement "earl: assertion from observed execution on the exact subject: weekday occurrences observed at pattern times in the anchor zone" ;
    scap:executionProperty "timing: calendar-correct in the anchor zone" ;
    scap:outcome scap:f-pos-weekdays-ok .

scap:f-pos-weekdays-ok a scap:Outcome ;
    skos:prefLabel "success:weekday-occurrence-fired" ;
    scap:outcomeKind "success" .

scap:real-oban scap:realizes scap:f-pos-weekdays .
