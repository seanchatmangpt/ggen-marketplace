# FIRES gates/dcap_010_required.rq (and nothing else): dcap:resumeOutcome is a CLOSED
# enum ("ALIVE" | "REFUSED_VERSION_BOUNDARY" | "REQUALIFIED"); "MAYBE" is an outcome
# nobody declared, so the claim asserts a state outside the typed vocabulary.
@prefix dcap: <https://ggen.dev/ontology/durability-capability#> .

dcap:wf-enum a dcap:WorkflowSubject ;
    dcap:workflowIdentity "urn:wf:demo:enum" ;
    dcap:projectionVersion "v26.9.30" .

dcap:rc-bad-enum a dcap:ResumeClaim ;
    dcap:resumesWorkflow dcap:wf-enum ;
    dcap:versionBoundaryCrossed false ;
    dcap:resumeOutcome "MAYBE" .
