# NEGATIVE fixture: fires gate ocap_010_capability_requires_realization.
# Observation.Aggregate is admitted but NO realization realizes it.
@prefix ocap: <https://ggen.dev/ontology/observation-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ocap:observation-aggregate a ocap:ObservationCapability, ocap:Capability ;
    rdfs:label "Observation.Aggregate" ;
    dcterms:identifier "Observation.Aggregate" ;
    ocap:input "observation record stream" ;
    ocap:output "aggregated observation summary" ;
    ocap:deliverySemantics ocap:atLeastOnce .
