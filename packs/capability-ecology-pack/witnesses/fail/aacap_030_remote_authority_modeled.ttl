# FAIL witness for gates/aacap_030_remote_authority_modeled.rq: two mutation shapes,
# both firing gate 030 (target):
#   1. remote realization with admission policy + reachability but NO envelope
#      (Policy != Authority; ProviderAvailable != Authorized);
#   2. remote realization whose envelope is valid only at the LOCAL end.
# Complete qualification conditions (gate 020 silent); both realize an existing
# capability (gate 010 silent).
@prefix aacap: <https://ggen.dev/ontology/a2a-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix earl: <http://www.w3.org/ns/earl#> .

aacap:witness-policy-only-real a aacap:Realization ;
    aacap:realizationOf aacap:capability-invoke ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.PolicyOnly" ;
    aacap:authorityLocation "remote" ;
    aacap:admissionPolicy "https-only endpoint admission (policy, not authority)" ;
    aacap:providerReachable true ;
    aacap:grantsDoAuthority false ;
    aacap:qualificationCondition aacap:witness-policy-only-cond .

aacap:witness-policy-only-cond a aacap:QualificationCondition ;
    earl:outcome earl:passed ;
    aacap:conditionStatement "Remote realization whose only remote facts are a policy admission and reachability: authorizes nothing." ;
    aacap:conditionScope "witness fixture" .

aacap:witness-local-envelope-real a aacap:Realization ;
    aacap:realizationOf aacap:capability-invoke ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.LocalEnvelopeOnly" ;
    aacap:authorityLocation "remote" ;
    aacap:authorityEnvelope aacap:witness-local-envelope ;
    aacap:grantsDoAuthority false ;
    aacap:qualificationCondition aacap:witness-local-envelope-cond .

aacap:witness-local-envelope a qce:AuthorityEnvelope ;
    aacap:validAtEnd "local" .

aacap:witness-local-envelope-cond a aacap:QualificationCondition ;
    earl:outcome earl:passed ;
    aacap:conditionStatement "Remote realization whose envelope is valid only at the local end: does not authorize a remote effect." ;
    aacap:conditionScope "witness fixture" .
