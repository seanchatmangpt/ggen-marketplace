# FIRES ONLY gates/ncap_010_capability_requires_realization.rq:
# Remote.Ping is complete in every other respect but declares no ncap:realizedBy.
@prefix ncap:    <https://ggen.dev/ontology/network-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ncap:neg-unrealized a ncap:Capability ;
    dcterms:identifier "Remote.Ping" ;
    ncap:consequenceClass "READ" ;
    ncap:input "endpoint" ;
    ncap:output "latency" ;
    ncap:hasPrecondition ncap:precondition-endpoint-resolution ;
    ncap:hasOutcome ncap:outcome-success, ncap:failure-dns-failure, ncap:failure-connect-timeout ;
    ncap:requiresEvidence "earl:request-response-receipt" ;
    ncap:requiresAuthority false ;
    ncap:determinism "nondeterministic" ;
    ncap:retryClass "idempotent-retry" .
