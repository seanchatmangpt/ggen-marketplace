# FIRES ONLY gates/fscap_040_consequential_requires_authority.rq:
# File.Chmod is a DO capability with every other property declared but
# fscap:requiresAuthority false and no authority scope
# (ProviderAvailable != Authorized violation).
@prefix fscap:   <https://ggen.dev/ontology/filesystem-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

fscap:neg-unauthorized a fscap:Capability ;
    dcterms:identifier "File.Chmod" ;
    fscap:consequenceClass "DO" ;
    fscap:input "path" ; fscap:input "mode" ;
    fscap:output "mode" ;
    fscap:hasPrecondition fscap:precondition-path-safety ;
    fscap:hasOutcome fscap:outcome-success, fscap:failure-enoent, fscap:failure-eacces ;
    fscap:requiresEvidence "earl:before-after-digest-receipt" ;
    fscap:requiresAuthority false ;
    fscap:durability "durable" ;
    fscap:idempotent true ;
    fscap:reversibilityClass "compensable" ;
    fscap:realizedBy fscap:neg-chmod-realization .

fscap:neg-chmod-realization a fscap:Realization ;
    dcterms:identifier "fixture.chmod-step" ;
    fscap:qualificationCondition "fixture-scoped provider pinned by consumer lock" .
