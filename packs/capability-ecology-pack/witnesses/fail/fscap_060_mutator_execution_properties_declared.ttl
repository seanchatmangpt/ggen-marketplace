# FIRES ONLY gates/fscap_060_mutator_execution_properties_declared.rq:
# File.Chmod is a DO capability with authority bound and every other property
# declared, but its fscap:reversibilityClass is missing, so the replay/compensation
# stance of a mutating capability is undeclared.
@prefix fscap:   <https://ggen.dev/ontology/filesystem-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

fscap:neg-no-reversibility a fscap:Capability ;
    dcterms:identifier "File.Chmod" ;
    fscap:consequenceClass "DO" ;
    fscap:input "path" ; fscap:input "mode" ;
    fscap:output "mode" ;
    fscap:hasPrecondition fscap:precondition-path-safety ;
    fscap:hasOutcome fscap:outcome-success, fscap:failure-enoent, fscap:failure-eacces ;
    fscap:requiresEvidence "earl:before-after-digest-receipt" ;
    fscap:requiresAuthority true ;
    fscap:authorityScope "workspace-root" ;
    fscap:durability "durable" ;
    fscap:idempotent true ;
    fscap:realizedBy fscap:neg-no-reversibility-realization .

fscap:neg-no-reversibility-realization a fscap:Realization ;
    dcterms:identifier "fixture.chmod-step-no-reversibility" ;
    fscap:qualificationCondition "fixture-scoped provider pinned by consumer lock" .
