# NEGATIVE fixture: fires gate ocap_030_delivery_semantics_required.
# Telemetry.Batch is otherwise conformed (realization + qualification) but
# declares NO deliverySemantics: the resolver would have to guess the
# fidelity bound (may the batcher drop measurements?).
@prefix ocap: <https://ggen.dev/ontology/observation-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ocap:telemetry-batch a ocap:Capability ;
    rdfs:label "Telemetry.Batch" ;
    dcterms:identifier "Telemetry.Batch" ;
    ocap:input "batch of measurements" ;
    ocap:output "batched sink append" .

ocap:realization-batch a ocap:Realization ;
    ocap:realizes ocap:telemetry-batch ;
    ocap:providerRepo "example" ;
    ocap:providerModule "batcher with no declared delivery semantics" ;
    ocap:versionPinPolicy "none" ;
    ocap:providerAvailable true ;
    ocap:qualificationCondition ocap:qc-ndjson-sink-appends .
