# FAIL witness for gates/aacap_010_capability_requires_realization.rq:
# a capability with NO realization -> gate 010 fires (target).
# Observation class, no authority, no evidence: every other gate stays silent.
@prefix aacap: <https://ggen.dev/ontology/a2a-capability#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

aacap:witness-orphan a aacap:Capability ;
    dcterms:identifier "A2A.OrphanProbe" ;
    rdfs:label "A2A.OrphanProbe" ;
    aacap:consequenceClass "observation" ;
    aacap:requiresAuthority false ;
    aacap:grantsDoAuthority false .
