# FIRES ONLY gates/fscap_030_capability_requires_typed_failure_set.rq:
# File.Stat models a failure outcome (eisdir) but never the family-universal
# enoent/eacces classes, so absence and permission failures are silently absorbable.
@prefix fscap:   <https://ggen.dev/ontology/filesystem-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

fscap:neg-thin-failures a fscap:Capability ;
    dcterms:identifier "File.Stat" ;
    fscap:consequenceClass "READ" ;
    fscap:input "path" ;
    fscap:output "file-info" ;
    fscap:hasPrecondition fscap:precondition-path-safety ;
    fscap:hasOutcome fscap:outcome-success, fscap:failure-eisdir ;
    fscap:requiresEvidence "earl:request-receipt" ;
    fscap:requiresAuthority false ;
    fscap:idempotent true ;
    fscap:realizedBy fscap:neg-thin-realization .

fscap:neg-thin-realization a fscap:Realization ;
    dcterms:identifier "fixture.stat-step-thin-failures" ;
    fscap:qualificationCondition "fixture-scoped provider pinned by consumer lock" .
