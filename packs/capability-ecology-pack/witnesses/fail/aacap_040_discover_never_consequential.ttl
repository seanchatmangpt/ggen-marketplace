# FAIL witness for gates/aacap_040_discover_never_consequential.rq: two mutation shapes,
# both firing gate 040 (target):
#   1. a capability identified "A2A.Discover" re-typed external_do
#      (discover-marked-consequential);
#   2. an observation-class capability that requires authority
#      (observation claiming actuation authority).
# Realizations with complete conditions keep gates 010/020 silent; the re-typed
# Discover carries a remote evidence requirement so gate 050 stays silent.
@prefix aacap: <https://ggen.dev/ontology/a2a-capability#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aacap:witness-consequential-discover a aacap:Capability ;
    dcterms:identifier "A2A.Discover" ;
    rdfs:label "A2A.Discover" ;
    aacap:consequenceClass "external_do" ;
    aacap:requiresAuthority true ;
    aacap:grantsDoAuthority false ;
    aacap:requiresEvidence aacap:witness-discover-do-evidence .

aacap:witness-discover-do-evidence a aacap:EvidenceRequirement ;
    aacap:evidenceKind "remote_receipt" .

aacap:witness-consequential-discover-real a aacap:Realization ;
    aacap:realizationOf aacap:witness-consequential-discover ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.ConsequentialDiscover" ;
    aacap:authorityLocation "local" ;
    aacap:grantsDoAuthority false ;
    aacap:qualificationCondition aacap:witness-consequential-discover-cond .

aacap:witness-consequential-discover-cond a aacap:QualificationCondition ;
    earl:outcome earl:passed ;
    aacap:conditionStatement "Mutation: Discover re-typed consequential; gate 040 must fire." ;
    aacap:conditionScope "witness fixture" .

aacap:witness-authoritative-observation a aacap:Capability ;
    dcterms:identifier "A2A.AuthorityProbe" ;
    rdfs:label "A2A.AuthorityProbe" ;
    aacap:consequenceClass "observation" ;
    aacap:requiresAuthority true ;
    aacap:grantsDoAuthority false .

aacap:witness-authoritative-observation-real a aacap:Realization ;
    aacap:realizationOf aacap:witness-authoritative-observation ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.AuthoritativeObservation" ;
    aacap:authorityLocation "local" ;
    aacap:grantsDoAuthority false ;
    aacap:qualificationCondition aacap:witness-authoritative-observation-cond .

aacap:witness-authoritative-observation-cond a aacap:QualificationCondition ;
    earl:outcome earl:passed ;
    aacap:conditionStatement "Mutation: observation capability requiring actuation authority; gate 040 must fire." ;
    aacap:conditionScope "witness fixture" .
