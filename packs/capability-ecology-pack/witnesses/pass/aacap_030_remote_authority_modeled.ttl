# PASS witness for gates/aacap_030_remote_authority_modeled.rq:
# a remote realization carrying a qce:AuthorityEnvelope valid at the REMOTE end.
# admissionPolicy and providerReachable are present as EXTRA facts and satisfy
# nothing (Policy != Authority, ProviderAvailable != Authorized); the remote
# envelope is what keeps the gate silent.
@prefix aacap: <https://ggen.dev/ontology/a2a-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aacap:witness-remote-cap a aacap:Capability ;
    dcterms:identifier "A2A.RemoteProbe" ;
    rdfs:label "A2A.RemoteProbe" ;
    aacap:consequenceClass "external_do" ;
    aacap:requiresAuthority true ;
    aacap:grantsDoAuthority false ;
    aacap:requiresEvidence aacap:witness-remote-evidence .

aacap:witness-remote-evidence a aacap:EvidenceRequirement ;
    aacap:evidenceKind "remote_receipt" .

aacap:witness-remote-real a aacap:Realization ;
    aacap:realizationOf aacap:witness-remote-cap ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.Remote" ;
    aacap:authorityLocation "remote" ;
    aacap:admissionPolicy "https-only endpoint admission (policy, not authority)" ;
    aacap:providerReachable true ;
    aacap:authorityEnvelope aacap:witness-remote-envelope ;
    aacap:grantsDoAuthority false ;
    aacap:qualificationCondition aacap:witness-remote-cond .

aacap:witness-remote-envelope a qce:AuthorityEnvelope ;
    aacap:validAtEnd "remote" .

aacap:witness-remote-cond a aacap:QualificationCondition ;
    earl:outcome earl:passed ;
    aacap:conditionStatement "Remote realization with a remote-valid envelope; policy and reachability facts are present but non-authorizing." ;
    aacap:conditionScope "witness fixture" .
