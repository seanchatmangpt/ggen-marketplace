# PASS witness for gates/authcap_050_actuation_without_envelope.rq: a consequential
# capability whose authority precondition is a TYPED qce:AuthorityEnvelope
# individual — leased, typed, revocable, never ambient.
@prefix authcap: <https://ggen.dev/ontology/authority-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/authcap/> .

ex:cap a authcap:Capability, authcap:ConsequentialCapability ;
    dcterms:identifier "Actuation.Execute" ;
    authcap:capabilityFamily "authority" ;
    authcap:input "admitted work order" ;
    authcap:output "sealed receipt" ;
    authcap:outcome ex:o ;
    authcap:authorityCeiling "construct" ;
    qce:authorityEnvelope ex:env .

ex:env a qce:AuthorityEnvelope ;
    qce:delegationDepth 1 .

ex:o a authcap:Outcome ;
    authcap:outcomeKind "refusal" ;
    authcap:refusalCode "REFUSED_NO_AUTHORITY" .
