# PASS witness for pcap_030_supervision_semantics_required: supervision capability and its realization both declare semantics.
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcap:w-sup a pcap:Capability ;
    dcterms:identifier "Process.SuperviseWitness" ;
    rdfs:label "Process.SuperviseWitness" ;
    pcap:capabilityFamily "process-supervision" ;
    pcap:supervisionSemantics "restart intensity + isolation + propagation declared" .
pcap:w-sup-real a pcap:CapabilityRealization ;
    pcap:realizes pcap:w-sup ;
    pcap:supervisionSemantics "OTP supervisor semantics declared" .
