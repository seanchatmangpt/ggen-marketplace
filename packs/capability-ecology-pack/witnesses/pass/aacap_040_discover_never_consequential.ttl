# PASS witness for gates/aacap_040_discover_never_consequential.rq:
# a Discover-shaped observation capability correctly typed observation,
# requiring no authority and carrying no authority envelope.
# Every gate must stay silent.
@prefix aacap: <https://ggen.dev/ontology/a2a-capability#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aacap:witness-discover-cap a aacap:Capability ;
    dcterms:identifier "A2A.DiscoverProbe" ;
    rdfs:label "A2A.DiscoverProbe" ;
    aacap:consequenceClass "observation" ;
    aacap:requiresAuthority false ;
    aacap:grantsDoAuthority false .

aacap:witness-discover-real a aacap:Realization ;
    aacap:realizationOf aacap:witness-discover-cap ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.Discover" ;
    aacap:authorityLocation "none" ;
    aacap:derivedFromSource true ;
    aacap:grantsDoAuthority false ;
    aacap:qualificationCondition aacap:witness-discover-cond .

aacap:witness-discover-cond a aacap:QualificationCondition ;
    earl:outcome earl:passed ;
    aacap:conditionStatement "Observation realization: no authority, no envelope, derived projection." ;
    aacap:conditionScope "witness fixture" .
