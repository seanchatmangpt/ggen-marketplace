# PASS witness for scap_020_realization_requires_qualification: realization WITH a qualification condition.
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .

scap:w-real a scap:CapabilityRealization ;
    scap:bindingModule "Witness.Binding.*" ;
    scap:qualificationCondition "qualified when a receipted run observes the bound firing" .
