# PASS witness for gates/ecap_040_realization_without_qualification.rq: a
# realization with full provider metadata, version-pin policy, ceiling inside
# the enum, an owning capability, and qualification conditions.
@prefix ecap: <https://ggen.dev/ontology/evidence-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/ecap/> .

ex:cap a ecap:Capability ;
    dcterms:identifier "Receipt.Sign" ;
    ecap:capabilityFamily "evidence" ;
    ecap:input "operation events" ;
    ecap:output "content-addressed receipt" ;
    ecap:outcome ex:o ;
    ecap:authorityCeiling "construct" ;
    ecap:realization ex:r .

ex:o a ecap:Outcome ;
    ecap:outcomeKind "success" .

ex:r a ecap:Realization ;
    dcterms:identifier "assemble-r" ;
    ecap:authorityCeiling "construct" ;
    ecap:providerRepo "ash_affidavit" ;
    ecap:bindingModule "AshAffidavit.Change.Receipt (op: :assemble)" ;
    ecap:sourceFile "lib/ash_affidavit/change/receipt.ex" ;
    ecap:versionPinPolicy "pin by exact release tag + registry digest" ;
    ecap:qualificationCondition "engine assembles the receipt; it signs nothing (recorded limit)" ;
    ecap:qualificationCondition "chain hash is 64 lowercase hex BLAKE3" .
