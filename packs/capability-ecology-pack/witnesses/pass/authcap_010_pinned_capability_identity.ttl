# POSITIVE fixture: clean complement to ontology.ttl. Adds qce qualification
# and replay receipts qualifying each of the three admitted realizations.
# Evaluated together with ontology.ttl, every gate in gates/ MUST return zero
# rows (verify.py refuses otherwise).
@prefix authcap: <https://ggen.dev/ontology/authority-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/authcap/> .

ex:qual-graphlaw a qce:QualificationReceipt ;
    qce:qualifies authcap:realization-graphlaw-authority ;
    qce:qualificationDigest "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-graphlaw .

ex:replay-graphlaw a qce:ReplayReceipt ;
    qce:replayDigest "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
    qce:replayVerified true .

ex:qual-readside a qce:QualificationReceipt ;
    qce:qualifies authcap:realization-graphlaw-authority-readside ;
    qce:qualificationDigest "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-readside .

ex:replay-readside a qce:ReplayReceipt ;
    qce:replayDigest "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" ;
    qce:replayVerified true .

ex:qual-actuation a qce:QualificationReceipt ;
    qce:qualifies authcap:realization-xaas-actuation ;
    qce:qualificationDigest "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" ;
    qce:independentVerification true ;
    qce:replayReceipt ex:replay-actuation .

ex:replay-actuation a qce:ReplayReceipt ;
    qce:replayDigest "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" ;
    qce:replayVerified true .
