# PASS witness for gates/ecap_020_capability_contract_complete.rq: a capability
# whose contract is complete — identifier, family, inputs, outputs, outcome,
# ceiling inside the enum.
@prefix ecap: <https://ggen.dev/ontology/evidence-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/ecap/> .

ex:cap a ecap:Capability ;
    dcterms:identifier "Evidence.Bind" ;
    ecap:capabilityFamily "evidence" ;
    ecap:input "observation" ;
    ecap:output "bound evidence" ;
    ecap:outcome ex:o ;
    ecap:authorityCeiling "observe" .

ex:o a ecap:Outcome ;
    ecap:outcomeKind "success" .
