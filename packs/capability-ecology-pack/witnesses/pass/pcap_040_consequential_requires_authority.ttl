# PASS witness for pcap_040_consequential_requires_authority: DO capability WITH bound authority.
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcap:w-do a pcap:Capability ;
    dcterms:identifier "Process.WitnessDO" ;
    rdfs:label "Process.WitnessDO" ;
    pcap:consequence "DO" ;
    pcap:authorityRequirement "authority envelope bound" .
