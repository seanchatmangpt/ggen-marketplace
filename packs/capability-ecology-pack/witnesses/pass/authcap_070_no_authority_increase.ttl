# PASS witness for gates/authcap_070_no_authority_increase.rq: a realization whose
# ceiling never exceeds its capability's (observe <= select <= construct).
@prefix authcap: <https://ggen.dev/ontology/authority-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/authcap/> .

ex:cap a authcap:Capability ;
    dcterms:identifier "Authority.Verify" ;
    authcap:capabilityFamily "authority" ;
    authcap:input "signed lease material" ;
    authcap:output "ceiling verdict" ;
    authcap:outcome ex:o ;
    authcap:authorityCeiling "select" ;
    authcap:realization ex:r .

ex:o a authcap:Outcome ;
    authcap:outcomeKind "success" .

ex:r a authcap:Realization ;
    dcterms:identifier "verify-r" ;
    authcap:authorityCeiling "select" ;
    authcap:providerRepo "ash_graphlaw" ;
    authcap:bindingModule "AshGraphLaw.Authority" ;
    authcap:sourceFile "lib/ash_graphlaw/authority.ex" ;
    authcap:versionPinPolicy "pin by exact release tag" ;
    authcap:qualificationCondition "signed-lease presentation check only" .
