# PASS witness for gates/aacap_050_invoke_requires_evidence.rq:
# a consequence-bearing (change) capability declaring a remote_receipt
# evidence requirement. Every gate must stay silent.
@prefix aacap: <https://ggen.dev/ontology/a2a-capability#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aacap:witness-change-cap a aacap:Capability ;
    dcterms:identifier "A2A.ChangeProbe" ;
    rdfs:label "A2A.ChangeProbe" ;
    aacap:consequenceClass "change" ;
    aacap:requiresAuthority true ;
    aacap:grantsDoAuthority false ;
    aacap:requiresEvidence aacap:witness-change-evidence .

aacap:witness-change-evidence a aacap:EvidenceRequirement ;
    aacap:evidenceKind "remote_receipt" ;
    aacap:evidenceEnvelopeSchema "sa2a.semantic-evidence-envelope.v1" .

aacap:witness-change-real a aacap:Realization ;
    aacap:realizationOf aacap:witness-change-cap ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.Change" ;
    aacap:authorityLocation "local" ;
    aacap:grantsDoAuthority false ;
    aacap:qualificationCondition aacap:witness-change-cond .

aacap:witness-change-cond a aacap:QualificationCondition ;
    earl:outcome earl:passed ;
    aacap:conditionStatement "Change capability with a remote-receipt evidence requirement declared." ;
    aacap:conditionScope "witness fixture" .
