# PASS witness for pcap_060_admitted_requires_evidence: admitted realization WITH evidence reference.
@prefix pcap: <https://ggen.dev/ontology/process-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .

pcap:w-admitted a pcap:CapabilityRealization ;
    qce:admitted true ;
    pcap:evidenceReference "earl:assertion:witness-001" .
