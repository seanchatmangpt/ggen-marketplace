# PASS witness for scap_060_recurring_requires_timezone_anchoring: recurring capability and its realization both declare an anchor.
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

scap:w-rec a scap:Capability ;
    dcterms:identifier "Schedule.WitnessNightly" ;
    rdfs:label "Schedule.WitnessNightly" ;
    scap:temporalKind "recurring" ;
    scap:timezoneAnchoring "named-zone" .
scap:w-real a scap:CapabilityRealization ;
    scap:realizes scap:w-rec ;
    scap:timezoneAnchoring "utc" .
