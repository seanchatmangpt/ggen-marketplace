# fscap_positive.ttl -- minimal COMPLETE capability instance. Union of ontology.ttl and
# this file must yield ZERO rows under every gate (the ontology's own nine pinned
# capabilities are the primary fscap_positive instance; this fixture adds a
# fixture-scoped READ and DO capability exercising the same contract).
@prefix fscap:   <https://ggen.dev/ontology/filesystem-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

fscap:pos-read a fscap:Capability ;
    dcterms:identifier "Pos.Read" ;
    fscap:consequenceClass "READ" ;
    fscap:input "path" ;
    fscap:output "content" ;
    fscap:hasPrecondition fscap:precondition-path-safety ;
    fscap:hasOutcome fscap:outcome-success, fscap:failure-enoent, fscap:failure-eacces ;
    fscap:requiresEvidence "earl:request-receipt" ;
    fscap:requiresAuthority false ;
    fscap:idempotent true ;
    fscap:realizedBy fscap:pos-real-read .

fscap:pos-real-read a fscap:Realization ;
    dcterms:identifier "fixture.read-step" ;
    fscap:providerModule "fixture.ReadStep" ;
    fscap:providerRepo "https://fixture.invalid/capability-ecology-pack" ;
    fscap:qualificationCondition "fixture-scoped provider pinned by consumer lock" .

fscap:pos-write a fscap:Capability ;
    dcterms:identifier "Pos.Write" ;
    fscap:consequenceClass "DO" ;
    fscap:input "path" ; fscap:input "content" ;
    fscap:output "bytes-written" ;
    fscap:hasPrecondition fscap:precondition-path-safety ;
    fscap:hasOutcome fscap:outcome-success, fscap:failure-enoent, fscap:failure-eacces ;
    fscap:requiresEvidence "earl:before-after-digest-receipt" ;
    fscap:requiresAuthority true ;
    fscap:authorityScope "workspace-root" ;
    fscap:durability "durable" ;
    fscap:idempotent true ;
    fscap:reversibilityClass "compensable" ;
    fscap:realizedBy fscap:pos-real-write .

fscap:pos-real-write a fscap:Realization ;
    dcterms:identifier "fixture.write-step" ;
    fscap:providerModule "fixture.WriteStep" ;
    fscap:providerRepo "https://fixture.invalid/capability-ecology-pack" ;
    fscap:qualificationCondition "fixture-scoped provider pinned by consumer lock" .
