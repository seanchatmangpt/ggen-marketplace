# MESSAGE: capability without any realization — an unresolvable scheduling capability is a plan that can never fire; name a qualified provider binding or refuse the capability.
PREFIX scap: <https://ggen.dev/ontology/scheduling-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?id WHERE {
  ?cap a scap:Capability ;
       dcterms:identifier ?id .
  FILTER NOT EXISTS { ?real scap:realizes ?cap . }
}
ORDER BY ?id
