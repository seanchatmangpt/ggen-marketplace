# MESSAGE: EVIDENCE-FIRST LAW, two refusal shapes.
# Shape A: every realization of an observation capability must state its
#   evidence requirement -- the receipt or observation record proving the
#   observation happened. Any row = a tap that cannot show what it saw: a
#   rumor generator. REFUSED (observation-without-evidence).
# Shape B: any realization declaring ocap:evidenceCapable false is refused
#   outright: a tap that cannot produce evidence must be REFUSED, not
#   tolerated. REFUSED (evidence-incapable-realization).
PREFIX ocap: <https://ggen.dev/ontology/observation-capability#>
SELECT ?realization ?violation WHERE {
  { ?realization ocap:realizes ?capability .
    ?capability a ocap:ObservationCapability .
    FILTER NOT EXISTS { ?realization ocap:evidenceRequirement ?evidence }
    BIND("observation-without-evidence-requirement" AS ?violation) }
  UNION
  { ?realization ocap:evidenceCapable false .
    BIND("evidence-incapable-realization" AS ?violation) }
}
ORDER BY ?realization ?violation
