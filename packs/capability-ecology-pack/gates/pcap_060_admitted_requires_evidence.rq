# MESSAGE: admitted realization without evidence reference — Generated != Admitted and ALIVE requires observed execution: a realization asserted qce:admitted true with no evidenceReference to a replayable assertion is an unadmitted admission; bind evidence or retract the flag.
PREFIX pcap: <https://ggen.dev/ontology/process-capability#>
PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
SELECT ?real WHERE {
  ?real a pcap:CapabilityRealization ;
        qce:admitted true .
  FILTER NOT EXISTS { ?real pcap:evidenceReference ?ev . }
}
ORDER BY ?real
