# MESSAGE: realization without qualification conditions.
# Generated != Admitted: every aacap:Realization must carry a qualification
# condition with an EARL passed outcome and an explicit witness scope; a row is a refusal.
PREFIX aacap: <https://ggen.dev/ontology/a2a-capability#>
PREFIX earl: <http://www.w3.org/ns/earl#>
SELECT ?module WHERE {
  ?realization a aacap:Realization ;
               aacap:providerModule ?module .
  FILTER NOT EXISTS {
    ?realization aacap:qualificationCondition ?condition .
    ?condition earl:outcome earl:passed ;
               aacap:conditionStatement ?statement ;
               aacap:conditionScope ?scope .
  }
}
ORDER BY ?module
