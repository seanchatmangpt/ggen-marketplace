# MESSAGE: every admitted dcap:Capability must carry at least one dcap:Realization
# (dcap:realizes). A capability with zero realizations is a demand no provider
# satisfies: the resolver must see it as UNSUPPORTED, not silently resolve nothing.
# Any row = a capability no realization realizes (capability-without-realization).
PREFIX dcap:    <https://ggen.dev/ontology/durability-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?capability ?id WHERE {
  ?capability a dcap:Capability ;
      dcterms:identifier ?id .
  FILTER NOT EXISTS {
    ?realization a dcap:Realization ;
        dcap:realizes ?capability .
  }
}
ORDER BY ?id
