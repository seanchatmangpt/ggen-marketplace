# MESSAGE: every fscap:Capability must declare at least one fscap:Realization via
# fscap:realizedBy. Any row = a capability no provider can execute (unresolvable by
# any capability-resolution engine). Plan != Execution: a capability with no
# realization plans nothing executable.
PREFIX fscap: <https://ggen.dev/ontology/filesystem-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?cap ?id WHERE {
  ?cap a fscap:Capability ;
       dcterms:identifier ?id .
  FILTER NOT EXISTS { ?cap fscap:realizedBy ?realization . }
}
ORDER BY ?id
