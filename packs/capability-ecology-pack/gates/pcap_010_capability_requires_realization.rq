# MESSAGE: capability without any realization — an unresolvable capability is a plan that cannot execute; name a qualified realization or refuse the capability.
PREFIX pcap: <https://ggen.dev/ontology/process-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?id WHERE {
  ?cap a pcap:Capability ;
       dcterms:identifier ?id .
  FILTER NOT EXISTS { ?real pcap:realizes ?cap . }
}
ORDER BY ?id
