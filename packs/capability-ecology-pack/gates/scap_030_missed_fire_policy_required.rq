# MESSAGE: missed-fire policy missing — a schedule without a declared missed-fire policy (catch_up | skip | drop) lets plans and executions silently diverge when the system is down across an occurrence; a realization without a declared policy cannot be compared against the contract. Declare it or refuse.
PREFIX scap: <https://ggen.dev/ontology/scheduling-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?subject ?kind WHERE {
  {
    ?cap a scap:Capability ;
         dcterms:identifier ?id .
    FILTER NOT EXISTS { ?cap scap:missedFirePolicy ?p . }
    BIND(?id AS ?subject)
    BIND("capability" AS ?kind)
  }
  UNION
  {
    ?real a scap:CapabilityRealization .
    FILTER NOT EXISTS { ?real scap:missedFirePolicy ?p2 . }
    BIND(?real AS ?subject)
    BIND("realization" AS ?kind)
  }
}
ORDER BY ?subject ?kind
