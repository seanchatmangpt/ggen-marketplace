# MESSAGE: every realization must carry at least one qualification condition.
# Any row = a provider offered for a capability with NO stated conditions under
# which it may be selected -- an unqualified offer is a hope, not a contract.
# REFUSED.
PREFIX escap: <https://ggen.dev/ontology/event-state-capability#>
SELECT ?realization WHERE {
  ?realization a escap:Realization .
  FILTER NOT EXISTS { ?realization escap:qualificationCondition ?condition }
}
ORDER BY ?realization
