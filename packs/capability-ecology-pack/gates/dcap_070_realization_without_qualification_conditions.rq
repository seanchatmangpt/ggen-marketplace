# MESSAGE: a realization with zero qualification conditions is unqualified by
# construction — there is no stated boundary under which a resolver may admit it, so
# "resolve it" silently means "resolve it always". Every dcap:Realization must carry
# >=1 dcap:qualificationCondition -> dcap:QualificationCondition with a non-empty
# dcap:conditionStatement (what the provider's qualify/2 demands, what evidence it
# must emit, what authority it must NOT hold). Any row = a realization that resolves
# unconditionally.
PREFIX dcap: <https://ggen.dev/ontology/durability-capability#>
SELECT ?realization ?module WHERE {
  ?realization a dcap:Realization ;
      dcap:providerModule ?module .
  FILTER NOT EXISTS {
    ?realization dcap:qualificationCondition ?condition .
    ?condition a dcap:QualificationCondition ;
        dcap:conditionStatement ?statement .
    FILTER(STRLEN(STR(?statement)) > 0)
  }
}
ORDER BY ?module
