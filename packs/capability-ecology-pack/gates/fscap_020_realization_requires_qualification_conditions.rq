# MESSAGE: every fscap:Realization must carry at least one fscap:qualificationCondition.
# Any row = a provider implementation that claims a capability with zero stated
# conditions under which it counts as that capability. Generated != Admitted: a
# realization with no qualification conditions admits nothing.
PREFIX fscap: <https://ggen.dev/ontology/filesystem-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?realization ?id WHERE {
  ?realization a fscap:Realization ;
               dcterms:identifier ?id .
  FILTER NOT EXISTS { ?realization fscap:qualificationCondition ?condition . }
}
ORDER BY ?id
