# MESSAGE: every realization of a State-family capability must state its
# evidence requirement -- the record that proves the observation happened.
# Any row = an observation offer with no stated evidence: an observation that
# cannot show what it saw is a rumor, not a capability. REFUSED.
PREFIX escap: <https://ggen.dev/ontology/event-state-capability#>
SELECT ?realization ?capability WHERE {
  ?realization escap:realizes ?capability .
  ?capability a escap:StateCapability .
  FILTER NOT EXISTS { ?realization escap:evidenceRequirement ?evidence }
}
ORDER BY ?realization ?capability
