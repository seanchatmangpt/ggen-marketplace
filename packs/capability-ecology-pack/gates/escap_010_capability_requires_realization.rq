# MESSAGE: every capability in the event/state family must have at least one
# realization. Any row = an admitted capability contract no provider offers --
# the resolver would surface a capability it can never discharge. REFUSED.
PREFIX escap: <https://ggen.dev/ontology/event-state-capability#>
SELECT ?capability WHERE {
  ?capability a escap:Capability .
  FILTER NOT EXISTS { ?realization escap:realizes ?capability }
}
ORDER BY ?capability
