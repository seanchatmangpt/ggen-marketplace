# MESSAGE: every capability in this family MUST declare deliverySemantics
# (atLeastOnce / atMostOnce / exactlyOnce / sampleMayDrop). Any row = a
# capability whose observation fidelity the resolver would have to GUESS --
# a guessed fidelity bound is how silent sample gaps get invented. REFUSED.
PREFIX ocap: <https://ggen.dev/ontology/observation-capability#>
SELECT ?capability WHERE {
  ?capability a ocap:Capability .
  FILTER NOT EXISTS { ?capability ocap:deliverySemantics ?semantics }
}
ORDER BY ?capability
