# MESSAGE: event-family capabilities MUST declare deliverySemantics
# (atLeastOnce / exactlyOnce / atMostOnce); state-family capabilities MUST
# declare observationSemantics (monotonicObservedState / pointInTimeSnapshot /
# streamingTail). Any row = a capability whose semantics the resolver would
# have to GUESS -- a guessed delivery contract is how duplicate and loss
# semantics get silently invented. REFUSED.
PREFIX escap: <https://ggen.dev/ontology/event-state-capability#>
SELECT ?capability ?family WHERE {
  { ?capability a escap:EventCapability .
    FILTER NOT EXISTS { ?capability escap:deliverySemantics ?semantics }
    BIND("event" AS ?family) }
  UNION
  { ?capability a escap:StateCapability .
    FILTER NOT EXISTS { ?capability escap:observationSemantics ?semantics }
    BIND("state" AS ?family) }
}
ORDER BY ?capability ?family
