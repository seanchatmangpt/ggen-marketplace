# MESSAGE: capability-without-realization. A capability that no inspected
# provider realizes may still be a lawful contract, but an ADMITTED capability
# in this pack must carry at least one authcap:Realization (whose qualification
# conditions delimit what part is actually implemented — see gate 040). Any
# row is a capability a consumer would resolve and find nothing behind.
PREFIX authcap: <https://ggen.dev/ontology/authority-capability#>
SELECT ?cap WHERE {
  ?cap a authcap:Capability .
  FILTER NOT EXISTS { ?cap authcap:realization ?r }
}
ORDER BY ?cap
