# MESSAGE: consequential scheduling capability with unbound authority — a firing capability without a bound authority requirement launders actuation through time (ProviderAvailable != Authorized, Policy != Authority); bind the authority requirement or refuse.
PREFIX scap: <https://ggen.dev/ontology/scheduling-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?id WHERE {
  ?cap a scap:Capability ;
       dcterms:identifier ?id ;
       scap:consequence "DO" .
  FILTER NOT EXISTS { ?cap scap:authorityRequirement ?auth . }
}
ORDER BY ?id
