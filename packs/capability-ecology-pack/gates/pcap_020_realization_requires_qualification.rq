# MESSAGE: realization without a qualification condition — an unconditioned provider binding can never be refused, which makes qualification vacuous; declare the condition under which it qualifies.
PREFIX pcap: <https://ggen.dev/ontology/process-capability#>
SELECT ?real ?binding WHERE {
  ?real a pcap:CapabilityRealization ;
        pcap:bindingModule ?binding .
  FILTER NOT EXISTS { ?real pcap:qualificationCondition ?cond . }
}
ORDER BY ?real
