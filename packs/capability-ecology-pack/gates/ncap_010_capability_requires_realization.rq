# MESSAGE: every ncap:Capability must declare at least one ncap:Realization via
# ncap:realizedBy. Any row = a capability no provider can execute (unresolvable by
# any capability-resolution engine). Plan != Execution: a capability with no
# realization plans nothing executable.
PREFIX ncap: <https://ggen.dev/ontology/network-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?cap ?id WHERE {
  ?cap a ncap:Capability ;
       dcterms:identifier ?id .
  FILTER NOT EXISTS { ?cap ncap:realizedBy ?realization . }
}
ORDER BY ?id
