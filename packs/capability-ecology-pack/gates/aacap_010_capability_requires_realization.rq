# MESSAGE: capability without realization.
# Every aacap:Capability must have at least one aacap:Realization; a row is a refusal.
PREFIX aacap: <https://ggen.dev/ontology/a2a-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?identifier WHERE {
  ?capability a aacap:Capability ;
              dcterms:identifier ?identifier .
  FILTER NOT EXISTS {
    ?realization a aacap:Realization ;
                 aacap:realizationOf ?capability .
  }
}
ORDER BY ?identifier
