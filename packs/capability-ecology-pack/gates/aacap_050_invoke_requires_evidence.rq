# MESSAGE: consequence-bearing capability without remote evidence requirement.
# Every change/external_do capability must declare an evidence requirement whose
# evidenceKind is "remote_receipt" or "remote_ack_provenance" (remote receipt/ack
# provenance). A "local_log"-only or absent requirement is a refusal. A row is a refusal.
PREFIX aacap: <https://ggen.dev/ontology/a2a-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?identifier WHERE {
  ?capability a aacap:Capability ;
              dcterms:identifier ?identifier ;
              aacap:consequenceClass ?class .
  FILTER (?class IN ("change", "external_do"))
  FILTER NOT EXISTS {
    ?capability aacap:requiresEvidence ?requirement .
    ?requirement a aacap:EvidenceRequirement ;
                 aacap:evidenceKind ?kind .
    FILTER (?kind IN ("remote_receipt", "remote_ack_provenance"))
  }
}
ORDER BY ?identifier
