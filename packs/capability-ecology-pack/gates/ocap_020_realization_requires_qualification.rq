# MESSAGE: every realization must carry at least one qualification condition.
# Any row = a provider offered for a capability with NO stated conditions under
# which it may be selected. REFUSED.
PREFIX ocap: <https://ggen.dev/ontology/observation-capability#>
SELECT ?realization WHERE {
  ?realization a ocap:Realization .
  FILTER NOT EXISTS { ?realization ocap:qualificationCondition ?condition }
}
ORDER BY ?realization
