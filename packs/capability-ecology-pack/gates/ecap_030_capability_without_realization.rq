# MESSAGE: capability-without-realization. An admitted capability in this pack
# must carry at least one ecap:Realization (whose qualification conditions
# delimit what part is actually implemented — see gate 040). Any row is a
# capability a consumer would resolve and find nothing behind.
PREFIX ecap: <https://ggen.dev/ontology/evidence-capability#>
SELECT ?cap WHERE {
  ?cap a ecap:Capability .
  FILTER NOT EXISTS { ?cap ecap:realization ?r }
}
ORDER BY ?cap
