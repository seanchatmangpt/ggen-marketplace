# MESSAGE: consequential capability with unbound authority — a consequence-DO capability without a bound authority requirement admits ambient execution authority (ProviderAvailable != Authorized); bind the authority requirement or refuse.
PREFIX pcap: <https://ggen.dev/ontology/process-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?id WHERE {
  ?cap a pcap:Capability ;
       dcterms:identifier ?id ;
       pcap:consequence "DO" .
  FILTER NOT EXISTS { ?cap pcap:authorityRequirement ?auth . }
}
ORDER BY ?id
