# MESSAGE: every ncap:Realization must carry at least one ncap:qualificationCondition.
# Any row = a provider implementation that claims a capability with zero stated
# conditions under which it counts as that capability. Generated != Admitted: a
# realization with no qualification conditions admits nothing.
PREFIX ncap: <https://ggen.dev/ontology/network-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?realization ?id WHERE {
  ?realization a ncap:Realization ;
               dcterms:identifier ?id .
  FILTER NOT EXISTS { ?realization ncap:qualificationCondition ?condition . }
}
ORDER BY ?id
