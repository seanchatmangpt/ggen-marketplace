@prefix paas: <https://chatmangpt.com/ontology/ash-r2rml-paas#> .
@prefix cv: <https://chatmangpt.com/ontology/challenger-value#> .
@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

paas:PlatformProfile a rdfs:Class .
paas:appName a rdf:Property .
paas:moduleName a rdf:Property .
paas:brceRequired a rdf:Property .
paas:requestTimeGgen a rdf:Property .
paas:innovationPolicy a rdf:Property .
paas:authorityCeiling a rdf:Property .
paas:intentDigest a rdf:Property .
paas:replayKey a rdf:Property .

paas: dcterms:conformsTo schema:, prov:, dcat:, dcterms:, odrl:, qudt:, skos:, sh:, rr:, <https://chatmangpt.com/ontology/challenger-value#> .

paas:DefaultPaaSProfile a paas:PlatformProfile ;
  dcterms:title "Marketplace Ash PaaS" ;
  paas:appName "marketplace_paas" ;
  paas:moduleName "MarketplacePaaS" ;
  paas:brceRequired true ;
  paas:requestTimeGgen false ;
  paas:innovationPolicy cv:ChallengerProjectionPolicy ;
  paas:authorityCeiling "BRCE_ONLY" .

paas:PlatformProfileShape a sh:NodeShape ;
  sh:targetClass paas:PlatformProfile ;
  sh:property [ sh:path paas:brceRequired ; sh:hasValue true ] ;
  sh:property [ sh:path paas:requestTimeGgen ; sh:hasValue false ] ;
  sh:property [ sh:path paas:innovationPolicy ; sh:minCount 1 ; sh:maxCount 1 ] .

paas:ExecutionPolicy odrl:prohibition paas:AmbientShell, paas:RequestTimeGgen, paas:UnreceiptedActuation, paas:ERRCActuation ;
  odrl:permission paas:Select, paas:Construct, paas:ReceiptedBRCE .
