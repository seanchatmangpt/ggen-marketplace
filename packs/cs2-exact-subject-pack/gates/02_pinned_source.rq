PREFIX cs2: <https://seanchatmangpt.github.io/ggen-marketplace/cs2#>
SELECT ?projection ?reason WHERE {
  ?projection a cs2:Projection .
  FILTER NOT EXISTS {
    ?projection cs2:sourceRepository ?repo ;
                cs2:sourceCommit ?sha ;
                cs2:sourceDigest ?digest .
    FILTER(STRLEN(STR(?repo)) > 0 && STRLEN(STR(?sha)) = 40 && STRLEN(STR(?digest)) > 0)
  }
  BIND("projection lacks repository + exact 40-character source commit + digest" AS ?reason)
}
