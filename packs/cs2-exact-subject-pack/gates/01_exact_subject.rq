PREFIX cs2: <https://seanchatmangpt.github.io/ggen-marketplace/cs2#>
SELECT ?projection ?reason WHERE {
  ?projection a cs2:Projection .
  FILTER NOT EXISTS { ?projection cs2:subject <https://seanchatmangpt.github.io/ggen-marketplace/cs2#RFC-CS2-001> }
  BIND("projection is not bound to exact RFC-CS2-001 subject" AS ?reason)
}
