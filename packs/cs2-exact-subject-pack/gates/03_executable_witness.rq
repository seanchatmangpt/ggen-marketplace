PREFIX cs2: <https://seanchatmangpt.github.io/ggen-marketplace/cs2#>
SELECT ?projection ?reason WHERE {
  ?projection a cs2:ExecutableWitnessProjection .
  FILTER NOT EXISTS {
    ?projection cs2:witnessPath ?path ; cs2:witnessDigest ?digest .
    FILTER(STRLEN(STR(?path)) > 0 && STRLEN(STR(?digest)) > 0)
  }
  BIND("executable witness projection lacks path or content digest" AS ?reason)
}
