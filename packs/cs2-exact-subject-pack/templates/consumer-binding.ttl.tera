@prefix cs2: <https://seanchatmangpt.github.io/ggen-marketplace/cs2#> .

<urn:cs2:projection:{{ consumer.slug }}> a cs2:ConsumerBindingProjection ;
  cs2:subject cs2:RFC-CS2-001 ;
  cs2:sourceRepository "{{ source.repository }}" ;
  cs2:sourceCommit "{{ source.sha }}" ;
  cs2:sourceDigest "{{ source.digest }}" ;
  cs2:consumerRepository "{{ consumer.repository }}" ;
  cs2:consumerCommit "{{ consumer.sha }}" .

<urn:cs2:witness:{{ consumer.slug }}> a cs2:ExecutableWitnessProjection ;
  cs2:subject cs2:RFC-CS2-001 ;
  cs2:sourceRepository "{{ source.repository }}" ;
  cs2:sourceCommit "{{ source.sha }}" ;
  cs2:sourceDigest "{{ source.digest }}" ;
  cs2:witnessPath "{{ witness.path }}" ;
  cs2:witnessDigest "{{ witness.digest }}" .
