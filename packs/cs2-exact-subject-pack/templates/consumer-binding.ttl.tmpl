---
to: "generated/consumer-bindings.ttl"
for_each: "binding"
sparql:
  binding: |
    PREFIX cs2: <https://seanchatmangpt.github.io/ggen-marketplace/cs2#>
    SELECT ?projection ?sourceRepository ?sourceSha ?sourceDigest ?consumerRepository ?consumerSha ?witnessPath ?witnessDigest
    WHERE {
      ?binding a cs2:ConsumerBindingProjection ;
        cs2:subject cs2:RFC-CS2-001 ;
        cs2:sourceRepository ?sourceRepository ;
        cs2:sourceCommit ?sourceSha ;
        cs2:sourceDigest ?sourceDigest ;
        cs2:consumerRepository ?consumerRepository ;
        cs2:consumerCommit ?consumerSha .
      OPTIONAL { ?binding cs2:executableWitness ?witness .
                 ?witness cs2:witnessPath ?witnessPath ; cs2:witnessDigest ?witnessDigest . }
      BIND(?binding AS ?projection)
    }
    ORDER BY ?consumerRepository ?sourceSha
---
@prefix cs2: <https://seanchatmangpt.github.io/ggen-marketplace/cs2#> .

<{{ projection }}> a cs2:ConsumerBindingProjection ;
  cs2:subject cs2:RFC-CS2-001 ;
  cs2:sourceRepository "{{ sourceRepository }}" ;
  cs2:sourceCommit "{{ sourceSha }}" ;
  cs2:sourceDigest "{{ sourceDigest }}" ;
  cs2:consumerRepository "{{ consumerRepository }}" ;
  cs2:consumerCommit "{{ consumerSha }}" .

{% if witnessPath %}<urn:cs2:witness:{{ consumerSha }}> a cs2:ExecutableWitnessProjection ;
  cs2:subject cs2:RFC-CS2-001 ;
  cs2:sourceRepository "{{ sourceRepository }}" ;
  cs2:sourceCommit "{{ sourceSha }}" ;
  cs2:sourceDigest "{{ sourceDigest }}" ;
  cs2:witnessPath "{{ witnessPath }}" ;
  cs2:witnessDigest "{{ witnessDigest }}" .
{% endif %}
