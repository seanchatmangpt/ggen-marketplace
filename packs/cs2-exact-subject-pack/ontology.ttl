@prefix cs2: <https://seanchatmangpt.github.io/ggen-marketplace/cs2#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .

cs2:RFC-CS2-001 a cs2:Subject ;
  dct:identifier "RFC-CS2-001" ;
  cs2:requiresProjection cs2:SourceProjection, cs2:ExecutableWitnessProjection, cs2:ConsumerBindingProjection .

cs2:Projection a cs2:Capability .
cs2:SourceProjection a rdfs:Class ; rdfs:subClassOf cs2:Projection .
cs2:ExecutableWitnessProjection a rdfs:Class ; rdfs:subClassOf cs2:Projection .
cs2:ConsumerBindingProjection a rdfs:Class ; rdfs:subClassOf cs2:Projection .

cs2:sourceRepository a cs2:Property .
cs2:sourceCommit a cs2:Property .
cs2:sourceDigest a cs2:Property .
cs2:subject a cs2:Property .
cs2:consumerRepository a cs2:Property .
cs2:consumerCommit a cs2:Property .
cs2:witnessPath a cs2:Property .
cs2:witnessDigest a cs2:Property .
