@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:ggen:innovation:errc>
    a skos:ConceptScheme ;
    dct:title "ERRC value-innovation strategy" ;
    dct:description "Eliminate, Reduce, Raise, Create selection categories for reversible marketplace-first innovation." .

<urn:ggen:innovation:errc:eliminate>
    a skos:Concept ;
    skos:inScheme <urn:ggen:innovation:errc> ;
    skos:prefLabel "Eliminate" ;
    skos:notation "10-E" ;
    dct:description "Remove duplicated or non-value-adding ownership once equivalence and standing are proved." .

<urn:ggen:innovation:errc:reduce>
    a skos:Concept ;
    skos:inScheme <urn:ggen:innovation:errc> ;
    skos:prefLabel "Reduce" ;
    skos:notation "20-R" ;
    dct:description "Reduce bespoke implementation and coupling while preserving reversible lawful options." .

<urn:ggen:innovation:errc:raise>
    a skos:Concept ;
    skos:inScheme <urn:ggen:innovation:errc> ;
    skos:prefLabel "Raise" ;
    skos:notation "30-R" ;
    dct:description "Raise evidence, provenance, qualification, replay, and marketplace reuse above current practice." .

<urn:ggen:innovation:errc:create>
    a skos:Concept ;
    skos:inScheme <urn:ggen:innovation:errc> ;
    skos:prefLabel "Create" ;
    skos:notation "40-C" ;
    dct:description "Create new reusable manufacturing capital and composition surfaces unavailable in consumer-local designs." .

<urn:ggen:innovation:errc:selection>
    a prov:Activity ;
    dct:title "Marketplace-first ERRC selection" ;
    dct:type <urn:ggen:authority:SELECT> ;
    prov:used <urn:ggen:innovation:errc> .

<urn:ggen:innovation:proposal:eliminate-local-pack-duplication>
    a prov:Entity ;
    dct:identifier "E-001" ;
    dct:type <urn:ggen:innovation:errc:eliminate> ;
    dct:title "Eliminate duplicate consumer-local pack ownership" ;
    dct:description "After byte-equivalence and exact-subject qualification, retain marketplace source as canonical and consumer copies only as generated or pinned consequences." ;
    dct:relation <https://github.com/seanchatmangpt/ggen-marketplace/tree/main/packs> ;
    prov:wasGeneratedBy <urn:ggen:innovation:errc:selection> .

<urn:ggen:innovation:proposal:eliminate-secondary-catalogs>
    a prov:Entity ;
    dct:identifier "E-002" ;
    dct:type <urn:ggen:innovation:errc:eliminate> ;
    dct:title "Eliminate hand-maintained secondary catalogs" ;
    dct:description "Derive pack discovery and identity from marketplace source and deterministic catalog generation rather than parallel metadata." ;
    dct:relation <https://github.com/seanchatmangpt/ggen-marketplace/blob/main/scripts/marketplace.py> ;
    prov:wasGeneratedBy <urn:ggen:innovation:errc:selection> .

<urn:ggen:innovation:proposal:reduce-handwritten-projections>
    a prov:Entity ;
    dct:identifier "R-001" ;
    dct:type <urn:ggen:innovation:errc:reduce> ;
    dct:title "Reduce handwritten projections" ;
    dct:description "Prefer ontology-query-template manufacture for manifests, adapters, documentation, tests, and control surfaces; retain handwritten code only for irreducible runtime boundaries." ;
    dct:relation <https://github.com/seanchatmangpt/ggen-marketplace/tree/main/packs/multicell-consumer-factory-pack> ;
    prov:wasGeneratedBy <urn:ggen:innovation:errc:selection> .

<urn:ggen:innovation:proposal:reduce-repo-path-coupling>
    a prov:Entity ;
    dct:identifier "R-002" ;
    dct:type <urn:ggen:innovation:errc:reduce> ;
    dct:title "Reduce direct repository-path coupling" ;
    dct:description "Consume immutable marketplace pack identities and digests instead of depending on mutable consumer-local source paths." ;
    dct:relation <https://github.com/seanchatmangpt/ggen-marketplace> ;
    prov:wasGeneratedBy <urn:ggen:innovation:errc:selection> .

<urn:ggen:innovation:proposal:raise-provenance>
    a prov:Entity ;
    dct:identifier "R+-001" ;
    dct:type <urn:ggen:innovation:errc:raise> ;
    dct:title "Raise exact-subject provenance" ;
    dct:description "Bind imported or generated capital to exact source repository, commit, tree, pack fingerprint, and producer standing before reuse." ;
    dct:relation <https://github.com/seanchatmangpt/ggen-marketplace/blob/main/docs/reference/provenance.md> ;
    prov:wasGeneratedBy <urn:ggen:innovation:errc:selection> .

<urn:ggen:innovation:proposal:raise-consumer-qualification>
    a prov:Entity ;
    dct:identifier "R+-002" ;
    dct:type <urn:ggen:innovation:errc:raise> ;
    dct:title "Raise independent consumer qualification" ;
    dct:description "Require the selected pack composition to regenerate and qualify on each exact consumer subject; producer validation alone cannot crown the consumer." ;
    dct:relation <https://github.com/seanchatmangpt/ggen-marketplace/tree/main/packs/multicell-consumer-factory-pack> ;
    prov:wasGeneratedBy <urn:ggen:innovation:errc:selection> .

<urn:ggen:innovation:proposal:create-errc-control>
    a prov:Entity ;
    dct:identifier "C-001" ;
    dct:type <urn:ggen:innovation:errc:create> ;
    dct:title "Create executable ERRC selection capital" ;
    dct:description "Represent value-innovation choices as admitted RDF, fail-closed queries, and deterministic projections that carry SELECT authority only." ;
    dct:relation <urn:ggen:innovation:errc> ;
    prov:wasGeneratedBy <urn:ggen:innovation:errc:selection> .

<urn:ggen:innovation:proposal:create-gym-composition-frontier>
    a prov:Entity ;
    dct:identifier "C-002" ;
    dct:type <urn:ggen:innovation:errc:create> ;
    dct:title "Create gym-family marketplace composition frontier" ;
    dct:description "Compose gym-specific packs with shared OCEL, SHACL, standing, receipt, replay, and multicell factory capital instead of maintaining isolated gym stacks." ;
    dct:relation <https://github.com/seanchatmangpt/ggen-marketplace/tree/main/packs/multicell-consumer-factory-pack> ;
    prov:wasGeneratedBy <urn:ggen:innovation:errc:selection> .
