# MESSAGE: ERRC strategy activities are SELECT-only and must not claim other authority
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?activity ?authority WHERE {
  ?activity a prov:Activity ;
            prov:used <urn:ggen:innovation:errc> ;
            dct:type ?authority .
  FILTER(?authority != <urn:ggen:authority:SELECT>)
}
ORDER BY ?activity ?authority
