# MESSAGE: every ERRC quadrant must contain at least one proposal
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?missingCategory WHERE {
  VALUES ?missingCategory {
    <urn:ggen:innovation:errc:eliminate>
    <urn:ggen:innovation:errc:reduce>
    <urn:ggen:innovation:errc:raise>
    <urn:ggen:innovation:errc:create>
  }
  FILTER NOT EXISTS {
    ?proposal a prov:Entity ;
              dct:type ?missingCategory ;
              prov:wasGeneratedBy <urn:ggen:innovation:errc:selection> .
  }
}
ORDER BY ?missingCategory
