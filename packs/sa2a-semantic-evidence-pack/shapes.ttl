@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sa2a: <https://graphlaw.dev/sa2a#> .

sa2a:EvidenceEnvelopeContractShape a sh:NodeShape ;
  sh:targetClass sa2a:EvidenceEnvelopeContract ;
  sh:property [ sh:path sa2a:schema ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path sa2a:contractVersion ; sh:hasValue "v26.9.29" ] ;
  sh:property [ sh:path sa2a:canonicalization ; sh:hasValue "RDFC-1.0" ] ;
  sh:property [ sh:path sa2a:authority ; sh:hasValue "NONE" ] ;
  sh:property [ sh:path sa2a:consequence ; sh:hasValue "EVIDENCE_ONLY" ] ;
  sh:property [ sh:path sa2a:requiresExactSubject ; sh:hasValue true ] ;
  sh:property [ sh:path sa2a:requiresSourceDigest ; sh:hasValue true ] ;
  sh:property [ sh:path sa2a:requiresReplayIdentity ; sh:hasValue true ] .
