PREFIX sa2a: <https://graphlaw.dev/sa2a#>
SELECT ?schema ?contractVersion ?canonicalization ?authority ?consequence
       ?requiresExactSubject ?requiresSourceDigest ?requiresReplayIdentity
       ?graphlawContractCommit ?sourceProducer
WHERE {
  sa2a:DefaultEvidenceEnvelopeContract
    sa2a:schema ?schema ;
    sa2a:contractVersion ?contractVersion ;
    sa2a:canonicalization ?canonicalization ;
    sa2a:authority ?authority ;
    sa2a:consequence ?consequence ;
    sa2a:requiresExactSubject ?requiresExactSubject ;
    sa2a:requiresSourceDigest ?requiresSourceDigest ;
    sa2a:requiresReplayIdentity ?requiresReplayIdentity ;
    sa2a:graphlawContractCommit ?graphlawContractCommit ;
    sa2a:sourceProducer ?sourceProducer .
}
ORDER BY ?schema
