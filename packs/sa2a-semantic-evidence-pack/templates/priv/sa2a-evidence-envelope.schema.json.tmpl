{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SA2A Semantic Evidence Envelope",
  "type": "object",
  "required": ["schema", "contractVersion", "canonicalization", "authority", "consequence", "subject", "source", "graphDigest", "replayIdentity", "provenance", "envelopeDigest"],
  "properties": {
    "schema": {"const": "{{ results[0]["schema"] }}"},
    "contractVersion": {"const": "{{ results[0]["contractVersion"] }}"},
    "canonicalization": {"const": "{{ results[0]["canonicalization"] }}"},
    "authority": {"const": "{{ results[0]["authority"] }}"},
    "consequence": {"const": "{{ results[0]["consequence"] }}"},
    "subject": {"type": "string", "minLength": 1},
    "source": {"type": "object", "required": ["id", "uri", "graph", "subjectTemplate", "digest"]},
    "graphDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "replayIdentity": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"},
    "envelopeDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
