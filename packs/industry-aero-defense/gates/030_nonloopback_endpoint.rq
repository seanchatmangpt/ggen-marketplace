# MESSAGE: non-loopback endpoint inside an air-gap boundary.
# The air-gap law: any ad:endpoint on an ad:AirGapBoundary that is not
# 127.0.0.1 / localhost / [::1] is a row (a refusal). Network faces are
# deliberately ABSENT; this gate encodes the absence.
PREFIX ad: <https://seanchatmangpt.github.io/packs/industry-aero-defense#>
SELECT ?boundary ?endpoint WHERE {
  ?boundary a ad:AirGapBoundary ;
            ad:endpoint ?endpoint .
  FILTER (!REGEX(STR(?endpoint), "^https?://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:|/|$)"))
}
