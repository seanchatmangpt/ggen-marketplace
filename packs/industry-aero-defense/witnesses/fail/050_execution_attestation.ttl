# FAIL witness 050 (P2 attestation): a VerifiableExecutionProof without the
# attestor's measurement fingerprint — the 050 law is the ONLY law broken
# (proves a complete, sealed artifact; every other gate silent).
@prefix ex: <https://example.org/aero-defense#> .
@prefix ad: <https://seanchatmangpt.github.io/packs/industry-aero-defense#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex:analyst-050f a ad:Principal ;
    ad:clearanceLevel ad:Secret .

ex:artifact-050f a ad:ClassifiedArtifact ;
    ad:classification ad:Secret ; ad:caveat "NOFORN" ;
    ad:needToKnowPrincipal ex:analyst-050f ;
    ad:hasSeal ex:seal-050f .

ex:seal-050f a ad:Seal ;
    ad:sealedRoot "sha256:44442f10a9c8d7e6f5a4b3c2d1e0f9a8b7b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4" .

ex:proof-050f a ad:VerifiableExecutionProof ;
    ad:proofDigest "sha256:bbbbe3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2" .
    # no ad:measurementFingerprint — the refusal
