# FAIL witness 070 (P3 proposer-judge): an AIContribution proposing a mutation
# adjudicated only by a plain prov:Activity (not an ad:JudgeActivity) — the
# 070 law is the ONLY law broken (the proposed artifact is otherwise complete:
# classification, caveat, principal, store, seal).
@prefix ex: <https://example.org/aero-defense#> .
@prefix ad: <https://seanchatmangpt.github.io/packs/industry-aero-defense#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex:analyst-070f a ad:Principal ;
    ad:clearanceLevel ad:Secret .

ex:artifact-070f a ad:ClassifiedArtifact ;
    ad:classification ad:Secret ; ad:caveat "NOFORN" ;
    ad:needToKnowPrincipal ex:analyst-070f ;
    ad:storedIn ex:store-070f ;
    ad:hasSeal ex:seal-070f .

ex:store-070f a ad:Store .

ex:seal-070f a ad:Seal ;
    ad:sealedRoot "sha256:66662f10a9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2" .

ex:generator-070f a prov:Activity .

ex:ai-070f a ad:AIContribution ;
    ad:proposes ex:artifact-070f ;
    ad:adjudicatedBy ex:generator-070f .
