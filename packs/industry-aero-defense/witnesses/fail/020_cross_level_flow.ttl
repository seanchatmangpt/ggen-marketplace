@prefix ex: <https://example.org/aero-defense#> .
# FAIL witness 020: Confidential -> TopSecret is a cross-level spill (row = refusal).
# Both artifacts are otherwise lawful (classification + caveat + cleared principal):
# the ONLY law broken is the cross-level flow law.
@prefix ad: <https://seanchatmangpt.github.io/packs/industry-aero-defense#> .

ex:principal-020f a ad:Principal ;
    ad:clearanceLevel ad:TopSecret .

ex:conf-src a ad:ClassifiedArtifact ;
    ad:classification ad:Confidential ; ad:caveat "REL-ID" ;
    ad:needToKnowPrincipal ex:principal-020f .

ex:ts-sink a ad:ClassifiedArtifact ;
    ad:classification ad:TopSecret ; ad:caveat "NOFORN" ;
    ad:needToKnowPrincipal ex:principal-020f .

ex:conf-src ad:dataFlow ex:ts-sink .
