@prefix ex: <https://example.org/aero-defense#> .
# PASS witness 010: a complete classified artifact (classification + caveat + cleared principal).
@prefix ad: <https://seanchatmangpt.github.io/packs/industry-aero-defense#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex: a ad:AirGapBoundary ;
    ad:endpoint "http://127.0.0.1:9443" .

ex:analyst-j-doe a ad:Principal , prov:Agent ;
    ad:clearanceLevel ad:Secret .

ex:flight-ctrl-swd a ad:ClassifiedArtifact , prov:Entity ;
    ad:classification ad:Secret ;
    ad:caveat "NOFORN" ;
    ad:needToKnowPrincipal ex:analyst-j-doe .
