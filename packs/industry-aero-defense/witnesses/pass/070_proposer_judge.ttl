# PASS witness 070 (P3 proposer-judge): an AIContribution proposing a mutation
# against a fully-lawful classified scene, adjudicated by an ad:JudgeActivity;
# every other gate silent.
@prefix ex: <https://example.org/aero-defense#> .
@prefix ad: <https://seanchatmangpt.github.io/packs/industry-aero-defense#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex:analyst-070p a ad:Principal ;
    ad:clearanceLevel ad:Secret .

ex:artifact-070p a ad:ClassifiedArtifact ;
    ad:classification ad:Secret ; ad:caveat "NOFORN" ;
    ad:needToKnowPrincipal ex:analyst-070p ;
    ad:storedIn ex:store-070p ;
    ad:hasSeal ex:seal-070p .

ex:store-070p a ad:Store .

ex:seal-070p a ad:Seal ;
    ad:sealedRoot "sha256:55552f10a9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2" .

ex:judge-070p a ad:JudgeActivity .

ex:ai-070p a ad:AIContribution ;
    ad:proposes ex:artifact-070p ;
    ad:adjudicatedBy ex:judge-070p .
