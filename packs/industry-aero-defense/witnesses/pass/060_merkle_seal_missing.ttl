# PASS witness 060 (P5 Merkle self-auth): classified artifact referencing a
# sealed root; all gates silent.
@prefix ex: <https://example.org/aero-defense#> .
@prefix ad: <https://seanchatmangpt.github.io/packs/industry-aero-defense#> .

ex:analyst-060 a ad:Principal ;
    ad:clearanceLevel ad:Secret .

ex:artifact-060 a ad:ClassifiedArtifact ;
    ad:classification ad:Secret ; ad:caveat "NOFORN" ;
    ad:needToKnowPrincipal ex:analyst-060 ;
    ad:hasSeal ex:seal-060p .

ex:seal-060p a ad:Seal ;
    ad:sealedRoot "sha256:55552f10a9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2" .
