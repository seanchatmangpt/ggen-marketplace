@prefix ex: <https://example.org/aero-defense#> .
# PASS witness 020: same-level and down-level flows only.
@prefix ad: <https://seanchatmangpt.github.io/packs/industry-aero-defense#> .

ex:secret-brief a ad:ClassifiedArtifact ;
    ad:classification ad:Secret ; ad:caveat "NOFORN" .

ex:conf-brief a ad:ClassifiedArtifact ;
    ad:classification ad:Confidential ; ad:caveat "REL-ID" .

# Secret -> Confidential is down-level: lawful.
ex:secret-brief ad:dataFlow ex:conf-brief .
