# autofde-lab's real OpenClaw capability surface, classified with GymAct's
# two real consequence-class IRIs. ZERO new RDF vocabulary: only
# sosa:Procedure individuals, per gymact/.claude/rules/ontology.md.
#
# Ground truth: vendor/autofde-lab/src/autofde_lab/openclaw_bridge.py
# `_TOOL_SPECS` (4 entries) at head edca036e02526014c5298b0cefd287c68ec0eab4;
# MCP tool names are TOOL_NAME_PREFIX ("autofde_lab_") + spec name,
# openclaw_runtime.py:357.

@prefix dct: <http://purl.org/dc/terms/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# openclaw_bridge.py: "List registered scikit-decide domains and solvers."
<urn:autofde-lab:capability:catalog>
    a sosa:Procedure ;
    dct:title "catalog" ;
    dct:type <urn:gymact:consequence:read> .

# openclaw_bridge.py: "Describe one registered domain or solver."
<urn:autofde-lab:capability:describe>
    a sosa:Procedure ;
    dct:title "describe" ;
    dct:type <urn:gymact:consequence:read> .

# openclaw_bridge.py: "Construct a registered domain and list compatible
# solvers." In-process construction over the registry only; no external
# world change, so READ under GymAct's two-class partition.
<urn:autofde-lab:capability:match>
    a sosa:Procedure ;
    dct:title "match" ;
    dct:type <urn:gymact:consequence:read> .

# openclaw_bridge.py: "Run a bounded rollout using registered subjects only."
# The single DO-classified capability. Bounded by the tool's own schema
# (timeout_seconds <= 600, num_episodes <= 100, max_steps <= 10000).
<urn:autofde-lab:capability:run>
    a sosa:Procedure ;
    dct:title "run" ;
    dct:type <urn:gymact:consequence:do> .
