//! GENERATED by ggen. MCP tool names use autofde-lab's real
//! `TOOL_NAME_PREFIX = "autofde_lab_"`
//! (vendor/autofde-lab/src/autofde_lab/openclaw_runtime.py:357), so generated
//! names never collide with GymAct's own `gymact.*` MCP surface.
//!
//! `consequence_class` is a schema field, not an enforcement point: an MCP tool
//! call manufactures an intent, it never grants execution authority. Do not edit.

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct McpToolSchema {
    pub name: &'static str,
    pub consequence_class: &'static str,
}

/// All {{ ops | length }} generated MCP tool schemas, ordered by tool name.
pub const MCP_TOOLS: &[McpToolSchema] = &[
{% for row in ops -%}
    McpToolSchema { name: "autofde_lab_{{ row.id }}", consequence_class: "{{ row.consequence_class }}" },
{% endfor -%}
];

pub fn lookup_mcp_tool(name: &str) -> Option<&'static McpToolSchema> {
    MCP_TOOLS.iter().find(|t| t.name == name)
}

/// The subset whose real execution requires a fail-closed authority decision
/// before it may cause a consequence.
pub fn do_class_tools() -> Vec<&'static McpToolSchema> {
    MCP_TOOLS
        .iter()
        .filter(|t| t.consequence_class == "Do")
        .collect()
}

pub fn mcp_tool_count() -> usize {
    MCP_TOOLS.len()
}
