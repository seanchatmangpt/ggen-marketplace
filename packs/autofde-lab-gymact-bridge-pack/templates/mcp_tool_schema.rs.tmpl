to: "src/autofde_lab_mcp_tools.rs"
shape:
  - shapes/profile.shacl.ttl
sparql:
  ops: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id ?consequence_class
    WHERE {
      ?cap a sosa:Procedure ; dct:title ?id ; dct:type ?class .
      BIND(IF(CONTAINS(STR(?class), "consequence:do"), "Do", "Read") AS ?consequence_class)
    }
    ORDER BY ?id
