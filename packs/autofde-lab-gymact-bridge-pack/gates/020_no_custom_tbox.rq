# MESSAGE: this pack must stay public-vocabulary ABox only. Any row means a local
# TBox declaration or local predicate leaked into the admitted graph. In
# particular it refuses autofde-lab's LOCAL ga: 4-value consequence vocabulary
# (READ/PREPARE/DO/VERIFY, vendor/autofde-lab/gymact/ontology/gymact.ttl), which
# is not GymAct's real 2-IRI classification.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?term ?problem WHERE {
  {
    ?term a ?kind .
    VALUES ?kind { owl:Class owl:ObjectProperty owl:DatatypeProperty rdfs:Class rdf:Property }
    BIND("local-tbox" AS ?problem)
  }
  UNION
  {
    ?s ?term ?o .
    FILTER(STRSTARTS(STR(?term), "urn:autofde-lab:"))
    BIND("local-predicate" AS ?problem)
  }
}
ORDER BY ?term ?problem
