# Pack gate-court witness — committed provenance of the witnessed sync.
@prefix sw: <https://strata.chatman.ai/ontology/witness#> .

<https://strata.chatman.ai/witness/strata-hash-pack> a sw:GateRun ;
    sw:pack <https://strata.chatman.ai/pack/strata-hash-pack> ;
    sw:syncedGraphHash "e50162ab4b12e08b5a8874c52798f63a14ba0bfac6d6082d8f303536058ce6ce" ;
    sw:date "2026-10-13" ;
    sw:andon "Green" ;
    sw:zeroRows true .

sw:gate-010_digest_length a sw:GateRun ;
    sw:gate "010_digest_length.rq" ;
    sw:syncedGraphHash "79a1312bd61510b3abea390ff5c328abf8bc9fe45c0d8182380d8a249ba6afcf" ;
    sw:date "2026-10-13" ;
    sw:andon "Green" ;
    sw:zeroRows true .

sw:gate-020_algorithm_closure a sw:GateRun ;
    sw:gate "020_algorithm_closure.rq" ;
    sw:syncedGraphHash "272cb16676cc25bac42bbf4ada2a8e319cc7bfe449778548916b55c6688fee1e" ;
    sw:date "2026-10-13" ;
    sw:andon "Green" ;
    sw:zeroRows true .

# BLAKE3 KAT fixture (lane L194, post-L167 consolidation): the pack owns the
# canonical BLAKE3, so its witness must pin spec vectors, not just gate
# row-counts. Two pins:
#   1. the BLAKE3 spec vector for the empty input (BLAKE3 paper, Appendix —
#      also the first vector of the reference test suite);
#   2. one canonical fold input/output over this pack's own namespace.
# verify.py recomputes both digests with the `b3sum` binary (provenance:
# /opt/homebrew/bin/b3sum, Homebrew BLAKE3 core team build) and refuses
# divergence — Python's hashlib has no blake3.
sw:blake3-kat a sw:GateRun ;
    sw:gate "blake3-kat" ;
    sw:katEmptyInputDigest "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262" ;
    sw:katFoldInput "strata-hash-pack/kat/fold" ;
    sw:katFoldDigest "d611761500365847f31b5dc404e84b0ab82e09877992a397f77d57cc7bd8f024" ;
    sw:date "2026-10-13" ;
    sw:andon "Green" ;
    sw:zeroRows true .
