---
to: "src/gym_upper_consequence_crosswalk.rs"
sparql:
  classes: |
    PREFIX gu: <http://seanchatmangpt.github.io/packs/gym-upper#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT DISTINCT ?notation ?label
    WHERE { ?c a gu:ConsequenceClass ; skos:notation ?notation ; skos:prefLabel ?label . }
    ORDER BY ?notation
  aliases: |
    PREFIX gu: <http://seanchatmangpt.github.io/packs/gym-upper#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT DISTINCT ?alias ?notation
    WHERE { ?c a gu:ConsequenceClass ; skos:notation ?notation ; skos:exactMatch ?alias . }
    ORDER BY ?alias
  caps: |
    PREFIX gu: <http://seanchatmangpt.github.io/packs/gym-upper#>
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX dcp: <http://seanchatmangpt.github.io/packs/domain-capability#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT DISTINCT ?id ?notation ?encoding
    WHERE {
      {
        ?cap a sosa:Procedure ; dct:title ?id ; dct:type ?c .
        ?c skos:notation ?notation .
        BIND("dct:type-iri" AS ?encoding)
      } UNION {
        ?cap a sosa:Procedure ; skos:prefLabel ?id ; dct:relation ?notation .
        BIND("dct:relation-literal" AS ?encoding)
      } UNION {
        ?cap a dcp:Capability ; dcp:slug ?id ; dcp:consequence ?notation .
        BIND("dcp:consequence-literal" AS ?encoding)
      }
    }
    ORDER BY ?id ?encoding
---
//! GENERATED by ggen from gym-upper-ontology-pack. Do not edit.
//!
//! Crosswalk over the consequence-class encodings the gym packs each minted
//! separately. gu:DO is an INTENT class: nothing here grants runtime authority;
//! consequential DO remains behind external GymAct/BRCE admission.

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ConsequenceClass { pub notation: &'static str, pub label: &'static str }

pub const CONSEQUENCE_CLASSES: &[ConsequenceClass] = &[
{% for row in classes -%}
    ConsequenceClass { notation: "{{ row.notation }}", label: "{{ row.label }}" },
{% endfor -%}
];

/// Legacy IRIs that other packs already reference; each resolves to a notation here.
pub const LEGACY_IRI_ALIASES: &[(&str, &str)] = &[
{% for row in aliases -%}
    ("{{ row.alias }}", "{{ row.notation }}"),
{% endfor -%}
];

/// (capability id, consequence notation, source encoding) resolved across every
/// spelling found in the real gym ontologies.
pub const RESOLVED_CAPABILITIES: &[(&str, &str, &str)] = &[
{% for row in caps -%}
    ("{{ row.id }}", "{{ row.notation }}", "{{ row.encoding }}"),
{% endfor -%}
];

pub fn resolve_legacy_iri(iri: &str) -> Option<&'static str> {
    LEGACY_IRI_ALIASES.iter().find(|(a, _)| *a == iri).map(|(_, n)| *n)
}

pub fn consequence_of(id: &str) -> Option<&'static str> {
    RESOLVED_CAPABILITIES.iter().find(|(c, _, _)| *c == id).map(|(_, n, _)| *n)
}
