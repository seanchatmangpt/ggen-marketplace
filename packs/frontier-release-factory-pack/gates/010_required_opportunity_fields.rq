PREFIX frf: <https://ggen.io/ontology/frontier-release-factory#>

SELECT ?opportunity ?missing
WHERE {
  ?opportunity a frf:Opportunity .
  {
    FILTER NOT EXISTS { ?opportunity frf:responseMode ?value }
    BIND("responseMode" AS ?missing)
  }
  UNION
  {
    FILTER NOT EXISTS { ?opportunity frf:targetRepository ?value }
    BIND("targetRepository" AS ?missing)
  }
  UNION
  {
    FILTER NOT EXISTS { ?opportunity frf:requiredCapability ?value }
    BIND("requiredCapability" AS ?missing)
  }
  UNION
  {
    FILTER NOT EXISTS { ?opportunity frf:benchmark ?value }
    BIND("benchmark" AS ?missing)
  }
}
