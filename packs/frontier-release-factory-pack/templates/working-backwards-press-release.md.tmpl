---
to: "releases/working-backwards/{{ slug }}.md"
for_each: rows
sparql:
  rows: |
    PREFIX frf: <https://ggen.io/ontology/frontier-release-factory#>
    SELECT ?opportunity ?slug ?release_title ?source_url ?publisher ?observed_claim
           ?reported_metric ?reported_cost ?customer_problem ?response_mode
           ?target_repository ?required_capability ?benchmark_id
           ?acceptance_predicate ?falsifier ?launch_claim
    WHERE {
      ?opportunity a frf:Opportunity ;
                   frf:slug ?slug ;
                   frf:responseMode ?response_mode ;
                   frf:targetRepository ?target_repository ;
                   frf:requiredCapability ?required_capability ;
                   frf:benchmark ?benchmark .
      ?benchmark frf:benchmarkId ?benchmark_id ;
                 frf:acceptancePredicate ?acceptance_predicate ;
                 frf:falsifier ?falsifier .
      OPTIONAL { ?opportunity frf:releaseTitle ?release_title . }
      OPTIONAL { ?opportunity frf:customerProblem ?customer_problem . }
      OPTIONAL { ?opportunity frf:launchClaim ?launch_claim . }
      OPTIONAL {
        ?source frf:derivedOpportunity ?opportunity ;
                frf:sourceUrl ?source_url ;
                frf:publisher ?publisher ;
                frf:observedClaim ?claim .
        OPTIONAL { ?claim frf:claimText ?observed_claim . }
        OPTIONAL { ?claim frf:reportedMetric ?reported_metric . }
        OPTIONAL { ?claim frf:reportedCost ?reported_cost . }
      }
    }
    ORDER BY ?slug
---
