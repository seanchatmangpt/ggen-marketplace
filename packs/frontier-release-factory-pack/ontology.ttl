@prefix frf: <https://ggen.io/ontology/frontier-release-factory#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://ggen.io/ontology/frontier-release-factory#> a owl:Ontology ;
  rdfs:label "Frontier Release Factory" ;
  rdfs:comment "Canonical vocabulary for turning external frontier announcements into bounded benchmark opportunities, working-backwards launch contracts, implementation obligations, evidence receipts, and earned releases. Source claims are observations, never authority or standing by themselves." .

frf:SourceRelease a rdfs:Class ;
  rdfs:label "Source release" .
frf:Claim a rdfs:Class ;
  rdfs:label "Observed claim" .
frf:Opportunity a rdfs:Class ;
  rdfs:label "Bounded response opportunity" .
frf:Benchmark a rdfs:Class ;
  rdfs:label "Executable comparison benchmark" .
frf:WorkingBackwardsRelease a rdfs:Class ;
  rdfs:label "Working-backwards press release" .
frf:AcceptanceContract a rdfs:Class ;
  rdfs:label "Machine-readable acceptance contract" .
frf:EvidenceReceipt a rdfs:Class ;
  rdfs:label "Execution evidence receipt" .
frf:EarnedRelease a rdfs:Class ;
  rdfs:label "Evidence-backed real press release" .
frf:FactoryStage a rdfs:Class ;
  rdfs:label "Factory stage" .

frf:sourceUrl a rdf:Property ; rdfs:domain frf:SourceRelease ; rdfs:range xsd:anyURI .
frf:publisher a rdf:Property ; rdfs:domain frf:SourceRelease ; rdfs:range xsd:string .
frf:publishedAt a rdf:Property ; rdfs:domain frf:SourceRelease ; rdfs:range xsd:dateTime .
frf:contentDigest a rdf:Property ; rdfs:domain frf:SourceRelease ; rdfs:range xsd:string .
frf:observedClaim a rdf:Property ; rdfs:domain frf:SourceRelease ; rdfs:range frf:Claim .
frf:claimText a rdf:Property ; rdfs:domain frf:Claim ; rdfs:range xsd:string .
frf:claimKind a rdf:Property ; rdfs:domain frf:Claim ; rdfs:range xsd:string .
frf:reportedMetric a rdf:Property ; rdfs:domain frf:Claim ; rdfs:range xsd:string .
frf:reportedCost a rdf:Property ; rdfs:domain frf:Claim ; rdfs:range xsd:string .
frf:derivedOpportunity a rdf:Property ; rdfs:domain frf:SourceRelease ; rdfs:range frf:Opportunity .
frf:responseMode a rdf:Property ; rdfs:domain frf:Opportunity ; rdfs:range xsd:string .
frf:targetRepository a rdf:Property ; rdfs:domain frf:Opportunity ; rdfs:range xsd:string .
frf:requiredCapability a rdf:Property ; rdfs:domain frf:Opportunity ; rdfs:range xsd:string .
frf:benchmark a rdf:Property ; rdfs:domain frf:Opportunity ; rdfs:range frf:Benchmark .
frf:benchmarkId a rdf:Property ; rdfs:domain frf:Benchmark ; rdfs:range xsd:string .
frf:metric a rdf:Property ; rdfs:domain frf:Benchmark ; rdfs:range xsd:string .
frf:acceptancePredicate a rdf:Property ; rdfs:domain frf:Benchmark ; rdfs:range xsd:string .
frf:falsifier a rdf:Property ; rdfs:domain frf:Benchmark ; rdfs:range xsd:string .
frf:dependsOn a rdf:Property ; rdfs:range rdfs:Resource .
frf:standing a rdf:Property ; rdfs:range xsd:string .
frf:evidenceRef a rdf:Property ; rdfs:domain frf:EvidenceReceipt ; rdfs:range xsd:string .
frf:subjectIdentity a rdf:Property ; rdfs:domain frf:EvidenceReceipt ; rdfs:range xsd:string .
frf:verifierIdentity a rdf:Property ; rdfs:domain frf:EvidenceReceipt ; rdfs:range xsd:string .
frf:replayRef a rdf:Property ; rdfs:domain frf:EvidenceReceipt ; rdfs:range xsd:string .
frf:supportsClaim a rdf:Property ; rdfs:domain frf:EvidenceReceipt ; rdfs:range frf:Claim .
frf:ordinal a rdf:Property ; rdfs:domain frf:FactoryStage ; rdfs:range xsd:integer .
frf:stageName a rdf:Property ; rdfs:domain frf:FactoryStage ; rdfs:range xsd:string .

frf:Observe a frf:FactoryStage ; frf:ordinal 1 ; frf:stageName "observe" .
frf:Extract a frf:FactoryStage ; frf:ordinal 2 ; frf:stageName "extract" ; frf:dependsOn frf:Observe .
frf:Fence a frf:FactoryStage ; frf:ordinal 3 ; frf:stageName "fence" ; frf:dependsOn frf:Extract .
frf:Invert a frf:FactoryStage ; frf:ordinal 4 ; frf:stageName "invert" ; frf:dependsOn frf:Fence .
frf:Specify a frf:FactoryStage ; frf:ordinal 5 ; frf:stageName "specify" ; frf:dependsOn frf:Invert .
frf:Manufacture a frf:FactoryStage ; frf:ordinal 6 ; frf:stageName "manufacture" ; frf:dependsOn frf:Specify .
frf:Verify a frf:FactoryStage ; frf:ordinal 7 ; frf:stageName "verify" ; frf:dependsOn frf:Manufacture .
frf:Publish a frf:FactoryStage ; frf:ordinal 8 ; frf:stageName "publish" ; frf:dependsOn frf:Verify .

frf:Reuse a rdf:Resource ; rdfs:label "reuse" .
frf:Compose a rdf:Resource ; rdfs:label "compose" .
frf:Extend a rdf:Resource ; rdfs:label "extend" .
frf:Invent a rdf:Resource ; rdfs:label "invent" .

frf:FactoryContract a frf:AcceptanceContract ;
  dct:title "Frontier Release Factory v1" ;
  frf:acceptancePredicate "earned release claims are a subset of working-backwards claims with exact-subject execution evidence" ;
  frf:falsifier "a generated earned release contains a claim without a replayable evidence receipt or treats source-release prose as authority" ;
  frf:standing "CANDIDATE" .
