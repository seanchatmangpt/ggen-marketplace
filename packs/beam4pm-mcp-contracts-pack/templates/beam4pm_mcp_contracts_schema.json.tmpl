---
to: generated/schema/beam4pm_mcp_contracts.schema.json
sparql:
  messages: |
    PREFIX mcp: <https://ggen.dev/ontology/beam4pm-mcp#>
    SELECT ?message_name ?message_doc WHERE {
      ?mt a mcp:MessageType ; mcp:messageName ?message_name ; mcp:messageDoc ?message_doc .
    } ORDER BY ?message_name
  fields: |
    PREFIX mcp: <https://ggen.dev/ontology/beam4pm-mcp#>
    SELECT ?message_name ?field_name ?field_type ?field_doc ?field_required ?field_order WHERE {
      ?mt a mcp:MessageType ; mcp:messageName ?message_name ; mcp:hasField ?f .
      ?f mcp:fieldName ?field_name ; mcp:fieldType ?field_type ; mcp:fieldDoc ?field_doc ;
         mcp:fieldRequired ?field_required ; mcp:fieldOrder ?field_order .
    } ORDER BY ?message_name ?field_order
---
{
  "$comment": "GENERATED by ggen from the admitted mcp:MessageType graph. Do not edit.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
{%- for r in messages %}
{%- set rfields = fields | filter(attribute="message_name", value=r.message_name) %}
{%- set required_fields = rfields | filter(attribute="field_required", value="true") %}
    "{{ r.message_name }}": {
      "type": "object",
      "description": {{ r.message_doc | json_encode | safe }},
      "properties": {
{%- for f in rfields %}
        "{{ f.field_name }}": {
{%- if f.field_type == "string" or f.field_type == "datetime" or f.field_type == "atom" %}
          "type": "string",
{%- elif f.field_type == "integer" %}
          "type": "integer",
{%- elif f.field_type == "float" %}
          "type": "number",
{%- elif f.field_type == "boolean" %}
          "type": "boolean",
{%- elif f.field_type == "list_string" %}
          "type": "array",
          "items": { "type": "string" },
{%- elif f.field_type == "map" %}
          "type": "object",
{%- endif %}
          "description": {{ f.field_doc | json_encode | safe }}
        }{% if not loop.last %},{% endif %}
{%- endfor %}
      }{% if required_fields | length > 0 %},
      "required": [
{%- for f in required_fields %}"{{ f.field_name }}"{% if not loop.last %}, {% endif %}{% endfor %}
      ]
{%- endif %}

    }{% if not loop.last %},{% endif %}
{%- endfor %}
  }
}
