{%- for f in rfields %}
    ?assertEqual({% if f.field_type == "string" %}<<"sample_{{ f.field_name }}">>{% elif f.field_type == "integer" %}42{% elif f.field_type == "float" %}3.5{% elif f.field_type == "boolean" %}true{% elif f.field_type == "datetime" %}<<"2026-08-29T12:00:00Z">>{% elif f.field_type == "atom" %}<<"sample_atom">>{% elif f.field_type == "list_string" %}[<<"alpha">>, <<"beta">>]{% elif f.field_type == "map" %}#{<<"k">> => <<"v">>}{% endif %}, maps:get(<<"{{ f.field_name }}">>, Map)),
