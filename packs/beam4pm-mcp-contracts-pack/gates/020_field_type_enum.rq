# MESSAGE: every mcp:Field's mcp:fieldType must be one of the 8 admitted enum values; any row is a refusal.
PREFIX mcp: <https://ggen.dev/ontology/beam4pm-mcp#>
SELECT ?subject ?value WHERE {
  ?subject a mcp:Field ; mcp:fieldType ?value .
  FILTER(STR(?value) NOT IN ("string", "integer", "float", "boolean", "datetime", "atom", "list_string", "map"))
}
ORDER BY ?subject
