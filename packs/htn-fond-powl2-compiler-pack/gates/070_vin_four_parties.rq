# MESSAGE: VIN repair domain must declare exactly four vin:Party (when any party exists).
PREFIX vin: <https://ggen.dev/ontology/vin-repair#>
SELECT ?violation ?subject WHERE {
  {
    SELECT (COUNT(?party) AS ?count) WHERE { ?party a vin:Party }
  }
  FILTER(?count > 0 && ?count != 4)
  BIND("VIN_PARTY_COUNT" AS ?violation)
  BIND(<urn:ggen:pack:htn-fond-powl2-compiler-pack> AS ?subject)
}
