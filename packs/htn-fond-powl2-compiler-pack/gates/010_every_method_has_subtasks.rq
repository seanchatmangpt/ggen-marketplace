# MESSAGE: every pp:Method must declare at least one pp:subtask; any row is a refusal.
# marketplace.py evaluates SELECT only (ASK is ignored).
PREFIX pp: <https://ggen.dev/ontology/planning-policy#>
SELECT ?violation ?subject WHERE {
  ?subject a pp:Method .
  FILTER NOT EXISTS { ?subject pp:subtask ?sub }
  BIND("METHOD_WITHOUT_SUBTASK" AS ?violation)
}
ORDER BY ?subject
