# MESSAGE: Surface C — refuse >64 powl:PlaceSlot (BoundExceeded discipline; never truncate).
PREFIX powl: <https://ggen.dev/ontology/powl2#>
SELECT ?violation ?subject WHERE {
  {
    SELECT (COUNT(?slot) AS ?count) WHERE { ?slot a powl:PlaceSlot }
  }
  FILTER(?count > 64)
  BIND("PLACES_OVER_64" AS ?violation)
  BIND(<urn:ggen:pack:htn-fond-powl2-compiler-pack> AS ?subject)
}
