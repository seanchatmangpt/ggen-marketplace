# MESSAGE: child pccf:Lease ceiling must not exceed parent ceiling.
PREFIX pccf: <https://ggen.dev/ontology/pccf#>
SELECT ?violation ?subject WHERE {
  ?subject a pccf:Lease ;
           pccf:parentLease ?parent ;
           pccf:leaseCeiling ?childCeil .
  ?parent pccf:leaseCeiling ?parentCeil .
  FILTER(?childCeil > ?parentCeil)
  BIND("LEASE_CEILING_EXCEEDS_PARENT" AS ?violation)
}
ORDER BY ?subject
