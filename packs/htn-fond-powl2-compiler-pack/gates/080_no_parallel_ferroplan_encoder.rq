# MESSAGE: L39 — refuse any declared "parallel ferroplan→Powl2 encoder" individual.
# Pack must adapt bcinr-pddl powl_bridge / powl2-decompose; never invent a second bridge.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX hf:   <urn:hfpowl2:>
SELECT ?violation ?subject WHERE {
  {
    ?subject a hf:ParallelFerroplanPowl2Encoder .
    BIND("PARALLEL_FERROPLAN_ENCODER" AS ?violation)
  }
  UNION
  {
    ?subject rdfs:label ?label .
    FILTER(CONTAINS(LCASE(STR(?label)), "parallel ferroplan") && CONTAINS(LCASE(STR(?label)), "powl2"))
    BIND("PARALLEL_FERROPLAN_ENCODER_LABEL" AS ?violation)
  }
}
ORDER BY ?subject ?violation
