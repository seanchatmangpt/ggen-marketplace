# MESSAGE: marking host must be cgap (bosym/ocel2/branchless); refuse fnox-mark crate claims.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX hf:   <urn:hfpowl2:>
SELECT ?violation ?subject WHERE {
  {
    ?subject a hf:FnoxMarkCrate .
    BIND("FNOX_MARK_CRATE_FORBIDDEN" AS ?violation)
  }
  UNION
  {
    ?subject hf:markingHost ?host .
    FILTER(!CONTAINS(LCASE(STR(?host)), "cgap"))
    BIND("MARKING_HOST_NOT_CGAP" AS ?violation)
  }
}
ORDER BY ?subject ?violation
