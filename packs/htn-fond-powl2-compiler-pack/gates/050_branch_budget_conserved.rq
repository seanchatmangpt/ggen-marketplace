# MESSAGE: stub — child budget must not exceed parent budget (full remainder conservation later).
PREFIX pccf: <https://ggen.dev/ontology/pccf#>
SELECT ?violation ?subject WHERE {
  ?subject a pccf:Lease ;
           pccf:parentLease ?parent ;
           pccf:leaseBudget ?childBudget .
  ?parent pccf:leaseBudget ?parentBudget .
  FILTER(?childBudget > ?parentBudget)
  BIND("LEASE_BUDGET_EXCEEDS_PARENT" AS ?violation)
}
ORDER BY ?subject
