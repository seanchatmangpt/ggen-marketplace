# MESSAGE: every pp:Primitive (FOND action) must declare at least one pp:hasOutcome.
PREFIX pp: <https://ggen.dev/ontology/planning-policy#>
SELECT ?violation ?subject WHERE {
  ?subject a pp:Primitive .
  FILTER NOT EXISTS { ?subject pp:hasOutcome ?outcome }
  BIND("ACTION_WITHOUT_OUTCOME" AS ?violation)
}
ORDER BY ?subject
