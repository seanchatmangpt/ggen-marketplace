# MESSAGE: Surface A — refuse >64 tape ops (mirrors powl_bridge BoundExceeded).
PREFIX hf:   <urn:hfpowl2:>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
SELECT ?violation ?subject WHERE {
  ?subject a hf:PlanTape ;
           hf:tapeOpCount ?n .
  FILTER(?n > 64)
  BIND("TAPE_OPS_OVER_64" AS ?violation)
}
ORDER BY ?subject
