# htn-fond-powl2-compiler-pack — vocabulary scaffold (cindy A13 prefix align).
# Full individuals / VIN domain deferred. Gates are SELECT stubs over this graph.
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pp:   <https://ggen.dev/ontology/planning-policy#> .
@prefix powl: <https://ggen.dev/ontology/powl2#> .
@prefix pccf: <https://ggen.dev/ontology/pccf#> .
@prefix vin:  <https://ggen.dev/ontology/vin-repair#> .
@prefix hf:   <urn:hfpowl2:> .

<urn:ggen:pack:htn-fond-powl2-compiler-pack>
    a owl:Ontology ;
    rdfs:label "HTN-FOND → POWL2 compiler pack ontology (scaffold)" ;
    rdfs:comment """
    Prefixes locked to cindy A13 (pp:/powl:/pccf:/vin:). hf: retained only as
    a transitional alias until A14 drafts are rewritten onto powl:/pp:/pccf:.
    Three 64-bit surfaces (L39): A tape / B hierarchical Powl / C OCEL place —
    do not conflate. No individuals yet: SELECT gates return 0 rows = PASS.
    """ .

# --- Surface markers (documentation individuals; not runtime encodings) -------

hf:PlanTapeSurface a rdfs:Class ;
    rdfs:label "Surface A — TemporalPlan tape (bcinr powl_bridge)" ;
    rdfs:comment "Bit i = tape slot. Cap 64. BoundExceeded on overflow." .

hf:HierarchicalPowlSurface a rdfs:Class ;
    rdfs:label "Surface B — powl2-decompose hierarchical Powl" ;
    rdfs:comment "WF-net → Powl tree; not a u64 tape. Do not reimplement convert." .

hf:OcelPlaceMarkingSurface a rdfs:Class ;
    rdfs:label "Surface C — OCEL place bitIndex marking" ;
    rdfs:comment "Bit i = place token. Cap 64 places. Hosted in cgap, not fnox-mark." .

# --- Minimal class hooks (aligned names; expand when docs ready) -------------

powl:Model a rdfs:Class .
powl:Node a rdfs:Class .
powl:PlaceSlot a rdfs:Class .
powl:Transition a rdfs:Class .
powl:Xor a rdfs:Class ; rdfs:subClassOf powl:Node .
powl:slotIndex a owl:DatatypeProperty ; rdfs:range xsd:unsignedByte .
powl:preMask a owl:DatatypeProperty ; rdfs:range xsd:unsignedLong .
powl:postMask a owl:DatatypeProperty ; rdfs:range xsd:unsignedLong .

pp:PolicyBranch a rdfs:Class .
pp:Method a rdfs:Class .
pp:Primitive a rdfs:Class .
pp:subtask a owl:ObjectProperty .
pp:hasOutcome a owl:ObjectProperty .

pccf:Envelope a rdfs:Class .
pccf:byteLength a owl:DatatypeProperty ; rdfs:range xsd:integer .
pccf:headerBytes a owl:DatatypeProperty ; rdfs:range xsd:integer .
pccf:bulletproofBytes a owl:DatatypeProperty ; rdfs:range xsd:integer .
pccf:Lease a rdfs:Class .
pccf:parentLease a owl:ObjectProperty ; rdfs:domain pccf:Lease ; rdfs:range pccf:Lease .
pccf:leaseCeiling a owl:DatatypeProperty ; rdfs:range xsd:integer .
pccf:leaseExpiry a owl:DatatypeProperty ; rdfs:range xsd:dateTime .
pccf:leaseBudget a owl:DatatypeProperty ; rdfs:range xsd:integer .

vin:Party a rdfs:Class .
