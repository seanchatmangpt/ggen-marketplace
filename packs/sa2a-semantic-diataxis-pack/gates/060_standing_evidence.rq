PREFIX sd: <https://ggen.dev/ontology/sa2a-semantic-diataxis#>
# MESSAGE: standing is a closed vocabulary and ALIVE requires evidence
SELECT ?d WHERE {
  { ?d sd:standing ?s . FILTER(?s NOT IN ("UNKNOWN","PARTIAL_ALIVE","ALIVE","BLOCKED","BUILD_BROKEN","UNSUPPORTED") && !STRSTARTS(?s,"REFUSED:")) }
  UNION { ?d sd:standing "ALIVE" . FILTER NOT EXISTS { ?d sd:evidence ?e } } }
