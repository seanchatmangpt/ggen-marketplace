PREFIX sd: <https://ggen.dev/ontology/sa2a-semantic-diataxis#>
# MESSAGE: documents carry authority NONE; consequential steps require external authority the document cannot self-grant
SELECT ?d WHERE {
  { ?d a sd:Document ; sd:authority ?a . FILTER(?a != "NONE") }
  UNION { ?d sd:hasStep ?s . ?s sd:consequential true . FILTER NOT EXISTS { ?s sd:externalAuthority ?x } }
  UNION { ?d sd:hasStep ?s . ?s sd:externalAuthority ?x . ?d sd:authority ?a . FILTER(?a != "NONE") } }
