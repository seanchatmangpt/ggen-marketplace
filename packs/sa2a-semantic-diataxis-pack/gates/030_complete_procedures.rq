PREFIX sd: <https://ggen.dev/ontology/sa2a-semantic-diataxis#>
# MESSAGE: tutorial and how-to documents need steps with unique integer order and an action (no ambiguous procedures)
SELECT ?d WHERE {
  { ?d a sd:Document ; sd:quadrant ?q . FILTER(?q IN ("tutorial","how-to")) FILTER NOT EXISTS { ?d sd:hasStep ?s } }
  UNION { ?d sd:hasStep ?s . FILTER NOT EXISTS { ?s sd:order ?o } }
  UNION { ?d sd:hasStep ?s . FILTER NOT EXISTS { ?s sd:action ?a } }
  UNION { ?d sd:hasStep ?s1, ?s2 . ?s1 sd:order ?o . ?s2 sd:order ?o . FILTER(?s1 != ?s2) } }
