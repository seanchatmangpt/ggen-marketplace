PREFIX sd: <https://ggen.dev/ontology/sa2a-semantic-diataxis#>
# MESSAGE: every Document requires title, quadrant, capability, outputId, subjectRevision, authority and standing
SELECT ?d WHERE { ?d a sd:Document .
  FILTER ( !EXISTS{?d sd:title ?a} || !EXISTS{?d sd:quadrant ?b} || !EXISTS{?d sd:capability ?c} || !EXISTS{?d sd:outputId ?e} || !EXISTS{?d sd:subjectRevision ?f} || !EXISTS{?d sd:authority ?g} || !EXISTS{?d sd:standing ?h} ) }
