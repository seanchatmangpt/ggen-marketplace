# MESSAGE: capability links are typed from the closed link taxonomy and connect known documents
PREFIX sd: <https://ggen.dev/ontology/sa2a-semantic-diataxis#>
SELECT ?l WHERE {
  ?l a sd:Link .
  FILTER ( !EXISTS { ?l sd:linkType ?t . ?ty a sd:LinkType . FILTER(STR(?ty) = CONCAT(STR(sd:), STR(?t))) }
        || !EXISTS { ?l sd:from ?f . ?f a sd:Document . }
        || !EXISTS { ?l sd:to ?to . ?to a sd:Document . } )
}
