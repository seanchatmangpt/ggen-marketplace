# MESSAGE: quadrant is single-valued and drawn from the closed Diataxis taxonomy (routing and quadrant exclusivity)
PREFIX sd: <https://ggen.dev/ontology/sa2a-semantic-diataxis#>
SELECT ?d WHERE {
  ?d a sd:Document ; sd:quadrant ?q .
  FILTER ( !EXISTS { ?t a sd:Quadrant . FILTER(STR(?t) = CONCAT(STR(sd:), STR(?q))) }
        || EXISTS { ?d sd:quadrant ?q2 . FILTER(?q2 != ?q) } )
}
