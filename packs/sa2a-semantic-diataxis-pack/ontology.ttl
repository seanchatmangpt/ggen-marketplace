@prefix sd:   <https://ggen.dev/ontology/sa2a-semantic-diataxis#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Single semantic source. Every projection (Diátaxis quadrants, SA2A,
# chatman.spg.v1, capability-marketplace) is a consequence of this graph.

sd:Contract a rdfs:Class .
sd:Document a rdfs:Class .
sd:Capability a rdfs:Class .
sd:Link a rdfs:Class .
sd:Step a rdfs:Class .
sd:Extension a rdfs:Class .

sd:DefaultContract a sd:Contract ;
  sd:authority "NONE" ;
  sd:consequence "EVIDENCE_ONLY" ;
  sd:semanticEquivalence "UNCLAIMED" ;
  sd:schema "chatman.spg.v1" ;
  sd:requiresExactSubject true .

# Closed taxonomies.
sd:tutorial a sd:Quadrant .
sd:how-to a sd:Quadrant .
sd:reference a sd:Quadrant .
sd:explanation a sd:Quadrant .
sd:requires a sd:LinkType .
sd:explains a sd:LinkType .
sd:procedureFor a sd:LinkType .
sd:specifiedBy a sd:LinkType .

sd:AgentAdmission a sd:Capability ;
  sd:title "Agent admission" ;
  sd:standing "PARTIAL_ALIVE" ;
  sd:subjectRevision "0000000000000000000000000000000000000001" .

sd:AgentReplay a sd:Capability ;
  sd:title "Agent replay" ;
  sd:standing "UNKNOWN" ;
  sd:subjectRevision "0000000000000000000000000000000000000001" .

sd:TutorialAdmission a sd:Document ;
  sd:title "Admit your first SA2A agent" ;
  sd:quadrant "tutorial" ;
  sd:capability sd:AgentAdmission ;
  sd:outputId "tutorial/agent-admission" ;
  sd:subjectRevision "0000000000000000000000000000000000000001" ;
  sd:authority "NONE" ;
  sd:standing "PARTIAL_ALIVE" ;
  sd:hasStep sd:TutorialAdmissionS1, sd:TutorialAdmissionS2 .

sd:TutorialAdmissionS1 a sd:Step ; sd:order 1 ; sd:action "Declare the agent identity in pack.toml." ; sd:consequential false .
sd:TutorialAdmissionS2 a sd:Step ; sd:order 2 ; sd:action "Run admission and read the typed refusal, if any." ; sd:consequential false .

sd:HowToReplay a sd:Document ;
  sd:title "Replay an admitted agent run" ;
  sd:quadrant "how-to" ;
  sd:capability sd:AgentReplay ;
  sd:outputId "how-to/agent-replay" ;
  sd:subjectRevision "0000000000000000000000000000000000000001" ;
  sd:authority "NONE" ;
  sd:standing "UNKNOWN" ;
  sd:hasStep sd:HowToReplayS1, sd:HowToReplayS2 .

sd:HowToReplayS1 a sd:Step ; sd:order 1 ; sd:action "Bind the exact subject revision." ; sd:consequential false .
sd:HowToReplayS2 a sd:Step ; sd:order 2 ; sd:action "Compare the replay receipt digest." ; sd:consequential false .

sd:ReferenceContract a sd:Document ;
  sd:title "Semantic Diátaxis contract fields" ;
  sd:quadrant "reference" ;
  sd:capability sd:AgentAdmission ;
  sd:outputId "reference/contract-fields" ;
  sd:subjectRevision "0000000000000000000000000000000000000001" ;
  sd:authority "NONE" ;
  sd:standing "PARTIAL_ALIVE" .

sd:ExplanationFences a sd:Document ;
  sd:title "Why documents cannot grant authority" ;
  sd:quadrant "explanation" ;
  sd:capability sd:AgentAdmission ;
  sd:outputId "explanation/authority-fences" ;
  sd:subjectRevision "0000000000000000000000000000000000000001" ;
  sd:authority "NONE" ;
  sd:standing "PARTIAL_ALIVE" .

sd:LinkTutorialToReference a sd:Link ;
  sd:from sd:TutorialAdmission ; sd:to sd:ReferenceContract ; sd:linkType "specifiedBy" .
sd:LinkHowToToTutorial a sd:Link ;
  sd:from sd:HowToReplay ; sd:to sd:TutorialAdmission ; sd:linkType "requires" .
sd:LinkExplanationToReference a sd:Link ;
  sd:from sd:ExplanationFences ; sd:to sd:ReferenceContract ; sd:linkType "explains" .
