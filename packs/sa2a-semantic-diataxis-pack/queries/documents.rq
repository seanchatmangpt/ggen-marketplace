PREFIX sd: <https://ggen.dev/ontology/sa2a-semantic-diataxis#>
SELECT ?doc ?title ?quadrant ?outputId ?subjectRevision ?authority ?standing ?capability
WHERE {
  ?doc a sd:Document ; sd:title ?title ; sd:quadrant ?quadrant ; sd:outputId ?outputId ;
       sd:subjectRevision ?subjectRevision ; sd:authority ?authority ; sd:standing ?standing ;
       sd:capability ?capability .
}
ORDER BY ?outputId
