PREFIX sd: <https://ggen.dev/ontology/sa2a-semantic-diataxis#>
SELECT ?capability ?title ?standing ?subjectRevision ?authority ?consequence ?semanticEquivalence
WHERE {
  ?capability a sd:Capability ; sd:title ?title ; sd:standing ?standing ; sd:subjectRevision ?subjectRevision .
  sd:DefaultContract sd:authority ?authority ; sd:consequence ?consequence ; sd:semanticEquivalence ?semanticEquivalence .
}
ORDER BY ?capability
