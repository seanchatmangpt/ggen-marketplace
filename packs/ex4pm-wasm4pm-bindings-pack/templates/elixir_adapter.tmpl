---
to: "apps/ex4pm_engine/lib/ex4pm_engine/wasm/{{ row.algorithm_id }}.ex"
sparql:
  row: |
    PREFIX epm: <http://seanchatmangpt.github.io/packs/ex4pm-wasm4pm-bindings#>
    SELECT ?algorithm_id ?module_name ?wasm_export ?wasm_replay_export ?source_crate WHERE {
      ?binding a epm:AlgorithmBinding ;
               epm:algorithmId ?algorithm_id ;
               epm:elixirModuleName ?module_name ;
               epm:wasmExportName ?wasm_export ;
               epm:wasmReplayExportName ?wasm_replay_export ;
               epm:wasm4pmSourceCrate ?source_crate .
    } ORDER BY ?algorithm_id
---
defmodule Ex4pmEngine.Wasm.{{ row.module_name }} do
  @moduledoc """
  wasm4pm-ex4pm-bindings `{{ row.algorithm_id }}` adapter — generated from
  `~/ggen-marketplace/packs/ex4pm-wasm4pm-bindings-pack`, source crate
  `{{ row.source_crate }}`.

  See `Ex4pmEngine.Wasm.Adapter` for the shared six-state standing shape.
  Injected transport key: `:{{ row.algorithm_id }}_wasm_fun`.
  """

  use Ex4pmEngine.Wasm.Adapter,
    algorithm_id: :{{ row.algorithm_id }},
    engine_id: :wasm_{{ row.algorithm_id }},
    wasm_export: "{{ row.wasm_export }}",
    wasm_replay_export: "{{ row.wasm_replay_export }}"
end
