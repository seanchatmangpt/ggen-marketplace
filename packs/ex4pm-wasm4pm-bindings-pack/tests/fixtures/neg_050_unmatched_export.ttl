@prefix epm: <http://seanchatmangpt.github.io/packs/ex4pm-wasm4pm-bindings#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Negative control for 050: source exports a_v1 only; the binding also claims a_replay_v1.
epm:M a epm:Module ; epm:sourceText """
#[unsafe(export_name = "wasm4pm_ex4pm_a_v1")]
pub unsafe extern "C" fn a_v1() {}
""" .
epm:A a epm:AlgorithmBinding ;
    epm:algorithmId "a" ; epm:elixirModuleName "A" ; epm:elixirSourceModule "X.A" ;
    epm:wasmExportName "wasm4pm_ex4pm_a_v1" ; epm:wasmReplayExportName "wasm4pm_ex4pm_a_replay_v1" ;
    epm:requestShape "r" ; epm:resultShape "r" ; epm:bcinrLike false ; epm:wasm4pmSourceCrate "wasm4pm" .
