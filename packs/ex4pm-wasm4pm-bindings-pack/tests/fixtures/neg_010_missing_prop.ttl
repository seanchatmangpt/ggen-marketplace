@prefix epm: <http://seanchatmangpt.github.io/packs/ex4pm-wasm4pm-bindings#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Negative control for 010: a binding with every required property except epm:resultShape.
epm:Bad a epm:AlgorithmBinding ;
    epm:algorithmId "bad" ; epm:elixirModuleName "Bad" ; epm:elixirSourceModule "X.Bad" ;
    epm:wasmExportName "wasm4pm_ex4pm_bad_v1" ; epm:wasmReplayExportName "wasm4pm_ex4pm_bad_replay_v1" ;
    epm:requestShape "r" ; epm:bcinrLike false ; epm:wasm4pmSourceCrate "wasm4pm" .
