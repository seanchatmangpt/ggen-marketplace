@prefix epm: <http://seanchatmangpt.github.io/packs/ex4pm-wasm4pm-bindings#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Negative control for 030: export name lacks the wasm4pm_ex4pm_ prefix.
epm:Bad a epm:AlgorithmBinding ;
    epm:algorithmId "bad" ; epm:elixirModuleName "Bad" ; epm:elixirSourceModule "X.Bad" ;
    epm:wasmExportName "other_bad_v1" ; epm:wasmReplayExportName "wasm4pm_ex4pm_bad_replay_v1" ;
    epm:requestShape "r" ; epm:resultShape "r" ; epm:bcinrLike false ; epm:wasm4pmSourceCrate "wasm4pm" .
