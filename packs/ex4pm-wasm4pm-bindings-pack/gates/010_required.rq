# MESSAGE: epm:LibModule must have a non-empty epm:sourceText; epm:CargoManifest must have a
# non-empty epm:manifestText; every epm:AlgorithmBinding must have algorithmId, elixirSourceModule,
# wasmExportName, wasmReplayExportName, requestShape, resultShape, bcinrLike bound — this file
# checks presence (translated from tcps-wasm-pack's shapes.ttl sh:minCount 1 pattern; any row = a
# typed individual missing the bound ?missing property)
PREFIX epm: <http://seanchatmangpt.github.io/packs/ex4pm-wasm4pm-bindings#>
SELECT ?s ?missing WHERE {
  {
    ?s a epm:Module .
    BIND(epm:sourceText AS ?missing)
    FILTER NOT EXISTS { ?s epm:sourceText ?v }
  } UNION {
    ?s a epm:Manifest .
    BIND(epm:manifestText AS ?missing)
    FILTER NOT EXISTS { ?s epm:manifestText ?v }
  } UNION {
    ?s a epm:AlgorithmBinding .
    VALUES ?missing {
      epm:algorithmId epm:elixirSourceModule epm:elixirModuleName epm:wasmExportName
      epm:wasmReplayExportName epm:requestShape epm:resultShape epm:bcinrLike
      epm:wasm4pmSourceCrate
    }
    FILTER NOT EXISTS { ?s ?missing ?v }
  }
}
ORDER BY ?s ?missing
