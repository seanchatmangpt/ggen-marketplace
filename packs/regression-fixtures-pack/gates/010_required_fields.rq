# MESSAGE: an rfx:RegressionFixture is missing rfx:setup, rfx:expectedBehavior, or rfx:specPath -- a fixture without all three is a name only, not a documented failure shape; fill in the missing field(s) before this fixture can be cited by any consumer
PREFIX rfx: <http://seanchatmangpt.github.io/packs/regression-fixtures#>
SELECT ?fixture ?missing WHERE {
  ?fixture a rfx:RegressionFixture ; rfx:name ?name .
  {
    FILTER NOT EXISTS { ?fixture rfx:setup ?s } BIND("setup" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?fixture rfx:expectedBehavior ?e } BIND("expectedBehavior" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?fixture rfx:specPath ?p } BIND("specPath" AS ?missing)
  }
}
ORDER BY ?fixture ?missing
