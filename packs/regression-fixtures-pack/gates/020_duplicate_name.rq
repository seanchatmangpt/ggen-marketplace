# MESSAGE: two rfx:RegressionFixture individuals declare the same rfx:name -- fixture names must be unique slugs matching one fixtures/<name>.md file each; rename the colliding fixture before it can be told apart from the other
PREFIX rfx: <http://seanchatmangpt.github.io/packs/regression-fixtures#>
SELECT ?name ?fixtureA ?fixtureB WHERE {
  ?fixtureA a rfx:RegressionFixture ; rfx:name ?name .
  ?fixtureB a rfx:RegressionFixture ; rfx:name ?name .
  FILTER(STR(?fixtureA) < STR(?fixtureB))
}
ORDER BY ?name ?fixtureA ?fixtureB
