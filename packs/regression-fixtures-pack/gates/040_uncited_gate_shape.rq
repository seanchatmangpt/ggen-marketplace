# MESSAGE: an rfx:citedGate value does not look like a real marketplace-relative path (must start with 'packs/<pack-name>/' and end in a recognized gate/script/test file extension) -- this pack never invents or re-derives a gate; a citedGate must be a real file path into an existing pack, or the property must be omitted entirely when no real gate exists yet
PREFIX rfx: <http://seanchatmangpt.github.io/packs/regression-fixtures#>
SELECT ?fixture ?citedGate WHERE {
  ?fixture a rfx:RegressionFixture ; rfx:citedGate ?citedGate .
  FILTER(!REGEX(?citedGate, "^packs/[a-zA-Z0-9_-]+/.+\\.(rq|py|sh)$"))
}
ORDER BY ?fixture
