# MESSAGE: an rfx:expectedBehavior mentions REFUSED but not in the REFUSED[SOME_CODE] shape (uppercase snake-case code in brackets) -- a loose refusal description can't be machine-matched against a real gate's own refusal code; tighten the expectedBehavior text to the REFUSED[CODE] form
PREFIX rfx: <http://seanchatmangpt.github.io/packs/regression-fixtures#>
SELECT ?fixture ?expectedBehavior WHERE {
  ?fixture a rfx:RegressionFixture ; rfx:expectedBehavior ?expectedBehavior .
  FILTER(CONTAINS(?expectedBehavior, "REFUSED"))
  FILTER(!REGEX(?expectedBehavior, "REFUSED\\[[A-Z][A-Z0-9_]*\\]"))
}
ORDER BY ?fixture
