# regression-fixtures-pack ontology: the rfx: vocabulary for a DOCUMENTED
# corpus of historical Claude-orchestration failure classes. Each
# rfx:RegressionFixture individual describes one real, previously-observed
# failure shape (name, setup, expected sensor/gate behavior) -- it is a
# specification a human or a future execution gym reads and reproduces, NOT
# code this pack executes itself. No generic execution gym exists on this
# machine yet (per the ecosystem census at authoring time); this pack is the
# corpus such a gym would consume, not the gym.
#
# rfx:RegressionFixture individuals are hand-authored (either here in
# qualification/consumer.ttl as the green fixture, or by a consumer pack that
# wires this ontology and adds its own). The prose failure-shape write-ups
# live as sibling plain-text files under fixtures/*.md -- rfx:specPath points
# at the file; the gates below check the RDF registration is well-formed
# (present, non-empty, internally consistent), not that the underlying
# failure was actually reproduced (this pack manufactures no evidence of
# reproduction -- see README.md's Scope section).

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rfx:  <http://seanchatmangpt.github.io/packs/regression-fixtures#> .

rfx:RegressionFixture a rdfs:Class ;
    rdfs:comment "One documented historical Claude-orchestration failure class. Properties: rfx:name (stable slug, matches the fixtures/<name>.md filename stem), rfx:failureClass (short category label, e.g. 'subject-identity', 'plan-staleness', 'resource-contention', 'false-claim', 'unbounded-directive', 'retry-without-hypothesis', 'destructive-deletion', 'placeholder-evidence', 'ground-truth-override'), rfx:setup (free text: how to construct the exact broken state), rfx:expectedBehavior (free text: the expected sensor/gate verdict, e.g. 'REFUSED[SUBJECT_IDENTITY_MISMATCH]'), rfx:specPath (relative path to the fixtures/*.md write-up), rfx:citedGate (0+ relative paths to a real SPARQL/Python gate elsewhere in the marketplace that already encodes this class -- present only when one genuinely exists; a fixture with no real corresponding gate yet MUST omit this property rather than invent one), rfx:sourceIncident (free text, optional -- names the real session/file where this failure was actually observed, when known)." .

rfx:FixtureCorpus a rdfs:Class ;
    rdfs:comment "The named collection this fixture set belongs to. Properties: rfx:name, rfx:memberCount (xsd:integer, real count of rfx:RegressionFixture individuals asserted for this corpus at authoring time -- a gate checks this stays truthful)." .

rfx:partOf a rdf:Property ;
    rdfs:comment "Relates an rfx:RegressionFixture to its owning rfx:FixtureCorpus." .
