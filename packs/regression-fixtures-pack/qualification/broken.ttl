@prefix rfx: <http://seanchatmangpt.github.io/packs/regression-fixtures#> .

# Deliberately-broken fixture, used only to prove each gate fires on the
# violation it names (not checked in as the pack's shipped qualification
# fixture -- consumer.ttl is). Run standalone against each gate.

rfx:b-corpus a rfx:FixtureCorpus ;
    rfx:name "broken-corpus" ;
    rfx:memberCount 2 .  # wrong on purpose -- 5 real members are actually asserted below (gate 050)

# Missing rfx:setup (gate 010)
rfx:b-missing-setup a rfx:RegressionFixture ;
    rfx:name "missing-setup" ;
    rfx:expectedBehavior "REFUSED[SOMETHING]" ;
    rfx:specPath "fixtures/missing-setup.md" ;
    rfx:partOf rfx:b-corpus .

# Duplicate name with the one above (gate 020)
rfx:b-dup-a a rfx:RegressionFixture ;
    rfx:name "duplicate-name" ;
    rfx:setup "x" ; rfx:expectedBehavior "y" ; rfx:specPath "fixtures/dup.md" ;
    rfx:partOf rfx:b-corpus .
rfx:b-dup-b a rfx:RegressionFixture ;
    rfx:name "duplicate-name" ;
    rfx:setup "x" ; rfx:expectedBehavior "y" ; rfx:specPath "fixtures/dup.md" ;
    rfx:partOf rfx:b-corpus .

# Malformed refusal code -- "REFUSED" present but not REFUSED[CODE] shape (gate 030)
rfx:b-loose-refusal a rfx:RegressionFixture ;
    rfx:name "loose-refusal" ;
    rfx:setup "x" ;
    rfx:expectedBehavior "should be REFUSED because it is bad" ;
    rfx:specPath "fixtures/loose.md" ;
    rfx:partOf rfx:b-corpus .

# Fabricated citedGate path, not a real marketplace file shape (gate 040)
rfx:b-fake-citation a rfx:RegressionFixture ;
    rfx:name "fake-citation" ;
    rfx:setup "x" ; rfx:expectedBehavior "y" ; rfx:specPath "fixtures/fake.md" ;
    rfx:citedGate "some/made/up/path.rq" ;
    rfx:partOf rfx:b-corpus .
