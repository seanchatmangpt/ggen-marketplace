{
  "$id": "urn:ggen:enterprise-connection:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architecture": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
        "constraints": {"items": {"minLength": 1, "type": "string"}, "type": "array", "uniqueItems": true},
        "graph": {"oneOf": [{"type": "null"}, {"additionalProperties": false, "properties": {"digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}, "media_type": {"minLength": 1, "type": "string"}, "path": {"minLength": 1, "type": "string"}}, "required": ["path", "media_type", "digest"], "type": "object"}]}
      },
      "required": ["graph", "capabilities", "constraints"], "type": "object"
    },
    "artifacts": {"items": {"additionalProperties": false, "properties": {"digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}, "media_type": {"minLength": 1, "type": "string"}, "path": {"minLength": 1, "type": "string"}, "role": {"minLength": 1, "type": "string"}}, "required": ["path", "role", "media_type", "digest"], "type": "object"}, "type": "array"},
    "authority": {"additionalProperties": false, "properties": {"ceiling": {"enum": ["CONSTRUCT_ONLY", "BOUNDED_GYM", "BRCE_REQUIRED"]}, "do_authority": {"const": false}}, "required": ["ceiling", "do_authority"], "type": "object"},
    "connection_id": {"maxLength": 256, "minLength": 1, "type": "string"},
    "evidence": {"items": {"additionalProperties": false, "properties": {"digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": ["string", "null"]}, "identity": {"minLength": 1, "type": "string"}, "kind": {"minLength": 1, "type": "string"}}, "required": ["kind", "identity", "digest"], "type": "object"}, "type": "array"},
    "labels": {"additionalProperties": {"type": "string"}, "type": "object"},
    "next": {"items": {"additionalProperties": false, "properties": {"consumer": {"pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string"}, "operation": {"minLength": 1, "type": "string"}}, "required": ["consumer", "operation"], "type": "object"}, "type": "array"},
    "packs": {"items": {"additionalProperties": false, "properties": {"admission": {"enum": ["REQUESTED", "CANDIDATE", "ADMITTED", "QUALIFIED"]}, "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": ["string", "null"]}, "name": {"minLength": 1, "type": "string"}, "version": {"type": ["string", "null"]}}, "required": ["name", "version", "digest", "admission"], "type": "object"}, "type": "array"},
    "parent": {"oneOf": [{"type": "null"}, {"additionalProperties": false, "properties": {"digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}, "producer": {"minLength": 1, "type": "string"}}, "required": ["digest", "producer"], "type": "object"}]},
    "producer": {"additionalProperties": false, "properties": {"component": {"minLength": 1, "type": "string"}, "repository": {"pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "type": "string"}, "revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"}}, "required": ["repository", "revision", "component"], "type": "object"},
    "schema": {"const": "urn:ggen:enterprise-connection:v1"},
    "stage": {"enum": ["RECONSTITUTE", "GENERALIZE", "CATALOG", "MANUFACTURE", "EXERCISE"]},
    "standing": {"additionalProperties": false, "properties": {"claim": {"minLength": 1, "type": "string"}, "state": {"pattern": "^(UNKNOWN|PARTIAL_ALIVE|ALIVE|BLOCKED|BUILD_BROKEN|UNSUPPORTED|REFUSED(?::[A-Z0-9_]+)?)$", "type": "string"}}, "required": ["state", "claim"], "type": "object"},
    "subject": {"additionalProperties": false, "properties": {"id": {"minLength": 1, "type": "string"}, "kind": {"minLength": 1, "type": "string"}, "revision": {"minLength": 1, "type": "string"}}, "required": ["id", "kind", "revision"], "type": "object"}
  },
  "required": ["schema", "connection_id", "stage", "producer", "subject", "architecture", "packs", "artifacts", "authority", "standing", "parent", "evidence", "next", "labels"],
  "title": "Enterprise Architecture Manufacturing Connection Envelope v1",
  "type": "object"
}
