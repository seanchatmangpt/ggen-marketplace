@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<urn:ggen:enterprise-connection:v1>
    a prof:Profile ;
    dcterms:title "Enterprise Architecture Manufacturing Connection v1" ;
    dcterms:description "A dependency-neutral provenance envelope joining bounded reconstitution, generalization, catalog admission, manufacture, and exercise. The envelope is never an authority grant; consequential DO remains external and receipted." ;
    dcterms:conformsTo <https://www.w3.org/TR/prov-o/> ;
    prof:hasResource <urn:ggen:enterprise-connection:v1#schema>,
                     <urn:ggen:enterprise-connection:v1#gate> .

<urn:ggen:enterprise-connection:v1#stages> a skos:ConceptScheme ;
    skos:prefLabel "Enterprise connection stages" .

<urn:ggen:enterprise-connection:v1#RECONSTITUTE> a skos:Concept ;
    skos:inScheme <urn:ggen:enterprise-connection:v1#stages> ;
    skos:prefLabel "RECONSTITUTE" .
<urn:ggen:enterprise-connection:v1#GENERALIZE> a skos:Concept ;
    skos:inScheme <urn:ggen:enterprise-connection:v1#stages> ;
    skos:prefLabel "GENERALIZE" .
<urn:ggen:enterprise-connection:v1#CATALOG> a skos:Concept ;
    skos:inScheme <urn:ggen:enterprise-connection:v1#stages> ;
    skos:prefLabel "CATALOG" .
<urn:ggen:enterprise-connection:v1#MANUFACTURE> a skos:Concept ;
    skos:inScheme <urn:ggen:enterprise-connection:v1#stages> ;
    skos:prefLabel "MANUFACTURE" .
<urn:ggen:enterprise-connection:v1#EXERCISE> a skos:Concept ;
    skos:inScheme <urn:ggen:enterprise-connection:v1#stages> ;
    skos:prefLabel "EXERCISE" .

<urn:ggen:enterprise-connection:v1#no-ambient-do>
    a prov:Entity ;
    dcterms:description "All ConnectionEnvelope instances require do_authority=false. A connection coordinate, profile, pack identity, model output, or transport is not permission to actuate a world." .
