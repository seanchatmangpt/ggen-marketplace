# MESSAGE: standing vocabulary violation -- aloop:executionStanding and aloop:verificationStanding are CLOSED two-axis vocabularies (execution: AUTONOMOUS|ASSISTED|BLOCKED_AUTHORITY|BLOCKED_INFORMATION|FAILED; verification: ALIVE|PARTIAL_ALIVE|BLOCKED|REFUSED|UNSUPPORTED|UNKNOWN). A standing value not typed in its closed class -- including a bare literal -- is a violation row. Custom literal standings are the fabrication-of-the-ratio failure mode.
# Violation-row style (FM-PACK-013): zero rows = conforming.
# The BIND-witness pattern: the OPTIONAL witnesses the value's membership; a
# literal or untyped-IRI standing leaves ?typed unbound and FILTER(!BOUND) fires.
# sparql 0.3.12 law: no FILTER inside EXISTS/OPTIONAL groups -- group-level
# FILTER(!BOUND) only (see priv/ggen/semantic-jira-pack/gates/050_frontier.rq).
PREFIX aloop: <https://seanchatmangpt.github.io/packs/aloop-episode-ontology#>
SELECT ?node ?standing ?kind WHERE {
  {
    ?node aloop:executionStanding ?standing .
    OPTIONAL { ?standing a aloop:ExecutionStanding . BIND(?standing AS ?typed) }
    FILTER(!BOUND(?typed))
    BIND("execution_standing_outside_closed_set" AS ?kind)
  } UNION {
    ?node aloop:verificationStanding ?standing .
    OPTIONAL { ?standing a aloop:VerificationStanding . BIND(?standing AS ?typed) }
    FILTER(!BOUND(?typed))
    BIND("verification_standing_outside_closed_set" AS ?kind)
  }
}
ORDER BY ?kind ?node
