---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch04",
  "files_and_dirs": {
    "README.md": true,
    "alert-rules.yaml": true,
    "cve-scanner.py": true,
    "dashboards/dashboard-developer.json": true,
    "dashboards/dashboard-management.json": true,
    "dashboards/dashboard-security.json": true,
    "dashboards/dashboard-sre.json": true,
    "ggen-create.json": true,
    "grafana-dashboard-platform.json": true,
    "instrument-app.py": true,
    "metrics_pull.py": true,
    "observability-personas.py": true,
    "otel-collector-config.yaml": true,
    "otel-collector-deployment.yaml": true,
    "otel_setup.py": true,
    "test-observability.py": true,
    "traces_push.py": true
  },
  "templatize_using_name": "{% endraw %}{{ row.capitalized }}{% raw %}",
  "gen_parent_dir": false
}
{% endraw %}