@prefix xs5: <http://seanchatmangpt.github.io/packs/xstate-v5-machine#> .
@prefix st: <https://ggen.dev/ontology/state-transition#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Qualification-only external fact identity. The canonical st: FSM-schema
# facts are owned by state-transition-pack
# (packs/state-transition-pack/ontology.ttl); this fixture supplies only the
# minimum typed identity needed so that this pack's rdfs:seeAlso alignment
# links (same concept, same IRI per the M15 cross-pack convention) do not
# dangle when xstate-v5-machine-pack is qualified in isolation. Mirrors the
# a2a-conformance-pack precedent.

st:Machine a st:Machine ;
    dcterms:source "packs/state-transition-pack/ontology.ttl#st:Machine" .

st:Transition a st:Transition ;
    dcterms:source "packs/state-transition-pack/ontology.ttl#st:Transition" .

st:Guard a st:Guard ;
    dcterms:source "packs/state-transition-pack/ontology.ttl#st:Guard" .

st:initial a rdf:Property ;
    dcterms:source "packs/state-transition-pack/ontology.ttl#st:initial" .

st:inMachine a rdf:Property ;
    dcterms:source "packs/state-transition-pack/ontology.ttl#st:inMachine" .

st:machineName a rdf:Property ;
    dcterms:source "packs/state-transition-pack/ontology.ttl#st:machineName" .
