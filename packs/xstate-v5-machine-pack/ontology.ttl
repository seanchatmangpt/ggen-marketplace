# xstate-v5-machine-pack ontology.
#
# Namespace convention (M15 ontology harmonization):
#   1. Pack-scoped vocabulary lives under exactly one pack-scoped namespace
#      per pack (xs5: below); canonical prefix names are never rebound, and
#      no terms are minted under a canonical namespace.
#   2. Cross-pack alignment: each xs5: term that is the same concept as a
#      state-transition-pack st: FSM-schema term carries rdfs:seeAlso to the
#      OWNING pack's IRI -- same concept, same IRI, never a re-mint.
#
# Truth source: /Users/sac/srve/docs/diagrams/state/xstate/SHAPES.md
# (Standing: PARTIAL_ALIVE inherited by this pack).

@prefix xs5: <http://seanchatmangpt.github.io/packs/xstate-v5-machine#> .
@prefix st: <https://ggen.dev/ontology/state-transition#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<http://seanchatmangpt.github.io/packs/xstate-v5-machine> a owl:Ontology ;
    rdfs:label "xstate-v5-machine-pack ontology" ;
    rdfs:comment "XState v5 machine semantics pack; pack-scoped ns below (M15)." ;
    owl:versionInfo "0.1.0" .

#################################################################
# Classes
#################################################################

xs5:Machine a rdfs:Class ;
    rdfs:label "Typed XState v5 machine definition: named actor schema with initial state." ;
    rdfs:seeAlso st:Machine ;
    rdfs:comment "Aligned to st:Machine (FSM schema, 26.9.13): same concept, same IRI." .

xs5:SmokeTest a rdfs:Class ;
    rdfs:label "Probe driving a machine through its happy path; asserts final-state shape." ;
    rdfs:comment "Real collaborators, assert on final state; no mocks, no fixed sleeps." .

xs5:CompileShape a rdfs:Class ;
    rdfs:label "Per-language parse/typecheck assertion over the projected machine artifact." ;
    rdfs:comment "Truth surface: the consumer repo's own compiler over generated output." .

xs5:ConformanceCase a rdfs:Class ;
    rdfs:label "Named event-sequence case asserting declared transition behavior." ;
    rdfs:seeAlso st:Transition ;
    rdfs:seeAlso st:Guard ;
    rdfs:comment "Aligned to st:Transition/st:Guard: exercises real guarded transitions." .

xs5:TtlBaseline a rdfs:Class ;
    rdfs:label "Frozen RDF baseline of the TTL projection, diffed to detect drift." ;
    rdfs:comment "Baseline diff is meaningful only under a deterministic serializer." .

#################################################################
# Properties
#################################################################

xs5:machineName a rdf:Property ;
    rdfs:domain xs5:Machine ; rdfs:range xsd:string ;
    rdfs:seeAlso st:machineName .

xs5:initial a rdf:Property ;
    rdfs:domain xs5:Machine ;
    rdfs:seeAlso st:initial .

xs5:hasStateNode a rdf:Property ;
    rdfs:domain xs5:Machine ;
    rdfs:seeAlso st:inMachine .

xs5:eventName a rdf:Property ;
    rdfs:domain xs5:ConformanceCase ; rdfs:range xsd:string .

xs5:assertsFinalState a rdf:Property ;
    rdfs:domain xs5:SmokeTest ; rdfs:range xsd:string .

xs5:targetLanguage a rdf:Property ;
    rdfs:domain xs5:CompileShape ; rdfs:range xsd:string .

xs5:baselineHash a rdf:Property ;
    rdfs:domain xs5:TtlBaseline ; rdfs:range xsd:string .

xs5:smokeTestFor a rdf:Property ;
    rdfs:domain xs5:SmokeTest ; rdfs:range xs5:Machine .

xs5:conformanceFor a rdf:Property ;
    rdfs:domain xs5:ConformanceCase ; rdfs:range xs5:Machine .

xs5:compileShapeFor a rdf:Property ;
    rdfs:domain xs5:CompileShape ; rdfs:range xs5:Machine .

xs5:baselineFor a rdf:Property ;
    rdfs:domain xs5:TtlBaseline ; rdfs:range xs5:Machine .
