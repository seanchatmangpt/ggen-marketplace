@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix p: <https://seanchatmangpt.github.io/packs/forced-top25-pack#> .

p:Subject a rdfs:Class ;
    rdfs:label "Subject" ;
    rdfs:comment "An exact subject admitted by forced-top25-pack." .

p:subjectId a rdf:Property ;
    rdfs:domain p:Subject ;
    rdfs:range xsd:string ;
    rdfs:comment "Exact identity of the subject." .

p:example a p:Subject ;
    p:subjectId "urn:forced-top25-pack:example" .
