PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?target ?state WHERE { ?target a r90:FanoutTarget ; r90:compatibilityState ?state .
  FILTER(?state = "COMPATIBLE_READY" || ?state = "COMPATIBLE_ADMITTED")
  FILTER NOT EXISTS { ?target r90:exactConsumerHead ?h . FILTER(STRLEN(?h) = 40) } }
ORDER BY ?target
