# Unified-population head shape: covers both winner vocabularies
# (fta:exactCurrentHead from copy A, fta:exactHead from copy B).
PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
SELECT ?target ?head WHERE {
  ?target a fta:FanoutTarget .
  { ?target fta:exactCurrentHead ?head } UNION { ?target fta:exactHead ?head }
  FILTER(STRLEN(?head) != 40 || !REGEX(?head, "^[0-9a-f]{40}$")) }
ORDER BY ?target
