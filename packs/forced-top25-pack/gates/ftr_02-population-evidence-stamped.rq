# Every population record must carry its per-repo evidence timestamp
# (fta:observedAt) - the reconciliation decision must stay replayable.
PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
SELECT ?target WHERE {
  ?target a fta:FanoutTarget .
  FILTER NOT EXISTS { ?target fta:observedAt ?ts } }
ORDER BY ?target
