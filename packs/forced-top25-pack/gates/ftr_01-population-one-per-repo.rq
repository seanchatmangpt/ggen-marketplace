# One population record per repo: duplicate repo literals are a
# reconciliation violation (a copy that lost must not survive as truth).
PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
SELECT ?repo ?a ?b WHERE {
  ?a a fta:FanoutTarget ; fta:repo ?repo .
  ?b a fta:FanoutTarget ; fta:repo ?repo .
  FILTER(STR(?a) < STR(?b)) }
ORDER BY ?repo ?a ?b
