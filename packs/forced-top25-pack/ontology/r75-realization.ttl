@prefix c2: <https://ggen.dev/cell2/forced-top25-r75#> .
@prefix fta: <https://ggen.dev/ontology/forced-top25-admissibility#> .
@prefix fts: <https://ggen.dev/ontology/forced-top25-standard-consumer#> .
@prefix r75: <https://ggen.dev/implement/r75#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

c2:FanoutRealizationPlan a prov:Plan .
c2:target a rdf:Property .
c2:consumerPlan a rdf:Property .
c2:realization a rdf:Property .
c2:upstreamPack a rdf:Property .
c2:exactHead a rdf:Property .
c2:standing a rdf:Property .
c2:authority a rdf:Property .
c2:consequentialDo a rdf:Property .
c2:preservesUnknown a rdf:Property .

c2:canonicalComposition a c2:FanoutRealizationPlan ;
  c2:upstreamPack fts:StandardConsumerPlan, r75:StructuralRealization ;
  c2:standing "PARTIAL_ALIVE" ;
  c2:authority "SELECT|CONSTRUCT" ;
  c2:consequentialDo false ;
  c2:preservesUnknown true .
