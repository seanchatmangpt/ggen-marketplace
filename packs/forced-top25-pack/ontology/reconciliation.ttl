# ontology/reconciliation.ttl - conserved head-SHA reconciliation.
# The three pre-merge population copies carried conflicting head SHAs.
# Policy: for each of the 25 repos the copy with the NEWEST per-repo
# evidence timestamp wins as targets/population.ttl truth; every losing
# assertion is recorded here - nothing silently dropped. Run snapshots
# r75/r86/r90 are replay evidence, frozen under runs/, and never compete.
@prefix ftr: <https://ggen.dev/ontology/forced-top25-reconciliation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ftr:HeadReconciliation a skos:Concept ; skos:prefLabel "Head SHA reconciliation record" .
ftr:SnapshotNonCompetition a skos:Concept ; skos:prefLabel "Run snapshot excluded from head competition" .
ftr:repo a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ftr:rank a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ftr:losingHead a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ftr:losingSourcePack a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ftr:losingObservedAt a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ftr:winnerHead a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ftr:winnerSourcePack a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ftr:winnerObservedAt a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ftr:conflictClass a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .

