@prefix r86: <https://ggen.dev/ontology/forced-top25-qualification-capsule#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

r86:QualificationCapsule a skos:Concept ; skos:prefLabel "Qualification Capsule" .
r86:ConsumerSubject a skos:Concept ; skos:prefLabel "Consumer Subject" .
r86:HostedWrapper a skos:Concept ; skos:prefLabel "Hosted Wrapper" .
r86:LocalCapsule a skos:Concept ; skos:prefLabel "Local Capsule" .
r86:SemanticStanding a skos:Concept ; skos:prefLabel "Semantic Standing" .
r86:MaterializationCase a skos:Concept ; skos:prefLabel "Exact Subject Materialization Case" .
r86:MaterializationPlan a skos:Concept ; skos:prefLabel "Exact Subject Materialization Plan" .

r86:consumerRepo a rdf:Property .
r86:consumerHead a rdf:Property .
r86:producerRepo a rdf:Property .
r86:producerHead a rdf:Property .
r86:producerPack a rdf:Property .
r86:qualificationCommand a rdf:Property .
r86:authority a rdf:Property .
r86:consequentialDo a rdf:Property .
r86:hostedStanding a rdf:Property .
r86:localStanding a rdf:Property .
r86:semanticStanding a rdf:Property .
r86:blocker a rdf:Property .
r86:failedTransport a rdf:Property .
r86:failureClass a rdf:Property .
r86:materializationTransport a rdf:Property .
r86:integrityBinding a rdf:Property .
r86:materializationStanding a rdf:Property .

r86:CapsuleDesign a prov:Entity ;
  r86:authority "VERIFY|CONSTRUCT" ;
  r86:consequentialDo false ;
  skos:note "Hosted workflow execution is a wrapper, not the semantic source of qualification standing." .

r86:SemanticStandingLaw a prov:Entity ;
  r86:authority "VERIFY|CONSTRUCT" ;
  r86:consequentialDo false ;
  skos:note "A successful exact-subject local capsule can establish semantic standing while a hosted-wrapper failure remains preserved as an independent Andon." .

r86:MaterializationLaw a prov:Entity ;
  r86:authority "VERIFY|CONSTRUCT" ;
  r86:consequentialDo false ;
  skos:note "Subject identity is the exact consumer head, not a particular checkout transport. A failed transport may be replaced by an authenticated exact-head materialization plan while the original transport Andon remains preserved." .

r86:UnrdfCheckoutFallback a r86:MaterializationCase, prov:Entity ;
  r86:consumerRepo "seanchatmangpt/unrdf" ;
  r86:consumerHead "4ffdf91c60cf45ad213f3fd8de1e7a4b2a9cbaeb" ;
  r86:failedTransport "GIT_CHECKOUT" ;
  r86:failureClass "HOSTED_CHECKOUT_PREEXEC[MALFORMED_GITMODULES_OPEN_ONTOLOGIES]" ;
  r86:materializationTransport "AUTHENTICATED_EXACT_SHA_ARCHIVE" ;
  r86:integrityBinding "CONSUMER_HEAD" ;
  r86:materializationStanding "ALIVE_EXACT_HEAD" ;
  r86:authority "VERIFY|CONSTRUCT" ;
  r86:consequentialDo false .
