---
to: generated/forced-top25/{{ row.rank }}.json
sparql:
  ready_set: |
    PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
    SELECT ?rank ?repo ?head ?shape ?producer_head ?compatibility_state WHERE {
      ?target a fta:FanoutTarget ;
              fta:rank ?rank ;
              fta:repo ?repo ;
              fta:exactHead ?head ;
              fta:consumerShape ?shape ;
              fta:producerHead ?producer_head ;
              fta:compatibilityState ?compatibility_state .
      FILTER(?compatibility_state = "COMPATIBLE_READY")
      FILTER NOT EXISTS { ?target fta:blocker ?blocker }
    }
    ORDER BY ?rank ?repo
for_each: ready_set
skip_empty: true
determinism: true
---
{"schema":"ggen.forced-top25-consumer/v1","rank":{{ row.rank }},"consumer_repo":"{{ row.repo }}","consumer_head":"{{ row.head }}","consumer_shape":"{{ row.shape }}","producer_repo":"seanchatmangpt/ggen-marketplace","producer_head":"{{ row.producer_head }}","producer_pack":"forced-top25-admissibility-factory-pack","compatibility_state":"{{ row.compatibility_state }}","authority":"VERIFY|CONSTRUCT","consequential_do":false}
