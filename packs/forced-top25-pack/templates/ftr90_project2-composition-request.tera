{
  "operation": "memory.upsert",
  "payload": {
    "record": {
      "key": "ggen/fanout/current",
      "kind": "ggen.fanout.composition",
      "standing": "{{ standing }}",
      "metadata": {
        "ggen_source_head": "{{ ggen_source_head }}",
        "U": {{ U }}, "G": {{ G }}, "O": {{ O }}, "Q": {{ Q }}, "M": {{ M }},
        "open_fanout_obligations": {{ open_fanout_obligations }},
        "open_observation_obligations": {{ open_observation_obligations }},
        "ocel_digest": "{{ ocel_digest }}",
        "process_analysis_owner": "wasm4pm"
      }
    }
  }
}
