---
to: generated/forced-top25-materialization/{{ row.consumer_repo }}.json
sparql:
  materialization_plan: |
    PREFIX r86: <https://ggen.dev/ontology/forced-top25-qualification-capsule#>
    SELECT ?consumer_repo ?consumer_head ?failed_transport ?failure_class ?materialization_transport ?integrity_binding ?materialization_standing WHERE {
      ?case a r86:MaterializationCase ; r86:consumerRepo ?consumer_repo ; r86:consumerHead ?consumer_head ; r86:failedTransport ?failed_transport ; r86:failureClass ?failure_class ; r86:materializationTransport ?materialization_transport ; r86:integrityBinding ?integrity_binding ; r86:materializationStanding ?materialization_standing ; r86:authority "VERIFY|CONSTRUCT" ; r86:consequentialDo false .
      FILTER(?materialization_transport = "AUTHENTICATED_EXACT_SHA_ARCHIVE")
      FILTER(?integrity_binding = "CONSUMER_HEAD")
    }
    ORDER BY ?consumer_repo ?consumer_head
for_each: materialization_plan
skip_empty: true
determinism: true
---
{"schema":"ggen.forced-top25-materialization-plan/v1","consumer_repo":"{{ row.consumer_repo }}","consumer_head":"{{ row.consumer_head }}","failed_transport":"{{ row.failed_transport }}","failure_class":"{{ row.failure_class }}","materialization_transport":"{{ row.materialization_transport }}","integrity_binding":"{{ row.integrity_binding }}","materialization_standing":"{{ row.materialization_standing }}","preserve_original_andon":true,"authority":"VERIFY|CONSTRUCT","consequential_do":false}
