PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
PREFIX fts: <https://ggen.dev/ontology/forced-top25-standard-consumer#>
SELECT ?rank ?repo ?head WHERE {
  ?t a fta:FanoutTarget ; fta:rank ?rank ; fta:repo ?repo ; fta:exactHead ?head ; fta:compatibilityState "COMPATIBLE_READY" .
  FILTER(?head != "UNKNOWN")
  FILTER NOT EXISTS { ?t fta:blocker ?blocker }
}
ORDER BY ?rank ?repo
