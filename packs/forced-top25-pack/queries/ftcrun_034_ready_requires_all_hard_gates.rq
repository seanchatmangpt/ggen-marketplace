PREFIX alloc: <https://ggen.dev/ontology/cell3-allocation#>
SELECT ?target WHERE { ?target a alloc:FanoutTarget ; alloc:standing "COMPATIBLE_READY" . FILTER(!EXISTS{?target alloc:exactHead ?h} || !EXISTS{?target alloc:authority ?a} || !EXISTS{?target alloc:dependsOn ?p . ?p a alloc:UpstreamPrimitive}) }
