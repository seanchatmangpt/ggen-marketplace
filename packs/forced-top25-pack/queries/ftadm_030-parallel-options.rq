PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
SELECT ?left ?right WHERE {
  ?a a fta:FanoutTarget ; fta:repo ?left ; fta:compatibilityState "UNKNOWN_PENDING_RECEIPT" .
  ?b a fta:FanoutTarget ; fta:repo ?right ; fta:compatibilityState "UNKNOWN_PENDING_RECEIPT" .
  FILTER(?left < ?right)
} ORDER BY ?left ?right
