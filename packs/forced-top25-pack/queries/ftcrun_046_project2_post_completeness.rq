PREFIX alloc: <https://ggen.dev/ontology/cell3-allocation#>
SELECT ?run WHERE { ?run a alloc:AllocationRun . FILTER(!EXISTS{?run alloc:uCount ?u} || !EXISTS{?run alloc:gCount ?g} || !EXISTS{?run alloc:oCount ?o} || !EXISTS{?run alloc:qCount ?q} || !EXISTS{?run alloc:mCount ?m} || !EXISTS{?run alloc:ocelDigest ?digest}) }
