PREFIX r86: <https://ggen.dev/ontology/forced-top25-qualification-capsule#>
SELECT ?consumer_repo ?consumer_head ?hosted_standing ?local_standing ?semantic_standing WHERE {
  ?capsule a r86:QualificationCapsule ;
           r86:consumerRepo ?consumer_repo ;
           r86:consumerHead ?consumer_head ;
           r86:hostedStanding ?hosted_standing ;
           r86:localStanding ?local_standing .
  BIND(
    IF(?local_standing = "ALIVE_EXACT_SUBJECT",
       "ALIVE_EXACT_SUBJECT",
       IF(?hosted_standing = "SUCCESS", "ALIVE_HOSTED_EXACT_HEAD", "PARTIAL_ALIVE"))
    AS ?semantic_standing
  )
}
ORDER BY ?consumer_repo ?consumer_head
