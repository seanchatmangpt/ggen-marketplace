PREFIX fgc: <https://ggen.dev/ontology/forced-top25-generated-closure#>
SELECT ?consumer ?path ?language ?validator WHERE {
  ?artifact a fgc:GeneratedArtifact ;
    fgc:belongsToConsumer ?consumer ;
    fgc:artifactPath ?path ;
    fgc:artifactLanguage ?language ;
    fgc:validatorCommand ?validator .
}
ORDER BY ?consumer ?path ?language ?validator
