PREFIX r86: <https://ggen.dev/ontology/forced-top25-qualification-capsule#>
SELECT ?consumer_repo ?consumer_head ?failed_transport ?failure_class ?materialization_transport ?integrity_binding ?materialization_standing WHERE {
  ?case a r86:MaterializationCase ;
        r86:consumerRepo ?consumer_repo ;
        r86:consumerHead ?consumer_head ;
        r86:failedTransport ?failed_transport ;
        r86:failureClass ?failure_class ;
        r86:materializationTransport ?materialization_transport ;
        r86:integrityBinding ?integrity_binding ;
        r86:materializationStanding ?materialization_standing ;
        r86:authority "VERIFY|CONSTRUCT" ;
        r86:consequentialDo false .
  FILTER(?materialization_transport = "AUTHENTICATED_EXACT_SHA_ARCHIVE")
  FILTER(?integrity_binding = "CONSUMER_HEAD")
}
ORDER BY ?consumer_repo ?consumer_head
