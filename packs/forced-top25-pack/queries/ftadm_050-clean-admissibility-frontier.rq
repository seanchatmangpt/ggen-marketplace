PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
SELECT ?rank ?repo ?head ?compatibility ?fanout ?qualification ?customer ?shape WHERE {
  ?t a fta:FanoutTarget ; fta:rank ?rank ; fta:repo ?repo ; fta:exactCurrentHead ?head ; fta:compatibilityState ?compatibility ; fta:fanoutState ?fanout ; fta:qualificationState ?qualification ; fta:downstreamCustomer ?customer ; fta:downstreamShape ?shape ; fta:authority "SELECT" .
  FILTER(STRLEN(?head)=40)
} ORDER BY ?rank ?repo
