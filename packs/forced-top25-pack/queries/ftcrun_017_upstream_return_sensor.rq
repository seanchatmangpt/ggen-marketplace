PREFIX alloc: <https://ggen.dev/ontology/cell3-allocation#>
SELECT ?primitive (COUNT(?event) AS ?returns) WHERE { ?event a alloc:ManufacturingEvent ; alloc:standing ?s ; alloc:dependsOn ?primitive . ?primitive a alloc:UpstreamPrimitive . FILTER(CONTAINS(STR(?s), "RETURN_UPSTREAM")) } GROUP BY ?primitive
