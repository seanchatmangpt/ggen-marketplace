PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
SELECT ?rank ?repo ?head ?compatibility ?fanout ?qualification WHERE {
  ?t a fta:FanoutTarget ; fta:rank ?rank ; fta:repo ?repo ; fta:exactCurrentHead ?head ; fta:compatibilityState ?compatibility ; fta:fanoutState ?fanout ; fta:qualificationState ?qualification .
} ORDER BY ?rank ?repo
