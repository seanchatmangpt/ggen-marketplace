PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?compatibility ?blocker WHERE { ?target a r90:FanoutTarget ; r90:rank 24 ; r90:owner "seanchatmangpt" ; r90:repo "yawl" ; r90:compatibilityState ?compatibility ; r90:blocker ?blocker . FILTER(STRLEN(STR(?blocker)) > 0) BIND(24 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("yawl" AS ?repo) } ORDER BY ?rank
