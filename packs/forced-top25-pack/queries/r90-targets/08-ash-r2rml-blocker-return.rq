PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?compatibility ?blocker WHERE { ?target a r90:FanoutTarget ; r90:rank 8 ; r90:owner "seanchatmangpt" ; r90:repo "ash_r2rml" ; r90:compatibilityState ?compatibility ; r90:blocker ?blocker . FILTER(STRLEN(STR(?blocker)) > 0) BIND(8 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("ash_r2rml" AS ?repo) } ORDER BY ?rank
