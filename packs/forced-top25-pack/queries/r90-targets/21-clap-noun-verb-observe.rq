PREFIX r90:<https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?consumer_head ?ggen_source_head WHERE{?target a r90:FanoutTarget;r90:rank 21;r90:owner "seanchatmangpt";r90:repo "clap-noun-verb";r90:fanoutState "DOWNSTREAM_REALIZED";r90:exactConsumerHead ?consumer_head;r90:exactGgenSourceHead ?ggen_source_head. OPTIONAL{?target r90:qualificationState ?qualification} FILTER(!BOUND(?qualification)||?qualification="UNKNOWN"||?qualification="UNOBSERVED") BIND(21 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("clap-noun-verb" AS ?repo)} ORDER BY ?rank
