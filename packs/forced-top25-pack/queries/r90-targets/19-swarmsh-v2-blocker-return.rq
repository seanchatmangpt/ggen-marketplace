PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?compatibility ?blocker WHERE { ?target a r90:FanoutTarget ; r90:rank 19 ; r90:owner "seanchatmangpt" ; r90:repo "swarmsh-v2" ; r90:compatibilityState ?compatibility ; r90:blocker ?blocker . FILTER(STRLEN(STR(?blocker)) > 0) BIND(19 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("swarmsh-v2" AS ?repo) } ORDER BY ?rank
