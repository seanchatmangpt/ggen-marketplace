PREFIX r90:<https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?consumer_head ?ggen_source_head WHERE{?target a r90:FanoutTarget;r90:rank 6;r90:owner "seanchatmangpt";r90:repo "chatgpt-cloud-elixir";r90:qualificationState ?qualification;r90:exactConsumerHead ?consumer_head;r90:exactGgenSourceHead ?ggen_source_head. FILTER(STRSTARTS(?qualification,"ALIVE")) OPTIONAL{?target r90:fanoutState ?fanout} FILTER(!BOUND(?fanout)||?fanout!="DEFAULT_ASSIMILATED") BIND(6 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("chatgpt-cloud-elixir" AS ?repo)} ORDER BY ?rank
