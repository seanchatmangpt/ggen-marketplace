PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?consumer_head ?ggen_source_head ?authority WHERE { ?target a r90:FanoutTarget ; r90:rank 24 ; r90:owner "seanchatmangpt" ; r90:repo "yawl" ; r90:compatibilityState ?compatibility ; r90:exactConsumerHead ?consumer_head ; r90:exactGgenSourceHead ?ggen_source_head ; r90:authorityMode ?authority . FILTER(?compatibility = "COMPATIBLE_READY" || ?compatibility = "COMPATIBLE_ADMITTED") FILTER(?authority = "VERIFY|CONSTRUCT") OPTIONAL { ?target r90:blocker ?blocker } FILTER(!BOUND(?blocker) || STRLEN(STR(?blocker)) = 0) BIND(24 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("yawl" AS ?repo) } ORDER BY ?rank
