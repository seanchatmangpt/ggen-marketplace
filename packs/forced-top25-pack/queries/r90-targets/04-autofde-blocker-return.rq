PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?compatibility ?blocker WHERE { ?target a r90:FanoutTarget ; r90:rank 4 ; r90:owner "seanchatmangpt" ; r90:repo "autofde" ; r90:compatibilityState ?compatibility ; r90:blocker ?blocker . FILTER(STRLEN(STR(?blocker)) > 0) BIND(4 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("autofde" AS ?repo) } ORDER BY ?rank
