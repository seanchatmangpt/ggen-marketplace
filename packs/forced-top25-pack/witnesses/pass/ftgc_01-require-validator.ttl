@prefix fgc: <https://ggen.dev/ontology/forced-top25-generated-closure#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fgc:dspygen-consumer fgc:qualificationStanding "REQUALIFYING" .

fgc:dspy-program a fgc:GeneratedArtifact ;
  fgc:belongsToConsumer fgc:dspygen-consumer ;
  fgc:artifactPath "experiments/dspy-errc-max/src/dspy_program.py" ;
  fgc:artifactLanguage "python" ;
  fgc:validatorCommand "python -m py_compile experiments/dspy-errc-max/src/dspy_program.py" .

fgc:dspy-optimize a fgc:GeneratedArtifact ;
  fgc:belongsToConsumer fgc:dspygen-consumer ;
  fgc:artifactPath "experiments/dspy-errc-max/src/dspy_optimize.py" ;
  fgc:artifactLanguage "python" ;
  fgc:validatorCommand "python -m py_compile experiments/dspy-errc-max/src/dspy_optimize.py" .

fgc:dspy-shacl-signatures a fgc:GeneratedArtifact ;
  fgc:belongsToConsumer fgc:dspygen-consumer ;
  fgc:artifactPath "experiments/dspy-errc-max/src/dspy_shacl_signatures.py" ;
  fgc:artifactLanguage "python" ;
  fgc:validatorCommand "python -m py_compile experiments/dspy-errc-max/src/dspy_shacl_signatures.py" .
