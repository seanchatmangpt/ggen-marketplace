@prefix r75: <https://ggen.dev/implement/r75#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Qualification-only external fact identity. The canonical capability facts are
# owned by epistemic-sensor-factory-pack
# (packs/epistemic-sensor-factory-pack/ontology.r75-structural-realization.ttl);
# this fixture restates the minimum typed identity needed so forced-top25-pack
# qualifies in isolation without a dangling cross-pack reference
# (court: scripts/check_cross_pack_references.py; defect class SLP-QUAL-001,
# fix shape per packs/standing-ladder-pack/qualification/consumer.ttl).
r75:StructuralRealization a prov:Activity ;
    dcterms:source "packs/epistemic-sensor-factory-pack/ontology.r75-structural-realization.ttl" .
