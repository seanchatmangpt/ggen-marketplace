---
to: "authority/generated/reconstitution-manifest.json"
sparql:
  spec: |
    PREFIX rr: <https://seanchatmangpt.github.io/ggen/reconstitution#>

    SELECT ?product ?release ?strategy ?requires_exact ?requires_verifier ?requires_replay
           ?release_admitted ?sunset_admitted
    WHERE {
      ?spec a rr:ReconstitutionSpec ;
            rr:product ?product ;
            rr:release ?release ;
            rr:strategy ?strategy ;
            rr:requiresExactSubject ?requires_exact ;
            rr:requiresIndependentVerifier ?requires_verifier ;
            rr:requiresReplay ?requires_replay ;
            rr:releaseAdmitted ?release_admitted ;
            rr:sunsetAdmitted ?sunset_admitted .
    }
    ORDER BY ?product
  owners: |
    PREFIX rr: <https://seanchatmangpt.github.io/ggen/reconstitution#>

    SELECT ?repository ?role ?authority
    WHERE {
      ?owner a rr:CapabilityOwner ;
             rr:repository ?repository ;
             rr:role ?role ;
             rr:authority ?authority .
    }
    ORDER BY ?repository
---
{
  "schema": "ggen.repository-reconstitution.manifest.v1",
  "product": "{{ spec[0].product }}",
  "release": "{{ spec[0].release }}",
  "strategy": "{{ spec[0].strategy }}",
  "controls": {
    "exact_subject_required": {{ spec[0].requires_exact }},
    "independent_verifier_required": {{ spec[0].requires_verifier }},
    "replay_required": {{ spec[0].requires_replay }},
    "release_admitted": {{ spec[0].release_admitted }},
    "sunset_admitted": {{ spec[0].sunset_admitted }}
  },
  "owners": [
{%- for owner in owners %}
    {
      "repository": "{{ owner.repository }}",
      "role": "{{ owner.role }}",
      "authority": "{{ owner.authority }}"
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
