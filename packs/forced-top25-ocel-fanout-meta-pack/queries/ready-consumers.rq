PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?owner ?repo ?rank ?consumer_head ?ggen_source_head ?compatibility_state ?fanout_state ?qualification_state
WHERE {
  ?t a r90:FanoutTarget ; r90:owner ?owner ; r90:repo ?repo ; r90:rank ?rank ;
     r90:exactConsumerHead ?consumer_head ; r90:exactGgenSourceHead ?ggen_source_head ;
     r90:compatibilityState ?compatibility_state ; r90:fanoutState ?fanout_state ;
     r90:qualificationState ?qualification_state .
  FILTER(?compatibility_state = "COMPATIBLE_READY" || ?compatibility_state = "COMPATIBLE_ADMITTED")
  FILTER(STRLEN(?consumer_head) = 40)
}
ORDER BY ?rank ?repo
