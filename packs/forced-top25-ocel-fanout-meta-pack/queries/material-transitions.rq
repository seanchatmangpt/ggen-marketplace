PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?owner ?repo ?consumer_head ?ggen_source_head ?event WHERE {
  ?t a r90:FanoutTarget ; r90:owner ?owner ; r90:repo ?repo ; r90:exactConsumerHead ?consumer_head ; r90:exactGgenSourceHead ?ggen_source_head ; r90:fanoutState ?fanout_state ; r90:qualificationState ?qualification_state .
  VALUES ?event { "admit" "select" "generate" "realize" "refuse" }
  FILTER((?event="realize" && ?fanout_state="DOWNSTREAM_REALIZED") || (?event="refuse" && CONTAINS(?qualification_state,"REFUSED")) || ?event="admit" || ?event="select" || ?event="generate")
}
ORDER BY ?repo ?event
