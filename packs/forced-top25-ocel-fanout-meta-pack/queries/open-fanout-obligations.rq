PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?owner ?repo ?rank WHERE {
  ?t a r90:FanoutTarget ; r90:owner ?owner ; r90:repo ?repo ; r90:rank ?rank ; r90:compatibilityState ?c .
  FILTER(?c = "COMPATIBLE_READY" || ?c = "COMPATIBLE_ADMITTED")
  FILTER NOT EXISTS { ?t r90:fanoutState "DEFAULT_LINEAGE_ASSIMILATED" }
}
ORDER BY ?rank
