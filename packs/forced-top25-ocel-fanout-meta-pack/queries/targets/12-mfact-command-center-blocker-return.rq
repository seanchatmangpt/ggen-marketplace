PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?compatibility ?blocker WHERE { ?target a r90:FanoutTarget ; r90:rank 12 ; r90:owner "seanchatmangpt" ; r90:repo "mfact-command-center" ; r90:compatibilityState ?compatibility ; r90:blocker ?blocker . FILTER(STRLEN(STR(?blocker)) > 0) BIND(12 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("mfact-command-center" AS ?repo) } ORDER BY ?rank
