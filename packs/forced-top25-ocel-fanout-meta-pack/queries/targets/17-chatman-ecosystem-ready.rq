PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?consumer_head ?ggen_source_head WHERE { ?target a r90:FanoutTarget ; r90:rank 17 ; r90:owner "seanchatmangpt" ; r90:repo "chatman-ecosystem" ; r90:compatibilityState ?compatibility ; r90:exactConsumerHead ?consumer_head ; r90:exactGgenSourceHead ?ggen_source_head . VALUES ?compatibility { "COMPATIBLE_READY" "COMPATIBLE_ADMITTED" } OPTIONAL { ?target r90:blocker ?blocker } FILTER(!BOUND(?blocker) || STRLEN(STR(?blocker)) = 0) BIND(17 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("chatman-ecosystem" AS ?repo) } ORDER BY ?rank
