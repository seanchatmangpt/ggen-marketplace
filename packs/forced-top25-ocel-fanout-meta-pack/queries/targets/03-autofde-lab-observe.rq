PREFIX r90:<https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?consumer_head ?ggen_source_head WHERE{?target a r90:FanoutTarget;r90:rank 3;r90:owner "seanchatmangpt";r90:repo "autofde-lab";r90:fanoutState "DOWNSTREAM_REALIZED";r90:exactConsumerHead ?consumer_head;r90:exactGgenSourceHead ?ggen_source_head. OPTIONAL{?target r90:qualificationState ?qualification} FILTER(!BOUND(?qualification)||?qualification="UNKNOWN"||?qualification="UNOBSERVED") BIND(3 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("autofde-lab" AS ?repo)} ORDER BY ?rank
