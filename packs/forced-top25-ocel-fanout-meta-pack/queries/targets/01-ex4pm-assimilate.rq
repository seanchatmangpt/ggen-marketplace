PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?consumer_head ?ggen_source_head WHERE {
  ?target a r90:FanoutTarget ; r90:rank 1 ; r90:owner "seanchatmangpt" ; r90:repo "ex4pm" ; r90:qualificationState ?qualification ; r90:exactConsumerHead ?consumer_head ; r90:exactGgenSourceHead ?ggen_source_head .
  FILTER(STRSTARTS(?qualification, "ALIVE"))
  OPTIONAL { ?target r90:fanoutState ?fanout }
  FILTER(!BOUND(?fanout) || ?fanout != "DEFAULT_ASSIMILATED")
  BIND(1 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("ex4pm" AS ?repo)
}
ORDER BY ?rank
