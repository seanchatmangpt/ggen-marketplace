PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?consumer_head ?ggen_source_head ?qualification WHERE { ?target a r90:FanoutTarget ; r90:rank 11 ; r90:owner "seanchatmangpt" ; r90:repo "mfact" ; r90:fanoutState "DOWNSTREAM_REALIZED" ; r90:qualificationState ?qualification ; r90:exactConsumerHead ?consumer_head ; r90:exactGgenSourceHead ?ggen_source_head . OPTIONAL { ?target r90:blocker ?blocker } FILTER(!BOUND(?blocker) || STRLEN(STR(?blocker)) = 0) BIND(11 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("mfact" AS ?repo) } ORDER BY ?rank
