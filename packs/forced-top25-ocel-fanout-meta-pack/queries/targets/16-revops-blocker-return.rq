PREFIX r90: <https://ggen.dev/ontology/r90#>
SELECT ?rank ?owner ?repo ?compatibility ?blocker WHERE { ?target a r90:FanoutTarget ; r90:rank 16 ; r90:owner "seanchatmangpt" ; r90:repo "revops" ; r90:compatibilityState ?compatibility ; r90:blocker ?blocker . FILTER(STRLEN(STR(?blocker)) > 0) BIND(16 AS ?rank) BIND("seanchatmangpt" AS ?owner) BIND("revops" AS ?repo) } ORDER BY ?rank
