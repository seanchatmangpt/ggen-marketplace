r90:CanonicalPolicy a r90:CompositionPlan ;
  r90:exactGgenSourceHead "8f881772256de00cbfbc1e410324f6c4a1ec7134" ;
  r90:authorityMode "VERIFY|CONSTRUCT" ;
  r90:processAnalysisOwner "wasm4pm" .

