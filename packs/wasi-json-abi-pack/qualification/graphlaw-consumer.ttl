# QUALIFICATION: graphlaw-wasm consumer graph (graphlaw v26.9.29, 14-op JSON ABI over
# gl_alloc / gl_free / gl_call, wasm32-wasip1). ffi.rs is not selected by this graph.

@prefix wja: <https://ggen.dev/ontology/wasi-json-abi#> .
@prefix gl: <https://graphlaw.dev/wasm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gl:module a wja:WasmModule ;
    wja:crateName "graphlaw-wasm" ;
    wja:exportPrefix "gl" ;
    wja:abiVersion 1 ;
    wja:maxRequestBytes 16777216 ;
    wja:maxJsonDepth 64 ;
    wja:stackSizeBytes 16777216 ;
    wja:importsPolicy "wasi_snapshot_preview1" ;
    wja:errorStyle "refusal-kind" ;
    wja:hasOp gl:op-capabilities , gl:op-sniff , gl:op-parse , gl:op-convert , gl:op-canonical , gl:op-sparql , gl:op-shacl , gl:op-shex , gl:op-n3 , gl:op-entail , gl:op-datalog , gl:op-hooks , gl:op-law , gl:op-policy ;
    wja:hasErrorCode gl:err-notsemanticcontent , gl:err-ambiguous , gl:err-enginerejected , gl:err-unsupported , gl:err-resourcelimit .

gl:op-capabilities a wja:Op ;
    wja:opName "capabilities" ;
    wja:opOrder 1 .

gl:op-sniff a wja:Op ;
    wja:opName "sniff" ;
    wja:opOrder 2 .

gl:op-parse a wja:Op ;
    wja:opName "parse" ;
    wja:opOrder 3 .

gl:op-convert a wja:Op ;
    wja:opName "convert" ;
    wja:opOrder 4 .

gl:op-canonical a wja:Op ;
    wja:opName "canonical" ;
    wja:opOrder 5 .

gl:op-sparql a wja:Op ;
    wja:opName "sparql" ;
    wja:opOrder 6 .

gl:op-shacl a wja:Op ;
    wja:opName "shacl" ;
    wja:opOrder 7 .

gl:op-shex a wja:Op ;
    wja:opName "shex" ;
    wja:opOrder 8 .

gl:op-n3 a wja:Op ;
    wja:opName "n3" ;
    wja:opOrder 9 .

gl:op-entail a wja:Op ;
    wja:opName "entail" ;
    wja:opOrder 10 .

gl:op-datalog a wja:Op ;
    wja:opName "datalog" ;
    wja:opOrder 11 .

gl:op-hooks a wja:Op ;
    wja:opName "hooks" ;
    wja:opOrder 12 .

gl:op-law a wja:Op ;
    wja:opName "law" ;
    wja:opOrder 13 .

gl:op-policy a wja:Op ;
    wja:opName "policy" ;
    wja:opOrder 14 .

gl:err-notsemanticcontent a wja:ErrorCode ; wja:codeName "NotSemanticContent" ; wja:codeOrder 1 .
gl:err-ambiguous a wja:ErrorCode ; wja:codeName "Ambiguous" ; wja:codeOrder 2 .
gl:err-enginerejected a wja:ErrorCode ; wja:codeName "EngineRejected" ; wja:codeOrder 3 .
gl:err-unsupported a wja:ErrorCode ; wja:codeName "Unsupported" ; wja:codeOrder 4 .
gl:err-resourcelimit a wja:ErrorCode ; wja:codeName "ResourceLimit" ; wja:codeOrder 5 .
