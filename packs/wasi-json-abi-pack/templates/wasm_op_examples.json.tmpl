{%- set ex_list = examples | split(pat="@@") | sort -%}
{
  "abi_version": {{ abi_version }},
  "examples": [
{%- for e in ex_list %}
{%- set p = e | split(pat="##") %}
    {
      "op": {{ p[1] | json_encode() | safe }},
      "request": {% for t in p | slice(start=2) %}{% if not loop.first %}##{% endif %}{{ t | safe }}{% endfor %}
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "schema": "wasi-json-abi.op-examples/1"
}
