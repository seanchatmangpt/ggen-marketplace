# {{ crate_name }} release artifacts (ABI version {{ abi_version }}). Format: <kind> <sha256> <bytes> <name>
# Consumed query columns (artifacts.rq): crate_name, abi_version, wasm_sha256, wasm_bytes,
# registry_sha256, surface_sha256 (pin lines render only when the graph carries the pin facts).
# Rendered by ggen (wasi-json-abi-pack) from the wja: graph; this is a SKELETON.
# The wasm line is a pin ENFORCED by the generated harness (generated/tests_common.rs,
# `assert_pin`): it builds the wasm when the env var is unset, PANICS on a placeholder
# pin, and PANICS on a size or sha256 mismatch; it never skips. Replace the
# placeholders with the digest and size of the module built by
#   cargo build --locked --target wasm32-wasip1 --profile wasm
# and regenerate the pin after any src/ change.
{% if wasm_sha256 and wasm_bytes %}wasm {{ wasm_sha256 }} {{ wasm_bytes }} {{ crate_name | replace(from="-", to="_") }}.wasm{% else %}wasm <sha256> <bytes> {{ crate_name | replace(from="-", to="_") }}.wasm{% endif %}{% if registry_sha256 %}
registry sha256:{{ registry_sha256 }} - capability-registry.json{% endif %}{% if surface_sha256 %}
surface sha256:{{ surface_sha256 }} - capability-registry.json{% endif %}
