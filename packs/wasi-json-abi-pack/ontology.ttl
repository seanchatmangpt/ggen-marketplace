# ontology.ttl — wasi-json-abi-pack
# ============================================================================
# FAILED-EDGE RECORD against the public vocabulary set (why wja: exists)
# ============================================================================
# Public vocabularies precede custom namespaces; each candidate was evaluated:
#
# 1. wasm-core / WebAssembly text-format vocabularies (structural WASM module
#    grammar): describe instructions, sections and imports of a binary. Failed
#    edge: no term for a JSON request/response ABI, a linear-memory allocation
#    contract, per-module request-size or JSON-depth limits, or typed error
#    codes returned to the host.
# 2. WASI (wasi_snapshot_preview1 witx interface definitions): defines syscall
#    signatures. Failed edge: it types the host imports, not the module's own
#    export surface; an imports-policy (WASI-only closure) has no class.
# 3. OpenAPI / JSON Schema vocabularies: type request/response bodies. Failed
#    edge: they have no notion of exported symbols with a naming prefix, an
#    alloc/free memory protocol, or ordered op tables bound to an ABI version.
# 4. dcterms: / rdfs: cover labels, versions and comments and are REUSED
#    (rdfs:label, rdfs:comment); they cannot carry a byte limit or op order.
# Everything minted below is a term whose failed edge is recorded above.
#
# Failed edges considered at v26.10.0 (wire-convention consolidation) and NOT
# encoded:
# 5. Per-op export dispatch geometry (one export symbol per algorithm, the
#    wasm4pm <algo>_v1 shape). wja:dispatchStyle was considered and rejected:
#    the rendered shell is a single <prefix>_call dispatching ops by request
#    field, no pack consumer renders per-op exports through this pack yet, and
#    the naming facts that DO exist (wja:opSymbolPrefix, wja:symbolSuffix,
#    wja:hasReplayCompanion) plus the ABI-doc projections already express the
#    per-op surface. UNSUPPORTED(ffi shell, per-op export dispatch) until a
#    consumer orders it -- record the failed edge, prune nothing silently.
# 6. wja:startupConvention (reactor _initialize) is admitted on coordinator
#    survey testimony of the rust->wasm->elixir convergence; a grep over
#    graphlaw/wasm/src, affidavit-wasm/src and wasm4pm-ex4pm-bindings/src at
#    encoding time (2026-10-01) witnessed no _initialize, so its local
#    standing is UNKNOWN-by-inspection and the fact stays optional.
# ============================================================================

@prefix wja: <https://ggen.dev/ontology/wasi-json-abi#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# -- Classes --

wja:WasmModule a rdfs:Class ;
    rdfs:label "WASM module" ;
    rdfs:comment "A WASI module exposing a JSON ABI: <exportPrefix>_abi_version, _alloc, _free, _call." .

wja:Op a rdfs:Class ;
    rdfs:label "Operation" ;
    rdfs:comment "A named operation dispatched by _call; carries ordered request/response field lists and an example request." .

wja:ErrorCode a rdfs:Class ;
    rdfs:label "Error code" ;
    rdfs:comment "A typed error code the module may return in a JSON error response." .

# -- WasmModule properties --

wja:crateName a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "crate name" ;
    rdfs:comment "Name of the Rust crate that hosts the module." .

wja:exportPrefix a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "export prefix" ;
    rdfs:comment "Prefix of the four exported symbols, e.g. ex yields ex_alloc." .

wja:abiVersion a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:integer ;
    rdfs:label "ABI version" ;
    rdfs:comment "Integer returned by <prefix>_abi_version." .

wja:maxRequestBytes a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:integer ;
    rdfs:label "max request bytes" ;
    rdfs:comment "Upper bound on request size; alloc returns null and call returns a typed limit error above it." .

wja:maxJsonDepth a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:integer ;
    rdfs:label "max JSON depth" ;
    rdfs:comment "Upper bound on JSON nesting depth accepted by the module." .

wja:stackSizeBytes a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:integer ;
    rdfs:label "stack size bytes" ;
    rdfs:comment "Linear-memory stack size rendered into the cargo config." .

wja:importsPolicy a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "imports policy" ;
    rdfs:comment "Closed set {wasi_snapshot_preview1, none}. wasi_snapshot_preview1: the module may import only WASI (any enumerated wja:WasiImport must use that module). none: the module imports nothing at all -- a hard zero-import invariant (the wasm4pm/ex4pm family, down from 87 __wbindgen_* imports); a module with importsPolicy none must not enumerate any wja:WasiImport (gates/060_imports_policy_wasi_only.rq)." .

wja:hasOp a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range wja:Op ;
    rdfs:label "has op" ;
    rdfs:comment "Links a module to an op it dispatches." .

wja:hasErrorCode a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range wja:ErrorCode ;
    rdfs:label "has error code" ;
    rdfs:comment "Links a module to an error code it may return." .

# -- Op properties --

wja:opName a rdf:Property ;
    rdfs:domain wja:Op ; rdfs:range xsd:string ;
    rdfs:label "op name" ;
    rdfs:comment "Wire name of the op." .

wja:opOrder a rdf:Property ;
    rdfs:domain wja:Op ; rdfs:range xsd:integer ;
    rdfs:label "op order" ;
    rdfs:comment "Stable ordinal fixing the op's position in the op table." .

wja:requestFields a rdf:Property ;
    rdfs:domain wja:Op ; rdfs:range xsd:string ;
    rdfs:label "request fields" ;
    rdfs:comment "Comma-separated request field names." .

wja:responseFields a rdf:Property ;
    rdfs:domain wja:Op ; rdfs:range xsd:string ;
    rdfs:label "response fields" ;
    rdfs:comment "Comma-separated response field names." .

wja:exampleRequest a rdf:Property ;
    rdfs:domain wja:Op ; rdfs:range xsd:string ;
    rdfs:label "example request" ;
    rdfs:comment "A JSON request string used for op-examples.json and differential tests." .

# -- ErrorCode properties --

wja:codeName a rdf:Property ;
    rdfs:domain wja:ErrorCode ; rdfs:range xsd:string ;
    rdfs:label "code name" ;
    rdfs:comment "Wire name of the error code." .

wja:codeOrder a rdf:Property ;
    rdfs:domain wja:ErrorCode ; rdfs:range xsd:integer ;
    rdfs:label "code order" ;
    rdfs:comment "Stable ordinal fixing the code's position in the error table." .

# -- Guard prelude + wasmi harness facts (WasmModule) --
# Consumed by queries/guards.rq and queries/harness.rq. Closed-set and cross-fact
# rules are enforced by gates/070_error_style_closed.rq.

wja:errorStyle a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "error style" ;
    rdfs:comment "Closed set {flat-code, refusal-kind, result-digest}. flat-code: {ok:false,error:{code,message,..}} with string codes drawn from the error table (guards fully generated). refusal-kind: the consumer owns a richer refusal envelope (only json_depth and the ordering helper are generated; the envelope is a HANDWRITTEN.md residue row). result-digest: success envelope {\"result\":<body>,\"digest\":\"<hex>\"} and failure envelope {\"error\":<message>} carrying NO digest; requires the four wja:digest facts (gates/110_wire_convention_closed.rq). The digest wraps the op result, not the refusal: a refused request has no digest by construction." .

wja:codeRequestTooLarge a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "code: request too large" ;
    rdfs:comment "flat-code only: wire code returned when the request length exceeds maxRequestBytes; must be a declared wja:codeName." .

wja:codeJsonTooDeep a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "code: JSON too deep" ;
    rdfs:comment "flat-code only: wire code returned when nesting exceeds maxJsonDepth; must be a declared wja:codeName." .

wja:codeMissingBuffer a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "code: missing buffer" ;
    rdfs:comment "flat-code only: wire code returned when _call receives a null request buffer; must be a declared wja:codeName." .

wja:codeInternal a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "code: internal" ;
    rdfs:comment "Optional (flat-code): code used by the encode fallback; defaults to internal." .

wja:wasmEnvVar a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "wasm env var" ;
    rdfs:comment "Environment variable naming a prebuilt .wasm for the harness; when unset the harness builds the module." .

wja:wasmBuildPackage a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "wasm build package" ;
    rdfs:comment "Optional cargo package (-p) that builds the wasm; absent means --lib of the current crate." .

wja:hasAbiVersionExport a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:boolean ;
    rdfs:label "has abi_version export" ;
    rdfs:comment "Whether the module exports <prefix>_abi_version (harness binds it and asserts it equals abiVersion)." .

wja:nativeCall a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "native call" ;
    rdfs:comment "Rust path of the native entry point fn(&[u8]) -> Vec<u8>, e.g. echo_wasm::abi::call." .

wja:cfgGate a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "cfg gate" ;
    rdfs:comment "Optional cfg predicate placed in #![cfg(..)] on the harness; default not(target_arch = \"wasm32\")." .

wja:pinEnv a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "pin env" ;
    rdfs:comment "Optional environment variable naming a pin file that replaces the pin text passed to assert_pin. Never turns the check off." .

wja:examplesPath a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "examples path" ;
    rdfs:comment "Optional manifest-relative path of op-examples.json read by the harness; default registry/op-examples.json." .

# -- Allocation discipline facts (WasmModule; optional, consumed by queries/ffi.rq and queries/meta.rq) --
# Absent facts keep the default boxed-slice shell with no outstanding-byte accounting.
# Closed-set and cross-fact rules are enforced by gates/100_alloc_discipline_closed.rq.

wja:maxOutstandingBytes a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:integer ;
    rdfs:label "max outstanding bytes" ;
    rdfs:comment "Optional cap on bytes handed to the host (alloc buffers and call responses) and not yet freed; alloc returns null once a reservation would exceed it. Rendered into abi_meta as MAX_OUTSTANDING_BYTES and enforced by the generated ffi shell. Must be >= maxRequestBytes." .

wja:bufferStyle a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "buffer style" ;
    rdfs:comment "Optional closed set {boxed-slice, vec}; default boxed-slice. boxed-slice: every buffer is a Box<[u8]> of length max(len,1), zeroed on alloc. vec: every buffer is a Vec<u8> with capacity max(len,1), reconstructed with Vec::from_raw_parts (the allocation discipline of graphlaw's wasm/src/lib.rs)." .

wja:abiModulePath a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "ABI module path" ;
    rdfs:comment "Optional Rust path of the safe core exposing call, limit_response and missing_buffer_response; default crate::abi (graphlaw: graphlaw::abi)." .

# -- Wire-convention facts (WasmModule; optional, consumed by queries/ffi.rq,
#    queries/registry.rq and queries/abi_doc.rq) --
# Absent facts keep the historical packed-u64, call-consumes, prefixed-symbol
# shell byte-for-byte. Closed sets and cross-fact rules are enforced by
# gates/110_wire_convention_closed.rq. The converged family this section
# captures (re-verified against source 2026-10-01): graphlaw (packed-u64,
# call-consumes, vec buffers, 256 MiB outstanding cap, no abi_version export),
# affidavit-wasm (packed-u64, af_abi_version export), wasm4pm/ex4pm-bindings
# (out-len-pointer, _v1 suffix, host-dealloc dealloc/free split, zero imports,
# FNV-1a result-digest envelope, per-algo replay companions).

wja:returnConvention a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "return convention" ;
    rdfs:comment "Closed set {packed-u64, out-len-pointer}; default packed-u64. packed-u64: the call export returns (out_ptr << 32) | out_len in one u64 (graphlaw gl_call, affidavit af_call). out-len-pointer: the call export takes an out_len pointer and returns the out_ptr directly, writing the response length through the pointer ((ptr, len, out_len) -> out_ptr; the wasm4pm_ex4pm_<algo>_v1 convention)." .

wja:symbolSuffix a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "symbol suffix" ;
    rdfs:comment "Optional versioned suffix appended to every exported symbol, e.g. _v1 yields <prefix>_alloc_v1 / _call_v1 / _free_v1 (wasm4pm). Must match ^(_[a-z][a-z0-9_]*)?$; default empty." .

wja:opSymbolPrefix a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "op symbol prefix" ;
    rdfs:comment "Optional prefix of the per-op export symbols under the out-len-pointer convention; default is the module's exportPrefix. wasm4pm uses wasm4pm_ex4pm for per-algo exports while its core exports use wasm4pm_ex4pm_bindings, so the two prefixes are distinct facts." .

wja:inputReleasePolicy a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "input release policy" ;
    rdfs:comment "Closed set {call-consumes, host-dealloc}; default call-consumes. call-consumes: running the call frees the request buffer; <prefix>_free releases both request and response buffers (graphlaw/affidavit shell). host-dealloc: reading an input never frees it; the host owns both releases -- <prefix>_dealloc releases request buffers, <prefix>_free releases response buffers (the wasm4pm dealloc_v1/free_v1 split). host-dealloc and wja:maxOutstandingBytes are mutually exclusive because the outstanding cap models buffers the module consumed (gates/110_wire_convention_closed.rq)." .

wja:abiVersionExportName a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "abi version export name" ;
    rdfs:comment "Optional full symbol name of the abi-version export, overriding the default <prefix>_abi_version<suffix> (wasm4pm names it wasm4pm_ex4pm_bindings_version_v1). A required surface element when wja:hasAbiVersionExport is true: the harness asserts it equals wja:abiVersion and the exports projections list it; naming it while hasAbiVersionExport is false is refused." .

wja:startupConvention a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "startup convention" ;
    rdfs:comment "Closed set {cdylib, reactor-initialize}; default cdylib. reactor-initialize: the module is built as a WASI reactor and the host drives it through the _initialize export. Declared on coordinator survey of the rust->wasm->elixir convergence; not re-witnessed in the three local pipelines at encoding time (see the failed-edge record below)." .

# -- Result-digest envelope facts (WasmModule; require errorStyle result-digest) --

wja:digestAlgorithm a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "digest algorithm" ;
    rdfs:comment "Algorithm of the digest embedded in a result-digest success envelope. Admitted value: FNV-1a-64 (offset basis 0xcbf29ce484222325, prime 0x100000001b3 -- definitional constants of the algorithm, not module parameters). A cheap non-cryptographic replay self-check; receipt identity hashing stays with the consumer (e.g. BLAKE3 on the ex4pm side)." .

wja:digestInput a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "digest input" ;
    rdfs:comment "Closed set {result-body, full-envelope}: which serialization bytes the digest covers. wasm4pm digests the serialized result body only, never the whole envelope." .

wja:digestFormat a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "digest format" ;
    rdfs:comment "Rust format spec of the rendered digest, e.g. {:016x} (zero-padded lowercase hex)." .

wja:digestHexChars a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:integer ;
    rdfs:label "digest hex chars" ;
    rdfs:comment "Length in hex characters of the rendered digest (16 for FNV-1a-64); positive and bounded." .

# -- Op-level surface facts (wja:Op) --

wja:hasReplayCompanion a rdf:Property ;
    rdfs:domain wja:Op ; rdfs:range xsd:boolean ;
    rdfs:label "has replay companion" ;
    rdfs:comment "Whether the op exposes a per-algo replay export named <opSymbolPrefix>_<opName>_replay<symbolSuffix>: it re-executes the same computation from the same request bytes and returns 1 iff the recomputed response is non-empty; the host compares digest fields of original and recomputed responses. Deterministic computations make equal requests yield equal digests (the wasm4pm <algo>_replay_v1 surface)." .

wja:opSourceFile a rdf:Property ;
    rdfs:domain wja:Op ; rdfs:range xsd:string ;
    rdfs:label "op source file" ;
    rdfs:comment "Optional consumer source file implementing the op body (e.g. src/phase2.rs), rendered as the source column of the ABI-doc exports table; absent renders as -." .

# -- Host imports and release pins (consumer facts; graphlaw v26.9.29 specimen) --

wja:WasiImport a rdfs:Class ;
    rdfs:label "WASI import" ;
    rdfs:comment "One host import of the module; importModule must equal the module's importsPolicy." .

wja:hasWasiImport a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range wja:WasiImport ;
    rdfs:label "has WASI import" ;
    rdfs:comment "Links a module to one of its enumerated host imports." .

wja:importModule a rdf:Property ;
    rdfs:domain wja:WasiImport ; rdfs:range xsd:string ;
    rdfs:label "import module" ;
    rdfs:comment "Import module namespace; the only admitted value is wasi_snapshot_preview1." .

wja:importName a rdf:Property ;
    rdfs:domain wja:WasiImport ; rdfs:range xsd:string ;
    rdfs:label "import name" ;
    rdfs:comment "Import field name, e.g. fd_write." .

wja:wasmSha256 a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "wasm sha256" ;
    rdfs:comment "Lowercase hex sha256 (64 chars) of the pinned release wasm; a pin, not a live check." .

wja:wasmBytes a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:integer ;
    rdfs:label "wasm bytes" ;
    rdfs:comment "Size in bytes of the pinned release wasm." .

wja:registrySha256 a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "registry sha256" ;
    rdfs:comment "Lowercase hex sha256 (64 chars) of the module's published capability registry." .

wja:surfaceSha256 a rdf:Property ;
    rdfs:domain wja:WasmModule ; rdfs:range xsd:string ;
    rdfs:label "surface sha256" ;
    rdfs:comment "Lowercase hex sha256 (64 chars) of the module's capability surface digest." .
