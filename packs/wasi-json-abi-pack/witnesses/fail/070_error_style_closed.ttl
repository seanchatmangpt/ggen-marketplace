# FAIL witness for gate 070_error_style_closed: VIOLATION: errorStyle "nested-code" is outside the closed set.
@prefix wja: <https://ggen.dev/ontology/wasi-json-abi#> .
@prefix ex: <https://example.org/echo-wasm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wja:WasmModule a rdfs:Class .
wja:Op a rdfs:Class .
wja:ErrorCode a rdfs:Class .

ex:module a wja:WasmModule ;
    wja:crateName "echo-wasm" ;
    wja:exportPrefix "ex" ;
    wja:abiVersion 1 ;
    wja:maxRequestBytes 1048576 ;
    wja:maxJsonDepth 64 ;
    wja:stackSizeBytes 16777216 ;
    wja:importsPolicy "wasi_snapshot_preview1" ;
    wja:errorStyle "nested-code" ;
    wja:codeRequestTooLarge "LIMIT_REQUEST_BYTES" ;
    wja:codeJsonTooDeep "LIMIT_JSON_DEPTH" ;
    wja:codeMissingBuffer "NULL_INPUT" ;
    wja:codeInternal "INTERNAL" ;
    wja:wasmEnvVar "ECHO_WASM" ;
    wja:hasAbiVersionExport true ;
    wja:nativeCall "echo_wasm::abi::call" ;
    wja:pinEnv "ECHO_WASM_PIN" ;
    wja:hasOp ex:op-echo , ex:op-len ;
    wja:hasErrorCode ex:err-bad-json , ex:err-unknown-op , ex:err-limit-request , ex:err-limit-depth , ex:err-null-input , ex:err-internal .

ex:op-echo a wja:Op ;
    wja:opName "echo" ;
    wja:opOrder 1 ;
    wja:requestFields "op,text" ;
    wja:responseFields "ok,text" ;
    wja:exampleRequest "{\"op\":\"echo\",\"text\":\"hi\"}" .

ex:op-len a wja:Op ;
    wja:opName "len" ;
    wja:opOrder 2 ;
    wja:requestFields "op,text" ;
    wja:responseFields "ok,len" ;
    wja:exampleRequest "{\"op\":\"len\",\"text\":\"hi\"}" .

ex:err-bad-json a wja:ErrorCode ; wja:codeName "BAD_JSON" ; wja:codeOrder 1 .
ex:err-unknown-op a wja:ErrorCode ; wja:codeName "UNKNOWN_OP" ; wja:codeOrder 2 .
ex:err-limit-request a wja:ErrorCode ; wja:codeName "LIMIT_REQUEST_BYTES" ; wja:codeOrder 3 .
ex:err-limit-depth a wja:ErrorCode ; wja:codeName "LIMIT_JSON_DEPTH" ; wja:codeOrder 4 .
ex:err-null-input a wja:ErrorCode ; wja:codeName "NULL_INPUT" ; wja:codeOrder 5 .
ex:err-internal a wja:ErrorCode ; wja:codeName "INTERNAL" ; wja:codeOrder 6 .
