# MESSAGE: wja:exportPrefix must be a valid C identifier prefix matching ^[a-z][a-z0-9_]*$ so that <prefix>_alloc, _free, _call and _abi_version are legal exported symbols.
PREFIX wja: <https://ggen.dev/ontology/wasi-json-abi#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?problem ?detail WHERE {
  ?m a wja:WasmModule ;
     wja:exportPrefix ?p .
  FILTER(!isLiteral(?p) || !REGEX(STR(?p), "^[a-z][a-z0-9_]*$"))
  BIND("export_prefix_not_c_identifier" AS ?problem)
  BIND(CONCAT("exportPrefix=", STR(?p)) AS ?detail)
}
ORDER BY ?detail
