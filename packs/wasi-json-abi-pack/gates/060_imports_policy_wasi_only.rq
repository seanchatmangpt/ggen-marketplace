# MESSAGE: wja:importsPolicy must be exactly "wasi_snapshot_preview1"; any other import module is refused so the module stays WASI-only.
PREFIX wja: <https://ggen.dev/ontology/wasi-json-abi#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?problem ?detail WHERE {
  ?m a wja:WasmModule ;
     wja:importsPolicy ?p .
  FILTER(!isLiteral(?p) || STR(?p) != "wasi_snapshot_preview1")
  BIND("imports_policy_not_wasi_only" AS ?problem)
  BIND(CONCAT("importsPolicy=", STR(?p)) AS ?detail)
}
ORDER BY ?detail
