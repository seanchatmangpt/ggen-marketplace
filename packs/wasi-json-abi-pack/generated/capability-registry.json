{
  "abi_version": 1,
  "crate": "echo-wasm",
  "error_codes": [
    "BAD_JSON",
    "UNKNOWN_OP",
    "LIMIT_REQUEST_BYTES",
    "LIMIT_JSON_DEPTH",
    "NULL_INPUT",
    "INTERNAL"
  ],
  "exports": [
    "ex_abi_version",
    "ex_alloc",
    "ex_call",
    "ex_free"
  ],
  "imports_policy": "wasi_snapshot_preview1",
  "limits": {
    "max_json_depth": 64,
    "max_request_bytes": 1048576,
    "stack_size_bytes": 16777216
  },
  "ops": [
    {
      "name": "echo",
      "request_fields": ["op", "text"],
      "response_fields": ["ok", "text"]
    },
    {
      "name": "len",
      "request_fields": ["op", "text"],
      "response_fields": ["ok", "len"]
    }
  ],
  "schema": "wasi-json-abi.capability-registry/1"
}
