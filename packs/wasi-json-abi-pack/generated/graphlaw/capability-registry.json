{
  "abi_version": 1,
  "crate": "graphlaw-wasm",
  "error_codes": [
    "NotSemanticContent",
    "Ambiguous",
    "EngineRejected",
    "Unsupported",
    "ResourceLimit"
  ],
  "exports": [
    "gl_abi_version",
    "gl_alloc",
    "gl_call",
    "gl_free"
  ],
  "imports_policy": "wasi_snapshot_preview1",
  "limits": {
    "max_json_depth": 64,
    "max_request_bytes": 16777216,
    "stack_size_bytes": 16777216
  },
  "ops": [
    {
      "name": "capabilities",
      "request_fields": ["op"],
      "response_fields": ["ok", "abi", "abi_version", "crate", "authorities", "rdf_dialects", "other_dialects", "ops", "registry_schema", "registry_sha256", "surface_sha256"]
    },
    {
      "name": "sniff",
      "request_fields": ["op", "text", "hint"],
      "response_fields": ["ok", "dialect", "engine"]
    },
    {
      "name": "parse",
      "request_fields": ["op", "text", "dialect", "hint", "base"],
      "response_fields": ["ok", "dialect", "quads", "id", "valid"]
    },
    {
      "name": "convert",
      "request_fields": ["op", "text", "to", "dialect", "hint", "base"],
      "response_fields": ["ok", "text", "id"]
    },
    {
      "name": "canonical",
      "request_fields": ["op", "data"],
      "response_fields": ["ok", "id", "nquads", "quads"]
    },
    {
      "name": "sparql",
      "request_fields": ["op", "data", "query", "base"],
      "response_fields": ["ok", "variables", "rows", "nquads", "quads", "value"]
    },
    {
      "name": "shacl",
      "request_fields": ["op", "data", "shapes", "base"],
      "response_fields": ["ok", "conforms", "results"]
    },
    {
      "name": "shex",
      "request_fields": ["op", "data", "schema", "schema_dialect", "map", "base"],
      "response_fields": ["ok", "conforms", "entries"]
    },
    {
      "name": "n3",
      "request_fields": ["op", "text"],
      "response_fields": ["ok", "derived"]
    },
    {
      "name": "entail",
      "request_fields": ["op", "data", "regime"],
      "response_fields": ["ok", "nquads", "added"]
    },
    {
      "name": "datalog",
      "request_fields": ["op", "rules", "facts"],
      "response_fields": ["ok", "count", "facts"]
    },
    {
      "name": "hooks",
      "request_fields": ["op", "pack", "data"],
      "response_fields": ["ok", "id", "rounds", "quads", "nquads", "firings"]
    },
    {
      "name": "law",
      "request_fields": ["op", "data", "steps", "signed_lease", "lease", "trusted_keys", "max_skew_secs", "unverified_lease", "now_unix"],
      "response_fields": ["ok", "states", "receipts", "nquads"]
    },
    {
      "name": "policy",
      "request_fields": ["op", "problem", "policy"],
      "response_fields": ["ok", "initial_states", "reachable", "goal_states", "entries", "ntriples"]
    }
  ],
  "schema": "wasi-json-abi.capability-registry/1"
}
