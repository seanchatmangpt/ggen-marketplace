# Violation rows: protocol vocabulary must stay inside autofde-lab's closed sets.
PREFIX spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#>
SELECT ?subject ?field ?value WHERE {
  {
    ?subject a spg:RetrofitCase ; spg:behavior ?value .
    FILTER(?value != "preserved" && ?value != "broken" &&
           ?value != "invalid" && ?value != "unavailable")
    BIND("behavior" AS ?field)
  } UNION {
    ?subject a spg:RetrofitCase ; spg:gateStrength ?value .
    FILTER(?value != "detected" && ?value != "blind" &&
           ?value != "vacuous" && ?value != "none")
    BIND("gateStrength" AS ?field)
  } UNION {
    ?subject a spg:DimensionObservation ; spg:evidenceStatus ?value .
    FILTER(?value != "pass" && ?value != "fail" &&
           ?value != "timeout" && ?value != "unavailable" &&
           ?value != "not_applicable")
    BIND("evidenceStatus" AS ?field)
  } UNION {
    ?subject a spg:EvidenceReceipt ; spg:verdict ?value .
    FILTER(?value != "PASS" && ?value != "COUNTEREXAMPLE" &&
           ?value != "BLOCKED" && ?value != "UNSUPPORTED")
    BIND("verdict" AS ?field)
  } UNION {
    ?subject a spg:ProbeSpec ; spg:role ?value .
    FILTER(?value != "governance" && ?value != "behavior" &&
           ?value != "mutation" && ?value != "clean_environment" &&
           ?value != "replay")
    BIND("probe.role" AS ?field)
  } UNION {
    ?subject a spg:ProbeSpec ; spg:scope ?value .
    FILTER(?value != "base" && ?value != "treated" && ?value != "both")
    BIND("probe.scope" AS ?field)
  } UNION {
    ?subject a spg:ProbeSpec ; spg:comparison ?value .
    FILTER(?value != "exit_only" && ?value != "stdout_digest")
    BIND("probe.comparison" AS ?field)
  } UNION {
    ?subject a spg:MutationSpec ; spg:operator ?value .
    FILTER(?value != "replace_once" && ?value != "delete_once" &&
           ?value != "append_text" && ?value != "write_text")
    BIND("mutation.operator" AS ?field)
  } UNION {
    ?subject a spg:VerifierSpec ; spg:detectionMode ?value .
    FILTER(?value != "exit_changed" && ?value != "stdout_changed" &&
           ?value != "either")
    BIND("verifier.detectionMode" AS ?field)
  }
}
ORDER BY ?field ?subject ?value
