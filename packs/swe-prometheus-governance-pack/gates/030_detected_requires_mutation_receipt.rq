# Violation rows: "detected" is a claim about a mutation court, not a label.
PREFIX spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#>
SELECT ?case ?kind WHERE {
  {
    ?case a spg:RetrofitCase ; spg:gateStrength "detected" .
    OPTIONAL { ?case spg:mutationReceipt ?r1 . BIND(?r1 AS ?w1) }
    FILTER(!BOUND(?w1))
    BIND("missing-mutation-receipt" AS ?kind)
  }
  UNION
  {
    ?case a spg:RetrofitCase ;
          spg:gateStrength "detected" ;
          spg:mutationReceipt ?r2 .
    OPTIONAL { ?r2 spg:receiptId ?id . BIND(?id AS ?w2) }
    FILTER(!BOUND(?w2))
    BIND("missing-mutation-receipt-id" AS ?kind)
  }
  UNION
  {
    ?case a spg:RetrofitCase ;
          spg:gateStrength "detected" ;
          spg:mutationReceipt ?r3 .
    OPTIONAL { ?r3 spg:verdict ?v . BIND(?v AS ?w3) }
    FILTER(!BOUND(?w3) || ?w3 != "PASS")
    BIND("mutation-receipt-not-pass" AS ?kind)
  }
}
ORDER BY ?case ?kind
