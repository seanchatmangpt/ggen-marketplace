# Violation rows for the generated autofde-lab probe/mutation manifests.
PREFIX spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#>
SELECT ?subject ?field WHERE {
  {
    ?subject a spg:ProbeSpec .
    OPTIONAL { ?subject spg:probeId ?v1 . BIND(?v1 AS ?w1) }
    FILTER(!BOUND(?w1))
    BIND("probe.missing-id" AS ?field)
  } UNION {
    ?subject a spg:ProbeSpec .
    OPTIONAL { ?subject spg:role ?v2 . BIND(?v2 AS ?w2) }
    FILTER(!BOUND(?w2))
    BIND("probe.missing-role" AS ?field)
  } UNION {
    ?subject a spg:ProbeSpec .
    OPTIONAL { ?subject spg:scope ?v3 . BIND(?v3 AS ?w3) }
    FILTER(!BOUND(?w3))
    BIND("probe.missing-scope" AS ?field)
  } UNION {
    ?subject a spg:ProbeSpec .
    OPTIONAL { ?subject spg:argvJson ?v4 . BIND(?v4 AS ?w4) }
    FILTER(!BOUND(?w4))
    BIND("probe.missing-argv" AS ?field)
  } UNION {
    ?subject a spg:ProbeSpec ; spg:role "governance" .
    OPTIONAL { ?subject spg:governanceDimension ?v5 . BIND(?v5 AS ?w5) }
    FILTER(!BOUND(?w5))
    BIND("governance-probe.missing-dimension" AS ?field)
  } UNION {
    ?subject a spg:ProbeSpec ; spg:probeId ?id .
    ?other a spg:ProbeSpec ; spg:probeId ?id .
    FILTER(STR(?subject) < STR(?other))
    BIND("probe.duplicate-id" AS ?field)
  } UNION {
    ?subject a spg:MutationSpec .
    OPTIONAL { ?subject spg:mutationId ?v6 . BIND(?v6 AS ?w6) }
    FILTER(!BOUND(?w6))
    BIND("mutation.missing-id" AS ?field)
  } UNION {
    ?subject a spg:MutationSpec .
    OPTIONAL { ?subject spg:path ?v7 . BIND(?v7 AS ?w7) }
    FILTER(!BOUND(?w7))
    BIND("mutation.missing-path" AS ?field)
  } UNION {
    ?subject a spg:MutationSpec .
    OPTIONAL { ?subject spg:beforeSha256 ?v8 . BIND(?v8 AS ?w8) }
    FILTER(!BOUND(?w8))
    BIND("mutation.missing-preimage" AS ?field)
  } UNION {
    ?subject a spg:MutationSpec .
    OPTIONAL { ?subject spg:operator ?v9 . BIND(?v9 AS ?w9) }
    FILTER(!BOUND(?w9))
    BIND("mutation.missing-operator" AS ?field)
  } UNION {
    ?subject a spg:MutationSpec ; spg:mutationId ?id .
    ?other a spg:MutationSpec ; spg:mutationId ?id .
    FILTER(STR(?subject) < STR(?other))
    BIND("mutation.duplicate-id" AS ?field)
  } UNION {
    ?case a spg:RetrofitCase ; spg:mutationSpec ?subject .
    OPTIONAL { ?case spg:verifierSpec ?v10 . BIND(?v10 AS ?w10) }
    FILTER(!BOUND(?w10))
    BIND("case.mutation-without-verifier" AS ?field)
  } UNION {
    ?subject a spg:VerifierSpec .
    OPTIONAL { ?subject spg:argvJson ?v11 . BIND(?v11 AS ?w11) }
    FILTER(!BOUND(?w11))
    BIND("verifier.missing-argv" AS ?field)
  }
}
ORDER BY ?field ?subject
