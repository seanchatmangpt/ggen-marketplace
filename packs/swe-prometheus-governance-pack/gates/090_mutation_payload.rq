# Violation rows: mutation plans must be reversible and exact before generation.
PREFIX spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#>
SELECT ?mutation ?field WHERE {
  {
    ?mutation a spg:MutationSpec ; spg:beforeSha256 ?digest .
    FILTER(!STRSTARTS(STR(?digest), "sha256:"))
    BIND("preimage-not-sha256" AS ?field)
  } UNION {
    ?mutation a spg:MutationSpec ; spg:path ?path .
    FILTER(STRSTARTS(STR(?path), "/") ||
           CONTAINS(STR(?path), "../") ||
           STR(?path) = "..")
    BIND("escaping-path" AS ?field)
  } UNION {
    ?mutation a spg:MutationSpec ; spg:operator "replace_once" .
    OPTIONAL { ?mutation spg:oldText ?old1 . BIND(?old1 AS ?w1) }
    FILTER(!BOUND(?w1))
    BIND("replace-once-missing-old" AS ?field)
  } UNION {
    ?mutation a spg:MutationSpec ; spg:operator "replace_once" .
    OPTIONAL { ?mutation spg:newText ?new1 . BIND(?new1 AS ?w2) }
    FILTER(!BOUND(?w2))
    BIND("replace-once-missing-new" AS ?field)
  } UNION {
    ?mutation a spg:MutationSpec ; spg:operator "delete_once" .
    OPTIONAL { ?mutation spg:oldText ?old2 . BIND(?old2 AS ?w3) }
    FILTER(!BOUND(?w3))
    BIND("delete-once-missing-old" AS ?field)
  } UNION {
    ?mutation a spg:MutationSpec ; spg:operator "append_text" .
    OPTIONAL { ?mutation spg:text ?text1 . BIND(?text1 AS ?w4) }
    FILTER(!BOUND(?w4))
    BIND("append-missing-text" AS ?field)
  } UNION {
    ?mutation a spg:MutationSpec ; spg:operator "write_text" .
    OPTIONAL { ?mutation spg:text ?text2 . BIND(?text2 AS ?w5) }
    FILTER(!BOUND(?w5))
    BIND("write-missing-text" AS ?field)
  }
}
ORDER BY ?field ?mutation
