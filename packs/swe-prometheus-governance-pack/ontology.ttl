@prefix spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#> .
@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:ggen:pack:swe-prometheus-governance-pack>
    a gp:Pack ;
    gp:name "swe-prometheus-governance-pack" ;
    gp:version "0.1.0" ;
    gp:profile gp:Core1 .

# FAILED EDGE / PRIOR ART
# PROV-O is reused for evidence entities and derivation identity; EARL is reused
# for test-result-shaped receipts; dcterms:identifier is reused for receipt IDs.
# Their boundary: none expresses the SWE-Prometheus fixed-base retrofit subject,
# six-dimension universe, paired base/treated 1..5 scores, evidence-status
# vocabulary, or mutation-derived behavior-gate strength. Those are the only
# semantics minted below.

spg:RetrofitCase a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "repository retrofit case" .

spg:DimensionObservation a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "paired governance dimension observation" .

spg:EvidenceReceipt a rdfs:Class ;
    rdfs:subClassOf earl:TestResult ;
    rdfs:label "typed evidence receipt" .

spg:GovernanceDimension a rdfs:Class ;
    rdfs:label "SWE-Prometheus governance dimension" .

spg:repository a rdf:Property ;
    rdfs:domain spg:RetrofitCase ;
    rdfs:range xsd:string .
spg:baseCommit a rdf:Property ;
    rdfs:domain spg:RetrofitCase ;
    rdfs:range xsd:string .
spg:patchDigest a rdf:Property ;
    rdfs:domain spg:RetrofitCase ;
    rdfs:range xsd:string .
spg:behavior a rdf:Property ;
    rdfs:domain spg:RetrofitCase ;
    rdfs:range xsd:string .
spg:gateStrength a rdf:Property ;
    rdfs:domain spg:RetrofitCase ;
    rdfs:range xsd:string .
spg:dimensionObservation a rdf:Property ;
    rdfs:domain spg:RetrofitCase ;
    rdfs:range spg:DimensionObservation .
spg:mutationReceipt a rdf:Property ;
    rdfs:domain spg:RetrofitCase ;
    rdfs:range spg:EvidenceReceipt .
spg:cleanEnvironmentReceipt a rdf:Property ;
    rdfs:domain spg:RetrofitCase ;
    rdfs:range spg:EvidenceReceipt .
spg:replayReceipt a rdf:Property ;
    rdfs:domain spg:RetrofitCase ;
    rdfs:range spg:EvidenceReceipt .

spg:dimension a rdf:Property ;
    rdfs:domain spg:DimensionObservation ;
    rdfs:range spg:GovernanceDimension .
spg:key a rdf:Property ;
    rdfs:domain spg:GovernanceDimension ;
    rdfs:range xsd:string .
spg:baseScore a rdf:Property ;
    rdfs:domain spg:DimensionObservation ;
    rdfs:range xsd:decimal .
spg:treatedScore a rdf:Property ;
    rdfs:domain spg:DimensionObservation ;
    rdfs:range xsd:decimal .
spg:evidenceStatus a rdf:Property ;
    rdfs:domain spg:DimensionObservation ;
    rdfs:range xsd:string .
spg:verdict a rdf:Property ;
    rdfs:domain spg:EvidenceReceipt ;
    rdfs:range xsd:string .
spg:receiptId a rdf:Property ;
    rdfs:domain spg:EvidenceReceipt ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier .

spg:D1 a spg:GovernanceDimension ;
    spg:key "tests_ci" ;
    rdfs:label "Tests & CI" .
spg:D2 a spg:GovernanceDimension ;
    spg:key "quality_gates" ;
    rdfs:label "Code Quality Gates" .
spg:D3 a spg:GovernanceDimension ;
    spg:key "docs_collaboration" ;
    rdfs:label "Documentation & Collaboration" .
spg:D4 a spg:GovernanceDimension ;
    spg:key "structure_maintainability" ;
    rdfs:label "Structure & Maintainability" .
spg:D5 a spg:GovernanceDimension ;
    spg:key "reproducible_environment" ;
    rdfs:label "Reproducible Environment" .
spg:D6 a spg:GovernanceDimension ;
    spg:key "dependency_security" ;
    rdfs:label "Dependency & Security Health" .
