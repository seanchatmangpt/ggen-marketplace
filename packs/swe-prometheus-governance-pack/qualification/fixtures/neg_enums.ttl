@prefix spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#> .

<urn:enum:case> a spg:RetrofitCase ;
  spg:behavior "maybe" ;
  spg:gateStrength "strong-ish" .

<urn:enum:obs> a spg:DimensionObservation ;
  spg:evidenceStatus "green" .

<urn:enum:receipt> a spg:EvidenceReceipt ;
  spg:verdict "OK" .

<urn:enum:probe> a spg:ProbeSpec ;
  spg:role "agent" ;
  spg:scope "universe" ;
  spg:comparison "vibes" .

<urn:enum:mutation> a spg:MutationSpec ;
  spg:operator "arbitrary_python" .

<urn:enum:verifier> a spg:VerifierSpec ;
  spg:detectionMode "trust-me" .
