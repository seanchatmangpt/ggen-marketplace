@prefix spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#> .

# One deliberately malformed case witnesses every structural gate.
<urn:case:bad> a spg:RetrofitCase ;
  spg:repository "seanchatmangpt/example" ;
  spg:baseCommit "base-a", "base-b" ;
  spg:behavior "preserved" ;
  spg:gateStrength "detected" ;
  spg:dimensionObservation <urn:bad:d1a>, <urn:bad:d1b> .

<urn:bad:d1a> a spg:DimensionObservation ;
  spg:dimension spg:D1 ;
  spg:evidenceStatus "pass" ;
  spg:baseScore 0 .

<urn:bad:d1b> a spg:DimensionObservation ;
  spg:dimension spg:D1 ;
  spg:evidenceStatus "bogus" ;
  spg:baseScore 2 ;
  spg:treatedScore 3 .
