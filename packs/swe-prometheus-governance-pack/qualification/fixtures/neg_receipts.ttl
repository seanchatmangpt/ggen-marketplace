@prefix spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#> .

<urn:receipt:missing-both> a spg:RetrofitCase .

<urn:receipt:malformed> a spg:RetrofitCase ;
  spg:cleanEnvironmentReceipt <urn:receipt:clean-no-id> ;
  spg:replayReceipt <urn:receipt:replay-no-verdict> .

<urn:receipt:clean-no-id> a spg:EvidenceReceipt ;
  spg:verdict "PASS" .

<urn:receipt:replay-no-verdict> a spg:EvidenceReceipt ;
  spg:receiptId "sha256:replay" .

<urn:receipt:duplicate> a spg:RetrofitCase ;
  spg:cleanEnvironmentReceipt <urn:receipt:c1>, <urn:receipt:c2> ;
  spg:replayReceipt <urn:receipt:r1>, <urn:receipt:r2> .

<urn:receipt:c1> a spg:EvidenceReceipt ; spg:receiptId "c1" ; spg:verdict "PASS" .
<urn:receipt:c2> a spg:EvidenceReceipt ; spg:receiptId "c2" ; spg:verdict "PASS" .
<urn:receipt:r1> a spg:EvidenceReceipt ; spg:receiptId "r1" ; spg:verdict "PASS" .
<urn:receipt:r2> a spg:EvidenceReceipt ; spg:receiptId "r2" ; spg:verdict "PASS" .
