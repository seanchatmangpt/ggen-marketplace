@prefix spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#> .

<urn:score:ambiguous> a spg:DimensionObservation ;
  spg:evidenceStatus "pass" ;
  spg:baseScore 1, 2 ;
  spg:treatedScore 3, 4 .

<urn:score:stale> a spg:DimensionObservation ;
  spg:evidenceStatus "fail" ;
  spg:baseScore 2 ;
  spg:treatedScore 5 .
