@prefix spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#> .

<urn:plan:case> a spg:RetrofitCase ;
  spg:mutationSpec <urn:plan:mutation-no-fields> .

<urn:plan:probe-no-fields> a spg:ProbeSpec .

<urn:plan:probe-governance-no-dimension> a spg:ProbeSpec ;
  spg:probeId "dup" ;
  spg:role "governance" ;
  spg:scope "both" ;
  spg:argvJson "[\"pytest\"]" .

<urn:plan:probe-duplicate> a spg:ProbeSpec ;
  spg:probeId "dup" ;
  spg:role "behavior" ;
  spg:scope "both" ;
  spg:argvJson "[\"pytest\"]" .

<urn:plan:mutation-no-fields> a spg:MutationSpec .

<urn:plan:mutation-duplicate-a> a spg:MutationSpec ;
  spg:mutationId "same" ;
  spg:path "a.py" ;
  spg:beforeSha256 "sha256:a" ;
  spg:operator "write_text" ;
  spg:text "a" .

<urn:plan:mutation-duplicate-b> a spg:MutationSpec ;
  spg:mutationId "same" ;
  spg:path "b.py" ;
  spg:beforeSha256 "sha256:b" ;
  spg:operator "write_text" ;
  spg:text "b" .

<urn:plan:verifier-no-argv> a spg:VerifierSpec .
