@prefix spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#> .

<urn:cmd:probe> a spg:ProbeSpec ;
  spg:argvJson "pytest -q" ;
  spg:cwd "../outside" ;
  spg:timeoutSeconds 0 .

<urn:cmd:verifier> a spg:VerifierSpec ;
  spg:argvJson "{\"cmd\":\"pytest\"}" ;
  spg:cwd "/tmp" ;
  spg:timeoutSeconds 3601 .
