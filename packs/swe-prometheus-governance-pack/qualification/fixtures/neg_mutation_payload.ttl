@prefix spg: <https://seanchatmangpt.github.io/packs/swe-prometheus-governance#> .

<urn:payload:replace> a spg:MutationSpec ;
  spg:mutationId "replace" ;
  spg:path "../escape.py" ;
  spg:beforeSha256 "md5:not-sha" ;
  spg:operator "replace_once" .

<urn:payload:delete> a spg:MutationSpec ;
  spg:mutationId "delete" ;
  spg:path "a.py" ;
  spg:beforeSha256 "sha256:a" ;
  spg:operator "delete_once" .

<urn:payload:append> a spg:MutationSpec ;
  spg:mutationId "append" ;
  spg:path "b.py" ;
  spg:beforeSha256 "sha256:b" ;
  spg:operator "append_text" .

<urn:payload:write> a spg:MutationSpec ;
  spg:mutationId "write" ;
  spg:path "c.py" ;
  spg:beforeSha256 "sha256:c" ;
  spg:operator "write_text" .
