# MESSAGE: an episode is admitted only when it uses both existing source
# identities. Their owning packs remain authoritative for their semantics.
PREFIX sll: <https://ggen.dev/ontology/semantic-life-loop#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?episode WHERE {
  ?episode a sll:Episode .
  FILTER (
    NOT EXISTS { ?episode prov:used <urn:lifegym:world-profile> } ||
    NOT EXISTS { ?episode prov:used <urn:biblegym:capability:devotion_prompt_packet> }
  )
}
ORDER BY ?episode
