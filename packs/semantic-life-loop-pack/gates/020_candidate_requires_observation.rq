# MESSAGE: every candidate must be derived from an actual SOSA observation.
PREFIX sll: <https://ggen.dev/ontology/semantic-life-loop#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
SELECT ?candidate WHERE {
  ?candidate a sll:WorkCandidate .
  FILTER NOT EXISTS {
    ?candidate prov:wasDerivedFrom ?observation .
    ?observation a sosa:Observation .
  }
}
ORDER BY ?candidate
