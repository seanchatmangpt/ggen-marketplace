# MESSAGE: refuse a candidate whose requested work kind does not match its
# admitted delta class. This gate selects only violations.
PREFIX sll: <https://ggen.dev/ontology/semantic-life-loop#>
SELECT ?candidate ?deltaClass ?workKind WHERE {
  ?candidate a sll:WorkCandidate ;
             sll:deltaClass ?deltaClass ;
             sll:workKind ?workKind .
  FILTER (
    !(
      (?deltaClass = "MISSING_TRANSITION" && ?workKind = "CLOSE_READINESS_GAP") ||
      (?deltaClass = "INCOMPLETE_BINDING" && ?workKind = "RESOLVE_BINDING") ||
      (?deltaClass = "ONTOLOGY_UPDATE_CANDIDATE" && ?workKind = "REVIEW_ONTOLOGY_CHANGE") ||
      (?deltaClass = "NOVEL_OBSERVATION" && ?workKind = "INVESTIGATE_NOVEL_OBSERVATION") ||
      (?deltaClass = "PROCESS_WASTE_CANDIDATE" && ?workKind = "REVIEW_PROCESS_WASTE")
    )
  )
}
ORDER BY ?candidate
