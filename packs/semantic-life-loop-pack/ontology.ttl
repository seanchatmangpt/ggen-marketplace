@prefix sll: <https://ggen.dev/ontology/semantic-life-loop#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Reusable bridge profile only. LifeGym owns life-world semantics; BibleGym
# owns formation/church semantics; Semantic Jira owns WorkOrder admission.
# This pack only manufactures a powerless observation-delta consequence.

sll:Episode a rdfs:Class ;
  rdfs:subClassOf prov:Activity ;
  rdfs:label "Bounded semantic life-loop episode" .

sll:WorkCandidate a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Authority-free candidate work derived from observation" .

sll:hasCandidate a rdf:Property ;
  rdfs:domain sll:Episode ;
  rdfs:range sll:WorkCandidate .

sll:sourceDigest a rdf:Property ;
  rdfs:domain sll:Episode ;
  rdfs:range xsd:string .

sll:projectionPriority a rdf:Property ;
  rdfs:domain sll:Episode ;
  rdfs:range xsd:integer ;
  rdfs:comment "Consumer episodes outrank the pack's priority-0 worked example without mutating pack source." .

sll:deltaClass a rdf:Property ;
  rdfs:domain sll:WorkCandidate ;
  rdfs:range xsd:string .

sll:workKind a rdf:Property ;
  rdfs:domain sll:WorkCandidate ;
  rdfs:range xsd:string .

# The source anchors are the exact public identities already used by the
# existing marketplace packs. These duplicate no runtime ownership. Both
# anchors stay prov:Entity: this pack only observes them, and typing a bare
# capability URN as sosa:Procedure would fail biblegym-pack's
# gates/010_required_contract.rq (every sosa:Procedure must carry the full
# bg:capability* contract) the moment the two packs share a union graph
# -- the authoritative sosa:Procedure for this capability is
# biblegym-pack's own bg:capability-05.
<urn:lifegym:world-profile> a prov:Entity .
<urn:biblegym:capability:devotion_prompt_packet> a prov:Entity .

sll:ExampleObservation a sosa:Observation ;
  dcterms:identifier "observation:example-profile-scripture-bridge" ;
  sosa:hasSimpleResult "A bounded life/formation relation exists but has not yet been admitted as reusable work." .

sll:ExampleSubject a prov:Entity ;
  dcterms:identifier "subject:example-life-formation" .

sll:ExampleCandidate a sll:WorkCandidate ;
  dcterms:identifier "SLL-001" ;
  dcterms:subject sll:ExampleSubject ;
  sll:deltaClass "NOVEL_OBSERVATION" ;
  sll:workKind "INVESTIGATE_NOVEL_OBSERVATION" ;
  prov:wasDerivedFrom sll:ExampleObservation .

sll:ExampleEpisode a sll:Episode ;
  dcterms:identifier "semantic-life-loop-example-001" ;
  sll:sourceDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
  sll:projectionPriority 0 ;
  prov:used <urn:lifegym:world-profile>, <urn:biblegym:capability:devotion_prompt_packet> ;
  sll:hasCandidate sll:ExampleCandidate .
