---
to: "lib/{{ app_module | lower }}_web/mcp_scope.ex"
for_each: "spec"
sparql:
  spec: |
    PREFIX ema: <http://seanchatmangpt.github.io/packs/elixir-mcp-a2a#>

    SELECT DISTINCT ?app_module ?otp_app ?mcp_mount_path ?mcp_protocol_version
                    ?mcp_audit_plug_module ?agent_module ?agent_name
                    ?agent_description ?agent_mount_path ?skills_module WHERE {
      ?s a ema:CapabilitySurface ;
         ema:appModule ?app_module ; ema:otpApp ?otp_app ;
         ema:mcpMountPath ?mcp_mount_path ; ema:mcpProtocolVersion ?mcp_protocol_version ;
         ema:agentModule ?agent_module ; ema:agentName ?agent_name ;
         ema:agentDescription ?agent_description ; ema:agentMountPath ?agent_mount_path .
      OPTIONAL { ?s ema:mcpAuditPlugModule ?mcp_audit_plug_module }
      OPTIONAL { ?s ema:skillsModule ?skills_module }
    }
  caps: |
    PREFIX ema: <http://seanchatmangpt.github.io/packs/elixir-mcp-a2a#>

    SELECT ?capability_id ?capability_name ?capability_description ?capability_ash_action
           ?observation_scope ?mutation_scope ?requires_authority ?is_reversible
           ?cost_estimate ?receipt_semantics ?capability_order WHERE {
      ?c a ema:Capability ; ema:capabilityOf ?surface ; ema:exposedVia ?via .
      FILTER (?via = "mcp" || ?via = "both")
      ?c ema:capabilityId ?capability_id ; ema:capabilityName ?capability_name ;
         ema:capabilityDescription ?capability_description ;
         ema:observationScope ?observation_scope ; ema:mutationScope ?mutation_scope ;
         ema:requiresAuthority ?requires_authority ; ema:isReversible ?is_reversible ;
         ema:receiptSemantics ?receipt_semantics ; ema:capabilityOrder ?capability_order .
      OPTIONAL { ?c ema:capabilityAshAction ?capability_ash_action }
      OPTIONAL { ?c ema:costEstimate ?cost_estimate }
    }
    ORDER BY ?capability_order
---
{# Real Phoenix router scope macro, mirroring xaas's own working /mcp scope
   (lib/xaas_web/router.ex:105-120) as a reusable `mcp_scope/0` macro any
   consuming router can `import {{ app_module }}Web.McpScope` and call
   inside its own `scope "{{ mcp_mount_path }}" do ... end`, rather than
   generating a full router file (routers commonly have hand-authored
   pipelines this pack should not overwrite). #}
defmodule {{ app_module }}Web.McpScope do
  @moduledoc """
  Generated MCP router scope for `{{ app_module }}`, from one admitted
  ema:CapabilitySurface. Mount in your router:

      import {{ app_module }}Web.McpScope
{% if mcp_audit_plug_module %}
      # `plug` is only valid inside a named `pipeline do ... end` block in
      # Phoenix's router DSL, never directly inside `scope` -- this macro
      # cannot inject a pipeline declaration from a scope call site (a
      # real defect an earlier draft of this template had: it called
      # `pipe_through` a second time with a bare module name where a
      # pipeline ATOM was expected). Define this yourself, the same way
      # xaas's own real router.ex defines
      # `pipeline :audit_mcp_tool_call do plug {{ mcp_audit_plug_module }} end`:
      #
      #   pipeline :audit_mcp_tool_call do
      #     plug {{ mcp_audit_plug_module }}
      #   end
{% endif %}
      scope "{{ mcp_mount_path }}" do
        pipe_through([:api{% if mcp_audit_plug_module %}, :audit_mcp_tool_call{% endif %}])
        {{ app_module }}Web.McpScope.mount(__MODULE__)
      end

  Real tools exposed: {% for c in caps %}`:{{ c.capability_id }}`{% if not loop.last %}, {% endif %}{% endfor %}.
{% if not mcp_audit_plug_module %}
  NO AUDIT PLUG configured on this surface (ema:mcpAuditPlugModule was
  absent from the spec) -- every MCP call through this scope is
  unaudited. This is a disclosed gap, not a silent default: add an
  ema:mcpAuditPlugModule row to the spec (mirroring
  XaasWeb.Plugs.AuditMcpToolCall's real convention) before treating this
  surface as production-ready.
{% endif %}
  """

  defmacro mount(_router_module) do
    quote do
      forward("/", AshAi.Mcp.Router,
        tools: [{% for c in caps %}{% if c.capability_id is containing("-") %}:"{{ c.capability_id }}"{% else %}:{{ c.capability_id }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}],
        protocol_version_statement: "{{ mcp_protocol_version }}",
        otp_app: {{ otp_app }}
      )
    end
  end
end
