---
to: "lib/{{ app_module | lower }}_web/a2a/{{ agent_module | lower }}.ex"
for_each: "spec"
sparql:
  spec: |
    PREFIX ema: <http://seanchatmangpt.github.io/packs/elixir-mcp-a2a#>

    SELECT DISTINCT ?app_module ?otp_app ?mcp_mount_path ?mcp_protocol_version
                    ?mcp_audit_plug_module ?agent_module ?agent_name
                    ?agent_description ?agent_mount_path ?skills_module WHERE {
      ?s a ema:CapabilitySurface ;
         ema:appModule ?app_module ; ema:otpApp ?otp_app ;
         ema:mcpMountPath ?mcp_mount_path ; ema:mcpProtocolVersion ?mcp_protocol_version ;
         ema:agentModule ?agent_module ; ema:agentName ?agent_name ;
         ema:agentDescription ?agent_description ; ema:agentMountPath ?agent_mount_path .
      OPTIONAL { ?s ema:mcpAuditPlugModule ?mcp_audit_plug_module }
      OPTIONAL { ?s ema:skillsModule ?skills_module }
    }
  caps: |
    PREFIX ema: <http://seanchatmangpt.github.io/packs/elixir-mcp-a2a#>

    SELECT ?capability_id ?capability_name ?capability_description ?capability_ash_action
           ?observation_scope ?mutation_scope ?requires_authority ?is_reversible
           ?cost_estimate ?receipt_semantics ?capability_order
           (GROUP_CONCAT(?tag; separator=",") AS ?tags) WHERE {
      ?c a ema:Capability ; ema:capabilityOf ?surface ; ema:exposedVia ?via .
      FILTER (?via = "a2a" || ?via = "both")
      ?c ema:capabilityId ?capability_id ; ema:capabilityName ?capability_name ;
         ema:capabilityDescription ?capability_description ;
         ema:observationScope ?observation_scope ; ema:mutationScope ?mutation_scope ;
         ema:requiresAuthority ?requires_authority ; ema:isReversible ?is_reversible ;
         ema:receiptSemantics ?receipt_semantics ; ema:capabilityOrder ?capability_order .
      OPTIONAL { ?c ema:capabilityAshAction ?capability_ash_action }
      OPTIONAL { ?c ema:costEstimate ?cost_estimate }
      OPTIONAL { ?c ema:capabilityTag ?tag }
    }
    GROUP BY ?capability_id ?capability_name ?capability_description ?capability_ash_action
             ?observation_scope ?mutation_scope ?requires_authority ?is_reversible
             ?cost_estimate ?receipt_semantics ?capability_order
    ORDER BY ?capability_order
---
{# Real A2A.Agent module, mirroring xaas's own working
   XaasWeb.A2A.NextReadUserAgent (lib/xaas_web/a2a/next_read_user_agent.ex)
   -- one skill per ema:Capability row with ema:exposedVia "a2a"|"both" on
   this surface. CORRECTED: an earlier version of this comment claimed the
   A2A skill list and the MCP tool list are generated from the SAME rows --
   checked against real xaas code and found false: router.ex's real /mcp
   tools and next_read_user_agent.ex's real A2A skills are disjoint id sets
   (e.g. "checkout" is a real consequential mutation, A2A-only, never an MCP
   tool). This template renders only the a2a/both-scoped rows
   (queries/a2a_capabilities.rq); mcp_router_scope.ex.tmpl renders only the
   mcp/both-scoped rows (queries/mcp_capabilities.rq) -- a shared row (both)
   is the only case where the two surfaces intentionally overlap. #}
defmodule {{ app_module }}Web.A2A.{{ agent_module }} do
  @moduledoc """
  Generated A2A agent for `{{ app_module }}`: {{ agent_description }}

  Mount at `{{ agent_mount_path }}` in your router:

      forward "{{ agent_mount_path }}", {{ app_module }}Web.A2A.{{ agent_module }}
  """

  use A2A.Agent,
    name: "{{ agent_name }}",
    description: "{{ agent_description }}",
    skills: [
{% for c in caps %}      %{
        id: "{{ c.capability_id }}",
        name: "{{ c.capability_name }}",
        description: "{{ c.capability_description }}",
        tags: ["generated", "{{ app_module | lower }}"]
      }{% if not loop.last %},
{% endif %}
{% endfor %}    ]

  # Real dispatch is deliberately NOT generated here: each skill's actual
  # handler must call this app's own real Ash action/context function
  # (this pack does not invent a generic dispatch mechanism that could
  # silently no-op a skill invocation). See {{ app_module }}Web.McpDescriptor
  # for this same capability list's real ash_action bindings, where
  # present, as the source of truth for wiring a skill handler.
end
