@prefix ver: <http://seanchatmangpt.github.io/packs/ggen-verify#> .

# Synthetic green evidence for testing the pack's compile/gate semantics. It
# is explicitly not an execution receipt for any real cargo command.
ver:q-build a ver:Check ; ver:name "build" ; ver:exitCode 0 ; ver:summary "synthetic qualification fixture" .
ver:q-test a ver:Check ; ver:name "test-workspace" ; ver:exitCode 0 ; ver:summary "synthetic qualification fixture" .
ver:q-clippy a ver:Check ; ver:name "clippy-reference-gate" ; ver:exitCode 0 ; ver:summary "synthetic qualification fixture" .
ver:q-bytes a ver:Check ; ver:name "byte-identity" ; ver:exitCode 0 ; ver:summary "synthetic qualification fixture" .
