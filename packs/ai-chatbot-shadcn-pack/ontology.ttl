@prefix pack: <urn:ggen-marketplace:ai-chatbot-shadcn-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:Project a pack:AdmittedProject ;
    rdfs:label "ai-chatbot" ;
    pack:sourcePath "/Users/sac/ai-chatbot"^^xsd:string ;
    pack:framework "Next.js 16 (React 19, TypeScript, Tailwind CSS 4)" ;
    pack:packageManager "npm (inferred from package.json; no pnpm-lock.yaml/yarn.lock/bun.lockb scan performed)" ;
    rdfs:comment "Local Next.js App Router project scanned in place at the given absolute source path; no source code was copied into this pack." .

pack:ShadcnUsage a pack:TechnologyFinding ;
    rdfs:label "shadcn/ui" ;
    pack:status "real" ;
    pack:componentsJsonPresent true ;
    pack:componentsJsonStyle "new-york" ;
    pack:componentsJsonBaseColor "neutral" ;
    pack:cnCallSiteCount 46 ;
    pack:cvaFileCount 5 ;
    pack:radixImportFileCount 13 ;
    rdfs:comment "shadcn/ui is genuinely used, not just an unused/listed dependency: components.json exists with style=new-york and baseColor=neutral, 18 shadcn/ui primitive files are present on disk under components/ui/, the cn() class-merge helper (lib/utils) is called at 46 source-file sites, class-variance-authority (cva) is used in 5 files, and @radix-ui/* headless primitives are imported in 13 files." .

pack:DeckGlUsage a pack:TechnologyFinding ;
    rdfs:label "deck.gl" ;
    pack:status "absent" ;
    rdfs:comment "deck.gl is NOT used and NOT a dependency: package.json lists no deck.gl or @deck.gl/* package, and a source-wide grep for deck.gl, DeckGL, Layer, and named layer classes (ScatterplotLayer, GeoJsonLayer, HexagonLayer, ArcLayer) found zero matches. This finding is stated plainly rather than fabricated." .

