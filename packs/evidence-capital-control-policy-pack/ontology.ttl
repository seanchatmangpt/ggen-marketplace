@prefix ecp: <https://ggen.dev/ontology/evidence-capital-control-policy#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
ecp:PolicyCandidate a rdfs:Class .
ecp:realizedGain a rdf:Property .
ecp:falseCapitalRate a rdf:Property .
ecp:rootConcentration a rdf:Property .
ecp:support a rdf:Property .
ecp:sensitivityGamma a rdf:Property .
ecp:ownerStanding a rdf:Property .
ecp:generation a rdf:Property .
ecp:authority a rdf:Property .
ecp:retain a ecp:PolicyCandidate .
ecp:reject a ecp:PolicyCandidate .
ecp:acquire a ecp:PolicyCandidate .
ecp:defer a ecp:PolicyCandidate .
