PREFIX ecp: <https://ggen.dev/ontology/evidence-capital-control-policy#>
SELECT ?p ?gain ?false ?concentration ?gamma WHERE {
  ?p a ecp:PolicyCandidate ; ecp:realizedGain ?gain ; ecp:falseCapitalRate ?false ; ecp:rootConcentration ?concentration ; ecp:sensitivityGamma ?gamma .
}
ORDER BY DESC(?gain) ?false ?concentration DESC(?gamma) ?p
