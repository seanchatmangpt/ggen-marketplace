@prefix sp: <http://seanchatmangpt.github.io/packs/ggen-self#> .

# Positive qualification input standing in for the bounded facts normally
# written by `ggen pack new` before this project-profile pack is synchronized.
sp:QualificationPack
    a sp:Pack ;
    sp:name "qualification-pack" ;
    sp:description "Bounded self-pack manufacture qualification." ;
    sp:version "0.1.0" ;
    sp:category "qualification" ;
    sp:namespace "https://ggen.dev/marketplace/qualification/self-pack#" ;
    sp:hasTemplateRole "main" .
