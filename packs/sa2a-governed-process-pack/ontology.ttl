@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix cmd: <urn:cmd:> .
@prefix gov: <urn:sa2a:governed:process:> .

<urn:sa2a:governed:process>
    a owl:Ontology ;
    rdfs:label "SA2A Governed Process Ontology" ;
    rdfs:comment "Domain-agnostic primitives for governed agent-to-agent interactions (Composition C12)." .

# --- Universal Governed Entities ---
gov:DelegationLease a rdfs:Class ;
    rdfs:label "Delegation Lease" ;
    rdfs:comment "Signed, bounded authority delegation permitting an agent to request execution." .

gov:ExecutionCommitment a rdfs:Class ;
    rdfs:label "Execution Commitment" ;
    rdfs:comment "Resource reservation or cost envelope committed prior to execution." .

gov:OversightGate a rdfs:Class ;
    rdfs:label "Oversight Gate" ;
    rdfs:comment "Dual-agent verification requirement (human-in-the-loop or machine supervisor)." .

gov:ConsequenceBoundary a rdfs:Class ;
    rdfs:label "Consequence Boundary" ;
    rdfs:comment "BRCE gate preventing unreceipted actuation or external mutation." .

gov:ExecutionReceipt a rdfs:Class ;
    rdfs:label "Execution Receipt" ;
    rdfs:comment "Canonical evidence record with exact-SHA replay verification." .

# --- Properties ---
gov:leasedTo a rdf:Property ;
    rdfs:domain gov:DelegationLease ;
    rdfs:range rdfs:Resource .

gov:leaseExpiresAt a rdf:Property ;
    rdfs:domain gov:DelegationLease ;
    rdfs:range xsd:dateTime .

gov:consequenceLevel a rdf:Property ;
    rdfs:domain gov:ConsequenceBoundary ;
    rdfs:range xsd:string .

gov:evidenceDigest a rdf:Property ;
    rdfs:domain gov:ExecutionReceipt ;
    rdfs:range xsd:string .
