---
to: "src/beam4pm_engine_manifest.erl"
shape:
  - shapes/profile.shacl.ttl
sparql:
  engines: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX prov: <http://www.w3.org/ns/prov#>
    PREFIX bpw: <urn:beam4pm:wasm:>
    SELECT ?name ?prefix ?facade ?erl ?wasm_rel ?cheap ?heavy
    WHERE {
      ?e a prov:SoftwareAgent ;
         dct:title ?name ;
         bpw:abiPrefix ?prefix ;
         bpw:facadeModule ?facade ;
         bpw:erlangModule ?erl ;
         bpw:wasmRelPath ?wasm_rel ;
         bpw:cheapTimeoutMs ?cheap .
      OPTIONAL { ?e bpw:heavyTimeoutMs ?h }
      BIND(COALESCE(?h, ?cheap) AS ?heavy)
    }
    ORDER BY ?name
  ops: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX bpw: <urn:beam4pm:wasm:>
    SELECT ?engine ?op ?consequence ?timeout
           (GROUP_CONCAT(?fname; separator=",") AS ?fields)
    WHERE {
      ?o a sosa:Procedure ;
         dct:title ?op ;
         dct:type ?ctype ;
         bpw:engine ?eng ;
         bpw:timeoutClass ?tc .
      ?eng dct:title ?engine .
      ?tc skos:prefLabel ?timeout .
      OPTIONAL { ?o bpw:requestField ?f . ?f bpw:fieldName ?fname }
      BIND(IF(CONTAINS(STR(?ctype), "consequence:do"), "do", "read") AS ?consequence)
    }
    GROUP BY ?engine ?op ?consequence ?timeout
    ORDER BY ?engine ?op
---
%%% GENERATED by ggen (beam4pm-wasm-engine-pack) from the WASM engine ABI
%%% graph. Do not edit.
%%%
%%% Erlang-side reflection over the four BEAM-hosted WASM engines and their
%%% wire ops -- the engine-op counterpart of the record-type manifest.
%%% Reflection only: this module dispatches nothing and grants no authority.
%%% Consequence 'do' means mutation INSIDE the engine's wasm linear memory
%%% (handle mint, handle free, in-engine session/graph/OCEL edit), never
%%% host actuation.

-module(beam4pm_engine_manifest).

-export([engines/0, ops/0, ops_for/1, engine/1, op/2,
         read_ops/0, do_ops/0, timeout_ms/2, stats/0]).

-type engine() :: #{name := binary(), abi_prefix := binary(),
                    facade_module := binary(), erlang_module := binary(),
                    wasm_rel_path := binary(),
                    cheap_timeout_ms := pos_integer(),
                    heavy_timeout_ms := pos_integer()}.

-type op() :: #{engine := binary(), op := binary(),
                consequence := read | do, timeout_class := cheap | heavy,
                request_fields := [binary()]}.

-spec engines() -> [engine()].
engines() ->
    [
{% for row in engines %}     #{name => <<"{{ row.name }}">>,
       abi_prefix => <<"{{ row.prefix }}">>,
       facade_module => <<"{{ row.facade }}">>,
       erlang_module => <<"{{ row.erl }}">>,
       wasm_rel_path => <<"{{ row.wasm_rel }}">>,
       cheap_timeout_ms => {{ row.cheap }},
       heavy_timeout_ms => {{ row.heavy }}}{% if not loop.last %},{% endif %}
{% endfor %}    ].

-spec ops() -> [op()].
ops() ->
    [
{% for row in ops %}     #{engine => <<"{{ row.engine }}">>,
       op => <<"{{ row.op }}">>,
       consequence => {{ row.consequence }},
       timeout_class => {{ row.timeout }},
       request_fields => [{% for f in row.fields | default(value="") | split(pat=",") %}{% if f %}<<"{{ f }}">>{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]}{% if not loop.last %},{% endif %}
{% endfor %}    ].

-spec ops_for(binary()) -> [op()].
ops_for(Engine) when is_binary(Engine) ->
    [O || O = #{engine := E} <- ops(), E =:= Engine].

-spec engine(binary()) -> engine() | undefined.
engine(Name) when is_binary(Name) ->
    case [E || E = #{name := N} <- engines(), N =:= Name] of
        [E | _] -> E;
        [] -> undefined
    end.

-spec op(binary(), binary()) -> op() | undefined.
op(Engine, Name) when is_binary(Engine), is_binary(Name) ->
    case [O || O = #{engine := E, op := N} <- ops(), E =:= Engine, N =:= Name] of
        [O | _] -> O;
        [] -> undefined
    end.

-spec read_ops() -> [op()].
read_ops() -> [O || O = #{consequence := C} <- ops(), C =:= read].

-spec do_ops() -> [op()].
do_ops() -> [O || O = #{consequence := C} <- ops(), C =:= do].

-spec timeout_ms(binary(), binary()) -> pos_integer() | undefined.
timeout_ms(EngineName, OpName) ->
    case {engine(EngineName), op(EngineName, OpName)} of
        {undefined, _} -> undefined;
        {_, undefined} -> undefined;
        { #{cheap_timeout_ms := C, heavy_timeout_ms := H}, #{timeout_class := Class} } ->
            case Class of
                heavy -> H;
                cheap -> C
            end
    end.

-spec stats() -> #{engines := non_neg_integer(), ops := non_neg_integer(),
                   read := non_neg_integer(), do := non_neg_integer()}.
stats() ->
    #{engines => length(engines()),
      ops => length(ops()),
      read => length(read_ops()),
      do => length(do_ops())}.
