---
to: "lib/beam4pm_engine_manifest.ex"
shape:
  - shapes/profile.shacl.ttl
sparql:
  engines: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX prov: <http://www.w3.org/ns/prov#>
    PREFIX bpw: <urn:beam4pm:wasm:>
    SELECT ?name ?prefix ?crate_dir ?wasm_rel ?gen_server ?facade ?erl ?gleam ?submodule ?cheap ?heavy
    WHERE {
      ?e a prov:SoftwareAgent ;
         dct:title ?name ;
         bpw:abiPrefix ?prefix ;
         bpw:crateDir ?crate_dir ;
         bpw:wasmRelPath ?wasm_rel ;
         bpw:genServerName ?gen_server ;
         bpw:facadeModule ?facade ;
         bpw:erlangModule ?erl ;
         bpw:gleamModule ?gleam ;
         bpw:isSubmodule ?submodule ;
         bpw:cheapTimeoutMs ?cheap .
      OPTIONAL { ?e bpw:heavyTimeoutMs ?h }
      BIND(COALESCE(?h, ?cheap) AS ?heavy)
    }
    ORDER BY ?name
  ops: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX bpw: <urn:beam4pm:wasm:>
    SELECT ?engine ?op ?consequence ?timeout ?handle_returning ?frees_handle ?needs_base64
           (GROUP_CONCAT(?fname; separator=",") AS ?fields)
    WHERE {
      ?o a sosa:Procedure ;
         dct:title ?op ;
         dct:type ?ctype ;
         bpw:engine ?eng ;
         bpw:timeoutClass ?tc ;
         bpw:handleReturning ?handle_returning ;
         bpw:freesHandle ?frees_handle ;
         bpw:needsBase64 ?needs_base64 .
      ?eng dct:title ?engine .
      ?tc skos:prefLabel ?timeout .
      OPTIONAL { ?o bpw:requestField ?f . ?f bpw:fieldName ?fname }
      BIND(IF(CONTAINS(STR(?ctype), "consequence:do"), "do", "read") AS ?consequence)
    }
    GROUP BY ?engine ?op ?consequence ?timeout ?handle_returning ?frees_handle ?needs_base64
    ORDER BY ?engine ?op
---
defmodule BeamPM.EngineManifest do
  @moduledoc """
  GENERATED by ggen (beam4pm-wasm-engine-pack) from the WASM engine ABI
  graph. Do not edit.

  The engine-op analogue of `BeamPM.TypesManifest`: a runtime-reflectable
  catalog of every BEAM-hosted WASM engine and every JSON wire op it
  accepts. Reflection only -- calling an op still goes through that
  engine's own facade (`BeamPM.Rust4PM`, `BeamPM.Ferroplan`,
  `BeamPM.Petgraph`, `BeamPM.Tract`). This module dispatches nothing and
  grants no authority.

  `consequence` is `:read` (observational, handle-local or pure) or `:do`
  (mutates state INSIDE the engine's wasm linear memory -- mints a handle,
  frees a handle, or edits an in-engine session/graph/OCEL). Neither class
  is host authority.
  """

  @type engine :: %{
          name: String.t(),
          abi_prefix: String.t(),
          crate_dir: String.t(),
          wasm_rel_path: String.t(),
          gen_server: String.t(),
          facade_module: String.t(),
          erlang_module: String.t(),
          gleam_module: String.t(),
          submodule?: boolean(),
          cheap_timeout_ms: pos_integer(),
          heavy_timeout_ms: pos_integer()
        }

  @type op :: %{
          engine: String.t(),
          op: String.t(),
          consequence: :read | :do,
          timeout_class: :cheap | :heavy,
          handle_returning?: boolean(),
          frees_handle?: boolean(),
          needs_base64?: boolean(),
          request_fields: [String.t()]
        }

  @engines [
{% for row in engines %}    %{
      name: "{{ row.name }}",
      abi_prefix: "{{ row.prefix }}",
      crate_dir: "{{ row.crate_dir }}",
      wasm_rel_path: "{{ row.wasm_rel }}",
      gen_server: "{{ row.gen_server }}",
      facade_module: "{{ row.facade }}",
      erlang_module: "{{ row.erl }}",
      gleam_module: "{{ row.gleam }}",
      submodule?: {{ row.submodule }},
      cheap_timeout_ms: {{ row.cheap }},
      heavy_timeout_ms: {{ row.heavy }}
    },
{% endfor %}  ]

  @ops [
{% for row in ops %}    %{
      engine: "{{ row.engine }}",
      op: "{{ row.op }}",
      consequence: :{{ row.consequence }},
      timeout_class: :{{ row.timeout }},
      handle_returning?: {{ row.handle_returning }},
      frees_handle?: {{ row.frees_handle }},
      needs_base64?: {{ row.needs_base64 }},
      request_fields: String.split("{{ row.fields | default(value="") }}", ",", trim: true)
    },
{% endfor %}  ]

  @doc "Every declared WASM engine, ordered by name."
  @spec engines() :: [engine()]
  def engines, do: @engines

  @doc "Every declared wire op across all engines, ordered by engine then op."
  @spec ops() :: [op()]
  def ops, do: @ops

  @doc "Ops belonging to one engine, by engine name."
  @spec ops_for(String.t()) :: [op()]
  def ops_for(engine) when is_binary(engine),
    do: Enum.filter(@ops, &(&1.engine == engine))

  @doc "Look up one engine by name."
  @spec engine(String.t()) :: engine() | nil
  def engine(name) when is_binary(name),
    do: Enum.find(@engines, &(&1.name == name))

  @doc "Look up one op by engine name and wire op name."
  @spec op(String.t(), String.t()) :: op() | nil
  def op(engine, name) when is_binary(engine) and is_binary(name),
    do: Enum.find(@ops, &(&1.engine == engine and &1.op == name))

  @doc "Ops classified as observational (`:read`)."
  @spec read_ops() :: [op()]
  def read_ops, do: Enum.filter(@ops, &(&1.consequence == :read))

  @doc "Ops that mutate in-engine wasm state (`:do`). Still not host authority."
  @spec do_ops() :: [op()]
  def do_ops, do: Enum.filter(@ops, &(&1.consequence == :do))

  @doc "Ops that mint a handle the caller must eventually free."
  @spec handle_minting_ops() :: [op()]
  def handle_minting_ops, do: Enum.filter(@ops, & &1.handle_returning?)

  @doc "Ops that free a handle."
  @spec handle_freeing_ops() :: [op()]
  def handle_freeing_ops, do: Enum.filter(@ops, & &1.frees_handle?)

  @doc "The per-op default timeout in ms, resolved against its engine's class defaults."
  @spec timeout_ms(String.t(), String.t()) :: pos_integer() | nil
  def timeout_ms(engine_name, op_name) do
    with %{} = e <- engine(engine_name),
         %{} = o <- op(engine_name, op_name) do
      if o.timeout_class == :heavy, do: e.heavy_timeout_ms, else: e.cheap_timeout_ms
    else
      _ -> nil
    end
  end

  @doc "Counts, for drift checks against the ontology and the README."
  @spec stats() :: %{engines: non_neg_integer(), ops: non_neg_integer(), read: non_neg_integer(), do: non_neg_integer()}
  def stats do
    %{
      engines: length(@engines),
      ops: length(@ops),
      read: length(read_ops()),
      do: length(do_ops())
    }
  end
end
