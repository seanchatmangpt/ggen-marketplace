---
to: "schema/beam4pm_engine_ops.schema.json"
shape:
  - shapes/profile.shacl.ttl
sparql:
  ops: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    PREFIX bpw: <urn:beam4pm:wasm:>
    SELECT ?engine ?prefix ?op ?consequence ?timeout
           (GROUP_CONCAT(?fname; separator=",") AS ?fields)
    WHERE {
      ?o a sosa:Procedure ;
         dct:title ?op ;
         dct:type ?ctype ;
         bpw:engine ?eng ;
         bpw:timeoutClass ?tc .
      ?eng dct:title ?engine ; bpw:abiPrefix ?prefix .
      ?tc skos:prefLabel ?timeout .
      OPTIONAL { ?o bpw:requestField ?f . ?f bpw:fieldName ?fname }
      BIND(IF(CONTAINS(STR(?ctype), "consequence:do"), "do", "read") AS ?consequence)
    }
    GROUP BY ?engine ?prefix ?op ?consequence ?timeout
    ORDER BY ?engine ?op
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beam4pm.dev/schema/beam4pm_engine_ops.schema.json",
  "title": "beam4pm WASM engine op requests",
  "description": "GENERATED by ggen (beam4pm-wasm-engine-pack). Do not edit. Request wire shapes for every op accepted by the four BEAM-hosted WASM engines over the shared <prefix>_alloc/<prefix>_call/<prefix>_dealloc linear-memory JSON ABI. The engine-op analogue of beam4pm_types.schema.json. Descriptive only: validating against this schema grants no authority to call anything.",
  "oneOf": [
{% for row in ops %}    { "$ref": "#/$defs/{{ row.engine }}__{{ row.op }}" }{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "$defs": {
{% for row in ops %}    "{{ row.engine }}__{{ row.op }}": {
      "type": "object",
      "title": "{{ row.engine }}.{{ row.op }}",
      "description": "engine={{ row.engine }} abi_prefix={{ row.prefix }} consequence={{ row.consequence }} timeout_class={{ row.timeout }}",
      "properties": {
        "op": { "const": "{{ row.op }}" }{% for f in row.fields | default(value="") | split(pat=",") %}{% if f %},
        "{{ f }}": {}{% endif %}{% endfor %}
      },
      "required": ["op"{% for f in row.fields | default(value="") | split(pat=",") %}{% if f %}, "{{ f }}"{% endif %}{% endfor %}],
      "additionalProperties": false
    }{% if not loop.last %},{% endif %}
{% endfor %}  }
}
