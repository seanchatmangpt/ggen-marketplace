# beam4pm WASM engine ABI graph.
#
# GROUNDED IN REAL SOURCE. Every individual below is read out of the
# hand-written facades in seanchatmangpt/beam4pm:
#   lib/beam4pm_rust4pm.ex  src/beam4pm_rust4pm.erl  gleam/src/beam4pm/rust4pm.gleam
#   lib/beam4pm_ferroplan.ex src/beam4pm_ferroplan.erl gleam/src/beam4pm/ferroplan.gleam
#   lib/beam4pm_petgraph.ex src/beam4pm_petgraph.erl gleam/src/beam4pm/petgraph.gleam
#   lib/beam4pm_tract.ex    src/beam4pm_tract.erl    gleam/src/beam4pm/tract.gleam
# Op names and request field names are the literal JSON wire keys those
# facades send; timeout classes are the literal @heavy_timeout/@cheap_timeout
# selection at each call site. See PROVENANCE.md.
#
# AUTHORITY BOUNDARY. Every op here acts only on the engine's own wasm
# linear memory behind the alloc/call/dealloc JSON ABI. A dct:type of
# urn:gymact:consequence:do marks in-engine state mutation (handle mint,
# handle free, session/graph/OCEL mutation) -- NOT host authority. This
# pack manufactures catalogs and reflection; consequential host actuation
# stays external, behind GymAct/BRCE admission.

@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix bpw:  <urn:beam4pm:wasm:> .

# --- timeout classes (SKOS, so they are enumerable rather than free strings) ---

<urn:beam4pm:wasm:timeout:cheap> a skos:Concept ;
    skos:prefLabel "cheap" ;
    dct:description "Handle-local query or mutation; billed against the engine's @cheap_timeout." .

<urn:beam4pm:wasm:timeout:heavy> a skos:Concept ;
    skos:prefLabel "heavy" ;
    dct:description "Import, discovery, search or inference; billed against the engine's @heavy_timeout." .

# --- engines (4 real wasm32-wasip1 modules hosted by wasmex) ---

<urn:beam4pm:wasm:engine:rust4pm> a prov:SoftwareAgent ;
    dct:title "rust4pm" ;
    dct:description "Process mining: XES/PNML/OCEL import, DFG and Alpha+++ discovery, alignment and fitness conformance." ;
    bpw:abiPrefix "r4pm_" ;
    bpw:crateDir "native/rust4pm-wasm" ;
    bpw:wasmRelPath "native/rust4pm-wasm/target/wasm32-wasip1/release/rust4pm_wasm.wasm" ;
    bpw:genServerName "BeamPM.Rust4PM.Engine" ;
    bpw:facadeModule "BeamPM.Rust4PM" ;
    bpw:erlangModule "beam4pm_rust4pm" ;
    bpw:gleamModule "beam4pm/rust4pm.gleam" ;
    bpw:isSubmodule false ;
    bpw:cheapTimeoutMs "30000"^^xsd:integer ;
    bpw:heavyTimeoutMs "120000"^^xsd:integer .

<urn:beam4pm:wasm:engine:ferroplan> a prov:SoftwareAgent ;
    dct:title "ferroplan" ;
    dct:description "PDDL planning: one-shot plan/explain plus a stateful planning-session handle API." ;
    bpw:abiPrefix "fp_" ;
    bpw:crateDir "native/ferroplan" ;
    bpw:wasmRelPath "native/ferroplan/target/wasm32-wasip1/release/ferroplan_wasm.wasm" ;
    bpw:genServerName "BeamPM.Ferroplan.Engine" ;
    bpw:facadeModule "BeamPM.Ferroplan" ;
    bpw:erlangModule "beam4pm_ferroplan" ;
    bpw:gleamModule "beam4pm/ferroplan.gleam" ;
    bpw:isSubmodule true ;
    bpw:cheapTimeoutMs "30000"^^xsd:integer ;
    bpw:heavyTimeoutMs "120000"^^xsd:integer .

<urn:beam4pm:wasm:engine:petgraph> a prov:SoftwareAgent ;
    dct:title "petgraph" ;
    dct:description "Graph algorithms over an in-engine directed graph: SCC, toposort, cyclicity, shortest path." ;
    bpw:abiPrefix "pg_" ;
    bpw:crateDir "native/petgraph-wasm" ;
    bpw:wasmRelPath "native/petgraph-wasm/target/wasm32-wasip1/release/petgraph_wasm.wasm" ;
    bpw:genServerName "BeamPM.Petgraph.Engine" ;
    bpw:facadeModule "BeamPM.Petgraph" ;
    bpw:erlangModule "beam4pm_petgraph" ;
    bpw:gleamModule "beam4pm/petgraph.gleam" ;
    bpw:isSubmodule false ;
    bpw:cheapTimeoutMs "30000"^^xsd:integer .

<urn:beam4pm:wasm:engine:tract> a prov:SoftwareAgent ;
    dct:title "tract" ;
    dct:description "ONNX inference (sonos/tract): load and compile a model to a runnable plan, run f32 tensors." ;
    bpw:abiPrefix "tr_" ;
    bpw:crateDir "native/tract-wasm" ;
    bpw:wasmRelPath "native/tract-wasm/target/wasm32-wasip1/release/tract_wasm.wasm" ;
    bpw:genServerName "BeamPM.Tract.Engine" ;
    bpw:facadeModule "BeamPM.Tract" ;
    bpw:erlangModule "beam4pm_tract" ;
    bpw:gleamModule "beam4pm/tract.gleam" ;
    bpw:isSubmodule true ;
    bpw:cheapTimeoutMs "30000"^^xsd:integer ;
    bpw:heavyTimeoutMs "60000"^^xsd:integer .

# --- engine ops (72 individuals; one per public wire op) ---

<urn:beam4pm:wasm:op:rust4pm:import_xes> a sosa:Procedure ;
    dct:title "import_xes" ;
    dct:type <urn:gymact:consequence:do> ;
    bpw:engine <urn:beam4pm:wasm:engine:rust4pm> ;
    bpw:timeoutClass <urn:beam4pm:wasm:timeout:heavy> ;
    bpw:handleReturning true ;
    bpw:freesHandle false ;
    bpw:needsBase64 false ;
    bpw:requestField [ bpw:fieldName "content" ; bpw:fieldOrder "0"^^xsd:integer ] .

<urn:beam4pm:wasm:op:rust4pm:import_xes_gz> a sosa:Procedure ;
