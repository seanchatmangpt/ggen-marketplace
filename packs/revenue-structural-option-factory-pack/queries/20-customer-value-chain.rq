PREFIX rsof: <https://ggen.dev/ontology/revenue-structural-option-factory#>
SELECT ?candidate ?process ?valueOutcome ?revenueOutcome
WHERE {
  ?candidate a rsof:CandidateStructure ;
    rsof:customerProcess ?process ;
    rsof:valueOutcome ?valueOutcome ;
    rsof:customerRevenueOutcome ?revenueOutcome .
}
ORDER BY ?candidate ?process ?valueOutcome ?revenueOutcome
