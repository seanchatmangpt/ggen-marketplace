PREFIX rsof: <https://ggen.dev/ontology/revenue-structural-option-factory#>
SELECT ?candidate ?payer ?beneficiary ?product ?offer ?valueMetric ?distribution ?stream
WHERE {
  ?candidate a rsof:CandidateStructure ; rsof:reversible true .
  OPTIONAL { ?candidate rsof:payer ?payer }
  OPTIONAL { ?candidate rsof:beneficiary ?beneficiary }
  OPTIONAL { ?candidate rsof:product ?product }
  OPTIONAL { ?candidate rsof:offer ?offer }
  OPTIONAL { ?candidate rsof:valueMetric ?valueMetric }
  OPTIONAL { ?candidate rsof:distributionSurface ?distribution }
  OPTIONAL { ?candidate rsof:revenueStream ?stream }
}
ORDER BY ?candidate ?payer ?beneficiary ?product ?offer ?valueMetric ?distribution ?stream
