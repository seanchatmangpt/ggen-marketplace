PREFIX rsof: <https://ggen.dev/ontology/revenue-structural-option-factory#>
SELECT ?candidate ?payer ?beneficiary WHERE { ?candidate a rsof:CandidateStructure ; rsof:reversible true ; rsof:payer ?payer ; rsof:beneficiary ?beneficiary ; rsof:valueMetric ?metric . FILTER(?payer != ?beneficiary) }
ORDER BY ?candidate ?payer ?beneficiary
