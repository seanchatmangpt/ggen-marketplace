{
  "schema": "ggen.revenue-structural-option-frontier/1",
  "authority": "SELECT",
  "structural_cardinality_is_observed_revenue": false,
  "candidates": [
  {%- for candidate in candidates %}
    {"id": {{ candidate.id | json_encode }}, "reversible": {{ candidate.reversible | json_encode }}}{% if not loop.last %},{% endif %}
  {%- endfor %}
  ]
}
