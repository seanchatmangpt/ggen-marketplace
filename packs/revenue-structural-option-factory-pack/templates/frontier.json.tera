{
  "schema": "ggen.revenue-structural-option-frontier/1",
  "authority": "SELECT",
  "structural_cardinality_is_observed_revenue": false,
  "candidates": [
  {%- for row in results %}
    {"from": {{ row.from | json_encode }}, "for": {{ row.for | json_encode }}, "value": {{ row.value | json_encode }}, "reversible": {{ row.reversible | json_encode }}}{% if not loop.last %},{% endif %}
  {%- endfor %}
  ]
}
