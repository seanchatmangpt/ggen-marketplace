{
  "schema": "ggen.revenue-structural-option-frontier/1",
  "authority": "SELECT",
  "structural_cardinality_is_observed_revenue": false,
  "candidates": [
  {%- for row in results %}
    {"candidate": {{ row.candidate | json_encode }}, "payer": {{ row.payer | default(value="") | json_encode }}, "beneficiary": {{ row.beneficiary | default(value="") | json_encode }}, "product": {{ row.product | default(value="") | json_encode }}, "offer": {{ row.offer | default(value="") | json_encode }}, "value_metric": {{ row.valueMetric | default(value="") | json_encode }}, "distribution": {{ row.distribution | default(value="") | json_encode }}, "stream": {{ row.stream | default(value="") | json_encode }}}{% if not loop.last %},{% endif %}
  {%- endfor %}
  ]
}
