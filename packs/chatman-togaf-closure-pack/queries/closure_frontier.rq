PREFIX tc: <http://seanchatmangpt.github.io/packs/chatman-togaf-closure#>
SELECT ?project ?obligation ?asset ?kind ?state ?lane ?impact ?blocked WHERE {
  ?project a tc:EnterpriseProject ;
           tc:hasObligation ?obligation .
  ?obligation a tc:LifecycleObligation ;
              tc:obligationKind ?kind .
  OPTIONAL { ?obligation tc:subjectAsset ?asset }
  OPTIONAL { ?obligation tc:obligationState ?state }
  OPTIONAL { ?obligation tc:errcLane ?lane }
  OPTIONAL { ?obligation tc:impactScore ?impact }
  OPTIONAL { ?obligation tc:blockedDependents ?blocked }
  FILTER(!BOUND(?state) || ?state = tc:OBLIGATION_REQUIRED)
}
ORDER BY DESC(COALESCE(?impact, 0)) DESC(COALESCE(?blocked, 0)) ?project ?obligation
