@prefix tc: <http://seanchatmangpt.github.io/packs/chatman-togaf-closure#> .
@prefix er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#> .
@prefix ex: <https://example.invalid/chatman-togaf-closure-qualification#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:LifecycleClosureQualification
    a tc:EnterpriseProject ;
    tc:projectState tc:CLOSED ;
    tc:authorityClass tc:SELECT_CONSTRUCT ;
    tc:hasTargetAsset ex:TargetService ;
    tc:displacesAsset ex:LegacyService ;
    tc:hasTransitionArchitecture ex:DualRunTransition ;
    tc:hasOperationsHandoff ex:OperationsAccepted ;
    tc:hasChangeWatch ex:ChangeWatch ;
    tc:hasBaselineRegistration ex:NewBaseline ;
    tc:hasObligation
        ex:TargetRealization,
        ex:ArchitectureConformance,
        ex:CloseTransition,
        ex:MigrateConsumers,
        ex:StopWrites,
        ex:RevokeAccess,
        ex:DisposeData,
        ex:DeprovisionRuntime,
        ex:TerminateCost,
        ex:ArchiveEvidence,
        ex:ReplacementComplete,
        ex:RegisterNewBaseline,
        ex:CreateClosureEvidence .

ex:TargetService
    a tc:ArchitectureAsset ;
    tc:assetState tc:ACTIVE ;
    tc:evidenceStanding er:ALIVE ;
    tc:accountableOwner "platform-operations" ;
    tc:replaces ex:LegacyService .

ex:LegacyService
    a tc:ArchitectureAsset ;
    tc:assetState tc:DECOMMISSIONED ;
    tc:dispositionDecision tc:REPLACED_AND_DECOMMISSIONED ;
    tc:sunsetDate "2026-08-15"^^xsd:date .

ex:DualRunTransition
    a tc:TransitionArchitecture ;
    tc:transitionState tc:TRANSITION_CLOSED ;
    tc:fromAsset ex:LegacyService ;
    tc:toAsset ex:TargetService .

ex:OperationsAccepted
    a tc:OperationsHandoff ;
    tc:handoffState tc:OPERATIONS_ACCEPTED ;
    tc:accountableOwner "platform-operations" ;
    tc:acceptedAt "2026-08-15T22:00:00Z"^^xsd:dateTime ;
    tc:handoffEvidence ex:OperationsEvidence .

ex:NewBaseline
    a tc:BaselineRegistration ;
    tc:baselineState tc:BASELINE_REGISTERED ;
    tc:includesAsset ex:TargetService ;
    tc:accountableOwner "enterprise-architecture" ;
    tc:baselineRegisteredAt "2026-08-15T22:10:00Z"^^xsd:dateTime ;
    tc:baselineEvidence ex:BaselineEvidence .

ex:ChangeWatch
    a tc:ChangeWatch ;
    tc:changeWatchState tc:WATCH_REGISTERED ;
    tc:accountableOwner "enterprise-architecture" ;
    tc:triggerPolicy "Re-enter architecture review on target replacement, authority-boundary change, major dependency change, or failed closure invariant." ;
    tc:registeredAt "2026-08-15T22:05:00Z"^^xsd:dateTime ;
    tc:watchEvidence ex:ChangeWatchEvidence .

ex:TargetRealization
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:TargetService ;
    tc:obligationKind tc:TARGET_REALIZATION ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:REDUCE ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:TargetRealizationEvidence .

ex:ArchitectureConformance
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:TargetService ;
    tc:obligationKind tc:ARCHITECTURE_CONFORMANCE ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:RAISE ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:ArchitectureConformanceEvidence .

ex:CloseTransition
    a tc:LifecycleObligation ;
    tc:obligationKind tc:CLOSE_TRANSITION ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:REDUCE ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:TransitionEvidence .

ex:MigrateConsumers
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:LegacyService ;
    tc:obligationKind tc:MIGRATE_CONSUMERS ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:REDUCE ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:MigrateConsumersEvidence .

ex:StopWrites
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:LegacyService ;
    tc:obligationKind tc:STOP_WRITES ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:REDUCE ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:StopWritesEvidence .

ex:RevokeAccess
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:LegacyService ;
    tc:obligationKind tc:REVOKE_ACCESS ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:RAISE ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:RevokeAccessEvidence .

ex:DisposeData
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:LegacyService ;
    tc:obligationKind tc:DISPOSE_DATA ;
    tc:obligationState tc:NOT_APPLICABLE_WITH_EVIDENCE ;
    tc:errcLane tc:RAISE ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:DisposeDataEvidence .

ex:DeprovisionRuntime
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:LegacyService ;
    tc:obligationKind tc:DEPROVISION_RUNTIME ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:ELIMINATE ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:DeprovisionRuntimeEvidence .

ex:TerminateCost
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:LegacyService ;
    tc:obligationKind tc:TERMINATE_COST ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:ELIMINATE ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:TerminateCostEvidence .

ex:ArchiveEvidence
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:LegacyService ;
    tc:obligationKind tc:ARCHIVE_EVIDENCE ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:CREATE ;
    tc:closesWip "legacy-evidence-retention" ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:ArchiveEvidenceEvidence .

ex:ReplacementComplete
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:LegacyService ;
    tc:obligationKind tc:DECLARE_REPLACEMENT_COMPLETE ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:REDUCE ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:ReplacementCompleteEvidence .

ex:RegisterNewBaseline
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:TargetService ;
    tc:obligationKind tc:REGISTER_NEW_BASELINE ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:CREATE ;
    tc:closesWip "architecture-repository-baseline-registration" ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:BaselineEvidence .

ex:CreateClosureEvidence
    a tc:LifecycleObligation ;
    tc:subjectAsset ex:TargetService ;
    tc:obligationKind tc:ARCHIVE_EVIDENCE ;
    tc:obligationState tc:OBLIGATION_SATISFIED ;
    tc:errcLane tc:CREATE ;
    tc:closesWip "target-closure-evidence-gap" ;
    tc:receiptRequired true ;
    tc:hasEvidence ex:CreatedClosureEvidence .

ex:TargetRealizationEvidence a tc:ClosureEvidence .
ex:ArchitectureConformanceEvidence a tc:ClosureEvidence .
ex:TransitionEvidence a tc:ClosureEvidence .
ex:MigrateConsumersEvidence a tc:ClosureEvidence .
ex:StopWritesEvidence a tc:ClosureEvidence .
ex:RevokeAccessEvidence a tc:ClosureEvidence .
ex:DisposeDataEvidence a tc:ClosureEvidence .
ex:DeprovisionRuntimeEvidence a tc:ClosureEvidence .
ex:TerminateCostEvidence a tc:ClosureEvidence .
ex:ArchiveEvidenceEvidence a tc:ClosureEvidence .
ex:ReplacementCompleteEvidence a tc:ClosureEvidence .
ex:CreatedClosureEvidence a tc:ClosureEvidence .
ex:OperationsEvidence a tc:ClosureEvidence .
ex:ChangeWatchEvidence a tc:ClosureEvidence .
ex:BaselineEvidence a tc:ClosureEvidence .
