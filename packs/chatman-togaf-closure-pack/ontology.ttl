@prefix tc: <http://seanchatmangpt.github.io/packs/chatman-togaf-closure#> .
@prefix er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Semantic closure law for enterprise projects. The pack models the lifecycle
# facts needed to prove project closure; it does not grant DO authority and
# does not copy proprietary TOGAF text. Consumers own project-specific facts.

tc:EnterpriseProject a rdfs:Class ;
    rdfs:label "Enterprise lifecycle project" ;
    dcterms:description "A bounded architecture/delivery subject whose closure requires target realization, migration closure, legacy disposition, operations handoff, and continuing change governance." .

tc:ArchitectureAsset a rdfs:Class ;
    rdfs:label "Architecture asset" ;
    dcterms:description "A system, service, repository, package, interface, data store, infrastructure unit, contract, license, or other managed asset participating in a baseline, transition, or target architecture." .

tc:TransitionArchitecture a rdfs:Class ;
    rdfs:label "Transition architecture" ;
    dcterms:description "An intermediate operational plateau between baseline and target. A project cannot close while one of its transition architectures remains open." .

tc:LifecycleObligation a rdfs:Class ;
    rdfs:label "Lifecycle closure obligation" ;
    dcterms:description "One explicit unit of work whose terminal disposition is required for enterprise project closure." .

tc:OperationsHandoff a rdfs:Class ;
    rdfs:label "Operations handoff" ;
    dcterms:description "Evidence that accountable operational ownership has accepted the realized target." .

tc:ChangeWatch a rdfs:Class ;
    rdfs:label "Architecture change watch" ;
    dcterms:description "Registered post-project governance that defines ownership and triggers for re-entering architecture review." .

tc:BaselineRegistration a rdfs:Class ;
    rdfs:label "New baseline registration" ;
    dcterms:description "Evidence that the realized target has been accepted into the architecture repository as the new governed baseline." .

tc:ClosureEvidence a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Closure evidence" .

tc:ProjectState a rdfs:Class .
tc:AssetState a rdfs:Class .
tc:TransitionState a rdfs:Class .
tc:ObligationState a rdfs:Class .
tc:DispositionDecision a rdfs:Class .
tc:AuthorityClass a rdfs:Class .
tc:ErrcLane a rdfs:Class .
tc:ObligationKind a rdfs:Class .
tc:HandoffState a rdfs:Class .
tc:ChangeWatchState a rdfs:Class .
tc:BaselineState a rdfs:Class .

# Project lifecycle: evidence standing is intentionally orthogonal.
tc:ARCHITECTING a tc:ProjectState .
tc:MIGRATION_PLANNED a tc:ProjectState .
tc:IMPLEMENTING a tc:ProjectState .
tc:CUTOVER a tc:ProjectState .
tc:LEGACY_RETIREMENT a tc:ProjectState .
tc:CHANGE_GOVERNANCE a tc:ProjectState .
tc:CLOSED a tc:ProjectState .

# Asset lifecycle. SUNSET_SCHEDULED and RETIRED are not decommissioned.
tc:PLANNED a tc:AssetState .
tc:TRANSITION a tc:AssetState .
tc:ACTIVE a tc:AssetState .
tc:SUNSET_SCHEDULED a tc:AssetState .
tc:RETIRING a tc:AssetState .
tc:RETIRED a tc:AssetState .
tc:DECOMMISSIONED a tc:AssetState .
tc:ARCHIVED a tc:AssetState .

tc:TRANSITION_OPEN a tc:TransitionState .
tc:TRANSITION_CLOSED a tc:TransitionState .

tc:OBLIGATION_REQUIRED a tc:ObligationState .
tc:OBLIGATION_SATISFIED a tc:ObligationState .
tc:NOT_APPLICABLE_WITH_EVIDENCE a tc:ObligationState .

tc:REPLACED_AND_DECOMMISSIONED a tc:DispositionDecision .
tc:RETAINED_WITH_DECISION a tc:DispositionDecision .

tc:SELECT_CONSTRUCT a tc:AuthorityClass .
tc:DO a tc:AuthorityClass .

tc:ELIMINATE a tc:ErrcLane .
tc:REDUCE a tc:ErrcLane .
tc:RAISE a tc:ErrcLane .
tc:CREATE a tc:ErrcLane .

tc:OPERATIONS_PENDING a tc:HandoffState .
tc:OPERATIONS_ACCEPTED a tc:HandoffState .

tc:WATCH_PENDING a tc:ChangeWatchState .
tc:WATCH_REGISTERED a tc:ChangeWatchState .

tc:BASELINE_PENDING a tc:BaselineState .
tc:BASELINE_REGISTERED a tc:BaselineState .

# Mandatory kinds are intentionally generic enough to cover software, cloud,
# data, identity, vendor, and repository retirement. NOT_APPLICABLE is allowed
# only with evidence, so irrelevant controls are explicit rather than omitted.
tc:TARGET_REALIZATION a tc:ObligationKind .
tc:ARCHITECTURE_CONFORMANCE a tc:ObligationKind .
tc:MIGRATE_CONSUMERS a tc:ObligationKind .
tc:STOP_WRITES a tc:ObligationKind .
tc:REVOKE_ACCESS a tc:ObligationKind .
tc:DISPOSE_DATA a tc:ObligationKind .
tc:DEPROVISION_RUNTIME a tc:ObligationKind .
tc:TERMINATE_COST a tc:ObligationKind .
tc:ARCHIVE_EVIDENCE a tc:ObligationKind .
tc:TRANSFER_OWNERSHIP a tc:ObligationKind .
tc:ACCEPT_OPERATIONS a tc:ObligationKind .
tc:CLOSE_TRANSITION a tc:ObligationKind .
tc:REGISTER_CHANGE_WATCH a tc:ObligationKind .
tc:REGISTER_NEW_BASELINE a tc:ObligationKind .
tc:DECLARE_REPLACEMENT_COMPLETE a tc:ObligationKind .
tc:RETIRE_INTERFACE a tc:ObligationKind .
tc:RETIRE_PACKAGE a tc:ObligationKind .
tc:RETIRE_REPOSITORY a tc:ObligationKind .
tc:REMOVE_IDENTITY a tc:ObligationKind .
tc:TERMINATE_CONTRACT a tc:ObligationKind .
tc:TERMINATE_LICENSE a tc:ObligationKind .

# Project relations.
tc:projectState a rdf:Property ; rdfs:domain tc:EnterpriseProject ; rdfs:range tc:ProjectState .
tc:authorityClass a rdf:Property ; rdfs:domain tc:EnterpriseProject ; rdfs:range tc:AuthorityClass .
tc:hasTargetAsset a rdf:Property ; rdfs:domain tc:EnterpriseProject ; rdfs:range tc:ArchitectureAsset .
tc:displacesAsset a rdf:Property ; rdfs:domain tc:EnterpriseProject ; rdfs:range tc:ArchitectureAsset .
tc:hasTransitionArchitecture a rdf:Property ; rdfs:domain tc:EnterpriseProject ; rdfs:range tc:TransitionArchitecture .
tc:hasObligation a rdf:Property ; rdfs:domain tc:EnterpriseProject ; rdfs:range tc:LifecycleObligation .
tc:hasOperationsHandoff a rdf:Property ; rdfs:domain tc:EnterpriseProject ; rdfs:range tc:OperationsHandoff .
tc:hasChangeWatch a rdf:Property ; rdfs:domain tc:EnterpriseProject ; rdfs:range tc:ChangeWatch .
tc:hasBaselineRegistration a rdf:Property ; rdfs:domain tc:EnterpriseProject ; rdfs:range tc:BaselineRegistration .

# Asset and replacement relations.
tc:assetState a rdf:Property ; rdfs:domain tc:ArchitectureAsset ; rdfs:range tc:AssetState .
tc:evidenceStanding a rdf:Property ; rdfs:domain tc:ArchitectureAsset .
tc:replaces a rdf:Property ; rdfs:domain tc:ArchitectureAsset ; rdfs:range tc:ArchitectureAsset .
tc:dispositionDecision a rdf:Property ; rdfs:domain tc:ArchitectureAsset ; rdfs:range tc:DispositionDecision .
tc:sunsetDate a rdf:Property ; rdfs:domain tc:ArchitectureAsset ; rdfs:range xsd:date .
tc:accountableOwner a rdf:Property .
tc:decisionEvidence a rdf:Property ; rdfs:range tc:ClosureEvidence .

# Transition architecture relations.
tc:transitionState a rdf:Property ; rdfs:domain tc:TransitionArchitecture ; rdfs:range tc:TransitionState .
tc:fromAsset a rdf:Property ; rdfs:domain tc:TransitionArchitecture ; rdfs:range tc:ArchitectureAsset .
tc:toAsset a rdf:Property ; rdfs:domain tc:TransitionArchitecture ; rdfs:range tc:ArchitectureAsset .

# Obligations are the enterprise-level WIP unit.
tc:obligationKind a rdf:Property ; rdfs:domain tc:LifecycleObligation ; rdfs:range tc:ObligationKind .
tc:obligationState a rdf:Property ; rdfs:domain tc:LifecycleObligation ; rdfs:range tc:ObligationState .
tc:subjectAsset a rdf:Property ; rdfs:domain tc:LifecycleObligation ; rdfs:range tc:ArchitectureAsset .
tc:subjectTransition a rdf:Property ; rdfs:domain tc:LifecycleObligation ; rdfs:range tc:TransitionArchitecture .
tc:errcLane a rdf:Property ; rdfs:domain tc:LifecycleObligation ; rdfs:range tc:ErrcLane .
tc:receiptRequired a rdf:Property ; rdfs:domain tc:LifecycleObligation ; rdfs:range xsd:boolean .
tc:hasEvidence a rdf:Property ; rdfs:domain tc:LifecycleObligation ; rdfs:range tc:ClosureEvidence .
tc:closesWip a rdf:Property ; rdfs:domain tc:LifecycleObligation .
tc:blockedDependents a rdf:Property ; rdfs:domain tc:LifecycleObligation ; rdfs:range xsd:nonNegativeInteger .
tc:impactScore a rdf:Property ; rdfs:domain tc:LifecycleObligation ; rdfs:range xsd:decimal .

# Operations and Phase-H-style continuing governance.
tc:handoffState a rdf:Property ; rdfs:domain tc:OperationsHandoff ; rdfs:range tc:HandoffState .
tc:acceptedAt a rdf:Property ; rdfs:domain tc:OperationsHandoff ; rdfs:range xsd:dateTime .
tc:handoffEvidence a rdf:Property ; rdfs:domain tc:OperationsHandoff ; rdfs:range tc:ClosureEvidence .

tc:changeWatchState a rdf:Property ; rdfs:domain tc:ChangeWatch ; rdfs:range tc:ChangeWatchState .
tc:triggerPolicy a rdf:Property ; rdfs:domain tc:ChangeWatch .
tc:registeredAt a rdf:Property ; rdfs:domain tc:ChangeWatch ; rdfs:range xsd:dateTime .
tc:watchEvidence a rdf:Property ; rdfs:domain tc:ChangeWatch ; rdfs:range tc:ClosureEvidence .

tc:baselineState a rdf:Property ; rdfs:domain tc:BaselineRegistration ; rdfs:range tc:BaselineState .
tc:includesAsset a rdf:Property ; rdfs:domain tc:BaselineRegistration ; rdfs:range tc:ArchitectureAsset .
tc:baselineRegisteredAt a rdf:Property ; rdfs:domain tc:BaselineRegistration ; rdfs:range xsd:dateTime .
tc:baselineEvidence a rdf:Property ; rdfs:domain tc:BaselineRegistration ; rdfs:range tc:ClosureEvidence .

# Public-ontology alignment.
tc:LifecycleObligation rdfs:subClassOf prov:Activity .
tc:accountableOwner rdfs:subPropertyOf dcterms:contributor .
tc:hasEvidence rdfs:subPropertyOf prov:used .
tc:decisionEvidence rdfs:subPropertyOf prov:wasDerivedFrom .
tc:handoffEvidence rdfs:subPropertyOf prov:wasDerivedFrom .
tc:watchEvidence rdfs:subPropertyOf prov:wasDerivedFrom .
tc:baselineEvidence rdfs:subPropertyOf prov:wasDerivedFrom .

tc:CLOSED skos:prefLabel "project closed" .
tc:DECOMMISSIONED skos:prefLabel "asset decommissioned" .
tc:ARCHIVED skos:prefLabel "asset archived" .
tc:TRANSITION_CLOSED skos:prefLabel "transition architecture closed" .
tc:BASELINE_REGISTERED skos:prefLabel "new baseline registered" .
