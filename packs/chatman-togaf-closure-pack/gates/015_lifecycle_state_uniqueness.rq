# MESSAGE: Current lifecycle state is single-valued for projects, assets,
# transitions, obligations, operations handoffs, change watches, and baseline
# registrations. Conflicting states make closure ambiguous and are refused.
PREFIX tc: <http://seanchatmangpt.github.io/packs/chatman-togaf-closure#>
SELECT ?subject ?reason WHERE {
  {
    ?subject a tc:EnterpriseProject ;
             tc:projectState ?a, ?b .
    FILTER(?a != ?b)
    BIND("conflicting-project-state" AS ?reason)
  } UNION {
    ?subject a tc:ArchitectureAsset ;
             tc:assetState ?a, ?b .
    FILTER(?a != ?b)
    BIND("conflicting-asset-state" AS ?reason)
  } UNION {
    ?subject a tc:TransitionArchitecture ;
             tc:transitionState ?a, ?b .
    FILTER(?a != ?b)
    BIND("conflicting-transition-state" AS ?reason)
  } UNION {
    ?subject a tc:LifecycleObligation ;
             tc:obligationState ?a, ?b .
    FILTER(?a != ?b)
    BIND("conflicting-obligation-state" AS ?reason)
  } UNION {
    ?subject a tc:OperationsHandoff ;
             tc:handoffState ?a, ?b .
    FILTER(?a != ?b)
    BIND("conflicting-handoff-state" AS ?reason)
  } UNION {
    ?subject a tc:ChangeWatch ;
             tc:changeWatchState ?a, ?b .
    FILTER(?a != ?b)
    BIND("conflicting-change-watch-state" AS ?reason)
  } UNION {
    ?subject a tc:BaselineRegistration ;
             tc:baselineState ?a, ?b .
    FILTER(?a != ?b)
    BIND("conflicting-baseline-state" AS ?reason)
  }
}
ORDER BY ?subject ?reason
