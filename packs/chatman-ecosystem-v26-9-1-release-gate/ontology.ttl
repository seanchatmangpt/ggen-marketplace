@prefix cer: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-v26-9-1-release-gate#> .
@prefix er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# This pack instantiates chatman-ecosystem-release-pack's composition law
# (er: vocabulary) for the v26.9.1 gate specifically. It reuses er:Release,
# er:Component, er:StandingState, er:AuthorityClass, and er:role rather than
# declaring a disjoint standing/authority vocabulary — the v26.9.1 release
# graph a consumer builds from release-manifest.toml is an er:Release whose
# er:Component individuals carry er:role values drawn from the real
# ecosystem's admitted role vocabulary (see release-manifest.example.toml).
# Per chatman-ecosystem-release-pack's own law, exact release-instance SHAs
# remain consumer-owned and are never duplicated into this pack's source.

cer:ReleaseGate a rdfs:Class ;
    rdfs:subClassOf er:Release ;
    rdfs:label "Chatman Ecosystem release gate" ;
    dcterms:description "A bounded release gate that binds exact component identities, evidence, authority separation, receipts, replay, and standing without granting ambient DO authority. Its component graph is an er:Release/er:Component graph checked by chatman-ecosystem-release-pack's gates." .

cer:Gate a rdfs:Class .

# Standing and authority vocabulary is not re-declared here: this pack uses
# er:StandingState (er:UNKNOWN, er:PARTIAL_ALIVE, er:ALIVE, er:BLOCKED,
# er:BUILD_BROKEN, er:UNSUPPORTED) and er:AuthorityClass
# (er:SELECT_CONSTRUCT, er:DO) directly.

cer:releaseV26_9_1 a cer:ReleaseGate ;
    dcterms:identifier "v26.9.1" ;
    dcterms:title "Chatman Ecosystem v26.9.1 release gate" ;
    er:authorityClass er:SELECT_CONSTRUCT ;
    cer:doAuthority false ;
    cer:hasGate cer:G01, cer:G02, cer:G03, cer:G04, cer:G05, cer:G06, cer:G07, cer:G08, cer:G09 ;
    # Real admitted role vocabulary observed in ~/chatman-ecosystem/ecosystem.lock
    # at the time this gate pack was aligned (see pack.toml [pack].description
    # for the exact commit citation). A consumer's release-manifest.toml is
    # expected to supply er:Component individuals whose er:role falls in this
    # set for the release-verifier gate (G07) to admit them.
    er:requiredRole "receipt-reference",
        "capability-reference",
        "process-evidence",
        "planner",
        "oracle",
        "manufacturer",
        "certifier",
        "semantic-admission",
        "actuation-authority" .

cer:G01 a cer:Gate ; dcterms:title "architecture-freeze" ; cer:ordinal 1 .
cer:G02 a cer:Gate ; dcterms:title "gymact-consolidation" ; cer:ordinal 2 .
cer:G03 a cer:Gate ; dcterms:title "brce-end-to-end" ; cer:ordinal 3 .
cer:G04 a cer:Gate ; dcterms:title "autofde-to-gymact" ; cer:ordinal 4 .
cer:G05 a cer:Gate ; dcterms:title "process-intelligence-feedback" ; cer:ordinal 5 .
cer:G06 a cer:Gate ; dcterms:title "gdmcp-deterministic-path" ; cer:ordinal 6 .
cer:G07 a cer:Gate ; dcterms:title "ecosystem-release-verifier" ; cer:ordinal 7 .
cer:G08 a cer:Gate ; dcterms:title "fortune5-capstone" ; cer:ordinal 8 .
cer:G09 a cer:Gate ; dcterms:title "immutable-release" ; cer:ordinal 9 .

cer:hasGate a rdf:Property ; rdfs:domain cer:ReleaseGate ; rdfs:range cer:Gate .
cer:ordinal a rdf:Property ; rdfs:domain cer:Gate ; rdfs:range xsd:integer .
cer:doAuthority a rdf:Property ; rdfs:domain cer:ReleaseGate ; rdfs:range xsd:boolean .
cer:requiresIndependentObservation a rdf:Property ; rdfs:range xsd:boolean .
cer:requiresReceipt a rdf:Property ; rdfs:range xsd:boolean .
cer:requiresReplay a rdf:Property ; rdfs:range xsd:boolean .

cer:G03 cer:requiresIndependentObservation true ; cer:requiresReceipt true ; cer:requiresReplay true .
cer:G05 cer:requiresIndependentObservation true ; cer:requiresReceipt true .
cer:G08 cer:requiresIndependentObservation true ; cer:requiresReceipt true ; cer:requiresReplay true .
cer:G09 cer:requiresReceipt true ; cer:requiresReplay true .

# Public provenance semantics are retained for exact-subject evidence carriers.
cer:ReleaseEvidence a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    dcterms:description "Evidence bound to an exact release subject and consumed by a gate without conferring authority." .
