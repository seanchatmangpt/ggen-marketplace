@prefix er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Qualification-only external fact identity. The canonical authority-class
# vocabulary and individual are owned by chatman-ecosystem-release-pack; this
# fixture supplies only the minimum typed identity required when this pack is
# qualified in isolation. It does not re-mint the vocabulary or grant DO.
er:SELECT_CONSTRUCT a er:AuthorityClass ;
    dcterms:source "packs/chatman-ecosystem-release-pack/ontology.ttl#er:SELECT_CONSTRUCT" .
