{#-
  Cargo.toml.tmpl — CSCB runner (Rust emission, RFC-2026-0042 §4.1)
  Binding contract: see templates/rust/BINDING_CONTRACT.md
  Consumes: crate_name, description, rust_edition
-#}
[package]
name = "{{ crate_name }}"
version = "0.1.0"
edition = "{{ rust_edition }}"
description = "{{ description }}"

# no_std-compatible core profile: the default build depends only on libm-free
# core/std-free arithmetic plus the cycle-counter module (cfg-gated per arch).
# `criterion` is optional behind the `bench` feature for host-side statistical
# benchmarking; the edge/no_std target builds with --no-default-features.
[features]
default = ["std"]
std = []
bench = ["dep:criterion"]

[dependencies]
# Results emission is self-contained (hand-rolled CSV/JSON writers + CRC32),
# so the default profile carries ZERO third-party deps. No libc, no std
# requirement beyond the `std` feature gate.
criterion = { version = "0.5", optional = true }

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
panic = "abort"
