# One row per CSCB arc stage, with runner-profile scalars repeated on every row
# (ggen's static-rule law flattens only cross-row COMMON keys to the top-level
# Tera context, so scalars must be present on every row to be usable as
# {{ crate_name }} etc.; the stage rows drive the template's stage list).
#
# The scalars are minted ontology terms since lane T20: cscb:RunnerProfile
# individual cscb:runner-001, bound to the positive-control arc via
# cscb:profileOf. Changing the emitted crate no longer touches this file —
# edit cscb:runner-001 in ontology.ttl.
PREFIX cscb: <urn:cscb:>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?crate_name ?description ?rust_edition ?iterations ?warmup_iterations
       ?output_basename ?stage_loop_var ?n_stages ?stage_name_rust ?stage_id
WHERE {
  {
    SELECT (COUNT(DISTINCT ?st) AS ?n_stages)
    WHERE {
      ?arc2 a cscb:BenchmarkArc ;
            cscb:hasStage ?st .
      ?st a/rdfs:subClassOf* cscb:ArcStage .
    }
  }
  ?profile a cscb:RunnerProfile ;
           cscb:profileOf ?arc ;
           cscb:crateName ?crate_name ;
           cscb:crateDescription ?description ;
           cscb:rustEdition ?rust_edition ;
           cscb:iterations ?iterations ;
           cscb:warmupIterations ?warmup_iterations ;
           cscb:outputBasename ?output_basename ;
           cscb:stageLoopVar ?stage_loop_var .
  ?arc cscb:hasStage ?stage .
  ?stage a/rdfs:subClassOf* cscb:ArcStage ;
         rdfs:label ?label ;
         cscb:stageIndex ?stage_id .
  # R15 defense-in-depth (AR6 P0): stage_name_rust is the label with backslash,
  # double-quote, and control characters Rust-string-escaped at the QUERY layer,
  # so the template can never interpolate raw label bytes into a Rust string
  # literal even if the label gate is bypassed. With the lawful charset
  # (^[A-Za-z0-9 _-]{1,64}$) escaped == raw; the escape is depth-2 insurance.
  BIND(REPLACE(REPLACE(REPLACE(REPLACE(STR(?label), "\\\\", "\\\\\\\\"),
       "\"", "\\\\\\\""),
       "[\\u0000-\\u001F]", ""),
       "[\\u007F]", "") AS ?stage_name_rust)
}
ORDER BY ?stage_id
