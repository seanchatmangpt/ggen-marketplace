---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch07",
  "files_and_dirs": {
    "README.md": true,
    "audit-logger.py": true,
    "audit_logger.py": true,
    "ggen-create.json": true,
    "keycloak-groups.py": true,
    "load-secrets.sh": true,
    "namespace-bootstrap.yaml": true,
    "onboarding-api.py": true,
    "openapi-spec.yaml": true,
    "permission-delegation.py": true,
    "project-bootstrapper.py": true,
    "services/teamService.js": true,
    "templates/backstage-template.yaml": true,
    "templates/namespace-template.yaml": true,
    "templates/resource-quota.yaml": true,
    "templates/team-rbac.yaml": true,
    "test-onboarding.py": true
  },
  "templatize_using_name": "{% endraw %}{{ row.capitalized }}{% raw %}",
  "gen_parent_dir": false
}
{% endraw %}