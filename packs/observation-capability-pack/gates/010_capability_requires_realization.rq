# MESSAGE: every capability in the observation/telemetry family must have at
# least one realization. Any row = an admitted capability contract no provider
# offers -- the resolver would surface a capability it can never discharge.
# REFUSED.
PREFIX ocap: <https://ggen.dev/ontology/observation-capability#>
SELECT ?capability WHERE {
  ?capability a ocap:Capability .
  FILTER NOT EXISTS { ?realization ocap:realizes ?capability }
}
ORDER BY ?capability
