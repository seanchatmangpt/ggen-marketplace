# NEGATIVE fixture: fires gate 020_realization_requires_qualification.
# A tap realization with provider metadata and an evidence requirement but NO
# qualification condition: an unqualified offer is a hope, not a contract.
@prefix ocap: <https://ggen.dev/ontology/observation-capability#> .

ocap:realization-unqualified-tap a ocap:Realization ;
    ocap:realizes ocap:observation-tap ;
    ocap:providerRepo "example-unqualified" ;
    ocap:providerModule "tap offer with no stated qualification conditions" ;
    ocap:versionPinPolicy "none" ;
    ocap:providerAvailable true ;
    ocap:evidenceRequirement "per-occurrence record" .
