# NEGATIVE fixture: fires gate 050_consequential_requires_authority (shape A).
# THE ProviderAvailable != Authorized witness: this realization sets
# ocap:providerAvailable true -- the provider EXISTS -- and emits onto the
# consequential audit-evidence sink WITHOUT any authorityRequirement.
# Provider availability never discharges authority; the gate never reads
# providerAvailable. REFUSED_NO_AUTHORITY class.
@prefix ocap: <https://ggen.dev/ontology/observation-capability#> .

ocap:realization-unauthorized-audit-emit a ocap:Realization ;
    ocap:realizes ocap:telemetry-emit ;
    ocap:providerRepo "example-unauthorized" ;
    ocap:providerModule "emit onto audit-evidence with provider available and no authority" ;
    ocap:versionPinPolicy "none" ;
    ocap:providerAvailable true ;
    ocap:qualificationCondition ocap:qc-ndjson-sink-appends ;
    ocap:evidenceRequirement "sink-side record" ;
    ocap:emitsOn ocap:stream-audit-evidence .
