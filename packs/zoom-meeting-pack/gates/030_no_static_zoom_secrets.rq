# MESSAGE: any row = a static Zoom secret, hardcoded credential/JWT literal, or URL with an embedded access_token in the graph.
PREFIX zoom: <https://seanchatmangpt.dev/ontology/zoom#>

SELECT DISTINCT ?node ?problem WHERE {
  {
    ?node ?pred ?val .
    FILTER(isLiteral(?val))
    FILTER(REGEX(STR(?pred), "(client_?secret|webhook_?secret|secret_?token|api_?secret|api_?key|access_?token|refresh_?token|private_?key)$", "i"))
    FILTER(!REGEX(STR(?val), "^(env:|secretmanager:|projects/|arn:|vault:|\\$\\{)", "i"))
    BIND(CONCAT("static-secret-property:", STR(?pred)) AS ?problem)
  } UNION {
    ?node ?pred ?val .
    FILTER(isLiteral(?val))
    FILTER(REGEX(STR(?val), "^(AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|ghp_[A-Za-z0-9]{36}|sk_[a-z]+_[A-Za-z0-9]+|eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,})"))
    BIND(CONCAT("hardcoded-credential-literal:", STR(?pred)) AS ?problem)
  } UNION {
    ?node ?urlPred ?url .
    FILTER(?urlPred IN (zoom:downloadUrl, zoom:playUrl, zoom:vttUrl, zoom:joinUrl))
    FILTER(REGEX(STR(?url), "[?&]access_token=[^&]+", "i"))
    BIND(CONCAT("url-embedded-access-token:", STR(?urlPred)) AS ?problem)
  }
}
