# MESSAGE: any row = a zoom:Transcript, zoom:TranscriptCue, or zoom:ActionItem missing required provenance links (forMeeting, forRecording, inTranscript, or sourceCue).
PREFIX zoom: <https://seanchatmangpt.dev/ontology/zoom#>

SELECT DISTINCT ?node ?problem WHERE {
  {
    ?node a zoom:Transcript .
    FILTER NOT EXISTS { ?node zoom:forMeeting ?m }
    BIND("transcript-missing-forMeeting" AS ?problem)
  } UNION {
    ?node a zoom:Transcript .
    FILTER NOT EXISTS { ?node zoom:forRecording ?r }
    BIND("transcript-missing-forRecording" AS ?problem)
  } UNION {
    ?node a zoom:TranscriptCue .
    FILTER NOT EXISTS { ?node zoom:inTranscript ?t }
    BIND("cue-missing-inTranscript" AS ?problem)
  } UNION {
    ?node a zoom:ActionItem .
    FILTER NOT EXISTS { ?node zoom:forMeeting ?m }
    BIND("action-item-missing-forMeeting" AS ?problem)
  } UNION {
    ?node a zoom:ActionItem .
    FILTER NOT EXISTS { ?node zoom:sourceCue ?c }
    BIND("action-item-missing-sourceCue" AS ?problem)
  }
}
