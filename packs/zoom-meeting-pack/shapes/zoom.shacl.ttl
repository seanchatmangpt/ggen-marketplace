@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix zoom: <https://seanchatmangpt.dev/ontology/zoom#> .

# SHACL shapes for zoom-meeting-pack (ontology/zoom.ttl).

zoom:MeetingShape a sh:NodeShape ;
    sh:targetClass zoom:Meeting ;
    sh:property [
        sh:path zoom:meetingId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:Meeting requires exactly one zoom:meetingId (xsd:string)." ;
    ] ;
    sh:property [
        sh:path zoom:meetingUuid ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:Meeting requires exactly one zoom:meetingUuid (xsd:string)." ;
    ] ;
    sh:property [
        sh:path zoom:topic ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:Meeting requires exactly one zoom:topic (xsd:string)." ;
    ] ;
    sh:property [
        sh:path zoom:hostId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:startTime ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:endTime ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:durationMinutes ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:meetingStatus ;
        sh:in ( "waiting" "started" "ended" ) ;
        sh:maxCount 1 ;
        sh:message "zoom:meetingStatus must be one of waiting, started, ended." ;
    ] ;
    sh:property [
        sh:path zoom:hasParticipant ;
        sh:class zoom:Participant ;
    ] ;
    sh:property [
        sh:path zoom:hasRecording ;
        sh:class zoom:Recording ;
    ] ;
    sh:property [
        sh:path zoom:hasTranscript ;
        sh:class zoom:Transcript ;
    ] ;
    sh:property [
        sh:path zoom:hasActionItem ;
        sh:class zoom:ActionItem ;
    ] .

zoom:ParticipantShape a sh:NodeShape ;
    sh:targetClass zoom:Participant ;
    sh:property [
        sh:path zoom:participantId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:Participant requires exactly one zoom:participantId." ;
    ] ;
    sh:property [
        sh:path zoom:participantName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:Participant requires exactly one zoom:participantName." ;
    ] ;
    sh:property [
        sh:path zoom:participantEmail ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:participantRole ;
        sh:in ( "host" "co-host" "attendee" ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:durationSeconds ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:inMeeting ;
        sh:class zoom:Meeting ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:Participant must link to exactly one zoom:Meeting via zoom:inMeeting." ;
    ] .

zoom:RecordingShape a sh:NodeShape ;
    sh:targetClass zoom:Recording ;
    sh:property [
        sh:path zoom:recordingId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:Recording requires exactly one zoom:recordingId." ;
    ] ;
    sh:property [
        sh:path zoom:fileType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:fileSizeBytes ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:forMeeting ;
        sh:class zoom:Meeting ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:Recording must link to exactly one zoom:Meeting via zoom:forMeeting." ;
    ] ;
    sh:property [
        sh:path zoom:hasTranscript ;
        sh:class zoom:Transcript ;
    ] .

zoom:TranscriptShape a sh:NodeShape ;
    sh:targetClass zoom:Transcript ;
    sh:property [
        sh:path zoom:transcriptId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:Transcript requires exactly one zoom:transcriptId." ;
    ] ;
    sh:property [
        sh:path zoom:language ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:forMeeting ;
        sh:class zoom:Meeting ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:Transcript must link to exactly one zoom:Meeting via zoom:forMeeting." ;
    ] ;
    sh:property [
        sh:path zoom:forRecording ;
        sh:class zoom:Recording ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:hasCue ;
        sh:class zoom:TranscriptCue ;
    ] .

zoom:TranscriptCueShape a sh:NodeShape ;
    sh:targetClass zoom:TranscriptCue ;
    sh:property [
        sh:path zoom:cueIndex ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:TranscriptCue requires a non-negative integer zoom:cueIndex." ;
    ] ;
    sh:property [
        sh:path zoom:startTimeOffset ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:endTimeOffset ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:cueText ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:TranscriptCue requires zoom:cueText." ;
    ] ;
    sh:property [
        sh:path zoom:inTranscript ;
        sh:class zoom:Transcript ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:TranscriptCue must link to exactly one zoom:Transcript via zoom:inTranscript." ;
    ] .

zoom:ActionItemShape a sh:NodeShape ;
    sh:targetClass zoom:ActionItem ;
    sh:property [
        sh:path zoom:actionItemId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:ActionItem requires exactly one zoom:actionItemId." ;
    ] ;
    sh:property [
        sh:path zoom:actionSummary ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:ActionItem requires zoom:actionSummary." ;
    ] ;
    sh:property [
        sh:path zoom:actionStatus ;
        sh:in ( "open" "in_progress" "done" "cancelled" ) ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path zoom:forMeeting ;
        sh:class zoom:Meeting ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:ActionItem must link to exactly one zoom:Meeting via zoom:forMeeting." ;
    ] ;
    sh:property [
        sh:path zoom:sourceCue ;
        sh:class zoom:TranscriptCue ;
        sh:maxCount 1 ;
    ] .

zoom:WebhookEventShape a sh:NodeShape ;
    sh:targetClass zoom:WebhookEvent ;
    sh:property [
        sh:path zoom:eventId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:WebhookEvent requires exactly one zoom:eventId." ;
    ] ;
    sh:property [
        sh:path zoom:eventType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "endpoint.url_validation"
            "meeting.started"
            "meeting.ended"
            "recording.completed"
            "recording.transcript_completed"
        ) ;
        sh:message "zoom:eventType must be one of endpoint.url_validation, meeting.started, meeting.ended, recording.completed, recording.transcript_completed." ;
    ] ;
    sh:property [
        sh:path zoom:eventTimestamp ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "zoom:WebhookEvent requires zoom:eventTimestamp (xsd:dateTime)." ;
    ] ;
    sh:property [
        sh:path zoom:forMeeting ;
        sh:class zoom:Meeting ;
        sh:maxCount 1 ;
    ] .
