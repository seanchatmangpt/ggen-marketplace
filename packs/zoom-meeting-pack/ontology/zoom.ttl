@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix zoom: <https://seanchatmangpt.dev/ontology/zoom#> .

<https://seanchatmangpt.dev/ontology/zoom> a owl:Ontology ;
    rdfs:label "Zoom Meeting Domain Ontology" ;
    rdfs:comment "Defines Zoom meeting, participant, recording, transcript, transcript cue, action item, and webhook event vocabulary." ;
    owl:versionInfo "0.1.0" .

# ---------------------------------------------------------------------------
# Classes
# ---------------------------------------------------------------------------

zoom:Meeting a owl:Class ;
    rdfs:label "Meeting" ;
    rdfs:comment "A scheduled or instant Zoom meeting session." .

zoom:Participant a owl:Class ;
    rdfs:label "Participant" ;
    rdfs:comment "A person or endpoint attending a Zoom meeting." .

zoom:Recording a owl:Class ;
    rdfs:label "Recording" ;
    rdfs:comment "A cloud or local recording artifact produced by a Zoom meeting." .

zoom:Transcript a owl:Class ;
    rdfs:label "Transcript" ;
    rdfs:comment "A speech-to-text transcript generated for a Zoom meeting recording." .

zoom:TranscriptCue a owl:Class ;
    rdfs:label "Transcript Cue" ;
    rdfs:comment "A single time-bounded speaker utterance within a Zoom transcript." .

zoom:ActionItem a owl:Class ;
    rdfs:label "Action Item" ;
    rdfs:comment "A follow-up task or commitment extracted from a Zoom meeting or transcript." .

zoom:WebhookEvent a owl:Class ;
    rdfs:label "Webhook Event" ;
    rdfs:comment "An inbound Zoom webhook notification (endpoint.url_validation, meeting.started, meeting.ended, recording.completed, recording.transcript_completed)." .

# ---------------------------------------------------------------------------
# Meeting properties
# ---------------------------------------------------------------------------

zoom:meetingId a owl:DatatypeProperty ;
    rdfs:label "meeting ID" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range xsd:string ;
    rdfs:comment "Numeric or string Zoom meeting identifier." .

zoom:meetingUuid a owl:DatatypeProperty ;
    rdfs:label "meeting UUID" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range xsd:string ;
    rdfs:comment "Unique Zoom meeting instance UUID." .

zoom:topic a owl:DatatypeProperty ;
    rdfs:label "topic" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range xsd:string .

zoom:hostId a owl:DatatypeProperty ;
    rdfs:label "host ID" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range xsd:string .

zoom:startTime a owl:DatatypeProperty ;
    rdfs:label "start time" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range xsd:dateTime .

zoom:endTime a owl:DatatypeProperty ;
    rdfs:label "end time" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range xsd:dateTime .

zoom:durationMinutes a owl:DatatypeProperty ;
    rdfs:label "duration minutes" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range xsd:integer .

zoom:timezone a owl:DatatypeProperty ;
    rdfs:label "timezone" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range xsd:string .

zoom:joinUrl a owl:DatatypeProperty ;
    rdfs:label "join URL" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range xsd:anyURI .

zoom:meetingStatus a owl:DatatypeProperty ;
    rdfs:label "meeting status" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range xsd:string ;
    rdfs:comment "Lifecycle status such as waiting, started, or ended." .

zoom:hasParticipant a owl:ObjectProperty ;
    rdfs:label "has participant" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range zoom:Participant .

zoom:hasRecording a owl:ObjectProperty ;
    rdfs:label "has recording" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range zoom:Recording .

zoom:hasTranscript a owl:ObjectProperty ;
    rdfs:label "has transcript" ;
    rdfs:range zoom:Transcript .

zoom:hasActionItem a owl:ObjectProperty ;
    rdfs:label "has action item" ;
    rdfs:domain zoom:Meeting ;
    rdfs:range zoom:ActionItem .

# ---------------------------------------------------------------------------
# Participant properties
# ---------------------------------------------------------------------------

zoom:participantId a owl:DatatypeProperty ;
    rdfs:label "participant ID" ;
    rdfs:domain zoom:Participant ;
    rdfs:range xsd:string .

zoom:userId a owl:DatatypeProperty ;
    rdfs:label "user ID" ;
    rdfs:domain zoom:Participant ;
    rdfs:range xsd:string .

zoom:participantName a owl:DatatypeProperty ;
    rdfs:label "participant name" ;
    rdfs:domain zoom:Participant ;
    rdfs:range xsd:string .

zoom:participantEmail a owl:DatatypeProperty ;
    rdfs:label "participant email" ;
    rdfs:domain zoom:Participant ;
    rdfs:range xsd:string .

zoom:participantRole a owl:DatatypeProperty ;
    rdfs:label "participant role" ;
    rdfs:domain zoom:Participant ;
    rdfs:range xsd:string ;
    rdfs:comment "Role in meeting: host, co-host, or attendee." .

zoom:joinTime a owl:DatatypeProperty ;
    rdfs:label "join time" ;
    rdfs:domain zoom:Participant ;
    rdfs:range xsd:dateTime .

zoom:leaveTime a owl:DatatypeProperty ;
    rdfs:label "leave time" ;
    rdfs:domain zoom:Participant ;
    rdfs:range xsd:dateTime .

zoom:durationSeconds a owl:DatatypeProperty ;
    rdfs:label "duration seconds" ;
    rdfs:domain zoom:Participant ;
    rdfs:range xsd:integer .

zoom:inMeeting a owl:ObjectProperty ;
    rdfs:label "in meeting" ;
    rdfs:domain zoom:Participant ;
    rdfs:range zoom:Meeting .

# ---------------------------------------------------------------------------
# Recording properties
# ---------------------------------------------------------------------------

zoom:recordingId a owl:DatatypeProperty ;
    rdfs:label "recording ID" ;
    rdfs:domain zoom:Recording ;
    rdfs:range xsd:string .

zoom:recordingType a owl:DatatypeProperty ;
    rdfs:label "recording type" ;
    rdfs:domain zoom:Recording ;
    rdfs:range xsd:string ;
    rdfs:comment "e.g., shared_screen_with_speaker_view, audio_only, audio_transcript." .

zoom:fileType a owl:DatatypeProperty ;
    rdfs:label "file type" ;
    rdfs:domain zoom:Recording ;
    rdfs:range xsd:string ;
    rdfs:comment "e.g., MP4, M4A, VTT, TXT." .

zoom:fileSizeBytes a owl:DatatypeProperty ;
    rdfs:label "file size bytes" ;
    rdfs:domain zoom:Recording ;
    rdfs:range xsd:integer .

zoom:downloadUrl a owl:DatatypeProperty ;
    rdfs:label "download URL" ;
    rdfs:domain zoom:Recording ;
    rdfs:range xsd:anyURI .

zoom:playUrl a owl:DatatypeProperty ;
    rdfs:label "play URL" ;
    rdfs:domain zoom:Recording ;
    rdfs:range xsd:anyURI .

zoom:recordingStart a owl:DatatypeProperty ;
    rdfs:label "recording start" ;
    rdfs:domain zoom:Recording ;
    rdfs:range xsd:dateTime .

zoom:recordingEnd a owl:DatatypeProperty ;
    rdfs:label "recording end" ;
    rdfs:domain zoom:Recording ;
    rdfs:range xsd:dateTime .

zoom:recordingStatus a owl:DatatypeProperty ;
    rdfs:label "recording status" ;
    rdfs:domain zoom:Recording ;
    rdfs:range xsd:string .

zoom:forMeeting a owl:ObjectProperty ;
    rdfs:label "for meeting" ;
    rdfs:range zoom:Meeting .

# ---------------------------------------------------------------------------
# Transcript & TranscriptCue properties
# ---------------------------------------------------------------------------

zoom:transcriptId a owl:DatatypeProperty ;
    rdfs:label "transcript ID" ;
    rdfs:domain zoom:Transcript ;
    rdfs:range xsd:string .

zoom:language a owl:DatatypeProperty ;
    rdfs:label "language" ;
    rdfs:domain zoom:Transcript ;
    rdfs:range xsd:string .

zoom:vttUrl a owl:DatatypeProperty ;
    rdfs:label "VTT URL" ;
    rdfs:domain zoom:Transcript ;
    rdfs:range xsd:anyURI .

zoom:fullText a owl:DatatypeProperty ;
    rdfs:label "full text" ;
    rdfs:domain zoom:Transcript ;
    rdfs:range xsd:string .

zoom:forRecording a owl:ObjectProperty ;
    rdfs:label "for recording" ;
    rdfs:domain zoom:Transcript ;
    rdfs:range zoom:Recording .

zoom:hasCue a owl:ObjectProperty ;
    rdfs:label "has cue" ;
    rdfs:domain zoom:Transcript ;
    rdfs:range zoom:TranscriptCue .

zoom:cueIndex a owl:DatatypeProperty ;
    rdfs:label "cue index" ;
    rdfs:domain zoom:TranscriptCue ;
    rdfs:range xsd:integer .

zoom:startTimeOffset a owl:DatatypeProperty ;
    rdfs:label "start time offset" ;
    rdfs:domain zoom:TranscriptCue ;
    rdfs:range xsd:string ;
    rdfs:comment "VTT timestamp or offset from recording start (e.g., 00:01:23.450)." .

zoom:endTimeOffset a owl:DatatypeProperty ;
    rdfs:label "end time offset" ;
    rdfs:domain zoom:TranscriptCue ;
    rdfs:range xsd:string .

zoom:speakerName a owl:DatatypeProperty ;
    rdfs:label "speaker name" ;
    rdfs:domain zoom:TranscriptCue ;
    rdfs:range xsd:string .

zoom:speakerEmail a owl:DatatypeProperty ;
    rdfs:label "speaker email" ;
    rdfs:domain zoom:TranscriptCue ;
    rdfs:range xsd:string .

zoom:cueText a owl:DatatypeProperty ;
    rdfs:label "cue text" ;
    rdfs:domain zoom:TranscriptCue ;
    rdfs:range xsd:string .

zoom:inTranscript a owl:ObjectProperty ;
    rdfs:label "in transcript" ;
    rdfs:domain zoom:TranscriptCue ;
    rdfs:range zoom:Transcript .

# ---------------------------------------------------------------------------
# ActionItem properties
# ---------------------------------------------------------------------------

zoom:actionItemId a owl:DatatypeProperty ;
    rdfs:label "action item ID" ;
    rdfs:domain zoom:ActionItem ;
    rdfs:range xsd:string .

zoom:actionSummary a owl:DatatypeProperty ;
    rdfs:label "action summary" ;
    rdfs:domain zoom:ActionItem ;
    rdfs:range xsd:string .

zoom:assignee a owl:DatatypeProperty ;
    rdfs:label "assignee" ;
    rdfs:domain zoom:ActionItem ;
    rdfs:range xsd:string .

zoom:dueDate a owl:DatatypeProperty ;
    rdfs:label "due date" ;
    rdfs:domain zoom:ActionItem ;
    rdfs:range xsd:date .

zoom:actionStatus a owl:DatatypeProperty ;
    rdfs:label "action status" ;
    rdfs:domain zoom:ActionItem ;
    rdfs:range xsd:string .

zoom:sourceCue a owl:ObjectProperty ;
    rdfs:label "source cue" ;
    rdfs:domain zoom:ActionItem ;
    rdfs:range zoom:TranscriptCue .

# ---------------------------------------------------------------------------
# WebhookEvent properties & supported event types
# ---------------------------------------------------------------------------

zoom:eventId a owl:DatatypeProperty ;
    rdfs:label "event ID" ;
    rdfs:domain zoom:WebhookEvent ;
    rdfs:range xsd:string .

zoom:eventType a owl:DatatypeProperty ;
    rdfs:label "event type" ;
    rdfs:domain zoom:WebhookEvent ;
    rdfs:range xsd:string ;
    rdfs:comment "Zoom webhook event name: endpoint.url_validation, meeting.started, meeting.ended, recording.completed, recording.transcript_completed." .

zoom:eventTimestamp a owl:DatatypeProperty ;
    rdfs:label "event timestamp" ;
    rdfs:domain zoom:WebhookEvent ;
    rdfs:range xsd:dateTime .

zoom:accountId a owl:DatatypeProperty ;
    rdfs:label "account ID" ;
    rdfs:domain zoom:WebhookEvent ;
    rdfs:range xsd:string .

zoom:signature a owl:DatatypeProperty ;
    rdfs:label "webhook signature" ;
    rdfs:domain zoom:WebhookEvent ;
    rdfs:range xsd:string ;
    rdfs:comment "x-zm-signature HMAC-SHA256 header value." .

zoom:signatureTimestamp a owl:DatatypeProperty ;
    rdfs:label "signature timestamp" ;
    rdfs:domain zoom:WebhookEvent ;
    rdfs:range xsd:string ;
    rdfs:comment "x-zm-request-timestamp header value." .

zoom:plainToken a owl:DatatypeProperty ;
    rdfs:label "plain token" ;
    rdfs:domain zoom:WebhookEvent ;
    rdfs:range xsd:string ;
    rdfs:comment "Challenge token present on endpoint.url_validation events." .

zoom:encryptedToken a owl:DatatypeProperty ;
    rdfs:label "encrypted token" ;
    rdfs:domain zoom:WebhookEvent ;
    rdfs:range xsd:string ;
    rdfs:comment "HMAC-SHA256 response token computed for endpoint.url_validation." .
