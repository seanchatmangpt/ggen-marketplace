@prefix fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#> .

# Falsifier for gates/060: a credential-named env literal on the intake service.
# Expected 060 rows: 1 (env-literal-name-looks-like-credential). 050 rows: 0.
fgb:svc_intake fgb:envVar [ fgb:envName "VENDOR_API_KEY" ; fgb:envValue "literal" ] .
