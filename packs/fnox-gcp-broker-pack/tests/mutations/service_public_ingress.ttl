@prefix fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#> .
@prefix gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#> .

# Falsifier for gates/050: additive sibling worker exposed publicly. Expected 050 rows: 1
# (service-ingress-not-internal-only). 060 reports one row too (egress worker without accessor
# role is NOT triggered; it carries the role) -> expected 060 rows: 0.
fgb:worker_mut_public a fgb:EgressWorker ; gtf:inModule gtf:mod_broker ; gtf:order 90 ;
    gtf:resourceType "google_cloud_run_v2_service" ; gtf:resourceName "egress_mut_public" ;
    fgb:gcpName "fnox-egress-mut-public" ; fgb:vendor "twilio" ;
    fgb:runsAs fgb:sa_egress_twilio ;
    fgb:ingress "INGRESS_TRAFFIC_ALL" ;
    fgb:accessesSecret fgb:secret_twilio ;
    fgb:accessorRole "roles/secretmanager.secretAccessor" .
