# MUTATION: a static JSON key for the platform service account. Union with ontology/fnox-gcp-broker.ttl.
# Expected: gates/030_zero_static_key.rq returns >= 1 row (google_service_account_key-forbidden); shapes/fgb.shacl.ttl does not conform.
@prefix gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#> .
@prefix fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#> .

fgb:mutant_platform_key a gtf:Resource ; gtf:inModule gtf:mod_broker ; gtf:order 61 ;
    gtf:resourceType "google_service_account_key" ; gtf:resourceName "platform_key" ;
    fgb:bindsAccount fgb:sa_platform .
