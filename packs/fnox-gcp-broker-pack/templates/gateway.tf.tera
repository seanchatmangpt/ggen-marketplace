---
to: "infra/gcp/broker/gateway.tf"
force: true
determinism: true
sparql:
  gateways: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?gw ?order ?name ?gcp_name ?sa_name WHERE {
      ?gw a fgb:Gateway ; gtf:order ?order ; gtf:resourceName ?name ; fgb:gcpName ?gcp_name ; fgb:runsAs ?sa .
      ?sa gtf:resourceName ?sa_name .
    } ORDER BY ?order ?name
  routes: |
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?gw ?path ?backend WHERE {
      ?gw a fgb:Gateway ; fgb:ingressRoute ?r .
      ?r fgb:routePath ?path ; fgb:routeBackend ?backend .
    } ORDER BY ?gw ?path
---
# GENERATED by `ggen sync` from packs/fnox-gcp-broker-pack/ontology/fnox-gcp-broker.ttl — do not edit by hand.
# Inbound vendor webhooks terminate at API Gateway and are forwarded to the platform; vendor
# signature verification happens in the platform (zero vendor secrets live in this gateway).
{% for g in gateways %}
locals {
  openapi_{{ g.name }} = <<-EOT
    swagger: "2.0"
    info:
      title: {{ g.gcp_name }}
      version: "1.0.0"
    schemes:
      - https
    paths:
{% for r in routes | filter(attribute="gw", value=g.gw) %}      {{ r.path }}:
        post:
          operationId: {{ r.path | replace(from="/", to="_") | trim_start_matches(pat="_") }}
          x-google-backend:
            address: {{ r.backend }}
            jwt_audience: {{ r.backend }}
          responses:
            "200":
              description: accepted
{% endfor %}  EOT
}

resource "google_api_gateway_api" "{{ g.name }}" {
  provider = google-beta
  project  = var.project_id
  api_id   = "{{ g.gcp_name }}"

  depends_on = [google_project_service.api]
}

resource "google_api_gateway_api_config" "{{ g.name }}" {
  provider      = google-beta
  project       = var.project_id
  api           = google_api_gateway_api.{{ g.name }}.api_id
  api_config_id = "{{ g.gcp_name }}-config"

  openapi_documents {
    document {
      path     = "openapi.yaml"
      contents = base64encode(local.openapi_{{ g.name }})
    }
  }

  gateway_config {
    backend_config {
      google_service_account = google_service_account.{{ g.sa_name }}.email
    }
  }

  lifecycle {
    create_before_destroy = true
  }
}

resource "google_api_gateway_gateway" "{{ g.name }}" {
  provider   = google-beta
  project    = var.project_id
  region     = var.region
  gateway_id = "{{ g.gcp_name }}"
  api_config = google_api_gateway_api_config.{{ g.name }}.id
}
{% endfor %}