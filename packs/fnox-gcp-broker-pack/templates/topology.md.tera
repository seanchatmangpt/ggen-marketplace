---
to: "infra/gcp/broker/topology.md"
force: true
determinism: true
sparql:
  resources: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    SELECT ?order ?type ?name WHERE {
      ?r gtf:inModule gtf:mod_broker ; gtf:order ?order ; gtf:resourceType ?type ; gtf:resourceName ?name .
      FILTER NOT EXISTS { ?r a gtf:ApiService }
    } ORDER BY ?order ?type ?name
  topics: |
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?gcp_name ?dedup ?dedup_scope ?twin_surface WHERE {
      ?t a fgb:Topic ; fgb:gcpName ?gcp_name ; fgb:dedupAttribute ?dedup ; fgb:messageOrdering true .
      OPTIONAL { ?t fgb:dedupScope ?dedup_scope }
      OPTIONAL { ?t fgb:twinSurface ?twin_surface }
    } ORDER BY ?gcp_name
  pushes: |
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?gcp_name ?endpoint ?audience ?signer ?issuer ?jwks_path ?alg ?twin_surface WHERE {
      ?s a fgb:PushSubscription ; fgb:gcpName ?gcp_name ; fgb:pushEndpoint ?endpoint ;
         fgb:oidcAudience ?audience ; fgb:oidcServiceAccount ?sa .
      ?sa fgb:accountId ?signer .
      OPTIONAL { ?s fgb:oidcIssuer ?issuer }
      OPTIONAL { ?s fgb:oidcJwksPath ?jwks_path }
      OPTIONAL { ?s fgb:oidcAlg ?alg }
      OPTIONAL { ?s fgb:twinSurface ?twin_surface }
    } ORDER BY ?gcp_name
  intake: |
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?bucket ?trigger ?service ?model ?provenance ?ingress WHERE {
      ?b a fgb:Bucket ; fgb:gcpName ?bucket ; fgb:finalizeTrigger ?tr .
      ?tr fgb:gcpName ?trigger ; fgb:destination ?svc .
      ?svc fgb:gcpName ?service ; fgb:model ?model ; fgb:provenance ?provenance .
      OPTIONAL { ?svc fgb:ingress ?ingress }
    } ORDER BY ?bucket
  workers: |
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?vendor ?gcp_name ?sa ?secret ?role ?ingress WHERE {
      ?w a fgb:EgressWorker ; fgb:vendor ?vendor ; fgb:gcpName ?gcp_name ; fgb:runsAs ?s ;
         fgb:accessesSecret ?sec ; fgb:accessorRole ?role .
      ?s fgb:accountId ?sa .
      ?sec fgb:gcpName ?secret .
      OPTIONAL { ?w fgb:ingress ?ingress }
    } ORDER BY ?vendor
  routes: |
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?gateway ?path ?backend WHERE {
      ?g a fgb:Gateway ; fgb:gcpName ?gateway ; fgb:ingressRoute ?r .
      ?r fgb:routePath ?path ; fgb:routeBackend ?backend .
    } ORDER BY ?gateway ?path
  wi: |
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?sa ?namespace ?ksa ?flavor_hdr ?flavor_val ?token_path ?twin_surface WHERE {
      ?b a fgb:WorkloadIdentityBinding ; fgb:bindsAccount ?acct ; fgb:kubernetesNamespace ?namespace ; fgb:kubernetesServiceAccount ?ksa .
      ?acct fgb:accountId ?sa .
      OPTIONAL { ?b fgb:metadataFlavorHeader ?flavor_hdr }
      OPTIONAL { ?b fgb:metadataFlavorValue ?flavor_val }
      OPTIONAL { ?b fgb:metadataTokenPath ?token_path }
      OPTIONAL { ?b fgb:twinSurface ?twin_surface }
    } ORDER BY ?sa
  constraints: |
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?forbidden ?org_constraint ?rationale WHERE {
      ?c a fgb:Constraint ; rdfs:label ?label ; fgb:forbidsResourceType ?forbidden ;
         fgb:orgPolicyConstraint ?org_constraint ; fgb:rationale ?rationale .
    } ORDER BY ?label
---
# fnox GCP broker topology (Tier 3)

Standing: UNVERIFIED

GENERATED by `ggen sync` from `packs/fnox-gcp-broker-pack/ontology/fnox-gcp-broker.ttl`.
This file is a projection receipt of the graph, not evidence that anything was applied.
Generated Terraform carries no DO authority; `terraform apply` is a separately admitted transition.

## Actuation topic
