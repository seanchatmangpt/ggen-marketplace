---
to: "infra/gcp/broker/intake.tf"
force: true
determinism: true
sparql:
  buckets: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?order ?name ?gcp_name WHERE {
      ?b a fgb:Bucket ; gtf:order ?order ; gtf:resourceName ?name ; fgb:gcpName ?gcp_name .
    } ORDER BY ?order ?name
  services: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?svc ?order ?name ?gcp_name ?image ?sa_name ?provenance ?model WHERE {
      ?svc a fgb:IntakeService ; gtf:order ?order ; gtf:resourceName ?name ; fgb:gcpName ?gcp_name ;
           fgb:image ?image ; fgb:runsAs ?sa ; fgb:provenance ?provenance ; fgb:model ?model .
      ?sa gtf:resourceName ?sa_name .
    } ORDER BY ?order ?name
  env: |
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?svc ?env_name ?env_value WHERE {
      ?svc a fgb:IntakeService ; fgb:envVar ?e .
      ?e fgb:envName ?env_name ; fgb:envValue ?env_value .
    } ORDER BY ?svc ?env_name
  triggers: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?order ?name ?gcp_name ?bucket_name ?svc_name ?sa_name WHERE {
      ?tr a fgb:FinalizeTrigger ; gtf:order ?order ; gtf:resourceName ?name ; fgb:gcpName ?gcp_name ;
          fgb:onBucket ?b ; fgb:destination ?svc ; fgb:runsAs ?sa .
      ?b gtf:resourceName ?bucket_name .
      ?svc gtf:resourceName ?svc_name .
      ?sa gtf:resourceName ?sa_name .
    } ORDER BY ?order ?name
---
# GENERATED by `ggen sync` from packs/fnox-gcp-broker-pack/ontology/fnox-gcp-broker.ttl — do not edit by hand.
{% for b in buckets %}
resource "google_storage_bucket" "{{ b.name }}" {
  project                     = var.project_id
  name                        = "{{ b.gcp_name }}"
  location                    = var.intake_bucket_location
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"

  versioning {
    enabled = true
  }

  depends_on = [google_project_service.api]
}
{% endfor %}
# Eventarc GCS triggers publish through the GCS service agent; it needs pubsub.publisher.
data "google_storage_project_service_account" "gcs" {
  project = var.project_id
}

resource "google_project_iam_member" "gcs_agent_pubsub_publisher" {
  project = var.project_id
  role    = "roles/pubsub.publisher"
  member  = "serviceAccount:${data.google_storage_project_service_account.gcs.email_address}"
}
{% for s in services %}
# provenance: {{ s.provenance }} — extraction via Document AI with Vertex {{ s.model }}.
resource "google_cloud_run_v2_service" "{{ s.name }}" {
  project  = var.project_id
  name     = "{{ s.gcp_name }}"
  location = var.region
  ingress  = "INGRESS_TRAFFIC_INTERNAL_ONLY"

  template {
    service_account = google_service_account.{{ s.sa_name }}.email

    containers {
      image = "{{ s.image }}"
{% for e in env | filter(attribute="svc", value=s.svc) %}
      env {
        name  = "{{ e.env_name }}"
        value = "{{ e.env_value }}"
      }
{% endfor %}    }
  }

  depends_on = [google_project_service.api]
}
{% endfor %}
{% for t in triggers %}
resource "google_eventarc_trigger" "{{ t.name }}" {
  project         = var.project_id
  name            = "{{ t.gcp_name }}"
  location        = var.intake_bucket_location == "US" ? "us" : lower(var.intake_bucket_location)
  service_account = google_service_account.{{ t.sa_name }}.email

  matching_criteria {
    attribute = "type"
    value     = "google.cloud.storage.object.v1.finalized"
  }

  matching_criteria {
    attribute = "bucket"
    value     = google_storage_bucket.{{ t.bucket_name }}.name
  }

  destination {
    cloud_run_service {
      service = google_cloud_run_v2_service.{{ t.svc_name }}.name
      region  = var.region
      path    = "/ingest"
    }
  }

  depends_on = [google_project_iam_member.gcs_agent_pubsub_publisher]
}

resource "google_cloud_run_v2_service_iam_member" "{{ t.name }}_invoker" {
  project  = var.project_id
  location = var.region
  name     = google_cloud_run_v2_service.{{ t.svc_name }}.name
  role     = "roles/run.invoker"
  member   = "serviceAccount:${google_service_account.{{ t.sa_name }}.email}"
}
{% endfor %}