---
to: "infra/gcp/broker/identity.tf"
force: true
determinism: true
sparql:
  accounts: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?order ?name ?account_id ?label WHERE {
      ?sa a fgb:ServiceAccount ; gtf:order ?order ; gtf:resourceName ?name ; fgb:accountId ?account_id ; rdfs:label ?label .
    } ORDER BY ?order ?name
  project_roles: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?name ?role WHERE {
      ?sa a fgb:ServiceAccount ; gtf:resourceName ?name ; fgb:projectRole ?role .
    } ORDER BY ?name ?role
  publishers: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?name ?topic_name WHERE {
      ?sa a fgb:ServiceAccount ; gtf:resourceName ?name ; fgb:publishesTo ?t .
      ?t a fgb:Topic ; gtf:resourceName ?topic_name .
    } ORDER BY ?name ?topic_name
  wi_bindings: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?name ?sa_name ?namespace ?ksa ?flavor_hdr ?flavor_val ?token_path ?email_path ?twin_surface WHERE {
      ?b a fgb:WorkloadIdentityBinding ; gtf:resourceName ?name ; fgb:bindsAccount ?sa ;
         fgb:kubernetesNamespace ?namespace ; fgb:kubernetesServiceAccount ?ksa .
      ?sa gtf:resourceName ?sa_name .
      OPTIONAL { ?b fgb:metadataFlavorHeader ?flavor_hdr }
      OPTIONAL { ?b fgb:metadataFlavorValue ?flavor_val }
      OPTIONAL { ?b fgb:metadataTokenPath ?token_path }
      OPTIONAL { ?b fgb:metadataEmailPath ?email_path }
      OPTIONAL { ?b fgb:twinSurface ?twin_surface }
    } ORDER BY ?name
  constraints: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?name ?org_constraint ?forbidden ?rationale WHERE {
      ?c a fgb:Constraint ; gtf:resourceName ?name ; fgb:orgPolicyConstraint ?org_constraint ;
         fgb:forbidsResourceType ?forbidden ; fgb:rationale ?rationale .
    } ORDER BY ?name
---
# GENERATED by `ggen sync` from packs/fnox-gcp-broker-pack/ontology/fnox-gcp-broker.ttl — do not edit by hand.
# Zero static keys: this file (and this module) never declares a google_service_account_key.
# Enforced at the graph by gates/030_zero_static_key.rq and at the project by the org policy below.
{% for sa in accounts %}
resource "google_service_account" "{{ sa.name }}" {
  project      = var.project_id
  account_id   = "{{ sa.account_id }}"
  display_name = "{{ sa.label }}"
  depends_on   = [google_project_service.api]
}
{% endfor %}
{% for pr in project_roles %}
resource "google_project_iam_member" "{{ pr.name }}_{{ pr.role | replace(from="roles/", to="") | replace(from=".", to="_") }}" {
  project = var.project_id
  role    = "{{ pr.role }}"
  member  = "serviceAccount:${google_service_account.{{ pr.name }}.email}"
}
{% endfor %}
{% for p in publishers %}
resource "google_pubsub_topic_iam_member" "{{ p.name }}_publishes_{{ p.topic_name }}" {
  project = var.project_id
  topic   = google_pubsub_topic.{{ p.topic_name }}.name
  role    = "roles/pubsub.publisher"
  member  = "serviceAccount:${google_service_account.{{ p.name }}.email}"
}
{% endfor %}
{% for w in wi_bindings %}
# Metadata token contract (arcus-fnox {{ w.twin_surface | default(value="/metadata/") }}): {{ w.flavor_hdr | default(value="Metadata-Flavor") }}={{ w.flavor_val | default(value="Google") }}, token={{ w.token_path | default(value="/computeMetadata/v1/instance/service-accounts/default/token") }}, email={{ w.email_path | default(value="/computeMetadata/v1/instance/service-accounts/default/email") }}
resource "google_service_account_iam_member" "{{ w.name }}" {
  service_account_id = google_service_account.{{ w.sa_name }}.name
  role               = "roles/iam.workloadIdentityUser"
  member             = "serviceAccount:${var.gke_project_id}.svc.id.goog[{{ w.namespace }}/{{ w.ksa }}]"
}
{% endfor %}
{% for c in constraints %}
# {{ c.rationale }}
# Forbidden resource type: {{ c.forbidden }}
resource "google_org_policy_policy" "{{ c.name }}" {
  name   = "projects/${var.project_id}/policies/{{ c.org_constraint | replace(from="constraints/", to="") }}"
  parent = "projects/${var.project_id}"

  spec {
    rules {
      enforce = "TRUE"
    }
  }

  depends_on = [google_project_service.api]
}
{% endfor %}