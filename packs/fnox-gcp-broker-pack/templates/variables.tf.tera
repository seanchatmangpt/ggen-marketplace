---
to: "infra/gcp/broker/variables.tf"
force: true
determinism: true
sparql:
  topics: |
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?gcp_name ?dedup WHERE {
      ?t a fgb:Topic ; fgb:gcpName ?gcp_name ; fgb:dedupAttribute ?dedup .
    } ORDER BY ?gcp_name
---
# GENERATED by `ggen sync` from packs/fnox-gcp-broker-pack/ontology/fnox-gcp-broker.ttl — do not edit by hand.
variable "project_id" {
  type        = string
  description = "GCP project hosting the fnox broker tier."
}

variable "region" {
  type        = string
  default     = "us-central1"
  description = "Region for Cloud Run, Eventarc, Artifact Registry and the intake bucket."
}

variable "ar_repo" {
  type        = string
  default     = "fnox"
  description = "Artifact Registry repository holding intake/egress images."
}

variable "image_tag" {
  type        = string
  description = "Immutable image tag (digest-pinned by the deployer) for all broker services."
}

variable "intake_bucket_location" {
  type        = string
  default     = "US"
  description = "Location of the fnox-intake-pdfs bucket."
}

variable "gke_project_id" {
  type        = string
  description = "Project whose GKE Workload Identity pool (<project>.svc.id.goog) hosts the platform pods."
}
{% for t in topics %}
# Topic {{ t.gcp_name }}: consumers dedup on message attribute "{{ t.dedup }}".
variable "dedup_attribute_{{ t.gcp_name | replace(from="-", to="_") }}" {
  type    = string
  default = "{{ t.dedup }}"
  validation {
    condition     = var.dedup_attribute_{{ t.gcp_name | replace(from="-", to="_") }} == "{{ t.dedup }}"
    error_message = "The dedup attribute for {{ t.gcp_name }} is pinned by the ontology to {{ t.dedup }}."
  }
}
{% endfor %}