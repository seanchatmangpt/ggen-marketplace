---
to: "infra/gcp/broker/egress_workers.tf"
force: true
determinism: true
sparql:
  secrets: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?order ?name ?gcp_name WHERE {
      ?s a fgb:Secret ; gtf:order ?order ; gtf:resourceName ?name ; fgb:gcpName ?gcp_name .
    } ORDER BY ?order ?name
  workers: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?order ?name ?gcp_name ?vendor ?image ?sa_name ?secret_name ?secret_gcp_name ?accessor_role ?ingress WHERE {
      ?w a fgb:EgressWorker ; gtf:order ?order ; gtf:resourceName ?name ; fgb:gcpName ?gcp_name ;
         fgb:vendor ?vendor ; fgb:image ?image ; fgb:runsAs ?sa ; fgb:accessesSecret ?sec ; fgb:accessorRole ?accessor_role .
      ?sa gtf:resourceName ?sa_name .
      ?sec gtf:resourceName ?secret_name ; fgb:gcpName ?secret_gcp_name .
      OPTIONAL { ?w fgb:ingress ?ingress }
    } ORDER BY ?order ?name
---
# GENERATED by `ggen sync` from packs/fnox-gcp-broker-pack/ontology/fnox-gcp-broker.ttl — do not edit by hand.
# Least privilege: each egress worker's runtime SA holds roles/secretmanager.secretAccessor on
# exactly one secret (gates/020_worker_single_secret.rq). Secret versions are never managed here.
{% for s in secrets %}
resource "google_secret_manager_secret" "{{ s.name }}" {
  project   = var.project_id
  secret_id = "{{ s.gcp_name }}"

  replication {
    auto {}
  }

  depends_on = [google_project_service.api]
}
{% endfor %}
{% for w in workers %}
resource "google_cloud_run_v2_service" "{{ w.name }}" {
  project  = var.project_id
  name     = "{{ w.gcp_name }}"
  location = var.region
  ingress  = "{{ w.ingress | default(value="INGRESS_TRAFFIC_INTERNAL_ONLY") }}"

  template {
    service_account = google_service_account.{{ w.sa_name }}.email

    containers {
      image = "{{ w.image }}"

      env {
        name = "{{ w.secret_gcp_name }}"
        value_source {
          secret_key_ref {
            secret  = google_secret_manager_secret.{{ w.secret_name }}.secret_id
            version = "latest"
          }
        }
      }

      env {
        name  = "FNOX_VENDOR"
        value = "{{ w.vendor }}"
      }
    }
  }

  depends_on = [google_secret_manager_secret_iam_member.{{ w.name }}_accessor]
}

resource "google_secret_manager_secret_iam_member" "{{ w.name }}_accessor" {
  project   = var.project_id
  secret_id = google_secret_manager_secret.{{ w.secret_name }}.secret_id
  role      = "{{ w.accessor_role }}"
  member    = "serviceAccount:${google_service_account.{{ w.sa_name }}.email}"
}
{% endfor %}