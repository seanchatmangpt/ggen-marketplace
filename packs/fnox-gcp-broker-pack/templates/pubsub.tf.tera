---
to: "infra/gcp/broker/pubsub.tf"
force: true
determinism: true
sparql:
  topics: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?order ?name ?gcp_name ?dedup ?dedup_scope ?twin_surface ?retention ?rationale WHERE {
      ?t a fgb:Topic ; gtf:order ?order ; gtf:resourceName ?name ; fgb:gcpName ?gcp_name ;
         fgb:dedupAttribute ?dedup ; fgb:messageOrdering true .
      OPTIONAL { ?t fgb:dedupScope ?dedup_scope }
      OPTIONAL { ?t fgb:twinSurface ?twin_surface }
      OPTIONAL { ?t fgb:retentionDuration ?retention }
      OPTIONAL { ?t fgb:rationale ?rationale }
    } ORDER BY ?order ?name
  subscriptions: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
    SELECT ?order ?name ?gcp_name ?topic_name ?ack_deadline ?endpoint ?audience ?signer_name ?issuer ?jwks_path ?alg ?twin_surface WHERE {
      ?s a fgb:PushSubscription ; gtf:order ?order ; gtf:resourceName ?name ; fgb:gcpName ?gcp_name ;
         fgb:subscribesTo ?t ; fgb:ackDeadlineSeconds ?ack_deadline ; fgb:pushEndpoint ?endpoint ;
         fgb:oidcAudience ?audience ; fgb:oidcServiceAccount ?signer ; fgb:messageOrdering true .
      ?t gtf:resourceName ?topic_name .
      ?signer gtf:resourceName ?signer_name .
      OPTIONAL { ?s fgb:oidcIssuer ?issuer }
      OPTIONAL { ?s fgb:oidcJwksPath ?jwks_path }
      OPTIONAL { ?s fgb:oidcAlg ?alg }
      OPTIONAL { ?s fgb:twinSurface ?twin_surface }
    } ORDER BY ?order ?name
---
# GENERATED by `ggen sync` from packs/fnox-gcp-broker-pack/ontology/fnox-gcp-broker.ttl — do not edit by hand.
{% for t in topics %}
# {{ t.rationale | default(value="") }}
# Pub/Sub has no server-side dedup: the push receiver is idempotent on attribute "{{ t.dedup }}" (arcus-fnox fnoxtwin {{ t.twin_surface | default(value="/pubsub/") }} keys on (topic, {{ t.dedup_scope | default(value="orderingKey") }}, {{ t.dedup }})).
resource "google_pubsub_topic" "{{ t.name }}" {
  project                    = var.project_id
  name                       = "{{ t.gcp_name }}"
  message_retention_duration = "{{ t.retention | default(value="604800s") }}"

  labels = {
    ordering        = "enabled"
    dedup_attribute = "{{ t.dedup }}"
    dedup_scope     = "{{ t.dedup_scope | default(value="orderingKey") }}"
  }

  depends_on = [google_project_service.api]
}
{% endfor %}
{% for s in subscriptions %}
# OIDC push: issuer={{ s.issuer | default(value="https://accounts.google.com") }} alg={{ s.alg | default(value="RS256") }} jwks={{ s.twin_surface | default(value="/oidc/") }}{{ s.jwks_path | default(value="/.well-known/jwks.json") | trim_start_matches(pat="/") }}
resource "google_pubsub_subscription" "{{ s.name }}" {
  project                 = var.project_id
  name                    = "{{ s.gcp_name }}"
  topic                   = google_pubsub_topic.{{ s.topic_name }}.id
  ack_deadline_seconds    = {{ s.ack_deadline }}
  enable_message_ordering = true

  push_config {
    push_endpoint = "{{ s.endpoint }}"

    oidc_token {
      service_account_email = google_service_account.{{ s.signer_name }}.email
      audience              = "{{ s.audience }}"
    }

    attributes = {
      x-goog-version = "v1"
    }
  }

  retry_policy {
    minimum_backoff = "10s"
    maximum_backoff = "600s"
  }

  expiration_policy {
    ttl = ""
  }
}
{% endfor %}