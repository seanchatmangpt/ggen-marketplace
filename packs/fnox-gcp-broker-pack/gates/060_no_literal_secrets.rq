# MESSAGE: any row = a secret-bearing literal or an over-broad secret grant.
# Secrets are mounted via fgb:accessesSecret only; env literals never carry credentials, egress
# workers hold the per-secret accessor role (never project-wide secretmanager roles), and every
# egress worker names its vendor.
PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
SELECT DISTINCT ?node ?problem WHERE {
  {
    ?node a fgb:Service ; fgb:envVar ?ev .
    ?ev fgb:envName ?n .
    FILTER(REGEX(STR(?n), "(KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL)", "i"))
    BIND("env-literal-name-looks-like-credential" AS ?problem)
  } UNION {
    ?node a fgb:ServiceAccount ; fgb:projectRole ?r .
    FILTER(STRSTARTS(STR(?r), "roles/secretmanager."))
    BIND("project-wide-secretmanager-role" AS ?problem)
  } UNION {
    ?node a fgb:EgressWorker .
    FILTER NOT EXISTS { ?node fgb:accessorRole "roles/secretmanager.secretAccessor" }
    BIND("egress-worker-without-secret-accessor-role" AS ?problem)
  } UNION {
    ?node a fgb:EgressWorker .
    FILTER NOT EXISTS { ?node fgb:vendor ?v }
    BIND("egress-worker-without-vendor" AS ?problem)
  }
}
