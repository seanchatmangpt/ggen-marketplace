# MESSAGE: any row = an fgb:EgressWorker whose fgb:accessesSecret cardinality is not exactly 1,
# or whose accessor role is not roles/secretmanager.secretAccessor (least privilege: one worker, one secret).
# Falsifier: tests/mutations/worker_two_secrets.ttl (twilio worker also accesses the stripe secret) must yield >= 1 row.
PREFIX fgb: <https://seanchatmangpt.dev/ontology/fnox-gcp-broker#>
SELECT DISTINCT ?worker ?problem WHERE {
  {
    SELECT ?worker (CONCAT("secret-count-not-1:", STR(COUNT(DISTINCT ?secret))) AS ?problem) WHERE {
      ?worker a fgb:EgressWorker .
      OPTIONAL { ?worker fgb:accessesSecret ?secret }
    }
    GROUP BY ?worker
    HAVING (COUNT(DISTINCT ?secret) != 1)
  }
  UNION
  {
    ?worker a fgb:EgressWorker .
    FILTER NOT EXISTS { ?worker fgb:accessorRole "roles/secretmanager.secretAccessor" }
    BIND("accessor-role-not-secretAccessor" AS ?problem)
  }
  UNION
  {
    ?worker a fgb:EgressWorker ; fgb:accessorRole ?role .
    FILTER(STR(?role) != "roles/secretmanager.secretAccessor")
    BIND(CONCAT("extra-accessor-role:", STR(?role)) AS ?problem)
  }
  UNION
  {
    ?worker a fgb:EgressWorker ; fgb:accessesSecret ?s .
    FILTER NOT EXISTS { ?s a fgb:Secret }
    BIND("accessesSecret-target-not-a-Secret" AS ?problem)
  }
}
