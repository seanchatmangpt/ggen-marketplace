@prefix pc: <https://ggen.dev/ontology/pack-compatibility#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Classes
#################################################################

pc:Component a rdfs:Class ;
    rdfs:comment "A named thing this marketplace or one of its packs depends on at a specific version -- a runtime binary (ggen), a hex package (reactor, spark), or another marketplace pack." .

pc:CompatibilityRequirement a rdfs:Class ;
    rdfs:comment "A real, checkable semver bound on one Component, in PEP 440 specifier syntax (e.g. '>=1.0.6,<2.0.0'), bound by the pack that depends on it and needs the bound enforced." .

#################################################################
# Properties
#################################################################

pc:componentName a rdf:Property ;
    rdfs:domain pc:CompatibilityRequirement ;
    rdfs:comment "The Component's name, matched verbatim against a --check component=version argument to scripts/check_pack_compatibility.py." .

pc:versionRequirement a rdf:Property ;
    rdfs:domain pc:CompatibilityRequirement ;
    rdfs:comment "A PEP 440 specifier string (packaging.specifiers.SpecifierSet syntax), the Python equivalent of Elixir's Version requirement syntax checked via Version.match?/2. Must parse -- gates/010_requirement_shape.rq refuses one that doesn't look like a specifier." .

pc:boundByPack a rdf:Property ;
    rdfs:domain pc:CompatibilityRequirement ;
    rdfs:comment "Which pack in this marketplace declares/needs this bound enforced -- named for real, not a placeholder, so a violation's diagnostic can point at the actual consumer." .

pc:dependsOnComponent a rdf:Property ;
    rdfs:domain pc:Component ;
    rdfs:range pc:Component ;
    rdfs:comment "A real dependency edge between two Components (or packs), consumed by scripts/pack_dependency_order.py to compute a dependency-closed check/install order and refuse a real cycle before one is silently produced. A Component with no outgoing pc:dependsOnComponent edges is a leaf, checked/installed first." .

#################################################################
# Real individuals -- every bound below is a currently-true fact,
# verified against the actual pinned version at the time this pack was
# written (see pack.toml description for exactly how each was checked),
# not an invented or aspirational bound.
#################################################################

pc:GgenRuntimeRequirement a pc:CompatibilityRequirement ;
    pc:componentName "ggen_runtime" ;
    pc:versionRequirement ">=26.8.0,<27.0.0" ;
    pc:boundByPack "marketplace.toml" ;
    rdfs:comment "This marketplace's own root marketplace.toml pins [ggen].version = \"v26.8.11\" -- the checker normalizes the leading 'v' before parsing (see check_pack_compatibility.py's _normalize_version). A consumer running a ggen 27.x binary against this marketplace's packs is outside the bound this repo's own release actually validated against." .

pc:ReactorRequirement a pc:CompatibilityRequirement ;
    pc:componentName "reactor" ;
    pc:versionRequirement ">=1.0.6,<2.0.0" ;
    pc:boundByPack "ash-runtime-integration-contract-pack" ;
    rdfs:comment "ash-runtime-integration-contract-pack's generated templates (reactor.ex.tmpl, compensation.ex.tmpl) target Reactor's real, current API (use Reactor; step/input/return; compensate/4). Verified against /Users/sac/ggen_igniter/mix.lock's real pinned reactor 1.0.6, the same dependency this session's own dogfood generation work (packages/marketplace-cli) already resolves." .

pc:SparkRequirement a pc:CompatibilityRequirement ;
    pc:componentName "spark" ;
    pc:versionRequirement ">=2.3.3,<3.0.0" ;
    pc:boundByPack "ash-extension-pack" ;
    rdfs:comment "ash-extension-pack's templates (extension.ex.tmpl) generate real Spark.Dsl.Extension modules (sections/entities/schema). Bound transcribed directly from reactor 1.0.6's own real dependency requirement on spark in /Users/sac/ggen_igniter/mix.lock (reactor requires spark >= 2.3.3 and < 3.0.0-0) -- not independently invented, since ash-extension-pack's generated code and Reactor share the same Spark DSL runtime." .

#################################################################
# Real dependency edge -- transcribed from the same real mix.lock line as
# pc:SparkRequirement above: reactor 1.0.6 itself declares a hex dependency
# on spark (>= 2.3.3 and < 3.0.0-0). Not an invented graph -- the smallest
# real, checkable edge this marketplace's own survey work found.
#################################################################

pc:Reactor a pc:Component ;
    pc:componentName "reactor" ;
    pc:dependsOnComponent pc:Spark .

pc:Spark a pc:Component ;
    pc:componentName "spark" .
