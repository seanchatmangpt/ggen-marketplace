@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
{% for row in results %}
<{{ row.baseIri }}requirement/REQ-{{ row.decisionKey }}-{{ row.elementKey }}> a ic:Requirement ;
    ic:requirementId "REQ-{{ row.decisionKey }}-{{ row.elementKey }}" ;
    ic:statement "Foundation element {{ row.elementKey }} of operating model decision {{ row.decisionKey }} ({{ row.integration }} integration, {{ row.standardization }} standardization) needs an architecture building block whose contract is signed off by a human." ;
    ic:inClosure <{{ row.closureIri }}> ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability <{{ row.capabilityIri }}> ;
    ic:originAuthority <{{ row.strategyIri }}> .
{% endfor %}
