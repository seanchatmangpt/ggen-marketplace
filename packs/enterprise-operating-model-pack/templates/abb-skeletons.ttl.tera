@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
@prefix eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#> .
{% for row in results %}
<{{ row.baseIri }}abb/{{ row.capabilityKey }}> a ea:ArchitectureBuildingBlock ;
    ea:realizesCapability <{{ row.capabilityIri }}> ;
    ea:governedByContract <{{ row.baseIri }}contract/{{ row.capabilityKey }}> .

<{{ row.baseIri }}contract/{{ row.capabilityKey }}> a ea:ArchitectureContract ;
    ea:hasAuthorityBoundary <{{ row.baseIri }}authority-boundary/construct-ceiling> ;
{% if row.standardization == "HIGH" %}    eom:complianceCriterion eom:StandardProcessVariant ;
{% endif %}{% if row.integration == "HIGH" %}    eom:complianceCriterion eom:SharedDataContract ;
{% endif %}    ic:approvalStatus ic:PENDING_HUMAN_APPROVAL ;
    ic:authorityClaim "NONE" ;
    ic:standing "UNKNOWN" .

<{{ row.baseIri }}authority-boundary/construct-ceiling> a ea:AuthorityBoundary .
{% endfor %}
