# Synthetic Unification enterprise for enterprise-operating-model-pack qualification.
#
# Overlays ontology/enterprise-input.ttl at the same relative path inside the
# qualification capsule. Every IRI is under example.invalid and every digest is a
# synthetic stand-in: nothing here is a real enterprise, receipt or observation.
#
# Capabilities carry ic:capabilityKey (industry-closure-ledger-pack IRI, consumed by IRI only).
# Expected pass-1 output: three strategy-derived requirements (one per foundation
# element) and two ABB/contract skeletons (the integration capability already has an
# ABB, so no skeleton is emitted for it).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#> .
@prefix togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#> .
@prefix ex: <https://example.invalid/enterprise/acme/> .

ex:strategy a ea:Strategy ;
    eom:ofEnterprise ex:enterprise .

ex:decision a eom:OperatingModelDecision ;
    eom:decisionKey "ACME-UNIF" ;
    eom:forStrategy ex:strategy ;
    eom:chosenModel eom:Unification ;
    eom:integrationLevel eom:HIGH ;
    eom:standardizationLevel eom:HIGH ;
    eom:hasFoundation ex:foundation ;
    eom:hasEngagementModel ex:engagement ;
    eom:atStage eom:StageStandardizedTechnology ;
    eom:targetClosure <https://example.invalid/closure/acme> ;
    eom:targetBaseIri "https://example.invalid/closure/acme/" ;
    eom:authorityCeiling "CONSTRUCT" ;
    dcterms:source "synthetic qualification input" .

ex:evidence-stage-1 a eom:StageEvidence ;
    eom:forDecision ex:decision ;
    eom:forStage eom:StageBusinessSilos ;
    eom:receiptDigest "sha256:b58c7d9eea3cae8aca8010c205277420f68e2ff33a1cdc0af6205bb9998f031f" .

ex:evidence-stage-2 a eom:StageEvidence ;
    eom:forDecision ex:decision ;
    eom:forStage eom:StageStandardizedTechnology ;
    eom:receiptDigest "sha256:0720364a66a3e1bb0ac8b6fa29e99751f554896b4367bd0945514d50066a0e74" .

ex:foundation a eom:FoundationForExecution ;
    eom:hasCoreProcess ex:process-order-to-cash ;
    eom:hasSharedData ex:data-customer-master ;
    eom:hasLinkingAutomation ex:link-integration-bus .

ex:process-order-to-cash a eom:CoreBusinessProcess ;
    eom:elementKey "order-to-cash" ;
    eom:standardVariant true ;
    eom:supportsCapability ex:cap-order-to-cash .

ex:data-customer-master a eom:SharedDataDomain ;
    eom:elementKey "customer-master" ;
    eom:enterpriseScope true ;
    eom:ownedBy ex:role-data-owner ;
    eom:supportsCapability ex:cap-customer-data .

ex:role-data-owner a org:Role .

ex:link-integration-bus a eom:LinkingAutomation ;
    eom:elementKey "integration-bus" ;
    eom:realizedByABB ex:abb-integration ;
    eom:supportsCapability ex:cap-integration .

ex:cap-order-to-cash a ea:Capability , eom:EnterpriseCapability ;
    ic:capabilityKey "CAP-ORDER-TO-CASH" ;
    ic:groundedInStrategy ex:strategy ;
    eom:ofEnterprise ex:enterprise .

ex:cap-customer-data a ea:Capability , eom:EnterpriseCapability ;
    ic:capabilityKey "CAP-CUSTOMER-DATA" ;
    ic:groundedInStrategy ex:strategy ;
    eom:ofEnterprise ex:enterprise .

ex:cap-integration a ea:Capability , eom:EnterpriseCapability ;
    ic:capabilityKey "CAP-INTEGRATION" ;
    ic:groundedInStrategy ex:strategy ;
    eom:ofEnterprise ex:enterprise ;
    eom:capabilityRole eom:ENABLING .

ex:abb-integration a ea:ArchitectureBuildingBlock ;
    ea:realizesCapability ex:cap-integration .

ex:value-stream a eom:ValueStream ;
    eom:hasStage ex:vs-stage-fulfil .

ex:vs-stage-fulfil a eom:ValueStreamStage ;
    eom:enablesCapability ex:cap-order-to-cash , ex:cap-customer-data .

ex:engagement a eom:EngagementModel ;
    eom:enterpriseGovernance ex:mech-arb ;
    eom:projectGovernance ex:mech-funding ;
    eom:linkingMechanism ex:mech-compliance .

ex:mech-arb a skos:Concept ;
    skos:notation "ENG-ARCH-REVIEW-BOARD" .

ex:mech-funding a skos:Concept ;
    skos:notation "ENG-PROJECT-FUNDING-GATE" .

ex:mech-compliance a skos:Concept ;
    skos:notation "ENG-COMPLIANCE-REVIEW" .

ex:work-package-bus a togaf:WorkPackage ;
    eom:ofEnterprise ex:enterprise ;
    eom:reviewedBy ex:review-bus .

ex:adm-run a eom:AdmEngagement .

ex:record-prelim a eom:PhaseRecord ;
    eom:ofEngagement ex:adm-run ;
    eom:phase eom:AdmPrelim ;
    eom:status "ACHIEVED" ;
    eom:produced ex:artifact-principles , ex:artifact-governance ;
    eom:reqMgmtReview ex:review-prelim .

ex:artifact-principles a eom:Artifact ;
    eom:artifactKind eom:KindArchitecturePrinciples .

ex:artifact-governance a eom:Artifact ;
    eom:artifactKind eom:KindGovernanceModel .

ex:review-prelim a eom:RequirementsReview .
