# One row per (decision, foundation element, supported capability). Literals and STR() only.
PREFIX eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#>
SELECT DISTINCT ?decisionKey ?elementKey ?capabilityKey
       (STR(?strat) AS ?strategyIri) (STR(?cl) AS ?closureIri) ?baseIri
       ?integration ?standardization (STR(?cap) AS ?capabilityIri)
WHERE {
  ?d a eom:OperatingModelDecision ; eom:decisionKey ?decisionKey ; eom:forStrategy ?strat ;
     eom:targetClosure ?cl ; eom:targetBaseIri ?baseIri ;
     eom:hasFoundation ?f ; eom:integrationLevel ?i ; eom:standardizationLevel ?s .
  ?i eom:levelCode ?integration .
  ?s eom:levelCode ?standardization .
  ?f (eom:hasCoreProcess|eom:hasSharedData|eom:hasLinkingAutomation) ?e .
  ?e eom:elementKey ?elementKey ; eom:supportsCapability ?cap .
  ?cap <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#capabilityKey> ?capabilityKey .
}
ORDER BY ?decisionKey ?elementKey ?capabilityKey
