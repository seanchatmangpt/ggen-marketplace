# One row per (decision, capability) that no architecture building block realizes yet.
# Once a human merges the skeletons the row disappears: that is the fixed point.
PREFIX eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#>
PREFIX ea: <https://chatman.ai/ontology/enterprise-architecture#>
SELECT DISTINCT ?decisionKey ?capabilityKey (STR(?cap) AS ?capabilityIri) ?baseIri ?integration ?standardization
WHERE {
  ?d a eom:OperatingModelDecision ; eom:decisionKey ?decisionKey ; eom:forStrategy ?strat ;
     eom:targetClosure ?cl ; eom:targetBaseIri ?baseIri ;
     eom:hasFoundation ?f ; eom:integrationLevel ?i ; eom:standardizationLevel ?s .
  ?i eom:levelCode ?integration .
  ?s eom:levelCode ?standardization .
  ?f (eom:hasCoreProcess|eom:hasSharedData|eom:hasLinkingAutomation) ?e .
  ?e eom:elementKey ?elementKey ; eom:supportsCapability ?cap .
  ?cap <https://seanchatmangpt.github.io/packs/industry-closure-pack#capabilityKey> ?capabilityKey .
  FILTER NOT EXISTS { ?abb ea:realizesCapability ?cap }
}
ORDER BY ?decisionKey ?capabilityKey
