# enterprise-operating-model-pack ontology (CapabilityPack): the semantic delta for
# "Enterprise Architecture as Strategy" plus the ADM as ontology and gates.
#
# Owns: operating-model axes (integration x standardization), the foundation for
# execution, four maturity stages with ordinals, the IT engagement model, ADM phase
# order and artifact kinds, phase records, and value-stream anchoring.
#
# Does NOT own and never re-types:
#   - ADM phase identity, operating-model identity, maturity-stage identity and
#     engagement-mechanism identity: those are skos:notation values in
#     togaf-adm-pack. This file restates only the notation join keys it needs
#     (OM-*, MAT-*, ADM-*). ENG-* mechanisms are referenced by notation prefix in
#     instance data only. A pytest drift test guards every join key.
#   - ea:Strategy, ea:Capability, ea:ArchitectureBuildingBlock and the other
#     enterprise-architecture-pack terms, and togaf:Capability / togaf:WorkPackage:
#     consumed by IRI in gates, queries and templates, never prefix-declared here.
#
# Interpretation versus source: every statement here is a paraphrased modelling
# choice. The axis obligations (gate 030) and the maturity prerequisites (gate 040)
# are modelling interpretations, not rules quoted from any book. The artifact kinds
# are generic paraphrased kinds (a stable superset), not edition-exact lists.
#
# Authority: gates and queries SELECT, templates CONSTRUCT candidate Turtle. No DO
# individual, class or property is declared anywhere in this namespace.
# Authority vocabulary (literals): "NONE" | "OBSERVE" | "SELECT" | "CONSTRUCT".
#
# Dialect: flat Turtle (no blank nodes, no collections).

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#> .

# ---------------------------------------------------------------------------
# Classes
# ---------------------------------------------------------------------------

eom:OperatingModel a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Operating model" ;
    rdfs:comment "One of four positions on the integration x standardization plane. Identity is the skos:notation join key shared with togaf-adm-pack." .

eom:Level a owl:Class ;
    rdfs:label "Axis level" ;
    rdfs:comment "LOW or HIGH on either operating-model axis." .

eom:OperatingModelDecision a owl:Class ;
    rdfs:label "Operating model decision" ;
    rdfs:comment "A recorded choice, for one strategy, of an operating model with its axes, foundation, engagement model, claimed maturity stage, and the industry closure it targets." .

eom:FoundationForExecution a owl:Class ;
    rdfs:label "Foundation for execution" ;
    rdfs:comment "The core processes, shared data and linking automation an enterprise must have to run its chosen operating model." .

eom:CoreBusinessProcess a owl:Class ;
    rdfs:label "Core business process" ;
    rdfs:comment "A process the enterprise relies on daily. Carries eom:standardVariant to say whether one enterprise-wide variant is used." .

eom:SharedDataDomain a owl:Class ;
    rdfs:subClassOf dcat:Dataset ;
    rdfs:label "Shared data domain" ;
    rdfs:comment "A data domain with a named owner role. eom:enterpriseScope says whether it is shared across the whole enterprise." .

eom:LinkingAutomation a owl:Class ;
    rdfs:label "Linking automation" ;
    rdfs:comment "Automation that links processes and data. Must be realized by an architecture building block." .

eom:ModularComponent a owl:Class ;
    rdfs:label "Modular component" ;
    rdfs:comment "A plug-and-play business component. Required by maturity stage 4 (business modularity)." .

eom:MaturityStage a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Maturity stage" ;
    rdfs:comment "One of four ordered architecture maturity stages. Identity is the skos:notation join key shared with togaf-adm-pack." .

eom:StageEvidence a owl:Class ;
    rdfs:label "Stage evidence" ;
    rdfs:comment "A receipted record that a decision has evidenced one maturity stage. A stage claim needs evidence for itself and every lower stage." .

eom:EngagementModel a owl:Class ;
    rdfs:label "IT engagement model" ;
    rdfs:comment "How enterprise-level governance, project-level governance and a linking mechanism fit together. Not an ADM run: see eom:AdmEngagement." .

eom:Dispensation a owl:Class ;
    rdfs:label "Dispensation" ;
    rdfs:comment "A time-bounded, owned exemption from architecture review for a work package." .

eom:ValueStream a owl:Class ;
    rdfs:label "Value stream" ;
    rdfs:comment "An ordered flow of stages through which the enterprise delivers value." .

eom:ValueStreamStage a owl:Class ;
    rdfs:label "Value stream stage" ;
    rdfs:comment "One stage of a value stream. It enables capabilities, which anchors them to delivered value." .

eom:EnterpriseCapability a owl:Class ;
    rdfs:label "Enterprise capability" ;
    rdfs:comment "Marker for a capability individual in an enterprise. Instance data types it alongside ea:Capability or togaf:Capability. It scopes gate 070 so that unrelated capabilities in a consumer graph are never refused." .

eom:CapabilityRole a owl:Class ;
    rdfs:label "Capability role" ;
    rdfs:comment "The explicit exemption vocabulary for capabilities that sit outside a value stream." .

eom:AdmPhase a owl:Class ;
    rdfs:label "ADM phase" ;
    rdfs:comment "One phase of the architecture development method. Identity is the skos:notation join key shared with togaf-adm-pack. Phase order and artifact requirements are owned here because that pack holds them only as comments." .

eom:ArtifactKind a owl:Class ;
    rdfs:label "Artifact kind" ;
    rdfs:comment "A generic, paraphrased kind of architecture work product. A stable superset, not an edition-exact catalogue." .

eom:Artifact a owl:Class ;
    rdfs:label "Artifact" ;
    rdfs:comment "A concrete work product of a given eom:ArtifactKind." .

eom:AdmEngagement a owl:Class ;
    rdfs:label "ADM engagement" ;
    rdfs:comment "One run of the architecture development method, for example one architecture project. Phase records belong to an engagement." .

eom:PhaseRecord a owl:Class ;
    rdfs:label "Phase record" ;
    rdfs:comment "The status of one ADM phase within one engagement, with the artifacts it produced." .

eom:RequirementsReview a owl:Class ;
    rdfs:label "Requirements review" ;
    rdfs:comment "A review of requirements against an achieved phase. The requirements-management phase is continuous and needs none." .

eom:ComplianceCriterion a owl:Class ;
    rdfs:label "Compliance criterion" ;
    rdfs:comment "A criterion an architecture contract skeleton carries, chosen from the operating-model axes by the generated skeleton template." .

# ---------------------------------------------------------------------------
# Axis levels and the four operating models
# ---------------------------------------------------------------------------

eom:LOW a eom:Level ;
    rdfs:label "Low" ;
    eom:levelCode "LOW" .

eom:HIGH a eom:Level ;
    rdfs:label "High" ;
    eom:levelCode "HIGH" .

eom:Diversification a eom:OperatingModel ;
    rdfs:label "Diversification" ;
    skos:notation "OM-DIVERSIFICATION" ;
    eom:integrationLevel eom:LOW ;
    eom:standardizationLevel eom:LOW .

eom:Coordination a eom:OperatingModel ;
    rdfs:label "Coordination" ;
    skos:notation "OM-COORDINATION" ;
    eom:integrationLevel eom:HIGH ;
    eom:standardizationLevel eom:LOW .

eom:Replication a eom:OperatingModel ;
    rdfs:label "Replication" ;
    skos:notation "OM-REPLICATION" ;
    eom:integrationLevel eom:LOW ;
    eom:standardizationLevel eom:HIGH .

eom:Unification a eom:OperatingModel ;
    rdfs:label "Unification" ;
    skos:notation "OM-UNIFICATION" ;
    eom:integrationLevel eom:HIGH ;
    eom:standardizationLevel eom:HIGH .

# ---------------------------------------------------------------------------
# Maturity stages (ordinals are owned here; identity is the notation)
# ---------------------------------------------------------------------------

eom:StageBusinessSilos a eom:MaturityStage ;
    rdfs:label "Stage 1: business silos" ;
    skos:notation "MAT-1-BUSINESS-SILOS" ;
    eom:stageOrdinal 1 .

eom:StageStandardizedTechnology a eom:MaturityStage ;
    rdfs:label "Stage 2: standardized technology" ;
    skos:notation "MAT-2-STANDARDIZED-TECHNOLOGY" ;
    eom:stageOrdinal 2 ;
    rdfs:comment "Modelling interpretation: claiming this stage needs shared linking infrastructure in the foundation." .

eom:StageOptimizedCore a eom:MaturityStage ;
    rdfs:label "Stage 3: optimized core" ;
    skos:notation "MAT-3-OPTIMIZED-CORE" ;
    eom:stageOrdinal 3 ;
    rdfs:comment "Modelling interpretation: claiming this stage needs every core process to use a standard variant." .

eom:StageBusinessModularity a eom:MaturityStage ;
    rdfs:label "Stage 4: business modularity" ;
    skos:notation "MAT-4-BUSINESS-MODULARITY" ;
    eom:stageOrdinal 4 ;
    rdfs:comment "Modelling interpretation: claiming this stage needs at least one modular component in the foundation." .

# ---------------------------------------------------------------------------
# Capability role (explicit exemption from value-stream anchoring)
# ---------------------------------------------------------------------------

eom:ENABLING a eom:CapabilityRole ;
    rdfs:label "Enabling" ;
    rdfs:comment "An enabling capability supports other capabilities and is exempt from sitting in a value stream stage. Declaring it is explicit, never silent." .

# ---------------------------------------------------------------------------
# Compliance criteria chosen by the skeleton template
# ---------------------------------------------------------------------------

eom:StandardProcessVariant a eom:ComplianceCriterion ;
    rdfs:label "Standard process variant" ;
    rdfs:comment "Emitted on a contract skeleton when the decision's standardization axis is HIGH." .

eom:SharedDataContract a eom:ComplianceCriterion ;
    rdfs:label "Shared data contract" ;
    rdfs:comment "Emitted on a contract skeleton when the decision's integration axis is HIGH." .

# ---------------------------------------------------------------------------
# ADM artifact kinds (generic paraphrase, stable superset)
# ---------------------------------------------------------------------------

eom:KindArchitecturePrinciples a eom:ArtifactKind ;
    rdfs:label "Architecture principles" .

eom:KindGovernanceModel a eom:ArtifactKind ;
    rdfs:label "Architecture governance model" .

eom:KindArchitectureVision a eom:ArtifactKind ;
    rdfs:label "Architecture vision" .

eom:KindStakeholderMap a eom:ArtifactKind ;
    rdfs:label "Stakeholder map" .

eom:KindBusinessArchitecture a eom:ArtifactKind ;
    rdfs:label "Business architecture definition" .

eom:KindInformationSystemsArchitecture a eom:ArtifactKind ;
    rdfs:label "Information systems architecture definition" .

eom:KindTechnologyArchitecture a eom:ArtifactKind ;
    rdfs:label "Technology architecture definition" .

eom:KindOpportunitiesAndSolutions a eom:ArtifactKind ;
    rdfs:label "Opportunities and solutions assessment" .

eom:KindMigrationPlan a eom:ArtifactKind ;
    rdfs:label "Migration plan" .

eom:KindComplianceAssessment a eom:ArtifactKind ;
    rdfs:label "Implementation compliance assessment" .

eom:KindChangeRecord a eom:ArtifactKind ;
    rdfs:label "Architecture change record" .

eom:KindRequirementsRegister a eom:ArtifactKind ;
    rdfs:label "Architecture requirements register" .

# ---------------------------------------------------------------------------
# ADM phases: identity is the notation, order and artifact kinds are owned here.
# eom:precedes forms the chain PRELIM -> A -> B -> ... -> H. Requirements
# management is continuous and sits outside the chain.
# ---------------------------------------------------------------------------

eom:AdmPrelim a eom:AdmPhase ;
    rdfs:label "Preliminary" ;
    skos:notation "ADM-PRELIM" ;
    eom:precedes eom:AdmPhaseA ;
    eom:requiresArtifactKind eom:KindArchitecturePrinciples , eom:KindGovernanceModel .

eom:AdmPhaseA a eom:AdmPhase ;
    rdfs:label "Phase A" ;
    skos:notation "ADM-PHASE-A" ;
    eom:precedes eom:AdmPhaseB ;
    eom:requiresArtifactKind eom:KindArchitectureVision , eom:KindStakeholderMap .

eom:AdmPhaseB a eom:AdmPhase ;
    rdfs:label "Phase B" ;
    skos:notation "ADM-PHASE-B" ;
    eom:precedes eom:AdmPhaseC ;
    eom:requiresArtifactKind eom:KindBusinessArchitecture .

eom:AdmPhaseC a eom:AdmPhase ;
    rdfs:label "Phase C" ;
    skos:notation "ADM-PHASE-C" ;
    eom:precedes eom:AdmPhaseD ;
    eom:requiresArtifactKind eom:KindInformationSystemsArchitecture .

eom:AdmPhaseD a eom:AdmPhase ;
    rdfs:label "Phase D" ;
    skos:notation "ADM-PHASE-D" ;
    eom:precedes eom:AdmPhaseE ;
    eom:requiresArtifactKind eom:KindTechnologyArchitecture .

eom:AdmPhaseE a eom:AdmPhase ;
    rdfs:label "Phase E" ;
    skos:notation "ADM-PHASE-E" ;
    eom:precedes eom:AdmPhaseF ;
    eom:requiresArtifactKind eom:KindOpportunitiesAndSolutions .

eom:AdmPhaseF a eom:AdmPhase ;
    rdfs:label "Phase F" ;
    skos:notation "ADM-PHASE-F" ;
    eom:precedes eom:AdmPhaseG ;
    eom:requiresArtifactKind eom:KindMigrationPlan .

eom:AdmPhaseG a eom:AdmPhase ;
    rdfs:label "Phase G" ;
    skos:notation "ADM-PHASE-G" ;
    eom:precedes eom:AdmPhaseH ;
    eom:requiresArtifactKind eom:KindComplianceAssessment .

eom:AdmPhaseH a eom:AdmPhase ;
    rdfs:label "Phase H" ;
    skos:notation "ADM-PHASE-H" ;
    eom:requiresArtifactKind eom:KindChangeRecord .

eom:AdmReqMgmt a eom:AdmPhase ;
    rdfs:label "Requirements management" ;
    skos:notation "ADM-REQ-MGMT" ;
    rdfs:comment "Continuous: it has no predecessor and no successor in the chain." ;
    eom:requiresArtifactKind eom:KindRequirementsRegister .

# ---------------------------------------------------------------------------
# Properties
# ---------------------------------------------------------------------------

eom:levelCode a owl:DatatypeProperty ;
    rdfs:domain eom:Level ;
    rdfs:range xsd:string ;
    rdfs:comment "LOW or HIGH, as a plain literal. Used by generation queries." .

eom:integrationLevel a owl:ObjectProperty ;
    rdfs:range eom:Level ;
    rdfs:comment "Integration axis level of an operating model or a decision." .

eom:standardizationLevel a owl:ObjectProperty ;
    rdfs:range eom:Level ;
    rdfs:comment "Standardization axis level of an operating model or a decision." .

eom:stageOrdinal a owl:DatatypeProperty ;
    rdfs:domain eom:MaturityStage ;
    rdfs:range xsd:integer ;
    rdfs:comment "Position 1..4 of a maturity stage. Owned here: togaf-adm-pack orders stages by notation only." .

eom:precedes a owl:ObjectProperty ;
    rdfs:domain eom:AdmPhase ;
    rdfs:range eom:AdmPhase ;
    rdfs:comment "Immediate predecessor relation of the ADM chain. A cycle is refused by gate 060." .

eom:requiresArtifactKind a owl:ObjectProperty ;
    rdfs:domain eom:AdmPhase ;
    rdfs:range eom:ArtifactKind ;
    rdfs:comment "A kind of artifact an engagement must have produced before the phase can be ACHIEVED." .

eom:decisionKey a owl:DatatypeProperty ;
    rdfs:domain eom:OperatingModelDecision ;
    rdfs:range xsd:string ;
    rdfs:comment "Safe key (letters, digits, dot, underscore, hyphen) used to mint requirement identifiers. Checked by gate 010." .

eom:forStrategy a owl:ObjectProperty ;
    rdfs:domain eom:OperatingModelDecision ;
    rdfs:comment "The ea:Strategy the decision answers." .

eom:chosenModel a owl:ObjectProperty ;
    rdfs:domain eom:OperatingModelDecision ;
    rdfs:range eom:OperatingModel ;
    rdfs:comment "Exactly one operating model must be chosen." .

eom:hasFoundation a owl:ObjectProperty ;
    rdfs:domain eom:OperatingModelDecision ;
    rdfs:range eom:FoundationForExecution .

eom:hasEngagementModel a owl:ObjectProperty ;
    rdfs:domain eom:OperatingModelDecision ;
    rdfs:range eom:EngagementModel .

eom:atStage a owl:ObjectProperty ;
    rdfs:domain eom:OperatingModelDecision ;
    rdfs:range eom:MaturityStage ;
    rdfs:comment "The maturity stage the enterprise claims. Gate 040 requires receipted evidence for it and every lower stage." .

eom:targetClosure a owl:ObjectProperty ;
    rdfs:domain eom:OperatingModelDecision ;
    rdfs:comment "IRI of the ic:IndustryClosure that generated requirements join." .

eom:targetBaseIri a owl:DatatypeProperty ;
    rdfs:domain eom:OperatingModelDecision ;
    rdfs:range xsd:string ;
    rdfs:comment "Plain string equal to the target closure's ic:baseIri. Mints requirement and skeleton IRIs." .

eom:ofEnterprise a owl:ObjectProperty ;
    rdfs:comment "Names the enterprise a strategy, work package or capability belongs to. It is the jurisdiction marker: gates refuse only subjects that carry it (or an eom type)." .

eom:hasCoreProcess a owl:ObjectProperty ;
    rdfs:domain eom:FoundationForExecution ;
    rdfs:range eom:CoreBusinessProcess .

eom:hasSharedData a owl:ObjectProperty ;
    rdfs:domain eom:FoundationForExecution ;
    rdfs:range eom:SharedDataDomain .

eom:hasLinkingAutomation a owl:ObjectProperty ;
    rdfs:domain eom:FoundationForExecution ;
    rdfs:range eom:LinkingAutomation .

eom:hasModularComponent a owl:ObjectProperty ;
    rdfs:domain eom:FoundationForExecution ;
    rdfs:range eom:ModularComponent .

eom:elementKey a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "Safe key of a foundation element. Used to mint requirement identifiers. Checked by gate 020." .

eom:supportsCapability a owl:ObjectProperty ;
    rdfs:comment "Links a foundation element to the capability it supports. In a closure pipeline the capability must carry ic:capabilityKey." .

eom:standardVariant a owl:DatatypeProperty ;
    rdfs:domain eom:CoreBusinessProcess ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True when a single enterprise-wide variant of the process is used." .

eom:ownedBy a owl:ObjectProperty ;
    rdfs:domain eom:SharedDataDomain ;
    rdfs:comment "The org:Role that owns the data domain." .

eom:enterpriseScope a owl:DatatypeProperty ;
    rdfs:domain eom:SharedDataDomain ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True when the data domain is shared across the whole enterprise." .

eom:realizedByABB a owl:ObjectProperty ;
    rdfs:domain eom:LinkingAutomation ;
    rdfs:comment "The ea:ArchitectureBuildingBlock that realizes the linking automation." .

eom:forDecision a owl:ObjectProperty ;
    rdfs:domain eom:StageEvidence ;
    rdfs:range eom:OperatingModelDecision .

eom:forStage a owl:ObjectProperty ;
    rdfs:domain eom:StageEvidence ;
    rdfs:range eom:MaturityStage .

eom:receiptDigest a owl:DatatypeProperty ;
    rdfs:domain eom:StageEvidence ;
    rdfs:range xsd:string ;
    rdfs:comment "Plain literal of the form sha256:<64 lowercase hex>. A malformed digest does not count as evidence." .

eom:enterpriseGovernance a owl:ObjectProperty ;
    rdfs:domain eom:EngagementModel ;
    rdfs:comment "Enterprise-level mechanism. Must be a concept whose skos:notation starts with ENG- (join to togaf-adm-pack)." .

eom:projectGovernance a owl:ObjectProperty ;
    rdfs:domain eom:EngagementModel ;
    rdfs:comment "Project-level mechanism. Must be a concept whose skos:notation starts with ENG- (join to togaf-adm-pack)." .

eom:linkingMechanism a owl:ObjectProperty ;
    rdfs:domain eom:EngagementModel ;
    rdfs:comment "Mechanism that links project and enterprise levels. Must be a concept whose skos:notation starts with ENG- (join to togaf-adm-pack)." .

eom:reviewedBy a owl:ObjectProperty ;
    rdfs:comment "Architecture review of a togaf:WorkPackage in an enterprise." .

eom:dispensation a owl:ObjectProperty ;
    rdfs:range eom:Dispensation ;
    rdfs:comment "An owned, expiring exemption used instead of a review." .

eom:owner a owl:ObjectProperty ;
    rdfs:domain eom:Dispensation .

eom:expires a owl:DatatypeProperty ;
    rdfs:domain eom:Dispensation ;
    rdfs:comment "Expiry date of a dispensation. A dispensation without owner and expiry is refused." .

eom:hasStage a owl:ObjectProperty ;
    rdfs:domain eom:ValueStream ;
    rdfs:range eom:ValueStreamStage .

eom:enablesCapability a owl:ObjectProperty ;
    rdfs:domain eom:ValueStreamStage ;
    rdfs:comment "The capability this stage depends on. Anchors the capability to delivered value." .

eom:capabilityRole a owl:ObjectProperty ;
    rdfs:range eom:CapabilityRole ;
    rdfs:comment "Explicit exemption from value-stream anchoring." .

eom:ofEngagement a owl:ObjectProperty ;
    rdfs:domain eom:PhaseRecord ;
    rdfs:range eom:AdmEngagement .

eom:phase a owl:ObjectProperty ;
    rdfs:domain eom:PhaseRecord ;
    rdfs:range eom:AdmPhase .

eom:status a owl:DatatypeProperty ;
    rdfs:domain eom:PhaseRecord ;
    rdfs:range xsd:string ;
    rdfs:comment "One of the plain literals NOT_STARTED, IN_PROGRESS, ACHIEVED." .

eom:produced a owl:ObjectProperty ;
    rdfs:domain eom:PhaseRecord ;
    rdfs:range eom:Artifact .

eom:artifactKind a owl:ObjectProperty ;
    rdfs:domain eom:Artifact ;
    rdfs:range eom:ArtifactKind .

eom:reqMgmtReview a owl:ObjectProperty ;
    rdfs:domain eom:PhaseRecord ;
    rdfs:range eom:RequirementsReview .

eom:complianceCriterion a owl:ObjectProperty ;
    rdfs:range eom:ComplianceCriterion ;
    rdfs:comment "Emitted on contract skeletons by the skeleton template. Chosen from the axes, not from the model name." .

eom:authorityCeiling a owl:DatatypeProperty ;
    rdfs:comment "Plain literal NONE, OBSERVE, SELECT or CONSTRUCT. DO is not representable (gate 080)." .

eom:authorityClaim a owl:DatatypeProperty ;
    rdfs:comment "Plain literal. Generated artifacts claim NONE. DO is not representable (gate 080)." .
