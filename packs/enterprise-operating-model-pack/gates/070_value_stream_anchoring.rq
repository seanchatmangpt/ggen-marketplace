# MESSAGE: an enterprise capability sits in a value stream stage or is explicitly marked ENABLING; a value stream has at least one stage.
PREFIX eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#>
SELECT ?subject ?reason WHERE {
  { ?subject a eom:EnterpriseCapability .
    FILTER NOT EXISTS { ?st a eom:ValueStreamStage ; eom:enablesCapability ?subject }
    FILTER NOT EXISTS { ?subject eom:capabilityRole eom:ENABLING }
    BIND("REFUSED:EOM_CAPABILITY_FLOATING" AS ?reason) }
  UNION
  { ?subject a eom:ValueStream .
    FILTER NOT EXISTS { ?subject eom:hasStage ?s }
    BIND("REFUSED:EOM_VALUE_STREAM_EMPTY" AS ?reason) }
}
ORDER BY ?subject ?reason
