# FAIL witness for gates/080_authority_fence.rq: the pass world plus one violating individual per declared code.
# Synthetic witness: every IRI is under example.invalid and every digest is a synthetic stand-in.
# The pack ontology.ttl is loaded alongside this file by the court.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
@prefix togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#> .
@prefix ex: <https://example.invalid/enterprise-operating-model-pack/fail/> .

ex:decision-ceiling a eom:OperatingModelDecision ;
    eom:decisionKey "A1" ;
    eom:forStrategy ex:strategy ;
    eom:chosenModel eom:Unification ;
    eom:integrationLevel eom:HIGH ;
    eom:standardizationLevel eom:HIGH ;
    eom:targetClosure <https://example.invalid/closure/main> ;
    eom:targetBaseIri "https://example.invalid/closure/" ;
    dcterms:source "synthetic witness" ;
    eom:authorityCeiling "CONSTRUCT" ;
    eom:authorityClaim "NONE" .

ex:select-only a eom:AdmEngagement ;
    eom:authorityCeiling "SELECT" .

# --- violators: each IRI carries the code it must trigger ---

ex:VIOL_EOM_AUTHORITY_DO_FORBIDDEN a eom:AdmEngagement ;
    eom:authorityCeiling "DO" .

ex:VIOL_EOM_AUTHORITY_DO_FORBIDDEN_claim a eom:AdmEngagement ;
    eom:authorityClaim "do" .

ex:VIOL_EOM_AUTHORITY_DO_FORBIDDEN_grant a eom:AdmEngagement ;
    eom:grantsDoAuthority true .

ex:VIOL_EOM_AUTHORITY_CEILING_INVALID a eom:AdmEngagement ;
    eom:authorityCeiling "ROOT" .

# DO as an IRI value, as a class, and as a string-typed grant is refused as firmly as the literal forms.
ex:VIOL_EOM_AUTHORITY_DO_FORBIDDEN_iri a eom:AdmEngagement ;
    eom:authorityClaim eom:DO .

ex:VIOL_EOM_AUTHORITY_DO_FORBIDDEN_class a eom:AdmEngagement ;
    eom:authorityClass "DO" .

ex:VIOL_EOM_AUTHORITY_DO_FORBIDDEN_grant_string a eom:AdmEngagement ;
    eom:grantsDoAuthority "true" .
