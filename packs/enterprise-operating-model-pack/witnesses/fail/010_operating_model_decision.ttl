# A strategy a decision answers must name its enterprise; omitting eom:ofEnterprise does not switch the gate off.
ex:VIOL_EOM_STRATEGY_NO_ENTERPRISE a ea:Strategy .

ex:decision-noenterprise a eom:OperatingModelDecision ;
    eom:decisionKey "D-NOENT" ;
    eom:forStrategy ex:VIOL_EOM_STRATEGY_NO_ENTERPRISE ;
