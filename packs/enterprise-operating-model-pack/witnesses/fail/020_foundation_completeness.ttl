# FAIL witness for gates/020_foundation_completeness.rq: the pass world plus one violating individual per declared code.
# Synthetic witness: every IRI is under example.invalid and every digest is a synthetic stand-in.
# The pack ontology.ttl is loaded alongside this file by the court.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
@prefix togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#> .
@prefix ex: <https://example.invalid/enterprise-operating-model-pack/fail/> .

ex:strategy a ea:Strategy ;
    eom:ofEnterprise ex:enterprise .

ex:data-owner-role a org:Role .

ex:decision-main a eom:OperatingModelDecision ;
    eom:decisionKey "D1" ;
    eom:forStrategy ex:strategy ;
    eom:chosenModel eom:Unification ;
    eom:integrationLevel eom:HIGH ;
    eom:standardizationLevel eom:HIGH ;
    eom:hasFoundation ex:ok-foundation ;
    eom:targetClosure <https://example.invalid/closure/main> ;
    eom:targetBaseIri "https://example.invalid/closure/" ;
    dcterms:source "synthetic witness" .

ex:ok-proc a eom:CoreBusinessProcess ;
    eom:elementKey "ok-proc" ;
    eom:supportsCapability ex:ok-proc-cap ;
    eom:standardVariant true .

ex:ok-proc-cap a ea:Capability ;
    ic:capabilityKey "CAP-OK-PROC-CAP" ;
    eom:ofEnterprise ex:enterprise .

ex:ok-data a eom:SharedDataDomain ;
    eom:elementKey "ok-data" ;
    eom:supportsCapability ex:ok-data-cap ;
    eom:ownedBy ex:data-owner-role ;
    eom:enterpriseScope true .

ex:ok-data-cap a ea:Capability ;
    ic:capabilityKey "CAP-OK-DATA-CAP" ;
    eom:ofEnterprise ex:enterprise .

ex:ok-link a eom:LinkingAutomation ;
    eom:elementKey "ok-link" ;
    eom:supportsCapability ex:ok-link-cap ;
    eom:realizedByABB ex:ok-link-abb .

ex:ok-link-cap a ea:Capability ;
    ic:capabilityKey "CAP-OK-LINK-CAP" ;
    eom:ofEnterprise ex:enterprise .

ex:ok-link-abb a ea:ArchitectureBuildingBlock .

ex:ok-foundation a eom:FoundationForExecution ;
    eom:hasCoreProcess ex:ok-proc ;
    eom:hasSharedData ex:ok-data ;
    eom:hasLinkingAutomation ex:ok-link .

