# FAIL witness for gates/060_adm_phase_gate.rq: the pass world plus one violating individual per declared code.
# Synthetic witness: every IRI is under example.invalid and every digest is a synthetic stand-in.
# The pack ontology.ttl is loaded alongside this file by the court.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
@prefix togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#> .
@prefix ex: <https://example.invalid/enterprise-operating-model-pack/fail/> .

ex:run-ok a eom:AdmEngagement .

ex:review-ok a eom:RequirementsReview .

ex:ok-principles a eom:Artifact ;
    eom:artifactKind eom:KindArchitecturePrinciples .

ex:ok-governance a eom:Artifact ;
    eom:artifactKind eom:KindGovernanceModel .

ex:ok-vision a eom:Artifact ;
    eom:artifactKind eom:KindArchitectureVision .

ex:ok-stakeholders a eom:Artifact ;
    eom:artifactKind eom:KindStakeholderMap .

ex:ok-requirements a eom:Artifact ;
    eom:artifactKind eom:KindRequirementsRegister .

ex:rec-prelim a eom:PhaseRecord ;
    eom:phase eom:AdmPrelim ;
    eom:ofEngagement ex:run-ok ;
    eom:status "ACHIEVED" ;
    eom:produced ex:ok-principles ;
    eom:produced ex:ok-governance ;
    eom:reqMgmtReview ex:review-ok .

ex:rec-a a eom:PhaseRecord ;
    eom:phase eom:AdmPhaseA ;
    eom:ofEngagement ex:run-ok ;
    eom:status "ACHIEVED" ;
    eom:produced ex:ok-vision ;
    eom:produced ex:ok-stakeholders ;
    eom:reqMgmtReview ex:review-ok .

ex:rec-b a eom:PhaseRecord ;
    eom:phase eom:AdmPhaseB ;
    eom:ofEngagement ex:run-ok ;
    eom:status "IN_PROGRESS" .

ex:rec-c a eom:PhaseRecord ;
    eom:phase eom:AdmPhaseC ;
    eom:ofEngagement ex:run-ok ;
    eom:status "NOT_STARTED" .

ex:rec-reqmgmt a eom:PhaseRecord ;
    eom:phase eom:AdmReqMgmt ;
    eom:ofEngagement ex:run-ok ;
    eom:status "ACHIEVED" ;
    eom:produced ex:ok-requirements .

# --- violators: each IRI carries the code it must trigger ---

ex:VIOL_EOM_ADM_CYCLE a eom:AdmPhase ;
    eom:precedes ex:VIOL_cycle-b .

ex:VIOL_cycle-b a eom:AdmPhase ;
    eom:precedes ex:VIOL_EOM_ADM_CYCLE .

ex:VIOL_run-art a eom:AdmEngagement .

ex:VIOL_art-principles a eom:Artifact ;
    eom:artifactKind eom:KindArchitecturePrinciples .

ex:VIOL_EOM_ADM_ARTIFACT_MISSING a eom:PhaseRecord ;
    eom:phase eom:AdmPrelim ;
    eom:ofEngagement ex:VIOL_run-art ;
    eom:status "ACHIEVED" ;
    eom:produced ex:VIOL_art-principles ;
    eom:reqMgmtReview ex:review-ok .

ex:VIOL_run-pre a eom:AdmEngagement .

ex:VIOL_pre-vision a eom:Artifact ;
    eom:artifactKind eom:KindArchitectureVision .

ex:VIOL_pre-stakeholders a eom:Artifact ;
    eom:artifactKind eom:KindStakeholderMap .

ex:VIOL_pre-prelim a eom:PhaseRecord ;
    eom:phase eom:AdmPrelim ;
    eom:ofEngagement ex:VIOL_run-pre ;
    eom:status "IN_PROGRESS" .

ex:VIOL_EOM_ADM_PREDECESSOR_NOT_ACHIEVED a eom:PhaseRecord ;
    eom:phase eom:AdmPhaseA ;
    eom:ofEngagement ex:VIOL_run-pre ;
    eom:status "ACHIEVED" ;
    eom:produced ex:VIOL_pre-vision ;
    eom:produced ex:VIOL_pre-stakeholders ;
    eom:reqMgmtReview ex:review-ok .

ex:VIOL_run-rm a eom:AdmEngagement .

ex:VIOL_rm-principles a eom:Artifact ;
    eom:artifactKind eom:KindArchitecturePrinciples .

ex:VIOL_rm-governance a eom:Artifact ;
    eom:artifactKind eom:KindGovernanceModel .

ex:VIOL_EOM_ADM_REQMGMT_MISSING a eom:PhaseRecord ;
    eom:phase eom:AdmPrelim ;
    eom:ofEngagement ex:VIOL_run-rm ;
    eom:status "ACHIEVED" ;
    eom:produced ex:VIOL_rm-principles ;
    eom:produced ex:VIOL_rm-governance .

ex:VIOL_EOM_ADM_STATUS_INVALID a eom:PhaseRecord ;
    eom:phase eom:AdmPhaseB ;
    eom:ofEngagement ex:run-ok ;
    eom:status "DONE" .

ex:VIOL_EOM_ADM_RECORD_MALFORMED a eom:PhaseRecord ;
    eom:ofEngagement ex:run-ok ;
    eom:status "IN_PROGRESS" .

ex:VIOL_EOM_ADM_RECORD_MALFORMED_no_engagement a eom:PhaseRecord ;
    eom:phase eom:AdmPhaseB ;
    eom:status "IN_PROGRESS" .

# A phase without a skos:notation does not switch the requirements-management check off.
ex:VIOL_phase-no-notation a eom:AdmPhase .

ex:VIOL_run-nn a eom:AdmEngagement .

ex:VIOL_EOM_ADM_REQMGMT_MISSING_no_notation a eom:PhaseRecord ;
    eom:phase ex:VIOL_phase-no-notation ;
    eom:ofEngagement ex:VIOL_run-nn ;
    eom:status "ACHIEVED" .
