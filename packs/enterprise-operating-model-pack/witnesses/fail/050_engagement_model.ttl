# FAIL witness for gates/050_engagement_model.rq: the pass world plus one violating individual per declared code.
# Synthetic witness: every IRI is under example.invalid and every digest is a synthetic stand-in.
# The pack ontology.ttl is loaded alongside this file by the court.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
@prefix togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#> .
@prefix ex: <https://example.invalid/enterprise-operating-model-pack/fail/> .

ex:mech-arb a skos:Concept ;
    skos:notation "ENG-ARCH-REVIEW-BOARD" .

ex:mech-funding a skos:Concept ;
    skos:notation "ENG-PROJECT-FUNDING-GATE" .

ex:mech-compliance a skos:Concept ;
    skos:notation "ENG-COMPLIANCE-REVIEW" .

ex:engagement-ok a eom:EngagementModel ;
    eom:enterpriseGovernance ex:mech-arb ;
    eom:projectGovernance ex:mech-funding ;
    eom:linkingMechanism ex:mech-compliance .

ex:decision-ok a eom:OperatingModelDecision ;
    eom:decisionKey "E1" ;
    eom:forStrategy ex:strategy ;
    eom:chosenModel eom:Unification ;
    eom:integrationLevel eom:HIGH ;
    eom:standardizationLevel eom:HIGH ;
    eom:hasEngagementModel ex:engagement-ok ;
    eom:targetClosure <https://example.invalid/closure/main> ;
    eom:targetBaseIri "https://example.invalid/closure/" ;
    dcterms:source "synthetic witness" .

ex:wp-reviewed a togaf:WorkPackage ;
    eom:ofEnterprise ex:enterprise ;
    eom:reviewedBy ex:review-board .

ex:disp-ok a eom:Dispensation ;
    eom:owner ex:owner-person ;
    eom:expires "2030-01-01"^^xsd:date .

ex:wp-dispensed a togaf:WorkPackage ;
    eom:ofEnterprise ex:enterprise ;
    eom:dispensation ex:disp-ok .

ex:foreign-wp a togaf:WorkPackage .

# --- violators: each IRI carries the code it must trigger ---

ex:VIOL_EOM_ENGAGEMENT_NO_ENTERPRISE_LEVEL a eom:EngagementModel ;
    eom:projectGovernance ex:mech-funding ;
    eom:linkingMechanism ex:mech-compliance .

ex:VIOL_EOM_ENGAGEMENT_NO_PROJECT_LEVEL a eom:EngagementModel ;
    eom:enterpriseGovernance ex:mech-arb ;
    eom:linkingMechanism ex:mech-compliance .

ex:VIOL_EOM_ENGAGEMENT_NO_LINKING a eom:EngagementModel ;
    eom:enterpriseGovernance ex:mech-arb ;
    eom:projectGovernance ex:mech-funding .

ex:VIOL_bad-notation a skos:Concept ;
    skos:notation "XYZ-1" .

ex:VIOL_EOM_ENGAGEMENT_MECHANISM_UNKNOWN a eom:EngagementModel ;
    eom:enterpriseGovernance ex:VIOL_bad-notation ;
    eom:projectGovernance ex:mech-funding ;
    eom:linkingMechanism ex:mech-compliance .

ex:VIOL_no-notation a skos:Concept .

ex:VIOL_EOM_ENGAGEMENT_MECHANISM_UNKNOWN_no_notation a eom:EngagementModel ;
    eom:enterpriseGovernance ex:mech-arb ;
    eom:projectGovernance ex:VIOL_no-notation ;
    eom:linkingMechanism ex:mech-compliance .

ex:VIOL_EOM_DECISION_NO_ENGAGEMENT a eom:OperatingModelDecision ;
    eom:decisionKey "E2" ;
    eom:forStrategy ex:strategy ;
    eom:chosenModel eom:Unification ;
    eom:integrationLevel eom:HIGH ;
    eom:standardizationLevel eom:HIGH ;
    eom:targetClosure <https://example.invalid/closure/main> ;
    eom:targetBaseIri "https://example.invalid/closure/" ;
    dcterms:source "synthetic witness" .

ex:VIOL_EOM_WORKPACKAGE_UNREVIEWED a togaf:WorkPackage ;
    eom:ofEnterprise ex:enterprise .

ex:VIOL_EOM_DISPENSATION_UNBOUNDED a eom:Dispensation ;
    eom:owner ex:owner-person .

ex:VIOL_EOM_DISPENSATION_UNBOUNDED_no_owner a eom:Dispensation ;
    eom:expires "2030-01-01"^^xsd:date .

# A dangling or untyped dispensation target does not exempt a work package from review.
ex:VIOL_EOM_WORKPACKAGE_UNREVIEWED_untyped_dispensation a togaf:WorkPackage ;
    eom:ofEnterprise ex:enterprise ;
    eom:dispensation ex:nothing-typed-here .
