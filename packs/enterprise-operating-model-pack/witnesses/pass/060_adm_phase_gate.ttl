# PASS witness for gates/060_adm_phase_gate.rq: phase records respect order, artifacts and requirements review. Zero rows expected.
# Synthetic witness: every IRI is under example.invalid and every digest is a synthetic stand-in.
# The pack ontology.ttl is loaded alongside this file by the court.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix eom: <https://seanchatmangpt.github.io/packs/enterprise-operating-model-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
@prefix togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#> .
@prefix ex: <https://example.invalid/enterprise-operating-model-pack/pass/> .

ex:run-ok a eom:AdmEngagement .

ex:review-ok a eom:RequirementsReview .

ex:ok-principles a eom:Artifact ;
    eom:artifactKind eom:KindArchitecturePrinciples .

ex:ok-governance a eom:Artifact ;
    eom:artifactKind eom:KindGovernanceModel .

ex:ok-vision a eom:Artifact ;
    eom:artifactKind eom:KindArchitectureVision .

ex:ok-stakeholders a eom:Artifact ;
    eom:artifactKind eom:KindStakeholderMap .

ex:ok-requirements a eom:Artifact ;
    eom:artifactKind eom:KindRequirementsRegister .

ex:rec-prelim a eom:PhaseRecord ;
    eom:phase eom:AdmPrelim ;
    eom:ofEngagement ex:run-ok ;
    eom:status "ACHIEVED" ;
    eom:produced ex:ok-principles ;
    eom:produced ex:ok-governance ;
    eom:reqMgmtReview ex:review-ok .

ex:rec-a a eom:PhaseRecord ;
    eom:phase eom:AdmPhaseA ;
    eom:ofEngagement ex:run-ok ;
    eom:status "ACHIEVED" ;
    eom:produced ex:ok-vision ;
    eom:produced ex:ok-stakeholders ;
    eom:reqMgmtReview ex:review-ok .

ex:rec-b a eom:PhaseRecord ;
    eom:phase eom:AdmPhaseB ;
    eom:ofEngagement ex:run-ok ;
    eom:status "IN_PROGRESS" .

ex:rec-c a eom:PhaseRecord ;
    eom:phase eom:AdmPhaseC ;
    eom:ofEngagement ex:run-ok ;
    eom:status "NOT_STARTED" .

ex:rec-reqmgmt a eom:PhaseRecord ;
    eom:phase eom:AdmReqMgmt ;
    eom:ofEngagement ex:run-ok ;
    eom:status "ACHIEVED" ;
    eom:produced ex:ok-requirements .

