    eom:supportsCapability ex:uni-data-cap ;
    eom:ownedBy ex:data-owner-role ;
    eom:enterpriseScope true .

ex:uni-data-cap a ea:Capability ;
    ic:capabilityKey "CAP-UNI-DATA-CAP" ;
    eom:ofEnterprise ex:enterprise .

ex:uni-decision a eom:OperatingModelDecision ;
    eom:decisionKey "U1" ;
    eom:forStrategy ex:strategy ;
    eom:chosenModel eom:Unification ;
    eom:integrationLevel eom:HIGH ;
    eom:standardizationLevel eom:HIGH ;
    eom:hasFoundation ex:uni-foundation ;
    eom:targetClosure <https://example.invalid/closure/main> ;
    eom:targetBaseIri "https://example.invalid/closure/" ;
    dcterms:source "synthetic witness" .

ex:uni-foundation a eom:FoundationForExecution ;
    eom:hasCoreProcess ex:uni-proc ;
    eom:hasSharedData ex:uni-data .

