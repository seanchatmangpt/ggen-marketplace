@prefix ex: <https://example.invalid/enterprise-operating-model-pack/pass/> .

ex:data-owner-role a org:Role .

ex:uni-proc a eom:CoreBusinessProcess ;
    eom:elementKey "uni-proc" ;
    eom:supportsCapability ex:uni-proc-cap ;
    eom:standardVariant true .

ex:uni-proc-cap a ea:Capability ;
    ic:capabilityKey "CAP-UNI-PROC-CAP" ;
    eom:ofEnterprise ex:enterprise .

