# MESSAGE: every FastAPIProjection must carry exact projection metadata.
PREFIX sfa: <https://ggen.dev/packs/shacl-to-fastapi#>
PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#>
SELECT ?projection ?missing WHERE {
  ?projection a sfa:FastAPIProjection .
  VALUES ?missing {
    sp:derivedFromShape
    sfa:moduleName
    sfa:routerVar
    sfa:routePath
    sfa:httpMethod
    sfa:operationId
    sfa:requestModelName
    sfa:responseModelName
    sfa:consequential
    sfa:requiresAuthority
  }
  FILTER NOT EXISTS { ?projection ?missing ?value }
}
ORDER BY ?projection ?missing
