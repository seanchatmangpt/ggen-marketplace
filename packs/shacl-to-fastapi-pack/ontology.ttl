@prefix sfa: <https://ggen.dev/packs/shacl-to-fastapi#> .
@prefix sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sfa:FastAPIProjection a rdfs:Class ;
    rdfs:comment "A generated HTTP projection over an admitted SHACL shape. It does not redefine domain semantics." .

sfa:moduleName a rdf:Property ; rdfs:domain sfa:FastAPIProjection ; rdfs:range xsd:string .
sfa:routerVar a rdf:Property ; rdfs:domain sfa:FastAPIProjection ; rdfs:range xsd:string .
sfa:routePath a rdf:Property ; rdfs:domain sfa:FastAPIProjection ; rdfs:range xsd:string .
sfa:httpMethod a rdf:Property ; rdfs:domain sfa:FastAPIProjection ; rdfs:range xsd:string .
sfa:operationId a rdf:Property ; rdfs:domain sfa:FastAPIProjection ; rdfs:range xsd:string .
sfa:requestModelName a rdf:Property ; rdfs:domain sfa:FastAPIProjection ; rdfs:range xsd:string .
sfa:responseModelName a rdf:Property ; rdfs:domain sfa:FastAPIProjection ; rdfs:range xsd:string .
sfa:consequential a rdf:Property ; rdfs:domain sfa:FastAPIProjection ; rdfs:range xsd:boolean .
sfa:requiresAuthority a rdf:Property ; rdfs:domain sfa:FastAPIProjection ; rdfs:range xsd:boolean .

# sp:derivedFromShape is intentionally reused, not redeclared here.
