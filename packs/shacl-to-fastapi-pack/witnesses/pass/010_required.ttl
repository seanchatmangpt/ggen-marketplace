@prefix sfa: <https://ggen.dev/packs/shacl-to-fastapi#> .
@prefix sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> .
@prefix wd: <https://ggen.dev/wd-fa/example#> .
sfa:Good a sfa:FastAPIProjection ;
  sp:derivedFromShape wd:Shape ;
  sfa:moduleName "wd_fa_api" ;
  sfa:routerVar "router" ;
  sfa:routePath "/cases" ;
  sfa:httpMethod "POST" ;
  sfa:operationId "create_failure_case" ;
  sfa:requestModelName "FailureCaseRequest" ;
  sfa:responseModelName "FailureCaseResponse" ;
  sfa:consequential false ;
  sfa:requiresAuthority false .
