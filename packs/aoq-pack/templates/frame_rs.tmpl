#[cfg(test)]
mod tests {
    use super::*;

    /// Build a minimal header-shaped buffer with the magic planted at 0x00.
    fn header_buf() -> [u8; AOQ1_SIZE_BYTES] {
        let mut b = [0u8; AOQ1_SIZE_BYTES];
        b[AOQ1_MAGIC_OFFSET..AOQ1_MAGIC_OFFSET + 4].copy_from_slice(&AOQ1_MAGIC.to_le_bytes());
        b[AOQ1_VERSION_OFFSET..AOQ1_VERSION_OFFSET + 2].copy_from_slice(&AOQ1_VERSION.to_le_bytes());
        b
    }

    #[test]
    fn accessors_read_ontology_offsets() {
        let b = header_buf();
        assert_eq!(aoq1_magic(&b), Some(AOQ1_MAGIC));
        assert_eq!(aoq1_version(&b), Some(AOQ1_VERSION));
        assert_eq!(aoq1_epoch(&b), Some(0));
        assert_eq!(aoq1_key_id(&b), Some(0));
        assert_eq!(aoq1_frame_ordinal(&b), Some(0));
        assert_eq!(aoq1_seq(&b), Some(0));
        assert_eq!(aoq1_header_digest(&b), Some(0));
    }

    #[test]
    fn short_buffer_is_typed_refusal() {
        let b = [0u8; AOQ1_SIZE_BYTES - 1];
        assert_eq!(aoq1_magic(&b), None);
        assert_eq!(aoq1_key_id(&b), None);
    }

    #[test]
    fn offsets_match_aoq02_field_table() {
        assert_eq!(AOQ1_MAGIC_OFFSET, 0x00);
        assert_eq!(AOQ1_VERSION_OFFSET, 0x04);
        assert_eq!(AOQ1_EPOCH_OFFSET, 0x06);
        assert_eq!(AOQ1_KEY_ID_OFFSET, 0x08);
        assert_eq!(AOQ1_FRAME_ORDINAL_OFFSET, 0x10);
        assert_eq!(AOQ1_SEQ_OFFSET, 0x14);
        assert_eq!(AOQ1_RESERVED_OFFSET, 0x18);
        assert_eq!(AOQ1_HEADER_DIGEST_OFFSET, 0x3C);
        assert_eq!(AOQ1_SIZE_BYTES, 64);
    }
}
