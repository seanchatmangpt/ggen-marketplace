---
to: crates/cgap-ffi/src/aoq/frame.rs
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/aoq-pack
sparql:
  header: >
    PREFIX aoq: <urn:aoq:>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?sizeBytes ?rustName WHERE {
      ?h a aoq:Header ;
         aoq:sizeBytes ?sizeBytes ;
         aoq:rustName ?rustName .
    } ORDER BY ?rustName
  fields: >
    PREFIX aoq: <urn:aoq:>
    SELECT ?off ?size ?kind ?rust ?c ?go WHERE {
      ?f a aoq:HeaderField ;
         aoq:offset ?off ;
         aoq:sizeBytes ?size ;
         aoq:wireKind ?kind ;
         aoq:rustName ?rust ;
         aoq:cName ?c ;
         aoq:goName ?go ;
         aoq:fieldOf ?h .
    } ORDER BY ?off
---
