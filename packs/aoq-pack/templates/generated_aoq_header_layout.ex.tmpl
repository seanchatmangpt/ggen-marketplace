---
to: lib/smalt/aoq/generated_aoq_header_layout.ex
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/aoq-pack
sparql:
  header: >
    PREFIX aoq: <urn:aoq:>
    SELECT ?sizeBytes WHERE {
      aoq:header-aq1 a aoq:Header ;
         aoq:sizeBytes ?sizeBytes .
    }
  fields: >
    PREFIX aoq: <urn:aoq:>
    SELECT ?off ?size ?kind ?rust WHERE {
      ?f a aoq:HeaderField ;
         aoq:offset ?off ;
         aoq:sizeBytes ?size ;
         aoq:wireKind ?kind ;
         aoq:rustName ?rust ;
         aoq:fieldOf aoq:header-aq1 .
    } ORDER BY ?off
---
# Code generated by ggen from packs/aoq-pack/ontology.ttl. DO NOT EDIT.
#
defmodule Smalt.Aoq.GeneratedAoqHeaderLayout do
  @moduledoc """
  AOQ1 header layout projection: one entry per `aoq:HeaderField`,
  ORDER BY aoq:offset, projected from the landed graph
  `ggen-marketplace/packs/aoq-pack/ontology.ttl` (R-1 ruling: 64-byte
  envelope, little-endian, FNV-1a32 digest over bytes `[0x00,0x3C)`
  stored at `0x3C`).

  This module is the machine-readable twin of the graph — the Elixir
  counterpart of cgap-aoq's `generated_aoq_header_layout.rs`. The drift
  court (`test/courts/aoq_layout_drift_court.exs`) parses the landed
  ontology TTL and asserts field-by-field equality with
  `header_fields/0`; anti-vacuity legs mutate a TTL copy and demand a
  RED. Never hand-edit: regenerate after any ontology offset change.
  """

  @size_bytes {{ header.0.sizeBytes }}
  @magic 0x414F_5131
  @version 1
  @digest_span_start 0x00
  @digest_span_end 0x3C

  @raw_fields [
{%- for f in fields %}
    %{rust_name: "{{ f.rust }}", offset: {{ f.off }}, size_bytes: {{ f.size }}, wire_kind: :{{ f.kind | replace(from="-", to="_") }}}{% if not loop.last %},{% endif %}
{%- endfor %}
  ]

  # Compile-time contiguity court: first field at offset 0, every field
  # abuts the next, last field ends exactly at byte 64 — mirroring the
  # const-assert chain in generated_aoq_header_layout.rs. A graph drift
  # refuses the BUILD, not the runtime.
  @contiguity_ok (
                   first = hd(@raw_fields)
                   last = List.last(@raw_fields)

                   chained =
                     @raw_fields
                     |> Enum.chunk_every(2, 1, :discard)
                     |> Enum.all?(fn [a, b] -> a.offset + a.size_bytes == b.offset end)

                   unless first.offset == 0 and chained and
                            last.offset + last.size_bytes == @size_bytes do
                     raise ArgumentError,
                           "AOQ1 layout drift: field table is not contiguous to byte 64"
                   end

                   true
                 )

  @doc "AOQ1 header size in bytes (`aoq:header-aq1 aoq:sizeBytes 64`)."
  @spec size_bytes() :: 64
  def size_bytes, do: @size_bytes

  @doc "Wire magic constant, `0x414F5131` — little-endian bytes `\"1QOA\"`."
  @spec magic() :: 0x414F5131
  def magic, do: @magic

  @doc "Header version this projection speaks (`aoq:hf-version aoq:value 1`)."
  @spec version() :: 1
  def version, do: @version

  @doc "Digest coverage is the half-open span `[0x00,0x3C)`; digest at `0x3C`."
  @spec digest_span() :: {0, 60}
  def digest_span, do: {@digest_span_start, @digest_span_end}

  @doc """
  The landed field table, ORDER BY aoq:offset — one map per
  `aoq:HeaderField` individual (`rust_name` from `aoq:rustName`,
  `offset` from `aoq:offset`, `size_bytes` from `aoq:sizeBytes`,
  `wire_kind` from `aoq:wireKind`).
  """
  @spec header_fields() :: [
          %{required(:rust_name) => String.t(), required(:offset) => non_neg_integer(),
            required(:size_bytes) => pos_integer(), required(:wire_kind) => atom()}
        ]
  def header_fields do
    unless @contiguity_ok, do: raise("unreachable")
    @raw_fields
  end

  @doc "Compile-time layout law, re-exposed for courts (always `true`)."
  @spec contiguity_verified?() :: boolean()
  def contiguity_verified?, do: @contiguity_ok
end
