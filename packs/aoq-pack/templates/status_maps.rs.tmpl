#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn band_is_closed_both_directions() {
        assert_eq!(AOQ_STATUS_COUNT, {{ constants | length }});
        {%- for c in constants %}
        assert_eq!(aoq_status_name(AOQ_STATUS_{{ c.label }}), Some("{{ c.label }}"));
        assert_eq!(aoq_status_word("{{ c.label }}"), Some({{ c.hex }}));
