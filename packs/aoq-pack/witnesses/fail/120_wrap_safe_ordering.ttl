@prefix aoq: <urn:aoq:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix w: <urn:aoq:witness:fail/> .

# FAIL witness for 120_wrap_safe_ordering: MUTATION = ordering law w:lawBad
# pins compareLaw "direct-lt" (the refused a < b compare that inverts after
# u64 wrap). Gate 120 must return >=1 row.

w:src a prov:Entity .

w:lawGood a aoq:OrderingLaw ; rdfs:label "per-partition total order" ;
    aoq:orderScope "per-partition-total" ;
    aoq:compareLaw "subtraction-mod-half" .

w:lawBad a aoq:OrderingLaw ; rdfs:label "wrapped naive compare (REFUSED)" ;
    aoq:orderScope "per-partition-total" ;
    aoq:compareLaw "direct-lt" .
