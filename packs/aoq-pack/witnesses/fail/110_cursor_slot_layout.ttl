@prefix aoq: <urn:aoq:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix w: <urn:aoq:witness:fail/> .

# FAIL witness for 110_cursor_slot_layout: MUTATION = slot w:slot6 ("seq2",
# outside the closed name set) with an index but NO aoq:writerOp — breaks the
# single-writer-per-index law. Gate 110 must return >=1 row.

w:src a prov:Entity .

w:slot0 a aoq:CursorSlot ; rdfs:label "ring_head" ;
    aoq:slotIndex 0 ; aoq:slotName "ring_head" ; aoq:writerOp "add_get" ;
    prov:wasDerivedFrom w:src .

w:slot6 a aoq:CursorSlot ; rdfs:label "seq2" ;
    aoq:slotIndex 6 ; aoq:slotName "seq2" ;
    prov:wasDerivedFrom w:src .
