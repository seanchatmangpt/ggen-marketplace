@prefix aoq: <urn:aoq:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix w: <urn:aoq:witness:fail/> .

# FAIL witness for 100_partition_stream_binding: MUTATION = binding w:psBad
# carries TWO aoq:ringOf edges (one partition backed by two rings breaks the
# 1:1:1 mapping law). Gate 100 must return >=1 row.

w:src a prov:Entity .

w:law a aoq:OrderingLaw ; rdfs:label "per-partition total order" ;
    aoq:orderScope "per-partition-total" ;
    aoq:compareLaw "subtraction-mod-half" .

w:ring0 a aoq:Ring ; rdfs:label "ring 0" .
w:ring1 a aoq:Ring ; rdfs:label "ring 1" .
w:s0 a aoq:WireStream ; rdfs:label "stream 0" ; aoq:streamId "stream:0" .

w:ps0 a aoq:PartitionStream ; rdfs:label "t/p0" ;
    aoq:topic "aoq-default" ; aoq:partitionIndex 0 ;
    aoq:ringOf w:ring0 ; aoq:streamOf w:s0 ;
    aoq:lawOf w:law ;
    prov:wasDerivedFrom w:src .

w:psBad a aoq:PartitionStream ; rdfs:label "t/p1 (two rings — REFUSED)" ;
    aoq:topic "aoq-default" ; aoq:partitionIndex 1 ;
    aoq:ringOf w:ring0 , w:ring1 ;
    aoq:streamOf w:s0 ;
    aoq:lawOf w:law ;
    prov:wasDerivedFrom w:src .
