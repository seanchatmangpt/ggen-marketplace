@prefix aoq: <urn:aoq:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix w: <urn:aoq:witness:fail/> .

# FAIL witness for 020_status_band: MUTATION = out-of-band constant
# w:st9 with value 0x4347A00A (outside the extended frozen band A001..A009).
# Gate 020 must return >=1 row.

w:src a prov:Entity .

w:hdr a aoq:Header ;
    rdfs:label "AOQ1 header (64 bytes)" ;
    aoq:sizeBytes 64 ;
    prov:wasDerivedFrom w:src .

w:f0 a aoq:HeaderField ; rdfs:label "magic" ;
    aoq:offset 0 ; aoq:sizeBytes 4 ; aoq:wireKind "u32" ;
    aoq:cName "magic" ; aoq:rustName "MAGIC" ; aoq:goName "Magic" ;
    aoq:value "0x414F5131" ;
    aoq:nextOffset w:f1 ; aoq:fieldOf w:hdr ;
    prov:wasDerivedFrom w:src .

w:f1 a aoq:HeaderField ; rdfs:label "version" ;
    aoq:offset 4 ; aoq:sizeBytes 2 ; aoq:wireKind "u16" ;
    aoq:cName "version" ; aoq:rustName "VERSION" ; aoq:goName "Version" ;
    aoq:value 2 ;
    aoq:nextOffset w:f2 ; aoq:fieldOf w:hdr ;
    prov:wasDerivedFrom w:src .

w:f2 a aoq:HeaderField ; rdfs:label "reserved" ;
    aoq:offset 6 ; aoq:sizeBytes 58 ; aoq:wireKind "reserved-zero" ;
    aoq:cName "reserved" ; aoq:rustName "RESERVED" ; aoq:goName "Reserved" ;
    aoq:fieldOf w:hdr ;
    prov:wasDerivedFrom w:src .

w:st a aoq:StatusConstant ; rdfs:label "OK" ;
    aoq:constantId "FM-AOQ-001" ; aoq:value "0x4347A001" ;
    prov:wasDerivedFrom w:src .

w:st9 a aoq:StatusConstant ; rdfs:label "SMUGGLED" ;
    aoq:constantId "FM-AOQ-010" ; aoq:value "0x4347A00A" ;
    prov:wasDerivedFrom w:src .

w:kem a aoq:KemParam ; rdfs:label "ML-KEM-768" ;
    aoq:seam "hand-law" ; aoq:status "blocked" ;
    prov:wasDerivedFrom w:src .

w:epoch a aoq:Epoch ; rdfs:label "GENESIS" ; aoq:value 0 ;
    prov:wasDerivedFrom w:src .

w:stream a aoq:StreamType ; rdfs:label "DATA" ; aoq:value 0 ;
    prov:wasDerivedFrom w:src .

w:frame a aoq:Frame ; rdfs:label "AOQ default frame" ;
    aoq:header w:hdr ; aoq:streamType w:stream ; aoq:epoch w:epoch ;
    aoq:statusWord "0x4347A001" ;
    prov:wasDerivedFrom w:src .
