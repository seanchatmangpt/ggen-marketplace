@prefix aoq: <urn:aoq:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix w: <urn:aoq:witness:fail/> .

# Per-header FAIL witness (FNOX-SJ-AOQF-2): AOQ1 header clean; MUTATION = the
# intent header declares sizeBytes 20 instead of 16. Gate 090 must return >=1 row.

w:hdr a aoq:Header ; aoq:sizeBytes 64 ; aoq:cName "aoq1_header_t" .
w:f0 a aoq:HeaderField ; aoq:offset 0 ; aoq:sizeBytes 4 ; aoq:wireKind "u32" ;
    aoq:cName "magic" ; aoq:rustName "MAGIC" ; aoq:goName "Magic" ;
    aoq:value "0x414F5131" ; aoq:nextOffset w:f1 ; aoq:fieldOf w:hdr .
w:f1 a aoq:HeaderField ; aoq:offset 4 ; aoq:sizeBytes 2 ; aoq:wireKind "u16" ;
    aoq:cName "version" ; aoq:rustName "VERSION" ; aoq:goName "Version" ;
    aoq:value 1 ; aoq:nextOffset w:f2 ; aoq:fieldOf w:hdr .
w:f2 a aoq:HeaderField ; aoq:offset 6 ; aoq:sizeBytes 58 ; aoq:wireKind "reserved-zero" ;
    aoq:cName "reserved" ; aoq:rustName "RESERVED" ; aoq:goName "Reserved" ;
    aoq:fieldOf w:hdr .

w:ihdr a aoq:Header ; aoq:sizeBytes 20 ; aoq:cName "aoq_intent_header_t" .
w:i0 a aoq:HeaderField ; aoq:offset 0 ; aoq:sizeBytes 4 ; aoq:wireKind "u32" ;
    aoq:cName "magic" ; aoq:rustName "INTENT_MAGIC" ; aoq:goName "Magic" ;
    aoq:nextOffset w:i1 ; aoq:fieldOf w:ihdr .
w:i1 a aoq:HeaderField ; aoq:offset 4 ; aoq:sizeBytes 2 ; aoq:wireKind "u16" ;
    aoq:cName "version" ; aoq:rustName "INTENT_VERSION" ; aoq:goName "Version" ;
    aoq:nextOffset w:i2 ; aoq:fieldOf w:ihdr .
w:i2 a aoq:HeaderField ; aoq:offset 6 ; aoq:sizeBytes 10 ; aoq:wireKind "reserved-zero" ;
    aoq:cName "reserved" ; aoq:rustName "INTENT_RESERVED" ; aoq:goName "Reserved" ;
    aoq:fieldOf w:ihdr .
