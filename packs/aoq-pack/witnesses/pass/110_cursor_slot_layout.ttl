@prefix aoq: <urn:aoq:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix w: <urn:aoq:witness:pass/> .

# PASS witness for 110_cursor_slot_layout: the full closed 6-slot layout,
# every slot with a fixed 0-based index, a name from the closed set, and the
# single-writer add_get op. Gate 110 must return 0 rows.

w:src a prov:Entity .

w:slot0 a aoq:CursorSlot ; rdfs:label "ring_head" ;
    aoq:slotIndex 0 ; aoq:slotName "ring_head" ; aoq:writerOp "add_get" ;
    prov:wasDerivedFrom w:src .
w:slot1 a aoq:CursorSlot ; rdfs:label "ring_tail" ;
    aoq:slotIndex 1 ; aoq:slotName "ring_tail" ; aoq:writerOp "add_get" ;
    prov:wasDerivedFrom w:src .
w:slot2 a aoq:CursorSlot ; rdfs:label "lease_ctr" ;
    aoq:slotIndex 2 ; aoq:slotName "lease_ctr" ; aoq:writerOp "add_get" ;
    prov:wasDerivedFrom w:src .
w:slot3 a aoq:CursorSlot ; rdfs:label "lease_gen" ;
    aoq:slotIndex 3 ; aoq:slotName "lease_gen" ; aoq:writerOp "add_get" ;
    prov:wasDerivedFrom w:src .
w:slot4 a aoq:CursorSlot ; rdfs:label "seq" ;
    aoq:slotIndex 4 ; aoq:slotName "seq" ; aoq:writerOp "add_get" ;
    prov:wasDerivedFrom w:src .
w:slot5 a aoq:CursorSlot ; rdfs:label "drop_ctr" ;
    aoq:slotIndex 5 ; aoq:slotName "drop_ctr" ; aoq:writerOp "add_get" ;
    prov:wasDerivedFrom w:src .
