@prefix aoq: <urn:aoq:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix w: <urn:aoq:witness:pass/> .

# Per-header PASS witness (FNOX-SJ-AOQF-2): AOQ1 64 B header (magic 0x414F5131,
# version 1) plus a page 28 B header whose magic/version carry no aoq:value.
# Gate 090 must return 0 rows.

w:hdr a aoq:Header ; aoq:sizeBytes 64 ; aoq:cName "aoq1_header_t" .
w:f0 a aoq:HeaderField ; aoq:offset 0 ; aoq:sizeBytes 4 ; aoq:wireKind "u32" ;
    aoq:cName "magic" ; aoq:rustName "MAGIC" ; aoq:goName "Magic" ;
    aoq:value "0x414F5131" ; aoq:nextOffset w:f1 ; aoq:fieldOf w:hdr .
w:f1 a aoq:HeaderField ; aoq:offset 4 ; aoq:sizeBytes 2 ; aoq:wireKind "u16" ;
    aoq:cName "version" ; aoq:rustName "VERSION" ; aoq:goName "Version" ;
    aoq:value 1 ; aoq:nextOffset w:f2 ; aoq:fieldOf w:hdr .
w:f2 a aoq:HeaderField ; aoq:offset 6 ; aoq:sizeBytes 58 ; aoq:wireKind "reserved-zero" ;
    aoq:cName "reserved" ; aoq:rustName "RESERVED" ; aoq:goName "Reserved" ;
    aoq:fieldOf w:hdr .

w:phdr a aoq:Header ; aoq:sizeBytes 28 ; aoq:cName "aoq_page_header_t" .
w:p0 a aoq:HeaderField ; aoq:offset 0 ; aoq:sizeBytes 4 ; aoq:wireKind "u32" ;
    aoq:cName "magic" ; aoq:rustName "PAGE_MAGIC" ; aoq:goName "Magic" ;
    aoq:nextOffset w:p1 ; aoq:fieldOf w:phdr .
w:p1 a aoq:HeaderField ; aoq:offset 4 ; aoq:sizeBytes 2 ; aoq:wireKind "u16" ;
    aoq:cName "version" ; aoq:rustName "PAGE_VERSION" ; aoq:goName "Version" ;
    aoq:nextOffset w:p2 ; aoq:fieldOf w:phdr .
w:p2 a aoq:HeaderField ; aoq:offset 6 ; aoq:sizeBytes 22 ; aoq:wireKind "reserved-zero" ;
    aoq:cName "reserved" ; aoq:rustName "PAGE_RESERVED" ; aoq:goName "Reserved" ;
    aoq:fieldOf w:phdr .
