@prefix aoq: <urn:aoq:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix w: <urn:aoq:witness:pass/> .

# Per-header PASS witness (FNOX-SJ-AOQF-2): clean AOQ1 64 B chain plus a clean
# page 28 B chain in one graph. Gate 010 must return 0 rows.

w:hdr a aoq:Header ; aoq:sizeBytes 64 ; aoq:cName "aoq1_header_t" .
w:f0 a aoq:HeaderField ; aoq:offset 0 ; aoq:sizeBytes 4 ; aoq:wireKind "u32" ;
    aoq:cName "magic" ; aoq:rustName "MAGIC" ; aoq:goName "Magic" ;
    aoq:value "0x414F5131" ; aoq:nextOffset w:f1 ; aoq:fieldOf w:hdr .
w:f1 a aoq:HeaderField ; aoq:offset 4 ; aoq:sizeBytes 2 ; aoq:wireKind "u16" ;
    aoq:cName "version" ; aoq:rustName "VERSION" ; aoq:goName "Version" ;
    aoq:value 1 ; aoq:nextOffset w:f2 ; aoq:fieldOf w:hdr .
w:f2 a aoq:HeaderField ; aoq:offset 6 ; aoq:sizeBytes 58 ; aoq:wireKind "reserved-zero" ;
    aoq:cName "reserved" ; aoq:rustName "RESERVED" ; aoq:goName "Reserved" ;
    aoq:fieldOf w:hdr .

w:phdr a aoq:Header ; aoq:sizeBytes 28 ; aoq:cName "aoq_page_header_t" .
w:p0 a aoq:HeaderField ; aoq:offset 0 ; aoq:sizeBytes 4 ; aoq:wireKind "u32" ;
    aoq:cName "magic" ; aoq:rustName "PAGE_MAGIC" ; aoq:goName "Magic" ;
    aoq:nextOffset w:p1 ; aoq:fieldOf w:phdr .
w:p1 a aoq:HeaderField ; aoq:offset 4 ; aoq:sizeBytes 2 ; aoq:wireKind "u16" ;
    aoq:cName "version" ; aoq:rustName "PAGE_VERSION" ; aoq:goName "Version" ;
    aoq:nextOffset w:p2 ; aoq:fieldOf w:phdr .
w:p2 a aoq:HeaderField ; aoq:offset 6 ; aoq:sizeBytes 2 ; aoq:wireKind "u16" ;
    aoq:cName "flags" ; aoq:rustName "PAGE_FLAGS" ; aoq:goName "Flags" ;
    aoq:nextOffset w:p3 ; aoq:fieldOf w:phdr .
w:p3 a aoq:HeaderField ; aoq:offset 8 ; aoq:sizeBytes 4 ; aoq:wireKind "u32" ;
    aoq:cName "page_ordinal" ; aoq:rustName "PAGE_ORDINAL" ; aoq:goName "PageOrdinal" ;
    aoq:nextOffset w:p4 ; aoq:fieldOf w:phdr .
w:p4 a aoq:HeaderField ; aoq:offset 12 ; aoq:sizeBytes 4 ; aoq:wireKind "u32" ;
    aoq:cName "page_count" ; aoq:rustName "PAGE_COUNT" ; aoq:goName "PageCount" ;
    aoq:nextOffset w:p5 ; aoq:fieldOf w:phdr .
w:p5 a aoq:HeaderField ; aoq:offset 16 ; aoq:sizeBytes 4 ; aoq:wireKind "u32" ;
    aoq:cName "payload_len" ; aoq:rustName "PAYLOAD_LEN" ; aoq:goName "PayloadLen" ;
    aoq:nextOffset w:p6 ; aoq:fieldOf w:phdr .
w:p6 a aoq:HeaderField ; aoq:offset 20 ; aoq:sizeBytes 4 ; aoq:wireKind "reserved-zero" ;
    aoq:cName "reserved" ; aoq:rustName "PAGE_RESERVED" ; aoq:goName "Reserved" ;
    aoq:nextOffset w:p7 ; aoq:fieldOf w:phdr .
w:p7 a aoq:HeaderField ; aoq:offset 24 ; aoq:sizeBytes 4 ; aoq:wireKind "fnv1a32" ;
    aoq:cName "page_digest" ; aoq:rustName "PAGE_DIGEST" ; aoq:goName "PageDigest" ;
    aoq:fieldOf w:phdr .
