@prefix aoq: <urn:aoq:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix w: <urn:aoq:witness:pass/> .

# PASS witness for 120_wrap_safe_ordering: ordering laws and compare-bearing
# slots all pinned to the wrap-safe subtraction compare and the closed
# scope vocabulary. Gate 120 must return 0 rows.

w:src a prov:Entity .

w:lawTotal a aoq:OrderingLaw ; rdfs:label "per-partition total order" ;
    aoq:orderScope "per-partition-total" ;
    aoq:compareLaw "subtraction-mod-half" .

w:lawCross a aoq:OrderingLaw ; rdfs:label "cross-partition unconstrained" ;
    aoq:orderScope "cross-partition-unconstrained" .

w:seqSlot a aoq:CursorSlot ; rdfs:label "seq" ;
    aoq:slotIndex 4 ; aoq:slotName "seq" ; aoq:writerOp "add_get" ;
    aoq:compareLaw "subtraction-mod-half" .
