# MESSAGE: template linkage broken — every class a pack template's SPARQL
# selects (Frame, Header, HeaderField, StatusConstant, Epoch, StreamType)
# must have at least one individual in the graph; an empty class silently
# renders an empty template output.
# KemParam is deliberately NOT in this list: it is hand-law seam, never
# projected (gate 060 enforces the fence).
# Anti-vacuity: witnesses/fail/080_template_linkage.ttl removes all Epoch
# individuals; >=1 row must result.
PREFIX aoq: <urn:aoq:>
SELECT ?class WHERE {
  VALUES ?class { aoq:Frame aoq:Header aoq:HeaderField aoq:StatusConstant aoq:Epoch aoq:StreamType }
  FILTER NOT EXISTS { ?individual a ?class . }
}
ORDER BY ?class
