# MESSAGE: frozen-pin collision — the retired status band 0x4347_0004 /
# 0x4347_0006 must never appear as a literal anywhere in the union graph.
# These are FROZEN pins owned by cgap; the AOQ status band is
# 0x4347_A001..A009 precisely to stay clear of them.
# Anti-vacuity: witnesses/fail/070_no_frozen_pin_collision.ttl adds a
# StatusConstant carrying the frozen literal "0x43470004"; >=1 row must result.
PREFIX aoq: <urn:aoq:>
SELECT ?subject ?value WHERE {
  ?subject ?p ?value .
  FILTER(STR(?value) IN ("0x43470004", "0x43470006", "0x4347_0004", "0x4347_0006"))
}
ORDER BY ?subject ?value
