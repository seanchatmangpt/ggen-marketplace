---
to: src/dsrust_optimize.rs
sparql:
  optimizers: "PREFIX dsrust: <http://seanchatmangpt.github.io/packs/dsrust#> SELECT ?name ?kind ?targetName ?metricFunction ?trainsetName ?valsetName ?model ?k ?sample ?seed ?maxBootstrappedDemos ?maxLabeledDemos ?maxRounds ?maxErrors ?metricThreshold ?breadth ?depth ?initTemperature ?numCandidates ?numTrials ?programCode ?maxMetricCalls ?reflectionMinibatchSize ?useMerge WHERE { ?o a dsrust:Optimizer ; dsrust:name ?name ; dsrust:kind ?kind ; dsrust:optimizes/dsrust:name ?targetName ; dsrust:trainsetName ?trainsetName . OPTIONAL { ?o dsrust:metricFunction ?metricFunction } OPTIONAL { ?o dsrust:valsetName ?valsetName } OPTIONAL { ?o dsrust:model ?model } OPTIONAL { ?o dsrust:k ?k } OPTIONAL { ?o dsrust:sample ?sample } OPTIONAL { ?o dsrust:seed ?seed } OPTIONAL { ?o dsrust:maxBootstrappedDemos ?maxBootstrappedDemos } OPTIONAL { ?o dsrust:maxLabeledDemos ?maxLabeledDemos } OPTIONAL { ?o dsrust:maxRounds ?maxRounds } OPTIONAL { ?o dsrust:maxErrors ?maxErrors } OPTIONAL { ?o dsrust:metricThreshold ?metricThreshold } OPTIONAL { ?o dsrust:breadth ?breadth } OPTIONAL { ?o dsrust:depth ?depth } OPTIONAL { ?o dsrust:initTemperature ?initTemperature } OPTIONAL { ?o dsrust:numCandidates ?numCandidates } OPTIONAL { ?o dsrust:numTrials ?numTrials } OPTIONAL { ?o dsrust:programCode ?programCode } OPTIONAL { ?o dsrust:maxMetricCalls ?maxMetricCalls } OPTIONAL { ?o dsrust:reflectionMinibatchSize ?reflectionMinibatchSize } OPTIONAL { ?o dsrust:useMerge ?useMerge } } ORDER BY ?name"
---
// GENERATED by ggen from dsrust-pack. Do not hand-edit.
// Consumer-owned metric functions are injected explicitly into constructors;
// generated construction never manufactures executable metric behavior.
use std::sync::Arc;

use anyhow::{Result, bail};
use dsrust::{
    BootstrapFewShot, COPRO, Example, Feedback, GEPA, LM, LabeledFewShot, MIPROv2, Prediction,
};

use crate::dsrust_program::{DynModule, build_module};

pub type MetricFn = fn(&Example, &Prediction) -> f64;
pub type FeedbackMetricFn = fn(&Example, &Prediction) -> Feedback;

/// Metadata binding a generated optimizer constructor to the consumer-owned datasets it expects.
pub struct OptimizerBinding {
    pub name: &'static str,
    pub target_module: &'static str,
    pub trainset: &'static str,
    pub valset: Option<&'static str>,
}

pub const OPTIMIZER_BINDINGS: &[OptimizerBinding] = &[
{% for optimizer in optimizers %}    OptimizerBinding {
        name: {{ optimizer.name | json_encode | safe }},
        target_module: {{ optimizer.targetName | json_encode | safe }},
        trainset: {{ optimizer.trainsetName | json_encode | safe }},
        valset: {% if optimizer.valsetName is defined %}Some({{ optimizer.valsetName | json_encode | safe }}){% else %}None{% endif %},
    },
{% endfor %}];

/// Build the target module named by an optimizer without executing the optimizer.
pub fn build_optimizer_target(name: &str) -> Result<DynModule> {
    match name {
{% for optimizer in optimizers %}        {{ optimizer.name | json_encode | safe }} => build_module({{ optimizer.targetName | json_encode | safe }}),
{% endfor %}        other => bail!("unknown admitted DsRust optimizer: {other}"),
    }
}

{% for optimizer in optimizers %}{% if optimizer.kind == "LabeledFewShot" %}
pub fn optimizer_{{ optimizer.name }}() -> LabeledFewShot {
    let mut optimizer = LabeledFewShot::new({% if optimizer.k is defined %}{{ optimizer.k }}{% else %}16{% endif %});
{% if optimizer.sample is defined %}    optimizer.sample = {{ optimizer.sample }};
{% endif %}{% if optimizer.seed is defined %}    optimizer.seed = {{ optimizer.seed }};
{% endif %}    optimizer
}
{% elif optimizer.kind == "BootstrapFewShot" %}
pub fn optimizer_{{ optimizer.name }}({% if optimizer.metricFunction is defined %}metric: MetricFn{% endif %}) -> BootstrapFewShot<MetricFn> {
    let mut optimizer = {% if optimizer.metricFunction is defined %}BootstrapFewShot::new(metric){% else %}BootstrapFewShot::without_metric(){% endif %};
{% if optimizer.maxBootstrappedDemos is defined %}    optimizer.max_bootstrapped_demos = {{ optimizer.maxBootstrappedDemos }};
{% endif %}{% if optimizer.maxLabeledDemos is defined %}    optimizer.max_labeled_demos = {{ optimizer.maxLabeledDemos }};
{% endif %}{% if optimizer.maxRounds is defined %}    optimizer.max_rounds = {{ optimizer.maxRounds }};
{% endif %}{% if optimizer.maxErrors is defined %}    optimizer.max_errors = {{ optimizer.maxErrors }};
{% endif %}{% if optimizer.metricThreshold is defined %}    optimizer.metric_threshold = Some({{ optimizer.metricThreshold }});
{% endif %}    optimizer
}
{% elif optimizer.kind == "COPRO" %}
pub fn optimizer_{{ optimizer.name }}(metric: MetricFn) -> COPRO<MetricFn> {
    COPRO::new(metric){% if optimizer.breadth is defined %}.with_breadth({{ optimizer.breadth }}){% endif %}{% if optimizer.depth is defined %}.with_depth({{ optimizer.depth }}){% endif %}{% if optimizer.initTemperature is defined %}.with_init_temperature({{ optimizer.initTemperature }}){% endif %}
}
{% elif optimizer.kind == "MIPROv2" %}
pub fn optimizer_{{ optimizer.name }}(metric: MetricFn) -> Result<MIPROv2<MetricFn>> {
    let model = Arc::new(LM::new({{ optimizer.model | json_encode | safe }})?);
    Ok(MIPROv2::new(metric, model){% if optimizer.numCandidates is defined %}.with_candidates({{ optimizer.numCandidates }}){% endif %}{% if optimizer.numTrials is defined %}.with_trials({{ optimizer.numTrials }}){% endif %}{% if optimizer.seed is defined %}.with_seed({{ optimizer.seed }}){% endif %}{% if optimizer.programCode is defined %}.with_program_code({{ optimizer.programCode | json_encode | safe }}){% endif %})
}
{% elif optimizer.kind == "GEPA" %}
pub fn optimizer_{{ optimizer.name }}(feedback_metric: FeedbackMetricFn) -> Result<GEPA<FeedbackMetricFn>> {
    let model = Arc::new(LM::new({{ optimizer.model | json_encode | safe }})?);
    let optimizer = GEPA::new(feedback_metric, model)
        .with_max_metric_calls({{ optimizer.maxMetricCalls }}){% if optimizer.reflectionMinibatchSize is defined %}
        .with_reflection_minibatch_size({{ optimizer.reflectionMinibatchSize }}){% endif %}{% if optimizer.seed is defined %}
        .with_seed({{ optimizer.seed }}){% endif %}{% if optimizer.useMerge is defined and not optimizer.useMerge %}
        .without_merge(){% endif %};
    Ok(optimizer)
}
{% endif %}{% endfor %}
