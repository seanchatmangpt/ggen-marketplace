@prefix dsrust: <http://seanchatmangpt.github.io/packs/dsrust#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Positive Fortune-5 binding fixture. The referenced enterprise asset is intentionally external:
# dsrust-pack owns only the binding contract, not the consuming organization's runtime asset.
dsrust:enterprise_qualification_binding a dsrust:EnterpriseBinding ;
  dcterms:description "Qualification binding proving the enterprise governance adapter without granting runtime authority." ;
  dsrust:architectureAssetRef <urn:enterprise:architecture:asset:dsrust-projection> ;
  dsrust:sourceRepository "https://github.com/seanchatmangpt/dsrust" ;
  dsrust:sourceCommit "f24adde08c1d8850e4d7079d019643bb40f905cb" ;
  dsrust:crateVersion "0.1.0-alpha.2" ;
  dsrust:compatibilityPolicy dsrust:ExactSourceCompatibility ;
  dsrust:authorityBoundary dsrust:ConstructOnlyAuthority ;
  dsrust:runtimeControlOwner dsrust:ConsumerRuntimeControls ;
  dsrust:dataBoundary dsrust:ConsumerDataBoundary ;
  dsrust:promotionPolicy dsrust:ReceiptGatedPromotion ;
  dsrust:rollbackPolicy dsrust:RegenerateFromPinnedSource ;
  dsrust:receiptRequired true ;
  dsrust:directActuation false ;
  dsrust:compilerQualificationStanding "UNKNOWN" ;
  dsrust:runtimeQualificationStanding "UNKNOWN" ;
  dsrust:requiredArchitectureVocabulary "http://seanchatmangpt.github.io/packs/fortune5-architecture#" ;
  dsrust:changeClass "minor" .
