@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Ledger is grounded in exact source tree f24adde08c1d8850e4d7079d019643bb40f905cb.
# `admitted true` means exported and modeled by dsrust-pack. `false` is a deliberate typed
# exclusion, never evidence that DSPy itself lacks the feature.

audit:source a prov:Entity ;
    dcterms:identifier "f24adde08c1d8850e4d7079d019643bb40f905cb" ;
    dcterms:hasVersion "0.1.0-alpha.2" .

# Public module exports observed in src/lib.rs.
audit:Predict a audit:Kind ; audit:role "Module" ; audit:symbol "Predict" ; audit:admitted true ; audit:sourceFile "src/lib.rs; src/predict.rs" .
