@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dsrust: <http://seanchatmangpt.github.io/packs/dsrust#> .
@prefix f5: <http://seanchatmangpt.github.io/packs/fortune5-architecture#> .

# EnterpriseBinding is deliberately an adapter, not a second enterprise-architecture ontology.
# The actual enterprise asset/program is owned by fortune5-architecture-pack or a consuming
# organization's equivalent control plane. This binding says how dsrust-pack participates in it.

dsrust:EnterpriseBinding a rdfs:Class ;
  rdfs:label "DsRust enterprise architecture binding" ;
  rdfs:comment "Optional governance adapter binding one DsRust projection to an external enterprise architecture asset without importing runtime authority into dsrust-pack." ;
  rdfs:seeAlso f5:ArchitectureAsset .

dsrust:architectureAssetRef a rdf:Property ;
  rdfs:domain dsrust:EnterpriseBinding ;
  rdfs:comment "IRI of the enterprise-owned architecture asset governed outside dsrust-pack." .

dsrust:sourceRepository a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:sourceCommit a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:crateVersion a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:compatibilityPolicy a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:authorityBoundary a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:runtimeControlOwner a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:dataBoundary a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:promotionPolicy a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:rollbackPolicy a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:receiptRequired a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:directActuation a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:compilerQualificationStanding a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:runtimeQualificationStanding a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:requiredArchitectureVocabulary a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .
dsrust:changeClass a rdf:Property ; rdfs:domain dsrust:EnterpriseBinding .

# Closed policy values. Consumers use literals so the gate can fail closed without relying on
# another pack's ontology being present in the graph.
dsrust:ExactSourceCompatibility a rdfs:Resource .
dsrust:ConstructOnlyAuthority a rdfs:Resource .
dsrust:ConsumerRuntimeControls a rdfs:Resource .
dsrust:ConsumerDataBoundary a rdfs:Resource .
dsrust:ReceiptGatedPromotion a rdfs:Resource .
dsrust:RegenerateFromPinnedSource a rdfs:Resource .
