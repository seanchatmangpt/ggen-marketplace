---
to: "generated/innovation/strategy-canvas.csv"
force: true
determinism: true
sparql:
  points: |
    PREFIX errc: <https://ggen.dev/ontology/innovation/errc#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?profileTitle ?canvas ?factorLabel ?series ?level WHERE {
      ?profile a errc:InnovationProfile ; dcterms:title ?profileTitle ; errc:hasCanvas ?canvas .
      ?canvas errc:hasPoint ?point .
      ?point errc:pointFactor ?factor ; errc:pointSeries ?seriesNode ; errc:normalizedLevel ?level .
      ?factor skos:prefLabel ?factorLabel .
      ?seriesNode skos:notation ?series .
    } ORDER BY ?profileTitle ?canvas ?factorLabel ?series
---
profile,canvas,factor,series,normalized_level
{% for row in points %}{{ row.profileTitle | json_encode | safe }},{{ row.canvas | json_encode | safe }},{{ row.factorLabel | json_encode | safe }},{{ row.series | json_encode | safe }},{{ row.level }}
{% endfor %}