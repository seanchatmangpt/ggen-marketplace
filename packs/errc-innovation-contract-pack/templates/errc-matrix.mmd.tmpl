---
to: "generated/innovation/errc-matrix.mmd"
force: true
determinism: true
sparql:
  decisions: |
    PREFIX errc: <https://ggen.dev/ontology/innovation/errc#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?profileTitle ?factorLabel ?action WHERE {
      ?profile a errc:InnovationProfile ; dcterms:title ?profileTitle ; errc:hasDecision ?decision .
      ?decision errc:decisionFactor ?factor ; errc:decisionAction ?actionNode .
      ?factor skos:prefLabel ?factorLabel .
      ?actionNode skos:notation ?action .
    } ORDER BY ?profileTitle ?factorLabel
---
flowchart TB
  subgraph E["Eliminate"]
{% for row in decisions %}{% if row.action == "ELIMINATE" %}    e{{ loop.index }}[{{ row.factorLabel | json_encode | safe }}]
{% endif %}{% endfor %}  end
  subgraph R["Reduce"]
{% for row in decisions %}{% if row.action == "REDUCE" %}    r{{ loop.index }}[{{ row.factorLabel | json_encode | safe }}]
{% endif %}{% endfor %}  end
  subgraph H["Raise"]
{% for row in decisions %}{% if row.action == "RAISE" %}    h{{ loop.index }}[{{ row.factorLabel | json_encode | safe }}]
{% endif %}{% endfor %}  end
  subgraph C["Create"]
{% for row in decisions %}{% if row.action == "CREATE" %}    c{{ loop.index }}[{{ row.factorLabel | json_encode | safe }}]
{% endif %}{% endfor %}  end
