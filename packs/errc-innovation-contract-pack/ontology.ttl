@prefix errc: <https://ggen.dev/ontology/innovation/errc#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://ggen.dev/ontology/innovation/errc>
    a dcat:Dataset, prov:Entity ;
    dcterms:title "ERRC Value Innovation Contract" ;
    dcterms:description "Reusable ontology for Eliminate-Reduce-Raise-Create decisions, strategy canvases, evidence, and deterministic projections." ;
    dcterms:hasVersion "26.8.27" ;
    dcterms:relation <http://seanchatmangpt.github.io/packs/affidavit#>,
        <https://ggen.dev/ontology/automatic-autonomic#>,
        <https://ggen.dev/ontology/capability-lineage-propagation#> .

errc:InnovationProfile a rdfs:Class ; rdfs:subClassOf dcat:Dataset, prov:Entity ; rdfs:label "Innovation profile" ; rdfs:comment "A bounded value-innovation subject containing ERRC decisions and optional strategy canvases." .
errc:Factor a rdfs:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Competition factor" .
errc:Action a rdfs:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "ERRC action" .
errc:ERRCDecision a rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "ERRC decision" ; rdfs:comment "One admitted decision assigning exactly one factor to exactly one ERRC action with rationale." .
errc:StrategyCanvas a rdfs:Class ; rdfs:subClassOf dcat:Dataset, prov:Entity ; rdfs:label "Strategy canvas" .
errc:ValueCurvePoint a rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Value curve point" .
errc:Series a rdfs:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "Value curve series" .

errc:ActionScheme a skos:ConceptScheme ; skos:prefLabel "ERRC four actions" .
errc:Eliminate a errc:Action, skos:Concept ; skos:inScheme errc:ActionScheme ; skos:notation "ELIMINATE" ; skos:prefLabel "Eliminate" ; skos:definition "Remove a factor from the admitted future value curve." .
errc:Reduce a errc:Action, skos:Concept ; skos:inScheme errc:ActionScheme ; skos:notation "REDUCE" ; skos:prefLabel "Reduce" ; skos:definition "Lower a factor relative to the admitted current value curve." .
errc:Raise a errc:Action, skos:Concept ; skos:inScheme errc:ActionScheme ; skos:notation "RAISE" ; skos:prefLabel "Raise" ; skos:definition "Increase a factor relative to the admitted current value curve." .
errc:Create a errc:Action, skos:Concept ; skos:inScheme errc:ActionScheme ; skos:notation "CREATE" ; skos:prefLabel "Create" ; skos:definition "Introduce a factor absent from the admitted current value curve." .

errc:SeriesScheme a skos:ConceptScheme ; skos:prefLabel "Strategy canvas series" .
errc:Current a errc:Series, skos:Concept ; skos:inScheme errc:SeriesScheme ; skos:notation "CURRENT" ; skos:prefLabel "Current" .
errc:Target a errc:Series, skos:Concept ; skos:inScheme errc:SeriesScheme ; skos:notation "TARGET" ; skos:prefLabel "Target" .

errc:hasDecision a rdf:Property ; rdfs:domain errc:InnovationProfile ; rdfs:range errc:ERRCDecision .
errc:decisionFactor a rdf:Property ; rdfs:domain errc:ERRCDecision ; rdfs:range errc:Factor .
errc:decisionAction a rdf:Property ; rdfs:domain errc:ERRCDecision ; rdfs:range errc:Action .
errc:rationale a rdf:Property ; rdfs:domain errc:ERRCDecision ; rdfs:range xsd:string ; rdfs:subPropertyOf dcterms:description .
errc:factorOrder a rdf:Property ; rdfs:domain errc:Factor ; rdfs:range xsd:positiveInteger .
errc:hasCanvas a rdf:Property ; rdfs:domain errc:InnovationProfile ; rdfs:range errc:StrategyCanvas .
errc:hasPoint a rdf:Property ; rdfs:domain errc:StrategyCanvas ; rdfs:range errc:ValueCurvePoint .
errc:pointFactor a rdf:Property ; rdfs:domain errc:ValueCurvePoint ; rdfs:range errc:Factor .
errc:pointSeries a rdf:Property ; rdfs:domain errc:ValueCurvePoint ; rdfs:range errc:Series .
errc:normalizedLevel a rdf:Property ; rdfs:domain errc:ValueCurvePoint ; rdfs:range xsd:decimal ; rdfs:comment "Normalized strategy-canvas level in the inclusive range 0..100." .
errc:evidence a rdf:Property ; rdfs:domain errc:ERRCDecision ; rdfs:range prov:Entity ; rdfs:subPropertyOf prov:wasDerivedFrom .
