@prefix k8s: <http://seanchatmangpt.github.io/packs/kubernetes#> .
@prefix ex:  <https://example.com/xaas-workload-example#> .

# Real facts, reproduced from ~/xaas's own live, kind-validated
# k8s/deployment.yaml (hardened + verified against kind-xaas: RBAC scoped,
# NetworkPolicy enforced, ResourceQuota enforced, securityContext present,
# etcd-at-rest encrypted). Not a hypothetical shape.

ex:xaasWorkload a k8s:Workload ;
  k8s:workloadName "xaas" ;
  k8s:namespace "default" ;
  k8s:fileName "deployment.yaml" ;
  k8s:replicas 1 ;
  k8s:serviceAccountName "xaas" ;
  k8s:automountServiceAccountToken false ;
  k8s:podSecurityContextBlock """runAsNonRoot: true
seccompProfile:
  type: RuntimeDefault""" ;
  k8s:servicePort 80 ;
  k8s:serviceTargetPort 4000 ;
  k8s:serviceType "ClusterIP" .

ex:xaasContainer a k8s:Container ;
  k8s:inWorkload ex:xaasWorkload ;
  k8s:containerName "xaas" ;
  k8s:image "xaas:local" ;
  k8s:imagePullPolicy "IfNotPresent" ;
  k8s:containerPort 4000 ;
  k8s:resourceRequestsBlock """cpu: 100m
memory: 512Mi""" ;
  k8s:resourceLimitsBlock """cpu: 500m
memory: 1Gi""" ;
  k8s:envFromConfigMap "xaas-config" ;
  k8s:envFromSecret "xaas-secrets" ;
  k8s:readinessProbeBlock """tcpSocket:
  port: 4000
initialDelaySeconds: 5
periodSeconds: 5""" ;
  k8s:livenessProbeBlock """tcpSocket:
  port: 4000
initialDelaySeconds: 10
periodSeconds: 10""" ;
  k8s:containerSecurityContextBlock """allowPrivilegeEscalation: false
capabilities:
  drop: ["ALL"]""" .
