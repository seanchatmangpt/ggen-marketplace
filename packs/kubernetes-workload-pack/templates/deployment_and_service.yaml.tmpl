---
# Renders one real k8s/<fileName> file per k8s:Workload individual --
# a Deployment plus (if k8s:servicePort is bound) a paired Service, from
# typed k8s:Container facts, not an echoed literal. Self-contained
# sync.rs-native format (to:/sparql:/for_each:), mirroring
# github-actions-pack/templates/workflow.yml.tmpl's exact convention.
#
# Raw-block escape-hatch properties (k8s:podSecurityContextBlock,
# k8s:containerSecurityContextBlock, k8s:resourceRequestsBlock,
# k8s:resourceLimitsBlock, k8s:readinessProbeBlock, k8s:livenessProbeBlock)
# are reindented the same way gha:onBlock/gha:jobExtra are in
# github-actions-pack -- loop split("\n"), not the `indent` filter (that
# filter's real behavior didn't match assumption there either, per that
# pack's own template comment; same caution applies here, untested
# assumption not repeated).
#
# Every rendered file opens with a "# GENERATED by ggen (...). Do not edit."
# YAML comment, same provenance-header convention every other real pack in
# this marketplace follows (beam4pm's scripts/gate_m2_check.sh-style
# marker-based determinism gates depend on it).
to: "k8s/{{ fileName }}"
force: true
for_each: workloads
sparql:
  workloads: |
    PREFIX k8s: <http://seanchatmangpt.github.io/packs/kubernetes#>
    SELECT ?wl ?workloadName ?namespace ?fileName ?replicas ?serviceAccountName
           ?automountServiceAccountToken ?podSecurityContextBlock
           ?servicePort ?serviceTargetPort ?serviceType
    WHERE {
      ?wl a k8s:Workload ; k8s:workloadName ?workloadName ; k8s:fileName ?fileName .
      OPTIONAL { ?wl k8s:namespace ?namespace . }
      OPTIONAL { ?wl k8s:replicas ?replicas . }
      OPTIONAL { ?wl k8s:serviceAccountName ?serviceAccountName . }
      OPTIONAL { ?wl k8s:automountServiceAccountToken ?automountServiceAccountToken . }
      OPTIONAL { ?wl k8s:podSecurityContextBlock ?podSecurityContextBlock . }
      OPTIONAL { ?wl k8s:servicePort ?servicePort . }
      OPTIONAL { ?wl k8s:serviceTargetPort ?serviceTargetPort . }
      OPTIONAL { ?wl k8s:serviceType ?serviceType . }
    }
    ORDER BY ?fileName
  containers: |
    PREFIX k8s: <http://seanchatmangpt.github.io/packs/kubernetes#>
    SELECT ?wl ?containerName ?image ?imagePullPolicy ?containerPort
           ?resourceRequestsBlock ?resourceLimitsBlock ?readinessProbeBlock
           ?livenessProbeBlock ?containerSecurityContextBlock
           (GROUP_CONCAT(DISTINCT ?cm; separator=",") AS ?configMaps)
           (GROUP_CONCAT(DISTINCT ?sec; separator=",") AS ?secrets)
    WHERE {
      ?c a k8s:Container ; k8s:inWorkload ?wl ; k8s:containerName ?containerName .
      OPTIONAL { ?c k8s:image ?image . }
      OPTIONAL { ?c k8s:imagePullPolicy ?imagePullPolicy . }
      OPTIONAL { ?c k8s:containerPort ?containerPort . }
      OPTIONAL { ?c k8s:resourceRequestsBlock ?resourceRequestsBlock . }
      OPTIONAL { ?c k8s:resourceLimitsBlock ?resourceLimitsBlock . }
      OPTIONAL { ?c k8s:readinessProbeBlock ?readinessProbeBlock . }
      OPTIONAL { ?c k8s:livenessProbeBlock ?livenessProbeBlock . }
      OPTIONAL { ?c k8s:containerSecurityContextBlock ?containerSecurityContextBlock . }
      OPTIONAL { ?c k8s:envFromConfigMap ?cm . }
      OPTIONAL { ?c k8s:envFromSecret ?sec . }
    }
    GROUP BY ?wl ?containerName ?image ?imagePullPolicy ?containerPort
             ?resourceRequestsBlock ?resourceLimitsBlock ?readinessProbeBlock
             ?livenessProbeBlock ?containerSecurityContextBlock
    ORDER BY ?wl ?containerName
---
{%- macro reindent(text, spaces) -%}
{%- for line in text | split(pat="\n") -%}
{{ spaces }}{{ line }}
{% endfor -%}
{%- endmacro reindent -%}
# GENERATED by ggen (kubernetes-workload-pack/templates/deployment_and_service.yaml.tmpl). Do not edit.
# Source of truth: this consumer's own admitted k8s:Workload/k8s:Container facts.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ workloadName }}
  namespace: {{ namespace | default(value="default") }}
  labels:
    app: {{ workloadName }}
spec:
  replicas: {{ replicas | default(value=1) }}
  selector:
    matchLabels:
      app: {{ workloadName }}
  template:
    metadata:
      labels:
        app: {{ workloadName }}
    spec:
{%- if serviceAccountName %}
      serviceAccountName: {{ serviceAccountName }}
{%- endif %}
{%- if automountServiceAccountToken is defined %}
      automountServiceAccountToken: {{ automountServiceAccountToken }}
{%- endif %}
{%- if podSecurityContextBlock %}
      securityContext:
{{ self::reindent(text=podSecurityContextBlock, spaces="        ") }}
{%- endif %}
      containers:
{%- for c in containers | filter(attribute="wl", value=wl) %}
        - name: {{ c.containerName }}
{%- if c.image %}
          image: {{ c.image }}
{%- endif %}
{%- if c.imagePullPolicy %}
          imagePullPolicy: {{ c.imagePullPolicy }}
{%- endif %}
{%- if c.containerSecurityContextBlock %}
          securityContext:
{{ self::reindent(text=c.containerSecurityContextBlock, spaces="            ") }}
{%- endif %}
{%- if c.containerPort %}
          ports:
            - containerPort: {{ c.containerPort }}
{%- endif %}
{%- if c.resourceRequestsBlock or c.resourceLimitsBlock %}
          resources:
{%- if c.resourceRequestsBlock %}
            requests:
{{ self::reindent(text=c.resourceRequestsBlock, spaces="              ") }}
{%- endif %}
{%- if c.resourceLimitsBlock %}
            limits:
{{ self::reindent(text=c.resourceLimitsBlock, spaces="              ") }}
{%- endif %}
{%- endif %}
{%- if c.configMaps or c.secrets %}
          envFrom:
{%- for cm in c.configMaps | split(pat=",") %}
{%- if cm %}
            - configMapRef:
                name: {{ cm }}
{%- endif %}
{%- endfor %}
{%- for sec in c.secrets | split(pat=",") %}
{%- if sec %}
            - secretRef:
                name: {{ sec }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if c.readinessProbeBlock %}
          readinessProbe:
{{ self::reindent(text=c.readinessProbeBlock, spaces="            ") }}
{%- endif %}
{%- if c.livenessProbeBlock %}
          livenessProbe:
{{ self::reindent(text=c.livenessProbeBlock, spaces="            ") }}
{%- endif %}
{%- endfor %}
{%- if servicePort %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ workloadName }}
  namespace: {{ namespace | default(value="default") }}
spec:
  selector:
    app: {{ workloadName }}
  ports:
    - port: {{ servicePort }}
      targetPort: {{ serviceTargetPort | default(value=servicePort) }}
  type: {{ serviceType | default(value="ClusterIP") }}
{%- endif %}
