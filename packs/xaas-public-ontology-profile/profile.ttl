# xaas-public-ontology-profile/profile.ttl
#
# Declares XaaS as a real prof:Profile (W3C Profiles Vocabulary,
# https://www.w3.org/TR/dx-prof/) composing real, retrieved, hash-pinned
# public ontologies -- not a standalone invented vocabulary. Every
# prof:isProfileOf target below is a real ontology present on disk in
# ontologies/public/ (see locks/*.lock.toml for per-ontology provenance).
#
# prof:isProfileOf, not owl:imports: XaaS constrains/combines/extends
# these specifications' terms via composition and SHACL, not by pulling
# their full axiom sets into one reasoning closure. No
# owl:equivalentClass/equivalentProperty assertion appears anywhere in
# this file -- see gates/020_no_unproven_equivalence.rq.
#
# This file intentionally declares ZERO xaas:-prefixed classes or
# properties. Native XaaS terms are earned only after competency coverage
# against the admitted public corpus demonstrates a real gap.

@prefix xaas:  <https://ggen.io/ontology/xaas#> .
@prefix prof:  <http://www.w3.org/ns/dx/prof/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Public ontology namespaces this profile composes. Prefixes here are term
# namespaces read from the admitted ontology artifacts, not guessed from
# ontology document IRIs. QUDT is the important distinction: the admitted
# ontology document IRI is http://qudt.org/2.1/schema/qudt while its terms use
# http://qudt.org/schema/qudt/.
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix org:   <http://www.w3.org/ns/org#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix time:  <http://www.w3.org/2006/time#> .
@prefix qudt:  <http://qudt.org/schema/qudt/> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix fno:   <https://w3id.org/function/ontology#> .

<https://ggen.io/ontology/xaas-public-ontology-profile#> a owl:Ontology ;
  rdfs:label "XaaS Public Ontology Profile" ;
  rdfs:comment "Declares xaas:Profile as a composition (prof:isProfileOf, not owl:imports) of real public ontologies. Zero xaas: domain classes/properties declared -- composition only, pending competency-question-driven gap analysis." .

xaas:Profile a prof:Profile ;
  dcterms:title "XaaS Semantic Profile" ;
  dcterms:description "A constrained composition of public ontologies (PROV-O, PROF, DCAT, ORG, SKOS, ODRL, SOSA, OWL-Time, QUDT, SPDX, P-PLAN, FnO) used to answer XaaS competency questions before any xaas:-native term is admitted." ;
  prof:isProfileOf prov: ;
  prof:isProfileOf dcat: ;
  prof:isProfileOf org: ;
  prof:isProfileOf skos: ;
  prof:isProfileOf odrl: ;
  prof:isProfileOf sosa: ;
  prof:isProfileOf time: ;
  prof:isProfileOf <http://qudt.org/2.1/schema/qudt> ;
  prof:isProfileOf spdx: ;
  prof:isProfileOf pplan: ;
  prof:isProfileOf fno: .

# Candidate role notes (hypotheses, not equivalence assertions):
#
# prov:Entity / prov:Activity / prov:Agent
#   receipt/actuation lineage candidates (CQ17, CQ19, CQ20)
# pplan:Plan / pplan:Step
#   plan != execution candidates (CQ12)
# fno:Function / fno:Mapping / fno:Implementation / fno:Execution
#   capability/realization/execution candidates (CQ01-CQ04)
# odrl:Permission / odrl:Prohibition / odrl:Duty
#   policy constraints (CQ08), explicitly NOT equivalent to BRCE execution authority
# dcat:Catalog / dcat:Resource
#   catalog/service candidates (CQ01)
# sosa:Observation / sosa:Actuation
#   observation and actuation candidates (CQ10)
# qudt:QuantityValue / qudt:Unit
#   measurement/unit candidates (CQ11)
