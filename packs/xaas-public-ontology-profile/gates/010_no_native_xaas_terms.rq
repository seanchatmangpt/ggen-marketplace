# MESSAGE: this pack must declare ZERO xaas:-prefixed classes or properties
# in profile.ttl (or anywhere under this pack) until queries/competency/
# has been run and a specific competency question is shown to have no
# satisfying public term. Any row returned here is a native term admitted
# before that check -- refuse the pack.
PREFIX xaas: <https://ggen.io/ontology/xaas#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?term WHERE {
  ?term rdf:type ?anyType .
  FILTER(STRSTARTS(STR(?term), STR(xaas:)))
  FILTER(?term != xaas:Profile)
}
