# MESSAGE: owl:equivalentClass / owl:equivalentProperty assert OWL identity
# between two vocabularies' terms -- a strong claim this pack refuses to
# make until a competency-question check (queries/competency/) actually
# demonstrates the equivalence holds. Candidate relationships (e.g.
# tosca:Capability ~ fno:Function, or odrl:Permission and XaaS execution
# authority) belong in profile.ttl's comments as hypotheses, or as
# skos:exactMatch/closeMatch (a vocabulary relation, not an OWL identity
# assertion) -- never as owl:equivalentClass/Property until proven. Any
# row returned here is a refused, unproven equivalence assertion.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?s ?p ?o WHERE {
  ?s ?p ?o .
  FILTER(?p IN (owl:equivalentClass, owl:equivalentProperty))
}
