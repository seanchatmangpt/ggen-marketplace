@prefix epr: <https://ggen.dev/ontology/external-paradigm-recompilation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Qualification-only external fact identity. The disposition concepts are
# owned by external-paradigm-recompilation-pack (SLP-QUAL-001 shape,
# standing-ladder-pack precedent); this fixture restates only the typed
# identity needed so ahr:disposition objects are not dangling IRIs when
# agent-harness-recompilation-pack is qualified in isolation. Canonical
# facts remain owned by external-paradigm-recompilation-pack/ontology.ttl.
epr:VENDOR a skos:Concept ;
    dcterms:source "packs/external-paradigm-recompilation-pack/ontology.ttl#epr:VENDOR" .

epr:WRAP a skos:Concept ;
    dcterms:source "packs/external-paradigm-recompilation-pack/ontology.ttl#epr:WRAP" .

epr:REPLACE a skos:Concept ;
    dcterms:source "packs/external-paradigm-recompilation-pack/ontology.ttl#epr:REPLACE" .
