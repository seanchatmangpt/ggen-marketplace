@prefix ahr: <https://ggen.dev/ontology/agent-harness-recompilation#> .
@prefix epr: <https://ggen.dev/ontology/external-paradigm-recompilation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ahr:HarnessPart a rdfs:Class .
ahr:partKind a rdf:Property .
ahr:disposition a rdf:Property .
ahr:retainSemantics a rdf:Property .
ahr:replaceSemantics a rdf:Property .
ahr:targetPack a rdf:Property .
ahr:authorityCeiling a rdf:Property .
ahr:grantsDoAuthority a rdf:Property .

# The nine recurrent harness parts. These are pattern classes, not ECC identities.
ahr:adapter a ahr:HarnessPart ; ahr:partKind "adapter" ; ahr:disposition epr:VENDOR ;
  ahr:retainSemantics "cross-harness protocol compatibility" ;
  ahr:targetPack "sa2a-bridge-pack" ; ahr:authorityCeiling "NONE" ; ahr:grantsDoAuthority false .

ahr:securityScanner a ahr:HarnessPart ; ahr:partKind "security_scanner" ; ahr:disposition epr:VENDOR ;
  ahr:retainSemantics "scanner findings as evidence" ;
  ahr:targetPack "gall-core-pack", "affidavit-pack" ; ahr:authorityCeiling "OBSERVE" ; ahr:grantsDoAuthority false .

ahr:capabilitySurface a ahr:HarnessPart ; ahr:partKind "capability_surface" ; ahr:disposition epr:WRAP ;
  ahr:retainSemantics "skills agents commands as reusable candidate behavior" ;
  ahr:replaceSemantics "normalize to provenance-bound ggen pack candidates before admission" ;
  ahr:targetPack "pack-authoring-pack", "prior-art-admission-pack" ;
  ahr:authorityCeiling "SELECT|CONSTRUCT" ; ahr:grantsDoAuthority false .

ahr:learning a ahr:HarnessPart ; ahr:partKind "learning" ; ahr:disposition epr:REPLACE ;
  ahr:retainSemantics "observation and candidate extraction" ;
  ahr:replaceSemantics "confidence promotion -> provenance falsifier court qualification admission" ;
  ahr:targetPack "collective-skill-court-pack", "dfcm-explore-candidate-factory-pack" ;
  ahr:authorityCeiling "OBSERVE" ; ahr:grantsDoAuthority false .

ahr:planning a ahr:HarnessPart ; ahr:partKind "planning" ; ahr:disposition epr:REPLACE ;
  ahr:retainSemantics "goal decomposition and workflow intent" ;
  ahr:replaceSemantics "prompt-selected orchestration -> formal planning and policy" ;
  ahr:targetPack "planning-federation-pack", "planning-policy-pack", "semantic-procedural-graph-pack" ;
  ahr:authorityCeiling "SELECT|CONSTRUCT" ; ahr:grantsDoAuthority false .

ahr:verification a ahr:HarnessPart ; ahr:partKind "verification" ; ahr:disposition epr:REPLACE ;
  ahr:retainSemantics "review verify barrier" ;
  ahr:replaceSemantics "narrative READY -> exact-subject courts receipt replay typed standing" ;
  ahr:targetPack "gall-core-pack", "affidavit-pack", "receipt-provenance-unification-pack" ;
  ahr:authorityCeiling "OBSERVE" ; ahr:grantsDoAuthority false .

ahr:memory a ahr:HarnessPart ; ahr:partKind "memory" ; ahr:disposition epr:WRAP ;
  ahr:retainSemantics "portable handoff and recall" ;
  ahr:replaceSemantics "memory facts -> provenance-bound observations that never grant authority" ;
  ahr:targetPack "receipt-provenance-unification-pack", "ggen-ecosystem-ocel-pack" ;
  ahr:authorityCeiling "OBSERVE" ; ahr:grantsDoAuthority false .

ahr:hook a ahr:HarnessPart ; ahr:partKind "hook" ; ahr:disposition epr:WRAP ;
  ahr:retainSemantics "deterministic observation and interception" ;
  ahr:replaceSemantics "consequential hook mutation -> explicit admitted actuation boundary" ;
  ahr:targetPack "ggen-ecosystem-ocel-pack", "autofde-level4-actuation-pack" ;
  ahr:authorityCeiling "OBSERVE|SELECT" ; ahr:grantsDoAuthority false .

ahr:workflow a ahr:HarnessPart ; ahr:partKind "workflow" ; ahr:disposition epr:REPLACE ;
  ahr:retainSemantics "multi-step orchestration plus review and verification barriers" ;
  ahr:replaceSemantics "harness-specific orchestration -> SA2A plus formal planning plus GALL" ;
  ahr:targetPack "sa2a-bridge-pack", "planning-federation-pack", "gall-core-pack" ;
  ahr:authorityCeiling "SELECT|CONSTRUCT" ; ahr:grantsDoAuthority false .
