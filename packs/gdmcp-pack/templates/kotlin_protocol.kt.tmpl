---
to: src/gdmcp/kotlin/GdmcpProtocol.kt
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/gdmcp-pack
sparql:
  features: >
    PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
    SELECT ?id ?kind ?status ?wire WHERE {
      ?f a gdmcp:Feature ; gdmcp:id ?id ; gdmcp:kind ?kind ; gdmcp:status ?status ; gdmcp:wire ?wire .
    } ORDER BY ?id
---
package gdmcp

// Generated protocol registry; construction only, no ambient actuation authority.
data class GdmcpFeature(val id: String, val kind: String, val status: String, val wire: String)
object GdmcpProtocol {
    const val PROTOCOL_VERSION = "2026-07-28"
    const val SDK_SUPPORT = "official-sdk"
    val FEATURES = listOf(
{% for row in features %}        GdmcpFeature("{{ row.id }}", "{{ row.kind }}", "{{ row.status }}", "{{ row.wire }}"){% if not loop.last %},{% endif %}
{% endfor %}    )
    fun hasFeature(id: String) = FEATURES.any { it.id == id }
}
