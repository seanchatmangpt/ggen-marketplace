---
to: src/gdmcp/ruby/protocol.rb
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/gdmcp-pack
sparql:
  features: >
    PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
    SELECT ?id ?kind ?status ?wire WHERE {
      ?f a gdmcp:Feature ; gdmcp:id ?id ; gdmcp:kind ?kind ; gdmcp:status ?status ; gdmcp:wire ?wire .
    } ORDER BY ?id
---
# frozen_string_literal: true
# Generated gdmcp registry; construction only, no ambient actuation authority.
module Gdmcp
  PROTOCOL_VERSION = "2026-07-28"
  SDK_SUPPORT = "official-sdk"
  Feature = Struct.new(:id, :kind, :status, :wire, keyword_init: true)
  FEATURES = [
{% for row in features %}    Feature.new(id: "{{ row.id }}", kind: "{{ row.kind }}", status: "{{ row.status }}", wire: "{{ row.wire }}"),
{% endfor %}  ].freeze
  def self.feature?(id) = FEATURES.any? { |feature| feature.id == id }
end
