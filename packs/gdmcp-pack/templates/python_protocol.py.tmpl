---
to: src/gdmcp/python/protocol.py
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/gdmcp-pack
sparql:
  features: >
    PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
    SELECT ?id ?kind ?status ?wire WHERE {
      ?f a gdmcp:Feature ; gdmcp:id ?id ; gdmcp:kind ?kind ; gdmcp:status ?status ; gdmcp:wire ?wire .
    } ORDER BY ?id
---
"""Generated gdmcp MCP 2026-07-28 protocol registry; no ambient actuation authority."""
from dataclasses import dataclass

@dataclass(frozen=True)
class GdmcpFeature:
    id: str
    kind: str
    status: str
    wire: str

GDMCP_PROTOCOL_VERSION = "2026-07-28"
GDMCP_SDK_SUPPORT = "tier1-2026-07-28"
GDMCP_FEATURES = (
{% for row in features %}    GdmcpFeature("{{ row.id }}", "{{ row.kind }}", "{{ row.status }}", "{{ row.wire }}"),
{% endfor %})
def has_gdmcp_feature(feature_id: str) -> bool:
    return any(feature.id == feature_id for feature in GDMCP_FEATURES)
