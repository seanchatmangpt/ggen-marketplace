---
to: src/gdmcp/java/GdmcpProtocol.java
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/gdmcp-pack
sparql:
  features: >
    PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
    SELECT ?id ?kind ?status ?wire WHERE {
      ?f a gdmcp:Feature ; gdmcp:id ?id ; gdmcp:kind ?kind ; gdmcp:status ?status ; gdmcp:wire ?wire .
    } ORDER BY ?id
---
package gdmcp;

import java.util.List;
// Generated protocol registry; construction only, no ambient actuation authority.
public final class GdmcpProtocol {
  public static final String PROTOCOL_VERSION = "2026-07-28";
  public static final String SDK_SUPPORT = "official-sdk";
  public record Feature(String id, String kind, String status, String wire) {}
  public static final List<Feature> FEATURES = List.of(
{% for row in features %}    new Feature("{{ row.id }}", "{{ row.kind }}", "{{ row.status }}", "{{ row.wire }}"){% if not loop.last %},{% endif %}
{% endfor %}  );
  public static boolean hasFeature(String id) { return FEATURES.stream().anyMatch(f -> f.id().equals(id)); }
  private GdmcpProtocol() {}
}
