---
to: src/gdmcp/typescript/protocol.ts
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/gdmcp-pack
sparql:
  features: >
    PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
    SELECT ?id ?kind ?status ?wire WHERE {
      ?f a gdmcp:Feature ; gdmcp:id ?id ; gdmcp:kind ?kind ; gdmcp:status ?status ; gdmcp:wire ?wire .
    } ORDER BY ?id
---
// Generated by gdmcp-pack from the canonical MCP 2026-07-28 ontology.
// Construction only: this registry grants no execution authority.
export type GdmcpFeature = Readonly<{ id: string; kind: string; status: string; wire: string }>;
export const GDMCP_PROTOCOL_VERSION = "2026-07-28" as const;
export const GDMCP_SDK_SUPPORT = "tier1-2026-07-28" as const;
export const GDMCP_FEATURES: readonly GdmcpFeature[] = [
{% for row in features %}  { id: "{{ row.id }}", kind: "{{ row.kind }}", status: "{{ row.status }}", wire: "{{ row.wire }}" },
{% endfor %}];
export const hasGdmcpFeature = (id: string): boolean => GDMCP_FEATURES.some((f) => f.id === id);
