---
to: src/gdmcp/rust/protocol.rs
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/gdmcp-pack
sparql:
  features: >
    PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
    SELECT ?id ?kind ?status ?wire WHERE {
      ?f a gdmcp:Feature ; gdmcp:id ?id ; gdmcp:kind ?kind ; gdmcp:status ?status ; gdmcp:wire ?wire .
    } ORDER BY ?id
---
// Generated from canonical gdmcp ontology. Construction only; no ambient actuation authority.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct GdmcpFeature { pub id: &'static str, pub kind: &'static str, pub status: &'static str, pub wire: &'static str }
pub const GDMCP_PROTOCOL_VERSION: &str = "2026-07-28";
pub const GDMCP_SDK_SUPPORT: &str = "beta-2026-07-28";
pub static GDMCP_FEATURES: &[GdmcpFeature] = &[
{% for row in features %}    GdmcpFeature { id: "{{ row.id }}", kind: "{{ row.kind }}", status: "{{ row.status }}", wire: "{{ row.wire }}" },
{% endfor %}];
pub fn has_gdmcp_feature(id: &str) -> bool { GDMCP_FEATURES.iter().any(|feature| feature.id == id) }
