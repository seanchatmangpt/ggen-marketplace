---
to: src/gdmcp/csharp/GdmcpProtocol.cs
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/gdmcp-pack
sparql:
  features: >
    PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
    SELECT ?id ?kind ?status ?wire WHERE {
      ?f a gdmcp:Feature ; gdmcp:id ?id ; gdmcp:kind ?kind ; gdmcp:status ?status ; gdmcp:wire ?wire .
    } ORDER BY ?id
---
using System;
using System.Collections.Generic;
using System.Linq;
namespace Gdmcp {
public sealed class Feature { public string Id {get;} public string Kind {get;} public string Status {get;} public string Wire {get;} public Feature(string id,string kind,string status,string wire){Id=id;Kind=kind;Status=status;Wire=wire;} }
public static class Protocol {
 public const string ProtocolVersion = "2026-07-28"; public const string SDKSupport = "tier1-2026-07-28";
 public static readonly IReadOnlyList<Feature> Features = new [] {
{% for row in features %}  new Feature("{{ row.id }}", "{{ row.kind }}", "{{ row.status }}", "{{ row.wire }}"),
{% endfor %} };
 public static bool HasFeature(string id) => Features.Any(f => f.Id == id);
}
}
