---
to: src/gdmcp/swift/GdmcpProtocol.swift
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/gdmcp-pack
sparql:
  features: >
    PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
    SELECT ?id ?kind ?status ?wire WHERE {
      ?f a gdmcp:Feature ; gdmcp:id ?id ; gdmcp:kind ?kind ; gdmcp:status ?status ; gdmcp:wire ?wire .
    } ORDER BY ?id
---
// Generated gdmcp registry; construction only, no ambient actuation authority.
public struct GdmcpFeature: Sendable, Equatable { public let id: String; public let kind: String; public let status: String; public let wire: String }
public enum GdmcpProtocol {
  public static let protocolVersion = "2026-07-28"
  public static let sdkSupport = "official-sdk"
  public static let features: [GdmcpFeature] = [
{% for row in features %}    GdmcpFeature(id: "{{ row.id }}", kind: "{{ row.kind }}", status: "{{ row.status }}", wire: "{{ row.wire }}"),
{% endfor %}  ]
  public static func hasFeature(_ id: String) -> Bool { features.contains { $0.id == id } }
}
