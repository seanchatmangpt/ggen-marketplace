---
to: src/gdmcp/go/protocol.go
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/gdmcp-pack
sparql:
  features: >
    PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
    SELECT ?id ?kind ?status ?wire WHERE {
      ?f a gdmcp:Feature ; gdmcp:id ?id ; gdmcp:kind ?kind ; gdmcp:status ?status ; gdmcp:wire ?wire .
    } ORDER BY ?id
---
package gdmcp

// Generated from the canonical gdmcp ontology. Construction only; no ambient actuation authority.
type Feature struct { ID, Kind, Status, Wire string }
const ProtocolVersion = "2026-07-28"
const SDKSupport = "tier1-2026-07-28"
var Features = []Feature{
{% for row in features %}	{ID: "{{ row.id }}", Kind: "{{ row.kind }}", Status: "{{ row.status }}", Wire: "{{ row.wire }}"},
{% endfor %}}
func HasFeature(id string) bool { for _, f := range Features { if f.ID == id { return true } }; return false }
