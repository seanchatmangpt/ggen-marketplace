---
to: src/gdmcp/php/protocol.php
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/gdmcp-pack
sparql:
  features: >
    PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
    SELECT ?id ?kind ?status ?wire WHERE {
      ?f a gdmcp:Feature ; gdmcp:id ?id ; gdmcp:kind ?kind ; gdmcp:status ?status ; gdmcp:wire ?wire .
    } ORDER BY ?id
---
<?php
declare(strict_types=1);
// Generated gdmcp registry; construction only, no ambient actuation authority.
const GDMCP_PROTOCOL_VERSION = '2026-07-28';
const GDMCP_SDK_SUPPORT = 'official-sdk';
const GDMCP_FEATURES = [
{% for row in features %}    ['id' => '{{ row.id }}', 'kind' => '{{ row.kind }}', 'status' => '{{ row.status }}', 'wire' => '{{ row.wire }}'],
{% endfor %}];
function gdmcp_has_feature(string $id): bool { foreach (GDMCP_FEATURES as $feature) { if ($feature['id'] === $id) return true; } return false; }
