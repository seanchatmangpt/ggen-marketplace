# MESSAGE: gdmcp protocol/version/status vocabulary must remain bounded to the admitted 2026-07-28 contract.
PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?subject ?problem WHERE {
  { gdmcp:spec-2026-07-28 dcterms:identifier ?version . FILTER(?version != "2026-07-28") BIND("protocol-version" AS ?problem) BIND(gdmcp:spec-2026-07-28 AS ?subject) }
  UNION
  { ?subject a gdmcp:Feature ; gdmcp:status ?status . FILTER(?status NOT IN ("active", "deprecated", "extension")) BIND("feature-status" AS ?problem) }
}
