# MESSAGE: gdmcp must retain every admitted MCP 2026-07-28 core, compatibility, transport, authorization, and official-extension feature.
PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
SELECT ?missing WHERE {
  VALUES ?missing { "protocol.jsonrpc" "protocol.stateless" "protocol.server-discover" "protocol.request-meta" "protocol.result-type" "protocol.cache-hints" "protocol.http-header-routing" "protocol.json-schema-2020-12" "protocol.extensions" "protocol.mrtr" "protocol.progress" "protocol.cancellation" "tools.list" "tools.call" "tools.list-changed" "tools.structured-content" "resources.list" "resources.templates-list" "resources.read" "resources.list-changed" "resources.updated" "resources.subscription-capability" "prompts.list" "prompts.get" "prompts.list-changed" "completion.complete" "subscriptions.listen" "subscriptions.acknowledged" "elicitation.form" "elicitation.url" "roots.compat" "sampling.compat" "logging.compat" "extensions.mcp-apps" "extensions.oauth-client-credentials" "extensions.enterprise-managed-authorization" "tasks.extension" "tasks.get" "tasks.update" "tasks.cancel" "authorization.oauth-2-1" "authorization.protected-resource-metadata" "authorization.authorization-server-metadata" "authorization.resource-indicators" "authorization.issuer-validation" "authorization.client-metadata-document" "authorization.dynamic-client-registration-compat" "transport.stdio" "transport.streamable-http" "transport.legacy-http-sse" "errors.parse" "errors.invalid-request" "errors.method-not-found" "errors.invalid-params" "errors.internal" "errors.unsupported-protocol-version" "errors.missing-client-capability" "content.text" "content.image" "content.audio" "content.resource-link" "content.embedded-resource" "metadata.annotations" "metadata.icons" }
  FILTER NOT EXISTS { ?feature a gdmcp:Feature ; gdmcp:id ?missing . }
}
