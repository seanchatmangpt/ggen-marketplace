# MESSAGE: every gdmcp feature must have id, kind, status, wire, and provenance.
PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?feature WHERE {
  ?feature a gdmcp:Feature .
  FILTER (
    NOT EXISTS { ?feature gdmcp:id ?id } ||
    NOT EXISTS { ?feature gdmcp:kind ?kind } ||
    NOT EXISTS { ?feature gdmcp:status ?status } ||
    NOT EXISTS { ?feature gdmcp:wire ?wire } ||
    NOT EXISTS { ?feature prov:wasDerivedFrom ?source }
  )
}
