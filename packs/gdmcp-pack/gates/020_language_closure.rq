# MESSAGE: gdmcp must retain all ten official MCP SDK language projections.
PREFIX gdmcp: <http://seanchatmangpt.github.io/packs/gdmcp#>
SELECT ?missing WHERE {
  VALUES ?missing { "typescript" "python" "go" "rust" "java" "kotlin" "csharp" "php" "ruby" "swift" }
  FILTER NOT EXISTS { ?language a gdmcp:Language ; gdmcp:slug ?missing ; gdmcp:outputPath ?path ; gdmcp:sdkSupportStatus ?status . }
}
