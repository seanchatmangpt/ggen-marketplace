"""GENERATED by ggen from ggen-ecosystem-standing-pack/ontology.ttl. Do not edit.

Source of truth: contracts/standing-transitions/*.json + docs/STANDING.md.
Consumed by scripts/ecosystem_alive.py, scripts/dod_engine.py, scripts/certify_ecosystem.py.
This module is CONSTRUCT-ceiling: it classifies standing, it never actuates.
"""
from __future__ import annotations
from typing import NamedTuple

STANDING_DEFINITIONS: dict[str, str] = {
{% for row in standings %}    "{{ row.label }}": "{{ row.definition }}",
{% endfor %}}

ADMITTED_STANDINGS: frozenset[str] = frozenset(STANDING_DEFINITIONS)


class Transition(NamedTuple):
    id: str
    from_standing: str
    to_standing: str
    rule: str
    authority_effect: str


TRANSITIONS: tuple[Transition, ...] = (
{% for row in transitions %}    Transition("{{ row.id }}", "{{ row.from }}", "{{ row.to }}", "{{ row.rule }}", "{{ row.authority_effect }}"),
{% endfor %})


def is_admitted(standing: str) -> bool:
    """A typed REFUSED:<type> is admitted; every other standing must match exactly."""
    return standing.split(":", 1)[0] in ADMITTED_STANDINGS


def lookup_transition(from_standing: str, to_standing: str) -> Transition | None:
    base_from = from_standing.split(":", 1)[0]
    base_to = to_standing.split(":", 1)[0]
    for t in TRANSITIONS:
        if t.from_standing == base_from and t.to_standing == base_to:
            return t
    return None


def transition_rule(from_standing: str, to_standing: str) -> str:
    t = lookup_transition(from_standing, to_standing)
    if t is None:
        raise ValueError(f"unadmitted standing transition: {from_standing} -> {to_standing}")
    return t.rule
