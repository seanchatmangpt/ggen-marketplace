@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix st:  <urn:ggen-ecosystem:standing:> .

# Standing concept scheme. Derived from contracts/standing-transitions/*.json (ST01-ST50)
# and docs/STANDING.md of ggen-ecosystem. Seven admitted standings; nothing else is admissible.
st:StandingScheme a skos:ConceptScheme ;
    dct:title "ggen-ecosystem standing vocabulary" ;
    dct:source "docs/STANDING.md" .

st:UNKNOWN a skos:Concept ; skos:inScheme st:StandingScheme ; skos:prefLabel "UNKNOWN" ; skos:definition "required observation absent, stale, or contradictory." .

st:PARTIAL_ALIVE a skos:Concept ; skos:inScheme st:StandingScheme ; skos:prefLabel "PARTIAL_ALIVE" ; skos:definition "bounded checkpoint executed successfully; crown claim remains open." .

st:ALIVE a skos:Concept ; skos:inScheme st:StandingScheme ; skos:prefLabel "ALIVE" ; skos:definition "observed execution against the exact admitted subject produced the claimed consequence." .

st:BLOCKED a skos:Concept ; skos:inScheme st:StandingScheme ; skos:prefLabel "BLOCKED" ; skos:definition "an admitted dependency prevents the relevant execution." .

st:BUILD_BROKEN a skos:Concept ; skos:inScheme st:StandingScheme ; skos:prefLabel "BUILD_BROKEN" ; skos:definition "the verifier cannot currently be reached because the build boundary is broken." .

st:UNSUPPORTED a skos:Concept ; skos:inScheme st:StandingScheme ; skos:prefLabel "UNSUPPORTED" ; skos:definition "outside the admitted capability boundary." .

st:REFUSED a skos:Concept ; skos:inScheme st:StandingScheme ; skos:prefLabel "REFUSED" ; skos:definition "admission deliberately denies a proposed state or action (typed as REFUSED:<type>)." .

st:ST01 a eco:StandingFoundationContract ;
    dct:identifier "ST01" ; dct:title "standing-vocabulary" ;
    dct:description "Only UNKNOWN, PARTIAL_ALIVE, ALIVE, BLOCKED, BUILD_BROKEN, UNSUPPORTED, and typed REFUSED are admitted standings." ;
    eco:authorityCeiling "CONSTRUCT" ;
    eco:contractStanding "CANDIDATE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st01-standing-vocabulary.json" .

st:ST02 a eco:StandingFoundationContract ;
    dct:identifier "ST02" ; dct:title "exact-subject" ;
    dct:description "Standing transitions bind the exact admitted subject identity; evidence for an adjacent subject cannot transfer standing." ;
    eco:authorityCeiling "CONSTRUCT" ;
    eco:contractStanding "CANDIDATE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st02-exact-subject.json" .

st:ST03 a eco:StandingFoundationContract ;
    dct:identifier "ST03" ; dct:title "evidence-required" ;
    dct:description "Every standing promotion requires new evidence scoped to the exact subject." ;
    eco:authorityCeiling "CONSTRUCT" ;
    eco:contractStanding "CANDIDATE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st03-evidence-required.json" .

st:ST04 a eco:StandingFoundationContract ;
    dct:identifier "ST04" ; dct:title "freshness-required" ;
    dct:description "Promotion evidence must be fresh for the claimed subject and exact head." ;
    eco:authorityCeiling "CONSTRUCT" ;
    eco:contractStanding "CANDIDATE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st04-freshness-required.json" .

st:ST05 a eco:StandingFoundationContract ;
    dct:identifier "ST05" ; dct:title "execution-required-for-alive" ;
    dct:description "ALIVE requires observed execution against the exact admitted subject; inspection alone cannot crown ALIVE." ;
    eco:authorityCeiling "CONSTRUCT" ;
    eco:contractStanding "CANDIDATE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st05-execution-required-for-alive.json" .

st:ST06 a eco:StandingFoundationContract ;
    dct:identifier "ST06" ; dct:title "replay-required-for-alive" ;
    dct:description "ALIVE requires replayable evidence or an explicit bounded reason replay is inapplicable." ;
    eco:authorityCeiling "CONSTRUCT" ;
    eco:contractStanding "CANDIDATE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st06-replay-required-for-alive.json" .

st:ST07 a eco:StandingFoundationContract ;
    dct:identifier "ST07" ; dct:title "authority-non-escalation" ;
    dct:description "Evidence and standing never grant DO authority; BRCE remains the exclusive actuation path." ;
    eco:authorityCeiling "CONSTRUCT" ;
    eco:contractStanding "CANDIDATE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st07-authority-non-escalation.json" .

st:ST08 a eco:StandingFoundationContract ;
    dct:identifier "ST08" ; dct:title "negative-observation-state-change" ;
    dct:description "A material negative observation must update constraints, eliminated options, dependencies, authority boundaries, or standing." ;
    eco:authorityCeiling "CONSTRUCT" ;
    eco:contractStanding "CANDIDATE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st08-negative-observation-state-change.json" .

st:ST09 a eco:StandingTransition ;
    dct:identifier "ST09" ; dct:title "st09-unknown-to-partial-alive" ;
    eco:fromStanding st:UNKNOWN ; eco:toStanding st:PARTIAL_ALIVE ;
    eco:promotionRule "Require bounded positive evidence and explicit missing crown evidence." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st09-unknown-to-partial-alive.json" .

st:ST10 a eco:StandingTransition ;
    dct:identifier "ST10" ; dct:title "st10-unknown-to-alive" ;
    eco:fromStanding st:UNKNOWN ; eco:toStanding st:ALIVE ;
    eco:promotionRule "Require exact-subject observed execution plus verifier receipt; inspection-only promotion is forbidden." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st10-unknown-to-alive.json" .

st:ST11 a eco:StandingTransition ;
    dct:identifier "ST11" ; dct:title "st11-unknown-to-blocked" ;
    eco:fromStanding st:UNKNOWN ; eco:toStanding st:BLOCKED ;
    eco:promotionRule "Require observed external, tooling, transport, or authority dependency preventing the next lawful step." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st11-unknown-to-blocked.json" .

st:ST12 a eco:StandingTransition ;
    dct:identifier "ST12" ; dct:title "st12-unknown-to-build-broken" ;
    eco:fromStanding st:UNKNOWN ; eco:toStanding st:BUILD_BROKEN ;
    eco:promotionRule "Require observed execution reaching a build or test boundary and failing there." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st12-unknown-to-build-broken.json" .

st:ST13 a eco:StandingTransition ;
    dct:identifier "ST13" ; dct:title "st13-unknown-to-unsupported" ;
    eco:fromStanding st:UNKNOWN ; eco:toStanding st:UNSUPPORTED ;
    eco:promotionRule "Require capability inspection proving the requested operation is not supported." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st13-unknown-to-unsupported.json" .

st:ST14 a eco:StandingTransition ;
    dct:identifier "ST14" ; dct:title "st14-unknown-to-refused" ;
    eco:fromStanding st:UNKNOWN ; eco:toStanding st:REFUSED ;
    eco:promotionRule "Require a typed policy, admission, or authority refusal with explicit refusal reason." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st14-unknown-to-refused.json" .

st:ST15 a eco:StandingTransition ;
    dct:identifier "ST15" ; dct:title "st15-partial-alive-to-unknown" ;
    eco:fromStanding st:PARTIAL_ALIVE ; eco:toStanding st:UNKNOWN ;
    eco:promotionRule "Require invalidation or expiry of prior evidence, or loss of subject identity; preserved receipts are not erased." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st15-partial-alive-to-unknown.json" .

st:ST16 a eco:StandingTransition ;
    dct:identifier "ST16" ; dct:title "st16-partial-alive-to-alive" ;
    eco:fromStanding st:PARTIAL_ALIVE ; eco:toStanding st:ALIVE ;
    eco:promotionRule "Require exact-subject observed execution plus verifier receipt closing every declared crown gap." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st16-partial-alive-to-alive.json" .

st:ST17 a eco:StandingTransition ;
    dct:identifier "ST17" ; dct:title "st17-partial-alive-to-blocked" ;
    eco:fromStanding st:PARTIAL_ALIVE ; eco:toStanding st:BLOCKED ;
    eco:promotionRule "Require a newly observed external, tooling, transport, or authority dependency preventing the next lawful step." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st17-partial-alive-to-blocked.json" .

st:ST18 a eco:StandingTransition ;
    dct:identifier "ST18" ; dct:title "st18-partial-alive-to-build-broken" ;
    eco:fromStanding st:PARTIAL_ALIVE ; eco:toStanding st:BUILD_BROKEN ;
    eco:promotionRule "Require observed execution of the previously unclosed build or test boundary and a concrete failure there." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st18-partial-alive-to-build-broken.json" .

st:ST19 a eco:StandingTransition ;
    dct:identifier "ST19" ; dct:title "st19-partial-alive-to-unsupported" ;
    eco:fromStanding st:PARTIAL_ALIVE ; eco:toStanding st:UNSUPPORTED ;
    eco:promotionRule "Require capability inspection proving the missing crown operation itself is unsupported, not merely failing." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st19-partial-alive-to-unsupported.json" .

st:ST20 a eco:StandingTransition ;
    dct:identifier "ST20" ; dct:title "st20-partial-alive-to-refused" ;
    eco:fromStanding st:PARTIAL_ALIVE ; eco:toStanding st:REFUSED ;
    eco:promotionRule "Require a typed policy, admission, or authority refusal on the next crown edge; prior partial evidence remains preserved." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st20-partial-alive-to-refused.json" .

st:ST21 a eco:StandingTransition ;
    dct:identifier "ST21" ; dct:title "st21-alive-to-unknown" ;
    eco:fromStanding st:ALIVE ; eco:toStanding st:UNKNOWN ;
    eco:promotionRule "Require subject identity loss or expiry/invalidation of the evidence basis; historical ALIVE receipts remain preserved." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st21-alive-to-unknown.json" .

st:ST22 a eco:StandingTransition ;
    dct:identifier "ST22" ; dct:title "st22-alive-to-partial-alive" ;
    eco:fromStanding st:ALIVE ; eco:toStanding st:PARTIAL_ALIVE ;
    eco:promotionRule "Require evidence that a previously crowned boundary no longer satisfies its exact-subject proof while some positive evidence remains valid." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st22-alive-to-partial-alive.json" .

st:ST23 a eco:StandingTransition ;
    dct:identifier "ST23" ; dct:title "st23-alive-to-blocked" ;
    eco:fromStanding st:ALIVE ; eco:toStanding st:BLOCKED ;
    eco:promotionRule "Require a newly observed external dependency that prevents current lawful execution; historical ALIVE evidence remains historical only." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st23-alive-to-blocked.json" .

st:ST24 a eco:StandingTransition ;
    dct:identifier "ST24" ; dct:title "st24-alive-to-build-broken" ;
    eco:fromStanding st:ALIVE ; eco:toStanding st:BUILD_BROKEN ;
    eco:promotionRule "Require fresh execution against the exact subject reaching a build or test boundary and failing there; stale ALIVE evidence cannot override it." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st24-alive-to-build-broken.json" .

st:ST25 a eco:StandingTransition ;
    dct:identifier "ST25" ; dct:title "st25-alive-to-unsupported" ;
    eco:fromStanding st:ALIVE ; eco:toStanding st:UNSUPPORTED ;
    eco:promotionRule "Require a changed capability boundary proving the requested current operation is unsupported; past ALIVE applies only to its original subject boundary." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st25-alive-to-unsupported.json" .

st:ST26 a eco:StandingTransition ;
    dct:identifier "ST26" ; dct:title "st26-alive-to-refused" ;
    eco:fromStanding st:ALIVE ; eco:toStanding st:REFUSED ;
    eco:promotionRule "Require a new typed policy, admission, or authority refusal for the current subject; prior ALIVE evidence does not override present authority limits." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st26-alive-to-refused.json" .

st:ST27 a eco:StandingTransition ;
    dct:identifier "ST27" ; dct:title "st27-blocked-to-unknown" ;
    eco:fromStanding st:BLOCKED ; eco:toStanding st:UNKNOWN ;
    eco:promotionRule "Require invalidation of the blocker evidence without new positive execution evidence; do not infer recovery." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st27-blocked-to-unknown.json" .

st:ST28 a eco:StandingTransition ;
    dct:identifier "ST28" ; dct:title "st28-blocked-to-partial-alive" ;
    eco:fromStanding st:BLOCKED ; eco:toStanding st:PARTIAL_ALIVE ;
    eco:promotionRule "Require evidence that the blocker cleared plus bounded positive execution evidence, while at least one crown edge remains unverified." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st28-blocked-to-partial-alive.json" .

st:ST29 a eco:StandingTransition ;
    dct:identifier "ST29" ; dct:title "st29-blocked-to-alive" ;
    eco:fromStanding st:BLOCKED ; eco:toStanding st:ALIVE ;
    eco:promotionRule "Require blocker clearance followed by fresh exact-subject execution and verifier receipt; blocker disappearance alone cannot crown ALIVE." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st29-blocked-to-alive.json" .

st:ST30 a eco:StandingTransition ;
    dct:identifier "ST30" ; dct:title "st30-blocked-to-build-broken" ;
    eco:fromStanding st:BLOCKED ; eco:toStanding st:BUILD_BROKEN ;
    eco:promotionRule "Require blocker clearance followed by attempted execution that reaches a build or test boundary and fails there." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st30-blocked-to-build-broken.json" .

st:ST31 a eco:StandingTransition ;
    dct:identifier "ST31" ; dct:title "st31-blocked-to-unsupported" ;
    eco:fromStanding st:BLOCKED ; eco:toStanding st:UNSUPPORTED ;
    eco:promotionRule "Require capability inspection showing the blocked operation is not implementable by the available capability surface, rather than merely inaccessible." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st31-blocked-to-unsupported.json" .

st:ST32 a eco:StandingTransition ;
    dct:identifier "ST32" ; dct:title "st32-blocked-to-refused" ;
    eco:fromStanding st:BLOCKED ; eco:toStanding st:REFUSED ;
    eco:promotionRule "Require discovery that the next attempted edge is prohibited by policy, admission, or authority; transport blockage alone is not refusal." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st32-blocked-to-refused.json" .

st:ST33 a eco:StandingTransition ;
    dct:identifier "ST33" ; dct:title "st33-build-broken-to-unknown" ;
    eco:fromStanding st:BUILD_BROKEN ; eco:toStanding st:UNKNOWN ;
    eco:promotionRule "Require invalidation of the exact failure evidence without successful rerun evidence; do not infer repair from disappearance of logs." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st33-build-broken-to-unknown.json" .

st:ST34 a eco:StandingTransition ;
    dct:identifier "ST34" ; dct:title "st34-build-broken-to-partial-alive" ;
    eco:fromStanding st:BUILD_BROKEN ; eco:toStanding st:PARTIAL_ALIVE ;
    eco:promotionRule "Require a state-changing repair and fresh rerun that closes the failed boundary while leaving one or more crown edges explicitly unverified." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st34-build-broken-to-partial-alive.json" .

st:ST35 a eco:StandingTransition ;
    dct:identifier "ST35" ; dct:title "st35-build-broken-to-alive" ;
    eco:fromStanding st:BUILD_BROKEN ; eco:toStanding st:ALIVE ;
    eco:promotionRule "Require a state-changing repair plus fresh exact-subject execution closing the failure and all crown edges with verifier receipt." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st35-build-broken-to-alive.json" .

st:ST36 a eco:StandingTransition ;
    dct:identifier "ST36" ; dct:title "st36-build-broken-to-blocked" ;
    eco:fromStanding st:BUILD_BROKEN ; eco:toStanding st:BLOCKED ;
    eco:promotionRule "Require a new external/tooling/transport dependency that prevents the next diagnostic or repair execution; the original build failure remains historical evidence." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st36-build-broken-to-blocked.json" .

st:ST37 a eco:StandingTransition ;
    dct:identifier "ST37" ; dct:title "st37-build-broken-to-unsupported" ;
    eco:fromStanding st:BUILD_BROKEN ; eco:toStanding st:UNSUPPORTED ;
    eco:promotionRule "Require capability inspection proving the failing operation has no supported implementation path; repeated failure alone is insufficient." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st37-build-broken-to-unsupported.json" .

st:ST38 a eco:StandingTransition ;
    dct:identifier "ST38" ; dct:title "st38-build-broken-to-refused" ;
    eco:fromStanding st:BUILD_BROKEN ; eco:toStanding st:REFUSED ;
    eco:promotionRule "Require discovery that further execution is prohibited by policy, admission, or authority; a failing build does not itself imply refusal." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st38-build-broken-to-refused.json" .

st:ST39 a eco:StandingTransition ;
    dct:identifier "ST39" ; dct:title "st39-unsupported-to-unknown" ;
    eco:fromStanding st:UNSUPPORTED ; eco:toStanding st:UNKNOWN ;
    eco:promotionRule "Require a capability-surface change or invalidation of prior unsupported evidence without enough new evidence to classify support." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st39-unsupported-to-unknown.json" .

st:ST40 a eco:StandingTransition ;
    dct:identifier "ST40" ; dct:title "st40-unsupported-to-partial-alive" ;
    eco:fromStanding st:UNSUPPORTED ; eco:toStanding st:PARTIAL_ALIVE ;
    eco:promotionRule "Require a changed capability surface plus bounded positive execution evidence, with remaining crown gaps explicit." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st40-unsupported-to-partial-alive.json" .

st:ST41 a eco:StandingTransition ;
    dct:identifier "ST41" ; dct:title "st41-unsupported-to-alive" ;
    eco:fromStanding st:UNSUPPORTED ; eco:toStanding st:ALIVE ;
    eco:promotionRule "Require a changed capability surface followed by fresh exact-subject execution and verifier receipt; capability declaration alone cannot crown ALIVE." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st41-unsupported-to-alive.json" .

st:ST42 a eco:StandingTransition ;
    dct:identifier "ST42" ; dct:title "st42-unsupported-to-blocked" ;
    eco:fromStanding st:UNSUPPORTED ; eco:toStanding st:BLOCKED ;
    eco:promotionRule "Require evidence of a potentially supported path whose evaluation is prevented by an external/tooling/transport dependency; unsupported evidence is superseded only for that changed boundary." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st42-unsupported-to-blocked.json" .

st:ST43 a eco:StandingTransition ;
    dct:identifier "ST43" ; dct:title "st43-unsupported-to-build-broken" ;
    eco:fromStanding st:UNSUPPORTED ; eco:toStanding st:BUILD_BROKEN ;
    eco:promotionRule "Require discovery of a supported execution path and an actual attempt that reaches a build or test boundary and fails there." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st43-unsupported-to-build-broken.json" .

st:ST44 a eco:StandingTransition ;
    dct:identifier "ST44" ; dct:title "st44-unsupported-to-refused" ;
    eco:fromStanding st:UNSUPPORTED ; eco:toStanding st:REFUSED ;
    eco:promotionRule "Require a typed policy, admission, or authority prohibition discovered independently of capability support; unsupported and refused remain distinct." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st44-unsupported-to-refused.json" .

st:ST45 a eco:StandingTransition ;
    dct:identifier "ST45" ; dct:title "st45-refused-to-unknown" ;
    eco:fromStanding st:REFUSED ; eco:toStanding st:UNKNOWN ;
    eco:promotionRule "Require the refusal basis to expire, be withdrawn, or lose subject correspondence without enough evidence to classify the next state." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st45-refused-to-unknown.json" .

st:ST46 a eco:StandingTransition ;
    dct:identifier "ST46" ; dct:title "st46-refused-to-partial-alive" ;
    eco:fromStanding st:REFUSED ; eco:toStanding st:PARTIAL_ALIVE ;
    eco:promotionRule "Require removal of the refusal plus bounded positive execution evidence; removal of refusal alone is not positive standing." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st46-refused-to-partial-alive.json" .

st:ST47 a eco:StandingTransition ;
    dct:identifier "ST47" ; dct:title "st47-refused-to-alive" ;
    eco:fromStanding st:REFUSED ; eco:toStanding st:ALIVE ;
    eco:promotionRule "Require removal of the refusal followed by fresh exact-subject execution and verifier receipt; authorization alone cannot crown ALIVE." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st47-refused-to-alive.json" .

st:ST48 a eco:StandingTransition ;
    dct:identifier "ST48" ; dct:title "st48-refused-to-blocked" ;
    eco:fromStanding st:REFUSED ; eco:toStanding st:BLOCKED ;
    eco:promotionRule "Require removal of the refusal followed by observation of an external/tooling/transport dependency preventing the next lawful step." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st48-refused-to-blocked.json" .

st:ST49 a eco:StandingTransition ;
    dct:identifier "ST49" ; dct:title "st49-refused-to-build-broken" ;
    eco:fromStanding st:REFUSED ; eco:toStanding st:BUILD_BROKEN ;
    eco:promotionRule "Require removal of the refusal followed by attempted execution that reaches a build or test boundary and fails there." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st49-refused-to-build-broken.json" .

st:ST50 a eco:StandingTransition ;
    dct:identifier "ST50" ; dct:title "st50-refused-to-unsupported" ;
    eco:fromStanding st:REFUSED ; eco:toStanding st:UNSUPPORTED ;
    eco:promotionRule "Require removal or irrelevance of the refusal plus capability inspection proving the requested operation is unsupported; policy and capability remain separate axes." ;
    eco:exactSubjectRequired true ;
    eco:authorityEffect "NONE" ;
    prov:hadPrimarySource "contracts/standing-transitions/st50-refused-to-unsupported.json" .
