@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix eco: <https://ggen.dev/ecosystem#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix st:  <urn:ggen-ecosystem:standing:> .

st:TransitionShape a sh:NodeShape ;
    sh:targetClass eco:StandingTransition ;
    sh:property [ sh:path dct:identifier ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path eco:fromStanding ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( st:UNKNOWN st:PARTIAL_ALIVE st:ALIVE st:BLOCKED st:BUILD_BROKEN st:UNSUPPORTED st:REFUSED ) ] ;
    sh:property [ sh:path eco:toStanding ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:in ( st:UNKNOWN st:PARTIAL_ALIVE st:ALIVE st:BLOCKED st:BUILD_BROKEN st:UNSUPPORTED st:REFUSED ) ] ;
    sh:property [ sh:path eco:promotionRule ; sh:minCount 1 ] ;
    sh:property [ sh:path eco:authorityEffect ; sh:minCount 1 ; sh:in ( "NONE" ) ] ;
    sh:property [ sh:path prov:hadPrimarySource ; sh:minCount 1 ] .

st:FoundationShape a sh:NodeShape ;
    sh:targetClass eco:StandingFoundationContract ;
    sh:property [ sh:path dct:identifier ; sh:minCount 1 ] ;
    sh:property [ sh:path eco:authorityCeiling ; sh:minCount 1 ; sh:in ( "CONSTRUCT" ) ] .
