---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch09",
  "files_and_dirs": {
    "README.md": true,
    "composition-postgresql.yaml": true,
    "crossplane-providers.yaml": true,
    "custom-infra-request.py": true,
    "demo-app-database.yaml": true,
    "generate-env-defaults.py": true,
    "ggen-create.json": true,
    "guardrail-validator.py": true,
    "lifecycle-controller.py": true,
    "load-secrets.sh": true,
    "tagging-patchset.yaml": true,
    "test-infrastructure.py": true,
    "xrd-gpu-nodepool.yaml": true,
    "xrd-postgresql.yaml": true
  },
  "templatize_using_name": "{% endraw %}{{ row.capitalized }}{% raw %}",
  "gen_parent_dir": false
}
{% endraw %}