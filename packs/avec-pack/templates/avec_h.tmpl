---
to: "include/avec.h"
sparql:
  results: |
    PREFIX av: <urn:avec:>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?kind ?label ?text WHERE {
      {
        ?s a av:CAbiStruct ;
           rdfs:label ?label ;
           av:sourceText ?text .
        BIND("struct" AS ?kind)
      }
      UNION
      {
        ?f a av:SchemaFlag ;
           rdfs:label ?label ;
           av:cFlagValue ?value .
        BIND(CONCAT("#define ", ?label, " ", STR(?value)) AS ?text)
        BIND("flag" AS ?kind)
      }
    } ORDER BY DESC(?kind) ?label
---

