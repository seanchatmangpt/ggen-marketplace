# MESSAGE: promise without backing individuals.
# Every av:Promise must have at least one p:backedBy edge to a modeled
# individual. A row is a refusal.
PREFIX av: <urn:avec:>
PREFIX p: <https://seanchatmangpt.github.io/packs/avec-pack#>
SELECT ?promise WHERE {
  ?promise a av:Promise .
  FILTER NOT EXISTS { ?promise p:backedBy ?b }
}
ORDER BY ?promise
