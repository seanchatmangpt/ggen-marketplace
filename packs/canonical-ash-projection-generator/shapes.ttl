@prefix apg: <https://ggen.dev/ash-projection#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

apg:ProfileShape a sh:NodeShape ;
  sh:targetClass apg:ProjectionProfile ;
  sh:property [ sh:path apg:namespace ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path apg:exactSubject ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path apg:generatorVersion ; sh:minCount 1 ; sh:maxCount 1 ] .

apg:ResourceShape a sh:NodeShape ;
  sh:targetClass apg:Resource ;
  sh:property [ sh:path apg:resourceName ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path apg:moduleName ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path apg:domainIri ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path apg:sourceDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path apg:attribute ; sh:minCount 1 ] .

apg:AttributeShape a sh:NodeShape ;
  sh:targetClass apg:Attribute ;
  sh:property [ sh:path apg:attributeName ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path apg:ashType ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path apg:primaryKey ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path apg:semanticPredicate ; sh:minCount 1 ; sh:maxCount 1 ] .
