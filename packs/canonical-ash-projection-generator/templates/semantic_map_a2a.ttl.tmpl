---
to: "generated/ash/semantic_map_a2a.ttl"
sparql:
  skills: |
    PREFIX apg: <https://ggen.dev/ash-projection#>
    SELECT ?module_name ?authority_gate ?skill_id ?skill_action ?consequence ?domain_iri
    WHERE {
      ?resource a apg:Resource ;
        apg:moduleName ?module_name ;
        apg:authorityGate ?authority_gate ;
        apg:domainIri ?domain_iri ;
        apg:skill ?skill .
      ?skill a apg:Skill ;
        apg:skillId ?skill_id ;
        apg:skillAction ?skill_action ;
        apg:consequence ?consequence .
    } ORDER BY ?module_name ?skill_id
  arguments: |
    PREFIX apg: <https://ggen.dev/ash-projection#>
    SELECT ?skill_id ?argument_name ?argument_type
    WHERE {
      ?skill a apg:Skill ;
        apg:skillId ?skill_id ;
        apg:argument ?argument .
      ?argument a apg:SkillArgument ;
        apg:argumentName ?argument_name ;
        apg:argumentType ?argument_type .
    } ORDER BY ?skill_id ?argument_name
---
# Generated by ggen pack canonical-ash-projection-generator. Do not edit.
#
# A2A capability surface projection, grounded in the compiled capability index
# (lib/ash_a2a/capability_index/compiler.ex): skill id "<Resource>.<action>",
# consequence defaulted from Ash action type (observe/change/external_do/unknown
# per lib/ash_a2a/skill.ex), authority gate persisted per resource
# (lib/ash_a2a/info.ex authority_gate/1, default :two_port).
#
# Vocabularies match the repository registry (lib/ash_a2a/semantic/vocabulary.ex):
# a2a: <https://a2a-protocol.org/ontology#> (the A2A Protocol v2.1.0 ontology,
# priv/sa2a/canonical/A2AProtocol_v2_1_0.ttl) and the private sa2a vocabulary
# <urn:ash-a2a:vocab:> as used by priv/sa2a/AllSA2A.ttl.
#
# Canonical identity: RDFC-1.0/SHA-256 via AshA2A.Semantic.CanonicalGraph
# (lib/ash_a2a/semantic/canonical_graph.ex). This graph mints no blank nodes --
# every skill and argument is a named IRI under urn:ash-a2a:vocab:, and each
# a2a:skillId literal is functionally unique (pack gate 040) -- so RDFC-1.0
# canonicalization is identity on named IRIs and the digest is stable under
# statement reordering and prefix relabeling.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix a2a: <https://a2a-protocol.org/ontology#> .
@prefix sa2a: <urn:ash-a2a:vocab:> .
@prefix apg: <https://ggen.dev/ash-projection#> .

# Declared vocabulary so every skill IRI resolves to a declared class.
a2a:Skill a owl:Class .
sa2a:Skill a owl:Class ; rdfs:subClassOf a2a:Skill .
sa2a:SkillArgument a owl:Class .
sa2a:consequence a rdf:Property .
sa2a:authorityGate a rdf:Property .
sa2a:projectsAction a rdf:Property .
sa2a:projectsResource a rdf:Property .
sa2a:argument a rdf:Property .
sa2a:argumentName a rdf:Property .
sa2a:argumentType a rdf:Property .

{% for s in skills %}
# skill {{ s.skill_id }} -- action {{ s.skill_action }}, consequence {{ s.consequence }}, authority gate {{ s.authority_gate }}
sa2a:skill-{{ s.skill_id | replace(from=".", to="_") }} a sa2a:Skill, a2a:Skill ;
  sa2a:consequence "{{ s.consequence }}" ;
  sa2a:authorityGate "{{ s.authority_gate }}" ;
  sa2a:projectsAction "{{ s.skill_action }}" ;
  sa2a:projectsResource <{{ s.domain_iri }}> ;
  a2a:skillId "{{ s.skill_id }}" .
{% for a in arguments %}{% if a.skill_id == s.skill_id %}
sa2a:skill-{{ a.skill_id | replace(from=".", to="_") }} sa2a:argument sa2a:argument-{{ a.skill_id | replace(from=".", to="_") }}_{{ a.argument_name }} .
sa2a:argument-{{ a.skill_id | replace(from=".", to="_") }}_{{ a.argument_name }} a sa2a:SkillArgument ;
  sa2a:argumentType "{{ a.argument_type }}" ;
  sa2a:argumentName "{{ a.argument_name }}" .
{% endif %}{% endfor %}
{% endfor %}
