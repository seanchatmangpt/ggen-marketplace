@prefix map: <https://ggen.dev/ash-projection/map#> .
@prefix apg: <https://ggen.dev/ash-projection#> .

map:{{ module_name }} a apg:SemanticBinding ;
  apg:exactSubject "{{ exact_subject }}" ;
  apg:domainIri <{{ domain_iri }}> ;
  apg:sourceDigest "{{ source_digest }}" ;
{% for attribute in attributes %}
  apg:attribute map:{{ module_name }}_{{ attribute.name }}{% if not loop.last %} ;{% else %} .{% endif %}

map:{{ module_name }}_{{ attribute.name }} a apg:Attribute ;
  apg:attributeName "{{ attribute.name }}" ;
  apg:ashType "{{ attribute.type }}" ;
  apg:primaryKey {{ attribute.primary_key }} ;
  apg:semanticPredicate <{{ attribute.semantic_predicate }}> .
{% endfor %}
