PREFIX apg: <https://ggen.dev/ash-projection#>
SELECT ?namespace ?module_name ?exact_subject ?domain_iri ?source_digest
       ?attribute_name ?ash_type ?primary_key ?semantic_predicate
WHERE {
  ?profile a apg:ProjectionProfile ;
    apg:namespace ?namespace ;
    apg:exactSubject ?exact_subject .
  ?resource a apg:Resource ;
    apg:moduleName ?module_name ;
    apg:domainIri ?domain_iri ;
    apg:sourceDigest ?source_digest ;
    apg:attribute ?attribute .
  ?attribute apg:attributeName ?attribute_name ;
    apg:ashType ?ash_type ;
    apg:primaryKey ?primary_key ;
    apg:semanticPredicate ?semantic_predicate .
}
ORDER BY ?module_name ?attribute_name ?semantic_predicate
