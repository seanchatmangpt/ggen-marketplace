# A2A capability surface: one row per compiled skill, with its resource's
# authority gate (lib/ash_a2a/capability_index/compiler.ex shape).
PREFIX apg: <https://ggen.dev/ash-projection#>
SELECT ?module_name ?authority_gate ?skill_id ?skill_action ?consequence ?domain_iri
WHERE {
  ?resource a apg:Resource ;
    apg:moduleName ?module_name ;
    apg:authorityGate ?authority_gate ;
    apg:domainIri ?domain_iri ;
    apg:skill ?skill .
  ?skill a apg:Skill ;
    apg:skillId ?skill_id ;
    apg:skillAction ?skill_action ;
    apg:consequence ?consequence .
} ORDER BY ?module_name ?skill_id
