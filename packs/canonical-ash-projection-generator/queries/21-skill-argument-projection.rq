# Per-skill typed arguments (lib/ash_a2a/capability_index/compiler.ex
# derive_arguments/2: declared public arguments plus accepted attributes).
PREFIX apg: <https://ggen.dev/ash-projection#>
SELECT ?skill_id ?argument_name ?argument_type
WHERE {
  ?skill a apg:Skill ;
    apg:skillId ?skill_id ;
    apg:argument ?argument .
  ?argument a apg:SkillArgument ;
    apg:argumentName ?argument_name ;
    apg:argumentType ?argument_type .
} ORDER BY ?skill_id ?argument_name
