@prefix apg: <https://ggen.dev/ash-projection#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

apg:ProjectionProfile a rdfs:Class .
apg:Resource a rdfs:Class .
apg:Attribute a rdfs:Class .
apg:SemanticBinding a rdfs:Class .
apg:Witness a rdfs:Class .

apg:namespace a rdf:Property .
apg:moduleName a rdf:Property .
apg:resourceName a rdf:Property .
apg:attribute a rdf:Property .
apg:attributeName a rdf:Property .
apg:ashType a rdf:Property .
apg:primaryKey a rdf:Property .
apg:semanticPredicate a rdf:Property .
apg:domainIri a rdf:Property .
apg:exactSubject a rdf:Property .
apg:sourceDigest a rdf:Property .
apg:generatorVersion a rdf:Property .

apg:AtlassianProfile a apg:ProjectionProfile ;
  apg:namespace "AshAtlassian.Generated" ;
  apg:generatorVersion "v26.9.25" ;
  apg:exactSubject "ash_atlassian:generated-resource-projection" .

apg:Issue a apg:Resource ;
  apg:resourceName "Issue" ;
  apg:moduleName "Issue" ;
  apg:domainIri <https://atlassian.com/ns/jira#Issue> ;
  apg:sourceDigest "fixture:issue:v1" ;
  apg:attribute apg:IssueKey, apg:IssueSummary .

apg:IssueKey a apg:Attribute ;
  apg:attributeName "key" ;
  apg:ashType "string" ;
  apg:primaryKey true ;
  apg:semanticPredicate <https://atlassian.com/ns/jira#key> .

apg:IssueSummary a apg:Attribute ;
  apg:attributeName "summary" ;
  apg:ashType "string" ;
  apg:primaryKey false ;
  apg:semanticPredicate <https://atlassian.com/ns/jira#summary> .
