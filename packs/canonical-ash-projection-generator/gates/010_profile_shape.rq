# MESSAGE: ProjectionProfile violates the cardinality constraints migrated from shapes.ttl (apg:ProjectionProfileShape).
PREFIX apg: <https://ggen.dev/ash-projection#>
SELECT DISTINCT ?subject ?problem WHERE {
  {
    ?subject a apg:ProjectionProfile .
    FILTER NOT EXISTS { ?subject apg:namespace ?v }
    BIND("ProjectionProfile-missing-namespace" AS ?problem)
  }
  UNION
  {
    ?subject a apg:ProjectionProfile ; apg:namespace ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("ProjectionProfile-multiple-namespace" AS ?problem)
  }
  UNION
  {
    ?subject a apg:ProjectionProfile .
    FILTER NOT EXISTS { ?subject apg:exactSubject ?v }
    BIND("ProjectionProfile-missing-exactSubject" AS ?problem)
  }
  UNION
  {
    ?subject a apg:ProjectionProfile ; apg:exactSubject ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("ProjectionProfile-multiple-exactSubject" AS ?problem)
  }
  UNION
  {
    ?subject a apg:ProjectionProfile .
    FILTER NOT EXISTS { ?subject apg:generatorVersion ?v }
    BIND("ProjectionProfile-missing-generatorVersion" AS ?problem)
  }
  UNION
  {
    ?subject a apg:ProjectionProfile ; apg:generatorVersion ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("ProjectionProfile-multiple-generatorVersion" AS ?problem)
  }
}
ORDER BY ?subject ?problem
