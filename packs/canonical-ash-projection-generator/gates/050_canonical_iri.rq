# MESSAGE: the capability surface must canonicalize without blank-node
# ambiguity -- RDFC-1.0 (AshA2A.Semantic.CanonicalGraph,
# lib/ash_a2a/semantic/canonical_graph.ex) hashes blank-node first-degree and
# n-degree hashes, so any blank node in the skill surface makes the projection
# digest identity-dependent on canonicalization rather than on named IRIs.
# Skills and their arguments MUST be named IRIs.
PREFIX apg: <https://ggen.dev/ash-projection#>
SELECT ?subject ?problem WHERE {
  {
    ?subject a apg:Skill .
    FILTER (!ISIRI(?subject))
    BIND("skill-is-not-a-named-IRI" AS ?problem)
  }
  UNION
  {
    ?subject a apg:SkillArgument .
    FILTER (!ISIRI(?subject))
    BIND("skill-argument-is-not-a-named-IRI" AS ?problem)
  }
  UNION
  {
    ?resource a apg:Resource ; apg:skill ?skill .
    FILTER (!ISIRI(?skill))
    BIND("resource-skill-link-is-not-a-named-IRI" AS ?problem)
  }
}
ORDER BY ?subject ?problem
