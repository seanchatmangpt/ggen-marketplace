# MESSAGE: apg:Skill individuals violate the capability-surface cardinality
# constraints (mirrors lib/ash_a2a/capability_index/compiler.ex project/3:
# exactly one skillId, one action, one consequence per skill; the owning
# resource carries an authority gate).
PREFIX apg: <https://ggen.dev/ash-projection#>
SELECT DISTINCT ?subject ?problem WHERE {
  {
    ?subject a apg:Skill .
    FILTER NOT EXISTS { ?subject apg:skillId ?v }
    BIND("Skill-missing-skillId" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Skill ; apg:skillId ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Skill-multiple-skillId" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Skill .
    FILTER NOT EXISTS { ?subject apg:skillAction ?v }
    BIND("Skill-missing-skillAction" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Skill ; apg:skillAction ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Skill-multiple-skillAction" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Skill .
    FILTER NOT EXISTS { ?subject apg:consequence ?v }
    BIND("Skill-missing-consequence" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Skill ; apg:consequence ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Skill-multiple-consequence" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Skill .
    FILTER NOT EXISTS {
      ?resource a apg:Resource ; apg:skill ?subject ; apg:authorityGate ?gate .
    }
    BIND("Skill-not-linked-to-gated-resource" AS ?problem)
  }
  UNION
  {
    ?resource a apg:Resource ; apg:authorityGate ?g1 , ?g2 .
    FILTER (?g1 != ?g2)
    BIND("Resource-multiple-authorityGate" AS ?problem)
  }
  UNION
  {
    ?skill a apg:Skill ; apg:argument ?argument .
    FILTER NOT EXISTS {
      ?argument a apg:SkillArgument ;
        apg:argumentName ?an ;
        apg:argumentType ?at .
    }
    BIND("SkillArgument-missing-name-or-type" AS ?problem)
  }
}
ORDER BY ?subject ?problem
