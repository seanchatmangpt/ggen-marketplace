# MESSAGE: Resource violates the cardinality constraints migrated from shapes.ttl (apg:ResourceShape).
PREFIX apg: <https://ggen.dev/ash-projection#>
SELECT DISTINCT ?subject ?problem WHERE {
  {
    ?subject a apg:Resource .
    FILTER NOT EXISTS { ?subject apg:resourceName ?v }
    BIND("Resource-missing-resourceName" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Resource ; apg:resourceName ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Resource-multiple-resourceName" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Resource .
    FILTER NOT EXISTS { ?subject apg:moduleName ?v }
    BIND("Resource-missing-moduleName" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Resource ; apg:moduleName ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Resource-multiple-moduleName" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Resource .
    FILTER NOT EXISTS { ?subject apg:domainIri ?v }
    BIND("Resource-missing-domainIri" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Resource ; apg:domainIri ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Resource-multiple-domainIri" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Resource .
    FILTER NOT EXISTS { ?subject apg:sourceDigest ?v }
    BIND("Resource-missing-sourceDigest" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Resource ; apg:sourceDigest ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Resource-multiple-sourceDigest" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Resource .
    FILTER NOT EXISTS { ?subject apg:attribute ?v }
    BIND("Resource-missing-attribute" AS ?problem)
  }
}
ORDER BY ?subject ?problem
