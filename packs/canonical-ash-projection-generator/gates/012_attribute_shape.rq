# MESSAGE: Attribute violates the cardinality constraints migrated from shapes.ttl (apg:AttributeShape).
PREFIX apg: <https://ggen.dev/ash-projection#>
SELECT DISTINCT ?subject ?problem WHERE {
  {
    ?subject a apg:Attribute .
    FILTER NOT EXISTS { ?subject apg:attributeName ?v }
    BIND("Attribute-missing-attributeName" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Attribute ; apg:attributeName ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Attribute-multiple-attributeName" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Attribute .
    FILTER NOT EXISTS { ?subject apg:ashType ?v }
    BIND("Attribute-missing-ashType" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Attribute ; apg:ashType ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Attribute-multiple-ashType" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Attribute .
    FILTER NOT EXISTS { ?subject apg:primaryKey ?v }
    BIND("Attribute-missing-primaryKey" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Attribute ; apg:primaryKey ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Attribute-multiple-primaryKey" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Attribute .
    FILTER NOT EXISTS { ?subject apg:semanticPredicate ?v }
    BIND("Attribute-missing-semanticPredicate" AS ?problem)
  }
  UNION
  {
    ?subject a apg:Attribute ; apg:semanticPredicate ?v1 , ?v2 .
    FILTER (?v1 != ?v2)
    BIND("Attribute-multiple-semanticPredicate" AS ?problem)
  }
}
ORDER BY ?subject ?problem
