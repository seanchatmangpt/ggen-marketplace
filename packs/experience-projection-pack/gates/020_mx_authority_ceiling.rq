# MESSAGE: An observation or planning projection in xp:MachineExperienceProjection
# must never carry DO authority. If xp:hasAuthorityBoundary is "OBSERVE" or "SELECT",
# asserting xp:hasDOAuthority true is refused outright. Consequential DO belongs
# exclusively behind the admitted runtime/BRCE consequence boundary.
PREFIX xp:  <https://ggen.dev/ontology/experience-projection#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?projection ?boundary WHERE {
  ?projection a xp:MachineExperienceProjection ;
              xp:hasAuthorityBoundary ?boundary ;
              xp:hasDOAuthority true .
  FILTER(?boundary IN ("OBSERVE", "SELECT", "CONSTRUCT"))
}
ORDER BY ?projection
