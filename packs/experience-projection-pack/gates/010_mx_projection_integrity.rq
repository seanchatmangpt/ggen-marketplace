# MESSAGE: A xp:MachineExperienceProjection is only lawful MX if all four of
# its machine-readiness booleans -- xp:discoverable, xp:composable,
# xp:verifiable, xp:replayable -- are asserted true. Any MX individual
# missing one of these properties (an unmet requirement, not an implicit
# pass) or asserting any of them as literal false is refused. A
# HumanExperienceProjection of the same capability is never subject to this
# gate -- humans are not required to be
# discoverable/composable/verifiable/replayable.
#
# Each row names the offending projection and the specific property that is
# false or missing.
PREFIX xp: <https://ggen.dev/ontology/experience-projection#>
SELECT ?projection ?property WHERE {
  ?projection a xp:MachineExperienceProjection .
  VALUES ?property { xp:discoverable xp:composable xp:verifiable xp:replayable }
  OPTIONAL { ?projection ?property ?value }
  FILTER(!BOUND(?value) || ?value = false)
}
ORDER BY ?projection ?property
