@prefix xp: <https://ggen.dev/ontology/experience-projection#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Minimal independent positive qualification fixture: a second, distinct
# capability with its own lawful MX projection and its own human
# projection, so scripts/qualify_packs.py's qualify_pack() has real
# consumer-side facts to render/query against beyond the pack's own worked
# example. This fixture is fully lawful (all four MX booleans true) and
# must NOT trigger gates/010_mx_projection_integrity.rq.

xp:ResolvePackDependenciesCapability a xp:Capability ;
    rdfs:label "Resolve a consuming project's pack dependency closure" .

xp:ResolvePackDependenciesCapability-MX a xp:MachineExperienceProjection ;
    rdfs:label "Machine-readable projection of dependency resolution, usable by CI" ;
    xp:projectionOf xp:ResolvePackDependenciesCapability ;
    xp:discoverable true ;
    xp:composable true ;
    xp:verifiable true ;
    xp:replayable true .

xp:ResolvePackDependenciesCapability-HX a xp:HumanExperienceProjection ;
    rdfs:label "Human-readable projection: a maintainer-facing dependency graph explainer" ;
    xp:projectionOf xp:ResolvePackDependenciesCapability ;
    xp:renderedFor "docs/explanation/dependency-resolution.md" .
