@prefix xp: <https://ggen.dev/ontology/experience-projection#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

xp:SemanticView a rdfs:Class .
xp:UIProjection a rdfs:Class .
xp:Primitive a rdfs:Class .
xp:Layout a rdfs:Class .
xp:Fixture a rdfs:Class .
xp:Profile a rdfs:Class .
xp:MachineExperience a rdfs:Class .
xp:source a rdf:Property .
xp:profile a rdf:Property .
xp:usesPrimitive a rdf:Property .
xp:machineDiscoverable a rdf:Property .
xp:formalSemantics a rdf:Property .
xp:composable a rdf:Property .
xp:deterministic a rdf:Property .
xp:verifiable a rdf:Property .
xp:repairable a rdf:Property .
xp:replayable a rdf:Property .
xp:authorityExplicit a rdf:Property .
xp:requiresHumanInterpretation a rdf:Property .

xp:MachineExperienceProfile a xp:Profile, xp:MachineExperience ;
  xp:machineDiscoverable true ;
  xp:formalSemantics true ;
  xp:composable true ;
  xp:deterministic true ;
  xp:verifiable true ;
  xp:repairable true ;
  xp:replayable true ;
  xp:authorityExplicit true ;
  xp:requiresHumanInterpretation false ;
  rdfs:comment "Machine Experience optimizes interfaces for machine discovery, composition, verification, repair and replay. Hidden conventions, prose-only semantics, guessed intent or required human explanation degrade MX." .
