@prefix xp: <https://ggen.dev/ontology/experience-projection#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== CLASSES =====
# xp:Capability is the single underlying thing being projected. It may be
# projected two ways from the same source: xp:MachineExperienceProjection
# (MX -- consumed by another program/agent, must be discoverable,
# composable, verifiable, replayable) and xp:HumanExperienceProjection
# (consumed by a person, no machine-readiness properties required). Both
# projections point back to the same xp:Capability via xp:projectionOf, so
# a consumer can confirm the two projections are of one real capability,
# not two unrelated ones.
xp:Capability a rdfs:Class .
xp:MachineExperienceProjection a rdfs:Class .
xp:HumanExperienceProjection a rdfs:Class .

# ===== PROPERTIES =====
xp:projectionOf a rdf:Property ;
    rdfs:comment "Links a projection (machine or human) back to the xp:Capability it projects." .

xp:discoverable a rdf:Property ;
    rdfs:domain xp:MachineExperienceProjection ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True iff the projection can be enumerated/found by another program without out-of-band knowledge." .

xp:composable a rdf:Property ;
    rdfs:domain xp:MachineExperienceProjection ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True iff the projection can be combined with other MX projections without hidden coupling." .

xp:verifiable a rdf:Property ;
    rdfs:domain xp:MachineExperienceProjection ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True iff a consumer can independently check the projection's output against the capability's contract." .

xp:replayable a rdf:Property ;
    rdfs:domain xp:MachineExperienceProjection ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True iff invoking the projection again with the same inputs deterministically reproduces the same output." .

xp:renderedFor a rdf:Property ;
    rdfs:domain xp:HumanExperienceProjection ;
    rdfs:comment "Free-text label naming the human audience/medium this projection targets (e.g. a UI, a doc page)." .

# ===== REAL INDIVIDUALS =====
# The one underlying capability both projections are of.
xp:PublishPackCapability a xp:Capability ;
    rdfs:label "Publish a ggen marketplace pack to the catalog" .

# A lawful machine-experience projection of that capability: every
# machine-readiness property is real and true, so it passes the gate.
xp:PublishPackCapability-MX a xp:MachineExperienceProjection ;
    rdfs:label "Machine-readable projection: pack publish as a discoverable/composable/verifiable/replayable operation" ;
    xp:projectionOf xp:PublishPackCapability ;
    xp:discoverable true ;
    xp:composable true ;
    xp:verifiable true ;
    xp:replayable true .

# A human-experience projection of the same underlying capability -- no
# machine-readiness properties are declared or required for this class.
xp:PublishPackCapability-HX a xp:HumanExperienceProjection ;
    rdfs:label "Human-readable projection: a how-to page walking a maintainer through publishing a pack" ;
    xp:projectionOf xp:PublishPackCapability ;
    xp:renderedFor "docs/how-to/publish-a-pack.md" .
