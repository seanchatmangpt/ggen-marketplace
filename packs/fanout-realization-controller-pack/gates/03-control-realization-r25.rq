PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
ASK WHERE {
  FILTER NOT EXISTS { ?x frc:actuationPerformed true }
  FILTER NOT EXISTS { ?d a frc:ControlDecision . FILTER NOT EXISTS { ?d frc:current true ; frc:exactSubject ?subject ; frc:receiptDigest ?receipt . } }
  FILTER NOT EXISTS { ?o a frc:ControlOutcome ; frc:selected true . FILTER NOT EXISTS { ?o frc:current true ; frc:evidenceRoot ?root ; frc:receiptDigest ?receipt . } }
}
