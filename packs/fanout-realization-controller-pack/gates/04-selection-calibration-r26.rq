PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
ASK {
 FILTER NOT EXISTS {
  ?d a frc:ControlDecision ; frc:current true ; frc:authority ?authority ; frc:actuationPerformed ?acted .
  FILTER(?authority != "SELECT" || ?acted != false)
 }
 FILTER NOT EXISTS {
  ?o a frc:ControlOutcome ; frc:selected true ; frc:current true ; frc:receipt ?receipt ; frc:exactSubject ?subject ; frc:authority ?authority ; frc:actuationPerformed ?acted .
  FILTER(STRLEN(STR(?receipt)) = 0 || !CONTAINS(STR(?subject), "@") || ?authority != "VERIFY" || ?acted != false)
 }
}
