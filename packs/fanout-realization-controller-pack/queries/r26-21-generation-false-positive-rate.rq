PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?generation (COUNT(?outcome) AS ?selected) (SUM(IF(?value <= 0, 1, 0)) AS ?falsePositive) WHERE {
  ?decision a frc:ControlDecision ; frc:controlGeneration ?generation ; frc:current true .
  ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedValueUnits ?value ; frc:current true .
} GROUP BY ?generation ORDER BY DESC(?generation)
