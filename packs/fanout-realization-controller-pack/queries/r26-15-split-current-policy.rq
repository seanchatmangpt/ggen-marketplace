PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?generation (COUNT(DISTINCT ?policy) AS ?policies) WHERE {
  ?decision a frc:ControlDecision ; frc:controlGeneration ?generation ; frc:policyDigest ?policy ; frc:current true .
} GROUP BY ?generation HAVING(COUNT(DISTINCT ?policy) > 1) ORDER BY DESC(?generation)
