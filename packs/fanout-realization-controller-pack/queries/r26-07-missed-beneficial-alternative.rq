PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?edge ?actions ?relief
WHERE {
 ?o a frc:ControlOutcome ; frc:decision ?decision ; frc:edge ?edge ; frc:observedAlternative true ; frc:realizedQualifiedActions ?actions ; frc:realizedDependencyRelief ?relief .
 FILTER(?actions > 0 || ?relief > 0)
}
ORDER BY DESC(?relief) DESC(?actions) ?decision ?edge
