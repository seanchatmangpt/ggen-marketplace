PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT (COUNT(?o) AS ?selectedCount) (SUM(IF(?beneficial,1,0)) AS ?truePositive) (IF(COUNT(?o)=0,0,SUM(IF(?beneficial,1,0))/COUNT(?o)) AS ?precision)
WHERE {
 ?o a frc:ControlOutcome ; frc:selected true ; frc:realizedQualifiedActions ?actions ; frc:realizedDependencyRelief ?relief .
 BIND((?actions > 0 || ?relief > 0) AS ?beneficial)
}
