PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?subject (COUNT(DISTINCT ?policy) AS ?policyCount) (COUNT(DISTINCT ?generation) AS ?generationCount) WHERE {
  ?decision a frc:ControlDecision ; frc:exactSubject ?subject ; frc:policyDigest ?policy ; frc:controlGeneration ?generation .
} GROUP BY ?subject HAVING(COUNT(DISTINCT ?policy) > 1) ORDER BY DESC(?policyCount) ?subject
