PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT (COUNT(?o) AS ?observedBeneficial) (SUM(IF(?selected,1,0)) AS ?captured) (IF(COUNT(?o)=0,0,SUM(IF(?selected,1,0))/COUNT(?o)) AS ?recall)
WHERE {
 ?o a frc:ControlOutcome ; frc:selected ?selected ; frc:realizedQualifiedActions ?actions ; frc:realizedDependencyRelief ?relief .
 FILTER(?selected || EXISTS { ?o frc:observedAlternative true })
 FILTER(?actions > 0 || ?relief > 0)
}
