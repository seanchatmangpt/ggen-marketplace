PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT (SUM(?cost) AS ?totalCost) (SUM(?actions) AS ?qualifiedActions) (IF(SUM(?actions)=0,SUM(?cost),SUM(?cost)/SUM(?actions)) AS ?costPerAction)
WHERE { ?o a frc:ControlOutcome ; frc:selected true ; frc:current true ; frc:realizedQualifiedActions ?actions ; frc:realizedCost ?cost ; frc:actuationPerformed false . }
