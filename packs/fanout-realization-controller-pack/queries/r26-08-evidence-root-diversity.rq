PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision (COUNT(DISTINCT ?root) AS ?independentRoots) (COUNT(?o) AS ?outcomes)
WHERE {
 ?o a frc:ControlOutcome ; frc:decision ?decision ; frc:evidenceRoot ?root .
}
GROUP BY ?decision
ORDER BY DESC(?independentRoots) ?decision
