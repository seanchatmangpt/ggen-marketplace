PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?tp ?fp ?fn (IF((2*?tp+?fp+?fn)=0,0,(2*?tp)/(2*?tp+?fp+?fn)) AS ?f1)
WHERE {
 { SELECT (SUM(IF(?selected && ?beneficial,1,0)) AS ?tp) (SUM(IF(?selected && !?beneficial,1,0)) AS ?fp) (SUM(IF(!?selected && ?beneficial,1,0)) AS ?fn)
   WHERE { ?o a frc:ControlOutcome ; frc:selected ?selected ; frc:realizedQualifiedActions ?a ; frc:realizedDependencyRelief ?r . BIND((?a>0 || ?r>0) AS ?beneficial) } }
}
