PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?subject ?policy ?generation ?value ?relief ?root WHERE {
  ?decision a frc:ControlDecision ; frc:policyDigest ?policy ; frc:controlGeneration ?generation ; frc:exactSubject ?subject ; frc:current true ; frc:actuationPerformed false .
  ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedValueUnits ?value ; frc:realizedDependencyRelief ?relief ; frc:evidenceRoot ?root ; frc:current true ; frc:standing "PARTIAL_ALIVE" ; frc:actuationPerformed false .
  FILTER(?value > 0 && ?relief > 0)
} ORDER BY DESC(?generation) ?subject ?decision
