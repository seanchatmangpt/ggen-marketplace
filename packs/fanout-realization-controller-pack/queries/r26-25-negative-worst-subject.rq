PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?subject (MIN(?value) AS ?worstValue) WHERE {
  ?outcome a frc:ControlOutcome ; frc:selected true ; frc:realizedValueUnits ?value ; frc:exactSubject ?subject ; frc:current true .
} GROUP BY ?subject HAVING(MIN(?value) <= 0) ORDER BY ?worstValue ?subject
