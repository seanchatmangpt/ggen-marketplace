PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT (SUM(IF(?selected && ?beneficial,1,0)) AS ?tp) (SUM(IF(?selected && !?beneficial,1,0)) AS ?fp) (SUM(IF(!?selected && ?beneficial,1,0)) AS ?fn) (SUM(IF(!?selected && !?beneficial,1,0)) AS ?tn)
WHERE {
  ?o a frc:ControlOutcome ; frc:selected ?selected ; frc:observedAlternative ?alternative ; frc:realizedQualifiedActions ?actions ; frc:realizedDependencyRelief ?relief .
  BIND((?actions > 0 || ?relief > 0) AS ?beneficial)
}
