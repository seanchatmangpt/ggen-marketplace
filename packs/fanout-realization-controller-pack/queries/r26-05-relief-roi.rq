PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?edge ?relief ?cost (IF(?cost=0,?relief,?relief/?cost) AS ?reliefRoi)
WHERE {
 ?o a frc:ControlOutcome ; frc:decision ?decision ; frc:edge ?edge ; frc:selected true ; frc:realizedDependencyRelief ?relief ; frc:realizedCost ?cost .
}
ORDER BY DESC(?reliefRoi) ?decision ?edge
