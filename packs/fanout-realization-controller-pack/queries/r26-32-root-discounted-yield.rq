PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision (SUM(?actions) AS ?actions) (COUNT(?o) AS ?outcomes) (COUNT(DISTINCT ?root) AS ?roots) ((SUM(?actions)*COUNT(DISTINCT ?root))/COUNT(?o) AS ?rootDiscountedActions)
WHERE {
 ?o a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedQualifiedActions ?actions ; frc:evidenceRoot ?root .
}
GROUP BY ?decision
ORDER BY DESC(?rootDiscountedActions) ?decision
