PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?subject (MAX(?alternativeValue - ?selectedValue) AS ?worstObservedRegret) WHERE {
  ?selected a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedValueUnits ?selectedValue ; frc:exactSubject ?subject ; frc:current true .
  ?alternative a frc:ControlOutcome ; frc:decision ?decision ; frc:observedAlternative true ; frc:realizedValueUnits ?alternativeValue ; frc:current true .
} GROUP BY ?subject ORDER BY DESC(?worstObservedRegret) ?subject
