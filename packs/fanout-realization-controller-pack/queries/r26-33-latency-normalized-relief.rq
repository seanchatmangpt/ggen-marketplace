PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?edge ?relief ?latency (IF(?latency=0,?relief,?relief/?latency) AS ?reliefPerLatency)
WHERE {
 ?o a frc:ControlOutcome ; frc:decision ?decision ; frc:edge ?edge ; frc:selected true ; frc:realizedDependencyRelief ?relief ; frc:realizedLatency ?latency .
}
ORDER BY DESC(?reliefPerLatency) ?decision ?edge
