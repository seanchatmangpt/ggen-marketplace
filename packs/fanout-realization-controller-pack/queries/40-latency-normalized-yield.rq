PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?r ?realized ?latency (?realized * 1000.0 / ?latency AS ?latencyYield) WHERE {
  ?r a frc:FanoutRealization ; frc:realizedQualifiedActions ?realized ; frc:latencyMs ?latency .
  FILTER(?latency > 0)
}
ORDER BY DESC(?latencyYield) ?r
