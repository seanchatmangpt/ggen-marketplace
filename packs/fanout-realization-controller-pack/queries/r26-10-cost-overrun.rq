PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?subject (?realized - ?predicted AS ?costOverrun) WHERE {
  ?decision a frc:ControlDecision ; frc:predictedCostUnits ?predicted ; frc:exactSubject ?subject ; frc:current true .
  ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedCostUnits ?realized ; frc:current true .
  FILTER(?realized > ?predicted)
} ORDER BY DESC(?costOverrun) ?subject
