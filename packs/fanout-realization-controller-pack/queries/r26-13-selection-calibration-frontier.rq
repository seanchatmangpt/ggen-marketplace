PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?edge ?actions ?relief ?cost ?root
WHERE {
 ?o a frc:ControlOutcome ; frc:decision ?decision ; frc:edge ?edge ; frc:selected true ; frc:realizedQualifiedActions ?actions ; frc:realizedDependencyRelief ?relief ; frc:realizedCost ?cost ; frc:evidenceRoot ?root ; frc:standing ?standing ; frc:current true ; frc:receipt ?receipt ; frc:actuationPerformed false .
 FILTER(?standing != "BUILD_BROKEN" && ?standing != "BLOCKED")
 FILTER(?actions > 0 || ?relief > 0)
 FILTER NOT EXISTS { ?other a frc:ControlOutcome ; frc:selected true ; frc:realizedQualifiedActions ?oa ; frc:realizedDependencyRelief ?or ; frc:realizedCost ?oc . FILTER(?oa >= ?actions && ?or >= ?relief && ?oc <= ?cost && (?oa > ?actions || ?or > ?relief || ?oc < ?cost)) }
}
ORDER BY DESC(?relief) DESC(?actions) ?cost ?decision ?edge
