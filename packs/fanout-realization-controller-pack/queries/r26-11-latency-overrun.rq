PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?subject (?realized - ?predicted AS ?latencyOverrunMs) WHERE {
  ?decision a frc:ControlDecision ; frc:predictedLatencyMs ?predicted ; frc:exactSubject ?subject ; frc:current true .
  ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedLatencyMs ?realized ; frc:current true .
  FILTER(?realized > ?predicted)
} ORDER BY DESC(?latencyOverrunMs) ?subject
