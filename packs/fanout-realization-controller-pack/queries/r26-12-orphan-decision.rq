PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?edge ?generation
WHERE {
 ?decision a frc:ControlDecision ; frc:selectedEdge ?edge ; frc:generation ?generation ; frc:current true .
 FILTER NOT EXISTS { ?o a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true }
}
ORDER BY DESC(?generation) ?decision
