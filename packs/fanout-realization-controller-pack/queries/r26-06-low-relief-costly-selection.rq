PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?edge ?cost ?relief
WHERE {
 ?o a frc:ControlOutcome ; frc:decision ?decision ; frc:edge ?edge ; frc:selected true ; frc:realizedCost ?cost ; frc:realizedDependencyRelief ?relief .
 FILTER(?cost > 0 && ?relief <= 0)
}
ORDER BY DESC(?cost) ?decision ?edge
