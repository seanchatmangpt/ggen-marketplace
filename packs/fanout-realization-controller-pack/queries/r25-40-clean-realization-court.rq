PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
ASK WHERE {
  FILTER NOT EXISTS { ?x frc:actuationPerformed true }
  FILTER NOT EXISTS { ?x frc:authority "DO" }
  FILTER NOT EXISTS { ?d a frc:ControlDecision . FILTER NOT EXISTS { ?d frc:current true ; frc:exactSubject ?s ; frc:receiptDigest ?r . FILTER(regex(str(?s),"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}$") && regex(str(?r),"^[0-9a-f]{64}$")) } }
  FILTER NOT EXISTS { ?o a frc:ControlOutcome ; frc:selected true . FILTER NOT EXISTS { ?o frc:current true ; frc:receiptDigest ?r . FILTER(regex(str(?r),"^[0-9a-f]{64}$")) } }
}
