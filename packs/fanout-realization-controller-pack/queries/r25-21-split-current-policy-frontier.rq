PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?generation (COUNT(DISTINCT ?digest) AS ?digests) WHERE { ?d a frc:ControlDecision ; frc:current true ; frc:controlGeneration ?generation ; frc:policyDigest ?digest . } GROUP BY ?generation HAVING(COUNT(DISTINCT ?digest) > 1)
