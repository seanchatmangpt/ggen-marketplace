PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?d ?selectedYield ?alternativeYield WHERE { ?s frc:decision ?d ; frc:selected true ; frc:realizedQualifiedActions ?selectedYield . ?a frc:decision ?d ; frc:selected false ; frc:observedAlternative true ; frc:realizedQualifiedActions ?alternativeYield . FILTER(?alternativeYield > ?selectedYield) }
