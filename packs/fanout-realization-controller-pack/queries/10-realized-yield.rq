PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?r ?realized ?investment (?realized / ?investment AS ?realizedY) WHERE {
  ?r a frc:FanoutRealization ; frc:realizedQualifiedActions ?realized ; frc:investmentUnits ?investment .
  FILTER(?investment > 0)
}
ORDER BY DESC(?realizedY) ?r
