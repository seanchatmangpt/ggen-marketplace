PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?o ?actions ?cost WHERE { ?o a frc:ControlOutcome ; frc:selected true ; frc:current true ; frc:realizedQualifiedActions ?actions ; frc:realizedCost ?cost ; frc:actuationPerformed false . FILTER(?cost > 0 && ?actions <= 0) } ORDER BY DESC(?cost)
