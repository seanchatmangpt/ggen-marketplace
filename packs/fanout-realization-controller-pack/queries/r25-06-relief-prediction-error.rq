PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?d ?predicted ?realized (?realized-?predicted AS ?error) WHERE { ?d a frc:ControlDecision ; frc:predictedDependencyRelief ?predicted . ?o a frc:ControlOutcome ; frc:decision ?d ; frc:selected true ; frc:realizedDependencyRelief ?realized . }
