PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision (MAX(?alternativeValue) - MAX(?selectedValue) AS ?observedRegret) WHERE {
  ?selected a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedValueUnits ?selectedValue ; frc:current true .
  ?alternative a frc:ControlOutcome ; frc:decision ?decision ; frc:observedAlternative true ; frc:realizedValueUnits ?alternativeValue ; frc:current true .
} GROUP BY ?decision ORDER BY DESC(?observedRegret)
