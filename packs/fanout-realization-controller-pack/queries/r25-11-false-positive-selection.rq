PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?d ?edge WHERE { ?d frc:selectedEdge ?edge ; frc:predictedQualifiedActions ?pred . ?o frc:decision ?d ; frc:edge ?edge ; frc:selected true ; frc:realizedQualifiedActions 0 ; frc:realizedDependencyRelief 0 . FILTER(?pred > 0) }
