PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?subject ?value WHERE {
  ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedDependencyRelief 0 ; frc:realizedValueUnits ?value ; frc:exactSubject ?subject ; frc:current true .
} ORDER BY ?subject ?decision
