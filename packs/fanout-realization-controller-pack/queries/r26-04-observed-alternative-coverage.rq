PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT (COUNT(DISTINCT ?decision) AS ?decisions) (COUNT(DISTINCT ?covered) AS ?coveredDecisions) WHERE {
  ?decision a frc:ControlDecision ; frc:current true .
  OPTIONAL {
    ?alternative a frc:ControlOutcome ; frc:decision ?decision ; frc:observedAlternative true ; frc:current true .
    BIND(?decision AS ?covered)
  }
}
