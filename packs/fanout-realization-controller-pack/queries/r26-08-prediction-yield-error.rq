PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?subject (?realized - ?predicted AS ?signedYieldError) WHERE {
  ?decision a frc:ControlDecision ; frc:predictedQualifiedActions ?predicted ; frc:exactSubject ?subject ; frc:current true .
  ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedQualifiedActions ?realized ; frc:current true .
} ORDER BY DESC(ABS(?signedYieldError)) ?subject
