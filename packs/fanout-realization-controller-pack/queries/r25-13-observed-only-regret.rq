PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?d (MAX(?alternativeYield)-MAX(?selectedYield) AS ?observedRegret) WHERE { ?s frc:decision ?d ; frc:selected true ; frc:realizedQualifiedActions ?selectedYield . ?a frc:decision ?d ; frc:selected false ; frc:observedAlternative true ; frc:realizedQualifiedActions ?alternativeYield . } GROUP BY ?d HAVING(MAX(?alternativeYield) > MAX(?selectedYield))
