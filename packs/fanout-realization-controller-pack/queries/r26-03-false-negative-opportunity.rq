PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?selectedOutcome ?alternative ?gain WHERE {
  ?selectedOutcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedValueUnits ?selectedValue ; frc:current true .
  ?alternative a frc:ControlOutcome ; frc:decision ?decision ; frc:observedAlternative true ; frc:realizedValueUnits ?alternativeValue ; frc:current true .
  BIND((?alternativeValue - ?selectedValue) AS ?gain)
  FILTER(?gain > 0)
} ORDER BY DESC(?gain) ?decision
