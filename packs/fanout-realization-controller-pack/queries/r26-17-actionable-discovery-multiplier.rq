PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?outcome ?subject (?opportunities / ?seeds AS ?E) WHERE {
  ?outcome a frc:ControlOutcome ; frc:selected true ; frc:seedObservations ?seeds ; frc:actionableOpportunities ?opportunities ; frc:exactSubject ?subject ; frc:current true .
  FILTER(?seeds > 0)
} ORDER BY DESC(?E) ?subject
