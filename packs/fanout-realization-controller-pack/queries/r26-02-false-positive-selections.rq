PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?outcome ?subject WHERE {
  ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedValueUnits ?value ; frc:exactSubject ?subject ; frc:current true .
  FILTER(?value <= 0)
} ORDER BY ?subject ?decision
