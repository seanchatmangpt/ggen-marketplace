PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?d ?edge ?subject ?standing WHERE {
  ?d a frc:ControlDecision ;
     frc:selectedEdge ?edge ;
     frc:exactSubject ?subject ;
     frc:current true ;
     frc:receiptDigest ?receipt ;
     frc:authority "SELECT" ;
     frc:actuationPerformed false .
  ?o a frc:ControlOutcome ;
     frc:decision ?d ;
     frc:edge ?edge ;
     frc:selected true ;
     frc:current true ;
     frc:standing ?standing ;
     frc:receiptDigest ?outReceipt ;
     frc:actuationPerformed false .
  FILTER(regex(str(?receipt), "^[0-9a-f]{64}$") && regex(str(?outReceipt), "^[0-9a-f]{64}$"))
}
ORDER BY ?subject ?d ?edge ?standing
