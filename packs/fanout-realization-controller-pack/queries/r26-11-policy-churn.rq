PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?generation ?policyDigest ?priorDigest ?yield ?priorYield
WHERE {
 ?c a frc:PolicyCalibration ; frc:generation ?generation ; frc:policyDigest ?policyDigest ; frc:realizedYield ?yield ; frc:priorPolicyDigest ?priorDigest ; frc:priorRealizedYield ?priorYield .
 FILTER(?policyDigest != ?priorDigest && ?yield <= ?priorYield)
}
ORDER BY DESC(?generation) ?policyDigest
