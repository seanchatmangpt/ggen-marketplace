PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?edge (SUM(?relief) / SUM(?cost) AS ?reliefPerCost) WHERE {
  ?outcome a frc:ControlOutcome ; frc:edge ?edge ; frc:selected true ; frc:realizedDependencyRelief ?relief ; frc:realizedCostUnits ?cost ; frc:current true .
  FILTER(?cost > 0)
} GROUP BY ?edge ORDER BY DESC(?reliefPerCost) ?edge
