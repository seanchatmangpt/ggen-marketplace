PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?generation ?policyDigest (SUM(?actions) AS ?qualifiedActions) (SUM(?relief) AS ?dependencyRelief) (SUM(?cost) AS ?cost)
WHERE {
 ?d a frc:ControlDecision ; frc:generation ?generation ; frc:policyDigest ?policyDigest .
 ?o a frc:ControlOutcome ; frc:decision ?d ; frc:selected true ; frc:realizedQualifiedActions ?actions ; frc:realizedDependencyRelief ?relief ; frc:realizedCost ?cost .
}
GROUP BY ?generation ?policyDigest
ORDER BY ?generation ?policyDigest
