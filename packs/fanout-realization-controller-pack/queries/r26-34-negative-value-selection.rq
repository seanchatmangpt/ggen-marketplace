PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?edge ?actions ?relief ?cost
WHERE {
 ?o a frc:ControlOutcome ; frc:decision ?decision ; frc:edge ?edge ; frc:selected true ; frc:realizedQualifiedActions ?actions ; frc:realizedDependencyRelief ?relief ; frc:realizedCost ?cost .
 FILTER(?actions <= 0 && ?relief <= 0 && ?cost > 0)
}
ORDER BY DESC(?cost) ?decision ?edge
