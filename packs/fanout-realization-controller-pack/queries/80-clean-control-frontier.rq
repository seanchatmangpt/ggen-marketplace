PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?r ?edge ?realized ?investment ?relief (?realized / ?investment AS ?realizedY) WHERE {
  ?r a frc:FanoutRealization ; frc:edge ?edge ; frc:realizedQualifiedActions ?realized ; frc:investmentUnits ?investment ; frc:dependencyRelief ?relief ; frc:current true ; frc:standing ?standing ; frc:exactSubject ?subject ; frc:receiptDigest ?receipt ; frc:authority "VERIFY" ; frc:actuationPerformed false .
  FILTER(?investment > 0 && ?realized > 0 && ?relief > 0 && STRLEN(STR(?receipt)) = 64 && (?standing = "ALIVE" || ?standing = "PARTIAL_ALIVE"))
}
ORDER BY DESC(?realizedY) DESC(?relief) ?r
