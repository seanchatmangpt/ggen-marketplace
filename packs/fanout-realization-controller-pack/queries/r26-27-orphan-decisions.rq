PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?subject WHERE {
  ?decision a frc:ControlDecision ; frc:exactSubject ?subject ; frc:current true .
  FILTER NOT EXISTS { ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:current true . }
} ORDER BY ?subject ?decision
