PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?subject (AVG(?realized) AS ?meanYield) (AVG(?relief) AS ?meanRelief) WHERE { ?o a frc:ControlOutcome ; frc:selected true ; frc:current true ; frc:exactSubject ?subject ; frc:realizedQualifiedActions ?realized ; frc:realizedDependencyRelief ?relief . } GROUP BY ?subject
