PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?subject (?relief / ?cost AS ?reliefPerCost) WHERE {
  ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedDependencyRelief ?relief ; frc:realizedCostUnits ?cost ; frc:exactSubject ?subject ; frc:current true .
  FILTER(?cost > 0)
} ORDER BY DESC(?reliefPerCost) ?subject
