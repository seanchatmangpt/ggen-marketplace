PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?edge ?actions ?relief ?cost ?root
WHERE {
 ?o a frc:ControlOutcome ; frc:decision ?decision ; frc:edge ?edge ; frc:selected true ; frc:realizedQualifiedActions ?actions ; frc:realizedDependencyRelief ?relief ; frc:realizedCost ?cost ; frc:evidenceRoot ?root ; frc:current true ; frc:receipt ?receipt ; frc:actuationPerformed false .
 FILTER(?actions > 0 && ?relief > 0)
 FILTER NOT EXISTS { ?dup a frc:ControlOutcome ; frc:decision ?decision ; frc:evidenceRoot ?root . FILTER(?dup != ?o) }
 FILTER NOT EXISTS { ?bad a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedQualifiedActions ?ba ; frc:realizedDependencyRelief ?br ; frc:realizedCost ?bc . FILTER(?ba <= 0 && ?br <= 0 && ?bc > 0) }
}
ORDER BY DESC(?relief) DESC(?actions) ?cost ?decision ?edge
