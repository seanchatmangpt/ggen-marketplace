PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT (COUNT(?o) AS ?selectedCount) (SUM(?actions) AS ?qualifiedActions) (IF(COUNT(?o)=0,0,SUM(?actions)/COUNT(?o)) AS ?actionsPerSelection)
WHERE { ?o a frc:ControlOutcome ; frc:selected true ; frc:current true ; frc:realizedQualifiedActions ?actions ; frc:actuationPerformed false . }
