PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT (SUM(?a) AS ?actions) (SUM(?cost) AS ?cost) (IF(SUM(?cost)=0,SUM(?a),SUM(?a)/SUM(?cost)) AS ?actionYieldPerCost) WHERE { ?o a frc:ControlOutcome ; frc:selected true ; frc:current true ; frc:realizedQualifiedActions ?a ; frc:realizedCost ?cost ; frc:actuationPerformed false . }
