PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?subject (?value / ?latency AS ?valuePerMs) WHERE {
  ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedValueUnits ?value ; frc:realizedLatencyMs ?latency ; frc:exactSubject ?subject ; frc:current true .
  FILTER(?latency > 0)
} ORDER BY DESC(?valuePerMs) ?subject
