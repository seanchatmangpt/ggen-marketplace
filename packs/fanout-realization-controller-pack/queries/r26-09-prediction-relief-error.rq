PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?decision ?subject (?realized - ?predicted AS ?signedReliefError) WHERE {
  ?decision a frc:ControlDecision ; frc:predictedDependencyRelief ?predicted ; frc:exactSubject ?subject ; frc:current true .
  ?outcome a frc:ControlOutcome ; frc:decision ?decision ; frc:selected true ; frc:realizedDependencyRelief ?realized ; frc:current true .
} ORDER BY DESC(ABS(?signedReliefError)) ?subject
