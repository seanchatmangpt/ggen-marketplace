PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT ?o ?actions ?cost (IF(?cost=0,?actions,?actions/?cost) AS ?efficiency) WHERE { ?o a frc:ControlOutcome ; frc:selected true ; frc:current true ; frc:realizedQualifiedActions ?actions ; frc:realizedCost ?cost ; frc:actuationPerformed false . FILTER(?actions > 0 && ?cost >= 0) } ORDER BY DESC(?efficiency) DESC(?actions)
