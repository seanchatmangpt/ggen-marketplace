PREFIX frc: <https://ggen.dev/ontology/fanout-realization-control#>
SELECT (SUM(?actions) AS ?qualifiedActions) (SUM(?cost) AS ?investment) (IF(SUM(?cost)=0,SUM(?actions),SUM(?actions)/SUM(?cost)) AS ?capitalYield)
WHERE {
 ?o a frc:ControlOutcome ; frc:selected true ; frc:current true ; frc:realizedQualifiedActions ?actions ; frc:realizedCost ?cost ; frc:actuationPerformed false .
}
