def admit_selection_calibration(*, precision, recall, relief_roi, independent_roots, actuation_performed):
    assert 0.0 <= precision <= 1.0
    assert 0.0 <= recall <= 1.0
    assert independent_roots >= 1
    assert actuation_performed is False
    return {
        "precision": precision,
        "recall": recall,
        "relief_roi": relief_roi,
        "independent_roots": independent_roots,
        "authority": "SELECT",
        "actuation_performed": False,
    }
