{
  "schema": "ggen.fanout-realization-control/1",
  "authority": "SELECT|CONSTRUCT|VERIFY",
  "actuation_performed": false,
  "frontier": [
  {% for row in results %}{"realization":"{{ row.r }}","edge":"{{ row.edge }}","realized_actions":{{ row.realized }},"investment":{{ row.investment }},"dependency_relief":{{ row.relief }},"realized_y":{{ row.realizedY }}}{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
