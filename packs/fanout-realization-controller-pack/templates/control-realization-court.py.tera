# Generated consequence. Do not hand-edit.
EXPECTED_SUBJECT = "{{ subject }}"
EXPECTED_DECISION = "{{ d }}"
AUTHORITY = "OBSERVE|VERIFY"
ACTUATION_PERFORMED = False

def qualify(observed_subject: str, receipt_present: bool, current: bool) -> str:
    if observed_subject != EXPECTED_SUBJECT or not receipt_present or not current:
        return "UNKNOWN"
    return "PARTIAL_ALIVE"
