@prefix frc: <https://ggen.dev/ontology/fanout-realization-control#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dct: <http://purl.org/dc/terms/> .

frc:SelectionCalibrationRun a prov:Activity .
frc:SelectionCalibrationObservation a prov:Entity .
frc:SelectionCalibrationQuality a dqv:QualityMeasurement .
frc:PrecisionMetric a dqv:Metric ; dct:title "Selection precision" .
frc:RecallMetric a dqv:Metric ; dct:title "Selection recall" .
frc:F1Metric a dqv:Metric ; dct:title "Selection F1" .
frc:ReliefRoiMetric a dqv:Metric ; dct:title "Realized dependency-relief ROI" .
frc:PolicyChurnMetric a dqv:Metric ; dct:title "Policy churn without realized improvement" .
frc:EvidenceRootDiversityMetric a dqv:Metric ; dct:title "Independent evidence-root diversity" .

frc:r26SelectionCalibrationLaw a prov:Entity ;
  frc:authority "OBSERVE|VERIFY|SELECT" ;
  frc:actuationPerformed false ;
  frc:requiresExactSubject true ;
  frc:requiresCurrentEvidence true ;
  frc:requiresReceipt true ;
  frc:requiresObservedAlternativesForRecall true ;
  frc:requiresIndependentEvidenceRoots true .
