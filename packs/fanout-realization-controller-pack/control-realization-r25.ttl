@prefix frc: <https://ggen.dev/ontology/fanout-realization-control#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dct: <http://purl.org/dc/terms/> .

frc:ControlOutcome a prov:Entity .
frc:ControlRealizationRun a prov:Activity .
frc:ControlRealizationQuality a dqv:QualityMeasurement .
frc:RealizedYieldMetric a dqv:Metric ; dct:title "Realized qualified-action yield" .
frc:DependencyReliefMetric a dqv:Metric ; dct:title "Realized dependency relief" .
frc:ObservedRegretMetric a dqv:Metric ; dct:title "Observed-only selection regret" .
frc:FalseSelectionMetric a dqv:Metric ; dct:title "False-positive selection rate" .
frc:DiscoveryMultiplierMetric a dqv:Metric ; dct:title "Actionable opportunities per seed observation" .

frc:r25ControlRealizationLaw a prov:Entity ;
  frc:authority "OBSERVE|VERIFY" ;
  frc:actuationPerformed false ;
  frc:requiresExactSubject true ;
  frc:requiresCurrentEvidence true ;
  frc:requiresReceipt true ;
  frc:requiresObservedAlternativesForRegret true .
