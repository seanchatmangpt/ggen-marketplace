@prefix mfc: <https://ggen.dev/ontology/manufacturing-fanout#> .

# Minimal qualification type declarations for cross-pack fanout-edge instances
# consumed by fanout-realization-controller-pack. The owning ontology remains
# manufacturing-fanout-controller-pack; these declarations only make the
# isolated qualification boundary explicit and do not duplicate owner facts.
mfc:edgeA a mfc:FanoutEdge .
mfc:edgeB a mfc:FanoutEdge .
mfc:edgeC a mfc:FanoutEdge .
mfc:edgeD a mfc:FanoutEdge .
mfc:edgeE a mfc:FanoutEdge .
