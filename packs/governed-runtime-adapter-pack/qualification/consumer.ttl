@prefix gra: <https://ggen.dev/ontology/governed-runtime-adapter#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gra:fixturePolicy a odrl:Policy .

gra:fixtureBudget a gra:ResourceBudget ;
  gra:fuelLimit 1000000 ;
  gra:memoryLimitBytes 67108864 .

gra:fixtureBinding a gra:RuntimeAdapterBinding ;
  gra:exactSubject "0123456789abcdef0123456789abcdef01234567" ;
  gra:projectNumber 2 ;
  gra:ocelLineage "ggen/ecosystem/ocel/current" ;
  gra:adapterId "fixture-adapter" ;
  gra:adapterVersion "1.0.0" ;
  gra:runtimeId "fixture-runtime" ;
  gra:runtimeVersion "1.0.0" ;
  gra:runtimeDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
  gra:runtimeKind gra:WasmRuntime ;
  gra:executionMode gra:ReplayOnly ;
  gra:freshDoAllowed false ;
  gra:authorityPolicy gra:fixturePolicy ;
  gra:inputSchemaDigest "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
  gra:outputSchemaDigest "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" ;
  gra:toolchainDigest "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" ;
  gra:configDigest "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" ;
  gra:dependencyDigest "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" ;
  gra:hostCapabilityDigest "sha256:1111111111111111111111111111111111111111111111111111111111111111" ;
  gra:hasBudget gra:fixtureBudget ;
  gra:moduleDigest "sha256:2222222222222222222222222222222222222222222222222222222222222222" ;
  gra:entrypoint "run" ;
  gra:abiVersion "component-model-0.2" ;
  gra:algorithmOwner "wasm4pm/wasm4pm-compat" .

gra:fixtureInvocation a gra:Invocation ;
  gra:usesBinding gra:fixtureBinding ;
  gra:inputDigest "sha256:3333333333333333333333333333333333333333333333333333333333333333" ;
  gra:outputDigest "sha256:4444444444444444444444444444444444444444444444444444444444444444" ;
  gra:command "fixture run" ;
  gra:hasReceipt gra:fixtureReceipt .

gra:fixtureReceipt a gra:Receipt ;
  gra:receiptId "receipt-fixture-1" ;
  gra:receiptVersion "1" ;
  gra:exactSubject "0123456789abcdef0123456789abcdef01234567" ;
  gra:projectNumber 2 ;
  gra:ocelLineage "ggen/ecosystem/ocel/current" ;
  gra:adapterId "fixture-adapter" ;
  gra:adapterVersion "1.0.0" ;
  gra:runtimeDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
  gra:inputDigest "sha256:3333333333333333333333333333333333333333333333333333333333333333" ;
  gra:outputDigest "sha256:4444444444444444444444444444444444444444444444444444444444444444" ;
  gra:nonce "nonce-fixture-1" ;
  gra:signaturePolicy gra:fixturePolicy ;
  gra:provenanceSource "Project #2" ;
  gra:resultStanding "ALIVE" .

gra:fixtureReplay a gra:ReplayInvocation ;
  gra:usesBinding gra:fixtureBinding ;
  gra:replayOf gra:fixtureInvocation ;
  gra:replaysReceipt gra:fixtureReceipt ;
  gra:inputDigest "sha256:3333333333333333333333333333333333333333333333333333333333333333" ;
  gra:outputDigest "sha256:4444444444444444444444444444444444444444444444444444444444444444" .
