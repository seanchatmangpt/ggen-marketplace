@prefix gra: <https://ggen.dev/ontology/governed-runtime-adapter#> .
@prefix ex: <urn:ggen:witness:> .
ex:receipt a gra:Receipt ; gra:inputDigest "sha256:in" ; gra:outputDigest "sha256:out-b" .
ex:invocation a gra:Invocation ; gra:hasReceipt ex:receipt ; gra:inputDigest "sha256:in" ; gra:outputDigest "sha256:out-a" .
