@prefix gra: <https://ggen.dev/ontology/governed-runtime-adapter#> .
@prefix ex: <urn:ggen:witness:> .
ex:receiptA a gra:Receipt .
ex:receiptB a gra:Receipt .
ex:original a gra:Invocation ; gra:hasReceipt ex:receiptA .
ex:replay a gra:ReplayInvocation ; gra:replayOf ex:original ; gra:replaysReceipt ex:receiptB .
