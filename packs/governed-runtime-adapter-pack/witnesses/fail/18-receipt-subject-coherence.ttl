@prefix gra: <https://ggen.dev/ontology/governed-runtime-adapter#> .
@prefix ex: <urn:ggen:witness:> .
ex:binding a gra:RuntimeAdapterBinding ; gra:exactSubject "subject-a" .
ex:receipt a gra:Receipt ; gra:exactSubject "subject-b" .
ex:invocation a gra:Invocation ; gra:usesBinding ex:binding ; gra:hasReceipt ex:receipt .
