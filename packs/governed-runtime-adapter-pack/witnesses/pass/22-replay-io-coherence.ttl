@prefix gra: <https://ggen.dev/ontology/governed-runtime-adapter#> .
@prefix ex: <urn:ggen:witness:> .
ex:original a gra:Invocation ; gra:inputDigest "sha256:in" ; gra:outputDigest "sha256:out" .
ex:replay a gra:ReplayInvocation ; gra:replayOf ex:original ; gra:inputDigest "sha256:in" ; gra:outputDigest "sha256:out" .
