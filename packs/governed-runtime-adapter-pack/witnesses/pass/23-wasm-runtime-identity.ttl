@prefix gra: <https://ggen.dev/ontology/governed-runtime-adapter#> .
@prefix ex: <urn:ggen:witness:> .
ex:budget a gra:ResourceBudget ; gra:fuelLimit 1000 ; gra:memoryLimitBytes 65536 .
ex:binding a gra:RuntimeAdapterBinding ; gra:runtimeKind gra:WasmRuntime ; gra:moduleDigest "sha256:module" ; gra:entrypoint "run" ; gra:abiVersion "component-model-0.2" ; gra:hasBudget ex:budget .
