@prefix gra: <https://ggen.dev/ontology/governed-runtime-adapter#> .
@prefix ex: <urn:ggen:witness:> .
ex:binding a gra:RuntimeAdapterBinding ; gra:adapterVersion "1.0.0" ; gra:runtimeDigest "sha256:runtime" .
ex:receipt a gra:Receipt ; gra:adapterVersion "1.0.0" ; gra:runtimeDigest "sha256:runtime" .
ex:invocation a gra:Invocation ; gra:usesBinding ex:binding ; gra:hasReceipt ex:receipt .
