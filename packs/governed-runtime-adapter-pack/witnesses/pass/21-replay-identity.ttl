@prefix gra: <https://ggen.dev/ontology/governed-runtime-adapter#> .
@prefix ex: <urn:ggen:witness:> .
ex:binding a gra:RuntimeAdapterBinding .
ex:original a gra:Invocation .
ex:receipt a gra:Receipt .
ex:replay a gra:ReplayInvocation ; gra:usesBinding ex:binding ; gra:replayOf ex:original ; gra:replaysReceipt ex:receipt ; gra:inputDigest "sha256:in" ; gra:outputDigest "sha256:out" .
