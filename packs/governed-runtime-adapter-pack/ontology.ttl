@prefix gra: <https://ggen.dev/ontology/governed-runtime-adapter#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ocel: <https://www.ocel-standard.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gra:RuntimeAdapterBinding a prov:Entity .
gra:Invocation a prov:Activity .
gra:ReplayInvocation a prov:Activity .
gra:RuntimeArtifact a prov:Entity .
gra:Receipt a prov:Entity .
gra:Refusal a prov:Entity .
gra:ResourceBudget a prov:Entity .
gra:CapabilitySet a prov:Entity .
gra:Certification a prov:Entity .

gra:ExecutionModeScheme a skos:ConceptScheme .
gra:ReplayOnly a skos:Concept ; skos:inScheme gra:ExecutionModeScheme ; skos:prefLabel "replay only" .
gra:SelectConstruct a skos:Concept ; skos:inScheme gra:ExecutionModeScheme ; skos:prefLabel "select/construct only" .
gra:AuthorizedDo a skos:Concept ; skos:inScheme gra:ExecutionModeScheme ; skos:prefLabel "authorized consequential DO" .

gra:RuntimeKindScheme a skos:ConceptScheme .
gra:WasmRuntime a skos:Concept ; skos:inScheme gra:RuntimeKindScheme ; skos:prefLabel "WebAssembly runtime" .
gra:ExternalProcessRuntime a skos:Concept ; skos:inScheme gra:RuntimeKindScheme ; skos:prefLabel "external process runtime" .
gra:EmbeddedRuntime a skos:Concept ; skos:inScheme gra:RuntimeKindScheme ; skos:prefLabel "embedded runtime" .

gra:exactSubject a rdf:Property .
gra:projectNumber a rdf:Property .
gra:ocelLineage a rdf:Property .
gra:adapterId a rdf:Property .
gra:adapterVersion a rdf:Property .
gra:capabilityVersion a rdf:Property .
gra:runtimeId a rdf:Property .
gra:runtimeVersion a rdf:Property .
gra:runtimeDigest a rdf:Property .
gra:runtimeKind a rdf:Property .
gra:executionMode a rdf:Property .
gra:freshDoAllowed a rdf:Property .
gra:authorityPolicy a rdf:Property .
gra:policyDigest a rdf:Property .
gra:authorityScope a rdf:Property .
gra:inputSchemaDigest a rdf:Property .
gra:outputSchemaDigest a rdf:Property .
gra:inputDigest a rdf:Property .
gra:outputDigest a rdf:Property .
gra:toolchainDigest a rdf:Property .
gra:configDigest a rdf:Property .
gra:dependencyDigest a rdf:Property .
gra:hostCapabilityDigest a rdf:Property .
gra:hasBudget a rdf:Property .
gra:fuelLimit a rdf:Property .
gra:memoryLimitBytes a rdf:Property .
gra:timeoutMs a rdf:Property .
gra:maxAttempts a rdf:Property .
gra:idempotencyKey a rdf:Property .
gra:transactionScope a rdf:Property .
gra:compensationRequired a rdf:Property .
gra:compensationPlanDigest a rdf:Property .
gra:actorRequired a rdf:Property .
gra:tenantRequired a rdf:Property .
gra:actorIdentity a rdf:Property .
gra:tenantIdentity a rdf:Property .
gra:correlationId a rdf:Property .
gra:causationId a rdf:Property .
gra:rateLimitCapacity a rdf:Property .
gra:rateLimitWindowMs a rdf:Property .
gra:clockIdentity a rdf:Property .
gra:moduleDigest a rdf:Property .
gra:entrypoint a rdf:Property .
gra:abiVersion a rdf:Property .
gra:executableIdentity a rdf:Property .
gra:registryIdentity a rdf:Property .
gra:command a rdf:Property .
gra:route a rdf:Property .
gra:hasReceipt a rdf:Property .
gra:receiptId a rdf:Property .
gra:receiptVersion a rdf:Property .
gra:nonce a rdf:Property .
gra:signaturePolicy a rdf:Property .
gra:provenanceSource a rdf:Property .
gra:resultStanding a rdf:Property .
gra:certificationDigest a rdf:Property .
gra:replayOf a rdf:Property .
gra:replaysReceipt a rdf:Property .
gra:usesBinding a rdf:Property .
gra:algorithmOwner a rdf:Property .
