@prefix gra: <https://ggen.dev/ontology/governed-runtime-adapter#> .

gra:badReplayOnly a gra:RuntimeAdapterBinding ;
  gra:executionMode gra:ReplayOnly ;
  gra:freshDoAllowed true .

gra:badExternalProcess a gra:RuntimeAdapterBinding ;
  gra:runtimeKind gra:ExternalProcessRuntime .

gra:badCertifiedReceipt a gra:Receipt ;
  gra:resultStanding "CERTIFIED" .
