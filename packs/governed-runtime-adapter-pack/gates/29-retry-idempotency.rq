PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?invocation WHERE { ?invocation a gra:Invocation ; gra:usesBinding ?binding . ?binding gra:maxAttempts ?attempts . FILTER(?attempts > 1) FILTER NOT EXISTS { ?invocation gra:idempotencyKey ?key . FILTER(STRLEN(STR(?key)) > 0) } }
