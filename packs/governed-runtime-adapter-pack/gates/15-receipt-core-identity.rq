PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?receipt WHERE { ?receipt a gra:Receipt . FILTER NOT EXISTS { ?receipt gra:receiptId ?id ; gra:receiptVersion ?version ; gra:exactSubject ?subject ; gra:adapterId ?adapter ; gra:adapterVersion ?adapterVersion ; gra:runtimeDigest ?runtime . FILTER(STRLEN(STR(?id)) > 0 && STRLEN(STR(?version)) > 0 && STRLEN(STR(?subject)) > 0 && STRLEN(STR(?adapter)) > 0 && STRLEN(STR(?adapterVersion)) > 0 && STRLEN(STR(?runtime)) > 0) } }
