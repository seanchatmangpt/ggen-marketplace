PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?receipt WHERE { ?invocation a gra:Invocation ; gra:hasReceipt ?receipt ; gra:inputDigest ?input ; gra:outputDigest ?output . ?receipt gra:inputDigest ?otherInput ; gra:outputDigest ?otherOutput . FILTER(STR(?input) != STR(?otherInput) || STR(?output) != STR(?otherOutput)) }
