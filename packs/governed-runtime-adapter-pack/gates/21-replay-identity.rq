PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?replay WHERE { ?replay a gra:ReplayInvocation . FILTER NOT EXISTS { ?replay gra:usesBinding ?binding ; gra:replayOf ?original ; gra:replaysReceipt ?receipt ; gra:inputDigest ?input ; gra:outputDigest ?output . ?binding a gra:RuntimeAdapterBinding . ?original a gra:Invocation . ?receipt a gra:Receipt . } }
