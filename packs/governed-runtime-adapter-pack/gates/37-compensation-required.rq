PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?binding WHERE { ?binding a gra:RuntimeAdapterBinding ; gra:compensationRequired true . FILTER NOT EXISTS { ?binding gra:transactionScope ?scope ; gra:compensationPlanDigest ?digest . FILTER(STRLEN(STR(?scope)) > 0 && STRLEN(STR(?digest)) > 0) } }
