PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?receipt WHERE { ?invocation a gra:Invocation ; gra:usesBinding ?binding ; gra:hasReceipt ?receipt . ?binding gra:adapterVersion ?adapterVersion ; gra:runtimeDigest ?runtimeDigest . ?receipt gra:adapterVersion ?otherAdapter ; gra:runtimeDigest ?otherRuntime . FILTER(STR(?adapterVersion) != STR(?otherAdapter) || STR(?runtimeDigest) != STR(?otherRuntime)) }
