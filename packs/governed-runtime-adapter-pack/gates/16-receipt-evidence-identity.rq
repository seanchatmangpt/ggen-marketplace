PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?receipt WHERE { ?receipt a gra:Receipt . FILTER NOT EXISTS { ?receipt gra:inputDigest ?in ; gra:outputDigest ?out ; gra:nonce ?nonce ; gra:signaturePolicy ?signature ; gra:provenanceSource ?provenance ; gra:resultStanding ?standing . FILTER(STRLEN(STR(?in)) > 0 && STRLEN(STR(?out)) > 0 && STRLEN(STR(?nonce)) > 0 && STRLEN(STR(?provenance)) > 0 && STRLEN(STR(?standing)) > 0) } }
