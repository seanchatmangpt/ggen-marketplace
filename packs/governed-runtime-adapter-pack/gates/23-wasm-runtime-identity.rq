PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?binding WHERE { ?binding a gra:RuntimeAdapterBinding ; gra:runtimeKind gra:WasmRuntime . FILTER NOT EXISTS { ?binding gra:moduleDigest ?module ; gra:entrypoint ?entrypoint ; gra:abiVersion ?abi ; gra:hasBudget ?budget . ?budget gra:fuelLimit ?fuel ; gra:memoryLimitBytes ?memory . FILTER(STRLEN(STR(?module)) > 0 && STRLEN(STR(?entrypoint)) > 0 && STRLEN(STR(?abi)) > 0 && ?fuel > 0 && ?memory > 0) } }
