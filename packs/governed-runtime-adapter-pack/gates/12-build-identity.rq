PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?binding WHERE { ?binding a gra:RuntimeAdapterBinding . FILTER NOT EXISTS { ?binding gra:toolchainDigest ?tool ; gra:configDigest ?config ; gra:dependencyDigest ?deps . FILTER(STRLEN(STR(?tool)) > 0 && STRLEN(STR(?config)) > 0 && STRLEN(STR(?deps)) > 0) } }
