PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?binding WHERE { ?binding a gra:RuntimeAdapterBinding . FILTER NOT EXISTS { ?binding gra:authorityPolicy ?policy ; gra:policyDigest ?digest ; gra:authorityScope ?scope . FILTER(STRLEN(STR(?digest)) > 0 && STRLEN(STR(?scope)) > 0) } }
