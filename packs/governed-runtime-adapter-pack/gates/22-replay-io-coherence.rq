PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?replay WHERE { ?replay a gra:ReplayInvocation ; gra:replayOf ?original ; gra:inputDigest ?input ; gra:outputDigest ?output . ?original gra:inputDigest ?origInput ; gra:outputDigest ?origOutput . FILTER(STR(?input) != STR(?origInput) || STR(?output) != STR(?origOutput)) }
