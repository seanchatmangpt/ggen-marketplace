PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?binding WHERE { ?binding a gra:RuntimeAdapterBinding . FILTER NOT EXISTS { ?binding gra:runtimeId ?id ; gra:runtimeVersion ?version ; gra:runtimeDigest ?digest . FILTER(STRLEN(STR(?id)) > 0 && STRLEN(STR(?version)) > 0 && STRLEN(STR(?digest)) > 0) } }
