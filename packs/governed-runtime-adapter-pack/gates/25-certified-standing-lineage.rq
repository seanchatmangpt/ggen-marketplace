PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?receipt WHERE { ?receipt a gra:Receipt ; gra:resultStanding "CERTIFIED" . FILTER NOT EXISTS { ?receipt gra:certificationDigest ?digest ; gra:provenanceSource ?source . FILTER(STRLEN(STR(?digest)) > 0 && STRLEN(STR(?source)) > 0) } }
