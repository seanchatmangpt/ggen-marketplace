PREFIX gra: <https://ggen.dev/ontology/governed-runtime-adapter#>
SELECT ?binding WHERE { ?binding a gra:RuntimeAdapterBinding ; gra:runtimeKind gra:ExternalProcessRuntime . FILTER NOT EXISTS { ?binding gra:executableIdentity ?executable ; gra:registryIdentity ?registry . FILTER(STRLEN(STR(?executable)) > 0 && STRLEN(STR(?registry)) > 0) } }
