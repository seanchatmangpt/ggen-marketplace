# Synthetic consumer fixture for isolated qualification. This pack's
# ctt:composesCommand (rdfs:range cnv:Command) references 4 cnv:* individuals
# from clap-noun-verb-pack's namespace. Found by
# scripts/check_cross_pack_references.py (RC2 lint).
#
# CORRECTION (this fixture's original comment wrongly called this "doc/code
# drift" -- retracted): all 4 are real, confirmed commands. cnv:SessionLogin
# and cnv:UserCreate are real individuals directly in
# packs/clap-noun-verb-pack/ontology.ttl (complete: noun/verb/handler/doc/
# returnType/args), so the fixture no longer re-declares them -- re-declaring
# any of their scalar properties here would create distinct double values and
# refuse gate 020_single_valued ([FM-PACK-013], 16 rows, zd-28 finding).
#
# cnv:ReceiptEmit and cnv:AlgorithmList are ALSO real -- defined not by
# clap-noun-verb-pack itself but by a real consuming project's own domain.ttl
# (seanchatmangpt/ggen's examples/receiptctl/schema/domain.ttl), exactly the
# pattern ctt:composesCommand's own rdfs:comment documents as valid ("a
# cnv:Command defined by clap-noun-verb-pack OR a consuming project's own
# domain.ttl"). Confirmed this session by cloning that project and running
# `ggen sync run` against it for real: exit 0, and the generated
# tests/chicago_tdd_tools_boundary.rs really contains
# receiptctl_algorithm_list_succeeds and
# receiptctl_receipt_emit_fails_without_required_arg as real test functions.
#
# COMPLETENESS FIX (zd-28): clap-noun-verb-pack's gate 010_required.rq runs
# against the qualification union graph and requires every cnv:Command to
# carry noun/verb/hentor/doc/returnType/args -- this fixture's original bare
# stubs (4 declared commands with zero required properties, 2 of which are
# external-project commands absent from the union) are exactly what that gate
# refuses (FM-PACK-013, 12 rows). The two external commands are declared here
# with complete qualification values mirroring the real receiptctl surface.
# These are synthetic qualification values, not evidence that any real CLI
# executed.
@prefix cnv: <http://seanchatmangpt.github.io/packs/clap-noun-verb#> .

cnv:ReceiptEmit a cnv:Command ;
    cnv:noun "receipt" ; cnv:verb "emit" ; cnv:handler "receipt_emit_handler" ;
    cnv:doc "Emit a receipt record for the just-run step." ;
    cnv:returnType "serde_json::Value" ;
    cnv:args "id|String|true|Receipt id for the just-run step." .

cnv:AlgorithmList a cnv:Command ;
    cnv:noun "algorithm" ; cnv:verb "list" ; cnv:handler "algorithm_list_handler" ;
    cnv:doc "List the algorithm catalog." ;
    cnv:returnType "serde_json::Value" ;
    cnv:args "" .
