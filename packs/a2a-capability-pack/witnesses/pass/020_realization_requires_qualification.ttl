# PASS witness for gates/020_realization_requires_qualification.rq:
# a realization with a COMPLETE qualification condition
# (earl:outcome earl:passed + conditionStatement + conditionScope).
# Every gate must stay silent.
@prefix aacap: <https://ggen.dev/ontology/a2a-capability#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aacap:witness-qualified-cap a aacap:Capability ;
    dcterms:identifier "A2A.QualifiedProbe" ;
    rdfs:label "A2A.QualifiedProbe" ;
    aacap:consequenceClass "observation" ;
    aacap:requiresAuthority false ;
    aacap:grantsDoAuthority false .

aacap:witness-qualified-real a aacap:Realization ;
    aacap:realizationOf aacap:witness-qualified-cap ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.Qualified" ;
    aacap:authorityLocation "none" ;
    aacap:grantsDoAuthority false ;
    aacap:qualificationCondition aacap:witness-qualified-cond .

aacap:witness-qualified-cond a aacap:QualificationCondition ;
    earl:outcome earl:passed ;
    aacap:conditionStatement "Generated surface admitted only because this complete declared condition exists (Generated != Admitted)." ;
    aacap:conditionScope "witness fixture, inspection scope" .
