# PASS witness for gates/010_capability_requires_realization.rq:
# a probe capability WITH a realization. Every gate must stay silent.
@prefix aacap: <https://ggen.dev/ontology/a2a-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aacap:witness-echo a aacap:Capability ;
    dcterms:identifier "A2A.EchoProbe" ;
    rdfs:label "A2A.EchoProbe" ;
    aacap:consequenceClass "observation" ;
    aacap:requiresAuthority false ;
    aacap:grantsDoAuthority false .

aacap:witness-echo-real a aacap:Realization ;
    aacap:realizationOf aacap:witness-echo ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.Echo" ;
    aacap:authorityLocation "none" ;
    aacap:grantsDoAuthority false ;
    aacap:qualificationCondition aacap:witness-echo-cond .

aacap:witness-echo-cond a aacap:QualificationCondition ;
    earl:outcome earl:passed ;
    aacap:conditionStatement "Witness-only realization; complete condition present." ;
    aacap:conditionScope "witness fixture" .
