# FAIL witness for gates/020_realization_requires_qualification.rq:
# a realization with NO qualification condition -> gate 020 fires (target).
# authorityLocation "local" keeps gate 030 silent; it realizes an existing
# capability so gate 010 stays silent.
@prefix aacap: <https://ggen.dev/ontology/a2a-capability#> .

aacap:witness-unqualified-real a aacap:Realization ;
    aacap:realizationOf aacap:capability-invoke ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.Unqualified" ;
    aacap:authorityLocation "local" ;
    aacap:grantsDoAuthority false .
