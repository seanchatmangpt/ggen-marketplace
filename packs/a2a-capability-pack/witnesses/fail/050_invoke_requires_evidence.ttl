# FAIL witness for gates/050_invoke_requires_evidence.rq:
# a change-class capability whose ONLY evidence requirement is local_log
# (no remote receipt/ack provenance) -> gate 050 fires (target).
# Realization with complete condition and local authority keep gates
# 010/020/030 silent; not observation, not Discover -> gate 040 silent.
@prefix aacap: <https://ggen.dev/ontology/a2a-capability#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

aacap:witness-local-log-cap a aacap:Capability ;
    dcterms:identifier "A2A.MutatingProbe" ;
    rdfs:label "A2A.MutatingProbe" ;
    aacap:consequenceClass "change" ;
    aacap:requiresAuthority true ;
    aacap:grantsDoAuthority false ;
    aacap:requiresEvidence aacap:witness-local-log-evidence .

aacap:witness-local-log-evidence a aacap:EvidenceRequirement ;
    aacap:evidenceKind "local_log" .

aacap:witness-local-log-real a aacap:Realization ;
    aacap:realizationOf aacap:witness-local-log-cap ;
    aacap:providerRepo "witness" ;
    aacap:providerModule "Witness.LocalLogOnly" ;
    aacap:authorityLocation "local" ;
    aacap:grantsDoAuthority false ;
    aacap:qualificationCondition aacap:witness-local-log-cond .

aacap:witness-local-log-cond a aacap:QualificationCondition ;
    earl:outcome earl:passed ;
    aacap:conditionStatement "Mutation: consequence-bearing capability with local_log evidence only; gate 050 must fire." ;
    aacap:conditionScope "witness fixture" .
