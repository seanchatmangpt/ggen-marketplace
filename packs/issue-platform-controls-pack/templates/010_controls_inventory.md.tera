---
to: "docs/generated/issue-platform-controls-inventory.md"
force: true
sparql:
  tenants: |
    PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
    SELECT ?tenant ?tenantId WHERE {
      ?tenant a ip:Tenant ;
              ip:tenantId ?tenantId .
    }
    ORDER BY ?tenantId
  roles: |
    PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
    SELECT ?role ?roleId ?conflictsWith WHERE {
      ?role a ip:Role ;
            ip:roleId ?roleId .
      OPTIONAL { ?role ip:conflictsWith ?conflictsWith }
    }
    ORDER BY ?roleId
  sod: |
    PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
    SELECT ?conflict ?leftId ?rightId WHERE {
      ?conflict a ip:SoDConflict ;
                ip:leftRole ?left ;
                ip:rightRole ?right .
      ?left ip:roleId ?leftId .
      ?right ip:roleId ?rightId .
    }
    ORDER BY ?leftId ?rightId
  retention: |
    PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
    SELECT ?policy ?days ?region ?dataClass ?tenantId WHERE {
      ?policy a ip:RetentionPolicy ;
              ip:retentionDays ?days ;
              ip:residencyRegion ?region ;
              ip:dataClass ?dataClass .
      OPTIONAL {
        ?policy ip:appliesToTenant ?t .
        ?t ip:tenantId ?tenantId .
      }
    }
    ORDER BY ?dataClass
  audits: |
    PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
    SELECT ?event ?actor ?action ?outcome ?occurredAt ?digest ?wo WHERE {
      ?event a ip:AuditEvent ;
             ip:actor ?actor ;
             ip:action ?action ;
             ip:outcome ?outcome ;
             ip:occurredAt ?occurredAt ;
             ip:integrityDigest ?digest .
      OPTIONAL { ?event ip:subjectWorkOrder ?wo }
    }
    ORDER BY ?occurredAt
  bindings: |
    PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
    PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
    SELECT ?wo ?tenantId ?dataClass WHERE {
      ?wo a sj:WorkOrder .
      OPTIONAL {
        ?wo ip:boundTenant ?t .
        ?t ip:tenantId ?tenantId .
      }
      OPTIONAL { ?wo ip:workOrderDataClass ?dataClass }
    }
    ORDER BY ?wo
---
# Issue-platform controls inventory

GENERATED by ggen sync from `issue-platform-controls-pack` — do not edit by hand.
Authority ceiling: SELECT/CONSTRUCT only. Overlay attaches to `sj:WorkOrder`;
never forks it.

## Tenants

| tenant | tenantId |
|---|---|
{% for row in tenants -%}
| {{ row.tenant }} | {{ row.tenantId }} |
{% endfor %}

