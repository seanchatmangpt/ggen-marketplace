|---|---|---|---|---|---|---|
{% for row in audits -%}
| {{ row.event }} | {{ row.actor }} | {{ row.action }} | {{ row.outcome }} | {{ row.occurredAt }} | {{ row.digest }} | {{ row.wo | default(value="") }} |
{% endfor %}

