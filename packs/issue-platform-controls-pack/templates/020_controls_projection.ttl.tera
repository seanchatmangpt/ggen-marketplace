---
to: "docs/generated/issue-platform-controls-projection.ttl"
force: true
sparql:
  tenants: |
    PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
    SELECT ?tenantId WHERE {
      ?t a ip:Tenant ; ip:tenantId ?tenantId .
    }
    ORDER BY ?tenantId
  roles: |
    PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
    SELECT ?roleId WHERE {
      ?r a ip:Role ; ip:roleId ?roleId .
    }
    ORDER BY ?roleId
  conflicts: |
    PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
    SELECT ?leftId ?rightId WHERE {
      {
        ?a a ip:Role ; ip:roleId ?leftId ; ip:conflictsWith ?b .
        ?b ip:roleId ?rightId .
        FILTER(STR(?leftId) < STR(?rightId))
      } UNION {
        ?c a ip:SoDConflict ;
           ip:leftRole ?l ; ip:rightRole ?r .
        ?l ip:roleId ?leftId .
        ?r ip:roleId ?rightId .
      }
    }
    ORDER BY ?leftId ?rightId
  retention: |
    PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
    SELECT ?dataClass ?days ?region WHERE {
      ?p a ip:RetentionPolicy ;
         ip:dataClass ?dataClass ;
         ip:retentionDays ?days ;
         ip:residencyRegion ?region .
    }
    ORDER BY ?dataClass
---
# GENERATED by ggen sync from issue-platform-controls-pack — do not edit by hand.
# Flattened projection of admitted platform-control facts (no secrets, no DO).
@prefix ip:   <https://ggen.dev/ontology/issue-platform-controls#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

{% for row in tenants -%}
ip:proj-tenant-{{ row.tenantId }} a ip:Tenant ;
    ip:tenantId "{{ row.tenantId }}" .
{% endfor %}

{% for row in roles -%}
ip:proj-role-{{ row.roleId }} a ip:Role ;
    ip:roleId "{{ row.roleId }}" .
{% endfor %}

{% for row in conflicts -%}
ip:proj-sod-{{ row.leftId }}-{{ row.rightId }} a ip:SoDConflict ;
    ip:leftRole ip:proj-role-{{ row.leftId }} ;
    ip:rightRole ip:proj-role-{{ row.rightId }} .
{% endfor %}

{% for row in retention -%}
ip:proj-retention-{{ row.dataClass }} a ip:RetentionPolicy ;
    ip:dataClass "{{ row.dataClass }}" ;
    ip:retentionDays {{ row.days }} ;
    ip:residencyRegion "{{ row.region }}" .
{% endfor %}
