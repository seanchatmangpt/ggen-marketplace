# MESSAGE: ip: must compose WITH sj:WorkOrder via properties; never subclass or fork it.
PREFIX ip: <https://ggen.dev/ontology/issue-platform-controls#>
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?cls ?problem WHERE {
  ?cls rdfs:subClassOf+ sj:WorkOrder .
  FILTER(STRSTARTS(STR(?cls), STR(ip:)))
  BIND("ip-class-must-not-subclass-sj-WorkOrder" AS ?problem)
}
ORDER BY ?cls
