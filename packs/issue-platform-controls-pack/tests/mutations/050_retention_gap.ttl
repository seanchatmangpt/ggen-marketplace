@prefix ip: <https://ggen.dev/ontology/issue-platform-controls#> .
@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix ex: <https://example.org/ip-controls-mutation#> .

# Falsifier for gates/050_retention_policy.rq + RetentionPolicyShape /
# WorkOrderDataClassCoverageShape.
# Incomplete retention policy + WO data class with no matching policy.

ex:IncompleteRetention a ip:RetentionPolicy ;
    ip:dataClass "partial-only" .

ex:WO-orphan-class a sj:WorkOrder ;
    ip:workOrderDataClass "orphan-class-no-policy" .
