@prefix ip: <https://ggen.dev/ontology/issue-platform-controls#> .
@prefix ex: <https://example.org/ip-controls-mutation#> .

# Falsifier for gates/030_sod_conflicting_roles.rq + PrincipalSoDShape.
# Principal holds both sides of conflictsWith without sodExceptionReceipt.

ex:RoleA a ip:Role ;
    ip:roleId "approve" .

ex:RoleB a ip:Role ;
    ip:roleId "execute" ;
    ip:conflictsWith ex:RoleA .

ex:DualHolder a ip:Principal ;
    ip:hasRole ex:RoleA , ex:RoleB .

# Incomplete SoDConflict (missing rightRole) — second refusal branch.
ex:BrokenConflict a ip:SoDConflict ;
    ip:leftRole ex:RoleA .
