@prefix ip:   <https://ggen.dev/ontology/issue-platform-controls#> .
@prefix sj:   <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <https://example.org/ip-controls-mutation#> .

# Falsifier for gates/040_audit_event.rq + AuditEventShape.
# Missing required fields; subjectWorkOrder not typed as sj:WorkOrder.

ex:NotWorkOrder a rdfs:Resource .

ex:IncompleteAudit a ip:AuditEvent ;
    ip:action "probe" ;
    ip:subjectWorkOrder ex:NotWorkOrder .
