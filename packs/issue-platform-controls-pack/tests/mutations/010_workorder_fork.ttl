@prefix ip:   <https://ggen.dev/ontology/issue-platform-controls#> .
@prefix sj:   <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Falsifier for gates/010_no_workorder_fork.rq + SHACL NoWorkOrderForkShape.
# Union with ontology.ttl must produce >=1 gate row / SHACL non-conformance.

ip:ForkedWorkOrder a rdfs:Class ;
    rdfs:subClassOf sj:WorkOrder ;
    rdfs:label "Illicit WorkOrder fork (must refuse)" .
