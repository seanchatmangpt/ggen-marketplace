@prefix hs: <https://ggen.dev/ontology/hyperdimensional-standing#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

hs: a owl:Ontology ;
  rdfs:label "Hyperdimensional Construct-Only Standing" ;
  rdfs:comment "Semantic law for A=mu(O*): standing precedes interaction; runtime variability selects only pre-admitted construct capsules over exact admitted subjects." .

# Constitutional vocabulary
hs:Constitution a owl:Class .
hs:Observation a owl:Class .
hs:AdmittedObservation a owl:Class ; rdfs:subClassOf hs:Observation .
hs:ManufacturingOperator a owl:Class .
hs:Artifact a owl:Class ; rdfs:subClassOf prov:Entity .
hs:Standing a owl:Class .
hs:Interaction a owl:Class .
hs:Refusal a owl:Class .
hs:ExecutionCapsule a owl:Class .
hs:SelectorUniverse a owl:Class .
hs:ConstructOperation a owl:Class ; rdfs:subClassOf prov:Activity .
hs:WasmInterchangeablePart a owl:Class ; rdfs:subClassOf prov:Entity .
hs:ProcessCarrier a owl:Class .
hs:ProcessGeometry a owl:Class .
hs:ProcessAlgebra a owl:Class .
hs:ProcessCalculus a owl:Class .
hs:HIEDimension a owl:Class .
hs:HyperdimensionalInformationEncryption a owl:Class .
hs:ConformanceEvidence a owl:Class ; rdfs:subClassOf prov:Entity .

hs:equation a owl:DatatypeProperty ; rdfs:domain hs:Constitution ; rdfs:range xsd:string .
hs:constructOnly a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:standingPrecedesInteraction a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:firstHandshakeEvidence a owl:DatatypeProperty ; rdfs:range xsd:string .
hs:corpusDigestAlgorithm a owl:DatatypeProperty ; rdfs:range xsd:string .
hs:partDigestAlgorithm a owl:DatatypeProperty ; rdfs:range xsd:string .
hs:requiresExactCorpus a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:requiresExactPart a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:requiresProcessConformance a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:mismatchBehavior a owl:DatatypeProperty ; rdfs:range xsd:string .
hs:runtimeQueryTextAllowed a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:runtimeExecutableIRAllowed a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:runtimePromptInstructionAllowed a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:runtimeShellInstructionAllowed a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:runtimeDynamicQueryFragmentAllowed a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:foreignCorpusHasStanding a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:humanHasAmbientAuthority a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:llmHasAmbientAuthority a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:knowledgeEqualsStanding a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:behavioralEquivalenceImpliesStanding a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:artifactPossessionImpliesStanding a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:architectureKnowledgeImpliesAuthority a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:signedPartRequired a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:ambientHostCapabilities a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:embeddedStringsPolicy a owl:DatatypeProperty ; rdfs:range xsd:string .
hs:branchlessRuntimeTarget a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:zeroCostRustTarget a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:selectorWidthBits a owl:DatatypeProperty ; rdfs:range xsd:integer .
hs:selectorCount a owl:DatatypeProperty ; rdfs:range xsd:integer .
hs:selector a owl:DatatypeProperty ; rdfs:range xsd:integer .
hs:selectorTransportsCode a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:selectorTransportsIR a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:selectorTransportsQueryText a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:refusalCompletesUniverse a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:processIsStateEvidence a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:processIsCreationStanding a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:routeIsPartOfSubject a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:creationKeyIsProcessGeometry a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:lawfulComposition a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:undefinedCompositionRefuses a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:lawfulFlowRequired a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:firstDerivativeConformance a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:secondDerivativeConformance a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:integralProcessInvariants a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:meaningLivesInRelations a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:singleProjectionAuthoritative a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:masterRosettaStoneRequired a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:manufactureMayBeNonInjective a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:runtimeArtifactEncodesFactory a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:attackSurfaceModel a owl:DatatypeProperty ; rdfs:range xsd:string .
hs:probingCanCreateNewTransition a owl:DatatypeProperty ; rdfs:range xsd:boolean .
hs:attackerIntelligenceCanCreateNewTransition a owl:DatatypeProperty ; rdfs:range xsd:boolean .

hs:hasOperator a owl:ObjectProperty ; rdfs:domain hs:Constitution ; rdfs:range hs:ManufacturingOperator .
hs:hasSelectorUniverse a owl:ObjectProperty ; rdfs:domain hs:Constitution ; rdfs:range hs:SelectorUniverse .
hs:hasProcessCarrier a owl:ObjectProperty ; rdfs:domain hs:Constitution ; rdfs:range hs:ProcessCarrier .
hs:hasHIE a owl:ObjectProperty ; rdfs:domain hs:Constitution ; rdfs:range hs:HyperdimensionalInformationEncryption .
hs:hasDimension a owl:ObjectProperty ; rdfs:domain hs:HyperdimensionalInformationEncryption ; rdfs:range hs:HIEDimension .
hs:bindsConstruct a owl:ObjectProperty ; rdfs:domain hs:ExecutionCapsule ; rdfs:range hs:ConstructOperation .
hs:bindsPart a owl:ObjectProperty ; rdfs:domain hs:ExecutionCapsule ; rdfs:range hs:WasmInterchangeablePart .
hs:hasGeometry a owl:ObjectProperty ; rdfs:domain hs:ProcessCarrier ; rdfs:range hs:ProcessGeometry .
hs:hasAlgebra a owl:ObjectProperty ; rdfs:domain hs:ProcessCarrier ; rdfs:range hs:ProcessAlgebra .
hs:hasCalculus a owl:ObjectProperty ; rdfs:domain hs:ProcessCarrier ; rdfs:range hs:ProcessCalculus .

# Canonical v1 law. This is semantic law, not a claim that any consumer is ALIVE.
hs:ConstitutionV1 a hs:Constitution ;
  hs:equation "A=mu(O*)" ;
  hs:constructOnly true ;
  hs:standingPrecedesInteraction true ;
  hs:firstHandshakeEvidence "OCEL_V2" ;
  hs:corpusDigestAlgorithm "BLAKE3" ;
  hs:partDigestAlgorithm "BLAKE3" ;
  hs:requiresExactCorpus true ;
  hs:requiresExactPart true ;
  hs:requiresProcessConformance true ;
  hs:mismatchBehavior "REFUSE_NO_INTERACTION" ;
  hs:runtimeQueryTextAllowed false ;
  hs:runtimeExecutableIRAllowed false ;
  hs:runtimePromptInstructionAllowed false ;
  hs:runtimeShellInstructionAllowed false ;
  hs:runtimeDynamicQueryFragmentAllowed false ;
  hs:foreignCorpusHasStanding false ;
  hs:humanHasAmbientAuthority false ;
  hs:llmHasAmbientAuthority false ;
  hs:knowledgeEqualsStanding false ;
  hs:behavioralEquivalenceImpliesStanding false ;
  hs:artifactPossessionImpliesStanding false ;
  hs:architectureKnowledgeImpliesAuthority false ;
  hs:signedPartRequired true ;
  hs:ambientHostCapabilities false ;
  hs:embeddedStringsPolicy "IMPORT_EXPORT_ONLY" ;
  hs:branchlessRuntimeTarget true ;
  hs:zeroCostRustTarget true ;
  hs:attackSurfaceModel "LAWFUL_REACHABILITY" ;
  hs:probingCanCreateNewTransition false ;
  hs:attackerIntelligenceCanCreateNewTransition false ;
  hs:hasOperator hs:MuV1 ;
  hs:hasSelectorUniverse hs:U8UniverseV1 ;
  hs:hasProcessCarrier hs:OCELV2Carrier ;
  hs:hasHIE hs:HIEV1 .

hs:MuV1 a hs:ManufacturingOperator .

hs:U8UniverseV1 a hs:SelectorUniverse ;
  hs:selectorWidthBits 8 ;
  hs:selectorCount 256 ;
  hs:refusalCompletesUniverse true ;
  hs:selectorTransportsCode false ;
  hs:selectorTransportsIR false ;
  hs:selectorTransportsQueryText false .

hs:OCELV2Carrier a hs:ProcessCarrier ;
  hs:processIsStateEvidence true ;
  hs:processIsCreationStanding true ;
  hs:hasGeometry hs:GeometryV1 ;
  hs:hasAlgebra hs:AlgebraV1 ;
  hs:hasCalculus hs:CalculusV1 .

hs:GeometryV1 a hs:ProcessGeometry ;
  hs:routeIsPartOfSubject true ;
  hs:creationKeyIsProcessGeometry true .

hs:AlgebraV1 a hs:ProcessAlgebra ;
  hs:lawfulComposition true ;
  hs:undefinedCompositionRefuses true .

hs:CalculusV1 a hs:ProcessCalculus ;
  hs:lawfulFlowRequired true ;
  hs:firstDerivativeConformance true ;
  hs:secondDerivativeConformance true ;
  hs:integralProcessInvariants true .

hs:HIEV1 a hs:HyperdimensionalInformationEncryption ;
  hs:meaningLivesInRelations true ;
  hs:singleProjectionAuthoritative false ;
  hs:masterRosettaStoneRequired false ;
  hs:manufactureMayBeNonInjective true ;
  hs:runtimeArtifactEncodesFactory false ;
  hs:hasDimension hs:RDFOntology, hs:SPARQLConstruct, hs:OCELV2Geometry,
                  hs:BLAKE3ExactIdentity, hs:RustZeroCostManufacture,
                  hs:WasmPart, hs:U8Dispatch, hs:StandingDimension,
                  hs:BRCEAuthority .

hs:RDFOntology a hs:HIEDimension .
hs:SPARQLConstruct a hs:HIEDimension .
hs:OCELV2Geometry a hs:HIEDimension .
hs:BLAKE3ExactIdentity a hs:HIEDimension .
hs:RustZeroCostManufacture a hs:HIEDimension .
hs:WasmPart a hs:HIEDimension .
hs:U8Dispatch a hs:HIEDimension .
hs:StandingDimension a hs:HIEDimension .
hs:BRCEAuthority a hs:HIEDimension .

# SHACL refusal surface. A consumer may extend this shape but may not weaken it
# and still claim conformance to ConstitutionV1.
hs:ConstitutionShape a sh:NodeShape ;
  sh:targetClass hs:Constitution ;
  sh:property [ sh:path hs:equation ; sh:hasValue "A=mu(O*)" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path hs:constructOnly ; sh:hasValue true ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:standingPrecedesInteraction ; sh:hasValue true ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:firstHandshakeEvidence ; sh:hasValue "OCEL_V2" ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:corpusDigestAlgorithm ; sh:hasValue "BLAKE3" ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:partDigestAlgorithm ; sh:hasValue "BLAKE3" ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:mismatchBehavior ; sh:hasValue "REFUSE_NO_INTERACTION" ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:runtimeQueryTextAllowed ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:runtimeExecutableIRAllowed ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:runtimePromptInstructionAllowed ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:runtimeShellInstructionAllowed ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:runtimeDynamicQueryFragmentAllowed ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:foreignCorpusHasStanding ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:humanHasAmbientAuthority ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:llmHasAmbientAuthority ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:knowledgeEqualsStanding ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:ambientHostCapabilities ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:embeddedStringsPolicy ; sh:hasValue "IMPORT_EXPORT_ONLY" ; sh:minCount 1 ] .

hs:SelectorUniverseShape a sh:NodeShape ;
  sh:targetClass hs:SelectorUniverse ;
  sh:property [ sh:path hs:selectorWidthBits ; sh:hasValue 8 ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path hs:selectorCount ; sh:hasValue 256 ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path hs:refusalCompletesUniverse ; sh:hasValue true ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:selectorTransportsCode ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:selectorTransportsIR ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:selectorTransportsQueryText ; sh:hasValue false ; sh:minCount 1 ] .

hs:ExecutionCapsuleShape a sh:NodeShape ;
  sh:targetClass hs:ExecutionCapsule ;
  sh:property [
    sh:path hs:selector ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxInclusive 255 ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:property [ sh:path hs:bindsConstruct ; sh:class hs:ConstructOperation ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path hs:bindsPart ; sh:class hs:WasmInterchangeablePart ; sh:minCount 1 ; sh:maxCount 1 ] .

hs:ProcessCarrierShape a sh:NodeShape ;
  sh:targetClass hs:ProcessCarrier ;
  sh:property [ sh:path hs:processIsStateEvidence ; sh:hasValue true ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:processIsCreationStanding ; sh:hasValue true ; sh:minCount 1 ] ;
  sh:property [ sh:path hs:hasGeometry ; sh:class hs:ProcessGeometry ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path hs:hasAlgebra ; sh:class hs:ProcessAlgebra ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path hs:hasCalculus ; sh:class hs:ProcessCalculus ; sh:minCount 1 ; sh:maxCount 1 ] .
