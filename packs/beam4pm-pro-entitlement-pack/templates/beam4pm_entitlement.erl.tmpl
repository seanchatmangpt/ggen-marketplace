%% ---------------------------------------------------------------------------
%% initial_entitlement_state(EntitlementId) -> entitlement_state().
%%
%% The synthetic bottom state for an entitlement with no prior applied event.
%% Its watermark ("", "") compares strictly less than the pos() of any real
%% event (event_id is never the empty string, and effective_at is never the
%% empty string), so the very first event applied to it is always admitted.
%% status ENTITLEMENT_STATE_UNSPECIFIED is the enum's own documented default,
%% never a locally invented sentinel.
%% ---------------------------------------------------------------------------
-spec initial_entitlement_state(binary()) -> entitlement_state().
initial_entitlement_state(EntitlementId) ->
    #entitlement_state{
        entitlement_id = EntitlementId,
        status = <<"ENTITLEMENT_STATE_UNSPECIFIED">>,
        last_applied_event_id = <<"">>,
        updated_at = <<"">>
    }.

%% ---------------------------------------------------------------------------
%% reconcile_entitlement(State, Event) -> NewState | {error, Reason}.
%%
%% State may be `undefined` (no entitlement_state exists yet for this
%% entitlement_id): Event is then applied against initial_entitlement_state/1
%% for Event's own entitlement_id.
%%
%% A State/Event pair naming two different entitlement_id values is a typed
%% refusal ({wrong_partition, ...}), never silently merged into one state --
%% reconciliation partitions strictly by entitlement_id.
%%
%% An Event whose event_type is outside the 13 admitted values is a typed
%% refusal ({unknown_event_type, ...}) propagated from transition/2, and
%% leaves State untouched: never silently ignored (which would lose a real
%% lifecycle transition) and never guessed (which would fabricate one).
%% ---------------------------------------------------------------------------
%% ---------------------------------------------------------------------------
%% REAL BUGS FOUND AND FIXED BY ADVERSARIAL VERIFICATION (2026-08-30), not
%% caught by the original well-formed-input test matrix:
%%
%% 1. SEVERE watermark poisoning: new_entitlement_event/1 validated only
%%    field PRESENCE, never format. A malformed effective_at (e.g.
%%    "zzz-not-a-real-timestamp") sorts ABOVE any real digit-leading
%%    ISO8601 string under plain term order (any lowercase letter byte >
%%    any digit byte), so applying one malformed event permanently
%%    poisoned the watermark: every subsequent real, chronologically-later
%%    event was silently dropped as "stale," with no error and no recovery
%%    path.
%% 2. Empty-string sentinel collision: an event with event_id="" AND
%%    effective_at="" has Pos identical to initial_entitlement_state/1's
%%    own bottom watermark ("", ""), so it was silently indistinguishable
%%    from an already-applied redelivery and dropped even as the very
%%    first event for that entitlement_id.
%%
%% Fix: validate_event_shape/1 rejects both classes with a typed refusal
%% BEFORE any watermark comparison happens, closing both bugs at the same
%% point (both are "the position-defining fields don't look like real
%% values") rather than patching each symptom separately.
%% ---------------------------------------------------------------------------
%% Q2 CROSS-LANGUAGE IDENTITY FIX (2026-08-30): an earlier revision built
%% {byte_size(EventId), re:run(EffectiveAt, Re)} EAGERLY, so a non-binary
%% value in either position-defining field (undefined passes the
%% constructor's presence-only check) crashed with badarg BEFORE any typed
%% refusal could be returned -- while the Elixir projection's lazy clause
%% sequence returned {:error, {:malformed_event, :empty_event_id}} for the
%% same input, and returned :ok outright for a nil event_id with a valid
%% effective_at (admitting a nil audit link into the watermark). Both
%% projections now check sequentially and treat a NON-BINARY value the
%% same as the malformed value of that field: non-binary/empty event_id ->
%% empty_event_id; non-binary/non-ISO8601 effective_at ->
%% invalid_effective_at. Identical typed refusals in both languages, no
%% crash path, no silent admit; behavior on well-formed binary inputs is
%% unchanged.
-spec validate_event_shape(entitlement_event()) -> ok | {error, {malformed_event, atom()}}.
validate_event_shape(Event) ->
    EventId = Event#entitlement_event.event_id,
    EffectiveAt = Event#entitlement_event.effective_at,
    Iso8601Re = "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
    if
        not is_binary(EventId); byte_size(EventId) =:= 0 ->
            {error, {malformed_event, empty_event_id}};
        not is_binary(EffectiveAt) ->
            {error, {malformed_event, invalid_effective_at}};
        true ->
            case re:run(EffectiveAt, Iso8601Re) of
                nomatch -> {error, {malformed_event, invalid_effective_at}};
                {match, _} -> ok
            end
    end.

-spec reconcile_entitlement(entitlement_state() | undefined, entitlement_event()) ->
          entitlement_state()
          | {error, {wrong_partition, binary(), binary()}}
          | {error, {unknown_event_type, binary()}}
          | {error, {malformed_event, atom()}}.
reconcile_entitlement(undefined, Event) ->
    reconcile_entitlement(
        initial_entitlement_state(Event#entitlement_event.entitlement_id), Event);
reconcile_entitlement(State, Event) ->
    case validate_event_shape(Event) of
        {error, _} = Malformed ->
            Malformed;
        ok ->
    case State#entitlement_state.entitlement_id =:= Event#entitlement_event.entitlement_id of
        false ->
            {error, {wrong_partition,
                     State#entitlement_state.entitlement_id,
                     Event#entitlement_event.entitlement_id}};
        true ->
            Pos = {Event#entitlement_event.effective_at, Event#entitlement_event.event_id},
            Wm = {State#entitlement_state.updated_at, State#entitlement_state.last_applied_event_id},
            case Pos > Wm of
                false ->
                    %% Redelivery (Pos =:= Wm) or a stale out-of-order event
                    %% (Pos < Wm): no-op. State is returned byte-for-byte
                    %% unchanged, which is exactly what makes this function
                    %% idempotent under replay.
                    State;
                true ->
                    case transition(Event#entitlement_event.event_type, State#entitlement_state.status) of
                        {error, _} = Refused ->
                            Refused;
                        NewStatus ->
                            State#entitlement_state{
                                status = NewStatus,
                                last_applied_event_id = Event#entitlement_event.event_id,
                                updated_at = Event#entitlement_event.effective_at
                            }
                    end
            end
    end
    end.

%% ---------------------------------------------------------------------------
%% transition(EventType, CurrentStatus) -> NewStatus | {error, {unknown_event_type, EventType}}.
%%
%% Total over the 13 admitted entitlement_event.event_type values and nothing
%% else. This is deliberately NOT a rename of event_type to status: the two
%% closed sets are not the same set (ENTITLEMENT_SUSPENDED is a reachable
%% status with no corresponding event type -- a named limit this fold cannot
%% close; ENTITLEMENT_RENEWED / ENTITLEMENT_OFFER_ENDED / ENTITLEMENT_DELETED
%% are event types with no distinct status). ENTITLEMENT_OFFER_ENDED and
%% ENTITLEMENT_DELETED leave CurrentStatus unchanged (commercial-term/tombstone
%% facts the 8-value status enum cannot express) but the event still advances
%% the caller's watermark via reconcile_entitlement/2 -- not advancing would
%% let the same event be reapplied forever.
%% ---------------------------------------------------------------------------
-spec transition(binary(), binary()) -> binary() | {error, {unknown_event_type, binary()}}.
transition(<<"ENTITLEMENT_CREATION_REQUESTED">>, _CurrentStatus) ->
    <<"ENTITLEMENT_ACTIVATION_REQUESTED">>;
transition(<<"ENTITLEMENT_OFFER_ACCEPTED">>, _CurrentStatus) ->
    <<"ENTITLEMENT_ACTIVATION_REQUESTED">>;
transition(<<"ENTITLEMENT_ACTIVE">>, _CurrentStatus) ->
    <<"ENTITLEMENT_ACTIVE">>;
transition(<<"ENTITLEMENT_PLAN_CHANGE_REQUESTED">>, _CurrentStatus) ->
    <<"ENTITLEMENT_PENDING_PLAN_CHANGE_APPROVAL">>;
transition(<<"ENTITLEMENT_PLAN_CHANGED">>, _CurrentStatus) ->
    <<"ENTITLEMENT_ACTIVE">>;
transition(<<"ENTITLEMENT_PLAN_CHANGE_CANCELLED">>, _CurrentStatus) ->
    <<"ENTITLEMENT_ACTIVE">>;
transition(<<"ENTITLEMENT_PENDING_CANCELLATION">>, _CurrentStatus) ->
    <<"ENTITLEMENT_PENDING_CANCELLATION">>;
transition(<<"ENTITLEMENT_CANCELLING">>, _CurrentStatus) ->
    <<"ENTITLEMENT_PENDING_CANCELLATION">>;
transition(<<"ENTITLEMENT_CANCELLATION_REVERTED">>, _CurrentStatus) ->
    <<"ENTITLEMENT_ACTIVE">>;
transition(<<"ENTITLEMENT_CANCELLED">>, _CurrentStatus) ->
    <<"ENTITLEMENT_CANCELLED">>;
transition(<<"ENTITLEMENT_RENEWED">>, _CurrentStatus) ->
    <<"ENTITLEMENT_ACTIVE">>;
transition(<<"ENTITLEMENT_OFFER_ENDED">>, CurrentStatus) ->
    CurrentStatus;
transition(<<"ENTITLEMENT_DELETED">>, CurrentStatus) ->
    CurrentStatus;
transition(Unknown, _CurrentStatus) ->
    {error, {unknown_event_type, Unknown}}.
