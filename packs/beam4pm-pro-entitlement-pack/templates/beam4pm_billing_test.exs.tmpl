# GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
#
# ExUnit court for BeamPM.Billing, proving MP6 dedup-correctness AND the
# caller-supplied half-open period filter (reconcile/4) with concrete
# adversarial usage_event sequences, including the real cross-period
# double-billing bug found and fixed 2026-08-30 (see
# "cross-period double billing is prevented" below). Mirrors the Erlang
# beam4pm_billing_tests.erl EUnit court test-for-test.
# Admitted bpm:RecordType graph size for this pack: {{ records | length }} record types.
defmodule BeamPM.BillingTest do
  use ExUnit.Case, async: true

  alias BeamPM.Billing
  alias BeamPM.Billing.BillingReconciliation
  alias BeamPM.Billing.UsageEvent

  defp event!(event_id, entitlement_id, quantity, metric_name, occurred_at) do
    {:ok, event} =
      UsageEvent.new(%{
        event_id: event_id,
        entitlement_id: entitlement_id,
        quantity: quantity,
        metric_name: metric_name,
        occurred_at: occurred_at
      })

    event
  end

  # A generous default period covering all fixture timestamps in this file
  # (all fixtures use 2026-08-29 dates), so tests not specifically about
  # period boundaries don't need to hand-derive one.
  defp all_2026_08_29, do: {"2026-08-29T00:00:00Z", "2026-08-30T00:00:00Z"}

  # ---------------------------------------------------------------------------
  # Adversarial dedup-correctness tests.
  # ---------------------------------------------------------------------------

  test "reconcile/4 dedups the exact same usage_event repeated 3 times in a row: total is ONE occurrence, not three" do
    ev = event!("ev1", "e1", 5.0, "api_calls", "2026-08-29T10:00:00Z")

    result = Billing.reconcile([ev, ev, ev], "e1", "api_calls", all_2026_08_29())
    assert %BillingReconciliation{entitlement_id: "e1", metric_name: "api_calls"} = result
    assert result.total_quantity == 5.0
    assert result.applied_event_ids == ["ev1"]
  end

  test "reconcile/4 dedups an arbitrary repeat count (5x), not just a fixed arity" do
    ev = event!("ev9", "e1", 7.5, "api_calls", "2026-08-29T10:00:00Z")

    result = Billing.reconcile([ev, ev, ev, ev, ev], "e1", "api_calls", all_2026_08_29())
    assert result.total_quantity == 7.5
    assert result.applied_event_ids == ["ev9"]
  end

  test "reconcile/4 produces an identical total for the same events in reverse order" do
    events = [
      event!("ev1", "e1", 1.0, "api_calls", "2026-08-29T10:00:00Z"),
      event!("ev2", "e1", 2.0, "api_calls", "2026-08-29T10:01:00Z"),
      event!("ev3", "e1", 3.0, "api_calls", "2026-08-29T10:02:00Z"),
      event!("ev4", "e1", 4.0, "api_calls", "2026-08-29T10:03:00Z"),
      event!("ev5", "e1", 5.0, "api_calls", "2026-08-29T10:04:00Z")
    ]

    forward = Billing.reconcile(events, "e1", "api_calls", all_2026_08_29())
    reverse = Billing.reconcile(Enum.reverse(events), "e1", "api_calls", all_2026_08_29())

    assert forward.total_quantity == 15.0
    assert forward.total_quantity == reverse.total_quantity
    assert forward.applied_event_ids == reverse.applied_event_ids
    assert forward.applied_event_ids == ["ev1", "ev2", "ev3", "ev4", "ev5"]
  end

  test "reconcile/4 never sums events across different entitlement_ids or different metric_names" do
    events = [
      event!("a1", "e1", 10.0, "api_calls", "2026-08-29T10:00:00Z"),
      event!("a2", "e2", 20.0, "api_calls", "2026-08-29T10:00:00Z"),
      event!("a3", "e1", 30.0, "storage_gb", "2026-08-29T10:00:00Z")
    ]

    r1 = Billing.reconcile(events, "e1", "api_calls", all_2026_08_29())
    r2 = Billing.reconcile(events, "e2", "api_calls", all_2026_08_29())
    r3 = Billing.reconcile(events, "e1", "storage_gb", all_2026_08_29())

    assert r1.total_quantity == 10.0
    assert r2.total_quantity == 20.0
    assert r3.total_quantity == 30.0
  end

  test "reconcile/4 correctly dedups and partitions a shuffled, duplicated, multi-group stream" do
    e1 = event!("m1", "e9", 2.0, "api_calls", "2026-08-29T09:00:00Z")
    e2 = event!("m2", "e9", 3.0, "api_calls", "2026-08-29T09:01:00Z")
    f1 = event!("n1", "e8", 100.0, "storage_gb", "2026-08-29T09:00:00Z")

    # e1 and f1 each appear twice, in a shuffled order.
    events = [f1, e2, e1, f1, e1, e2]

    r1 = Billing.reconcile(events, "e9", "api_calls", all_2026_08_29())
    r2 = Billing.reconcile(events, "e8", "storage_gb", all_2026_08_29())

    assert r1.total_quantity == 5.0
    assert r1.applied_event_ids == ["m1", "m2"]
    assert r2.total_quantity == 100.0
    assert r2.applied_event_ids == ["n1"]
  end

  test "reconcile/4 on an empty list produces a real, well-defined zero-total answer -- never crashes" do
    result = Billing.reconcile([], "e1", "api_calls", all_2026_08_29())
    assert result.total_quantity == 0.0
    assert result.applied_event_ids == []
  end

  # ---------------------------------------------------------------------------
  # REAL BUG regression fence (2026-08-30): cross-period double billing.
  #
  # An earlier revision (reconcile/1, no period argument) derived
  # period_start/period_end AFTER THE FACT from each call's own input
  # batch. The SAME usage_event landing in both an "August" batch and a
  # "September" batch (a realistic off-by-one query or an at-least-once
  # redelivery spanning a period rollover) was counted in BOTH periods'
  # totals, since each period's own dedup set was internally
  # duplicate-free and had no visibility into the other period's set.
  # This test mechanically proves the fix: with an explicit half-open
  # period argument, a boundary event belongs to exactly one of the two
  # adjacent periods, never both.
  # ---------------------------------------------------------------------------
  test "cross-period double billing is prevented by the caller-supplied half-open period filter" do
    aug1 = event!("aug1", "e1", 10.0, "api_calls", "2026-08-29T10:00:00Z")
    # Lands EXACTLY on the boundary between August and September.
    boundary_ev = event!("boundary-ev", "e1", 100.0, "api_calls", "2026-09-01T00:00:00Z")
    sep1 = event!("sep1", "e1", 20.0, "api_calls", "2026-09-15T00:00:00Z")
    all_events = [aug1, boundary_ev, sep1]

    aug_period = {"2026-08-01T00:00:00Z", "2026-09-01T00:00:00Z"}
    sep_period = {"2026-09-01T00:00:00Z", "2026-10-01T00:00:00Z"}

    aug_result = Billing.reconcile(all_events, "e1", "api_calls", aug_period)
    sep_result = Billing.reconcile(all_events, "e1", "api_calls", sep_period)

    # August's half-open [Aug1, Sep1) EXCLUDES the boundary event (it
    # lands exactly at Sep1, not before it) -- August only ever sees aug1.
    assert aug_result.total_quantity == 10.0
    assert aug_result.applied_event_ids == ["aug1"]
    # September's half-open [Sep1, Oct1) INCLUDES the boundary event (it
    # lands exactly at the lower, inclusive bound) plus sep1.
    assert sep_result.total_quantity == 120.0
    assert sep_result.applied_event_ids == ["boundary-ev", "sep1"]
    # The invariant this whole fix exists for: summed across both periods,
    # the boundary event's 100.0 is counted EXACTLY ONCE, not twice.
    assert aug_result.total_quantity + sep_result.total_quantity == 130.0
  end

  # ---------------------------------------------------------------------------
  # Baseline constructor coverage (beam4pm_types_test.exs.tmpl precedent).
  # ---------------------------------------------------------------------------

  test "UsageEvent.new/1 builds a real struct on the ok path" do
    assert {:ok, %UsageEvent{event_id: "ev1", quantity: 1.0}} =
             UsageEvent.new(%{
               event_id: "ev1",
               entitlement_id: "e1",
               quantity: 1.0,
               metric_name: "api_calls",
               occurred_at: "2026-08-29T10:00:00Z"
             })
  end

  test "UsageEvent.new/1 refuses construction when a required field is missing" do
    assert {:error, {:missing_field, :event_id}} = UsageEvent.new(%{entitlement_id: "e1"})
  end

  test "BillingReconciliation.new/1 builds a real struct on the ok path" do
    assert {:ok, %BillingReconciliation{total_quantity: 3.0}} =
             BillingReconciliation.new(%{
               entitlement_id: "e1",
               metric_name: "api_calls",
               total_quantity: 3.0,
               applied_event_ids: ["ev1", "ev2"],
               period_start: "2026-08-29T00:00:00Z",
               period_end: "2026-08-30T00:00:00Z"
             })
  end

  test "BillingReconciliation.new/1 refuses construction when a required field is missing" do
    assert {:error, {:missing_field, :entitlement_id}} = BillingReconciliation.new(%{})
  end
end
