%% ---------------------------------------------------------------------------
%% reconcile_billing([usage_event()], EntitlementId, MetricName,
%%                    {PeriodStart, PeriodEnd}) -> billing_reconciliation().
%%
%% HAND-DESIGNED (not templated field-by-field), following the
%% beam4pm_discovery.erl.tmpl precedent of literal algorithmic code operating
%% on the schema-driven accessors above.
%%
%% Anti-double-billing contract (the actual MP6 requirement): only events
%% matching {EntitlementId, MetricName} AND satisfying
%% PeriodStart =< occurred_at < PeriodEnd (half-open: PeriodStart itself is
%% in-period, PeriodEnd itself is NOT) are considered at all -- filtering
%% happens BEFORE dedup/sum, not after. An event landing exactly on
%% PeriodEnd belongs to the NEXT period's call, never this one's, which is
%% what makes it impossible for the same event_id to be counted by two
%% adjacent calls: the two periods' filters are disjoint by construction.
%%
%% Dedup contract (unchanged from the prior revision, still correct on its
%% own terms): within the filtered set, deduplicated by event_id via an
%% Erlang map -- first-occurrence-wins, arrival-order-independent both in
%% count and in which duplicate survives. total_quantity sums
%% applied_event_ids (sorted ascending) in that order, never the raw
%% input list, so the total is a pure function of the deduplicated set.
%%
%% period_start/period_end on the returned record are the CALLER-SUPPLIED
%% bounds verbatim, never derived from occurred_at -- this is what makes
%% two adjacent calls' periods provably disjoint (derived-from-data bounds
%% could not offer that guarantee, and could themselves invert under mixed
%% timestamp precision, a real bug found and closed by this same fix).
%%
%% An empty filtered set returns a well-defined zero-total reconciliation
%% for the given entitlement_id/metric_name/period, never a crash --
%% "zero matching events" is a legitimate real outcome (nothing happened
%% for this customer in this period), not an error.
%%
%% REAL BUG FOUND AND FIXED (2026-08-30) by adversarial verification:
%% PeriodStart >= PeriodEnd (an inverted or empty window -- a realistic
%% operator error: swapped call-site arguments) was never guarded. The
%% filter's own >= / < comparisons make an inverted window match ZERO
%% events unconditionally, so the function silently returned a
%% well-formed zero-total reconciliation with the nonsensical bounds
%% echoed back verbatim -- indistinguishable from a legitimate
%% "no usage this period" answer, silently under-billing a customer with
%% real usage in the (correctly-ordered) window the caller meant to ask
%% about. Reproduced against the real compiled module before this fix.
%% Now a typed refusal, never silent.
-spec reconcile_billing([usage_event()], binary(), binary(), {binary(), binary()}) ->
          billing_reconciliation() | {error, {invalid_period, binary(), binary()}}.
reconcile_billing(_Events, _EntitlementId, _MetricName, {PeriodStart, PeriodEnd})
        when PeriodStart >= PeriodEnd ->
    {error, {invalid_period, PeriodStart, PeriodEnd}};
reconcile_billing(Events, EntitlementId, MetricName, {PeriodStart, PeriodEnd}) ->
    InScope = lists:filter(
        fun(Ev) ->
            usage_event_entitlement_id(Ev) =:= EntitlementId
                andalso usage_event_metric_name(Ev) =:= MetricName
                andalso usage_event_occurred_at(Ev) >= PeriodStart
                andalso usage_event_occurred_at(Ev) < PeriodEnd
        end,
        Events),
    EventsById = lists:foldl(
        fun(Ev, Acc) ->
            EventId = usage_event_event_id(Ev),
            case maps:is_key(EventId, Acc) of
                true -> Acc;
                false -> maps:put(EventId, Ev, Acc)
            end
        end,
        #{},
        InScope),
    AppliedIds = lists:sort(maps:keys(EventsById)),
    TotalQuantity = lists:foldl(
        fun(EventId, Sum) ->
            Sum + usage_event_quantity(maps:get(EventId, EventsById))
        end,
        0.0,
        AppliedIds),
    {ok, Reconciliation} = new_billing_reconciliation(#{
        entitlement_id => EntitlementId,
        metric_name => MetricName,
        total_quantity => TotalQuantity,
        applied_event_ids => AppliedIds,
        period_start => PeriodStart,
        period_end => PeriodEnd
    }),
    Reconciliation.
