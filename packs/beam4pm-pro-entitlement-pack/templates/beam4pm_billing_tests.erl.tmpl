%% GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
%%
%% EUnit court for beam4pm_billing, proving MP6 dedup-correctness AND the
%% caller-supplied half-open period filter (reconcile_billing/4) with
%% concrete adversarial usage_event sequences, including the real
%% cross-period double-billing bug found and fixed 2026-08-30 (see
%% cross_period_double_bill_prevented_test below).
%% Admitted bpm:RecordType graph size for this pack: {{ records | length }} record types.

-module(beam4pm_billing_tests).

-include_lib("eunit/include/eunit.hrl").

%% No explicit -export: EUnit's parse transform auto-exports *_test/0.

ev(EventId, EntitlementId, Quantity, MetricName, OccurredAt) ->
    {ok, Ev} = beam4pm_billing:new_usage_event(
        #{event_id => EventId, entitlement_id => EntitlementId, quantity => Quantity,
          metric_name => MetricName, occurred_at => OccurredAt}),
    Ev.

%% A generous default period covering all fixture timestamps in this file
%% (all fixtures use 2026-08-29 dates), so tests not specifically about
%% period boundaries don't need to hand-derive one.
all_2026_08_29() -> {<<"2026-08-29T00:00:00Z">>, <<"2026-08-30T00:00:00Z">>}.

%% ---------------------------------------------------------------------------
%% Adversarial dedup-correctness tests.
%% ---------------------------------------------------------------------------

%% The exact same usage_event repeated 3 times in a row: total_quantity must
%% equal ONE occurrence's quantity (5.0), not three (15.0), and
%% applied_event_ids must list ev1 exactly once.
triple_repeat_dedup_test() ->
    Ev = ev(<<"ev1">>, <<"e1">>, 5.0, <<"api_calls">>, <<"2026-08-29T10:00:00Z">>),
    Result = beam4pm_billing:reconcile_billing([Ev, Ev, Ev], <<"e1">>, <<"api_calls">>, all_2026_08_29()),
    ?assertEqual(<<"e1">>, beam4pm_billing:billing_reconciliation_entitlement_id(Result)),
    ?assertEqual(<<"api_calls">>, beam4pm_billing:billing_reconciliation_metric_name(Result)),
    ?assertEqual(5.0, beam4pm_billing:billing_reconciliation_total_quantity(Result)),
    ?assertEqual([<<"ev1">>], beam4pm_billing:billing_reconciliation_applied_event_ids(Result)).

%% A DIFFERENT triple repeat (not just a fixed-arity call, an arbitrary
%% repeat count) still dedups to exactly one occurrence's worth.
five_times_repeat_dedup_test() ->
    Ev = ev(<<"ev9">>, <<"e1">>, 7.5, <<"api_calls">>, <<"2026-08-29T10:00:00Z">>),
    Result = beam4pm_billing:reconcile_billing([Ev, Ev, Ev, Ev, Ev], <<"e1">>, <<"api_calls">>, all_2026_08_29()),
    ?assertEqual(7.5, beam4pm_billing:billing_reconciliation_total_quantity(Result)),
    ?assertEqual([<<"ev9">>], beam4pm_billing:billing_reconciliation_applied_event_ids(Result)).

%% The same events in reverse order must produce an IDENTICAL total to
%% forward order (order-independence of the fold).
reverse_order_same_total_test() ->
    Events = [
        ev(<<"ev1">>, <<"e1">>, 1.0, <<"api_calls">>, <<"2026-08-29T10:00:00Z">>),
        ev(<<"ev2">>, <<"e1">>, 2.0, <<"api_calls">>, <<"2026-08-29T10:01:00Z">>),
        ev(<<"ev3">>, <<"e1">>, 3.0, <<"api_calls">>, <<"2026-08-29T10:02:00Z">>),
        ev(<<"ev4">>, <<"e1">>, 4.0, <<"api_calls">>, <<"2026-08-29T10:03:00Z">>),
        ev(<<"ev5">>, <<"e1">>, 5.0, <<"api_calls">>, <<"2026-08-29T10:04:00Z">>)
    ],
    Forward = beam4pm_billing:reconcile_billing(Events, <<"e1">>, <<"api_calls">>, all_2026_08_29()),
    Reverse = beam4pm_billing:reconcile_billing(lists:reverse(Events), <<"e1">>, <<"api_calls">>, all_2026_08_29()),
    ?assertEqual(15.0, beam4pm_billing:billing_reconciliation_total_quantity(Forward)),
    ?assertEqual(beam4pm_billing:billing_reconciliation_total_quantity(Forward),
                 beam4pm_billing:billing_reconciliation_total_quantity(Reverse)),
    ?assertEqual(beam4pm_billing:billing_reconciliation_applied_event_ids(Forward),
                 beam4pm_billing:billing_reconciliation_applied_event_ids(Reverse)),
    ?assertEqual([<<"ev1">>, <<"ev2">>, <<"ev3">>, <<"ev4">>, <<"ev5">>],
                 beam4pm_billing:billing_reconciliation_applied_event_ids(Forward)).

%% Events for two DIFFERENT entitlement_ids, and events for two DIFFERENT
%% metric_names on the SAME entitlement_id, must never be summed together --
%% reconcile_billing/4 only counts events matching the EXACT
%% (entitlement_id, metric_name) partition requested.
distinct_groups_never_summed_test() ->
    Events = [
        ev(<<"a1">>, <<"e1">>, 10.0, <<"api_calls">>, <<"2026-08-29T10:00:00Z">>),
        ev(<<"a2">>, <<"e2">>, 20.0, <<"api_calls">>, <<"2026-08-29T10:00:00Z">>),
        ev(<<"a3">>, <<"e1">>, 30.0, <<"storage_gb">>, <<"2026-08-29T10:00:00Z">>)
    ],
    R1 = beam4pm_billing:reconcile_billing(Events, <<"e1">>, <<"api_calls">>, all_2026_08_29()),
    R2 = beam4pm_billing:reconcile_billing(Events, <<"e2">>, <<"api_calls">>, all_2026_08_29()),
    R3 = beam4pm_billing:reconcile_billing(Events, <<"e1">>, <<"storage_gb">>, all_2026_08_29()),
    ?assertEqual(10.0, beam4pm_billing:billing_reconciliation_total_quantity(R1)),
    ?assertEqual(20.0, beam4pm_billing:billing_reconciliation_total_quantity(R2)),
    ?assertEqual(30.0, beam4pm_billing:billing_reconciliation_total_quantity(R3)).

%% Mixed reordering AND duplication together: a shuffled, duplicated stream
%% spanning two groups must still dedup and partition correctly when each
%% group is reconciled separately.
shuffled_duplicated_mixed_groups_test() ->
    E1 = ev(<<"m1">>, <<"e9">>, 2.0, <<"api_calls">>, <<"2026-08-29T09:00:00Z">>),
    E2 = ev(<<"m2">>, <<"e9">>, 3.0, <<"api_calls">>, <<"2026-08-29T09:01:00Z">>),
    F1 = ev(<<"n1">>, <<"e8">>, 100.0, <<"storage_gb">>, <<"2026-08-29T09:00:00Z">>),
    %% E1 and F1 each appear twice, in a shuffled order.
    Events = [F1, E2, E1, F1, E1, E2],
    R1 = beam4pm_billing:reconcile_billing(Events, <<"e9">>, <<"api_calls">>, all_2026_08_29()),
    R2 = beam4pm_billing:reconcile_billing(Events, <<"e8">>, <<"storage_gb">>, all_2026_08_29()),
    ?assertEqual(5.0, beam4pm_billing:billing_reconciliation_total_quantity(R1)),
    ?assertEqual([<<"m1">>, <<"m2">>], beam4pm_billing:billing_reconciliation_applied_event_ids(R1)),
    ?assertEqual(100.0, beam4pm_billing:billing_reconciliation_total_quantity(R2)),
    ?assertEqual([<<"n1">>], beam4pm_billing:billing_reconciliation_applied_event_ids(R2)).

%% An empty event list must produce a real, well-defined zero-total
%% reconciliation -- never crash.
empty_list_no_crash_test() ->
    Result = beam4pm_billing:reconcile_billing([], <<"e1">>, <<"api_calls">>, all_2026_08_29()),
    ?assertEqual(0.0, beam4pm_billing:billing_reconciliation_total_quantity(Result)),
    ?assertEqual([], beam4pm_billing:billing_reconciliation_applied_event_ids(Result)).

%% ---------------------------------------------------------------------------
%% REAL BUG regression fence (2026-08-30): cross-period double billing.
%%
%% An earlier revision (reconcile_billing/1, no period argument) derived
%% period_start/period_end AFTER THE FACT from each call's own input batch.
%% The SAME usage_event landing in both an "August" batch and a "September"
%% batch (a realistic off-by-one query or an at-least-once redelivery
%% spanning a period rollover) was counted in BOTH periods' totals, since
%% each period's own dedup set was internally duplicate-free and had no
%% visibility into the other period's set. This test mechanically proves
%% the fix: with an explicit half-open period argument, a boundary event
%% belongs to exactly one of the two adjacent periods, never both.
%% ---------------------------------------------------------------------------
cross_period_double_bill_prevented_test() ->
    Aug1 = ev(<<"aug1">>, <<"e1">>, 10.0, <<"api_calls">>, <<"2026-08-29T10:00:00Z">>),
    %% Lands EXACTLY on the boundary between August and September.
    BoundaryEv = ev(<<"boundary-ev">>, <<"e1">>, 100.0, <<"api_calls">>, <<"2026-09-01T00:00:00Z">>),
    Sep1 = ev(<<"sep1">>, <<"e1">>, 20.0, <<"api_calls">>, <<"2026-09-15T00:00:00Z">>),
    AllEvents = [Aug1, BoundaryEv, Sep1],

    AugPeriod = {<<"2026-08-01T00:00:00Z">>, <<"2026-09-01T00:00:00Z">>},
    SepPeriod = {<<"2026-09-01T00:00:00Z">>, <<"2026-10-01T00:00:00Z">>},

    AugResult = beam4pm_billing:reconcile_billing(AllEvents, <<"e1">>, <<"api_calls">>, AugPeriod),
    SepResult = beam4pm_billing:reconcile_billing(AllEvents, <<"e1">>, <<"api_calls">>, SepPeriod),

    %% August's half-open [Aug1, Sep1) EXCLUDES the boundary event (it
    %% lands exactly at Sep1, not before it) -- August only ever sees aug1.
    ?assertEqual(10.0, beam4pm_billing:billing_reconciliation_total_quantity(AugResult)),
    ?assertEqual([<<"aug1">>], beam4pm_billing:billing_reconciliation_applied_event_ids(AugResult)),
    %% September's half-open [Sep1, Oct1) INCLUDES the boundary event (it
    %% lands exactly at the lower, inclusive bound) plus sep1.
    ?assertEqual(120.0, beam4pm_billing:billing_reconciliation_total_quantity(SepResult)),
    ?assertEqual([<<"boundary-ev">>, <<"sep1">>], beam4pm_billing:billing_reconciliation_applied_event_ids(SepResult)),
    %% The invariant this whole fix exists for: summed across both periods,
    %% the boundary event's 100.0 is counted EXACTLY ONCE, not twice.
    Combined = beam4pm_billing:billing_reconciliation_total_quantity(AugResult)
             + beam4pm_billing:billing_reconciliation_total_quantity(SepResult),
    ?assertEqual(130.0, Combined).

