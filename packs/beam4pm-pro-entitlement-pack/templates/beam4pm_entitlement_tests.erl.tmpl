%% GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
%%
%% EUnit court for beam4pm_entitlement (MP3), Chicago-style: real records,
%% real reconcile_entitlement/2 calls, state-based assertions only -- zero
%% mocks. Admitted bpm:RecordType graph size: {{ records | length }} record
%% types projected by this suite.
%%
%% Constructor tests (one ok-path + one missing-required-field test per
%% record type) follow beam4pm_types_tests.erl.tmpl's own pattern exactly.
%% The four adversarial reconciliation tests below are hand-written, proving
%% the CONTRACT stated in beam4pm_entitlement.erl.tmpl's module comment
%% against concrete event sequences, not just asserting it in prose.

-module(beam4pm_entitlement_tests).

-include_lib("eunit/include/eunit.hrl").

%% No explicit -export: EUnit's parse transform auto-exports every *_test/0.

{% for r in records -%}
{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) -%}
{%- set required_fields = rfields | filter(attribute="field_required", value="true") -%}
{{ r.record_name }}_ok_test() ->
    ?assertMatch({ok, _}, beam4pm_entitlement:new_{{ r.record_name }}(#{
{%- for f in rfields %}
        {{ f.field_name }} => {% if f.field_type == "string" %}<<"x">>{% elif f.field_type == "integer" %}1{% elif f.field_type == "float" %}1.0{% elif f.field_type == "boolean" %}true{% elif f.field_type == "datetime" %}<<"2026-01-01T00:00:00Z">>{% elif f.field_type == "atom" %}some_atom{% elif f.field_type == "list_string" %}[<<"a">>]{% elif f.field_type == "map" %}#{}{% endif %}{% if not loop.last %},{% endif %}
{%- endfor %}
    })).

{{ r.record_name }}_missing_field_test() ->
    ?assertMatch({error, {missing_field, _}}, beam4pm_entitlement:new_{{ r.record_name }}(#{})).

{% endfor -%}

%% ---------------------------------------------------------------------------
%% Shared fixtures for the four adversarial reconciliation cases below. All
%% timestamps are fixed-width "YYYY-MM-DDTHH:MM:SSZ" (no fractional seconds)
%% so that byte-wise binary comparison equals chronological order, exactly
%% the assumption reconcile_entitlement/2's watermark comparison relies on.
%% ---------------------------------------------------------------------------

entitlement_id() -> <<"ENT-1">>.

%% event_a: the LATER of the [A,B] pair used by the order-independence case.
event_a() ->
    {ok, Ev} = beam4pm_entitlement:new_entitlement_event(#{
        event_id => <<"evt-a">>,
        entitlement_id => entitlement_id(),
        event_type => <<"ENTITLEMENT_ACTIVE">>,
        effective_at => <<"2026-08-29T10:05:00Z">>
    }),
    Ev.

%% event_b: the EARLIER of the [A,B] pair -- strictly older than event_a.
event_b() ->
    {ok, Ev} = beam4pm_entitlement:new_entitlement_event(#{
        event_id => <<"evt-b">>,
        entitlement_id => entitlement_id(),
        event_type => <<"ENTITLEMENT_CREATION_REQUESTED">>,
        effective_at => <<"2026-08-29T10:00:00Z">>
    }),
    Ev.

create_event() ->
    {ok, Ev} = beam4pm_entitlement:new_entitlement_event(#{
        event_id => <<"evt-create-1">>,
        entitlement_id => entitlement_id(),
        event_type => <<"ENTITLEMENT_CREATION_REQUESTED">>,
        effective_at => <<"2026-08-29T09:00:00Z">>
    }),
    Ev.

cancel_event() ->
    {ok, Ev} = beam4pm_entitlement:new_entitlement_event(#{
        event_id => <<"evt-cancel-1">>,
        entitlement_id => entitlement_id(),
        event_type => <<"ENTITLEMENT_CANCELLED">>,
        effective_at => <<"2026-08-29T09:30:00Z">>
    }),
    Ev.

%% A SUSPENDED entitlement_state as it would be populated by the
%% authoritative entitlement-resource-read path noted as a named limit in
%% beam4pm_entitlement.erl.tmpl's module comment -- the notification fold
%% alone can never produce ENTITLEMENT_SUSPENDED, since no event_type maps
%% to it. Constructed directly here, exactly the way that second path would
%% seed it, with a watermark strictly older than cancel_event/0.
suspended_state() ->
    {ok, State} = beam4pm_entitlement:new_entitlement_state(#{
        entitlement_id => entitlement_id(),
        status => <<"ENTITLEMENT_SUSPENDED">>,
        last_applied_event_id => <<"ext-suspend-read-1">>,
        updated_at => <<"2026-08-29T09:00:00Z">>
    }),
    State.

%% ---------------------------------------------------------------------------
%% 1. Apply the same event twice: the second application must produce a
%%    state IDENTICAL to the first -- idempotency, the core MP3 contract.
%% ---------------------------------------------------------------------------
apply_twice_is_idempotent_test() ->
    State0 = beam4pm_entitlement:initial_entitlement_state(entitlement_id()),
    StateOnce = beam4pm_entitlement:reconcile_entitlement(State0, event_a()),
    StateTwice = beam4pm_entitlement:reconcile_entitlement(StateOnce, event_a()),
    ?assertEqual(StateOnce, StateTwice),
    ?assertEqual(<<"ENTITLEMENT_ACTIVE">>, beam4pm_entitlement:entitlement_state_status(StateTwice)),
    ?assertEqual(<<"evt-a">>, beam4pm_entitlement:entitlement_state_last_applied_event_id(StateTwice)).

%% ---------------------------------------------------------------------------
%% 2. Apply [A, B] (newer-then-older) and [B, A] (older-then-newer), where B
%%    is strictly older than A: both orders must fold to the IDENTICAL final
%%    state, and that state must be the one A produced ("A wins").
%% ---------------------------------------------------------------------------
order_independence_a_then_b_wins_test() ->
    State0 = beam4pm_entitlement:initial_entitlement_state(entitlement_id()),
    %% Order [A, B]: A applies (initial watermark admits anything); B is
    %% then strictly older than A's watermark -> no-op.
    AfterA = beam4pm_entitlement:reconcile_entitlement(State0, event_a()),
    FinalAB = beam4pm_entitlement:reconcile_entitlement(AfterA, event_b()),
    ?assertEqual(AfterA, FinalAB),
    ?assertEqual(<<"ENTITLEMENT_ACTIVE">>, beam4pm_entitlement:entitlement_state_status(FinalAB)),
    ?assertEqual(<<"evt-a">>, beam4pm_entitlement:entitlement_state_last_applied_event_id(FinalAB)).

order_independence_b_then_a_wins_test() ->
    State0 = beam4pm_entitlement:initial_entitlement_state(entitlement_id()),
    %% Order [B, A]: B applies first (initial watermark admits anything);
    %% A is strictly newer than B's watermark -> A applies normally.
    AfterB = beam4pm_entitlement:reconcile_entitlement(State0, event_b()),
    FinalBA = beam4pm_entitlement:reconcile_entitlement(AfterB, event_a()),
    ?assertEqual(<<"ENTITLEMENT_ACTIVE">>, beam4pm_entitlement:entitlement_state_status(FinalBA)),
    ?assertEqual(<<"evt-a">>, beam4pm_entitlement:entitlement_state_last_applied_event_id(FinalBA)),
    %% The two arrival orders converge on the exact same final state.
    AfterA = beam4pm_entitlement:reconcile_entitlement(State0, event_a()),
    FinalAB = beam4pm_entitlement:reconcile_entitlement(AfterA, event_b()),
    ?assertEqual(FinalAB, FinalBA).

%% ---------------------------------------------------------------------------
%% 3. A CREATE event followed by a DUPLICATE of the exact same CREATE event
%%    must leave state unchanged on the duplicate.
%% ---------------------------------------------------------------------------
duplicate_create_is_noop_test() ->
    State0 = beam4pm_entitlement:initial_entitlement_state(entitlement_id()),
    AfterCreate = beam4pm_entitlement:reconcile_entitlement(State0, create_event()),
    ?assertEqual(<<"ENTITLEMENT_ACTIVATION_REQUESTED">>, beam4pm_entitlement:entitlement_state_status(AfterCreate)),
    AfterDuplicateCreate = beam4pm_entitlement:reconcile_entitlement(AfterCreate, create_event()),
    ?assertEqual(AfterCreate, AfterDuplicateCreate).

%% ---------------------------------------------------------------------------
%% 4. Starting from an (authoritatively-seeded) SUSPENDED state, apply
%%    CANCEL, then apply the exact same CANCEL again: the duplicate must be
%%    a no-op, never a second transition or a reversion.
%% ---------------------------------------------------------------------------
cancel_after_suspend_then_duplicate_cancel_test() ->
    Suspended = suspended_state(),
    AfterCancel = beam4pm_entitlement:reconcile_entitlement(Suspended, cancel_event()),
    ?assertEqual(<<"ENTITLEMENT_CANCELLED">>, beam4pm_entitlement:entitlement_state_status(AfterCancel)),
    ?assertEqual(<<"evt-cancel-1">>, beam4pm_entitlement:entitlement_state_last_applied_event_id(AfterCancel)),
    AfterDuplicateCancel = beam4pm_entitlement:reconcile_entitlement(AfterCancel, cancel_event()),
    ?assertEqual(AfterCancel, AfterDuplicateCancel).

%% ---------------------------------------------------------------------------
%% Two supporting refusal-path tests: not part of the requested adversarial
%% matrix, but real, executable proof that the two typed refusals named in
%% reconcile_entitlement/2's own moduledoc actually fire.
%% ---------------------------------------------------------------------------
wrong_partition_is_refused_test() ->
    State0 = beam4pm_entitlement:initial_entitlement_state(<<"ENT-OTHER">>),
    ?assertEqual(
        {error, {wrong_partition, <<"ENT-OTHER">>, <<"ENT-1">>}},
        beam4pm_entitlement:reconcile_entitlement(State0, event_a())).

unknown_event_type_is_refused_test() ->
    {ok, BadEvent} = beam4pm_entitlement:new_entitlement_event(#{
        event_id => <<"evt-bad">>,
        entitlement_id => entitlement_id(),
        event_type => <<"ENTITLEMENT_TELEPORTED">>,
        effective_at => <<"2026-08-29T11:00:00Z">>
    }),
    State0 = beam4pm_entitlement:initial_entitlement_state(entitlement_id()),
    ?assertEqual(
        {error, {unknown_event_type, <<"ENTITLEMENT_TELEPORTED">>}},
        beam4pm_entitlement:reconcile_entitlement(State0, BadEvent)).
