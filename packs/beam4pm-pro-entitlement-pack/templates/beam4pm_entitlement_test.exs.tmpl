# GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
#
# ExUnit court for BeamPM.Entitlement (MP3), Chicago-style: real structs,
# real reconcile_entitlement/2 calls, state-based assertions only -- zero
# mocks. Mirrors beam4pm_entitlement_tests.erl.tmpl's Erlang suite exactly
# (same fixtures, same four adversarial cases, same two refusal checks).
defmodule BeamPM.EntitlementTest do
  use ExUnit.Case, async: true

  alias BeamPM.Entitlement
  alias BeamPM.Entitlement.EntitlementEvent
  alias BeamPM.Entitlement.EntitlementState

  @entitlement_id "ENT-1"

  # All timestamps are fixed-width "YYYY-MM-DDTHH:MM:SSZ" (no fractional
  # seconds) so that byte-wise binary comparison equals chronological
  # order, exactly the assumption reconcile_entitlement/2's watermark
  # comparison relies on.

  # event_a: the LATER of the [a, b] pair used by the order-independence case.
  defp event_a do
    {:ok, event} =
      EntitlementEvent.new(%{
        event_id: "evt-a",
        entitlement_id: @entitlement_id,
        event_type: "ENTITLEMENT_ACTIVE",
        effective_at: "2026-08-29T10:05:00Z"
      })

    event
  end

  # event_b: the EARLIER of the [a, b] pair -- strictly older than event_a.
  defp event_b do
    {:ok, event} =
      EntitlementEvent.new(%{
        event_id: "evt-b",
        entitlement_id: @entitlement_id,
        event_type: "ENTITLEMENT_CREATION_REQUESTED",
        effective_at: "2026-08-29T10:00:00Z"
      })

    event
  end

  defp create_event do
    {:ok, event} =
      EntitlementEvent.new(%{
        event_id: "evt-create-1",
        entitlement_id: @entitlement_id,
        event_type: "ENTITLEMENT_CREATION_REQUESTED",
        effective_at: "2026-08-29T09:00:00Z"
      })

    event
  end

  defp cancel_event do
    {:ok, event} =
      EntitlementEvent.new(%{
        event_id: "evt-cancel-1",
        entitlement_id: @entitlement_id,
        event_type: "ENTITLEMENT_CANCELLED",
        effective_at: "2026-08-29T09:30:00Z"
      })

    event
  end

  # A SUSPENDED entitlement_state as it would be populated by the
  # authoritative entitlement-resource-read path noted as a named limit in
  # BeamPM.Entitlement's moduledoc -- the notification fold alone can never
  # produce ENTITLEMENT_SUSPENDED, since no event_type maps to it.
  # Constructed directly here, exactly the way that second path would seed
  # it, with a watermark strictly older than cancel_event/0.
  defp suspended_state do
    {:ok, state} =
      EntitlementState.new(%{
        entitlement_id: @entitlement_id,
        status: "ENTITLEMENT_SUSPENDED",
        last_applied_event_id: "ext-suspend-read-1",
        updated_at: "2026-08-29T09:00:00Z"
      })

    state
  end

  describe "reconcile_entitlement/2 idempotency and ordering (MP3 contract)" do
    test "applying the same event twice produces an identical state to applying it once" do
      state0 = Entitlement.initial_entitlement_state(@entitlement_id)
      state_once = Entitlement.reconcile_entitlement(state0, event_a())
      state_twice = Entitlement.reconcile_entitlement(state_once, event_a())

      assert state_once == state_twice
      assert %EntitlementState{status: "ENTITLEMENT_ACTIVE", last_applied_event_id: "evt-a"} = state_twice
    end

    test "[a, b] then [b, a], with b strictly older than a, fold to the identical final state (a wins)" do
      state0 = Entitlement.initial_entitlement_state(@entitlement_id)

      # Order [a, b]: a applies (initial watermark admits anything); b is
      # then strictly older than a's watermark -> no-op.
      after_a = Entitlement.reconcile_entitlement(state0, event_a())
      final_ab = Entitlement.reconcile_entitlement(after_a, event_b())
      assert after_a == final_ab
      assert %EntitlementState{status: "ENTITLEMENT_ACTIVE", last_applied_event_id: "evt-a"} = final_ab

      # Order [b, a]: b applies first (initial watermark admits anything);
      # a is strictly newer than b's watermark -> a applies normally.
      after_b = Entitlement.reconcile_entitlement(state0, event_b())
      final_ba = Entitlement.reconcile_entitlement(after_b, event_a())
      assert %EntitlementState{status: "ENTITLEMENT_ACTIVE", last_applied_event_id: "evt-a"} = final_ba

      # The two arrival orders converge on the exact same final state.
      assert final_ab == final_ba
    end

    test "a CREATE followed by a duplicate CREATE leaves state unchanged on the duplicate" do
      state0 = Entitlement.initial_entitlement_state(@entitlement_id)
      after_create = Entitlement.reconcile_entitlement(state0, create_event())
      assert %EntitlementState{status: "ENTITLEMENT_ACTIVATION_REQUESTED"} = after_create

      after_duplicate_create = Entitlement.reconcile_entitlement(after_create, create_event())
      assert after_create == after_duplicate_create
    end

    test "CANCEL after SUSPEND transitions to CANCELLED, and a duplicate CANCEL is a no-op" do
      suspended = suspended_state()
      after_cancel = Entitlement.reconcile_entitlement(suspended, cancel_event())

      assert %EntitlementState{status: "ENTITLEMENT_CANCELLED", last_applied_event_id: "evt-cancel-1"} =
               after_cancel

      after_duplicate_cancel = Entitlement.reconcile_entitlement(after_cancel, cancel_event())
      assert after_cancel == after_duplicate_cancel
    end

    test "an event for a different entitlement_id is a typed wrong_partition refusal" do
      state0 = Entitlement.initial_entitlement_state("ENT-OTHER")

      assert {:error, {:wrong_partition, "ENT-OTHER", "ENT-1"}} =
               Entitlement.reconcile_entitlement(state0, event_a())
    end

    test "an unrecognized event_type is a typed unknown_event_type refusal" do
      {:ok, bad_event} =
        EntitlementEvent.new(%{
          event_id: "evt-bad",
          entitlement_id: @entitlement_id,
          event_type: "ENTITLEMENT_TELEPORTED",
          effective_at: "2026-08-29T11:00:00Z"
        })

      state0 = Entitlement.initial_entitlement_state(@entitlement_id)

      assert {:error, {:unknown_event_type, "ENTITLEMENT_TELEPORTED"}} =
               Entitlement.reconcile_entitlement(state0, bad_event)
    end
  end
