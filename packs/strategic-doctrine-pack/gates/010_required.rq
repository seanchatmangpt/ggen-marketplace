# MESSAGE: every sdo:Strategy must carry at least one sdo:applicableWhen, one
# sdo:falsifiedBy, and one sdo:method (HTN method realization). Any row = a
# strategy missing a required doctrine element. Gates run against the UNION
# graph (this pack's facts + every other pack's + the consumer's own
# ontology.ttl), so the violation may come from any source.
PREFIX sdo: <https://ggen.dev/ontology/strategic-doctrine#>
SELECT ?strategy ?missing WHERE {
  ?strategy a sdo:Strategy .
  VALUES ?missing { sdo:applicableWhen sdo:falsifiedBy sdo:method }
  FILTER NOT EXISTS { ?strategy ?missing ?value }
}
ORDER BY ?strategy ?missing
