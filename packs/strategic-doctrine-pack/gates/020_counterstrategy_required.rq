# MESSAGE: every sdo:Strategy must declare at least one sdo:counteredBy
# (a Counterstrategy). Any row = a strategy asserting itself invincible —
# no articulated counter exists for it.
PREFIX sdo: <https://ggen.dev/ontology/strategic-doctrine#>
SELECT ?strategy WHERE {
  ?strategy a sdo:Strategy .
  FILTER NOT EXISTS { ?strategy sdo:counteredBy ?counter }
}
ORDER BY ?strategy
