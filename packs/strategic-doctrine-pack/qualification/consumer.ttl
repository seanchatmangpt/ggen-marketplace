@prefix sdo: <https://ggen.dev/ontology/strategic-doctrine#> .
@prefix pp: <https://ggen.dev/ontology/planning-policy#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Qualification fixtures for strategic-doctrine-pack (marketplace semantic
# qualification convention: scripts/qualify_packs.py combines this file with
# the pack's ontology.ttl into the consumer graph and runs the pack's gates
# against the union).
#
# Two synthetic fixture strategies, clearly named fixture-*, exercising every
# required doctrine element. They carry NO licensed strategy content: each is
# marked dcterms:rights "fixture" and every named element is fixture-local.
#
# strategyCount: this graph adds two strategies, so it declares the raised
# count 2 on the pack registry. In the union graph the registry then carries
# the ontology's default 0 AND this lawful same-change raise 2;
# gates/030's max-declared semantics admits the raised declaration and would
# refuse a third strategy appearing without a further raise.

sdo:fixture-applicability-a a sdo:ApplicabilityCondition ;
    rdfs:label "fixture: condition A holds" .
sdo:fixture-applicability-b a sdo:ApplicabilityCondition ;
    rdfs:label "fixture: condition B holds" .
sdo:fixture-counterstrategy-a a sdo:Counterstrategy ;
    rdfs:label "fixture: counter to strategy alpha" .
sdo:fixture-counterstrategy-b a sdo:Counterstrategy ;
    rdfs:label "fixture: counter to strategy beta" .
sdo:fixture-falsifier-a a sdo:Falsifier ;
    rdfs:label "fixture: observation that retires strategy alpha" .
sdo:fixture-falsifier-b a sdo:Falsifier ;
    rdfs:label "fixture: observation that retires strategy beta" .
sdo:fixture-method-a a pp:Method ;
    rdfs:label "fixture: HTN method realizing strategy alpha" .
sdo:fixture-method-b a pp:Method ;
    rdfs:label "fixture: HTN method realizing strategy beta" .

sdo:fixture-strategy-alpha a sdo:Strategy ;
    rdfs:label "fixture strategy alpha (synthetic, no licensed content)" ;
    dcterms:rights "fixture" ;
    sdo:applicableWhen sdo:fixture-applicability-a ;
    sdo:counteredBy sdo:fixture-counterstrategy-a ;
    sdo:falsifiedBy sdo:fixture-falsifier-a ;
    sdo:method sdo:fixture-method-a .

sdo:fixture-strategy-beta a sdo:Strategy ;
    rdfs:label "fixture strategy beta (synthetic, no licensed content)" ;
    dcterms:rights "fixture" ;
    sdo:applicableWhen sdo:fixture-applicability-b ;
    sdo:counteredBy sdo:fixture-counterstrategy-b ;
    sdo:falsifiedBy sdo:fixture-falsifier-b ;
    sdo:method sdo:fixture-method-b .

sdo:strategic-doctrine-pack sdo:strategyCount 2 .
