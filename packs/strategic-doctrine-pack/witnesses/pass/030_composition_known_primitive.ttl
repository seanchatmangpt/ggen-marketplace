@prefix sd: <https://ggen.dev/ontology/strategic-doctrine#> .
@prefix cs: <urn:xaas:case-study:> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix w: <urn:example:strategic-doctrine:witness:> .

# PASS witness for 030: every step applies one of the fourteen primitives,
# including both members of a dual pair. All gates return zero rows.

w:cond a sd:StrategicCondition ;
  sd:aboutClass org:Organization ; sd:observedProperty sd:win-rate ;
  sd:comparator "lt" ; sd:threshold 0.35 .

w:falsifier a sd:Falsifier ;
  sd:observedProperty sd:segment-share ; sd:comparator "lt" ; sd:threshold 0.05 ; sd:windowDays 90 ;
  sd:refutedWhen "Segment share stays under 5% after 90 days of the composed steps." .

w:strategy a sd:Strategy ; sd:ordinal 11 ;
  sd:shortTitle "Trade ground for time" ;
  sd:composedOf w:s1 , w:s2 , w:s3 ;
  sd:appliesWhen w:cond ;
  sd:hasFalsifier w:falsifier .

w:s1 a sd:Step ; sd:order 1 ; sd:operator sd:conceal .
w:s2 a sd:Step ; sd:order 2 ; sd:operator sd:reveal .
w:s3 a sd:Step ; sd:order 3 ; sd:operator sd:transform .

w:nonclaim a cs:NonClaim ;
  rdfs:comment "Not licensed; no endorsement; no text of the source work reproduced." ;
  sd:assertsNotLicensed true ; sd:assertsNoEndorsement true ; sd:assertsNoTextReproduced true .
