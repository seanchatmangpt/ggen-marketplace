@prefix sdo: <https://ggen.dev/ontology/strategic-doctrine#> .
@prefix pp: <https://ggen.dev/ontology/planning-policy#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
# FAIL witness for 030_licensed_content_guard: strategy WITHOUT dcterms:rights
# (part a fires). The declared count is 1, matching actual, so the row that
# appears is specifically the unlicensed-content row.
sdo:strategic-doctrine-pack sdo:strategyCount 1 .
sdo:wA a sdo:ApplicabilityCondition .
sdo:wC a sdo:Counterstrategy .
sdo:wF a sdo:Falsifier .
sdo:wM a pp:Method .
sdo:SmuggledStrategy a sdo:Strategy ;
  sdo:applicableWhen sdo:wA ;
  sdo:counteredBy sdo:wC ;
  sdo:falsifiedBy sdo:wF ;
  sdo:method sdo:wM .
