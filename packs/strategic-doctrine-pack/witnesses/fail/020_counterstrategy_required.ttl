@prefix sdo: <https://ggen.dev/ontology/strategic-doctrine#> .
@prefix pp: <https://ggen.dev/ontology/planning-policy#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
# FAIL witness for 020_counterstrategy_required: otherwise-conforming strategy
# with NO sdo:counteredBy — one violation row.
sdo:strategic-doctrine-pack sdo:strategyCount 1 .
sdo:wA a sdo:ApplicabilityCondition .
sdo:wF a sdo:Falsifier .
sdo:wM a pp:Method .
sdo:BrokenStrategy a sdo:Strategy ;
  dcterms:rights "fixture" ;
  sdo:applicableWhen sdo:wA ;
  sdo:falsifiedBy sdo:wF ;
  sdo:method sdo:wM .
