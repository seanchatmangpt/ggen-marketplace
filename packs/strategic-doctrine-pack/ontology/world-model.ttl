@prefix sd: <https://ggen.dev/ontology/strategic-doctrine#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# World-model alignments only. No new world vocabulary is minted where a
# public one exists: actors are W3C ORG organizations and PROV agents,
# markets are schema.org products, steps are PROV activities, falsifier
# readings are SOSA observations, timing is an OWL-Time interval.
#
# Vendored copies of each public vocabulary, with sha256 per file, live
# under sources/vendor/ (see sources/vendor/materialization-receipt.json).
# GeoSPARQL and the OCEL 2.0 ontology are NOT vendored (absent from
# ontologies/public/); nothing here depends on them.

sd:Actor a rdfs:Class ;
    rdfs:subClassOf org:Organization , prov:Agent ;
    rdfs:label "Actor" ;
    rdfs:comment "A party in the contest." .

sd:Market a rdfs:Class ;
    rdfs:subClassOf schema:Product ;
    rdfs:label "Market" ;
    rdfs:comment "The offering class over which actors contend." .

sd:Step rdfs:subClassOf prov:Activity .

sd:FalsifierObservation a rdfs:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "Falsifier observation" ;
    rdfs:comment "A SOSA observation read by a strategic falsifier or condition." .

sd:Timing a rdfs:Class ;
    rdfs:subClassOf time:Interval ;
    rdfs:label "Timing" ;
    rdfs:comment "The interval over which a strategy or falsifier is evaluated." .

# Observable properties read by conditions and falsifiers.

sd:win-rate a sosa:ObservableProperty , ssn:Property ;
    rdfs:label "win rate" ;
    rdfs:comment "Share of contested deals won, 0..1." .

sd:churn-rate a sosa:ObservableProperty , ssn:Property ;
    rdfs:label "churn rate" ;
    rdfs:comment "Share of customers lost per quarter, 0..1." .

sd:runway-months a sosa:ObservableProperty , ssn:Property ;
    rdfs:label "runway months" ;
    rdfs:comment "Months of operation fundable at current burn." .

sd:rival-count a sosa:ObservableProperty , ssn:Property ;
    rdfs:label "rival count" ;
    rdfs:comment "Number of incumbents contesting the same segment." .

sd:rival-response-days a sosa:ObservableProperty , ssn:Property ;
    rdfs:label "rival response days" ;
    rdfs:comment "Days until a rival visibly reacts to a move." .

sd:segment-share a sosa:ObservableProperty , ssn:Property ;
    rdfs:label "segment share" ;
    rdfs:comment "Share of the chosen segment held, 0..1." .

sd:partner-sourced-share a sosa:ObservableProperty , ssn:Property ;
    rdfs:label "partner-sourced share" ;
    rdfs:comment "Share of new revenue sourced by partners, 0..1." .

sd:rival-misallocation a sosa:ObservableProperty , ssn:Property ;
    rdfs:label "rival misallocation" ;
    rdfs:comment "Share of rival spend directed at a decoy front, 0..1." .
