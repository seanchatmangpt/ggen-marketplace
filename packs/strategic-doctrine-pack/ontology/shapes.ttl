@prefix sd: <https://ggen.dev/ontology/strategic-doctrine#> .
@prefix sdsh: <https://ggen.dev/ontology/strategic-doctrine/shape#> .
@prefix cs: <urn:xaas:case-study:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL shapes for the strategic doctrine graph. The SPARQL gates in gates/
# are the fail-closed twins of the laws that need cross-node reasoning
# (total step order, public-class applicability, licensing non-claim,
# no-excerpt); these shapes carry the per-node structure.

sdsh:StrategyShape a sh:NodeShape ;
  sh:targetClass sd:Strategy ;
  sh:property [ sh:path sd:ordinal ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 33 ] ;
  sh:property [ sh:path sd:shortTitle ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:string ; sh:maxLength 60 ] ;
  sh:property [ sh:path sd:sourceWork ; sh:maxCount 1 ; sh:class sd:SourceWork ] ;
  sh:property [ sh:path sd:composedOf ; sh:class sd:Step ] ;
  sh:property [ sh:path sd:hasFalsifier ; sh:class sd:Falsifier ] ;
  sh:property [ sh:path sd:appliesWhen ; sh:class sd:StrategicCondition ] ;
  sh:property [ sh:path sd:producesEffect ; sh:class sd:StrategicEffect ] ;
  sh:property [ sh:path sd:servesObjective ; sh:class sd:StrategicObjective ] ;
  sh:property [ sh:path sd:counteredBy ; sh:class sd:Strategy ] ;
  sh:or ( [ sh:class sd:StrategyStub ;
            sh:property [ sh:path sd:composedOf ; sh:maxCount 0 ] ;
            sh:property [ sh:path sd:hasFalsifier ; sh:maxCount 0 ] ]
          [ sh:not [ sh:class sd:StrategyStub ] ;
            sh:property [ sh:path sd:composedOf ; sh:minCount 1 ] ;
            sh:property [ sh:path sd:hasFalsifier ; sh:minCount 1 ] ] ) ;
  sh:message "A strategy has one ordinal in 1..33 and one own title of at most 60 characters; a stub carries no steps and no falsifier; an operationalized strategy has at least one step and at least one falsifier." .

sdsh:StepShape a sh:NodeShape ;
  sh:targetClass sd:Step ;
  sh:property [ sh:path sd:order ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
  sh:property [ sh:path sd:operator ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( sd:shape sd:probe sd:conceal sd:reveal sd:concentrate sd:disperse
                        sd:delay sd:accelerate sd:commit sd:withdraw sd:divide sd:combine
                        sd:substitute sd:transform ) ] .

sdsh:PrimitiveOperatorShape a sh:NodeShape ;
  sh:targetClass sd:PrimitiveOperator ;
  sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path sd:dualOf ; sh:maxCount 1 ; sh:class sd:PrimitiveOperator ] .

sdsh:FalsifierShape a sh:NodeShape ;
  sh:targetClass sd:Falsifier ;
  sh:property [ sh:path sd:refutedWhen ; sh:minCount 1 ; sh:datatype xsd:string ;
                sh:pattern "^\\s*(?:\\S\\s*){10,}$" ;
                sh:message "A refutation statement holds at least 10 non-whitespace characters." ] ;
  sh:property [ sh:path sd:observedProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path sd:comparator ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( "lt" "lte" "gt" "gte" "eq" ) ] ;
  sh:property [ sh:path sd:threshold ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path sd:windowDays ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] .

sdsh:ConditionShape a sh:NodeShape ;
  sh:targetClass sd:StrategicCondition ;
  sh:property [ sh:path sd:aboutClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path sd:observedProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path sd:comparator ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( "lt" "lte" "gt" "gte" "eq" ) ] ;
  sh:property [ sh:path sd:threshold ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] .

sdsh:ApplicabilityShape a sh:NodeShape ;
  sh:targetClass sd:DoctrineApplicability ;
  sh:property [ sh:path sd:applicabilityOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sd:Strategy ] ;
  sh:property [ sh:path sd:actor ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

sdsh:CatalogShape a sh:NodeShape ;
  sh:targetClass sd:DoctrineCatalog ;
  sh:property [ sh:path sd:authority ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "NONE" ) ] ;
  sh:property [ sh:path sd:authorityCeiling ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( "SELECT" "CONSTRUCT" ) ] .

sdsh:NonClaimShape a sh:NodeShape ;
  sh:targetClass cs:NonClaim ;
  sh:property [ sh:path rdfs:comment ; sh:minCount 1 ] .
