defmodule AshA2A.CS2.ConsumerContract do
  @moduledoc "Generated CS2 consumer contract. Do not hand-edit."

  @subject "https://chatman.ai/cs2#RFC-CS2-001"
  @work_id "CS2-WRK-012"
  @authority_ceiling :construct

  def subject, do: @subject
  def work_id, do: @work_id
  def authority_ceiling, do: @authority_ceiling

  def envelope(evidence) when is_map(evidence) do
    %{
      schema: "cs2-consumer/v1",
      subject: @subject,
      work_id: @work_id,
      authority_ceiling: @authority_ceiling,
      evidence: evidence
    }
  end
end
