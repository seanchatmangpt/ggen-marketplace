@prefix cs2: <https://chatman.ai/cs2#> .

# Producer pin, subject, consumer and replay declarations (formerly pack.toml
# [producer], [subject], [consumer], [replay] tables, which ggen-engine denies).
cs2:pack-cs2-canonical-pack a cs2:PackPin ;
  cs2:producerRepository "seanchatmangpt/chatman-ecosystem" ;
  cs2:producerSha "f3d215e9a4fc6fe17ca4e396cf78254d847cbdd7" ;
  cs2:producerPath "cs2/canonical.ttl" ;
  cs2:producerBlobSha "fdcdbfc00205d9e7d367a64adfee2bbe65f31dd6" ;
  cs2:subjectId "RFC-CS2-001" ;
  cs2:campaign "CS2-CHICAGO" ;
  cs2:authorityCeiling cs2:CONSTRUCT ;
  cs2:consumerWorkId "CS2-WRK-003" ;
  cs2:consumerRepository "seanchatmangpt/ggen-marketplace" ;
  cs2:replayCommand "python3 packs/cs2-canonical-pack/verify.py" .
