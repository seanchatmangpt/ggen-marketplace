@prefix eli: <https://chatman.ai/ontology/evidence-lineage-independence#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
eli:Pack a eli:MeasurementPack ; eli:authority "OBSERVE|VERIFY" ; eli:consequentialDo "BRCE_ONLY" .
eli:ExactSubject a eli:SubjectClass . eli:EvidenceSource a eli:EvidenceClass .
eli:subjectSha a eli:IdentityProperty . eli:semanticDigest a eli:IdentityProperty .
eli:sourceDigest a eli:IdentityProperty . eli:modelDigest a eli:IdentityProperty .
eli:implementationDigest a eli:IdentityProperty . eli:failureDomain a eli:ProvenanceProperty .
eli:ancestorDigest a eli:ProvenanceProperty . eli:effectiveCapital a eli:MeasurementProperty .
eli:dependenceState a eli:MeasurementProperty . eli:actuationPerformed a eli:AuthorityProperty .
