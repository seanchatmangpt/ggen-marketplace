# rbac.ttl — minimal RBAC mini-ontology
#
# PROVENANCE: This vocabulary is derived from the NIST RBAC model
# (INCITS 359-2012 / ANSI INCITS 359-2004; FIPS 199-adjacent role-based
# access control concepts). It is NOT an official NIST artifact, is not
# ratified by W3C, and carries no NIST endorsement. Community OWL
# encodings (e.g. UMBC ebiquity OWL-RBAC) informed the class/property
# surface but this file is an independent minimal projection.
#
# Exclusive-file lane: V-RBAC (do not edit ggen.toml or shapes here).

@prefix rbac: <http://csrc.nist.gov/ns/rbac#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://csrc.nist.gov/ns/rbac#> a owl:Ontology ;
  rdfs:label "NIST RBAC mini-ontology"@en ;
  rdfs:comment "Minimal OWL projection of the NIST RBAC reference model (INCITS 359-2012). Not an official NIST artifact."@en .

# --- Classes ---

rbac:Subject a owl:Class ;
  rdfs:label "Subject"@en ;
  rdfs:comment "An entity (user, agent, or process) that can be assigned roles."@en .

rbac:Role a owl:Class ;
  rdfs:label "Role"@en ;
  rdfs:comment "A named job function; the unit of permission assignment and subject assignment in the NIST RBAC model."@en .

rbac:Permission a owl:Class ;
  rdfs:label "Permission"@en ;
  rdfs:comment "An approval of a mode of access to one or more objects, granted to roles."@en .

rbac:Operation a owl:Class ;
  rdf:type rdfs:Class ;
  rdfs:label "Operation"@en ;
  rdfs:comment "An executable image of a part of the system (e.g. read, write, execute)."@en .

rbac:Object a owl:Class ;
  rdfs:label "Object"@en ;
  rdfs:comment "A system resource being protected; passively contains or receives information, or is an identity whose access is being controlled."@en .

# --- Properties ---

rbac:role a owl:ObjectProperty ;
  rdfs:label "role"@en ;
  rdfs:comment "Links a Subject to a Role assigned to it."@en ;
  rdfs:domain rbac:Subject ;
  rdfs:range rbac:Role .

rbac:permission a owl:ObjectProperty ;
  rdfs:label "permission"@en ;
  rdfs:comment "Links a Role to a Permission granted to it."@en ;
  rdfs:domain rbac:Role ;
  rdfs:range rbac:Permission .

rbac:operation a owl:ObjectProperty ;
  rdfs:label "operation"@en ;
  rdfs:comment "Links a Permission to the Operation it approves."@en ;
  rdfs:domain rbac:Permission ;
  rdfs:range rbac:Operation .

rbac:object a owl:ObjectProperty ;
  rdfs:label "object"@en ;
  rdfs:comment "Links a Permission to the Object it protects."@en ;
  rdfs:domain rbac:Permission ;
  rdfs:range rbac:Object .
