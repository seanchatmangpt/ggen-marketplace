# kmip.ttl — minimal KMIP v1.4 mini-ontology
#
# PROVENANCE: Derived by hand from the OASIS Key Management Interoperability
# Protocol (KMIP) v1.4 specification text (Profiles chapter, State attribute
# enumeration). OASIS KMIP v1.4 has NO official RDF/RDFS/OWL encoding; this
# file is NOT an official OASIS artifact. It covers only the surface consumed
# by the smalt-core-pack admission shapes: ManagedObject and its SecretData /
# SymmetricKey subclasses, plus the State enumeration as allowed xsd:string
# values.
#
# State enumeration source: KMIP v1.4 §3.1.2 (State attribute), values
# PreActive(1), Active(2), Deactivated(3), Compromised(4), Destroyed(5).

@prefix kmip: <http://docs.oasis-open.org/kmip/ns/v1.4#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://docs.oasis-open.org/kmip/ns/v1.4#> a owl:Ontology ;
    dcterms:title "KMIP v1.4 mini-ontology (smalt-core-pack)" ;
    dcterms:license "Derived from OASIS KMIP v1.4 specification text; this encoding is not an official OASIS artifact." ;
    rdfs:comment
        "Minimal RDFS encoding of the KMIP v1.4 ManagedObject type hierarchy and State enumeration, scoped to what smalt-core-pack admission shapes consume." ;
    rdfs:seeAlso <https://docs.oasis-open.org/kmip/kmip/v1.4/os/kmip-v1.4-os.html> .

kmip:ManagedObject a rdfs:Class ;
    rdfs:label "Managed Object" ;
    rdfs:comment
        "KMIP v1.4 base type for all objects managed by a key management server. Allowed State strings for kmip:state on any ManagedObject: PreActive, Active, Deactivated, Compromised, Destroyed." .

kmip:SecretData a rdfs:Class ;
    rdfs:subClassOf kmip:ManagedObject ;
    rdfs:label "Secret Data" ;
    rdfs:comment
        "KMIP v1.4 object type holding secret bytes (e.g. passwords, seeds); subclass of ManagedObject." .

kmip:SymmetricKey a rdfs:Class ;
    rdfs:subClassOf kmip:ManagedObject ;
    rdfs:label "Symmetric Key" ;
    rdfs:comment
        "KMIP v1.4 object type for symmetric cryptographic keys; subclass of ManagedObject." .

kmip:state a rdf:Property ;
    rdfs:label "State" ;
    rdfs:domain kmip:ManagedObject ;
    rdfs:range xsd:string ;
    rdfs:comment
        "KMIP v1.4 State attribute of a ManagedObject, encoded as an xsd:string. Allowed values (KMIP v1.4 §3.1.2 State enumeration): 'PreActive', 'Active', 'Deactivated', 'Compromised', 'Destroyed'. SHACL shape expectation: sh:datatype xsd:string ; sh:in ( \"PreActive\" \"Active\" \"Deactivated\" \"Compromised\" \"Destroyed\" ) ; sh:maxCount 1." .
