# kmip.ttl — hand-vendored mini-ontology for the KMIP terms the smalt
# admission core consumes.
#
# PROVENANCE (honesty header — this is NOT an official OASIS artifact):
# No official RDF/OWL serialization of KMIP exists. This file was hand-written
# from the OASIS KMIP v1.4 specification text (OASIS, "Key Management
# Interoperability Protocol (KMIP) Version 1.4", 2019-11-08) — specifically
# the Managed Object types (Secret Data) and the State enumeration (§9.1.3
# State Enumeration: Active, PreActive, Deactivated, Destroyed). The namespace
# http://docs.oasis-open.org/kmip/ns/v1.4# is the community-conventional KMIP
# namespace; OASIS publishes no RDF at that IRI. Consumers MUST treat this
# file as the local definition of these IRIs for admission purposes.
@prefix kmip:    <http://docs.oasis-open.org/kmip/ns/v1.4#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<http://docs.oasis-open.org/kmip/ns/v1.4>
    a owl:Ontology ;
    dcterms:created "2026-10-30"^^xsd:date ;
    rdfs:label "KMIP v1.4 mini-ontology (hand-vendored)" ;
    owl:versionInfo "0.1.0 hand-vendored from KMIP v1.4 spec text; not an official OASIS artifact" .

kmip:ManagedObject
    a owl:Class, rdfs:Class ;
    rdfs:label "Managed Object" ;
    rdfs:comment "KMIP managed object (any object managed by the key management system). KMIP v1.4 §2." .

kmip:SecretData
    a owl:Class, rdfs:Class ;
    rdfs:subClassOf kmip:ManagedObject ;
    rdfs:label "Secret Data" ;
    rdfs:comment "KMIP Secret Data object type (v1.4 §9.2.5: a managed object holding secret bytes, e.g. passwords/keys as opaque data)." .

kmip:state
    a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain kmip:ManagedObject ;
    rdfs:label "state" ;
    rdfs:comment "Lifecycle state of a KMIP managed object. Permitted values are the State enumeration: Active, PreActive, Deactivated, Destroyed (v1.4 §9.1.3)." .

kmip:StateValue
    a rdfs:Datatype ;
    owl:oneOf ("Active" "PreActive" "Deactivated" "Destroyed") ;
    rdfs:label "State enumeration" ;
    rdfs:comment "KMIP v1.4 State enumeration (§9.1.3)." .
