# rbac.ttl — hand-vendored mini-ontology for the NIST RBAC terms the smalt
# admission core consumes.
#
# PROVENANCE (honesty header — this is NOT an official NIST artifact):
# NIST RBAC (INCITS 359-2012) publishes no RDF/OWL serialization. This file was
# hand-written from the NIST RBAC model (INCITS 359-2012, Annex A model
# vocabulary: User/Subject, Role, Permission, Operation, Object, Session; and
# the role-assignment relation). The namespace http://csrc.nist.gov/ns/rbac#
# is community-conventional; NIST publishes no RDF at that IRI. Consumers MUST
# treat this file as the local definition of these IRIs for admission purposes.
@prefix rbac:    <http://csrc.nist.gov/ns/rbac#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<http://csrc.nist.gov/ns/rbac>
    a owl:Ontology ;
    dcterms:created "2026-10-30"^^xsd:date ;
    rdfs:label "NIST RBAC mini-ontology (hand-vendored)" ;
    owl:versionInfo "0.1.0 hand-vendored from INCITS 359-2012 model text; not an official NIST artifact" .

rbac:Subject
    a owl:Class, rdfs:Class ;
    rdfs:label "Subject" ;
    rdfs:comment "An active entity that holds a session and exercises operations on objects (INCITS 359-2012 RBAC model: subject = user/session instance)." .

rbac:Role
    a owl:Class, rdfs:Class ;
    rdfs:label "Role" ;
    rdfs:comment "A job function within the context of an organization, to which users/subjects and permissions may be assigned (INCITS 359-2012)." .

rbac:Permission
    a owl:Class, rdfs:Class ;
    rdfs:label "Permission" ;
    rdfs:comment "An approval of a mode of access to one or more objects (INCITS 359-2012)." .

rbac:Operation
    a owl:Class, rdfs:Class ;
    rdfs:label "Operation" ;
    rdfs:comment "An executable image of a function upon a protected object (INCITS 359-2012)." .

rbac:Object
    a owl:Class, rdfs:Class ;
    rdfs:label "Object" ;
    rdfs:comment "A system resource protected by RBAC (INCITS 359-2012)." .

rbac:role
    a rdf:Property, owl:ObjectProperty ;
    rdfs:domain rbac:Subject ;
    rdfs:range rbac:Role ;
    rdfs:label "role" ;
    rdfs:comment "Role assignment: binds a subject to a role (INCITS 359-2012 PA/UA relations, flattened to a property for admission use)." .
