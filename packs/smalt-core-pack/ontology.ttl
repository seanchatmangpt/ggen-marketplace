# ontology.ttl — root aggregate for smalt-core-pack (SA-15, 2026-11-03).
#
# The ggen 26.10.11 pack loader refuses any pack without `ontology.ttl` at
# the pack root ([FM-PACK-004]). The pack's real content lives in ontology/
# (vendored standards + authored shapes); this root file is the loader-facing
# aggregate. Content is carried by the imported files, not duplicated here.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://smalt.dev/packs/smalt-core-pack> a owl:Ontology ;
    owl:imports
        <ontology/cimi.ttl> ,
        <ontology/dcterms.ttl> ,
        <ontology/kmip.ttl> ,
        <ontology/occi.ttl> ,
        <ontology/org.ttl> ,
        <ontology/rbac.ttl> ,
        <ontology/security.ttl> ,
        <ontology/tosca.ttl> ,
        <ontology/wac.ttl> ,
        <ontology/smalt-core-shapes.ttl> ;
    owl:versionInfo "0.1.0 (SA-15 aggregate)" .
