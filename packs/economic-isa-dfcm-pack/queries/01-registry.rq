PREFIX eco: <https://ggen.dev/ontology/economic-isa#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT (GROUP_CONCAT(?line; separator="\n") AS ?registry) WHERE {
  {
    SELECT ?byte ?symbol ?categoryLabel WHERE {
      ?op skos:inScheme eco:Registry ;
          eco:byte ?byte ;
          skos:prefLabel ?symbol ;
          eco:category ?category .
      ?category skos:prefLabel ?categoryLabel .
    }
    ORDER BY ?byte
  }
  BIND(CONCAT(STR(?byte), "\t", STR(?symbol), "\t", STR(?categoryLabel)) AS ?line)
}
