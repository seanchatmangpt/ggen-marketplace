@prefix eco: <https://ggen.dev/ontology/economic-isa#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# This ontology is a manufacturing projection of the canonical ex4pm economic ISA.
# It is not a second authority. Generated consumers MUST preserve unknown,
# unassigned, extension, and authority states rather than inventing meanings.

eco:Registry a skos:ConceptScheme ;
  dct:title "Economic ISA v1" ;
  dct:source <https://github.com/seanchatmangpt/ex4pm/pull/45> ;
  prov:wasDerivedFrom <https://github.com/seanchatmangpt/ex4pm/pull/45> .

eco:Unknown a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "unknown" ; eco:byte 0 ; eco:category eco:UnknownCategory .
eco:Escape a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "escape" ; eco:byte 255 ; eco:category eco:EscapeCategory .

# Stable byte partitions. Category membership does not imply byte assignment.
eco:UnknownCategory a skos:Concept ; skos:prefLabel "unknown" .
eco:Market a skos:Concept ; skos:prefLabel "market" ; eco:rangeStart 1 ; eco:rangeEnd 31 .
eco:Transaction a skos:Concept ; skos:prefLabel "transaction" ; eco:rangeStart 32 ; eco:rangeEnd 63 .
eco:PaymentSettlement a skos:Concept ; skos:prefLabel "payment_settlement" ; eco:rangeStart 64 ; eco:rangeEnd 95 .
eco:LogisticsTransfer a skos:Concept ; skos:prefLabel "logistics_transfer" ; eco:rangeStart 96 ; eco:rangeEnd 127 .
eco:ContractRights a skos:Concept ; skos:prefLabel "contract_rights" ; eco:rangeStart 128 ; eco:rangeEnd 159 .
eco:ProductionService a skos:Concept ; skos:prefLabel "production_service" ; eco:rangeStart 160 ; eco:rangeEnd 191 .
eco:AccountingFinance a skos:Concept ; skos:prefLabel "accounting_finance" ; eco:rangeStart 192 ; eco:rangeEnd 223 .
eco:GovernanceAuthority a skos:Concept ; skos:prefLabel "governance_authority" ; eco:rangeStart 224 ; eco:rangeEnd 239 .
eco:Extension a skos:Concept ; skos:prefLabel "extension" ; eco:rangeStart 240 ; eco:rangeEnd 254 .
eco:EscapeCategory a skos:Concept ; skos:prefLabel "escape" .

# Assigned v1 economic verbs.
eco:Quote a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "quote" ; eco:byte 1 ; eco:category eco:Market .
eco:Offer a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "offer" ; eco:byte 2 ; eco:category eco:Market .
eco:Bid a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "bid" ; eco:byte 3 ; eco:category eco:Market .
eco:Ask a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "ask" ; eco:byte 4 ; eco:category eco:Market .
eco:Order a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "order" ; eco:byte 32 ; eco:category eco:Transaction .
eco:Fill a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "fill" ; eco:byte 33 ; eco:category eco:Transaction .
eco:Sale a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "sale" ; eco:byte 34 ; eco:category eco:Transaction .
eco:Purchase a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "purchase" ; eco:byte 35 ; eco:category eco:Transaction .
eco:Invoice a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "invoice" ; eco:byte 64 ; eco:category eco:PaymentSettlement .
eco:Pay a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "pay" ; eco:byte 65 ; eco:category eco:PaymentSettlement .
eco:Settle a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "settle" ; eco:byte 66 ; eco:category eco:PaymentSettlement .
eco:Refund a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "refund" ; eco:byte 67 ; eco:category eco:PaymentSettlement .
eco:Ship a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "ship" ; eco:byte 96 ; eco:category eco:LogisticsTransfer .
eco:Deliver a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "deliver" ; eco:byte 97 ; eco:category eco:LogisticsTransfer .
eco:Transfer a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "transfer" ; eco:byte 98 ; eco:category eco:LogisticsTransfer .
eco:License a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "license" ; eco:byte 128 ; eco:category eco:ContractRights .
eco:Subscribe a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "subscribe" ; eco:byte 129 ; eco:category eco:ContractRights .
eco:Renew a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "renew" ; eco:byte 130 ; eco:category eco:ContractRights .
eco:Claim a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "claim" ; eco:byte 131 ; eco:category eco:ContractRights .
eco:Manufacture a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "manufacture" ; eco:byte 160 ; eco:category eco:ProductionService .
eco:ProvideService a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "provide_service" ; eco:byte 161 ; eco:category eco:ProductionService .
eco:Discover a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "discover" ; eco:byte 162 ; eco:category eco:ProductionService .
eco:Prove a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "prove" ; eco:byte 163 ; eco:category eco:ProductionService .
eco:Design a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "design" ; eco:byte 164 ; eco:category eco:ProductionService .
eco:RecognizeRevenue a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "recognize_revenue" ; eco:byte 192 ; eco:category eco:AccountingFinance .
eco:AccrueReceivable a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "accrue_receivable" ; eco:byte 193 ; eco:category eco:AccountingFinance .
eco:RealizeValue a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "realize_value" ; eco:byte 194 ; eco:category eco:AccountingFinance .
eco:Authorize a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "authorize" ; eco:byte 224 ; eco:category eco:GovernanceAuthority .
eco:Attest a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "attest" ; eco:byte 225 ; eco:category eco:GovernanceAuthority .
eco:Refuse a skos:Concept ; skos:inScheme eco:Registry ; skos:prefLabel "refuse" ; eco:byte 226 ; eco:category eco:GovernanceAuthority .

# DfCM authority lattice. Semantic identity never manufactures DO authority.
eco:Observe a skos:Concept ; skos:prefLabel "observe" .
eco:Select a skos:Concept ; skos:prefLabel "select" .
eco:Construct a skos:Concept ; skos:prefLabel "construct" .
eco:Do a skos:Concept ; skos:prefLabel "do" .
eco:OpcodeIdentity a skos:Concept ; skos:prefLabel "opcode identity" ; eco:doesNotConfer eco:Do .
