@prefix sfe: <https://seanchatmangpt.dev/ontology/selection-frontier-execution#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sfe:SelectionRun a sfe:SelectionExecution ;
  sfe:authority "SELECT" ;
  sfe:actuationPerformed false ;
  sfe:minimumMeaningfulEvidence 1 ;
  sfe:requiresExactSubject true ;
  sfe:preservesAlternatives true ;
  sfe:failureDominant true .

sfe:PrimaryCtq a sfe:Criterion ; sfe:ordinal 1 ; sfe:name "meaningful_new_commits" .
sfe:MergeabilityCtq a sfe:Criterion ; sfe:ordinal 2 ; sfe:name "independent_merge_yield" .
sfe:QualificationCtq a sfe:Criterion ; sfe:ordinal 3 ; sfe:name "qualified_dependency_relief" .
sfe:StandingCtq a sfe:Criterion ; sfe:ordinal 4 ; sfe:name "explicit_selection_standing" .
