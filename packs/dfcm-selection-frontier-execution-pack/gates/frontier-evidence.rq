PREFIX sfe: <https://seanchatmangpt.dev/ontology/selection-frontier-execution#>
SELECT ?candidate WHERE {
  ?candidate a sfe:Candidate .
  FILTER NOT EXISTS { ?candidate sfe:evidenceScore ?evidence ; sfe:rollbackScore ?rollback ; sfe:uncertainty ?u .
    FILTER(?evidence >= 0.0 && ?rollback >= 0.0 && ?u >= 0.0) }
}
