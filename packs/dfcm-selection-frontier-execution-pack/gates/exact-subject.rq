PREFIX sfe: <https://seanchatmangpt.dev/ontology/selection-frontier-execution#>
SELECT ?run WHERE {
  ?run a sfe:SelectionExecution .
  FILTER NOT EXISTS { ?run sfe:subjectRepository ?repo ; sfe:subjectSha ?sha .
    FILTER(REGEX(STR(?repo), "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$") && REGEX(STR(?sha), "^[0-9a-f]{40}$")) }
}
