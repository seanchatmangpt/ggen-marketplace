PREFIX sfe: <https://seanchatmangpt.dev/ontology/selection-frontier-execution#>
SELECT ?candidate WHERE {
  ?candidate a sfe:Candidate ; sfe:evidenceScore ?e ; sfe:rollbackScore ?r ; sfe:dependencyRelief ?d ; sfe:uncertainty ?u .
  FILTER NOT EXISTS {
    ?other a sfe:Candidate ; sfe:evidenceScore ?oe ; sfe:rollbackScore ?or ; sfe:dependencyRelief ?od ; sfe:uncertainty ?ou .
    FILTER(?other != ?candidate && ?oe >= ?e && ?or >= ?r && ?od >= ?d && ?ou <= ?u && (?oe > ?e || ?or > ?r || ?od > ?d || ?ou < ?u))
  }
}
ORDER BY DESC(?e) DESC(?d) DESC(?r) ?u ?candidate
