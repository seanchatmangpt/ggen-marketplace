---
to: "lib/{{ package_name }}/{% if support_subdir %}{{ support_subdir }}/{% endif %}persist.ex"
for_each: "spec"
sparql:
  spec: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT DISTINCT ?package_name ?module_name
           (SAMPLE(?support_subdir_value) AS ?support_subdir)
           (SAMPLE(?context_normalize) AS ?context_normalize)
           (SAMPLE(?context_target_entity) AS ?context_target_entity)
           (SAMPLE(?context_target_field) AS ?context_target_field)
           (SAMPLE(?normalize_module) AS ?normalize_module)
           (SAMPLE(?normalize_function) AS ?normalize_function)
           (SAMPLE(?provenance_source) AS ?provenance_source)
    WHERE {
      ?s a aex:AshExtensionSpec ; aex:packageName ?package_name ; aex:moduleName ?module_name .
      FILTER NOT EXISTS { ?s aex:fixtureOnly true }
      OPTIONAL { ?s aex:supportSubdir ?support_subdir_value }
      OPTIONAL { ?s aex:contextNormalize ?context_normalize }
      OPTIONAL { ?s aex:contextTargetEntity ?context_target_entity }
      OPTIONAL { ?s aex:contextTargetField ?context_target_field }
      OPTIONAL { ?s aex:normalizeModule ?normalize_module }
      OPTIONAL { ?s aex:normalizeFunction ?normalize_function }
      OPTIONAL { ?s aex:provenanceSource ?provenance_source }
    } GROUP BY ?package_name ?module_name
  sections: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT ?package_name ?section_name WHERE {
      ?section a aex:DslSection ; aex:sectionOf ?spec ; aex:sectionName ?section_name .
      ?spec aex:packageName ?package_name .
    }
    ORDER BY ?package_name ?section_name
  after_transformers: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT DISTINCT ?package_name ?after_transformer WHERE {
      ?s a aex:AshExtensionSpec ; aex:packageName ?package_name ; aex:afterTransformer ?after_transformer .
    }
    ORDER BY ?package_name ?after_transformer
---
{# Derive/Normalize transformer -- mirrors ash_r2rml/lib/ash_r2rml/resource.ex's
   AshR2RML.Resource.Persist: reads the raw DSL entities for each section, normalizes
   them into a compiled struct, and persists it under a single, documented key so the
   generated Verify module and Info module read the SAME persisted shape.

   v26.9.9: two capabilities added from real source, not invented:
   - after?/1 explicit ordering against upstream Ash transformers, verbatim
     ash_r2rml/lib/ash_r2rml/resource.ex:188-194's five-clause pattern (gated on
     aex:afterTransformer rows).
   - resource/domain context-normalization, the ash_ai AshAi.Transformers.ResourceTools
     pattern (lib/ash_ai/transformers/resource_tools.ex:13-55,125-127): detect via the
     `@spark_is` module attribute, fill in the target-context field on resource-local
     declarations, reject an explicit value at resource level, require one at domain
     level (gated on aex:contextNormalize). #}
{% set sections_for_spec = sections | filter(attribute="package_name", value=package_name) %}
{% set after_transformers_for_spec = after_transformers | filter(attribute="package_name", value=package_name) %}
defmodule {{ module_name }}.Persist do
  @moduledoc """
  Transformer for `{{ package_name }}`: normalizes the raw `{% for s in sections_for_spec %}:{{ s.section_name }}{% if not loop.last %}, {% endif %}{% endfor %}`
  DSL entities into a compiled struct and persists it as `:{{ package_name }}_compiled`.
  """
  use Spark.Dsl.Transformer

{% if after_transformers_for_spec | length > 0 %}
  @impl true
{% for t in after_transformers_for_spec %}
  def after?({{ t.after_transformer }}), do: true
{% endfor %}
  def after?(_), do: false

{% endif %}
  @impl true
  def transform(dsl_state) do
{% if context_normalize | default(value="false") == "true" %}
    module = Spark.Dsl.Transformer.get_persisted(dsl_state, :module)
    resource_dsl? = resource_dsl?(module)

    dsl_state =
      dsl_state
      |> Spark.Dsl.Transformer.get_entities([:{{ context_target_entity }}])
      |> Enum.reduce(dsl_state, fn entity, dsl ->
        cond do
          resource_dsl? and is_nil(entity.{{ context_target_field }}) ->
            Spark.Dsl.Transformer.replace_entity(
              dsl,
              [:{{ context_target_entity }}],
              %{entity | {{ context_target_field }}: module},
              &(&1.name == entity.name)
            )

          resource_dsl? ->
            raise Spark.Error.DslError,
              module: module,
              path: [:{{ context_target_entity }}, entity.name, :{{ context_target_field }}],
              message: "Resource-level :{{ context_target_entity }} cannot set `{{ context_target_field }}`."

          is_nil(entity.{{ context_target_field }}) ->
            raise Spark.Error.DslError,
              module: module,
              path: [:{{ context_target_entity }}, entity.name, :{{ context_target_field }}],
              message: "`#{entity.name}` is missing `{{ context_target_field }}` -- required on domain-level :{{ context_target_entity }} declarations."

          true ->
            dsl
        end
      end)

{% endif %}
{% for s in sections_for_spec %}
    {{ s.section_name }}_entities = Spark.Dsl.Transformer.get_entities(dsl_state, [:{{ s.section_name }}])
{% endfor %}

    compiled = %{
{% for s in sections_for_spec %}      {{ s.section_name }}: {{ s.section_name }}_entities,
{% endfor %}{% if provenance_source %}      metadata: %{source: :{{ provenance_source }}},
{% endif %}    }
{% if normalize_module and normalize_function %}
    compiled = {{ normalize_module }}.{{ normalize_function }}(compiled)
{% endif %}

    {:ok, Spark.Dsl.Transformer.persist(dsl_state, :{{ package_name }}_compiled, compiled)}
  end
{% if context_normalize | default(value="false") == "true" %}
  # ash_ai AshAi.Transformers.ResourceTools pattern (resource_tools.ex:125-127):
  # `@spark_is` is the module attribute Spark sets to Ash.Resource or Ash.Domain
  # on any module using a DSL extension declared against that behaviour.
  defp resource_dsl?(module) do
    Module.get_attribute(module, :spark_is) == Ash.Resource
  end
{% endif %}
end
