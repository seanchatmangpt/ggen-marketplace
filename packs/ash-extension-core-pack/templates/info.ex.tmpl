---
to: "lib/{{ package_name }}/{% if support_subdir %}{{ support_subdir }}/{% endif %}info.ex"
for_each: "spec"
sparql:
  spec: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT DISTINCT ?package_name ?module_name
           (SAMPLE(?support_subdir_value) AS ?support_subdir)
           (SAMPLE(?legacy_adapter_module) AS ?legacy_adapter_module)
           (SAMPLE(?legacy_adapter_function) AS ?legacy_adapter_function)
    WHERE {
      ?s a aex:AshExtensionSpec ; aex:packageName ?package_name ; aex:moduleName ?module_name .
      FILTER NOT EXISTS { ?s aex:fixtureOnly true }
      OPTIONAL { ?s aex:supportSubdir ?support_subdir_value }
      OPTIONAL { ?s aex:legacyAdapterModule ?legacy_adapter_module }
      OPTIONAL { ?s aex:legacyAdapterFunction ?legacy_adapter_function }
    } GROUP BY ?package_name ?module_name
  sections: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT ?package_name ?section_name WHERE {
      ?section a aex:DslSection ; aex:sectionOf ?spec ; aex:sectionName ?section_name .
      ?spec aex:packageName ?package_name .
    }
    ORDER BY ?package_name ?section_name
---
{# Generated Info module -- mirrors ash_r2rml/lib/ash_r2rml/resource.ex's
   AshR2RML.Resource.Info: the public, documented introspection API a consumer (or this
   pack's own composition test) reads instead of poking Spark.Dsl.Extension internals. #}
{% set sections_for_spec = sections | filter(attribute="package_name", value=package_name) %}
defmodule {{ module_name }}.Info do
  @moduledoc """
  Public introspection API for `{{ package_name }}`.
  """
{% for s in sections_for_spec %}
  @doc "Returns the raw `:{{ s.section_name }}` DSL entities declared on `resource`."
  def {{ s.section_name }}(resource) do
    Spark.Dsl.Extension.get_entities(resource, [:{{ s.section_name }}])
  end
{% endfor %}
  @doc "Returns the transformer-normalized compiled state for `resource`, or `nil` if the extension is not present."
  def compiled(resource) do
    case compiled_result(resource) do
      {:ok, compiled} -> compiled
      {:error, _} -> nil
    end
  end

  @doc """
  Returns `{:ok, compiled}` or `{:error, :not_compiled}` for `resource`.
{% if legacy_adapter_module and legacy_adapter_function %}
  Rescues to `{{ legacy_adapter_module }}.{{ legacy_adapter_function }}/1` on any error,
  mirroring ash_r2rml's Info.mapping_result/1 rescue-to-legacy-adapter idiom.
{% endif %}
  """
  def compiled_result(resource) do
    case Spark.Dsl.Extension.get_persisted(resource, :{{ package_name }}_compiled, nil) do
      nil -> {:error, :not_compiled}
      compiled -> {:ok, compiled}
    end
{% if legacy_adapter_module and legacy_adapter_function %}
  rescue
    _ -> {{ legacy_adapter_module }}.{{ legacy_adapter_function }}(resource)
{% endif %}
  end

  @doc "Bang variant of `compiled_result/1` -- raises `ArgumentError` instead of returning `{:error, _}`."
  def compiled!(resource) do
    case compiled_result(resource) do
      {:ok, compiled} -> compiled
      {:error, reason} -> raise ArgumentError, "{{ module_name }}.Info.compiled!/1: #{inspect(reason)}"
    end
  end

  @doc "Predicate: does `resource` carry compiled `{{ package_name }}` state?"
  def compiled?(resource) do
    match?({:ok, _}, compiled_result(resource))
  end
end
