PREFIX am: <https://ggen.io/ontology/athena-matter#>
SELECT ?kind ?cls ?field ?zod ?custody
WHERE {
  {
    am:AccessGrant am:custodyBinding ?custody .
    BIND("custody" AS ?kind) BIND("AccessGrant" AS ?cls) BIND("" AS ?field) BIND("" AS ?zod)
  }
  UNION
  {
    ?f a am:Field ; am:belongsTo am:AccessGrant ; am:fieldName ?field ; am:zodExpr ?zod .
    BIND("field" AS ?kind) BIND("AccessGrant" AS ?cls) BIND("" AS ?custody)
  }
}
ORDER BY ?kind ?field
