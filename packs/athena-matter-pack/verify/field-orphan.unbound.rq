# Inverted verify gate: MUST return zero rows.
# A row = an am:Field whose am:belongsTo does not resolve to a declared
# domain class (orphan field) — a contract line projected from nothing.
PREFIX am:  <https://ggen.io/ontology/athena-matter#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?field WHERE {
  ?f a am:Field ; am:belongsTo ?cls ; am:fieldName ?field .
  OPTIONAL { ?cls a rdfs:Class . BIND(?cls AS ?ok) }
  FILTER (!bound(?ok))
}
