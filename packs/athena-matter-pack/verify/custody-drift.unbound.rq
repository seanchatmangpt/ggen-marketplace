# Inverted verify gate: MUST return zero rows.
# Custody law: CaseSpace fields may only be projected when the
# am:custodyBinding annotation is present (container derivation is part
# of the contract, not caller-chosen). A row = field rows without the
# custody binding.
PREFIX am: <https://ggen.io/ontology/athena-matter#>

SELECT ?field WHERE {
  ?f a am:Field ; am:belongsTo am:CaseSpace ; am:fieldName ?field .
  FILTER NOT EXISTS { am:CaseSpace am:custodyBinding ?cb . }
}
