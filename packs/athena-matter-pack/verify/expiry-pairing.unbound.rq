# Inverted verify gate: MUST return zero rows.
# J7 law: an AccessGrant contract without a mandatory expiresAt field row
# is a permanent-grant channel — refused. A row here = the class is
# declared but the expiresAt field row is missing or mis-bound.
PREFIX am:   <https://ggen.io/ontology/athena-matter#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?cls WHERE {
  ?cls a rdfs:Class ; rdfs:label "Access Grant" .
  FILTER NOT EXISTS {
    ?f a am:Field ; am:belongsTo ?cls ; am:fieldName "expiresAt" .
  }
}
