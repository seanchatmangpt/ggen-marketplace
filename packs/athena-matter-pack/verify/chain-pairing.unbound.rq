# Inverted verify gate: MUST return zero rows.
# Sentinel-audit chain law: the AuditEvent contract MUST pair prevHash
# with the event fields. A row = AuditEvent declared but the prevHash
# field row missing/mis-bound (an unlinkable chain).
PREFIX am:   <https://ggen.io/ontology/athena-matter#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?cls WHERE {
  ?cls a rdfs:Class ; rdfs:label "Audit Event" .
  FILTER NOT EXISTS {
    ?f a am:Field ; am:belongsTo ?cls ; am:fieldName "prevHash" .
  }
}
