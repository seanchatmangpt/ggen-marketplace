@prefix sd: <https://ggen.dev/ontology/strategic-doctrine#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
sd:concealShape a sh:NodeShape ; sh:targetNode sd:conceal ; sh:property [ sh:path sd:authority ; sh:hasValue "NONE" ; sh:minCount 1 ; sh:maxCount 1 ] ; sh:property [ sh:path sd:dualOf ; sh:hasValue sd:reveal ; sh:minCount 1 ; sh:maxCount 1 ] .
