PREFIX sd: <https://ggen.dev/ontology/strategic-doctrine#>
SELECT ?operator WHERE { VALUES ?operator { sd:shape } ?operator a sd:OperatorContract ; sd:authority "NONE" ; sd:dualOf sd:probe ; sd:requiresEvidence true ; sd:preservesConsequence true . FILTER NOT EXISTS { ?operator sd:authority ?a FILTER(?a != "NONE") } }
