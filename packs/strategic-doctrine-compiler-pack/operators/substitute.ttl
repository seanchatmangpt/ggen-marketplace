sd:substitute a sd:Primitive, sd:OperatorContract ; sd:name "substitute" ; sd:dualOf sd:transform ; sd:purpose "replace a component while preserving admitted consequences" ; sd:authority "NONE" ; sd:requiresEvidence true ; sd:preservesConsequence true .
