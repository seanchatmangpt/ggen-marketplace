@prefix sd: <https://ggen.dev/ontology/strategic-doctrine#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
sd:Primitive a rdfs:Class .
sd:OperatorContract a rdfs:Class .
sd:name a rdf:Property .
sd:dualOf a rdf:Property .
sd:purpose a rdf:Property .
sd:authority a rdf:Property .
sd:requiresEvidence a rdf:Property .
sd:preservesConsequence a rdf:Property .
sd:refusalReason a rdf:Property .

# Compiler-level admission metadata. Previously declared as non-admitted keys in pack.toml
# (authority, ceiling, [compiler]); ggen's pack loader admits only name/version/description
# in [pack], so the facts live here (and in mappings/compiler-contract.json).
sd:Compiler a rdfs:Class .
sd:ceiling a rdf:Property .
sd:operatorCount a rdf:Property .
sd:failClosed a rdf:Property .
sd:strategicDoctrineCompiler a sd:Compiler ;
    sd:authority "NONE" ;
    sd:ceiling "CONSTRUCT" ;
    sd:operatorCount 14 ;
    sd:failClosed true .
