@prefix r75: <https://ggen.dev/explore/r75#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

r75:CandidateStructure a prov:Entity .
r75:AshDomain a r75:CandidateStructure .
r75:AshResource a r75:CandidateStructure .
r75:AshAction a r75:CandidateStructure .
r75:AshPolicy a r75:CandidateStructure .
r75:AshCalculation a r75:CandidateStructure .
r75:AshAggregate a r75:CandidateStructure .
r75:AshValidation a r75:CandidateStructure .
r75:ReactorWorkflow a r75:CandidateStructure .
r75:LiveViewWorkspace a r75:CandidateStructure .
r75:OcelTimeline a r75:CandidateStructure .
r75:OpportunityWorkspace a r75:CandidateStructure .
r75:OfferPackage a r75:CandidateStructure .
r75:InvoiceEvidence a r75:CandidateStructure .
r75:ValueEvidence a r75:CandidateStructure .
r75:CustomerRevenueWorkspace a r75:CandidateStructure .
r75:ProcessConformance a r75:CandidateStructure .
r75:SimulationSurface a r75:CandidateStructure .
r75:ValueCalculator a r75:CandidateStructure .
r75:ApiSurface a r75:CandidateStructure .
r75:MigrationSurface a r75:CandidateStructure .
r75:RevenueFROMCustomer a prov:Entity .
r75:RevenueFORCustomer a prov:Entity .
r75:AgentRefinement a prov:Activity .
r75:GeneralizableKnowledge a prov:Entity .
r75:Qualification a prov:Activity .
r75:Receipt a prov:Entity .

r75:dependsOn a rdf:Property .
r75:projects a rdf:Property .
r75:generates a rdf:Property .
r75:qualifies a rdf:Property .
r75:hasFalsifier a rdf:Property .
r75:payer a rdf:Property .
r75:beneficiary a rdf:Property .
r75:valueMetric a rdf:Property .
r75:customerProcess a rdf:Property .
r75:valueOutcome a rdf:Property .
r75:customerRevenueOutcome a rdf:Property .
r75:promotes a rdf:Property .
r75:regenerates a rdf:Property .
r75:supersedes a rdf:Property .
r75:authority a rdf:Property .
r75:standing a rdf:Property .

r75:factory a prov:SoftwareAgent ;
  skos:prefLabel "Ash OCEL RevOps surface factory" ;
  r75:authority "SELECT_CONSTRUCT_ONLY" ;
  r75:generates r75:AshDomain, r75:AshResource, r75:AshAction, r75:AshPolicy,
    r75:ReactorWorkflow, r75:LiveViewWorkspace, r75:OcelTimeline,
    r75:OpportunityWorkspace, r75:OfferPackage, r75:InvoiceEvidence,
    r75:ValueEvidence, r75:CustomerRevenueWorkspace, r75:ProcessConformance,
    r75:SimulationSurface, r75:ValueCalculator, r75:ApiSurface, r75:MigrationSurface .

r75:dualRevOpsInvariant a dqv:QualityMeasurement ;
  r75:projects r75:RevenueFROMCustomer, r75:RevenueFORCustomer ;
  r75:standing "INVARIANT" .
