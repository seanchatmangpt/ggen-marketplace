# MESSAGE: every PhaseActivity's dflss:hasPhase must resolve to a skos:Concept in the closed dflss:DMADVPhaseScheme; any row is a refusal.
PREFIX dflss: <https://ggen.dev/dflss#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?activity ?phase WHERE {
  ?activity a dflss:PhaseActivity ; dflss:hasPhase ?phase .
  FILTER NOT EXISTS { ?phase a skos:Concept ; skos:inScheme dflss:DMADVPhaseScheme }
}
ORDER BY ?activity ?phase
