# MESSAGE: every DFLSSProject must have an rdfs:label and at least one phase activity bound to it via dflss:partOfProject; any row is a refusal.
PREFIX dflss: <https://ggen.dev/dflss#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?project ?reason WHERE {
  ?project a dflss:DFLSSProject .
  {
    FILTER NOT EXISTS { ?project rdfs:label ?label }
    BIND("MISSING_LABEL" AS ?reason)
  }
  UNION
  {
    FILTER NOT EXISTS { ?activity dflss:partOfProject ?project }
    BIND("NO_PHASE_ACTIVITY" AS ?reason)
  }
}
ORDER BY ?project ?reason
