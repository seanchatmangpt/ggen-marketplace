# MESSAGE: every DOEExperiment must declare at least one factor and at least one response; any row is a refusal.
PREFIX dflss: <https://ggen.dev/dflss#>
SELECT ?experiment ?reason WHERE {
  ?experiment a dflss:DOEExperiment .
  {
    FILTER NOT EXISTS { ?experiment dflss:hasFactor ?f }
    BIND("NO_FACTOR" AS ?reason)
  }
  UNION
  {
    FILTER NOT EXISTS { ?experiment dflss:hasResponse ?r }
    BIND("NO_RESPONSE" AS ?reason)
  }
}
ORDER BY ?experiment ?reason
