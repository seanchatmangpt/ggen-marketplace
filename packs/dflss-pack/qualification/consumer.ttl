@prefix dflss: <https://ggen.dev/dflss#> .
@prefix req:   <https://ggen.io/onto/requirements/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

# Minimal synthetic project satisfying every dflss-pack gate, used for
# marketplace qualification and as a worked example for consumer projects.

<urn:qualification:project> a dflss:DFLSSProject ;
  rdfs:label "Qualification DFLSS Project" .

<urn:qualification:define-activity> a dflss:PhaseActivity ;
  dflss:hasPhase dflss:Define ;
  dflss:partOfProject <urn:qualification:project> .

# CTQ: must already be req:AdmittedCtq at the requirements-andon layer.
# In an isolated qualification fixture we assert the admitted type directly;
# a real consumer project would inherit this fact from an actual
# requirements-andon admission receipt, not assert it by hand.
<urn:qualification:ctq> a dflss:CTQ, req:AdmittedCtq ;
  rdfs:label "Bond strength" .
<urn:qualification:project> dflss:hasCTQ <urn:qualification:ctq> .

<urn:qualification:risk> a dflss:DFMEARisk ;
  dflss:severity 6 ;
  dflss:occurrence 3 ;
  dflss:detection 4 ;
  dflss:rpn 72 ;
  dflss:hasControlPlan <urn:qualification:control-plan> .
<urn:qualification:project> dflss:identifiesRisk <urn:qualification:risk> .

<urn:qualification:control-plan> a dflss:ControlPlan ;
  rdfs:label "Monitor CTQ weekly; escalate on 2-sigma shift" .

<urn:qualification:experiment> a dflss:DOEExperiment ;
  dflss:hasFactor <urn:qualification:factor-temp> ;
  dflss:hasFactor <urn:qualification:factor-pressure> ;
  dflss:hasResponse <urn:qualification:response-yield> ;
  dflss:hasResponse <urn:qualification:response-strength> .
<urn:qualification:project> dflss:runsExperiment <urn:qualification:experiment> .

<urn:qualification:factor-temp> a dflss:DOEFactor ;
  rdfs:label "Cure temperature" ;
  dflss:factorLevel "180C" ;
  dflss:factorLevel "200C" .

<urn:qualification:factor-pressure> a dflss:DOEFactor ;
  rdfs:label "Cure pressure" ;
  dflss:factorLevel "2bar" ;
  dflss:factorLevel "4bar" .

<urn:qualification:response-yield> a dflss:DOEResponse ;
  rdfs:label "Yield" ;
  dflss:responseValue 0.94 .

<urn:qualification:response-strength> a dflss:DOEResponse ;
  rdfs:label "Bond strength (MPa)" ;
  dflss:responseValue 18.7 .
