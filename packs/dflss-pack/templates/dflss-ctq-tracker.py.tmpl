---
to: src/dflss_ctq_tracker.py
force: true
sparql:
  ctqs: |
    PREFIX dflss: <https://ggen.dev/dflss#>
    PREFIX req: <https://ggen.io/onto/requirements/>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?project ?ctq ?label WHERE {
      ?project dflss:hasCTQ ?ctq .
      ?ctq a dflss:CTQ, req:AdmittedCtq .
      OPTIONAL { ?ctq rdfs:label ?label }
    } ORDER BY ?project ?ctq
---
"""Admitted CTQ tracker -- generated by dflss-pack's dflss-ctq-tracker.py.tmpl
from this project's actual dflss:hasCTQ / dflss:CTQ facts.

dflss:CTQ is rdfs:subClassOf req:AdmittedCtq (the requirements-andon pack's own
5-field-gated CTQ class: source, measure, verification, negative case, control
plan). Those five admission fields live at the requirements-andon layer, not in
this ontology, so this module tracks the identity/label/owning-project facts
this pack's own graph actually carries for each admitted CTQ -- it does not
redeclare fields this pack does not define.

Every entry in ADMITTED_CTQS below is a literal echo of a dflss:hasCTQ /
rdfs:label fact already computed by the frontmatter SPARQL query in this
template; nothing here is hand-invented.
"""

from dataclasses import dataclass
from typing import Optional


@dataclass(frozen=True)
class AdmittedCtq:
    """A CTQ cited by a DFLSSProject (mirrors dflss:CTQ / req:AdmittedCtq)."""

    identity: str
    project: str
    label: Optional[str] = None


ADMITTED_CTQS: list[AdmittedCtq] = [
{% for c in ctqs %}    AdmittedCtq(
        identity="{{ c.ctq }}",
        project="{{ c.project }}",
        label={% if c.label %}"{{ c.label }}"{% else %}None{% endif %},
    ),
{% endfor %}]


def load_ctqs() -> list[AdmittedCtq]:
    """Return the admitted CTQs recorded in this project's graph."""
    return list(ADMITTED_CTQS)


def ctqs_for_project(project: str) -> list[AdmittedCtq]:
    """Return the admitted CTQs cited by a single DFLSSProject identity."""
    return [c for c in ADMITTED_CTQS if c.project == project]
