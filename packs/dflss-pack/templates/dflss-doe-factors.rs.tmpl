---
to: src/dflss_doe_factors.rs
force: true
sparql:
  factors: |
    PREFIX dflss: <https://ggen.dev/dflss#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT DISTINCT ?experiment ?factor ?factorLabel WHERE {
      ?experiment a dflss:DOEExperiment ; dflss:hasFactor ?factor .
      OPTIONAL { ?factor rdfs:label ?factorLabel }
    } ORDER BY ?experiment ?factor
  levels: |
    PREFIX dflss: <https://ggen.dev/dflss#>
    SELECT ?factor ?level WHERE {
      ?factor dflss:factorLevel ?level .
    } ORDER BY ?factor ?level
  responses: |
    PREFIX dflss: <https://ggen.dev/dflss#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT DISTINCT ?experiment ?response ?responseLabel ?value WHERE {
      ?experiment a dflss:DOEExperiment ; dflss:hasResponse ?response .
      ?response dflss:responseValue ?value .
      OPTIONAL { ?response rdfs:label ?responseLabel }
    } ORDER BY ?experiment ?response
---
//! DOE factor/response data -- generated by dflss-pack's dflss-doe-factors.rs.tmpl
//! from this project's actual dflss:DOEExperiment / dflss:DOEFactor / dflss:DOEResponse
//! facts.
//!
//! `DOEFactor`/`DOEResponse` mirror this pack's own ontology classes; the
//! `DOE_FACTORS`/`DOE_RESPONSES` const arrays below are a literal echo of the
//! `dflss:factorLevel` / `dflss:responseValue` facts already computed by the
//! frontmatter SPARQL queries in this template -- nothing here is
//! hand-invented sample data.

/// An independent variable manipulated in a DOE experiment (mirrors dflss:DOEFactor).
#[derive(Debug, Clone, PartialEq)]
pub struct DOEFactor {
    pub name: &'static str,
    pub levels: &'static [&'static str],
}

/// A measured/observed outcome variable of a DOE experiment (mirrors dflss:DOEResponse).
#[derive(Debug, Clone, PartialEq)]
pub struct DOEResponse {
    pub name: &'static str,
    pub value: f64,
}

pub const DOE_FACTORS: &[DOEFactor] = &[
{% for f in factors %}    DOEFactor {
        name: "{{ f.factorLabel | default(value=f.factor) }}",
        levels: &[{% for l in levels %}{% if l.factor == f.factor %}"{{ l.level }}", {% endif %}{% endfor %}],
    },
{% endfor %}];

pub const DOE_RESPONSES: &[DOEResponse] = &[
{% for r in responses %}    DOEResponse {
        name: "{{ r.responseLabel | default(value=r.response) }}",
        value: {{ r.value }},
    },
{% endfor %}];

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn every_factor_has_at_least_one_level() {
        for factor in DOE_FACTORS {
            assert!(!factor.levels.is_empty(), "{} has no declared level", factor.name);
        }
    }
}
