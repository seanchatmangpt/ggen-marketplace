---
to: docs/DFLSS_CONTROL_PLAN.md
force: true
sparql:
  plans: |
    PREFIX dflss: <https://ggen.dev/dflss#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?risk ?plan ?planLabel WHERE {
      ?risk a dflss:DFMEARisk ; dflss:hasControlPlan ?plan .
      OPTIONAL { ?plan rdfs:label ?planLabel }
    } ORDER BY ?risk
  experiments: |
    PREFIX dflss: <https://ggen.dev/dflss#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?experiment ?factorLabel ?responseLabel ?responseValue WHERE {
      ?experiment a dflss:DOEExperiment ; dflss:hasFactor ?factor ; dflss:hasResponse ?response .
      OPTIONAL { ?factor rdfs:label ?factorLabel }
      OPTIONAL { ?response rdfs:label ?responseLabel }
      OPTIONAL { ?response dflss:responseValue ?responseValue }
    } ORDER BY ?experiment
---
