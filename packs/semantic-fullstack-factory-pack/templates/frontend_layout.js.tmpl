---
to: "generated/frontend/app/layout.js"
sparql:
  apps: "PREFIX sf: <https://ggen.dev/ontology/semantic-fullstack#> SELECT ?pageTitle WHERE { ?app a sf:Application ; sf:pageTitle ?pageTitle . } ORDER BY ?pageTitle"
---
export const metadata = { title: "{{ apps[0].pageTitle }}" };

export default function RootLayout({ children }) {
  return (
    <html lang="en">
      <body>{children}</body>
    </html>
  );
}
