---
to: "generated/frontend/e2e/semantic-generated.spec.cjs"
---
const { test, expect } = require("@playwright/test");

const API = process.env.SEMANTIC_API_URL || "http://127.0.0.1:8000";

test("generated browser court matches the generated semantic API", async ({ page, request }) => {
  await page.goto("/", { waitUntil: "networkidle" });
  await expect(page.locator('[data-testid="semantic-app-root"]')).toBeVisible();
  await expect(page.locator('[data-testid="authority"]')).toHaveText("SELECT_CONSTRUCT_ONLY");
  await expect(page.locator('[data-testid="human-gate"]')).toHaveText("ENGINEER_DISPOSITION_REQUIRED");

  const listResponse = await request.get(API + "/api/scenarios");
  expect(listResponse.ok()).toBeTruthy();
  const scenarios = await listResponse.json();
  expect(scenarios.length).toBeGreaterThan(0);

  for (const expected of scenarios) {
    await page.locator('[data-testid="scenario-' + expected.id + '"]').click();
    await expect(page.locator('[data-testid="classification"]')).toHaveText(expected.classification);
    await expect(page.locator('[data-testid="standing"]')).toHaveText(expected.standing);
    await expect(page.locator('[data-testid="admitted-mode"]')).toHaveText(expected.admitted_mode || "NONE");
    await expect(page.locator('[data-testid="confidence-basis"]')).toHaveText(expected.confidence_basis);

    for (const transition of expected.transitions) {
      const targetResponse = await request.get(
        API + "/api/scenarios/" + expected.id + "?transition=" + encodeURIComponent(transition.id)
      );
      expect(targetResponse.ok()).toBeTruthy();
      const target = await targetResponse.json();

      await page.locator('[data-testid="transition-' + transition.id + '"]').click();
      await expect(page.locator('[data-testid="classification"]')).toHaveText(target.classification);
      await expect(page.locator('[data-testid="admitted-mode"]')).toHaveText(target.admitted_mode || "NONE");
      await expect(page.locator('[data-testid="confidence-basis"]')).toHaveText(target.confidence_basis);
    }
  }
});
