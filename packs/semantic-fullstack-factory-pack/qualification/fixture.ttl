@prefix sf: <https://ggen.dev/ontology/semantic-fullstack#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:qualification:app> a sf:Application ;
  sf:appName "WD CS2 generated qualification" ;
  sf:pageTitle "WD Case Study 2 — Generated Quality Loop" ;
  sf:apiBasePath "/api" ;
  sf:defaultScenario "known_firmware" ;
  sf:runtimeIntelligence "NONE" ;
  sf:manufactureMode "DETERMINISTIC" .

<urn:qualification:known> a sf:Scenario ;
  sf:scenarioId "known_firmware" ;
  sf:title "Known firmware timeout" ;
  sf:classification "KNOWN" ;
  sf:standing "ALIVE" ;
  sf:candidateMode "MODE-A-FIRMWARE" ;
  sf:admittedMode "MODE-A-FIRMWARE" ;
  sf:confidenceBasis "DETERMINISTIC_RULE_AND_REQUIRED_EVIDENCE" ;
  sf:nextAction "RUN_FIRMWARE_DIAGNOSTIC_T14" ;
  sf:owningTeam "firmware_analysis" ;
  sf:humanGate "ENGINEER_DISPOSITION_REQUIRED" ;
  sf:authority "SELECT_CONSTRUCT_ONLY" ;
  sf:evidenceCsv "fw_trace|timeout_waveform|lot_genealogy" ;
  sf:missingEvidenceCsv "" ;
  sf:priorCasesCsv "FA-2019-0042|FA-2024-0117" ;
  sf:exposed true ;
  sf:order 1 .

<urn:qualification:partial> a sf:Scenario ;
  sf:scenarioId "partial_firmware" ;
  sf:title "Incomplete firmware timeout" ;
  sf:classification "PARTIAL" ;
  sf:standing "PARTIAL_ALIVE" ;
  sf:candidateMode "MODE-A-FIRMWARE" ;
  sf:admittedMode "NONE" ;
  sf:confidenceBasis "DETERMINISTIC_RULE_INCOMPLETE_EVIDENCE" ;
  sf:nextAction "ACQUIRE_TIMEOUT_WAVEFORM" ;
  sf:owningTeam "failure_analysis" ;
  sf:humanGate "ENGINEER_DISPOSITION_REQUIRED" ;
  sf:authority "SELECT_CONSTRUCT_ONLY" ;
  sf:evidenceCsv "fw_trace|lot_genealogy" ;
  sf:missingEvidenceCsv "timeout_waveform" ;
  sf:priorCasesCsv "FA-2019-0042|FA-2024-0117" ;
  sf:exposed true ;
  sf:order 2 .

<urn:qualification:novel> a sf:Scenario ;
  sf:scenarioId "novel_x" ;
  sf:title "Novel cross-layer signature" ;
  sf:classification "UNKNOWN" ;
  sf:standing "UNKNOWN" ;
  sf:candidateMode "MODE-X-CANDIDATE" ;
  sf:admittedMode "NONE" ;
  sf:confidenceBasis "NO_ADMITTED_PRIOR_ART" ;
  sf:nextAction "ESCALATE_NOVEL_INVESTIGATION" ;
  sf:owningTeam "failure_analysis" ;
  sf:humanGate "ENGINEER_DISPOSITION_REQUIRED" ;
  sf:authority "SELECT_CONSTRUCT_ONLY" ;
  sf:evidenceCsv "servo_trace|media_scan|lot_genealogy" ;
  sf:missingEvidenceCsv "" ;
  sf:priorCasesCsv "" ;
  sf:exposed true ;
  sf:order 3 .

<urn:qualification:replay> a sf:Scenario ;
  sf:scenarioId "novel_x_replay" ;
  sf:title "Novel signature after admitted experience" ;
  sf:classification "KNOWN" ;
  sf:standing "ALIVE" ;
  sf:candidateMode "MODE-X-NOVEL" ;
  sf:admittedMode "MODE-X-NOVEL" ;
  sf:confidenceBasis "ADMITTED_MACHINE_EXPERIENCE" ;
  sf:nextAction "RUN_NOVEL_X_STANDARD_WORK" ;
  sf:owningTeam "failure_analysis" ;
  sf:humanGate "ENGINEER_DISPOSITION_REQUIRED" ;
  sf:authority "SELECT_CONSTRUCT_ONLY" ;
  sf:evidenceCsv "servo_trace|media_scan|lot_genealogy" ;
  sf:missingEvidenceCsv "" ;
  sf:priorCasesCsv "MX-NOVEL-X-001" ;
  sf:exposed false ;
  sf:order 4 .

<urn:qualification:learn> a sf:Transition ;
  sf:transitionId "admit_experience" ;
  sf:fromScenario "novel_x" ;
  sf:toScenario "novel_x_replay" ;
  sf:triggerLabel "Admit verified MachineExperience fixture" .
