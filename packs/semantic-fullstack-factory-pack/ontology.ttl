@prefix sf: <https://ggen.dev/ontology/semantic-fullstack#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sf:Application a rdfs:Class .
sf:Scenario a rdfs:Class .
sf:Transition a rdfs:Class .

sf:appName a rdf:Property ; rdfs:range xsd:string .
sf:pageTitle a rdf:Property ; rdfs:range xsd:string .
sf:apiBasePath a rdf:Property ; rdfs:range xsd:string .
sf:defaultScenario a rdf:Property ; rdfs:range xsd:string .
sf:runtimeIntelligence a rdf:Property ; rdfs:range xsd:string .
sf:manufactureMode a rdf:Property ; rdfs:range xsd:string .

sf:scenarioId a rdf:Property ; rdfs:range xsd:string .
sf:title a rdf:Property ; rdfs:range xsd:string .
sf:classification a rdf:Property ; rdfs:range xsd:string .
sf:standing a rdf:Property ; rdfs:range xsd:string .
sf:candidateMode a rdf:Property ; rdfs:range xsd:string .
sf:admittedMode a rdf:Property ; rdfs:range xsd:string .
sf:confidenceBasis a rdf:Property ; rdfs:range xsd:string .
sf:nextAction a rdf:Property ; rdfs:range xsd:string .
sf:owningTeam a rdf:Property ; rdfs:range xsd:string .
sf:humanGate a rdf:Property ; rdfs:range xsd:string .
sf:authority a rdf:Property ; rdfs:range xsd:string .
sf:evidenceCsv a rdf:Property ; rdfs:range xsd:string .
sf:missingEvidenceCsv a rdf:Property ; rdfs:range xsd:string .
sf:priorCasesCsv a rdf:Property ; rdfs:range xsd:string .
sf:exposed a rdf:Property ; rdfs:range xsd:boolean .
sf:order a rdf:Property ; rdfs:range xsd:integer .

sf:transitionId a rdf:Property ; rdfs:range xsd:string .
sf:fromScenario a rdf:Property ; rdfs:range xsd:string .
sf:toScenario a rdf:Property ; rdfs:range xsd:string .
sf:triggerLabel a rdf:Property ; rdfs:range xsd:string .
