PREFIX empire: <https://chatmangpt.com/ontology/empire-reconstitution#>
SELECT ?violation ?subject WHERE {
  {
    BIND("CANDIDATE_COUNT" AS ?violation)
    BIND(empire:CandidateCapability AS ?subject)
    { SELECT (COUNT(?candidate) AS ?count) WHERE { ?candidate a empire:CandidateCapability . } }
    FILTER(?count != 6)
  }
  UNION
  {
    ?subject a empire:CandidateCapability .
    FILTER NOT EXISTS {
      ?subject empire:identifier ?id ; empire:disposition empire:Unknown .
    }
    BIND("OBSERVATION_ASSIGNED_FINAL_DISPOSITION" AS ?violation)
  }
}
