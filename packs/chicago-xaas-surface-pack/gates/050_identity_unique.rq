# ASK true = violation -> REFUSED_CHICAGO_IDENTITY_COLLISION
# Gate 050: semantic-identity uniqueness.
# Law: sj:capabilityId literals are unique across capabilities, and dcterms:identifier
# literals are unique across sj:Prediction cases. A collision means two distinct semantic
# entities claim one identity — the renderer must refuse rather than generalize.
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX dcterms: <http://purl.org/dc/terms/>
ASK {
  {
    ?a sj:capabilityId ?id .
    ?b sj:capabilityId ?id .
    FILTER(STR(?a) < STR(?b))
  }
  UNION
  {
    ?a a sj:Prediction .
    ?a dcterms:identifier ?id .
    ?b a sj:Prediction .
    ?b dcterms:identifier ?id .
    FILTER(STR(?a) < STR(?b))
  }
}
