# ASK true = violation -> REFUSED_CHICAGO_CAPABILITY_UNRESOLVED
# Gate 030: capability id resolution (renderer must refuse a missing capability id).
# Law: every layer required by the root must require a capability, every required
# capability must carry a non-empty sj:capabilityId, and no capabilityId may be empty.
PREFIX chi: <https://ggen-igniter.dev/sjira/v26.10.1/chicago#>
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
ASK {
  {
    chi:GC-XAAS-26.10.1-CHICAGO dcterms:hasPart ?layer .
    ?layer sj:requiresCapability ?capability .
    FILTER NOT EXISTS { ?capability sj:capabilityId ?capabilityId . }
  }
  UNION
  {
    ?capability sj:capabilityId "" .
  }
  UNION
  {
    VALUES ?required {
      chi:layer-sjira chi:layer-graphlaw chi:layer-sa2a chi:layer-pplan chi:layer-xaas
      chi:layer-ocel chi:layer-beam4pm chi:layer-affidavit chi:layer-surface chi:layer-marketplace
    }
    chi:GC-XAAS-26.10.1-CHICAGO dcterms:hasPart ?required .
    FILTER NOT EXISTS { ?required sj:requiresCapability ?anyCapability . }
  }
}
