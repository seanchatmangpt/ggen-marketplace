# ASK true = violation -> REFUSED_CHICAGO_AUTHORITY_WIDENING
# Gate 070: authority NONE (falsifier-authority-widening; renderer refuses projection
# authority other than NONE).
# Law: no sj:authorityClaim literal may be anything but "NONE"; every sj:ProjectionSpec
# and every sj:Prediction case must carry sj:authorityClaim "NONE" (absence = widening).
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
ASK {
  {
    ?entity sj:authorityClaim ?claim .
    FILTER(STR(?claim) != "NONE")
  }
  UNION
  {
    ?projection a sj:ProjectionSpec .
    FILTER NOT EXISTS { ?projection sj:authorityClaim "NONE" . }
  }
  UNION
  {
    ?case a sj:Prediction .
    FILTER NOT EXISTS { ?case sj:authorityClaim "NONE" . }
  }
}
