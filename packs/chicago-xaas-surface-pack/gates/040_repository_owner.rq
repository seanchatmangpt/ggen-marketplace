# ASK true = violation -> REFUSED_CHICAGO_REPOSITORY_OWNER_MISSING
# Gate 040: repository owner (renderer must refuse a required layer with no repository owner).
# Law: each of the 10 required layers carries a non-empty sj:repository, and every
# sj:repository literal in the Chicago graph names an owner inside seanchatmangpt/.
PREFIX chi: <https://ggen-igniter.dev/sjira/v26.10.1/chicago#>
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
ASK {
  {
    VALUES ?required {
      chi:layer-sjira chi:layer-graphlaw chi:layer-sa2a chi:layer-pplan chi:layer-xaas
      chi:layer-ocel chi:layer-beam4pm chi:layer-affidavit chi:layer-surface chi:layer-marketplace
    }
    FILTER NOT EXISTS { ?required sj:repository ?repository . }
  }
  UNION
  {
    ?layer sj:repository ?repository .
    FILTER(!STRSTARTS(STR(?repository), "seanchatmangpt/"))
  }
}
