# ASK true = violation -> REFUSED_CHICAGO_LAYER_IDENTITY
# Gate 020: layer-id uniqueness + required-layer presence.
# Law: layers are objects of the pinned root's dcterms:hasPart; two layers must never
# share a dcterms:identifier, and each of the 10 contract-required layers
# (contract slugs sjira|graphlaw|sa2a|pplan|xaas|ex4pm|beam4pm|affidavit|ashsurface|marketplace
#  <- graph IRIs layer-sjira..layer-marketplace, ex4pm=layer-ocel, ashsurface=layer-surface)
# must be declared as a part of chi:GC-XAAS-26.10.1-CHICAGO.
PREFIX chi: <https://ggen-igniter.dev/sjira/v26.10.1/chicago#>
PREFIX dcterms: <http://purl.org/dc/terms/>
ASK {
  {
    chi:GC-XAAS-26.10.1-CHICAGO dcterms:hasPart ?a , ?b .
    ?a dcterms:identifier ?id .
    ?b dcterms:identifier ?id .
    FILTER(STR(?a) < STR(?b))
  }
  UNION
  {
    VALUES ?required {
      chi:layer-sjira chi:layer-graphlaw chi:layer-sa2a chi:layer-pplan chi:layer-xaas
      chi:layer-ocel chi:layer-beam4pm chi:layer-affidavit chi:layer-surface chi:layer-marketplace
    }
    FILTER NOT EXISTS { chi:GC-XAAS-26.10.1-CHICAGO dcterms:hasPart ?required . }
  }
}
