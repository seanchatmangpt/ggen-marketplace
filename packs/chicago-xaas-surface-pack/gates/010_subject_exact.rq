# ASK true = violation -> REFUSED_CHICAGO_SUBJECT_DRIFT
# Gate 010: exact subject integrity (renderer must refuse a missing/wrong Chicago subject).
# Law: every sj:Prediction case anchors the exact subject LITERAL
# "urn:chicago:agentic-payment:purchase-001" (L1 fix: sj:subject objects are literals),
# and no sj:subject literal anywhere may drift from it.
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
ASK {
  {
    ?case a sj:Prediction .
    FILTER NOT EXISTS { ?case sj:subject "urn:chicago:agentic-payment:purchase-001" . }
  }
  UNION
  {
    ?entity sj:subject ?subject .
    FILTER(STR(?subject) != "urn:chicago:agentic-payment:purchase-001")
  }
}
