# ASK true = violation -> REFUSED_CHICAGO_PROJECTION_VOCABULARY
# Gate 060: projection-type vocabulary (R1: all four projections are JSON).
# Law: every sj:ProjectionSpec carries sj:projectionType inside the closed vocabulary
# {machine, verification, executive, replay} and sj:extension "json".
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
ASK {
  {
    ?projection a sj:ProjectionSpec .
    FILTER NOT EXISTS { ?projection sj:projectionType ?projectionType . }
  }
  UNION
  {
    ?projection a sj:ProjectionSpec .
    ?projection sj:projectionType ?projectionType .
    FILTER(?projectionType NOT IN ("machine", "verification", "executive", "replay"))
  }
  UNION
  {
    ?projection a sj:ProjectionSpec .
    FILTER NOT EXISTS { ?projection sj:extension "json" . }
  }
}
