@prefix chi: <https://ggen-igniter.dev/sjira/v26.10.1/chicago#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Chicago v26.10.1 render-source provenance (pack-side).
#
# The three canonical XaaS source graphs are vendored byte-identically under
# source/ (cp, never hand-copied); consumer-side drift checks compare these
# digests against docs/sjira/v26.10.1/. chi:sha256 values are regenerated with
# sha256sum after every re-vendoring and never hand-edited. narrative.ttl is a
# pack-authored render input (no canonical path); provenance.ttl cannot digest
# itself.
#
# Regeneration recipe:
#   cd packs/chicago-xaas-surface-pack/source
#   shasum -a 256 goal.ttl chicago.ttl projections.ttl narrative.ttl
# plus a byte-identity cmp against ~/xaas/docs/sjira/v26.10.1/.

chi:source-goal
    a chi:RenderSource ;
    rdfs:label "Vendored canonical goal graph" ;
    chi:canonicalPath "docs/sjira/v26.10.1/goal.ttl" ;
    chi:packPath "source/goal.ttl" ;
    chi:sha256 "7eb920b31942ea6269cc42fcde7cace896eb7bcae32fc535fbbb697ce4acc1f8" .

chi:source-chicago
    a chi:RenderSource ;
    rdfs:label "Vendored canonical Chicago episode and cases graph" ;
    chi:canonicalPath "docs/sjira/v26.10.1/chicago.ttl" ;
    chi:packPath "source/chicago.ttl" ;
    chi:sha256 "cd38fe16b421b3aa2656944498021fdf2a0473cd697143100819763f2f01e853" .

chi:source-projections
    a chi:RenderSource ;
    rdfs:label "Vendored canonical projections contract graph" ;
    chi:canonicalPath "docs/sjira/v26.10.1/projections.ttl" ;
    chi:packPath "source/projections.ttl" ;
    chi:sha256 "f74018a27d1b2ea16bca19ab919b1e2408b1dad0be51a6f8afdb03dbc9b4e18e" .

chi:source-narrative
    a chi:RenderSource ;
    rdfs:label "Pack-authored narrative projection graph" ;
    chi:packPath "source/narrative.ttl" ;
    chi:sha256 "f9e60b12defaa6f7ec34cc38d4f94c5d7289e2d5368570fd255f3f31bbe0fb61" .
