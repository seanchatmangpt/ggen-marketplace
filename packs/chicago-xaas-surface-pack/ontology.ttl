@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix cxp: <https://ggen-igniter.dev/pack/chicago-xaas-surface-pack#> .

# Pack ontology header (marketplace catalog + semantic identity).
# The RENDER source graphs live under source/ and are merged by ggen.toml
# [ontology].imports; this file only declares the pack identity and points at
# them. It carries no duplicate canonical bytes: source/provenance.ttl owns the
# digest chain.

<https://ggen-igniter.dev/pack/chicago-xaas-surface-pack>
    a owl:Ontology ;
    owl:versionInfo "26.10.1" ;
    rdfs:label "Chicago XaaS surface pack render ontology" ;
    dcterms:description "Deterministic Chicago renderer pack: machine, verification, executive and replay JSON projections manufactured from the vendored v26.10.1 sJira graphs. All projections carry authorityClaim NONE and byte-identical replay." ;
    dcterms:source "docs/sjira/v26.10.1/" ;
    owl:imports <https://ggen-igniter.dev/sjira/v26.10.1/chicago> .

cxp:render a rdfs:Class ;
    rdfs:label "Chicago render" ;
    rdfs:comment "One deterministic render of the four Chicago projections over the merged source graph." .
