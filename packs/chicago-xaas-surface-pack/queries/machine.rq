# Chicago machine projection rows (strict law: SELECT ending in ORDER BY).
# Row shapes (RESOLUTIONS R2): meta = root goal, digest = vendored source
# digests, layer = ecosystem layer (contract slug via chi:contractId),
# case = candidate-only prediction (sj:subject is the exact LITERAL).
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>
PREFIX chi: <https://ggen-igniter.dev/sjira/v26.10.1/chicago#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?rowKind ?sortKey ?subject ?identifier ?label ?repository ?baseSha
       ?authorityCeiling ?evidenceHorizon ?replayIdentity ?id ?pathScope
       ?boundaryClass ?capabilityId ?required ?status ?evidenceRefs
       ?receiptRefs ?description ?candidateOnly ?authorityClaim
       ?observedStanding ?path ?packPath ?canonicalPath ?sha256
WHERE {
  {
    BIND("meta" AS ?rowKind)
    BIND("0" AS ?sortKey)
    ?root a sj:GoalCheckpoint .
    FILTER NOT EXISTS { ?hasPartParent dcterms:hasPart ?root }
    ?root dcterms:identifier ?identifier ;
          rdfs:label ?label ;
          sj:repository ?repository ;
          sj:baseSha ?baseSha ;
          sj:authorityCeiling ?authorityCeiling ;
          sj:evidenceHorizon ?evidenceHorizon ;
          sj:replayIdentity ?replayIdentity .
    OPTIONAL {
      ?subjectElement a prov:Entity ;
                      dcterms:isPartOf ?root ;
                      dcterms:identifier ?subjectIdentifier .
    }
    BIND(COALESCE(?subjectIdentifier, "") AS ?subject)
    BIND("" AS ?id)
    BIND("" AS ?pathScope)
    BIND("" AS ?boundaryClass)
    BIND("" AS ?capabilityId)
    BIND("" AS ?required)
    BIND("" AS ?status)
    BIND("" AS ?evidenceRefs)
    BIND("" AS ?receiptRefs)
    BIND("" AS ?description)
    BIND("" AS ?candidateOnly)
    BIND("" AS ?authorityClaim)
    BIND("" AS ?observedStanding)
    BIND("" AS ?path)
    BIND("" AS ?packPath)
    BIND("" AS ?canonicalPath)
    BIND("" AS ?sha256)
  }
  UNION
  {
    BIND("digest" AS ?rowKind)
    ?renderSource a chi:RenderSource ;
                  chi:packPath ?packPath ;
                  chi:sha256 ?sha256 .
    OPTIONAL { ?renderSource chi:canonicalPath ?canonicalPathValue }
    BIND(COALESCE(?canonicalPathValue, "") AS ?canonicalPath)
    BIND(COALESCE(?canonicalPathValue, ?packPath) AS ?path)
    BIND(?path AS ?sortKey)
    BIND("" AS ?subject)
    BIND("" AS ?identifier)
    BIND("" AS ?label)
    BIND("" AS ?repository)
    BIND("" AS ?baseSha)
    BIND("" AS ?authorityCeiling)
    BIND("" AS ?evidenceHorizon)
    BIND("" AS ?replayIdentity)
    BIND("" AS ?id)
    BIND("" AS ?pathScope)
    BIND("" AS ?boundaryClass)
    BIND("" AS ?capabilityId)
    BIND("" AS ?required)
    BIND("" AS ?status)
    BIND("" AS ?evidenceRefs)
    BIND("" AS ?receiptRefs)
    BIND("" AS ?description)
    BIND("" AS ?candidateOnly)
    BIND("" AS ?authorityClaim)
    BIND("" AS ?observedStanding)
  }
  UNION
  {
    BIND("layer" AS ?rowKind)
    ?layer a sj:GoalCheckpoint ;
           dcterms:identifier ?identifier ;
           rdfs:label ?label ;
           sj:repository ?repository ;
           sj:pathScope ?pathScope ;
           sj:boundaryClass ?boundaryClassIri ;
           sj:authorityCeiling ?authorityCeiling ;
           sj:requiresCapability ?capability ;
           sj:evidenceHorizon ?evidenceHorizon .
    ?capability sj:capabilityId ?capabilityId .
    ?layer chi:contractId ?id .
    BIND(STR(?boundaryClassIri) AS ?boundaryClass)
    BIND(IF(?boundaryClassIri = sj:Successor, "false", "true") AS ?required)
    BIND("UNKNOWN" AS ?status)
    BIND(?identifier AS ?sortKey)
    BIND("" AS ?subject)
    BIND("" AS ?baseSha)
    BIND("" AS ?replayIdentity)
    BIND("" AS ?evidenceRefs)
    BIND("" AS ?receiptRefs)
    BIND("" AS ?description)
    BIND("" AS ?candidateOnly)
    BIND("" AS ?authorityClaim)
    BIND("" AS ?observedStanding)
    BIND("" AS ?path)
    BIND("" AS ?packPath)
    BIND("" AS ?canonicalPath)
    BIND("" AS ?sha256)
  }
  UNION
  {
    BIND("case" AS ?rowKind)
    ?case a sj:Prediction ;
          dcterms:identifier ?id ;
          rdfs:label ?label ;
          dcterms:description ?description ;
          sj:subject ?subject ;
          sj:candidateOnly ?candidateOnlyValue ;
          sj:authorityClaim ?authorityClaim ;
          sj:observedStanding ?observedStanding .
    BIND(STR(?candidateOnlyValue) AS ?candidateOnly)
    BIND(?id AS ?sortKey)
    BIND("" AS ?identifier)
    BIND("" AS ?repository)
    BIND("" AS ?baseSha)
    BIND("" AS ?authorityCeiling)
    BIND("" AS ?evidenceHorizon)
    BIND("" AS ?replayIdentity)
    BIND("" AS ?pathScope)
    BIND("" AS ?boundaryClass)
    BIND("" AS ?capabilityId)
    BIND("" AS ?required)
    BIND("" AS ?status)
    BIND("" AS ?evidenceRefs)
    BIND("" AS ?receiptRefs)
    BIND("" AS ?path)
    BIND("" AS ?packPath)
    BIND("" AS ?canonicalPath)
    BIND("" AS ?sha256)
  }
}
ORDER BY ?rowKind ?sortKey
