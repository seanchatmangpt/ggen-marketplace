{%- set metas = results | filter(attribute="rowKind", value="meta") -%}
{%- set digests = results | filter(attribute="rowKind", value="digest") -%}
{
  "generated": true,
  "authorityClaim": "NONE",
  "subject": "{{ metas[0]["subject"] | safe }}",
  "projectionType": "replay",
  "sourceDigests": [
    {%- for d in digests %}
    { "path": "{{ d["path"] | safe }}", "sha256": "{{ d["sha256"] | safe }}" }{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "generatorIdentity": "ggen-marketplace/chicago-xaas-surface-pack@26.10.1",
  "replayIdentity": "{{ metas[0]["replayIdentity"] | safe }}",
  "rootGoal": {
    "identifier": "{{ metas[0]["identifier"] | safe }}",
    "repository": "{{ metas[0]["repository"] | safe }}",
    "baseSha": "{{ metas[0]["baseSha"] | safe }}"
  },
  "sources": [
    {%- for d in digests %}
    { "path": "{{ d["path"] | safe }}", "sha256": "{{ d["sha256"] | safe }}" }{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "inputFiles": [
    {%- for d in digests %}
    "{{ d["packPath"] | safe }}"{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "outputs": [
    "chicago.machine.json",
    "chicago.verification.json",
    "chicago.executive.json",
    "chicago.replay.json"
  ],
  "renderCommand": "ggen sync run"
}
