{%- set metas = results | filter(attribute="rowKind", value="meta") -%}
{%- set digests = results | filter(attribute="rowKind", value="digest") -%}
{%- set layers = results | filter(attribute="rowKind", value="layer") -%}
{%- set falsifiers = results | filter(attribute="rowKind", value="falsifier") -%}
{%- set scenarios = results | filter(attribute="rowKind", value="scenario") -%}
{
  "generated": true,
  "authorityClaim": "NONE",
  "subject": "{{ metas[0]["subject"] | safe }}",
  "projectionType": "verification",
  "sourceDigests": [
    {%- for d in digests %}
    { "path": "{{ d["path"] | safe }}", "sha256": "{{ d["sha256"] | safe }}" }{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "generatorIdentity": "ggen-marketplace/chicago-xaas-surface-pack@26.10.1",
  "rootGoal": {
    "identifier": "{{ metas[0]["identifier"] | safe }}",
    "label": "{{ metas[0]["label"] | safe }}",
    "authorityCeiling": "{{ metas[0]["authorityCeiling"] | safe }}",
    "evidenceHorizon": "{{ metas[0]["evidenceHorizon"] | safe }}",
    "replayIdentity": "{{ metas[0]["replayIdentity"] | safe }}"
  },
  "layers": [
    {%- for r in layers %}
    {
      "id": "{{ r["id"] | safe }}",
      "identifier": "{{ r["identifier"] | safe }}",
      "label": "{{ r["label"] | safe }}",
      "repository": "{{ r["repository"] | safe }}",
      "pathScope": "{{ r["pathScope"] | safe }}",
      "authorityCeiling": "{{ r["authorityCeiling"] | safe }}",
      "evidenceHorizon": "{{ r["evidenceHorizon"] | safe }}",
      "status": "{{ r["status"] | safe }}",
      "evidenceRefs": [{{ r["evidenceRefs"] }}],
      "receiptRefs": [{{ r["receiptRefs"] }}],
      "falsifier": "{{ r["layerFalsifier"] | safe }}"
    }{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "falsifiers": [
    {%- for r in falsifiers %}
    {
      "label": "{{ r["falsifierLabel"] | safe }}",
      "description": "{{ r["falsifierDescription"] | safe }}"
    }{% if not loop.last %},{% endif %}{% endfor %}
  ],
  "scenarios": [
    {%- for r in scenarios %}
    {
      "id": "{{ r["caseId"] | safe }}",
      "label": "{{ r["caseLabel"] | safe }}",
      "polarity": "{{ r["polarity"] | safe }}",
      "description": "{{ r["caseDescription"] | safe }}",
      "subject": "{{ r["caseSubject"] | safe }}",
      "candidateOnly": {{ r["candidateOnly"] }},
      "authorityClaim": "{{ r["authorityClaim"] | safe }}",
      "observedStanding": "{{ r["observedStanding"] | safe }}"
    }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
