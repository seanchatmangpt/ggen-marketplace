PREFIX ocp: <https://ggen.dev/ontology/opportunity-currentness#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?entity WHERE {
  VALUES ?entity { ocp:DefaultDriftObservation ocp:RealizationLatencyObservation ocp:LedgerRefreshFact ocp:CurrentnessReceipt }
  ?entity a prov:Entity .
}
ORDER BY ?entity
