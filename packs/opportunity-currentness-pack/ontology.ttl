@prefix ocp: <https://ggen.dev/ontology/opportunity-currentness#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ocp:DefaultDriftObservation a prov:Entity .
ocp:RealizationLatencyObservation a prov:Entity .
ocp:LedgerRefreshFact a prov:Entity .
ocp:CurrentnessReceipt a prov:Entity .
ocp:DefaultDriftMetric a dqv:Metric ; dcterms:title "Default-branch drift containment" .
ocp:RealizationLatencyMetric a dqv:Metric ; dcterms:title "Discovery-to-realization latency" .
ocp:LedgerRefreshMetric a dqv:Metric ; dcterms:title "Append-only ledger refresh coverage" .

ocp:evaluator ocp:authority "OBSERVE|VERIFY|CONSTRUCT" ;
  ocp:actuationPerformed false ;
  ocp:networkAllowed false ;
  ocp:requiresExactSubject true ;
  ocp:appendOnlyLedger true ;
  ocp:preservesPriorFacts true .
