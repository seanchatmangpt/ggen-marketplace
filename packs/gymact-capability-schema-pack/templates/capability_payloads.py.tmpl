---
# Renders one Python module of Pydantic v2 BaseModel classes, one per
# gcs:CapabilityPayloadShape individual, from typed sh:property
# PropertyShape facts -- not an echoed literal, and not the free-text
# `Capability.title` string gymact uses today. Self-contained
# to:/sparql: frontmatter (sync.rs-native discovery) -- the exact
# convention this marketplace's own qualify tooling
# (scripts/qualify_packs.py's FRONTMATTER_PROBE_TEMPLATE) requires of
# every template, and the convention packs/github-actions-pack's
# workflow.yml.tmpl documents at length after a prior revision of THAT
# pack broke by using the no-frontmatter [[generation.rules]] File-sourced
# form instead. Do not repeat that mistake here.
#
# No for_each: this renders ONE output file aggregating every
# gcs:CapabilityPayloadShape row (matching star-toml-pack's
# star_toml_config.rs.tmpl, which renders one src/star_toml_config.rs from
# multiple stp:ConfigSection rows the same way) -- a payload-schema module
# is one importable unit, not one file per capability.
#
# `properties` returns every PropertyShape row for every shape (frontmatter
# sparql: values are static strings, not per-row templated, so no
# per-shape filtering is possible here, same constraint workflow.yml.tmpl
# documents for its own jobs:/steps: queries) -- the body filters down to
# the current row's own shape via `{% if p.shape == s.shape %}`, same
# per-row filtering technique star_toml_config.rs.tmpl uses for its own
# fields/a_sections join (`{% if f.sectionLabel == s.sectionLabel %}`).
#
# Body deliberately avoids Tera `-`/`{%- ... -%}` whitespace-trim markers
# inside the per-field indentation-sensitive block below -- Python's
# indentation is semantic, and an earlier draft of this template used `-`
# trims there, which (confirmed empirically against a real `ggen sync`
# render, not assumed) ate through the leading four spaces along with the
# intended newline, producing field lines at column 0 outside the class
# body. Fixed by following star_toml_config.rs.tmpl's own proven
# no-trim-marker style: literal text stays adjacent to its tags on the
# same source line so there is no run of whitespace for a trim to
# over-consume.
to: "gymact_capability_payloads.py"
sparql:
  shapes: |
    PREFIX gcs: <http://seanchatmangpt.github.io/packs/gymact-capability-schema#>
    PREFIX sh:  <http://www.w3.org/ns/shacl#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?shape ?className ?capability ?capTitle
    WHERE {
      ?shape a gcs:CapabilityPayloadShape ; gcs:payloadShapeOf ?capability .
      OPTIONAL { ?shape sh:name ?className . }
      OPTIONAL { ?capability dct:title ?capTitle . }
    }
    ORDER BY ?shape
  properties: |
    PREFIX sh: <http://www.w3.org/ns/shacl#>
    SELECT ?shape ?propName ?datatype ?minCount ?maxCount ?description ?defaultValue
    WHERE {
      ?shape sh:property ?prop .
      ?prop sh:path ?path .
      OPTIONAL { ?prop sh:name ?propName . }
      OPTIONAL { ?prop sh:datatype ?datatype . }
      OPTIONAL { ?prop sh:minCount ?minCount . }
      OPTIONAL { ?prop sh:maxCount ?maxCount . }
      OPTIONAL { ?prop sh:description ?description . }
      OPTIONAL { ?prop sh:defaultValue ?defaultValue . }
    }
    ORDER BY ?shape ?propName
---
{%- macro py_type(datatype) %}{% if datatype == "http://www.w3.org/2001/XMLSchema#string" %}str{% elif datatype == "http://www.w3.org/2001/XMLSchema#anyURI" %}str{% elif datatype == "http://www.w3.org/2001/XMLSchema#integer" %}int{% elif datatype == "http://www.w3.org/2001/XMLSchema#boolean" %}bool{% elif datatype == "http://www.w3.org/2001/XMLSchema#double" %}float{% elif datatype == "http://www.w3.org/2001/XMLSchema#decimal" %}float{% elif datatype == "http://www.w3.org/2001/XMLSchema#float" %}float{% elif datatype == "http://www.w3.org/2001/XMLSchema#dateTime" %}datetime{% else %}Any{% endif %}{% endmacro py_type -%}
{%- macro py_default(datatype, value) %}{% if datatype == "http://www.w3.org/2001/XMLSchema#string" or datatype == "http://www.w3.org/2001/XMLSchema#anyURI" %}"{{ value }}"{% else %}{{ value }}{% endif %}{% endmacro py_default -%}
"""Generated by gymact-capability-schema-pack from gcs:CapabilityPayloadShape
facts -- do not hand-edit.

Closes gymact's payload-schema gap: today `Capability.title`
(~/gymact/src/gymact/providers.py) folds a capability's payload shape into
free text ('Payload: {"key": <str>, "value": <any>}.') because nothing in
gymact's admitted RDF/SHACL profile describes it. These typed Pydantic v2
models are the machine-checkable equivalent, derived from real
sh:NodeShape/sh:PropertyShape facts, not from re-parsing that title string.

Add a new typed payload for a Consequence.DO capability by adding a
gcs:CapabilityPayloadShape individual (sh:NodeShape + sh:property
PropertyShapes) to your own instance-data .ttl -- not by adding a class
here by hand; the next `ggen sync run` regenerates this file from scratch.
"""

from __future__ import annotations

from datetime import datetime
from typing import Any

from pydantic import BaseModel, ConfigDict

{% for s in shapes %}
class {{ s.className | default(value="UnnamedPayload") | pascal_case }}(BaseModel):
    """Payload shape for {{ s.capTitle | default(value=s.capability) }} (`{{ s.capability }}`)."""

    model_config = ConfigDict(extra="forbid")
{% for p in properties %}{% if p.shape == s.shape %}{% if p.minCount and p.minCount >= 1 %}    {{ p.propName }}: {{ self::py_type(datatype=p.datatype) }}
{% else %}    {{ p.propName }}: {{ self::py_type(datatype=p.datatype) }} | None{% if p.defaultValue %} = {{ self::py_default(datatype=p.datatype, value=p.defaultValue) }}{% else %} = None{% endif %}
{% endif %}{% if p.description %}    """{{ p.description }}"""
{% endif %}{% endif %}{% endfor %}{% if properties | filter(attribute="shape", value=s.shape) | length == 0 %}    pass
{% endif %}

{% endfor %}
