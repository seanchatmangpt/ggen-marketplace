@prefix gha: <http://seanchatmangpt.github.io/packs/github-actions#> .

gha:qualification-workflow a gha:Workflow ;
  gha:fileName "qualification.yml" ;
  gha:purpose "Marketplace qualification workflow" ;
  gha:trigger gha:EventWorkflowDispatch ;
  gha:permissionCeiling "contents: read" ;
  gha:noEvidenceReason "Qualification-only deterministic generation witness." .

gha:qualification-job a gha:Job ;
  gha:inWorkflow gha:qualification-workflow ;
  gha:jobName "qualify" ;
  gha:runner "ubuntu-latest" ;
  gha:timeoutMinutes 5 .

gha:qualification-step a gha:Step ;
  gha:inJob gha:qualification-job ;
  gha:stepOrder 1 ;
  gha:stepName "Prove workflow projection" ;
  gha:runCommand "printf 'github-actions-pack qualified\\n'" .

gha:qualification-action a gha:CompositeAction ;
  gha:actionDirName "qualification" ;
  gha:actionPurpose "Marketplace qualification composite action" .

gha:qualification-action-step a gha:Step ;
  gha:inJob gha:qualification-action ;
  gha:stepOrder 1 ;
  gha:stepName "Prove composite-action projection" ;
  gha:runCommand "printf 'github-actions-pack composite qualified\\n'" .
