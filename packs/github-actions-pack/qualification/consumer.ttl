# Synthetic consumer fixture for isolated qualification of gate 030
# (push-trigger-required). Proves the two admitted outcomes: a real push
# trigger, and a stated exemption reason. The third, refused case
# (a gha:Workflow with neither) was verified for real during development
# -- `ggen sync run` genuinely refused it with FM-PACK-013, naming the
# exact subject -- but is not shipped here, since a pack's own
# qualification fixture should demonstrate what a real consumer is
# admitted to do, not carry a permanently-failing individual.
@prefix gha: <http://seanchatmangpt.github.io/packs/github-actions#> .

gha:test-ci-with-push
    a gha:Workflow ;
    gha:fileName "test-ci-with-push.yml" ;
    gha:purpose "Test fixture: CI with a real push trigger -- must be admitted." ;
    gha:permissionCeiling "read-all" ;
    gha:trigger gha:EventPush .

gha:test-release-gate
    a gha:Workflow ;
    gha:fileName "test-release-gate.yml" ;
    gha:purpose "Test fixture: manual-dispatch-only release gate with a stated exemption -- must be admitted." ;
    gha:permissionCeiling "read-all" ;
    gha:trigger gha:EventWorkflowDispatch ;
    gha:noPushTriggerReason "manual-dispatch-only release gate, intentionally not push-triggered" .
