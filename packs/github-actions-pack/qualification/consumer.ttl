# Synthetic consumer fixture for isolated qualification.
# Existing push-trigger cases plus the admitted local-runtime DfCM route graph and
# GitHub's 2026 background/wait/cancel/parallel step-concurrency grammar.
@prefix gha: <http://seanchatmangpt.github.io/packs/github-actions#> .

gha:test-ci-with-push
    a gha:Workflow ;
    gha:fileName "test-ci-with-push.yml" ;
    gha:purpose "Test fixture: CI with a real push trigger -- must be admitted." ;
    gha:permissionCeiling "read-all" ;
    gha:trigger gha:EventPush .

gha:test-job
    a gha:Job ;
    gha:inWorkflow gha:test-ci-with-push ;
    gha:jobName "test" ;
    gha:runner "ubuntu-24.04" .

gha:test-background-build
    a gha:Step ;
    gha:inJob gha:test-job ;
    gha:stepOrder 1 ;
    gha:stepName "background build" ;
    gha:stepId "build" ;
    gha:runCommand "echo build" ;
    gha:background true .

gha:test-wait-build
    a gha:Step ;
    gha:inJob gha:test-job ;
    gha:stepOrder 2 ;
    gha:waitFor "build" .

gha:test-background-monitor
    a gha:Step ;
    gha:inJob gha:test-job ;
    gha:stepOrder 3 ;
    gha:stepName "background monitor" ;
    gha:stepId "monitor" ;
    gha:runCommand "sleep 30" ;
    gha:background true .

gha:test-cancel-monitor
    a gha:Step ;
    gha:inJob gha:test-job ;
    gha:stepOrder 4 ;
    gha:cancelStep "monitor" .

gha:test-parallel
    a gha:Step ;
    gha:inJob gha:test-job ;
    gha:stepOrder 5 ;
    gha:parallelBody """- name: parallel A
  run: echo A
- name: parallel B
  run: echo B""" .

gha:test-release-gate
    a gha:Workflow ;
    gha:fileName "test-release-gate.yml" ;
    gha:purpose "Test fixture: manual-dispatch-only release gate with a stated exemption -- must be admitted." ;
    gha:permissionCeiling "read-all" ;
    gha:trigger gha:EventWorkflowDispatch ;
    gha:noPushTriggerReason "manual-dispatch-only release gate, intentionally not push-triggered" .

gha:test-local-profile
    a gha:LocalExecutionProfile ;
    gha:profileName "qualification" ;
    gha:receiptRoot ".ggen-v2/github-local/receipts" ;
    gha:exactActSha "4f411281417e88660bea1c1a1749aa71ae0bd60f" ;
    gha:exactActVersion "0.2.89" ;
    gha:requiresCapability gha:test-capability .

gha:test-capability
    a gha:LocalCapability ;
    gha:capabilityKey "workflow.execution" ;
    gha:requiresGitHubControlPlane false .

gha:test-act
    a gha:ExecutionBackend ;
    gha:capabilityKey "act" .

gha:test-route
    a gha:CapabilityRoute ;
    gha:inProfile gha:test-local-profile ;
    gha:forCapability gha:test-capability ;
    gha:viaBackend gha:test-act ;
    gha:routeMode gha:ModeNative ;
    gha:routePriority 10 ;
    gha:semanticCeiling "workflow/job/step execution where act semantics match admitted workflow features" ;
    gha:evidenceClass "local act exit code + receipt" .
