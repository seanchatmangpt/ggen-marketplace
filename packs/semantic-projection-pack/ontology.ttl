@prefix sp: <https://ggen.dev/ontology/semantic-projection#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

sp:SemanticSource a rdfs:Class .
sp:Projection a rdfs:Class .
sp:GeneratedArtifact a rdfs:Class .
sp:Profile a rdfs:Class .
sp:Lineage a rdfs:Class .
sp:SemanticCompilation a rdfs:Class .
sp:CompilationPhase a rdfs:Class .
sp:IntermediateRepresentation a rdfs:Class .
sp:TargetRepresentation a rdfs:Class .
sp:source a rdf:Property .
sp:profile a rdf:Property .
sp:produces a rdf:Property .
sp:lineage a rdf:Property .
sp:deterministic a rdf:Property .
sp:phase a rdf:Property .
sp:canonicalSemanticSource a rdf:Property .
sp:priorArtClosure a rdf:Property .
sp:irreducibleResidual a rdf:Property .
sp:projectionTarget a rdf:Property .
sp:humanImplementationRequired a rdf:Property .
sp:grantsDoAuthority a rdf:Property .

sp:CanonicalProjection a sp:Projection ;
  sp:deterministic true .

sp:ParseIntent a sp:CompilationPhase .
sp:ReconstructOntology a sp:CompilationPhase .
sp:HyperSearch a sp:CompilationPhase .
sp:EquivalenceCheck a sp:CompilationPhase .
sp:CapabilityClosure a sp:CompilationPhase .
sp:Residualize a sp:CompilationPhase .
sp:Plan a sp:CompilationPhase .
sp:Generate a sp:CompilationPhase .
sp:Admit a sp:CompilationPhase .
sp:Execute a sp:CompilationPhase .
sp:Receipt a sp:CompilationPhase .

sp:MachineSemanticCompilation a sp:SemanticCompilation ;
  sp:phase sp:ParseIntent,
    sp:ReconstructOntology,
    sp:HyperSearch,
    sp:EquivalenceCheck,
    sp:CapabilityClosure,
    sp:Residualize,
    sp:Plan,
    sp:Generate,
    sp:Admit,
    sp:Execute,
    sp:Receipt ;
  sp:deterministic true ;
  sp:humanImplementationRequired false ;
  sp:grantsDoAuthority false ;
  rdfs:comment "Machine Semantic Compilation Theory: meaning compiles to lawful computation. Prior-art closure is a compilation phase; generated code, configuration, protocol surfaces and runtime manifests are non-sovereign projections of admitted semantics." .
