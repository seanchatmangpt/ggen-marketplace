@prefix sp: <https://ggen.dev/ontology/semantic-projection#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== CLASSES =====
# The core projection chain this pack enforces:
#   CanonicalSemanticSource --projectedBy--> ProjectionEvent --produces--> GeneratedArtifact
#   ProjectionEvent --lineageSource--> CanonicalSemanticSource (mandatory)
#   GeneratedArtifact --derivedFrom--> ProjectionEvent
# A GeneratedArtifact is never itself a CanonicalSemanticSource -- it is
# structurally the consequence of a projection, not a second source of
# truth. Enforced/refused by gates/010_no_sovereign_generated_artifact.rq.
sp:CanonicalSemanticSource a rdfs:Class .
sp:ProjectionEvent a rdfs:Class .
sp:GeneratedArtifact a rdfs:Class .
sp:Lineage a rdfs:Class .
sp:Fanout a rdfs:Class .

# ===== PROPERTIES =====
sp:projectsFrom a rdf:Property ; rdfs:domain sp:ProjectionEvent ; rdfs:range sp:CanonicalSemanticSource .
sp:produces a rdf:Property ; rdfs:domain sp:ProjectionEvent ; rdfs:range sp:GeneratedArtifact .
sp:derivedFrom a rdf:Property ; rdfs:domain sp:GeneratedArtifact ; rdfs:range sp:ProjectionEvent .
sp:lineageSource a rdf:Property ; rdfs:domain sp:ProjectionEvent ; rdfs:range sp:CanonicalSemanticSource .
sp:fanoutOf a rdf:Property ; rdfs:domain sp:Fanout ; rdfs:range sp:ProjectionEvent .
sp:isSovereign a rdf:Property ; rdfs:range xsd:boolean .
sp:deterministic a rdf:Property ; rdfs:range xsd:boolean .
sp:eventId a rdf:Property ; rdfs:domain sp:ProjectionEvent ; rdfs:range xsd:string .

# ===== REAL INDIVIDUALS: canonical source =====
# The sole sovereign source of truth for this pack's own worked example: the
# marketplace's own ontology.ttl for this pack, which every rendered/generated
# consequence of this pack must trace back to.
sp:SemanticProjectionPackOntology a sp:CanonicalSemanticSource ;
    rdfs:label "packs/semantic-projection-pack/ontology.ttl -- the canonical RDF source for this pack" ;
    sp:isSovereign true .

# ===== REAL INDIVIDUALS: projection event with mandatory lineage =====
sp:ProjectSemanticProjectionPackCatalogEvent a sp:ProjectionEvent ;
    rdfs:label "scripts/marketplace.py catalog projecting this pack's manifest+ontology into a catalog record" ;
    sp:eventId "semantic-projection-pack/26.9.12/catalog/001" ;
    sp:projectsFrom sp:SemanticProjectionPackOntology ;
    sp:lineageSource sp:SemanticProjectionPackOntology ;
    sp:produces sp:SemanticProjectionPackCatalogRecord ;
    sp:deterministic true .

# ===== REAL INDIVIDUALS: generated artifact, explicitly non-sovereign =====
# The catalog record is a real consequence of the projection event above. It
# is explicitly marked non-sovereign: it is a rendering, never a second
# source of truth, and must never be asserted as a sp:CanonicalSemanticSource.
sp:SemanticProjectionPackCatalogRecord a sp:GeneratedArtifact ;
    rdfs:label "The catalog.json record scripts/marketplace.py catalog projects for this pack" ;
    sp:derivedFrom sp:ProjectSemanticProjectionPackCatalogEvent ;
    sp:isSovereign false .

# ===== REAL INDIVIDUAL: fanout over the projection event =====
sp:SemanticProjectionPackCatalogFanout a sp:Fanout ;
    rdfs:label "The a/b/cmp determinism check fanning out two independent runs of the same projection event" ;
    sp:fanoutOf sp:ProjectSemanticProjectionPackCatalogEvent .

sp:SemanticCompilation a rdfs:Class .
sp:CompilationPhase a rdfs:Class .
sp:IntermediateRepresentation a rdfs:Class .
sp:TargetRepresentation a rdfs:Class .


sp:CanonicalSubject a rdfs:Class ;
  rdfs:comment "Canonical semantic subject. External consumers ordinarily receive purpose-bound projections rather than this subject." .
sp:PurposeBoundProjection a rdfs:Class ;
  rdfs:subClassOf sp:Projection ;
  rdfs:comment "A projection bounded by relying party, admitted purpose, identifier scope, validity, and disclosure predicates." .
sp:RelyingParty a rdfs:Class .
sp:Purpose a rdfs:Class .
sp:DisclosurePredicate a rdfs:Class .
sp:IdentifierScope a rdfs:Class .
sp:AnonymousProofScope a rdfs:Class ; rdfs:subClassOf sp:IdentifierScope .
sp:EphemeralIdentifierScope a rdfs:Class ; rdfs:subClassOf sp:IdentifierScope .
sp:PairwiseIdentifierScope a rdfs:Class ; rdfs:subClassOf sp:IdentifierScope .
sp:CanonicalIdentifierScope a rdfs:Class ; rdfs:subClassOf sp:IdentifierScope .

sp:source a rdf:Property .
sp:profile a rdf:Property .
sp:produces a rdf:Property .
sp:lineage a rdf:Property .
sp:deterministic a rdf:Property .
sp:phase a rdf:Property .
sp:canonicalSemanticSource a rdf:Property .
sp:priorArtClosure a rdf:Property .
sp:irreducibleResidual a rdf:Property .
sp:projectionTarget a rdf:Property .
sp:humanImplementationRequired a rdf:Property .
sp:grantsDoAuthority a rdf:Property .

sp:CanonicalProjection a sp:Projection ;
  sp:deterministic true .

sp:ParseIntent a sp:CompilationPhase .
sp:ReconstructOntology a sp:CompilationPhase .
sp:HyperSearch a sp:CompilationPhase .
sp:EquivalenceCheck a sp:CompilationPhase .
sp:CapabilityClosure a sp:CompilationPhase .
sp:Residualize a sp:CompilationPhase .
sp:Plan a sp:CompilationPhase .
sp:Generate a sp:CompilationPhase .
sp:Admit a sp:CompilationPhase .
sp:Execute a sp:CompilationPhase .
sp:Receipt a sp:CompilationPhase .

sp:MachineSemanticCompilation a sp:SemanticCompilation ;
  sp:phase sp:ParseIntent,
    sp:ReconstructOntology,
    sp:HyperSearch,
    sp:EquivalenceCheck,
    sp:CapabilityClosure,
    sp:Residualize,
    sp:Plan,
    sp:Generate,
    sp:Admit,
    sp:Execute,
    sp:Receipt ;
  sp:deterministic true ;
  sp:humanImplementationRequired false ;
  sp:grantsDoAuthority false ;
  rdfs:comment "Machine Semantic Compilation Theory: meaning compiles to lawful computation. Prior-art closure is a compilation phase; generated code, configuration, protocol surfaces and runtime manifests are non-sovereign projections of admitted semantics." .


sp:projectionFor a rdf:Property .
sp:hasPurpose a rdf:Property .
sp:requiresPredicate a rdf:Property .
sp:allowsPredicate a rdf:Property .
sp:forbidsPredicate a rdf:Property .
sp:disclosesPredicate a rdf:Property .
sp:usesIdentifierScope a rdf:Property .
sp:requiresCanonicalIdentity a rdf:Property .
sp:minimumSufficientDisclosure a rdf:Property .
sp:validFrom a rdf:Property .
sp:validUntil a rdf:Property .
sp:linkableWithin a rdf:Property .
sp:audience a rdf:Property .

sp:CanonicalProjection a sp:Projection ; sp:deterministic true .
sp:AnonymousProof a sp:AnonymousProofScope ;
  rdfs:comment "Prefer when a predicate can be proved without disclosing a stable identifier." .
sp:EphemeralIdentifier a sp:EphemeralIdentifierScope ;
  rdfs:comment "Use when transaction identity is required but continuity is not." .
sp:PairwiseIdentifier a sp:PairwiseIdentifierScope ;
  rdfs:comment "Use when continuity with one relying party is required without global identity." .
sp:CanonicalIdentifier a sp:CanonicalIdentifierScope ;
  rdfs:comment "Use only when canonical identity is required by the admitted purpose and separately authorized." .
