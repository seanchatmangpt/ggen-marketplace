@prefix sp: <https://ggen.dev/ontology/semantic-projection#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Minimal positive qualification fixture: a second, independently-named
# canonical source / projection event / generated artifact chain a consumer
# pack could query against -- exercises the full lineage chain with real
# individuals distinct from the pack's own worked example, so
# scripts/qualify_packs.py's qualify_pack() has real facts to render and
# gates/010_no_sovereign_generated_artifact.rq has more than one row to
# evaluate. This fixture is lawful (full lineage, non-sovereign artifact)
# and must NOT trigger the gate.

sp:ConsumerCanonicalOntology a sp:CanonicalSemanticSource ;
    rdfs:label "A downstream consumer's own canonical ontology source" ;
    sp:isSovereign true .

sp:ConsumerProjectionEvent a sp:ProjectionEvent ;
    rdfs:label "A downstream consumer's own projection event, lineage-linked" ;
    sp:eventId "consumer/projection/001" ;
    sp:projectsFrom sp:ConsumerCanonicalOntology ;
    sp:lineageSource sp:ConsumerCanonicalOntology ;
    sp:produces sp:ConsumerGeneratedArtifact ;
    sp:deterministic true .

sp:ConsumerGeneratedArtifact a sp:GeneratedArtifact ;
    rdfs:label "A downstream consumer's rendered artifact, explicitly non-sovereign" ;
    sp:derivedFrom sp:ConsumerProjectionEvent ;
    sp:isSovereign false .
