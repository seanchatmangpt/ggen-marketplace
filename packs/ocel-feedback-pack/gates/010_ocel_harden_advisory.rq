# MESSAGE: this command's real fleet-wide OCEL corpus signal recommends harden (exercised recently but below the configured success-rate threshold); any row is a refusal.
PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
PREFIX cnv-ocel: <https://clap-noun-verb.dev/ontology/ocel#>
SELECT ?command ?commandId WHERE {
  ?noun a cnv:Noun ; cnv:name ?nounName ; cnv:hasCommand ?command .
  ?command a cnv:Command ; cnv:name ?verbName .
  BIND(CONCAT(?nounName, ":", ?verbName) AS ?commandId)
  ?signal a cnv-ocel:Signal ;
          cnv-ocel:commandId ?commandId ;
          cnv-ocel:recommendation "harden" .
}
ORDER BY ?commandId
