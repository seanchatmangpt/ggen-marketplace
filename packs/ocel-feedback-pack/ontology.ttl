# Vocabulary for cnv-ocel:Signal individuals -- the real fleet-wide usage
# evidence this pack's gate reads. This pack does NOT produce Signal
# individuals itself; they come from a real merged OCEL corpus, projected via
# clap_noun_verb::ocel::signals_to_rdf (in the clap-noun-verb Rust crate) and
# composed into the SAME graph as this project's own cnv:Cli ontology --
# typically by writing the projection's output into a small sibling "pack"
# directory (just an ontology.ttl, no gates/templates of its own) and adding
# it to this project's [packs] table alongside this one. See
# clap-noun-verb/docs/reference/ocel-feedback-loop.md for the full worked
# example (synthetic corpus -> signals -> composed graph -> real gate
# refusal), and clap-noun-verb/tests/ocel_feedback_loop.rs for the real,
# subprocess-level integration test that proves the refusal is real.
@prefix cnv-ocel: <https://clap-noun-verb.dev/ontology/ocel#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cnv-ocel:Signal a rdfs:Class ;
    rdfs:comment "One admitted command's real fleet-wide usage signal, derived from a merged OCEL 2.0 corpus." .

cnv-ocel:commandId a rdf:Property ;
    rdfs:domain cnv-ocel:Signal ;
    rdfs:comment "The \"{noun}:{verb}\" id this signal describes -- the same scheme clap_noun_verb::ocel::record_invocation uses." .

cnv-ocel:invocationCount a rdf:Property ;
    rdfs:domain cnv-ocel:Signal ;
    rdfs:comment "Total real events regarding this command across the merged corpus." .

cnv-ocel:successRate a rdf:Property ;
    rdfs:domain cnv-ocel:Signal ;
    rdfs:comment "success_count / invocation_count across the merged corpus, or 0.0 if never invoked." .

cnv-ocel:recommendation a rdf:Property ;
    rdfs:domain cnv-ocel:Signal ;
    rdfs:comment "One of \"prune\" | \"review\" | \"harden\" | \"keep\" -- see clap_noun_verb::ocel::SignalRecommendation." .
