def qualify(subject, gates):
    results = [gate(subject) for gate in gates]
    hard = [r for r in results if r in {"BUILD_BROKEN","BLOCKED"}]
    if hard:
        return hard[0]
    if all(r == "ALIVE" for r in results):
        return "ALIVE"
    if any(r == "PARTIAL_ALIVE" for r in results):
        return "PARTIAL_ALIVE"
    return "UNKNOWN"
