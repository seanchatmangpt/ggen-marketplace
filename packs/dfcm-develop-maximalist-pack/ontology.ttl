dev:searchPortfolio a dev:Capability ; dct:title "Bounded search portfolio" ; dev:family "search" ; dev:authority "SELECT" ; dev:falsifier "budget-or-regret-violation" .
dev:semanticConvergence a dev:Capability ; dct:title "Semantic convergence" ; dev:family "semantics" ; dev:authority "CONSTRUCT" ; dev:falsifier "non-monotone-or-divergent" .
dev:distributedEvidence a dev:Capability ; dct:title "Distributed evidence" ; dev:family "distributed" ; dev:authority "VERIFY" ; dev:falsifier "pseudo-quorum-or-split-currentness" .
dev:simulationConformance a dev:Capability ; dct:title "Simulation and conformance" ; dev:family "process-intelligence" ; dev:authority "VERIFY" ; dev:falsifier "trace-or-provider-divergence" .

