@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix f5rh: <http://seanchatmangpt.github.io/packs/fortune5-retention-legal-hold#> .

# SHACL twin of gates/010, 020, 030. Not root shapes.ttl (pack contract refuse).
# Manual: ggen graph validate --files ontology.ttl --shapes shapes/f5rh.shacl.ttl

f5rh:RetentionProgramShape a sh:NodeShape ;
    sh:targetClass f5rh:RetentionProgram ;
    sh:property [
        sh:path f5rh:programId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5rh:catalogGroup ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:hasValue "object-storage" ;
        sh:message "RetentionProgram catalogGroup must be object-storage" ;
    ] ;
    sh:property [
        sh:path f5rh:catalogVersion ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5rh:catalogPackId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:hasValue "fortune5-retention-pack" ;
        sh:message "catalogPackId must equal fortune5-retention-pack" ;
    ] ;
    sh:property [
        sh:path f5rh:hasSchedule ;
        sh:minCount 1 ; sh:class f5rh:RetentionSchedule ;
    ] ;
    sh:property [
        sh:path f5rh:hasLegalHold ;
        sh:minCount 1 ; sh:class f5rh:LegalHold ;
    ] ;
    sh:property [
        sh:path f5rh:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:message "RetentionProgram directActuation must be false (broker-only)" ;
    ] ;
    sh:severity sh:Violation .

f5rh:RetentionScheduleShape a sh:NodeShape ;
    sh:targetClass f5rh:RetentionSchedule ;
    sh:property [
        sh:path f5rh:scheduleId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5rh:title ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5rh:appliesToStorageClass ;
        sh:minCount 1 ; sh:class f5rh:StorageClass ;
    ] ;
    sh:property [
        sh:path f5rh:retentionDays ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "retentionDays must be a positive xsd:integer" ;
    ] ;
    sh:property [
        sh:path f5rh:immutableCapable ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
    ] ;
    sh:property [
        sh:path f5rh:evidenceRequired ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
    ] ;
    sh:property [
        sh:path f5rh:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
    ] ;
    sh:severity sh:Violation .

f5rh:LegalHoldShape a sh:NodeShape ;
    sh:targetClass f5rh:LegalHold ;
    sh:property [
        sh:path f5rh:holdId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5rh:title ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5rh:matterId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5rh:holdsObject ;
        sh:minCount 1 ; sh:class f5rh:HeldObject ;
    ] ;
    sh:property [
        sh:path f5rh:blocksDelete ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "LegalHold blocksDelete must be true" ;
    ] ;
    sh:property [
        sh:path f5rh:blocksExport ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "LegalHold blocksExport must be true" ;
    ] ;
    sh:property [
        sh:path f5rh:evidenceRequired ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
    ] ;
    sh:property [
        sh:path f5rh:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
    ] ;
    sh:severity sh:Violation .

f5rh:HeldObjectShape a sh:NodeShape ;
    sh:targetClass f5rh:HeldObject ;
    sh:property [
        sh:path f5rh:objectId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5rh:appliesToStorageClass ;
        sh:minCount 1 ; sh:class f5rh:StorageClass ;
    ] ;
    sh:severity sh:Violation .

f5rh:StorageClassShape a sh:NodeShape ;
    sh:targetClass f5rh:StorageClass ;
    sh:property [
        sh:path f5rh:storageClassId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:severity sh:Violation .
