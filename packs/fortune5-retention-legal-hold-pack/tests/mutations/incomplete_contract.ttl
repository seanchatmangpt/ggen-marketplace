@prefix f5rh: <http://seanchatmangpt.github.io/packs/fortune5-retention-legal-hold#> .

# Gate 010 anti-vacuity: incomplete RetentionSchedule (missing retentionDays).
# Union with ontology.ttl must produce >=1 gate 010 row / SHACL non-conformance.

f5rh:incomplete-010-schedule a f5rh:RetentionSchedule ;
    f5rh:scheduleId "RET-INCOMPLETE-010" ;
    f5rh:title "Incomplete schedule missing retentionDays" ;
    f5rh:appliesToStorageClass f5rh:ObjectEvidence ;
    f5rh:immutableCapable true ;
    f5rh:evidenceRequired true ;
    f5rh:directActuation false .
