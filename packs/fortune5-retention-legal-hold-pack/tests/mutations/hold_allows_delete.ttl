@prefix f5rh: <http://seanchatmangpt.github.io/packs/fortune5-retention-legal-hold#> .

# Falsifier for gates/020 blocksDelete=true + SHACL hasValue true.

f5rh:bad-hold-delete a f5rh:LegalHold ;
    f5rh:holdId "HOLD-BAD-DELETE" ;
    f5rh:title "Hold that fails to block delete" ;
    f5rh:matterId "MATTER-BAD" ;
    f5rh:holdsObject f5rh:obj-receipt-ledger-001 ;
    f5rh:blocksDelete false ;
    f5rh:blocksExport true ;
    f5rh:evidenceRequired true ;
    f5rh:directActuation false .
