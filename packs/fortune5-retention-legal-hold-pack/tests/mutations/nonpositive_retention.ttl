@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix f5rh: <http://seanchatmangpt.github.io/packs/fortune5-retention-legal-hold#> .

# Falsifier for gates/030 retentionDays > 0 + SHACL minInclusive 1.

f5rh:bad-schedule-zero a f5rh:RetentionSchedule ;
    f5rh:scheduleId "RET-BAD-ZERO" ;
    f5rh:title "Zero-day retention" ;
    f5rh:appliesToStorageClass f5rh:ObjectEvidence ;
    f5rh:retentionDays "0"^^xsd:integer ;
    f5rh:immutableCapable true ;
    f5rh:evidenceRequired true ;
    f5rh:directActuation false .
