---
to: "infrastructure/data/object-storage/retention_contract.ttl"
force: true
sparql:
  programs: |
    PREFIX f5rh: <http://seanchatmangpt.github.io/packs/fortune5-retention-legal-hold#>
    SELECT ?programId ?catalogGroup ?catalogVersion ?catalogPackId ?directActuation
    WHERE {
      ?p a f5rh:RetentionProgram ;
         f5rh:programId ?programId ;
         f5rh:catalogGroup ?catalogGroup ;
         f5rh:catalogVersion ?catalogVersion ;
         f5rh:catalogPackId ?catalogPackId ;
         f5rh:directActuation ?directActuation .
    }
    ORDER BY ?programId
  schedules: |
    PREFIX f5rh: <http://seanchatmangpt.github.io/packs/fortune5-retention-legal-hold#>
    SELECT ?scheduleId ?title ?storageClassId ?retentionDays ?immutable
           ?evidence ?directActuation
    WHERE {
      ?s a f5rh:RetentionSchedule ;
         f5rh:scheduleId ?scheduleId ;
         f5rh:title ?title ;
         f5rh:appliesToStorageClass ?sc ;
         f5rh:retentionDays ?retentionDays ;
         f5rh:immutableCapable ?immutable ;
         f5rh:evidenceRequired ?evidence ;
         f5rh:directActuation ?directActuation .
      ?sc f5rh:storageClassId ?storageClassId .
    }
    ORDER BY ?scheduleId
  holds: |
    PREFIX f5rh: <http://seanchatmangpt.github.io/packs/fortune5-retention-legal-hold#>
    SELECT ?holdId ?title ?matterId ?objectId ?storageClassId
           ?blocksDelete ?blocksExport ?evidence ?directActuation
    WHERE {
      ?h a f5rh:LegalHold ;
         f5rh:holdId ?holdId ;
         f5rh:title ?title ;
         f5rh:matterId ?matterId ;
         f5rh:holdsObject ?obj ;
         f5rh:blocksDelete ?blocksDelete ;
         f5rh:blocksExport ?blocksExport ;
         f5rh:evidenceRequired ?evidence ;
         f5rh:directActuation ?directActuation .
      ?obj f5rh:objectId ?objectId ;
          f5rh:appliesToStorageClass ?sc .
      ?sc f5rh:storageClassId ?storageClassId .
    }
    ORDER BY ?holdId
---
# GENERATED by ggen sync from fortune5-retention-legal-hold-pack — do not edit by hand.
# Flattened projection of admitted retention/hold facts (broker-only; no secrets).
@prefix f5rh: <http://seanchatmangpt.github.io/packs/fortune5-retention-legal-hold#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

{% for row in schedules -%}
f5rh:proj-sc-{{ row.storageClassId }} a f5rh:StorageClass ;
    f5rh:storageClassId "{{ row.storageClassId }}" .

f5rh:proj-schedule-{{ row.scheduleId }} a f5rh:RetentionSchedule ;
    f5rh:scheduleId "{{ row.scheduleId }}" ;
    f5rh:title "{{ row.title }}" ;
    f5rh:appliesToStorageClass f5rh:proj-sc-{{ row.storageClassId }} ;
    f5rh:retentionDays "{{ row.retentionDays }}"^^xsd:integer ;
    f5rh:immutableCapable {{ row.immutable }} ;
    f5rh:evidenceRequired {{ row.evidence }} ;
    f5rh:directActuation {{ row.directActuation }} .
{% endfor %}

{% for row in holds -%}
f5rh:proj-sc-{{ row.storageClassId }} a f5rh:StorageClass ;
    f5rh:storageClassId "{{ row.storageClassId }}" .

f5rh:proj-obj-{{ row.objectId }} a f5rh:HeldObject ;
    f5rh:objectId "{{ row.objectId }}" ;
    f5rh:appliesToStorageClass f5rh:proj-sc-{{ row.storageClassId }} .

f5rh:proj-hold-{{ row.holdId }} a f5rh:LegalHold ;
    f5rh:holdId "{{ row.holdId }}" ;
    f5rh:title "{{ row.title }}" ;
    f5rh:matterId "{{ row.matterId }}" ;
    f5rh:holdsObject f5rh:proj-obj-{{ row.objectId }} ;
    f5rh:blocksDelete {{ row.blocksDelete }} ;
    f5rh:blocksExport {{ row.blocksExport }} ;
    f5rh:evidenceRequired {{ row.evidence }} ;
    f5rh:directActuation {{ row.directActuation }} .
{% endfor %}

{% for row in programs -%}
f5rh:proj-program-{{ row.programId }} a f5rh:RetentionProgram ;
    f5rh:programId "{{ row.programId }}" ;
    f5rh:catalogGroup "{{ row.catalogGroup }}" ;
    f5rh:catalogVersion "{{ row.catalogVersion }}" ;
    f5rh:catalogPackId "{{ row.catalogPackId }}" ;
    f5rh:directActuation {{ row.directActuation }} .
{% endfor %}
