PREFIX alloc: <https://ggen.dev/ontology/cell3-allocation#>
SELECT ?a ?b WHERE { ?a a alloc:FanoutTarget ; alloc:standing "COMPATIBLE_READY" . ?b a alloc:FanoutTarget ; alloc:standing "COMPATIBLE_READY" . FILTER(?a != ?b) FILTER NOT EXISTS { ?a alloc:dependsOn ?b } FILTER NOT EXISTS { ?b alloc:dependsOn ?a } }
