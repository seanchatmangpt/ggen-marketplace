PREFIX alloc: <https://ggen.dev/ontology/cell3-allocation#>
SELECT ?candidate WHERE { ?candidate a alloc:FanoutTarget ; alloc:standing "COMPATIBLE_READY" . FILTER NOT EXISTS { ?other a alloc:FanoutTarget ; alloc:standing "COMPATIBLE_READY" . FILTER(?other != ?candidate) ?other alloc:dependsOn ?candidate } }
