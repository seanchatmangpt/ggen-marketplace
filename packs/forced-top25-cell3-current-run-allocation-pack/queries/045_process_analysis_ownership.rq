PREFIX alloc: <https://ggen.dev/ontology/cell3-allocation#>
SELECT ?event WHERE { ?event a alloc:ManufacturingEvent ; alloc:standing ?s . FILTER(CONTAINS(LCASE(STR(?s)), "fitness") || CONTAINS(LCASE(STR(?s)), "precision") || CONTAINS(LCASE(STR(?s)), "conformance")) FILTER NOT EXISTS { ?event <http://purl.org/dc/terms/creator> "wasm4pm" } }
