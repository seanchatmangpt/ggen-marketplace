@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# Vocabulary for an Ash + AshA2A application. Consumers describe their app in
# Turtle with these terms; templates/ project domain, resources, skills, agent.
#
# MERGED (ERRC E1): this file is the single declaration site for every aap: term used by
# templates/, gates/ and fixtures/. ontology.d/L*.ttl are retained read-only as lane sources;
# every term below is declared exactly once here. Terms that two lanes used with different
# kinds (object vs datatype) are declared rdf:Property (kind-neutral) and the dual use is
# documented on the term. See fragments/ERRC-E1-ontology.md for the conflict register.

# =====================================================================================
# 0. Core / legacy (resource.ex.tmpl, domain.ex.tmpl, agent.ex.tmpl, mix/config templates)
# =====================================================================================
aap:Domain   a owl:Class ; rdfs:comment "An Ash.Domain using the AshA2A extension." .
aap:Resource a owl:Class ; rdfs:comment "An Ash.Resource using the AshA2A extension." .
aap:Attribute a owl:Class ; rdfs:comment "Legacy simple attribute (aap:attribute edge, aap:name/aap:ashType/aap:primaryKey). Full-fidelity attributes are aap:AttributeSpec (L01)." .
aap:Action   a owl:Class ; rdfs:comment "Legacy simple action (aap:action edge). L06 fragment actions are aap:L06Action; L02 manage actions are aap:RelManage." .
aap:Skill    a owl:Class ; rdfs:comment "An explicit a2a skill override on a resource action. Full-option skills are aap:SkillSpec (L17); a name may not appear on both." .
aap:Agent    a owl:Class ; rdfs:comment "An AshA2A.Agent wrapping a domain." .
aap:Project  a owl:Class ; rdfs:comment "Application-level node: mix project, config, supervision-level facts." .

aap:moduleName a owl:DatatypeProperty .
aap:inDomain   a owl:ObjectProperty .
aap:ofResource a owl:ObjectProperty .
aap:name       a owl:DatatypeProperty .
aap:ashType    a owl:DatatypeProperty .
aap:primaryKey a owl:DatatypeProperty .
aap:actionType a owl:DatatypeProperty ; rdfs:comment "read|create|update|destroy (generic actions: L06 uses action)" .
aap:consequence a owl:DatatypeProperty ; rdfs:comment "observe|propose|commit..." .
aap:description a owl:DatatypeProperty .
aap:forDomain  a owl:ObjectProperty .
aap:agentName  a owl:DatatypeProperty .
aap:appPath    a owl:DatatypeProperty ; rdfs:comment "lib/<appPath>/ directory for generated files" .
aap:domainFile a owl:DatatypeProperty .
aap:resourceFile a owl:DatatypeProperty .
aap:agentFile  a owl:DatatypeProperty .
aap:attribute  a owl:ObjectProperty ; rdfs:comment "Resource -> legacy aap:Attribute (disjoint from L01 aap:attrSpec)." .
aap:action     a owl:ObjectProperty ; rdfs:comment "Resource -> legacy aap:Action (disjoint from L06 aap:l06Action, L02 aap:manage, L15 aap:reactorAction)." .
aap:skill      a owl:ObjectProperty ; rdfs:comment "Resource -> aap:Skill." .
aap:ofAction   a owl:DatatypeProperty ; rdfs:comment "Action name a skill / code interface targets (literal)." .
aap:appName    a owl:DatatypeProperty .
aap:appModule  a owl:DatatypeProperty .
aap:ashA2aDep  a owl:DatatypeProperty ; rdfs:comment "Elixir term for the ash_a2a dep requirement/opts" .
aap:ashPPlanDep a owl:DatatypeProperty ; rdfs:domain aap:Project ;
  rdfs:comment "Raw Elixir ash_pplan dep requirement/opts, e.g. path: \"/Users/sac/ash_pplan\" or \"~> 26.10\"; mix.exs.tmpl OPTIONAL, default \"~> 26.10\" (declared by E1; was undeclared)." .
aap:securityProfile a owl:DatatypeProperty ; rdfs:domain aap:Project ;
  rdfs:comment "Security profile applied by config.exs.tmpl in every environment, OPTIONAL (declared by E1; was undeclared)." .
aap:accept        a owl:DatatypeProperty ; rdfs:comment "comma-separated accepted attribute names (create/update)" .
aap:leaseRequired a owl:DatatypeProperty .

# =====================================================================================
# L01 attributes (aap:attrSpec; Spark fragment per resource)
# DSL grammar: deps/ash/lib/ash/resource/attribute.ex:70-175, dsl.ex:36-186, type/enum.ex:73-80
# =====================================================================================
aap:AttributeSpec a owl:Class ;
  rdfs:comment "A full-fidelity Ash attribute (any kind, type, constraint, default)." .
aap:EnumType a owl:Class ; rdfs:comment "An Ash.Type.Enum module." .
aap:EnumValue a owl:Class .

aap:attrSpec a owl:ObjectProperty ; rdfs:domain aap:Resource ; rdfs:range aap:AttributeSpec .
aap:attrKind a owl:DatatypeProperty ;
  rdfs:comment "attribute|create_timestamp|update_timestamp|uuid_primary_key|uuid_v7_primary_key|integer_primary_key (dsl.ex:36-186). Non-attribute kinds accept only aap:name (attribute.ex hide_all_except [:name])." .
aap:attrOrder a owl:DatatypeProperty ; rdfs:comment "integer; declaration order (composite PK order matters)." .
aap:ashTypeModule a owl:DatatypeProperty ; rdfs:comment "Elixir module type, e.g. Ash.Type.CiString, MyApp.Status." .
aap:ashTypeEnum a owl:ObjectProperty ; rdfs:range aap:EnumType ; rdfs:comment "type is this enum module." .
aap:arrayOf a owl:DatatypeProperty ; rdfs:comment "element type atom => {:array, :atom}. Put items: [...] in aap:constraints." .
aap:arrayOfModule a owl:DatatypeProperty ; rdfs:comment "element type module => {:array, Module}." .
aap:arrayOfEnum a owl:ObjectProperty ; rdfs:range aap:EnumType .
aap:constraints a owl:DatatypeProperty ; rdfs:comment "Elixir keyword-list text, e.g. max_length: 80, allow_empty?: false (L01 attribute.ex:75; L03 calc :43 / arg :51; L17 gate L17_113 scans it)." .
aap:allowNil a owl:DatatypeProperty ; rdfs:comment "true|false -> allow_nil? (L01 attribute.ex:119; L02 belongs_to/has_one; L03 calc :93 / arg :41; L12 field/attribute)." .
aap:public a owl:DatatypeProperty ; rdfs:comment "true|false -> public? (L01 attribute default true; L03 calculation)." .
aap:sensitive a owl:DatatypeProperty ; rdfs:comment "true|false -> sensitive? (L01 attribute.ex:85; L03 calculation.ex:66)" .
aap:generated a owl:DatatypeProperty ; rdfs:comment "true|false (attribute.ex:126)" .
aap:writable a owl:DatatypeProperty ; rdfs:comment "true|false (attribute.ex:133)" .
aap:isPrimaryKey a owl:DatatypeProperty ; rdfs:comment "true|false primary_key? (attribute.ex:112)" .
aap:defaultExpr a owl:DatatypeProperty ; rdfs:comment "raw Elixir term or capture, e.g. :open, \"x\", &DateTime.utc_now/0 (attribute.ex:147)" .
aap:updateDefaultExpr a owl:DatatypeProperty ; rdfs:comment "raw Elixir term/capture (attribute.ex:153)" .
aap:sourceColumn a owl:DatatypeProperty ; rdfs:comment "source: atom name (attribute.ex:92)" .
aap:selectByDefault a owl:DatatypeProperty ; rdfs:comment "true|false (attribute.ex:98)" .
aap:alwaysSelect a owl:DatatypeProperty ; rdfs:comment "true|false (attribute.ex:105)" .
aap:filterable a owl:DatatypeProperty ; rdfs:comment "true|false|simple_equality (L01 attribute.ex:157; L03 calculation.ex:102)" .
aap:sortable a owl:DatatypeProperty ; rdfs:comment "true|false (L01 attribute.ex:164; L03 calculation.ex:107)" .
aap:matchOtherDefaults a owl:DatatypeProperty ; rdfs:comment "true|false (attribute.ex:171)" .
aap:enumFile a owl:DatatypeProperty ; rdfs:comment "file stem under lib/<appPath>/ for the enum module" .
aap:label a owl:DatatypeProperty ; rdfs:comment "enum value label (enum.ex:78)" .
aap:order a owl:DatatypeProperty ; rdfs:comment "integer ordering for enum values" .

# DUAL USE (E1): L01 links an EnumType to aap:EnumValue nodes (object); L12 gives an
# aap:CustomType (typeKind enum) literal atom names. Kind-neutral rdf:Property.
aap:enumValue a rdf:Property ;
  rdfs:comment "L01: aap:EnumType -> aap:EnumValue node (carries aap:name/aap:label/aap:order/aap:description). L12: aap:CustomType (typeKind enum) -> atom-name literal, repeatable." .

# =====================================================================================
# L02 relationships. DSL: dsl.ex:237 has_one, :269 has_many, :301 many_to_many, :336 belongs_to
# =====================================================================================
aap:Relationship a owl:Class ;
  rdfs:comment "A relationship declared on an aap:Resource. L02 nodes use aap:name/aap:relKind/aap:destination (any kind); L08 nodes (belongs_to tenant owner) use aap:relName/aap:relDestination/aap:relSourceAttribute." .
aap:RelManage    a owl:Class ; rdfs:comment "A generated action that manages one relationship via an argument." .

aap:relationship a owl:ObjectProperty ; rdfs:domain aap:Resource ; rdfs:range aap:Relationship ;
  rdfs:comment "Resource -> relationship node with aap:name and aap:destination (L02/L04) or aap:relName (L08)." .
aap:manage       a owl:ObjectProperty ; rdfs:domain aap:Resource ; rdfs:range aap:RelManage .

aap:relKind     a owl:DatatypeProperty ; rdfs:comment "belongs_to | has_one | has_many | many_to_many" .
aap:destination a owl:ObjectProperty ; rdfs:comment "Destination aap:Resource (args: [:name, :destination]); also relationship node -> destination aap:Resource for L04 path gates." .
aap:through     a owl:ObjectProperty ; rdfs:comment "Join aap:Resource for many_to_many (many_to_many.ex:85)." .
aap:throughPath a owl:DatatypeProperty ; rdfs:comment "Elixir list for has_many/has_one through (has_many.ex:84)." .
aap:sourceAttribute a owl:DatatypeProperty ; rdfs:comment "shared_options.ex:32" .
aap:destinationAttribute a owl:DatatypeProperty ; rdfs:comment "shared_options.ex:21" .
aap:sourceAttributeOnJoin a owl:DatatypeProperty ; rdfs:comment "many_to_many.ex:75" .
aap:destinationAttributeOnJoin a owl:DatatypeProperty ; rdfs:comment "many_to_many.ex:80" .
aap:joinRelationship a owl:DatatypeProperty ; rdfs:comment "many_to_many.ex:89" .
aap:relPrimaryKey a owl:DatatypeProperty ; rdfs:comment "belongs_to primary_key? (belongs_to.ex:84)" .
aap:defineAttribute a owl:DatatypeProperty ; rdfs:comment "belongs_to define_attribute? (belongs_to.ex:115)" .
aap:attributeType a owl:DatatypeProperty ; rdfs:comment "belongs_to attribute_type, Elixir term (belongs_to.ex:121)" .
aap:relPublic   a owl:DatatypeProperty ; rdfs:comment "public? (L02 shared_options.ex:44); L08: attribute_public? true|false" .
aap:relWritable a owl:DatatypeProperty ; rdfs:comment "shared_options.ex:57" .
aap:noAttributes a owl:DatatypeProperty ; rdfs:comment "shared_options.ex:155" .
aap:relSort     a owl:DatatypeProperty ; rdfs:comment "Elixir sort term (shared_options.ex:95)" .
aap:relFilter   a owl:DatatypeProperty ; rdfs:comment "Elixir expression body, multi-valued; each emits `filter expr(..)` (dsl.ex:11)" .
aap:relReadAction a owl:DatatypeProperty ; rdfs:comment "shared_options.ex:64" .
aap:inverse     a owl:ObjectProperty ; rdfs:comment "The aap:Relationship on the destination resource that points back." .
aap:noInverse   a owl:DatatypeProperty ; rdfs:comment "true waives the missing-inverse gate." .

# manage_relationship action
aap:argumentName a owl:DatatypeProperty .
aap:argumentType a owl:DatatypeProperty ; rdfs:comment "Elixir type term; default :map / {:array, :map}" .
aap:manageType  a owl:DatatypeProperty ; rdfs:comment "append|append_and_remove|remove|direct_control|create" .
aap:onLookup    a owl:DatatypeProperty .
aap:onNoMatch   a owl:DatatypeProperty .
aap:onMatch     a owl:DatatypeProperty .
aap:onMissing   a owl:DatatypeProperty .
aap:useIdentities a owl:DatatypeProperty ; rdfs:comment "Elixir list e.g. [:_primary_key]" .

# DUAL USE (E1): L02 RelManage -> aap:Relationship node (object); L09 aap:Reference carries the
# relationship name as a literal. Kind-neutral rdf:Property.
aap:ofRelationship a rdf:Property ;
  rdfs:comment "L02: aap:RelManage -> aap:Relationship node. L09: aap:Reference -> relationship name literal." .

# =====================================================================================
# L03 calculations. calculation.ex:28-130, argument.ex:25-57, dsl.ex:1715-1785
# =====================================================================================
aap:Calculation         a owl:Class ; rdfs:comment "An Ash calculation (calculations do calculate ... end)." .
aap:CalculationArgument a owl:Class ; rdfs:comment "An argument of a calculation (argument.ex:25)." .

aap:calcArgument  a owl:ObjectProperty ; rdfs:comment "Calculation -> aap:CalculationArgument." .
aap:calcKind      a owl:DatatypeProperty ; rdfs:comment "expr | concat | module. expr: aap:expression; concat: builtin Ash.Resource.Calculation.Concat with aap:calcKeys/aap:separator; module: generated coalesce module aap:calcModule over aap:calcKeys." .
aap:expression    a owl:DatatypeProperty ; rdfs:comment "Elixir expression text placed inside expr(...) (kind expr)." .
aap:calcKeys      a owl:DatatypeProperty ; rdfs:comment "comma-separated attribute names (concat/module kinds)." .
aap:separator     a owl:DatatypeProperty ; rdfs:comment "concat separator string." .
aap:calcModule    a owl:DatatypeProperty ; rdfs:comment "Module name of generated calculation (kind module)." .
aap:calcFile      a owl:DatatypeProperty ; rdfs:comment "File stem under lib/<appPath>/calculations/ (kind module)." .
aap:load          a owl:DatatypeProperty ; rdfs:comment "comma-separated attribute/calculation names for load: (calculation.ex:87)." .
aap:allowExpr     a owl:DatatypeProperty ; rdfs:comment "argument allow_expr? (argument.ex:46)." .
aap:default       a owl:DatatypeProperty ; rdfs:comment "Elixir literal text for argument default (argument.ex:36)." .
aap:argOrder      a owl:DatatypeProperty ; rdfs:comment "integer sort key for arguments (L03 calculation arguments; L15 reactor bindings)." .

# DUAL USE (E1): L03 Resource -> aap:Calculation node (object); L10 aap:CalculationInterface
# names the calculation as a literal. Kind-neutral rdf:Property.
aap:calculation a rdf:Property ;
  rdfs:comment "L03: aap:Resource -> aap:Calculation node. L10: aap:CalculationInterface -> calculation name literal (define_calculation)." .

# =====================================================================================
# L04 aggregates. dsl.ex @count:1377 ... @custom:1578 @list:1618 @join_filter:1353; aggregate.ex:39-125
# (L04's minimal aap:relationship / aap:destination declarations are subsumed by L02 above.)
# =====================================================================================
aap:Aggregate a owl:Class ; rdfs:comment "A named Ash aggregate (aggregates do ... end)." .
aap:AggregateJoinFilter a owl:Class ; rdfs:comment "join_filter relationship_path, filter inside an aggregate (dsl.ex:1353)." .

aap:aggregate a owl:ObjectProperty ; rdfs:comment "Resource -> Aggregate." .
aap:aggJoinFilter a owl:ObjectProperty ; rdfs:comment "Aggregate -> AggregateJoinFilter." .
aap:aggKind a owl:DatatypeProperty ; rdfs:comment "count|exists|first|sum|min|max|avg|list|custom (aggregate.ex:61)" .
aap:aggPath a owl:DatatypeProperty ; rdfs:comment "comma-separated relationship path, no whitespace, e.g. comments,author (aggregate.ex:51)" .
aap:aggResource a owl:DatatypeProperty ; rdfs:comment "resource-based aggregate: module name (aggregate.ex:158)" .
aap:aggField a owl:DatatypeProperty ; rdfs:comment "aggregate.ex:67" .
aap:aggType a owl:DatatypeProperty ; rdfs:comment "custom only: type module (dsl.ex:1604)" .
aap:aggImplementation a owl:DatatypeProperty ; rdfs:comment "custom only: raw Elixir term (dsl.ex:1609)" .
aap:aggFilter a owl:DatatypeProperty ; rdfs:comment "raw Elixir: [active: true] or expr(...) (aggregate.ex:73)" .
aap:aggSort a owl:DatatypeProperty ; rdfs:comment "raw Elixir sort (aggregate.ex:78); first/list/custom only" .
aap:aggDefault a owl:DatatypeProperty ; rdfs:comment "raw Elixir default (aggregate.ex:86)" .
aap:aggDescription a owl:DatatypeProperty ; rdfs:comment "aggregate.ex:82" .
aap:aggPublic a owl:DatatypeProperty ; rdfs:comment "true|false (aggregate.ex:90)" .
aap:aggUniq a owl:DatatypeProperty ; rdfs:comment "true|false; count/list only (dsl.ex:1406,1642)" .
aap:aggIncludeNil a owl:DatatypeProperty ; rdfs:comment "true|false; first/list only (dsl.ex:1439,1647)" .
aap:aggReadAction a owl:DatatypeProperty ; rdfs:comment "aggregate.ex:45" .
aap:aggFilterable a owl:DatatypeProperty ; rdfs:comment "true|false|simple_equality (aggregate.ex:95)" .
aap:aggSortable a owl:DatatypeProperty ; rdfs:comment "true|false (aggregate.ex:100)" .
aap:aggSensitive a owl:DatatypeProperty ; rdfs:comment "true|false (aggregate.ex:105)" .
aap:aggAuthorize a owl:DatatypeProperty ; rdfs:comment "true|false (aggregate.ex:110)" .
aap:aggMultitenancy a owl:DatatypeProperty ; rdfs:comment "bypass (aggregate.ex:117)" .

# =====================================================================================
# L05 identities + validations. identity.ex:32-94, validation.ex:145-186, validation/builtins.ex
# =====================================================================================
aap:Identity   a owl:Class ; rdfs:comment "An Ash identity (unique constraint) on a resource." .
aap:Validation a owl:Class ; rdfs:comment "A resource-level Ash validation; action-scoped via aap:forAction." .

aap:identity   a owl:ObjectProperty ; rdfs:comment "Resource -> Identity." .
aap:validation a owl:ObjectProperty ; rdfs:comment "Resource -> Validation." .

aap:identityKey    a owl:DatatypeProperty ; rdfs:comment "Repeatable: one attribute name per triple. Must name an aap:attribute of the resource." .
aap:eagerCheck     a owl:DatatypeProperty ; rdfs:comment "true|false -> eager_check?" .
aap:eagerCheckWith a owl:DatatypeProperty ; rdfs:comment "Domain module -> eager_check_with" .
aap:preCheck       a owl:DatatypeProperty ; rdfs:comment "true|false -> pre_check?" .
aap:preCheckWith   a owl:DatatypeProperty ; rdfs:comment "Domain module -> pre_check_with" .
aap:nilsDistinct   a owl:DatatypeProperty ; rdfs:comment "true|false -> nils_distinct?" .
aap:allTenants     a owl:DatatypeProperty ; rdfs:comment "true|false -> all_tenants?" .
aap:fieldNames     a owl:DatatypeProperty ; rdfs:comment "comma-separated atoms -> field_names" .
aap:identityWhere  a owl:DatatypeProperty ; rdfs:comment "Raw Elixir expression, e.g. expr(is_nil(archived_at)) -> where" .

aap:validationKind a owl:DatatypeProperty ;
  rdfs:comment "present|absent|attributes_present|attributes_absent|match|compare|numericality|one_of|string_length|attribute_equals|attribute_does_not_equal|attribute_in|argument_equals|argument_does_not_equal|argument_in|confirm|changing|raw" .
aap:vAttribute  a owl:DatatypeProperty ; rdfs:comment "Repeatable attribute/argument name. Single-target kinds take exactly one." .
aap:vValue      a owl:DatatypeProperty ; rdfs:comment "Raw Elixir second argument (regex sigil, list, atom, literal); for kind raw, the whole validation expression." .
aap:vOpts       a owl:DatatypeProperty ; rdfs:comment "Raw Elixir keyword opts for the builtin, e.g. min: 3, max: 120" .
aap:on          a owl:DatatypeProperty ; rdfs:comment "comma-separated create|update|destroy -> on:" .
aap:where       a owl:DatatypeProperty ; rdfs:comment "';'-separated raw where-validations, e.g. attribute_equals(:a, 1); present(:b)" .
aap:forAction   a owl:DatatypeProperty ; rdfs:comment "Action name; adds action_is(:name) to where (action-level validation)." .
aap:message     a owl:DatatypeProperty ; rdfs:comment "Error message (no double quotes; see gate L05_message_quotes)." .
aap:onlyWhenValid a owl:DatatypeProperty .
aap:beforeAction  a owl:DatatypeProperty .
aap:alwaysAtomic  a owl:DatatypeProperty .

# =====================================================================================
# L06 changes, preparations, action arguments, generic actions.
# L06 actions are SEPARATE entities from aap:action (they live in a Spark fragment module).
# =====================================================================================
aap:L06Action   a owl:Class ; rdfs:comment "Action emitted in the L06 fragment (create|update|destroy|read|action)." .
aap:L06Argument a owl:Class ; rdfs:comment "argument :name, :type inside an L06 action." .
aap:L06Step     a owl:Class ; rdfs:comment "One change or prepare entry in an L06 action." .
aap:L06Hook     a owl:Class ; rdfs:comment "Generated Ash.Resource.Change / Preparation module wrapping a hook body." .
aap:L06Run      a owl:Class ; rdfs:comment "Generated Ash.Resource.Actions.Implementation for a generic action." .

aap:l06Action   a owl:ObjectProperty ; rdfs:comment "Resource -> L06Action." .
aap:l06Argument a owl:ObjectProperty ; rdfs:comment "L06Action -> L06Argument." .
aap:l06Step     a owl:ObjectProperty ; rdfs:comment "L06Action -> L06Step." .

aap:l06Primary       a owl:DatatypeProperty ; rdfs:comment "primary? true|false" .
aap:l06Transaction   a owl:DatatypeProperty ; rdfs:comment "transaction? true|false" .
aap:l06RequireAtomic a owl:DatatypeProperty ; rdfs:comment "require_atomic? true|false (update/destroy)" .
aap:l06AtomicUpgrade a owl:DatatypeProperty ; rdfs:comment "atomic_upgrade? true|false (update)" .
aap:l06Public        a owl:DatatypeProperty ; rdfs:comment "public? true|false" .
aap:l06Description   a owl:DatatypeProperty .
aap:l06Returns       a owl:DatatypeProperty ; rdfs:comment "generic action returns type, e.g. string" .
aap:l06Constraints   a owl:DatatypeProperty ; rdfs:comment "Elixir keyword literal for returns constraints" .
aap:l06AllowNil      a owl:DatatypeProperty ; rdfs:comment "generic action allow_nil? (default false in Ash)" .
aap:l06RunModule     a owl:DatatypeProperty ; rdfs:comment "moduleName of an aap:L06Run implementation" .

aap:l06ArgAllowNil a owl:DatatypeProperty .
aap:l06ArgDefault  a owl:DatatypeProperty ; rdfs:comment "Elixir literal" .
aap:l06ArgPublic   a owl:DatatypeProperty .
aap:l06ArgConstraints a owl:DatatypeProperty ; rdfs:comment "Elixir keyword literal" .

aap:l06Kind    a owl:DatatypeProperty ; rdfs:comment "change | prepare" .
aap:l06Op      a owl:DatatypeProperty ; rdfs:comment "change: set_attribute|set_new_attribute|atomic_update|atomic_set|increment|manage_relationship|module ; prepare: build|filter|sort|limit|module" .
aap:l06Order   a owl:DatatypeProperty ; rdfs:comment "xsd:integer, step order inside the action" .
aap:l06Attr    a owl:DatatypeProperty ; rdfs:comment "attribute (or argument for manage_relationship)" .
aap:l06Rel     a owl:DatatypeProperty ; rdfs:comment "relationship name for manage_relationship" .
aap:l06Value   a owl:DatatypeProperty ; rdfs:comment "Elixir term / expr text / build keyword literal" .
aap:l06Opts    a owl:DatatypeProperty ; rdfs:comment "trailing Elixir keyword literal, e.g. type: :append" .
aap:l06Module  a owl:DatatypeProperty ; rdfs:comment "module name used when op = module" .
aap:l06Where   a owl:DatatypeProperty ; rdfs:comment "Elixir text for where: option on the change/prepare" .
aap:l06On      a owl:DatatypeProperty ; rdfs:comment "Elixir list text for on: option, e.g. [:create]" .
aap:l06OnlyWhenValid a owl:DatatypeProperty .

aap:l06HookResource a owl:ObjectProperty ; rdfs:comment "L06Hook -> Resource (for appPath resolution)" .
aap:l06HookKind     a owl:DatatypeProperty ; rdfs:comment "before_action|after_action|before_transaction|after_transaction|prepare" .
aap:l06HookBody     a owl:DatatypeProperty ; rdfs:comment "Elixir body. before_action/before_transaction: vars changeset; after_action: changeset, record -> {:ok, record}; after_transaction: changeset, result; prepare: query, opts, context" .
aap:l06HookFile     a owl:DatatypeProperty ; rdfs:comment "file stem under lib/<appPath>/" .

aap:l06RunResource a owl:ObjectProperty .
aap:l06RunBody     a owl:DatatypeProperty ; rdfs:comment "Elixir body; vars input, opts, context; returns {:ok, v} | :ok | {:error, e}" .
aap:l06RunFile     a owl:DatatypeProperty .

# =====================================================================================
# L07 Ash.Policy.Authorizer. authorizer.ex policy/bypass :140-219, policy_group :221-276,
# field_policy :339-381; checks built_in_checks.ex
# =====================================================================================
aap:Policy       a owl:Class ; rdfs:comment "policy / bypass entity in policies do ... end" .
aap:PolicyGroup  a owl:Class ; rdfs:comment "policy_group <condition> do ... end" .
aap:PolicyCheck  a owl:Class ; rdfs:comment "authorize_if|forbid_if|authorize_unless|forbid_unless <check>" .
aap:FieldPolicy  a owl:Class ; rdfs:comment "field_policy / field_policy_bypass" .

aap:policy       a owl:ObjectProperty ; rdfs:comment "Resource -> Policy" .
aap:policyGroup  a owl:ObjectProperty ; rdfs:comment "Resource -> PolicyGroup" .
aap:fieldPolicy  a owl:ObjectProperty ; rdfs:comment "Resource -> FieldPolicy" .
aap:inGroup      a owl:DatatypeProperty ; rdfs:comment "Policy -> group name (aap:name of a PolicyGroup on same resource)" .
aap:check        a owl:ObjectProperty ; rdfs:comment "Policy|FieldPolicy -> PolicyCheck" .

aap:defaultAccessType a owl:DatatypeProperty ; rdfs:comment "Resource: strict|filter|runtime (default :filter)" .
aap:accessType        a owl:DatatypeProperty ; rdfs:comment "Policy: strict|filter|runtime" .
aap:bypass            a owl:DatatypeProperty ; rdfs:comment "Policy/FieldPolicy: true => bypass / field_policy_bypass" .
aap:policyOrder       a owl:DatatypeProperty ; rdfs:comment "integer, source order within resource (policies order matters)" .
aap:errorMessage      a owl:DatatypeProperty ; rdfs:comment "Policy error_message string" .

aap:condKind a owl:DatatypeProperty ; rdfs:comment "always | actor_present | action_type | action | actor_attribute_equals | accessing_from | relates_to_actor_via | expr" .
aap:condArg  a owl:DatatypeProperty ; rdfs:comment "atom name (action_type/action/relates_to_actor_via, comma = path), attribute, module, or raw expr text" .
aap:condArg2 a owl:DatatypeProperty ; rdfs:comment "second arg: actor_attribute_equals value (raw Elixir term) / accessing_from relationship atom" .

aap:checkType a owl:DatatypeProperty ; rdfs:comment "authorize_if|forbid_if|authorize_unless|forbid_unless" .
aap:checkKind a owl:DatatypeProperty ; rdfs:comment "same kinds as condKind" .
aap:checkArg  a owl:DatatypeProperty .
aap:checkArg2 a owl:DatatypeProperty .
aap:checkOrder a owl:DatatypeProperty ; rdfs:comment "integer, order within its policy" .

aap:fields a owl:DatatypeProperty ; rdfs:comment "comma-separated field names, or * (no spaces)" .
aap:fieldPrivateFields a owl:DatatypeProperty ; rdfs:comment "Resource: show|hide|include (field_policies private_fields)" .

# =====================================================================================
# L08 multitenancy + domain mounts + tenant task store. dsl.ex:1787-1841
# =====================================================================================
aap:Multitenancy a owl:Class ; rdfs:comment "Ash multitenancy section of a resource (dsl.ex:1787)." .
aap:TenantTaskStore a owl:Class ;
  rdfs:comment "Per-tenant namespaced AshA2A.TaskStore.Ash wrapper (closes tenancy gap)." .

aap:multitenancy a owl:ObjectProperty ; rdfs:domain aap:Resource ; rdfs:range aap:Multitenancy .
aap:tenantStrategy a owl:DatatypeProperty ; rdfs:comment "attribute|context (dsl.ex:1808)" .
aap:tenantAttribute a owl:DatatypeProperty ; rdfs:comment "attribute name for strategy attribute (dsl.ex:1815)" .
aap:tenantGlobal a owl:DatatypeProperty ; rdfs:comment "true|false (dsl.ex:1821)" .
aap:parseAttribute a owl:DatatypeProperty ; rdfs:comment "Elixir mfa literal, e.g. {MyApp.Tenant, :to_attr, []} (dsl.ex:1828)" .
aap:tenantFromAttribute a owl:DatatypeProperty ; rdfs:comment "Elixir mfa literal, inverse of parseAttribute (dsl.ex:1834)" .

# belongs_to tenant-owner relationship nodes (parallel to L02 name/destination vocabulary)
aap:relName a owl:DatatypeProperty .
aap:relDestination a owl:DatatypeProperty ; rdfs:comment "destination module name" .
aap:relSourceAttribute a owl:DatatypeProperty ; rdfs:comment "foreign-key attribute name" .
aap:relAttributeType a owl:DatatypeProperty ; rdfs:comment "ash type of the FK, default uuid" .
aap:relAllowNil a owl:DatatypeProperty ; rdfs:comment "true|false; tenant FKs must be false" .

aap:mountsTenantFor a owl:ObjectProperty ;
  rdfs:comment "Mount -> Resource whose tenant this mount id supplies (gate cross-check)." .

aap:taskStore a owl:ObjectProperty ; rdfs:domain aap:Project ; rdfs:range aap:TenantTaskStore .
aap:taskStoreModule a owl:DatatypeProperty .
aap:taskStoreFile a owl:DatatypeProperty .
aap:taskStoreAppPath a owl:DatatypeProperty .
aap:taskStoreNamespace a owl:DatatypeProperty ; rdfs:comment "base namespace; tenant is suffixed" .

# =====================================================================================
# L09 data layers. Resources without aap:dataLayer keep the template default (Ash.DataLayer.Ets).
# =====================================================================================
aap:Repo            a owl:Class ; rdfs:comment "An Ecto repo module (AshPostgres.Repo or AshSqlite.Repo)." .
aap:CustomIndex     a owl:Class ; rdfs:comment "postgres/sqlite custom_indexes entry." .
aap:Reference       a owl:Class ; rdfs:comment "postgres/sqlite references entry (FK behaviour)." .
aap:CheckConstraint a owl:Class ; rdfs:comment "postgres check_constraints entry." .
aap:Statement       a owl:Class ; rdfs:comment "postgres custom_statements entry (up/down SQL)." .

aap:dataLayer  a owl:DatatypeProperty ; rdfs:comment "ets|mnesia|simple|postgres|sqlite" .
aap:tableName  a owl:DatatypeProperty ; rdfs:comment "table (ets: atom name; postgres/sqlite: string; mnesia: atom)" .
aap:etsPrivate a owl:DatatypeProperty ; rdfs:comment "ets private? \"true\"|\"false\"" .
aap:repo       a owl:ObjectProperty   ; rdfs:comment "resource -> aap:Repo (postgres/sqlite)" .

aap:pgSchema        a owl:DatatypeProperty ; rdfs:comment "postgres schema \"...\"" .
aap:migrate         a owl:DatatypeProperty ; rdfs:comment "migrate? \"true\"|\"false\"" .
aap:baseFilterSql   a owl:DatatypeProperty ; rdfs:comment "base_filter_sql (must not contain the pipe char)" .
aap:skipUniqueIndexes a owl:DatatypeProperty ; rdfs:comment "postgres skip_unique_indexes: \"true\" or comma list of identity names" .
aap:sqliteStrict    a owl:DatatypeProperty ; rdfs:comment "sqlite strict? \"true\"|\"false\"" .
aap:customIndex     a owl:ObjectProperty .
aap:reference       a owl:ObjectProperty .
aap:checkConstraint a owl:ObjectProperty .
aap:statement       a owl:ObjectProperty .

aap:indexFields   a owl:DatatypeProperty ; rdfs:comment "comma-separated attribute names or raw expressions" .
aap:indexName     a owl:DatatypeProperty .
aap:indexUnique   a owl:DatatypeProperty .
aap:indexUsing    a owl:DatatypeProperty ; rdfs:comment "btree|gin|gist|brin|hash" .
aap:indexWhere    a owl:DatatypeProperty .
aap:indexInclude  a owl:DatatypeProperty ; rdfs:comment "comma-separated attributes" .
aap:indexNullsDistinct a owl:DatatypeProperty .

aap:onDelete       a owl:DatatypeProperty ; rdfs:comment "nothing|restrict|delete|nilify" .
aap:onUpdate       a owl:DatatypeProperty ; rdfs:comment "nothing|restrict|update|nilify" .
aap:fkName         a owl:DatatypeProperty .
aap:deferrable     a owl:DatatypeProperty ; rdfs:comment "\"true\"|\"false\"|\"initially\"" .

aap:checkAttribute a owl:DatatypeProperty .
aap:checkName      a owl:DatatypeProperty .
aap:checkExpr      a owl:DatatypeProperty .
aap:checkMessage   a owl:DatatypeProperty .

aap:stmtUp   a owl:DatatypeProperty .
aap:stmtDown a owl:DatatypeProperty .

aap:repoKind     a owl:DatatypeProperty ; rdfs:comment "postgres|sqlite" .
aap:repoFile     a owl:DatatypeProperty .
aap:pgExtensions a owl:DatatypeProperty ; rdfs:comment "installed_extensions, comma list e.g. ash-functions,citext" .
aap:pgMinVersion a owl:DatatypeProperty ; rdfs:comment "min_pg_version, e.g. 16.0.0" .
aap:poolSize     a owl:DatatypeProperty .
aap:dbName       a owl:DatatypeProperty ; rdfs:comment "dev/test database name or sqlite file path" .
aap:dbUrlEnv     a owl:DatatypeProperty ; rdfs:comment "runtime env var holding the URL (default DATABASE_URL)" .

aap:setupAppPath a owl:DatatypeProperty ; rdfs:domain aap:Project ; rdfs:comment "lib/<setupAppPath>/ for data_layer_setup_l09.ex (Project-level; used by L09 repo/setup templates and gate L09_070)" .

# =====================================================================================
# L10 code interfaces, domain config. define: interface.ex:307-384; domain/dsl.ex
# =====================================================================================
aap:CodeInterface        a owl:Class ; rdfs:comment "A `define` entry (resource or domain level)." .
aap:CalculationInterface a owl:Class ; rdfs:comment "A `define_calculation` entry." .

