aap:obWorkerFile    a owl:DatatypeProperty .

# =====================================================================================
# L15 Reactor (reactor dsl.ex:19-55; ash/reactor dsl; generic action implementation.ex:5-60)
# =====================================================================================
aap:Reactor         a owl:Class ; rdfs:comment "A Reactor module (use Reactor, or use Ash.Reactor when aap:reactorAsh \"true\")." .
aap:ReactorInput    a owl:Class ; rdfs:comment "input :name (input.ex:52)." .
aap:ReactorStep     a owl:Class ; rdfs:comment "Any step-like entity; kind chosen by aap:stepKind." .
aap:ReactorBinding  a owl:Class ; rdfs:comment "A Reactor template: input(..)|result(..)|element(..)|value(..) (argument.ex:59-158). Used for argument, inputs, initial, actor, tenant, on, source." .
aap:ReactorBranch   a owl:Class ; rdfs:comment "A switch matches?/default branch (switch.ex:42-93)." .
aap:ReactorAction   a owl:Class ; rdfs:comment "A generic Ash action whose run is a Reactor (Ash.Resource.Actions.Implementation)." .
aap:ReactorActionArg a owl:Class ; rdfs:comment "argument of a ReactorAction." .

aap:reactor         a owl:ObjectProperty ; rdfs:comment "Domain -> aap:Reactor (supplies appPath via the domain)." .
aap:reactorFile     a owl:DatatypeProperty ; rdfs:comment "File stem under lib/<appPath>/reactors/." .
aap:reactorAsh      a owl:DatatypeProperty ; rdfs:comment "\"true\" => use Ash.Reactor, else use Reactor." .
aap:reactorReturn   a owl:ObjectProperty ; rdfs:comment "Reactor -> step; return :name (dsl.ex:23)." .
aap:reactorDescription a owl:DatatypeProperty ; rdfs:comment "reactor description (dsl.ex:30). No double quotes or backslashes." .
aap:reactorMiddleware a owl:DatatypeProperty ; rdfs:comment "Middleware module name; multi-valued (middleware.ex:30-40)." .
aap:reactorInput    a owl:ObjectProperty ; rdfs:comment "Reactor -> aap:ReactorInput." .
aap:reactorStep     a owl:ObjectProperty ; rdfs:comment "Reactor -> every step at any depth (nested steps additionally carry aap:stepParent)." .
aap:inputTransform  a owl:DatatypeProperty ; rdfs:comment "raw Elixir capture for input transform (input.ex:42-50)." .

aap:stepKind a owl:DatatypeProperty ; rdfs:comment "step|collect|flunk|compose|map|switch|around|transaction|create|update|destroy|read_one|read|action|bulk_create|bulk_update|bulk_destroy." .
aap:stepOrder a owl:DatatypeProperty ; rdfs:comment "integer; emission order among siblings." .
aap:stepParent a owl:ObjectProperty ; rdfs:comment "Nested step -> container step (map/around/transaction) or aap:ReactorBranch." .
aap:stepImpl a owl:DatatypeProperty ; rdfs:comment "kind step: Reactor.Step module (step.ex:105). Empty + aap:stepGenerate \"true\" => generated module <Reactor>.Steps.<stepImplName>." .
aap:stepGenerate a owl:DatatypeProperty ; rdfs:comment "\"true\" => L15_step_module.ex.tmpl emits the impl (run/3, compensate/4, undo/4)." .
aap:stepImplName a owl:DatatypeProperty ; rdfs:comment "Module suffix of generated impl." .
aap:stepHasCompensate a owl:DatatypeProperty ; rdfs:comment "\"true\" => generated impl defines compensate/4 and gate L15_030 accepts it." .
aap:stepHasUndo a owl:DatatypeProperty ; rdfs:comment "\"true\" => generated impl defines undo/4; gate accepts it." .
aap:stepEffectful a owl:DatatypeProperty ; rdfs:comment "\"true\"|\"false\"; overrides the kind default for gate L15_030." .
aap:stepRunBody a owl:DatatypeProperty ; rdfs:comment "raw Elixir expr returning {:ok, _}|{:error, _} for generated run/3 (arguments in scope)." .
aap:stepCompensateBody a owl:DatatypeProperty ; rdfs:comment "raw Elixir expr for generated compensate/4 (:ok|:retry|{:continue, v}); needs aap:stepHasCompensate true." .
aap:stepUndoBody a owl:DatatypeProperty ; rdfs:comment "raw Elixir expr for generated undo/4 (:ok|:retry|{:error, _}); needs aap:stepHasUndo true." .
aap:compensationWaiver a owl:DatatypeProperty ; rdfs:comment "Reason text; explicit, auditable waiver for gate L15_030." .
aap:stepResource a owl:DatatypeProperty ; rdfs:comment "Ash resource module (Ash steps; action.ex:119)." .
aap:stepResources a owl:DatatypeProperty ; rdfs:comment "comma-separated resource modules (transaction.ex:64)." .
aap:stepAction a owl:DatatypeProperty ; rdfs:comment "action name atom (action.ex:83)." .
aap:stepReactorRef a owl:ObjectProperty ; rdfs:comment "compose step -> aap:Reactor (compose.ex:80)." .
aap:stepMessage a owl:DatatypeProperty ; rdfs:comment "flunk message string (flunk.ex:57)." .
aap:stepWaitFor a owl:ObjectProperty ; rdfs:comment "step -> step (wait_for.ex:34)." .
aap:stepArg a owl:ObjectProperty ; rdfs:comment "step -> aap:ReactorBinding emitted as argument :name, template (argument.ex:194)." .
aap:stepInputs a owl:ObjectProperty ; rdfs:comment "Ash step -> aap:ReactorBinding emitted into inputs %{name: template} (inputs.ex:45-56)." .
aap:stepInitial a owl:ObjectProperty ; rdfs:comment "update/bulk_* initial / create initial." .
aap:stepActor a owl:ObjectProperty ; rdfs:comment "actor template (actor.ex:28)." .
aap:stepTenant a owl:ObjectProperty ; rdfs:comment "tenant template (tenant.ex)." .
aap:stepOn a owl:ObjectProperty ; rdfs:comment "switch on (switch.ex:131)." .
aap:stepSource a owl:ObjectProperty ; rdfs:comment "map source (map.ex:145)." .
aap:stepReturn a owl:ObjectProperty ; rdfs:comment "container step or branch -> nested step; return (map.ex:152, transaction.ex:71, switch.ex:66)." .
aap:stepOpt a owl:DatatypeProperty ; rdfs:comment "Escape hatch: one raw DSL option line per value, e.g. \"return_records? true\" or \"transform &Mod.f/1\". Emitted verbatim inside the step block." .

aap:stepDescription a owl:DatatypeProperty ; rdfs:comment "description (step.ex:98). No double quotes or backslashes." .
aap:stepAsync a owl:DatatypeProperty ; rdfs:comment "async? (step.ex:148, action.ex:96)." .
aap:stepMaxRetries a owl:DatatypeProperty ; rdfs:comment "max_retries (step.ex:140)." .
aap:stepAllowAsync a owl:DatatypeProperty ; rdfs:comment "allow_async? (compose.ex:87, map.ex:122, around.ex:74, switch.ex:123)." .
aap:stepSupportUndo a owl:DatatypeProperty ; rdfs:comment "support_undo? (compose.ex:103)." .
aap:stepBatchSize a owl:DatatypeProperty ; rdfs:comment "batch_size (map.ex:130, bulk_create.ex:170)." .
aap:stepStrictOrdering a owl:DatatypeProperty ; rdfs:comment "strict_ordering? (map.ex:159)." .
aap:stepTimeout a owl:DatatypeProperty ; rdfs:comment "timeout (transaction.ex:78)." .
aap:stepUndo a owl:DatatypeProperty ; rdfs:comment "always|never|outside_transaction (action.ex:136)." .
aap:stepUndoAction a owl:DatatypeProperty ; rdfs:comment "undo action name (action.ex:129)." .
aap:stepUpsert a owl:DatatypeProperty ; rdfs:comment "upsert? (create.ex:110)." .
aap:stepUpsertIdentity a owl:DatatypeProperty ; rdfs:comment "upsert_identity atom (create.ex:105)." .
aap:stepAuthorize a owl:DatatypeProperty ; rdfs:comment "authorize? (action.ex:103)." .
aap:stepFailOnNotFound a owl:DatatypeProperty ; rdfs:comment "fail_on_not_found? (read_one.ex:84)." .
aap:stepReadAction a owl:DatatypeProperty ; rdfs:comment "read_action atom (bulk_create.ex:203)." .

aap:argKind a owl:DatatypeProperty ; rdfs:comment "input|result|element|value." .
aap:argName a owl:DatatypeProperty ; rdfs:comment "L15: argument name / inputs key (role arg and inputs only). L17: declared aap:ActionArgument name." .
aap:argInput a owl:ObjectProperty ; rdfs:comment "kind input -> aap:ReactorInput." .
aap:argStep a owl:ObjectProperty ; rdfs:comment "kind result|element -> aap:ReactorStep (same reactor; gate L15_020)." .
aap:argPath a owl:DatatypeProperty ; rdfs:comment "comma-separated sub_path atoms (argument.ex:62,100,158)." .
aap:argValue a owl:DatatypeProperty ; rdfs:comment "kind value: raw Elixir term (argument.ex:127)." .
aap:argTransform a owl:DatatypeProperty ; rdfs:comment "raw Elixir capture (argument.ex:220)." .

aap:switchMatch a owl:ObjectProperty ; rdfs:comment "switch step -> aap:ReactorBranch." .
aap:branchPredicate a owl:DatatypeProperty ; rdfs:comment "raw 1-arity capture/fn for matches? (switch.ex:52). Absent + aap:branchDefault \"true\" => default." .
aap:branchDefault a owl:DatatypeProperty ; rdfs:comment "\"true\" => default branch (switch.ex:76)." .

aap:reactorAction a owl:ObjectProperty ; rdfs:domain aap:Resource ; rdfs:range aap:ReactorAction .
aap:runsReactor a owl:ObjectProperty ; rdfs:comment "ReactorAction -> aap:Reactor." .
aap:actionReturns a owl:DatatypeProperty ; rdfs:comment "Ash type atom for `action :name, :type` (e.g. map, string)." .
aap:actionImplModule a owl:DatatypeProperty ; rdfs:comment "Module of generated Implementation." .
aap:actionImplFile a owl:DatatypeProperty ; rdfs:comment "File stem under lib/<appPath>/reactor_actions/." .
aap:actionFragmentModule a owl:DatatypeProperty ; rdfs:comment "Per-resource fragment module name (set on the Resource: aap:reactorFragment)." .
aap:reactorFragment a owl:DatatypeProperty ; rdfs:comment "Resource -> fragment module name that holds its reactor actions + skills." .
aap:reactorFragmentFile a owl:DatatypeProperty ; rdfs:comment "Resource -> file stem of the fragment." .
aap:actionArg a owl:ObjectProperty ; rdfs:comment "ReactorAction -> aap:ReactorActionArg." .
aap:actionArgType a owl:DatatypeProperty ; rdfs:comment "Ash type atom." .
aap:actionArgAllowNil a owl:DatatypeProperty ; rdfs:comment "true|false." .
aap:passActor a owl:DatatypeProperty ; rdfs:comment "\"true\" => run/3 passes ctx.actor as reactor input :actor." .
aap:passTenant a owl:DatatypeProperty ; rdfs:comment "\"true\" => passes ctx.tenant as reactor input :tenant." .
aap:runTimeout a owl:DatatypeProperty ; rdfs:comment "Reactor.run timeout option (reactor.ex:158)." .
aap:runMaxConcurrency a owl:DatatypeProperty ; rdfs:comment "Reactor.run max_concurrency (reactor.ex:153)." .
aap:runMaxIterations a owl:DatatypeProperty ; rdfs:comment "Reactor.run max_iterations (reactor.ex:164)." .
aap:reactorSkill a owl:ObjectProperty ; rdfs:comment "ReactorAction -> aap:Skill-shaped node (aap:name, aap:description, optional aap:consequence, aap:leaseRequired, aap:skillOnCancel)." .
aap:skillOnCancel a owl:DatatypeProperty ; rdfs:comment "module for on_cancel (ash_a2a dsl.ex:61)." .

# =====================================================================================
# L16 ash_pplan (workflow/dsl/extension.ex, capability.ex, provider.ex, capability_pack.ex, ...)
# Multi-valued lists are repeated triples except step order (aap:ppStep blank nodes).
# =====================================================================================
aap:PPlanWorkflow       a owl:Class ; rdfs:comment "A module using AshPPlan.Workflow (workflow do ... end)." .
aap:PPlanTask           a owl:Class ; rdfs:comment "workflow task entity (extension.ex:25)." .
aap:PPlanMethod         a owl:Class ; rdfs:comment "workflow method entity, an HDDL decomposition (extension.ex:47)." .
aap:PPlanStep           a owl:Class ; rdfs:comment "Ordered subtask reference inside a method." .
aap:PPlanProvider       a owl:Class ; rdfs:comment "Module implementing @behaviour AshPPlan.Provider (provider.ex)." .
aap:PPlanBinding        a owl:Class ; rdfs:comment "Provider binding row: capability -> {adapter, op, options} (qualify.ex:72)." .
aap:PPlanCapabilityPack a owl:Class ; rdfs:comment "AshPPlan.CapabilityPack declaration (capability_pack.ex:13)." .
aap:PPlanObligation     a owl:Class ; rdfs:comment "A requirement a workflow must discharge: a capability (with properties/evidence) some task AND some provider must supply." .
aap:PPlanManufactureTarget a owl:Class ; rdfs:comment "One manufacture manifest row (manufacture_targets.ex:24)." .
aap:PPlanControlPlane   a owl:Class ; rdfs:comment "Control-plane expectation for an Ash resource (control_plane.ex:19)." .

aap:ppWorkflow     a owl:ObjectProperty ; rdfs:comment "Domain -> aap:PPlanWorkflow (placement only)." .
aap:ppFile         a owl:DatatypeProperty ; rdfs:comment "File stem under lib/<appPath>/pplan/." .
aap:ppName         a owl:DatatypeProperty ; rdfs:comment "workflow name (section schema :name, extension.ex:65)." .
aap:ppGoal         a owl:DatatypeProperty ; rdfs:comment "workflow goal string (extension.ex:66)." .
aap:ppVersion      a owl:DatatypeProperty ; rdfs:comment "pos_integer workflow version (extension.ex:67)." .
aap:ppTask         a owl:ObjectProperty ; rdfs:comment "Workflow -> aap:PPlanTask." .
aap:ppMethod       a owl:ObjectProperty ; rdfs:comment "Workflow -> aap:PPlanMethod." .
aap:ppObligation   a owl:ObjectProperty ; rdfs:comment "Workflow -> aap:PPlanObligation." .
aap:ppProvider     a owl:ObjectProperty ; rdfs:comment "Domain -> aap:PPlanProvider (placement only)." .
aap:ppUsesProvider a owl:ObjectProperty ; rdfs:comment "Workflow -> aap:PPlanProvider candidate set for its generated court." .

aap:ppCapability   a owl:DatatypeProperty ; rdfs:comment "Family.Name capability id (extension.ex:33)." .
aap:ppAfter        a owl:ObjectProperty ; rdfs:comment "Task -> Task it depends on (after:, extension.ex:34). Object-valued so the acyclicity gate is a property path." .
aap:ppOutcome      a owl:DatatypeProperty ; rdfs:comment "Declared nondeterministic outcome atom (outcomes:, :35). Repeatable." .
aap:ppProperty     a owl:DatatypeProperty ; rdfs:comment "Required execution property atom (properties:, :36). Repeatable." .
aap:ppEvidenceKind a owl:DatatypeProperty ; rdfs:comment "Required evidence kind atom (evidence:, :37). Repeatable." .
aap:ppAuthority    a owl:DatatypeProperty ; rdfs:comment "none|observe|select|plan|construct (:38; ceiling construct, :do never)." .
aap:ppCompensation a owl:DatatypeProperty ; rdfs:comment "Elixir term text for compensation: (e.g. {Mod, :fun, []}), :39-43 (workflow section only)." .

aap:ppRefines      a owl:ObjectProperty ; rdfs:comment "Method -> Task refined (task:, extension.ex:51)." .
aap:ppStepOf       a owl:ObjectProperty ; rdfs:comment "Method -> aap:PPlanStep (ordered subtasks:, :52)." .
aap:ppStep         a owl:DatatypeProperty ; rdfs:comment "integer order key of a step." .
aap:ppStepTask     a owl:ObjectProperty ; rdfs:comment "Step -> Task." .
aap:ppPrecondition a owl:DatatypeProperty ; rdfs:comment "Elixir term text for method precondition: (:any, :53)." .

aap:ppProviderId   a owl:DatatypeProperty ; rdfs:comment "provider id/0 atom (provider.ex:23)." .
aap:ppCost         a owl:DatatypeProperty ; rdfs:comment "cost/0 number (provider.ex:31)." .
aap:ppProvidesProperty a owl:DatatypeProperty ; rdfs:comment "properties/0 element (provider.ex:27). Repeatable." .
aap:ppProvidesEvidence a owl:DatatypeProperty ; rdfs:comment "evidence/0 element (provider.ex:29). Repeatable." .
aap:ppAuthorityCeiling a owl:DatatypeProperty ; rdfs:comment "authorities list handed to Qualify.check (qualify.ex:22). Repeatable; default = full list." .
aap:ppBinding      a owl:ObjectProperty ; rdfs:comment "Provider -> aap:PPlanBinding." .
aap:ppAdapter      a owl:DatatypeProperty ; rdfs:comment "Binding adapter atom, key of AshPPlan.Reactor.adapters/0 (realization.ex:25)." .
aap:ppOp           a owl:DatatypeProperty ; rdfs:comment "Binding op atom; must equal Realization.op_for(capability) (realization.ex:29)." .
aap:ppOptions      a owl:DatatypeProperty ; rdfs:comment "Elixir keyword text for binding options, default []." .

aap:ppPack         a owl:ObjectProperty ; rdfs:comment "Domain -> aap:PPlanCapabilityPack." .
aap:ppPackId       a owl:DatatypeProperty ; rdfs:comment "pack id string (capability_pack.ex:14)." .
aap:ppPackVersion  a owl:DatatypeProperty ; rdfs:comment "pack version string, default 0.0.0." .
aap:ppPackCapability a owl:DatatypeProperty ; rdfs:comment "Capability id in the pack. Repeatable." .
aap:ppPackProperty a owl:DatatypeProperty ; rdfs:comment "Pack property atom. Repeatable." .
aap:ppPackEvidence a owl:DatatypeProperty ; rdfs:comment "Pack evidence atom. Repeatable." .

aap:ppRequiresProperty a owl:DatatypeProperty ; rdfs:comment "Property the discharging provider must offer. Repeatable." .
aap:ppRequiresEvidence a owl:DatatypeProperty ; rdfs:comment "Evidence the discharging provider must offer. Repeatable." .

aap:ppTarget       a owl:ObjectProperty ; rdfs:comment "Domain -> aap:PPlanManufactureTarget." .
aap:ppTemplate     a owl:DatatypeProperty ; rdfs:comment "manufacture template name (manufacture_targets.ex:27)." .
aap:ppOut          a owl:DatatypeProperty ; rdfs:comment "root-relative output path." .
aap:ppTargetModule a owl:DatatypeProperty ; rdfs:comment "module the projection defines." .
aap:ppGeneratedDir a owl:DatatypeProperty ; rdfs:comment "Domain-level generated_dirs/0 entry (:86). Repeatable." .
aap:ppReusesPack   a owl:DatatypeProperty ; rdfs:comment "Marketplace pack id reused by reference (ash-pplan-igniter-pack, ash-pplan-protocol-court-pack, ash-pplan-store-conformance-pack, ash-pplan-chaos-pack). Repeatable, on a Domain." .
aap:ppControlPlane a owl:ObjectProperty ; rdfs:comment "Resource -> aap:PPlanControlPlane." .
aap:ppExpectStateMachine a owl:DatatypeProperty ; rdfs:comment "\"true\" => generated verify/0 requires state_machine.available? (control_plane.ex:27)." .
aap:ppExpectOban   a owl:DatatypeProperty ; rdfs:comment "\"true\" => generated verify/0 requires oban.available? (control_plane.ex:28)." .

# =====================================================================================
# L17 complete AshA2A DSL (dsl.ex, domain.ex, agent.ex, verifiers/*)
# =====================================================================================
aap:SkillSpec        a owl:Class ; rdfs:comment "Full-option a2a skill override (dsl.ex:188 @skill). Distinct from aap:Skill: a name may not appear on both (duplicate Spark identifier :name, dsl.ex:195)." .
aap:ArgMapping       a owl:Class ; rdfs:comment "One argument_mapping entry wire-name => action argument (dsl.ex:73)." .
aap:ActionArgument   a owl:Class ; rdfs:comment "Declared Ash action argument; needed so argument_mapping targets and JSON-serializability are checkable (verify_skills.ex:373,413)." .
aap:HddlOperator     a owl:Class ; rdfs:comment "Skill HDDL operator (dsl.ex:178)." .
aap:HddlFact         a owl:Class ; rdfs:comment "{predicate, args} tuple (dsl.ex:153)." .
aap:SecurityRequirement a owl:Class ; rdfs:comment "One AgentSkill securityRequirements map entry scheme => scopes (dsl.ex:119)." .
aap:HookRef          a owl:Class ; rdfs:comment "Binding of a dispatch hook id to a lifecycle phase (dsl.ex:253 hooks section)." .
aap:DispatchHook     a owl:Class ; rdfs:comment "config :ash_a2a, :dispatch_hooks entry id => {Module, :fun} (dsl.ex:261-264)." .
aap:SecurityScheme   a owl:Class ; rdfs:comment "Domain security_scheme entity (domain.ex:153)." .
aap:RequirementScope a owl:Class ; rdfs:comment "Domain security requirement_scopes entry (domain.ex:232)." .
aap:Mount            a owl:Class ; rdfs:comment "A domain-level a2a transport mount (ash_a2a lib/ash_a2a/domain.ex:243-291). Shapes: L08/L17 Domain -aap:mount-> Mount; L10 Mount -aap:mountOf-> Domain." .
aap:AgentExtension   a owl:Class ; rdfs:comment "Domain transport extension entity (domain.ex:293)." .
aap:Endpoint         a owl:Class ; rdfs:comment "Bandit + Plug.Router + AgentSupervisor supervision subtree serving a domain's mounts (AshA2A.Domain.Router, domain/router.ex:5)." .

aap:skillSpec        a owl:ObjectProperty ; rdfs:comment "Resource -> aap:SkillSpec." .
aap:semanticRequests a owl:DatatypeProperty ; rdfs:comment "true|false; a2a.semantic_requests (dsl.ex:205). Resource or Domain subject." .
aap:specName         a owl:DatatypeProperty ; rdfs:comment "skill name atom (dsl.ex:20)." .
aap:specAction       a owl:DatatypeProperty ; rdfs:comment "public action name atom (dsl.ex:30)." .
aap:tag              a owl:DatatypeProperty ; rdfs:comment "multi-valued; skill tags (dsl.ex:40). Sorted on emit." .
aap:expose           a owl:DatatypeProperty ; rdfs:comment "true|false -> expose? (dsl.ex:45). Default true." .
aap:onCancel         a owl:DatatypeProperty ; rdfs:comment "Elixir text: Module or {Module, :fun, [extra]} (dsl.ex:61; verify_skills.ex:267)." .
aap:argMapping       a owl:ObjectProperty ; rdfs:comment "SkillSpec -> aap:ArgMapping." .
aap:wireName         a owl:DatatypeProperty ; rdfs:comment "inbound wire (string) argument name (dsl.ex:73)." .
aap:targetArg        a owl:DatatypeProperty ; rdfs:comment "action argument / accepted attribute atom name." .
aap:getRead          a owl:DatatypeProperty ; rdfs:comment "true|false -> get? (dsl.ex:82); read skills only." .
aap:streaming        a owl:DatatypeProperty ; rdfs:comment "true|false -> streaming? (dsl.ex:128); read skills only." .
aap:example          a owl:DatatypeProperty ; rdfs:comment "multi-valued; AgentSkill examples (dsl.ex:99). Sorted on emit." .
aap:inputMode        a owl:DatatypeProperty ; rdfs:comment "multi-valued MIME; per-skill input_modes (dsl.ex:104; MIME-shaped, verify_skills.ex:200). Also Domain default_input_modes via aap:cardInputMode." .
aap:outputMode       a owl:DatatypeProperty ; rdfs:comment "multi-valued MIME; per-skill output_modes (dsl.ex:112)." .
aap:secRequirement   a owl:ObjectProperty ; rdfs:comment "SkillSpec -> aap:SecurityRequirement (dsl.ex:119)." .
aap:secGroup         a owl:DatatypeProperty ; rdfs:comment "string key grouping entries into one map (AND within a group, OR across groups)." .
aap:secScheme        a owl:DatatypeProperty ; rdfs:comment "declared security_scheme name (verify_skills.ex:233)." .
aap:secScopes        a owl:DatatypeProperty ; rdfs:comment "comma-separated scopes; empty = []." .
aap:actionArgument   a owl:ObjectProperty ; rdfs:comment "Action -> aap:ActionArgument." .
aap:argType          a owl:DatatypeProperty ; rdfs:comment "Ash type atom name, e.g. string, term." .
aap:actionPrivate    a owl:DatatypeProperty ; rdfs:comment "true -> action is `public? false`; skills may not target it (verify_skills.ex:351)." .

aap:hddlOperator a owl:ObjectProperty ; rdfs:comment "SkillSpec -> aap:HddlOperator (at most one, verify_hddl_operators.ex:27)." .
aap:hddlParams   a owl:DatatypeProperty ; rdfs:comment "ordered comma-separated parameter atoms (dsl.ex:157)." .
aap:hddlPre      a owl:ObjectProperty ; rdfs:comment "HddlOperator -> aap:HddlFact precondition (dsl.ex:161)." .
aap:hddlAdd      a owl:ObjectProperty ; rdfs:comment "HddlOperator -> aap:HddlFact add effect (dsl.ex:166)." .
aap:hddlDel      a owl:ObjectProperty ; rdfs:comment "HddlOperator -> aap:HddlFact delete effect (dsl.ex:171)." .
aap:predicate    a owl:DatatypeProperty ; rdfs:comment "fact predicate atom." .
aap:factArgs     a owl:DatatypeProperty ; rdfs:comment "ordered comma-separated args; each must be a declared parameter (verify_hddl_operators.ex:51)." .

aap:authGate         a owl:DatatypeProperty ; rdfs:comment "two_port|open|disabled (dsl.ex:232)." .
aap:leaseDurationMs  a owl:DatatypeProperty ; rdfs:comment "positive integer ms (dsl.ex:242). Declared-only: flagged inert by AshA2A.Verify." .
aap:authorizer       a owl:DatatypeProperty ; rdfs:comment "comma-separated authorizer modules for the resource fragment `authorizers:` (required by lease_required?, verify_skills.ex:487)." .
aap:hookRef          a owl:ObjectProperty ; rdfs:comment "Resource -> aap:HookRef." .
aap:hookId           a owl:DatatypeProperty ; rdfs:comment "hook id atom." .
aap:hookPhase        a owl:DatatypeProperty ; rdfs:comment "pre|post." .
aap:hookOrder        a owl:DatatypeProperty ; rdfs:comment "integer evaluation order within phase." .
aap:dispatchHook     a owl:ObjectProperty ; rdfs:comment "Project -> aap:DispatchHook." .
aap:hookModule       a owl:DatatypeProperty .
aap:hookFun          a owl:DatatypeProperty .

aap:a2aConfigured    a owl:DatatypeProperty ; rdfs:comment "true on a Domain that gets the AshA2A.Domain fragment." .
aap:cardName         a owl:DatatypeProperty ; rdfs:comment "agent.name; REQUIRED (verify_config.ex:33)." .
aap:cardDescription  a owl:DatatypeProperty .
aap:cardVersion      a owl:DatatypeProperty .
aap:cardUrl          a owl:DatatypeProperty .
aap:cardProvider     a owl:DatatypeProperty .
aap:cardDocumentationUrl a owl:DatatypeProperty .
aap:cardIconUrl      a owl:DatatypeProperty .
aap:cardInputMode    a owl:DatatypeProperty ; rdfs:comment "multi-valued MIME -> agent.default_input_modes (domain.ex:121)." .
aap:cardOutputMode   a owl:DatatypeProperty ; rdfs:comment "multi-valued MIME -> agent.default_output_modes (domain.ex:128)." .
aap:signCard         a owl:DatatypeProperty ; rdfs:comment "agent.sign_card key reference (domain.ex:135). Atom text when it starts with ':'; else string." .

aap:securityScheme   a owl:ObjectProperty ; rdfs:comment "Domain -> aap:SecurityScheme." .
aap:schemeName       a owl:DatatypeProperty .
aap:schemeKind       a owl:DatatypeProperty ; rdfs:comment "bearer|api_key|none|http|oauth2|openid_connect|mtls (domain.ex:151)." .
aap:schemeLocation   a owl:DatatypeProperty ; rdfs:comment "header|query|cookie (api_key only, domain.ex:177)." .
aap:paramName        a owl:DatatypeProperty .
aap:httpScheme       a owl:DatatypeProperty ; rdfs:comment "required for kind http (verify_config.ex:119)." .
aap:bearerFormat     a owl:DatatypeProperty .
aap:oauthFlows       a owl:DatatypeProperty ; rdfs:comment "Elixir map literal text, string-keyed; required for kind oauth2 (domain.ex:197)." .
aap:schemeScopes     a owl:DatatypeProperty ; rdfs:comment "comma-separated documentation scopes (domain.ex:207)." .
aap:openidUrl        a owl:DatatypeProperty ; rdfs:comment "required for kind openid_connect." .
aap:requirement      a owl:DatatypeProperty ; rdfs:comment "multi-valued declared scheme name -> security.requirements (domain.ex:225)." .
aap:requirementScope a owl:ObjectProperty ; rdfs:comment "Domain -> aap:RequirementScope." .
aap:reqName          a owl:DatatypeProperty .
aap:reqScopes        a owl:DatatypeProperty ; rdfs:comment "comma-separated scopes." .

aap:extendedAgentCard a owl:DatatypeProperty ; rdfs:comment "true|false (domain.ex:321)." .
aap:userArtifacts    a owl:DatatypeProperty ; rdfs:comment "true|false (domain.ex:328)." .
aap:pushAllowedHost  a owl:DatatypeProperty ; rdfs:comment "multi-valued host (domain.ex:335)." .
aap:pushRetryMaxAttempts a owl:DatatypeProperty ; rdfs:comment "positive integer (domain.ex:346)." .
aap:pushRetryBackoffMs a owl:DatatypeProperty ; rdfs:comment "positive integer (domain.ex:347)." .
aap:baseUrl          a owl:DatatypeProperty ; rdfs:comment "absolute http(s) URL (domain.ex:351; verify_config.ex:164)." .
aap:defaultMount     a owl:DatatypeProperty ; rdfs:comment "path starting with / (domain.ex:359)." .
aap:streamingEnabled a owl:DatatypeProperty ; rdfs:comment "true|false (domain.ex:369)." .
aap:pushNotifications a owl:DatatypeProperty ; rdfs:comment "true|false (domain.ex:374)." .
aap:mount            a owl:ObjectProperty ; rdfs:domain aap:Domain ; rdfs:range aap:Mount ; rdfs:comment "Domain -> aap:Mount (tenant mapping into A2A supportedInterfaces; L08 and L17)." .
aap:mountPath        a owl:DatatypeProperty .
aap:mountBinding     a owl:DatatypeProperty ; rdfs:comment "jsonrpc|rest|grpc (mount.ex:44). Default jsonrpc." .
aap:mountTenant      a owl:DatatypeProperty ; rdfs:comment "tenant id on the mount (domain.ex:278)." .
aap:mountProtocolVersion a owl:DatatypeProperty .
aap:agentExtension   a owl:ObjectProperty ; rdfs:comment "Domain -> aap:AgentExtension." .
aap:extUri           a owl:DatatypeProperty ; rdfs:comment "unique per domain (verify_extensions.ex:18)." .
aap:extDescription   a owl:DatatypeProperty .
aap:extRequired      a owl:DatatypeProperty ; rdfs:comment "true|false." .
aap:extParams        a owl:DatatypeProperty ; rdfs:comment "Elixir map literal text %{...} (domain.ex:308)." .

# DUAL USE (E1): L08 fixture gives the agent module name as a literal; L10 and L17 link Mount ->
# aap:Agent node (object). Kind-neutral rdf:Property.
aap:mountAgent a rdf:Property ;
  rdfs:comment "L10/L17: aap:Mount -> aap:Agent node (must not be an agent of the mounting domain: compile-order deadlock, see L17-NOTES). L08: agent module name literal." .

aap:agentConfigured  a owl:DatatypeProperty ; rdfs:comment "true -> emit <Agent>.Configured with full option set." .
aap:agentDescription a owl:DatatypeProperty .
aap:agentVersion     a owl:DatatypeProperty .
aap:requireAuthenticatedCaller a owl:DatatypeProperty ; rdfs:comment "true|false (agent.ex:97). Default true is fail-closed." .
aap:publicSkill      a owl:DatatypeProperty ; rdfs:comment "multi-valued skill name (agent.ex:99)." .
aap:observeGenericAction a owl:DatatypeProperty ; rdfs:comment "multi-valued skill name (agent.ex:92-96)." .
aap:strictObserveGenericActions a owl:DatatypeProperty ; rdfs:comment "true|false (agent.ex:101)." .
aap:execMode         a owl:DatatypeProperty ; rdfs:comment "async|inline (runtime.ex:81)." .
aap:execMaxInFlight  a owl:DatatypeProperty ; rdfs:comment "positive integer (runtime.ex:523)." .
aap:execRateCount    a owl:DatatypeProperty ; rdfs:comment "positive integer; with execRatePerMs -> rate_limit {count, per_ms} (runtime.ex:531)." .
aap:execRatePerMs    a owl:DatatypeProperty .
aap:execCancelInFlight a owl:DatatypeProperty ; rdfs:comment "refuse|interrupt|default (verify_execution.ex:26)." .
aap:execEventsTransport a owl:DatatypeProperty ; rdfs:comment "registered-name atom/module text; booleans refused (verify_execution.ex:73)." .
aap:execValidateInputModes a owl:DatatypeProperty ; rdfs:comment "true|false (verify_execution.ex:100)." .
aap:execUserArtifacts a owl:DatatypeProperty ; rdfs:comment "true|false." .
aap:execAdapter      a owl:DatatypeProperty ; rdfs:comment "local|pplan (runtime.ex:217)." .
aap:execOrphanSweepIntervalMs a owl:DatatypeProperty ; rdfs:comment "positive integer (runtime.ex:721)." .
aap:execOrphanLeaseMs a owl:DatatypeProperty ; rdfs:comment "positive integer (runtime.ex:730)." .

aap:endpoint         a owl:ObjectProperty ; rdfs:comment "Project -> aap:Endpoint." .
aap:endpointModule   a owl:DatatypeProperty ; rdfs:comment "Supervisor module; Router is <module>.Router." .
aap:endpointFile     a owl:DatatypeProperty ; rdfs:comment "lib/<appPath of served domain>/<file>.ex." .
aap:endpointDomain   a owl:ObjectProperty ; rdfs:comment "Endpoint -> served aap:Domain." .
aap:endpointPort     a owl:DatatypeProperty ; rdfs:comment "1..65535 (Bandit :port)." .
aap:endpointIp       a owl:DatatypeProperty ; rdfs:comment "loopback|any (Bandit :ip). Default loopback (fail-closed)." .
aap:endpointForwardPath a owl:DatatypeProperty ; rdfs:comment "Plug.Router forward prefix; default /." .
aap:endpointPushNotifications a owl:DatatypeProperty ; rdfs:comment "true|false forwarded to every delegate (router.ex:46)." .
aap:endpointExtendedCard a owl:DatatypeProperty ; rdfs:comment "Elixir capture text e.g. &MyApp.Cards.extended/2 (router.ex:46)." .
aap:endpointAgent    a owl:ObjectProperty ; rdfs:comment "Endpoint -> aap:Agent started under AshA2A.Protocol.AgentSupervisor (agent_supervisor.ex:22)." .

# =====================================================================================
# L18 Spark: app-level custom Spark.Dsl.Extension authored from Turtle
# =====================================================================================
aap:SparkExtension a owl:Class ; rdfs:comment "App-level Spark.Dsl.Extension module (aap:moduleName, aap:appPath, aap:extFile, aap:extTarget)." .
aap:SparkSection   a owl:Class ; rdfs:comment "Spark.Dsl.Section of an extension (aap:name)." .
aap:SparkEntity    a owl:Class ; rdfs:comment "Spark.Dsl.Entity in a section (aap:name, aap:structModule)." .
aap:SparkField     a owl:Class ; rdfs:comment "Schema key of an entity or section (aap:name, aap:sparkType)." .
aap:SparkInstance  a owl:Class ; rdfs:comment "A use of an entity inside one resource's fragment." .
aap:SparkValue     a owl:Class ; rdfs:comment "Value of one field in an instance (aap:forField, aap:valueText)." .

aap:sparkExtension a owl:ObjectProperty ; rdfs:comment "Resource -> SparkExtension it enables (fragment extensions: [...])." .
aap:extFile        a owl:DatatypeProperty ; rdfs:comment "File stem of the extension module under lib/<appPath>/." .
aap:extTarget      a owl:DatatypeProperty ; rdfs:comment "Target DSL; only Ash.Resource fragments are emitted (default Ash.Resource)." .
aap:extPersistKey  a owl:DatatypeProperty ; rdfs:comment "Atom name of the persisted map key written by the generated transformer." .
aap:sparkSection   a owl:ObjectProperty ; rdfs:comment "SparkExtension -> SparkSection." .
aap:sparkEntity    a owl:ObjectProperty ; rdfs:comment "SparkSection -> SparkEntity." .
aap:sparkField     a owl:ObjectProperty ; rdfs:comment "SparkEntity or SparkSection -> SparkField." .
aap:structModule   a owl:DatatypeProperty ; rdfs:comment "Entity target struct module name." .
aap:identifier     a owl:DatatypeProperty ; rdfs:comment "Entity identifier field name (entity.ex identifier:)." .
aap:minEntities    a owl:DatatypeProperty ; rdfs:comment "Section: verifier requires >= N entities when the section is present." .
aap:uniqueField    a owl:DatatypeProperty ; rdfs:comment "Entity: verifier requires this field unique across the section." .
aap:sparkType      a owl:DatatypeProperty ; rdfs:comment "Elixir Spark type text, e.g. :atom, {:one_of, [:a, :b]}, {:list, :string}." .
aap:required       a owl:DatatypeProperty ; rdfs:comment "\"true\"|\"false\"." .
aap:fieldDefault   a owl:DatatypeProperty ; rdfs:comment "Elixir literal text for default:." .
aap:doc            a owl:DatatypeProperty ; rdfs:comment "Field doc string." .
aap:fieldOrder     a owl:DatatypeProperty ; rdfs:comment "Integer sort key." .
aap:argPosition    a owl:DatatypeProperty ; rdfs:comment "1-based positional arg index (entity args:)." .
aap:sparkOrder     a owl:DatatypeProperty ; rdfs:comment "Integer sort key for sections/entities." .
aap:sparkInstance  a owl:ObjectProperty ; rdfs:comment "Resource -> SparkInstance." .
aap:ofEntity       a owl:ObjectProperty ; rdfs:comment "SparkInstance -> SparkEntity." .
aap:sparkValue     a owl:ObjectProperty ; rdfs:comment "SparkInstance -> SparkValue." .
aap:forField       a owl:ObjectProperty ; rdfs:comment "SparkValue -> SparkField." .
aap:valueText      a owl:DatatypeProperty ; rdfs:comment "Elixir literal text of the value." .

# =====================================================================================
# L19 EA admission graph projection (templates/L19_ea_graph.json.tmpl emits ea.graph.json)
# =====================================================================================
aap:eaDeclare a owl:DatatypeProperty ;
  rdfs:domain aap:Project ;
  rdfs:comment "\"true\"|\"false\" (default \"false\"). false: emit the minimal valid graph ggen init writes. true: additionally declare one capability, ABB and contract per aap:Agent. Candidate SBBs and qualifications are never emitted (digests computed by ggen-abb-sbb; see fragments/L19-NOTES.md)." .

# =====================================================================================
# L20 courts: facts that drive generated ExUnit courts and shim courts
# =====================================================================================
aap:CourtCase a owl:Class ; rdfs:comment "Abstract: a declared court input." .
aap:PolicyCase     a owl:Class ; rdfs:subClassOf aap:CourtCase ; rdfs:comment "Allow/deny matrix cell." .
aap:CourtIdentity  a owl:Class ; rdfs:subClassOf aap:CourtCase ; rdfs:comment "Identity uniqueness witness." .
aap:TransitionCase a owl:Class ; rdfs:subClassOf aap:CourtCase ; rdfs:comment "State-machine edge." .
aap:ReactorCase    a owl:Class ; rdfs:subClassOf aap:CourtCase ; rdfs:comment "Reactor happy + compensation path." .
aap:PlanCase       a owl:Class ; rdfs:subClassOf aap:CourtCase ; rdfs:comment "ash_pplan FOND satisfiability." .
aap:ShimCourt      a owl:Class ; rdfs:comment "A mutation that must flip a generated test (gap G6)." .

aap:courtResource a owl:ObjectProperty ; rdfs:range aap:Resource .
aap:caseName      a owl:DatatypeProperty ; rdfs:comment "unique test-name fragment" .
aap:caseAction    a owl:DatatypeProperty ; rdfs:comment "action name (must exist on courtResource; gate L20_045)" .
aap:caseActor     a owl:DatatypeProperty ; rdfs:comment "raw Elixir term for the actor; default nil" .
aap:caseExpect    a owl:DatatypeProperty ; rdfs:comment "allow|deny (policy) ; ok|error (transition) ; satisfiable|unsatisfiable (plan)" .
aap:caseInput     a owl:DatatypeProperty ; rdfs:comment "raw Elixir map for action input; default %{}" .

aap:identityName  a owl:DatatypeProperty .
aap:identityKeys  a owl:DatatypeProperty ; rdfs:comment "comma-separated attribute names" .
aap:seedAction    a owl:DatatypeProperty ; rdfs:comment "create action used to seed (identity + transition)" .
aap:seedInput     a owl:DatatypeProperty ; rdfs:comment "raw Elixir map, valid input for seedAction" .

aap:stateAttr     a owl:DatatypeProperty .

aap:dispatchText     a owl:DatatypeProperty ; rdfs:comment "message text; default ping" .
aap:dispatchIdentity a owl:DatatypeProperty ; rdfs:comment "auth_identity term (dispatcher.ex:145-154); default nil" .
aap:dispatchExpect   a owl:DatatypeProperty ; rdfs:comment "reply|input_required|auth_required|error|typed; default typed" .

aap:caseFile        a owl:DatatypeProperty ; rdfs:comment "file stem under test/courts/" .
aap:reactorModule   a owl:DatatypeProperty .
aap:reactorInputs   a owl:DatatypeProperty ; rdfs:comment "raw Elixir map for the happy path" .
aap:reactorExpect   a owl:DatatypeProperty ; rdfs:comment "raw Elixir pattern for the {:ok, pattern} result; default _" .
aap:failInputs      a owl:DatatypeProperty ; rdfs:comment "raw Elixir map that must fail the reactor" .
aap:undoProbe       a owl:DatatypeProperty ; rdfs:comment "raw Elixir boolean expression true after compensation" .

aap:planTransitions a owl:DatatypeProperty ; rdfs:comment "raw Elixir map %{state => %{action => [outcomes]}} (fond.ex:10-15)" .
aap:planGoals       a owl:DatatypeProperty ; rdfs:comment "raw Elixir list" .
aap:planInitial     a owl:DatatypeProperty ; rdfs:comment "raw Elixir term" .
aap:planMode        a owl:DatatypeProperty ; rdfs:comment "strong|strong_cyclic (synthesis.ex:56)" .

aap:shimName     a owl:DatatypeProperty .
aap:shimTarget   a owl:DatatypeProperty ; rdfs:comment "generated file mutated (relative to project root)" .
aap:shimTemplate a owl:DatatypeProperty ; rdfs:comment "optional pack template; mutated + regenerated when GGEN_SYNC_CMD is set" .
aap:shimBefore   a owl:DatatypeProperty ; rdfs:comment "literal text present in the file" .
aap:shimAfter    a owl:DatatypeProperty ; rdfs:comment "literal replacement (a SHIM-COURT marker is appended by the script)" .
aap:shimTest     a owl:DatatypeProperty ; rdfs:comment "generated test file that must flip" .
