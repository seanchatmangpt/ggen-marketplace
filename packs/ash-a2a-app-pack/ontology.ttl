aap:interfaceOfDomain  a owl:ObjectProperty ; rdfs:comment "Domain-level interface owner (aap:Domain)." .
aap:forResource        a owl:ObjectProperty ; rdfs:comment "Resource a domain-level interface targets." .
aap:interfaceArgs      a owl:DatatypeProperty ; rdfs:comment "comma list; leading ? = optional arg: id,?note" .
aap:get                a owl:DatatypeProperty ; rdfs:comment "true|false -> get?:" .
aap:getBy              a owl:DatatypeProperty ; rdfs:comment "comma list of fields" .
aap:getByIdentity      a owl:DatatypeProperty .
aap:notFoundError      a owl:DatatypeProperty ; rdfs:comment "true|false -> not_found_error?:" .
aap:requireReference   a owl:DatatypeProperty ; rdfs:comment "true|false -> require_reference?:" .
aap:excludeInputs      a owl:DatatypeProperty ; rdfs:comment "comma list" .
aap:functions          a owl:DatatypeProperty ; rdfs:comment "comma subset of subject,can,can?,action,action!" .
aap:interfaceNamespace a owl:DatatypeProperty ; rdfs:comment "Elixir alias segment (e.g. Tickets)" .
aap:defaultOptions     a owl:DatatypeProperty ; rdfs:comment "raw Elixir keyword list, e.g. [load: [:x]]" .
aap:calcArgs           a owl:DatatypeProperty ; rdfs:comment "comma list of id | arg:id | ref:id" .
aap:defineInterface    a owl:DatatypeProperty ; rdfs:comment "Resource code_interface define?: true|false" .
aap:interfaceDomain    a owl:ObjectProperty ; rdfs:comment "Resource code_interface domain: override." .
aap:resourceInterfaceNamespace a owl:DatatypeProperty ; rdfs:comment "Resource code_interface namespace:" .
aap:domainResourceNamespace    a owl:DatatypeProperty ; rdfs:comment "Domain resource-ref namespace:" .

aap:domainDescription  a owl:DatatypeProperty .
aap:domainTimeout      a owl:DatatypeProperty ; rdfs:comment "integer ms or the literal infinity" .
aap:traceName          a owl:DatatypeProperty .
aap:requireActor       a owl:DatatypeProperty ; rdfs:comment "true|false" .
aap:authorize          a owl:DatatypeProperty ; rdfs:comment "always|by_default|when_requested" .
aap:allowUnregistered  a owl:DatatypeProperty ; rdfs:comment "true|false" .
aap:validateConfigInclusion a owl:DatatypeProperty ; rdfs:comment "false -> excluded from ash_domains (host-line seam)" .

aap:mountOf            a owl:ObjectProperty ; rdfs:comment "Mount -> Domain that owns the mount (L10 mount shape)." .

# =====================================================================================
# L11 notifiers: Ash.Notifier.PubSub, custom notifiers, A2A TaskEvents bridge.
# pub_sub.ex:63-99, publication.ex:26-95
# =====================================================================================
aap:PubSub      a owl:Class ; rdfs:comment "pub_sub do ... end section of a resource (Ash.Notifier.PubSub)." .
aap:Publication a owl:Class ; rdfs:comment "publish / publish_all entity inside pub_sub." .
aap:PubSubServer a owl:Class ; rdfs:comment "A Phoenix.PubSub instance started in the app supervision tree." .
aap:Notifier    a owl:Class ; rdfs:comment "A custom Ash.Notifier module (generated)." .
aap:A2ABridge   a owl:Class ; rdfs:comment "Maps an action's notification to AshA2A TaskEvents.publish/6." .
aap:Delegate    a owl:Class ; rdfs:comment "Forwards a notification to a hand-owned module's notify/1." .

aap:pubSub   a owl:ObjectProperty ; rdfs:comment "Resource -> aap:PubSub (at most one)." .
aap:publication a owl:ObjectProperty ; rdfs:comment "aap:PubSub -> aap:Publication." .
aap:notifier a owl:ObjectProperty ; rdfs:comment "Resource -> aap:Notifier (generated simple notifier)." .
aap:simpleNotifier a owl:DatatypeProperty ; rdfs:comment "Resource -> existing notifier module name (no DSL); coordinator adds to simple_notifiers:." .
aap:bridge   a owl:ObjectProperty ; rdfs:comment "aap:Notifier -> aap:A2ABridge." .
aap:delegate a owl:ObjectProperty ; rdfs:comment "aap:Notifier -> aap:Delegate." .

aap:pubSubModule        a owl:DatatypeProperty ; rdfs:comment "module (required), e.g. Phoenix.PubSub or an Endpoint." .
aap:pubSubName          a owl:DatatypeProperty ; rdfs:comment "name: named pub sub passed as first broadcast arg." .
aap:pubSubPrefix        a owl:DatatypeProperty ; rdfs:comment "prefix string." .
aap:pubSubDelimiter     a owl:DatatypeProperty ; rdfs:comment "delimiter string." .
aap:broadcastType       a owl:DatatypeProperty ; rdfs:comment "notification|phoenix_broadcast|broadcast." .
aap:pubSubFilterFn      a owl:DatatypeProperty ; rdfs:comment "Remote capture Mod.fun (arity 1), emitted as &Mod.fun/1." .
aap:pubSubTransformFn   a owl:DatatypeProperty ; rdfs:comment "Remote capture Mod.fun (arity 1)." .

aap:pubAction   a owl:DatatypeProperty ; rdfs:comment "publish: action name. Mutually exclusive with pubType." .
aap:pubType     a owl:DatatypeProperty ; rdfs:comment "publish_all: create|update|destroy." .
aap:pubEvent    a owl:DatatypeProperty ; rdfs:comment "event name (string)." .
aap:pubTopic    a owl:DatatypeProperty ; rdfs:comment "Comma-separated topic parts; ':x' is an attribute atom, else a string. e.g. 'updated,:_pkey'." .
aap:pubTopicTerm a owl:DatatypeProperty ; rdfs:comment "Raw Elixir topic term (nested alternatives); overrides pubTopic." .
aap:pubExcept   a owl:DatatypeProperty ; rdfs:comment "publish_all except: comma-separated action names." .
aap:previousValues a owl:DatatypeProperty ; rdfs:comment "previous_values? true|false." .
aap:pubLoad     a owl:DatatypeProperty ; rdfs:comment "Raw Elixir load statement." .
aap:pubFilterFn a owl:DatatypeProperty ; rdfs:comment "Remote capture Mod.fun (arity 1)." .
aap:pubTransformFn a owl:DatatypeProperty ; rdfs:comment "Remote capture Mod.fun/1, OR a calculation name when pubTransformCalc true." .
aap:pubTransformCalc a owl:DatatypeProperty ; rdfs:comment "true: pubTransformFn is a calculation atom." .
aap:pubPublic   a owl:DatatypeProperty ; rdfs:comment "public? true|false." .
aap:pubDispatcher a owl:DatatypeProperty ; rdfs:comment "dispatcher module." .
aap:pubReturns  a owl:DatatypeProperty ; rdfs:comment "returns Ash.Type atom (requires transform)." .

aap:serverName a owl:DatatypeProperty ; rdfs:comment "Phoenix.PubSub name module." .
aap:serverFile a owl:DatatypeProperty .
aap:serverModule a owl:DatatypeProperty ; rdfs:comment "Generated module exposing children/0." .

aap:notifierFile a owl:DatatypeProperty .
aap:bridgeAction a owl:DatatypeProperty ; rdfs:comment "Action name whose notification is bridged." .
aap:bridgeKind a owl:DatatypeProperty ; rdfs:comment "TaskEvents kind: task|status-update|artifact-update|message-update." .
aap:bridgeTaskIdField a owl:DatatypeProperty ; rdfs:comment "Attribute of notification.data holding the A2A task id." .
aap:bridgeFinal a owl:DatatypeProperty ; rdfs:comment "final? flag true|false." .
aap:bridgeTransport a owl:DatatypeProperty ; rdfs:comment "Transport atom module; default AshA2A.A2ATransport." .
aap:delegateAction a owl:DatatypeProperty ; rdfs:comment "Action name forwarded; absent = all actions." .
aap:delegateModule a owl:DatatypeProperty ; rdfs:comment "Module implementing notify/1." .

# =====================================================================================
# L12 custom Ash types (enum, NewType, TypedStruct, embedded resource, union)
# =====================================================================================
aap:CustomType a owl:Class ;
  rdfs:comment "A generated Ash type module. aap:typeKind: enum|newtype|typed_struct|embedded|union." .
aap:TypeField a owl:Class ;
  rdfs:comment "A field of a typed_struct or embedded type (Ash.TypedStruct field / attribute)." .
aap:UnionMember a owl:Class ;
  rdfs:comment "A member of a union type (Ash.Type.Union constraints[:types] entry)." .
aap:TypedAttribute a owl:Class ;
  rdfs:comment "A resource attribute whose type is a CustomType or a builtin; emitted via fragment." .

aap:typeKind        a owl:DatatypeProperty .
aap:typeFile        a owl:DatatypeProperty ; rdfs:comment "file stem under lib/<appPath>/types/" .
aap:subtypeOf       a owl:DatatypeProperty ; rdfs:comment "newtype: Ash type atom, e.g. string, map (no colon)" .
aap:typeConstraints a owl:DatatypeProperty ; rdfs:comment "Elixir keyword-list literal, e.g. [max_length: 80]" .
aap:typeField       a owl:ObjectProperty .
aap:unionMember     a owl:ObjectProperty .
aap:typedAttribute  a owl:ObjectProperty .
aap:typeRef         a owl:ObjectProperty ; rdfs:comment "points at an aap:CustomType" .
aap:isArray         a owl:DatatypeProperty ; rdfs:comment "true|false: wrap type in {:array, t}" .
aap:defaultValue    a owl:DatatypeProperty ; rdfs:comment "Elixir term literal" .
aap:unionStorage    a owl:DatatypeProperty ; rdfs:comment "type_and_value|map_with_tag" .
aap:unionTag        a owl:DatatypeProperty .
aap:unionTagValue   a owl:DatatypeProperty ; rdfs:comment "Elixir term literal" .
aap:a2aExposed      a owl:DatatypeProperty ; rdfs:comment "false opts a field out of the serializability gate" .

# =====================================================================================
# L13 AshStateMachine mapped onto the A2A task lifecycle (ash_a2a task_lifecycle.ex:29-50)
# States are IRIs minted per machine (aap:State, aap:name "submitted").
# =====================================================================================
aap:StateMachine a owl:Class ; rdfs:comment "state_machine section of an Ash.Resource (ash_state_machine.ex:73)." .
aap:State a owl:Class ; rdfs:comment "A state of exactly one aap:StateMachine; aap:name is the atom." .
aap:Transition a owl:Class ; rdfs:comment "transition entity (ash_state_machine.ex:23-48)." .

aap:stateMachine a owl:ObjectProperty ; rdfs:comment "Resource -> StateMachine." .
aap:smState a owl:ObjectProperty ; rdfs:comment "StateMachine -> State: the declared state universe." .
aap:stateAttribute a owl:DatatypeProperty ; rdfs:comment "state_attribute (ash_state_machine.ex:90), default state." .
aap:initialState a owl:ObjectProperty ; rdfs:comment "initial_states member (ash_state_machine.ex:95, required)." .
aap:defaultInitialState a owl:ObjectProperty ; rdfs:comment "default_initial_state (ash_state_machine.ex:100); must be an initialState." .
aap:extraState a owl:ObjectProperty ; rdfs:comment "extra_states member (ash_state_machine.ex:83)." .
aap:deprecatedState a owl:ObjectProperty ; rdfs:comment "deprecated_states member (ash_state_machine.ex:76)." .
aap:terminalState a owl:ObjectProperty ; rdfs:comment "Pack-level assertion: no outgoing transitions. Not an Ash option." .
aap:a2aLifecycle a owl:DatatypeProperty ; rdfs:comment "true: machine is the A2A task lifecycle; names must be in AshA2A.TaskLifecycle.states/0." .

aap:smTransition a owl:ObjectProperty ; rdfs:comment "StateMachine -> Transition." .
aap:viaAction a owl:DatatypeProperty ; rdfs:comment "transition :action (ash_state_machine.ex:29); '*' = any update action." .
aap:fromAny a owl:DatatypeProperty ; rdfs:comment "true: from: :*" .
aap:toAny a owl:DatatypeProperty ; rdfs:comment "true: to: :*" .
aap:transitionTarget a owl:ObjectProperty ;
  rdfs:comment "Emit change transition_state(target) scoped to viaAction (builtin_changes.ex:13). Requires single concrete target." .

# DUAL USE (E1): L13 aap:Transition -> aap:State node (from:/to: member, ash_state_machine.ex:35,41);
# L20 aap:TransitionCase carries a raw Elixir term literal (e.g. ":open"). Kind-neutral rdf:Property.
aap:fromState a rdf:Property ;
  rdfs:comment "L13: aap:Transition -> aap:State node (transition from: member). L20: aap:TransitionCase -> raw Elixir term literal; seedInput must put the resource in this state." .
aap:toState a rdf:Property ;
  rdfs:comment "L13: aap:Transition -> aap:State node (transition to: member). L20: aap:TransitionCase -> raw Elixir term literal." .

