---
to: "lib/{{ app_path }}/{{ endpoint_file }}.ex"
force: true
for_each: "endpoints"
sparql:
  endpoints: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?endpoint_module ?endpoint_file ?domain_module ?app_path ?port ?ip ?forward_path ?push ?extended_card WHERE {
      ?e a aap:Endpoint ; aap:endpointModule ?endpoint_module ; aap:endpointFile ?endpoint_file ;
         aap:endpointDomain ?d ; aap:endpointPort ?port .
      ?d aap:moduleName ?domain_module ; aap:appPath ?app_path .
      OPTIONAL { ?e aap:endpointIp ?ip }
      OPTIONAL { ?e aap:endpointForwardPath ?forward_path }
      OPTIONAL { ?e aap:endpointPushNotifications ?push }
      OPTIONAL { ?e aap:endpointExtendedCard ?extended_card }
    } ORDER BY ?endpoint_module
  agents: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?endpoint_module ?agent_module WHERE {
      ?e a aap:Endpoint ; aap:endpointModule ?endpoint_module ; aap:endpointAgent ?a .
      ?a aap:moduleName ?agent_base .
      BIND ( IF(EXISTS { ?a aap:agentConfigured "true" }, CONCAT(?agent_base, ".Configured"), ?agent_base) AS ?agent_module )
    } ORDER BY ?endpoint_module ?agent_module
---
# GENERATED by ash-a2a-app-pack (L17 Plug/Bandit endpoint) from the application ontology. Do not hand-edit.
{% set my_agents = agents | filter(attribute="endpoint_module", value=endpoint_module) -%}
defmodule {{ endpoint_module }}.Router do
  @moduledoc false
  use Plug.Router

  plug :match
  plug :dispatch

  forward {{ forward_path | default(value="/") | json_encode | safe }},
    to: AshA2A.Domain.Router,
    init_opts: [
      domain: {{ domain_module }}
{%- if push | default(value="") != "" %},
      push_notifications: {{ push }}
{%- endif %}
{%- if extended_card | default(value="") != "" %},
      extended_card: {{ extended_card | safe }}
{%- endif %}
    ]
end

defmodule {{ endpoint_module }} do
  @moduledoc false
  use Supervisor

  def start_link(opts \\ []), do: Supervisor.start_link(__MODULE__, opts, name: __MODULE__)

  @impl Supervisor
  def init(opts) do
    port = Keyword.get(opts, :port, {{ port }})

    children = [
      {AshA2A.Protocol.AgentSupervisor, agents: [{% for a in my_agents %}{{ a.agent_module }}{% if not loop.last %}, {% endif %}{% endfor %}]},
      {Bandit, plug: {{ endpoint_module }}.Router, port: port, ip: {% if ip | default(value="loopback") == "any" %}:any{% else %}:loopback{% endif %}}
    ]

    Supervisor.init(children, strategy: :rest_for_one)
  end
end
