---
to: "lib/{{ app_path }}/{{ domain_file }}_l10.ex"
force: true
for_each: "domains"
sparql:
  domains: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?domain_file ?description ?timeout ?trace_name ?require_actor
           ?authorize ?allow_unregistered WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:appPath ?app_path ;
         aap:domainFile ?domain_file .
      OPTIONAL { ?d aap:domainDescription ?description }
      OPTIONAL { ?d aap:domainTimeout ?timeout }
      OPTIONAL { ?d aap:traceName ?trace_name }
      OPTIONAL { ?d aap:requireActor ?require_actor }
      OPTIONAL { ?d aap:authorize ?authorize }
      OPTIONAL { ?d aap:allowUnregistered ?allow_unregistered }
      FILTER ( BOUND(?description) || BOUND(?timeout) || BOUND(?trace_name) || BOUND(?require_actor)
               || BOUND(?authorize) || BOUND(?allow_unregistered)
               || EXISTS { ?i aap:interfaceOfDomain ?d } || EXISTS { ?m aap:mountOf ?d } )
    } ORDER BY ?module_name
  refs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?domain_module ?resource_module ?res_namespace WHERE {
      { ?i a aap:CodeInterface ; aap:interfaceOfDomain ?d ; aap:forResource ?r . }
      UNION
      { ?i a aap:CalculationInterface ; aap:interfaceOfDomain ?d ; aap:forResource ?r . }
      ?d aap:moduleName ?domain_module .
      ?r aap:moduleName ?resource_module .
      OPTIONAL { ?r aap:domainResourceNamespace ?res_namespace }
    } ORDER BY ?domain_module ?resource_module
  defs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?domain_module ?resource_module ?name ?action ?args ?get ?get_by ?get_by_identity
           ?not_found ?require_ref ?exclude ?functions ?namespace ?default_options WHERE {
      ?i a aap:CodeInterface ; aap:interfaceOfDomain ?d ; aap:forResource ?r ; aap:name ?name .
      ?d aap:moduleName ?domain_module .
      ?r aap:moduleName ?resource_module .
      OPTIONAL { ?i aap:ofAction ?action }
      OPTIONAL { ?i aap:interfaceArgs ?args }
      OPTIONAL { ?i aap:get ?get }
      OPTIONAL { ?i aap:getBy ?get_by }
      OPTIONAL { ?i aap:getByIdentity ?get_by_identity }
      OPTIONAL { ?i aap:notFoundError ?not_found }
      OPTIONAL { ?i aap:requireReference ?require_ref }
      OPTIONAL { ?i aap:excludeInputs ?exclude }
      OPTIONAL { ?i aap:functions ?functions }
      OPTIONAL { ?i aap:interfaceNamespace ?namespace }
      OPTIONAL { ?i aap:defaultOptions ?default_options }
    } ORDER BY ?domain_module ?resource_module ?name
  calcs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?domain_module ?resource_module ?name ?calculation ?args ?exclude ?namespace WHERE {
      ?i a aap:CalculationInterface ; aap:interfaceOfDomain ?d ; aap:forResource ?r ; aap:name ?name .
      ?d aap:moduleName ?domain_module .
      ?r aap:moduleName ?resource_module .
      OPTIONAL { ?i aap:calculation ?calculation }
      OPTIONAL { ?i aap:calcArgs ?args }
      OPTIONAL { ?i aap:excludeInputs ?exclude }
      OPTIONAL { ?i aap:interfaceNamespace ?namespace }
    } ORDER BY ?domain_module ?resource_module ?name
  mounts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?domain_module ?agent_module ?path ?binding ?tenant ?protocol_version WHERE {
      ?m a aap:Mount ; aap:mountOf ?d ; aap:mountAgent ?a ; aap:mountPath ?path .
      ?d aap:moduleName ?domain_module .
      ?a aap:moduleName ?agent_module .
      FILTER NOT EXISTS { ?d aap:a2aConfigured "true" }
      OPTIONAL { ?m aap:mountBinding ?binding }
      OPTIONAL { ?m aap:mountTenant ?tenant }
      OPTIONAL { ?m aap:mountProtocolVersion ?protocol_version }
    } ORDER BY ?domain_module ?path
---
# GENERATED by ash-a2a-app-pack (lane L10) from the application ontology. Do not hand-edit.
{% set my_refs = refs | filter(attribute="domain_module", value=module_name) -%}
{% set my_defs = defs | filter(attribute="domain_module", value=module_name) -%}
{% set my_calcs = calcs | filter(attribute="domain_module", value=module_name) -%}
{% set my_mounts = mounts | filter(attribute="domain_module", value=module_name) -%}
defmodule {{ module_name }}.L10 do
  use Spark.Dsl.Fragment, of: Ash.Domain, extensions: [AshA2A.Domain]
{%- if description | default(value="") != "" %}

  domain do
    description("{{ description }}")
  end
{%- endif %}
{%- if timeout | default(value="") != "" or trace_name | default(value="") != "" %}

  execution do
{%- if timeout | default(value="") != "" %}
    timeout({% if timeout == "infinity" %}:infinity{% else %}{{ timeout }}{% endif %})
{%- endif %}
{%- if trace_name | default(value="") != "" %}
    trace_name("{{ trace_name }}")
{%- endif %}
  end
{%- endif %}
{%- if require_actor | default(value="") != "" or authorize | default(value="") != "" %}

  authorization do
{%- if require_actor | default(value="") != "" %}
    require_actor?({{ require_actor }})
{%- endif %}
{%- if authorize | default(value="") != "" %}
    authorize(:{{ authorize }})
{%- endif %}
  end
{%- endif %}
{%- if my_refs | length > 0 or allow_unregistered | default(value="") != "" %}

  resources do
{%- if allow_unregistered | default(value="") != "" %}
    allow_unregistered?({{ allow_unregistered }})
{%- endif %}
{%- for ref in my_refs %}
{%- set rdefs = my_defs | filter(attribute="resource_module", value=ref.resource_module) %}
{%- set rcalcs = my_calcs | filter(attribute="resource_module", value=ref.resource_module) %}
    resource {{ ref.resource_module }} do
{%- if ref.res_namespace | default(value="") != "" %}
      namespace({{ ref.res_namespace }})
{%- endif %}
{%- for d in rdefs %}
      define :{{ d.name }}
{%- if d.action | default(value="") != "" %}, action: :{{ d.action }}{% endif %}
{%- if d.args | default(value="") != "" %}, args: [{% for t in d.args | split(pat=",") %}{% if t is starting_with("?") %}{:optional, :{{ t | trim_start_matches(pat="?") }}}{% else %}:{{ t }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if d.get | default(value="") != "" %}, get?: {{ d.get }}{% endif %}
{%- if d.get_by | default(value="") != "" %}, get_by: [{% for t in d.get_by | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if d.get_by_identity | default(value="") != "" %}, get_by_identity: :{{ d.get_by_identity }}{% endif %}
{%- if d.not_found | default(value="") != "" %}, not_found_error?: {{ d.not_found }}{% endif %}
{%- if d.require_ref | default(value="") != "" %}, require_reference?: {{ d.require_ref }}{% endif %}
{%- if d.exclude | default(value="") != "" %}, exclude_inputs: [{% for t in d.exclude | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if d.functions | default(value="") != "" %}, functions: [{% for t in d.functions | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if d.namespace | default(value="") != "" %}, namespace: {{ d.namespace }}{% endif %}
{%- if d.default_options | default(value="") != "" %}, default_options: {{ d.default_options }}{% endif %}
{%- endfor %}
{%- for c in rcalcs %}
      define_calculation :{{ c.name }}
{%- if c.calculation | default(value="") != "" %}, calculation: :{{ c.calculation }}{% endif %}
{%- if c.args | default(value="") != "" %}, args: [{% for t in c.args | split(pat=",") %}{% set p = t | split(pat=":") %}{% if p | length == 2 %}{:{{ p[0] }}, :{{ p[1] }}}{% else %}:{{ t }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if c.exclude | default(value="") != "" %}, exclude_inputs: [{% for t in c.exclude | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if c.namespace | default(value="") != "" %}, namespace: {{ c.namespace }}{% endif %}
{%- endfor %}
    end
{%- endfor %}
  end
{%- endif %}
{%- if my_mounts | length > 0 %}

  transport do
{%- for m in my_mounts %}
    mount agent: {{ m.agent_module }}, path: "{{ m.path }}", binding: :{{ m.binding | default(value="jsonrpc") }}
{%- if m.tenant | default(value="") != "" %}, tenant: "{{ m.tenant }}"{% endif %}
{%- if m.protocol_version | default(value="") != "" %}, protocol_version: "{{ m.protocol_version }}"{% endif %}
{%- endfor %}
  end
{%- endif %}
end
