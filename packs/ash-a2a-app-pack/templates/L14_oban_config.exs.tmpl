---
to: "config/L14_oban.exs"
force: true
sparql:
  app: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?app_name ?repo ?engine ?notifier ?prefix ?testing ?pro ?extra_plugins WHERE {
      ?p a aap:Project ; aap:appName ?app_name .
      ?c a aap:ObanConfig ; aap:obConfigOf ?p ; aap:obRepo ?repo .
      OPTIONAL { ?c aap:obEngine ?engine }
      OPTIONAL { ?c aap:obNotifier ?notifier }
      OPTIONAL { ?c aap:obPrefix ?prefix }
      OPTIONAL { ?c aap:obTestingMode ?testing }
      OPTIONAL { ?c aap:obPro ?pro }
      OPTIONAL { ?c aap:obExtraPlugins ?extra_plugins }
    }
  queues: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?q_name ?q_limit WHERE {
      ?q a aap:ObanQueue ; aap:obQueueName ?q_name ; aap:obQueueLimit ?q_limit .
    } ORDER BY ?q_name
---
# GENERATED by ash-a2a-app-pack lane L14 from the application ontology. Do not hand-edit.
# Coordinator: add `import_config "L14_oban.exs"` to config/config.exs (after `import Config`).
import Config
{% if app | length > 0 %}
{%- set a = app[0] %}
{%- if a.pro | default(value="") != "" %}
config :ash_oban, pro?: {{ a.pro }}
{% endif %}
config :{{ a.app_name }}, Oban,
{%- if a.engine | default(value="") != "" %}
  engine: {{ a.engine }},
{%- endif %}
{%- if a.notifier | default(value="") != "" %}
  notifier: {{ a.notifier }},
{%- endif %}
{%- if a.prefix | default(value="") != "" %}
  prefix: "{{ a.prefix }}",
{%- endif %}
  repo: {{ a.repo }},
  plugins: [{Oban.Plugins.Cron, []}{% if a.extra_plugins | default(value="") != "" %}, {{ a.extra_plugins }}{% endif %}],
  queues: [{% for q in queues %}{{ q.q_name }}: {{ q.q_limit }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- if a.testing | default(value="") != "" %}

if config_env() == :test do
  config :{{ a.app_name }}, Oban, testing: :{{ a.testing }}
end
{%- endif %}
{% endif %}
