---
to: "lib/{{ app_path }}/reactors/steps/{{ reactor_file }}_{{ step_name }}.ex"
force: true
for_each: "gsteps"
sparql:
  gsteps: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?reactor_file ?step_name ?impl_name ?compensate ?undo
           ?run_body ?compensate_body ?undo_body WHERE {
      ?d aap:reactor ?r ; aap:appPath ?app_path .
      ?r a aap:Reactor ; aap:moduleName ?module_name ; aap:reactorFile ?reactor_file ;
         aap:reactorStep ?s .
      ?s aap:stepKind "step" ; aap:stepGenerate "true" ; aap:name ?step_name ; aap:stepImplName ?impl_name .
      OPTIONAL { ?s aap:stepHasCompensate ?compensate }
      OPTIONAL { ?s aap:stepHasUndo ?undo }
      OPTIONAL { ?s aap:stepRunBody ?run_body }
      OPTIONAL { ?s aap:stepCompensateBody ?compensate_body }
      OPTIONAL { ?s aap:stepUndoBody ?undo_body }
    } ORDER BY ?module_name ?step_name
---
{#- Mirrors ash-extension-pack reactor_step.ex.tmpl (run/3 + compensate/4 only when declared),
    adds undo/4 (reactor/lib/reactor/step.ex callbacks). Domain behavior comes only from the
    aap:step*Body facts; with none declared run/3 returns the arguments deterministically. -#}
# GENERATED by ash-a2a-app-pack lane L15 from the application ontology. Do not hand-edit.
defmodule {{ module_name }}.Steps.{{ impl_name }} do
  @moduledoc """
  Reactor step `:{{ step_name }}` of `{{ module_name }}`.
  """
  use Reactor.Step

  @impl true
  def run(arguments, _context, _options) do
{%- if run_body %}
    {{ run_body }}
{%- else %}
    {:ok, %{step: :{{ step_name }}, arguments: arguments}}
{%- endif %}
  end
{% if compensate and compensate == "true" %}
  @impl true
  def compensate(_reason, _arguments, _context, _options) do
{%- if compensate_body %}
    {{ compensate_body }}
{%- else %}
    :ok
{%- endif %}
  end
{% endif %}
{%- if undo and undo == "true" %}
  @impl true
  def undo(_value, _arguments, _context, _options) do
{%- if undo_body %}
    {{ undo_body }}
{%- else %}
    :ok
{%- endif %}
  end
{% endif %}
end
