---
to: "lib/{{ app_path }}/{{ resource_file }}_l10.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?resource_file ?define_flag ?ci_domain ?ci_namespace WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file .
      ?d aap:appPath ?app_path .
      OPTIONAL { ?r aap:defineInterface ?define_flag }
      OPTIONAL { ?r aap:interfaceDomain ?cd . ?cd aap:moduleName ?ci_domain }
      OPTIONAL { ?r aap:resourceInterfaceNamespace ?ci_namespace }
      FILTER ( EXISTS { ?i aap:interfaceOf ?r } || BOUND(?define_flag) || BOUND(?ci_domain) || BOUND(?ci_namespace) )
    } ORDER BY ?module_name
  defs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?name ?action ?args ?get ?get_by ?get_by_identity ?not_found ?require_ref
           ?exclude ?functions ?namespace ?default_options WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name .
      ?i a aap:CodeInterface ; aap:interfaceOf ?r ; aap:name ?name .
      OPTIONAL { ?i aap:ofAction ?action }
      OPTIONAL { ?i aap:interfaceArgs ?args }
      OPTIONAL { ?i aap:get ?get }
      OPTIONAL { ?i aap:getBy ?get_by }
      OPTIONAL { ?i aap:getByIdentity ?get_by_identity }
      OPTIONAL { ?i aap:notFoundError ?not_found }
      OPTIONAL { ?i aap:requireReference ?require_ref }
      OPTIONAL { ?i aap:excludeInputs ?exclude }
      OPTIONAL { ?i aap:functions ?functions }
      OPTIONAL { ?i aap:interfaceNamespace ?namespace }
      OPTIONAL { ?i aap:defaultOptions ?default_options }
    } ORDER BY ?module_name ?name
  calcs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?name ?calculation ?args ?exclude ?namespace WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name .
      ?i a aap:CalculationInterface ; aap:interfaceOf ?r ; aap:name ?name .
      OPTIONAL { ?i aap:calculation ?calculation }
      OPTIONAL { ?i aap:calcArgs ?args }
      OPTIONAL { ?i aap:excludeInputs ?exclude }
      OPTIONAL { ?i aap:interfaceNamespace ?namespace }
    } ORDER BY ?module_name ?name
---
# GENERATED by ash-a2a-app-pack (lane L10) from the application ontology. Do not hand-edit.
{% set my_defs = defs | filter(attribute="module_name", value=module_name) -%}
{% set my_calcs = calcs | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.L10 do
  use Spark.Dsl.Fragment, of: Ash.Resource

  code_interface do
{%- if ci_domain | default(value="") != "" %}
    domain({{ ci_domain }})
{%- endif %}
{%- if define_flag | default(value="") != "" %}
    define?({{ define_flag }})
{%- endif %}
{%- if ci_namespace | default(value="") != "" %}
    namespace({{ ci_namespace }})
{%- endif %}
{%- for d in my_defs %}
    define :{{ d.name }}
{%- if d.action | default(value="") != "" %}, action: :{{ d.action }}{% endif %}
{%- if d.args | default(value="") != "" %}, args: [{% for t in d.args | split(pat=",") %}{% if t is starting_with("?") %}{:optional, :{{ t | trim_start_matches(pat="?") }}}{% else %}:{{ t }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if d.get | default(value="") != "" %}, get?: {{ d.get }}{% endif %}
{%- if d.get_by | default(value="") != "" %}, get_by: [{% for t in d.get_by | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if d.get_by_identity | default(value="") != "" %}, get_by_identity: :{{ d.get_by_identity }}{% endif %}
{%- if d.not_found | default(value="") != "" %}, not_found_error?: {{ d.not_found }}{% endif %}
{%- if d.require_ref | default(value="") != "" %}, require_reference?: {{ d.require_ref }}{% endif %}
{%- if d.exclude | default(value="") != "" %}, exclude_inputs: [{% for t in d.exclude | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if d.functions | default(value="") != "" %}, functions: [{% for t in d.functions | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if d.namespace | default(value="") != "" %}, namespace: {{ d.namespace }}{% endif %}
{%- if d.default_options | default(value="") != "" %}, default_options: {{ d.default_options }}{% endif %}
{%- endfor %}
{%- for c in my_calcs %}
    define_calculation :{{ c.name }}
{%- if c.calculation | default(value="") != "" %}, calculation: :{{ c.calculation }}{% endif %}
{%- if c.args | default(value="") != "" %}, args: [{% for t in c.args | split(pat=",") %}{% set p = t | split(pat=":") %}{% if p | length == 2 %}{:{{ p[0] }}, :{{ p[1] }}}{% else %}:{{ t }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if c.exclude | default(value="") != "" %}, exclude_inputs: [{% for t in c.exclude | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if c.namespace | default(value="") != "" %}, namespace: {{ c.namespace }}{% endif %}
{%- endfor %}
  end
end
