---
to: "lib/{{ app_path }}/data_layer_setup_l09.ex"
force: true
for_each: "projects"
sparql:
  projects: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?app_module ?app_name ?app_path WHERE {
      ?p a aap:Project ; aap:appModule ?app_module ; aap:appName ?app_name ; aap:setupAppPath ?app_path .
    }
  mnesia: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?domain_module ?module_name WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ; aap:dataLayer "mnesia" .
      ?d aap:moduleName ?domain_module .
    } ORDER BY ?domain_module ?module_name
  repos: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?repo_kind WHERE {
      ?rp a aap:Repo ; aap:moduleName ?module_name ; aap:repoKind ?repo_kind .
    } ORDER BY ?module_name
---
# GENERATED by ash-a2a-app-pack (L09) from the application ontology. Do not hand-edit.
defmodule {{ app_module }}.DataLayerSetup do
  @moduledoc """
  Data layer bootstrap projected from the ontology: Mnesia table creation and
  release-time Ecto migrations for every declared repo.
  """

  @repos [{% for r in repos %}{{ r.module_name }}{% if not loop.last %}, {% endif %}{% endfor %}]

  def repos, do: @repos

  @doc "Creates the Mnesia schema and tables for every mnesia resource."
  def start_mnesia do
{%- if mnesia | length == 0 %}
    :ok
{%- else %}
{%- for m in mnesia %}
    Ash.DataLayer.Mnesia.start({{ m.domain_module }}, [{{ m.module_name }}])
{%- endfor %}
    :ok
{%- endif %}
  end

  @doc "Runs all pending migrations for every repo (release task)."
  def migrate do
    Application.load(:{{ app_name }})

    for repo <- @repos do
      {:ok, _, _} = Ecto.Migrator.with_repo(repo, &Ecto.Migrator.run(&1, :up, all: true))
    end

    :ok
  end

  @doc "Rolls back one migration on the given repo."
  def rollback(repo, version) do
    {:ok, _, _} = Ecto.Migrator.with_repo(repo, &Ecto.Migrator.run(&1, :down, to: version))
    :ok
  end
end
