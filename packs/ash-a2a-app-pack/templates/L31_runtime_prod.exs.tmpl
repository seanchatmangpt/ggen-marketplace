---
to: "config/runtime.exs"
force: true
sparql:
  prof: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?key_env ?outbox_env ?claim_env WHERE {
      ?p a aap:Project ; aap:profile ?profile ; aap:keyEnv ?key_env ; aap:outboxDirEnv ?outbox_env .
      FILTER(STR(?profile) = "strict")
      OPTIONAL { ?p aap:claimStoreDirEnv ?claim_env }
    }
---
# GENERATED by ash-a2a-app-pack (L31). Do not hand-edit.
import Config
{%- for s in prof %}

if config_env() == :prod do
  key =
    System.get_env("{{ s.key_env }}") ||
      raise "environment variable {{ s.key_env }} is missing (receipt HMAC key, >= 32 bytes)"

  if byte_size(key) < 32, do: raise("{{ s.key_env }} must be at least 32 bytes")

  config :ash_a2a,
    receipt_outbox_key: key,
    receipt_outbox_dir:
      System.get_env("{{ s.outbox_env }}") ||
        raise("environment variable {{ s.outbox_env }} is missing (durable receipt outbox dir)")
{%- if s.claim_env | default(value="") != "" %}

  config :ash_a2a,
    claim_store_dir:
      System.get_env("{{ s.claim_env }}") ||
        raise("environment variable {{ s.claim_env }} is missing (durable claim store dir)")
{%- endif %}
end
{%- endfor %}
