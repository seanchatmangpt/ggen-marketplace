---
to: "config/l10_ash.exs"
force: true
sparql:
  app: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?app_name WHERE { ?p a aap:Project ; aap:appName ?app_name . }
  domains: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name .
      OPTIONAL { ?d aap:validateConfigInclusion ?vci }
      FILTER ( !BOUND(?vci) || STR(?vci) != "false" )
    } ORDER BY ?module_name
---
# GENERATED by ash-a2a-app-pack (lane L10) from the application ontology. Do not hand-edit.
# Multi-domain ash_domains list; domains with aap:validateConfigInclusion "false" are omitted
# (they must also say `use Ash.Domain, validate_config_inclusion?: false`).
import Config

config :{{ app[0].app_name }},
  ash_domains: [{% for d in domains %}{{ d.module_name }}{% if not loop.last %}, {% endif %}{% endfor %}]
