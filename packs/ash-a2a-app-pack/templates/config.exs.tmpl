---
to: "config/config.exs"
force: true
sparql:
  app: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?app_name ?security_profile WHERE {
      ?p a aap:Project ; aap:appName ?app_name .
      OPTIONAL { ?p aap:securityProfile ?security_profile }
    }
  domains: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name .
      OPTIONAL { ?d aap:validateConfigInclusion ?vci }
      FILTER ( !BOUND(?vci) || STR(?vci) != "false" )
    } ORDER BY ?module_name
  agents: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name WHERE { ?a a aap:Agent ; aap:moduleName ?module_name . } ORDER BY ?module_name
  repos: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?repo_kind ?db_name ?pool_size WHERE {
      ?rp a aap:Repo ; aap:moduleName ?module_name ; aap:repoKind ?repo_kind .
      OPTIONAL { ?rp aap:dbName ?db_name }
      OPTIONAL { ?rp aap:poolSize ?pool_size }
    } ORDER BY ?module_name
  oban: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?repo ?engine ?notifier ?prefix ?testing ?pro ?extra_plugins WHERE {
      ?p a aap:Project .
      ?c a aap:ObanConfig ; aap:obConfigOf ?p ; aap:obRepo ?repo .
      OPTIONAL { ?c aap:obEngine ?engine }
      OPTIONAL { ?c aap:obNotifier ?notifier }
      OPTIONAL { ?c aap:obPrefix ?prefix }
      OPTIONAL { ?c aap:obTestingMode ?testing }
      OPTIONAL { ?c aap:obPro ?pro }
      OPTIONAL { ?c aap:obExtraPlugins ?extra_plugins }
    }
  queues: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?q_name ?q_limit WHERE {
      ?q a aap:ObanQueue ; aap:obQueueName ?q_name ; aap:obQueueLimit ?q_limit .
    } ORDER BY ?q_name
  hooks: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?hook_id ?hook_module ?hook_fun WHERE {
      ?p a aap:Project ; aap:dispatchHook ?h .
      ?h aap:hookId ?hook_id ; aap:hookModule ?hook_module ; aap:hookFun ?hook_fun .
    } ORDER BY ?hook_id
---
# GENERATED by ash-a2a-app-pack from the application ontology. Do not hand-edit.
# Lane config (L09 repos, L10 ash_domains, L14 Oban, L17 dispatch hooks) is inlined from the
# graph; no import_config of lane files, so absent files can never break the build.
import Config
{%- set a = app[0] %}

config :ash, default_string_length_count: :codepoints

config :{{ a.app_name }},
  ash_domains: [{% for d in domains %}{{ d.module_name }}{% if not loop.last %}, {% endif %}{% endfor %}]

config :ash_a2a, :agents, [{% for a2 in agents %}{{ a2.module_name }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- if repos | length > 0 %}

config :{{ a.app_name }}, ecto_repos: [{% for r in repos %}{{ r.module_name }}{% if not loop.last %}, {% endif %}{% endfor %}]
{% for r in repos %}
{%- if r.repo_kind == "postgres" %}
if config_env() in [:dev, :test] do
  config :{{ a.app_name }}, {{ r.module_name }},
    username: "postgres",
    password: "postgres",
    hostname: "localhost",
    database: "{{ r.db_name | default(value=a.app_name) }}_#{config_env()}",
    pool_size: {{ r.pool_size | default(value="10") }}
end
{% else %}
if config_env() in [:dev, :test] do
  config :{{ a.app_name }}, {{ r.module_name }},
    database: "priv/{{ r.db_name | default(value=a.app_name) }}_#{config_env()}.sqlite3",
    pool_size: {{ r.pool_size | default(value="5") }}
end
{% endif %}
{%- endfor %}
{%- endif %}
{%- if oban | length > 0 %}
{%- set o = oban[0] %}
{%- if o.pro | default(value="") != "" %}

config :ash_oban, pro?: {{ o.pro }}
{%- endif %}

config :{{ a.app_name }}, Oban,
{%- if o.engine | default(value="") != "" %}
  engine: {{ o.engine }},
{%- endif %}
{%- if o.notifier | default(value="") != "" %}
  notifier: {{ o.notifier }},
{%- endif %}
{%- if o.prefix | default(value="") != "" %}
  prefix: "{{ o.prefix }}",
{%- endif %}
  repo: {{ o.repo }},
  plugins: [{Oban.Plugins.Cron, []}{% if o.extra_plugins | default(value="") != "" %}, {{ o.extra_plugins }}{% endif %}],
  queues: [{% for q in queues %}{{ q.q_name }}: {{ q.q_limit }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- if o.testing | default(value="") != "" %}

if config_env() == :test do
  config :{{ a.app_name }}, Oban, testing: :{{ o.testing }}
end
{%- endif %}
{%- endif %}
{%- if hooks | length > 0 %}

config :ash_a2a, :dispatch_hooks, %{
{%- for h in hooks %}
  {{ h.hook_id }}: { {{ h.hook_module }}, :{{ h.hook_fun }} }{% if not loop.last %},{% endif %}
{%- endfor %}
}
{%- endif %}

{% if a.security_profile | default(value="") != "" -%}
# Project declares aap:securityProfile; applied in every environment.
config :ash_a2a, :security_profile, :{{ a.security_profile }}
{%- else -%}
# Strict (default) outside dev/test: production supplies durable stores/keys (ash_a2a
# docs/reference/configuration.md). Deps compile under :prod where :dev_bypass is compiled
# out, so :legacy_compat is the documented dev/test profile.
if config_env() in [:dev, :test] do
  config :ash_a2a, :security_profile, :legacy_compat
end
{%- endif %}
