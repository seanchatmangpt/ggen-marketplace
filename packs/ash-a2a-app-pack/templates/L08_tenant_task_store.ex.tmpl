---
to: "lib/{{ store_app_path }}/{{ store_file }}.ex"
force: true
for_each: "stores"
sparql:
  stores: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?store_module ?store_file ?store_app_path ?store_ns WHERE {
      ?s a aap:TenantTaskStore ; aap:taskStoreModule ?store_module ;
         aap:taskStoreFile ?store_file ; aap:taskStoreAppPath ?store_app_path ;
         aap:taskStoreNamespace ?store_ns .
    } ORDER BY ?store_module
---
# GENERATED by ash-a2a-app-pack (L08) from the application ontology. Do not hand-edit.
defmodule {{ store_module }} do
  @moduledoc """
  Tenant-partitioned task store over `AshA2A.TaskStore.Ash`.

  `AshA2A.TaskStore.Ash` has no tenant concept (its rows carry only a `namespace`
  column holding the store `ref`, lib/ash_a2a/task_store/ash.ex:6-9), and the
  `AshA2A.Protocol.TaskStore` callbacks receive only `ref`. The only lawful seam
  is the ref: this module maps each tenant to a distinct namespace, so tenant A
  cannot read, list or delete tenant B's tasks or push configs.

  Use `task_store(tenant)` as an agent's `:task_store` option, one per tenant
  mount. A nil/empty tenant is refused (never falls into a shared namespace).
  """

  @base "{{ store_ns }}"

  @doc "Namespace string for a tenant."
  @spec namespace(String.t() | atom() | integer()) :: String.t()
  def namespace(tenant) when is_binary(tenant) and tenant != "", do: @base <> ":" <> tenant
  def namespace(tenant) when is_atom(tenant) and tenant not in [nil, true, false],
    do: namespace(Atom.to_string(tenant))

  def namespace(tenant) when is_integer(tenant), do: namespace(Integer.to_string(tenant))

  def namespace(other),
    do: raise(ArgumentError, "tenant-scoped task store requires a tenant, got: #{inspect(other)}")

  @doc "The `{module, ref}` tuple for `:task_store`, scoped to one tenant."
  @spec task_store(String.t() | atom() | integer()) :: {module(), String.t()}
  def task_store(tenant), do: AshA2A.TaskStore.Ash.task_store(namespace(tenant))
end
