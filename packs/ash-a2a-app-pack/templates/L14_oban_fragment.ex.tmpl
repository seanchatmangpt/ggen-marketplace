---
to: "lib/{{ app_path }}/{{ resource_file }}_l14_oban.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?resource_file ?ob_domain ?ob_list_tenants ?ob_shared_context ?ob_use_tenant WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file .
      ?d aap:appPath ?app_path .
      FILTER EXISTS { { ?r aap:obTrigger ?x } UNION { ?r aap:obSchedule ?x } }
      OPTIONAL { ?r aap:obDomain ?ob_domain }
      OPTIONAL { ?r aap:obListTenants ?ob_list_tenants }
      OPTIONAL { ?r aap:obSharedContext ?ob_shared_context }
      OPTIONAL { ?r aap:obUseTenantFromRecord ?ob_use_tenant }
    } ORDER BY ?module_name
  triggers: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?t_name ?t_action ?t_where ?t_sort ?t_read_action ?t_worker_read_action
           ?t_queue ?t_scheduler_queue ?t_cron ?t_worker_module ?t_scheduler_module
           ?t_max_attempts ?t_max_sched_attempts ?t_record_limit ?t_stream_batch ?t_stream_with
           ?t_state ?t_on_error ?t_on_error_fails ?t_trigger_once ?t_lock ?t_worker_prio
           ?t_sched_prio ?t_log_errors ?t_log_final ?t_use_tenant ?t_shared_context ?t_tags
           ?t_backoff ?t_timeout ?t_action_input ?t_extra_args ?t_read_metadata ?t_list_tenants
           ?t_actor_persister ?t_default_actor ?t_worker_opts ?t_debug
           ?c_size ?c_timeout ?c_by WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:obTrigger ?t .
      ?t aap:name ?t_name ; aap:obAction ?t_action .
      OPTIONAL { ?t aap:obWhere ?t_where }
      OPTIONAL { ?t aap:obSort ?t_sort }
      OPTIONAL { ?t aap:obReadAction ?t_read_action }
      OPTIONAL { ?t aap:obWorkerReadAction ?t_worker_read_action }
      OPTIONAL { ?t aap:obQueue ?t_queue }
      OPTIONAL { ?t aap:obSchedulerQueue ?t_scheduler_queue }
      OPTIONAL { ?t aap:obSchedulerCron ?t_cron }
      OPTIONAL { ?t aap:obWorkerModuleName ?t_worker_module }
      OPTIONAL { ?t aap:obSchedulerModuleName ?t_scheduler_module }
      OPTIONAL { ?t aap:obMaxAttempts ?t_max_attempts }
      OPTIONAL { ?t aap:obMaxSchedulerAttempts ?t_max_sched_attempts }
      OPTIONAL { ?t aap:obRecordLimit ?t_record_limit }
      OPTIONAL { ?t aap:obStreamBatchSize ?t_stream_batch }
      OPTIONAL { ?t aap:obStreamWith ?t_stream_with }
      OPTIONAL { ?t aap:obState ?t_state }
      OPTIONAL { ?t aap:obOnError ?t_on_error }
      OPTIONAL { ?t aap:obOnErrorFailsJob ?t_on_error_fails }
      OPTIONAL { ?t aap:obTriggerOnce ?t_trigger_once }
      OPTIONAL { ?t aap:obLockForUpdate ?t_lock }
      OPTIONAL { ?t aap:obWorkerPriority ?t_worker_prio }
      OPTIONAL { ?t aap:obSchedulerPriority ?t_sched_prio }
      OPTIONAL { ?t aap:obLogErrors ?t_log_errors }
      OPTIONAL { ?t aap:obLogFinalError ?t_log_final }
      OPTIONAL { ?t aap:obUseTenantFromRecord ?t_use_tenant }
      OPTIONAL { ?t aap:obSharedContext ?t_shared_context }
      OPTIONAL { ?t aap:obTags ?t_tags }
      OPTIONAL { ?t aap:obBackoff ?t_backoff }
      OPTIONAL { ?t aap:obTimeout ?t_timeout }
      OPTIONAL { ?t aap:obActionInput ?t_action_input }
      OPTIONAL { ?t aap:obExtraArgs ?t_extra_args }
      OPTIONAL { ?t aap:obReadMetadata ?t_read_metadata }
      OPTIONAL { ?t aap:obListTenants ?t_list_tenants }
      OPTIONAL { ?t aap:obActorPersister ?t_actor_persister }
      OPTIONAL { ?t aap:obDefaultActor ?t_default_actor }
      OPTIONAL { ?t aap:obWorkerOpts ?t_worker_opts }
      OPTIONAL { ?t aap:obDebug ?t_debug }
      OPTIONAL { ?t aap:obChunks ?c . ?c aap:obChunkSize ?c_size .
                 OPTIONAL { ?c aap:obChunkTimeout ?c_timeout }
                 OPTIONAL { ?c aap:obChunkBy ?c_by } }
    } ORDER BY ?module_name ?t_name
  schedules: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?s_name ?s_cron ?s_action ?s_queue ?s_worker_module ?s_max_attempts
           ?s_state ?s_priority ?s_tags ?s_action_input ?s_list_tenants ?s_actor_persister
           ?s_default_actor ?s_worker_opts ?s_shared_context ?s_debug WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:obSchedule ?s .
      ?s aap:name ?s_name ; aap:obCron ?s_cron ; aap:obAction ?s_action .
      OPTIONAL { ?s aap:obQueue ?s_queue }
      OPTIONAL { ?s aap:obWorkerModuleName ?s_worker_module }
      OPTIONAL { ?s aap:obMaxAttempts ?s_max_attempts }
      OPTIONAL { ?s aap:obState ?s_state }
      OPTIONAL { ?s aap:obPriority ?s_priority }
      OPTIONAL { ?s aap:obTags ?s_tags }
      OPTIONAL { ?s aap:obActionInput ?s_action_input }
      OPTIONAL { ?s aap:obListTenants ?s_list_tenants }
      OPTIONAL { ?s aap:obActorPersister ?s_actor_persister }
      OPTIONAL { ?s aap:obDefaultActor ?s_default_actor }
      OPTIONAL { ?s aap:obWorkerOpts ?s_worker_opts }
      OPTIONAL { ?s aap:obSharedContext ?s_shared_context }
      OPTIONAL { ?s aap:obDebug ?s_debug }
    } ORDER BY ?module_name ?s_name
---
# GENERATED by ash-a2a-app-pack lane L14 from the application ontology. Do not hand-edit.
{% set my_triggers = triggers | filter(attribute="module_name", value=module_name) -%}
{% set my_schedules = schedules | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.L14Oban do
  @moduledoc false
  use Spark.Dsl.Fragment, of: Ash.Resource, extensions: [AshOban]

  oban do
{%- if ob_domain | default(value="") != "" %}
    domain({{ ob_domain }})
{%- endif %}
{%- if ob_list_tenants | default(value="") != "" %}
    list_tenants({{ ob_list_tenants }})
{%- endif %}
{%- if ob_shared_context | default(value="") != "" %}
    shared_context({% if ob_shared_context == "all" %}:all{% else %}[{% for k in ob_shared_context | split(pat=",") %}:{{ k | trim }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %})
{%- endif %}
{%- if ob_use_tenant | default(value="") != "" %}
    use_tenant_from_record?({{ ob_use_tenant }})
{%- endif %}
{%- if my_triggers | length > 0 %}

    triggers do
{%- for t in my_triggers %}
      trigger :{{ t.t_name }} do
        action(:{{ t.t_action }})
{%- if t.t_where | default(value="") != "" %}
        where(expr({{ t.t_where }}))
{%- endif %}
{%- if t.t_sort | default(value="") != "" %}
        sort({{ t.t_sort }})
{%- endif %}
{%- if t.t_read_action | default(value="") != "" %}
        read_action(:{{ t.t_read_action }})
{%- endif %}
{%- if t.t_worker_read_action | default(value="") != "" %}
        worker_read_action(:{{ t.t_worker_read_action }})
{%- endif %}
{%- if t.t_queue | default(value="") != "" %}
        queue(:{{ t.t_queue }})
{%- endif %}
{%- if t.t_scheduler_queue | default(value="") != "" %}
        scheduler_queue(:{{ t.t_scheduler_queue }})
{%- endif %}
{%- if t.t_cron | default(value="") != "" %}
        scheduler_cron({% if t.t_cron == "false" %}false{% else %}"{{ t.t_cron }}"{% endif %})
{%- endif %}
{%- if t.t_worker_module | default(value="") != "" %}
        worker_module_name({{ t.t_worker_module }})
{%- endif %}
{%- if t.t_scheduler_module | default(value="") != "" %}
        scheduler_module_name({{ t.t_scheduler_module }})
{%- endif %}
{%- if t.t_max_attempts | default(value="") != "" %}
        max_attempts({{ t.t_max_attempts }})
{%- endif %}
{%- if t.t_max_sched_attempts | default(value="") != "" %}
        max_scheduler_attempts({{ t.t_max_sched_attempts }})
{%- endif %}
{%- if t.t_record_limit | default(value="") != "" %}
        record_limit({{ t.t_record_limit }})
{%- endif %}
{%- if t.t_stream_batch | default(value="") != "" %}
        stream_batch_size({{ t.t_stream_batch }})
{%- endif %}
{%- if t.t_stream_with | default(value="") != "" %}
        stream_with(:{{ t.t_stream_with }})
{%- endif %}
{%- if t.t_state | default(value="") != "" %}
        state(:{{ t.t_state }})
{%- endif %}
{%- if t.t_on_error | default(value="") != "" %}
        on_error(:{{ t.t_on_error }})
{%- endif %}
{%- if t.t_on_error_fails | default(value="") != "" %}
        on_error_fails_job?({{ t.t_on_error_fails }})
{%- endif %}
{%- if t.t_trigger_once | default(value="") != "" %}
        trigger_once?({{ t.t_trigger_once }})
{%- endif %}
{%- if t.t_lock | default(value="") != "" %}
        lock_for_update?({{ t.t_lock }})
{%- endif %}
{%- if t.t_worker_prio | default(value="") != "" %}
        worker_priority({{ t.t_worker_prio }})
{%- endif %}
{%- if t.t_sched_prio | default(value="") != "" %}
        scheduler_priority({{ t.t_sched_prio }})
{%- endif %}
{%- if t.t_log_errors | default(value="") != "" %}
        log_errors?({{ t.t_log_errors }})
{%- endif %}
{%- if t.t_log_final | default(value="") != "" %}
        log_final_error?({{ t.t_log_final }})
{%- endif %}
{%- if t.t_use_tenant | default(value="") != "" %}
        use_tenant_from_record?({{ t.t_use_tenant }})
{%- endif %}
{%- if t.t_shared_context | default(value="") != "" %}
        shared_context({% if t.t_shared_context == "all" %}:all{% else %}[{% for k in t.t_shared_context | split(pat=",") %}:{{ k | trim }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %})
{%- endif %}
{%- if t.t_tags | default(value="") != "" %}
        tags([{% for k in t.t_tags | split(pat=",") %}"{{ k | trim }}"{% if not loop.last %}, {% endif %}{% endfor %}])
{%- endif %}
{%- if t.t_backoff | default(value="") != "" %}
        backoff({% if t.t_backoff == "exponential" %}:exponential{% else %}{{ t.t_backoff }}{% endif %})
{%- endif %}
{%- if t.t_timeout | default(value="") != "" %}
        timeout({% if t.t_timeout == "infinity" %}:infinity{% else %}{{ t.t_timeout }}{% endif %})
{%- endif %}
{%- if t.t_action_input | default(value="") != "" %}
        action_input({{ t.t_action_input }})
{%- endif %}
{%- if t.t_extra_args | default(value="") != "" %}
        extra_args({{ t.t_extra_args }})
{%- endif %}
{%- if t.t_read_metadata | default(value="") != "" %}
        read_metadata({{ t.t_read_metadata }})
{%- endif %}
{%- if t.t_list_tenants | default(value="") != "" %}
        list_tenants({{ t.t_list_tenants }})
{%- endif %}
{%- if t.t_actor_persister | default(value="") != "" %}
        actor_persister({% if t.t_actor_persister == "none" %}:none{% else %}{{ t.t_actor_persister }}{% endif %})
{%- endif %}
{%- if t.t_default_actor | default(value="") != "" %}
        default_actor({{ t.t_default_actor }})
{%- endif %}
{%- if t.t_worker_opts | default(value="") != "" %}
        worker_opts({{ t.t_worker_opts }})
{%- endif %}
{%- if t.t_debug | default(value="") != "" %}
        debug?({{ t.t_debug }})
{%- endif %}
{%- if t.c_size | default(value="") != "" %}

        chunks do
          size({{ t.c_size }})
{%- if t.c_timeout | default(value="") != "" %}
          timeout({{ t.c_timeout }})
{%- endif %}
{%- if t.c_by | default(value="") != "" %}
          by([{% for k in t.c_by | split(pat=",") %}:{{ k | trim }}{% if not loop.last %}, {% endif %}{% endfor %}])
{%- endif %}
        end
{%- endif %}
      end
{%- endfor %}
    end
{%- endif %}
{%- if my_schedules | length > 0 %}

    scheduled_actions do
{%- for s in my_schedules %}
      schedule :{{ s.s_name }}, "{{ s.s_cron }}" do
        action(:{{ s.s_action }})
{%- if s.s_queue | default(value="") != "" %}
        queue(:{{ s.s_queue }})
{%- endif %}
{%- if s.s_worker_module | default(value="") != "" %}
        worker_module_name({{ s.s_worker_module }})
{%- endif %}
{%- if s.s_max_attempts | default(value="") != "" %}
        max_attempts({{ s.s_max_attempts }})
{%- endif %}
{%- if s.s_state | default(value="") != "" %}
        state(:{{ s.s_state }})
{%- endif %}
{%- if s.s_priority | default(value="") != "" %}
        priority({{ s.s_priority }})
{%- endif %}
{%- if s.s_tags | default(value="") != "" %}
        tags([{% for k in s.s_tags | split(pat=",") %}"{{ k | trim }}"{% if not loop.last %}, {% endif %}{% endfor %}])
{%- endif %}
{%- if s.s_action_input | default(value="") != "" %}
        action_input({{ s.s_action_input }})
{%- endif %}
{%- if s.s_list_tenants | default(value="") != "" %}
        list_tenants({{ s.s_list_tenants }})
{%- endif %}
{%- if s.s_actor_persister | default(value="") != "" %}
        actor_persister({% if s.s_actor_persister == "none" %}:none{% else %}{{ s.s_actor_persister }}{% endif %})
{%- endif %}
{%- if s.s_default_actor | default(value="") != "" %}
        default_actor({{ s.s_default_actor }})
{%- endif %}
{%- if s.s_worker_opts | default(value="") != "" %}
        worker_opts({{ s.s_worker_opts }})
{%- endif %}
{%- if s.s_shared_context | default(value="") != "" %}
        shared_context({% if s.s_shared_context == "all" %}:all{% else %}[{% for k in s.s_shared_context | split(pat=",") %}:{{ k | trim }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %})
{%- endif %}
{%- if s.s_debug | default(value="") != "" %}
        debug?({{ s.s_debug }})
{%- endif %}
      end
{%- endfor %}
    end
{%- endif %}
  end
end
