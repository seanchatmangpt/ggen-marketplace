---
to: "lib/{{ app_path }}/{{ resource_file }}_l06.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:l06Action ?x .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  actions: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?action_type ?accept ?primary ?transaction ?require_atomic
           ?atomic_upgrade ?public ?adesc ?returns ?constraints ?allow_nil ?run_module WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:l06Action ?a .
      ?a aap:name ?action_name ; aap:actionType ?action_type .
      OPTIONAL { ?a aap:accept ?accept }
      OPTIONAL { ?a aap:l06Primary ?primary }
      OPTIONAL { ?a aap:l06Transaction ?transaction }
      OPTIONAL { ?a aap:l06RequireAtomic ?require_atomic }
      OPTIONAL { ?a aap:l06AtomicUpgrade ?atomic_upgrade }
      OPTIONAL { ?a aap:l06Public ?public }
      OPTIONAL { ?a aap:l06Description ?adesc }
      OPTIONAL { ?a aap:l06Returns ?returns }
      OPTIONAL { ?a aap:l06Constraints ?constraints }
      OPTIONAL { ?a aap:l06AllowNil ?allow_nil }
      OPTIONAL { ?a aap:l06RunModule ?run_module }
    } ORDER BY ?module_name ?action_name
  args: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?arg_name ?arg_type ?arg_allow_nil ?arg_default ?arg_public ?arg_constraints WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:l06Action ?a .
      ?a aap:name ?action_name ; aap:l06Argument ?g .
      ?g aap:name ?arg_name ; aap:ashType ?arg_type .
      OPTIONAL { ?g aap:l06ArgAllowNil ?arg_allow_nil }
      OPTIONAL { ?g aap:l06ArgDefault ?arg_default }
      OPTIONAL { ?g aap:l06ArgPublic ?arg_public }
      OPTIONAL { ?g aap:l06ArgConstraints ?arg_constraints }
    } ORDER BY ?module_name ?action_name ?arg_name
  steps: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?step_order ?kind ?op ?attr ?rel ?value ?opts ?step_module
           ?step_where ?step_on ?only_when_valid WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:l06Action ?a .
      ?a aap:name ?action_name ; aap:l06Step ?s .
      ?s aap:l06Order ?step_order ; aap:l06Kind ?kind ; aap:l06Op ?op .
      OPTIONAL { ?s aap:l06Attr ?attr }
      OPTIONAL { ?s aap:l06Rel ?rel }
      OPTIONAL { ?s aap:l06Value ?value }
      OPTIONAL { ?s aap:l06Opts ?opts }
      OPTIONAL { ?s aap:l06Module ?step_module }
      OPTIONAL { ?s aap:l06Where ?step_where }
      OPTIONAL { ?s aap:l06On ?step_on }
      OPTIONAL { ?s aap:l06OnlyWhenValid ?only_when_valid }
    } ORDER BY ?module_name ?action_name ?step_order
---
# GENERATED by ash-a2a-app-pack lane L06 from the application ontology. Do not hand-edit.
{% set my_actions = actions | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.L06 do
  use Spark.Dsl.Fragment, of: Ash.Resource

  actions do
{%- for x in my_actions %}
{%- set my_args = args | filter(attribute="module_name", value=module_name) | filter(attribute="action_name", value=x.action_name) %}
{%- set my_steps = steps | filter(attribute="module_name", value=module_name) | filter(attribute="action_name", value=x.action_name) %}
{%- if x.action_type == "action" %}
    action :{{ x.action_name }}{% if x.returns %}, {% if x.returns is starting_with("{") %}{{ x.returns | safe }}{% else %}:{{ x.returns }}{% endif %}{% endif %} do
{%- else %}
    {{ x.action_type }} :{{ x.action_name }} do
{%- endif %}
{%- if x.adesc %}
      description("{{ x.adesc }}")
{%- endif %}
{%- if x.primary %}
      primary?({{ x.primary }})
{%- endif %}
{%- if x.public %}
      public?({{ x.public }})
{%- endif %}
{%- if x.transaction %}
      transaction?({{ x.transaction }})
{%- endif %}
{%- if x.require_atomic and (x.action_type == "update" or x.action_type == "destroy") %}
      require_atomic?({{ x.require_atomic }})
{%- endif %}
{%- if x.atomic_upgrade and x.action_type == "update" %}
      atomic_upgrade?({{ x.atomic_upgrade }})
{%- endif %}
{%- if x.action_type == "create" or x.action_type == "update" or x.action_type == "destroy" %}
{%- if x.accept %}
      accept([{% for t in x.accept | split(pat=",") %}{% if t != "" %}:{{ t }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}])
{%- endif %}
{%- endif %}
{%- if x.action_type == "action" and x.constraints %}
      constraints({{ x.constraints | safe }})
{%- endif %}
{%- if x.action_type == "action" and x.allow_nil %}
      allow_nil?({{ x.allow_nil }})
{%- endif %}
{%- for g in my_args %}
      argument(:{{ g.arg_name }}, {% if g.arg_type is starting_with("{") %}{{ g.arg_type | safe }}{% else %}:{{ g.arg_type }}{% endif %}{% if g.arg_allow_nil %}, allow_nil?: {{ g.arg_allow_nil }}{% endif %}{% if g.arg_default %}, default: {{ g.arg_default | safe }}{% endif %}{% if g.arg_public %}, public?: {{ g.arg_public }}{% endif %}{% if g.arg_constraints %}, constraints: {{ g.arg_constraints | safe }}{% endif %})
{%- endfor %}
{%- for s in my_steps %}
{%- set so = "" %}
{%- if s.step_where %}{% set so = so ~ ", where: " ~ s.step_where %}{% endif %}
{%- if s.step_on %}{% set so = so ~ ", on: " ~ s.step_on %}{% endif %}
{%- if s.only_when_valid %}{% set so = so ~ ", only_when_valid?: " ~ s.only_when_valid %}{% endif %}
{%- if s.kind == "change" %}
{%- if s.op == "set_attribute" %}
      change(set_attribute(:{{ s.attr }}, {{ s.value | safe }}{% if s.opts %}, {{ s.opts | safe }}{% endif %}){{ so | safe }})
{%- elif s.op == "set_new_attribute" %}
      change(set_new_attribute(:{{ s.attr }}, {{ s.value | safe }}){{ so | safe }})
{%- elif s.op == "atomic_update" %}
      change(atomic_update(:{{ s.attr }}, expr({{ s.value | safe }})){{ so | safe }})
{%- elif s.op == "atomic_set" %}
      change(atomic_set(:{{ s.attr }}, expr({{ s.value | safe }})){{ so | safe }})
{%- elif s.op == "increment" %}
      change(increment(:{{ s.attr }}{% if s.opts %}, {{ s.opts | safe }}{% endif %}){{ so | safe }})
{%- elif s.op == "manage_relationship" %}
      change(manage_relationship(:{{ s.attr }}, :{{ s.rel | default(value=s.attr) }}, {{ s.opts | default(value="type: :append_and_remove") | safe }}){{ so | safe }})
{%- elif s.op == "module" %}
      change({{ s.step_module }}{% if s.opts %}, {{ s.opts | safe }}{% endif %}{{ so | safe }})
{%- endif %}
{%- else %}
{%- if s.op == "build" %}
      prepare(build({{ s.value | safe }}){{ so | safe }})
{%- elif s.op == "filter" %}
      prepare(build(filter: expr({{ s.value | safe }})){{ so | safe }})
{%- elif s.op == "sort" %}
      prepare(build(sort: {{ s.value | safe }}){{ so | safe }})
{%- elif s.op == "limit" %}
      prepare(build(limit: {{ s.value | safe }}){{ so | safe }})
{%- elif s.op == "module" %}
      prepare({{ s.step_module }}{% if s.opts %}, {{ s.opts | safe }}{% endif %}{{ so | safe }})
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if x.run_module %}
      run({{ x.run_module }})
{%- endif %}
    end
{%- endfor %}
  end
end
