---
to: "lib/{{ app_path }}/{{ worker_file }}_l14.ex"
force: true
for_each: "workers"
sparql:
  workers: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?worker_module ?worker_file ?handler ?queue ?max_attempts ?snooze ?app_path WHERE {
      ?w a aap:ObanDeliveryWorker ; aap:moduleName ?worker_module ;
         aap:obWorkerFile ?worker_file ; aap:obHandlerModule ?handler ;
         aap:obQueue ?queue ; aap:inDomain ?d .
      ?d aap:appPath ?app_path .
      OPTIONAL { ?w aap:obMaxAttempts ?max_attempts }
      OPTIONAL { ?w aap:obSnoozeSeconds ?snooze }
    } ORDER BY ?worker_module
---
# GENERATED by ash-a2a-app-pack lane L14 from the application ontology. Do not hand-edit.
defmodule {{ worker_module }} do
  @moduledoc """
  Oban worker for `AshA2A.Delivery.Oban` jobs. Queue insertion is delivery only; `{{ handler }}.run/1`
  receives the job args (the `AshA2A.Delivery.Oban.payload/1` map) and returns the
  `AshA2A.CommandBus` result, which is mapped by `AshA2A.Delivery.Oban.perform_result/2`
  (in-flight claims snooze instead of burning attempts).
  """
  use Oban.Worker,
    queue: :{{ queue }},
    max_attempts: {{ max_attempts | default(value="3") }},
    unique: AshA2A.Delivery.Oban.unique_opts()

  @snooze_seconds {{ snooze | default(value="30") }}

  @impl Oban.Worker
  def perform(%Oban.Job{args: args}) do
    AshA2A.Delivery.Oban.perform_result({{ handler }}.run(args), @snooze_seconds)
  end

  @doc "Enqueue an admitted command; returns `{:ok, AshA2A.Delivery.t()}`."
  @spec enqueue(AshA2A.Command.t(), keyword()) :: {:ok, AshA2A.Delivery.t()} | {:error, term()}
  def enqueue(%AshA2A.Command{} = command, opts \\ []) do
    AshA2A.Delivery.Oban.enqueue(__MODULE__, command, opts)
  end
end
