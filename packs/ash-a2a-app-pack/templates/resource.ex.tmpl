---
to: "lib/{{ app_path }}/{{ resource_file }}.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?domain_module ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file .
      ?d aap:moduleName ?domain_module ; aap:appPath ?app_path .
    } ORDER BY ?module_name
  attributes: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?attr_name ?ash_type ?pk WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:attribute ?a .
      ?a aap:name ?attr_name ; aap:ashType ?ash_type ; aap:primaryKey ?pk .
    } ORDER BY ?module_name ?attr_name
  actions: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?action_type ?accept WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:action ?a .
      ?a aap:name ?action_name ; aap:actionType ?action_type .
      OPTIONAL { ?a aap:accept ?accept }
    } ORDER BY ?module_name ?action_name
  skills: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?skill_name ?skill_action ?skill_desc ?consequence ?lease WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skill ?s .
      ?s aap:name ?skill_name ; aap:ofAction ?skill_action ; aap:description ?skill_desc .
      OPTIONAL { ?s aap:consequence ?consequence }
      OPTIONAL { ?s aap:leaseRequired ?lease }
    } ORDER BY ?module_name ?skill_name
  frags: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?frag_ord ?lane ?frag WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name .
      { ?r aap:attrSpec ?x .
        BIND("01" AS ?frag_ord) BIND("L01" AS ?lane)
        BIND(".L01Attributes" AS ?suffix) }
      UNION
      { ?r aap:relationship ?x .
        BIND("02" AS ?frag_ord) BIND("L02" AS ?lane)
        BIND(".Relationships" AS ?suffix) }
      UNION
      { ?r aap:manage ?x .
        BIND("02" AS ?frag_ord) BIND("L02" AS ?lane)
        BIND(".Relationships" AS ?suffix) }
      UNION
      { ?r aap:calculation ?x .
        BIND("03" AS ?frag_ord) BIND("L03" AS ?lane)
        BIND(".CalculationsL03" AS ?suffix) }
      UNION
      { ?r aap:aggregate ?x .
        BIND("04" AS ?frag_ord) BIND("L04" AS ?lane)
        BIND("Aggregates" AS ?suffix) }
      UNION
      { ?r aap:identity ?x .
        BIND("05" AS ?frag_ord) BIND("L05" AS ?lane)
        BIND(".L05" AS ?suffix) }
      UNION
      { ?r aap:validation ?x .
        BIND("05" AS ?frag_ord) BIND("L05" AS ?lane)
        BIND(".L05" AS ?suffix) }
      UNION
      { ?r aap:l06Action ?x .
        BIND("06" AS ?frag_ord) BIND("L06" AS ?lane)
        BIND(".L06" AS ?suffix) }
      UNION
      { ?r aap:policy ?x .
        BIND("07" AS ?frag_ord) BIND("L07" AS ?lane)
        BIND(".L07Policies" AS ?suffix) }
      UNION
      { ?r aap:multitenancy ?x . ?x aap:tenantStrategy ?ts .
        BIND("08" AS ?frag_ord) BIND("L08" AS ?lane)
        BIND(".TenancyL08" AS ?suffix) }
      UNION
      { ?r aap:dataLayer ?x .
        BIND("09" AS ?frag_ord) BIND("L09" AS ?lane)
        BIND(".DataLayer" AS ?suffix) }
      UNION
      { ?x aap:interfaceOf ?r .
        BIND("10" AS ?frag_ord) BIND("L10" AS ?lane)
        BIND(".L10" AS ?suffix) }
      UNION
      { ?r aap:defineInterface ?x .
        BIND("10" AS ?frag_ord) BIND("L10" AS ?lane)
        BIND(".L10" AS ?suffix) }
      UNION
      { ?r aap:interfaceDomain ?x .
        BIND("10" AS ?frag_ord) BIND("L10" AS ?lane)
        BIND(".L10" AS ?suffix) }
      UNION
      { ?r aap:resourceInterfaceNamespace ?x .
        BIND("10" AS ?frag_ord) BIND("L10" AS ?lane)
        BIND(".L10" AS ?suffix) }
      UNION
      { ?r aap:pubSub ?x . ?x aap:pubSubModule ?pm .
        BIND("11" AS ?frag_ord) BIND("L11" AS ?lane)
        BIND(".L11PubSub" AS ?suffix) }
      UNION
      { ?r aap:typedAttribute ?x .
        BIND("12" AS ?frag_ord) BIND("L12" AS ?lane)
        BIND(".TypesL12" AS ?suffix) }
      UNION
      { ?r aap:stateMachine ?x .
        BIND("13" AS ?frag_ord) BIND("L13" AS ?lane)
        BIND(".StateMachine" AS ?suffix) }
      UNION
      { ?r aap:obTrigger ?x .
        BIND("14" AS ?frag_ord) BIND("L14" AS ?lane)
        BIND(".L14Oban" AS ?suffix) }
      UNION
      { ?r aap:obSchedule ?x .
        BIND("14" AS ?frag_ord) BIND("L14" AS ?lane)
        BIND(".L14Oban" AS ?suffix) }
      UNION
      { ?r aap:reactorFragment ?rf ; aap:reactorFragmentFile ?rff ; aap:reactorAction ?ra .
        BIND("15" AS ?frag_ord) BIND("L15" AS ?lane)
        BIND(STR(?rf) AS ?full) }
      UNION
      { ?r aap:skillSpec ?x .
        BIND("17" AS ?frag_ord) BIND("L17" AS ?lane)
        BIND(".A2aL17" AS ?suffix) }
      UNION
      { ?r aap:authGate ?x .
        BIND("17" AS ?frag_ord) BIND("L17" AS ?lane)
        BIND(".A2aL17" AS ?suffix) }
      UNION
      { ?r aap:leaseDurationMs ?x .
        BIND("17" AS ?frag_ord) BIND("L17" AS ?lane)
        BIND(".A2aL17" AS ?suffix) }
      UNION
      { ?r aap:hookRef ?x .
        BIND("17" AS ?frag_ord) BIND("L17" AS ?lane)
        BIND(".A2aL17" AS ?suffix) }
      UNION
      { ?r aap:semanticRequests ?x .
        BIND("17" AS ?frag_ord) BIND("L17" AS ?lane)
        BIND(".A2aL17" AS ?suffix) }
      UNION
      { ?r aap:authorizer ?x .
        BIND("17" AS ?frag_ord) BIND("L17" AS ?lane)
        BIND(".A2aL17" AS ?suffix) }
      UNION
      { ?r aap:sparkInstance ?x .
        BIND("18" AS ?frag_ord) BIND("L18" AS ?lane)
        BIND(".SparkL18" AS ?suffix) }
      BIND(COALESCE(?full, CONCAT(STR(?module_name), ?suffix)) AS ?frag)
    } ORDER BY ?module_name ?frag_ord ?frag
  notifiers: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?notifier WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name .
      { ?r aap:notifier ?n . ?n aap:moduleName ?notifier }
      UNION
      { ?r aap:simpleNotifier ?notifier }
    } ORDER BY ?module_name ?notifier
---
# GENERATED by ash-a2a-app-pack from the application ontology. Do not hand-edit.
{% set my_attrs = attributes | filter(attribute="module_name", value=module_name) -%}
{% set my_actions = actions | filter(attribute="module_name", value=module_name) -%}
{% set my_skills = skills | filter(attribute="module_name", value=module_name) -%}
{% set my_frags = frags | filter(attribute="module_name", value=module_name) -%}
{% set my_notifiers = notifiers | filter(attribute="module_name", value=module_name) -%}
{% set l09 = my_frags | filter(attribute="lane", value="L09") -%}
{% set l14 = my_frags | filter(attribute="lane", value="L14") -%}
{% set l07 = my_frags | filter(attribute="lane", value="L07") -%}
defmodule {{ module_name }} do
  use Ash.Resource,
    domain: {{ domain_module }}{% if l09 | length == 0 %},
    data_layer: Ash.DataLayer.Ets{% endif %},
    extensions: [AshA2A]{% if l07 | length > 0 %},
    authorizers: [Ash.Policy.Authorizer]{% endif %}{% if my_frags | length > 0 %},
    fragments: [{% for f in my_frags %}{{ f.frag }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}{% if my_notifiers | length > 0 %},
    simple_notifiers: [{% for n in my_notifiers %}{{ n.notifier }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}

  attributes do
{%- for a in my_attrs %}
{%- if a.pk == "true" %}
    uuid_primary_key(:{{ a.attr_name }})
{%- else %}
    attribute(:{{ a.attr_name }}, :{{ a.ash_type }}, public?: true)
{%- endif %}
{%- endfor %}
  end

  actions do
{%- for x in my_actions %}
{%- set n_same = my_actions | filter(attribute="action_type", value=x.action_type) | length %}
{%- if x.action_type == "read" %}
{%- if l14 | length > 0 %}
    read :{{ x.action_name }} do
{%- if n_same == 1 %}
      primary?(true)
{%- endif %}
      pagination(keyset?: true, required?: false)
    end
{%- elif n_same == 1 %}
    read :{{ x.action_name }} do
      primary?(true)
    end
{%- else %}
    read(:{{ x.action_name }})
{%- endif %}
{%- elif x.action_type == "destroy" %}
{%- if n_same == 1 %}
    destroy :{{ x.action_name }} do
      primary?(true)
    end
{%- else %}
    destroy(:{{ x.action_name }})
{%- endif %}
{%- else %}
    {{ x.action_type }} :{{ x.action_name }} do
{%- if n_same == 1 %}
      primary?(true)
{%- endif %}
      accept([{% for t in x.accept | default(value="") | split(pat=",") %}{% if t != "" %}:{{ t }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}])
    end
{%- endif %}
{%- endfor %}
  end
{%- if my_skills | length > 0 %}

  a2a do
{%- for s in my_skills %}
    skill(:{{ s.skill_name }}, :{{ s.skill_action }}, description: "{{ s.skill_desc }}"{% if s.consequence %}, consequence: :{{ s.consequence }}{% endif %}{% if s.lease %}, lease_required?: {{ s.lease }}{% endif %})
{%- endfor %}
  end
{%- endif %}
end
