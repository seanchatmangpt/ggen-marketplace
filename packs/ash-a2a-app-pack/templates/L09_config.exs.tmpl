---
to: "config/l09_data_layers.exs"
force: true
sparql:
  app: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?app_name WHERE { ?p a aap:Project ; aap:appName ?app_name . }
  repos: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?repo_kind ?db_name ?pool_size WHERE {
      ?rp a aap:Repo ; aap:moduleName ?module_name ; aap:repoKind ?repo_kind .
      OPTIONAL { ?rp aap:dbName ?db_name }
      OPTIONAL { ?rp aap:poolSize ?pool_size }
    } ORDER BY ?module_name
---
# GENERATED by ash-a2a-app-pack (L09) from the application ontology. Do not hand-edit.
# Coordinator wires: `import_config "l09_data_layers.exs"` at the end of config/config.exs.
import Config
{% if repos | length > 0 %}
config :{{ app[0].app_name }}, ecto_repos: [{% for r in repos %}{{ r.module_name }}{% if not loop.last %}, {% endif %}{% endfor %}]
{% for r in repos %}
{%- if r.repo_kind == "postgres" %}
if config_env() in [:dev, :test] do
  config :{{ app[0].app_name }}, {{ r.module_name }},
    username: "postgres",
    password: "postgres",
    hostname: "localhost",
    database: "{{ r.db_name | default(value=app[0].app_name) }}_#{config_env()}",
    pool_size: {{ r.pool_size | default(value="10") }}
end
{% else %}
if config_env() in [:dev, :test] do
  config :{{ app[0].app_name }}, {{ r.module_name }},
    database: "priv/{{ r.db_name | default(value=app[0].app_name) }}_#{config_env()}.sqlite3",
    pool_size: {{ r.pool_size | default(value="5") }}
end
{% endif %}
{%- endfor %}
{%- endif %}
