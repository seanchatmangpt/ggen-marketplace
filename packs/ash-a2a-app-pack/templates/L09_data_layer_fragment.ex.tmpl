---
to: "lib/{{ app_path }}/{{ resource_file }}_l09.ex"
force: true
for_each: "layers"
sparql:
  layers: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?resource_file ?data_layer ?table_name ?ets_private ?repo_module ?pg_schema ?migrate ?base_filter ?skip_unique ?strict WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:dataLayer ?data_layer .
      ?d aap:appPath ?app_path .
      OPTIONAL { ?r aap:tableName ?table_name }
      OPTIONAL { ?r aap:etsPrivate ?ets_private }
      OPTIONAL { ?r aap:repo ?rp . ?rp aap:moduleName ?repo_module }
      OPTIONAL { ?r aap:pgSchema ?pg_schema }
      OPTIONAL { ?r aap:migrate ?migrate }
      OPTIONAL { ?r aap:baseFilterSql ?base_filter }
      OPTIONAL { ?r aap:skipUniqueIndexes ?skip_unique }
      OPTIONAL { ?r aap:sqliteStrict ?strict }
    } ORDER BY ?module_name
  indexes: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?idx_fields ?idx_name ?idx_unique ?idx_using ?idx_where ?idx_include ?idx_nulls WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:customIndex ?i .
      ?i aap:indexFields ?idx_fields .
      OPTIONAL { ?i aap:indexName ?idx_name }
      OPTIONAL { ?i aap:indexUnique ?idx_unique }
      OPTIONAL { ?i aap:indexUsing ?idx_using }
      OPTIONAL { ?i aap:indexWhere ?idx_where }
      OPTIONAL { ?i aap:indexInclude ?idx_include }
      OPTIONAL { ?i aap:indexNullsDistinct ?idx_nulls }
    } ORDER BY ?module_name ?idx_fields
  references: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?ref_rel ?on_delete ?on_update ?fk_name ?deferrable WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:reference ?f .
      ?f aap:ofRelationship ?ref_rel .
      OPTIONAL { ?f aap:onDelete ?on_delete }
      OPTIONAL { ?f aap:onUpdate ?on_update }
      OPTIONAL { ?f aap:fkName ?fk_name }
      OPTIONAL { ?f aap:deferrable ?deferrable }
    } ORDER BY ?module_name ?ref_rel
  checks: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?chk_attr ?chk_name ?chk_expr ?chk_msg WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:checkConstraint ?c .
      ?c aap:checkAttribute ?chk_attr ; aap:checkName ?chk_name ; aap:checkExpr ?chk_expr .
      OPTIONAL { ?c aap:checkMessage ?chk_msg }
    } ORDER BY ?module_name ?chk_name
  statements: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?stmt_name ?stmt_up ?stmt_down WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:statement ?s .
      ?s aap:name ?stmt_name ; aap:stmtUp ?stmt_up ; aap:stmtDown ?stmt_down .
    } ORDER BY ?module_name ?stmt_name
---
# GENERATED by ash-a2a-app-pack (L09) from the application ontology. Do not hand-edit.
{% set my_idx = indexes | filter(attribute="module_name", value=module_name) -%}
{% set my_refs = references | filter(attribute="module_name", value=module_name) -%}
{% set my_checks = checks | filter(attribute="module_name", value=module_name) -%}
{% set my_stmts = statements | filter(attribute="module_name", value=module_name) -%}
{% if data_layer == "postgres" %}{% set layer_mod = "AshPostgres.DataLayer" %}{% set section = "postgres" %}
{%- elif data_layer == "sqlite" %}{% set layer_mod = "AshSqlite.DataLayer" %}{% set section = "sqlite" %}
{%- elif data_layer == "mnesia" %}{% set layer_mod = "Ash.DataLayer.Mnesia" %}{% set section = "mnesia" %}
{%- elif data_layer == "simple" %}{% set layer_mod = "Ash.DataLayer.Simple" %}{% set section = "" %}
{%- else %}{% set layer_mod = "Ash.DataLayer.Ets" %}{% set section = "ets" %}{% endif -%}
defmodule {{ module_name }}.DataLayer do
  @moduledoc false
  use Spark.Dsl.Fragment, of: Ash.Resource, data_layer: {{ layer_mod }}
{%- if data_layer == "ets" %}

  ets do
{%- if ets_private | default(value="") == "true" %}
    private?(true)
{%- endif %}
{%- if table_name | default(value="") != "" %}
    table(:{{ table_name }})
{%- endif %}
  end
{%- elif data_layer == "mnesia" %}
{%- if table_name | default(value="") != "" %}

  mnesia do
    table(:{{ table_name }})
  end
{%- endif %}
{%- elif data_layer == "postgres" or data_layer == "sqlite" %}

  {{ section }} do
    table("{{ table_name }}")
{%- if repo_module | default(value="") != "" %}
    repo({{ repo_module }})
{%- endif %}
{%- if data_layer == "postgres" and pg_schema | default(value="") != "" %}
    schema("{{ pg_schema }}")
{%- endif %}
{%- if migrate | default(value="") != "" %}
    migrate?({{ migrate }})
{%- endif %}
{%- if base_filter | default(value="") != "" %}
    base_filter_sql(~S|{{ base_filter | safe }}|)
{%- endif %}
{%- if data_layer == "postgres" and skip_unique | default(value="") == "true" %}
    skip_unique_indexes(true)
{%- elif data_layer == "postgres" and skip_unique | default(value="") != "" %}
    skip_unique_indexes([{% for n in skip_unique | split(pat=",") %}:{{ n | trim }}{% if not loop.last %}, {% endif %}{% endfor %}])
{%- endif %}
{%- if data_layer == "sqlite" and strict | default(value="") != "" %}
    strict?({{ strict }})
{%- endif %}
{%- if my_idx | length > 0 %}

    custom_indexes do
{%- for i in my_idx %}
      index([{% for f in i.idx_fields | split(pat=",") %}{% set ft = f | trim %}{% if ft is matching("^[a-z_][a-zA-Z0-9_]*$") %}:{{ ft }}{% else %}"{{ ft | safe }}"{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- if i.idx_name | default(value="") != "" %}, name: "{{ i.idx_name }}"{% endif %}
{%- if i.idx_unique | default(value="") != "" %}, unique: {{ i.idx_unique }}{% endif %}
{%- if data_layer == "postgres" and i.idx_using | default(value="") != "" %}, using: "{{ i.idx_using }}"{% endif %}
{%- if i.idx_where | default(value="") != "" %}, where: ~S|{{ i.idx_where | safe }}|{% endif %}
{%- if data_layer == "postgres" and i.idx_include | default(value="") != "" %}, include: [{% for f in i.idx_include | split(pat=",") %}:{{ f | trim }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if data_layer == "postgres" and i.idx_nulls | default(value="") != "" %}, nulls_distinct: {{ i.idx_nulls }}{% endif %})
{%- endfor %}
    end
{%- endif %}
{%- if my_refs | length > 0 %}

    references do
{%- for f in my_refs %}
      reference(:{{ f.ref_rel }}
{%- if f.on_delete | default(value="") != "" %}, on_delete: :{{ f.on_delete }}{% endif %}
{%- if f.on_update | default(value="") != "" %}, on_update: :{{ f.on_update }}{% endif %}
{%- if f.fk_name | default(value="") != "" %}, name: "{{ f.fk_name }}"{% endif %}
{%- if f.deferrable | default(value="") == "initially" %}, deferrable: :initially
{%- elif f.deferrable | default(value="") != "" %}, deferrable: {{ f.deferrable }}{% endif %})
{%- endfor %}
    end
{%- endif %}
{%- if data_layer == "postgres" and my_checks | length > 0 %}

    check_constraints do
{%- for c in my_checks %}
      check_constraint(:{{ c.chk_attr }}, "{{ c.chk_name }}", check: ~S|{{ c.chk_expr | safe }}|{% if c.chk_msg | default(value="") != "" %}, message: "{{ c.chk_msg }}"{% endif %})
{%- endfor %}
    end
{%- endif %}
{%- if data_layer == "postgres" and my_stmts | length > 0 %}

    custom_statements do
{%- for s in my_stmts %}
      statement :{{ s.stmt_name }} do
        up(~S|{{ s.stmt_up | safe }}|)
        down(~S|{{ s.stmt_down | safe }}|)
      end
{%- endfor %}
    end
{%- endif %}
  end
{%- endif %}
end
