---
to: "lib/{{ app_path }}/{{ resource_file }}_l03.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:calculation ?c .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  calcs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?calc_name ?ash_type ?kind ?expression ?calc_keys ?separator ?calc_module
           ?load ?public ?allow_nil ?description ?sensitive ?filterable ?sortable ?constraints WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:calculation ?c .
      ?c aap:name ?calc_name ; aap:ashType ?ash_type ; aap:calcKind ?kind .
      OPTIONAL { ?c aap:expression ?expression }
      OPTIONAL { ?c aap:calcKeys ?calc_keys }
      OPTIONAL { ?c aap:separator ?separator }
      OPTIONAL { ?c aap:calcModule ?calc_module }
      OPTIONAL { ?c aap:load ?load }
      OPTIONAL { ?c aap:public ?public }
      OPTIONAL { ?c aap:allowNil ?allow_nil }
      OPTIONAL { ?c aap:description ?description }
      OPTIONAL { ?c aap:sensitive ?sensitive }
      OPTIONAL { ?c aap:filterable ?filterable }
      OPTIONAL { ?c aap:sortable ?sortable }
      OPTIONAL { ?c aap:constraints ?constraints }
    } ORDER BY ?module_name ?calc_name
  args: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?calc_name ?arg_name ?arg_type ?arg_default ?arg_allow_nil ?arg_allow_expr ?arg_constraints ?arg_order WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:calculation ?c .
      ?c aap:name ?calc_name ; aap:calcArgument ?a .
      ?a aap:name ?arg_name ; aap:ashType ?arg_type .
      OPTIONAL { ?a aap:default ?arg_default }
      OPTIONAL { ?a aap:allowNil ?arg_allow_nil }
      OPTIONAL { ?a aap:allowExpr ?arg_allow_expr }
      OPTIONAL { ?a aap:constraints ?arg_constraints }
      OPTIONAL { ?a aap:argOrder ?arg_order }
    } ORDER BY ?module_name ?calc_name ?arg_order ?arg_name
---
# GENERATED by ash-a2a-app-pack (L03 calculations) from the application ontology. Do not hand-edit.
{% set my_calcs = calcs | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.CalculationsL03 do
  use Spark.Dsl.Fragment, of: Ash.Resource

  calculations do
{%- for c in my_calcs %}
{%- set my_args = args | filter(attribute="module_name", value=module_name) | filter(attribute="calc_name", value=c.calc_name) %}
    calculate :{{ c.calc_name }}, :{{ c.ash_type }}, {% if c.kind == "expr" %}expr({{ c.expression | default(value="nil") | safe }}){% elif c.kind == "concat" %}{Ash.Resource.Calculation.Concat, keys: [{% for k in c.calc_keys | default(value="") | split(pat=",") %}{% if k != "" %}:{{ k | trim }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]{% if c.separator %}, separator: "{{ c.separator | safe }}"{% endif %}}{% else %}{{ "{" }}{{ c.calc_module | default(value="nil") }}, keys: [{% for k in c.calc_keys | default(value="") | split(pat=",") %}{% if k != "" %}:{{ k | trim }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]{{ "}" }}{% endif %} do
{%- if c.description %}
      description "{{ c.description | safe }}"
{%- endif %}
{%- if c.public %}
      public? {{ c.public }}
{%- endif %}
{%- if c.allow_nil %}
      allow_nil? {{ c.allow_nil }}
{%- endif %}
{%- if c.sensitive %}
      sensitive? {{ c.sensitive }}
{%- endif %}
{%- if c.filterable %}
      filterable? {% if c.filterable == "simple_equality" %}:simple_equality{% else %}{{ c.filterable }}{% endif %}
{%- endif %}
{%- if c.sortable %}
      sortable? {{ c.sortable }}
{%- endif %}
{%- if c.constraints %}
      constraints [{{ c.constraints | safe }}]
{%- endif %}
{%- if c.load %}
      load [{% for l in c.load | split(pat=",") %}{% if l != "" %}:{{ l | trim }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]
{%- endif %}
{%- for a in my_args %}
      argument :{{ a.arg_name }}, :{{ a.arg_type }} do
{%- if a.arg_default %}
        default {{ a.arg_default | safe }}
{%- endif %}
{%- if a.arg_allow_nil %}
        allow_nil? {{ a.arg_allow_nil }}
{%- endif %}
{%- if a.arg_allow_expr %}
        allow_expr? {{ a.arg_allow_expr }}
{%- endif %}
{%- if a.arg_constraints %}
        constraints [{{ a.arg_constraints | safe }}]
{%- endif %}
      end
{%- endfor %}
    end
{%- endfor %}
  end
end
