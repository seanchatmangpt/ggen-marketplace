---
to: "lib/{{ app_path }}/{{ domain_file }}_a2a_l17.ex"
force: true
for_each: "domains"
sparql:
  domains: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?domain_file ?card_name ?card_description ?card_version ?card_url ?card_provider
           ?card_doc_url ?card_icon_url ?sign_card ?semantic ?extended_card ?user_artifacts ?push_max ?push_backoff
           ?base_url ?default_mount ?streaming ?push_notifications ?auth_gate ?lease_ms WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:appPath ?app_path ; aap:domainFile ?domain_file ;
         aap:a2aConfigured "true" .
      OPTIONAL { ?d aap:cardName ?card_name }
      OPTIONAL { ?d aap:cardDescription ?card_description }
      OPTIONAL { ?d aap:cardVersion ?card_version }
      OPTIONAL { ?d aap:cardUrl ?card_url }
      OPTIONAL { ?d aap:cardProvider ?card_provider }
      OPTIONAL { ?d aap:cardDocumentationUrl ?card_doc_url }
      OPTIONAL { ?d aap:cardIconUrl ?card_icon_url }
      OPTIONAL { ?d aap:signCard ?sign_card }
      OPTIONAL { ?d aap:semanticRequests ?semantic }
      OPTIONAL { ?d aap:extendedAgentCard ?extended_card }
      OPTIONAL { ?d aap:userArtifacts ?user_artifacts }
      OPTIONAL { ?d aap:pushRetryMaxAttempts ?push_max }
      OPTIONAL { ?d aap:pushRetryBackoffMs ?push_backoff }
      OPTIONAL { ?d aap:baseUrl ?base_url }
      OPTIONAL { ?d aap:defaultMount ?default_mount }
      OPTIONAL { ?d aap:streamingEnabled ?streaming }
      OPTIONAL { ?d aap:pushNotifications ?push_notifications }
      OPTIONAL { ?d aap:authGate ?auth_gate }
      OPTIONAL { ?d aap:leaseDurationMs ?lease_ms }
    } ORDER BY ?module_name
  facets: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?facet ?val WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:a2aConfigured "true" .
      { ?d aap:cardInputMode ?val . BIND ("input" AS ?facet) }
      UNION { ?d aap:cardOutputMode ?val . BIND ("output" AS ?facet) }
      UNION { ?d aap:pushAllowedHost ?val . BIND ("host" AS ?facet) }
      UNION { ?d aap:requirement ?val . BIND ("requirement" AS ?facet) }
    } ORDER BY ?module_name ?facet ?val
  schemes: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?scheme_name ?kind ?location ?param_name ?http_scheme ?bearer_format ?oauth_flows ?scopes ?openid_url WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:a2aConfigured "true" ; aap:securityScheme ?s .
      ?s aap:schemeName ?scheme_name ; aap:schemeKind ?kind .
      OPTIONAL { ?s aap:schemeLocation ?location }
      OPTIONAL { ?s aap:paramName ?param_name }
      OPTIONAL { ?s aap:httpScheme ?http_scheme }
      OPTIONAL { ?s aap:bearerFormat ?bearer_format }
      OPTIONAL { ?s aap:oauthFlows ?oauth_flows }
      OPTIONAL { ?s aap:schemeScopes ?scopes }
      OPTIONAL { ?s aap:openidUrl ?openid_url }
    } ORDER BY ?module_name ?scheme_name
  req_scopes: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?req_name ?req_scopes WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:a2aConfigured "true" ; aap:requirementScope ?q .
      ?q aap:reqName ?req_name ; aap:reqScopes ?req_scopes .
    } ORDER BY ?module_name ?req_name
  mounts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?agent_module ?path ?binding ?tenant ?protocol_version WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:a2aConfigured "true" ; aap:mount ?m .
      ?m aap:mountAgent ?a ; aap:mountPath ?path .
      ?a aap:moduleName ?agent_base .
      BIND ( IF(EXISTS { ?a aap:agentConfigured "true" }, CONCAT(?agent_base, ".Configured"), ?agent_base) AS ?agent_module )
      OPTIONAL { ?m aap:mountBinding ?binding }
      OPTIONAL { ?m aap:mountTenant ?tenant }
      OPTIONAL { ?m aap:mountProtocolVersion ?protocol_version }
    } ORDER BY ?module_name ?path
  extensions: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?uri ?description ?required ?params WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:a2aConfigured "true" ; aap:agentExtension ?e .
      ?e aap:extUri ?uri .
      OPTIONAL { ?e aap:extDescription ?description }
      OPTIONAL { ?e aap:extRequired ?required }
      OPTIONAL { ?e aap:extParams ?params }
    } ORDER BY ?module_name ?uri
---
# GENERATED by ash-a2a-app-pack (L17 AshA2A.Domain) from the application ontology. Do not hand-edit.
{% set my_facets = facets | filter(attribute="module_name", value=module_name) -%}
{% set my_schemes = schemes | filter(attribute="module_name", value=module_name) -%}
{% set my_reqscopes = req_scopes | filter(attribute="module_name", value=module_name) -%}
{% set my_mounts = mounts | filter(attribute="module_name", value=module_name) -%}
{% set my_exts = extensions | filter(attribute="module_name", value=module_name) -%}
{% set inputs = my_facets | filter(attribute="facet", value="input") -%}
{% set outputs = my_facets | filter(attribute="facet", value="output") -%}
{% set hosts = my_facets | filter(attribute="facet", value="host") -%}
{% set reqs = my_facets | filter(attribute="facet", value="requirement") -%}
defmodule {{ module_name }}.A2aL17 do
  use Spark.Dsl.Fragment, of: Ash.Domain, extensions: [AshA2A, AshA2A.Domain]

  agent do
{%- if card_name | default(value="") != "" %}
    name {{ card_name | json_encode | safe }}
{%- endif %}
{%- if card_description | default(value="") != "" %}
    description {{ card_description | json_encode | safe }}
{%- endif %}
{%- if card_version | default(value="") != "" %}
    version {{ card_version | json_encode | safe }}
{%- endif %}
{%- if card_url | default(value="") != "" %}
    url {{ card_url | json_encode | safe }}
{%- endif %}
{%- if card_provider | default(value="") != "" %}
    provider {{ card_provider | json_encode | safe }}
{%- endif %}
{%- if card_doc_url | default(value="") != "" %}
    documentation_url {{ card_doc_url | json_encode | safe }}
{%- endif %}
{%- if card_icon_url | default(value="") != "" %}
    icon_url {{ card_icon_url | json_encode | safe }}
{%- endif %}
{%- if inputs | length > 0 %}
    default_input_modes [{% for t in inputs %}{{ t.val | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if outputs | length > 0 %}
    default_output_modes [{% for t in outputs %}{{ t.val | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if sign_card | default(value="") != "" %}
    sign_card {% if sign_card is starting_with(":") %}{{ sign_card | safe }}{% else %}{{ sign_card | json_encode | safe }}{% endif %}
{%- endif %}
  end
{%- if semantic | default(value="") != "" %}

  a2a do
    semantic_requests {{ semantic }}
  end
{%- endif %}
{%- if auth_gate | default(value="") != "" or lease_ms | default(value="") != "" %}

  authority do
{%- if auth_gate | default(value="") != "" %}
    gate :{{ auth_gate }}
{%- endif %}
{%- if lease_ms | default(value="") != "" %}
    lease_duration_ms {{ lease_ms }}
{%- endif %}
  end
{%- endif %}
{%- if my_schemes | length > 0 or reqs | length > 0 %}

  security do
{%- for s in my_schemes %}
    security_scheme :{{ s.scheme_name }}, :{{ s.kind }}
{%- if s.location | default(value="") != "" %}, location: :{{ s.location }}{% endif %}
{%- if s.param_name | default(value="") != "" %}, param_name: {{ s.param_name | json_encode | safe }}{% endif %}
{%- if s.http_scheme | default(value="") != "" %}, http_scheme: {{ s.http_scheme | json_encode | safe }}{% endif %}
{%- if s.bearer_format | default(value="") != "" %}, bearer_format: {{ s.bearer_format | json_encode | safe }}{% endif %}
{%- if s.oauth_flows | default(value="") != "" %}, oauth_flows: {{ s.oauth_flows | safe }}{% endif %}
{%- if s.scopes | default(value="") != "" %}, scopes: [{% for z in s.scopes | split(pat=",") %}{{ z | trim | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if s.openid_url | default(value="") != "" %}, openid_url: {{ s.openid_url | json_encode | safe }}{% endif %}
{%- endfor %}
{%- if reqs | length > 0 %}
    requirements [{% for r in reqs %}{{ r.val | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if my_reqscopes | length > 0 %}
    requirement_scopes %{ {% for q in my_reqscopes %}{{ q.req_name | json_encode | safe }} => [{% for z in q.req_scopes | split(pat=",") %}{{ z | trim | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]{% if not loop.last %}, {% endif %}{% endfor %} }
{%- endif %}
  end
{%- endif %}

  transport do
{%- if base_url | default(value="") != "" %}
    base_url {{ base_url | json_encode | safe }}
{%- endif %}
{%- if default_mount | default(value="") != "" %}
    default_mount {{ default_mount | json_encode | safe }}
{%- endif %}
{%- if streaming | default(value="") != "" %}
    streaming {{ streaming }}
{%- endif %}
{%- if push_notifications | default(value="") != "" %}
    push_notifications {{ push_notifications }}
{%- endif %}
{%- if extended_card | default(value="") != "" %}
    extended_agent_card {{ extended_card }}
{%- endif %}
{%- if user_artifacts | default(value="") != "" %}
    user_artifacts {{ user_artifacts }}
{%- endif %}
{%- if hosts | length > 0 %}
    push_allowed_hosts [{% for h in hosts %}{{ h.val | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if push_max | default(value="") != "" or push_backoff | default(value="") != "" %}
    push_retry [{% if push_max | default(value="") != "" %}max_attempts: {{ push_max }}{% endif %}{% if push_max | default(value="") != "" and push_backoff | default(value="") != "" %}, {% endif %}{% if push_backoff | default(value="") != "" %}backoff_ms: {{ push_backoff }}{% endif %}]
{%- endif %}
{%- for m in my_mounts %}
    mount agent: {{ m.agent_module }}, path: {{ m.path | json_encode | safe }}, binding: :{{ m.binding | default(value="jsonrpc") }}
{%- if m.tenant | default(value="") != "" %}, tenant: {{ m.tenant | json_encode | safe }}{% endif %}
{%- if m.protocol_version | default(value="") != "" %}, protocol_version: {{ m.protocol_version | json_encode | safe }}{% endif %}
{%- endfor %}
{%- for e in my_exts %}
    extension {{ e.uri | json_encode | safe }}
{%- if e.description | default(value="") != "" %}, description: {{ e.description | json_encode | safe }}{% endif %}
{%- if e.required | default(value="") != "" %}, required: {{ e.required }}{% endif %}
{%- if e.params | default(value="") != "" %}, params: {{ e.params | safe }}{% endif %}
{%- endfor %}
  end
end
