---
to: "lib/{{ app_path }}/types/{{ type_file }}.ex"
force: true
for_each: "embeds"
sparql:
  embeds: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?type_file WHERE {
      ?t a aap:CustomType ; aap:moduleName ?module_name ; aap:typeKind "embedded" ;
         aap:inDomain ?d ; aap:typeFile ?type_file .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  fields: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?field_name ?ash_type ?ref_module ?is_array ?allow_nil ?constraints ?default_value WHERE {
      ?t a aap:CustomType ; aap:moduleName ?module_name ; aap:typeKind "embedded" ; aap:typeField ?f .
      ?f aap:name ?field_name .
      OPTIONAL { ?f aap:ashType ?ash_type }
      OPTIONAL { ?f aap:typeRef ?r . ?r aap:moduleName ?ref_module }
      OPTIONAL { ?f aap:isArray ?is_array }
      OPTIONAL { ?f aap:allowNil ?allow_nil }
      OPTIONAL { ?f aap:typeConstraints ?constraints }
      OPTIONAL { ?f aap:defaultValue ?default_value }
    } ORDER BY ?module_name ?field_name
---
# GENERATED by ash-a2a-app-pack (lane L12) from the application ontology. Do not hand-edit.
{% set my_fields = fields | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }} do
  use Ash.Resource, data_layer: :embedded

  attributes do
    uuid_primary_key(:id)
{%- for f in my_fields %}
    attribute(:{{ f.field_name }}, {% if f.is_array | default(value="") == "true" %}{ :array, {% endif %}{% if f.ref_module | default(value="") != "" %}{{ f.ref_module }}{% else %}:{{ f.ash_type | default(value="string") }}{% endif %}{% if f.is_array | default(value="") == "true" %} }{% endif %}, public?: true{% if f.allow_nil | default(value="") == "false" %}, allow_nil?: false{% endif %}{% if f.default_value | default(value="") != "" %}, default: {{ f.default_value | safe }}{% endif %}{% if f.constraints | default(value="") != "" %}, constraints: {{ f.constraints | safe }}{% endif %})
{%- endfor %}
  end

  actions do
    defaults [:read, :destroy, create: :*, update: :*]
  end
end
