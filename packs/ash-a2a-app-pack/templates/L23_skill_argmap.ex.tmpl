---
to: "lib/{{ app_path }}/{{ resource_file }}_a2a_l23.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ; aap:resourceFile ?resource_file ;
         aap:skill ?s .
      ?d aap:appPath ?app_path .
      ?s aap:skillArgMap ?m .
    } ORDER BY ?module_name
  skills: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?skill_name ?skill_action ?description ?consequence ?lease WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skill ?s .
      ?s aap:name ?skill_name ; aap:ofAction ?skill_action ; aap:skillArgMap ?m .
      OPTIONAL { ?s aap:description ?description }
      OPTIONAL { ?s aap:consequence ?consequence }
      OPTIONAL { ?s aap:leaseRequired ?lease }
    } ORDER BY ?module_name ?skill_name
  maps: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?skill_name ?wire ?target WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skill ?s .
      ?s aap:name ?skill_name ; aap:skillArgMap ?m .
      ?m aap:wireName ?wire ; aap:targetArg ?target .
    } ORDER BY ?module_name ?skill_name ?wire
---
# GENERATED by ash-a2a-app-pack (lane L23 argument_mapping) from the application ontology. Do not hand-edit.
{% set my_skills = skills | filter(attribute="module_name", value=module_name) -%}
{% set my_maps = maps | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.A2aL23 do
  use Spark.Dsl.Fragment, of: Ash.Resource, extensions: [AshA2A]

  a2a do
{%- for s in my_skills %}
{%- set sm = my_maps | filter(attribute="skill_name", value=s.skill_name) %}
    skill :{{ s.skill_name }}, :{{ s.skill_action }},
      expose?: true
{%- if s.description | default(value="") != "" %},
      description: {{ s.description | json_encode | safe }}
{%- endif %}
{%- if s.consequence | default(value="") != "" %},
      consequence: :{{ s.consequence }}
{%- endif %}
{%- if s.lease | default(value="") != "" %},
      lease_required?: {{ s.lease }}
{%- endif %},
      argument_mapping: %{ {% for m in sm %}{{ m.wire | json_encode | safe }} => :{{ m.target }}{% if not loop.last %}, {% endif %}{% endfor %} }
{%- endfor %}
  end
end
