---
to: "lib/{{ app_path }}/{{ resource_file }}_l24.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:l24Read ?a .
      ?a aap:actionType "read" .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  reads: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?get (GROUP_CONCAT(DISTINCT ?k; separator=",") AS ?keys) WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:l24Read ?a .
      ?a aap:name ?action_name ; aap:actionType "read" .
      OPTIONAL { ?a aap:l24Get ?get }
      OPTIONAL {
        { ?a aap:getByKey ?k }
        UNION
        { ?a aap:getIdentity ?iname . ?r aap:identity ?i .
          ?i aap:name ?iname ; aap:identityKey ?k }
      }
    } GROUP BY ?module_name ?action_name ?get ORDER BY ?module_name ?action_name
---
# GENERATED by ash-a2a-app-pack (lane L24) from the application ontology. Do not hand-edit.
{% set my_reads = reads | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.L24Get do
  use Spark.Dsl.Fragment, of: Ash.Resource

  actions do
{%- for x in my_reads %}
    read :{{ x.action_name }} do
{%- if x.get | default(value="") == "true" %}
      get?(true)
{%- endif %}
{%- if x.keys | default(value="") != "" %}
      get_by([{% for t in x.keys | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}])
{%- endif %}
    end
{%- endfor %}
  end
end
