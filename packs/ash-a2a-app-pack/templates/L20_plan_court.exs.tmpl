---
to: "test/courts/{{ case_file }}_plan_court_test.exs"
force: true
for_each: "plans"
sparql:
  plans: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?case_name ?case_file ?plan_transitions ?plan_goals ?plan_initial ?plan_mode ?case_expect WHERE {
      ?c a aap:PlanCase ; aap:caseName ?case_name ; aap:caseFile ?case_file ;
         aap:planTransitions ?plan_transitions ; aap:planGoals ?plan_goals ;
         aap:planInitial ?plan_initial ; aap:caseExpect ?case_expect .
      OPTIONAL { ?c aap:planMode ?plan_mode }
    } ORDER BY ?case_name
---
# GENERATED by ash-a2a-app-pack (L20 courts) from the application ontology. Do not hand-edit.
defmodule AshA2AAppPack.Courts.Plan_{{ case_file | replace(from="-", to="_") }}CourtTest do
  # ash_pplan FOND satisfiability: AshPPlan.FOND.new/2 + AshPPlan.FOND.Synthesis.synthesize/3.
  use ExUnit.Case, async: true

  test "{{ case_name }}: plan is {{ case_expect }} ({{ plan_mode | default(value="strong_cyclic") }})" do
    assert {:ok, domain} = AshPPlan.FOND.new({{ plan_transitions | safe }}, {{ plan_goals | safe }})
    assert :ok = AshPPlan.FOND.check(domain)
    result = AshPPlan.FOND.Synthesis.synthesize(domain, {{ plan_initial | safe }}, :{{ plan_mode | default(value="strong_cyclic") }})
{%- if case_expect == "satisfiable" %}
    assert {:ok, policy} = result
    assert is_map(policy)
    assert {:ok, _} = AshPPlan.FOND.validate_policy(domain, policy, {{ plan_initial | safe }}, :{{ plan_mode | default(value="strong_cyclic") }})
{%- else %}
    assert {:error, {:unsolvable, _mode, _states}} = result
{%- endif %}
  end
end
