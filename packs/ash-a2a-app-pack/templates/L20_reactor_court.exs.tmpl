---
to: "test/courts/{{ case_file }}_reactor_court_test.exs"
force: true
for_each: "reactors"
sparql:
  reactors: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?case_name ?case_file ?reactor_module ?reactor_inputs ?reactor_expect ?fail_inputs ?undo_probe WHERE {
      ?c a aap:ReactorCase ; aap:caseName ?case_name ; aap:caseFile ?case_file ;
         aap:reactorModule ?reactor_module ; aap:reactorInputs ?reactor_inputs .
      OPTIONAL { ?c aap:reactorExpect ?reactor_expect }
      OPTIONAL { ?c aap:failInputs ?fail_inputs }
      OPTIONAL { ?c aap:undoProbe ?undo_probe }
    } ORDER BY ?case_name
---
# GENERATED by ash-a2a-app-pack (L20 courts) from the application ontology. Do not hand-edit.
defmodule AshA2AAppPack.Courts.Reactor_{{ case_file | replace(from="-", to="_") }}CourtTest do
  # Real Reactor run; no mocks. Compensation is witnessed through the declared undo probe.
  use ExUnit.Case, async: false

  test "{{ case_name }}: happy path returns {:ok, _}" do
    assert {:ok, result} = Reactor.run({{ reactor_module }}, {{ reactor_inputs | safe }}, %{}, async?: false)
    assert match?({{ reactor_expect | default(value="_") | safe }}, result)
  end
{%- if fail_inputs %}

  test "{{ case_name }}: failing inputs return {:error, _} and compensate" do
    assert {:error, _} = Reactor.run({{ reactor_module }}, {{ fail_inputs | default(value="%{}") | safe }}, %{}, async?: false)
{%- if undo_probe %}
    assert {{ undo_probe | safe }}, "compensation did not restore state"
{%- endif %}
  end
{%- endif %}
end
