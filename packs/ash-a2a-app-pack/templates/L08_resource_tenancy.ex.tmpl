---
to: "lib/{{ app_path }}/{{ resource_file }}_l08.ex"
force: true
for_each: "tenants"
sparql:
  tenants: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?resource_file ?strategy ?tenant_attr ?tglobal ?parse_attr ?from_attr WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:multitenancy ?m .
      ?d aap:appPath ?app_path .
      ?m aap:tenantStrategy ?strategy .
      OPTIONAL { ?m aap:tenantAttribute ?tenant_attr }
      OPTIONAL { ?m aap:tenantGlobal ?tglobal }
      OPTIONAL { ?m aap:parseAttribute ?parse_attr }
      OPTIONAL { ?m aap:tenantFromAttribute ?from_attr }
    } ORDER BY ?module_name
  rels: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?rel_name ?rel_dest ?rel_src ?rel_type ?rel_nil ?rel_public WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:multitenancy ?m ; aap:relationship ?x .
      ?x aap:relName ?rel_name ; aap:relDestination ?rel_dest ; aap:relSourceAttribute ?rel_src .
      OPTIONAL { ?x aap:relAttributeType ?rel_type }
      OPTIONAL { ?x aap:relAllowNil ?rel_nil }
      OPTIONAL { ?x aap:relPublic ?rel_public }
    } ORDER BY ?module_name ?rel_name
---
# GENERATED by ash-a2a-app-pack (L08) from the application ontology. Do not hand-edit.
{% set my_rels = rels | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.TenancyL08 do
  @moduledoc false
  use Spark.Dsl.Fragment, of: Ash.Resource

  multitenancy do
    strategy(:{{ strategy }})
{%- if strategy == "attribute" and tenant_attr %}
    attribute(:{{ tenant_attr }})
{%- endif %}
{%- if tglobal | default(value="") == "true" %}
    global?(true)
{%- endif %}
{%- if parse_attr | default(value="") != "" %}
    parse_attribute({{ parse_attr }})
{%- endif %}
{%- if from_attr | default(value="") != "" %}
    tenant_from_attribute({{ from_attr }})
{%- endif %}
  end
{%- if my_rels | length > 0 %}

  relationships do
{%- for x in my_rels %}
    belongs_to :{{ x.rel_name }}, {{ x.rel_dest }} do
      source_attribute(:{{ x.rel_src }})
      attribute_type(:{{ x.rel_type | default(value="uuid") }})
      allow_nil?({{ x.rel_nil | default(value="false") }})
      attribute_public?({{ x.rel_public | default(value="true") }})
    end
{%- endfor %}
  end
{%- endif %}
end
