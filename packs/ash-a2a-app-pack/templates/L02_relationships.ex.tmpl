---
to: "lib/{{ app_path }}/{{ resource_file }}_l02.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file .
      ?d aap:appPath ?app_path .
      { ?r aap:relationship ?x } UNION { ?r aap:manage ?x }
    } ORDER BY ?module_name
  rels: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?rel_name ?rel_kind ?dest_module ?through_module ?through_path
           ?sa ?da ?sajr ?dajr ?jr ?allow_nil ?rpk ?define ?atype ?public ?writable
           ?no_attrs ?sort ?desc ?read_action WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:relationship ?rel .
      ?rel aap:name ?rel_name ; aap:relKind ?rel_kind ; aap:destination ?dest .
      ?dest aap:moduleName ?dest_module .
      OPTIONAL { ?rel aap:through ?th . ?th aap:moduleName ?through_module }
      OPTIONAL { ?rel aap:throughPath ?through_path }
      OPTIONAL { ?rel aap:sourceAttribute ?sa }
      OPTIONAL { ?rel aap:destinationAttribute ?da }
      OPTIONAL { ?rel aap:sourceAttributeOnJoin ?sajr }
      OPTIONAL { ?rel aap:destinationAttributeOnJoin ?dajr }
      OPTIONAL { ?rel aap:joinRelationship ?jr }
      OPTIONAL { ?rel aap:allowNil ?allow_nil }
      OPTIONAL { ?rel aap:relPrimaryKey ?rpk }
      OPTIONAL { ?rel aap:defineAttribute ?define }
      OPTIONAL { ?rel aap:attributeType ?atype }
      OPTIONAL { ?rel aap:relPublic ?public }
      OPTIONAL { ?rel aap:relWritable ?writable }
      OPTIONAL { ?rel aap:noAttributes ?no_attrs }
      OPTIONAL { ?rel aap:relSort ?sort }
      OPTIONAL { ?rel aap:description ?desc }
      OPTIONAL { ?rel aap:relReadAction ?read_action }
    } ORDER BY ?module_name ?rel_name
  rel_filters: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?rel_name ?filter_expr WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:relationship ?rel .
      ?rel aap:name ?rel_name ; aap:relFilter ?filter_expr .
    } ORDER BY ?module_name ?rel_name ?filter_expr
  manages: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?action_type ?rel_name ?rel_kind ?arg_name ?arg_type
           ?manage_type ?on_lookup ?on_no_match ?on_match ?on_missing ?use_identities ?accept WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:manage ?m .
      ?m aap:name ?action_name ; aap:actionType ?action_type ;
         aap:ofRelationship ?rel ; aap:manageType ?manage_type .
      ?rel aap:name ?rel_name ; aap:relKind ?rel_kind .
      OPTIONAL { ?m aap:argumentName ?an }
      OPTIONAL { ?m aap:argumentType ?arg_type }
      OPTIONAL { ?m aap:onLookup ?on_lookup }
      OPTIONAL { ?m aap:onNoMatch ?on_no_match }
      OPTIONAL { ?m aap:onMatch ?on_match }
      OPTIONAL { ?m aap:onMissing ?on_missing }
      OPTIONAL { ?m aap:useIdentities ?use_identities }
      OPTIONAL { ?m aap:accept ?accept }
      BIND(COALESCE(?an, ?rel_name) AS ?arg_name)
    } ORDER BY ?module_name ?action_name
---
# GENERATED by ash-a2a-app-pack (lane L02) from the application ontology. Do not hand-edit.
{% set my_rels = rels | filter(attribute="module_name", value=module_name) -%}
{% set my_filters = rel_filters | filter(attribute="module_name", value=module_name) -%}
{% set my_manages = manages | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.Relationships do
  use Spark.Dsl.Fragment, of: Ash.Resource
{%- if my_rels | length > 0 %}

  relationships do
{%- for r in my_rels %}
    {{ r.rel_kind }} :{{ r.rel_name }}, {{ r.dest_module }} do
      public?({{ r.public | default(value="true") }})
{%- if r.desc | default(value="") %}
      description("{{ r.desc }}")
{%- endif %}
{%- if r.sa | default(value="") %}
      source_attribute(:{{ r.sa }})
{%- endif %}
{%- if r.da | default(value="") %}
      destination_attribute(:{{ r.da }})
{%- endif %}
{%- if r.through_module | default(value="") %}
      through({{ r.through_module }})
{%- endif %}
{%- if r.through_path | default(value="") %}
      through({{ r.through_path }})
{%- endif %}
{%- if r.sajr | default(value="") %}
      source_attribute_on_join_resource(:{{ r.sajr }})
{%- endif %}
{%- if r.dajr | default(value="") %}
      destination_attribute_on_join_resource(:{{ r.dajr }})
{%- endif %}
{%- if r.jr | default(value="") %}
      join_relationship(:{{ r.jr }})
{%- endif %}
{%- if r.allow_nil | default(value="") %}
      allow_nil?({{ r.allow_nil }})
{%- endif %}
{%- if r.rpk | default(value="") %}
      primary_key?({{ r.rpk }})
{%- endif %}
{%- if r.define | default(value="") %}
      define_attribute?({{ r.define }})
{%- endif %}
{%- if r.atype | default(value="") %}
      attribute_type({{ r.atype }})
{%- endif %}
{%- if r.writable | default(value="") %}
      writable?({{ r.writable }})
{%- endif %}
{%- if r.no_attrs | default(value="") %}
      no_attributes?({{ r.no_attrs }})
{%- endif %}
{%- if r.sort | default(value="") %}
      sort({{ r.sort }})
{%- endif %}
{%- if r.read_action | default(value="") %}
      read_action(:{{ r.read_action }})
{%- endif %}
{%- for f in my_filters | filter(attribute="rel_name", value=r.rel_name) %}
      filter(expr({{ f.filter_expr }}))
{%- endfor %}
    end
{%- endfor %}
  end
{%- endif %}
{%- if my_manages | length > 0 %}

  actions do
{%- for m in my_manages %}
    {{ m.action_type }} :{{ m.action_name }} do
{%- if m.action_type != "create" %}
      require_atomic?(false)
{%- endif %}
      accept([{% for t in m.accept | default(value="") | split(pat=",") %}{% if t != "" %}:{{ t }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}])
{%- if m.arg_type | default(value="") %}
      argument(:{{ m.arg_name }}, {{ m.arg_type }}, allow_nil?: true)
{%- elif m.rel_kind == "has_many" or m.rel_kind == "many_to_many" %}
      argument(:{{ m.arg_name }}, {:array, :map}, allow_nil?: true)
{%- else %}
      argument(:{{ m.arg_name }}, :map, allow_nil?: true)
{%- endif %}
      change(manage_relationship(:{{ m.arg_name }}, :{{ m.rel_name }}, type: :{{ m.manage_type }}
{%- if m.on_lookup | default(value="") %}, on_lookup: {{ m.on_lookup }}{% endif %}
{%- if m.on_no_match | default(value="") %}, on_no_match: {{ m.on_no_match }}{% endif %}
{%- if m.on_match | default(value="") %}, on_match: {{ m.on_match }}{% endif %}
{%- if m.on_missing | default(value="") %}, on_missing: {{ m.on_missing }}{% endif %}
{%- if m.use_identities | default(value="") %}, use_identities: {{ m.use_identities }}{% endif %}))
    end
{%- endfor %}
  end
{%- endif %}
end
