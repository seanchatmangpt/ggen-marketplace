---
to: "lib/{{ app_path }}/{{ resource_file }}_a2a_l17.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file ?authorizers ?semantic ?auth_gate ?lease_ms WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ; aap:resourceFile ?resource_file .
      ?d aap:appPath ?app_path .
      FILTER ( EXISTS { ?r aap:skillSpec ?x } || EXISTS { ?r aap:authGate ?g } || EXISTS { ?r aap:leaseDurationMs ?l }
            || EXISTS { ?r aap:hookRef ?h } || EXISTS { ?r aap:semanticRequests ?s } || EXISTS { ?r aap:authorizer ?z } )
      OPTIONAL { ?r aap:authorizer ?authorizers }
      OPTIONAL { ?r aap:semanticRequests ?semantic }
      OPTIONAL { ?r aap:authGate ?auth_gate }
      OPTIONAL { ?r aap:leaseDurationMs ?lease_ms }
    } ORDER BY ?module_name
  specs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?spec_name ?spec_action ?description ?consequence ?on_cancel ?lease ?get_read ?streaming ?expose ?has_hddl WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skillSpec ?s .
      ?s aap:specName ?spec_name ; aap:specAction ?spec_action .
      OPTIONAL { ?s aap:description ?description }
      OPTIONAL { ?s aap:consequence ?consequence }
      OPTIONAL { ?s aap:onCancel ?on_cancel }
      OPTIONAL { ?s aap:leaseRequired ?lease }
      OPTIONAL { ?s aap:getRead ?get_read }
      OPTIONAL { ?s aap:streaming ?streaming }
      OPTIONAL { ?s aap:expose ?expose }
      BIND ( EXISTS { ?s aap:hddlOperator ?o } AS ?has_hddl )
    } ORDER BY ?module_name ?spec_name
  facets: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?spec_name ?facet ?val WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skillSpec ?s .
      ?s aap:specName ?spec_name .
      { ?s aap:tag ?val . BIND ("tag" AS ?facet) }
      UNION { ?s aap:example ?val . BIND ("example" AS ?facet) }
      UNION { ?s aap:inputMode ?val . BIND ("input" AS ?facet) }
      UNION { ?s aap:outputMode ?val . BIND ("output" AS ?facet) }
    } ORDER BY ?module_name ?spec_name ?facet ?val
  argmaps: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?spec_name ?wire ?target WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skillSpec ?s .
      ?s aap:specName ?spec_name ; aap:argMapping ?m .
      ?m aap:wireName ?wire ; aap:targetArg ?target .
    } ORDER BY ?module_name ?spec_name ?wire
  secs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?spec_name ?grp ?scheme ?scopes WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skillSpec ?s .
      ?s aap:specName ?spec_name ; aap:secRequirement ?q .
      ?q aap:secGroup ?grp ; aap:secScheme ?scheme .
      OPTIONAL { ?q aap:secScopes ?scopes }
    } ORDER BY ?module_name ?spec_name ?grp ?scheme
  hddl: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?spec_name ?params WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skillSpec ?s .
      ?s aap:specName ?spec_name ; aap:hddlOperator ?o .
      OPTIONAL { ?o aap:hddlParams ?params }
    } ORDER BY ?module_name ?spec_name
  facts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?spec_name ?kind ?pred ?args WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skillSpec ?s .
      ?s aap:specName ?spec_name ; aap:hddlOperator ?o .
      { ?o aap:hddlPre ?f . BIND ("pre" AS ?kind) }
      UNION { ?o aap:hddlAdd ?f . BIND ("add" AS ?kind) }
      UNION { ?o aap:hddlDel ?f . BIND ("del" AS ?kind) }
      ?f aap:predicate ?pred .
      OPTIONAL { ?f aap:factArgs ?args }
    } ORDER BY ?module_name ?spec_name ?kind ?pred ?args
  hooks: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
    SELECT ?module_name ?phase ?hook_id ?ord WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:hookRef ?h .
      ?h aap:hookId ?hook_id ; aap:hookPhase ?phase .
      OPTIONAL { ?h aap:hookOrder ?ord }
    } ORDER BY ?module_name ?phase xsd:integer(?ord) ?hook_id
---
# GENERATED by ash-a2a-app-pack (L17 AshA2A DSL) from the application ontology. Do not hand-edit.
{% set my_specs = specs | filter(attribute="module_name", value=module_name) -%}
{% set my_facets = facets | filter(attribute="module_name", value=module_name) -%}
{% set my_argmaps = argmaps | filter(attribute="module_name", value=module_name) -%}
{% set my_secs = secs | filter(attribute="module_name", value=module_name) -%}
{% set my_hddl = hddl | filter(attribute="module_name", value=module_name) -%}
{% set my_facts = facts | filter(attribute="module_name", value=module_name) -%}
{% set my_hooks = hooks | filter(attribute="module_name", value=module_name) -%}
{% set pre_hooks = my_hooks | filter(attribute="phase", value="pre") -%}
{% set post_hooks = my_hooks | filter(attribute="phase", value="post") -%}
defmodule {{ module_name }}.A2aL17 do
  use Spark.Dsl.Fragment,
    of: Ash.Resource,
    extensions: [AshA2A]{% if authorizers | default(value="") != "" %},
    authorizers: [{% for z in authorizers | split(pat=",") %}{{ z | trim }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if my_specs | length > 0 or semantic | default(value="") != "" %}

  a2a do
{%- if semantic | default(value="") != "" %}
    semantic_requests {{ semantic }}
{%- endif %}
{%- for s in my_specs %}
{%- set tags = my_facets | filter(attribute="spec_name", value=s.spec_name) | filter(attribute="facet", value="tag") %}
{%- set examples = my_facets | filter(attribute="spec_name", value=s.spec_name) | filter(attribute="facet", value="example") %}
{%- set inputs = my_facets | filter(attribute="spec_name", value=s.spec_name) | filter(attribute="facet", value="input") %}
{%- set outputs = my_facets | filter(attribute="spec_name", value=s.spec_name) | filter(attribute="facet", value="output") %}
{%- set maps = my_argmaps | filter(attribute="spec_name", value=s.spec_name) %}
{%- set reqs = my_secs | filter(attribute="spec_name", value=s.spec_name) %}
{%- set ops = my_hddl | filter(attribute="spec_name", value=s.spec_name) %}
    skill :{{ s.spec_name }}, :{{ s.spec_action }}{% if ops | length == 0 %},
      expose?: {{ s.expose | default(value="true") }}
{%- if s.description | default(value="") != "" %},
      description: {{ s.description | json_encode | safe }}
{%- endif %}
{%- if s.consequence | default(value="") != "" %},
      consequence: :{{ s.consequence }}
{%- endif %}
{%- if s.on_cancel | default(value="") != "" %},
      on_cancel: {{ s.on_cancel | safe }}
{%- endif %}
{%- if s.lease | default(value="") != "" %},
      lease_required?: {{ s.lease }}
{%- endif %}
{%- if s.get_read | default(value="") != "" %},
      get?: {{ s.get_read }}
{%- endif %}
{%- if s.streaming | default(value="") != "" %},
      streaming?: {{ s.streaming }}
{%- endif %}
{%- if tags | length > 0 %},
      tags: [{% for t in tags %}{{ t.val | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if examples | length > 0 %},
      examples: [{% for t in examples %}{{ t.val | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if inputs | length > 0 %},
      input_modes: [{% for t in inputs %}{{ t.val | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if outputs | length > 0 %},
      output_modes: [{% for t in outputs %}{{ t.val | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if maps | length > 0 %},
      argument_mapping: %{ {% for m in maps %}{{ m.wire | json_encode | safe }} => :{{ m.target }}{% if not loop.last %}, {% endif %}{% endfor %} }
{%- endif %}
{%- if reqs | length > 0 %},
      security_requirements: [
{%- for grp, items in reqs | group_by(attribute="grp") %}
        %{ {% for i in items %}{{ i.scheme | json_encode | safe }} => [{% for z in i.scopes | default(value="") | split(pat=",") %}{% if z != "" %}{{ z | trim | json_encode | safe }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]{% if not loop.last %}, {% endif %}{% endfor %} }{% if not loop.last %},{% endif %}
{%- endfor %}
      ]
{%- endif %}
{%- endif %}{# skill options and a nested hddl_operator block are mutually exclusive in the Spark macro shapes (no skill/5) #}
{%- if ops | length > 0 %} do
{%- for o in ops %}
{%- set pres = my_facts | filter(attribute="spec_name", value=s.spec_name) | filter(attribute="kind", value="pre") %}
{%- set adds = my_facts | filter(attribute="spec_name", value=s.spec_name) | filter(attribute="kind", value="add") %}
{%- set dels = my_facts | filter(attribute="spec_name", value=s.spec_name) | filter(attribute="kind", value="del") %}
      hddl_operator parameters: [{% for p in o.params | default(value="") | split(pat=",") %}{% if p != "" %}:{{ p | trim }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}],
        preconditions: [{% for f in pres %}{ :{{ f.pred }}, [{% for a in f.args | default(value="") | split(pat=",") %}{% if a != "" %}:{{ a | trim }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}] }{% if not loop.last %}, {% endif %}{% endfor %}],
        add_effects: [{% for f in adds %}{ :{{ f.pred }}, [{% for a in f.args | default(value="") | split(pat=",") %}{% if a != "" %}:{{ a | trim }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}] }{% if not loop.last %}, {% endif %}{% endfor %}],
        delete_effects: [{% for f in dels %}{ :{{ f.pred }}, [{% for a in f.args | default(value="") | split(pat=",") %}{% if a != "" %}:{{ a | trim }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}] }{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endfor %}
    end
{%- endif %}
{%- endfor %}
  end
{%- endif %}
{%- if auth_gate | default(value="") != "" or lease_ms | default(value="") != "" %}

  authority do
{%- if auth_gate | default(value="") != "" %}
    gate :{{ auth_gate }}
{%- endif %}
{%- if lease_ms | default(value="") != "" %}
    lease_duration_ms {{ lease_ms }}
{%- endif %}
  end
{%- endif %}
{%- if my_hooks | length > 0 %}

  hooks do
{%- if pre_hooks | length > 0 %}
    pre_dispatch [{% for h in pre_hooks %}:{{ h.hook_id }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if post_hooks | length > 0 %}
    post_dispatch [{% for h in post_hooks %}:{{ h.hook_id }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
  end
{%- endif %}
end
