---
to: "config/prod.exs"
force: true
sparql:
  prof: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?profile ?store ?broker ?kill WHERE {
      ?p a aap:Project ; aap:profile ?profile ; aap:durableStore ?store .
      FILTER(STR(?profile) = "strict")
      OPTIONAL { ?p aap:authorityBroker ?broker }
      OPTIONAL { ?p aap:killSwitchClass ?kill }
    }
---
# GENERATED by ash-a2a-app-pack (L31). Do not hand-edit.
# Compile-time prod config. :security_profile is read via Application.compile_env, so it must
# live here (not runtime.exs). Keys and dirs are runtime-only: see runtime.exs.
import Config
{%- for s in prof %}

config :ash_a2a, :security_profile, :strict
config :ash_a2a, :receipt_store, {{ s.store }}
config :ash_a2a, :capability_release_mode, :strict
{%- if s.broker | default(value="") != "" %}
config :ash_a2a, :authority_broker, {{ s.broker }}
{%- endif %}
{%- if s.kill | default(value="") != "" %}
config :ash_a2a, :kill_switch_class, {{ s.kill }}
{%- endif %}
{%- endfor %}
