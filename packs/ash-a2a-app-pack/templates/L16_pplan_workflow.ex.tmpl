---
to: "lib/{{ app_path }}/pplan/{{ pp_file }}.ex"
force: true
for_each: "workflows"
sparql:
  workflows: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?pp_file ?wf_name ?goal ?version WHERE {
      ?d a aap:Domain ; aap:appPath ?app_path ; aap:ppWorkflow ?w .
      ?w a aap:PPlanWorkflow ; aap:moduleName ?module_name ; aap:ppFile ?pp_file .
      OPTIONAL { ?w aap:ppName ?wf_name }
      OPTIONAL { ?w aap:ppGoal ?goal }
      OPTIONAL { ?w aap:ppVersion ?version }
    } ORDER BY ?module_name
  tasks: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?task_id ?capability ?authority ?compensation
           (GROUP_CONCAT(DISTINCT ?dep_name; separator=",") AS ?after_ids)
           (GROUP_CONCAT(DISTINCT ?outcome; separator=",") AS ?outcomes)
           (GROUP_CONCAT(DISTINCT ?prop; separator=",") AS ?properties)
           (GROUP_CONCAT(DISTINCT ?ev; separator=",") AS ?evidence)
    WHERE {
      ?w a aap:PPlanWorkflow ; aap:moduleName ?module_name ; aap:ppTask ?t .
      ?t aap:name ?task_id ; aap:ppCapability ?capability .
      OPTIONAL { ?t aap:ppAuthority ?authority }
      OPTIONAL { ?t aap:ppCompensation ?compensation }
      OPTIONAL { ?t aap:ppAfter ?dep . ?dep aap:name ?dep_name }
      OPTIONAL { ?t aap:ppOutcome ?outcome }
      OPTIONAL { ?t aap:ppProperty ?prop }
      OPTIONAL { ?t aap:ppEvidenceKind ?ev }
    } GROUP BY ?module_name ?task_id ?capability ?authority ?compensation
    ORDER BY ?module_name ?task_id
  methods: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?method_id ?refines ?precondition WHERE {
      ?w a aap:PPlanWorkflow ; aap:moduleName ?module_name ; aap:ppMethod ?m .
      ?m aap:name ?method_id ; aap:ppRefines ?rt .
      ?rt aap:name ?refines .
      OPTIONAL { ?m aap:ppPrecondition ?precondition }
    } ORDER BY ?module_name ?method_id
  steps: |
    PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?method_id ?step_no ?step_task WHERE {
      ?w a aap:PPlanWorkflow ; aap:moduleName ?module_name ; aap:ppMethod ?m .
      ?m aap:name ?method_id ; aap:ppStepOf ?s .
      ?s aap:ppStep ?step_no ; aap:ppStepTask ?st .
      ?st aap:name ?step_task .
    } ORDER BY ?module_name ?method_id xsd:integer(?step_no)
---
# GENERATED by ash-a2a-app-pack (L16 ash_pplan workflow) from the application ontology. Do not hand-edit.
{% set my_tasks = tasks | filter(attribute="module_name", value=module_name) -%}
{% set my_methods = methods | filter(attribute="module_name", value=module_name) -%}
{% set my_steps = steps | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }} do
  use AshPPlan.Workflow

  workflow do
{%- if wf_name %}
    name {{ ":" ~ wf_name }}
{%- endif %}
{%- if goal %}
    goal "{{ goal | safe }}"
{%- endif %}
{%- if version %}
    version {{ version }}
{%- endif %}
{% for t in my_tasks %}
    task :{{ t.task_id }}, capability: "{{ t.capability }}"
{%- if t.after_ids %}, after: [{% for x in t.after_ids | split(pat=",") %}:{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if t.outcomes %}, outcomes: [{% for x in t.outcomes | split(pat=",") %}:{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if t.properties %}, properties: [{% for x in t.properties | split(pat=",") %}:{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if t.evidence %}, evidence: [{% for x in t.evidence | split(pat=",") %}:{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if t.authority %}, authority: :{{ t.authority }}{% endif %}
{%- if t.compensation %}, compensation: {{ t.compensation | safe }}{% endif %}
{% endfor %}
{%- for m in my_methods %}
    method :{{ m.method_id }}, task: :{{ m.refines }}, subtasks: [{% set ms = my_steps | filter(attribute="method_id", value=m.method_id) %}{% for s in ms %}:{{ s.step_task }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- if m.precondition %}, precondition: {{ m.precondition | safe }}{% endif %}
{% endfor %}
  end
end
