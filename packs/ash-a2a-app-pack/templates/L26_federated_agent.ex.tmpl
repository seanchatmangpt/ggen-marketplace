---
to: "lib/{{ app_path }}/{{ fed_file }}.ex"
force: true
for_each: "feds"
sparql:
  feds: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?fed ?fed_module ?fed_name ?fed_file ?app_path WHERE {
      ?fed a aap:FederatedAgent ; aap:moduleName ?fed_module ; aap:agentName ?fed_name ;
           aap:agentFile ?fed_file ; aap:appPath ?app_path .
    } ORDER BY ?fed_module
  members: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?fed ?domain_module ?member_module WHERE {
      ?fed a aap:FederatedAgent ; aap:servesDomain ?d ; aap:memberAgent ?m .
      ?d aap:moduleName ?domain_module .
      ?m aap:forDomain ?d ; aap:moduleName ?member_module .
    } ORDER BY ?fed ?domain_module
---
# GENERATED by ash-a2a-app-pack (L26) from the application ontology. Do not hand-edit.
defmodule {{ fed_module }} do
  @moduledoc """
  Federated A2A agent "{{ fed_name }}": AshA2A.Agent serves one resource_or_domain
  (ash_a2a lib/ash_a2a/agent.ex:110), so this facade enumerates one agent per served
  domain for AshA2A.Protocol.AgentSupervisor.
  """

  @domains [{% for row in members %}{% if row.fed == fed %}{{ row.domain_module }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]
  @agents [{% for row in members %}{% if row.fed == fed %}{{ row.member_module }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]

  @doc "Served Ash domains."
  def domains, do: @domains

  @doc "Per-domain agents; pass to `{AshA2A.Protocol.AgentSupervisor, agents: agents()}`."
  def agents, do: @agents
end
