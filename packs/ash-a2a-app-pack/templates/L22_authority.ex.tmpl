---
to: "lib/{{ app_path }}/{{ resource_file }}_l22.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file ?gate ?lease_ms WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file .
      ?d aap:appPath ?app_path .
      OPTIONAL { ?r aap:authorityGate ?gate }
      OPTIONAL { ?r aap:leaseDurationMs ?lease_ms }
      FILTER (BOUND(?gate) || BOUND(?lease_ms))
    } ORDER BY ?module_name
---
# GENERATED by ash-a2a-app-pack (L22 authority fragment) from the application ontology. Do not hand-edit.
{% for row in resources -%}
defmodule {{ row.module_name }}.L22Authority do
  use Spark.Dsl.Fragment,
    of: Ash.Resource,
    extensions: [AshA2A]

  authority do
{%- if row.gate | default(value="") != "" %}
    gate :{{ row.gate }}
{%- endif %}
{%- if row.lease_ms | default(value="") != "" %}
    lease_duration_ms {{ row.lease_ms }}
{%- endif %}
  end
end
{% endfor %}
