---
to: "config/l09_runtime.exs"
force: true
sparql:
  app: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?app_name WHERE { ?p a aap:Project ; aap:appName ?app_name . }
  repos: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?repo_kind ?db_url_env ?pool_size WHERE {
      ?rp a aap:Repo ; aap:moduleName ?module_name ; aap:repoKind ?repo_kind .
      OPTIONAL { ?rp aap:dbUrlEnv ?db_url_env }
      OPTIONAL { ?rp aap:poolSize ?pool_size }
    } ORDER BY ?module_name
---
# GENERATED by ash-a2a-app-pack (L09) from the application ontology. Do not hand-edit.
# Coordinator wires: `import_config "l09_runtime.exs"` in config/runtime.exs (prod only).
import Config
{% if repos | length > 0 %}
if config_env() == :prod do
{%- for r in repos %}
  config :{{ app[0].app_name }}, {{ r.module_name }},
    url: System.get_env("{{ r.db_url_env | default(value="DATABASE_URL") }}") ||
           raise("environment variable {{ r.db_url_env | default(value="DATABASE_URL") }} is missing"),
    pool_size: String.to_integer(System.get_env("POOL_SIZE") || "{{ r.pool_size | default(value="10") }}")
{%- endfor %}
end
{%- endif %}
