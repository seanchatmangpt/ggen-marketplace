---
to: "lib/{{ app_path }}/pplan/{{ pp_file }}.ex"
force: true
for_each: "packs"
sparql:
  packs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?pp_file ?pack_id ?pack_version
           (GROUP_CONCAT(DISTINCT ?cap; separator=",") AS ?capabilities)
           (GROUP_CONCAT(DISTINCT ?prop; separator=",") AS ?properties)
           (GROUP_CONCAT(DISTINCT ?ev; separator=",") AS ?evidence)
    WHERE {
      ?d a aap:Domain ; aap:appPath ?app_path ; aap:ppPack ?p .
      ?p a aap:PPlanCapabilityPack ; aap:moduleName ?module_name ; aap:ppFile ?pp_file ;
         aap:ppPackId ?pack_id ; aap:ppPackCapability ?cap .
      OPTIONAL { ?p aap:ppPackVersion ?pack_version }
      OPTIONAL { ?p aap:ppPackProperty ?prop }
      OPTIONAL { ?p aap:ppPackEvidence ?ev }
    } GROUP BY ?module_name ?app_path ?pp_file ?pack_id ?pack_version
    ORDER BY ?module_name
---
# GENERATED by ash-a2a-app-pack (L16 ash_pplan capability pack) from the application ontology. Do not hand-edit.
defmodule {{ module_name }} do
  @moduledoc """
  Generated AshPPlan.CapabilityPack declaration `{{ pack_id }}`. Declaring a capability confers
  no authority; the ceiling is :construct (capability_pack.ex:13-19).
  """

  @spec pack() :: {:ok, AshPPlan.CapabilityPack.t()} | {:error, map()}
  def pack do
    AshPPlan.CapabilityPack.load(%{
      id: "{{ pack_id }}",
      version: "{{ pack_version | default(value="0.0.0") }}",
      capabilities: [{% for x in capabilities | split(pat=",") %}"{{ x }}"{% if not loop.last %}, {% endif %}{% endfor %}],
      properties: [{% for x in properties | default(value="") | split(pat=",") %}{% if x != "" %}:{{ x }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}],
      evidence: [{% for x in evidence | default(value="") | split(pat=",") %}{% if x != "" %}:{{ x }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}],
      authority: :construct
    })
  end
end
