---
to: "lib/{{ app_path }}/{{ resource_file }}_l05.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?domain_module ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file .
      ?d aap:moduleName ?domain_module ; aap:appPath ?app_path .
      FILTER ( EXISTS { ?r aap:identity ?i } || EXISTS { ?r aap:validation ?v } )
    } ORDER BY ?module_name
  identities: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?identity_name
           (GROUP_CONCAT(DISTINCT ?k; separator=",") AS ?keys)
           (SAMPLE(?ec) AS ?eager) (SAMPLE(?ecw) AS ?eager_with)
           (SAMPLE(?pc) AS ?pre) (SAMPLE(?pcw) AS ?pre_with)
           (SAMPLE(?nd) AS ?nils) (SAMPLE(?at) AS ?all_tenants)
           (SAMPLE(?fn) AS ?field_names) (SAMPLE(?wh) AS ?where_expr)
           (SAMPLE(?msg) AS ?message) (SAMPLE(?desc) AS ?description)
    WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:identity ?i .
      ?i aap:name ?identity_name ; aap:identityKey ?k .
      OPTIONAL { ?i aap:eagerCheck ?ec }
      OPTIONAL { ?i aap:eagerCheckWith ?ecw }
      OPTIONAL { ?i aap:preCheck ?pc }
      OPTIONAL { ?i aap:preCheckWith ?pcw }
      OPTIONAL { ?i aap:nilsDistinct ?nd }
      OPTIONAL { ?i aap:allTenants ?at }
      OPTIONAL { ?i aap:fieldNames ?fn }
      OPTIONAL { ?i aap:identityWhere ?wh }
      OPTIONAL { ?i aap:message ?msg }
      OPTIONAL { ?i aap:description ?desc }
    } GROUP BY ?module_name ?identity_name ORDER BY ?module_name ?identity_name
  validations: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?v_name
           (SAMPLE(?kd) AS ?kind)
           (GROUP_CONCAT(DISTINCT ?a; separator=",") AS ?attrs)
           (SAMPLE(?val) AS ?value) (SAMPLE(?op) AS ?vopts)
           (SAMPLE(?o) AS ?on) (SAMPLE(?w) AS ?where_list)
           (SAMPLE(?fa) AS ?for_action) (SAMPLE(?msg) AS ?message)
           (SAMPLE(?ov) AS ?only_when_valid) (SAMPLE(?ba) AS ?before_action)
           (SAMPLE(?aa) AS ?always_atomic) (SAMPLE(?desc) AS ?description)
    WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:validation ?v .
      ?v aap:name ?v_name ; aap:validationKind ?kd .
      OPTIONAL { ?v aap:vAttribute ?a }
      OPTIONAL { ?v aap:vValue ?val }
      OPTIONAL { ?v aap:vOpts ?op }
      OPTIONAL { ?v aap:on ?o }
      OPTIONAL { ?v aap:where ?w }
      OPTIONAL { ?v aap:forAction ?fa }
      OPTIONAL { ?v aap:message ?msg }
      OPTIONAL { ?v aap:onlyWhenValid ?ov }
      OPTIONAL { ?v aap:beforeAction ?ba }
      OPTIONAL { ?v aap:alwaysAtomic ?aa }
      OPTIONAL { ?v aap:description ?desc }
    } GROUP BY ?module_name ?v_name ORDER BY ?module_name ?v_name
---
# GENERATED by ash-a2a-app-pack (L05) from the application ontology. Do not hand-edit.
{% set my_identities = identities | filter(attribute="module_name", value=module_name) -%}
{% set my_validations = validations | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.L05 do
  use Spark.Dsl.Fragment, of: Ash.Resource
{%- if my_identities | length > 0 %}

  identities do
{%- for i in my_identities %}
    identity :{{ i.identity_name }}, [{% for k in i.keys | split(pat=",") %}:{{ k }}{% if not loop.last %}, {% endif %}{% endfor %}]{% if i.eager and i.eager != "" %}, eager_check?: {{ i.eager }}{% endif %}{% if i.eager_with and i.eager_with != "" %}, eager_check_with: {{ i.eager_with }}{% endif %}{% if i.pre and i.pre != "" %}, pre_check?: {{ i.pre }}{% endif %}{% if i.pre_with and i.pre_with != "" %}, pre_check_with: {{ i.pre_with }}{% endif %}{% if i.nils and i.nils != "" %}, nils_distinct?: {{ i.nils }}{% endif %}{% if i.all_tenants and i.all_tenants != "" %}, all_tenants?: {{ i.all_tenants }}{% endif %}{% if i.field_names and i.field_names != "" %}, field_names: [{% for f in i.field_names | split(pat=",") %}:{{ f | trim }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}{% if i.where_expr and i.where_expr != "" %}, where: {{ i.where_expr }}{% endif %}{% if i.message and i.message != "" %}, message: "{{ i.message }}"{% endif %}{% if i.description and i.description != "" %}, description: "{{ i.description }}"{% endif %}
{%- endfor %}
  end
{%- endif %}
{%- if my_validations | length > 0 %}

  validations do
{%- for v in my_validations %}
{%- set attr_list = v.attrs | default(value="") | split(pat=",") %}
{%- set w_list = v.where_list | default(value="") %}
    validate {% if v.kind == "raw" %}{{ v.value }}{% else %}{{ v.kind }}({% if v.kind == "present" or v.kind == "absent" or v.kind == "attributes_present" or v.kind == "attributes_absent" %}[{% for a in attr_list %}:{{ a }}{% if not loop.last %}, {% endif %}{% endfor %}]{% else %}:{{ attr_list | first }}{% endif %}{% if v.value and v.value != "" %}, {{ v.value }}{% endif %}{% if v.vopts and v.vopts != "" %}, {{ v.vopts }}{% endif %}){% endif %}{% if v.on and v.on != "" %}, on: [{% for o in v.on | split(pat=",") %}:{{ o | trim }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}{% if (v.for_action and v.for_action != "") or w_list != "" %}, where: [{% if v.for_action and v.for_action != "" %}action_is(:{{ v.for_action }}){% endif %}{% if v.for_action and v.for_action != "" and w_list != "" %}, {% endif %}{% if w_list != "" %}{% for w in w_list | split(pat=";") %}{{ w | trim }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}]{% endif %}{% if v.message and v.message != "" %}, message: "{{ v.message }}"{% endif %}{% if v.only_when_valid and v.only_when_valid != "" %}, only_when_valid?: {{ v.only_when_valid }}{% endif %}{% if v.before_action and v.before_action != "" %}, before_action?: {{ v.before_action }}{% endif %}{% if v.always_atomic and v.always_atomic != "" %}, always_atomic?: {{ v.always_atomic }}{% endif %}{% if v.description and v.description != "" %}, description: "{{ v.description }}"{% endif %}
{%- endfor %}
  end
{%- endif %}
end
