---
to: "lib/{{ app_path }}/{{ ext_file }}_persist.ex"
force: true
for_each: "exts"
sparql:
  exts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?ext_module ?app_path ?ext_file ?persist_key WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:appPath ?app_path ; aap:extFile ?ext_file .
      OPTIONAL { ?e aap:extPersistKey ?persist_key }
    } ORDER BY ?ext_module
  sections: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?ext_module ?section_name WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:sparkSection ?s .
      ?s aap:name ?section_name .
    } ORDER BY ?ext_module ?section_name
---
# GENERATED by ash-a2a-app-pack (L18 spark persist transformer) from the application ontology. Do not hand-edit.
{% set my_sections = sections | filter(attribute="ext_module", value=ext_module) -%}
defmodule {{ ext_module }}.Persist do
  @moduledoc "Persists per-section entity counts (Spark.Dsl.Transformer.persist/3, transformer.ex:88)."
  use Spark.Dsl.Transformer

  @impl true
  def transform(dsl_state) do
    summary = %{
{%- for s in my_sections %}
      {{ s.section_name }}: Spark.Dsl.Transformer.get_entities(dsl_state, [:{{ s.section_name }}]) |> length(){% if not loop.last %},{% endif %}
{%- endfor %}
    }

    {:ok, Spark.Dsl.Transformer.persist(dsl_state, :{{ persist_key | default(value="spark_summary") }}, summary)}
  end
end
