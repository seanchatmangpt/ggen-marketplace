---
to: "lib/{{ app_path }}/{{ resource_file }}_l21.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:skill ?s .
      ?d aap:appPath ?app_path .
      ?s aap:hddlOperator ?o .
    } ORDER BY ?module_name
  skills: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?skill_name ?action_name ?consequence WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skill ?s .
      ?s aap:name ?skill_name ; aap:ofAction ?action_name ; aap:hddlOperator ?o .
      OPTIONAL { ?s aap:consequence ?c }
      BIND(COALESCE(?c, "") AS ?consequence)
    } ORDER BY ?module_name ?skill_name
  params: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?skill_name ?pname ?ord WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skill ?s .
      ?s aap:name ?skill_name ; aap:hddlOperator ?o .
      ?o aap:hddlParam ?p . ?p aap:paramName ?pname .
      OPTIONAL { ?p aap:paramOrder ?po }
      BIND(COALESCE(?po, 0) AS ?ord)
    } ORDER BY ?module_name ?skill_name ?ord
  facts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?skill_name ?role ?fact_ord ?predicate ?fact_key WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skill ?s .
      ?s aap:name ?skill_name ; aap:hddlOperator ?o .
      ?o aap:hddlFact ?f . ?f aap:factRole ?role ; aap:predicate ?predicate .
      OPTIONAL { ?f aap:factOrder ?fo }
      BIND(COALESCE(?fo, 0) AS ?fact_ord)
      BIND(CONCAT(?skill_name, "/", ?role, "/", ?predicate, "/", STR(?fact_ord)) AS ?fact_key)
    } ORDER BY ?module_name ?skill_name ?role ?fact_ord
  fact_args: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?fact_key ?aname ?ord WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skill ?s .
      ?s aap:name ?skill_name ; aap:hddlOperator ?o .
      ?o aap:hddlFact ?f . ?f aap:factRole ?role ; aap:predicate ?predicate ; aap:factArg ?a .
      ?a aap:argName ?aname .
      OPTIONAL { ?f aap:factOrder ?fo }
      OPTIONAL { ?a aap:argOrder ?ao }
      BIND(COALESCE(?fo, 0) AS ?fact_ord)
      BIND(COALESCE(?ao, 0) AS ?ord)
      BIND(CONCAT(?skill_name, "/", ?role, "/", ?predicate, "/", STR(?fact_ord)) AS ?fact_key)
    } ORDER BY ?module_name ?fact_key ?ord
---
# GENERATED by ash-a2a-app-pack (lane L21) from the application ontology. Do not hand-edit.
{% set my_skills = skills | filter(attribute="module_name", value=module_name) -%}
{% set my_params = params | filter(attribute="module_name", value=module_name) -%}
{% set my_facts = facts | filter(attribute="module_name", value=module_name) -%}
{% set my_args = fact_args | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.L21Operators do
  use Spark.Dsl.Fragment,
    of: Ash.Resource,
    extensions: [AshA2A]

  a2a do
{%- for s in my_skills %}
{%- set sparams = my_params | filter(attribute="skill_name", value=s.skill_name) %}
{%- set sfacts = my_facts | filter(attribute="skill_name", value=s.skill_name) %}

    skill :{{ s.skill_name }}, :{{ s.action_name }} do
{%- if s.consequence != "" %}
      consequence(:{{ s.consequence }})
{%- endif %}

      hddl_operator do
        parameters([{% for p in sparams %}:{{ p.pname }}{% if not loop.last %}, {% endif %}{% endfor %}])
{%- for role in ["precondition", "add_effect", "delete_effect"] %}
{%- set rfacts = sfacts | filter(attribute="role", value=role) %}
{%- if rfacts | length > 0 %}
        {% if role == "precondition" %}preconditions{% elif role == "add_effect" %}add_effects{% else %}delete_effects{% endif %}([{% for f in rfacts %}{% set fargs = my_args | filter(attribute="fact_key", value=f.fact_key) %}{ :{{ f.predicate }}, [{% for a in fargs %}:{{ a.aname }}{% if not loop.last %}, {% endif %}{% endfor %}] }{% if not loop.last %}, {% endif %}{% endfor %}])
{%- endif %}
{%- endfor %}
      end
    end
{%- endfor %}
  end
end
