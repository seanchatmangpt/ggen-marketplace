---
to: "lib/{{ app_path }}/{{ notifier_file }}.ex"
force: true
for_each: "notifiers"
sparql:
  notifiers: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?notifier_module ?app_path ?notifier_file ?resource_module WHERE {
      ?r a aap:Resource ; aap:moduleName ?resource_module ; aap:inDomain ?d ; aap:notifier ?n .
      ?d aap:appPath ?app_path .
      ?n aap:moduleName ?notifier_module ; aap:notifierFile ?notifier_file .
    } ORDER BY ?notifier_module
  bridges: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?notifier_module ?b_action ?b_kind ?b_field ?b_final ?b_transport WHERE {
      ?r a aap:Resource ; aap:notifier ?n .
      ?n aap:moduleName ?notifier_module ; aap:bridge ?b .
      ?b aap:bridgeAction ?b_action ; aap:bridgeKind ?b_kind ; aap:bridgeTaskIdField ?b_field .
      OPTIONAL { ?b aap:bridgeFinal ?b_final }
      OPTIONAL { ?b aap:bridgeTransport ?b_transport }
    } ORDER BY ?notifier_module ?b_action
  delegates: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?notifier_module ?d_module ?d_action WHERE {
      ?r a aap:Resource ; aap:notifier ?n .
      ?n aap:moduleName ?notifier_module ; aap:delegate ?dg .
      ?dg aap:delegateModule ?d_module .
      OPTIONAL { ?dg aap:delegateAction ?d_action }
    } ORDER BY ?notifier_module ?d_module
---
# GENERATED by ash-a2a-app-pack lane L11 from the application ontology. Do not hand-edit.
{% set my_bridges = bridges | filter(attribute="notifier_module", value=notifier_module) -%}
{% set my_delegates = delegates | filter(attribute="notifier_module", value=notifier_module) -%}
defmodule {{ notifier_module }} do
  @moduledoc """
  Simple Ash notifier for `{{ resource_module }}` (add to `simple_notifiers:`).
  Bridges action notifications into `AshA2A.A2ATransport.TaskEvents`.
  """
  use Ash.Notifier

  @impl true
  def notify(%Ash.Notifier.Notification{} = notification) do
    action = notification.action && notification.action.name
    dispatch(action, notification)
    :ok
  end
{% for b in my_bridges %}
  defp dispatch(:{{ b.b_action }}, %Ash.Notifier.Notification{data: data} = notification) do
    transport = {{ b.b_transport | default(value="AshA2A.A2ATransport") }}

    case Map.get(data, :{{ b.b_field }}) do
      nil ->
        :ok

      task_id ->
        if Process.whereis(AshA2A.A2ATransport.events_name(transport)) do
          AshA2A.A2ATransport.TaskEvents.publish(
            transport,
            to_string(task_id),
            "{{ b.b_kind }}",
            %{
              "resource" => inspect(notification.resource),
              "action" => to_string(notification.action.name),
              "id" => to_string(task_id)
            },
            {{ b.b_final | default(value="false") }}
          )
        end

        forward(:{{ b.b_action }}, notification)
    end
  end
{% endfor %}
  defp dispatch(action, notification), do: forward(action, notification)

  defp forward(action, notification) do
{%- for d in my_delegates %}
{%- if d.d_action | default(value="") != "" %}
    if action == :{{ d.d_action }}, do: {{ d.d_module }}.notify(notification)
{%- else %}
    _ = action
    {{ d.d_module }}.notify(notification)
{%- endif %}
{%- endfor %}
    :ok
  end
end
