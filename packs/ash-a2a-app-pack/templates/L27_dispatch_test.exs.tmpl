---
to: "test/{{ agent_file }}_dispatch_test.exs"
force: true
for_each: "agents"
sparql:
  agents: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?agent_name ?agent_file WHERE {
      ?a a aap:Agent ; aap:moduleName ?module_name ; aap:agentName ?agent_name ; aap:agentFile ?agent_file .
    } ORDER BY ?module_name
  read_skills: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?agent_module ?res_module ?skill_name ?consequence ?lease ?has_policy WHERE {
      ?a a aap:Agent ; aap:moduleName ?agent_module ; aap:forDomain ?d .
      ?r a aap:Resource ; aap:inDomain ?d ; aap:moduleName ?res_module ; aap:skill ?s ; aap:action ?act .
      ?s aap:name ?skill_name ; aap:ofAction ?action_name .
      ?act aap:name ?action_name ; aap:actionType "read" .
      OPTIONAL { ?s aap:consequence ?consequence }
      OPTIONAL { ?s aap:leaseRequired ?lease }
      BIND(IF(EXISTS { ?r aap:policy ?p }, "true", "false") AS ?has_policy)
    } ORDER BY ?agent_module ?res_module ?skill_name
  creates: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?res_module ?create_action ?create_accept WHERE {
      ?r a aap:Resource ; aap:moduleName ?res_module ; aap:action ?act .
      ?act aap:name ?create_action ; aap:actionType "create" .
      OPTIONAL { ?act aap:accept ?create_accept }
    } ORDER BY ?res_module ?create_action
  attrs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?res_module ?attr_name ?ash_type ?pk WHERE {
      ?r a aap:Resource ; aap:moduleName ?res_module ; aap:attribute ?a .
      ?a aap:name ?attr_name ; aap:ashType ?ash_type ; aap:primaryKey ?pk .
    } ORDER BY ?res_module ?attr_name
---
# GENERATED by ash-a2a-app-pack (L27) from the application ontology. Do not hand-edit.
# Calls AshA2A.Dispatcher.dispatch/6 for every :read skill and asserts the REPLY content.
# Skipped skills carry a visible `L27-SKIP` reason (ExUnit reports them as skipped).
defmodule {{ module_name }}DispatchTest do
  use ExUnit.Case, async: true

  alias AshA2A.Protocol.{Message, Part}

  defp l27_message(input), do: Message.new_user([Part.Data.new(input)])
{%- set my_skills = read_skills | filter(attribute="agent_module", value=module_name) %}
{%- for s in my_skills %}
{%- set my_attrs = attrs | filter(attribute="res_module", value=s.res_module) %}
{%- set my_creates = creates | filter(attribute="res_module", value=s.res_module) %}
{%- set pks = my_attrs | filter(attribute="pk", value="true") %}
{%- set consequence = s.consequence | default(value="observe") %}
{%- set lease = s.lease | default(value="false") %}
{%- if lease == "true" %}

  @tag skip: "L27-SKIP lease_required: {{ s.skill_name }} needs an active capability lease"
  test "L27 dispatch read skill {{ s.skill_name }} (lease-gated)" do
    :skipped
  end
{%- elif consequence != "observe" %}

  @tag skip: "L27-SKIP consequence={{ consequence }}: {{ s.skill_name }} is refused outside the consequence-kernel fence"
  test "L27 dispatch read skill {{ s.skill_name }} (consequence-gated)" do
    :skipped
  end
{%- elif s.has_policy == "true" %}

  @tag skip: "L27-SKIP policy-gated: {{ s.res_module }} carries Ash policies, no actor available to the generated test"
  test "L27 dispatch read skill {{ s.skill_name }} (policy-gated)" do
    :skipped
  end
{%- else %}

  test "L27 dispatch read skill {{ s.skill_name }} returns real record content" do
{%- if my_creates | length > 0 %}
{%- set c = my_creates | first %}
{%- set accepted = c.create_accept | default(value="") | split(pat=",") %}
    params = %{
{%- for an in accepted %}
{%- if an != "" %}
{%- set at = my_attrs | filter(attribute="attr_name", value=an) %}
{%- if at | length > 0 %}
{%- set at_first = at | first %}
{%- set ty = at_first.ash_type %}
{%- if ty == "string" %}
      "{{ an }}" => "l27-{{ an }}",
{%- elif ty == "integer" %}
      "{{ an }}" => 1,
{%- elif ty == "boolean" %}
      "{{ an }}" => true,
{%- elif ty == "float" %}
      "{{ an }}" => 1.0,
{%- elif ty == "uuid" %}
      "{{ an }}" => Ash.UUID.generate(),
{%- endif %}
{%- endif %}
{%- endif %}
{%- endfor %}
    }

    {:ok, created} =
      {{ s.res_module }}
      |> Ash.Changeset.for_create(:{{ c.create_action }}, params)
      |> Ash.create(authorize?: false)
{%- endif %}

    assert {:reply, [%Part.Data{data: %{results: results}}]} =
             AshA2A.Dispatcher.dispatch(:{{ s.skill_name }}, l27_message(%{}), {{ s.res_module }}, [], nil, [])

    assert is_list(results)
{%- if my_creates | length > 0 %}
{%- if pks | length > 0 %}
{%- set pk_first = pks | first %}
{%- set pk = pk_first.attr_name %}
    assert Enum.any?(results, fn row -> row.{{ pk }} == created.{{ pk }} end),
           "created record not in {{ s.skill_name }} reply: #{inspect(results)}"
{%- else %}
    assert results != [], "created record not in {{ s.skill_name }} reply"
{%- endif %}
{%- for an in accepted %}
{%- if an != "" %}
{%- set at = my_attrs | filter(attribute="attr_name", value=an) %}
{%- if at | length > 0 %}
{%- set at_first2 = at | first %}
{%- if at_first2.ash_type == "string" %}
    assert Enum.any?(results, fn row -> row.{{ an }} == "l27-{{ an }}" end),
           "reply of {{ s.skill_name }} lacks {{ an }} content: #{inspect(results)}"
{%- endif %}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- endif %}
  end
{%- endif %}
{%- endfor %}
{%- if my_skills | length == 0 %}

  @tag skip: "L27-SKIP no read skills declared for {{ module_name }}"
  test "L27 dispatch (no read skills)" do
    :skipped
  end
{%- endif %}
end
