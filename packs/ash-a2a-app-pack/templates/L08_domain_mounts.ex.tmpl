---
to: "lib/{{ app_path }}/{{ domain_file }}_l08.ex"
force: true
for_each: "domains"
sparql:
  domains: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?domain_file WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:appPath ?app_path ;
         aap:domainFile ?domain_file ; aap:mount ?m .
    } ORDER BY ?module_name
  mounts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?domain_module ?agent ?path ?binding ?tenant WHERE {
      ?d a aap:Domain ; aap:moduleName ?domain_module ; aap:mount ?m .
      ?m aap:mountAgent ?agent_ref ; aap:mountPath ?path .
      OPTIONAL { ?agent_ref aap:moduleName ?agent_mod }
      BIND(COALESCE(STR(?agent_mod), STR(?agent_ref)) AS ?agent)
      OPTIONAL { ?m aap:mountBinding ?binding }
      OPTIONAL { ?m aap:mountTenant ?tenant }
      FILTER NOT EXISTS { ?m aap:mountOf ?other }
      FILTER NOT EXISTS { ?d aap:a2aConfigured "true" }
    } ORDER BY ?domain_module ?path
---
# GENERATED by ash-a2a-app-pack (L08) from the application ontology. Do not hand-edit.
{% set mine = mounts | filter(attribute="domain_module", value=module_name) -%}
defmodule {{ module_name }}.MountsL08 do
  @moduledoc false
  use Spark.Dsl.Fragment, of: Ash.Domain, extensions: [AshA2A.Domain]

  transport do
{%- for m in mine %}
    mount(agent: {{ m.agent }}, path: "{{ m.path }}"{% if m.binding %}, binding: :{{ m.binding }}{% endif %}{% if m.tenant %}, tenant: "{{ m.tenant }}"{% endif %})
{%- endfor %}
  end
end
