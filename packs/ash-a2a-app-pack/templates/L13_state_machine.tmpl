---
to: "lib/{{ app_path }}/{{ resource_file }}_l13.ex"
force: true
for_each: "machines"
sparql:
  machines: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?resource_file ?state_attr ?default_state WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:stateMachine ?m .
      ?d aap:appPath ?app_path .
      OPTIONAL { ?m aap:stateAttribute ?state_attr }
      OPTIONAL { ?m aap:defaultInitialState ?ds . ?ds aap:name ?default_state }
    } ORDER BY ?module_name
  initials: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?state_name WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:stateMachine ?m .
      ?m aap:initialState ?s . ?s aap:name ?state_name .
    } ORDER BY ?module_name ?state_name
  extras: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?state_name WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:stateMachine ?m .
      ?m aap:extraState ?s . ?s aap:name ?state_name .
    } ORDER BY ?module_name ?state_name
  deprecated: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?state_name WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:stateMachine ?m .
      ?m aap:deprecatedState ?s . ?s aap:name ?state_name .
    } ORDER BY ?module_name ?state_name
  transitions: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?tid ?via ?target WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:stateMachine ?m .
      ?m aap:smTransition ?t . ?t aap:viaAction ?via .
      OPTIONAL { ?t aap:transitionTarget ?ts . ?ts aap:name ?target }
      BIND(STR(?t) AS ?tid)
    } ORDER BY ?module_name ?tid
  t_from: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?tid ?st WHERE {
      ?m aap:smTransition ?t .
      { ?t aap:fromState ?s . ?s aap:name ?st }
      UNION { ?t aap:fromAny true . BIND("*" AS ?st) }
      BIND(STR(?t) AS ?tid)
    } ORDER BY ?tid ?st
  t_to: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?tid ?st WHERE {
      ?m aap:smTransition ?t .
      { ?t aap:toState ?s . ?s aap:name ?st }
      UNION { ?t aap:toAny true . BIND("*" AS ?st) }
      BIND(STR(?t) AS ?tid)
    } ORDER BY ?tid ?st
---
# GENERATED by ash-a2a-app-pack lane L13 from the application ontology. Do not hand-edit.
{% set my_initials = initials | filter(attribute="module_name", value=module_name) -%}
{% set my_extras = extras | filter(attribute="module_name", value=module_name) -%}
{% set my_deprecated = deprecated | filter(attribute="module_name", value=module_name) -%}
{% set my_transitions = transitions | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.StateMachine do
  use Spark.Dsl.Fragment, of: Ash.Resource, extensions: [AshStateMachine]

  state_machine do
    state_attribute(:{{ state_attr | default(value="state") }})
    initial_states([{% for i in my_initials %}:{{ i.state_name }}{% if not loop.last %}, {% endif %}{% endfor %}])
{%- if default_state %}
    default_initial_state(:{{ default_state }})
{%- endif %}
{%- if my_extras | length > 0 %}
    extra_states([{% for e in my_extras %}:{{ e.state_name }}{% if not loop.last %}, {% endif %}{% endfor %}])
{%- endif %}
{%- if my_deprecated | length > 0 %}
    deprecated_states([{% for e in my_deprecated %}:{{ e.state_name }}{% if not loop.last %}, {% endif %}{% endfor %}])
{%- endif %}

    transitions do
{%- for t in my_transitions %}
{%- set froms = t_from | filter(attribute="tid", value=t.tid) %}
{%- set tos = t_to | filter(attribute="tid", value=t.tid) %}
      transition(:{{ t.via }},
        from: [{% for f in froms %}:{{ f.st }}{% if not loop.last %}, {% endif %}{% endfor %}],
        to: [{% for o in tos %}:{{ o.st }}{% if not loop.last %}, {% endif %}{% endfor %}]
      )
{%- endfor %}
    end
  end
{%- set targeted = my_transitions | filter(attribute="target") %}
{%- if targeted | length > 0 %}

  changes do
{%- for t in my_transitions %}
{%- if t.target and t.via != "*" %}
    change(transition_state(:{{ t.target }}), where: [action_is(:{{ t.via }})])
{%- endif %}
{%- endfor %}
  end
{%- endif %}
end
