---
to: "lib/{{ app_path }}/{{ enum_file }}.ex"
force: true
for_each: "enums"
sparql:
  enums: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?enum_file WHERE {
      ?e a aap:EnumType ; aap:moduleName ?module_name ; aap:inDomain ?d ; aap:enumFile ?enum_file .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  vals: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?value_name ?description ?label ?ord WHERE {
      ?e a aap:EnumType ; aap:moduleName ?module_name ; aap:enumValue ?v .
      ?v aap:name ?value_name .
      OPTIONAL { ?v aap:description ?description }
      OPTIONAL { ?v aap:label ?label }
      OPTIONAL { ?v aap:order ?o0 }
      BIND(COALESCE(?o0, 0) AS ?ord)
    } ORDER BY ?module_name ?ord ?value_name
---
# GENERATED by ash-a2a-app-pack lane L01 from the application ontology. Do not hand-edit.
{% set my_vals = vals | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }} do
  use Ash.Type.Enum,
    values: [
{%- for v in my_vals %}
{%- set d = v.description | default(value="") %}
{%- set l = v.label | default(value="") %}
{%- if d != "" and l != "" %}
      {{ v.value_name }}: [description: "{{ d }}", label: "{{ l }}"]{% if not loop.last %},{% endif %}
{%- elif l != "" %}
      {{ v.value_name }}: [label: "{{ l }}"]{% if not loop.last %},{% endif %}
{%- elif d != "" %}
      {{ v.value_name }}: "{{ d }}"{% if not loop.last %},{% endif %}
{%- else %}
      {{ v.value_name }}: nil{% if not loop.last %},{% endif %}
{%- endif %}
{%- endfor %}
    ]
end
