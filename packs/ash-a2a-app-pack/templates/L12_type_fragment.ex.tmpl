---
to: "lib/{{ app_path }}/{{ resource_file }}_l12.ex"
force: true
for_each: "owners"
sparql:
  owners: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:typedAttribute ?a .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  typed: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?attr_name ?ash_type ?ref_module ?is_array ?allow_nil ?constraints ?default_value WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:typedAttribute ?a .
      ?a aap:name ?attr_name .
      OPTIONAL { ?a aap:ashType ?ash_type }
      OPTIONAL { ?a aap:typeRef ?t . ?t aap:moduleName ?ref_module }
      OPTIONAL { ?a aap:isArray ?is_array }
      OPTIONAL { ?a aap:allowNil ?allow_nil }
      OPTIONAL { ?a aap:typeConstraints ?constraints }
      OPTIONAL { ?a aap:defaultValue ?default_value }
    } ORDER BY ?module_name ?attr_name
---
# GENERATED by ash-a2a-app-pack (lane L12) from the application ontology. Do not hand-edit.
{% set my_typed = typed | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.TypesL12 do
  use Spark.Dsl.Fragment, of: Ash.Resource

  attributes do
{%- for a in my_typed %}
    attribute(:{{ a.attr_name }}, {% if a.is_array | default(value="") == "true" %}{ :array, {% endif %}{% if a.ref_module | default(value="") != "" %}{{ a.ref_module }}{% else %}:{{ a.ash_type | default(value="string") }}{% endif %}{% if a.is_array | default(value="") == "true" %} }{% endif %}, public?: true{% if a.allow_nil | default(value="") == "false" %}, allow_nil?: false{% endif %}{% if a.default_value | default(value="") != "" %}, default: {{ a.default_value | safe }}{% endif %}{% if a.constraints | default(value="") != "" %}, constraints: {{ a.constraints | safe }}{% endif %})
{%- endfor %}
  end
end
