---
to: "lib/{{ app_path }}/{{ agent_file }}_configured_l17.ex"
force: true
for_each: "agents"
sparql:
  agents: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?agent_name ?domain_module ?app_path ?agent_file ?description ?version ?require_auth ?strict_observe
           ?mode ?max_in_flight ?rate_count ?rate_per_ms ?cancel ?events ?validate_modes ?user_artifacts ?adapter
           ?sweep_ms ?lease_ms WHERE {
      ?a a aap:Agent ; aap:moduleName ?module_name ; aap:agentName ?agent_name ;
         aap:forDomain ?d ; aap:agentFile ?agent_file ; aap:agentConfigured "true" .
      ?d aap:moduleName ?domain_module ; aap:appPath ?app_path .
      OPTIONAL { ?a aap:agentDescription ?description }
      OPTIONAL { ?a aap:agentVersion ?version }
      OPTIONAL { ?a aap:requireAuthenticatedCaller ?require_auth }
      OPTIONAL { ?a aap:strictObserveGenericActions ?strict_observe }
      OPTIONAL { ?a aap:execMode ?mode }
      OPTIONAL { ?a aap:execMaxInFlight ?max_in_flight }
      OPTIONAL { ?a aap:execRateCount ?rate_count }
      OPTIONAL { ?a aap:execRatePerMs ?rate_per_ms }
      OPTIONAL { ?a aap:execCancelInFlight ?cancel }
      OPTIONAL { ?a aap:execEventsTransport ?events }
      OPTIONAL { ?a aap:execValidateInputModes ?validate_modes }
      OPTIONAL { ?a aap:execUserArtifacts ?user_artifacts }
      OPTIONAL { ?a aap:execAdapter ?adapter }
      OPTIONAL { ?a aap:execOrphanSweepIntervalMs ?sweep_ms }
      OPTIONAL { ?a aap:execOrphanLeaseMs ?lease_ms }
    } ORDER BY ?module_name
  facets: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?facet ?val WHERE {
      ?a a aap:Agent ; aap:moduleName ?module_name ; aap:agentConfigured "true" .
      { ?a aap:publicSkill ?val . BIND ("public" AS ?facet) }
      UNION { ?a aap:observeGenericAction ?val . BIND ("observe" AS ?facet) }
    } ORDER BY ?module_name ?facet ?val
---
# GENERATED by ash-a2a-app-pack (L17 AshA2A.Agent options) from the application ontology. Do not hand-edit.
{% set my_facets = facets | filter(attribute="module_name", value=module_name) -%}
{% set publics = my_facets | filter(attribute="facet", value="public") -%}
{% set observes = my_facets | filter(attribute="facet", value="observe") -%}
defmodule {{ module_name }}.Configured do
  use AshA2A.Agent,
    resource_or_domain: {{ domain_module }},
    name: {{ agent_name | json_encode | safe }},
    require_authenticated_caller: {{ require_auth | default(value="true") }}
{%- if description | default(value="") != "" %},
    description: {{ description | json_encode | safe }}
{%- endif %}
{%- if version | default(value="") != "" %},
    version: {{ version | json_encode | safe }}
{%- endif %}
{%- if publics | length > 0 %},
    public_skills: [{% for p in publics %}:{{ p.val }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if observes | length > 0 %},
    observe_generic_actions: [{% for p in observes %}:{{ p.val }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
{%- if strict_observe | default(value="") != "" %},
    strict_observe_generic_actions: {{ strict_observe }}
{%- endif %}
{%- if mode | default(value="") != "" or max_in_flight | default(value="") != "" or rate_count | default(value="") != "" or cancel | default(value="") != "" or events | default(value="") != "" or validate_modes | default(value="") != "" or user_artifacts | default(value="") != "" or adapter | default(value="") != "" or sweep_ms | default(value="") != "" or lease_ms | default(value="") != "" %},
    execution: [
      mode: :{{ mode | default(value="async") }}
{%- if max_in_flight | default(value="") != "" %},
      max_in_flight: {{ max_in_flight }}
{%- endif %}
{%- if rate_count | default(value="") != "" and rate_per_ms | default(value="") != "" %},
      rate_limit: { {{ rate_count }}, {{ rate_per_ms }} }
{%- endif %}
{%- if cancel | default(value="") != "" %},
      cancel_in_flight: :{{ cancel }}
{%- endif %}
{%- if events | default(value="") != "" %},
      events_transport: {{ events | safe }}
{%- endif %}
{%- if validate_modes | default(value="") != "" %},
      validate_input_modes: {{ validate_modes }}
{%- endif %}
{%- if user_artifacts | default(value="") != "" %},
      user_artifacts: {{ user_artifacts }}
{%- endif %}
{%- if adapter | default(value="") != "" and adapter != "local" %},
      adapter: :{{ adapter }}
{%- endif %}
{%- if sweep_ms | default(value="") != "" %},
      orphan_sweep_interval_ms: {{ sweep_ms }}
{%- endif %}
{%- if lease_ms | default(value="") != "" %},
      orphan_lease_ms: {{ lease_ms }}
{%- endif %}
    ]
{%- endif %}
end
