---
to: "lib/{{ app_path }}/{{ ext_file }}_verify.ex"
force: true
for_each: "exts"
sparql:
  exts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?ext_module ?app_path ?ext_file WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:appPath ?app_path ; aap:extFile ?ext_file .
    } ORDER BY ?ext_module
  mins: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?ext_module ?section_name ?min_entities WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:sparkSection ?s .
      ?s aap:name ?section_name ; aap:minEntities ?min_entities .
    } ORDER BY ?ext_module ?section_name
  uniques: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?ext_module ?section_name ?unique_field WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:sparkSection ?s .
      ?s aap:name ?section_name ; aap:sparkEntity ?n .
      ?n aap:uniqueField ?unique_field .
    } ORDER BY ?ext_module ?section_name ?unique_field
---
# GENERATED by ash-a2a-app-pack (L18 spark verifier) from the application ontology. Do not hand-edit.
{% set my_mins = mins | filter(attribute="ext_module", value=ext_module) -%}
{% set my_uniques = uniques | filter(attribute="ext_module", value=ext_module) -%}
defmodule {{ ext_module }}.Verify do
  @moduledoc "Spark.Verifier (verifier.ex:18): entity-count and uniqueness laws declared in the ontology."
  use Spark.Dsl.Verifier
  alias Spark.Dsl.Verifier
  alias Spark.Error.DslError

  @impl true
  def verify(dsl_state) do
    module = Verifier.get_persisted(dsl_state, :module)

    with :ok <- :ok,{% for m in my_mins %}
         :ok <- min_entities(dsl_state, module, :{{ m.section_name }}, {{ m.min_entities }}),{% endfor %}{% for u in my_uniques %}
         :ok <- unique(dsl_state, module, :{{ u.section_name }}, :{{ u.unique_field }}),{% endfor %}
         :ok <- :ok do
      :ok
    end
  end

  defp min_entities(dsl_state, module, section, min) do
    n = Verifier.get_entities(dsl_state, [section]) |> length()

    if n == 0 or n >= min,
      do: :ok,
      else: {:error, DslError.exception(module: module, path: [section], message: "#{section} requires at least #{min} entities, got #{n}")}
  end

  defp unique(dsl_state, module, section, field) do
    vals = Verifier.get_entities(dsl_state, [section]) |> Enum.map(&Map.get(&1, field))

    case vals -- Enum.uniq(vals) do
      [] -> :ok
      dups -> {:error, DslError.exception(module: module, path: [section], message: "duplicate #{field}: #{inspect(Enum.uniq(dups))}")}
    end
  end
end
