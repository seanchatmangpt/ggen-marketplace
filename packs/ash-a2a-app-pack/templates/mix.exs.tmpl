---
to: "mix.exs"
force: true
sparql:
  app: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?app_name ?app_module ?ash_a2a_dep ?pplan_dep ?has_postgres ?has_sqlite ?has_mnesia
           ?has_oban ?has_ash_oban ?has_pubsub ?has_state_machine ?has_pplan_lib ?has_plan_case
           ?has_reactor ?has_courts ?has_bandit WHERE {
      ?p a aap:Project ; aap:appName ?app_name ; aap:appModule ?app_module ; aap:ashA2aDep ?ash_a2a_dep .
      OPTIONAL { ?p aap:ashPPlanDep ?pplan_dep }
      BIND(IF(EXISTS { ?r1 a aap:Resource ; aap:dataLayer "postgres" }
              || EXISTS { ?rp1 a aap:Repo ; aap:repoKind "postgres" }, "true", "false") AS ?has_postgres)
      BIND(IF(EXISTS { ?r2 a aap:Resource ; aap:dataLayer "sqlite" }
              || EXISTS { ?rp2 a aap:Repo ; aap:repoKind "sqlite" }, "true", "false") AS ?has_sqlite)
      BIND(IF(EXISTS { ?r3 a aap:Resource ; aap:dataLayer "mnesia" }, "true", "false") AS ?has_mnesia)
      BIND(IF(EXISTS { ?r4 aap:obTrigger ?t4 } || EXISTS { ?r5 aap:obSchedule ?s5 }, "true", "false") AS ?has_ash_oban)
      BIND(IF(EXISTS { ?r6 aap:obTrigger ?t6 } || EXISTS { ?r7 aap:obSchedule ?s7 }
              || EXISTS { ?c8 a aap:ObanConfig } || EXISTS { ?q9 a aap:ObanQueue }
              || EXISTS { ?w10 a aap:ObanDeliveryWorker }, "true", "false") AS ?has_oban)
      BIND(IF(EXISTS { ?r11 aap:pubSub ?ps11 } || EXISTS { ?s12 a aap:PubSubServer }
              || EXISTS { ?n13 a aap:A2ABridge }, "true", "false") AS ?has_pubsub)
      BIND(IF(EXISTS { ?r14 aap:stateMachine ?sm14 }, "true", "false") AS ?has_state_machine)
      BIND(IF(EXISTS { ?d15 aap:ppWorkflow ?w15 } || EXISTS { ?d16 aap:ppProvider ?pr16 }
              || EXISTS { ?d17 aap:ppPack ?pk17 } || EXISTS { ?r18 aap:ppControlPlane ?cp18 }
              || EXISTS { ?d19 aap:ppTarget ?t19 }, "true", "false") AS ?has_pplan_lib)
      BIND(IF(EXISTS { ?c20 a aap:PlanCase }, "true", "false") AS ?has_plan_case)
      BIND(IF(EXISTS { ?x21 a aap:Reactor } || EXISTS { ?c22 a aap:ReactorCase }
              || EXISTS { ?d23 aap:ppWorkflow ?w23 }, "true", "false") AS ?has_reactor)
      BIND(IF(EXISTS { ?c24 a aap:CourtCase } || EXISTS { ?c25 a aap:ShimCourt }, "true", "false") AS ?has_courts)
      BIND("true" AS ?has_bandit)
    }
---
# GENERATED by ash-a2a-app-pack from the application ontology. Do not hand-edit.
{%- set a = app[0] %}
defmodule {{ a.app_module }}.MixProject do
  use Mix.Project

  def project do
    [
      app: :{{ a.app_name }},
      version: "0.1.0",
      elixir: "~> 1.19",
      deps: deps()
    ]
  end

  def application do
    [extra_applications: [:logger{% if a.has_mnesia == "true" %}, :mnesia{% endif %}]]
  end

  defp deps do
    [
      {:ash, "~> 3.0"},
      {:simple_sat, "~> 0.1 and >= 0.1.1"},
      {:ash_a2a, {{ a.ash_a2a_dep }}},
      {:bandit, "~> 1.0"},
{%- if a.has_postgres == "true" %}
      {:ash_postgres, "~> 2.0"},
{%- endif %}
{%- if a.has_sqlite == "true" %}
      {:ash_sqlite, "~> 0.2"},
{%- endif %}
{%- if a.has_oban == "true" %}
      {:oban, "~> 2.19"},
{%- endif %}
{%- if a.has_ash_oban == "true" %}
      {:ash_oban, "~> 0.8 or ~> 0.9"},
{%- endif %}
{%- if a.has_state_machine == "true" %}
      {:ash_state_machine, "~> 0.2"},
{%- endif %}
{%- if a.has_pubsub == "true" %}
      {:phoenix_pubsub, "~> 2.1"},
{%- endif %}
{%- if a.has_reactor == "true" %}
      {:reactor, ">= 0.11.0"},
{%- endif %}
{%- if a.has_pplan_lib == "true" %}
      {:ash_pplan, {{ a.pplan_dep | default(value='"~> 26.10"') | safe }}},
      {:opentelemetry_api, "~> 1.4"},
{%- elif a.has_plan_case == "true" %}
      {:ash_pplan, {{ a.pplan_dep | default(value='"~> 26.10"') | safe }}, only: :test},
      {:opentelemetry_api, "~> 1.4", only: :test},
{%- endif %}
{%- if a.has_courts == "true" %}
      {:stream_data, "~> 1.1"},
{%- endif %}
    ]
  end
end
