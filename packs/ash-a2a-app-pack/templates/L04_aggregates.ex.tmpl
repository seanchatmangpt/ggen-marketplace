---
to: "lib/{{ app_path }}/{{ resource_file }}_l04.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:aggregate ?g .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  aggregates: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?agg_name ?agg_kind ?agg_path ?agg_resource ?agg_field ?agg_type
           ?agg_impl ?agg_filter ?agg_sort ?agg_default ?agg_desc ?agg_public ?agg_uniq
           ?agg_nil ?agg_read ?agg_filterable ?agg_sortable ?agg_sensitive ?agg_authorize
           ?agg_mt WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:aggregate ?g .
      ?g aap:name ?agg_name ; aap:aggKind ?agg_kind .
      OPTIONAL { ?g aap:aggPath ?agg_path }
      OPTIONAL { ?g aap:aggResource ?agg_resource }
      OPTIONAL { ?g aap:aggField ?agg_field }
      OPTIONAL { ?g aap:aggType ?agg_type }
      OPTIONAL { ?g aap:aggImplementation ?agg_impl }
      OPTIONAL { ?g aap:aggFilter ?agg_filter }
      OPTIONAL { ?g aap:aggSort ?agg_sort }
      OPTIONAL { ?g aap:aggDefault ?agg_default }
      OPTIONAL { ?g aap:aggDescription ?agg_desc }
      OPTIONAL { ?g aap:aggPublic ?agg_public }
      OPTIONAL { ?g aap:aggUniq ?agg_uniq }
      OPTIONAL { ?g aap:aggIncludeNil ?agg_nil }
      OPTIONAL { ?g aap:aggReadAction ?agg_read }
      OPTIONAL { ?g aap:aggFilterable ?agg_filterable }
      OPTIONAL { ?g aap:aggSortable ?agg_sortable }
      OPTIONAL { ?g aap:aggSensitive ?agg_sensitive }
      OPTIONAL { ?g aap:aggAuthorize ?agg_authorize }
      OPTIONAL { ?g aap:aggMultitenancy ?agg_mt }
    } ORDER BY ?module_name ?agg_name
  join_filters: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?agg_name ?jf_path ?jf_filter WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:aggregate ?g .
      ?g aap:name ?agg_name ; aap:aggJoinFilter ?j .
      ?j aap:aggPath ?jf_path ; aap:aggFilter ?jf_filter .
    } ORDER BY ?module_name ?agg_name ?jf_path
---
# GENERATED by ash-a2a-app-pack (L04 aggregates) from the application ontology. Do not hand-edit.
{% set my_aggs = aggregates | filter(attribute="module_name", value=module_name) -%}
{% set my_jfs = join_filters | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}Aggregates do
  use Spark.Dsl.Fragment, of: Ash.Resource

  aggregates do
{%- for a in my_aggs %}
    {{ a.agg_kind }} :{{ a.agg_name }}, {% if a.agg_resource | default(value="") != "" %}{{ a.agg_resource }}{% else %}[{% for p in a.agg_path | default(value="") | split(pat=",") %}:{{ p }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if a.agg_kind != "count" and a.agg_kind != "exists" and a.agg_kind != "custom" %}, :{{ a.agg_field | default(value="") }}
{%- elif a.agg_kind == "count" and a.agg_field | default(value="") != "" %}, :{{ a.agg_field }}
{%- elif a.agg_kind == "custom" %}, {{ a.agg_type | default(value="") }}
{%- endif %} do
{%- if a.agg_desc | default(value="") != "" %}
      description "{{ a.agg_desc }}"
{%- endif %}
{%- if a.agg_read | default(value="") != "" %}
      read_action :{{ a.agg_read }}
{%- endif %}
{%- if a.agg_filter | default(value="") != "" %}
      filter {{ a.agg_filter }}
{%- endif %}
{%- if a.agg_sort | default(value="") != "" %}
      sort {{ a.agg_sort }}
{%- endif %}
{%- if a.agg_default | default(value="") != "" %}
      default {{ a.agg_default }}
{%- endif %}
{%- if a.agg_uniq | default(value="") != "" %}
      uniq? {{ a.agg_uniq }}
{%- endif %}
{%- if a.agg_nil | default(value="") != "" %}
      include_nil? {{ a.agg_nil }}
{%- endif %}
{%- if a.agg_public | default(value="") != "" %}
      public? {{ a.agg_public }}
{%- endif %}
{%- if a.agg_filterable | default(value="") != "" %}
      filterable? {% if a.agg_filterable == "simple_equality" %}:simple_equality{% else %}{{ a.agg_filterable }}{% endif %}
{%- endif %}
{%- if a.agg_sortable | default(value="") != "" %}
      sortable? {{ a.agg_sortable }}
{%- endif %}
{%- if a.agg_sensitive | default(value="") != "" %}
      sensitive? {{ a.agg_sensitive }}
{%- endif %}
{%- if a.agg_authorize | default(value="") != "" %}
      authorize? {{ a.agg_authorize }}
{%- endif %}
{%- if a.agg_mt | default(value="") != "" %}
      multitenancy :{{ a.agg_mt }}
{%- endif %}
{%- if a.agg_kind == "custom" %}
      implementation {{ a.agg_impl | default(value="") }}
{%- endif %}
{%- for j in my_jfs | filter(attribute="agg_name", value=a.agg_name) %}
      join_filter [{% for p in j.jf_path | split(pat=",") %}:{{ p }}{% if not loop.last %}, {% endif %}{% endfor %}], {{ j.jf_filter }}
{%- endfor %}
    end
{%- endfor %}
  end
end
