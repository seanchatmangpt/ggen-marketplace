---
to: "lib/{{ app_path }}/{{ ext_file }}_info.ex"
force: true
for_each: "exts"
sparql:
  exts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?ext_module ?app_path ?ext_file ?persist_key WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:appPath ?app_path ; aap:extFile ?ext_file .
      OPTIONAL { ?e aap:extPersistKey ?persist_key }
    } ORDER BY ?ext_module
  sections: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?ext_module ?section_name WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:sparkSection ?s .
      ?s aap:name ?section_name .
    } ORDER BY ?ext_module ?section_name
---
# GENERATED by ash-a2a-app-pack (L18 spark info) from the application ontology. Do not hand-edit.
{% set my_sections = sections | filter(attribute="ext_module", value=ext_module) -%}
defmodule {{ ext_module }}.Info do
  @moduledoc "Introspection for `{{ ext_module }}` (Spark.InfoGenerator, info_generator.ex:23)."
  use Spark.InfoGenerator,
    extension: {{ ext_module }},
    sections: [{% for s in my_sections %}:{{ s.section_name }}{% if not loop.last %}, {% endif %}{% endfor %}]

  @doc "Persisted summary written by `{{ ext_module }}.Persist`, or `nil`."
  def summary(resource),
    do: Spark.Dsl.Extension.get_persisted(resource, :{{ persist_key | default(value="spark_summary") }}, nil)
end
