---
to: "scripts/shim_court/{{ shim_name }}.sh"
force: true
for_each: "shims"
sparql:
  shims: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?shim_name ?shim_target ?shim_before ?shim_after ?shim_test ?shim_template WHERE {
      ?s a aap:ShimCourt ; aap:shimName ?shim_name ; aap:shimTarget ?shim_target ;
         aap:shimBefore ?shim_before ; aap:shimAfter ?shim_after ; aap:shimTest ?shim_test .
      OPTIONAL { ?s aap:shimTemplate ?shim_template }
    } ORDER BY ?shim_name
---
#!/usr/bin/env bash
# GENERATED by ash-a2a-app-pack (L20 courts) from the application ontology. Do not hand-edit.
# Shim court (gap G6): BASELINE(sha256) -> BEFORE(test passes) -> SHIM(mutation, marked SHIM-COURT)
# -> AFTER(test must FAIL) -> RESTORE(sha256 byte-exact, fail-closed). Protocol: smalt scripts/shim_court/lib.sh.
# A court that cannot flip is FAIL. A skip is loud ([SKIP] <reason>), never a faked pass.
# Optional: GGEN_SYNC_CMD regenerates after mutating the pack template (SHIM_TEMPLATE mode).
set -u

NAME="{{ shim_name }}"
ROOT="${SHIM_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
TARGET="$ROOT/{{ shim_target }}"
TEST="{{ shim_test }}"
TEMPLATE="{% if shim_template %}${SHIM_PACK_ROOT:-}/{{ shim_template }}{% endif %}"
BEFORE_TXT='{{ shim_before | safe }}'
AFTER_TXT='{{ shim_after | safe }}'
MARK="# SHIM-COURT"

command -v perl >/dev/null 2>&1 || { echo "[SKIP] $NAME: perl absent"; exit 3; }
command -v mix >/dev/null 2>&1 || { echo "[SKIP] $NAME: mix absent"; exit 3; }
if command -v sha256sum >/dev/null 2>&1; then
  sha() { sha256sum "$1" | cut -d' ' -f1; }
else
  sha() { shasum -a 256 "$1" | cut -d' ' -f1; }
fi

fail() { echo "[FAIL] $NAME: $*"; exit 1; }

# MUTATED is the file the shim edits: the pack template when SHIM_TEMPLATE mode is usable, else the generated target.
MUTATED="$TARGET"
REGEN=""
if [ -n "$TEMPLATE" ] && [ -n "${GGEN_SYNC_CMD:-}" ] && [ -f "$TEMPLATE" ]; then
  MUTATED="$TEMPLATE"
  REGEN="$GGEN_SYNC_CMD"
fi
[ -f "$MUTATED" ] || fail "mutation target missing: $MUTATED"
[ -f "$TARGET" ] || fail "generated target missing: $TARGET"

run_test() { (cd "$ROOT" && mix test "$TEST" >/tmp/shim_court_$NAME.log 2>&1); }
regen() { if [ -n "$REGEN" ]; then (cd "$ROOT" && eval "$REGEN" >/tmp/shim_court_${NAME}_sync.log 2>&1) || fail "regeneration failed"; fi; }

mutate() {
  BEFORE="$1" AFTER="$2" perl -0pi -e 's/\Q$ENV{BEFORE}\E/$ENV{AFTER}/' "$MUTATED"
}

# Self-check: restore detection is not vacuous (corrupt a restore on a real temp copy).
selfcheck() {
  tmp="$(mktemp)"; cp "$MUTATED" "$tmp"
  want="$(sha "$tmp")"
  printf 'corrupt' >> "$tmp"
  [ "$(sha "$tmp")" != "$want" ] || { rm -f "$tmp"; fail "self-check: corrupted restore not detected (VACUOUS)"; }
  rm -f "$tmp"
}
selfcheck

BACKUP="$(mktemp)"
cp "$MUTATED" "$BACKUP"
BASELINE_SHA="$(sha "$MUTATED")"
echo "BASELINE $NAME sha256=$BASELINE_SHA file=$MUTATED"

restore() {
  cp "$BACKUP" "$MUTATED"
  [ "$(sha "$MUTATED")" = "$BASELINE_SHA" ] || { echo "[FAIL] $NAME: RESTORE sha256 mismatch (fail-closed)"; rm -f "$BACKUP"; exit 2; }
  regen
}
trap 'restore' EXIT

run_test || fail "BEFORE: test does not pass on baseline (see /tmp/shim_court_$NAME.log)"
echo "BEFORE pass"

grep -qF -- "$BEFORE_TXT" "$MUTATED" || fail "SHIM: before-text not found in $MUTATED (mutation cannot apply)"
mutate "$BEFORE_TXT" "$AFTER_TXT $MARK"
grep -qF -- "$MARK" "$MUTATED" || fail "SHIM: marker absent after mutation"
[ "$(sha "$MUTATED")" != "$BASELINE_SHA" ] || fail "SHIM: mutation did not change the file"
regen
echo "SHIM applied ($MARK)"

if run_test; then
  fail "AFTER: test still passes under shim -- court cannot flip (VACUOUS)"
fi
echo "AFTER fail (flipped)"

trap - EXIT
restore
echo "RESTORE sha256 ok"
rm -f "$BACKUP"
echo "[PASS] $NAME"
