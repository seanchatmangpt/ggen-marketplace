---
to: "test/{{ app_path }}/pplan/{{ pp_file }}_test.exs"
force: true
for_each: "workflows"
sparql:
  workflows: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?pp_file WHERE {
      ?d a aap:Domain ; aap:appPath ?app_path ; aap:ppWorkflow ?w .
      ?w a aap:PPlanWorkflow ; aap:moduleName ?module_name ; aap:ppFile ?pp_file .
    } ORDER BY ?module_name
  providers: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?provider_module WHERE {
      ?w a aap:PPlanWorkflow ; aap:moduleName ?module_name ; aap:ppUsesProvider ?p .
      ?p aap:moduleName ?provider_module .
    } ORDER BY ?module_name ?provider_module
  obligations: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?ob_name ?capability
           (GROUP_CONCAT(DISTINCT ?prop; separator=",") AS ?properties)
           (GROUP_CONCAT(DISTINCT ?ev; separator=",") AS ?evidence)
    WHERE {
      ?w a aap:PPlanWorkflow ; aap:moduleName ?module_name ; aap:ppObligation ?o .
      ?o aap:name ?ob_name ; aap:ppCapability ?capability .
      OPTIONAL { ?o aap:ppRequiresProperty ?prop }
      OPTIONAL { ?o aap:ppRequiresEvidence ?ev }
    } GROUP BY ?module_name ?ob_name ?capability
    ORDER BY ?module_name ?ob_name
  tasks: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?task_id ?capability
           (GROUP_CONCAT(DISTINCT ?prop; separator=",") AS ?properties)
           (GROUP_CONCAT(DISTINCT ?ev; separator=",") AS ?evidence)
    WHERE {
      ?w a aap:PPlanWorkflow ; aap:moduleName ?module_name ; aap:ppTask ?t .
      ?t aap:name ?task_id ; aap:ppCapability ?capability .
      OPTIONAL { ?t aap:ppProperty ?prop }
      OPTIONAL { ?t aap:ppEvidenceKind ?ev }
    } GROUP BY ?module_name ?task_id ?capability
    ORDER BY ?module_name ?task_id
---
# GENERATED by ash-a2a-app-pack (L16 ash_pplan court) from the application ontology. Do not hand-edit.
{% set my_providers = providers | filter(attribute="module_name", value=module_name) -%}
{% set my_obs = obligations | filter(attribute="module_name", value=module_name) -%}
{% set my_tasks = tasks | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.CourtL16Test do
  use ExUnit.Case, async: true

  alias AshPPlan.Providers.Registry

  @registry Registry.new([{% for p in my_providers %}{{ p.provider_module }}{% if not loop.last %}, {% endif %}{% endfor %}])

  test "workflow resolves to a valid model" do
    assert {:ok, %AshPPlan.Workflow.Model{}} = AshPPlan.Workflow.model({{ module_name }})
  end

  test "every task capability resolves to a qualified provider" do
    for {id, cap, props, evidence} <- [
{%- for t in my_tasks %}
          {:{{ t.task_id }}, "{{ t.capability }}", [{% for x in t.properties | default(value="") | split(pat=",") %}{% if x != "" %}:{{ x }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}], [{% for x in t.evidence | default(value="") | split(pat=",") %}{% if x != "" %}:{{ x }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]}{% if not loop.last %},{% endif %}
{%- endfor %}
        ] do
      assert {:ok, _} = Registry.resolve(@registry, %{capability: cap, properties: props, evidence: evidence}),
             "task #{inspect(id)} has no qualified provider"
    end
  end

  test "every obligation is discharged by a qualified provider" do
    for {name, cap, props, evidence} <- [
{%- for o in my_obs %}
          {:{{ o.ob_name }}, "{{ o.capability }}", [{% for x in o.properties | default(value="") | split(pat=",") %}{% if x != "" %}:{{ x }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}], [{% for x in o.evidence | default(value="") | split(pat=",") %}{% if x != "" %}:{{ x }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]}{% if not loop.last %},{% endif %}
{%- endfor %}
        ] do
      assert {:ok, _} = Registry.resolve(@registry, %{capability: cap, properties: props, evidence: evidence}),
             "obligation #{inspect(name)} is undischarged"
    end
  end
end
