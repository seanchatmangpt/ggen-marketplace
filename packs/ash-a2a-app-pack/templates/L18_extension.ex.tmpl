---
to: "lib/{{ app_path }}/{{ ext_file }}.ex"
force: true
for_each: "exts"
sparql:
  exts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?ext_module ?app_path ?ext_file ?persist_key WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:appPath ?app_path ; aap:extFile ?ext_file .
      OPTIONAL { ?e aap:extPersistKey ?persist_key }
    } ORDER BY ?ext_module
  sections: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?ext_module ?section_name ?section_describe ?section_order WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:sparkSection ?s .
      ?s aap:name ?section_name .
      OPTIONAL { ?s aap:description ?section_describe }
      OPTIONAL { ?s aap:sparkOrder ?section_order }
    } ORDER BY ?ext_module ?section_order ?section_name
  entities: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?ext_module ?section_name ?entity_name ?struct_module ?identifier ?entity_describe WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:sparkSection ?s .
      ?s aap:name ?section_name ; aap:sparkEntity ?n .
      ?n aap:name ?entity_name ; aap:structModule ?struct_module .
      OPTIONAL { ?n aap:identifier ?identifier }
      OPTIONAL { ?n aap:description ?entity_describe }
    } ORDER BY ?ext_module ?section_name ?entity_name
  fields: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?ext_module ?struct_module ?field_name ?field_type ?field_required ?field_default ?field_doc ?arg_pos ?field_order WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:sparkSection ?s .
      ?s aap:sparkEntity ?n .
      ?n aap:structModule ?struct_module ; aap:sparkField ?f .
      ?f aap:name ?field_name ; aap:sparkType ?field_type .
      OPTIONAL { ?f aap:required ?field_required }
      OPTIONAL { ?f aap:fieldDefault ?field_default }
      OPTIONAL { ?f aap:doc ?field_doc }
      OPTIONAL { ?f aap:argPosition ?arg_pos }
      OPTIONAL { ?f aap:fieldOrder ?field_order }
    } ORDER BY ?ext_module ?struct_module ?field_order ?field_name
  section_fields: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?ext_module ?section_name ?field_name ?field_type ?field_default ?field_doc WHERE {
      ?e a aap:SparkExtension ; aap:moduleName ?ext_module ; aap:sparkSection ?s .
      ?s aap:name ?section_name ; aap:sparkField ?f .
      ?f aap:name ?field_name ; aap:sparkType ?field_type .
      OPTIONAL { ?f aap:fieldDefault ?field_default }
      OPTIONAL { ?f aap:doc ?field_doc }
    } ORDER BY ?ext_module ?section_name ?field_name
---
# GENERATED by ash-a2a-app-pack (L18 spark extension) from the application ontology. Do not hand-edit.
{% set my_sections = sections | filter(attribute="ext_module", value=ext_module) -%}
{% set my_entities = entities | filter(attribute="ext_module", value=ext_module) -%}
{% set my_fields = fields | filter(attribute="ext_module", value=ext_module) -%}
{% set my_sfields = section_fields | filter(attribute="ext_module", value=ext_module) -%}
{% for en in my_entities %}
{%- set ef = my_fields | filter(attribute="struct_module", value=en.struct_module) %}
defmodule {{ en.struct_module }} do
  @moduledoc false
  defstruct [{% for f in ef %}{% if not f.field_default %}:{{ f.field_name }}, {% endif %}{% endfor %}:__identifier__, :__spark_metadata__{% for f in ef %}{% if f.field_default %}, {{ f.field_name }}: {{ f.field_default | safe }}{% endif %}{% endfor %}]
end
{% endfor %}
defmodule {{ ext_module }} do
  @moduledoc "App-level Spark.Dsl.Extension projected from the application ontology (L18)."
{% for en in my_entities %}
{%- set ef = my_fields | filter(attribute="struct_module", value=en.struct_module) %}
  @{{ en.entity_name }} %Spark.Dsl.Entity{
    name: :{{ en.entity_name }},
    target: {{ en.struct_module }},
{%- if en.entity_describe %}
    describe: "{{ en.entity_describe | safe }}",
{%- endif %}
    args: [{% for f in ef %}{% if f.arg_pos %}:{{ f.field_name }}, {% endif %}{% endfor %}],
{%- if en.identifier %}
    identifier: :{{ en.identifier }},
{%- endif %}
    schema: [
{%- for f in ef %}
      {{ f.field_name }}: [type: {{ f.field_type | safe }}{% if f.field_required %}, required: {{ f.field_required }}{% endif %}{% if f.field_default %}, default: {{ f.field_default | safe }}{% endif %}{% if f.field_doc %}, doc: "{{ f.field_doc | safe }}"{% endif %}],
{%- endfor %}
    ]
  }
{% endfor %}
{%- for s in my_sections %}
{%- set sf = my_sfields | filter(attribute="section_name", value=s.section_name) %}
  @{{ s.section_name }} %Spark.Dsl.Section{
    name: :{{ s.section_name }},
{%- if s.section_describe %}
    describe: "{{ s.section_describe | safe }}",
{%- endif %}
{%- if sf | length > 0 %}
    schema: [
{%- for f in sf %}
      {{ f.field_name }}: [type: {{ f.field_type | safe }}{% if f.field_default %}, default: {{ f.field_default | safe }}{% endif %}{% if f.field_doc %}, doc: "{{ f.field_doc | safe }}"{% endif %}],
{%- endfor %}
    ],
{%- endif %}
    entities: [{% for en in my_entities %}{% if en.section_name == s.section_name %}@{{ en.entity_name }}, {% endif %}{% endfor %}]
  }
{% endfor %}
  use Spark.Dsl.Extension,
    sections: [{% for s in my_sections %}@{{ s.section_name }}{% if not loop.last %}, {% endif %}{% endfor %}],
    transformers: [{{ ext_module }}.Persist],
    verifiers: [{{ ext_module }}.Verify]
end
