---
to: ".formatter_l18.exs"
force: true
sparql:
  entities: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?entity_name (COUNT(?pos) AS ?arity) WHERE {
      ?e a aap:SparkExtension ; aap:sparkSection ?s .
      ?s aap:sparkEntity ?n .
      ?n aap:name ?entity_name .
      OPTIONAL { ?n aap:sparkField ?f . ?f aap:argPosition ?pos }
    } GROUP BY ?entity_name ORDER BY ?entity_name
  section_opts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?field_name WHERE {
      ?e a aap:SparkExtension ; aap:sparkSection ?s .
      ?s aap:sparkField ?f . ?f aap:name ?field_name .
    } ORDER BY ?field_name
---
# GENERATED by ash-a2a-app-pack (L18 formatter locals). Do not hand-edit.
# Equivalent to `mix spark.formatter` output (spark.formatter.ex:29-70): paste into
# .formatter.exs as `spark_locals_without_parens`, or `import_deps`/Code.eval_file this file.
[
{%- for e in entities %}
  {{ e.entity_name }}: {{ e.arity }},
  {{ e.entity_name }}: {{ e.arity + 1 }},
{%- endfor %}
{%- for s in section_opts %}
  {{ s.field_name }}: 1{% if not loop.last %},{% endif %}
{%- endfor %}
]
