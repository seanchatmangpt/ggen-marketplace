---
to: "lib/{{ app_path }}/pplan/manufacture_targets_l16.ex"
force: true
for_each: "domains"
sparql:
  domains: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:appPath ?app_path .
      { ?d aap:ppTarget ?t } UNION { ?d aap:ppReusesPack ?p } UNION { ?d aap:ppGeneratedDir ?g }
    } ORDER BY ?module_name
  targets: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?template ?out ?target_module WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:ppTarget ?t .
      ?t aap:ppTemplate ?template ; aap:ppOut ?out ; aap:ppTargetModule ?target_module .
    } ORDER BY ?module_name ?template
  dirs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?dir WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:ppGeneratedDir ?dir .
    } ORDER BY ?module_name ?dir
  packs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?pack WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:ppReusesPack ?pack .
    } ORDER BY ?module_name ?pack
---
# GENERATED by ash-a2a-app-pack (L16 ash_pplan manufacture targets) from the application ontology. Do not hand-edit.
{% set my_targets = targets | filter(attribute="module_name", value=module_name) -%}
{% set my_dirs = dirs | filter(attribute="module_name", value=module_name) -%}
{% set my_packs = packs | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.PPlan.ManufactureTargetsL16 do
  @moduledoc """
  Generated manufacture manifest in the shape of AshPPlan.ManufactureTargets
  (manufacture_targets.ex:24-96). Packs listed in `packs/0` are consumed by reference.
  """

  @spec targets() :: [%{template: String.t(), out: String.t(), module: String.t()}]
  def targets do
    [
{%- for t in my_targets %}
      %{template: "{{ t.template }}", out: "{{ t.out }}", module: "{{ t.target_module }}"}{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
  end

  @spec generated_dirs() :: [String.t()]
  def generated_dirs do
    [
{%- for g in my_dirs %}
      "{{ g.dir }}"{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
  end

  @doc "Marketplace packs reused by reference, never copied."
  @spec packs() :: [String.t()]
  def packs do
    [
{%- for p in my_packs %}
      "{{ p.pack }}"{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
  end
end
