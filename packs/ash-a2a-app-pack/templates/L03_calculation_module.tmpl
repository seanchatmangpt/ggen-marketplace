---
to: "lib/{{ app_path }}/calculations/{{ calc_file }}.ex"
force: true
for_each: "mods"
sparql:
  mods: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?calc_module ?calc_file ?calc_keys ?app_path WHERE {
      ?r a aap:Resource ; aap:inDomain ?d ; aap:calculation ?c .
      ?d aap:appPath ?app_path .
      ?c aap:calcKind "module" ; aap:calcModule ?calc_module ; aap:calcFile ?calc_file ; aap:calcKeys ?calc_keys .
    } ORDER BY ?calc_module
---
# GENERATED by ash-a2a-app-pack (L03 calculations) from the application ontology. Do not hand-edit.
defmodule {{ calc_module }} do
  @moduledoc "Coalesces the first non-nil of: {{ calc_keys }}."
  use Ash.Resource.Calculation

  @impl Ash.Resource.Calculation
  def init(opts) do
    if is_list(opts[:keys]) and Enum.all?(opts[:keys], &is_atom/1) do
      {:ok, opts}
    else
      {:error, "Expected a `keys` option listing attribute names"}
    end
  end

  @impl Ash.Resource.Calculation
  def load(_query, opts, _context), do: opts[:keys]

  @impl Ash.Resource.Calculation
  def calculate(records, opts, _context) do
    Enum.map(records, fn record ->
      Enum.find_value(opts[:keys], fn key -> Map.get(record, key) end)
    end)
  end
end
