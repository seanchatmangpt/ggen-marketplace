---
to: "lib/{{ app_path }}/pplan/{{ pp_file }}.ex"
force: true
for_each: "providers"
sparql:
  providers: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?pp_file ?provider_id ?cost
           (GROUP_CONCAT(DISTINCT ?prop; separator=",") AS ?properties)
           (GROUP_CONCAT(DISTINCT ?ev; separator=",") AS ?evidence)
           (GROUP_CONCAT(DISTINCT ?auth; separator=",") AS ?authorities)
    WHERE {
      ?d a aap:Domain ; aap:appPath ?app_path ; aap:ppProvider ?p .
      ?p a aap:PPlanProvider ; aap:moduleName ?module_name ; aap:ppFile ?pp_file ;
         aap:ppProviderId ?provider_id .
      OPTIONAL { ?p aap:ppCost ?cost }
      OPTIONAL { ?p aap:ppProvidesProperty ?prop }
      OPTIONAL { ?p aap:ppProvidesEvidence ?ev }
      OPTIONAL { ?p aap:ppAuthorityCeiling ?auth }
    } GROUP BY ?module_name ?app_path ?pp_file ?provider_id ?cost
    ORDER BY ?module_name
  bindings: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?capability ?adapter ?op ?options WHERE {
      ?p a aap:PPlanProvider ; aap:moduleName ?module_name ; aap:ppBinding ?b .
      ?b aap:ppCapability ?capability ; aap:ppAdapter ?adapter ; aap:ppOp ?op .
      OPTIONAL { ?b aap:ppOptions ?options }
    } ORDER BY ?module_name ?capability
---
# GENERATED by ash-a2a-app-pack (L16 ash_pplan provider) from the application ontology. Do not hand-edit.
{% set my_bindings = bindings | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }} do
  @moduledoc """
  Generated AshPPlan.Provider `{{ provider_id }}`: describes capability realizations
  (adapter + op binding). Availability is not authority; ceiling never exceeds :construct.
  """
  @behaviour AshPPlan.Provider

  alias AshPPlan.Providers.Qualify

  @capabilities [{% for b in my_bindings %}"{{ b.capability }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  @properties [{% for x in properties | default(value="") | split(pat=",") %}{% if x != "" %}:{{ x }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]
  @evidence [{% for x in evidence | default(value="") | split(pat=",") %}{% if x != "" %}:{{ x }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}]
  @authorities {% if authorities %}[{% for x in authorities | split(pat=",") %}:{{ x }}{% if not loop.last %}, {% endif %}{% endfor %}]{% else %}Qualify.authorities(){% endif %}

  @table %{
{%- for b in my_bindings %}
    "{{ b.capability }}" => {:{{ b.adapter }}, :{{ b.op }}, [{{ b.options | default(value="") | safe }}]}{% if not loop.last %},{% endif %}
{%- endfor %}
  }

  @impl true
  def id, do: :{{ provider_id }}
  @impl true
  def capabilities, do: @capabilities
  @impl true
  def properties, do: @properties
  @impl true
  def evidence, do: @evidence
  @impl true
  def cost, do: {{ cost | default(value="1") }}

  @impl true
  def qualify(requirement, context) do
    Qualify.check(requirement, context, @capabilities, @properties, @evidence, @authorities)
  end

  @impl true
  def realize(requirement, context) do
    with :ok <- qualify(requirement, context) do
      Qualify.realize(requirement, id(), @table, @properties)
    end
  end
end
