---
to: "lib/{{ app_path }}/{{ domain_file }}.ex"
force: true
for_each: "domains"
sparql:
  domains: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?domain_file ?vci ?has_l08 ?has_l10 ?has_l17 WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name ; aap:appPath ?app_path ;
         aap:domainFile ?domain_file .
      OPTIONAL { ?d aap:validateConfigInclusion ?vci }
      OPTIONAL { ?d aap:domainDescription ?description }
      OPTIONAL { ?d aap:domainTimeout ?timeout }
      OPTIONAL { ?d aap:traceName ?trace_name }
      OPTIONAL { ?d aap:requireActor ?require_actor }
      OPTIONAL { ?d aap:authorize ?authorize }
      OPTIONAL { ?d aap:allowUnregistered ?allow_unregistered }
      BIND(IF(EXISTS { ?d aap:mount ?m8 }, "true", "false") AS ?has_l08)
      BIND(IF(BOUND(?description) || BOUND(?timeout) || BOUND(?trace_name) || BOUND(?require_actor)
              || BOUND(?authorize) || BOUND(?allow_unregistered)
              || EXISTS { ?i10 aap:interfaceOfDomain ?d } || EXISTS { ?m10 aap:mountOf ?d },
              "true", "false") AS ?has_l10)
      BIND(IF(EXISTS { ?d aap:a2aConfigured "true" }, "true", "false") AS ?has_l17)
    } ORDER BY ?module_name
  members: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?domain_module ?resource_module WHERE {
      ?r a aap:Resource ; aap:moduleName ?resource_module ; aap:inDomain ?d .
      ?d aap:moduleName ?domain_module .
    } ORDER BY ?domain_module ?resource_module
---
# GENERATED by ash-a2a-app-pack from the application ontology. Do not hand-edit.
{% set mine = members | filter(attribute="domain_module", value=module_name) -%}
{% set any_frag = has_l08 == "true" or has_l10 == "true" or has_l17 == "true" -%}
defmodule {{ module_name }} do
  use Ash.Domain,
{%- if vci | default(value="") == "false" %}
    validate_config_inclusion?: false,
{%- endif %}
{%- if any_frag %}
    extensions: [AshA2A, AshA2A.Domain],
    fragments: [
{%- if has_l08 == "true" %}
      {{ module_name }}.MountsL08,
{%- endif %}
{%- if has_l10 == "true" %}
      {{ module_name }}.L10,
{%- endif %}
{%- if has_l17 == "true" %}
      {{ module_name }}.A2aL17,
{%- endif %}
    ]
{%- else %}
    extensions: [AshA2A]
{%- endif %}

  resources do
{%- for m in mine %}
    resource({{ m.resource_module }})
{%- endfor %}
  end
end
