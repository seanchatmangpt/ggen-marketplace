---
to: "lib/{{ app_path }}/{{ server_file }}.ex"
force: true
for_each: "servers"
sparql:
  servers: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?server_module ?server_name ?server_file ?app_path WHERE {
      ?s a aap:PubSubServer ; aap:serverModule ?server_module ; aap:serverName ?server_name ;
         aap:serverFile ?server_file ; aap:inDomain ?d .
      ?d aap:appPath ?app_path .
    } ORDER BY ?server_module
---
# GENERATED by ash-a2a-app-pack lane L11 from the application ontology. Do not hand-edit.
defmodule {{ server_module }} do
  @moduledoc "Supervision children for the Phoenix.PubSub named `{{ server_name }}`."

  @doc "Add to the application supervisor's children."
  def children, do: [{Phoenix.PubSub, name: {{ server_name }}}]
end
