---
to: "test/courts/{{ resource_file }}_court_test.exs"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?domain_module ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ; aap:resourceFile ?resource_file .
      ?d aap:moduleName ?domain_module .
    } ORDER BY ?module_name
  actions: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?action_type WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:action ?a .
      ?a aap:name ?action_name ; aap:actionType ?action_type .
    } ORDER BY ?module_name ?action_name
  attributes: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?attr_name WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:attribute ?a .
      ?a aap:name ?attr_name .
    } ORDER BY ?module_name ?attr_name
  read_skills: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?skill_name ?dispatch_text ?dispatch_identity ?dispatch_expect WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:skill ?s ; aap:action ?a .
      ?s aap:name ?skill_name ; aap:ofAction ?an .
      ?a aap:name ?an ; aap:actionType "read" .
      OPTIONAL { ?s aap:dispatchText ?dispatch_text }
      OPTIONAL { ?s aap:dispatchIdentity ?dispatch_identity }
      OPTIONAL { ?s aap:dispatchExpect ?dispatch_expect }
    } ORDER BY ?module_name ?skill_name
  relationships: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?rel_name ?rel_kind ?dest_module WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:relationship ?rel .
      ?rel aap:name ?rel_name ; aap:relKind ?rel_kind ; aap:destination ?d .
      ?d aap:moduleName ?dest_module .
    } ORDER BY ?module_name ?rel_name
  identities: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?identity_name ?identity_keys ?seed_action ?seed_input WHERE {
      ?i a aap:CourtIdentity ; aap:courtResource ?r ; aap:identityName ?identity_name ;
         aap:identityKeys ?identity_keys ; aap:seedAction ?seed_action ; aap:seedInput ?seed_input .
      ?r aap:moduleName ?module_name .
    } ORDER BY ?module_name ?identity_name
  policy_cases: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?case_name ?case_action ?case_actor ?case_expect WHERE {
      ?c a aap:PolicyCase ; aap:courtResource ?r ; aap:caseName ?case_name ;
         aap:caseAction ?case_action ; aap:caseExpect ?case_expect .
      ?r aap:moduleName ?module_name .
      OPTIONAL { ?c aap:caseActor ?case_actor }
    } ORDER BY ?module_name ?case_name
  transitions: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?case_name ?case_action ?state_attr ?from_state ?to_state ?case_expect ?seed_action ?seed_input ?case_input WHERE {
      ?c a aap:TransitionCase ; aap:courtResource ?r ; aap:caseName ?case_name ;
         aap:caseAction ?case_action ; aap:stateAttr ?state_attr ; aap:fromState ?from_state ;
         aap:toState ?to_state ; aap:caseExpect ?case_expect ;
         aap:seedAction ?seed_action ; aap:seedInput ?seed_input .
      ?r aap:moduleName ?module_name .
      OPTIONAL { ?c aap:caseInput ?case_input }
    } ORDER BY ?module_name ?case_name
---
# GENERATED by ash-a2a-app-pack (L20 courts) from the application ontology. Do not hand-edit.
{% set my_actions = actions | filter(attribute="module_name", value=module_name) -%}
{% set my_attrs = attributes | filter(attribute="module_name", value=module_name) -%}
{% set my_reads = read_skills | filter(attribute="module_name", value=module_name) -%}
{% set my_rels = relationships | filter(attribute="module_name", value=module_name) -%}
{% set my_ids = identities | filter(attribute="module_name", value=module_name) -%}
{% set my_pols = policy_cases | filter(attribute="module_name", value=module_name) -%}
{% set my_trans = transitions | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}CourtTest do
  # async: false -- ETS data layer state is shared; no sleeps, no mocks (real Ash, real dispatcher).
  use ExUnit.Case, async: false
  use ExUnitProperties

  alias AshA2A.Protocol.Message

  @resource {{ module_name }}

  # Ash errors carry `class`; invalid/forbidden are the lawful typed refusals.
  defp lawful?({:ok, _}), do: true
  defp lawful?({:error, %{class: class}}) when class in [:invalid, :forbidden], do: true
  defp lawful?(_), do: false

  describe "declared actions exist with the declared type" do
{%- for x in my_actions %}
    test "action {{ x.action_name }} is {{ x.action_type }}" do
      action = Ash.Resource.Info.action(@resource, :{{ x.action_name }})
      assert action, "action :{{ x.action_name }} missing on #{inspect(@resource)}"
      assert action.type == :{{ x.action_type }}
    end
{%- endfor %}
  end

  describe "declared attributes exist" do
{%- for a in my_attrs %}
    test "attribute {{ a.attr_name }}" do
      assert Ash.Resource.Info.attribute(@resource, :{{ a.attr_name }})
    end
{%- endfor %}
  end
{%- if my_reads | length > 0 %}

  # Gap G8: AshA2A.Dispatcher.dispatch/6 round-trip per read skill
  # (/Users/sac/ash_a2a/lib/ash_a2a/dispatcher.ex:164-171).
  describe "dispatcher round-trip per read skill" do
{%- for s in my_reads %}
    test "dispatch {{ s.skill_name }}" do
      msg = Message.new_user("{{ s.dispatch_text | default(value="ping") }}")
      reply = AshA2A.Dispatcher.dispatch(:{{ s.skill_name }}, msg, @resource, [], {{ s.dispatch_identity | default(value="nil") | safe }}, [])
{%- set expect = s.dispatch_expect | default(value="typed") %}
{%- if expect == "reply" %}
      assert {:reply, parts} = reply
      assert is_list(parts)
{%- elif expect == "input_required" %}
      assert {:input_required, parts} = reply
      assert is_list(parts)
{%- elif expect == "auth_required" %}
      assert {:error, {:auth_required, parts}} = reply
      assert is_list(parts)
{%- elif expect == "error" %}
      assert {:error, _} = reply
{%- else %}
      assert match?({:reply, _}, reply) or match?({:input_required, _}, reply) or
               match?({:error, _}, reply) or match?({:stream, _}, reply),
             "untyped dispatch reply: #{inspect(reply)}"
{%- endif %}
    end
{%- endfor %}
  end
{%- endif %}

  describe "generated-input properties (Ash.Generator.action_input/3)" do
{%- for x in my_actions %}
{%- if x.action_type == "create" %}
    property "create :{{ x.action_name }} yields ok or a typed Ash error for any generated input" do
      check all(input <- Ash.Generator.action_input(@resource, :{{ x.action_name }}), max_runs: 25) do
        assert lawful?(Ash.create(@resource, input, action: :{{ x.action_name }}, authorize?: false))
      end
    end
{%- endif %}
{%- endfor %}
    property "read never raises and returns a list" do
      check all(_ <- StreamData.constant(:ok), max_runs: 5) do
        assert {:ok, list} = Ash.read(@resource, authorize?: false)
        assert is_list(list)
      end
    end
  end
{%- if my_rels | length > 0 %}

  describe "relationship integrity" do
{%- for r in my_rels %}
    test "relationship {{ r.rel_name }} is {{ r.rel_kind }} to {{ r.dest_module }}" do
      rel = Ash.Resource.Info.relationship(@resource, :{{ r.rel_name }})
      assert rel, "relationship :{{ r.rel_name }} missing"
      assert rel.type == :{{ r.rel_kind }}
      assert rel.destination == {{ r.dest_module }}
      assert Code.ensure_loaded?(rel.destination)
      assert Ash.Resource.Info.resource?(rel.destination)
    end
{%- endfor %}
  end
{%- endif %}
{%- if my_ids | length > 0 %}

  describe "identity uniqueness" do
{%- for i in my_ids %}
    test "identity {{ i.identity_name }} is declared on keys and refuses duplicates" do
      identity = Ash.Resource.Info.identity(@resource, :{{ i.identity_name }})
      assert identity, "identity :{{ i.identity_name }} missing"
      assert Enum.sort(identity.keys) == Enum.sort([{% for k in i.identity_keys | split(pat=",") %}:{{ k | trim }}{% if not loop.last %}, {% endif %}{% endfor %}])
      input = {{ i.seed_input | safe }}
      assert {:ok, _} = Ash.create(@resource, input, action: :{{ i.seed_action }}, authorize?: false)
      assert {:error, %{class: :invalid}} =
               Ash.create(@resource, input, action: :{{ i.seed_action }}, authorize?: false)
    end
{%- endfor %}
  end
{%- endif %}
{%- if my_pols | length > 0 %}

  describe "policy allow/deny matrix" do
{%- for p in my_pols %}
    test "{{ p.case_name }}: {{ p.case_action }} is {{ p.case_expect }}" do
      actor = {{ p.case_actor | default(value="nil") | safe }}
{%- if p.case_expect == "allow" %}
      assert Ash.can?({@resource, :{{ p.case_action }}}, actor, maybe_is: false)
{%- else %}
      refute Ash.can?({@resource, :{{ p.case_action }}}, actor, maybe_is: false)
{%- endif %}
    end
{%- endfor %}
  end
{%- endif %}
{%- if my_trans | length > 0 %}

  describe "state-machine transitions" do
{%- for t in my_trans %}
    test "{{ t.case_name }}: {{ t.from_state }} -> {{ t.to_state }} via {{ t.case_action }} ({{ t.case_expect }})" do
      assert {:ok, seed} = Ash.create(@resource, {{ t.seed_input | safe }}, action: :{{ t.seed_action }}, authorize?: false)
      assert Map.get(seed, :{{ t.state_attr }}) == {{ t.from_state | safe }}
      result = Ash.update(seed, {{ t.case_input | default(value="%{}") | safe }}, action: :{{ t.case_action }}, authorize?: false)
{%- if t.case_expect == "ok" %}
      assert {:ok, moved} = result
      assert Map.get(moved, :{{ t.state_attr }}) == {{ t.to_state | safe }}
{%- else %}
      assert {:error, _} = result
      assert {:ok, again} = Ash.get(@resource, seed.id, authorize?: false)
      assert Map.get(again, :{{ t.state_attr }}) == {{ t.from_state | safe }}
{%- endif %}
    end
{%- endfor %}
  end
{%- endif %}
end
