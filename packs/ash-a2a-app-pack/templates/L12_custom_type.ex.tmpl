---
to: "lib/{{ app_path }}/types/{{ type_file }}.ex"
force: true
for_each: "types"
sparql:
  types: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?type_kind ?app_path ?type_file ?subtype_of ?type_constraints ?union_storage WHERE {
      ?t a aap:CustomType ; aap:moduleName ?module_name ; aap:typeKind ?type_kind ;
         aap:inDomain ?d ; aap:typeFile ?type_file .
      ?d aap:appPath ?app_path .
      FILTER(?type_kind IN ("enum", "newtype", "typed_struct", "union"))
      OPTIONAL { ?t aap:subtypeOf ?subtype_of }
      OPTIONAL { ?t aap:typeConstraints ?type_constraints }
      OPTIONAL { ?t aap:unionStorage ?union_storage }
    } ORDER BY ?module_name
  enum_values: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?enum_value WHERE {
      ?t a aap:CustomType ; aap:moduleName ?module_name ; aap:typeKind "enum" ; aap:enumValue ?enum_value .
    } ORDER BY ?module_name ?enum_value
  fields: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?field_name ?ash_type ?ref_module ?allow_nil ?constraints ?default_value WHERE {
      ?t a aap:CustomType ; aap:moduleName ?module_name ; aap:typeKind "typed_struct" ; aap:typeField ?f .
      ?f aap:name ?field_name .
      OPTIONAL { ?f aap:ashType ?ash_type }
      OPTIONAL { ?f aap:typeRef ?r . ?r aap:moduleName ?ref_module }
      OPTIONAL { ?f aap:allowNil ?allow_nil }
      OPTIONAL { ?f aap:typeConstraints ?constraints }
      OPTIONAL { ?f aap:defaultValue ?default_value }
    } ORDER BY ?module_name ?field_name
  members: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?member_name ?ash_type ?ref_module ?tag ?tag_value ?constraints WHERE {
      ?t a aap:CustomType ; aap:moduleName ?module_name ; aap:typeKind "union" ; aap:unionMember ?m .
      ?m aap:name ?member_name .
      OPTIONAL { ?m aap:ashType ?ash_type }
      OPTIONAL { ?m aap:typeRef ?r . ?r aap:moduleName ?ref_module }
      OPTIONAL { ?m aap:unionTag ?tag }
      OPTIONAL { ?m aap:unionTagValue ?tag_value }
      OPTIONAL { ?m aap:typeConstraints ?constraints }
    } ORDER BY ?module_name ?member_name
---
# GENERATED by ash-a2a-app-pack (lane L12) from the application ontology. Do not hand-edit.
{% set my_values = enum_values | filter(attribute="module_name", value=module_name) -%}
{% set my_fields = fields | filter(attribute="module_name", value=module_name) -%}
{% set my_members = members | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }} do
{%- if type_kind == "enum" %}
  use Ash.Type.Enum, values: [{% for v in my_values %}:{{ v.enum_value }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- elif type_kind == "newtype" %}
  use Ash.Type.NewType,
    subtype_of: :{{ subtype_of | default(value="string") }}{% if type_constraints %},
    constraints: {{ type_constraints | safe }}{% endif %}
{%- elif type_kind == "typed_struct" %}
  use Ash.TypedStruct

  typed_struct do
{%- for f in my_fields %}
    field :{{ f.field_name }}, {% if f.ref_module | default(value="") != "" %}{{ f.ref_module }}{% else %}:{{ f.ash_type | default(value="string") }}{% endif %}{% if f.allow_nil | default(value="") == "false" %}, allow_nil?: false{% endif %}{% if f.default_value | default(value="") != "" %}, default: {{ f.default_value | safe }}{% endif %}{% if f.constraints | default(value="") != "" %}, constraints: {{ f.constraints | safe }}{% endif %}
{%- endfor %}
  end
{%- elif type_kind == "union" %}
  use Ash.Type.NewType,
    subtype_of: :union,
    constraints: [
      storage: :{{ union_storage | default(value="type_and_value") }},
      types: [
{%- for m in my_members %}
        {{ m.member_name }}: [
          type: {% if m.ref_module | default(value="") != "" %}{{ m.ref_module }}{% else %}:{{ m.ash_type | default(value="string") }}{% endif %}
{%- if m.tag | default(value="") != "" %},
          tag: :{{ m.tag }},
          tag_value: {{ m.tag_value | default(value="nil") | safe }}
{%- endif %}
{%- if m.constraints | default(value="") != "" %},
          constraints: {{ m.constraints | safe }}
{%- endif %}
        ]{% if not loop.last %},{% endif %}
{%- endfor %}
      ]
    ]
{%- endif %}
end
