---
to: "lib/{{ app_path }}/{{ resource_file }}_l01.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:attrSpec ?s .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  attrs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?attr_name ?attr_kind ?ash_type ?ash_type_module ?array_of ?array_of_module
           ?allow_nil ?public ?sensitive ?generated ?writable ?is_pk ?default_expr
           ?update_default_expr ?constraints ?description ?source_col ?select_by_default
           ?always_select ?filterable ?sortable ?match_other ?ord
    WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:attrSpec ?s .
      ?s aap:name ?attr_name .
      OPTIONAL { ?s aap:attrKind ?k0 }
      BIND(COALESCE(?k0, "attribute") AS ?attr_kind)
      OPTIONAL { ?s aap:ashType ?ash_type }
      OPTIONAL { ?s aap:ashTypeModule ?tm0 }
      OPTIONAL { ?s aap:ashTypeEnum ?te . ?te aap:moduleName ?tm1 }
      BIND(COALESCE(?tm1, ?tm0, "") AS ?ash_type_module)
      OPTIONAL { ?s aap:arrayOf ?array_of }
      OPTIONAL { ?s aap:arrayOfModule ?am0 }
      OPTIONAL { ?s aap:arrayOfEnum ?ae . ?ae aap:moduleName ?am1 }
      BIND(COALESCE(?am1, ?am0, "") AS ?array_of_module)
      OPTIONAL { ?s aap:allowNil ?allow_nil }
      OPTIONAL { ?s aap:public ?public }
      OPTIONAL { ?s aap:sensitive ?sensitive }
      OPTIONAL { ?s aap:generated ?generated }
      OPTIONAL { ?s aap:writable ?writable }
      OPTIONAL { ?s aap:isPrimaryKey ?is_pk }
      OPTIONAL { ?s aap:defaultExpr ?default_expr }
      OPTIONAL { ?s aap:updateDefaultExpr ?update_default_expr }
      OPTIONAL { ?s aap:constraints ?constraints }
      OPTIONAL { ?s aap:description ?description }
      OPTIONAL { ?s aap:sourceColumn ?source_col }
      OPTIONAL { ?s aap:selectByDefault ?select_by_default }
      OPTIONAL { ?s aap:alwaysSelect ?always_select }
      OPTIONAL { ?s aap:filterable ?filterable }
      OPTIONAL { ?s aap:sortable ?sortable }
      OPTIONAL { ?s aap:matchOtherDefaults ?match_other }
      OPTIONAL { ?s aap:attrOrder ?o0 }
      BIND(COALESCE(?o0, 0) AS ?ord)
    } ORDER BY ?module_name ?ord ?attr_name
---
# GENERATED by ash-a2a-app-pack lane L01 from the application ontology. Do not hand-edit.
{% set my_attrs = attrs | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.L01Attributes do
  use Spark.Dsl.Fragment, of: Ash.Resource

  attributes do
{%- for a in my_attrs %}
{%- if a.attr_kind == "create_timestamp" %}
    create_timestamp(:{{ a.attr_name }})
{%- elif a.attr_kind == "update_timestamp" %}
    update_timestamp(:{{ a.attr_name }})
{%- elif a.attr_kind == "uuid_primary_key" %}
    uuid_primary_key(:{{ a.attr_name }})
{%- elif a.attr_kind == "uuid_v7_primary_key" %}
    uuid_v7_primary_key(:{{ a.attr_name }})
{%- elif a.attr_kind == "integer_primary_key" %}
    integer_primary_key(:{{ a.attr_name }})
{%- else %}
    attribute(:{{ a.attr_name }}, {% if a.array_of_module | default(value="") != "" %}{:array, {{ a.array_of_module }}}{% elif a.array_of | default(value="") != "" %}{:array, :{{ a.array_of }}}{% elif a.ash_type_module | default(value="") != "" %}{{ a.ash_type_module }}{% else %}:{{ a.ash_type }}{% endif %},
      public?: {{ a.public | default(value="true") }}
{%- if a.allow_nil | default(value="") != "" %}, allow_nil?: {{ a.allow_nil }}{% endif %}
{%- if a.sensitive | default(value="") != "" %}, sensitive?: {{ a.sensitive }}{% endif %}
{%- if a.generated | default(value="") != "" %}, generated?: {{ a.generated }}{% endif %}
{%- if a.writable | default(value="") != "" %}, writable?: {{ a.writable }}{% endif %}
{%- if a.is_pk | default(value="") != "" %}, primary_key?: {{ a.is_pk }}{% endif %}
{%- if a.default_expr | default(value="") != "" %}, default: {{ a.default_expr }}{% endif %}
{%- if a.update_default_expr | default(value="") != "" %}, update_default: {{ a.update_default_expr }}{% endif %}
{%- if a.match_other | default(value="") != "" %}, match_other_defaults?: {{ a.match_other }}{% endif %}
{%- if a.constraints | default(value="") != "" %}, constraints: [{{ a.constraints }}]{% endif %}
{%- if a.source_col | default(value="") != "" %}, source: :{{ a.source_col }}{% endif %}
{%- if a.select_by_default | default(value="") != "" %}, select_by_default?: {{ a.select_by_default }}{% endif %}
{%- if a.always_select | default(value="") != "" %}, always_select?: {{ a.always_select }}{% endif %}
{%- if a.filterable | default(value="") != "" %}, filterable?: {% if a.filterable == "simple_equality" %}:simple_equality{% else %}{{ a.filterable }}{% endif %}{% endif %}
{%- if a.sortable | default(value="") != "" %}, sortable?: {{ a.sortable }}{% endif %}
{%- if a.description | default(value="") != "" %}, description: "{{ a.description }}"{% endif %})
{%- endif %}
{%- endfor %}
  end
end
