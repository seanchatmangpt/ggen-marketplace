---
to: "lib/{{ app_path }}/{{ hook_file }}.ex"
force: true
for_each: "hooks"
sparql:
  hooks: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?hook_module ?hook_kind ?hook_body ?hook_file ?app_path WHERE {
      ?h a aap:L06Hook ; aap:moduleName ?hook_module ; aap:l06HookKind ?hook_kind ;
         aap:l06HookBody ?hook_body ; aap:l06HookFile ?hook_file ; aap:l06HookResource ?r .
      ?r aap:inDomain ?d . ?d aap:appPath ?app_path .
    } ORDER BY ?hook_module
---
# GENERATED by ash-a2a-app-pack lane L06 from the application ontology. Do not hand-edit.
{% if hook_kind == "prepare" -%}
defmodule {{ hook_module }} do
  use Ash.Resource.Preparation

  @impl true
  def prepare(query, opts, context) do
    _ = {opts, context}
    {{ hook_body | safe }}
  end
end
{%- else -%}
defmodule {{ hook_module }} do
  use Ash.Resource.Change

  @impl true
  def change(changeset, _opts, _context) do
{%- if hook_kind == "before_action" %}
    Ash.Changeset.before_action(changeset, fn changeset ->
      {{ hook_body | safe }}
    end)
{%- elif hook_kind == "after_action" %}
    Ash.Changeset.after_action(changeset, fn changeset, record ->
      {{ hook_body | safe }}
    end)
{%- elif hook_kind == "before_transaction" %}
    Ash.Changeset.before_transaction(changeset, fn changeset ->
      {{ hook_body | safe }}
    end)
{%- else %}
    Ash.Changeset.after_transaction(changeset, fn changeset, result ->
      {{ hook_body | safe }}
    end)
{%- endif %}
  end
end
{%- endif %}
