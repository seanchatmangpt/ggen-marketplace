---
to: "lib/{{ app_path }}/{{ fragment_file }}.ex"
force: true
for_each: "frags"
sparql:
  frags: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?fragment_module ?fragment_file ?app_path WHERE {
      ?res a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
           aap:reactorFragment ?fragment_module ; aap:reactorFragmentFile ?fragment_file ;
           aap:reactorAction ?any .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  ractions: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?returns ?description ?impl_module WHERE {
      ?res a aap:Resource ; aap:moduleName ?module_name ; aap:reactorAction ?a .
      ?a aap:name ?action_name ; aap:actionReturns ?returns ; aap:actionImplModule ?impl_module .
      OPTIONAL { ?a aap:description ?description }
    } ORDER BY ?module_name ?action_name
  rargs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?arg_name ?arg_type ?allow_nil WHERE {
      ?res a aap:Resource ; aap:moduleName ?module_name ; aap:reactorAction ?a .
      ?a aap:name ?action_name ; aap:actionArg ?g .
      ?g aap:name ?arg_name ; aap:actionArgType ?arg_type .
      OPTIONAL { ?g aap:actionArgAllowNil ?allow_nil }
    } ORDER BY ?module_name ?action_name ?arg_name
  rskills: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?skill_name ?skill_action ?skill_desc ?consequence ?lease ?on_cancel WHERE {
      ?res a aap:Resource ; aap:moduleName ?module_name ; aap:reactorAction ?a .
      ?a aap:name ?skill_action ; aap:reactorSkill ?s .
      ?s aap:name ?skill_name ; aap:description ?skill_desc .
      OPTIONAL { ?s aap:consequence ?consequence }
      OPTIONAL { ?s aap:leaseRequired ?lease }
      OPTIONAL { ?s aap:skillOnCancel ?on_cancel }
    } ORDER BY ?module_name ?skill_name
---
{#- Spark fragment: generic actions whose run is a Reactor (+ a2a skills on them).
    Grammar: ash action DSL `action :name, :type do argument..; run Impl end`;
    ash_a2a dsl.ex:188-197 (skill), :61 (on_cancel), :90 (lease_required?). -#}
{%- set my_actions = ractions | filter(attribute="module_name", value=module_name) -%}
{%- set my_args = rargs | filter(attribute="module_name", value=module_name) -%}
{%- set my_skills = rskills | filter(attribute="module_name", value=module_name) -%}
# GENERATED by ash-a2a-app-pack lane L15 from the application ontology. Do not hand-edit.
defmodule {{ fragment_module }} do
  use Spark.Dsl.Fragment, of: Ash.Resource, extensions: [AshA2A]

  actions do
{%- for x in my_actions %}
    action :{{ x.action_name }}, :{{ x.returns }} do
{%- if x.description %}
      description "{{ x.description }}"
{%- endif %}
{%- for g in my_args %}{% if g.action_name == x.action_name %}
      argument :{{ g.arg_name }}, :{{ g.arg_type }}{% if g.allow_nil %}, allow_nil?: {{ g.allow_nil }}{% endif %}
{%- endif %}{% endfor %}
      run {{ x.impl_module }}
    end
{%- endfor %}
  end
{%- if my_skills | length > 0 %}

  a2a do
{%- for s in my_skills %}
    skill(:{{ s.skill_name }}, :{{ s.skill_action }}, description: "{{ s.skill_desc }}"{% if s.consequence %}, consequence: :{{ s.consequence }}{% endif %}{% if s.lease %}, lease_required?: {{ s.lease }}{% endif %}{% if s.on_cancel %}, on_cancel: {{ s.on_cancel }}{% endif %})
{%- endfor %}
  end
{%- endif %}
end
