to: "lib/{{ app_path }}/{{ run_file }}.ex"
force: true
for_each: "runs"
sparql:
  runs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?run_module ?run_body ?run_file ?app_path WHERE {
      ?h a aap:L06Run ; aap:moduleName ?run_module ; aap:l06RunBody ?run_body ;
         aap:l06RunFile ?run_file ; aap:l06RunResource ?r .
      ?r aap:inDomain ?d . ?d aap:appPath ?app_path .
    } ORDER BY ?run_module
---
# GENERATED by ash-a2a-app-pack lane L06 from the application ontology. Do not hand-edit.
defmodule {{ run_module }} do
  use Ash.Resource.Actions.Implementation

  @impl true
  def run(input, opts, context) do
    _ = {opts, context}
    {{ run_body | safe }}
  end
end
