---
to: "lib/{{ app_path }}/{{ resource_file }}_l25.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:l25Destroy ?x .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  destroys: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?action_name ?primary ?accept ?require_atomic ?soft ?manual ?ts_attr WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:l25Destroy ?a .
      ?a aap:name ?action_name .
      OPTIONAL { ?a aap:l25Primary ?primary }
      OPTIONAL { ?a aap:l25Accept ?accept }
      OPTIONAL { ?a aap:l25RequireAtomic ?require_atomic }
      OPTIONAL { ?a aap:l25Soft ?soft }
      OPTIONAL { ?a aap:l25Manual ?manual }
      OPTIONAL { ?a aap:l25TimestampAttribute ?ts_attr }
    } ORDER BY ?module_name ?action_name
---
# GENERATED by ash-a2a-app-pack lane L25 from the application ontology. Do not hand-edit.
{% set my_destroys = destroys | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.L25Destroy do
  use Spark.Dsl.Fragment, of: Ash.Resource

  actions do
{%- for x in my_destroys %}
    destroy :{{ x.action_name }} do
{%- if x.primary %}
      primary?({{ x.primary }})
{%- endif %}
{%- if x.soft == "true" %}
      soft?(true)
{%- endif %}
{%- if x.manual %}
      manual({{ x.manual }})
{%- endif %}
{%- if x.require_atomic %}
      require_atomic?({{ x.require_atomic }})
{%- endif %}
{%- if x.accept and (x.soft == "true" or x.manual) %}
      accept([{% for t in x.accept | split(pat=",") %}{% if t != "" %}:{{ t }}{% if not loop.last %}, {% endif %}{% endif %}{% endfor %}])
{%- endif %}
{%- if x.soft == "true" and x.ts_attr %}
      change(set_attribute(:{{ x.ts_attr }}, &DateTime.utc_now/0))
{%- endif %}
    end
{%- endfor %}
  end
end
