---
to: "lib/{{ app_path }}/{{ resource_file }}_l18.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?app_path ?resource_file WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:sparkInstance ?i .
      ?d aap:appPath ?app_path .
    } ORDER BY ?module_name
  exts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT DISTINCT ?module_name ?ext_module WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:sparkExtension ?e .
      ?e aap:moduleName ?ext_module .
    } ORDER BY ?module_name ?ext_module
  insts: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?inst ?section_name ?entity_name WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:sparkInstance ?inst .
      ?inst aap:ofEntity ?n .
      ?n aap:name ?entity_name .
      ?s aap:sparkEntity ?n ; aap:name ?section_name .
    } ORDER BY ?module_name ?section_name ?inst
  vals: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?inst ?field_name ?arg_pos ?value_text WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:sparkInstance ?inst .
      ?inst aap:sparkValue ?v .
      ?v aap:forField ?f ; aap:valueText ?value_text .
      ?f aap:name ?field_name .
      OPTIONAL { ?f aap:argPosition ?arg_pos }
    } ORDER BY ?module_name ?inst ?arg_pos ?field_name
---
# GENERATED by ash-a2a-app-pack (L18 spark fragment) from the application ontology. Do not hand-edit.
{% set my_exts = exts | filter(attribute="module_name", value=module_name) -%}
{% set my_insts = insts | filter(attribute="module_name", value=module_name) -%}
{% set my_vals = vals | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.SparkL18 do
  use Spark.Dsl.Fragment,
    of: Ash.Resource,
    extensions: [{% for e in my_exts %}{{ e.ext_module }}{% if not loop.last %}, {% endif %}{% endfor %}]
{% set_global last_section = "" %}
{%- for i in my_insts %}
{%- set iv = my_vals | filter(attribute="inst", value=i.inst) %}
  {{ i.section_name }} do
    {{ i.entity_name }}{% set_global first = true %}{% for v in iv %}{% if v.arg_pos %} {% if not first %}, {% endif %}{{ v.value_text | safe }}{% set_global first = false %}{% endif %}{% endfor %}{% for v in iv %}{% if not v.arg_pos %}{% if first %} {% else %}, {% endif %}{{ v.field_name }}: {{ v.value_text | safe }}{% set_global first = false %}{% endif %}{% endfor %}
  end
{% endfor %}
end
