---
to: "lib/{{ app_path }}/{{ repo_file }}.ex"
force: true
for_each: "repos"
sparql:
  repos: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?repo_kind ?repo_file ?app_path ?otp_app ?pg_ext ?pg_min WHERE {
      ?p a aap:Project ; aap:appName ?otp_app ; aap:setupAppPath ?app_path .
      ?rp a aap:Repo ; aap:moduleName ?module_name ; aap:repoKind ?repo_kind ; aap:repoFile ?repo_file .
      OPTIONAL { ?rp aap:pgExtensions ?pg_ext }
      OPTIONAL { ?rp aap:pgMinVersion ?pg_min }
    } ORDER BY ?module_name
---
# GENERATED by ash-a2a-app-pack (L09) from the application ontology. Do not hand-edit.
{% if repo_kind == "postgres" -%}
defmodule {{ module_name }} do
  use AshPostgres.Repo, otp_app: :{{ otp_app }}

  @impl true
  def installed_extensions do
    [{% for e in pg_ext | default(value="ash-functions") | split(pat=",") %}"{{ e | trim }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  end
{%- if pg_min | default(value="") != "" %}
{%- set v = pg_min | split(pat=".") %}

  @impl true
  def min_pg_version, do: %Version{major: {{ v[0] }}, minor: {{ v[1] | default(value="0") }}, patch: {{ v[2] | default(value="0") }}}
{%- endif %}
end
{%- else -%}
defmodule {{ module_name }} do
  use AshSqlite.Repo, otp_app: :{{ otp_app }}
end
{%- endif %}
