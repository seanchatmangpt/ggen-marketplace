---
to: "lib/{{ app_path }}/{{ resource_file }}_l11.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?resource_file ?ps_module ?ps_name ?ps_prefix ?ps_delim ?ps_bt ?ps_filter ?ps_transform WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:pubSub ?ps .
      ?d aap:appPath ?app_path .
      ?ps aap:pubSubModule ?ps_module .
      OPTIONAL { ?ps aap:pubSubName ?ps_name }
      OPTIONAL { ?ps aap:pubSubPrefix ?ps_prefix }
      OPTIONAL { ?ps aap:pubSubDelimiter ?ps_delim }
      OPTIONAL { ?ps aap:broadcastType ?ps_bt }
      OPTIONAL { ?ps aap:pubSubFilterFn ?ps_filter }
      OPTIONAL { ?ps aap:pubSubTransformFn ?ps_transform }
    } ORDER BY ?module_name
  pubs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?pub_id ?pub_action ?pub_type ?pub_event ?pub_topic ?pub_topic_term ?pub_except ?pub_prev ?pub_load ?pub_filter ?pub_transform ?pub_transform_calc ?pub_public ?pub_dispatcher ?pub_returns WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:pubSub ?ps .
      ?ps aap:publication ?p .
      BIND(STR(?p) AS ?pub_id)
      OPTIONAL { ?p aap:pubAction ?pub_action }
      OPTIONAL { ?p aap:pubType ?pub_type }
      OPTIONAL { ?p aap:pubEvent ?pub_event }
      OPTIONAL { ?p aap:pubTopic ?pub_topic }
      OPTIONAL { ?p aap:pubTopicTerm ?pub_topic_term }
      OPTIONAL { ?p aap:pubExcept ?pub_except }
      OPTIONAL { ?p aap:previousValues ?pub_prev }
      OPTIONAL { ?p aap:pubLoad ?pub_load }
      OPTIONAL { ?p aap:pubFilterFn ?pub_filter }
      OPTIONAL { ?p aap:pubTransformFn ?pub_transform }
      OPTIONAL { ?p aap:pubTransformCalc ?pub_transform_calc }
      OPTIONAL { ?p aap:pubPublic ?pub_public }
      OPTIONAL { ?p aap:pubDispatcher ?pub_dispatcher }
      OPTIONAL { ?p aap:pubReturns ?pub_returns }
    } ORDER BY ?module_name ?pub_id
---
# GENERATED by ash-a2a-app-pack lane L11 from the application ontology. Do not hand-edit.
{% set my_pubs = pubs | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.L11PubSub do
  @moduledoc false
  use Spark.Dsl.Fragment,
    of: Ash.Resource,
    notifiers: [Ash.Notifier.PubSub]

  pub_sub do
    module({{ ps_module }})
{%- if ps_name | default(value="") != "" %}
    name({{ ps_name }})
{%- endif %}
{%- if ps_prefix | default(value="") != "" %}
    prefix("{{ ps_prefix }}")
{%- endif %}
{%- if ps_delim | default(value="") != "" %}
    delimiter("{{ ps_delim }}")
{%- endif %}
{%- if ps_bt | default(value="") != "" %}
    broadcast_type(:{{ ps_bt }})
{%- endif %}
{%- if ps_filter | default(value="") != "" %}
    filter(&{{ ps_filter }}/1)
{%- endif %}
{%- if ps_transform | default(value="") != "" %}
    transform(&{{ ps_transform }}/1)
{%- endif %}
{% for p in my_pubs %}
{%- if p.pub_type | default(value="") != "" %}
    publish_all(:{{ p.pub_type }}, {% if p.pub_topic_term | default(value="") != "" %}{{ p.pub_topic_term }}{% else %}[{% for t in p.pub_topic | default(value="") | split(pat=",") %}{% if t is starting_with(":") %}{{ t }}{% else %}"{{ t }}"{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- else %}
    publish(:{{ p.pub_action }}, {% if p.pub_topic_term | default(value="") != "" %}{{ p.pub_topic_term }}{% else %}[{% for t in p.pub_topic | default(value="") | split(pat=",") %}{% if t is starting_with(":") %}{{ t }}{% else %}"{{ t }}"{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- endif %}
{%- if p.pub_event | default(value="") != "" %}, event: "{{ p.pub_event }}"{% endif %}
{%- if p.pub_except | default(value="") != "" %}, except: [{% for e in p.pub_except | split(pat=",") %}:{{ e }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
{%- if p.pub_prev | default(value="") != "" %}, previous_values?: {{ p.pub_prev }}{% endif %}
{%- if p.pub_load | default(value="") != "" %}, load: {{ p.pub_load }}{% endif %}
{%- if p.pub_filter | default(value="") != "" %}, filter: &{{ p.pub_filter }}/1{% endif %}
{%- if p.pub_transform | default(value="") != "" %}{% if p.pub_transform_calc | default(value="") == "true" %}, transform: :{{ p.pub_transform }}{% else %}, transform: &{{ p.pub_transform }}/1{% endif %}{% endif %}
{%- if p.pub_public | default(value="") != "" %}, public?: {{ p.pub_public }}{% endif %}
{%- if p.pub_dispatcher | default(value="") != "" %}, dispatcher: {{ p.pub_dispatcher }}{% endif %}
{%- if p.pub_returns | default(value="") != "" %}, returns: :{{ p.pub_returns }}{% endif %})
{% endfor %}
  end
end
