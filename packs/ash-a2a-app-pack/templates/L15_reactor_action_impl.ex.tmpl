---
to: "lib/{{ app_path }}/reactor_actions/{{ impl_file }}.ex"
force: true
for_each: "impls"
sparql:
  impls: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?impl_module ?impl_file ?app_path ?reactor_module ?action_name ?pass_actor ?pass_tenant
           ?run_timeout ?run_max_concurrency ?run_max_iterations WHERE {
      ?res a aap:Resource ; aap:inDomain ?d ; aap:reactorAction ?a .
      ?d aap:appPath ?app_path .
      ?a aap:name ?action_name ; aap:actionImplModule ?impl_module ; aap:actionImplFile ?impl_file ;
         aap:runsReactor ?rx .
      ?rx aap:moduleName ?reactor_module .
      OPTIONAL { ?a aap:passActor ?pass_actor }
      OPTIONAL { ?a aap:passTenant ?pass_tenant }
      OPTIONAL { ?a aap:runTimeout ?run_timeout }
      OPTIONAL { ?a aap:runMaxConcurrency ?run_max_concurrency }
      OPTIONAL { ?a aap:runMaxIterations ?run_max_iterations }
    } ORDER BY ?impl_module
  rx_inputs: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?impl_module ?input_name WHERE {
      ?res a aap:Resource ; aap:reactorAction ?a .
      ?a aap:actionImplModule ?impl_module ; aap:runsReactor ?rx .
      ?rx aap:reactorInput ?i . ?i aap:name ?input_name .
    } ORDER BY ?impl_module ?input_name
---
{#- Generic-action implementation (ash Ash.Resource.Actions.Implementation, implementation.ex:5-60)
    that runs a Reactor (Reactor.run/4, reactor.ex:152-176). Only the reactor's declared inputs
    are forwarded; actor/tenant are forwarded as inputs :actor/:tenant only when declared. -#}
{%- set my_in = rx_inputs | filter(attribute="impl_module", value=impl_module) -%}
# GENERATED by ash-a2a-app-pack lane L15 from the application ontology. Do not hand-edit.
defmodule {{ impl_module }} do
  @moduledoc """
  Generic action `:{{ action_name }}` implementation: runs `{{ reactor_module }}`.
  """
  use Ash.Resource.Actions.Implementation

  @reactor_inputs [{% for i in my_in %}:{{ i.input_name }}{% if not loop.last %}, {% endif %}{% endfor %}]

  @impl true
  def run(input, _opts, ctx) do
    inputs =
      input.arguments
      |> Map.take(@reactor_inputs)
{%- if pass_actor and pass_actor == "true" %}
      |> Map.put(:actor, ctx.actor)
{%- endif %}
{%- if pass_tenant and pass_tenant == "true" %}
      |> Map.put(:tenant, ctx.tenant)
{%- endif %}

    run_opts = [
{%- if run_timeout %}
      timeout: {{ run_timeout }},
{%- endif %}
{%- if run_max_concurrency %}
      max_concurrency: {{ run_max_concurrency }},
{%- endif %}
{%- if run_max_iterations %}
      max_iterations: {{ run_max_iterations }},
{%- endif %}
    ]

    case Reactor.run({{ reactor_module }}, inputs, %{}, run_opts) do
      {:ok, result} -> {:ok, result}
      {:halted, _reactor} -> {:error, :reactor_halted}
      {:error, reason} -> {:error, reason}
    end
  end
end
