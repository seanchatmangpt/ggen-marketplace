---
to: "lib/{{ app_path }}/{{ resource_file }}_l07.ex"
force: true
for_each: "resources"
sparql:
  resources: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?app_path ?resource_file ?default_access ?private_fields WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:inDomain ?d ;
         aap:resourceFile ?resource_file ; aap:policy ?anyp .
      ?d aap:appPath ?app_path .
      OPTIONAL { ?r aap:defaultAccessType ?da }
      OPTIONAL { ?r aap:fieldPrivateFields ?pf }
      BIND(COALESCE(?da, "") AS ?default_access)
      BIND(COALESCE(?pf, "") AS ?private_fields)
    } GROUP BY ?module_name ?app_path ?resource_file ?default_access ?private_fields
      ORDER BY ?module_name
  groups: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?group_name ?kind ?arg ?arg2 WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:policyGroup ?g .
      ?g aap:name ?group_name ; aap:condKind ?kind .
      OPTIONAL { ?g aap:condArg ?a }
      OPTIONAL { ?g aap:condArg2 ?a2 }
      BIND(COALESCE(?a, "") AS ?arg)
      BIND(COALESCE(?a2, "") AS ?arg2)
    } ORDER BY ?module_name ?group_name
  policies: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?policy_name ?ord ?group ?bypass ?kind ?arg ?arg2 ?access_type ?errmsg WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:policy ?p .
      ?p aap:name ?policy_name ; aap:condKind ?kind .
      OPTIONAL { ?p aap:policyOrder ?o }
      OPTIONAL { ?p aap:inGroup ?g }
      OPTIONAL { ?p aap:bypass ?b }
      OPTIONAL { ?p aap:condArg ?a }
      OPTIONAL { ?p aap:condArg2 ?a2 }
      OPTIONAL { ?p aap:accessType ?at }
      OPTIONAL { ?p aap:errorMessage ?em }
      BIND(COALESCE(?o, 0) AS ?ord)
      BIND(COALESCE(?g, "") AS ?group)
      BIND(COALESCE(?b, "false") AS ?bypass)
      BIND(COALESCE(?a, "") AS ?arg)
      BIND(COALESCE(?a2, "") AS ?arg2)
      BIND(COALESCE(?at, "") AS ?access_type)
      BIND(COALESCE(?em, "") AS ?errmsg)
    } ORDER BY ?module_name ?ord ?policy_name
  checks: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?policy_name ?ord ?check_type ?check_kind ?carg ?carg2 WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:policy ?p .
      ?p aap:name ?policy_name ; aap:check ?c .
      ?c aap:checkType ?check_type ; aap:checkKind ?check_kind .
      OPTIONAL { ?c aap:checkOrder ?o }
      OPTIONAL { ?c aap:checkArg ?a }
      OPTIONAL { ?c aap:checkArg2 ?a2 }
      BIND(COALESCE(?o, 0) AS ?ord)
      BIND(COALESCE(?a, "") AS ?carg)
      BIND(COALESCE(?a2, "") AS ?carg2)
    } ORDER BY ?module_name ?policy_name ?ord
  field_policies: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?fp_name ?ord ?fields ?bypass ?kind ?arg ?arg2 WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:fieldPolicy ?f .
      ?f aap:name ?fp_name ; aap:fields ?fields .
      OPTIONAL { ?f aap:policyOrder ?o }
      OPTIONAL { ?f aap:bypass ?b }
      OPTIONAL { ?f aap:condKind ?k }
      OPTIONAL { ?f aap:condArg ?a }
      OPTIONAL { ?f aap:condArg2 ?a2 }
      BIND(COALESCE(?o, 0) AS ?ord)
      BIND(COALESCE(?b, "false") AS ?bypass)
      BIND(COALESCE(?k, "") AS ?kind)
      BIND(COALESCE(?a, "") AS ?arg)
      BIND(COALESCE(?a2, "") AS ?arg2)
    } ORDER BY ?module_name ?ord ?fp_name
  field_checks: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name ?fp_name ?ord ?check_type ?check_kind ?carg ?carg2 WHERE {
      ?r a aap:Resource ; aap:moduleName ?module_name ; aap:fieldPolicy ?f .
      ?f aap:name ?fp_name ; aap:check ?c .
      ?c aap:checkType ?check_type ; aap:checkKind ?check_kind .
      OPTIONAL { ?c aap:checkOrder ?o }
      OPTIONAL { ?c aap:checkArg ?a }
      OPTIONAL { ?c aap:checkArg2 ?a2 }
      BIND(COALESCE(?o, 0) AS ?ord)
      BIND(COALESCE(?a, "") AS ?carg)
      BIND(COALESCE(?a2, "") AS ?carg2)
    } ORDER BY ?module_name ?fp_name ?ord
---
# GENERATED by ash-a2a-app-pack (lane L07) from the application ontology. Do not hand-edit.
{% macro ref(kind, a, b) -%}
{%- if kind == "always" -%}always()
{%- elif kind == "actor_present" -%}actor_present()
{%- elif kind == "action_type" -%}action_type(:{{ a }})
{%- elif kind == "action" -%}action(:{{ a }})
{%- elif kind == "actor_attribute_equals" -%}actor_attribute_equals(:{{ a }}, {{ b }})
{%- elif kind == "accessing_from" -%}accessing_from({{ a }}, :{{ b }})
{%- elif kind == "relates_to_actor_via" -%}relates_to_actor_via({% if a is containing(",") %}[{% for t in a | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}]{% else %}:{{ a }}{% endif %})
{%- elif kind == "expr" -%}expr({{ a }})
{%- else -%}{{ kind }}({{ a }})
{%- endif -%}
{%- endmacro ref %}
{% set my_groups = groups | filter(attribute="module_name", value=module_name) -%}
{% set my_policies = policies | filter(attribute="module_name", value=module_name) -%}
{% set my_checks = checks | filter(attribute="module_name", value=module_name) -%}
{% set my_fps = field_policies | filter(attribute="module_name", value=module_name) -%}
{% set my_fchecks = field_checks | filter(attribute="module_name", value=module_name) -%}
defmodule {{ module_name }}.L07Policies do
  use Spark.Dsl.Fragment,
    of: Ash.Resource,
    authorizers: [Ash.Policy.Authorizer]

  policies do
{%- if default_access != "" %}
    default_access_type(:{{ default_access }})
{%- endif %}
{%- for g in my_groups %}

    policy_group {{ self::ref(kind=g.kind, a=g.arg, b=g.arg2) }} do
{%- for p in my_policies | filter(attribute="group", value=g.group_name) %}
{%- set pchecks = my_checks | filter(attribute="policy_name", value=p.policy_name) %}
      {% if p.bypass == "true" %}bypass{% else %}policy{% endif %} {{ self::ref(kind=p.kind, a=p.arg, b=p.arg2) }} do
        description("{{ p.policy_name }}")
{%- if p.access_type != "" %}
        access_type(:{{ p.access_type }})
{%- endif %}
{%- if p.errmsg != "" %}
        error_message("{{ p.errmsg }}")
{%- endif %}
{%- for c in pchecks %}
        {{ c.check_type }} {{ self::ref(kind=c.check_kind, a=c.carg, b=c.carg2) }}
{%- endfor %}
      end
{%- endfor %}
    end
{%- endfor %}
{%- for p in my_policies | filter(attribute="group", value="") %}
{%- set pchecks = my_checks | filter(attribute="policy_name", value=p.policy_name) %}

    {% if p.bypass == "true" %}bypass{% else %}policy{% endif %} {{ self::ref(kind=p.kind, a=p.arg, b=p.arg2) }} do
      description("{{ p.policy_name }}")
{%- if p.access_type != "" %}
      access_type(:{{ p.access_type }})
{%- endif %}
{%- if p.errmsg != "" %}
      error_message("{{ p.errmsg }}")
{%- endif %}
{%- for c in pchecks %}
      {{ c.check_type }} {{ self::ref(kind=c.check_kind, a=c.carg, b=c.carg2) }}
{%- endfor %}
    end
{%- endfor %}
  end
{%- if my_fps | length > 0 %}

  field_policies do
{%- if private_fields != "" %}
    private_fields(:{{ private_fields }})
{%- endif %}
{%- for f in my_fps %}
{%- set fchecks = my_fchecks | filter(attribute="fp_name", value=f.fp_name) %}

    {% if f.bypass == "true" %}field_policy_bypass{% else %}field_policy{% endif %} {% if f.fields == "*" %}:*{% else %}[{% for t in f.fields | split(pat=",") %}:{{ t }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}{% if f.kind != "" %}, {{ self::ref(kind=f.kind, a=f.arg, b=f.arg2) }}{% endif %} do
{%- for c in fchecks %}
      {{ c.check_type }} {{ self::ref(kind=c.check_kind, a=c.carg, b=c.carg2) }}
{%- endfor %}
    end
{%- endfor %}
  end
{%- endif %}
end
