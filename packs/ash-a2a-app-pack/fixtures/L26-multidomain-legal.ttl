@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.com/multi#> .

# LEGAL: federation over Desk + Billing; exposed skills' resources sit in served domains.
ex:Desk a aap:Domain ; aap:moduleName "Multi.Desk" ; aap:appPath "multi" ; aap:domainFile "desk" .
ex:Billing a aap:Domain ; aap:moduleName "Multi.Billing" ; aap:appPath "multi" ; aap:domainFile "billing" .
ex:DeskAgent a aap:Agent ; aap:moduleName "Multi.DeskAgent" ; aap:agentName "desk" ;
  aap:forDomain ex:Desk ; aap:agentFile "desk_agent" .
ex:BillingAgent a aap:Agent ; aap:moduleName "Multi.BillingAgent" ; aap:agentName "billing" ;
  aap:forDomain ex:Billing ; aap:agentFile "billing_agent" .
ex:Ticket a aap:Resource ; aap:moduleName "Multi.Desk.Ticket" ; aap:inDomain ex:Desk ;
  aap:skill ex:Ticket_skill .
ex:Invoice a aap:Resource ; aap:moduleName "Multi.Billing.Invoice" ; aap:inDomain ex:Billing ;
  aap:skill ex:Invoice_skill .
ex:Ticket_skill a aap:Skill ; aap:name "list_tickets" ; aap:ofAction "read" ; aap:consequence "observe" .
ex:Invoice_skill a aap:Skill ; aap:name "list_invoices" ; aap:ofAction "read" ; aap:consequence "observe" .
ex:Fed a aap:FederatedAgent ; aap:moduleName "Multi.FedAgent" ; aap:agentName "multi" ;
  aap:agentFile "fed_agent" ; aap:appPath "multi" ;
  aap:servesDomain ex:Desk, ex:Billing ; aap:memberAgent ex:DeskAgent, ex:BillingAgent ;
  aap:exposesSkill ex:Ticket_skill, ex:Invoice_skill .
