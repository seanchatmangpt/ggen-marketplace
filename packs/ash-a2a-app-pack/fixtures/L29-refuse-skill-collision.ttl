@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix l29: <https://example.com/l29skill#> .

# Refuses L29_020: skill "list_all" (aap:skill) on Ticket and (aap:skillSpec) on Note, same domain,
# domain wrapped by two agents.
l29:Desk a aap:Domain .
l29:AgentA a aap:Agent ; aap:forDomain l29:Desk .
l29:AgentB a aap:Agent ; aap:forDomain l29:Desk .
l29:Ticket a aap:Resource ; aap:inDomain l29:Desk ; aap:skill l29:Ticket_list .
l29:Note a aap:Resource ; aap:inDomain l29:Desk ; aap:skillSpec l29:Note_list .
l29:Ticket_list a aap:Skill ; aap:name "list_all" .
l29:Note_list a aap:SkillSpec ; aap:name "list_all" .
