@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.org/l23#> .

# LEGAL fixture: every mapping target is a declared argument or accepted attribute.
# Gates L23_010 and L23_020 must return ZERO rows on this graph.
# REFUSING fixture: see fixtures/L23-argmap-refusing.ttl (gate must return rows).
ex:Dom a aap:Domain ; aap:moduleName "Demo.Search" ; aap:appPath "demo" .

ex:Doc a aap:Resource ; aap:moduleName "Demo.Search.Doc" ; aap:inDomain ex:Dom ;
  aap:resourceFile "doc" ;
  aap:action ex:dSearch, ex:dCreate ;
  aap:skill ex:sSearch, ex:sCreate .

# read action with a declared argument `query`
ex:dSearch a aap:Action ; aap:name "search" ; aap:actionType "read" ;
  aap:actionArgument ex:dSearchQ .
ex:dSearchQ a aap:ActionArgument ; aap:argName "query" .

# create action accepting attributes title,body
ex:dCreate a aap:Action ; aap:name "create_doc" ; aap:actionType "create" ; aap:accept "title,body" .

ex:sSearch a aap:Skill ; aap:name "search_docs" ; aap:ofAction "search" ;
  aap:description "Search documents" ; aap:consequence "observe" ;
  aap:skillArgMap ex:sSearchQ .
ex:sSearchQ a aap:ArgMapping ; aap:wireName "q" ; aap:targetArg "query" .

ex:sCreate a aap:Skill ; aap:name "add_doc" ; aap:ofAction "create_doc" ;
  aap:description "Add a document" ; aap:consequence "change" ;
  aap:skillArgMap ex:sCreateT, ex:sCreateB .
ex:sCreateT a aap:ArgMapping ; aap:wireName "heading" ; aap:targetArg "title" .
ex:sCreateB a aap:ArgMapping ; aap:wireName "text" ; aap:targetArg "body" .
