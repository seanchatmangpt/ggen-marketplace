@prefix aap: <https://ggen.dev/ash-a2a-app#> .

# Valid strict profile. Layer on an app.ttl that declares <urn:demo:project> a aap:Project.
# Negative control: delete the aap:durableStore line and gate L31_010 must emit a row.
<urn:demo:project> aap:profile "strict" ;
  aap:durableStore "AshA2A.ReceiptStore.Ekv" ;
  aap:keyEnv "A2A_RECEIPT_KEY" ;
  aap:outboxDirEnv "A2A_OUTBOX_DIR" ;
  aap:claimStoreDirEnv "A2A_CLAIM_DIR" ;
  aap:authorityBroker "Demo.AuthorityBroker" ;
  aap:killSwitchClass ":operator" .
