@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix l29: <https://example.com/l29action#> .

# Refuses L29_030: legacy action "close" and L06 action "close" on one resource.
l29:Desk a aap:Domain .
l29:Ticket a aap:Resource ; aap:inDomain l29:Desk ;
  aap:action l29:Ticket_close_legacy ; aap:l06Action l29:Ticket_close_l06 .
l29:Ticket_close_legacy a aap:Action ; aap:name "close" .
l29:Ticket_close_l06 a aap:L06Action ; aap:name "close" .
