@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <https://example.org/l22#> .

# Legal: lease-required skill + valid duration + valid gate. Gates L22_010/L22_020 return 0 rows.
ex:Dom a aap:Domain ; aap:moduleName "Demo.Auth" ; aap:appPath "demo" .

ex:Good a aap:Resource ; aap:moduleName "Demo.Auth.Good" ; aap:inDomain ex:Dom ;
  aap:resourceFile "good" ; aap:authorityGate "two_port" ;
  aap:leaseDurationMs "120000"^^xsd:integer ;
  aap:skill ex:gSkill .
ex:gSkill a aap:Skill ; aap:name "do_good" ; aap:ofAction "act" ; aap:leaseRequired "true" .

# Refusing cases live in fixtures/L22-authority-refusing.ttl.
