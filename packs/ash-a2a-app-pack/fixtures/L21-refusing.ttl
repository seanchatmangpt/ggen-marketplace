@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.org/l21bad#> .

# REFUSING: expected gate rows
#   L21_020 refused_hddl_fact_args  (ex:opBad precondition uses "ghost", not a parameter)
#   L21_020 operator has no effects (ex:opBad)
#   L21_010 refused_hddl_multiple_operators (ex:sTwo has two operators)
ex:Dom a aap:Domain ; aap:moduleName "Bad.Flow" ; aap:appPath "bad" .

ex:Phase a aap:Resource ; aap:moduleName "Bad.Flow.Phase" ; aap:inDomain ex:Dom ;
  aap:resourceFile "phase" ; aap:skill ex:sBad, ex:sTwo .

ex:sBad a aap:Skill ; aap:name "bad_op" ; aap:ofAction "advance" ; aap:hddlOperator ex:opBad .
ex:opBad a aap:HddlOperator ;
  aap:hddlParam [ aap:paramName "from" ; aap:paramOrder 1 ] ;
  aap:hddlFact [ aap:factRole "precondition" ; aap:predicate "current_phase" ; aap:factOrder 1 ;
                 aap:factArg [ aap:argName "ghost" ; aap:argOrder 1 ] ] .

ex:sTwo a aap:Skill ; aap:name "two_ops" ; aap:ofAction "advance" ;
  aap:hddlOperator ex:opA, ex:opB .
ex:opA a aap:HddlOperator ; aap:hddlParam [ aap:paramName "x" ] ;
  aap:hddlFact [ aap:factRole "add_effect" ; aap:predicate "p" ; aap:factArg [ aap:argName "x" ] ] .
ex:opB a aap:HddlOperator ; aap:hddlParam [ aap:paramName "y" ] ;
  aap:hddlFact [ aap:factRole "add_effect" ; aap:predicate "q" ; aap:factArg [ aap:argName "y" ] ] .
