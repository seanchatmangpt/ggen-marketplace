@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.com/demo#> .

# Requires the base fixture (ex:Desk domain, ex:Ticket resource with legacy id/title attributes).
ex:TicketStatus a aap:EnumType ; aap:moduleName "Demo.Desk.TicketStatus" ; aap:inDomain ex:Desk ;
  aap:enumFile "ticket_status" ;
  aap:enumValue ex:TS_open, ex:TS_esc, ex:TS_closed, ex:TS_wait .
ex:TS_open   a aap:EnumValue ; aap:name "open" ; aap:description "An open ticket" ; aap:order 1 .
ex:TS_esc    a aap:EnumValue ; aap:name "escalated" ; aap:description "Escalated" ; aap:label "Escalated!" ; aap:order 2 .
ex:TS_closed a aap:EnumValue ; aap:name "closed" ; aap:label "Closed" ; aap:order 3 .
ex:TS_wait   a aap:EnumValue ; aap:name "waiting" ; aap:order 4 .

ex:Ticket aap:attrSpec ex:T_status, ex:T_tags, ex:T_prio, ex:T_secret, ex:T_ins, ex:T_upd,
                       ex:T_closed_at, ex:T_slug, ex:T_scores .

ex:T_status a aap:AttributeSpec ; aap:name "status" ; aap:ashTypeEnum ex:TicketStatus ;
  aap:allowNil "false" ; aap:defaultExpr ":open" ; aap:attrOrder 1 .
ex:T_tags a aap:AttributeSpec ; aap:name "tags" ; aap:arrayOf "string" ;
  aap:constraints "items: [max_length: 24, min_length: 1], nil_items?: false" ; aap:attrOrder 2 .
ex:T_prio a aap:AttributeSpec ; aap:name "priority" ; aap:ashType "integer" ;
  aap:constraints "min: 1, max: 5" ; aap:defaultExpr "3" ; aap:allowNil "false" ;
  aap:description "Priority 1-5" ; aap:attrOrder 3 .
ex:T_secret a aap:AttributeSpec ; aap:name "api_token" ; aap:ashType "string" ;
  aap:sensitive "true" ; aap:public "false" ; aap:filterable "false" ; aap:attrOrder 4 .
ex:T_ins a aap:AttributeSpec ; aap:name "inserted_at" ; aap:attrKind "create_timestamp" ; aap:attrOrder 5 .
ex:T_upd a aap:AttributeSpec ; aap:name "updated_at" ; aap:attrKind "update_timestamp" ; aap:attrOrder 6 .
ex:T_closed_at a aap:AttributeSpec ; aap:name "closed_at" ; aap:ashTypeModule "Ash.Type.UtcDatetimeUsec" ;
  aap:writable "false" ; aap:updateDefaultExpr "nil" ; aap:attrOrder 7 .
ex:T_slug a aap:AttributeSpec ; aap:name "slug" ; aap:ashTypeModule "Ash.Type.CiString" ;
  aap:generated "true" ; aap:sourceColumn "slug_col" ; aap:sortable "false" ;
  aap:selectByDefault "false" ; aap:attrOrder 8 .
ex:T_scores a aap:AttributeSpec ; aap:name "scores" ; aap:arrayOf "float" ;
  aap:constraints "min_length: 0, items: [min: 0.0]" ; aap:defaultExpr "[]" ; aap:attrOrder 9 .
