# L24 legal fixture: extends demo ex:Ticket (attributes title/priority, identity unique_title
# from L05-identities-validations.ttl). All gates L24_010/020/030 must return zero rows.
@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.com/demo#> .

ex:Ticket aap:l24Read ex:Ticket_get_by_title, ex:Ticket_get_by_identity, ex:Ticket_plain_list .

ex:Ticket_get_by_title a aap:L24ReadAction ; aap:name "by_title" ; aap:actionType "read" ;
  aap:l24Get "true" ; aap:getByKey "title" .
ex:Ticket_get_by_identity a aap:L24ReadAction ; aap:name "by_unique_title" ; aap:actionType "read" ;
  aap:l24Get "true" ; aap:getIdentity "unique_title" .
# no get?: not subject to key requirement
ex:Ticket_plain_list a aap:L24ReadAction ; aap:name "list_all" ; aap:actionType "read" .
