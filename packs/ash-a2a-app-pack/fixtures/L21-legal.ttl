@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.org/l21#> .

# LEGAL: mirrors ash_a2a brce.ex:130-149. Gates L21_010/L21_020 must return zero rows.
ex:Dom a aap:Domain ; aap:moduleName "Demo.Flow" ; aap:appPath "demo" .

ex:Phase a aap:Resource ; aap:moduleName "Demo.Flow.Phase" ; aap:inDomain ex:Dom ;
  aap:resourceFile "phase" ; aap:skill ex:sAdvance .

ex:sAdvance a aap:Skill ; aap:name "advance" ; aap:ofAction "advance" ; aap:consequence "change" ;
  aap:hddlOperator ex:opAdvance .

ex:opAdvance a aap:HddlOperator ;
  aap:hddlParam [ aap:paramName "from" ; aap:paramOrder 1 ], [ aap:paramName "to" ; aap:paramOrder 2 ] ;
  aap:hddlFact
    [ aap:factRole "precondition" ; aap:predicate "current_phase" ; aap:factOrder 1 ;
      aap:factArg [ aap:argName "from" ; aap:argOrder 1 ] ],
    [ aap:factRole "add_effect" ; aap:predicate "current_phase" ; aap:factOrder 1 ;
      aap:factArg [ aap:argName "to" ; aap:argOrder 1 ] ],
    [ aap:factRole "delete_effect" ; aap:predicate "current_phase" ; aap:factOrder 1 ;
      aap:factArg [ aap:argName "from" ; aap:argOrder 1 ] ] .
