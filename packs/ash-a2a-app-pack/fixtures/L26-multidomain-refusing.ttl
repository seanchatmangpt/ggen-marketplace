@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.com/multibad#> .

# REFUSING: L26_010 fires for ex:EmptyFed (zero domains); L26_020 fires for ex:BadFed
# (exposes Invoice_skill whose resource is in Billing, which BadFed does not serve).
ex:Desk a aap:Domain ; aap:moduleName "Bad.Desk" ; aap:appPath "bad" ; aap:domainFile "desk" .
ex:Billing a aap:Domain ; aap:moduleName "Bad.Billing" ; aap:appPath "bad" ; aap:domainFile "billing" .
ex:Ticket a aap:Resource ; aap:moduleName "Bad.Desk.Ticket" ; aap:inDomain ex:Desk ;
  aap:skill ex:Ticket_skill .
ex:Invoice a aap:Resource ; aap:moduleName "Bad.Billing.Invoice" ; aap:inDomain ex:Billing ;
  aap:skill ex:Invoice_skill .
ex:Ticket_skill a aap:Skill ; aap:name "list_tickets" ; aap:ofAction "read" ; aap:consequence "observe" .
ex:Invoice_skill a aap:Skill ; aap:name "list_invoices" ; aap:ofAction "read" ; aap:consequence "observe" .

ex:EmptyFed a aap:FederatedAgent ; aap:moduleName "Bad.EmptyFed" ; aap:agentName "empty" ;
  aap:agentFile "empty_fed" ; aap:appPath "bad" .

ex:BadFed a aap:FederatedAgent ; aap:moduleName "Bad.BadFed" ; aap:agentName "bad" ;
  aap:agentFile "bad_fed" ; aap:appPath "bad" ;
  aap:servesDomain ex:Desk ;
  aap:exposesSkill ex:Ticket_skill, ex:Invoice_skill .
