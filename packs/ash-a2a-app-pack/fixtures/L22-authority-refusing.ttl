@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <https://example.org/l22r#> .

# Refusing fixture. Expected: L22_010 -> (NoDur, ndSkill), (ZeroDur, zSkill), (StrDur, sSkill);
# L22_020 -> (Disabled, "disabled", dSkill), (BadGate, "wide_open").
ex:Dom a aap:Domain ; aap:moduleName "Demo.AuthR" ; aap:appPath "demor" .

ex:NoDur a aap:Resource ; aap:moduleName "Demo.AuthR.NoDur" ; aap:inDomain ex:Dom ;
  aap:resourceFile "no_dur" ; aap:skill ex:ndSkill .
ex:ndSkill a aap:Skill ; aap:name "nd" ; aap:ofAction "act" ; aap:leaseRequired "true" .

ex:ZeroDur a aap:Resource ; aap:moduleName "Demo.AuthR.ZeroDur" ; aap:inDomain ex:Dom ;
  aap:resourceFile "zero_dur" ; aap:leaseDurationMs "0"^^xsd:integer ; aap:skill ex:zSkill .
ex:zSkill a aap:Skill ; aap:name "z" ; aap:ofAction "act" ; aap:leaseRequired "true" .

ex:StrDur a aap:Resource ; aap:moduleName "Demo.AuthR.StrDur" ; aap:inDomain ex:Dom ;
  aap:resourceFile "str_dur" ; aap:leaseDurationMs "soon" ; aap:skill ex:sSkill .
ex:sSkill a aap:Skill ; aap:name "s" ; aap:ofAction "act" ; aap:leaseRequired "true" .

ex:Disabled a aap:Resource ; aap:moduleName "Demo.AuthR.Disabled" ; aap:inDomain ex:Dom ;
  aap:resourceFile "disabled" ; aap:authorityGate "disabled" ;
  aap:leaseDurationMs "1000"^^xsd:integer ; aap:skill ex:dSkill .
ex:dSkill a aap:Skill ; aap:name "d" ; aap:ofAction "act" ; aap:leaseRequired "true" .

ex:BadGate a aap:Resource ; aap:moduleName "Demo.AuthR.BadGate" ; aap:inDomain ex:Dom ;
  aap:resourceFile "bad_gate" ; aap:authorityGate "wide_open" .
