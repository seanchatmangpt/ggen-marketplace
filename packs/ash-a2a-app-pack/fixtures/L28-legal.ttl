@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.com/l28#> .

# L28 legal fixture: zero rows from every gates/L28_*.rq.
ex:Dom a aap:Domain ; aap:moduleName "L28.Dom" ; aap:appPath "l28" .
ex:A a aap:Resource ; aap:moduleName "L28.Dom.A" ; aap:inDomain ex:Dom ; aap:skill ex:A_s1 .
ex:B a aap:Resource ; aap:moduleName "L28.Dom.B" ; aap:inDomain ex:Dom ; aap:skillSpec ex:B_s2 .
ex:A_s1 a aap:Skill ; aap:name "get_a" .
ex:B_s2 a aap:SkillSpec ; aap:specName "get_b" .
ex:DomAgent a aap:Agent ; aap:moduleName "L28.DomAgent" ; aap:forDomain ex:Dom .
