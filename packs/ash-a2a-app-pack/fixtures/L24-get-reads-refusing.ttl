# L24 refusing fixture (load with the demo Ticket base + L05 fixture, NOT with the legal one).
# Expected: L24_010 -> ex:Ticket_bad_create ; L24_020 -> ex:Ticket_bad_nokey, ex:Ticket_bad_identity ;
#           L24_030 -> ex:Ticket_bad_attr (k "nonexistent").
@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.com/demo#> .

ex:Ticket aap:l24Read ex:Ticket_bad_create, ex:Ticket_bad_nokey, ex:Ticket_bad_identity,
                      ex:Ticket_bad_attr .

ex:Ticket_bad_create a aap:L24ReadAction ; aap:name "open_get" ; aap:actionType "create" ;
  aap:l24Get "true" ; aap:getByKey "title" .
ex:Ticket_bad_nokey a aap:L24ReadAction ; aap:name "one_ticket" ; aap:actionType "read" ;
  aap:l24Get "true" .
ex:Ticket_bad_identity a aap:L24ReadAction ; aap:name "by_missing_identity" ; aap:actionType "read" ;
  aap:l24Get "true" ; aap:getIdentity "no_such_identity" .
ex:Ticket_bad_attr a aap:L24ReadAction ; aap:name "by_ghost" ; aap:actionType "read" ;
  aap:l24Get "true" ; aap:getByKey "nonexistent" .
