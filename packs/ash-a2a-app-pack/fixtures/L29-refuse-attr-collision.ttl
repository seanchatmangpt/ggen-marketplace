@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix l29: <https://example.com/l29attr#> .

# Refuses L29_010: attribute "notes" equals relationship "notes"; attrSpec "total" equals aggregate.
l29:Desk a aap:Domain .
l29:Ticket a aap:Resource ; aap:inDomain l29:Desk ;
  aap:attribute l29:Ticket_notes_attr ; aap:attrSpec l29:Ticket_total_attr ;
  aap:relationship l29:Ticket_notes_rel ; aap:aggregate l29:Ticket_total_agg .
l29:Ticket_notes_attr a aap:Attribute ; aap:name "notes" .
l29:Ticket_total_attr a aap:AttributeSpec ; aap:name "total" .
l29:Ticket_notes_rel a aap:Relationship ; aap:name "notes" .
l29:Ticket_total_agg a aap:Aggregate ; aap:name "total" .
