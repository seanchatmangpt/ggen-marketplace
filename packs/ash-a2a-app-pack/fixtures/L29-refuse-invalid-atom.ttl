@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix l29: <https://example.com/l29atom#> .

# Refuses L29_040: attribute "Title" (uppercase start), skill "list tickets" (space),
# action "9close" (digit start).
l29:Desk a aap:Domain .
l29:Ticket a aap:Resource ; aap:inDomain l29:Desk ;
  aap:attribute l29:Ticket_Title ; aap:skill l29:Ticket_list ; aap:action l29:Ticket_9close .
l29:Ticket_Title a aap:Attribute ; aap:name "Title" .
l29:Ticket_list a aap:Skill ; aap:name "list tickets" .
l29:Ticket_9close a aap:Action ; aap:name "9close" .
