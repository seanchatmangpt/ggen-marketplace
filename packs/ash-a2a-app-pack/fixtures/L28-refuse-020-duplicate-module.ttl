@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.com/l28#> .

# Refuses L28_020 (and L20_041). Expected row: ?a = ex:A, ?b = ex:B, ?module_name = "L28.Dom.Same".
ex:Dom a aap:Domain ; aap:moduleName "L28.Dom" ; aap:appPath "l28" .
ex:A a aap:Resource ; aap:moduleName "L28.Dom.Same" ; aap:inDomain ex:Dom .
ex:B a aap:Resource ; aap:moduleName "L28.Dom.Same" ; aap:inDomain ex:Dom .
