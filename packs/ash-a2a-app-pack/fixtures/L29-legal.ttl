@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix l29: <https://example.com/l29legal#> .

# Legal: all four L29 gates return zero rows.
l29:Desk a aap:Domain ; aap:moduleName "L29.Desk" .
l29:DeskAgent a aap:Agent ; aap:forDomain l29:Desk .
l29:Ticket a aap:Resource ; aap:inDomain l29:Desk ;
  aap:attribute l29:Ticket_title ; aap:attrSpec l29:Ticket_status ;
  aap:relationship l29:Ticket_notes ; aap:calculation l29:Ticket_display ;
  aap:aggregate l29:Ticket_note_count ;
  aap:action l29:Ticket_read ; aap:l06Action l29:Ticket_close ;
  aap:skill l29:Ticket_list ; aap:skillSpec l29:Ticket_find .
l29:Ticket_title a aap:Attribute ; aap:name "title" .
l29:Ticket_status a aap:AttributeSpec ; aap:name "status" .
l29:Ticket_notes a aap:Relationship ; aap:name "notes" .
l29:Ticket_display a aap:Calculation ; aap:name "display" .
l29:Ticket_note_count a aap:Aggregate ; aap:name "note_count" .
l29:Ticket_read a aap:Action ; aap:name "read" .
l29:Ticket_close a aap:L06Action ; aap:name "close" .
l29:Ticket_list a aap:Skill ; aap:name "list_tickets" .
l29:Ticket_find a aap:SkillSpec ; aap:name "find_tickets" .
