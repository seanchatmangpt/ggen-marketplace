@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix ex:  <https://example.org/l18#> .

# Fixture: app-level Spark extension `Demo.Audit` with section `audit`, entity `watch`, applied to one resource.
ex:domain a aap:Domain ; aap:moduleName "Demo.Domain" ; aap:appPath "demo" .

ex:ext a aap:SparkExtension ; aap:moduleName "Demo.Audit" ; aap:appPath "demo" ; aap:extFile "audit"
  ; aap:extPersistKey "demo_audit_summary" ; aap:sparkSection ex:sec .

ex:sec a aap:SparkSection ; aap:name "audit" ; aap:description "Audit watches." ; aap:sparkOrder 1
  ; aap:minEntities 1 ; aap:sparkField ex:secLevel ; aap:sparkEntity ex:watch .

ex:secLevel a aap:SparkField ; aap:name "default_level" ; aap:sparkType ":atom"
  ; aap:fieldDefault ":info" ; aap:doc "Default audit level." .

ex:watch a aap:SparkEntity ; aap:name "watch" ; aap:structModule "Demo.Audit.Watch" ; aap:identifier "attribute"
  ; aap:uniqueField "attribute" ; aap:description "Watch an attribute."
  ; aap:sparkField ex:fAttr, ex:fLevel .

ex:fAttr  a aap:SparkField ; aap:name "attribute" ; aap:sparkType ":atom" ; aap:required "true"
  ; aap:argPosition 1 ; aap:fieldOrder 1 ; aap:doc "Attribute to watch." .
ex:fLevel a aap:SparkField ; aap:name "level" ; aap:sparkType "{:one_of, [:info, :warn]}"
  ; aap:fieldDefault ":info" ; aap:fieldOrder 2 ; aap:doc "Severity." .

ex:res a aap:Resource ; aap:moduleName "Demo.Ticket" ; aap:inDomain ex:domain ; aap:resourceFile "ticket"
  ; aap:sparkExtension ex:ext ; aap:sparkInstance ex:inst1 .

ex:inst1 a aap:SparkInstance ; aap:ofEntity ex:watch ; aap:sparkValue ex:v1, ex:v2 .
ex:v1 a aap:SparkValue ; aap:forField ex:fAttr ; aap:valueText ":status" .
ex:v2 a aap:SparkValue ; aap:forField ex:fLevel ; aap:valueText ":warn" .
