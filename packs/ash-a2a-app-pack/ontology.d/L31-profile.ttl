@prefix aap:  <https://ggen.dev/ash-a2a-app#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# L31 vocabulary: production security profile (ash_a2a AshA2A.SecurityProfile.Boot, :strict).
# Evidence: ash_a2a lib/ash_a2a/security_profile.ex:22-24 (compile_env, default :strict),
# lib/ash_a2a/security_profile/boot.ex:96-112 (snapshot) and :119-149 (strict violations).

aap:profile a rdf:Property ; rdfs:label "production security profile: strict | legacy_compat" ;
  rdfs:domain aap:Project .
aap:durableStore a rdf:Property ;
  rdfs:label "durable receipt store module (config :ash_a2a, :receipt_store); not ...ReceiptStore.Memory" .
aap:keyEnv a rdf:Property ;
  rdfs:label "env var name read at runtime for the receipt outbox HMAC key (>= 32 bytes)" .
aap:outboxDirEnv a rdf:Property ;
  rdfs:label "env var name read at runtime for the durable receipt outbox dir (not under tmp)" .
aap:claimStoreDirEnv a rdf:Property ;
  rdfs:label "env var name read at runtime for the durable effect-claim store dir" .
aap:authorityBroker a rdf:Property ; rdfs:label "authority broker module (strict requires one)" .
aap:killSwitchClass a rdf:Property ; rdfs:label "kill switch class (strict requires one)" .
