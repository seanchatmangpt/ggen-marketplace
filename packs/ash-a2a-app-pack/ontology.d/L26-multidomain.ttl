@prefix aap: <https://ggen.dev/ash-a2a-app#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# L26 multi-domain agent. Evidence: AshA2A.Agent takes exactly one resource_or_domain
# (/Users/sac/ash_a2a/lib/ash_a2a/agent.ex:110 Keyword.pop!(opts, :resource_or_domain); :137 stores
# one @ash_a2a_resource_or_domain); no `domains` option exists under /Users/sac/ash_a2a/lib.
# Multiple agents are served together via AshA2A.Protocol.AgentSupervisor agents: [...]
# (protocol/agent_supervisor.ex:12, protocol/registry.ex:19). So a multi-domain agent is a
# federation: one AshA2A.Agent per served domain plus a generated facade module.

aap:FederatedAgent a owl:Class ;
  rdfs:comment "An agent identity serving more than one Ash domain. Emitted as a facade listing one AshA2A.Agent per served domain. Requires >= 1 aap:servesDomain." .
aap:servesDomain a owl:ObjectProperty ;
  rdfs:domain aap:FederatedAgent ; rdfs:range aap:Domain ;
  rdfs:comment "FederatedAgent -> aap:Domain (repeatable). Zero is refused by L26_010." .
aap:memberAgent a owl:ObjectProperty ;
  rdfs:domain aap:FederatedAgent ; rdfs:range aap:Agent ;
  rdfs:comment "FederatedAgent -> the per-domain aap:Agent (aap:forDomain) that serves one of its domains." .
aap:exposesSkill a owl:ObjectProperty ;
  rdfs:domain aap:FederatedAgent ; rdfs:range aap:Skill ;
  rdfs:comment "FederatedAgent -> aap:Skill it advertises; the skill's resource must be aap:inDomain a served domain (L26_020)." .
