@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# L03 calculations vocabulary. Grammar: ash deps/ash/lib/ash/resource/calculation/calculation.ex:28-130
# (schema), calculation/argument.ex:25-57 (argument schema), resource/dsl.ex:1715-1785 (entity+section).
aap:Calculation         a owl:Class ; rdfs:comment "An Ash calculation (calculations do calculate ... end)." .
aap:CalculationArgument a owl:Class ; rdfs:comment "An argument of a calculation (argument.ex:25)." .

aap:calculation   a owl:ObjectProperty ; rdfs:comment "Resource -> aap:Calculation." .
aap:calcArgument  a owl:ObjectProperty ; rdfs:comment "Calculation -> aap:CalculationArgument." .
aap:calcKind      a owl:DatatypeProperty ; rdfs:comment "expr | concat | module. expr: aap:expression; concat: builtin Ash.Resource.Calculation.Concat (concat.ex:5) with aap:calcKeys/aap:separator; module: generated coalesce module aap:calcModule over aap:calcKeys." .
aap:expression    a owl:DatatypeProperty ; rdfs:comment "Elixir expression text placed inside expr(...) (kind expr)." .
aap:calcKeys      a owl:DatatypeProperty ; rdfs:comment "comma-separated attribute names (concat/module kinds)." .
aap:separator     a owl:DatatypeProperty ; rdfs:comment "concat separator string." .
aap:calcModule    a owl:DatatypeProperty ; rdfs:comment "Module name of generated calculation (kind module)." .
aap:calcFile      a owl:DatatypeProperty ; rdfs:comment "File stem under lib/<appPath>/calculations/ (kind module)." .
aap:load          a owl:DatatypeProperty ; rdfs:comment "comma-separated attribute/calculation names for load: (calculation.ex:87)." .
aap:public        a owl:DatatypeProperty ; rdfs:comment "\"true\"|\"false\" -> public? (calculation.ex:59)." .
aap:allowNil      a owl:DatatypeProperty ; rdfs:comment "\"true\"|\"false\" -> allow_nil? (calc :93, arg :41)." .
aap:allowExpr     a owl:DatatypeProperty ; rdfs:comment "argument allow_expr? (argument.ex:46)." .
aap:sensitive     a owl:DatatypeProperty ; rdfs:comment "sensitive? (calculation.ex:66)." .
aap:filterable    a owl:DatatypeProperty ; rdfs:comment "true|false|simple_equality (calculation.ex:102)." .
aap:sortable      a owl:DatatypeProperty ; rdfs:comment "sortable? (calculation.ex:107)." .
aap:constraints   a owl:DatatypeProperty ; rdfs:comment "Elixir keyword text, e.g. \"max_length: 80\" (calc :43, arg :51)." .
aap:default       a owl:DatatypeProperty ; rdfs:comment "Elixir literal text for argument default (argument.ex:36)." .
aap:argOrder      a owl:DatatypeProperty ; rdfs:comment "integer sort key for arguments." .
