@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# L22: AshA2A `authority do ... end` section (gate + lease duration).
# DSL: /Users/sac/ash_a2a/lib/ash_a2a/dsl.ex:228-251 (@authority section; gate :232-241 one_of
#   [:two_port,:open,:disabled] default :two_port; lease_duration_ms :242-249 :pos_integer default 60_000);
#   sections list :275. Skill flag lease_required? dsl.ex:90-98 (boolean, default false).
# Readers: AshA2A.Info.lease_duration_ms/1 info.ex:196-198 ; persisted by
#   transformers/build_capability_index.ex:66,76 ; inert warnings verify.ex:181-205
#   (lease_duration_ms != 60_000 warns "declared but not enforced"; gate :open warns).
# Fragment extension: `use Ash.Resource, extensions: [AshA2A]` ash_a2a.ex:11.

aap:authorityGate     a owl:DatatypeProperty ; rdfs:domain aap:Resource ;
  rdfs:comment "Resource: two_port|open|disabled (authority gate; dsl.ex:232). Omit => default two_port." .
aap:leaseDurationMs   a owl:DatatypeProperty ; rdfs:domain aap:Resource ; rdfs:range xsd:integer ;
  rdfs:comment "Resource: authority lease_duration_ms, xsd:integer > 0 (dsl.ex:242). Required (L22_010) when any skill has leaseRequired true." .
# Reused (L07/base): aap:skill, aap:Skill, aap:leaseRequired ("true"/"false" string literals).
