@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# L04 aggregates vocabulary. DSL grammar: ash dsl.ex @count:1377 @first:1415 @max:1449 @min:1475
# @sum:1501 @avg:1527 @exists:1553 @custom:1578 @list:1618 @join_filter:1353;
# option schema ash/resource/aggregate/aggregate.ex:39-125.

aap:Aggregate a owl:Class ;
  rdfs:comment "A named Ash aggregate (aggregates do ... end)." .
aap:AggregateJoinFilter a owl:Class ;
  rdfs:comment "join_filter relationship_path, filter inside an aggregate (dsl.ex:1353)." .

aap:aggregate a owl:ObjectProperty ; rdfs:comment "Resource -> Aggregate." .
aap:aggJoinFilter a owl:ObjectProperty ; rdfs:comment "Aggregate -> AggregateJoinFilter." .

# kind: count|exists|first|sum|min|max|avg|list|custom (aggregate.ex:61)
aap:aggKind a owl:DatatypeProperty .
# comma-separated relationship path, no whitespace, e.g. "comments,author" (aggregate.ex:51)
aap:aggPath a owl:DatatypeProperty .
# resource-based aggregate: module name (aggregate.ex:158, count :x, Profile)
aap:aggResource a owl:DatatypeProperty .
aap:aggField a owl:DatatypeProperty ; rdfs:comment "aggregate.ex:67" .
aap:aggType a owl:DatatypeProperty ; rdfs:comment "custom only: type module (dsl.ex:1604)" .
aap:aggImplementation a owl:DatatypeProperty ; rdfs:comment "custom only: raw Elixir term (dsl.ex:1609)" .
aap:aggFilter a owl:DatatypeProperty ; rdfs:comment "raw Elixir: [active: true] or expr(...) (aggregate.ex:73)" .
aap:aggSort a owl:DatatypeProperty ; rdfs:comment "raw Elixir sort (aggregate.ex:78); first/list/custom only" .
aap:aggDefault a owl:DatatypeProperty ; rdfs:comment "raw Elixir default (aggregate.ex:86)" .
aap:aggDescription a owl:DatatypeProperty ; rdfs:comment "aggregate.ex:82" .
aap:aggPublic a owl:DatatypeProperty ; rdfs:comment "true|false (aggregate.ex:90)" .
aap:aggUniq a owl:DatatypeProperty ; rdfs:comment "true|false; count/list only (dsl.ex:1406,1642)" .
aap:aggIncludeNil a owl:DatatypeProperty ; rdfs:comment "true|false; first/list only (dsl.ex:1439,1647)" .
aap:aggReadAction a owl:DatatypeProperty ; rdfs:comment "aggregate.ex:45" .
aap:aggFilterable a owl:DatatypeProperty ; rdfs:comment "true|false|simple_equality (aggregate.ex:95)" .
aap:aggSortable a owl:DatatypeProperty ; rdfs:comment "true|false (aggregate.ex:100)" .
aap:aggSensitive a owl:DatatypeProperty ; rdfs:comment "true|false (aggregate.ex:105)" .
aap:aggAuthorize a owl:DatatypeProperty ; rdfs:comment "true|false (aggregate.ex:110)" .
aap:aggMultitenancy a owl:DatatypeProperty ; rdfs:comment "bypass (aggregate.ex:117)" .

# Relationship facts consumed by the path gates. Declared here minimally; dedupe with the
# relationships lane if it mints the same terms.
aap:relationship a owl:ObjectProperty ; rdfs:comment "Resource -> relationship node with aap:name and aap:destination." .
aap:destination a owl:ObjectProperty ; rdfs:comment "relationship node -> destination aap:Resource." .
