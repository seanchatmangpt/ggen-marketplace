@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# L13 vocabulary: AshStateMachine (deps/ash_state_machine/lib/ash_state_machine.ex) mapped onto
# the A2A task lifecycle (ash_a2a lib/ash_a2a/task_lifecycle.ex:29-50).
# States are IRIs minted per machine (aap:State, aap:name "submitted") so gates can run
# reachability without cross-machine contamination.

aap:StateMachine a owl:Class ;
  rdfs:comment "state_machine section of an Ash.Resource (ash_state_machine.ex:73)." .
aap:State a owl:Class ;
  rdfs:comment "A state of exactly one aap:StateMachine; aap:name is the atom." .
aap:Transition a owl:Class ;
  rdfs:comment "transition entity (ash_state_machine.ex:23-48)." .

aap:stateMachine a owl:ObjectProperty ;
  rdfs:comment "Resource -> StateMachine." .
aap:smState a owl:ObjectProperty ;
  rdfs:comment "StateMachine -> State: the declared state universe." .
aap:stateAttribute a owl:DatatypeProperty ;
  rdfs:comment "state_attribute (ash_state_machine.ex:90), default state." .
aap:initialState a owl:ObjectProperty ;
  rdfs:comment "initial_states member (ash_state_machine.ex:95, required)." .
aap:defaultInitialState a owl:ObjectProperty ;
  rdfs:comment "default_initial_state (ash_state_machine.ex:100); must be an initialState." .
aap:extraState a owl:ObjectProperty ;
  rdfs:comment "extra_states member (ash_state_machine.ex:83)." .
aap:deprecatedState a owl:ObjectProperty ;
  rdfs:comment "deprecated_states member (ash_state_machine.ex:76)." .
aap:terminalState a owl:ObjectProperty ;
  rdfs:comment "Pack-level assertion: no outgoing transitions. Not an Ash option." .
aap:a2aLifecycle a owl:DatatypeProperty ;
  rdfs:comment "true: machine is the A2A task lifecycle; names must be in AshA2A.TaskLifecycle.states/0." .

aap:smTransition a owl:ObjectProperty ;
  rdfs:comment "StateMachine -> Transition." .
aap:viaAction a owl:DatatypeProperty ;
  rdfs:comment "transition :action (ash_state_machine.ex:29); '*' = any update action." .
aap:fromState a owl:ObjectProperty ;
  rdfs:comment "transition from: member (ash_state_machine.ex:35)." .
aap:toState a owl:ObjectProperty ;
  rdfs:comment "transition to: member (ash_state_machine.ex:41)." .
aap:fromAny a owl:DatatypeProperty ;
  rdfs:comment "true: from: :*" .
aap:toAny a owl:DatatypeProperty ;
  rdfs:comment "true: to: :*" .
aap:transitionTarget a owl:ObjectProperty ;
  rdfs:comment "Emit change transition_state(target) scoped to viaAction (builtin_changes.ex:13). Requires single concrete target." .
