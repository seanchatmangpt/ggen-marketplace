@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# L21: a2a skill option `hddl_operator` (HDDL :action for deterministic planning).
# DSL evidence (ash_a2a):
#   entity + schema  lib/ash_a2a/dsl.ex:153-186 (parameters/preconditions/add_effects/delete_effects;
#                    fact = {predicate_atom, [arg_atoms]}); nested in skill dsl.ex:196
#   verifier         lib/ash_a2a/verifiers/verify_hddl_operators.ex:11-14 (<=1 operator per skill,
#                    refused_hddl_multiple_operators :35; fact args subset of parameters,
#                    refused_hddl_fact_args :61)
#   usage example    lib/ash_a2a/chicago/fixtures/brce.ex:130-149

aap:HddlOperator a owl:Class ; rdfs:comment "skill -> hddl_operator do ... end (at most one per skill)" .
aap:HddlParam    a owl:Class ; rdfs:comment "one declared operator parameter" .
aap:HddlFact     a owl:Class ; rdfs:comment "one {predicate, [args]} fact" .
aap:HddlFactArg  a owl:Class ; rdfs:comment "one argument of a fact; must name a declared parameter" .

aap:hddlOperator a owl:ObjectProperty ; rdfs:comment "Skill -> HddlOperator" .
aap:hddlParam    a owl:ObjectProperty ; rdfs:comment "HddlOperator -> HddlParam" .
aap:hddlFact     a owl:ObjectProperty ; rdfs:comment "HddlOperator -> HddlFact" .
aap:factArg      a owl:ObjectProperty ; rdfs:comment "HddlFact -> HddlFactArg" .

aap:paramName a owl:DatatypeProperty ; rdfs:comment "snake_case atom name of a parameter" .
aap:paramOrder a owl:DatatypeProperty ; rdfs:comment "integer, position in :parameters" .
aap:factRole  a owl:DatatypeProperty ; rdfs:comment "precondition | add_effect | delete_effect" .
aap:predicate a owl:DatatypeProperty ; rdfs:comment "snake_case atom name of the predicate" .
aap:factOrder a owl:DatatypeProperty ; rdfs:comment "integer, order within its role" .
aap:argName   a owl:DatatypeProperty ; rdfs:comment "parameter name referenced by the fact" .
aap:argOrder  a owl:DatatypeProperty ; rdfs:comment "integer, position in the fact's arg list" .
