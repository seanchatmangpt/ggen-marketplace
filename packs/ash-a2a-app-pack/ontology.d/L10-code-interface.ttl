@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# L10 vocabulary: code interfaces, domain config, domain-level a2a mounts.
# DSL grammar sources (deps/ash = /Users/sac/ash_a2a/deps/ash/lib/ash):
#   define               resource/interface.ex:307-384 (schema), domain/dsl.ex:95-112
#   define_calculation   resource/calculation_interface.ex:21-49, domain/dsl.ex:114-132
#   code_interface sect.  resource/dsl.ex:1126-1161 (domain, define?, namespace)
#   resource ref + defs   domain/dsl.ex:134-157 (namespace; defs merged by dedup_resources.ex:22-42)
#   execution             domain/dsl.ex:28-53 (timeout, trace_name)
#   authorization         domain/dsl.ex:55-81 (require_actor?, authorize)
#   resources opts        domain/dsl.ex:159-188 (allow, allow_unregistered?)
#   use opts              domain/domain.ex:35-47 (validate_config_inclusion?)
#   transport + mount     /Users/sac/ash_a2a/lib/ash_a2a/domain.ex:243-291, 316-380

aap:CodeInterface        a owl:Class ; rdfs:comment "A `define` entry (resource or domain level)." .
aap:CalculationInterface a owl:Class ; rdfs:comment "A `define_calculation` entry." .
aap:Mount                a owl:Class ; rdfs:comment "A domain-level a2a transport mount." .

aap:interfaceOf        a owl:ObjectProperty ; rdfs:comment "Resource-level code_interface owner (aap:Resource)." .
aap:interfaceOfDomain  a owl:ObjectProperty ; rdfs:comment "Domain-level interface owner (aap:Domain)." .
aap:forResource        a owl:ObjectProperty ; rdfs:comment "Resource a domain-level interface targets." .
aap:interfaceArgs      a owl:DatatypeProperty ; rdfs:comment "comma list; leading ? = optional arg: id,?note" .
aap:get                a owl:DatatypeProperty ; rdfs:comment "true|false -> get?:" .
aap:getBy              a owl:DatatypeProperty ; rdfs:comment "comma list of fields" .
aap:getByIdentity      a owl:DatatypeProperty .
aap:notFoundError      a owl:DatatypeProperty ; rdfs:comment "true|false -> not_found_error?:" .
aap:requireReference   a owl:DatatypeProperty ; rdfs:comment "true|false -> require_reference?:" .
aap:excludeInputs      a owl:DatatypeProperty ; rdfs:comment "comma list" .
aap:functions          a owl:DatatypeProperty ; rdfs:comment "comma subset of subject,can,can?,action,action!" .
aap:interfaceNamespace a owl:DatatypeProperty ; rdfs:comment "Elixir alias segment (e.g. Tickets)" .
aap:defaultOptions     a owl:DatatypeProperty ; rdfs:comment "raw Elixir keyword list, e.g. [load: [:x]]" .
aap:calculation        a owl:DatatypeProperty .
aap:calcArgs           a owl:DatatypeProperty ; rdfs:comment "comma list of id | arg:id | ref:id" .
aap:defineInterface    a owl:DatatypeProperty ; rdfs:comment "Resource code_interface define?: true|false" .
aap:interfaceDomain    a owl:ObjectProperty ; rdfs:comment "Resource code_interface domain: override." .
aap:resourceInterfaceNamespace a owl:DatatypeProperty ; rdfs:comment "Resource code_interface namespace:" .
aap:domainResourceNamespace    a owl:DatatypeProperty ; rdfs:comment "Domain resource-ref namespace:" .

aap:domainDescription  a owl:DatatypeProperty .
aap:domainTimeout      a owl:DatatypeProperty ; rdfs:comment "integer ms or the literal infinity" .
aap:traceName          a owl:DatatypeProperty .
aap:requireActor       a owl:DatatypeProperty ; rdfs:comment "true|false" .
aap:authorize          a owl:DatatypeProperty ; rdfs:comment "always|by_default|when_requested" .
aap:allowUnregistered  a owl:DatatypeProperty ; rdfs:comment "true|false" .
aap:validateConfigInclusion a owl:DatatypeProperty ; rdfs:comment "false -> excluded from ash_domains (host-line seam)" .

aap:mountOf            a owl:ObjectProperty ; rdfs:comment "Domain that owns the mount." .
aap:mountAgent         a owl:ObjectProperty ; rdfs:comment "aap:Agent served by the mount." .
aap:mountPath          a owl:DatatypeProperty .
aap:mountBinding       a owl:DatatypeProperty ; rdfs:comment "jsonrpc|rest|grpc" .
aap:mountTenant        a owl:DatatypeProperty .
aap:mountProtocolVersion a owl:DatatypeProperty .
