@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# L12 vocabulary: custom Ash types (enum, NewType, TypedStruct, embedded resource, union)
# and typed attributes that reference them (projected as a Spark fragment per resource).

aap:CustomType a owl:Class ;
  rdfs:comment "A generated Ash type module. aap:typeKind: enum|newtype|typed_struct|embedded|union." .
aap:TypeField a owl:Class ;
  rdfs:comment "A field of a typed_struct or embedded type (Ash.TypedStruct field / attribute)." .
aap:UnionMember a owl:Class ;
  rdfs:comment "A member of a union type (Ash.Type.Union constraints[:types] entry)." .
aap:TypedAttribute a owl:Class ;
  rdfs:comment "A resource attribute whose type is a CustomType or a builtin; emitted via fragment." .

aap:typeKind        a owl:DatatypeProperty .
aap:typeFile        a owl:DatatypeProperty ; rdfs:comment "file stem under lib/<appPath>/types/" .
aap:subtypeOf       a owl:DatatypeProperty ; rdfs:comment "newtype: Ash type atom, e.g. string, map (no colon)" .
aap:typeConstraints a owl:DatatypeProperty ; rdfs:comment "Elixir keyword-list literal, e.g. [max_length: 80]" .
aap:enumValue       a owl:DatatypeProperty ; rdfs:comment "atom name of an Ash.Type.Enum value (repeatable)" .
aap:typeField       a owl:ObjectProperty .
aap:unionMember     a owl:ObjectProperty .
aap:typedAttribute  a owl:ObjectProperty .
aap:typeRef         a owl:ObjectProperty ; rdfs:comment "points at an aap:CustomType" .
aap:allowNil        a owl:DatatypeProperty ; rdfs:comment "true|false" .
aap:isArray         a owl:DatatypeProperty ; rdfs:comment "true|false: wrap type in {:array, t}" .
aap:defaultValue    a owl:DatatypeProperty ; rdfs:comment "Elixir term literal" .
aap:unionStorage    a owl:DatatypeProperty ; rdfs:comment "type_and_value|map_with_tag" .
aap:unionTag        a owl:DatatypeProperty .
aap:unionTagValue   a owl:DatatypeProperty ; rdfs:comment "Elixir term literal" .
aap:a2aExposed      a owl:DatatypeProperty ; rdfs:comment "false opts a field out of the serializability gate" .
