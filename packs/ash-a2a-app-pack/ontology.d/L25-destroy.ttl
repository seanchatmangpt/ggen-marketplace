@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# L25: destroy actions (deps/ash/lib/ash/resource/actions/destroy.ex:66-115).
# Emitted in Spark fragment <Resource>.L25Destroy. Action names must not collide with
# actions from resource.ex.tmpl or L06.

aap:L25Destroy a owl:Class ; rdfs:comment "Destroy action emitted in the L25 fragment." .
aap:l25Destroy a owl:ObjectProperty ; rdfs:domain aap:Resource ; rdfs:range aap:L25Destroy .

aap:l25Primary a owl:DatatypeProperty ;
  rdfs:comment "primary? true|false (shared_options.ex:14). At most one true per resource." .
aap:l25Accept a owl:DatatypeProperty ;
  rdfs:comment "comma list of attributes; destroy.ex:112-115 create/update opts, legal only when soft or manual." .
aap:l25RequireAtomic a owl:DatatypeProperty ;
  rdfs:comment "require_atomic? true|false (destroy.ex:87); relevant only when soft?; manual forces false (destroy.ex:120)." .
aap:l25Soft a owl:DatatypeProperty ;
  rdfs:comment "soft? true|false (destroy.ex:67)." .
aap:l25Manual a owl:DatatypeProperty ;
  rdfs:comment "moduleName of an Ash.Resource.ManualDestroy implementation (destroy.ex:72)." .
aap:l25TimestampAttribute a owl:DatatypeProperty ;
  rdfs:comment "Attribute name stamped with DateTime.utc_now on soft destroy; required when l25Soft true." .
