@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# L11 vocabulary: Ash.Notifier.PubSub, custom notifiers, A2A TaskEvents bridge.
# DSL grammar: deps/ash/lib/ash/notifier/pub_sub/pub_sub.ex:63-99 (section schema),
# publication.ex:26-95 (publication schema), notifier/notifier.ex:9 (notify/1 callback).

aap:PubSub      a owl:Class ; rdfs:comment "pub_sub do ... end section of a resource (Ash.Notifier.PubSub)." .
aap:Publication a owl:Class ; rdfs:comment "publish / publish_all entity inside pub_sub." .
aap:PubSubServer a owl:Class ; rdfs:comment "A Phoenix.PubSub instance started in the app supervision tree." .
aap:Notifier    a owl:Class ; rdfs:comment "A custom Ash.Notifier module (generated)." .
aap:A2ABridge   a owl:Class ; rdfs:comment "Maps an action's notification to AshA2A TaskEvents.publish/6." .
aap:Delegate    a owl:Class ; rdfs:comment "Forwards a notification to a hand-owned module's notify/1." .

# resource -> sections
aap:pubSub   a owl:ObjectProperty ; rdfs:comment "Resource -> aap:PubSub (at most one)." .
aap:publication a owl:ObjectProperty ; rdfs:comment "aap:PubSub -> aap:Publication." .
aap:notifier a owl:ObjectProperty ; rdfs:comment "Resource -> aap:Notifier (generated simple notifier)." .
aap:simpleNotifier a owl:DatatypeProperty ; rdfs:comment "Resource -> existing notifier module name (no DSL); coordinator adds to simple_notifiers:." .
aap:bridge   a owl:ObjectProperty ; rdfs:comment "aap:Notifier -> aap:A2ABridge." .
aap:delegate a owl:ObjectProperty ; rdfs:comment "aap:Notifier -> aap:Delegate." .

# pub_sub section options (pub_sub.ex:64-98)
aap:pubSubModule        a owl:DatatypeProperty ; rdfs:comment "module (required), e.g. Phoenix.PubSub or an Endpoint." .
aap:pubSubName          a owl:DatatypeProperty ; rdfs:comment "name: named pub sub passed as first broadcast arg." .
aap:pubSubPrefix        a owl:DatatypeProperty ; rdfs:comment "prefix string." .
aap:pubSubDelimiter     a owl:DatatypeProperty ; rdfs:comment "delimiter string." .
aap:broadcastType       a owl:DatatypeProperty ; rdfs:comment "notification|phoenix_broadcast|broadcast." .
aap:pubSubFilterFn      a owl:DatatypeProperty ; rdfs:comment "Remote capture Mod.fun (arity 1), emitted as &Mod.fun/1." .
aap:pubSubTransformFn   a owl:DatatypeProperty ; rdfs:comment "Remote capture Mod.fun (arity 1)." .

# publication options (publication.ex:26-83)
aap:pubAction   a owl:DatatypeProperty ; rdfs:comment "publish: action name. Mutually exclusive with pubType." .
aap:pubType     a owl:DatatypeProperty ; rdfs:comment "publish_all: create|update|destroy." .
aap:pubEvent    a owl:DatatypeProperty ; rdfs:comment "event name (string)." .
aap:pubTopic    a owl:DatatypeProperty ; rdfs:comment "Comma-separated topic parts; ':x' is an attribute atom, else a string. e.g. 'updated,:_pkey'." .
aap:pubTopicTerm a owl:DatatypeProperty ; rdfs:comment "Raw Elixir topic term (nested alternatives); overrides pubTopic." .
aap:pubExcept   a owl:DatatypeProperty ; rdfs:comment "publish_all except: comma-separated action names." .
aap:previousValues a owl:DatatypeProperty ; rdfs:comment "previous_values? true|false." .
aap:pubLoad     a owl:DatatypeProperty ; rdfs:comment "Raw Elixir load statement." .
aap:pubFilterFn a owl:DatatypeProperty ; rdfs:comment "Remote capture Mod.fun (arity 1)." .
aap:pubTransformFn a owl:DatatypeProperty ; rdfs:comment "Remote capture Mod.fun/1, OR a calculation name when pubTransformCalc true." .
aap:pubTransformCalc a owl:DatatypeProperty ; rdfs:comment "true: pubTransformFn is a calculation atom." .
aap:pubPublic   a owl:DatatypeProperty ; rdfs:comment "public? true|false." .
aap:pubDispatcher a owl:DatatypeProperty ; rdfs:comment "dispatcher module." .
aap:pubReturns  a owl:DatatypeProperty ; rdfs:comment "returns Ash.Type atom (requires transform)." .

# pubsub server
aap:serverName a owl:DatatypeProperty ; rdfs:comment "Phoenix.PubSub name module." .
aap:serverFile a owl:DatatypeProperty .
aap:serverModule a owl:DatatypeProperty ; rdfs:comment "Generated module exposing children/0." .

# notifier / bridge
aap:notifierFile a owl:DatatypeProperty .
aap:bridgeAction a owl:DatatypeProperty ; rdfs:comment "Action name whose notification is bridged." .
aap:bridgeKind a owl:DatatypeProperty ; rdfs:comment "TaskEvents kind: task|status-update|artifact-update|message-update." .
aap:bridgeTaskIdField a owl:DatatypeProperty ; rdfs:comment "Attribute of notification.data holding the A2A task id." .
aap:bridgeFinal a owl:DatatypeProperty ; rdfs:comment "final? flag true|false." .
aap:bridgeTransport a owl:DatatypeProperty ; rdfs:comment "Transport atom module; default AshA2A.A2ATransport." .
aap:delegateAction a owl:DatatypeProperty ; rdfs:comment "Action name forwarded; absent = all actions." .
aap:delegateModule a owl:DatatypeProperty ; rdfs:comment "Module implementing notify/1." .
