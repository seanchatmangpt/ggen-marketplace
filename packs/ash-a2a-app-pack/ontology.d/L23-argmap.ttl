@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix aap:  <https://ggen.dev/ash-a2a-app#> .

# L23: argument_mapping on the plain aap:Skill (L17 covers only aap:SkillSpec via aap:argMapping).
# DSL: /Users/sac/ash_a2a/lib/ash_a2a/dsl.ex:73-81 (argument_mapping, type {:map, :string, :atom}, default %{})
# Verifier refusal: /Users/sac/ash_a2a/lib/ash_a2a/verifiers/verify_skills.ex:373-397
#   (refused_argument_mapping_target; real names = declared arguments U accept, :399-411)
# Runtime: /Users/sac/ash_a2a/lib/ash_a2a/executor.ex:242-256 ; schema: lib/ash_a2a/schema.ex:119-140
# Reuses aap:ArgMapping, aap:wireName, aap:targetArg (L17), aap:actionArgument/aap:argName (L17).

aap:skillArgMap a owl:ObjectProperty ;
  rdfs:domain aap:Skill ; rdfs:range aap:ArgMapping ;
  rdfs:comment "L23: aap:Skill -> aap:ArgMapping (wire name => action argument/accepted attribute). Disjoint from L17 aap:argMapping, which hangs off aap:SkillSpec." .
