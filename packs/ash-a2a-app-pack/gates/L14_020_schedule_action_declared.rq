# Gate L14: a scheduled action must name a declared action of type create or action (generic);
# AshOban schedule supports generic and create only (ash_oban.ex:585-588, 675-679).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?schedule ?action WHERE {
  ?r a aap:Resource ; aap:obSchedule ?schedule .
  ?schedule aap:obAction ?action .
  FILTER NOT EXISTS {
    ?r aap:action ?a . ?a aap:name ?n ; aap:actionType ?t .
    FILTER(STR(?n) = STR(?action) && STR(?t) IN ("create", "action"))
  }
}
