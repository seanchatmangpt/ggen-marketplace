# Gate L20_047: two Resources in one domain share a resourceFile (generated lib path collides), or two
# court cases share a caseFile within a class (test file collides). Rows = violation.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?a ?b ?file WHERE {
  {
    ?a a aap:Resource ; aap:inDomain ?d ; aap:resourceFile ?file .
    ?b a aap:Resource ; aap:inDomain ?d ; aap:resourceFile ?file .
    FILTER(STR(?a) < STR(?b))
  } UNION {
    ?a a ?k ; aap:caseFile ?file .
    ?b a ?k ; aap:caseFile ?file .
    FILTER(?k IN (aap:ReactorCase, aap:PlanCase))
    FILTER(STR(?a) < STR(?b))
  }
}
