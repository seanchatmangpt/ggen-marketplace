# Gate: every skill must name an action declared on the same resource. Rows = violation.
# Action sources (matched on aap:name, string-compared):
#   aap:action (legacy) | aap:manage (L02) | aap:l06Action (L06) | aap:reactorAction (L15)
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?skill WHERE {
  ?resource a aap:Resource ; aap:skill ?skill . ?skill aap:ofAction ?an .
  FILTER NOT EXISTS {
    ?resource aap:action|aap:manage|aap:l06Action|aap:reactorAction ?a .
    ?a aap:name ?n .
    FILTER (STR(?n) = STR(?an))
  }
}
