# L16 gate: a task whose capability no provider binds is unsatisfiable (violation = row).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?task ?capability WHERE {
  ?w a aap:PPlanWorkflow ; aap:ppTask ?task . ?task aap:ppCapability ?capability .
  FILTER NOT EXISTS { ?p a aap:PPlanProvider ; aap:ppBinding ?b . ?b aap:ppCapability ?capability }
}
