# Gate L18: entity without name/structModule/fields, field without type, or entity outside a section.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?node WHERE {
  { ?node a aap:SparkEntity .
    FILTER (NOT EXISTS { ?node aap:name ?n } || NOT EXISTS { ?node aap:structModule ?m }
            || NOT EXISTS { ?node aap:sparkField ?f } || NOT EXISTS { ?s aap:sparkEntity ?node }) }
  UNION
  { ?node a aap:SparkField . FILTER (NOT EXISTS { ?node aap:name ?n } || NOT EXISTS { ?node aap:sparkType ?t }) }
}
