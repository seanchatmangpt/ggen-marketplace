# Gate: reference on_delete / on_update must be a value the data layer accepts.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?reference ?value WHERE {
  { ?reference aap:onDelete ?value FILTER(?value NOT IN ("nothing", "restrict", "delete", "nilify")) }
  UNION
  { ?reference aap:onUpdate ?value FILTER(?value NOT IN ("nothing", "restrict", "update", "nilify")) }
}
