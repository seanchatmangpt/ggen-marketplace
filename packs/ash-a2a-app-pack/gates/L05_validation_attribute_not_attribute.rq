# Gate L05: attribute-strict validation kinds must target a declared aap:attribute.
# present/absent/argument_*/confirm/raw may legitimately name arguments, so they are exempt.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?validation ?target WHERE {
  ?resource a aap:Resource ; aap:validation ?validation .
  ?validation aap:validationKind ?kind ; aap:vAttribute ?target .
  FILTER (STR(?kind) IN ("match","compare","numericality","one_of","string_length",
    "attribute_equals","attribute_does_not_equal","attribute_in","changing"))
  FILTER NOT EXISTS { ?resource aap:attribute ?a . ?a aap:name ?n . FILTER (STR(?n) = STR(?target)) }
}
