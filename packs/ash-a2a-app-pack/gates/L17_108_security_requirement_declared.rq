# L17 gate (mirrors verify_skills.ex:233-257 refused_security_requirement_undeclared).
# The verifier only sees domain schemes for domain subjects; the pack knows the domain, so it is checked
# here for resource skill specs too. Each requirement scheme must be a security_scheme of the resource's domain.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?scheme ?reason WHERE {
  ?r a aap:Resource ; aap:inDomain ?d ; aap:skillSpec ?subject .
  ?subject aap:secRequirement ?q .
  ?q aap:secScheme ?scheme .
  FILTER NOT EXISTS { ?d aap:securityScheme ?ss . ?ss aap:schemeName ?scheme }
  BIND ("refused_security_requirement_undeclared" AS ?reason)
}
