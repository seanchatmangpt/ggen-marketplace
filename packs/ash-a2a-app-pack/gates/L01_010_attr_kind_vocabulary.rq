# L01 gate: aap:attrKind must be one of the six Ash attribute entities (dsl.ex:36-186).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?spec ?kind WHERE {
  ?spec aap:attrKind ?kind .
  FILTER (?kind NOT IN ("attribute","create_timestamp","update_timestamp",
                        "uuid_primary_key","uuid_v7_primary_key","integer_primary_key"))
}
