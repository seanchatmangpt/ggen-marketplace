# Gate L20_040: an attribute ashType outside the known Ash builtin type names (rows = violation).
# Use aap:ashTypeModule (L01) for custom modules instead. Builtins: deps/ash/lib/ash/type/type.ex short_names.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?attribute ?ash_type WHERE {
  ?r a aap:Resource ; aap:attribute ?attribute .
  ?attribute aap:ashType ?ash_type .
  FILTER(?ash_type NOT IN ("uuid","uuid_v7","string","ci_string","integer","float","decimal","boolean",
    "atom","map","keyword","term","binary","date","time","time_usec","datetime","utc_datetime",
    "utc_datetime_usec","naive_datetime","duration","duration_name","module","function","struct",
    "tuple","union","regex","url_encoded_binary","file","vector"))
}
