# Gate L28_020: two distinct aap:Resource nodes share one aap:moduleName (the second file/module
# silently overwrites the first). Rows = violation. Resource-scoped subset of L20_041, which
# additionally covers Domain/Agent/other nodes; this gate names the colliding resources only.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?a ?b ?module_name WHERE {
  ?a a aap:Resource ; aap:moduleName ?module_name .
  ?b a aap:Resource ; aap:moduleName ?module_name .
  FILTER(STR(?a) < STR(?b))
}
