# L01 gate: timestamp / primary-key entities accept only :name (attribute.ex hide_all_except
# [:name]); any other option on such a spec would be silently dropped => violation.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?spec ?kind ?prop WHERE {
  ?spec aap:attrKind ?kind .
  FILTER (?kind != "attribute")
  ?spec ?prop ?o .
  FILTER (?prop NOT IN (aap:name, aap:attrKind, aap:attrOrder, <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>))
}
