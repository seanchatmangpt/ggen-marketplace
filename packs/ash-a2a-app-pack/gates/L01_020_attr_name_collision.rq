# L01 gate: an aap:attrSpec name must not duplicate a legacy aap:attribute name or another spec
# on the same resource (duplicate attribute => Ash compile error).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?name WHERE {
  ?resource aap:attrSpec ?s1 .
  ?s1 aap:name ?name .
  {
    ?resource aap:attribute ?a . ?a aap:name ?name .
  } UNION {
    ?resource aap:attrSpec ?s2 . ?s2 aap:name ?name . FILTER (?s1 != ?s2)
  }
}
