# Gate: postgres/sqlite resources must declare a repo and a table.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?layer WHERE {
  ?resource a aap:Resource ; aap:dataLayer ?layer .
  FILTER(?layer IN ("postgres", "sqlite"))
  FILTER(NOT EXISTS { ?resource aap:repo ?r } || NOT EXISTS { ?resource aap:tableName ?t })
}
