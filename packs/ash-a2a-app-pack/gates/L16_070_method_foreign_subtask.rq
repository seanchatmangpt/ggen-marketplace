# L16 gate: method refines or lists a task not declared in the same workflow
# (model.ex:222-229 {:unknown_method_subtasks,_}).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?method ?task WHERE {
  ?w a aap:PPlanWorkflow ; aap:ppMethod ?method .
  {
    ?method aap:ppRefines ?task .
  } UNION {
    ?method aap:ppStepOf ?s . ?s aap:ppStepTask ?task .
  }
  FILTER NOT EXISTS { ?w aap:ppTask ?task }
}
