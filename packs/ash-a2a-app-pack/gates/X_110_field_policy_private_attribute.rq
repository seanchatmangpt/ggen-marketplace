# Gate: Ash field policies only support public, non-primary-key attributes (and calculations/
# aggregates); a field policy naming an attribute declared public "false" is a compile error
# (AddMissingFieldPolicies.ensure_field_coverage/2, witnessed on /tmp/a2a_full).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?field ?reason WHERE {
  ?resource a aap:Resource ; aap:fieldPolicy ?fp ; aap:attrSpec ?a .
  ?fp aap:fields ?fields .
  ?a aap:name ?field ; aap:public "false" .
  FILTER(CONTAINS(CONCAT(",", REPLACE(STR(?fields), " ", ""), ","), CONCAT(",", STR(?field), ",")))
  BIND("field policy references a non-public attribute" AS ?reason)
}
