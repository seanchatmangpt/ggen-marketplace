# L01 gate: a plain attribute needs exactly one type source (atom | module | enum | array form).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?spec WHERE {
  ?spec a aap:AttributeSpec .
  FILTER NOT EXISTS { ?spec aap:attrKind ?k . FILTER (?k != "attribute") }
  {
    FILTER NOT EXISTS { ?spec aap:ashType|aap:ashTypeModule|aap:ashTypeEnum|aap:arrayOf|aap:arrayOfModule|aap:arrayOfEnum ?t }
  } UNION {
    ?spec aap:ashType ?t1 . ?spec aap:ashTypeModule|aap:ashTypeEnum|aap:arrayOf|aap:arrayOfModule|aap:arrayOfEnum ?t2 .
  } UNION {
    ?spec aap:ashTypeModule|aap:ashTypeEnum ?t1 . ?spec aap:arrayOf|aap:arrayOfModule|aap:arrayOfEnum ?t2 .
  }
}
