# Gate L14: chunks require Oban Pro (ash_oban.ex:164); a Project with chunked triggers must
# declare aap:obPro "true" on its ObanConfig.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?trigger WHERE {
  ?trigger aap:obChunks ?c .
  FILTER NOT EXISTS { ?cfg a aap:ObanConfig ; aap:obPro "true" }
}
