# Gate L05: every aap:identityKey must name an aap:attribute of the same resource.
# Rows = violations. Caveat: attributes contributed by other lanes (e.g. belongs_to
# generated *_id) must also be declared as aap:attribute to satisfy this gate.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?identity ?key WHERE {
  ?resource a aap:Resource ; aap:identity ?identity .
  ?identity aap:identityKey ?key .
  FILTER NOT EXISTS { ?resource aap:attribute ?a . ?a aap:name ?n . FILTER (STR(?n) = STR(?key)) }
}
