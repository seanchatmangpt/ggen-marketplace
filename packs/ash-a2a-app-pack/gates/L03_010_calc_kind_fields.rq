# Gate L03: every calculation needs a valid calcKind and the fields that kind requires.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?calc WHERE {
  ?calc a aap:Calculation ; aap:calcKind ?k .
  FILTER (
    !(?k IN ("expr", "concat", "module"))
    || (?k = "expr" && NOT EXISTS { ?calc aap:expression ?e })
    || (?k = "concat" && NOT EXISTS { ?calc aap:calcKeys ?ck })
    || (?k = "module" && (NOT EXISTS { ?calc aap:calcKeys ?mk } || NOT EXISTS { ?calc aap:calcModule ?m } || NOT EXISTS { ?calc aap:calcFile ?f }))
  )
}
