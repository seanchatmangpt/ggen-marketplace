# Gate: repo/indexes/references/checks/statements/schema only on postgres or sqlite resources.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?layer ?prop WHERE {
  ?resource a aap:Resource ; ?prop ?o .
  VALUES ?prop { aap:repo aap:customIndex aap:reference aap:checkConstraint aap:statement
                 aap:pgSchema aap:migrate aap:baseFilterSql aap:skipUniqueIndexes aap:sqliteStrict }
  OPTIONAL { ?resource aap:dataLayer ?l }
  BIND(COALESCE(?l, "unset") AS ?layer)
  FILTER(?layer NOT IN ("postgres", "sqlite"))
}
