# L17 gate (mirrors domain/verifiers/verify_mounts.ex:38-188): path shape, uniqueness, prefix overlap,
# agent+binding uniqueness, agent exists as aap:Agent. Plus the pack-level compile-order law: a mounted
# agent must not wrap the mounting domain (agent compiles against the domain; the domain verifier
# Code.ensure_compiled's the agent -> deadlock).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?reason WHERE {
  {
    ?d aap:mount ?subject . ?subject aap:mountPath ?p .
    FILTER ( !STRSTARTS(STR(?p), "/") )
    BIND ("mount_path_must_start_with_slash" AS ?reason)
  }
  UNION
  {
    ?d aap:mount ?subject , ?other . ?subject aap:mountPath ?p . ?other aap:mountPath ?p .
    FILTER (?subject != ?other)
    BIND ("mount_path_declared_more_than_once" AS ?reason)
  }
  UNION
  {
    ?d aap:mount ?subject , ?other . ?subject aap:mountPath ?p1 . ?other aap:mountPath ?p2 .
    FILTER ( STR(?p1) != STR(?p2) && STR(?p1) != "/" && STRSTARTS(STR(?p2), CONCAT(STR(?p1), "/")) )
    BIND ("mount_path_is_prefix_of_another_mount" AS ?reason)
  }
  UNION
  {
    ?d aap:mount ?subject , ?other . ?subject aap:mountAgent ?a . ?other aap:mountAgent ?a .
    OPTIONAL { ?subject aap:mountBinding ?b1 } OPTIONAL { ?other aap:mountBinding ?b2 }
    FILTER (?subject != ?other)
    FILTER ( COALESCE(STR(?b1), "jsonrpc") = COALESCE(STR(?b2), "jsonrpc") )
    BIND ("agent_mounted_more_than_once_over_same_binding" AS ?reason)
  }
  UNION
  {
    ?d aap:mount ?subject . ?subject aap:mountBinding ?b .
    FILTER ( !(STR(?b) IN ("jsonrpc", "rest", "grpc")) )
    BIND ("mount_binding_not_in_jsonrpc_rest_grpc" AS ?reason)
  }
  UNION
  {
    ?d aap:mount ?subject . ?subject aap:mountAgent ?a .
    FILTER NOT EXISTS { ?a a aap:Agent }
    BIND ("mount_agent_is_not_a_declared_aap_Agent" AS ?reason)
  }
  UNION
  {
    ?d aap:mount ?subject . ?subject aap:mountAgent ?a . ?a aap:forDomain ?d .
    BIND ("mount_agent_wraps_mounting_domain_compile_order_deadlock" AS ?reason)
  }
  UNION
  {
    ?d aap:mount ?subject .
    FILTER NOT EXISTS { ?subject aap:mountAgent ?a }
    BIND ("mount_requires_agent" AS ?reason)
  }
  UNION
  {
    ?d aap:mount ?subject .
    FILTER NOT EXISTS { ?subject aap:mountPath ?p }
    BIND ("mount_requires_path" AS ?reason)
  }
}
