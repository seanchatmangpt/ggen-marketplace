# Gate: a many_to_many join resource needs a primary destroy action (Ash manage_relationship
# raises "Required primary destroy action" at runtime/verify).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?join WHERE {
  ?resource a aap:Resource ; aap:relationship ?r .
  ?r aap:relKind "many_to_many" ; aap:through ?join .
  FILTER NOT EXISTS { ?join aap:action ?a . ?a aap:actionType "destroy" }
}
