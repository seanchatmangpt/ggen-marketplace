# L01 gate: attribute that is allow_nil? false, not writable, with no default and not generated
# can never be satisfied on create.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?spec WHERE {
  ?spec aap:allowNil "false" ; aap:writable "false" .
  FILTER NOT EXISTS { ?spec aap:defaultExpr ?d }
  FILTER NOT EXISTS { ?spec aap:generated "true" }
}
