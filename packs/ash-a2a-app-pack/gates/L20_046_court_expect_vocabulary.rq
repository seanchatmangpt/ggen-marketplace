# Gate L20_046: caseExpect outside the vocabulary of its case class, or dispatchExpect outside its set.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?case ?expect WHERE {
  {
    ?case a aap:PolicyCase ; aap:caseExpect ?expect .
    FILTER(?expect NOT IN ("allow","deny"))
  } UNION {
    ?case a aap:TransitionCase ; aap:caseExpect ?expect .
    FILTER(?expect NOT IN ("ok","error"))
  } UNION {
    ?case a aap:PlanCase ; aap:caseExpect ?expect .
    FILTER(?expect NOT IN ("satisfiable","unsatisfiable"))
  } UNION {
    ?case a aap:Skill ; aap:dispatchExpect ?expect .
    FILTER(?expect NOT IN ("reply","input_required","auth_required","error","typed"))
  }
}
