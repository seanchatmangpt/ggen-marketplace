# L16 gate: a task requires an evidence kind no provider binding its capability emits
# (providers/qualify.ex:38 -> {:missing_evidence,_}).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?task ?capability ?ev WHERE {
  ?w a aap:PPlanWorkflow ; aap:ppTask ?task .
  ?task aap:ppCapability ?capability ; aap:ppEvidenceKind ?ev .
  FILTER NOT EXISTS {
    ?p a aap:PPlanProvider ; aap:ppBinding ?b ; aap:ppProvidesEvidence ?ev .
    ?b aap:ppCapability ?capability
  }
}
