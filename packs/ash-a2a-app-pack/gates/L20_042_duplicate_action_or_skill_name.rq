# Gate L20_042: duplicate action name on one resource, or duplicate skill name within one domain
# (skill names are the a2a wire identity; duplicates shadow each other). Rows = violation.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?a ?b ?name WHERE {
  {
    ?r a aap:Resource ; aap:action ?a , ?b .
    ?a aap:name ?name . ?b aap:name ?name .
    FILTER(STR(?a) < STR(?b))
  } UNION {
    ?r1 a aap:Resource ; aap:inDomain ?d ; aap:skill ?a .
    ?r2 a aap:Resource ; aap:inDomain ?d ; aap:skill ?b .
    ?a aap:name ?name . ?b aap:name ?name .
    FILTER(STR(?a) < STR(?b))
  }
}
