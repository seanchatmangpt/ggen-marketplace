# L16 gate: unsatisfiable precondition. A task requires an execution property that no
# provider binding its capability offers (providers/qualify.ex:35 -> {:missing_properties,_}).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?task ?capability ?prop WHERE {
  ?w a aap:PPlanWorkflow ; aap:ppTask ?task .
  ?task aap:ppCapability ?capability ; aap:ppProperty ?prop .
  FILTER NOT EXISTS {
    ?p a aap:PPlanProvider ; aap:ppBinding ?b ; aap:ppProvidesProperty ?prop .
    ?b aap:ppCapability ?capability
  }
}
