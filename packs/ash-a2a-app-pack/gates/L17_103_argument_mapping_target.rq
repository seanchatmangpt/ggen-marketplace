# L17 gate (mirrors verify_skills.ex:373-411 refused_argument_mapping_target).
# Every argument_mapping target must be a declared action argument or an accepted attribute.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?target ?reason WHERE {
  ?r a aap:Resource ; aap:skillSpec ?subject ; aap:action ?a .
  ?subject aap:specAction ?an ; aap:argMapping ?m .
  ?a aap:name ?an .
  ?m aap:targetArg ?target .
  OPTIONAL { ?a aap:accept ?acc }
  FILTER NOT EXISTS { ?a aap:actionArgument ?x . ?x aap:argName ?target }
  FILTER ( !BOUND(?acc) || !CONTAINS(CONCAT(",", REPLACE(?acc, " ", ""), ","), CONCAT(",", ?target, ",")) )
  BIND ("refused_argument_mapping_target" AS ?reason)
}
