# L17 gate: string-typed L17 values are emitted as Elixir double-quoted strings. json_encode escapes quotes
# and backslashes but NOT "#{", which Elixir would interpolate. Raw-Elixir properties are exempt (L17_112).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?property ?reason WHERE {
  ?subject ?property ?value .
  FILTER ( ISLITERAL(?value) && STRSTARTS(STR(?property), "https://ggen.dev/ash-a2a-app#") )
  FILTER ( CONTAINS(STR(?value), "#{") )
  FILTER ( ?property NOT IN (aap:expression, aap:onCancel, aap:extParams, aap:oauthFlows, aap:default,
                             aap:constraints, aap:endpointExtendedCard, aap:execEventsTransport, aap:ashA2aDep) )
  BIND ("string_contains_interpolation" AS ?reason)
}
