# Gate L06: an update/destroy action using a hook-module step (module op) must set
# require_atomic? "false" (hooks have no atomic/3 callback; Ash default is true).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?action WHERE {
  ?action a aap:L06Action ; aap:actionType ?t ; aap:l06Step ?s .
  ?s aap:l06Op "module" .
  FILTER (?t IN ("update", "destroy"))
  FILTER NOT EXISTS { ?action aap:l06RequireAtomic "false" }
}
