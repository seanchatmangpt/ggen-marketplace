# L17 gate (mirrors verify_skills.ex:200-225 refused_mode_not_mime; regex is the verifier's @mime_regex).
# Applied to per-skill input/output modes and to domain card default modes (stricter than the verifier).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?mode ?reason WHERE {
  ?subject aap:inputMode|aap:outputMode|aap:cardInputMode|aap:cardOutputMode ?mode .
  FILTER ( !REGEX(STR(?mode), "^(\\*|[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*)/(\\*|[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*)(\\s*;\\s*[^;\\s=]+=[^;]+)*$") )
  BIND ("refused_mode_not_mime" AS ?reason)
}
