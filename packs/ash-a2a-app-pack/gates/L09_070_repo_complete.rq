# Gate: every aap:Repo needs kind in (postgres|sqlite) and a repoFile; project needs setupAppPath.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?repo WHERE {
  ?repo a aap:Repo .
  FILTER(NOT EXISTS { ?repo aap:repoKind ?k . FILTER(?k IN ("postgres", "sqlite")) }
      || NOT EXISTS { ?repo aap:repoFile ?f }
      || NOT EXISTS { ?repo aap:moduleName ?m }
      || NOT EXISTS { ?p a aap:Project ; aap:setupAppPath ?s })
}
