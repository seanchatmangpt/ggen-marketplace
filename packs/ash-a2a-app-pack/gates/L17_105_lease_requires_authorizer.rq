# L17 gate (mirrors verify_skills.ex:487-508 refused_lease_required_no_authorizer).
# lease_required? true on any skill (aap:Skill or aap:SkillSpec) needs an authorizer on the resource
# (aap:authorizer -> `authorizers:` on the L17 resource fragment).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?reason WHERE {
  ?r a aap:Resource ; aap:skill|aap:skillSpec ?subject .
  ?subject aap:leaseRequired "true" .
  FILTER NOT EXISTS { ?r aap:authorizer ?z }
  BIND ("refused_lease_required_no_authorizer" AS ?reason)
}
