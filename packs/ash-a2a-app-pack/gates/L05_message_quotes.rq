# Gate L05: messages/descriptions are emitted inside "..." unescaped; forbid quotes and backslashes.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?text WHERE {
  ?subject ?p ?text .
  ?s2 (aap:identity|aap:validation) ?subject .
  FILTER (?p IN (aap:message, aap:description))
  FILTER (CONTAINS(STR(?text), "\"") || CONTAINS(STR(?text), "\\"))
}
