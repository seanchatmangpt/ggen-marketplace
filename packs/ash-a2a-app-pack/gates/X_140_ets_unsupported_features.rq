# Gate: features the ETS data layer cannot honor: transaction?(true) actions; identities with
# no pre_check_with (RequirePreCheckWith).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?item ?reason WHERE {
  ?resource a aap:Resource ; aap:dataLayer "ets" .
  { ?resource aap:l06Action ?item . ?item aap:l06Transaction "true"
    BIND("ETS does not support transactions" AS ?reason) }
  UNION
  { ?resource aap:identity ?item . FILTER NOT EXISTS { ?item aap:preCheckWith ?pc }
    BIND("identity on ETS needs aap:preCheckWith" AS ?reason) }
}
