# L19 gate: app and agent names are interpolated into EA ids unescaped; they must be id-safe.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?name WHERE {
  { ?a a aap:Agent ; aap:agentName ?name } UNION { ?p a aap:Project ; aap:appName ?name }
  FILTER (!REGEX(STR(?name), "^[A-Za-z0-9_.-]+$"))
}
