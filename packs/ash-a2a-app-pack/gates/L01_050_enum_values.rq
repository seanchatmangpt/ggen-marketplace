# L01 gate: enum with zero values, or duplicate value names within one enum.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?enum ?name WHERE {
  {
    ?enum a aap:EnumType .
    FILTER NOT EXISTS { ?enum aap:enumValue ?v }
    BIND("" AS ?name)
  } UNION {
    ?enum aap:enumValue ?v1, ?v2 .
    ?v1 aap:name ?name . ?v2 aap:name ?name .
    FILTER (?v1 != ?v2)
  }
}
