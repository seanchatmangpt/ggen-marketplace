# Gate L22-020: aap:authorityGate must be two_port|open|disabled (dsl.ex:233); and a resource whose
# gate is "disabled" must not carry a lease-required skill (dispatcher refuses every
# consequence-bearing skill with :authority_gate_disabled, dsl.ex:236-238).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?gate ?skill WHERE {
  ?resource a aap:Resource ; aap:authorityGate ?gate .
  OPTIONAL { ?resource aap:skill ?skill . ?skill aap:leaseRequired "true" }
  FILTER (
    !(?gate IN ("two_port", "open", "disabled"))
    || (?gate = "disabled" && BOUND(?skill))
  )
}
