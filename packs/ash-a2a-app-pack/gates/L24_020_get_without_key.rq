# Gate L24_020: a get? read must declare a key: aap:getByKey, or aap:getIdentity resolving to an
# aap:Identity of the owning resource that has at least one aap:identityKey.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?action ?why WHERE {
  ?r a aap:Resource ; aap:l24Read ?action .
  ?action aap:l24Get "true" ; aap:actionType "read" .
  FILTER NOT EXISTS { ?action aap:getByKey ?k }
  FILTER NOT EXISTS {
    ?action aap:getIdentity ?iname .
    ?r aap:identity ?i . ?i aap:name ?iname ; aap:identityKey ?ik .
  }
  BIND("get? read has no get_by key and no resolvable identity" AS ?why)
}
