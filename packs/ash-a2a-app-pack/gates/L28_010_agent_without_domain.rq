# Gate L28_010: an aap:Agent with no domain (neither aap:forDomain nor aap:inDomain) wraps nothing
# and projects an agent with zero skills. Rows = violation.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?agent ?module_name WHERE {
  ?agent a aap:Agent .
  OPTIONAL { ?agent aap:moduleName ?mn }
  BIND(COALESCE(?mn, "") AS ?module_name)
  FILTER NOT EXISTS { ?agent aap:forDomain|aap:inDomain ?d }
}
