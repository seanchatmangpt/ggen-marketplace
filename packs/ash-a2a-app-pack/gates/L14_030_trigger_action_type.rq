# Gate L14: a trigger action must be an update or destroy action (record trigger).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?trigger ?action ?type WHERE {
  ?r a aap:Resource ; aap:obTrigger ?trigger .
  ?trigger aap:obAction ?action .
  ?r aap:action ?a . ?a aap:name ?n ; aap:actionType ?type .
  FILTER(STR(?n) = STR(?action) && !(STR(?type) IN ("update", "destroy")))
}
