# Gate L03: calculations without a name, type, or kind are violations; calc without owning resource too.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?calc WHERE {
  ?calc a aap:Calculation .
  FILTER (
    NOT EXISTS { ?calc aap:name ?n }
    || NOT EXISTS { ?calc aap:ashType ?t }
    || NOT EXISTS { ?calc aap:calcKind ?k }
    || NOT EXISTS { ?r aap:calculation ?calc }
  )
}
