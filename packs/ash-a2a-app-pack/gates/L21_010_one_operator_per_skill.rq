# Gate L21-010: at most one hddl_operator per skill (verify_hddl_operators.ex:11,35
# refused_hddl_multiple_operators). Any row = refusal.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?skill ?why WHERE {
  ?skill aap:hddlOperator ?o1, ?o2 .
  FILTER (?o1 != ?o2)
  BIND("refused_hddl_multiple_operators" AS ?why)
}
