# Gate L29_040: attribute, skill and action names must be valid Elixir atoms for generated
# `:name` / `name :name` DSL positions: ^[a-z_][a-zA-Z0-9_]*[?!]?$. Rows = violation.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?kind ?node ?name WHERE {
  ?resource a aap:Resource .
  { ?resource aap:attribute ?node . BIND("attribute" AS ?kind) }
  UNION { ?resource aap:attrSpec ?node . BIND("attribute" AS ?kind) }
  UNION { ?resource aap:skill ?node . BIND("skill" AS ?kind) }
  UNION { ?resource aap:skillSpec ?node . BIND("skill" AS ?kind) }
  UNION { ?resource aap:action ?node . BIND("action" AS ?kind) }
  UNION { ?resource aap:l06Action ?node . BIND("action" AS ?kind) }
  UNION { ?resource aap:manage ?node . BIND("action" AS ?kind) }
  UNION { ?resource aap:reactorAction ?node . BIND("action" AS ?kind) }
  ?node aap:name ?name .
  FILTER(!REGEX(STR(?name), "^[a-z_][a-zA-Z0-9_]*[?!]?$"))
}
