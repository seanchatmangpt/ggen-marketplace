# L01 gate: boolean flags must be the literals "true" or "false" (filterable also simple_equality).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?spec ?prop ?val WHERE {
  ?spec ?prop ?val .
  FILTER (?prop IN (aap:allowNil, aap:public, aap:sensitive, aap:generated, aap:writable,
                    aap:isPrimaryKey, aap:selectByDefault, aap:alwaysSelect, aap:sortable,
                    aap:matchOtherDefaults) && STR(?val) NOT IN ("true","false"))
}
