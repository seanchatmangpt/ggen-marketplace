# Gate L03: calculation names must not collide with attributes or other calculations on a resource.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?name WHERE {
  ?resource aap:calculation ?c1 .
  ?c1 aap:name ?name .
  {
    ?resource aap:attribute ?a . ?a aap:name ?name .
  } UNION {
    ?resource aap:calculation ?c2 . ?c2 aap:name ?name . FILTER (?c1 != ?c2)
  }
}
