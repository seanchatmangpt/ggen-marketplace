# L16 gate: a workflow with a generated court but no aap:ppUsesProvider can never resolve;
# a workflow with zero tasks; a ControlPlane expectation on a resource lacking actions.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?reason WHERE {
  {
    ?subject a aap:PPlanWorkflow .
    FILTER NOT EXISTS { ?subject aap:ppUsesProvider ?p }
    BIND("no_provider_set" AS ?reason)
  } UNION {
    ?subject a aap:PPlanWorkflow .
    FILTER NOT EXISTS { ?subject aap:ppTask ?t }
    BIND("no_tasks" AS ?reason)
  } UNION {
    ?subject a aap:Resource ; aap:ppControlPlane ?cp .
    FILTER NOT EXISTS { ?subject aap:action ?a }
    BIND("control_plane_without_actions" AS ?reason)
  }
}
