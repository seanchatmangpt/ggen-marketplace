# Gate L24_010: get? / get_by are read-action options (read.ex:70-89); refuse on any other type.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?action ?why WHERE {
  ?action a aap:L24ReadAction .
  { ?action aap:l24Get "true" } UNION { ?action aap:getByKey ?k } UNION { ?action aap:getIdentity ?i }
  OPTIONAL { ?action aap:actionType ?t }
  FILTER (!BOUND(?t) || ?t != "read")
  BIND("get?/get_by declared on a non-read action" AS ?why)
}
