# L17 gate (mirrors verify_extensions.ex:11-33): extension uris unique per domain.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?uri ?reason WHERE {
  ?d aap:agentExtension ?subject , ?other .
  ?subject aap:extUri ?uri . ?other aap:extUri ?uri .
  FILTER (?subject != ?other)
  BIND ("extension_uri_declared_more_than_once" AS ?reason)
}
