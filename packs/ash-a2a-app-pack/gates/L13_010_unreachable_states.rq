# L13 gate: a declared state not reachable from any initial state (machines without wildcards).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?machine ?state WHERE {
  ?machine a aap:StateMachine ; aap:smState ?state .
  FILTER NOT EXISTS { ?machine aap:initialState ?state }
  FILTER NOT EXISTS { ?machine aap:smTransition ?w . { ?w aap:fromAny true } UNION { ?w aap:toAny true } }
  FILTER NOT EXISTS { ?machine aap:initialState ?i . ?i (^aap:fromState/aap:toState)+ ?state }
}
