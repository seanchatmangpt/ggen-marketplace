# Gate L29_010: an attribute name (legacy aap:attribute or L01 aap:attrSpec) must not equal a
# relationship, calculation or aggregate name on the same resource (Ash entity-name clash =>
# compile error). Rows = violation. Not covered by L01_020 (attr/attr), L03_030 (calc vs legacy
# attribute only), L04_030 (aggregate vs attribute/relationship).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?name ?clash WHERE {
  ?resource a aap:Resource .
  { ?resource aap:attribute ?a } UNION { ?resource aap:attrSpec ?a } .
  ?a aap:name ?name .
  { ?resource aap:relationship ?o . BIND("relationship" AS ?clash) }
  UNION { ?resource aap:calculation ?o . BIND("calculation" AS ?clash) }
  UNION { ?resource aap:aggregate ?o . BIND("aggregate" AS ?clash) }
  ?o aap:name ?name .
}
