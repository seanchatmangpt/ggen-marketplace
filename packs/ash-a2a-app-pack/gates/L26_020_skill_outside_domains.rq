# Gate L26-020: a skill exposed by a federated agent must belong to a resource inside one of the
# agent's served domains. Rows = violations (also refuses a skill attached to no resource).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?agent ?skill WHERE {
  ?agent a aap:FederatedAgent ; aap:exposesSkill ?skill .
  FILTER NOT EXISTS {
    ?res a aap:Resource ; aap:skill ?skill ; aap:inDomain ?d .
    ?agent aap:servesDomain ?d .
  }
}
