# Gate L22-010: a skill with leaseRequired "true" needs its resource to declare a valid lease
# duration: aap:leaseDurationMs as xsd:integer > 0 (dsl.ex:242 :pos_integer). Missing, non-integer
# typed, zero or negative => refuse. Complements (does not duplicate) L07_030 (policy coverage).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?resource ?skill WHERE {
  ?resource a aap:Resource ; aap:skill ?skill .
  ?skill aap:leaseRequired ?l .
  FILTER (?l = "true")
  FILTER NOT EXISTS {
    ?resource aap:leaseDurationMs ?d .
    FILTER (datatype(?d) = xsd:integer && ?d > 0)
  }
}
