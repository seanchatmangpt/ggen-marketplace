# L16 gate: task on a dependency cycle (acyclic_dependencies.ex:25-37), or `after` pointing at
# a task of another workflow (acyclic_dependencies.ex:12-22 unknown dependency).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?task ?reason WHERE {
  {
    ?w a aap:PPlanWorkflow ; aap:ppTask ?task . ?task aap:ppAfter+ ?task .
    BIND("cycle" AS ?reason)
  } UNION {
    ?w a aap:PPlanWorkflow ; aap:ppTask ?task . ?task aap:ppAfter ?dep .
    FILTER NOT EXISTS { ?w aap:ppTask ?dep }
    BIND("foreign_dependency" AS ?reason)
  }
}
