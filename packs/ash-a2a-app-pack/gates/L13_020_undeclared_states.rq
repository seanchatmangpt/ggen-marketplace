# L13 gate: transition/initial/default/extra/terminal references a state not in the machine's smState set.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?machine ?state WHERE {
  ?machine a aap:StateMachine .
  { ?machine aap:smTransition/aap:fromState ?state }
  UNION { ?machine aap:smTransition/aap:toState ?state }
  UNION { ?machine aap:smTransition/aap:transitionTarget ?state }
  UNION { ?machine aap:initialState ?state }
  UNION { ?machine aap:defaultInitialState ?state }
  UNION { ?machine aap:extraState ?state }
  UNION { ?machine aap:deprecatedState ?state }
  UNION { ?machine aap:terminalState ?state }
  FILTER NOT EXISTS { ?machine aap:smState ?state }
}
