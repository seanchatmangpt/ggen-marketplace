# Gate L24_030: every get_by key must name an aap:attribute of the owning resource
# (read.ex:83-89 adds an argument+filter per field; a non-attribute key cannot filter).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?action ?k ?why WHERE {
  ?r a aap:Resource ; aap:l24Read ?action .
  ?action aap:getByKey ?k .
  FILTER NOT EXISTS { ?r aap:attribute ?a . ?a aap:name ?k }
  BIND("get_by key is not an attribute of the resource" AS ?why)
}
