# Gate: SQL text is emitted inside ~S|...| sigils; it must not contain the pipe character.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?node ?prop ?value WHERE {
  ?node ?prop ?value .
  VALUES ?prop { aap:baseFilterSql aap:indexWhere aap:indexFields aap:checkExpr aap:stmtUp aap:stmtDown }
  FILTER(CONTAINS(STR(?value), "|"))
}
