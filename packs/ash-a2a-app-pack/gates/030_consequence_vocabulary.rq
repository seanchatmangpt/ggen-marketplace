# Gate: any aap:consequence must be in the AshA2A vocabulary
# (ash_a2a dsl.ex:51 one_of [:observe, :change, :external_do, :unknown]). Rows = violation.
# Applies to every subject carrying aap:consequence (aap:Skill, L15 reactorSkill nodes, L17 specs).
# A leading ":" (Elixir atom spelling) is tolerated.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?skill ?c WHERE {
  ?skill aap:consequence ?c .
  FILTER (REPLACE(STR(?c), "^:", "") NOT IN ("observe", "change", "external_do", "unknown"))
}
