# L13 gate: a terminal state with an outgoing transition to a different state (or from :*).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?machine ?state ?transition WHERE {
  ?machine a aap:StateMachine ; aap:terminalState ?state ; aap:smTransition ?transition .
  { ?transition aap:fromState ?state . ?transition aap:toState ?to . FILTER(?to != ?state) }
  UNION { ?transition aap:fromAny true }
}
