# L17 gate: skill names are the Spark entity identifier (dsl.ex:195 identifier: :name). A SkillSpec
# name may not repeat another SkillSpec or an aap:Skill on the same resource (duplicate identifier).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?reason WHERE {
  {
    ?r a aap:Resource ; aap:skillSpec ?subject ; aap:skill ?other .
    ?subject aap:specName ?n . ?other aap:name ?n .
    BIND ("spec_name_collides_with_aap_Skill" AS ?reason)
  }
  UNION
  {
    ?r a aap:Resource ; aap:skillSpec ?subject ; aap:skillSpec ?other .
    ?subject aap:specName ?n . ?other aap:specName ?n .
    FILTER (?subject != ?other)
    BIND ("duplicate_spec_name" AS ?reason)
  }
}
