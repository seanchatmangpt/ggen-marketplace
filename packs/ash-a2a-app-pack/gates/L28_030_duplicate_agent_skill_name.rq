# Gate L28_030: two skills exposed by one aap:Agent share a wire name. The agent's skills are those
# of every resource in its domain (aap:forDomain), from aap:skill (aap:name) and aap:skillSpec
# (aap:specName), across resources and across both kinds. Rows = violation.
# L20_042 covers only aap:skill pairs per domain; this adds skillSpec and mixed pairs per agent.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?agent ?a ?b ?name WHERE {
  ?agent a aap:Agent ; aap:forDomain ?d .
  ?r1 a aap:Resource ; aap:inDomain ?d ; aap:skill|aap:skillSpec ?a .
  ?r2 a aap:Resource ; aap:inDomain ?d ; aap:skill|aap:skillSpec ?b .
  ?a aap:name|aap:specName ?name .
  ?b aap:name|aap:specName ?name .
  FILTER(STR(?a) < STR(?b))
}
