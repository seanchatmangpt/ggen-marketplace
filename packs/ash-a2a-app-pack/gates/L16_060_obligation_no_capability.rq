# L16 gate: an obligation with no capability, or whose capability no provider binds.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?obligation ?capability WHERE {
  ?w a aap:PPlanWorkflow ; aap:ppObligation ?obligation .
  OPTIONAL { ?obligation aap:ppCapability ?capability }
  FILTER (
    !BOUND(?capability) ||
    NOT EXISTS { ?p a aap:PPlanProvider ; aap:ppBinding ?b . ?b aap:ppCapability ?capability }
  )
}
