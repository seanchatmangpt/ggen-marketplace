# Gate: AshA2A allows at most one skill override per {resource, action}
# (REFUSED_DUPLICATE_ACTION_OVERRIDE, ash_a2a verify.ex:39), counting aap:skill and L17 aap:skillSpec.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?action (COUNT(DISTINCT ?s) AS ?n) WHERE {
  ?resource a aap:Resource .
  { ?resource aap:skill ?s . ?s aap:ofAction ?action }
  UNION
  { ?resource aap:skillSpec ?s . ?s aap:ofAction ?action }
}
GROUP BY ?resource ?action
HAVING (COUNT(DISTINCT ?s) > 1)
