# Gate L14: every trigger action / read_action / worker_read_action / on_error must name an
# action declared on the same resource.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?trigger ?missing WHERE {
  ?r a aap:Resource ; aap:obTrigger ?trigger .
  { ?trigger aap:obAction ?missing } UNION { ?trigger aap:obReadAction ?missing }
  UNION { ?trigger aap:obWorkerReadAction ?missing } UNION { ?trigger aap:obOnError ?missing }
  FILTER NOT EXISTS { ?r aap:action ?a . ?a aap:name ?n . FILTER(STR(?n) = STR(?missing)) }
}
