# Gate L14: every queue named by a trigger, scheduler or schedule must have an aap:ObanQueue
# with a concurrency limit (an undeclared queue is never polled by Oban).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?node ?queue WHERE {
  { ?node aap:obQueue ?queue } UNION { ?node aap:obSchedulerQueue ?queue }
  FILTER NOT EXISTS { ?q a aap:ObanQueue ; aap:obQueueName ?qn ; aap:obQueueLimit ?l .
                      FILTER(STR(?qn) = STR(?queue)) }
}
