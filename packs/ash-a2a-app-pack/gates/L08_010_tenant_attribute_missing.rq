# L08 gate: strategy :attribute names a tenant attribute that the resource neither
# declares (aap:attribute) nor derives from a belongs_to source attribute.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?resource ?tenant_attr WHERE {
  ?resource a aap:Resource ; aap:multitenancy ?m .
  ?m aap:tenantStrategy "attribute" ; aap:tenantAttribute ?tenant_attr .
  FILTER NOT EXISTS { ?resource aap:attribute ?a . ?a aap:name ?tenant_attr }
  FILTER NOT EXISTS { ?resource aap:relationship ?x . ?x aap:relSourceAttribute ?tenant_attr }
}
