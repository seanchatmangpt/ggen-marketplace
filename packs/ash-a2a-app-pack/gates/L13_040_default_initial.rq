# L13 gate: default_initial_state must be an initial state (verify_default_initial_state.ex);
# a machine must declare at least one initial state (required, ash_state_machine.ex:95).
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?machine ?state WHERE {
  { ?machine a aap:StateMachine ; aap:defaultInitialState ?state .
    FILTER NOT EXISTS { ?machine aap:initialState ?state } }
  UNION
  { ?machine a aap:StateMachine . BIND("<no-initial-state>" AS ?state)
    FILTER NOT EXISTS { ?machine aap:initialState ?x } }
}
