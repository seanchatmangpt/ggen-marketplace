# L17 gate (mirrors verify_config.ex:99-115,143-162): security.requirements name declared schemes;
# requirement_scopes keys must appear in requirements.
PREFIX aap: <https://ggen.dev/ash-a2a-app#>
SELECT ?subject ?name ?reason WHERE {
  {
    ?subject a aap:Domain ; aap:requirement ?name .
    FILTER NOT EXISTS { ?subject aap:securityScheme ?s . ?s aap:schemeName ?name }
    BIND ("security_requirement_references_no_declared_scheme" AS ?reason)
  }
  UNION
  {
    ?subject a aap:Domain ; aap:requirementScope ?q . ?q aap:reqName ?name .
    FILTER NOT EXISTS { ?subject aap:requirement ?name }
    BIND ("requirement_scopes_key_not_in_requirements" AS ?reason)
  }
}
