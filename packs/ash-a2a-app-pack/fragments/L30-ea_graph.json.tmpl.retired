---
to: "ea.graph.json"
force: true
sparql:
  domains: |
    PREFIX aap: <https://ggen.dev/ash-a2a-app#>
    SELECT ?module_name WHERE {
      ?d a aap:Domain ; aap:moduleName ?module_name .
    } ORDER BY ?module_name
---
{#- GENERATED by ash-a2a-app-pack lane L30 from the application ontology. Do not hand-edit.
    Shape: ggen-abb-sbb EaGraph (crates/ggen-abb-sbb/src/lib.rs:184, deny_unknown_fields),
    schema ggen.ea.graph.v1, validated by EaGraph::validate (lib.rs:529).
    One capability + ABB + contract per Ash domain. candidate_sbbs/qualifications are empty:
    SBB admission needs sha256 canonical digests (lib.rs:620-631) a template cannot compute. -#}
{
  "schema": "ggen.ea.graph.v1",
  "strategy": { "id": "ash-a2a-app", "title": "Ash A2A application" },
  "capabilities": [
{%- for d in domains %}
    { "id": "cap-{{ d.module_name | lower | replace(from=".", to="-") }}", "strategy": "ash-a2a-app" }{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "abbs": [
{%- for d in domains %}
    { "id": "abb-{{ d.module_name | lower | replace(from=".", to="-") }}", "capability": "cap-{{ d.module_name | lower | replace(from=".", to="-") }}", "contract": "contract-{{ d.module_name | lower | replace(from=".", to="-") }}" }{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "contracts": [
{%- for d in domains %}
    { "id": "contract-{{ d.module_name | lower | replace(from=".", to="-") }}", "abb": "abb-{{ d.module_name | lower | replace(from=".", to="-") }}", "version": "1", "max_artifacts": 4096, "authority_ceiling": "CONSTRUCT", "required_ports": [] }{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  "candidate_sbbs": [],
  "qualifications": [],
  "packs": []
}
