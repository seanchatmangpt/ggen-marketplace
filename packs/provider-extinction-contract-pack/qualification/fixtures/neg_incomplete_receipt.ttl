# NEG fixture (gate 030 must FIRE): a receipt missing subjectAfter,
# replayBinding and evidence -- three violation rows, one per missing field,
# naming the receipt.
@prefix ex: <https://example.org/consumer#> .
@prefix pec: <https://seanchatmangpt.github.io/packs/provider-extinction-contract#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ex:authority-4 a pec:AuthorityGrant ; dcterms:identifier "EX-4/grant" .
ex:provider-recipe a pec:ExecutionProvider ; dcterms:identifier "recipe" ; pec:providerId "recipe" ; pec:enabled true .

ex:rcpt-4 a pec:ExecutionReceipt ;
    dcterms:identifier "EX-4/receipt" ;
    pec:workOrderId "EX-4" ;
    pec:originAuthority ex:authority-4 ;
    pec:provider ex:provider-recipe ;
    pec:providerExecutionId "run-43" ;
    pec:subjectBefore "consumer@3333333333333333333333333333333333333333" ;
    pec:commands "make test" ;
    pec:consequences "tests green" ;
    pec:exitStatus 0 ;
    pec:timestamps "2026-09-25T00:00:00Z" .
