# POS fixture: a conforming consumer graph (consumer's own namespace -- packs
# ship zero consumer individuals). All three gates must return ZERO rows.
@prefix ex: <https://example.org/consumer#> .
@prefix pec: <https://seanchatmangpt.github.io/packs/provider-extinction-contract#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:wo-1 a pec:WorkOrder ;
    dcterms:identifier "EX-1" ;
    dcterms:title "Deterministic render of the catalog" ;
    dcterms:description "Render the catalog projection from the canonical graph." ;
    ex:acceptance ex:acc-1 .

ex:acc-1 a pec:AcceptanceCriterion ;
    dcterms:title "byte-identical re-render" .

ex:authority-1 a pec:AuthorityGrant ;
    dcterms:identifier "EX-1/operator-grant" ;
    dcterms:description "Operator grant for CONSTRUCT-scope rendering." .

ex:cap-render a pec:Capability ; pec:capabilityId "recipe:render" .
ex:cap-fanout a pec:Capability ; pec:capabilityId "worker:fanout" .

ex:provider-recipe a pec:ExecutionProvider ;
    dcterms:identifier "recipe" ;
    pec:providerId "recipe" ;
    pec:enabled true ;
    pec:authorityCeiling "CONSTRUCT" ;
    pec:extinctionInvariant "capacity latency cost capability-set" .

ex:provider-worker a pec:ExecutionProvider ;
    dcterms:identifier "worker" ;
    pec:providerId "worker" ;
    pec:enabled true ;
    pec:authorityCeiling "CONSTRUCT" ;
    pec:extinctionInvariant "capacity latency cost capability-set" .

ex:rcpt-1 a pec:ExecutionReceipt ;
    dcterms:identifier "EX-1/receipt" ;
    pec:workOrderId "EX-1" ;
    pec:originAuthority ex:authority-1 ;
    pec:provider ex:provider-recipe ;
    pec:providerExecutionId "run-42" ;
    pec:subjectBefore "consumer@1111111111111111111111111111111111111111" ;
    pec:subjectAfter "consumer@2222222222222222222222222222222222222222" ;
    pec:commands "ggen sync run" ;
    pec:consequences "catalog rendered" ;
    pec:evidence "sync receipt" ;
    pec:exitStatus 0 ;
    pec:timestamps "2026-09-25T00:00:00Z" ;
    pec:replayBinding "git-notes@2222" .
