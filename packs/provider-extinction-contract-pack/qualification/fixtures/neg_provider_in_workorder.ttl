# NEG fixture (gate 010 must FIRE): a work order whose identity and acceptance
# carry a provider name. Injecting this into a consumer graph must produce
# violation rows (workorder.title / acceptance.title at minimum); removing the
# provider tokens must return the graph to zero rows (anti-vacuity pair with
# pos_consumer_clean.ttl).
@prefix ex: <https://example.org/consumer#> .
@prefix pec: <https://seanchatmangpt.github.io/packs/provider-extinction-contract#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ex:wo-bad a pec:WorkOrder ;
    dcterms:identifier "EX-2" ;
    dcterms:title "Migrate the Claude integration to a ZCode worker" ;
    dcterms:description "Hand the fan-out lanes to the named provider." .

ex:acc-bad a pec:AcceptanceCriterion ;
    dcterms:title "all lanes running on Anthropic" .
