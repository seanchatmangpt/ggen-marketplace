# NEG fixture (gate 020 must FIRE): one capability whose provider class has no
# ENABLED provider individual ("shadow" exists but is disabled), plus one
# malformed capabilityId with no provider segment at all. Both must come back
# as violation rows naming the capability.
@prefix ex: <https://example.org/consumer#> .
@prefix pec: <https://seanchatmangpt.github.io/packs/provider-extinction-contract#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ex:wo-3 a pec:WorkOrder ;
    dcterms:identifier "EX-3" ;
    dcterms:title "Shadow render" .

ex:cap-shadow a pec:Capability ; pec:capabilityId "shadow:render" .
ex:cap-nosegment a pec:Capability ; pec:capabilityId "no-provider-segment-here" .

ex:provider-shadow a pec:ExecutionProvider ;
    dcterms:identifier "shadow" ;
    pec:providerId "shadow" ;
    pec:enabled false ;
    pec:extinctionInvariant "capacity latency cost capability-set" .
