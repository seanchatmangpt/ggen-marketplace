# MESSAGE: receipt-shape violation -- a pec:ExecutionReceipt missing any of
# the 12 contract fields (workOrderId, originAuthority, provider,
# providerExecutionId, subjectBefore, subjectAfter, commands, consequences,
# evidence, exitStatus, timestamps, replayBinding) is a violation row naming
# the receipt and the missing field. A receipt that cannot be replayed or
# attributed after a provider.replace is not evidence.
# Violation-row style (FM-PACK-013): zero rows = every receipt carries the
# full contract; one row per missing field.
# The BIND-witness pattern: each UNION branch OPTIONALLY witnesses one field
# into its own ?wN variable; a missing field leaves ?wN unbound and the
# group-level FILTER(!BOUND) fires. Distinct witness variables per branch are
# required -- a shared name would leak bindings across branches.
# GRAPH-SHAPE LAW (falsifier-witnessed 2026-09-25, lane 5, both engines):
# the class-typing triple MUST live INSIDE every UNION branch. A shared outer
# BGP (`?receipt a pec:ExecutionReceipt .` before the UNION) joined against
# OPTIONAL/!BOUND branches silently drops every row once a CONFORMING receipt
# also exists in the graph -- 3 expected rows became 0 (measured on
# sparql 0.3.12 AND oxigraph). The same portability shape is used by
# aloop-episode-ontology-pack gate 010 and semantic-jira-pack gate 047.
# sparql law: no FILTER inside EXISTS/OPTIONAL groups; group-level
# FILTER(!BOUND) only.
PREFIX pec: <https://seanchatmangpt.github.io/packs/provider-extinction-contract#>
SELECT ?receipt ?field WHERE {
  {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:workOrderId ?w1 . BIND(?w1 AS ?witness1) }
    FILTER(!BOUND(?witness1))
    BIND("workOrderId" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:originAuthority ?w2 . BIND(?w2 AS ?witness2) }
    FILTER(!BOUND(?witness2))
    BIND("originAuthority" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:provider ?w3 . BIND(?w3 AS ?witness3) }
    FILTER(!BOUND(?witness3))
    BIND("provider" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:providerExecutionId ?w4 . BIND(?w4 AS ?witness4) }
    FILTER(!BOUND(?witness4))
    BIND("providerExecutionId" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:subjectBefore ?w5 . BIND(?w5 AS ?witness5) }
    FILTER(!BOUND(?witness5))
    BIND("subjectBefore" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:subjectAfter ?w6 . BIND(?w6 AS ?witness6) }
    FILTER(!BOUND(?witness6))
    BIND("subjectAfter" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:commands ?w7 . BIND(?w7 AS ?witness7) }
    FILTER(!BOUND(?witness7))
    BIND("commands" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:consequences ?w8 . BIND(?w8 AS ?witness8) }
    FILTER(!BOUND(?witness8))
    BIND("consequences" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:evidence ?w9 . BIND(?w9 AS ?witness9) }
    FILTER(!BOUND(?witness9))
    BIND("evidence" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:exitStatus ?w10 . BIND(?w10 AS ?witness10) }
    FILTER(!BOUND(?witness10))
    BIND("exitStatus" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:timestamps ?w11 . BIND(?w11 AS ?witness11) }
    FILTER(!BOUND(?witness11))
    BIND("timestamps" AS ?field)
  } UNION {
    ?receipt a pec:ExecutionReceipt .
    OPTIONAL { ?receipt pec:replayBinding ?w12 . BIND(?w12 AS ?witness12) }
    FILTER(!BOUND(?witness12))
    BIND("replayBinding" AS ?field)
  }
}
ORDER BY ?field ?receipt
