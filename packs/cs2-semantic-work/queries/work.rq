PREFIX cs2: <https://chatman.ai/cs2#>
SELECT ?subject ?campaign ?authority ?workId ?consumer ?repository ?capability ?projectionKind WHERE {
 VALUES ?subject { cs2:RFC-CS2-001 }
 ?subject a cs2:SemanticWorld ; cs2:campaign ?campaign ; cs2:authorityCeiling ?authorityIri ; cs2:requiresExactSubject true .
 BIND(REPLACE(STR(?authorityIri), "^.*[#/]", "") AS ?authority)
 ?workId a cs2:Work ; cs2:implements ?subject ; cs2:consumer ?consumer ; cs2:capability ?capability ; cs2:projectionKind ?projectionKind .
 ?consumer cs2:repository ?repository .
} ORDER BY STR(?workId)
