PREFIX cs2: <https://example.org/cs2#>
SELECT ?workKey ?subject ?repo ?sha ?digest ?objective ?acceptance ?falsifier ?nextEdge WHERE {
 ?work a cs2:WorkItem ; cs2:workKey ?workKey ; cs2:subjectIri ?subject ;
   cs2:sourceRepo ?repo ; cs2:sourceSha ?sha ; cs2:sourceDigest ?digest ;
   cs2:objective ?objective ; cs2:acceptance ?acceptance ;
   cs2:falsifier ?falsifier ; cs2:nextEdge ?nextEdge .
}
ORDER BY ?workKey
