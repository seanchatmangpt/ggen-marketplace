PREFIX cs2: <https://example.org/cs2#>
SELECT ?work ?reason WHERE {
  ?work a cs2:WorkItem .
  {
    FILTER NOT EXISTS { ?work cs2:subjectIri ?subject }
    BIND("missing exact subject" AS ?reason)
  }
  UNION
  {
    ?work cs2:subjectIri ?subject .
    FILTER(?subject != "https://chatman.ai/cs2#RFC-CS2-001")
    BIND("subject mismatch" AS ?reason)
  }
}
