PREFIX cs2: <https://example.org/cs2#>
SELECT ?left ?right ?leftRepo ?rightRepo ?leftSha ?rightSha ?leftDigest ?rightDigest WHERE {
  ?left a cs2:WorkItem ;
    cs2:sourceRepo ?leftRepo ;
    cs2:sourceSha ?leftSha ;
    cs2:sourceDigest ?leftDigest .
  ?right a cs2:WorkItem ;
    cs2:sourceRepo ?rightRepo ;
    cs2:sourceSha ?rightSha ;
    cs2:sourceDigest ?rightDigest .
  FILTER(STR(?left) < STR(?right))
  FILTER(?leftRepo != ?rightRepo || ?leftSha != ?rightSha || ?leftDigest != ?rightDigest)
}
