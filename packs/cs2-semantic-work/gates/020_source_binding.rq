PREFIX cs2: <https://example.org/cs2#>
SELECT ?work ?reason WHERE {
 ?work a cs2:WorkItem .
 { FILTER NOT EXISTS { ?work cs2:sourceRepo ?repo } BIND("missing source repo" AS ?reason) }
 UNION { FILTER NOT EXISTS { ?work cs2:sourceSha ?sha } BIND("missing source sha" AS ?reason) }
 UNION { FILTER NOT EXISTS { ?work cs2:sourceDigest ?digest } BIND("missing source digest" AS ?reason) }
}
