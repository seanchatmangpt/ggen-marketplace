{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatman.ai/schemas/cs2/work-projection-batch.schema.json",
  "title": "CS2 semantic work projection batch",
  "type": "object",
  "required": ["batchId", "subject", "source", "work", "authority"],
  "properties": {
    "batchId": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "format": "uri"},
    "source": {
      "type": "object",
      "required": ["repo", "sha", "digest"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "work": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/workItem"}
    },
    "authority": {"const": "NONE"}
  },
  "$defs": {
    "workItem": {
      "type": "object",
      "required": ["workKey", "objective", "acceptance", "falsifier", "nextEdge"],
      "properties": {
        "workKey": {"type": "string", "pattern": "^CS2-WRK-[0-9]+$"},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1},
        "falsifier": {"type": "string", "minLength": 1},
        "nextEdge": {"type": "string", "minLength": 1},
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "pattern": "^CS2-WRK-[0-9]+$"},
          "uniqueItems": true,
          "default": []
        },
        "pathScope": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "pattern": "^[^/].*"},
          "uniqueItems": true,
          "default": []
        },
        "projections": {
          "type": "array",
          "items": {
            "enum": ["jira", "wbpr", "prd", "ard", "vision", "fond", "hddl", "sa2a", "a2a_agent_card", "worker", "verification", "executive", "machine", "receipt", "replay"]
          },
          "uniqueItems": true,
          "default": ["worker", "verification", "machine"]
        },
        "originAuthority": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
