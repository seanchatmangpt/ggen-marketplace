defmodule {{ module }} do
  @moduledoc false
  @required ~w(workKey subject source objective acceptance falsifier nextEdge authority)

  def admit(projection) when is_map(projection) do
    with :ok <- required(projection),
         "NONE" <- projection["authority"],
         %{"repo" => repo, "sha" => sha, "digest" => digest} <- projection["source"],
         true <- repo != "" and byte_size(sha) == 40 and byte_size(digest) == 64 do
      {:ok, %{
        work_key: projection["workKey"],
        subject: projection["subject"],
        origin: %{repo: repo, sha: sha, digest: digest},
        objective: projection["objective"],
        acceptance: projection["acceptance"],
        falsifier: projection["falsifier"],
        next_edge: projection["nextEdge"],
        authority: :none
      }}
    else
      _ -> {:error, :refused_cs2_projection}
    end
  end

  def admit(_), do: {:error, :refused_cs2_projection}

  defp required(map) do
    if Enum.all?(@required, &Map.has_key?(map, &1)), do: :ok, else: {:error, :missing_field}
  end
end
