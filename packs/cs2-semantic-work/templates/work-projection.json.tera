{
  "workKey": {{ workKey | json_encode() }},
  "subject": {{ subject | json_encode() }},
  "source": {
    "repo": {{ repo | json_encode() }},
    "sha": {{ sha | json_encode() }},
    "digest": {{ digest | json_encode() }}
  },
  "objective": {{ objective | json_encode() }},
  "acceptance": {{ acceptance | json_encode() }},
  "falsifier": {{ falsifier | json_encode() }},
  "nextEdge": {{ nextEdge | json_encode() }},
  "authority": "NONE"
}
