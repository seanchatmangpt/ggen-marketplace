defmodule {{ module }} do
  @moduledoc false
  @subject "https://chatman.ai/cs2#RFC-CS2-001"
  @authority "NONE"

  def admit(%{"subject" => @subject, "authority" => @authority, "source" => source, "work" => work} = batch)
      when is_map(source) and is_list(work) and work != [] do
    with :ok <- source(source),
         :ok <- unique_keys(work),
         :ok <- dependencies_closed(work) do
      {:ok, %{batch_id: batch["batchId"], subject: @subject, source: source,
        work: Enum.map(work, &normalize/1), authority: :none}}
    end
  end
  def admit(_), do: {:error, :refused_cs2_batch}

  defp source(%{"repo" => repo, "sha" => sha, "digest" => digest})
       when is_binary(repo) and byte_size(sha) == 40 and byte_size(digest) == 64, do: :ok
  defp source(_), do: {:error, :invalid_source}

  defp unique_keys(work) do
    keys = Enum.map(work, & &1["workKey"])
    if Enum.all?(keys, &is_binary/1) and length(keys) == MapSet.size(MapSet.new(keys)), do: :ok,
      else: {:error, :duplicate_work_key}
  end

  defp dependencies_closed(work) do
    keys = MapSet.new(Enum.map(work, & &1["workKey"]))
    invalid = Enum.find(work, fn item ->
      deps = item["dependencies"] || []
      item["workKey"] in deps or Enum.any?(deps, &(not MapSet.member?(keys, &1)))
    end)
    if invalid, do: {:error, :open_dependency}, else: :ok
  end

  defp normalize(item) do
    %{work_key: item["workKey"], title: item["title"], objective: item["objective"],
      acceptance: item["acceptance"], falsifier: item["falsifier"], next_edge: item["nextEdge"],
      dependencies: item["dependencies"] || [], path_scope: item["pathScope"] || [],
      projections: item["projections"] || [], origin_authority: item["originAuthority"]}
  end
end
