---
to: generated/cs2-semantic-work/work/{{ workKey }}.json
force: true
for_each: work
sparql:
  work: |
    PREFIX cs2: <https://example.org/cs2#>
    SELECT ?workKey ?subject ?repo ?sha ?digest ?objective ?acceptance ?falsifier ?nextEdge WHERE {
     ?work a cs2:WorkItem ; cs2:workKey ?workKey ; cs2:subjectIri ?subject ;
       cs2:sourceRepo ?repo ; cs2:sourceSha ?sha ; cs2:sourceDigest ?digest ;
       cs2:objective ?objective ; cs2:acceptance ?acceptance ;
       cs2:falsifier ?falsifier ; cs2:nextEdge ?nextEdge ; cs2:authority "NONE" .
    }
    ORDER BY ?workKey
---
{
  "workKey": {{ workKey | json_encode() | safe }},
  "subject": {{ subject | json_encode() | safe }},
  "source": {
    "repo": {{ repo | json_encode() | safe }},
    "sha": {{ sha | json_encode() | safe }},
    "digest": {{ digest | json_encode() | safe }}
  },
  "objective": {{ objective | json_encode() | safe }},
  "acceptance": {{ acceptance | json_encode() | safe }},
  "falsifier": {{ falsifier | json_encode() | safe }},
  "nextEdge": {{ nextEdge | json_encode() | safe }},
  "authority": "NONE"
}
