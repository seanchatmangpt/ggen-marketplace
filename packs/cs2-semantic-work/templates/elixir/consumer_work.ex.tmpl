---
to: generated/cs2-semantic-work/elixir/consumer_work.ex
force: true
sparql:
  mod: |
    PREFIX cs2: <https://example.org/cs2#>
    SELECT ?module WHERE { cs2:ConsumerWork cs2:elixirModule ?module . } ORDER BY ?module LIMIT 1
---
{%- set m = mod.0.module -%}
# Typed consumer surfaces over the consumer JSON projections
# (generated/cs2-semantic-work/consumer/*.json). Row keys are the snake_case
# forms of the consumer SPARQL variables. Generated by ggen; do not hand-edit.
defmodule {{ m }}.Work do
  @moduledoc "One consumer work row (consumer-work.json payload item)."
  @enforce_keys [:work_key, :subject_iri, :source_repo, :source_sha]
  defstruct @enforce_keys ++ [authority: "NONE"]
end

defmodule {{ m }}.Admission do
  @moduledoc "Refuses any consumer row whose authority is not NONE."
  @spec admit(term()) :: {:ok, map()} | {:error, :authority_refused}
  def admit(%{"authority" => "NONE"} = w), do: {:ok, w}
  def admit(_), do: {:error, :authority_refused}
end

defmodule {{ m }}.Source do
  @moduledoc "Source binding row: repo plus a 40-hex git SHA."
  @spec valid?(term()) :: boolean()
  def valid?(%{source_repo: r, source_sha: s}) when is_binary(r) and is_binary(s),
    do: r != "" and byte_size(s) == 40

  def valid?(_), do: false
end

defmodule {{ m }}.Dependency do
  @moduledoc "Dependency edge row; a self-edge is invalid."
  @spec valid?(term()) :: boolean()
  def valid?(%{work_key: k, depends_on_work_key: d}) when is_binary(k) and is_binary(d), do: k != d
  def valid?(_), do: false
end

defmodule {{ m }}.Projection do
  @moduledoc "Requested projection-type row."
  @spec requested?(term()) :: boolean()
  def requested?(%{projection_type: p}) when is_binary(p), do: p != ""
  def requested?(_), do: false
end

defmodule {{ m }}.Batch do
  @moduledoc "Batch helpers; rows carrying depends_on_work_key are not roots."
  @spec authority() :: String.t()
  def authority, do: "NONE"
  @spec roots([map()]) :: [map()]
  def roots(xs), do: Enum.reject(xs, &Map.has_key?(&1, :depends_on_work_key))
end
