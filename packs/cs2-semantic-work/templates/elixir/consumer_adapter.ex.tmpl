---
to: generated/cs2-semantic-work/elixir/consumer_adapter.ex
force: true
sparql:
  mod: |
    PREFIX cs2: <https://example.org/cs2#>
    SELECT ?module WHERE { cs2:ConsumerAdmission cs2:elixirModule ?module . } ORDER BY ?module LIMIT 1
  subject: |
    PREFIX cs2: <https://example.org/cs2#>
    SELECT ?subject WHERE { cs2:WorkProjection cs2:canonicalSubject ?subject . } ORDER BY ?subject LIMIT 1
---
defmodule {{ mod.0.module }} do
  @moduledoc """
  Authority-free admission of a CS2 work-projection batch
  (schemas/work-projection-batch.schema.json). Generated by ggen from the
  cs2-semantic-work pack; do not hand-edit.
  """
  @subject {{ subject.0.subject | json_encode() | safe }}
  @authority "NONE"

  @spec admit(term()) :: {:ok, map()} | {:error, atom()}
  def admit(%{"subject" => @subject, "authority" => @authority, "source" => source, "work" => work} = batch)
      when is_map(source) and is_list(work) and work != [] do
    with :ok <- source(source),
         :ok <- unique_keys(work),
         :ok <- dependencies_closed(work) do
      {:ok,
       %{
         batch_id: batch["batchId"],
         subject: @subject,
         source: source,
         work: Enum.map(work, &normalize/1),
         authority: :none
       }}
    end
  end

  def admit(_), do: {:error, :refused_cs2_batch}

  defp source(%{"repo" => repo, "sha" => sha, "digest" => digest})
       when is_binary(repo) and is_binary(sha) and is_binary(digest) and
              byte_size(sha) == 40 and byte_size(digest) == 64,
       do: :ok

  defp source(_), do: {:error, :invalid_source}

  defp unique_keys(work) do
    keys = Enum.map(work, &work_key/1)

    if Enum.all?(keys, &is_binary/1) and length(keys) == MapSet.size(MapSet.new(keys)),
      do: :ok,
      else: {:error, :duplicate_work_key}
  end

  defp dependencies_closed(work) do
    keys = MapSet.new(Enum.map(work, &work_key/1))

    invalid =
      Enum.find(work, fn item ->
        deps = dependencies(item)
        work_key(item) in deps or Enum.any?(deps, &(not MapSet.member?(keys, &1)))
      end)

    if invalid, do: {:error, :open_dependency}, else: :ok
  end

  defp work_key(item) when is_map(item), do: item["workKey"]
  defp work_key(_), do: nil

  defp dependencies(item) when is_map(item), do: item["dependencies"] || []
  defp dependencies(_), do: []

  defp normalize(item) do
    %{
      work_key: item["workKey"],
      title: item["title"],
      objective: item["objective"],
      acceptance: item["acceptance"],
      falsifier: item["falsifier"],
      next_edge: item["nextEdge"],
      dependencies: item["dependencies"] || [],
      path_scope: item["pathScope"] || [],
      projections: item["projections"] || [],
      origin_authority: item["originAuthority"]
    }
  end
end
