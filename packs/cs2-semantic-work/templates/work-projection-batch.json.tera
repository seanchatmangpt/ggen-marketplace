{
  "batchId": {{ batchId | json_encode() }},
  "subject": {{ subject | json_encode() }},
  "source": {
    "repo": {{ source.repo | json_encode() }},
    "sha": {{ source.sha | json_encode() }},
    "digest": {{ source.digest | json_encode() }}
  },
  "work": [
{% for item in work %}
    {
      "workKey": {{ item.workKey | json_encode() }},
      "title": {{ item.title | json_encode() }},
      "description": {{ item.description | json_encode() }},
      "objective": {{ item.objective | json_encode() }},
      "acceptance": {{ item.acceptance | json_encode() }},
      "falsifier": {{ item.falsifier | json_encode() }},
      "nextEdge": {{ item.nextEdge | json_encode() }},
      "dependencies": {{ item.dependencies | json_encode() }},
      "pathScope": {{ item.pathScope | json_encode() }},
      "projections": {{ item.projections | json_encode() }},
      "originAuthority": {{ item.originAuthority | json_encode() }}
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ],
  "authority": "NONE"
}
