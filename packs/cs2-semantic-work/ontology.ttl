@prefix cs2: <https://example.org/cs2#> .
cs2:WorkProjection a cs2:Capability ; cs2:workId "CS2-WRK-003" ; cs2:authority "NONE" .
cs2:BatchProjection a cs2:Capability ; cs2:workId "CS2-WRK-006" ; cs2:authority "NONE" .
cs2:ConsumerProjection a cs2:Capability ; cs2:authority "NONE" .
cs2:ConsumerAdmission a cs2:Capability ; cs2:authority "NONE" .
cs2:WorkBatch a cs2:ProjectionType .
cs2:WorkItem a cs2:ProjectionType .
cs2:ConsumerWork a cs2:ProjectionType .
cs2:batchId a cs2:ProjectionField .
cs2:containsWork a cs2:ProjectionField .
cs2:workKey a cs2:ProjectionField .
cs2:subjectIri a cs2:ProjectionField .
cs2:sourceRepo a cs2:ProjectionField .
cs2:sourceSha a cs2:ProjectionField .
cs2:sourceDigest a cs2:ProjectionField .
cs2:objective a cs2:ProjectionField .
cs2:acceptance a cs2:ProjectionField .
cs2:falsifier a cs2:ProjectionField .
cs2:nextEdge a cs2:ProjectionField .
cs2:dependsOnWorkKey a cs2:ProjectionField .
cs2:pathScope a cs2:ProjectionField .
cs2:projectionType a cs2:ProjectionField .
cs2:originAuthority a cs2:ProjectionField .
cs2:authority a cs2:ProjectionField .
cs2:title a cs2:ProjectionField .
cs2:description a cs2:ProjectionField .
cs2:canonicalSubject a cs2:ProjectionField .
cs2:elixirModule a cs2:ProjectionField .
cs2:WorkProjection cs2:canonicalSubject "https://chatman.ai/cs2#RFC-CS2-001" .
cs2:ConsumerProjection cs2:elixirModule "Cs2SemanticWork.Consumer" .
cs2:ConsumerAdmission cs2:elixirModule "Cs2SemanticWork.ConsumerAdapter" .
cs2:ConsumerWork cs2:elixirModule "Cs2SemanticWork.ConsumerWork" .

# Pack manifest wiring (formerly pack.toml [projection], [batch_projection],
# [consumer], [[gates]] and [[templates]] tables, which ggen-engine denies).
cs2:PackManifest a cs2:ManifestWiring ;
  cs2:projectionQuery "queries/project_work.rq" ;
  cs2:projectionSchema "schemas/work-projection.schema.json" ;
  cs2:batchDependencyQuery "queries/project_dependencies.rq" ;
  cs2:batchSchema "schemas/work-projection-batch.schema.json" ;
  cs2:batchTemplate "templates/work-projection-batch.json.tera" ;
  cs2:consumerWorkQuery "consumer/queries/project_consumer_work.rq" ;
  cs2:consumerDependencyQuery "consumer/queries/project_consumer_dependencies.rq" ;
  cs2:consumerSourceQuery "consumer/queries/project_consumer_sources.rq" ;
  cs2:consumerBatchQuery "consumer/queries/project_consumer_batch.rq" ;
  cs2:consumerSchema "consumer/schemas/consumer-work.schema.json" ;
  cs2:consumerTemplate "consumer/templates/consumer-work.json.tera" ;
  cs2:manifestAuthority "NONE" ;
  cs2:declaredGate "gates/010_exact_subject.rq", "gates/020_source_binding.rq",
    "gates/030_authority_none.rq", "gates/040_unique_work_key.rq",
    "gates/050_single_subject.rq", "gates/060_single_source_binding.rq",
    "gates/070_dependency_target_exists.rq", "gates/080_no_self_dependency.rq",
    "gates/100_projection_required.rq" ;
  cs2:declaredTemplate "templates/work-projection.json.tera",
    "templates/work-projection-batch.json.tera" .
