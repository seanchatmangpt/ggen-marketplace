{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CS2 recovery-state contract",
  "type": "object",
  "required": [
    "workKey",
    "attempt",
    "lastError"
  ],
  "properties": {
    "workKey": {
      "type": "string"
    },
    "attempt": {
      "type": "integer"
    },
    "lastError": {
      "type": "string"
    }
  },
  "additionalProperties": true
}