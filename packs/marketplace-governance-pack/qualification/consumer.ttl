# Minimal positive qualification fixture: a consumer pack that has
# completed a real consolidation review and recorded its own qualification
# receipt against this governance law. Must satisfy gates/01 as-is (every
# LegacyPack precondition consistent with its lifecycleEligible claim).
@prefix mg: <https://ggen.dev/ontology/marketplace-governance#> .
@prefix mq: <https://ggen.dev/marketplace/qualification#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mq:ExampleConsumerLegacyPack a mg:LegacyPack ;
  rdfs:comment "A synthetic consumer-side legacy pack exercising the ABSORB path end to end for qualification purposes only." ;
  mg:replacementDecision mg:ABSORB ;
  mg:absorbedInto mg:MarketplaceGovernance ;
  mg:coverageComplete true ;
  mg:independentReplacement true ;
  mg:replayVerified true ;
  mg:noActiveConsumers true ;
  mg:lifecycleEligible true .

mq:ExampleConsumerReceipt a mg:QualificationReceipt ;
  mg:forPack mq:ExampleConsumerLegacyPack ;
  mg:receiptStatus "ALIVE" ;
  mg:qualifiedOn "2026-09-12"^^xsd:date .
