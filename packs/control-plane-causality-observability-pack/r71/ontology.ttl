@prefix cea: <https://chatman.ai/ontology/causal-evidence-assimilation#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cea:EvidenceAssimilationRun a rdfs:Class ; rdfs:subClassOf prov:Activity .
cea:ExternalSubject a rdfs:Class ; rdfs:subClassOf prov:Entity .
cea:EvidenceReceipt a rdfs:Class ; rdfs:subClassOf prov:Entity .
cea:AssimilationObservation a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .
cea:Opportunity a rdfs:Class ; rdfs:subClassOf prov:Entity .

cea:repository a rdf:Property .
cea:headSha a rdf:Property .
cea:subjectCurrent a rdf:Property .
cea:receiptCurrent a rdf:Property .
cea:receiptPresent a rdf:Property .
cea:receiptStanding a rdf:Property .
cea:exactSubjectPresent a rdf:Property .
cea:independentEvidenceRoot a rdf:Property .
cea:replayVerified a rdf:Property .
cea:falsifierPassed a rdf:Property .
cea:qualificationPresent a rdf:Property .
cea:mergeContained a rdf:Property .
cea:causalLinkPresent a rdf:Property .
cea:consumerFactor a rdf:Property .
cea:reuseFactor a rdf:Property .
cea:compositionFactor a rdf:Property .
cea:opportunityCount a rdf:Property .
cea:seedCount a rdf:Property .
cea:memoryRecordsConsumed a rdf:Property .
cea:memoryCausedOpportunities a rdf:Property .
cea:latencySeconds a rdf:Property .
cea:stale a rdf:Property .
cea:contradicted a rdf:Property .
cea:authority a rdf:Property .
cea:consequentialDo a rdf:Property .
cea:actuationPerformed a rdf:Property .
cea:generatedOutputEdited a rdf:Property .
cea:publicOntologyAligned a rdf:Property .
cea:marketplacePack a rdf:Property .
cea:standing a rdf:Property .
cea:unlockPresent a rdf:Property .
cea:projectionPresent a rdf:Property .
cea:sourceObservedAt a rdf:Property .
cea:assimilationObservedAt a rdf:Property .
cea:receiptDigest a rdf:Property .
cea:duplicate a rdf:Property .
cea:orphaned a rdf:Property .
cea:refused a rdf:Property .
cea:refusalType a rdf:Property .
cea:thousandXAdmitted a rdf:Property .
