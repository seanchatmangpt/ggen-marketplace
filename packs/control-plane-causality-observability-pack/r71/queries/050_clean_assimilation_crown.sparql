PREFIX cea: <https://chatman.ai/ontology/causal-evidence-assimilation#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?s ?r WHERE { ?s a cea:ExternalSubject ; cea:subjectCurrent true ; cea:exactSubjectPresent true ; cea:independentEvidenceRoot true ; cea:qualificationPresent true ; cea:mergeContained true ; cea:replayVerified true ; cea:falsifierPassed true ; cea:standing "ALIVE" . ?r a cea:EvidenceReceipt ; cea:receiptPresent true ; cea:receiptCurrent true ; cea:receiptStanding "ALIVE" ; cea:causalLinkPresent true ; prov:wasDerivedFrom ?s . }