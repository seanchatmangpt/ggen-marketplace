PREFIX cea: <https://chatman.ai/ontology/causal-evidence-assimilation#>
SELECT ?run WHERE { ?run a cea:EvidenceAssimilationRun ; cea:thousandXAdmitted true . ?o a cea:AssimilationObservation ; cea:consumerFactor ?c ; cea:reuseFactor ?r ; cea:compositionFactor ?p . FILTER(?c < 10 || ?r < 10 || ?p < 10) }