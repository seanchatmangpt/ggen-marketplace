cpc:Consumer a prov:Entity .
cpc:QualifiedManufacturingAction a prov:Activity .
cpc:DependencyUnlock a prov:Entity .
cpc:Composition a prov:Entity .
cpc:YieldObservation a dqv:QualityMeasurement .
