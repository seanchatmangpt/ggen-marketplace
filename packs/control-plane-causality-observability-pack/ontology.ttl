@prefix cpc: <https://chatman.ai/ontology/control-plane-causality#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cpc:ControlPlaneCausalityPack a prov:Entity ; dcterms:title "Control-plane causality observability" ; cpc:authority "OBSERVE|VERIFY" ; cpc:consequentialDo false .
cpc:Request a prov:Entity .
cpc:WorkflowRun a prov:Activity .
cpc:Receipt a prov:Entity .
cpc:MemoryRecord a prov:Entity .
cpc:Observation a dqv:QualityMeasurement .
cpc:requestId a rdf:Property .
cpc:headSha a rdf:Property .
cpc:workflowName a rdf:Property .
cpc:relevantToRequest a rdf:Property .
cpc:queuedSeconds a rdf:Property .
cpc:latencySeconds a rdf:Property .
cpc:standing a rdf:Property .
cpc:current a rdf:Property .
cpc:terminal a rdf:Property .
cpc:receiptPresent a rdf:Property .
cpc:provenancePresent a rdf:Property .
cpc:exactSubjectPresent a rdf:Property .
cpc:actuationPerformed a rdf:Property .
cpc:itemCount a rdf:Property .
cpc:changed a rdf:Property .
cpc:concurrencyGroup a rdf:Property .
cpc:triggerPathMatched a rdf:Property .
cpc:independentEvidenceRoot a rdf:Property .
cpc:memoryKey a rdf:Property .
cpc:archived a rdf:Property .
cpc:contradicted a rdf:Property .
