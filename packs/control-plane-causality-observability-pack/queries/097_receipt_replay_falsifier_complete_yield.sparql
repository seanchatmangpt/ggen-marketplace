PREFIX cpc: <https://chatman.ai/ontology/control-plane-causality#>
SELECT ?action WHERE { ?action a cpc:QualifiedManufacturingAction ; cpc:qualificationReceiptPresent true ; cpc:replayVerified true ; cpc:falsifierPassed true ; cpc:currentEvidence true ; cpc:standing "ALIVE" ; cpc:actuationPerformed false . }
