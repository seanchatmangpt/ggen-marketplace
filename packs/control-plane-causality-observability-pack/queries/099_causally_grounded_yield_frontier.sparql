PREFIX cpc: <https://chatman.ai/ontology/control-plane-causality#>
SELECT ?yield ?value ?actions WHERE { ?yield a cpc:YieldObservation ; cpc:marginalYield ?value ; cpc:qualifiedActionsUnlocked ?actions ; cpc:currentEvidence true ; cpc:replayVerified true ; cpc:falsifierPassed true ; cpc:qualificationReceiptPresent true ; cpc:actuationPerformed false . FILTER(?actions > 0) }
