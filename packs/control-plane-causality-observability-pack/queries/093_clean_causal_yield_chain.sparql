PREFIX cpc: <https://chatman.ai/ontology/control-plane-causality#>
SELECT ?action ?consumer ?primitive WHERE { ?action a cpc:QualifiedManufacturingAction ; cpc:causedBy ?consumer ; cpc:currentEvidence true ; cpc:replayVerified true ; cpc:falsifierPassed true ; cpc:qualificationReceiptPresent true ; cpc:standing "ALIVE" ; cpc:actuationPerformed false . ?consumer a cpc:Consumer ; cpc:causedBy ?primitive ; cpc:independent true ; cpc:sameEvidenceRoot false . ?primitive a cpc:ReusablePrimitive ; cpc:standing "ALIVE" . }
