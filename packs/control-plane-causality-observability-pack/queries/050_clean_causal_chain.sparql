PREFIX cpc: <https://chatman.ai/ontology/control-plane-causality#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?request ?run ?receipt WHERE { ?request a cpc:Request ; cpc:requestId ?id ; cpc:current true . ?run a cpc:WorkflowRun ; cpc:requestId ?id ; cpc:relevantToRequest true ; cpc:terminal true ; prov:used ?request . ?receipt a cpc:Receipt ; cpc:requestId ?id ; cpc:standing "ALIVE" ; cpc:current true ; prov:wasGeneratedBy ?run . }
