PREFIX cpc: <https://chatman.ai/ontology/control-plane-causality#>
SELECT ?yield ?value WHERE { ?yield a cpc:YieldObservation ; cpc:marginalYield ?value ; cpc:currentEvidence true ; cpc:replayVerified true ; cpc:falsifierPassed true ; cpc:qualificationReceiptPresent true ; cpc:actuationPerformed false . FILTER(?value < 1) }
