PREFIX cpc: <https://chatman.ai/ontology/control-plane-causality#>
SELECT ?yield WHERE { ?yield a cpc:YieldObservation ; cpc:reuseFactor ?reuse ; cpc:consumerFactor ?consumer ; cpc:compositionFactor ?composition ; cpc:currentEvidence true ; cpc:replayVerified true ; cpc:falsifierPassed true ; cpc:qualificationReceiptPresent true ; cpc:actuationPerformed false . FILTER(?reuse >= 10 && ?consumer >= 10 && ?composition >= 10) }
