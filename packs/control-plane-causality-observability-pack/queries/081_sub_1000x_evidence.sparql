PREFIX cpc: <https://chatman.ai/ontology/control-plane-causality#>
SELECT ?yield ?reuse ?consumer ?composition WHERE { ?yield a cpc:YieldObservation ; cpc:reuseFactor ?reuse ; cpc:consumerFactor ?consumer ; cpc:compositionFactor ?composition . FILTER(?reuse < 10 || ?consumer < 10 || ?composition < 10) }
