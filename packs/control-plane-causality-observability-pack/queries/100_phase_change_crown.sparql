PREFIX cpc: <https://chatman.ai/ontology/control-plane-causality#>
SELECT ?yield ?value ?memoryMultiplier WHERE { ?yield a cpc:YieldObservation ; cpc:marginalYield ?value ; cpc:memoryMultiplier ?memoryMultiplier ; cpc:qualifiedActionsUnlocked ?actions ; cpc:currentEvidence true ; cpc:replayVerified true ; cpc:falsifierPassed true ; cpc:qualificationReceiptPresent true ; cpc:actuationPerformed false . FILTER(?actions > 0 && ?value > 0 && ?memoryMultiplier > 0) }
