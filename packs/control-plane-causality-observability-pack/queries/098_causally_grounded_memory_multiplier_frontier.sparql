PREFIX cpc: <https://chatman.ai/ontology/control-plane-causality#>
SELECT ?yield ?records ?unlocks ?multiplier WHERE { ?yield a cpc:YieldObservation ; cpc:memoryRecordsConsumed ?records ; cpc:memoryUnlocks ?unlocks ; cpc:memoryMultiplier ?multiplier ; cpc:currentEvidence true ; cpc:replayVerified true ; cpc:falsifierPassed true . FILTER(?records > 0 && ?unlocks > 0) }
