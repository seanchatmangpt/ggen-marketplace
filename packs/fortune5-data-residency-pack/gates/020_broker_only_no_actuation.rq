# MESSAGE: Fortune 5 data-residency law declares direct actuation, cross-border replication, or an unsafe provider pin
PREFIX f5dr: <http://seanchatmangpt.github.io/packs/fortune5-data-residency#>
SELECT ?subject ?field ?value WHERE {
  {
    ?subject f5dr:directActuation ?value .
    FILTER(?value != false)
    BIND("f5dr:directActuation" AS ?field)
  }
  UNION
  {
    ?subject a f5dr:ResidencyPolicy ;
             f5dr:forbidCrossBorderReplication ?value .
    FILTER(?value != true)
    BIND("f5dr:forbidCrossBorderReplication" AS ?field)
  }
  UNION
  {
    ?subject a f5dr:RegionPin ; f5dr:provider ?raw .
    FILTER(STR(?raw) NOT IN ("aws", "azure", "gcp"))
    BIND("f5dr:provider" AS ?field)
    BIND(STR(?raw) AS ?value)
  }
}
ORDER BY ?subject ?field
