@prefix f5dr: <http://seanchatmangpt.github.io/packs/fortune5-data-residency#> .

# Falsifier for gates/020 forbidCrossBorderReplication + SHACL hasValue true.

f5dr:bad-xborder-policy a f5dr:ResidencyPolicy ;
    f5dr:policyId "RES-BAD-XBORDER" ;
    f5dr:title "Open cross-border replication" ;
    f5dr:appliesToDataClass f5dr:Transactional ;
    f5dr:homeJurisdiction f5dr:US ;
    f5dr:allowedJurisdiction f5dr:EU ;
    f5dr:pinnedRegion f5dr:pin-us-east ;
    f5dr:forbidCrossBorderReplication false ;
    f5dr:evidenceRequired true ;
    f5dr:directActuation false .
