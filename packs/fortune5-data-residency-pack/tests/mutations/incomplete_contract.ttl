@prefix f5dr: <http://seanchatmangpt.github.io/packs/fortune5-data-residency#> .

# Gate 010 anti-vacuity: incomplete ResidencyPolicy (missing homeJurisdiction).
# Union with ontology.ttl must produce >=1 gate 010 row / SHACL non-conformance.

f5dr:incomplete-010-policy a f5dr:ResidencyPolicy ;
    f5dr:policyId "RES-INCOMPLETE-010" ;
    f5dr:title "Incomplete policy missing homeJurisdiction" ;
    f5dr:appliesToDataClass f5dr:Transactional ;
    f5dr:allowedJurisdiction f5dr:US ;
    f5dr:pinnedRegion f5dr:pin-us-east ;
    f5dr:forbidCrossBorderReplication true ;
    f5dr:evidenceRequired true ;
    f5dr:directActuation false .
