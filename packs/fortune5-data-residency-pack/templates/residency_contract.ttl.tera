---
to: "infrastructure/data/transactional/residency_contract.ttl"
force: true
sparql:
  programs: |
    PREFIX f5dr: <http://seanchatmangpt.github.io/packs/fortune5-data-residency#>
    SELECT ?programId ?catalogGroup ?catalogVersion ?directActuation
    WHERE {
      ?p a f5dr:ResidencyProgram ;
         f5dr:programId ?programId ;
         f5dr:catalogGroup ?catalogGroup ;
         f5dr:catalogVersion ?catalogVersion ;
         f5dr:directActuation ?directActuation .
    }
    ORDER BY ?programId
  policies: |
    PREFIX f5dr: <http://seanchatmangpt.github.io/packs/fortune5-data-residency#>
    SELECT ?policyId ?title ?dataClassId ?homeId ?allowedId ?regionId ?provider
           ?forbidXBorder ?evidence ?directActuation
    WHERE {
      ?pol a f5dr:ResidencyPolicy ;
           f5dr:policyId ?policyId ;
           f5dr:title ?title ;
           f5dr:appliesToDataClass ?dc ;
           f5dr:homeJurisdiction ?home ;
           f5dr:allowedJurisdiction ?allowed ;
           f5dr:pinnedRegion ?pin ;
           f5dr:forbidCrossBorderReplication ?forbidXBorder ;
           f5dr:evidenceRequired ?evidence ;
           f5dr:directActuation ?directActuation .
      ?dc f5dr:dataClassId ?dataClassId .
      ?home f5dr:jurisdictionId ?homeId .
      ?allowed f5dr:jurisdictionId ?allowedId .
      ?pin f5dr:regionId ?regionId ;
          f5dr:provider ?provider .
    }
    ORDER BY ?policyId
---
# GENERATED by ggen sync from fortune5-data-residency-pack — do not edit by hand.
# Flattened projection of admitted residency facts (broker-only; no secrets).
@prefix f5dr: <http://seanchatmangpt.github.io/packs/fortune5-data-residency#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

{% for row in policies -%}
f5dr:proj-dc-{{ row.dataClassId }} a f5dr:DataClass ;
    f5dr:dataClassId "{{ row.dataClassId }}" .

f5dr:proj-jurisdiction-{{ row.homeId }} a f5dr:Jurisdiction ;
    f5dr:jurisdictionId "{{ row.homeId }}" .

f5dr:proj-jurisdiction-{{ row.allowedId }} a f5dr:Jurisdiction ;
    f5dr:jurisdictionId "{{ row.allowedId }}" .

f5dr:proj-pin-{{ row.provider }}-{{ row.regionId }} a f5dr:RegionPin ;
    f5dr:regionId "{{ row.regionId }}" ;
    f5dr:provider "{{ row.provider }}" ;
    f5dr:homeJurisdiction f5dr:proj-jurisdiction-{{ row.homeId }} .

f5dr:proj-policy-{{ row.policyId }} a f5dr:ResidencyPolicy ;
    f5dr:policyId "{{ row.policyId }}" ;
    f5dr:title "{{ row.title }}" ;
    f5dr:appliesToDataClass f5dr:proj-dc-{{ row.dataClassId }} ;
    f5dr:homeJurisdiction f5dr:proj-jurisdiction-{{ row.homeId }} ;
    f5dr:allowedJurisdiction f5dr:proj-jurisdiction-{{ row.allowedId }} ;
    f5dr:pinnedRegion f5dr:proj-pin-{{ row.provider }}-{{ row.regionId }} ;
    f5dr:forbidCrossBorderReplication {{ row.forbidXBorder }} ;
    f5dr:evidenceRequired {{ row.evidence }} ;
    f5dr:directActuation {{ row.directActuation }} .
{% endfor %}

{% for row in programs -%}
f5dr:proj-program-{{ row.programId }} a f5dr:ResidencyProgram ;
    f5dr:programId "{{ row.programId }}" ;
    f5dr:catalogGroup "{{ row.catalogGroup }}" ;
    f5dr:catalogVersion "{{ row.catalogVersion }}" ;
    f5dr:directActuation {{ row.directActuation }} .
{% endfor %}
