@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix f5dr: <http://seanchatmangpt.github.io/packs/fortune5-data-residency#> .

# SHACL twin of gates/010_residency_contract.rq and gates/020_broker_only_no_actuation.rq.
# Path is shapes/f5dr.shacl.ttl (not root shapes.ttl — pack contract refuses that name).
# Manual: ggen graph validate --files ontology.ttl --shapes shapes/f5dr.shacl.ttl

f5dr:ResidencyProgramShape a sh:NodeShape ;
    sh:targetClass f5dr:ResidencyProgram ;
    sh:closed false ;
    sh:property [
        sh:path f5dr:programId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
        sh:message "ResidencyProgram missing programId" ;
    ] ;
    sh:property [
        sh:path f5dr:catalogGroup ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:hasValue "transaction-data" ;
        sh:message "ResidencyProgram catalogGroup must be transaction-data" ;
    ] ;
    sh:property [
        sh:path f5dr:catalogVersion ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
        sh:message "ResidencyProgram missing catalogVersion" ;
    ] ;
    sh:property [
        sh:path f5dr:hasPolicy ;
        sh:minCount 1 ; sh:class f5dr:ResidencyPolicy ;
        sh:message "ResidencyProgram must declare at least one ResidencyPolicy" ;
    ] ;
    sh:property [
        sh:path f5dr:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:message "ResidencyProgram directActuation must be false (broker-only)" ;
    ] ;
    sh:severity sh:Violation .

f5dr:ResidencyPolicyShape a sh:NodeShape ;
    sh:targetClass f5dr:ResidencyPolicy ;
    sh:closed false ;
    sh:property [
        sh:path f5dr:policyId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5dr:title ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5dr:appliesToDataClass ;
        sh:minCount 1 ; sh:class f5dr:DataClass ;
    ] ;
    sh:property [
        sh:path f5dr:homeJurisdiction ;
        sh:minCount 1 ; sh:class f5dr:Jurisdiction ;
    ] ;
    sh:property [
        sh:path f5dr:allowedJurisdiction ;
        sh:minCount 1 ; sh:class f5dr:Jurisdiction ;
    ] ;
    sh:property [
        sh:path f5dr:pinnedRegion ;
        sh:minCount 1 ; sh:class f5dr:RegionPin ;
    ] ;
    sh:property [
        sh:path f5dr:forbidCrossBorderReplication ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "forbidCrossBorderReplication must be true" ;
    ] ;
    sh:property [
        sh:path f5dr:evidenceRequired ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "evidenceRequired must be true" ;
    ] ;
    sh:property [
        sh:path f5dr:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:message "ResidencyPolicy directActuation must be false (broker-only)" ;
    ] ;
    sh:severity sh:Violation .

f5dr:RegionPinShape a sh:NodeShape ;
    sh:targetClass f5dr:RegionPin ;
    sh:property [
        sh:path f5dr:regionId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5dr:provider ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:in ( "aws" "azure" "gcp" ) ;
        sh:message "RegionPin provider must be aws, azure, or gcp" ;
    ] ;
    sh:property [
        sh:path f5dr:homeJurisdiction ;
        sh:minCount 1 ; sh:class f5dr:Jurisdiction ;
    ] ;
    sh:severity sh:Violation .

f5dr:JurisdictionShape a sh:NodeShape ;
    sh:targetClass f5dr:Jurisdiction ;
    sh:property [
        sh:path f5dr:jurisdictionId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:severity sh:Violation .

f5dr:DataClassShape a sh:NodeShape ;
    sh:targetClass f5dr:DataClass ;
    sh:property [
        sh:path f5dr:dataClassId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:severity sh:Violation .
