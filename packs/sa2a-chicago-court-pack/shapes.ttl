@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix chi: <urn:chicago:court:> .

chi:CourtShape a sh:NodeShape ;
    sh:targetClass chi:Court ;
    sh:property [
        sh:path chi:courtId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path chi:courtTitle ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:hasFalsifier ;
        sh:minCount 1 ;
    ] .

chi:FalsifierShape a sh:NodeShape ;
    sh:targetClass chi:Falsifier ;
    sh:property [
        sh:path chi:falsifierKind ;
        sh:in ("positive" "negative" "mutation") ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path chi:targetInvariant ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .
