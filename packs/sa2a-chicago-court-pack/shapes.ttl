@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix chi: <urn:chicago:court:> .

# SHACL shapes over the court corpus. These complement the SPARQL gates:
# gates refuse (ASK true = violation); shapes declare the structural contract
# a conforming corpus satisfies.

chi:CourtShape a sh:NodeShape ;
    sh:targetClass chi:Court ;
    sh:property [
        sh:path chi:courtId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path chi:courtTitle ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:modulePath ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:pattern "^lib/" ;
    ] ;
    sh:property [
        sh:path chi:referenceModule ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:hasScenario ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:hasFalsifier ;
        sh:minCount 1 ;
    ] .

chi:FalsifierShape a sh:NodeShape ;
    sh:targetClass chi:Falsifier ;
    sh:property [
        sh:path chi:falsifierId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[A-Z0-9-]+$" ;
    ] ;
    sh:property [
        sh:path chi:falsifierKind ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "positive_control" "negative" "mutation" ) ;
    ] ;
    sh:property [
        sh:path chi:targetInvariant ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:stimulus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:usesConfig ;
        sh:minCount 1 ;
    ] .

chi:ScenarioShape a sh:NodeShape ;
    sh:targetClass chi:Scenario ;
    sh:property [
        sh:path chi:scenarioName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:hasEvent ;
        sh:minCount 1 ;
    ] .

chi:TelemetryEventShape a sh:NodeShape ;
    sh:targetClass chi:TelemetryEvent ;
    sh:property [
        sh:path chi:eventName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:activity ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

chi:WireBenchShape a sh:NodeShape ;
    sh:targetClass chi:WireBench ;
    sh:property [
        sh:path chi:modulePath ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:hasScenario ;
        sh:minCount 1 ;
    ] .

chi:SuiteConfigShape a sh:NodeShape ;
    sh:targetClass chi:SuiteConfig ;
    sh:property [
        sh:path chi:suiteModule ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path chi:targetResource ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:principal ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:postStateAttribute ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:commandBusModule ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chi:grantModule ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .
