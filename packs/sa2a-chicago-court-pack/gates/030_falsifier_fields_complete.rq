# ASK true = violation (gate refuses). Evaluated over ontology.ttl.
# Every falsifier declares its id, kind, invariant, stimulus, and the
# SuiteConfig whose bindings execute it.
PREFIX chi: <urn:chicago:court:>
ASK {
  ?f a chi:Falsifier .
  {
    VALUES ?p { chi:falsifierId chi:falsifierKind chi:targetInvariant chi:stimulus chi:usesConfig }
    FILTER NOT EXISTS { ?f ?p ?v }
  }
  UNION
  {
    ?f chi:usesConfig ?config .
    FILTER NOT EXISTS { ?config a chi:SuiteConfig }
  }
}
