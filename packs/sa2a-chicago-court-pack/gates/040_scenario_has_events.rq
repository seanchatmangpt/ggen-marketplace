# ASK true = violation (gate refuses). Evaluated over ontology.ttl.
# Every court scenario declares at least one boundary telemetry event and a
# scenario name -- a scenario with no observable boundary is not falsifiable.
PREFIX chi: <urn:chicago:court:>
ASK {
  ?scenario a chi:Scenario .
  {
    FILTER NOT EXISTS { ?scenario chi:scenarioName ?name . FILTER(STRLEN(STR(?name)) > 0) }
  }
  UNION
  {
    FILTER NOT EXISTS {
      ?scenario chi:hasEvent ?event .
      ?event chi:activity ?activity . FILTER(STRLEN(STR(?activity)) > 0)
    }
  }
}
