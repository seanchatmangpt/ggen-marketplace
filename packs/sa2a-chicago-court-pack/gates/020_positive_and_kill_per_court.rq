# ASK true = violation (gate refuses). Evaluated over ontology.ttl.
# Completeness: every court carries at least one positive_control falsifier
# (the court must be able to pass on a lawful subject) and at least one
# negative kill (the court must be able to fail). A court that cannot fail is
# vacuous; a court that cannot pass is not a control.
PREFIX chi: <urn:chicago:court:>
ASK {
  ?court a chi:Court .
  {
    FILTER NOT EXISTS {
      ?court chi:hasFalsifier ?f .
      ?f chi:falsifierKind "positive_control" .
    }
  }
  UNION
  {
    FILTER NOT EXISTS {
      ?court chi:hasFalsifier ?f .
      ?f chi:falsifierKind "negative" .
    }
  }
}
