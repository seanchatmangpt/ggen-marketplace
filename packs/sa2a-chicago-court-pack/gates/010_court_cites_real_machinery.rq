# ASK true = violation (gate refuses). Evaluated over ontology.ttl.
# Every court must cite the real landed machinery it mirrors -- both the
# source path and the real module alias. A court with no referent is
# un-admissible prose, not a court.
PREFIX chi: <urn:chicago:court:>
ASK {
  ?court a chi:Court .
  {
    FILTER NOT EXISTS { ?court chi:modulePath ?path . FILTER(STRSTARTS(STR(?path), "lib/")) }
  }
  UNION
  {
    FILTER NOT EXISTS { ?court chi:referenceModule ?mod . FILTER(CONTAINS(STR(?mod), ".")) }
  }
}
