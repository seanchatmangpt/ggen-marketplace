# ASK true = violation (gate refuses). Evaluated over ontology.ttl.
# Every SuiteConfig carries the complete binding set the template renders:
# the target resource/capability/skill, principal, post-state attribute, app
# name, suite module, and every collaborator module. A missing binding would
# render an un-compilable or hardcoded suite.
PREFIX chi: <urn:chicago:court:>
ASK {
  ?config a chi:SuiteConfig .
  VALUES ?p {
    chi:suiteModule chi:targetResource chi:targetCapability chi:targetSkillSelector
    chi:principal chi:postStateAttribute chi:applicationName
    chi:agentModule chi:identityModule chi:infoModule chi:jsonModule
    chi:commandModule chi:commandBusModule chi:grantModule chi:brokerModule
    chi:receiptStoreModule chi:receiptModule chi:messageModule chi:partModule
    chi:plugModule chi:plugAuthModule chi:httpAuthSchemeModule
  }
  FILTER NOT EXISTS { ?config ?p ?v }
}
