# GENERATED FROM ggen-marketplace: sa2a-chicago-court-pack
# Pure pack-deployed Chicago adversarial test suite. Zero mocks, real collaborators.

ExUnit.start()

defmodule AshA2A.PackDeployed.ChicagoCourtTest do
  use ExUnit.Case, async: false

  @moduledoc """
  Chicago Court test generated purely from sa2a-chicago-court-pack.
  Exercises real TwoPortGate conjunct masks, exact-SHA receipts, and offline replay verification.
  """

  alias AshA2A.Authority.{Lease, TwoPortGate}
  alias AshA2A.{Command, Receipt, SemanticSubject}
  alias AshA2A.Receipt.OfflineReplay

  @ga "sha256:" <> String.duplicate("a", 64)
  @gb "sha256:" <> String.duplicate("b", 64)
  @gc "sha256:" <> String.duplicate("c", 64)

  defp make_subject do
    {:ok, subj} =
      SemanticSubject.new(
        graph_digest: @ga,
        projection_digest: @gb,
        manufacturer_digest: @gc,
        ephemeral?: false
      )
    subj
  end

  defp make_command do
    Command.new("AshA2A.Test.Fixture.Echo.read",
      command_id: "two-port-pack-1",
      agent_id: "pack-agent",
      principal_id: "p-pack",
      task_id: "task-pack-1",
      semantic_subject: make_subject(),
      scope: %{resource: "Echo", action: "read"}
    )
  end

  defp make_keypair do
    # Real 32-byte Ed25519 seed
    :crypto.generate_key(:eddsa, :ed25519)
  end

  describe "Pack-Deployed Court CHI-DEPLOY-BRCE" do
    test "positive falsifier: Valid leased actuation passes TwoPortGate without refusal" do
      {pub, priv} = make_keypair()
      cmd = make_command()

      {:ok, lease} =
        Lease.issue(
          command: cmd,
          principal_id: "p-pack",
          private_key: priv,
          public_key: pub,
          duration_ms: 60_000
        )

      result = TwoPortGate.evaluate(cmd, lease, lease_public_key: pub)
      assert result == :admitted
    end

    test "negative falsifier: Scope mismatch fails TwoPortGate with mask 0x1" do
      {pub, priv} = make_keypair()
      cmd = make_command()

      # Tamper with scope on command
      tampered_cmd = %{cmd | scope: %{resource: "Tampered", action: "write"}}

      {:ok, lease} =
        Lease.issue(
          command: cmd,
          principal_id: "p-pack",
          private_key: priv,
          public_key: pub,
          duration_ms: 60_000
        )

      result = TwoPortGate.evaluate(tampered_cmd, lease, lease_public_key: pub)
      assert {:error, {:refused_lease, mask, %{codes: codes}}} = result
      assert Bitwise.band(mask, 0x1) == 0x1
      assert :lease_scope_mismatch in codes
    end

    test "mutation falsifier: Mutated receipt fails exact-SHA offline replay" do
      receipt = %Receipt{
        command_id: "cmd-pack-1",
        exact_subject: %{sha: "subject-sha-123"},
        authority_claims: ["claim-1"],
        standing: :admitted,
        receipt_digest: "sha256:" <> String.duplicate("0", 64)
      }

      # Compute actual canonical digest
      computed_digest = Receipt.compute_digest(receipt)
      valid_receipt = %{receipt | receipt_digest: computed_digest}

      # Valid receipt verifies cleanly
      assert {:ok, :verified} = OfflineReplay.verify_receipt(valid_receipt)

      # Tampered receipt fails replay
      mutated_receipt = %{valid_receipt | standing: :refused}
      assert {:error, :digest_mismatch} = OfflineReplay.verify_receipt(mutated_receipt)
    end
  end
end
