  @tag court: "{{ r["courtId"] }}"
  @tag falsifier: "{{ r["falsifierId"] }}"
  test "{{ r["falsifierId"] }} positive control: authenticated send completes and the row is visible", %{
    plug: plug,
    plug_auth: plug_auth,
    http_auth_scheme: http_auth_scheme,
    info: info,
    grant: grant,
    identity: identity,
    message: message,
    part: part,
    json: json
  } do
    unique = System.unique_integer([:positive])
    broker_name = Module.concat(__MODULE__, "WireBroker#{unique}")
    agent_name = Module.concat(__MODULE__, "WireAgent#{unique}")
    broker = @broker
    app = @application

    # Wire courts swap the real authority broker in app env (the wire bench
    # pattern) and restore the prior value afterwards.
    previous = Application.get_env(app, :authority_broker)
    Application.put_env(app, :authority_broker, {broker, [name: broker_name]})
    {:ok, broker_pid} = broker.start_link(name: broker_name)
    {:ok, agent_pid} = TargetAgent.start_link(name: agent_name)

    on_exit(fn ->
      if Process.alive?(agent_pid), do: GenServer.stop(agent_pid, :normal)
      if Process.alive?(broker_pid), do: GenServer.stop(broker_pid, :normal)

      case previous do
        nil -> Application.delete_env(app, :authority_broker)
        value -> Application.put_env(app, :authority_broker, value)
      end
    end)

    {:ok, skill} = info.skill(@wire_resource, @wire_skill_name)
    capability = skill.id

    # Real standing grant for the transport-verified principal.
    {:ok, _authority} = grant.grant(identity.principal(@wire_principal), capability)

    token = "wire-bearer-#{unique}"

    auth =
      plug_auth.init(
        schemes: %{"bearer_auth" => struct(http_auth_scheme, scheme: "bearer")},
        verify: fn "bearer_auth", ^token, _conn -> {:ok, @wire_principal} end
      )

    label = unique_label()

    wire_message =
      %{message.new_user([part.new(%{@post_attribute => label})]) | metadata: %{"skill" => @wire_skill_name}}

    body =
      Jason.encode!(%{
        "jsonrpc" => "2.0",
        "id" => unique,
        "method" => "message/send",
        "params" => %{"message" => json.encode!(wire_message)}
      })

    conn =
      Plug.Test.conn(:post, "/", body)
      |> Plug.Conn.put_req_header("content-type", "application/json")
      |> Plug.Conn.put_req_header("authorization", "Bearer " <> token)
      |> plug_auth.call(auth)
      |> then(fn %Plug.Conn{} = conn ->
        if conn.halted do
          conn
        else
          plug.call(conn, plug.init(agent: agent_name, base_url: "http://127.0.0.1/a2a"))
        end
      end)

    decoded =
      case Jason.decode(conn.resp_body || "") do
        {:ok, map} when is_map(map) -> map
        _ -> nil
      end

    assert conn.status == 200
    assert wire_task_state(decoded) == "TASK_STATE_COMPLETED"
    assert wire_row_present?(label)
  end

