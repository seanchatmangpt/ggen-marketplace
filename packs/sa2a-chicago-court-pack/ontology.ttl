@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix chi: <urn:chicago:court:> .

<urn:chicago:court>
    a owl:Ontology ;
    rdfs:label "Chicago Adversarial Court Ontology" ;
    rdfs:comment "Formal structure for Chicago-style adversarial qualification courts." .

# --- Classes ---
chi:Court a rdfs:Class ;
    rdfs:label "Adversarial Court" ;
    rdfs:comment "A qualification court verifying architectural invariants via falsification." .

chi:Falsifier a rdfs:Class ;
    rdfs:label "Falsifier" ;
    rdfs:comment "A specific attack vector attempting to break an invariant." .

chi:Gate a rdfs:Class ;
    rdfs:label "Crown Gate" ;
    rdfs:comment "An RFC-SA2A-002 numbered gate verification boundary." .

# --- Properties ---
chi:courtId a rdf:Property ;
    rdfs:domain chi:Court ;
    rdfs:range xsd:string .

chi:courtTitle a rdf:Property ;
    rdfs:domain chi:Court ;
    rdfs:range xsd:string .

chi:hasGate a rdf:Property ;
    rdfs:domain chi:Court ;
    rdfs:range chi:Gate .

chi:hasFalsifier a rdf:Property ;
    rdfs:domain chi:Court ;
    rdfs:range chi:Falsifier .

chi:falsifierKind a rdf:Property ;
    rdfs:domain chi:Falsifier ;
    rdfs:range xsd:string . # "positive", "negative", "mutation"

chi:targetInvariant a rdf:Property ;
    rdfs:domain chi:Falsifier ;
    rdfs:range xsd:string .

# --- Concrete Court Instance (Full Deployment Pack Test) ---
chi:CourtBRCE a chi:Court ;
    chi:courtId "CHI-DEPLOY-BRCE" ;
    chi:courtTitle "Pack-Deployed Full Chicago BRCE Actuation & Evidence Court" ;
    chi:hasGate chi:Gate11 ;
    chi:hasFalsifier chi:FalsifierPos, chi:FalsifierNeg, chi:FalsifierMut .

chi:Gate11 a chi:Gate ;
    rdfs:label "Gate 11: Fresh-Consumer Proof and Consequence Boundary" .

chi:FalsifierPos a chi:Falsifier ;
    chi:falsifierKind "positive" ;
    chi:targetInvariant "Valid leased actuation produces exact-SHA receipt and OCEL event" .

chi:FalsifierNeg a chi:Falsifier ;
    chi:falsifierKind "negative" ;
    chi:targetInvariant "Unleased actuation is refused at Two-Port Gate without side effects" .

chi:FalsifierMut a chi:Falsifier ;
    chi:falsifierKind "mutation" ;
    chi:targetInvariant "Tampered receipt digest fails offline replay court verification" .
