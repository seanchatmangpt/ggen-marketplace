# One row per falsifier, joined to its court and SuiteConfig bindings.
# Every template variable comes from these bindings; the template contains no
# literal module names (gates/000 enforces this).
PREFIX chi: <urn:chicago:court:>
SELECT ?suiteModule ?targetResource ?targetCapability ?targetSkillSelector
       ?principal ?postStateAttribute ?applicationName
       ?agentModule ?identityModule ?infoModule ?jsonModule ?commandModule ?commandBusModule
       ?grantModule ?brokerModule ?receiptStoreModule ?receiptModule
       ?messageModule ?partModule ?plugModule ?plugAuthModule ?httpAuthSchemeModule
       ?courtId ?courtTitle ?courtModule
       ?falsifierId ?falsifierKind ?invariant ?stimulus
WHERE {
  ?falsifier a chi:Falsifier ;
      chi:falsifierId ?falsifierId ;
      chi:falsifierKind ?falsifierKind ;
      chi:targetInvariant ?invariant ;
      chi:stimulus ?stimulus ;
      chi:usesConfig ?config .
  ?court a chi:Court ;
      chi:courtId ?courtId ;
      chi:courtTitle ?courtTitle ;
      chi:modulePath ?courtModule ;
      chi:hasFalsifier ?falsifier .
  ?config a chi:SuiteConfig ;
      chi:suiteModule ?suiteModule ;
      chi:targetResource ?targetResource ;
      chi:targetCapability ?targetCapability ;
      chi:targetSkillSelector ?targetSkillSelector ;
      chi:principal ?principal ;
      chi:postStateAttribute ?postStateAttribute ;
      chi:applicationName ?applicationName ;
      chi:agentModule ?agentModule ;
      chi:identityModule ?identityModule ;
      chi:infoModule ?infoModule ;
      chi:jsonModule ?jsonModule ;
      chi:commandModule ?commandModule ;
      chi:commandBusModule ?commandBusModule ;
      chi:grantModule ?grantModule ;
      chi:brokerModule ?brokerModule ;
      chi:receiptStoreModule ?receiptStoreModule ;
      chi:receiptModule ?receiptModule ;
      chi:messageModule ?messageModule ;
      chi:partModule ?partModule ;
      chi:plugModule ?plugModule ;
      chi:plugAuthModule ?plugAuthModule ;
      chi:httpAuthSchemeModule ?httpAuthSchemeModule .
}
ORDER BY ?courtId ?falsifierId
