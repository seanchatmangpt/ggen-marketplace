PREFIX chi: <urn:chicago:court:>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?courtId ?courtTitle ?falsifierKind ?targetInvariant
WHERE {
    ?court a chi:Court ;
           chi:courtId ?courtId ;
           chi:courtTitle ?courtTitle ;
           chi:hasFalsifier ?falsifier .
    ?falsifier chi:falsifierKind ?falsifierKind ;
               chi:targetInvariant ?targetInvariant .
}
ORDER BY ?courtId ?falsifierKind
