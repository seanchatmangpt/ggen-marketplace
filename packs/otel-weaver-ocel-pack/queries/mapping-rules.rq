PREFIX otelocel: <https://chatmangpt.com/ontology/otel-weaver-ocel#>
SELECT ?order ?identifier ?slug ?sourceField ?targetField ?derivation ?witness
WHERE {
  ?rule a otelocel:MappingRule ;
    otelocel:order ?order ;
    otelocel:identifier ?identifier ;
    otelocel:slug ?slug ;
    otelocel:sourceField ?sourceField ;
    otelocel:targetField ?targetField ;
    otelocel:derivation ?derivation ;
    otelocel:witness ?witness .
}
ORDER BY ?order
