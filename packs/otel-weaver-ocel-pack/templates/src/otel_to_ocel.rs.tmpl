/// Minimal real OTEL span shape this transformer consumes. Field names mirror
/// the OTLP span proto (trace_id/span_id/parent_span_id/name/start_time_unix_nano/
/// attributes) closely enough to be filled directly from a decoded OTLP span or
/// from chicago-tdd-tools' weaver live-check span samples.
#[derive(Debug, Clone)]
pub struct OtelSpan {
    pub trace_id: String,
    pub span_id: String,
    /// OTLP parent_span_id, when this span is not a trace root. `None` (or an
    /// empty string, per OTLP's all-zero-bytes root convention) means this
    /// span has no parent within the trace. Threaded into a real
    /// `child_of`/`parent_span_of` O2O relationship pair (rule
    /// RelationshipChildOfParentSpan) so downstream DFG/Petri-net discovery
    /// gets genuine causal parent/child ordering instead of inferring
    /// sequence purely from start_time, which fabricates sibling-to-sibling
    /// precedence edges among spans that share a parent.
    pub parent_span_id: Option<String>,
    pub name: String,
    pub start_time: DateTime<FixedOffset>,
    pub attributes: Vec<(String, OtelAttributeValue)>,
    pub resource_attributes: Vec<(String, OtelAttributeValue)>,
}

#[derive(Debug, Clone)]
pub enum OtelAttributeValue {
    Str(String),
    Int(i64),
    Float(f64),
    Bool(bool),
}

impl From<OtelAttributeValue> for OCELAttributeValue {
    fn from(v: OtelAttributeValue) -> Self {
        match v {
            OtelAttributeValue::Str(s) => OCELAttributeValue::String(s),
            OtelAttributeValue::Int(i) => OCELAttributeValue::Integer(i),
            OtelAttributeValue::Float(f) => OCELAttributeValue::Float(f),
            OtelAttributeValue::Bool(b) => OCELAttributeValue::Boolean(b),
        }
    }
}

/// Secret-shaped key fragments this scrub denies on the attribute *name*
/// (case-insensitive substring match). Mirrors this repo's prior secret-leak
/// incident (span attributes copied verbatim into OCEL with no redaction --
/// CISO finding, 2026-08).
const DENYLISTED_KEY_FRAGMENTS: &[&str] = &[
    "api_key",
    "apikey",
    "api-key",
    "secret",
    "password",
    "passwd",
    "token",
    "bearer",
    "authorization",
    "auth_",
    "private_key",
    "access_key",
    "session_id",
    "sessionid",
    "credential",
    "client_secret",
    "ssh_key",
    "cookie",
];

/// Max chars kept for any single attribute value copied into OCEL. Anything
/// longer is truncated -- caps both accidental blob leakage and payload
/// bloat from oversized span attributes.
const MAX_ATTRIBUTE_VALUE_LEN: usize = 256;

/// Minimum length a token must reach before it is even considered for the
/// high-entropy secret check (short strings can't carry enough entropy to
/// matter and would false-positive constantly).
const HIGH_ENTROPY_MIN_LEN: usize = 20;

fn key_is_denylisted(name: &str) -> bool {
    let lower = name.to_ascii_lowercase();
    DENYLISTED_KEY_FRAGMENTS
        .iter()
        .any(|frag| lower.contains(frag))
}

/// Detects a base64/hex-shaped run of characters at least
/// `HIGH_ENTROPY_MIN_LEN` long with a character-class mix consistent with a
/// generated secret (as opposed to prose or a URL): mixed case + digits, or
/// pure hex/base64 alphabet at length. Heuristic, not a proof -- paired with
/// the key-name denylist and length cap as defense in depth, not a
/// substitute for either.
fn looks_high_entropy(value: &str) -> bool {
    let candidate = value.trim();
    if candidate.len() < HIGH_ENTROPY_MIN_LEN {
        return false;
    }
    let is_token_charset = candidate
        .chars()
        .all(|c| c.is_ascii_alphanumeric() || c == '+' || c == '/' || c == '=' || c == '-' || c == '_');
    if !is_token_charset {
        return false;
    }
    let has_upper = candidate.chars().any(|c| c.is_ascii_uppercase());
    let has_lower = candidate.chars().any(|c| c.is_ascii_lowercase());
    let has_digit = candidate.chars().any(|c| c.is_ascii_digit());
    let has_no_whitespace = !candidate.chars().any(|c| c.is_ascii_whitespace());
    has_no_whitespace && ((has_upper && has_lower) || (has_upper && has_digit) || (has_lower && has_digit))
        && (has_upper as u8 + has_lower as u8 + has_digit as u8) >= 2
}

/// Applies the CISO-flagged secret-redaction scrub to a single OTEL span
/// attribute before it is admitted into OCEL. Runs on both the key
/// (denylist) and the value (denylist-by-key, high-entropy detection, and a
/// hard length cap), so a secret is blocked whether it leaked via a
/// suspicious key name, a suspicious value shape, or an oversized blob.
fn redact_attribute_value(name: &str, value: OtelAttributeValue) -> OtelAttributeValue {
    match value {
        OtelAttributeValue::Str(s) => {
            if key_is_denylisted(name) {
                return OtelAttributeValue::Str("[REDACTED]".to_string());
            }
            let lower_name = name.to_ascii_lowercase();
            let integrity_value = lower_name.ends_with("_hash")
                || lower_name.ends_with("_digest")
                || lower_name.ends_with(".hash")
                || lower_name.ends_with(".digest");
            if looks_high_entropy(&s) && !integrity_value {
                return OtelAttributeValue::Str("[REDACTED:high-entropy]".to_string());
            }
            if s.len() > MAX_ATTRIBUTE_VALUE_LEN {
                let mut truncated: String = s.chars().take(MAX_ATTRIBUTE_VALUE_LEN).collect();
                truncated.push_str("...[TRUNCATED]");
                return OtelAttributeValue::Str(truncated);
            }
            OtelAttributeValue::Str(s)
        }
        // Non-string values (Int/Float/Bool) carry no free-text secret
        // surface -- key-name denylist still applies via the caller if the
        // key itself is suspicious, but the value has no scrubbable shape.
        other => {
            if key_is_denylisted(name) {
                return OtelAttributeValue::Str("[REDACTED]".to_string());
            }
            other
        }
    }
}

#[derive(Debug, Default)]
struct SemanticObjectSpec {
    id: Option<String>,
    object_type: Option<String>,
    qualifier: Option<String>,
    attributes: Vec<(String, OtelAttributeValue)>,
}

fn string_span_attribute(
    attributes: &[(String, OtelAttributeValue)],
    name: &str,
) -> Option<String> {
    attributes.iter().find_map(|(key, value)| {
        if key != name {
            return None;
        }
        match value {
            OtelAttributeValue::Str(value) if !value.trim().is_empty() => {
                Some(value.clone())
            }
            _ => None,
        }
    })
}

/// Generic semantic override profile.
///
/// Any producer may attach:
/// - ocel.event.id / ocel.event.type
/// - ocel.object.<slot>.id
/// - ocel.object.<slot>.type
/// - ocel.object.<slot>.qualifier
/// - ocel.object.<slot>.attr.<name>
///
/// Complete object slots become domain objects and qualified event-object
/// links.  The profile is generic: manufacturing, incident, finance, or any
/// other domain can project its admitted identities without this transformer
/// learning a domain-specific vocabulary.
fn semantic_object_projection(
    attributes: &[(String, OtelAttributeValue)],
    start_time: &DateTime<FixedOffset>,
) -> (Vec<OCELObject>, Vec<OCELRelationship>) {
    let mut slots: BTreeMap<String, SemanticObjectSpec> = BTreeMap::new();

    for (name, value) in attributes {
        let Some(rest) = name.strip_prefix("ocel.object.") else {
            continue;
        };
        let mut parts = rest.splitn(3, '.');
        let Some(slot) = parts.next() else {
            continue;
        };
        let Some(field) = parts.next() else {
            continue;
        };
        let tail = parts.next();
        let spec = slots.entry(slot.to_string()).or_default();

        match (field, tail, value) {
            ("id", _, OtelAttributeValue::Str(value)) if !value.trim().is_empty() => {
                spec.id = Some(value.clone());
            }
            ("type", _, OtelAttributeValue::Str(value)) if !value.trim().is_empty() => {
                spec.object_type = Some(value.clone());
            }
            ("qualifier", _, OtelAttributeValue::Str(value))
                if !value.trim().is_empty() =>
            {
                spec.qualifier = Some(value.clone());
            }
            ("attr", Some(attribute_name), _) if !attribute_name.trim().is_empty() => {
                spec.attributes
                    .push((attribute_name.to_string(), value.clone()));
            }
            _ => {}
        }
    }

    let mut objects = Vec::new();
    let mut relationships = Vec::new();
    for (_, spec) in slots {
        let (Some(id), Some(object_type)) = (spec.id, spec.object_type) else {
            continue;
        };
        if let Some(qualifier) = spec.qualifier {
            relationships.push(OCELRelationship {
                object_id: id.clone(),
                qualifier,
            });
        }
        let object_attributes = spec
            .attributes
            .into_iter()
            .map(|(name, value)| OCELObjectAttribute {
                name: name.clone(),
                value: redact_attribute_value(&name, value).into(),
                time: start_time.clone(),
            })
            .collect();
        objects.push(OCELObject {
            id,
            object_type,
            attributes: object_attributes,
            relationships: vec![],
        });
    }
    (objects, relationships)
}

/// The named admission law this boundary enforces: a span must carry a
/// non-empty `name` (rule EventType, order 20) to become an OCEL v2 activity
/// label, and must carry a `service.name` resource attribute (rule
/// ObjectFromServiceName, order 50) so the event can be linked to a real
/// object. A bare "invalid input" is never returned -- the specific missing
/// field is named.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum OtelSpanRefusal {
    MissingSpanName,
    MissingServiceNameResourceAttribute,
}

/// One admitted OCEL v2 event plus the objects/relationships derived
/// alongside it (rules ObjectFromServiceName/ObjectFromTraceId/
/// RelationshipPerformedBy/RelationshipPartOfTrace).
#[derive(Debug, Clone)]
pub struct OcelProjection {
    pub event: OCELEvent,
    pub objects: Vec<OCELObject>,
}

/// The `Admit` boundary for this transformer, per wasm4pm-compat's admission
/// contract (admission.rs `Admit` trait): the only sanctioned path from Raw
/// OTEL-span evidence to Admitted OCEL v2 evidence.
pub enum OtelToOcel {}

impl Admit for OtelToOcel {
    type Raw = OtelSpan;
    type Admitted = OcelProjection;
    type Reason = OtelSpanRefusal;
    type Witness = Ocel20;

    fn admit(
        raw: Evidence<OtelSpan, Raw, Ocel20>,
    ) -> Result<Admission<OcelProjection, Ocel20>, Refusal<OtelSpanRefusal, Ocel20>> {
        let span = raw.value;

        // Rule EventType (order 20): activity = span.name, must be non-empty.
        if span.name.trim().is_empty() {
            return Err(Refusal::new(OtelSpanRefusal::MissingSpanName));
        }

        // Rule ObjectFromServiceName (order 50): object type "service",
        // derived from the resource.attributes["service.name"] value.
        let service_name = span
            .resource_attributes
            .iter()
            .find(|(k, _)| k == "service.name")
            .and_then(|(_, v)| match v {
                OtelAttributeValue::Str(s) => Some(s.clone()),
                _ => None,
            });
        let Some(service_name) = service_name else {
            return Err(Refusal::new(
                OtelSpanRefusal::MissingServiceNameResourceAttribute,
            ));
        };

        // Generic semantic overrides are optional.  When absent the exact
        // legacy trace/span mapping remains the fallback.
        let semantic_event_id =
            string_span_attribute(&span.attributes, "ocel.event.id");
        let semantic_event_type =
            string_span_attribute(&span.attributes, "ocel.event.type");
        let (semantic_objects, semantic_relationships) =
            semantic_object_projection(&span.attributes, &span.start_time);

        // Rule EventId + EventIdOverride.
        let event_id = semantic_event_id
            .unwrap_or_else(|| format!("{}:{}", span.trace_id, span.span_id));
        let service_object_id = format!("service:{}", service_name);
        let trace_object_id = format!("trace:{}", span.trace_id);

        // Projection-control attributes are consumed as control metadata and
        // do not leak back into the domain event's ordinary attribute set.
        let attributes: Vec<OCELEventAttribute> = span
            .attributes
            .iter()
            .filter(|(name, _)| !name.starts_with("ocel."))
            .cloned()
            .map(|(name, value)| {
                let scrubbed = redact_attribute_value(&name, value);
                OCELEventAttribute {
                    name,
                    value: scrubbed.into(),
                }
            })
            .collect();

        // Rules RelationshipPerformedBy (order 70) / RelationshipPartOfTrace (order 80).
        let mut relationships = vec![
            OCELRelationship {
                object_id: service_object_id.clone(),
                qualifier: "performed_by".to_string(),
            },
            OCELRelationship {
                object_id: trace_object_id.clone(),
                qualifier: "part_of_trace".to_string(),
            },
        ];
        relationships.extend(semantic_relationships);

        // Rule RelationshipChildOfParentSpan (order 90): when this span carries
        // a non-empty parent_span_id, record a real causal edge to the parent
        // span's event id ("{trace_id}:{parent_span_id}"). This is the fix for
        // the CISO/process-mining finding that OtelSpan discarded
        // parent_span_id entirely, leaving downstream DFG/Petri-net discovery
        // to infer sequence purely from start_time -- which fabricates
        // sibling-to-sibling precedence edges among spans that share one
        // parent. object_id here references another EVENT's id, not an
        // object -- a deliberate, minimal extension of the O2O relationship
        // shape rather than a new event-to-event schema field.
        if let Some(parent_span_id) = span.parent_span_id.as_deref() {
            if !parent_span_id.trim().is_empty() {
                let parent_event_id = format!("{}:{}", span.trace_id, parent_span_id);
                relationships.push(OCELRelationship {
                    object_id: parent_event_id,
                    qualifier: "child_of_span".to_string(),
                });
            }
        }

        // Rule EventActivityCapability (order 45): when the (already redacted)
        // attributes carry a beam4pm.capability.id value, it is the more
        // specific OCEL activity label -- prefer it over the bare span.name.
        // Looked up in the already-built `attributes` vec (rule EventAttributes,
        // order 40) rather than re-deriving from raw span.attributes a second
        // time, so this introduces no second event-attribute copy path.
        let event_type = semantic_event_type.unwrap_or_else(|| {
            attributes
                .iter()
                .find(|a| a.name == "beam4pm.capability.id")
                .and_then(|a| match &a.value {
                    OCELAttributeValue::String(s) if !s.trim().is_empty() => Some(s.clone()),
                    _ => None,
                })
                .unwrap_or_else(|| span.name.clone())
        });

        // Rule EventTime (order 30): time = span start time.
        let event = OCELEvent {
            id: event_id,
            event_type,
            time: span.start_time,
            attributes,
            relationships,
        };

        let mut objects = vec![
            OCELObject {
                id: service_object_id,
                object_type: "service".to_string(),
                attributes: vec![],
                relationships: vec![],
            },
            OCELObject {
                id: trace_object_id,
                object_type: "trace".to_string(),
                attributes: vec![],
                relationships: vec![],
            },
        ];
        objects.extend(semantic_objects);

        Ok(Admission::new(OcelProjection { event, objects }))
    }
}

/// Convenience entry point: admits a raw `OtelSpan` and returns Admitted
/// wasm4pm-compat Evidence carrying the derived OCEL v2 projection, or the
/// named refusal.
pub fn otel_span_to_ocel_evidence(
    span: OtelSpan,
) -> Result<
    Evidence<OcelProjection, wasm4pm_compat::state::Admitted, Ocel20>,
    Refusal<OtelSpanRefusal, Ocel20>,
> {
    let raw = Evidence::raw(span);
    OtelToOcel::admit(raw).map(Admission::into_evidence)
}
