# MESSAGE: every aic:Field's aic:fieldType must be one of the 8 admitted enum values; any row is a refusal.
PREFIX aic: <https://ggen.dev/ontology/beam4pm-ai#>
SELECT ?subject ?value WHERE {
  ?subject a aic:Field ; aic:fieldType ?value .
  FILTER(STR(?value) NOT IN ("string", "integer", "float", "boolean", "datetime", "atom", "list_string", "map"))
}
ORDER BY ?subject
