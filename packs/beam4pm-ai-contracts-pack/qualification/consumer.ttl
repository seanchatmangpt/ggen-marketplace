# Synthetic consumer fixture for isolated qualification of
# beam4pm-ai-contracts-pack. Every codec-test template
# (beam4pm_ai_contracts_codec_tests.erl.tmpl /
# beam4pm_ai_contracts_codec_test.exs.tmpl) takes `req_fields | first` to
# build its missing-field/invalid-json fixtures -- so an EMPTY consumer
# graph fails render outright (real FM-TPL-017 in the qualify harness:
# "Variable `mf.record_name` not found ... records (array, 0 items), fields
# (array, 0 items), results (array, 0 items)"), which is exactly the
# failure this fixture exists to admit against. Mirrors
# beam4pm-process-model-pack/qualification/consumer.ttl's own fix for the
# identical FM-TPL-017 class of failure.
#
# Per this pack's own ontology.ttl and pack.toml: consumer contract-type
# individuals are NOT declared in the pack itself (vocabulary only) -- the
# consuming project's own ontology.ttl (e.g. beam4pm) supplies them. This
# fixture supplies two of the seven canonical AI-contract data shapes named
# in pack.toml's own description (evidence_envelope, research_task) as a
# minimal, realistic, isolated qualification graph -- enough to exercise
# every field-type branch each template renders (string, integer, float,
# boolean, datetime, atom, list_string, map) and to give
# `req_fields | first` a real required field to bind.
@prefix aic: <https://ggen.dev/ontology/beam4pm-ai#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aic:evidence_envelope_rt a aic:ContractType ;
    aic:contractName "evidence_envelope" ;
    aic:contractDoc "One admitted, sourced observation supporting a candidate claim." ;
    aic:hasField aic:evidence_envelope_evidence_id_f ,
                 aic:evidence_envelope_source_uri_f ,
                 aic:evidence_envelope_confidence_f ,
                 aic:evidence_envelope_observed_at_f ,
                 aic:evidence_envelope_verified_f ,
                 aic:evidence_envelope_tags_f .

aic:evidence_envelope_evidence_id_f a aic:Field ;
    aic:fieldName "evidence_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Unique evidence identifier." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 1 .

aic:evidence_envelope_source_uri_f a aic:Field ;
    aic:fieldName "source_uri" ;
    aic:fieldType "string" ;
    aic:fieldDoc "URI of the sourced observation." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 2 .

aic:evidence_envelope_confidence_f a aic:Field ;
    aic:fieldName "confidence" ;
    aic:fieldType "float" ;
    aic:fieldDoc "Confidence score in [0.0, 1.0]." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 3 .

aic:evidence_envelope_observed_at_f a aic:Field ;
    aic:fieldName "observed_at" ;
    aic:fieldType "datetime" ;
    aic:fieldDoc "ISO8601 timestamp the evidence was observed." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 4 .

aic:evidence_envelope_verified_f a aic:Field ;
    aic:fieldName "verified" ;
    aic:fieldType "boolean" ;
    aic:fieldDoc "Whether this evidence has been independently verified." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 5 .

aic:evidence_envelope_tags_f a aic:Field ;
    aic:fieldName "tags" ;
    aic:fieldType "list_string" ;
    aic:fieldDoc "Free-form classification tags." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 6 .

aic:research_task_rt a aic:ContractType ;
    aic:contractName "research_task" ;
    aic:contractDoc "One admitted unit of research work with its execution status and attributes." ;
    aic:hasField aic:research_task_task_id_f ,
                 aic:research_task_status_f ,
                 aic:research_task_priority_f ,
                 aic:research_task_metadata_f .

aic:research_task_task_id_f a aic:Field ;
    aic:fieldName "task_id" ;
    aic:fieldType "string" ;
    aic:fieldDoc "Unique task identifier." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 1 .

aic:research_task_status_f a aic:Field ;
    aic:fieldName "status" ;
    aic:fieldType "atom" ;
    aic:fieldDoc "Current task status." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 2 .

aic:research_task_priority_f a aic:Field ;
    aic:fieldName "priority" ;
    aic:fieldType "integer" ;
    aic:fieldDoc "Relative priority; lower runs first." ;
    aic:fieldRequired "true" ;
    aic:fieldOrder 3 .

aic:research_task_metadata_f a aic:Field ;
    aic:fieldName "metadata" ;
    aic:fieldType "map" ;
    aic:fieldDoc "Arbitrary named task metadata." ;
    aic:fieldRequired "false" ;
    aic:fieldOrder 4 .
