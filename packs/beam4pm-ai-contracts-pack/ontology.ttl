# beam4pm-ai-contracts-pack vocabulary.
#
# Mirrors beam4pm-process-model-pack's bpm:RecordType / bpm:Field pattern
# exactly, under a sibling namespace and prefix, for a sibling domain: the
# canonical AI-contract data shapes named in the post-LLM capability
# architecture roadmap (evidence, research tasks, candidate claims, tool
# intents, admission decisions, model-call receipts, evidence hits).
#
# Consumer contract-type individuals (the seven admitted aic:ContractType
# instances) are NOT declared here -- per this marketplace's established
# contract, packs ship vocabulary only. The consuming project's own
# ontology.ttl (e.g. beam4pm) supplies the instance data built from this
# vocabulary. This file contains ZERO individuals.
#
# Scope boundary (deliberate, not an oversight): this vocabulary models data
# shapes only. It carries no execution-authority, admission, or actuation
# semantics of any kind -- those are the exclusive responsibility of the
# separately-owned beam4pm-post-llm-runtime-pack (rt: vocabulary:
# RuntimeContract, ExactSubject, hasAuthorityPolicy, replayKey, refusalCode,
# refusalReason, enablesCapability) and its beam4pm_governor templates. In
# particular aic:ContractType's tool_intent shape (see the consumer instance
# data) intentionally carries no authority/capability-grant field: it is
# inert data, admissible for planning and receipting but conferring zero
# actuation authority on its own.

@prefix aic: <https://ggen.dev/ontology/beam4pm-ai#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

aic:ContractType a rdfs:Class ;
    rdfs:label "Contract Type" ;
    rdfs:comment "One admitted AI-contract data shape (evidence, research task, claim, tool intent, admission decision, model-call receipt, or evidence hit) projected into generated code." .

aic:Field a rdfs:Class ;
    rdfs:label "Field" ;
    rdfs:comment "One typed, ordered field belonging to an aic:ContractType." .

aic:contractName a rdf:Property ; rdfs:domain aic:ContractType ; rdfs:range xsd:string ;
    rdfs:comment "The contract type's canonical snake_case name (e.g. evidence_envelope)." .
aic:contractDoc a rdf:Property ; rdfs:domain aic:ContractType ; rdfs:range xsd:string .
aic:hasField a rdf:Property ; rdfs:domain aic:ContractType ; rdfs:range aic:Field .
aic:fieldName a rdf:Property ; rdfs:domain aic:Field ; rdfs:range xsd:string .
aic:fieldType a rdf:Property ; rdfs:domain aic:Field ; rdfs:range xsd:string ;
    rdfs:comment "Closed set: string, integer, float, boolean, datetime, atom, list_string, map." .
aic:fieldDoc a rdf:Property ; rdfs:domain aic:Field ; rdfs:range xsd:string .
aic:fieldRequired a rdf:Property ; rdfs:domain aic:Field ; rdfs:range xsd:string ;
    rdfs:comment "Plain string literal true or false; templates compare it as a string." .
aic:fieldOrder a rdf:Property ; rdfs:domain aic:Field ; rdfs:range xsd:integer .
