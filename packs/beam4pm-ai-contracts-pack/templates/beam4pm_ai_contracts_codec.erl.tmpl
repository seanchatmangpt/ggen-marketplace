---
to: src/beam4pm_ai_contracts_codec.erl
sparql:
  records: |
    PREFIX aic: <https://ggen.dev/ontology/beam4pm-ai#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a aic:ContractType ; aic:contractName ?record_name ; aic:contractDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX aic: <https://ggen.dev/ontology/beam4pm-ai#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order WHERE {
      ?rt a aic:ContractType ; aic:contractName ?record_name ; aic:hasField ?f .
      ?f aic:fieldName ?field_name ; aic:fieldType ?field_type ; aic:fieldDoc ?field_doc ;
         aic:fieldRequired ?field_required ; aic:fieldOrder ?field_order .
    } ORDER BY ?record_name ?field_order
---
%% GENERATED by ggen from the admitted aic:ContractType graph. Do not edit.

-module(beam4pm_ai_contracts_codec).

-export([to_map/1, from_map/2, encode/1, decode/2]).

%% Union of every admitted contract type. Records are the tagged tuples
%% defined (and constructed) by beam4pm_ai_contracts; this module never
%% touches the -record declarations directly -- it dispatches on element(1)
%% and reads fields positionally, and it builds records only through the
%% validating beam4pm_ai_contracts:new_*/1 constructors.
-type known_record() ::
{%- for r in records %}
    beam4pm_ai_contracts:{{ r.record_name }}(){% if not loop.last %} |{% endif %}
{%- endfor %}.

%% to_map/1: project a record onto a JSON-ready map with binary keys.
%% Fields whose value is 'undefined' are omitted; atom-typed fields are
%% converted with atom_to_binary/2; every other value passes through.
-spec to_map(known_record()) -> #{binary() => term()}.
{%- for r in records %}
{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) %}
to_map(R) when element(1, R) =:= {{ r.record_name }} ->
    pairs_to_map([
{%- for f in rfields %}
        {<<"{{ f.field_name }}">>, {% if f.field_type == "atom" %}atom{% else %}plain{% endif %}, element({{ loop.index + 1 }}, R)}{% if not loop.last %},{% endif %}
{%- endfor %}
    ]){% if loop.last %}.{% else %};{% endif %}
{%- endfor %}

%% from_map/2: rebuild a record from a binary-keyed map. Only KNOWN
%% field-name binaries are converted to atom keys (unknown binary keys are
%% dropped, so no atom-table pollution from untrusted input); atom-typed
%% field values are converted with binary_to_atom/2. The atom-keyed map is
%% then delegated to beam4pm_ai_contracts:new_<record>/1 so required-field
%% validation lives in exactly one place.
-spec from_map(atom(), #{binary() => term()}) ->
          {ok, known_record()}
        | {error, {missing_field, atom()}}
        | {error, {unknown_record, atom()}}.
{%- for r in records %}
{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) %}
from_map({{ r.record_name }}, Map) when is_map(Map) ->
    beam4pm_ai_contracts:new_{{ r.record_name }}(take_known(Map, [
{%- for f in rfields %}
        {<<"{{ f.field_name }}">>, {{ f.field_name }}, {% if f.field_type == "atom" %}atom{% else %}plain{% endif %}}{% if not loop.last %},{% endif %}
{%- endfor %}
    ]));
{%- endfor %}
from_map(RecordName, Map) when is_atom(RecordName), is_map(Map) ->
    {error, {unknown_record, RecordName}}.

%% encode/1: record -> JSON binary via the OTP 27+ built-in json module.
-spec encode(known_record()) -> binary().
encode(Record) ->
    iolist_to_binary(json:encode(to_map(Record))).

%% decode/2: JSON binary -> {ok, Record} | {error, term()}. JSON parse
%% failures are wrapped in {error, _} rather than propagated.
-spec decode(atom(), binary()) -> {ok, known_record()} | {error, term()}.
decode(RecordName, Bin) when is_atom(RecordName), is_binary(Bin) ->
    try json:decode(Bin) of
        Map when is_map(Map) -> from_map(RecordName, Map);
        Other -> {error, {not_a_json_object, Other}}
    catch
        Class:Reason -> {error, {invalid_json, Class, Reason}}
    end.

%% Internal helpers ----------------------------------------------------

-spec pairs_to_map([{binary(), 'atom' | 'plain', term()}]) ->
          #{binary() => term()}.
pairs_to_map(Pairs) ->
    maps:from_list(
        [{Key, to_json_value(Kind, Value)}
         || {Key, Kind, Value} <- Pairs, Value =/= undefined]).

-spec to_json_value('atom' | 'plain', term()) -> term().
to_json_value(atom, Value) when is_atom(Value) -> atom_to_binary(Value, utf8);
to_json_value(plain, Value) -> Value.

-spec take_known(#{binary() => term()}, [{binary(), atom(), 'atom' | 'plain'}]) ->
          #{atom() => term()}.
take_known(Map, Specs) ->
    lists:foldl(
        fun({BinKey, AtomKey, Kind}, Acc) ->
            case maps:find(BinKey, Map) of
                {ok, Value} -> Acc#{AtomKey => from_json_value(Kind, Value)};
                error -> Acc
            end
        end,
        #{},
        Specs).

-spec from_json_value('atom' | 'plain', term()) -> term().
from_json_value(atom, Value) when is_binary(Value) -> binary_to_atom(Value, utf8);
from_json_value(plain, Value) -> Value.
