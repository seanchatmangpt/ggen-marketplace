---
to: schema/beam4pm_ai_contracts.schema.json
sparql:
  records: |
    PREFIX aic: <https://ggen.dev/ontology/beam4pm-ai#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a aic:ContractType ; aic:contractName ?record_name ; aic:contractDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX aic: <https://ggen.dev/ontology/beam4pm-ai#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order ?json_schema_type ?json_schema_items_type WHERE {
      ?rt a aic:ContractType ; aic:contractName ?record_name ; aic:hasField ?f .
      ?f aic:fieldName ?field_name ; aic:fieldType ?field_type ; aic:fieldDoc ?field_doc ;
         aic:fieldRequired ?field_required ; aic:fieldOrder ?field_order .
      ?ft a aic:FieldType ; aic:fieldTypeName ?field_type ;
          aic:jsonSchemaType ?json_schema_type ; aic:jsonSchemaItemsType ?json_schema_items_type .
    } ORDER BY ?record_name ?field_order
---
{
  "$comment": "GENERATED by ggen from the admitted aic:ContractType graph. Do not edit.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
{%- for r in records %}
{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) %}
{%- set required_fields = rfields | filter(attribute="field_required", value="true") %}
    "{{ r.record_name }}": {
      "type": "object",
      "description": {{ r.record_doc | json_encode | safe }},
      "properties": {
{%- for f in rfields %}
        "{{ f.field_name }}": {
          "type": "{{ f.json_schema_type }}",
{%- if f.json_schema_items_type and f.json_schema_items_type != "" %}
          "items": { "type": "{{ f.json_schema_items_type }}" },
{%- endif %}
          "description": {{ f.field_doc | json_encode | safe }}
        }{% if not loop.last %},{% endif %}
{%- endfor %}
      }{% if required_fields | length > 0 %},
      "required": [
{%- for f in required_fields %}"{{ f.field_name }}"{% if not loop.last %}, {% endif %}{% endfor %}
      ]
{%- endif %}

    }{% if not loop.last %},{% endif %}
{%- endfor %}
  }
}
