    ic:admission ic:ADMITTED ;
    ic:sourceLocator "ontologies/public/fibo/LOAN/LoansGeneral/LoanApplications.rdf" ;
    ic:sourceDigest "sha256:ad7df5c986fa0bf6d1e108aff41f9772e18303b6300d97e3e0d5e7f6de038f67" ;
    ic:sourceIri <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/> ;
    ic:sourceVersion "https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/" ;
    ic:licenseBoundary "MIT licence (https://opensource.org/licenses/MIT) as stated in the file's own dct:license; copyright 2016-2026 EDM Association dba EDM Council, Inc. and 2016-2025 Object Management Group, Inc.; redistributed as vendored, notice retained in the file" ;
    ic:providesConcept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/LoanApplication> ,
        <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/LoanApplicationStatus> ,
        <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/BorrowerAssessment> ,
        <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/CreditRiskAssessment> ,
