        <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoansRegulatory/GoodFaithEstimate> ,
        <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoansRegulatory/DisclosureRequirement> .

lnd:SrcMortgageOrigination a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceLocator "ontologies/public/fibo/LOAN/RealEstateLoans/MortgageOrigination.rdf" ;
    ic:sourceDigest "sha256:dda3d7a2dc8fdcee8b5b0825f90373336231f5a6557977bb1457bde3a5d1eb2e" ;
    ic:sourceIri <https://spec.edmcouncil.org/fibo/ontology/LOAN/RealEstateLoans/MortgageOrigination/> ;
