    ic:licenseBoundary "MIT licence (https://opensource.org/licenses/MIT) as stated in the file's own dct:license" ;
    ic:exclusionReason "marine finance is outside consumer and mortgage lending origination" .

lnd:SrcStudentLoans a ic:KnowledgeSource ;
    ic:admission ic:UNKNOWN ;
    ic:sourceLocator "ontologies/public/fibo/LOAN/LoansSpecific/StudentLoans.rdf" ;
    ic:sourceDigest "sha256:2e988d8c097169157129178fe629acf566582bdb86b1cca02980abc08f3ae38d" ;
    ic:sourceIri <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/StudentLoans/> ;
    ic:sourceVersion "https://spec.edmcouncil.org/fibo/ontology/LOAN/20250301/LoansSpecific/StudentLoans/" ;
    ic:licenseBoundary "MIT licence (https://opensource.org/licenses/MIT) as stated in the file's own dct:license" ;
    ic:falsifier "falsified if any in-scope requirement needs student-loan terms; then review the module and admit it or keep it excluded" .

lnd:CapLoanIntake a ea:Capability ;
    ic:capabilityKey "CAP-LOAN-INTAKE" ;
    ic:groundedIn lnd:SrcLoanApplications ;
    ic:concept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/LoanApplication> .

lnd:CapBorrowerAssessment a ea:Capability ;
    ic:capabilityKey "CAP-BORROWER-ASSESSMENT" ;
    ic:groundedIn lnd:SrcLoanApplications ;
    ic:concept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/BorrowerAssessment> .

lnd:CapCreditDecisioning a ea:Capability ;
    ic:capabilityKey "CAP-CREDIT-DECISIONING" ;
    ic:groundedIn lnd:SrcLoanApplications ;
    ic:concept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/UnderwritingDecision> .

lnd:CapAutomatedUnderwriting a ea:Capability ;
    ic:capabilityKey "CAP-AUTOMATED-UNDERWRITING" ;
    ic:groundedIn lnd:SrcMortgageOrigination ;
    ic:concept <https://spec.edmcouncil.org/fibo/ontology/LOAN/RealEstateLoans/MortgageOrigination/AutomatedUnderwritingSystem> .

lnd:CapCollateralAssessment a ea:Capability ;
    ic:capabilityKey "CAP-COLLATERAL-ASSESSMENT" ;
    ic:groundedIn lnd:SrcLoans ;
    ic:concept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/CollateralizedLoan> .

lnd:CapRegulatoryDisclosure a ea:Capability ;
    ic:capabilityKey "CAP-REGULATORY-DISCLOSURE" ;
    ic:groundedIn lnd:SrcLoansRegulatory ;
    ic:concept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoansRegulatory/BorrowerDisclosureRequirement> .

lnd:CapMortgagePurpose a ea:Capability ;
    ic:capabilityKey "CAP-MORTGAGE-PURPOSE" ;
    ic:groundedIn lnd:SrcMortgageOrigination ;
    ic:concept <https://spec.edmcouncil.org/fibo/ontology/LOAN/RealEstateLoans/MortgageOrigination/MortgageLoanPurpose> .

lnd:CapFundingInstruction a ea:Capability ;
    ic:capabilityKey "CAP-FUNDING-INSTRUCTION" ;
    ic:groundedIn lnd:SrcLoans ;
    ic:concept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan> .

lnd:Req01 a ic:Requirement ;
    ic:requirementId "LND-REQ-01" ;
    ic:statement "Capture a loan application with its applicant, requested terms and submission context as one identified record." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability lnd:CapLoanIntake ;
    ic:derivedFrom lnd:SrcLoanApplications .

lnd:Req02 a ic:Requirement ;
    ic:requirementId "LND-REQ-02" ;
    ic:statement "Track each loan application through its lifecycle phases and statuses so its current state is always knowable." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability lnd:CapLoanIntake ;
    ic:derivedFrom lnd:SrcLoanApplications .

lnd:Req03 a ic:Requirement ;
    ic:requirementId "LND-REQ-03" ;
    ic:statement "Assess the borrower's capacity to repay, including monthly income and the debt-to-expense picture, before a decision." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability lnd:CapBorrowerAssessment ;
    ic:derivedFrom lnd:SrcLoanApplications .

lnd:Req04 a ic:Requirement ;
    ic:requirementId "LND-REQ-04" ;
    ic:statement "Record a credit risk assessment for each application as a distinct, attributable assessment." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability lnd:CapBorrowerAssessment ;
    ic:derivedFrom lnd:SrcLoanApplications .

lnd:Req05 a ic:Requirement ;
    ic:requirementId "LND-REQ-05" ;
    ic:statement "Record an underwriting decision for each application, separate from the assessment that informed it." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability lnd:CapCreditDecisioning ;
    ic:derivedFrom lnd:SrcLoanApplications .

lnd:Req06 a ic:Requirement ;
    ic:requirementId "LND-REQ-06" ;
    ic:statement "Support automated underwriting for mortgage applications while keeping the automated outcome distinguishable from a human decision." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability lnd:CapAutomatedUnderwriting ;
    ic:derivedFrom lnd:SrcMortgageOrigination .

lnd:Req07 a ic:Requirement ;
    ic:requirementId "LND-REQ-07" ;
    ic:statement "Assess collateral for secured loans, including the loan-to-value relationship." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability lnd:CapCollateralAssessment ;
    ic:derivedFrom lnd:SrcLoans .

lnd:Req08 a ic:Requirement ;
    ic:requirementId "LND-REQ-08" ;
    ic:statement "Produce the disclosures a borrower must receive before commitment, including an estimate of costs." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability lnd:CapRegulatoryDisclosure ;
    ic:derivedFrom lnd:SrcLoansRegulatory .

lnd:Req09 a ic:Requirement ;
    ic:requirementId "LND-REQ-09" ;
    ic:statement "Capture the stated purpose of a mortgage loan and the intended use of the property." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability lnd:CapMortgagePurpose ;
    ic:derivedFrom lnd:SrcMortgageOrigination .

lnd:Req10 a ic:Requirement ;
    ic:requirementId "LND-REQ-10" ;
    ic:statement "Release loan funds to the borrower autonomously once a decision is recorded, without a human gate." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability lnd:CapFundingInstruction ;
    ic:needsDoAuthority true ;
    ic:derivedFrom lnd:SrcLoans .

lnd:Req11 a ic:Requirement ;
    ic:requirementId "LND-REQ-11" ;
    ic:statement "Originate and track financing for marine vessels." ;
    ic:inClosure lnd:RetailLending ;
    ic:disposition ic:OUT_OF_SCOPE ;
    ic:scopeJustification "Vessel financing is a specialised lending line outside consumer and mortgage origination; its module is kept EXCLUDED." ;
    ic:derivedFrom lnd:SrcMarineFinance .
