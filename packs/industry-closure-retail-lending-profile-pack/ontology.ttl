# industry-closure-retail-lending-profile-pack ontology: ProfilePack ABox only.
#
# One bounded industry scope (consumer and mortgage lending origination), four ADMITTED public
# knowledge sources (vendored FIBO LOAN modules, pinned by sha256 of the vendored file), one EXCLUDED
# source, one UNKNOWN source with a falsifier, capability individuals grounded in those sources,
# paraphrased atomic requirements, and the empty epoch-0 snapshot (the closure starts empty).
#
# This file declares NO architecture building blocks, solution building blocks, coverages, execution
# evidence or receipts: the honest starting residual is DEFICIT_ABB for every in-scope requirement,
# except the requirement that needs consequential authority, which is DEFICIT_AUTHORITY / BLOCKED.
# A need for DO authority is a need, never a grant. Packs here SELECT and CONSTRUCT only.
#
# Vocabulary is owned by industry-closure-pack (ic:) and enterprise-architecture-pack (ea:, IRI-only
# use). Vendored sources are referenced by locator and digest; nothing is copied from them here.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix lnd: <https://seanchatmangpt.github.io/packs/industry-closure-retail-lending-profile-pack#> .

lnd:RetailLending a ic:IndustryClosure ;
    ic:baseIri "https://seanchatmangpt.github.io/packs/industry-closure-retail-lending-profile-pack/" ;
    ic:industryScope "consumer and mortgage lending origination" ;
    ic:boundPathPrefix "ontologies/public/fibo/LOAN/" ;
    ic:hasSnapshot lnd:Snapshot0 ;
    ic:usesSource lnd:SrcLoans , lnd:SrcLoanApplications , lnd:SrcLoansRegulatory , lnd:SrcMortgageOrigination , lnd:SrcMarineFinance , lnd:SrcStudentLoans .

lnd:Snapshot0 a ic:ClosureSnapshot ;
    ic:snapshotOf lnd:RetailLending ;
    ic:epoch 0 .


lnd:SrcLoans a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceLocator "ontologies/public/fibo/LOAN/LoansGeneral/Loans.rdf" ;
    ic:sourceDigest "sha256:87024035dac38303e21738879202d87f0f37c1347a16119f9ec2b4e37e124f05" ;
    ic:sourceIri <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/> ;
    ic:sourceVersion "https://spec.edmcouncil.org/fibo/ontology/LOAN/20251201/LoansGeneral/Loans/" ;
    ic:licenseBoundary "MIT licence (https://opensource.org/licenses/MIT) as stated in the file's own dct:license; copyright 2016-2025 EDM Council, Inc. and Object Management Group, Inc.; redistributed as vendored, notice retained in the file" ;
    ic:providesConcept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan> ,
        <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/CollateralizedLoan> ,
        <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/LoanToValueRatio> .

