    ic:admission ic:ADMITTED ;
    ic:sourceLocator "ontologies/public/fibo/LOAN/LoansGeneral/LoansRegulatory.rdf" ;
    ic:sourceDigest "sha256:2ac7db4283eb42d68cfa4acad8e0d41db324a1635789d771bb37b4ba3f7f9d35" ;
    ic:sourceIri <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoansRegulatory/> ;
