        <https://spec.edmcouncil.org/fibo/ontology/LOAN/RealEstateLoans/MortgageOrigination/PropertyUsage> .

lnd:SrcMarineFinance a ic:KnowledgeSource ;
    ic:admission ic:EXCLUDED ;
    ic:sourceLocator "ontologies/public/fibo/LOAN/LoansSpecific/MarineFinance.rdf" ;
    ic:sourceDigest "sha256:f95a470fc34641bfbb2831094042a03321f2b60a5791dd6985ed5ef3702346cc" ;
    ic:sourceIri <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansSpecific/MarineFinance/> ;
