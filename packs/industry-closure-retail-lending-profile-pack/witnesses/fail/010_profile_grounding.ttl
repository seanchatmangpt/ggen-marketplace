@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ex: <https://example.org/industry-closure-retail-lending-profile-pack/fail/> .

# Same positive world as the pass witness, plus one violator per declared code.
ex:closure a ic:IndustryClosure ;
    ic:baseIri "https://example.org/industry-closure-retail-lending-profile-pack/fail/" ;
    ic:boundPathPrefix "ontologies/public/fibo/LOAN/" ;
    ic:usesSource ex:src , ex:srcForeign .

ex:src a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/> ;
    ic:providesConcept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan> .

ex:cap a ea:Capability ;
    ic:capabilityKey "CAP-PASS" ;
    ic:groundedIn ex:src ;
    ic:concept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan> .

ex:req a ic:Requirement ;
    ic:requirementId "PASS-REQ" ;
    ic:inClosure ex:closure ;
    ic:derivedFrom ex:src .

# LND_CAPABILITY_CONCEPT_NOT_PROVIDED: the concept is not provided by the grounding source.
ex:capBadConcept a ea:Capability ;
    ic:capabilityKey "CAP-BAD-CONCEPT" ;
    ic:groundedIn ex:src ;
    ic:concept <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Unprovided> .

# LND_REQUIREMENT_SOURCE_NOT_IN_CLOSURE: the source is not used by the requirement's closure.
ex:srcUnused a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/LoanApplications/> .

ex:reqBadSource a ic:Requirement ;
    ic:requirementId "FAIL-REQ-SOURCE" ;
    ic:inClosure ex:closure ;
    ic:derivedFrom ex:srcUnused .

# LND_SOURCE_NOT_FIBO_LOAN: a LOAN-scoped closure admits a non-LOAN source.
ex:srcForeign a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://example.invalid/not-fibo/> .

# LND_CAPABILITY_CONCEPT_MISSING: a grounded capability that names no concept cannot be checked for concept provision.
ex:capNoConcept a ea:Capability ;
    ic:capabilityKey "CAP-NO-CONCEPT" ;
    ic:groundedIn ex:src .
