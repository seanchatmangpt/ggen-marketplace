# Synthetic consumer stub. This pack is qualified in isolation, without the sibling kernel's ontology,
# so the handful of industry-closure-ledger-pack individuals and classes it references are restated here as
# type stubs only (the same typing industry-closure-ledger-pack/ontology.ttl owns). No data, no authority.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#> .

ic:IndustryClosure a rdfs:Class .
ic:KnowledgeSource a rdfs:Class .
ic:Requirement a rdfs:Class .
ic:ClosureSnapshot a rdfs:Class .
ic:AdmissionState a rdfs:Class .
ic:ScopeDisposition a rdfs:Class .
ic:ADMITTED a ic:AdmissionState .
ic:EXCLUDED a ic:AdmissionState .
ic:UNKNOWN a ic:AdmissionState .
ic:IN_SCOPE a ic:ScopeDisposition .
ic:OUT_OF_SCOPE a ic:ScopeDisposition .
