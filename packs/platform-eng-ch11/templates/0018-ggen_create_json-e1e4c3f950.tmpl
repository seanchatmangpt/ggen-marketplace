---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch11",
  "files_and_dirs": {
    ".github/workflows/policy-tests.yaml": true,
    ".github/workflows/validate.yml": true,
    ".pre-commit-config.yaml": true,
    "README.md": true,
    "compliance-dashboard.py": true,
    "compliance-report.md": true,
    "conftest-tests/policy.rego": true,
    "conftest-tests/test-manifests.yaml": true,
    "constraint-template-security-baselines.yaml": true,
    "constraint-template.yaml": true,
    "constraints/deny-privileged-containers.yaml": true,
    "constraints/require-compliance-labels.yaml": true,
    "constraints/require-labels.yaml": true,
    "constraints/require-resource-limits.yaml": true,
    "constraints/require-resources.yaml": true,
    "constraints/restrict-image-registries.yaml": true,
    "gatekeeper-install.yaml": true,
    "gatekeeper-metrics-servicemonitor.yaml": true,
    "ggen-create.json": true,
    "grafana-compliance-dashboard.json": true,
    "install-gatekeeper.sh": true,
    "policies/deny-privileged-containers.yaml": true,
    "policies/require-labels.yaml": true,
    "policies/require-resource-limits.yaml": true,
    "policies/require-tests-passed.rego": true,
    "policies/require-tests-passed_test.rego": true,
