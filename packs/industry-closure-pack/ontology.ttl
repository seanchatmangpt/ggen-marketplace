@prefix ic: <https://ggen.dev/ontology/industry-closure#> .
@prefix req: <https://ggen.io/onto/requirements/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Control vocabulary for public-ontology-first requirement closure.
# Domain meaning remains in the bound public ontology terms; this graph only
# records closure standing, evidence, and exact residuals.

ic:ClosureAssessment a rdfs:Class ;
  rdfs:label "Industry closure assessment" ;
  rdfs:subClassOf prov:Entity .

ic:OntologyBinding a rdfs:Class ;
  rdfs:label "Admitted public ontology binding" ;
  rdfs:subClassOf prov:Entity .

ic:ClosureResidual a rdfs:Class ;
  rdfs:label "Exact semantic closure residual" ;
  rdfs:subClassOf prov:Entity .

ic:ClosureState a rdfs:Class .
ic:CLOSED a ic:ClosureState .
ic:RESIDUAL a ic:ClosureState .

ic:hasAssessment a rdf:Property ;
  rdfs:domain req:CandidateRequirement ;
  rdfs:range ic:ClosureAssessment .

ic:closureState a rdf:Property ;
  rdfs:domain ic:ClosureAssessment ;
  rdfs:range ic:ClosureState .

ic:bindsPublicTerm a rdf:Property ;
  rdfs:domain ic:ClosureAssessment ;
  rdfs:range ic:OntologyBinding .

ic:publicTermIri a rdf:Property ;
  rdfs:domain ic:OntologyBinding ;
  rdfs:range xsd:anyURI .

ic:ontologySource a rdf:Property ;
  rdfs:domain ic:OntologyBinding ;
  rdfs:range xsd:anyURI ;
  rdfs:subPropertyOf dcterms:source .

ic:ontologyDigest a rdf:Property ;
  rdfs:domain ic:OntologyBinding ;
  rdfs:range xsd:string .

ic:qualificationEvidence a rdf:Property ;
  rdfs:domain ic:ClosureAssessment ;
  rdfs:range prov:Entity ;
  rdfs:subPropertyOf prov:wasDerivedFrom .

ic:emitsResidual a rdf:Property ;
  rdfs:domain ic:ClosureAssessment ;
  rdfs:range ic:ClosureResidual .

ic:residualKind a rdf:Property ;
  rdfs:domain ic:ClosureResidual ;
  rdfs:range xsd:string .

ic:missingSemanticCapability a rdf:Property ;
  rdfs:domain ic:ClosureResidual ;
  rdfs:range xsd:string .

ic:requirementDigest a rdf:Property ;
  rdfs:domain ic:ClosureAssessment ;
  rdfs:range xsd:string .

ic:residualDigest a rdf:Property ;
  rdfs:domain ic:ClosureResidual ;
  rdfs:range xsd:string .

ic:unresolved a rdf:Property ;
  rdfs:domain ic:ClosureResidual ;
  rdfs:range xsd:boolean .

ic:authority a rdf:Property ;
  rdfs:range xsd:string .
