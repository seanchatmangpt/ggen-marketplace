# 010_source_admission fail witness: one violating source per declared code (admission, provenance, digest, vendoring, scope, exclusion, unknown).
# Synthetic data only (example.invalid IRIs). Loaded together with ontology.ttl by the gate court.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ex: <https://example.invalid/synthetic/> .

ex:closure a ic:IndustryClosure ;
    ic:industryScope "synthetic bounded scope for witnesses and fixtures" ;
    ic:baseIri "https://example.invalid/synthetic/" ;
    ic:boundPathPrefix "ontologies/public/synthetic/" ;
    ic:usesSource ex:srcA , ex:srcExcluded , ex:srcUnknown , ex:badScope ;
    ic:hasSnapshot ex:snap0 .

ex:snap0 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:epoch 0 .

ex:srcA a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://example.invalid/source/a> ;
    ic:sourceVersion "1.0.0" ;
    ic:sourceDigest "sha256:c2922945bce9302c46fb563eb14f55a7d5fa796bcb3a229c49e9013ccc4e04bc" ;
    ic:licenseBoundary "synthetic test source, no external licence" ;
    ic:sourceLocator "ontologies/public/synthetic/a.ttl" ;
    ic:providesConcept <https://example.invalid/concept/A> .

ex:srcExcluded a ic:KnowledgeSource ;
    ic:admission ic:EXCLUDED ;
    ic:exclusionReason "Outside the synthetic scope." ;
    ic:sourceLocator "ontologies/public/other/excluded.ttl" .

ex:srcUnknown a ic:KnowledgeSource ;
    ic:admission ic:UNKNOWN ;
    ic:falsifier "Falsified if any in-scope requirement needs this source; then review and admit." .

ex:badAdmission a ic:KnowledgeSource ;
    ic:sourceLocator "ontologies/public/synthetic/x.ttl" .

ex:badProvenance a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://example.invalid/source/p> ;
    ic:sourceDigest "sha256:4cc83d210488a923c5ac74666424efb23bde1a72dab1de72989a127e28257cd6" ;
    ic:licenseBoundary "synthetic" ;
    ic:sourceLocator "ontologies/public/synthetic/p.ttl" .

ex:badDigest a ic:KnowledgeSource ;
    ic:admission ic:UNKNOWN ;
    ic:falsifier "Falsified if reviewed." ;
    ic:sourceDigest "sha256:not-a-digest" .

ex:badVendored a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://example.invalid/source/v> ;
    ic:sourceVersion "1" ;
    ic:sourceDigest "sha256:00987017d8f2563e2817772719c155de55d0c00c436688450926d995b568011a" ;
    ic:licenseBoundary "synthetic" ;
    ic:sourceLocator "vendor/not-under-public.ttl" .

ex:badScope a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://example.invalid/source/s> ;
    ic:sourceVersion "1" ;
    ic:sourceDigest "sha256:9ec869ed676292e9d406052df86c2ea6883dfaba8c860457efc7f61f73947b22" ;
    ic:licenseBoundary "synthetic" ;
    ic:sourceLocator "ontologies/public/elsewhere/s.ttl" .

ex:badExcluded a ic:KnowledgeSource ;
    ic:admission ic:EXCLUDED .

ex:badUnknown a ic:KnowledgeSource ;
    ic:admission ic:UNKNOWN .

