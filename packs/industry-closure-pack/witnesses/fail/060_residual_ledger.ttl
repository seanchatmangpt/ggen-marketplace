# 060_residual_ledger fail witness: an in-scope deficit with no residual, a residual whose class differs from the computed class, and a residual of an out-of-scope requirement.
# Synthetic data only (example.invalid IRIs). Loaded together with ontology.ttl by the gate court.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ex: <https://example.invalid/synthetic/> .

ex:closure a ic:IndustryClosure ;
    ic:industryScope "synthetic bounded scope for witnesses and fixtures" ;
    ic:baseIri "https://example.invalid/synthetic/" ;
    ic:boundPathPrefix "ontologies/public/synthetic/" ;
    ic:usesSource ex:srcA ;
    ic:hasSnapshot ex:snap0 .

ex:snap0 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:epoch 0 .

ex:srcA a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://example.invalid/source/a> ;
    ic:sourceVersion "1.0.0" ;
    ic:sourceDigest "sha256:c2922945bce9302c46fb563eb14f55a7d5fa796bcb3a229c49e9013ccc4e04bc" ;
    ic:licenseBoundary "synthetic test source, no external licence" ;
    ic:sourceLocator "ontologies/public/synthetic/a.ttl" ;
    ic:providesConcept <https://example.invalid/concept/A> .

ex:agentBuilder a <http://www.w3.org/ns/prov#Agent> .
ex:agentVerifier a <http://www.w3.org/ns/prov#Agent> .

ex:reqOOS a ic:Requirement ;
    ic:requirementId "REQ-OOS" ;
    ic:statement "A synthetic requirement outside the declared scope." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:OUT_OF_SCOPE ;
    ic:scopeJustification "The synthetic scope excludes this capability family." ;
    ic:derivedFrom ex:srcA .

ex:capC a ea:Capability ;
    ic:capabilityKey "CAP-C" ;
    ic:groundedIn ex:srcA ;
    ic:concept <https://example.invalid/concept/A> .

ex:reqC a ic:Requirement ;
    ic:requirementId "REQ-C" ;
    ic:statement "Synthetic requirement C stated in paraphrase." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability ex:capC ;
    ic:derivedFrom ex:srcA .

ex:abbC a ea:ArchitectureBuildingBlock ;
    ea:realizesCapability ex:capC ;
    ea:governedByContract ex:kC .

ex:kC a ea:ArchitectureContract ;
    ea:hasAuthorityBoundary ex:boundaryC ;
    ic:approvalStatus ic:APPROVED ;
    ic:approvedBy ex:humanApprover ;
    ic:approvalReceipt "receipt:C-approval" ;
    ic:authorityClaim "NONE" .

ex:boundaryC a ea:AuthorityBoundary .

ex:humanApprover a <http://www.w3.org/ns/prov#Agent> .

ex:sbbC a ea:SolutionBuildingBlock ;
    ea:satisfiesABB ex:abbC ;
    ea:hasStanding ea:QUALIFIED ;
    ea:exactSubject "sha256:521fc929503480de9be4a7d3939a600fa212ee642dad30d87ce8976eb3b54ab5" .

ex:evCV a ic:ExecutionEvidence ;
    ic:evidenceFor ex:sbbC ;
    ic:evidenceSubject "sha256:521fc929503480de9be4a7d3939a600fa212ee642dad30d87ce8976eb3b54ab5" ;
    ic:outcome ic:VERIFIED ;
    ic:receiptDigest "sha256:83a5e1d7a1dce8c689592dc94114102839a09f40e94afa95654122b467d56c33" ;
    ic:producedBy ex:agentBuilder ;
    ic:verifiedBy ex:agentVerifier ;
    ic:evidenceKind ic:SYNTHETIC .

ex:capA a ea:Capability ;
    ic:capabilityKey "CAP-A" ;
    ic:groundedIn ex:srcA ;
    ic:concept <https://example.invalid/concept/A> .

ex:reqA a ic:Requirement ;
