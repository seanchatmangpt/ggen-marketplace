@prefix ic: <https://ggen.dev/ontology/industry-closure#> .
@prefix req: <https://ggen.io/onto/requirements/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:req:known-procurement> a req:CandidateRequirement ;
  req:hasSourceVoice "Manufacture a governed supplier-selection workflow from admitted procurement, contract, identity, and provenance semantics." ;
  ic:hasAssessment <urn:assessment:known-procurement> .

<urn:assessment:known-procurement> a ic:ClosureAssessment ;
  ic:requirementDigest "sha256:known-procurement" ;
  ic:closureState ic:CLOSED ;
  ic:authority "SELECT_CONSTRUCT_ONLY" ;
  ic:bindsPublicTerm <urn:binding:prov-activity> ;
  ic:qualificationEvidence <urn:evidence:known-procurement> .

<urn:binding:prov-activity> a ic:OntologyBinding ;
  ic:publicTermIri <http://www.w3.org/ns/prov#Activity> ;
  ic:ontologySource <https://www.w3.org/TR/prov-o/> ;
  ic:ontologyDigest "sha256:fixture-prov-o" .

<urn:evidence:known-procurement> a prov:Entity .

<urn:req:unbound-domain-term> a req:CandidateRequirement ;
  req:hasSourceVoice "Represent a domain-specific obligation for which no admitted ontology binding currently exists." ;
  ic:hasAssessment <urn:assessment:unbound-domain-term> .

<urn:assessment:unbound-domain-term> a ic:ClosureAssessment ;
  ic:requirementDigest "sha256:unbound-domain-term" ;
  ic:closureState ic:RESIDUAL ;
  ic:authority "SELECT_CONSTRUCT_ONLY" ;
  ic:emitsResidual <urn:residual:unbound-domain-term> .

<urn:residual:unbound-domain-term> a ic:ClosureResidual ;
  ic:residualDigest "sha256:residual-unbound-domain-term" ;
  ic:residualKind "ONTOLOGY_TERM" ;
  ic:missingSemanticCapability "Admitted public term or explicit profile mapping for the observed obligation." ;
  ic:unresolved true .
