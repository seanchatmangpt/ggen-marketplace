# Synthetic industry overlay for the industry-closure-pack qualification capsule.
# It replaces the shipped EMPTY ontology/industry-input.ttl at the same relative path, so the real ggen
# runtime has residual deficits of several classes, a DO-needing requirement, an unmapped requirement and
# one recorded LIVE coverage to carry into the next snapshot. example.invalid IRIs; no real industry.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ex: <https://example.invalid/synthetic/> .

ex:closure a ic:IndustryClosure ;
    ic:industryScope "synthetic bounded scope for witnesses and fixtures" ;
    ic:baseIri "https://example.invalid/synthetic/" ;
    ic:boundPathPrefix "ontologies/public/synthetic/" ;
    ic:usesSource ex:srcA ;
    ic:hasSnapshot ex:snap0 , ex:snap1 .

ex:snap0 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:epoch 0 .

ex:snap1 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:supersedes ex:snap0 ;
    ic:epoch 1 .

ex:srcA a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://example.invalid/source/a> ;
    ic:sourceVersion "1.0.0" ;
    ic:sourceDigest "sha256:c2922945bce9302c46fb563eb14f55a7d5fa796bcb3a229c49e9013ccc4e04bc" ;
    ic:licenseBoundary "synthetic test source, no external licence" ;
    ic:sourceLocator "ontologies/public/synthetic/a.ttl" ;
    ic:providesConcept <https://example.invalid/concept/A> .

ex:agentBuilder a <http://www.w3.org/ns/prov#Agent> .
ex:agentVerifier a <http://www.w3.org/ns/prov#Agent> .

ex:reqOOS a ic:Requirement ;
    ic:requirementId "REQ-OOS" ;
    ic:statement "A synthetic requirement outside the declared scope." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:OUT_OF_SCOPE ;
    ic:scopeJustification "The synthetic scope excludes this capability family." ;
    ic:derivedFrom ex:srcA .

ex:capA a ea:Capability ;
    ic:capabilityKey "CAP-A" ;
    ic:groundedIn ex:srcA ;
    ic:concept <https://example.invalid/concept/A> .

ex:reqA a ic:Requirement ;
    ic:requirementId "REQ-A" ;
    ic:statement "Synthetic requirement A stated in paraphrase." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability ex:capA ;
    ic:derivedFrom ex:srcA .

ex:capB a ea:Capability ;
    ic:capabilityKey "CAP-B" ;
    ic:groundedIn ex:srcA ;
    ic:concept <https://example.invalid/concept/A> .

ex:reqB a ic:Requirement ;
    ic:requirementId "REQ-B" ;
    ic:statement "Synthetic requirement B stated in paraphrase." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability ex:capB ;
    ic:derivedFrom ex:srcA .

ex:abbB a ea:ArchitectureBuildingBlock ;
    ea:realizesCapability ex:capB ;
    ea:governedByContract ex:kB .

ex:kB a ea:ArchitectureContract ;
    ea:hasAuthorityBoundary ex:boundaryB ;
    ic:approvalStatus ic:PENDING_HUMAN_APPROVAL ;
    ic:authorityClaim "NONE" .

ex:boundaryB a ea:AuthorityBoundary .

ex:capC a ea:Capability ;
    ic:capabilityKey "CAP-C" ;
    ic:groundedIn ex:srcA ;
    ic:concept <https://example.invalid/concept/A> .

ex:reqC a ic:Requirement ;
    ic:requirementId "REQ-C" ;
    ic:statement "Synthetic requirement C stated in paraphrase." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability ex:capC ;
    ic:derivedFrom ex:srcA .

ex:abbC a ea:ArchitectureBuildingBlock ;
    ea:realizesCapability ex:capC ;
    ea:governedByContract ex:kC .

ex:kC a ea:ArchitectureContract ;
    ea:hasAuthorityBoundary ex:boundaryC ;
    ic:approvalStatus ic:APPROVED ;
    ic:approvedBy ex:humanApprover ;
    ic:approvalReceipt "receipt:C-approval" ;
    ic:authorityClaim "NONE" .

ex:boundaryC a ea:AuthorityBoundary .

ex:humanApprover a <http://www.w3.org/ns/prov#Agent> .

ex:capD a ea:Capability ;
    ic:capabilityKey "CAP-D" ;
    ic:groundedIn ex:srcA ;
    ic:concept <https://example.invalid/concept/A> .

ex:reqD a ic:Requirement ;
    ic:requirementId "REQ-D" ;
    ic:statement "Synthetic requirement D stated in paraphrase." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability ex:capD ;
    ic:needsDoAuthority true ;
    ic:derivedFrom ex:srcA .

ex:capE a ea:Capability ;
    ic:capabilityKey "CAP-E" ;
    ic:groundedIn ex:srcA ;
    ic:concept <https://example.invalid/concept/A> .

ex:reqE a ic:Requirement ;
    ic:requirementId "REQ-E" ;
    ic:statement "Synthetic requirement E stated in paraphrase." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability ex:capE ;
    ic:derivedFrom ex:srcA .

ex:abbE a ea:ArchitectureBuildingBlock ;
    ea:realizesCapability ex:capE ;
    ea:governedByContract ex:kE .

ex:kE a ea:ArchitectureContract ;
    ea:hasAuthorityBoundary ex:boundaryE ;
    ic:approvalStatus ic:APPROVED ;
    ic:approvedBy ex:humanApprover ;
    ic:approvalReceipt "receipt:E-approval" ;
    ic:authorityClaim "NONE" .

ex:boundaryE a ea:AuthorityBoundary .

ex:humanApprover a <http://www.w3.org/ns/prov#Agent> .

ex:sbbE a ea:SolutionBuildingBlock ;
    ea:satisfiesABB ex:abbE ;
    ea:hasStanding ea:QUALIFIED ;
    ea:exactSubject "sha256:672bf743af3d28c301a28d90501ceb61c259dfe9274fb207ea221b0ce8f724b3" .

ex:evEV a ic:ExecutionEvidence ;
    ic:evidenceFor ex:sbbE ;
    ic:evidenceSubject "sha256:672bf743af3d28c301a28d90501ceb61c259dfe9274fb207ea221b0ce8f724b3" ;
    ic:outcome ic:VERIFIED ;
    ic:receiptDigest "sha256:a18e54a126bec81e67826199254cba70a43f1c9c93a8e26b9ef18301ffced9c2" ;
    ic:producedBy ex:agentBuilder ;
    ic:verifiedBy ex:agentVerifier ;
    ic:evidenceKind ic:SYNTHETIC .

ex:covE a ic:Coverage ;
    ic:inSnapshot ex:snap1 ;
    ic:coversCapability ex:capE ;
    ic:byABB ex:abbE ;
    ic:bySBB ex:sbbE ;
    ic:coverageState ic:LIVE .

ex:reqU a ic:Requirement ;
    ic:requirementId "REQ-U" ;
    ic:statement "A synthetic requirement that maps to no capability yet." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:IN_SCOPE ;
    ic:derivedFrom ex:srcA .
