PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#>
PREFIX ea: <https://chatman.ai/ontology/enterprise-architecture#>
PREFIX togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#>
# MESSAGE: every residual has exactly one deficit class and exactly the upstream target that its class routes to; an authority block is BLOCKED and reasoned; a residual's standing is UNKNOWN or BLOCKED, never promoted.
SELECT ?subject ?reason WHERE {
  { ?subject a ic:Residual . FILTER NOT EXISTS { ?subject ic:deficitClass ?c . ?c a ic:DeficitClass } BIND("REFUSED:IC_RESIDUAL_UNCLASSIFIED" AS ?reason) }
  UNION { ?subject a ic:Residual ; ic:deficitClass ?a , ?b . FILTER(STR(?a) < STR(?b)) BIND("REFUSED:IC_RESIDUAL_MULTICLASS" AS ?reason) }
  UNION { ?subject a ic:Residual . FILTER NOT EXISTS { ?subject ic:feedbackTarget ?t } BIND("REFUSED:IC_RESIDUAL_NO_FEEDBACK" AS ?reason) }
  UNION { ?subject a ic:Residual ; ic:deficitClass ?c ; ic:feedbackTarget ?t . FILTER NOT EXISTS { ?c ic:routesTo ?t } BIND("REFUSED:IC_FEEDBACK_MISROUTED" AS ?reason) }
  UNION { ?subject a ic:Residual ; ic:feedbackTarget ic:UPSTREAM_AUTHORITY . FILTER NOT EXISTS { ?subject ic:standing "BLOCKED" }
          BIND("REFUSED:IC_AUTHORITY_BLOCK_NOT_BLOCKED" AS ?reason) }
  UNION { ?subject a ic:Residual ; ic:feedbackTarget ic:UPSTREAM_AUTHORITY . FILTER NOT EXISTS { ?subject ic:blockedReason ?why }
          BIND("REFUSED:IC_AUTHORITY_BLOCK_UNREASONED" AS ?reason) }
  UNION { ?subject a ic:Residual ; ic:standing ?s . FILTER(!(STR(?s) IN ("UNKNOWN", "BLOCKED"))) BIND("REFUSED:IC_RESIDUAL_STANDING_PROMOTED" AS ?reason) }
} ORDER BY ?subject ?reason
