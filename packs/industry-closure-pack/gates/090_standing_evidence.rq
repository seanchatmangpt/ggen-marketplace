PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ic: <https://seanchatmangpt.github.io/packs/industry-closure-pack#>
PREFIX ea: <https://chatman.ai/ontology/enterprise-architecture#>
PREFIX togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#>
# MESSAGE: standing is the closed vocabulary; ALIVE needs independent, observed, current-subject evidence and a pack-bound SBB; falsified evidence must feed an OPEN residual.
SELECT ?subject ?reason WHERE {
  { ?subject ic:standing ?s . FILTER(!REGEX(STR(?s), "^(UNKNOWN|PARTIAL_ALIVE|ALIVE|BLOCKED|BUILD_BROKEN|UNSUPPORTED|REFUSED:[A-Z0-9_]+)$"))
    BIND("REFUSED:IC_STANDING_INVALID" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:standing "ALIVE" .
          FILTER NOT EXISTS { ?subject ic:evidencedBy ?ev . ?ev a ic:ExecutionEvidence ; ic:receiptDigest ?r ; ic:outcome ic:VERIFIED ; ic:verifiedBy ?v ; ic:evidenceSubject ?d }
          BIND("REFUSED:IC_STANDING_ALIVE_WITHOUT_EVIDENCE" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:standing "ALIVE" ; ic:inSnapshot ?sn ; ic:bySBB ?sbb ; ic:evidencedBy ?ev . ?sbb ea:exactSubject ?d . ?ev ic:evidenceSubject ?e .
          FILTER NOT EXISTS { ?nx ic:supersedes ?sn }
          FILTER(?d != ?e) BIND("REFUSED:IC_STANDING_STALE_SUBJECT" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:standing "ALIVE" ; ic:evidencedBy ?ev . OPTIONAL { ?ev ic:evidenceKind ?k }
          FILTER(!BOUND(?k) || ?k != ic:OBSERVED) BIND("REFUSED:IC_STANDING_SYNTHETIC_ALIVE" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:standing "ALIVE" ; ic:bySBB ?sbb . OPTIONAL { ?sbb ic:marketplacePack ?pk } OPTIONAL { ?sbb ic:packDigest ?pd }
          FILTER(!BOUND(?pk) || !BOUND(?pd)) BIND("REFUSED:IC_STANDING_ALIVE_PACK_UNBOUND" AS ?reason) }
  UNION { ?subject a ic:ExecutionEvidence .
          OPTIONAL { ?subject ic:evidenceFor ?q1 } OPTIONAL { ?subject ic:evidenceSubject ?q2 } OPTIONAL { ?subject ic:outcome ?q3 }
          OPTIONAL { ?subject ic:receiptDigest ?q4 } OPTIONAL { ?subject ic:producedBy ?q5 } OPTIONAL { ?subject ic:verifiedBy ?q6 } OPTIONAL { ?subject ic:evidenceKind ?q7 }
          FILTER(!BOUND(?q1) || !BOUND(?q2) || !BOUND(?q3) || !BOUND(?q4) || !BOUND(?q5) || !BOUND(?q6) || !BOUND(?q7))
          BIND("REFUSED:IC_EVIDENCE_MALFORMED" AS ?reason) }
  UNION { ?subject a ic:ExecutionEvidence ; ic:receiptDigest ?r . FILTER(!REGEX(STR(?r), "^sha256:[0-9a-f]{64}$")) BIND("REFUSED:IC_EVIDENCE_MALFORMED" AS ?reason) }
  UNION { ?subject a ic:ExecutionEvidence ; ic:producedBy ?x ; ic:verifiedBy ?x BIND("REFUSED:IC_EVIDENCE_NOT_INDEPENDENT" AS ?reason) }
  UNION { ?subject a ic:ExecutionEvidence ; ic:outcome ic:FALSIFIED ; ic:evidenceFor ?sbb ; ic:evidenceSubject ?d .
          ?sbb ea:exactSubject ?d ; ea:satisfiesABB ?abb . ?abb ea:realizesCapability ?cap .
          ?req ic:requiresCapability ?cap ; ic:disposition ic:IN_SCOPE .
          FILTER NOT EXISTS { ?res a ic:Residual ; ic:residualOf ?req ; ic:status "OPEN" }
          BIND("REFUSED:IC_EVIDENCE_FALSIFICATION_UNFED" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:standing "ALIVE" . OPTIONAL { ?subject ic:coverageState ?cs }
          FILTER(!BOUND(?cs) || ?cs != ic:LIVE) BIND("REFUSED:IC_STANDING_ALIVE_NOT_LIVE" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:standing "ALIVE" ; ic:inSnapshot ?sn ; ic:bySBB ?sbb . ?sbb ea:exactSubject ?d .
          FILTER NOT EXISTS { ?nx ic:supersedes ?sn }
          ?f a ic:ExecutionEvidence ; ic:evidenceFor ?sbb ; ic:evidenceSubject ?d ; ic:outcome ic:FALSIFIED
          BIND("REFUSED:IC_STANDING_ALIVE_FALSIFIED" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:standing "ALIVE" ; ic:bySBB ?sbb ; ic:evidencedBy ?ev .
          FILTER NOT EXISTS { ?ev ic:evidenceFor ?sbb } BIND("REFUSED:IC_STANDING_EVIDENCE_FOREIGN" AS ?reason) }
} ORDER BY ?subject ?reason
