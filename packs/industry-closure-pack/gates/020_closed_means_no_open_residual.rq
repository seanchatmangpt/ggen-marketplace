# MESSAGE: Closure is evidence-bearing and cannot coexist with an unresolved residual.
PREFIX ic: <https://ggen.dev/ontology/industry-closure#>
PREFIX req: <https://ggen.io/onto/requirements/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?subject ?reason WHERE {
  {
    ?subject a req:CandidateRequirement ;
             ic:hasAssessment ?a .
    ?a ic:closureState ic:CLOSED .
    FILTER NOT EXISTS { ?a ic:qualificationEvidence ?e . ?e a prov:Entity }
    BIND("closed-requirement-without-qualification-evidence" AS ?reason)
  } UNION {
    ?subject a req:CandidateRequirement ;
             ic:hasAssessment ?a .
    ?a ic:closureState ic:CLOSED ;
       ic:emitsResidual ?r .
    ?r a ic:ClosureResidual ;
       ic:unresolved true .
    BIND("closed-requirement-has-unresolved-residual" AS ?reason)
  } UNION {
    ?subject a req:CandidateRequirement ;
             ic:hasAssessment ?a .
    FILTER NOT EXISTS { ?a ic:authority "SELECT_CONSTRUCT_ONLY" }
    BIND("closure-assessment-must-not-grant-DO-authority" AS ?reason)
  }
}
ORDER BY ?subject ?reason
