PREFIX ic: <https://ggen.dev/ontology/industry-closure#>
PREFIX req: <https://ggen.io/onto/requirements/>
SELECT ?requirement ?assessment ?residual ?kind ?missing WHERE {
  ?requirement a req:CandidateRequirement ;
               ic:hasAssessment ?assessment .
  ?assessment ic:closureState ic:RESIDUAL ;
              ic:emitsResidual ?residual .
  ?residual a ic:ClosureResidual ;
            ic:unresolved true ;
            ic:residualKind ?kind ;
            ic:missingSemanticCapability ?missing .
}
ORDER BY ?kind ?requirement ?residual
