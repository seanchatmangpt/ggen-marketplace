---
to: "mix.exs"
sparql:
  spec: |
    PREFIX ggi: <http://seanchatmangpt.github.io/packs/ggen-igniter-bootstrap#>
    SELECT DISTINCT ?app_name ?top_module WHERE {
      ?s a ggi:LibrarySpec ; ggi:appName ?app_name ; ggi:topModule ?top_module .
    }
---
defmodule {{ spec[0].top_module }}.MixProject do
  use Mix.Project

  def project do
    [
      app: :{{ spec[0].app_name }},
      version: "0.1.0",
      elixir: "~> 1.17",
      start_permanent: Mix.env() == :prod,
      deps: deps()
    ]
  end

  def application do
    [extra_applications: [:logger]]
  end

  defp deps do
    [
      {:rdf, "~> 3.0"},
      {:sparql, "~> 0.3"},
      {:igniter, "~> 0.8"}
    ]
  end
end
