@prefix nvc: <https://ggen.dev/marketplace/noun-verb-cli-pack#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

nvc:MarketplaceCliApp a nvc:GeneratorFirstConsumer ;
    rdfs:label "marketplace_cli" ;
    nvc:displaces nvc:MarketplacePyScript ;
    nvc:usesLibrary nvc:ExNounVerbCli ;
    nvc:usesGraphEngine nvc:GgenIgniter .

nvc:MarketplacePyScript a nvc:PythonTool ;
    rdfs:label "scripts/marketplace.py" .

nvc:ExNounVerbCli a nvc:ElixirLibrary ;
    rdfs:label "ex_noun_verb_cli" .

nvc:GgenIgniter a nvc:ElixirLibrary ;
    rdfs:label "ggen_igniter" .

nvc:ValidateVerb a nvc:CliVerb ;
    nvc:noun "marketplace" ;
    nvc:verb "validate" ;
    nvc:belongsTo nvc:MarketplaceCliApp .

nvc:CatalogVerb a nvc:CliVerb ;
    nvc:noun "marketplace" ;
    nvc:verb "catalog" ;
    nvc:belongsTo nvc:MarketplaceCliApp .
