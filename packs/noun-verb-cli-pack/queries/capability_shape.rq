PREFIX nvc: <https://ggen.dev/marketplace/noun-verb-cli-pack#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Real consumer of nvc:displaces / nvc:usesLibrary / nvc:usesGraphEngine.
#
# Reports the app's displacement/library claims for real, so they are
# checkable against packages/marketplace-cli/mix.exs's real deps() (which
# names ex_noun_verb_cli and ggen_igniter as path: deps) rather than sitting
# in ontology.ttl as an assertion nothing ever reads back. Executed by
# packages/marketplace-cli/test/marketplace_cli/cli_verbs_query_test.exs.
SELECT ?app ?displaces ?library ?graphEngine WHERE {
    ?app a nvc:GeneratorFirstConsumer ;
        nvc:displaces ?displaces ;
        nvc:usesLibrary ?library ;
        nvc:usesGraphEngine ?graphEngine .
}
