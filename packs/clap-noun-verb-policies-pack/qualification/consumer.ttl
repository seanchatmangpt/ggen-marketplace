@prefix cnv-policies: <https://clap-noun-verb.dev/ontology/policies#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Synthetic consumer fixture: the one cnv-policies:Config a consuming project admits.
<https://clap-noun-verb.dev/qualification/policies#config> a cnv-policies:Config ;
    cnv-policies:maxSizeGb "5.0"^^xsd:decimal ;
    cnv-policies:pruneAfterDays "7"^^xsd:integer ;
    cnv-policies:trybuildPath "tests/ui" ;
    cnv-policies:requireCleanTreeDefault "true"^^xsd:boolean .
