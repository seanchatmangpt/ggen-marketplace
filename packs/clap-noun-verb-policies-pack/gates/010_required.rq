# MESSAGE: every cnv-policies:Config node must contain the fields required to render a real policies.rs; any row is a refusal.
PREFIX cnv-policies: <https://clap-noun-verb.dev/ontology/policies#>
SELECT ?subject ?missing WHERE {
  ?subject a cnv-policies:Config .
  VALUES ?missing { cnv-policies:maxSizeGb cnv-policies:pruneAfterDays cnv-policies:trybuildPath cnv-policies:requireCleanTreeDefault }
  FILTER NOT EXISTS { ?subject ?missing ?value }
}
ORDER BY ?subject ?missing
