# Vocabulary for cnv-policies:Config -- the one admitted individual a
# consuming project declares to generate its src/policies.rs.
@prefix cnv-policies: <https://clap-noun-verb.dev/ontology/policies#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cnv-policies:Config a rdfs:Class ;
    rdfs:comment "One consuming project's Autonomic CI/CD Policies configuration -- the knobs clap-noun-verb-policies-pack's template substitutes into a generated src/policies.rs." .

cnv-policies:maxSizeGb a rdf:Property ;
    rdfs:domain cnv-policies:Config ;
    rdfs:comment "Default max acceptable target/ directory size in GB before TargetPressurePolicy suggests pruning." .

cnv-policies:pruneAfterDays a rdf:Property ;
    rdfs:domain cnv-policies:Config ;
    rdfs:comment "Default days before automatic pruning is suggested." .

cnv-policies:trybuildPath a rdf:Property ;
    rdfs:domain cnv-policies:Config ;
    rdfs:comment "Default path to trybuild test fixtures TrybuildChangedPolicy watches." .

cnv-policies:requireCleanTreeDefault a rdf:Property ;
    rdfs:domain cnv-policies:Config ;
    rdfs:comment "Default value for GitPhaseDirtyPolicy's require_clean_tree." .
