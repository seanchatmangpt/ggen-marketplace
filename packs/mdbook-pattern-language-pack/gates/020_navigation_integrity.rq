# MESSAGE: no two mdp:NavigationEntry individuals may share the same
# mdp:position — templates/SUMMARY.md.tmpl relies on ORDER BY ?position being
# a total, unambiguous order, and a tie makes replay position-order-dependent
# rather than deterministic. Every mdp:NavigationEntry's mdp:kind must be
# exactly "heading" or "chapter" — those are the only two values
# templates/SUMMARY.md.tmpl's {% if row.kind == "heading" %} branch
# understands; anything else silently falls into the chapter-link branch,
# a silent-wrong-output risk rather than a refusal. Any row = a violation.
PREFIX mdp: <https://seanchatmangpt.github.io/ggen-marketplace/mdbook-pattern-language#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?s ?reason WHERE {
  {
    ?s a mdp:NavigationEntry ; mdp:position ?position .
    ?other a mdp:NavigationEntry ; mdp:position ?position .
    FILTER (?s != ?other)
    BIND("duplicate mdp:position" AS ?reason)
  } UNION {
    ?s a mdp:NavigationEntry ; mdp:kind ?kind .
    FILTER (?kind != "heading" && ?kind != "chapter")
    BIND("invalid mdp:kind" AS ?reason)
  }
}
ORDER BY ?s ?reason
