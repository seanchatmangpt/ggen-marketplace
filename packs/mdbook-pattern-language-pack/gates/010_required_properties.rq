# MESSAGE: every mdp:Book must have a non-empty dcterms:title, dcterms:creator,
# dcterms:language, mdp:srcDir, mdp:buildDir, and mdp:repositoryUrl — these six
# are interpolated by templates/book.toml.tmpl's SPARQL SELECT with no
# OPTIONAL/COALESCE fallback (unlike dcterms:description), so a Book missing
# any of them would fail generation with an opaque template error instead of
# a clear admission refusal; every mdp:NavigationEntry must have a non-empty
# mdp:position, mdp:kind, and dcterms:title for the same reason against
# templates/SUMMARY.md.tmpl's SELECT. Any row = a subject missing its
# required property.
PREFIX mdp: <https://seanchatmangpt.github.io/ggen-marketplace/mdbook-pattern-language#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?s ?missing WHERE {
  {
    ?s a mdp:Book . BIND(dcterms:title AS ?missing)
  } UNION {
    ?s a mdp:Book . BIND(dcterms:creator AS ?missing)
  } UNION {
    ?s a mdp:Book . BIND(dcterms:language AS ?missing)
  } UNION {
    ?s a mdp:Book . BIND(mdp:srcDir AS ?missing)
  } UNION {
    ?s a mdp:Book . BIND(mdp:buildDir AS ?missing)
  } UNION {
    ?s a mdp:Book . BIND(mdp:repositoryUrl AS ?missing)
  } UNION {
    ?s a mdp:NavigationEntry . BIND(mdp:position AS ?missing)
  } UNION {
    ?s a mdp:NavigationEntry . BIND(mdp:kind AS ?missing)
  } UNION {
    ?s a mdp:NavigationEntry . BIND(dcterms:title AS ?missing)
  }
  FILTER NOT EXISTS { ?s ?missing ?any }
}
ORDER BY ?s ?missing
