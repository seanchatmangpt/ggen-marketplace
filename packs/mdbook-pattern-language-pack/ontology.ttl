@prefix mdp: <https://seanchatmangpt.github.io/ggen-marketplace/mdbook-pattern-language#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

mdp:Book a rdfs:Class ;
    rdfs:label "mdBook" ;
    rdfs:comment "A deterministic publication projection over an ordered Markdown corpus." .

mdp:NavigationEntry a rdfs:Class ;
    rdfs:label "Navigation entry" ;
    rdfs:comment "An ordered heading or chapter link projected into SUMMARY.md." .

mdp:srcDir a rdf:Property .
mdp:buildDir a rdf:Property .
mdp:repositoryUrl a rdf:Property .
mdp:position a rdf:Property .
mdp:kind a rdf:Property .
mdp:path a rdf:Property .

mdp:PatternLanguage a skos:ConceptScheme ;
    dcterms:title "mdBook Pattern Language" ;
    dcterms:description "Patterns for manufacturing a reviewable mdBook from admitted RDF facts rather than hand-maintained navigation metadata." .

mdp:OntologyFirstNavigation a skos:Concept ;
    skos:inScheme mdp:PatternLanguage ;
    skos:prefLabel "Ontology-first navigation" ;
    skos:definition "Represent book identity, headings, chapter paths, and order as facts; project mdBook control files from those facts." .

mdp:DiataxisSpine a skos:Concept ;
    skos:inScheme mdp:PatternLanguage ;
    skos:prefLabel "Diátaxis spine" ;
    skos:definition "Keep tutorials, how-to guides, reference, and explanation as distinct navigation regions instead of flattening documentation by filename." .

mdp:SummaryAsProjection a skos:Concept ;
    skos:inScheme mdp:PatternLanguage ;
    skos:prefLabel "SUMMARY as projection" ;
    skos:definition "Treat SUMMARY.md as a generated navigation consequence, never as an independent catalog of documentation." .

mdp:ExistingMarkdownCorpus a skos:Concept ;
    skos:inScheme mdp:PatternLanguage ;
    skos:prefLabel "Existing Markdown corpus" ;
    skos:definition "Generate mdBook control surfaces around existing Markdown instead of copying chapter prose into a second source tree." .

mdp:ExactOrder a skos:Concept ;
    skos:inScheme mdp:PatternLanguage ;
    skos:prefLabel "Exact order" ;
    skos:definition "Make navigation order an explicit integer fact so replay is stable and reviewable." .

mdp:PagesAsConsequence a skos:Concept ;
    skos:inScheme mdp:PatternLanguage ;
    skos:prefLabel "Pages as consequence" ;
    skos:definition "Build and deploy static HTML only after ggen has manufactured the mdBook projection and the mdBook compiler accepts it." .
