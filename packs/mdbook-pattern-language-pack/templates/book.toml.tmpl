---
to: book.toml
sparql:
  book: |
    PREFIX mdp: <https://seanchatmangpt.github.io/ggen-marketplace/mdbook-pattern-language#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?creator ?description ?language ?srcDir ?buildDir ?repositoryUrl WHERE {
      ?book a mdp:Book ;
            dcterms:title ?title ;
            dcterms:creator ?creator ;
            dcterms:language ?language ;
            mdp:srcDir ?srcDir ;
            mdp:buildDir ?buildDir ;
            mdp:repositoryUrl ?repositoryUrl .
      OPTIONAL { ?book dcterms:description ?description_raw . }
      BIND(COALESCE(?description_raw, ?title) AS ?description)
    } ORDER BY ?title LIMIT 1
---
# GENERATED by ggen from mdbook-pattern-language-pack.
# Edit admitted RDF/template source, not this projection.
[book]
title = "{{ book[0].title }}"
authors = ["{{ book[0].creator }}"]
description = "{{ book[0].description }}"
language = "{{ book[0].language }}"
src = "{{ book[0].srcDir }}"

[build]
build-dir = "{{ book[0].buildDir }}"
create-missing = false

[output.html]
git-repository-url = "{{ book[0].repositoryUrl }}"
edit-url-template = "{{ book[0].repositoryUrl }}/edit/main/{{ book[0].srcDir }}/{path}"
site-url = "/ggen-marketplace/"
