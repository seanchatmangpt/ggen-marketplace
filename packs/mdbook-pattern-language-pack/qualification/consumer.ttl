@prefix mdp: <https://seanchatmangpt.github.io/ggen-marketplace/mdbook-pattern-language#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:mdbook-pattern-language:qualification-book> a mdp:Book ;
    dcterms:title "Qualification Book" ;
    dcterms:creator "ggen Marketplace" ;
    dcterms:language "en" ;
    mdp:srcDir "docs" ;
    mdp:buildDir "book" ;
    mdp:repositoryUrl "https://example.invalid/qualification-book" .

<urn:mdbook-pattern-language:qualification-home> a mdp:NavigationEntry ;
    mdp:position 0 ;
    mdp:kind "chapter" ;
    dcterms:title "Home" ;
    mdp:path "index.md" .
