@prefix gli: <https://ggen.dev/ontology/github-live-ingest#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gli:CapturedEnvelope a prov:Entity .
gli:NormalizedObservation a prov:Entity .
gli:EvidenceRoot a prov:Entity .
gli:LineageEdge a prov:Entity .
gli:IngestionReceipt a prov:Entity .
gli:QualificationResult a dqv:QualityMeasurement .

gli:normalizer gli:authority "OBSERVE|VERIFY|CONSTRUCT" ; gli:actuationPerformed false ; gli:networkAllowed false ; gli:requiresExactSubject true ; gli:requiresReceipt true ; gli:preservesRawDigest true ; gli:preservesFailedEdges true .

gli:ExactSubjectMetric a dqv:Metric ; dcterms:title "Exact repository@SHA correspondence" .
gli:RootLineageMetric a dqv:Metric ; dcterms:title "Cross-run evidence-root lineage coverage" .
gli:ReplayMetric a dqv:Metric ; dcterms:title "Byte-stable normalization replay" .
