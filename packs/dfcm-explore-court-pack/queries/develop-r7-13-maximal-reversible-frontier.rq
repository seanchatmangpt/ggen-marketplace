PREFIX ex: <https://ggen.dev/ontology/dfcm-explore#>
SELECT ?candidate ?novelty ?reversibility ?evidence ?rollback WHERE {
  ?candidate a ex:Candidate ; ex:ctqNovelty ?novelty ; ex:ctqReversibility ?reversibility ; ex:ctqEvidence ?evidence ; ex:rollbackCost ?rollback .
  FILTER(?reversibility >= 9 && ?rollback <= 2)
} ORDER BY DESC(?evidence) DESC(?novelty) ?rollback ?candidate
