PREFIX ex: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm-explore#>
SELECT ?candidate ?family ?method ?evidence ?falsifier WHERE { ?candidate a ex:Candidate ; ex:family ?family ; ex:method ?method ; ex:evidence ?evidence ; ex:falsifier ?falsifier ; ex:standing ex:unknown . FILTER(?family IN ("bandit","tree-search","evolutionary","game-theoretic","constraint","distributed","process-intelligence","meta-selection")) } ORDER BY ?family ?method
