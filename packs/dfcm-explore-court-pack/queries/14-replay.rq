PREFIX ex: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm-explore#>
SELECT ?candidate ?family ?method ?evidence ?falsifier WHERE { ?candidate a ex:Candidate ; ex:family ?family ; ex:method ?method ; ex:evidence ?evidence ; ex:falsifier ?falsifier . FILTER(CONTAINS(LCASE(STR(?evidence)), "replay")) } ORDER BY ?family ?method
