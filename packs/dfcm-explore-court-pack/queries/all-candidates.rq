PREFIX ex: <https://ggen.dev/ontology/dfcm-explore#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?candidate ?title ?novelty ?reversibility ?evidence ?rollback ?falsifier ?standing WHERE {
  ?candidate a ?kind ; dct:title ?title ; ex:ctqNovelty ?novelty ; ex:ctqReversibility ?reversibility ; ex:ctqEvidence ?evidence ; ex:rollbackCost ?rollback ; ex:falsifier ?falsifier ; ex:standing ?standing .
  ?kind <http://www.w3.org/2000/01/rdf-schema#subClassOf> ex:Candidate .
} ORDER BY DESC(?reversibility) DESC(?evidence) DESC(?novelty) ?title
