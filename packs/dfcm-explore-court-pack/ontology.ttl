@prefix ex: <https://ggen.dev/ontology/dfcm-explore#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .

ex:Candidate a rdfs:Class .
ex:AlgorithmicCandidate a rdfs:Class ; rdfs:subClassOf ex:Candidate .
ex:SemanticCandidate a rdfs:Class ; rdfs:subClassOf ex:Candidate .
ex:RuntimeCandidate a rdfs:Class ; rdfs:subClassOf ex:Candidate .
ex:VerifierCandidate a rdfs:Class ; rdfs:subClassOf ex:Candidate .
ex:RecoveryCandidate a rdfs:Class ; rdfs:subClassOf ex:Candidate .
ex:ctqNovelty a rdf:Property .
ex:ctqReversibility a rdf:Property .
ex:ctqEvidence a rdf:Property .
ex:rollbackCost a rdf:Property .
ex:falsifier a rdf:Property .
ex:standing a rdf:Property .
ex:assumption a rdf:Property .

ex:paretoFrontier a ex:AlgorithmicCandidate ; dct:title "Pareto frontier preservation" ; ex:ctqNovelty 8 ; ex:ctqReversibility 10 ; ex:ctqEvidence 8 ; ex:rollbackCost 1 ; ex:falsifier "Dominated candidate survives frontier reduction" ; ex:standing "PARTIAL_ALIVE" .
ex:epsilonDominance a ex:AlgorithmicCandidate ; dct:title "Epsilon-dominance archive" ; ex:ctqNovelty 8 ; ex:ctqReversibility 9 ; ex:ctqEvidence 7 ; ex:rollbackCost 1 ; ex:falsifier "Archive cardinality is unbounded under configured epsilon" ; ex:standing "PARTIAL_ALIVE" .
ex:ucbBandit a ex:AlgorithmicCandidate ; dct:title "UCB exploration scheduler" ; ex:ctqNovelty 7 ; ex:ctqReversibility 9 ; ex:ctqEvidence 8 ; ex:rollbackCost 1 ; ex:falsifier "Unvisited arm is never selected" ; ex:standing "PARTIAL_ALIVE" .
ex:thompsonSampling a ex:AlgorithmicCandidate ; dct:title "Thompson posterior scheduler" ; ex:ctqNovelty 8 ; ex:ctqReversibility 9 ; ex:ctqEvidence 7 ; ex:rollbackCost 1 ; ex:falsifier "Posterior update is non-deterministic under seeded replay" ; ex:standing "PARTIAL_ALIVE" .
ex:mcts a ex:AlgorithmicCandidate ; dct:title "Monte Carlo tree search" ; ex:ctqNovelty 9 ; ex:ctqReversibility 8 ; ex:ctqEvidence 7 ; ex:rollbackCost 2 ; ex:falsifier "Tree policy cannot replay from recorded seed and observations" ; ex:standing "PARTIAL_ALIVE" .
ex:psro a ex:AlgorithmicCandidate ; dct:title "Policy-space response oracle" ; ex:ctqNovelty 10 ; ex:ctqReversibility 9 ; ex:ctqEvidence 6 ; ex:rollbackCost 2 ; ex:falsifier "Best-response addition decreases empirical game support without evidence" ; ex:standing "PARTIAL_ALIVE" .
ex:evolutionaryArchive a ex:AlgorithmicCandidate ; dct:title "Quality-diversity evolutionary archive" ; ex:ctqNovelty 9 ; ex:ctqReversibility 10 ; ex:ctqEvidence 7 ; ex:rollbackCost 2 ; ex:falsifier "Novel behavior descriptor cannot survive objective tie" ; ex:standing "PARTIAL_ALIVE" .
ex:constraintSolver a ex:AlgorithmicCandidate ; dct:title "Constraint-satisfaction explorer" ; ex:ctqNovelty 7 ; ex:ctqReversibility 10 ; ex:ctqEvidence 9 ; ex:rollbackCost 1 ; ex:falsifier "Admitted constraints produce an invalid candidate" ; ex:standing "PARTIAL_ALIVE" .
ex:latticeFixedPoint a ex:SemanticCandidate ; dct:title "Lattice fixed-point closure" ; ex:ctqNovelty 9 ; ex:ctqReversibility 10 ; ex:ctqEvidence 9 ; ex:rollbackCost 1 ; ex:falsifier "Closure is non-monotone for admitted facts" ; ex:standing "PARTIAL_ALIVE" .
ex:categoryComposition a ex:SemanticCandidate ; dct:title "Category-preserving composition" ; ex:ctqNovelty 10 ; ex:ctqReversibility 10 ; ex:ctqEvidence 7 ; ex:rollbackCost 1 ; ex:falsifier "Identity or associativity law fails for admitted morphisms" ; ex:standing "PARTIAL_ALIVE" .
ex:hypergraphDependencies a ex:SemanticCandidate ; dct:title "Hypergraph dependency closure" ; ex:ctqNovelty 9 ; ex:ctqReversibility 10 ; ex:ctqEvidence 8 ; ex:rollbackCost 1 ; ex:falsifier "Required multi-parent dependency is flattened lossily" ; ex:standing "PARTIAL_ALIVE" .
ex:temporalLogic a ex:SemanticCandidate ; dct:title "Temporal-logic candidate obligations" ; ex:ctqNovelty 9 ; ex:ctqReversibility 9 ; ex:ctqEvidence 8 ; ex:rollbackCost 1 ; ex:falsifier "A retained trace violates an admitted safety invariant" ; ex:standing "PARTIAL_ALIVE" .
ex:eventSourcedReplay a ex:RuntimeCandidate ; dct:title "Event-sourced deterministic replay" ; ex:ctqNovelty 8 ; ex:ctqReversibility 10 ; ex:ctqEvidence 10 ; ex:rollbackCost 1 ; ex:falsifier "Same event log yields a different state hash" ; ex:standing "PARTIAL_ALIVE" .
ex:contentAddressedState a ex:RuntimeCandidate ; dct:title "Content-addressed candidate state" ; ex:ctqNovelty 8 ; ex:ctqReversibility 10 ; ex:ctqEvidence 10 ; ex:rollbackCost 1 ; ex:falsifier "Equal semantic state maps to divergent canonical digest" ; ex:standing "PARTIAL_ALIVE" .
ex:crdtArchive a ex:RuntimeCandidate ; dct:title "CRDT candidate archive" ; ex:ctqNovelty 9 ; ex:ctqReversibility 10 ; ex:ctqEvidence 8 ; ex:rollbackCost 2 ; ex:falsifier "Replica merge is non-convergent under permutation" ; ex:standing "PARTIAL_ALIVE" .
ex:snapshotDelta a ex:RecoveryCandidate ; dct:title "Snapshot plus delta recovery" ; ex:ctqNovelty 7 ; ex:ctqReversibility 9 ; ex:ctqEvidence 9 ; ex:rollbackCost 2 ; ex:falsifier "Recovered state differs from uninterrupted replay" ; ex:standing "PARTIAL_ALIVE" .
ex:metamorphicOracle a ex:VerifierCandidate ; dct:title "Metamorphic relation oracle" ; ex:ctqNovelty 8 ; ex:ctqReversibility 10 ; ex:ctqEvidence 9 ; ex:rollbackCost 1 ; ex:falsifier "Known invariant-preserving transform changes verdict" ; ex:standing "PARTIAL_ALIVE" .
ex:differentialOracle a ex:VerifierCandidate ; dct:title "Differential reference oracle" ; ex:ctqNovelty 8 ; ex:ctqReversibility 9 ; ex:ctqEvidence 10 ; ex:rollbackCost 1 ; ex:falsifier "Independent implementations disagree without classified domain divergence" ; ex:standing "PARTIAL_ALIVE" .
ex:propertyOracle a ex:VerifierCandidate ; dct:title "Property-based oracle" ; ex:ctqNovelty 7 ; ex:ctqReversibility 10 ; ex:ctqEvidence 9 ; ex:rollbackCost 1 ; ex:falsifier "Generated counterexample is not reproducible from seed" ; ex:standing "PARTIAL_ALIVE" .
ex:processConformance a ex:VerifierCandidate ; dct:title "Process-conformance oracle" ; ex:ctqNovelty 9 ; ex:ctqReversibility 9 ; ex:ctqEvidence 10 ; ex:rollbackCost 1 ; ex:falsifier "Observed trace accepted despite violating admitted process model" ; ex:standing "PARTIAL_ALIVE" .
ex:causalIntervention a ex:VerifierCandidate ; dct:title "Causal intervention probe" ; ex:ctqNovelty 10 ; ex:ctqReversibility 8 ; ex:ctqEvidence 7 ; ex:rollbackCost 2 ; ex:falsifier "Claimed causal edge survives contradictory intervention evidence" ; ex:standing "PARTIAL_ALIVE" .
ex:refusalKernel a ex:VerifierCandidate ; dct:title "Fail-closed refusal kernel" ; ex:ctqNovelty 8 ; ex:ctqReversibility 10 ; ex:ctqEvidence 10 ; ex:rollbackCost 1 ; ex:falsifier "Unknown authority reaches consequential execution" ; ex:standing "PARTIAL_ALIVE" .
