---
# Renders the real Packer googlecompute template for the beam4pm_pro GCE VM
# image from typed b4pi:PackerImage facts -- not an echoed HCL blob.
# Self-contained sync.rs-native format (to:/sparql:), the same convention as
# github-actions-pack/templates/workflow.yml.tmpl.
#
# Single-image contract: exactly one b4pi:PackerImage individual is expected
# per consumer project (see ontology-packer-vocab.ttl); the body projects
# image[0] after ORDER BY ?imageName. All facts the body renders
# unconditionally are REQUIRED triple patterns below (a consumer missing one
# gets zero rows -> a render-time refusal, not a silently defaulted value);
# only description/serviceDescription/networkTag are OPTIONAL, and each is
# guarded in the body. GROUP_CONCAT over the OPTIONAL ?tag wraps COALESCE
# (NotBoundError otherwise on rows where ?tag never binds).
#
# Escaping layers, outer to inner: Tera renders {{ ... }} at ggen sync time;
# Packer/HCL evaluates ${var.*}/${local.*} at packer build time (Tera does
# not touch "${"); bash runs last. No legacy Packer {{timestamp}} syntax
# anywhere (it would collide with Tera).
to: infra/gcp/packer/beam4pm-image.pkr.hcl
force: true
sparql:
  image: |
    PREFIX b4pi: <http://seanchatmangpt.github.io/packs/beam4pm-pro-infra#>
    SELECT ?img ?imageName ?imageFamily ?imageDescription ?gcpProjectDefault
           ?buildZone ?buildMachineType ?buildDiskGb ?sourceImageFamily
           ?sourceImageProject ?sshUsername ?containerImage ?containerName
           ?servicePort ?serviceDescription
           (GROUP_CONCAT(DISTINCT COALESCE(?tag, ""); separator=",") AS ?networkTags)
    WHERE {
      ?img a b4pi:PackerImage ;
           b4pi:imageName ?imageName ;
           b4pi:imageFamily ?imageFamily ;
           b4pi:gcpProjectDefault ?gcpProjectDefault ;
           b4pi:buildZone ?buildZone ;
           b4pi:buildMachineType ?buildMachineType ;
           b4pi:buildDiskGb ?buildDiskGb ;
           b4pi:sourceImageFamily ?sourceImageFamily ;
           b4pi:sourceImageProject ?sourceImageProject ;
           b4pi:sshUsername ?sshUsername ;
           b4pi:packerContainerImage ?containerImage ;
           b4pi:containerName ?containerName ;
           b4pi:servicePort ?servicePort .
      OPTIONAL { ?img b4pi:imageDescription ?imageDescription . }
      OPTIONAL { ?img b4pi:serviceDescription ?serviceDescription . }
      OPTIONAL { ?img b4pi:networkTag ?tag . }
    }
    GROUP BY ?img ?imageName ?imageFamily ?imageDescription ?gcpProjectDefault
             ?buildZone ?buildMachineType ?buildDiskGb ?sourceImageFamily
             ?sourceImageProject ?sshUsername ?containerImage ?containerName
             ?servicePort ?serviceDescription
    ORDER BY ?imageName
---
# GENERATED by ggen (beam4pm-pro-infra-pack/templates/packer-beam4pm-image.pkr.hcl.tmpl). Do not edit.
{%- set img = image[0] %}
#
# Packer template: beam4pm_pro GCE VM image.
# Debian base + Docker + pre-pulled {{ img.containerImage }} + a systemd unit
# running it. Variable defaults live in the sibling generated variables.pkr.hcl.
#
# Build (requires real GCP credentials and Compute Engine API -- NOT run by
# the manufacturing pipeline):
#   packer init  infra/gcp/packer
#   packer build -var "project_id=YOUR_PROJECT" infra/gcp/packer

packer {
  required_version = ">= 1.9.0"

  required_plugins {
    googlecompute = {
      version = ">= 1.1.1"
      source  = "github.com/hashicorp/googlecompute"
    }
  }
}

locals {
  build_ts   = formatdate("YYYYMMDDhhmmss", timestamp())
  image_name = "${var.image_name}-${local.build_ts}"
}

source "googlecompute" "beam4pm" {
  project_id              = var.project_id
  zone                    = var.zone
  machine_type            = var.machine_type
  source_image_family     = var.source_image_family
  source_image_project_id = [var.source_image_project]

  disk_size = var.disk_size_gb
  disk_type = "pd-balanced"

  image_name        = local.image_name
  image_family      = var.image_family
  image_description = {% if img.imageDescription %}"{{ img.imageDescription }}"{% else %}"beam4pm_pro VM image"{% endif %}

  image_labels = {
    managed_by = "ggen"
    product    = "beam4pm-pro"
  }

  ssh_username = var.ssh_username

  tags = [
{%- if img.networkTags %}
{%- for t in img.networkTags | split(pat=",") %}
    "{{ t }}",
{%- endfor %}
{%- endif %}
    "packer-builder",
  ]
}

build {
  name    = "beam4pm-pro-gce-image"
  sources = ["source.googlecompute.beam4pm"]

  # systemd unit for the pre-pulled product container. ${var.container_image}
  # is resolved by Packer at build time, so the unit carries the exact ref
  # the image was baked with.
  provisioner "file" {
    destination = "/tmp/{{ img.containerName }}.service"
    content     = <<-EOT
      [Unit]
      Description={% if img.serviceDescription %}{{ img.serviceDescription }}{% else %}beam4pm_pro service{% endif %}
      After=network-online.target docker.service
      Requires=docker.service
      Wants=network-online.target

      [Service]
      Restart=always
      RestartSec=10
      TimeoutStartSec=300
      ExecStartPre=-/usr/bin/docker rm -f {{ img.containerName }}
      ExecStart=/usr/bin/docker run --rm --name {{ img.containerName }} -p {{ img.servicePort }}:{{ img.servicePort }} ${var.container_image}
      ExecStop=/usr/bin/docker stop {{ img.containerName }}

      [Install]
      WantedBy=multi-user.target
    EOT
  }

  # Generic Debian/apt base-package bootstrap (Docker + prerequisites),
  # rendered from templates/packer-setup.sh.tmpl into a real sibling file
  # (infra/gcp/packer/setup.sh) instead of an inline heredoc -- the
  # BEAMOps/PragProg pattern. ${path.root} keeps this correct regardless of
  # the caller's CWD when invoking `packer build infra/gcp/packer`.
  provisioner "file" {
    source      = "${path.root}/setup.sh"
    destination = "/tmp/setup.sh"
  }

  provisioner "shell" {
    inline = [
      "chmod +x /tmp/setup.sh",
      "sudo bash /tmp/setup.sh",
    ]
  }

  provisioner "file" {
    destination = "/tmp/beam4pm-provision.sh"
    content     = <<-EOT
      #!/usr/bin/env bash
      set -euo pipefail

      echo "=== beam4pm_pro image provisioning ==="

      # Pre-pull the product container so first boot needs no registry
      # round-trip (the image ref is public on GHCR; no credentials baked).
      docker pull ${var.container_image}

      install -m 0644 /tmp/{{ img.containerName }}.service /etc/systemd/system/{{ img.containerName }}.service
      systemctl daemon-reload
      systemctl enable {{ img.containerName }}.service

      # Inspectable image provenance facts (no secrets).
      {
        echo "image_name=${local.image_name}"
        echo "image_family=${var.image_family}"
        echo "container_image=${var.container_image}"
        echo "service_port={{ img.servicePort }}"
        echo "built_ts=${local.build_ts}"
      } > /etc/beam4pm-image-facts

      echo "=== beam4pm_pro image provisioning complete ==="
    EOT
  }

  provisioner "shell" {
    inline = [
      "chmod +x /tmp/beam4pm-provision.sh",
      "sudo bash /tmp/beam4pm-provision.sh",
    ]
  }

  provisioner "shell" {
    inline = [
      "sudo apt-get clean",
      "sudo rm -f /tmp/setup.sh /tmp/beam4pm-provision.sh /tmp/{{ img.containerName }}.service",
    ]
  }
}
