---
# Renders the Cloud Run v2 service module body from the consumer's single
# b4pi:Deployment individual. All graph facts flow through variables.tf
# (rendered by cloudrun_variables_tf.tmpl) as variable DEFAULTS, so this
# file references only var.* -- an operator can override any fact at plan
# time without touching a generated file. Fixed output path => exactly one
# b4pi:Deployment is assumed; deployments[0] after ORDER BY(?serviceName)
# is the deterministic subject (same single-subject convention as
# gh-terraform-pack's variables_tf.tmpl row[0]).
#
# Lineage: adapted from erlmcp marketplace/gcp/terraform/modules/cloud-run
# (conditional allUsers run.invoker member, deny-public-by-default posture)
# and tai-erlang-autonomics gcp/cloud-run.tf (min/max scaling facts, probe
# discipline, managed-by labels), rebuilt on google_cloud_run_v2_service
# (both references were still on the v1 resource). Product-specific parts
# of both (erlmcp secrets/domain-mapping/random-suffix, TAI Firestore and
# pub/sub env wiring) are deliberately not ported.
to: infra/gcp/cloudrun/main.tf
sparql:
  deployments: |
    PREFIX b4pi: <http://seanchatmangpt.github.io/packs/beam4pm-pro-infra#>
    SELECT ?d ?serviceName WHERE {
      ?d a b4pi:Deployment ; b4pi:serviceName ?serviceName .
    } ORDER BY ?serviceName
---
# GENERATED by ggen (beam4pm-pro-infra-pack cloudrun_main_tf.tmpl) from the
# b4pi:Deployment facts for "{{ deployments[0].serviceName }}". Do not edit.
# Edit the b4pi: facts in the project ontology and re-run `ggen sync run`.

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 8.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

# Cloud Run v2 service. Every argument that came from the graph is a var.*
# reference whose default carries the graph fact -- see variables.tf.
resource "google_cloud_run_v2_service" "service" {
  name     = var.service_name
  location = var.region
  ingress  = "INGRESS_TRAFFIC_ALL"

  # This module's standing ceiling is `validate`; nothing it describes has
  # been applied, so there is no live revision to protect yet. Flip to true
  # before any real production apply.
  deletion_protection = false

  template {
    scaling {
      min_instance_count = var.min_instances
      max_instance_count = var.max_instances
    }

    max_instance_request_concurrency = var.concurrency
    timeout                          = "${var.timeout_seconds}s"

    containers {
      image = var.container_image

      ports {
        name           = "http1"
        container_port = var.container_port
      }

      resources {
        limits = {
          cpu    = var.cpu_limit
          memory = var.memory_limit
        }
        cpu_idle = true
      }

      # TCP startup probe on the serving port: path-agnostic on purpose --
      # this pack asserts nothing about the container's HTTP route table.
      startup_probe {
        tcp_socket {
          port = var.container_port
        }
        initial_delay_seconds = 5
        period_seconds        = 5
        timeout_seconds       = 3
        failure_threshold     = 6
      }

      dynamic "env" {
        for_each = var.environment_variables
        content {
          name  = env.key
          value = env.value
        }
      }
    }
  }

  traffic {
    type    = "TRAFFIC_TARGET_ALLOCATION_TYPE_LATEST"
    percent = 100
  }

  labels = {
    app        = var.service_name
    managed-by = "terraform"
    origin     = "ggen-beam4pm-pro-infra-pack"
  }
}

# Public access is an explicit, graph-stated decision (b4pi:allowUnauthenticated),
# never a side effect: the allUsers invoker member exists only when the
# operator-visible variable (defaulted from the graph fact) is true.
resource "google_cloud_run_v2_service_iam_member" "public_invoker" {
  count    = var.allow_unauthenticated ? 1 : 0
  project  = google_cloud_run_v2_service.service.project
  location = google_cloud_run_v2_service.service.location
  name     = google_cloud_run_v2_service.service.name
  role     = "roles/run.invoker"
  member   = "allUsers"
}
