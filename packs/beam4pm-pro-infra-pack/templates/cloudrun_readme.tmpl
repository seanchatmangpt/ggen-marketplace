---
# Renders the module README with the deployment's real graph facts and an
# honest standing statement. b4pi:purpose is optional (OPTIONAL pattern);
# the body falls back to a generic sentence when absent.
to: infra/gcp/cloudrun/README.md
sparql:
  deployments: |
    PREFIX b4pi: <http://seanchatmangpt.github.io/packs/beam4pm-pro-infra#>
    SELECT ?d ?serviceName ?region ?containerImage ?cpuLimit ?memoryLimit
           ?minInstances ?maxInstances ?port ?allowUnauthenticated ?purpose
    WHERE {
      ?d a b4pi:Deployment ;
         b4pi:serviceName          ?serviceName ;
         b4pi:region               ?region ;
         b4pi:containerImage       ?containerImage ;
         b4pi:cpuLimit             ?cpuLimit ;
         b4pi:memoryLimit          ?memoryLimit ;
         b4pi:minInstances         ?minInstances ;
         b4pi:maxInstances         ?maxInstances ;
         b4pi:port                 ?port ;
         b4pi:allowUnauthenticated ?allowUnauthenticated .
      OPTIONAL { ?d b4pi:purpose ?purpose . }
    } ORDER BY ?serviceName
---
