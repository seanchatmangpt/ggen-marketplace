---
# Renders variables.pkr.hcl for the beam4pm_pro GCE image build. Every
# default below is a fact from the consumer's RDF graph (b4pi:PackerImage),
# not a hand-typed literal -- change the graph, rerun `ggen sync run`,
# never edit the rendered file. Same single-image contract and required/
# OPTIONAL split as packer-beam4pm-image.pkr.hcl.tmpl (the two templates
# share one query so they can never disagree about the same fact).
to: infra/gcp/packer/variables.pkr.hcl
force: true
sparql:
  image: |
    PREFIX b4pi: <http://seanchatmangpt.github.io/packs/beam4pm-pro-infra#>
    SELECT ?img ?imageName ?imageFamily ?gcpProjectDefault ?buildZone
           ?buildMachineType ?buildDiskGb ?sourceImageFamily
           ?sourceImageProject ?sshUsername ?containerImage
    WHERE {
      ?img a b4pi:PackerImage ;
           b4pi:imageName ?imageName ;
           b4pi:imageFamily ?imageFamily ;
           b4pi:gcpProjectDefault ?gcpProjectDefault ;
           b4pi:buildZone ?buildZone ;
           b4pi:buildMachineType ?buildMachineType ;
           b4pi:buildDiskGb ?buildDiskGb ;
           b4pi:sourceImageFamily ?sourceImageFamily ;
           b4pi:sourceImageProject ?sourceImageProject ;
           b4pi:sshUsername ?sshUsername ;
           b4pi:containerImage ?containerImage .
    }
    ORDER BY ?imageName
---
# GENERATED by ggen (beam4pm-pro-infra-pack/templates/packer-variables.pkr.hcl.tmpl). Do not edit.
{%- set img = image[0] %}
#
# Variable defaults are projected from the consumer RDF graph. project_id
# defaults to a demo placeholder -- a real build MUST override it:
#   packer build -var "project_id=YOUR_PROJECT" infra/gcp/packer

variable "project_id" {
  type        = string
  description = "GCP project ID to build the image in (default is a demo placeholder, not a real project)"
  default     = "{{ img.gcpProjectDefault }}"
}

variable "zone" {
  type        = string
  description = "GCP zone for the temporary build instance"
  default     = "{{ img.buildZone }}"
}

variable "machine_type" {
  type        = string
  description = "Machine type for the temporary build instance"
  default     = "{{ img.buildMachineType }}"
}

variable "source_image_family" {
  type        = string
  description = "Public base image family the build starts from"
  default     = "{{ img.sourceImageFamily }}"
}

variable "source_image_project" {
  type        = string
  description = "Project hosting the source image family"
  default     = "{{ img.sourceImageProject }}"
}

variable "image_name" {
  type        = string
  description = "Base name for the produced image (a build timestamp is appended)"
  default     = "{{ img.imageName }}"
}

variable "image_family" {
  type        = string
  description = "Image family the produced image joins"
  default     = "{{ img.imageFamily }}"
}

variable "disk_size_gb" {
  type        = number
  description = "Build/boot disk size in GB"
  default     = {{ img.buildDiskGb }}
}

variable "ssh_username" {
  type        = string
  description = "SSH username Packer provisions through"
  default     = "{{ img.sshUsername }}"
}

variable "container_image" {
  type        = string
  description = "OCI image ref pre-pulled and run by the baked systemd unit (override to pin a digest)"
  default     = "{{ img.containerImage }}"
}
