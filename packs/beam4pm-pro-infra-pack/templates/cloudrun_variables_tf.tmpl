---
# Renders variables.tf with every graph fact as a variable DEFAULT: the
# graph is the source of the recorded decision, the variable is the
# operator's override lever. project_id has no graph fact by design -- a
# real project id must never be a committed fact; the default is the
# placeholder "beam4pm-pro-demo". Integer facts (minInstances/maxInstances/
# port) arrive as real Tera numbers (bare Turtle integers are xsd:integer,
# coerced by the engine), booleans as real Tera booleans -- both render as
# bare HCL tokens, not quoted strings.
to: infra/gcp/cloudrun/variables.tf
sparql:
  deployments: |
    PREFIX b4pi: <http://seanchatmangpt.github.io/packs/beam4pm-pro-infra#>
    SELECT ?d ?serviceName ?region ?containerImage ?cpuLimit ?memoryLimit
           ?minInstances ?maxInstances ?port ?allowUnauthenticated
    WHERE {
      ?d a b4pi:Deployment ;
         b4pi:serviceName          ?serviceName ;
         b4pi:region               ?region ;
         b4pi:containerImage       ?containerImage ;
         b4pi:cpuLimit             ?cpuLimit ;
         b4pi:memoryLimit          ?memoryLimit ;
         b4pi:minInstances         ?minInstances ;
         b4pi:maxInstances         ?maxInstances ;
         b4pi:port                 ?port ;
         b4pi:allowUnauthenticated ?allowUnauthenticated .
    } ORDER BY ?serviceName
---
# GENERATED by ggen (beam4pm-pro-infra-pack cloudrun_variables_tf.tmpl) from the
# b4pi:Deployment facts for "{{ deployments[0].serviceName }}". Do not edit.
# Edit the b4pi: facts in the project ontology and re-run `ggen sync run`.

variable "project_id" {
  type        = string
  default     = "beam4pm-pro-demo"
  description = "GCP project id. The default is a placeholder, not a real project -- override it for any real plan/apply."
}

variable "service_name" {
  type        = string
  default     = "{{ deployments[0].serviceName }}"
  description = "Cloud Run service name (graph fact b4pi:serviceName)."
}

variable "region" {
  type        = string
  default     = "{{ deployments[0].region }}"
  description = "GCP region for the service (graph fact b4pi:region)."
}

variable "container_image" {
  type        = string
  default     = "{{ deployments[0].containerImage }}"
  description = "Container image to deploy (graph fact b4pi:containerImage). A real Cloud Run deploy requires this to be pullable from Artifact Registry / gcr.io; a ghcr.io default names the canonical artifact and must be mirrored first."
}

variable "cpu_limit" {
  type        = string
  default     = "{{ deployments[0].cpuLimit }}"
  description = "CPU limit in Cloud Run string form (graph fact b4pi:cpuLimit)."
}

variable "memory_limit" {
  type        = string
  default     = "{{ deployments[0].memoryLimit }}"
  description = "Memory limit in Cloud Run string form (graph fact b4pi:memoryLimit)."
}

variable "min_instances" {
  type        = number
  default     = {{ deployments[0].minInstances }}
  description = "Minimum instance count; 0 scales to zero (graph fact b4pi:minInstances)."
}

variable "max_instances" {
  type        = number
  default     = {{ deployments[0].maxInstances }}
  description = "Maximum instance count (graph fact b4pi:maxInstances)."
}

variable "container_port" {
  type        = number
  default     = {{ deployments[0].port }}
  description = "Port the container listens on; also the TCP startup-probe port (graph fact b4pi:port)."
}

variable "allow_unauthenticated" {
  type        = bool
  default     = {{ deployments[0].allowUnauthenticated }}
  description = "Grant allUsers roles/run.invoker (graph fact b4pi:allowUnauthenticated). Keep false unless public exposure is a stated product decision."
}

variable "concurrency" {
  type        = number
  default     = 80
  description = "Max concurrent requests per instance. Operator lever, no graph fact."
}

variable "timeout_seconds" {
  type        = number
  default     = 300
  description = "Request timeout in seconds. Operator lever, no graph fact."
}

variable "environment_variables" {
  type        = map(string)
  default     = {}
  description = "Plain (non-secret) environment variables for the container. Operator lever, no graph fact. Secrets are out of this module's scope on purpose -- wire Secret Manager separately; never pass secret material through this map."
}
