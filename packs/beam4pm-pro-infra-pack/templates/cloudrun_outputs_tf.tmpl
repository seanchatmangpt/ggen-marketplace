---
# Renders outputs.tf. Output values are attributes of the single rendered
# google_cloud_run_v2_service resource; nothing here needs per-fact
# templating beyond the deployment's name in the generated header.
to: infra/gcp/cloudrun/outputs.tf
sparql:
  deployments: |
    PREFIX b4pi: <http://seanchatmangpt.github.io/packs/beam4pm-pro-infra#>
    SELECT ?d ?serviceName WHERE {
      ?d a b4pi:Deployment ; b4pi:serviceName ?serviceName .
    } ORDER BY ?serviceName
---
# GENERATED by ggen (beam4pm-pro-infra-pack cloudrun_outputs_tf.tmpl) from the
# b4pi:Deployment facts for "{{ deployments[0].serviceName }}". Do not edit.
# Edit the b4pi: facts in the project ontology and re-run `ggen sync run`.

output "service_uri" {
  description = "URI of the deployed Cloud Run service (known only after a real apply)."
  value       = google_cloud_run_v2_service.service.uri
}

output "service_name" {
  description = "Name of the Cloud Run service."
  value       = google_cloud_run_v2_service.service.name
}

output "location" {
  description = "Region the service is deployed in."
  value       = google_cloud_run_v2_service.service.location
}

output "latest_ready_revision" {
  description = "Latest revision serving traffic (known only after a real apply)."
  value       = google_cloud_run_v2_service.service.latest_ready_revision
}

output "public_access" {
  description = "Whether allUsers holds roles/run.invoker on this service."
  value       = var.allow_unauthenticated
}
