# MESSAGE: beam4pm-pro-infra-pack required-facts gate. Every b4pi:Deployment must
# MESSAGE: declare all nine facts the Cloud Run templates render from: b4pi:serviceName,
# MESSAGE: b4pi:region, b4pi:containerImage, b4pi:cpuLimit, b4pi:memoryLimit,
# MESSAGE: b4pi:minInstances, b4pi:maxInstances, b4pi:port, and b4pi:allowUnauthenticated.
# MESSAGE: A deployment missing any of them would render a Terraform module with an
# MESSAGE: empty variable default (guaranteed `terraform validate` failure at best, a
# MESSAGE: silently-wrong default at worst), and an unstated b4pi:allowUnauthenticated
# MESSAGE: is an undecided public-exposure posture -- refused, never defaulted. Any row
# MESSAGE: = a subject missing the bound property. Every pattern is typed on
# MESSAGE: b4pi:Deployment, so this gate is namespace-scoped and composes with other
# MESSAGE: packs' graphs (e.g. beam4pm's own bpm: facts) without cross-firing.
PREFIX b4pi: <http://seanchatmangpt.github.io/packs/beam4pm-pro-infra#>
SELECT ?s ?missing WHERE {
  {
    ?s a b4pi:Deployment . BIND(b4pi:serviceName AS ?missing)
  } UNION {
    ?s a b4pi:Deployment . BIND(b4pi:region AS ?missing)
  } UNION {
    ?s a b4pi:Deployment . BIND(b4pi:containerImage AS ?missing)
  } UNION {
    ?s a b4pi:Deployment . BIND(b4pi:cpuLimit AS ?missing)
  } UNION {
    ?s a b4pi:Deployment . BIND(b4pi:memoryLimit AS ?missing)
  } UNION {
    ?s a b4pi:Deployment . BIND(b4pi:minInstances AS ?missing)
  } UNION {
    ?s a b4pi:Deployment . BIND(b4pi:maxInstances AS ?missing)
  } UNION {
    ?s a b4pi:Deployment . BIND(b4pi:port AS ?missing)
  } UNION {
    ?s a b4pi:Deployment . BIND(b4pi:allowUnauthenticated AS ?missing)
  }
  FILTER NOT EXISTS { ?s ?missing ?any }
}
ORDER BY ?s ?missing
