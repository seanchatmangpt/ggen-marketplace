# MESSAGE: beam4pm-pro-infra-pack PackerImage required-facts gate. Every
# MESSAGE: b4pi:PackerImage must declare all twelve facts
# MESSAGE: templates/packer-beam4pm-image.pkr.hcl.tmpl's SPARQL requires without
# MESSAGE: OPTIONAL: b4pi:imageName, b4pi:imageFamily, b4pi:gcpProjectDefault,
# MESSAGE: b4pi:buildZone, b4pi:buildMachineType, b4pi:buildDiskGb,
# MESSAGE: b4pi:sourceImageFamily, b4pi:sourceImageProject, b4pi:sshUsername,
# MESSAGE: b4pi:packerContainerImage, b4pi:containerName, b4pi:servicePort. Before this
# MESSAGE: gate existed, a missing PackerImage fact produced a zero-row template query
# MESSAGE: and an unguarded `image[0]` index, surfacing as an undiagnosable
# MESSAGE: "Variable not found in context" Tera stack trace instead of a named
# MESSAGE: FM-PACK-013 refusal naming the exact missing predicate and subject (real
# MESSAGE: failure confirmed by adversarial review, then fixed here). Any row = a
# MESSAGE: subject missing the bound property.
PREFIX b4pi: <http://seanchatmangpt.github.io/packs/beam4pm-pro-infra#>
SELECT ?s ?missing WHERE {
  {
    ?s a b4pi:PackerImage . BIND(b4pi:imageName AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:imageFamily AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:gcpProjectDefault AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:buildZone AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:buildMachineType AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:buildDiskGb AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:sourceImageFamily AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:sourceImageProject AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:sshUsername AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:packerContainerImage AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:containerName AS ?missing)
  } UNION {
    ?s a b4pi:PackerImage . BIND(b4pi:servicePort AS ?missing)
  }
  FILTER NOT EXISTS { ?s ?missing ?any }
}
ORDER BY ?s ?missing
