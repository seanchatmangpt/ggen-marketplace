---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch14",
  "files_and_dirs": {
    "README.md": true,
    "agents/multi_agent_system.py": true,
    "ai-governance-alerts.yaml": true,
    "ai-guardrails.py": true,
    "ai_governance/observability.py": true,
    "alert-correlator.py": true,
    "backstage-ai-template.yaml": true,
    "ggen-create.json": true,
    "incident-agent.py": true,
    "load-secrets.sh": true,
    "measure-ai-impact.py": true,
    "platform_chatbot/incident_triage.py": true,
    "platform_chatbot/rag_pipeline.py": true,
    "rag-platform-docs.py": true,
    "requirements.txt": true,
    "runbook-automator.py": true,
    "test-ai-agents.py": true
  },
  "templatize_using_name": "{% endraw %}{{ row.capitalized }}{% raw %}",
  "gen_parent_dir": false
}
{% endraw %}