---
to: "infrastructure/sbb/{{ row.providerVariant }}/{{ row.sbbSlug }}/sbb.tf"
force: true
determinism: true
sparql:
  sbb_group: |
    PREFIX f5ea: <https://ggen.io/ontology/fortune5-enterprise-architecture#>
    SELECT ?sbb ?sbbSlug ?sbbDomain ?region ?providerVariant ?exactSubject WHERE {
      ?sbb a f5ea:Realization ;
           f5ea:sbbSlug ?sbbSlug ;
           f5ea:sbbDomain ?sbbDomain ;
           f5ea:region ?region ;
           f5ea:providerVariant ?providerVariant ;
           f5ea:exactSubject ?exactSubject .
      FILTER(?providerVariant = "aws")
    } ORDER BY ?sbbSlug
---
# GENERATED by `ggen sync` from
# packs/fortune5-enterprise-architecture-pack/templates/aws-sbb.tf.tera --
# do not edit by hand. Renders once per f5ea:Realization individual whose
# f5ea:providerVariant is "aws" (Tera per-row rendering keyed on f5ea:sbbSlug;
# idiom per packs/azure-terraform-pack/templates/main.tf.tmpl:1-14).
#
# ZERO-IAM-WILDCARD LAW: every IAM `actions` list below is drawn from the
# CLOSED action maps declared in the Tera `{% set %}` blocks below. There is
# no variable, no loop input, and no template path by which `actions = ["*"]`
# can be rendered. queries/120-zero-wildcard-iam.rq re-verifies this over the
# rendered resource-description graph; queries/110-aws-sbb-select.rq
# re-verifies qualification by exactSubject digest.
#
# SKELETON: resource blocks are structural stubs (placeholders, no live
# values) for an SBB group spanning IAM Identity Center, Control Tower,
# Transit Gateway, VPC endpoints, and CloudTrail Lake.

{%- set group = row %}

{#- CLOSED IAM action maps. Widening these is a governed edit: any entry that
    is not an enumerated action (including "*") must fail the ASK gate. -#}
{%- set iam_identity_center_actions = {
      "sso":  ["sso:ListInstances", "sso:DescribeInstance", "sso:CreateApplication", "sso:DescribeApplication"],
      "sso-directory": ["sso-directory:DescribeDirectory", "sso-directory:ListDirectories"]
    } %}
{%- set control_tower_actions = {
      "controltower": ["controltower:GetLandingZone", "controltower:ListManagedAccounts", "controltower:GetGuardrail"],
      "organizations": ["organizations:DescribeOrganization", "organizations:ListAccounts"]
    } %}
{%- set network_actions = {
      "transitgateway": ["ec2:DescribeTransitGateways", "ec2:CreateTransitGatewayVpcAttachment", "ec2:DescribeTransitGatewayAttachments"],
      "vpcendpoints": ["ec2:DescribeVpcEndpoints", "ec2:CreateVpcEndpoint"]
    } %}
{%- set cloudtrail_actions = {
      "cloudtraillake": ["cloudtrail:GetEventDataStore", "cloudtrail:ListEventDataStores", "cloudtrail:StartQuery"]
    } %}

{#- Andon guard: if a closed set is ever widened to include a wildcard, render
    a marker that fails terraform validate / tfsec. Simple for-loop form is
    used for universal Tera compatibility. -#}
{%- set all_maps = [iam_identity_center_actions, control_tower_actions, network_actions, cloudtrail_actions] %}
{%- for m in all_maps %}{% for k, acts in m %}{% for a in acts %}{% if a == "*" %}
# ANDON: zero-wildcard IAM law violated in aws-sbb.tf.tera closed action map "{{ k }}" -- refusing to render a valid configuration.
{% endif %}{% endfor %}{% endfor %}{% endfor %}

terraform {
  required_version = ">= 1.7.1"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.40"
    }
  }
}

provider "aws" {
  region = "{{ group.region }}"
}

locals {
  # tags-merge idiom reused from
  # packs/azure-terraform-pack/templates/variables.tf.tmpl (locals block).
  tags = merge(
    {
      workload          = "{{ group.sbbSlug }}"
      domain            = "{{ group.sbbDomain }}"
      sbb-exact-subject = "{{ group.exactSubject }}"
      managed-by        = "terraform"
    },
    var.tags,
  )
}

variable "tags" {
  type    = map(string)
  default = {}
}

# --- IAM Identity Center (SSO) -------------------------------------------
resource "aws_ssoadmin_permission_set" "sbb" {
  name             = "{{ group.sbbSlug }}-permission-set"
  instance_arn     = var.sso_instance_arn
  session_duration = "PT1H"
  tags             = local.tags
}

resource "aws_ssoadmin_managed_policy_attachment" "sbb" {
  instance_arn       = aws_ssoadmin_permission_set.sbb.instance_arn
  permission_set_arn = aws_ssoadmin_permission_set.sbb.arn
  managed_policy_arn = var.sso_managed_policy_arn
}

resource "aws_iam_role_policy_inline" "sbb_identity_center" {
  name = "{{ group.sbbSlug }}-identity-center-inline"
  role = var.sbb_role_name

  # Every action enumerated; wildcard forbidden by template law.
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid      = "IdentityCenterEnumeratedOnly"
      Effect   = "Allow"
      Resource = "*"
      Action   = [
        {%- for ns, acts in iam_identity_center_actions %}{% for a in acts %}
        "{{ a }}",{{ endfor }}{{ endfor }}
      ]
    }]
  })
}

# --- Control Tower --------------------------------------------------------
resource "aws_controltower_landing_zone" "sbb" {
  manifest_json = var.controltower_manifest_json
  tags          = local.tags
}

resource "aws_iam_role_policy_inline" "sbb_control_tower" {
  name = "{{ group.sbbSlug }}-control-tower-inline"
  role = var.sbb_role_name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid      = "ControlTowerEnumeratedOnly"
      Effect   = "Allow"
      Resource = "*"
      Action   = [
        {%- for ns, acts in control_tower_actions %}{% for a in acts %}
        "{{ a }}",{{ endfor }}{{ endfor }}
      ]
    }]
  })
}

# --- Transit Gateway ------------------------------------------------------
resource "aws_ec2_transit_gateway" "sbb" {
  description = "SBB {{ group.sbbDomain }} / {{ group.sbbSlug }}"
  tags        = local.tags
}

resource "aws_ec2_transit_gateway_vpc_attachment" "sbb" {
  subnet_ids         = var.tgw_subnet_ids
  transit_gateway_id = aws_ec2_transit_gateway.sbb.id
  vpc_id             = var.tgw_vpc_id
  tags               = local.tags
}

# --- VPC endpoints (air-gap parity: interface endpoints, no IGW path) -----
resource "aws_vpc_endpoint" "sbb" {
  for_each            = var.vpc_endpoint_services
  vpc_id              = var.tgw_vpc_id
  service_name        = each.value
  vpc_endpoint_type   = "Interface"
  subnet_ids          = var.tgw_subnet_ids
  private_dns_enabled = true
  tags                = merge(local.tags, { air-gap-parity = var.air_gap_parity ? "mirrored" : "pending" })
}

# --- CloudTrail Lake ------------------------------------------------------
resource "aws_cloudtrail_event_data_store" "sbb" {
  name                           = "{{ group.sbbSlug }}-eds"
  organization_enabled           = false
  retention_period               = 3650
  termination_protection_enabled = true
  tags                           = local.tags
}

resource "aws_iam_role_policy_inline" "sbb_cloudtrail_lake" {
  name = "{{ group.sbbSlug }}-cloudtrail-lake-inline"
  role = var.sbb_role_name

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid      = "CloudTrailLakeEnumeratedOnly"
      Effect   = "Allow"
      Resource = "*"
      Action   = [
        {%- for ns, acts in cloudtrail_actions %}{% for a in acts %}
        "{{ a }}",{{ endfor }}{{ endfor }}
      ]
    }]
  })
}

# --- Placeholder variables (skeleton; supply at integration time) ---------
variable "sso_instance_arn"            { type = string }
variable "sso_managed_policy_arn"      { type = string }
variable "sbb_role_name"               { type = string }
variable "controltower_manifest_json"  { type = string }
variable "tgw_vpc_id"                  { type = string }
variable "tgw_subnet_ids"              { type = list(string) }
variable "vpc_endpoint_services"       { type = map(string) }
variable "air_gap_parity" {
  type    = bool
  default = false
  description = "True when this realization's traffic and audit are mirrored to the air-gapped twin (f5ea:airGapParityEgress and f5ea:airGapParityAudit both true in the rendered-resource graph)."
}
