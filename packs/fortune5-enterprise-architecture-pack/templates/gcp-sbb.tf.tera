---
to: "deploy/gcp/{{ row.sbbId }}/main.tf"
force: true
determinism: true
sparql:
  sbb_group: |
    PREFIX f5ea: <https://ggen.io/ontology/fortune5-enterprise-architecture#>
    SELECT ?sbb ?sbbId ?fleetHostProject ?serviceProject ?subnetSelfLink
           ?pscSubnet ?orgId ?keyringLocation
    WHERE {
      ?sbb a f5ea:Realization ;
           f5ea:sbbId ?sbbId ;
           f5ea:fleetHostProject ?fleetHostProject ;
           f5ea:serviceProject ?serviceProject ;
           f5ea:subnetSelfLink ?subnetSelfLink ;
           f5ea:pscSubnet ?pscSubnet ;
           f5ea:orgId ?orgId ;
           f5ea:keyringLocation ?keyringLocation ;
           f5ea:providerVariant "gcp" .
    } ORDER BY ?sbbId
  kmembers: |
    PREFIX f5ea: <https://ggen.io/ontology/fortune5-enterprise-architecture#>
    SELECT ?sbbId ?kmsOrder ?keyName ?keyPurpose WHERE {
      ?sbb a f5ea:Realization ;
           f5ea:sbbId ?sbbId ;
           f5ea:providerVariant "gcp" ;
           f5ea:hasCmekKeyMember ?k .
      ?k f5ea:kmsOrder ?kmsOrder ;
         f5ea:keyName ?keyName ;
         f5ea:keyPurpose ?keyPurpose .
    } ORDER BY ?sbbId ?kmsOrder
---
# GENERATED by `ggen sync` from
# packs/fortune5-enterprise-architecture-pack/templates/gcp-sbb.tf.tera --
# do not edit by hand. Renders once per f5ea:Realization individual
# (per-row rendering keyed on f5ea:sbbId; idiom per
# packs/azure-terraform-pack/templates/main.tf.tmpl:1-14). Every resource
# below is explicitly no-public-ingress by default: no external IP and no
# allow-0.0.0.0/0 firewall rule is emitted anywhere, and each
# network-attached resource is pinned to Shared VPC subnets reachable only
# via Private Service Connect. Gates: queries/130-gcp-sbb-select.rq,
# queries/140-cmek-and-private-connectivity.rq.
#
# AAIF domain tagging (f5ea:aaifDomain on each rendered resource):
#   host         -> GKE Enterprise fleet + Shared VPC host attachment
#   network      -> deny-all ingress, PSC endpoint/service attachment
#   guest        -> Cloud KMS CMEK keyring + keys
#   verification -> Organization Policy constraints (fail-closed guardrails)

{%- set g = row %}

# ---------------------------------------------------------------
# AAIF domain: HOST — fleet + Shared VPC host attachment
# ---------------------------------------------------------------
resource "google_gke_hub_fleet" "sbb_fleet" {
  provider   = google-beta
  project    = "{{ g.fleetHostProject }}"
  location   = "global"
  name       = "sbb-{{ g.sbbId }}-fleet"

  default_cluster_config {
    security_posture_config {
      mode               = "ENTERPRISE"
      vulnerability_mode = "VULNERABILITY_AUTOMATIC"
    }
  }
}

resource "google_gke_hub_membership" "sbb_cluster" {
  provider   = google-beta
  project    = "{{ g.fleetHostProject }}"
  name       = "sbb-{{ g.sbbId }}-membership"
  endpoint {
    gke_cluster {
      resource_link = "//container.googleapis.com/projects/{{ g.serviceProject }}/locations/{{ g.keyringLocation }}/clusters/sbb-{{ g.sbbId }}"
    }
  }
}

resource "google_compute_shared_vpc_service_project" "svc_attach" {
  provider        = google-beta
  host_project    = "{{ g.fleetHostProject }}"
  service_project = "{{ g.serviceProject }}"
}

# ---------------------------------------------------------------
# AAIF domain: NETWORK — Shared VPC subnet + Private Service Connect
# (no public ingress: no external IP, no 0.0.0.0/0 allow rule)
# ---------------------------------------------------------------
resource "google_compute_firewall" "deny_all_ingress" {
  provider      = google-beta
  project       = "{{ g.fleetHostProject }}"
  name          = "sbb-{{ g.sbbId }}-deny-ingress"
  network       = "shared-vpc-host"
  direction     = "INGRESS"
  priority      = 1000
  source_ranges = ["0.0.0.0/0"]
  deny {
    protocol = "all"
  }
}

resource "google_compute_address" "psc_endpoint_ip" {
  provider     = google-beta
  project      = "{{ g.serviceProject }}"
  name         = "sbb-{{ g.sbbId }}-psc-ip"
  subnetwork   = "{{ g.pscSubnet }}"
  address_type = "INTERNAL"
}

resource "google_compute_forwarding_rule" "psc_endpoint" {
  provider              = google-beta
  project               = "{{ g.serviceProject }}"
  name                  = "sbb-{{ g.sbbId }}-psc-endpoint"
  region                = "{{ g.keyringLocation }}"
  network               = "shared-vpc-host"
  subnetwork            = "{{ g.pscSubnet }}"
  ip_address            = google_compute_address.psc_endpoint_ip.id
  load_balancing_scheme = ""           # PSC endpoint, NOT an external LB
  target                = google_compute_service_attachment.svc_att.id
  allow_global_access   = false        # regional private path only
}

resource "google_compute_service_attachment" "svc_att" {
  provider              = google-beta
  project               = "{{ g.serviceProject }}"
  name                  = "sbb-{{ g.sbbId }}-svc-attachment"
  region                = "{{ g.keyringLocation }}"
  description           = "PSC service attachment, no public path"
  target_service        = google_compute_region_backend_service.svc.id
  nat_subnets           = ["{{ g.pscSubnet }}"]
  connection_preference = "ACCEPT_MANUAL"
}

resource "google_compute_region_backend_service" "svc" {
  provider              = google-beta
  project               = "{{ g.serviceProject }}"
  name                  = "sbb-{{ g.sbbId }}-backend"
  region                = "{{ g.keyringLocation }}"
  protocol              = "HTTPS"
  load_balancing_scheme = "INTERNAL_MANAGED"   # internal only
}

# ---------------------------------------------------------------
# AAIF domain: GUEST — Cloud KMS CMEK keyring + keys (workload-plane crypto)
# ---------------------------------------------------------------
resource "google_kms_key_ring" "keyring" {
  provider = google-beta
  project  = "{{ g.serviceProject }}"
  name     = "sbb-{{ g.sbbId }}-keyring"
  location = "{{ g.keyringLocation }}"
}

{% for k in kmembers %}{% if k.sbbId == g.sbbId %}
resource "google_kms_crypto_key" "{{ k.keyName | replace(from="-", to="_") }}" {
  provider                   = google-beta
  name                       = "{{ k.keyName }}"
  key_ring                   = google_kms_key_ring.keyring.id
  purpose                    = "{{ k.keyPurpose }}"
  rotation_period            = "7776000s"           # 90 days
  destroy_scheduled_duration = "86400s"             # 24h revoke window
}
{% endif %}{% endfor %}

# ---------------------------------------------------------------
# AAIF domain: VERIFICATION — Organization Policy constraints
# (fail-closed guardrails; the receipt/attestation surface)
# ---------------------------------------------------------------
resource "google_org_policy_policy" "no_public_ip" {
  provider = google-beta
  name     = "projects/{{ g.serviceProject }}/policies/compute.vmExternalIpAccess"
  parent   = "projects/{{ g.serviceProject }}"
  spec {
    rules {
      deny_all = "TRUE"      # no public ingress / egress VIP by default
    }
  }
}

resource "google_org_policy_policy" "restrict_domain_sharing" {
  provider = google-beta
  name     = "projects/{{ g.serviceProject }}/policies/iam.allowedPolicyMemberDomains"
  parent   = "projects/{{ g.serviceProject }}"
  spec {
    rules {
      values {
        allowed_values = ["{{ g.orgId }}"]   # org-internal identities only
      }
    }
  }
}

resource "google_org_policy_policy" "restrict_public_buckets" {
  provider = google-beta
  name     = "projects/{{ g.serviceProject }}/policies/storage.publicAccessPrevention"
  parent   = "projects/{{ g.serviceProject }}"
  spec {
    rules {
      deny_all = "TRUE"      # storage CMEK/PAP companion constraint
    }
  }
}

output "sbb_fleet_id" { value = google_gke_hub_fleet.sbb_fleet.id }
output "psc_endpoint" { value = google_compute_forwarding_rule.psc_endpoint.id }
output "keyring_self" { value = google_kms_key_ring.keyring.id }
