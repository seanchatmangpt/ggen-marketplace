---
to: "deploy/azure/{{ row.sbbSlug }}/azure_sbb.tf"
force: true
determinism: true
sparql:
  sbb: |
    PREFIX f5ea: <https://ggen.io/ontology/fortune5-enterprise-architecture#>
    SELECT ?sbb ?sbbSlug ?sbbDomain ?managementGroupId ?vwanId ?region WHERE {
      ?sbb a f5ea:Realization ;
           f5ea:sbbSlug ?sbbSlug ;
           f5ea:sbbDomain ?sbbDomain ;
           f5ea:managementGroupId ?managementGroupId ;
           f5ea:vwanId ?vwanId ;
           f5ea:region ?region ;
           f5ea:providerVariant "azure" .
    } ORDER BY ?sbbSlug
  guest_config_assignments: |
    PREFIX f5ea: <https://ggen.io/ontology/fortune5-enterprise-architecture#>
    SELECT ?sbbSlug ?initiativeName ?assignmentName WHERE {
      ?sbb a f5ea:Realization ;
           f5ea:providerVariant "azure" ;
           f5ea:hasGuestConfigurationAssignment ?a .
      ?a f5ea:initiativeName ?initiativeName ;
         f5ea:assignmentName ?assignmentName .
    } ORDER BY ?sbbSlug ?assignmentName
---
# GENERATED by `ggen sync` from
# packs/fortune5-enterprise-architecture-pack/templates/azure-sbb.tf.tera --
# do not edit by hand. Per-SBB Azure enclave skeleton (Management Group
# hierarchy, Virtual WAN hub/spoke, Guest Configuration, Dedicated HSM,
# Confidential Computing), parameterized over the SBB domain. Idioms reused
# from packs/fortune5-deployment-blocks-pack/templates/deployment_catalog.md.tmpl
# (frontmatter sparql block) and packs/azure-terraform-pack/templates/main.tf.tmpl
# (per-row rendering, GENERATED header). Gates: queries/150-azure-nist-800-53-rev5.rq,
# queries/160-azure-sbb-select.rq.

terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.100"
    }
  }
}

provider "azurerm" { features {} }

# --- Management Group hierarchy (cf. azure-management-groups-pack,
#     fortune5-bblocks.json:149) ---
resource "azurerm_management_group" "root" {
  display_name = "{{ sbb.sbbDomain }}-enclave-root"
}

resource "azurerm_management_group" "landing_zone" {
  display_name               = "{{ sbb.sbbDomain }}-landing-zone"
  parent_management_group_id = azurerm_management_group.root.id
}

resource "azurerm_management_group" "enclave" {
  display_name               = "{{ sbb.sbbDomain }}-enclave"
  parent_management_group_id = azurerm_management_group.landing_zone.id
}

# --- Virtual WAN hub/spoke (cf. azure-vnet-pack, fortune5-bblocks.json:19) ---
resource "azurerm_resource_group" "connectivity" {
  name     = "rg-{{ sbb.sbbSlug }}-connectivity"
  location = "{{ sbb.region }}"
}

resource "azurerm_virtual_wan" "this" {
  name                = "vwan-{{ sbb.sbbSlug }}"
  resource_group_name = azurerm_resource_group.connectivity.name
  location            = "{{ sbb.region }}"
}

resource "azurerm_virtual_hub" "hub" {
  name                = "vhub-{{ sbb.sbbSlug }}-{{ sbb.region }}"
  resource_group_name = azurerm_resource_group.connectivity.name
  location            = "{{ sbb.region }}"
  virtual_wan_id      = azurerm_virtual_wan.this.id
  address_prefix      = var.hub_address_prefix
}

resource "azurerm_virtual_hub_connection" "spoke" {
  for_each                  = toset(var.spoke_vnet_ids)
  name                      = "sconn-${each.value}"
  virtual_hub_id            = azurerm_virtual_hub.hub.id
  remote_virtual_network_id = each.value
}

# --- Azure Policy Guest Configuration assignments ---
resource "azurerm_resource_group_policy_assignment" "guest_config" {
  for_each             = { for a in guest_config_assignments : a.assignmentName => a }
  name                 = each.value.assignmentName
  resource_group_id    = azurerm_resource_group.connectivity.id
  policy_definition_id = each.value.initiativeName
}

# --- Dedicated HSM (cf. azure-managed-hsm-pack, fortune5-bblocks.json:45) ---
resource "azurerm_resource_group" "hsm" {
  name     = "rg-{{ sbb.sbbSlug }}-hsm"
  location = "{{ sbb.region }}"
}

resource "azurerm_dedicated_hardware_security_module" "this" {
  name                = "hsm-{{ sbb.sbbSlug }}"
  resource_group_name = azurerm_resource_group.hsm.name
  location            = "{{ sbb.region }}"
  sku_name            = var.hsm_sku
  subnet_id           = var.hsm_subnet_id
  management_network_profile {
    network_interface_private_ip_addresses = []
  }
  network_profile {
    network_interface_private_ip_addresses = []
    subnet_id                              = var.hsm_subnet_id
  }
}

# --- Confidential Computing (DCcv5): enforce confidential VM sizes via
#     policy; deny non-DCcv5 SKUs (SC-28, CM-6 control mappings). ---
resource "azurerm_resource_group" "confcomp" {
  name     = "rg-{{ sbb.sbbSlug }}-confcomp"
  location = "{{ sbb.region }}"
}

resource "azurerm_subscription_policy_assignment" "confidential_vm" {
  name                 = "confidential-vm-dccv5-only"
  subscription_id      = var.subscription_id
  policy_definition_id = var.confidential_vm_policy_definition_id
  parameters = jsonencode({
    allowedVmSizes = {
      value = ["Standard_DC2ccs_v5", "Standard_DC4ccs_v5", "Standard_DC8ccs_v5", "Standard_DC16ccs_v5", "Standard_DC32ccs_v5", "Standard_DC48ccs_v5"]
    }
  })
}

variable "hub_address_prefix"                     { type = string }
variable "spoke_vnet_ids"                         { type = list(string), default = [] }
variable "hsm_sku"                                { type = string, default = "Standard_DirHsmSmall" }
variable "hsm_subnet_id"                          { type = string }
variable "subscription_id"                        { type = string }
variable "confidential_vm_policy_definition_id"   { type = string }
