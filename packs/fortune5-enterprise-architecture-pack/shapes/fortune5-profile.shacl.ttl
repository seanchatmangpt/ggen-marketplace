@prefix ea: <urn:autofde:fortune5:ea:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ea:LabeledPrincipleShape a sh:NodeShape ;
  sh:targetClass ea:ArchitecturePrinciple ;
  sh:property [ sh:path ea:conformsToProfile ; sh:hasValue ea:Fortune5EnterpriseProfile ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ] .

ea:LabeledViewpointShape a sh:NodeShape ;
  sh:targetClass ea:ArchitectureViewpoint ;
  sh:property [ sh:path ea:conformsToProfile ; sh:hasValue ea:Fortune5EnterpriseProfile ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ] .

ea:LabeledGovernanceGateShape a sh:NodeShape ;
  sh:targetClass ea:GovernanceGate ;
  sh:property [ sh:path ea:conformsToProfile ; sh:hasValue ea:Fortune5EnterpriseProfile ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ] .

ea:LabeledPlannerRoleShape a sh:NodeShape ;
  sh:targetClass ea:PlannerRole ;
  sh:property [ sh:path ea:conformsToProfile ; sh:hasValue ea:Fortune5EnterpriseProfile ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ] .
