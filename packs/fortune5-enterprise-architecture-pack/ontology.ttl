@prefix ea: <urn:autofde:fortune5:ea:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dct: <http://purl.org/dc/terms/> .

ea:Fortune5EnterpriseProfile a skos:Concept ;
  skos:prefLabel "Fortune 5 enterprise architecture planning profile" ;
  dct:description "Semantic contract for business-traceable, role-conditioned, receipt-bounded enterprise architecture planning." .

ea:ArchitecturePrinciple a rdfs:Class .
ea:ArchitectureViewpoint a rdfs:Class .
ea:GovernanceGate a rdfs:Class .
ea:PlannerRole a rdfs:Class .
ea:EnterpriseScenario a rdfs:Class .
ea:DecisionRight a rdfs:Class .
ea:ArchitectureDecision a rdfs:Class .
ea:ServiceTier a rdfs:Class .
ea:ControlDomain a rdfs:Class .
ea:RecoveryContract a rdfs:Class .
ea:ExitStrategy a rdfs:Class .
ea:Counterexample a rdfs:Class .
ea:Receipt a rdfs:Class ; rdfs:subClassOf prov:Entity .
ea:ArchitectureFitness a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .

ea:conformsToProfile a rdf:Property .
ea:requiresViewpoint a rdf:Property .
ea:requiresGate a rdf:Property .
ea:hasRole a rdf:Property .
ea:hasScenario a rdf:Property .
ea:preservationLaw a rdf:Property .
ea:claimCeiling a rdf:Property .
ea:decisionAccountableTo a rdf:Property .
ea:handoffTo a rdf:Property .

ea:P01 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Business outcome traceability" ; dct:description "Every architecture decision traces to an admitted business capability, objective, risk, or regulatory obligation." .
ea:P02 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Zero ambient authority" ; dct:description "Planning and generation have no consequence authority; DO requires explicit principal, capability and resource admission." .
ea:P03 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Re-observe after consequence" ; dct:description "Every consequential transition invalidates stale future assumptions." .
ea:P04 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Preserve reversible options" .
ea:P05 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Data governed by contract" .
ea:P06 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Identity is the primary control plane" .
ea:P07 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Failure is designed, not discovered" .
ea:P08 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Observability is architecture" .
ea:P09 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Exit before entry" .
ea:P10 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Cost is a constrained state variable" .
ea:P11 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Standards become machine constraints" .
ea:P12 a ea:ArchitecturePrinciple ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Compile away solved cognition" .

ea:V01 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Business capability" .
ea:V02 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Information/data" .
ea:V03 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Application/service" .
ea:V04 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Platform/infrastructure" .
ea:V05 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Security/identity" .
ea:V06 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Resilience" .
ea:V07 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Operations/SRE" .
ea:V08 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Financial/FinOps" .
ea:V09 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Governance/compliance" .
ea:V10 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Organization/operating model" .
ea:V11 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Portfolio/roadmap" .
ea:V12 a ea:ArchitectureViewpoint ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Vendor/exit" .

ea:G0 a ea:GovernanceGate ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Observation admission" .
ea:G1 a ea:GovernanceGate ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Business architecture" .
ea:G2 a ea:GovernanceGate ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Architecture fitness" .
ea:G3 a ea:GovernanceGate ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Risk/control admission" .
ea:G4 a ea:GovernanceGate ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Resilience/operations" .
ea:G5 a ea:GovernanceGate ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Economic/portfolio" .
ea:G6 a ea:GovernanceGate ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Pre-DO handoff" .
ea:G7 a ea:GovernanceGate ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Post-DO standing" .
ea:G8 a ea:GovernanceGate ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Industrialize cognition" .

ea:Accomplish a ea:PlannerRole ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Accomplish" .
ea:Falsify a ea:PlannerRole ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Falsify" .
ea:Diagnose a ea:PlannerRole ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Diagnose" .
ea:Recover a ea:PlannerRole ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Recover" .
ea:Architect a ea:PlannerRole ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Architect" .
ea:WorldGenerator a ea:PlannerRole ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "World generator" .
ea:RewardFalsifier a ea:PlannerRole ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Reward falsifier" .
ea:AssumptionFalsifier a ea:PlannerRole ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Assumption falsifier" .
ea:MetaSelector a ea:PlannerRole ; ea:conformsToProfile ea:Fortune5EnterpriseProfile ; skos:prefLabel "Meta selector" .

ea:EnterpriseArchitectureCrown a skos:Concept ;
 ea:conformsToProfile ea:Fortune5EnterpriseProfile ;
 ea:requiresViewpoint ea:V01, ea:V02, ea:V03, ea:V04, ea:V05, ea:V06, ea:V07, ea:V08, ea:V09, ea:V10, ea:V11, ea:V12 ;
 ea:requiresGate ea:G0, ea:G1, ea:G2, ea:G3, ea:G4, ea:G5, ea:G6, ea:G7, ea:G8 ;
 ea:hasRole ea:Accomplish, ea:Falsify, ea:Diagnose, ea:Recover, ea:Architect, ea:WorldGenerator, ea:RewardFalsifier, ea:AssumptionFalsifier, ea:MetaSelector ;
 ea:claimCeiling "CANDIDATE_ENTERPRISE_ARCHITECTURE_PLANNING_NO_PRODUCTION_AUTHORITY" .
