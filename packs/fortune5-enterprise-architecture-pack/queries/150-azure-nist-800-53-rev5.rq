# ASK gate, fail-closed (true = PASS): every Azure SBB realization's
# rendered resources carry the required NIST SP 800-53 Rev 5 control
# mappings (AC-2 account management, SC-28 protection of information at
# rest, CM-6 configuration management policy).
# Idiom: fortune5-deployment-blocks-pack gates/010_catalog_contract.rq
# (FILTER NOT EXISTS completeness).
PREFIX f5ea: <https://ggen.io/ontology/fortune5-enterprise-architecture#>
ASK {
  FILTER NOT EXISTS {
    ?realization a f5ea:Realization ;
                 f5ea:providerVariant "azure" ;
                 f5ea:hasResource ?resource .
    FILTER NOT EXISTS {
      ?resource f5ea:controlMapping ?c .
      FILTER(?c IN ("AC-2", "SC-28", "CM-6"))
    }
  }
}
