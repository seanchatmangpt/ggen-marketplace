# Stage 2 gate: contract APPROVED (attributed), no SBB yet.
# Zero rows = pass. Fixture precedent: stage2-contract-approved-no-sbb.ttl:60-67.
PREFIX ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#>
PREFIX ea: <https://chatman.ai/ontology/enterprise-architecture#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?abb ?reason WHERE {
  ?abb a ea:ArchitectureBuildingBlock ;
       ea:realizesCapability ?cap ;
       ea:governedByContract ?k .
  {
    ?k ic:approvalStatus ic:APPROVED .
    FILTER NOT EXISTS { ?k ic:approvedBy ?who . ?who a prov:Agent . ?k ic:approvalReceipt ?rc . }
    BIND("REFUSED:F5_STAGE2_APPROVAL_UNATTRIBUTED" AS ?reason)
  }
  UNION
  {
    FILTER EXISTS { ?s ?p ic:DO }
    BIND("REFUSED:F5_STAGE2_AUTHORITY_DO_FORBIDDEN" AS ?reason)
  }
  UNION
  {
    FILTER EXISTS { ?sbb ea:satisfiesABB ?abb }
    FILTER NOT EXISTS {
      ?res a ic:Residual ; ic:deficitClass ic:DEFICIT_SBB ; ic:status "OPEN" ;
           ic:residualOf ?req2 .
      ?req2 ic:requiresCapability ?cap .
    }
    BIND("REFUSED:F5_STAGE2_SBB_PREMATURE" AS ?reason)
  }
}
# prov: prefix needed for ?who a prov:Agent
