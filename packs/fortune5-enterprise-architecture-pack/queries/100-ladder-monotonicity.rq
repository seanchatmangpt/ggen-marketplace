# Whole-ladder monotonicity gate: no skipped stages, no regression.
# Reuses the R_CORE nested-IF deficit classifier idiom from
# industry-closure-ledger-pack queries/10-residual.rq:34-40
# (AUTHORITY -> ONTOLOGY -> ABB -> CONTRACT -> SBB -> QUALIFICATION ->
#  EVIDENCE -> COVERED), ordered so the FIRST matching deficit class is
# the computed stage. The recorded residual must not sit ABOVE the
# computed class. Zero rows = pass.
PREFIX ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#>
PREFIX ea: <https://chatman.ai/ontology/enterprise-architecture#>
SELECT ?req ?reason WHERE {
  ?req a ic:Requirement ;
       ic:disposition ic:IN_SCOPE ;
       ic:requiresCapability ?cap .

  # computed deficit class for this requirement (first-match wins, monotone order)
  OPTIONAL {
    ?abb a ea:ArchitectureBuildingBlock ; ea:realizesCapability ?cap .
    OPTIONAL {
      ?abb ea:governedByContract ?k .
      ?k ic:approvalStatus ic:APPROVED .
      OPTIONAL {
        ?sbb a ea:SolutionBuildingBlock ; ea:satisfiesABB ?abb .
        OPTIONAL {
          ?sbb ea:hasStanding ea:QUALIFIED ; ea:exactSubject ?d .
          OPTIONAL {
            ?ev a ic:ExecutionEvidence ; ic:evidenceFor ?sbb ;
                ic:outcome ic:VERIFIED ; ic:evidenceSubject ?d .
          }
        }
      }
    }
  }

  # recorded deficit class (lowest-index OPEN residual for this requirement)
  OPTIONAL {
    ?res a ic:Residual ; ic:residualOf ?req ; ic:deficitClass ?recorded ; ic:status "OPEN" .
  }

  BIND(COALESCE(?recorded, ic:DEFICIT_ABB) AS ?claimed)
  # regression: a recorded class more advanced than the computed chain supports.
  # Stage ordering by string comparison of the deficit class IRI local names
  # is NOT relied on; instead: claiming SBB/QUALIFICATION/EVIDENCE progress
  # without the supporting chain element is refused.
  BIND("REFUSED:F5_LADDER_REGRESSION" AS ?reason)
  FILTER(
    ( !BOUND(?abb) && ?claimed != ic:DEFICIT_ABB )
    || ( BOUND(?abb) && !BOUND(?k) && ?claimed IN (ic:DEFICIT_SBB, ic:DEFICIT_QUALIFICATION, ic:DEFICIT_EVIDENCE) )
    || ( BOUND(?k) && !BOUND(?sbb) && ?claimed IN (ic:DEFICIT_QUALIFICATION, ic:DEFICIT_EVIDENCE) )
    || ( BOUND(?sbb) && !(BOUND(?d)) && ?claimed = ic:DEFICIT_EVIDENCE )
  )
} ORDER BY ?req ?reason
