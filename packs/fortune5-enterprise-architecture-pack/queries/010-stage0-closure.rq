# Stage 0 gate (falsifier shape, house idiom: zero rows = pass).
# MESSAGE: a Stage0 closure may lack an ABB only while the deficit is
# recorded as an OPEN residual — any row returned is a violation.
# Fixture precedent: industry-closure-ledger-pack/fixtures/closure-growth/stage0-no-abb.ttl
PREFIX ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#>
PREFIX ea: <https://chatman.ai/ontology/enterprise-architecture#>
SELECT ?req ?reason WHERE {
  ?req a ic:Requirement ;
       ic:disposition ic:IN_SCOPE ;
       ic:requiresCapability ?cap .
  FILTER NOT EXISTS { ?abb a ea:ArchitectureBuildingBlock ; ea:realizesCapability ?cap }
  FILTER NOT EXISTS {
    ?res a ic:Residual ;
         ic:residualOf ?req ;
         ic:deficitClass ic:DEFICIT_ABB ;
         ic:status "OPEN" ;
         ic:authorityClaim "NONE" ;
         ic:feedbackTarget ic:UPSTREAM_ARCHITECTURE .
  }
  BIND("REFUSED:F5_STAGE0_ABB_DEFICIT_UNRECORDED" AS ?reason)
} ORDER BY ?req ?reason
