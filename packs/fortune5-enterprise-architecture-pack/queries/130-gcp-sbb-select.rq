# SELECT gate (clean rows only): qualified GCP SBB groups keyed by
# exactSubject sha256 literal. Malformed/unqualified SBBs are excluded here;
# the ASK gate (queries/140-cmek-and-private-connectivity.rq) refuses them.
# Idioms: enterprise-architecture-pack/ontology.ttl:30-34;
# governed-runtime-adapter-pack gates/01-exact-subject.rq:2.
PREFIX f5ea: <https://ggen.io/ontology/fortune5-enterprise-architecture#>
PREFIX ea:   <https://chatman.ai/ontology/enterprise-architecture#>
SELECT ?realization ?sbbId ?exactSubject WHERE {
  ?realization a f5ea:Realization ;
               f5ea:sbbId ?sbbId ;
               f5ea:exactSubject ?exactSubject ;
               f5ea:providerVariant "gcp" ;
               f5ea:hasStanding ea:QUALIFIED .
  FILTER(STRSTARTS(STR(?exactSubject), "sha256:"))
  FILTER(STRLEN(STR(?exactSubject)) = 71)   # "sha256:" (7) + 64 hex chars
} ORDER BY ?sbbId ?exactSubject
