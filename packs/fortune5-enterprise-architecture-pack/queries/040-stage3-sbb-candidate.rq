# Stage 3 gate: SBB at CANDIDATE standing, contract APPROVED.
# Zero rows = pass. Fixture precedent: stage3-sbb-candidate.ttl:69-71.
PREFIX ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#>
PREFIX ea: <https://chatman.ai/ontology/enterprise-architecture#>
SELECT ?sbb ?reason WHERE {
  ?sbb a ea:SolutionBuildingBlock ;
       ea:satisfiesABB ?abb ;
       ea:hasStanding ?standing .
  {
    ?abb ea:governedByContract ?k .
    FILTER NOT EXISTS {
      ?k ic:approvalStatus ic:APPROVED ;
         ic:approvedBy ?w ;
         ic:approvalReceipt ?rc .
    }
    BIND("REFUSED:F5_STAGE3_CONTRACT_NOT_APPROVED" AS ?reason)
  }
  UNION
  {
    FILTER(?standing != ea:CANDIDATE && ?standing != ea:QUALIFIED)
    BIND("REFUSED:F5_STAGE3_SBB_NOT_CANDIDATE" AS ?reason)
  }
  UNION
  {
    FILTER(?standing = ea:CANDIDATE)
    FILTER NOT EXISTS {
      ?res a ic:Residual ; ic:deficitClass ic:DEFICIT_QUALIFICATION ; ic:status "OPEN" ;
           ic:feedbackTarget ic:UPSTREAM_QUALIFICATION ;
           ic:residualOf ?req .
      ?req ic:requiresCapability ?cap .
      ?abb ea:realizesCapability ?cap .
    }
    BIND("REFUSED:F5_STAGE3_CANDIDATE_UNRECORDED" AS ?reason)
  }
} ORDER BY ?sbb ?reason
