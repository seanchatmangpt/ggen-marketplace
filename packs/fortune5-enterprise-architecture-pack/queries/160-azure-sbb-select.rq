# SELECT gate (falsifier shape): under-bound Azure realizations.
# Zero rows = pass. exactSubject idiom: governed-runtime-adapter-pack
# gates/01-exact-subject.rq:2.
PREFIX f5ea: <https://ggen.io/ontology/fortune5-enterprise-architecture#>
SELECT ?realization ?exactSubject WHERE {
  ?realization a f5ea:Realization ;
               f5ea:providerVariant "azure" ;
               f5ea:sbbSlug ?slug ;
               f5ea:sbbDomain ?domain ;
               f5ea:exactSubject ?exactSubject .
  FILTER(STRLEN(STR(?exactSubject)) > 0)
} ORDER BY ?slug
