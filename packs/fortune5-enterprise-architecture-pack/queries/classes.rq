PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?term ?type ?comment WHERE {
  ?term a ?type .
  FILTER(?type IN (owl:Class, owl:ObjectProperty))
  FILTER(STRSTARTS(STR(?term), "https://ggen.io/ontology/fortune5-enterprise-architecture#"))
  OPTIONAL { ?term rdfs:comment ?comment }
} ORDER BY ?type ?term
