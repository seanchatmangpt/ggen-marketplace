---
to: "generated/network/network_law_census.md"
force: true
sparql:
  programs: |
    PREFIX ianp: <https://ggen.dev/packs/ip-allowlist-network-policy#>
    SELECT ?programId ?catalogGroup ?catalogVersion ?catalogPackId ?directActuation
    WHERE {
      ?p a ianp:NetworkProgram ;
         ianp:programId ?programId ;
         ianp:catalogGroup ?catalogGroup ;
         ianp:catalogVersion ?catalogVersion ;
         ianp:catalogPackId ?catalogPackId ;
         ianp:directActuation ?directActuation .
    }
    ORDER BY ?programId
  policies: |
    PREFIX ianp: <https://ggen.dev/packs/ip-allowlist-network-policy#>
    SELECT ?policyName ?namespace ?postureToken
    WHERE {
      ?np a ianp:NetworkPolicySpec ;
          ianp:policyName ?policyName ;
          ianp:namespace ?namespace ;
          ianp:posture ?posture .
      ?posture ianp:postureToken ?postureToken .
    }
    ORDER BY ?namespace ?policyName
---
