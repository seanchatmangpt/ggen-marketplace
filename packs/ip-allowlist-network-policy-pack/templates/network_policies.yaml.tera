---
to: "generated/network/network_policies.yaml"
force: true
sparql:
  policies: |
    PREFIX ianp: <https://ggen.dev/packs/ip-allowlist-network-policy#>
    SELECT ?policyName ?namespace ?postureToken ?ingress ?egress ?egressEmpty
           ?labelKey ?labelValue ?allowPort ?allowProtocol ?allowlistId
    WHERE {
      ?np a ianp:NetworkPolicySpec ;
          ianp:policyName ?policyName ;
          ianp:namespace ?namespace ;
          ianp:posture ?posture ;
          ianp:policyTypesIngress ?ingress ;
          ianp:policyTypesEgress ?egress ;
          ianp:egressEmpty ?egressEmpty .
      ?posture ianp:postureToken ?postureToken .
      OPTIONAL { ?np ianp:podSelectorMatchLabelKey ?labelKey }
      OPTIONAL { ?np ianp:podSelectorMatchLabelValue ?labelValue }
      OPTIONAL { ?np ianp:allowPort ?allowPort }
      OPTIONAL { ?np ianp:allowProtocol ?allowProtocol }
      OPTIONAL {
        ?np ianp:bindsAllowlist ?al .
        ?al ianp:allowlistId ?allowlistId
      }
    }
    ORDER BY ?namespace ?policyName
  cidrs: |
    PREFIX ianp: <https://ggen.dev/packs/ip-allowlist-network-policy#>
    SELECT ?allowlistId ?cidr ?entryId ?purposeToken
    WHERE {
      ?al a ianp:IpAllowlist ; ianp:allowlistId ?allowlistId ; ianp:hasEntry ?e .
      ?e ianp:cidr ?cidr ; ianp:entryId ?entryId ; ianp:hasPurpose ?purp .
      ?purp ianp:purposeToken ?purposeToken .
    }
    ORDER BY ?allowlistId ?entryId
---
# GENERATED by ggen (ip-allowlist-network-policy-pack/templates/network_policies.yaml.tera). Do not edit.
# Source of truth: admitted ianp:NetworkPolicySpec facts. Regenerate: ggen sync run.
# Broker-only projection — CNI enforcement and cloud firewalls are out of band.
{% for p in policies %}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ p.policyName }}
  namespace: {{ p.namespace }}
  labels:
    ggen.dev/pack: ip-allowlist-network-policy-pack
    ggen.dev/posture: {{ p.postureToken }}
spec:
  podSelector:
{%- if p.labelKey and p.labelKey | length > 0 %}
    matchLabels:
      {{ p.labelKey }}: {{ p.labelValue | default(value="") }}
{%- else %}
    {}
{%- endif %}
  policyTypes:
{%- if p.ingress == true or p.ingress == "true" %}
    - Ingress
{%- endif %}
{%- if p.egress == true or p.egress == "true" %}
    - Egress
{%- endif %}
{%- if p.egressEmpty == true or p.egressEmpty == "true" %}
  egress: []
{%- endif %}
{%- if p.allowlistId and p.allowlistId | length > 0 %}
  ingress:
{%- for c in cidrs %}
{%- if c.allowlistId == p.allowlistId %}
    - from:
        - ipBlock:
            cidr: {{ c.cidr }}
{%- if p.allowPort %}
      ports:
        - protocol: {{ p.allowProtocol | default(value="TCP") }}
          port: {{ p.allowPort }}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- endif %}
{% endfor %}
