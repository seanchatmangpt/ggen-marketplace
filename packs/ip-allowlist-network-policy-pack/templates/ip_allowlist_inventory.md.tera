---
to: "generated/network/ip_allowlist_inventory.md"
force: true
sparql:
  allowlists: |
    PREFIX ianp: <https://ggen.dev/packs/ip-allowlist-network-policy#>
    SELECT ?allowlistId ?title
    WHERE {
      ?al a ianp:IpAllowlist ; ianp:allowlistId ?allowlistId .
      OPTIONAL { ?al ianp:allowlistTitle ?title }
    }
    ORDER BY ?allowlistId
  entries: |
    PREFIX ianp: <https://ggen.dev/packs/ip-allowlist-network-policy#>
    SELECT ?allowlistId ?entryId ?cidr ?label ?purposeToken
    WHERE {
      ?al a ianp:IpAllowlist ; ianp:allowlistId ?allowlistId ; ianp:hasEntry ?e .
      ?e ianp:entryId ?entryId ; ianp:cidr ?cidr ; ianp:hasPurpose ?purp .
      ?purp ianp:purposeToken ?purposeToken .
      OPTIONAL { ?e ianp:entryLabel ?label }
    }
    ORDER BY ?allowlistId ?entryId
  blocked: |
    PREFIX ianp: <https://ggen.dev/packs/ip-allowlist-network-policy#>
    SELECT ?blockedId ?resourceType ?reason
    WHERE {
      ?b a ianp:BlockedSurface ;
         ianp:blockedId ?blockedId ;
         ianp:blockedResourceType ?resourceType ;
         ianp:blockedReason ?reason .
    }
    ORDER BY ?blockedId
---
