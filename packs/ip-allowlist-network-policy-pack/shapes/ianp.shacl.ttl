@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ianp:  <https://ggen.dev/packs/ip-allowlist-network-policy#> .

# SHACL shapes for ip-allowlist-network-policy-pack (ontology.ttl).

ianp:NetworkProgramShape a sh:NodeShape ;
    sh:targetClass ianp:NetworkProgram ;
    sh:property [
        sh:path ianp:programId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "ianp:NetworkProgram requires exactly one ianp:programId." ;
    ] ;
    sh:property [
        sh:path ianp:catalogGroup ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^global-network$" ;
        sh:message "ianp:catalogGroup must be global-network." ;
    ] ;
    sh:property [
        sh:path ianp:catalogVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:catalogPackId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^fortune5-network-law-pack$" ;
        sh:message "ianp:catalogPackId must be fortune5-network-law-pack." ;
    ] ;
    sh:property [
        sh:path ianp:hasAllowlist ;
        sh:class ianp:IpAllowlist ;
        sh:minCount 1 ;
        sh:message "ianp:NetworkProgram requires at least one ianp:hasAllowlist." ;
    ] ;
    sh:property [
        sh:path ianp:hasNetworkPolicy ;
        sh:class ianp:NetworkPolicySpec ;
        sh:minCount 1 ;
        sh:message "ianp:NetworkProgram requires at least one ianp:hasNetworkPolicy." ;
    ] ;
    sh:property [
        sh:path ianp:directActuation ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue false ;
        sh:message "ianp:directActuation must be false (broker-only)." ;
    ] .

ianp:IpAllowlistShape a sh:NodeShape ;
    sh:targetClass ianp:IpAllowlist ;
    sh:property [
        sh:path ianp:allowlistId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:hasEntry ;
        sh:class ianp:CidrEntry ;
        sh:minCount 1 ;
        sh:message "ianp:IpAllowlist requires at least one ianp:CidrEntry." ;
    ] ;
    sh:property [
        sh:path ianp:directActuation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:hasValue false ;
    ] .

ianp:CidrEntryShape a sh:NodeShape ;
    sh:targetClass ianp:CidrEntry ;
    sh:property [
        sh:path ianp:entryId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:cidr ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])/([0-9]|[1-2][0-9]|3[0-2])|(([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}/([0-9]|[1-9][0-9]|1[0-2][0-8])))$" ;
        sh:message "ianp:cidr must be an IPv4 or IPv6 CIDR literal." ;
    ] ;
    sh:property [
        sh:path ianp:hasPurpose ;
        sh:class ianp:CidrPurpose ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .

ianp:NetworkPolicySpecShape a sh:NodeShape ;
    sh:targetClass ianp:NetworkPolicySpec ;
    sh:property [
        sh:path ianp:policyName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" ;
        sh:message "ianp:policyName must be a DNS-1123 label." ;
    ] ;
    sh:property [
        sh:path ianp:namespace ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:posture ;
        sh:class ianp:EgressPosture ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:policyTypesIngress ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:policyTypesEgress ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:egressEmpty ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:directActuation ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:hasValue false ;
    ] ;
    sh:property [
        sh:path ianp:allowPort ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ; sh:maxInclusive 65535 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:allowProtocol ;
        sh:datatype xsd:string ;
        sh:in ( "TCP" "UDP" "SCTP" ) ;
        sh:maxCount 1 ;
    ] .

ianp:BlockedSurfaceShape a sh:NodeShape ;
    sh:targetClass ianp:BlockedSurface ;
    sh:property [
        sh:path ianp:blockedId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:blockedResourceType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ianp:blockedReason ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
    ] .
