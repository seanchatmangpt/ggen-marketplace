# MESSAGE: CidrEntry missing purpose, empty allowlist, or CIDR literal fails IPv4/IPv6 CIDR shape
PREFIX ianp: <https://ggen.dev/packs/ip-allowlist-network-policy#>
SELECT ?subject ?violation WHERE {
  {
    ?subject a ianp:CidrEntry .
    FILTER NOT EXISTS { ?subject ianp:hasPurpose ?p }
    BIND("CIDR_PURPOSE_MISSING" AS ?violation)
  }
  UNION
  {
    ?subject a ianp:CidrEntry .
    OPTIONAL { ?subject ianp:cidr ?cidr }
    FILTER(!BOUND(?cidr) || !REGEX(STR(?cidr), "^((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])/([0-9]|[1-2][0-9]|3[0-2])|(([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}/([0-9]|[1-9][0-9]|1[0-2][0-8])))$"))
    BIND("CIDR_LITERAL_INVALID" AS ?violation)
  }
  UNION
  {
    ?subject a ianp:IpAllowlist .
    FILTER NOT EXISTS { ?subject ianp:hasEntry ?e }
    BIND("ALLOWLIST_EMPTY" AS ?violation)
  }
  UNION
  {
    ?subject a ianp:CidrEntry ; ianp:hasPurpose ?purpose .
    FILTER NOT EXISTS {
      VALUES ?ok {
        ianp:purposeAdmin ianp:purposeVpn ianp:purposeCorp ianp:purposePeer
      }
      FILTER(?purpose = ?ok)
    }
    BIND("CIDR_PURPOSE_NOT_CLOSED" AS ?violation)
  }
}
ORDER BY ?subject ?violation
