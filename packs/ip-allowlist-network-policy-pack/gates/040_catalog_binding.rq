# MESSAGE: NetworkProgram catalog binding drifts from fortune5 global-network / fortune5-network-law-pack
PREFIX ianp: <https://ggen.dev/packs/ip-allowlist-network-policy#>
SELECT ?program ?field ?value WHERE {
  ?program a ianp:NetworkProgram .
  {
    ?program ianp:catalogGroup ?value .
    FILTER(STR(?value) != "global-network")
    BIND("ianp:catalogGroup" AS ?field)
  }
  UNION
  {
    ?program ianp:catalogPackId ?value .
    FILTER(STR(?value) != "fortune5-network-law-pack")
    BIND("ianp:catalogPackId" AS ?field)
  }
}
ORDER BY ?program ?field
