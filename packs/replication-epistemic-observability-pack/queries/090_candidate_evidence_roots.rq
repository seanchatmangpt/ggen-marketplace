PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT ?candidate (COUNT(DISTINCT ?root) AS ?evidenceRoots) WHERE {
  ?candidate a reo:ReplicationCandidate .
  OPTIONAL { ?evidence reo:forCandidate ?candidate ; reo:evidenceRoot ?root . }
}
GROUP BY ?candidate
ORDER BY ?evidenceRoots ?candidate
