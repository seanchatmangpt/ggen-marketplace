PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT ?candidate ?target (COUNT(DISTINCT ?root) AS ?roots) WHERE { ?candidate a reo:ReplicationCandidate ; reo:targets ?target ; reo:evidenceRoot ?root . } GROUP BY ?candidate ?target HAVING(COUNT(DISTINCT ?root)>1) ORDER BY DESC(?roots) ?candidate ?target
