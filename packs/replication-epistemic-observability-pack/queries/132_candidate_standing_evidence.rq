PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT ?candidate (COUNT(DISTINCT ?receipt) AS ?receipts) (COUNT(DISTINCT ?court) AS ?courts) WHERE { ?candidate a reo:ReplicationCandidate . OPTIONAL { ?receipt a reo:ReplicationReceipt ; reo:forCandidate ?candidate . } OPTIONAL { ?court a reo:QualificationCourt ; reo:qualifies ?candidate . } } GROUP BY ?candidate ORDER BY ?candidate
