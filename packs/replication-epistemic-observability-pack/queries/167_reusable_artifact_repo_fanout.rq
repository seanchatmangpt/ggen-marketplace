PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT ?artifact (COUNT(DISTINCT ?repo) AS ?repos) WHERE { ?artifact a reo:ReusableArtifact . ?candidate a reo:ReplicationCandidate ; reo:consumes ?artifact ; reo:targets ?target . ?target reo:observedInRepo ?repo . } GROUP BY ?artifact ORDER BY DESC(?repos) ?artifact
