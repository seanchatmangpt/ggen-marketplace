PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT (COUNT(DISTINCT ?candidate) AS ?candidates) (COUNT(DISTINCT ?repo) AS ?repos) (COUNT(DISTINCT ?opportunity) AS ?opportunities) WHERE { ?candidate a reo:ReplicationCandidate . OPTIONAL { ?candidate reo:observedInRepo ?repo . } OPTIONAL { ?opportunity a reo:Opportunity ; reo:derivedFromSeed ?candidate . } }
