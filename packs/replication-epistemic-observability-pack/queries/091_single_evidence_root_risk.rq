PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT ?candidate (COUNT(DISTINCT ?root) AS ?roots) WHERE {
  ?candidate a reo:ReplicationCandidate .
  ?evidence reo:forCandidate ?candidate ; reo:evidenceRoot ?root .
}
GROUP BY ?candidate
HAVING(COUNT(DISTINCT ?root) < 2)
ORDER BY ?candidate
