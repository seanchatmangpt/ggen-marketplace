PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT ?run ?observation ?reuse ?opportunity ((1000 - (?observation * ?reuse * ?opportunity)) AS ?shortfall) WHERE { ?run a reo:MeasurementRun ; reo:asserts ?observation . ?hypothesis a reo:Hypothesis ; reo:derivedFromSeed ?run ; reo:asserts ?reuse . ?opportunityNode a reo:Opportunity ; reo:derivedFromSeed ?hypothesis ; reo:asserts ?opportunity . FILTER((?observation * ?reuse * ?opportunity) < 1000) } ORDER BY DESC(?shortfall) ?run
