PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT ?run (?coverage * ?reuse * ?opportunities AS ?multiplier) WHERE { ?run a reo:MeasurementRun ; reo:coverageMultiplier ?coverage ; reo:reuseMultiplier ?reuse ; reo:opportunityMultiplier ?opportunities . FILTER(?coverage * ?reuse * ?opportunities >= 1000) }
