PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT (COUNT(DISTINCT ?candidate) AS ?candidates) (COUNT(DISTINCT ?replicated) AS ?replicated) WHERE { ?candidate a reo:ReplicationCandidate . OPTIONAL { ?receipt a reo:ReplicationReceipt ; reo:forCandidate ?candidate . BIND(?candidate AS ?replicated) } }
