PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT ?candidate (COUNT(DISTINCT ?repo) AS ?repos) (COUNT(DISTINCT ?receipt) AS ?receipts) (COUNT(DISTINCT ?root) AS ?roots) WHERE { ?candidate a reo:ReplicationCandidate ; reo:targets ?target . ?target reo:observedInRepo ?repo . OPTIONAL { ?receipt a reo:ReplicationReceipt ; reo:forCandidate ?candidate ; reo:targets ?target . } OPTIONAL { ?candidate reo:evidenceRoot ?root . } } GROUP BY ?candidate ORDER BY DESC(?repos) DESC(?receipts) DESC(?roots) ?candidate
