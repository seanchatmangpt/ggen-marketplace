PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT ?candidate WHERE { ?candidate a reo:ReplicationCandidate ; reo:targets ?target ; reo:evidenceRoot ?root ; reo:generatorSource ?generator ; reo:observedInRepo ?repo . ?receipt a reo:ReplicationReceipt ; reo:forCandidate ?candidate . ?f a reo:Falsifier ; reo:forCandidate ?candidate . ?court a reo:QualificationCourt ; reo:qualifies ?candidate . ?ci a reo:CIExecution ; reo:verifies ?candidate . }
ORDER BY ?candidate
