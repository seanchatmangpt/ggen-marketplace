PREFIX reo: <https://ggen.dev/ontology/replication-epistemic#>
SELECT ?run (?coverage * ?reuse * ?opportunities AS ?observed) (1000 - (?coverage * ?reuse * ?opportunities) AS ?shortfall) WHERE { ?run a reo:MeasurementRun ; reo:coverageMultiplier ?coverage ; reo:reuseMultiplier ?reuse ; reo:opportunityMultiplier ?opportunities . FILTER(?coverage * ?reuse * ?opportunities < 1000) }
ORDER BY ?run
