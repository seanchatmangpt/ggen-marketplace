@prefix reo: <https://ggen.dev/ontology/replication-epistemic#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

reo:ReplicationCandidate a prov:Entity .
reo:ReplicationReceipt a prov:Entity .
reo:Falsifier a prov:Entity .
reo:QualificationCourt a prov:Activity .
reo:CIExecution a prov:Activity .
reo:Sensor a dqv:QualityMeasurementDataset .
reo:SensorObservation a dqv:QualityMeasurement .
reo:MeasurementRun a prov:Activity .
reo:MemoryRecord a prov:Entity .
reo:CurrentObservation a prov:Entity .
reo:Opportunity a prov:Entity .
reo:Hypothesis a prov:Entity .
reo:ReplicationPath a prov:Plan .
reo:ReusableArtifact a prov:Entity .
reo:Documentation a dcat:Resource .

reo:subjectSha a prov:qualifiedGeneration .
reo:forCandidate a prov:specializationOf .
reo:targets a prov:used .
reo:evidenceRoot a prov:wasDerivedFrom .
reo:consumes a prov:used .
reo:qualifies a prov:generated .
reo:relieves a prov:invalidated .
reo:observedInRepo a prov:atLocation .
reo:generatorSource a prov:wasDerivedFrom .
reo:exercised a prov:used .
reo:documents a dcterms:subject .
reo:verifies a prov:used .
reo:bySensor a dqv:isMeasurementOf .
reo:producedEdge a prov:generated .
reo:provenanceReceipt a prov:wasDerivedFrom .
reo:derivedFromMemory a prov:wasDerivedFrom .
reo:derivedFromSeed a prov:wasDerivedFrom .
reo:duplicatesMemory a prov:alternateOf .
reo:asserts a prov:value .
reo:contradicts a prov:invalidated .

reo:authorityPolicy a odrl:Policy ;
  odrl:permission [ odrl:action odrl:read ] ;
  odrl:prohibition [ odrl:action odrl:execute ] .
