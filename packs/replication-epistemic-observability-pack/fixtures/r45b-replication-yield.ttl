@prefix reo: <https://ggen.dev/ontology/replication-epistemic#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

reo:artifactFrontier a reo:ReusableArtifact .
reo:repoA reo:observedInRepo "seanchatmangpt/ex4pm" .
reo:repoB reo:observedInRepo "seanchatmangpt/GymAct" .
reo:targetA reo:observedInRepo "seanchatmangpt/ex4pm" .
reo:targetB reo:observedInRepo "seanchatmangpt/GymAct" .
reo:rootA a reo:CurrentObservation .
reo:rootB a reo:CurrentObservation .
reo:memoryR44 a reo:MemoryRecord .
reo:candidateA a reo:ReplicationCandidate ; reo:subjectSha "1111111111111111111111111111111111111111" ; reo:targets reo:targetA ; reo:evidenceRoot reo:rootA, reo:rootB ; reo:consumes reo:artifactFrontier ; reo:derivedFromMemory reo:memoryR44 ; reo:generatorSource reo:artifactFrontier ; reo:exercised reo:executionA .
reo:candidateB a reo:ReplicationCandidate ; reo:subjectSha "2222222222222222222222222222222222222222" ; reo:targets reo:targetB ; reo:evidenceRoot reo:rootA ; reo:consumes reo:artifactFrontier ; reo:derivedFromSeed reo:rootB .
reo:receiptA a reo:ReplicationReceipt ; reo:forCandidate reo:candidateA ; reo:targets reo:targetA ; reo:provenanceReceipt reo:rootA .
reo:falsifierA a reo:Falsifier ; reo:forCandidate reo:candidateA ; reo:targets reo:targetA .
reo:courtA a reo:QualificationCourt ; reo:qualifies reo:targetA, reo:executionA .
reo:ciA a reo:CIExecution ; reo:subjectSha "1111111111111111111111111111111111111111" ; reo:verifies reo:courtA ; reo:observedInRepo "seanchatmangpt/ex4pm" .
reo:pathA a reo:ReplicationPath ; reo:targets reo:targetA ; reo:evidenceRoot reo:rootA, reo:rootB .
reo:opportunityA a reo:Opportunity ; reo:targets reo:targetB ; reo:relieves reo:dependencyA ; reo:derivedFromSeed reo:candidateA .
reo:runA a reo:MeasurementRun ; reo:asserts 5 .
reo:hypothesisA a reo:Hypothesis ; reo:derivedFromSeed reo:runA ; reo:asserts 4 .
reo:multiplierOpportunity a reo:Opportunity ; reo:derivedFromSeed reo:hypothesisA ; reo:asserts 8 .
