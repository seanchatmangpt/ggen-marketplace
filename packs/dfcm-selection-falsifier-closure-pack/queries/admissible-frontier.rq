PREFIX dfcm: <https://chatman.ai/dfcm#>
SELECT ?candidate ?evidence ?uncertainty ?rollback ?relief ?reuse WHERE {
  ?candidate a dfcm:SelectionCandidate ;
    dfcm:evidenceScore ?evidence ; dfcm:uncertaintyWidth ?uncertainty ;
    dfcm:rollbackCost ?rollback ; dfcm:dependencyRelief ?relief ; dfcm:reuseValue ?reuse ;
    dfcm:closureRequired ?required ; dfcm:closurePassed ?passed .
  FILTER(?passed >= ?required && ?uncertainty <= 0.35 && ?rollback <= 0.50)
}
ORDER BY DESC(?relief) DESC(?reuse) DESC(?evidence) ?candidate
