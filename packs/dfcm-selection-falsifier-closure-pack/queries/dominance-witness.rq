PREFIX dfcm: <https://chatman.ai/dfcm#>
SELECT ?better ?worse WHERE {
  ?better a dfcm:SelectionCandidate ; dfcm:evidenceScore ?be ; dfcm:uncertaintyWidth ?bu ; dfcm:rollbackCost ?br ; dfcm:dependencyRelief ?bd ; dfcm:reuseValue ?bv .
  ?worse a dfcm:SelectionCandidate ; dfcm:evidenceScore ?we ; dfcm:uncertaintyWidth ?wu ; dfcm:rollbackCost ?wr ; dfcm:dependencyRelief ?wd ; dfcm:reuseValue ?wv .
  FILTER(?better != ?worse && ?be >= ?we && ?bu <= ?wu && ?br <= ?wr && ?bd >= ?wd && ?bv >= ?wv && (?be > ?we || ?bu < ?wu || ?br < ?wr || ?bd > ?wd || ?bv > ?wv))
}
ORDER BY ?better ?worse
