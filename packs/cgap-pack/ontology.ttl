    p:receiptSha256 "63aab2a307618f60c1fe78f7418135002386bd6fce192dc8ba54ae9f6f69b0a0" ;
    p:receiptStanding "PARTIAL" ;
    p:receiptLane "W3-L2" .

p:receipt-w3-l5 a p:Receipt ;
    p:receiptFile "docs/jira/v26.11.2/waves/w3-l5-fused.md" ;
    p:receiptSha256 "8a84cbb7c07d3fc2a2c47798c562f1342ba4961a0e5055e9fb7bcabe3dc9c37b" ;
    p:receiptStanding "PARTIAL" ;
    p:receiptLane "W3-L5" .

