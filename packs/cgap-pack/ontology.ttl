# cgap-pack ontology — canonical graph for the CGAP columnar substrate.
#
# Models the Apache Arrow columnar format surface (physical layouts, buffer
# slots, C Data Interface ABI structs, schema flags) that the `cgap` repo
# manufactures from. Per-individual citations ground every modeled type to the
# Arrow Columnar Format spec:
#   https://arrow.apache.org/docs/format/Columnar.html
#
# Generated consequences (include/cgap.h, include/cgap_format_codes.h,
# crates/cgap-core/src/layout_gen.rs) are projections of THIS graph. Never
# hand-edit generated output; change the graph and re-run `ggen sync`.

@prefix av:      <https://cgap.chatmangpt.com/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix p:       <https://seanchatmangpt.github.io/packs/cgap-pack#> .

#################################################################
# 1. VOCABULARY
#################################################################

av:PhysicalLayout a rdfs:Class ;
    rdfs:label "Physical Memory Layout" ;
    rdfs:comment "A distinct physical buffer arrangement defined by the Arrow columnar spec." .

av:NullLayout           rdfs:subClassOf av:PhysicalLayout .
av:PrimitiveLayout      rdfs:subClassOf av:PhysicalLayout .
av:TemporalLayout       rdfs:subClassOf av:PrimitiveLayout .
av:DecimalLayout        rdfs:subClassOf av:PrimitiveLayout .
av:VariableBinaryLayout rdfs:subClassOf av:PhysicalLayout .
av:BinaryViewLayout     rdfs:subClassOf av:PhysicalLayout .
av:NestedLayout         rdfs:subClassOf av:PhysicalLayout .
av:RunEndEncodedLayout  rdfs:subClassOf av:PhysicalLayout .
av:DictionaryLayout     rdfs:subClassOf av:PhysicalLayout .

av:BufferRole a rdfs:Class ;
    rdfs:label "Buffer Semantic Role" .

av:ValidityBitmap     a av:BufferRole ; rdfs:label "1-bit LSB-first validity bitmap" .
av:DataBuffer         a av:BufferRole ; rdfs:label "Contiguous value/element payload" .
av:OffsetBuffer       a av:BufferRole ; rdfs:label "Relative index offset array (32/64-bit)" .
av:VariadicDataBuffer a av:BufferRole ; rdfs:label "Variadic data blocks behind string/binary views" .
av:SizeBuffer         a av:BufferRole ; rdfs:label "List-view element sizes array" .
av:TypeBuffer         a av:BufferRole ; rdfs:label "Union 8-bit type discriminator ids" .

av:BufferSlot a rdfs:Class ;
    rdfs:label "Explicit Buffer Slot Descriptor" .

av:slotIndex       a rdf:Property ; rdfs:domain av:BufferSlot ; rdfs:range xsd:integer .
av:bufferRole      a rdf:Property ; rdfs:domain av:BufferSlot ; rdfs:range av:BufferRole .
av:elementBitWidth a rdf:Property ; rdfs:domain av:BufferSlot ; rdfs:range xsd:integer .
av:alignmentBytes  a rdf:Property ; rdfs:domain av:BufferSlot ; rdfs:range xsd:integer .
av:hasBufferSlot   a rdf:Property ; rdfs:domain av:PhysicalLayout ; rdfs:range av:BufferSlot .

av:formatCode   a rdf:Property ; rdfs:range xsd:string .
av:formatPrefix a rdf:Property ; rdfs:range xsd:string .
av:bufferCount  a rdf:Property ; rdfs:range xsd:integer .
av:childCount   a rdf:Property ; rdfs:range xsd:integer .
av:sourceText   a rdf:Property ; rdfs:range xsd:string .

#################################################################
# 2. C DATA INTERFACE ABI STRUCTS + FLAGS
#################################################################

av:CAbiStruct a rdfs:Class ;
    rdfs:label "Arrow C Data Interface ABI Struct" .

av:SchemaFlag a rdfs:Class ;
    rdfs:label "ArrowSchema.flags Bitmask" .

av:cFlagValue a rdf:Property ; rdfs:range xsd:integer .

av:FlagDictionaryOrdered a av:SchemaFlag ; av:cFlagValue 1 ; rdfs:label "ARROW_FLAG_DICTIONARY_ORDERED" .
av:FlagNullable          a av:SchemaFlag ; av:cFlagValue 2 ; rdfs:label "ARROW_FLAG_NULLABLE" .
av:FlagMapKeysSorted     a av:SchemaFlag ; av:cFlagValue 4 ; rdfs:label "ARROW_FLAG_MAP_KEYS_SORTED" .

# Exact spec definitions (C Data Interface, Buffer.html / C_DataInterface.html).
av:ArrowSchema a av:CAbiStruct ;
    rdfs:label "struct ArrowSchema" ;
    av:sourceText """struct ArrowSchema {
  const char* format;
  const char* name;
  const char* metadata;
  int64_t flags;
  int64_t n_children;
  struct ArrowSchema** children;
  struct ArrowSchema* dictionary;
  void (*release)(struct ArrowSchema*);
  void* private_data;
};""" .

av:ArrowArray a av:CAbiStruct ;
    rdfs:label "struct ArrowArray" ;
    av:sourceText """struct ArrowArray {
  int64_t length;
  int64_t null_count;
  int64_t offset;
  int64_t n_buffers;
  int64_t n_children;
  const void** buffers;
  struct ArrowArray** children;
  struct ArrowArray* dictionary;
  void (*release)(struct ArrowArray*);
  void* private_data;
};""" .

#################################################################
# 3. TYPE INDIVIDUALS (format codes + buffer slots)
#################################################################

# --- Null (spec: Columnar.html#null) ---
av:Null a av:NullLayout ;
    rdfs:label "Null" ;
    av:formatCode "n" ;
    av:bufferCount 0 .

# --- Boolean (spec: Columnar.html#boolean) ---
av:Boolean a av:PrimitiveLayout ;
    rdfs:label "Boolean" ;
    av:formatCode "b" ;
    av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] .

# --- Primitive integers (spec: Columnar.html#integer) ---
av:Int8   a av:PrimitiveLayout ; rdfs:label "Int8"   ; av:formatCode "c" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 8  ; av:alignmentBytes 64 ] .

av:UInt8  a av:PrimitiveLayout ; rdfs:label "UInt8"  ; av:formatCode "C" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 8  ; av:alignmentBytes 64 ] .

av:Int16  a av:PrimitiveLayout ; rdfs:label "Int16"  ; av:formatCode "s" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 16 ; av:alignmentBytes 64 ] .

av:UInt16 a av:PrimitiveLayout ; rdfs:label "UInt16" ; av:formatCode "S" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 16 ; av:alignmentBytes 64 ] .

av:Int32  a av:PrimitiveLayout ; rdfs:label "Int32"  ; av:formatCode "i" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

av:UInt32 a av:PrimitiveLayout ; rdfs:label "UInt32" ; av:formatCode "I" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

av:Int64  a av:PrimitiveLayout ; rdfs:label "Int64"  ; av:formatCode "l" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:UInt64 a av:PrimitiveLayout ; rdfs:label "UInt64" ; av:formatCode "L" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

# --- Floating point (spec: Columnar.html#floating-point) ---
av:Float16 a av:PrimitiveLayout ; rdfs:label "Float16" ; av:formatCode "e" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 16 ; av:alignmentBytes 64 ] .

av:Float32 a av:PrimitiveLayout ; rdfs:label "Float32" ; av:formatCode "f" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

av:Float64 a av:PrimitiveLayout ; rdfs:label "Float64" ; av:formatCode "g" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

# --- Decimals (spec: Columnar.html#decimal) ---
av:Decimal128 a av:DecimalLayout ; rdfs:label "Decimal128" ; av:formatPrefix "d:" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1   ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 128 ; av:alignmentBytes 64 ] .

av:Decimal256 a av:DecimalLayout ; rdfs:label "Decimal256" ; av:formatPrefix "d:" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1   ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 256 ; av:alignmentBytes 64 ] .

# --- Temporal (spec: Columnar.html#temporal) ---
av:Date32 a av:TemporalLayout ; rdfs:label "Date32" ; av:formatCode "tdD" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

av:Date64 a av:TemporalLayout ; rdfs:label "Date64" ; av:formatCode "tdm" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:Time32Sec a av:TemporalLayout ; rdfs:label "Time32Sec" ; av:formatCode "tts" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

av:Time32Milli a av:TemporalLayout ; rdfs:label "Time32Milli" ; av:formatCode "ttm" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

av:Time64Micro a av:TemporalLayout ; rdfs:label "Time64Micro" ; av:formatCode "ttu" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:Time64Nano a av:TemporalLayout ; rdfs:label "Time64Nano" ; av:formatCode "ttn" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

# Timestamps: timezone-scoped, exact form is prefix + tz string, e.g. tss:UTC.
av:TimestampSec a av:TemporalLayout ; rdfs:label "TimestampSec" ; av:formatPrefix "tss:" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:TimestampMilli a av:TemporalLayout ; rdfs:label "TimestampMilli" ; av:formatPrefix "tsm:" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:TimestampMicro a av:TemporalLayout ; rdfs:label "TimestampMicro" ; av:formatPrefix "tsu:" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:TimestampNano a av:TemporalLayout ; rdfs:label "TimestampNano" ; av:formatPrefix "tsn:" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:DurationSec a av:TemporalLayout ; rdfs:label "DurationSec" ; av:formatCode "tDs" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:DurationMilli a av:TemporalLayout ; rdfs:label "DurationMilli" ; av:formatCode "tDm" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:DurationMicro a av:TemporalLayout ; rdfs:label "DurationMicro" ; av:formatCode "tDu" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:DurationNano a av:TemporalLayout ; rdfs:label "DurationNano" ; av:formatCode "tDn" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:IntervalYearMonth a av:TemporalLayout ; rdfs:label "IntervalYearMonth" ; av:formatCode "tiM" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

av:IntervalDayTime a av:TemporalLayout ; rdfs:label "IntervalDayTime" ; av:formatCode "tiD" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

av:IntervalMonthDayNano a av:TemporalLayout ; rdfs:label "IntervalMonthDayNano" ; av:formatCode "tiI" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer ; av:elementBitWidth 128 ; av:alignmentBytes 64 ] .

# --- Variable binary / string (spec: Columnar.html#variable-size-binary) ---
av:Utf8String a av:VariableBinaryLayout ; rdfs:label "Utf8" ; av:formatCode "u" ; av:bufferCount 3 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:OffsetBuffer   ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 2 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 8  ; av:alignmentBytes 64 ] .

av:LargeUtf8String a av:VariableBinaryLayout ; rdfs:label "LargeUtf8" ; av:formatCode "U" ; av:bufferCount 3 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:OffsetBuffer   ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 2 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 8  ; av:alignmentBytes 64 ] .

av:Binary a av:VariableBinaryLayout ; rdfs:label "Binary" ; av:formatCode "z" ; av:bufferCount 3 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:OffsetBuffer   ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 2 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 8  ; av:alignmentBytes 64 ] .

av:LargeBinary a av:VariableBinaryLayout ; rdfs:label "LargeBinary" ; av:formatCode "Z" ; av:bufferCount 3 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:OffsetBuffer   ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 2 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 8  ; av:alignmentBytes 64 ] .

av:FixedSizeBinary a av:PrimitiveLayout ; rdfs:label "FixedSizeBinary" ; av:formatPrefix "w:" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1 ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer     ; av:elementBitWidth 8 ; av:alignmentBytes 64 ] .

# --- String/Binary views (spec: Columnar.html#string-view-binary-view) ---
# Slot 1 holds 16-byte inline view descriptors; slots 2..n hold variadic data
# blocks (one or more data buffers referenced by long-form views).
av:Utf8View a av:BinaryViewLayout ; rdfs:label "Utf8View" ; av:formatCode "vu" ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap     ; av:elementBitWidth 1   ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer         ; av:elementBitWidth 128 ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 2 ; av:bufferRole av:VariadicDataBuffer ; av:elementBitWidth 8   ; av:alignmentBytes 64 ] .

av:BinaryView a av:BinaryViewLayout ; rdfs:label "BinaryView" ; av:formatCode "vz" ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap     ; av:elementBitWidth 1   ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:DataBuffer         ; av:elementBitWidth 128 ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 2 ; av:bufferRole av:VariadicDataBuffer ; av:elementBitWidth 8   ; av:alignmentBytes 64 ] .

# --- Nested (spec: Columnar.html#nested) ---
av:Struct_ a av:NestedLayout ; rdfs:label "Struct" ; av:formatCode "+s" ; av:bufferCount 1 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1 ; av:alignmentBytes 64 ] .

av:List a av:NestedLayout ; rdfs:label "List" ; av:formatCode "+l" ; av:bufferCount 2 ; av:childCount 1 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:OffsetBuffer   ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

av:LargeList a av:NestedLayout ; rdfs:label "LargeList" ; av:formatCode "+L" ; av:bufferCount 2 ; av:childCount 1 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:OffsetBuffer   ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

# Fixed-size list: exact form is "+fl:{fixed_size}" (e.g. +fl:4096).
av:FixedSizeList a av:NestedLayout ; rdfs:label "FixedSizeList" ; av:formatPrefix "+fl:" ; av:bufferCount 1 ; av:childCount 1 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1 ; av:alignmentBytes 64 ] .

av:ListView a av:NestedLayout ; rdfs:label "ListView" ; av:formatCode "+vl" ; av:bufferCount 3 ; av:childCount 1 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:OffsetBuffer   ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 2 ; av:bufferRole av:SizeBuffer     ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

av:LargeListView a av:NestedLayout ; rdfs:label "LargeListView" ; av:formatCode "+vL" ; av:bufferCount 3 ; av:childCount 1 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:OffsetBuffer   ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 2 ; av:bufferRole av:SizeBuffer     ; av:elementBitWidth 64 ; av:alignmentBytes 64 ] .

# Unions carry type ids only — no validity bitmap (spec: unions are always valid).
av:DenseUnion a av:NestedLayout ; rdfs:label "DenseUnion" ; av:formatPrefix "+ud:" ; av:bufferCount 2 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:TypeBuffer   ; av:elementBitWidth 8  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:OffsetBuffer ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

av:SparseUnion a av:NestedLayout ; rdfs:label "SparseUnion" ; av:formatPrefix "+us:" ; av:bufferCount 1 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:TypeBuffer ; av:elementBitWidth 8 ; av:alignmentBytes 64 ] .

# Map: list-like of struct<entries>; child 0 is the entries struct (keys, values).
av:Map a av:NestedLayout ; rdfs:label "Map" ; av:formatCode "+m" ; av:bufferCount 2 ; av:childCount 1 ;
    av:hasBufferSlot [ av:slotIndex 0 ; av:bufferRole av:ValidityBitmap ; av:elementBitWidth 1  ; av:alignmentBytes 64 ] ;
    av:hasBufferSlot [ av:slotIndex 1 ; av:bufferRole av:OffsetBuffer   ; av:elementBitWidth 32 ; av:alignmentBytes 64 ] .

# Run-end encoded: logical container; run_ends + values live in two children.
av:RunEndEncoded a av:RunEndEncodedLayout ; rdfs:label "RunEndEncoded" ; av:formatCode "+r" ;
    av:bufferCount 0 ; av:childCount 2 .

# Dictionary encoding: parent format string equals the index type's native
# format code; decoded values live in the C-ABI `dictionary` child.
av:Dictionary a av:DictionaryLayout ; rdfs:label "Dictionary" ; av:bufferCount 0 ; av:childCount 2 ;
    rdfs:comment "Format string equals the index type's native format code; values in dictionary child." .

#################################################################
# 4. PROMISES (gate 020 promise-vs-content backing)
#################################################################

av:Promise a rdfs:Class ;
    rdfs:label "Pack Promise" ;
    rdfs:comment "A claim the pack makes about its admitted surface; each must be backed by modeled individuals." .

av:promise_alignment a av:Promise ;
    rdfs:label "Every modeled buffer slot is aligned to exactly 64 bytes" ;
    p:backedBy av:AlignmentGate , av:Boolean , av:Int64 , av:Utf8String .

av:promise_c_abi_parity a av:Promise ;
    rdfs:label "C Data Interface parity: ArrowSchema + ArrowArray modeled and projected to include/cgap.h" ;
    p:backedBy av:ArrowSchema , av:ArrowArray , av:FlagNullable .

av:promise_format_coverage a av:Promise ;
    rdfs:label "Every Arrow type family has a modeled layout with formatCode or formatPrefix" ;
    p:backedBy av:Null , av:Boolean , av:Date32 , av:Utf8String , av:Struct_ , av:RunEndEncoded , av:Dictionary .

#################################################################
# 5. SHACL-CLASS GATES (modeled; SPARQL forms live in gates/*.rq)
#################################################################

av:AlignmentGate a rdfs:Class ;
    rdfs:label "Hardware Alignment Gate" ;
    rdfs:comment "Every BufferSlot must carry alignmentBytes exactly 64 (AVX-512 / NEON invariant)." .

av:FormatCompletenessGate a rdfs:Class ;
    rdfs:label "Format Code Completeness Gate" ;
    rdfs:comment "Every PhysicalLayout (except DictionaryLayout, whose format string is its index type's) must carry formatCode or formatPrefix." .

av:SlotContinuityGate a rdfs:Class ;
    rdfs:label "Slot Index Continuity Gate" ;
    rdfs:comment "Buffer slots per layout must be densely indexed from 0 (max+1 == count)." .

# Pack-level subjects (gate 010 compatibility individuals)
p:example a p:Subject ;
    p:subjectId "https://cgap.chatmangpt.com/cgap-pack/example" .
p:cgap a p:Subject ;
    p:subjectId "https://cgap.chatmangpt.com/cgap-pack/cgap" .

#################################################################
# 6. PARETO LEVERS (W1-04)
#################################################################

p:ParetoLever a rdfs:Class ;
    rdfs:label "Pareto Lever" ;
    rdfs:comment "Measured perf lever with code grounding + named mutation." .

p:LeverGate a rdfs:Class ;
    rdfs:label "Lever Gate" ;
    rdfs:comment "A refusal gate admitted into the lever court set." .

p:leverId      a rdf:Property ; rdfs:domain p:ParetoLever ; rdfs:range xsd:string .
p:leverTarget  a rdf:Property ; rdfs:domain p:ParetoLever ; rdfs:range xsd:string .
p:measuredNs   a rdf:Property ; rdfs:domain p:ParetoLever ; rdfs:range xsd:decimal .
p:groundedIn   a rdf:Property ; rdfs:domain p:ParetoLever ; rdfs:range xsd:string .
p:mutated      a rdf:Property ; rdfs:domain p:ParetoLever ; rdfs:range xsd:boolean .
p:mutationName a rdf:Property ; rdfs:domain p:ParetoLever ; rdfs:range xsd:string .
p:skipReason   a rdf:Property ; rdfs:domain p:ParetoLever ; rdfs:range xsd:string .
p:leverGate    a rdf:Property ; rdfs:domain p:ParetoLever ; rdfs:range p:LeverGate .
p:leverStatus  a rdf:Property ; rdfs:domain p:ParetoLever ; rdfs:range xsd:string ;
    rdfs:comment "Campaign status: [TARGET-v26.11.2] | LANDED-<receipt-cite> | BLOCKED-<coords> (G1K-3)." .

p:gate-060 a p:LeverGate ; rdfs:label "lever identity" .
p:gate-070 a p:LeverGate ; rdfs:label "mutation law" .
p:gate-080 a p:LeverGate ; rdfs:label "target/measured pair" .
p:gate-090 a p:LeverGate ; rdfs:label "grounding path regex" .
p:gate-100 a p:LeverGate ; rdfs:label "gate linkage" .
p:gate-130 a p:LeverGate ; rdfs:label "lever status law" .

p:L1-ingress-digest-escalation a p:ParetoLever ;
    p:leverId "L1-ingress-digest-escalation" ;
    p:leverStatus "LANDED-skip-not-pay (10.20 ns/frame, 10.1x; proof waves/w4-p3-escalation-corpus.md)" ;
    p:leverTarget "<15 ns/frame" ;
    p:measuredNs 102.7 ;
    p:groundedIn "crates/cgap-core/src/frame.rs:86-87" ;
    p:mutated false ;
    p:mutationName "flip-mutation-on-lever" ;
    p:leverGate p:gate-060 ;
    p:leverGate p:gate-130 .

p:L2-parquet-swar-fnv1a a p:ParetoLever ;
    p:leverId "L2-parquet-swar-fnv1a" ;
    p:leverStatus "[TARGET-v26.11.2]" ;
    p:leverTarget "<10 ms @1M rows" ;
    p:measuredNs 41540000.0 ;
    p:groundedIn "crates/cgap-parquet/src/footer.rs:119-127" ;
    p:mutated false ;
    p:mutationName "fnv1a-prime-corruption" ;
    p:leverGate p:gate-070 ;
    p:leverGate p:gate-130 .

p:L3-bn3-plnf-semi-join a p:ParetoLever ;
    p:leverId "L3-bn3-plnf-semi-join" ;
    p:leverStatus "LANDED-waves/p1-repair-unify-repair.md (semi-join landed in unify.rs; 7 lever courts exit 0 incl. l3_antivacuity_probe_drop_flips; perf re-measure pending)" ;
    p:leverTarget "unbounded-until-measured" ;
    p:measuredNs 1470000000.0 ;
    p:groundedIn "crates/cgap-bn3/src/unify.rs:330-342" ;
    p:mutated true ;
    p:mutationName "unify-var-swap" ;
    p:leverGate p:gate-080 ;
    p:leverGate p:gate-130 .

p:L4-sovereign-ring-sink a p:ParetoLever ;
    p:leverId "L4-sovereign-ring-sink" ;
    p:leverStatus "LANDED-waves/a3-ring-sink.md (0.60 us/tx, >=76x)" ;
    p:leverTarget "<4 us/tx" ;
    p:measuredNs 600.0 ;
    p:groundedIn "crates/cgap-ffi/src/sovereign.rs:706-730" ;
    p:leverGate p:gate-090 ;
    p:leverGate p:gate-130 .

p:L5-seal-fused-asc450 a p:ParetoLever ;
    p:leverId "L5-seal-fused-asc450" ;
    p:leverStatus "[TARGET-v26.11.2]" ;
    p:leverTarget "<1.45 us/row" ;
    p:measuredNs 2370.0 ;
    p:groundedIn "crates/cgap-p28/src/asc450.rs:360-364" ;
    p:mutated false ;
    p:mutationName "asc450-seal-truncate" ;
    p:leverGate p:gate-100 ;
    p:leverGate p:gate-130 .

#################################################################
# 7. BENCH REGISTRY (G1K-4)
#################################################################

p:Bench a rdfs:Class ;
    rdfs:label "Benchmark Target" ;
    rdfs:comment "A chained-pipeline bench target grounded in crates/bench/benches/." .

p:benchTarget  a rdf:Property ; rdfs:domain p:Bench ; rdfs:range xsd:string .
p:benchFile    a rdf:Property ; rdfs:domain p:Bench ; rdfs:range xsd:string .
p:benchConsts  a rdf:Property ; rdfs:domain p:Bench ; rdfs:range xsd:string .
p:benchLever   a rdf:Property ; rdfs:domain p:Bench ; rdfs:range p:ParetoLever .
p:benchSeedLaw a rdf:Property ; rdfs:domain p:Bench ; rdfs:range xsd:string .

p:bench-chains-ingress a p:Bench ;
    p:benchTarget "chains-ingress" ;
    p:benchFile "crates/bench/benches/chains-ingress.rs" ;
    p:benchConsts "CHAIN_SEED=0xC001_0000_5EED_0001 (chains-ingress.rs:54); SLOT_CAP=512 (:58); POOL=65536 (:61); EC_SHORT=9 (:65); EC_OK=0 (:68)" ;
    p:benchLever p:L1-ingress-digest-escalation ;
    p:benchSeedLaw "CHAIN_SEED is chain-domain, not the canonical seed; corpus seeding follows the SplitMix64 law 0xBF58_476D_1CE4_E5B9 (seed) — 0xA20C_0FFE_E5A7_E000 is a spread constant, never a seed" .

p:bench-chains-parquet a p:Bench ;
    p:benchTarget "chains-parquet" ;
    p:benchFile "crates/bench/benches/chains-parquet.rs" ;
    p:benchConsts "CORPUS_SEED=0xBF58_476D_1CE4_E5B9 (chains-parquet.rs:55); LANE_SPREAD=0x2544_5491_4F6C_DD1D (:59); BLOCK_CAP=8388608 (:65)" ;
    p:benchLever p:L2-parquet-swar-fnv1a ;
    p:benchSeedLaw "CORPUS_SEED pinned to canonical SplitMix64 0xBF58_476D_1CE4_E5B9 at chains-parquet.rs:55; seed/constant roles never conflated" .

p:bench-chains-bn3 a p:Bench ;
    p:benchTarget "chains-bn3" ;
    p:benchFile "crates/bench/benches/chains-bn3.rs" ;
    p:benchConsts "CANONICAL_SEED=0xBF58_476D_1CE4_E5B9 (chains-bn3.rs:33); CHAIN_EPOCH=7 (:37); KEY_DOM=8 (:77)" ;
    p:benchLever p:L3-bn3-plnf-semi-join ;
    p:benchSeedLaw "CANONICAL_SEED pinned to 0xBF58_476D_1CE4_E5B9 at chains-bn3.rs:33; a non-canonical constant in bench code is the known write-corruption class" .

p:bench-chains-seal a p:Bench ;
    p:benchTarget "chains-seal" ;
    p:benchFile "crates/bench/benches/chains-seal.rs" ;
    p:benchConsts "CORPUS_SEED=0xBF58_476D_1CE4_E5B9 (chains-seal.rs:55); RECORD_SPREAD=0x2544_5491_4F6C_DD1D (:59); METER_LEASE_DOMAIN=0xA18E_5000_0000_0001 (:63); RECEIPT_EPOCH_DOMAIN=0xA16E_7000_0000_0001 (:66); GENESIS_ROOT_DOMAIN=0xA16E_7000_0000_0002 (:69)" ;
    p:benchLever p:L5-seal-fused-asc450 ;
    p:benchSeedLaw "CORPUS_SEED pinned to 0xBF58_476D_1CE4_E5B9 at chains-seal.rs:55; domain-split constants are spreads, not seeds" .

p:bench-chains-sovereign a p:Bench ;
    p:benchTarget "chains-sovereign" ;
    p:benchFile "crates/bench/benches/chains-sovereign.rs" ;
    p:benchConsts "CORPUS_SEED=0xBF58_476D_1CE4_E5B9 (chains-sovereign.rs:77); RECORD_SPREAD=0x2544_5491_4F6C_DD1D (:64); ROWS_PER_FRAME=16 (:68)" ;
    p:benchLever p:L4-sovereign-ring-sink ;
    p:benchSeedLaw "CORPUS_SEED pinned to 0xBF58_476D_1CE4_E5B9 at chains-sovereign.rs:77" .

#################################################################
# 6. COURT INDIVIDUALS (docs/jira/v26.11.2/07-court-corpus.md §5)
#
# Courts as graph individuals, not hand-written doc rows. courtSubject is
# gate-lawful: repo-relative path:line[-line] (crates/ or scripts/) or the
# id-prefix escape hatch ^G[0-9]- for subjects with no on-disk file.
# Line cites as-of 2026-11-01 on-disk tree.
#################################################################

p:Court            a rdfs:Class ;
    rdfs:label "Adversarial Court Individual" ;
    rdfs:comment "One flip-summary row: subject, mutation, kill exit, receipt slot." .

p:courtId          a rdf:Property ; rdfs:domain p:Court ; rdfs:range xsd:string .
p:courtSubject     a rdf:Property ; rdfs:domain p:Court ; rdfs:range xsd:string .
p:courtMutation    a rdf:Property ; rdfs:domain p:Court ; rdfs:range xsd:string .
p:courtKillExit    a rdf:Property ; rdfs:domain p:Court ; rdfs:range xsd:string .
p:courtReceipt     a rdf:Property ; rdfs:domain p:Court ; rdfs:range xsd:string .

p:court-L1-COURT a p:Court ;
    p:courtId "L1-COURT" ;
    p:courtSubject "crates/cgap-gate/src/penstock.rs:491" ;
    p:courtMutation "slot byte corrupt" ;
    p:courtKillExit "assert" ;
    p:courtReceipt "w2-l1-court" .

p:court-L2-COURT a p:Court ;
    p:courtId "L2-COURT" ;
    p:courtSubject "crates/cgap-parquet/src/footer.rs:119-127" ;
    p:courtMutation "committed window byte flip" ;
    p:courtKillExit "101" ;
    p:courtReceipt "w2-l2-court" .

p:court-L3-COURT a p:Court ;
    p:courtId "L3-COURT" ;
    p:courtSubject "crates/cgap-bn3/src/unify.rs:453-455" ;
    p:courtMutation "comparator swap" ;
    p:courtKillExit "oracle assert" ;
    p:courtReceipt "w2-l3-court" .

p:court-L4-COURT a p:Court ;
    p:courtId "L4-COURT" ;
    p:courtSubject "crates/cgap-ffi/src/sovereign.rs:722" ;
    p:courtMutation "header byte / slab drop" ;
    p:courtKillExit "SPOLIATION" ;
    p:courtReceipt "w2-l4-court" .

p:court-L5-COURT a p:Court ;
    p:courtId "L5-COURT" ;
    p:courtSubject "crates/cgap-p28/src/asc450.rs:328" ;
    p:courtMutation "receipt bit-flip / crossing demote" ;
    p:courtKillExit "refuse" ;
    p:courtReceipt "w2-l5-court" .

p:court-G1-FLIP a p:Court ;
    p:courtId "G1-FLIP" ;
    p:courtSubject "scripts/release_check.py" ;
    p:courtMutation "strip crate `description`" ;
    p:courtKillExit "1" ;
    p:courtReceipt "w3-g1-court" .

p:court-G2-FLIP a p:Court ;
    p:courtId "G2-FLIP" ;
    p:courtSubject "G2-FLIP:bench kernels L1-L5" ;
    p:courtMutation "inline removal / bounds check" ;
    p:courtKillExit "1" ;
    p:courtReceipt "w3-g2-court" .

p:court-G3-FLIP a p:Court ;
    p:courtId "G3-FLIP" ;
    p:courtSubject "G3-FLIP:mat closure bench" ;
    p:courtMutation "skip derivation rule" ;
    p:courtKillExit "2 loud" ;
    p:courtReceipt "w3-g3-court" .

p:court-G4-FLIP a p:Court ;
    p:courtId "G4-FLIP" ;
    p:courtSubject "G4-FLIP:DRED bench" ;
    p:courtMutation "skip entropy recompute" ;
    p:courtKillExit "2 loud" ;
    p:courtReceipt "w3-g4-court" .

p:court-G5-FLIP a p:Court ;
    p:courtId "G5-FLIP" ;
    p:courtSubject "scripts/symbol_gate.py" ;
    p:courtMutation "alloc / panic symbol injection" ;
    p:courtKillExit "1/2" ;
    p:courtReceipt "w3-g5-court" .

p:court-G6-FLIP a p:Court ;
    p:courtId "G6-FLIP" ;
    p:courtSubject "scripts/zero_datafusion_gate.py" ;
    p:courtMutation "datafusion = \"42\" append" ;
    p:courtKillExit "1" ;
    p:courtReceipt "w3-g6-court" .

p:court-G7-FLIP a p:Court ;
    p:courtId "G7-FLIP" ;
    p:courtSubject "G7-FLIP:verify_ost_design_around.py" ;
    p:courtMutation "claim / prior-art merge" ;
    p:courtKillExit "3 loud" ;
    p:courtReceipt "w3-g7-court" .

p:court-G8-FLIP a p:Court ;
    p:courtId "G8-FLIP" ;
    p:courtSubject "G8-FLIP:purrdf campaign-graph scripts" ;
    p:courtMutation "remove one mapping" ;
    p:courtKillExit "2 loud" ;
    p:courtReceipt "w3-g8-court" .

#################################################################
# 8. CRATE MANIFEST FACTS (G1K-1: manifests moved into the graph)
#################################################################

# One p:CrateManifest individual per root-workspace crate (22, enumerated via
# `cargo metadata --no-deps` on 2026-11-02). Facts are lifted from each
# Cargo.toml — the graph is the projection source; hand-maintained manifests
# are the drift channel this section closes. Gate 110 refuses a workspace
# crate without a fully-attributed p:CrateManifest;
# templates/manifest-facts-tbl.tmpl projects the markdown table.
p:CrateManifest a rdfs:Class ;
    rdfs:label "Crate Manifest Fact" ;
    rdfs:comment "Facts lifted from one workspace member's Cargo.toml." .

p:crateName        a rdf:Property ; rdfs:domain p:CrateManifest ; rdfs:range xsd:string .
p:crateDescription a rdf:Property ; rdfs:domain p:CrateManifest ; rdfs:range xsd:string .
p:cratePublish     a rdf:Property ; rdfs:domain p:CrateManifest ; rdfs:range xsd:boolean .
p:crateVersion     a rdf:Property ; rdfs:domain p:CrateManifest ; rdfs:range xsd:string .

# Witness vocabulary for gate 110: the known workspace-crate names.
p:witnessCrate a rdf:Property ; rdfs:range xsd:string .

p:manifest-cgap a p:CrateManifest ;
    p:crateName "cgap" ;
    p:crateDescription "cgap umbrella facade: columnar substrate (Arrow), BLAKE3 hashing, Parquet persistence, and Git packfile writing - one dependency for the published cgap kernel crates." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-arrow a p:CrateManifest ;
    p:crateName "cgap-arrow" ;
    p:crateDescription "Freestanding Apache Arrow columnar substrate: branch-free kernel inner-loop bodies, itemized latches/dispatch (no_std, zero dependencies)." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-core a p:CrateManifest ;
    p:crateName "cgap-core" ;
    p:crateDescription "128-byte sovereign CgapFrameHeader codec and triumvirate isomorphism kernels for the cgap substrate." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-blake3 a p:CrateManifest ;
    p:crateName "cgap-blake3" ;
    p:crateDescription "Sovereign, zero-dependency no_std BLAKE3 cryptographic tree hash with 4-way NEON and 8-way AVX2 parent Merkle reduction." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-gate a p:CrateManifest ;
    p:crateName "cgap-gate" ;
    p:crateDescription "Campaign boundary gate kernels: fail-closed guard evaluation courts for the cgap substrate." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-storage a p:CrateManifest ;
    p:crateName "cgap-storage" ;
    p:crateDescription "WAL-framed transactional storage engine (flash model, Txn commit path, differential erase sweeps) for the cgap substrate." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-git a p:CrateManifest ;
    p:crateName "cgap-git" ;
    p:crateDescription "Git Packfile v2 writer: stored blob objects, .idx v2 generation, in-crate SHA-1 and CRC32 (zero external dependencies)." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-parquet a p:CrateManifest ;
    p:crateName "cgap-parquet" ;
    p:crateDescription "Parquet persistence kernels with branch-free inner-loop bodies: bit-unpacking, SWAR RLE, page-to-buffer decode (no_std, zero dependencies)." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-ffi a p:CrateManifest ;
    p:crateName "cgap-ffi" ;
    p:crateDescription "C Data Interface cdylib membrane for cgap (Gate 3 wire-parity exports)." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-audit a p:CrateManifest ;
    p:crateName "cgap-audit" ;
    p:crateDescription "CC=1 branch-audit cdylib: forces every kernel into the artifact so machine code can be inspected." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-bn3 a p:CrateManifest ;
    p:crateName "cgap-bn3" ;
    p:crateDescription "Binary N3 (BN3) reasoning kernel: slab arena, sigil codec, BN3 unifier and projection for the cgap substrate." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-p28 a p:CrateManifest ;
    p:crateName "cgap-p28" ;
    p:crateDescription "P28-SIL v2.1.0 sovereign compliance crate: license attestation (80-byte P28LicenseAttestation), ASC-450 control kernels, and sealed evidence for the cgap substrate." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-crypto a p:CrateManifest ;
    p:crateName "cgap-crypto" ;
    p:crateDescription "Sovereign, zero-dependency no_std keyed BLAKE3 cryptography kernel (keyed digest engine, sealed transcripts, Merkle helpers) on the cgap-blake3 substrate." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-beam a p:CrateManifest ;
    p:crateName "cgap-beam" ;
    p:crateDescription "BEAM/AtomVM NIF membrane for cgap (off-heap resource handles)." ;
    p:cratePublish false ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-gpu a p:CrateManifest ;
    p:crateName "cgap-gpu" ;
    p:crateDescription "GPU execution membrane for the cgap sovereign substrate: Metal Unified Memory zero-copy buffer bridging." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-bench a p:CrateManifest ;
    p:crateName "bench" ;
    p:crateDescription "Divan membrane: v26.11.1 Phase 2 (Measure) perf-target graduation harness." ;
    p:cratePublish false ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-integration a p:CrateManifest ;
    p:crateName "cgap-integration" ;
    p:crateDescription "Cross-crate integration tests: C-ABI roundtrip, alignment law, format-code table, varlen/views roundtrips." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-bont a p:CrateManifest ;
    p:crateName "cgap-bont" ;
    p:crateDescription "Binary ontology (B-ONT) primitives, SHACL bitmask compiler and O-ABI reader for the cgap sovereign columnar substrate." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-bosym a p:CrateManifest ;
    p:crateName "cgap-bosym" ;
    p:crateDescription "Binary ontology symbol slab (B-OSYM) interned-identifier slab for the cgap sovereign columnar substrate." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-court a p:CrateManifest ;
    p:crateName "cgap-court" ;
    p:crateDescription "" ;
    p:cratePublish false ;
    p:crateVersion "26.11.2" .

p:manifest-cgap-fibo a p:CrateManifest ;
    p:crateName "cgap-fibo" ;
    p:crateDescription "FIBO O-ABI pack for the cgap sovereign columnar substrate: build-time-emitted binary ontology pack, no_std const/types facade." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

p:Receipt a rdfs:Class ;
    rdfs:label "Campaign Receipt Individual" ;
    rdfs:comment "A wave receipt (docs/jira/v26.11.2/waves/<name>.md) cited as a graph individual, so receipt drift (file edited after citation) is mechanically detectable: the sha256 pinned in the graph vs the file on disk." .

p:receiptFile     a rdf:Property ; rdfs:domain p:Receipt ; rdfs:range xsd:string ;
    rdfs:comment "Repo-relative path of the receipt markdown, relative to /Users/sac/cgap." .
p:receiptSha256   a rdf:Property ; rdfs:domain p:Receipt ; rdfs:range xsd:string ;
    rdfs:comment "Full 64-hex sha256 of the receipt file bytes at citation time." .
p:receiptStanding a rdf:Property ; rdfs:domain p:Receipt ; rdfs:range xsd:string ;
    rdfs:comment "Honest standing at citation time: ALIVE | PARTIAL | BLOCKED | UNVERIFIED." .
p:receiptLane     a rdf:Property ; rdfs:domain p:Receipt ; rdfs:range xsd:string .

# STARTING SET: the six load-bearing W3 receipts (sha256 computed over the
# exact on-disk bytes this session, 2026-11-01).
p:receipt-w3-l1 a p:Receipt ;
