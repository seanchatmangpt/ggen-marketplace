p:manifest-cgap-cloud a p:CrateManifest ;
    p:crateName "cgap-cloud" ;
    p:crateDescription "Cloud ontology O-ABI pack for the cgap sovereign columnar substrate: build-time-emitted binary ontology pack, no_std const/types facade." ;
    p:cratePublish true ;
    p:crateVersion "26.11.2" .

#################################################################
# 9. CAPABILITIES (p3-pack lane, v26.11.2 starDF)
#
# One p:Capability individual per deductive kernel admitted into the pack
# surface. Each is grounded to the REAL on-disk kernel (p:capModule must pass
# gate 160's ^crates/...:[0-9]+(-[0-9]+)?$ regex) and names its flip court and
# reduction law. Individuals are admitted only when the kernel is verified
# on disk this session; the capId is the campaign capability name.
#################################################################

p:Capability a rdfs:Class ;
    rdfs:label "Deductive Kernel Capability" ;
    rdfs:comment "A kernel capability admitted into the cgap-pack surface with code grounding, reduction law, and flip court." .

p:capId       a rdf:Property ; rdfs:domain p:Capability ; rdfs:range xsd:string .
p:capModule   a rdf:Property ; rdfs:domain p:Capability ; rdfs:range xsd:string ;
    rdfs:comment "Real on-disk kernel cite (crates/...:line[-line]); gate 160 regex-checked." .
p:capReduction a rdf:Property ; rdfs:domain p:Capability ; rdfs:range xsd:string ;
    rdfs:comment "Reduction law: what the kernel reduces and to what." .
p:capCourt    a rdf:Property ; rdfs:domain p:Capability ; rdfs:range xsd:string ;
    rdfs:comment "Flip court slot (receipt stem in docs/jira/v26.11.2/waves/)." .

# Cites verified on disk 2026-11-02 (p3-pack lane); reduction/court slots cite
# the landed receipts and court files witnessed this session.
p:cap-bgp-equi-join a p:Capability ;
    p:capId "bgp_equi_join" ;
    p:capModule "crates/cgap-bn3/src/unify.rs:786" ;
    p:capReduction "k-hop BGP chain join reduced to mask-AND composition over SoA columns (emit_join_masks)" ;
    p:capCourt "crates/cgap-bn3/tests/bgp_hop_courts.rs (p1-bgp)" .

p:cap-transitive-closure a p:Capability ;
    p:capId "transitive_closure" ;
    p:capModule "crates/cgap-storage/src/closure.rs:94" ;
    p:capReduction "graph transitive closure reduced to semi-naive delta iteration over packed-hash seen-set" ;
    p:capCourt "waves/p1-closure-closure.md court1_oracle_set_equality" .

p:cap-shacl-mask-eval a p:Capability ;
    p:capId "shacl_mask_eval" ;
    p:capModule "crates/cgap-bont/src/shacl_mask.rs:128" ;
    p:capReduction "SHACL shape evaluation reduced to bitmask mask-plan over SlotId columns (vs brute_force oracle)" ;
    p:capCourt "waves/p1-shacl-columnar-mask-kernels.md M1+M2 sandbox mutation flips" .

p:cap-dred-antijoin a p:Capability ;
    p:capId "dred_antijoin" ;
    p:capModule "crates/cgap-storage/src/dred.rs:116" ;
    p:capReduction "retraction antijoin reduced to SWAR keep-mask AND-NOT over derived-dep bitplanes" ;
    p:capCourt "waves/p1-dred-retraction-antijoin.md court_retraction_matches_oracle" .

p:cap-state-lineage a p:Capability ;
    p:capId "state_lineage" ;
    p:capModule "crates/cgap-git/src/dag.rs:1048" ;
    p:capReduction "state lineage reduced to BLAKE3 merkle-root chain proof over DAG commit blocks" ;
    p:capCourt "waves/p1-lineage-workflow.md tamper courts" .

p:cap-radix-semijoin a p:Capability ;
    p:capId "radix_semijoin" ;
    p:capModule "crates/cgap-bn3/src/unify.rs:690-750" ;
    p:capReduction "bound-key semi-join reduced to radix-bucketed probe with caller-leased scratch (JoinProbeScratch)" ;
    p:capCourt "waves/w2-12-l3-court.md M-L3-1" .

#################################################################
# 10. ARROW IMPORT PRIMITIVES (GA4 lane, v26.11.3)
#
# The C Data Interface import surface: typed entrypoints replacing the legacy
# admit_frame entrypoint (C-ABI survey gap #1), the array kinds they admit,
# and the branchless validity-bit-test law. Deep array mechanics (SIMD
# turnstiles, SHACL bitmask evaluation) are cgap hand-law; the graph admits
# only the signatures, format-string validators, alignment scaffolds, and
# the bit-test law — the generated module emits typed seams at those points.
#################################################################

p:ImportFn a rdfs:Class ;
    rdfs:label "C-ABI Import Function" ;
    rdfs:comment "A typed C Data Interface import entrypoint projected as a no_std Rust function." .

p:fnName        a rdf:Property ; rdfs:domain p:ImportFn ; rdfs:range xsd:string .
p:fnSignature   a rdf:Property ; rdfs:domain p:ImportFn ; rdfs:range xsd:string ;
    rdfs:comment "Rust signature text as emitted (unsafe fn, raw pointers)." .
p:fnErrorMapping a rdf:Property ; rdfs:domain p:ImportFn ; rdfs:range xsd:string ;
    rdfs:comment "ForeignError variants the fn maps to i32 status codes (comma-separated)." .
p:fnReplaces    a rdf:Property ; rdfs:domain p:ImportFn ; rdfs:range xsd:string ;
    rdfs:comment "Legacy entrypoint this fn replaces (e.g. admit_frame)." .

p:ArrayKind a rdfs:Class ;
    rdfs:label "Importable Array Kind" ;
    rdfs:comment "An array kind the import surface admits, with its Arrow format code and buffer layout." .

p:kindLabel       a rdf:Property ; rdfs:domain p:ArrayKind ; rdfs:range xsd:string .
p:kindSlotWidths  a rdf:Property ; rdfs:domain p:ArrayKind ; rdfs:range xsd:string ;
    rdfs:comment "Buffer-slot bit widths in slot order: 'index:bits' pairs, space-separated." .
p:kindAlignment   a rdf:Property ; rdfs:domain p:ArrayKind ; rdfs:range xsd:integer ;
    rdfs:comment "Required buffer alignment in bytes (Arrow: 64)." .

p:BitTestLaw a rdfs:Class ;
    rdfs:label "Branchless Bit-Test Law" ;
    rdfs:comment "The validity bitmap bit-test law, expressed branch-free." .

p:lawExpression a rdf:Property ; rdfs:domain p:BitTestLaw ; rdfs:range xsd:string .

# --- Import entrypoints (C-ABI survey gap #1: admit_frame replacement) ---

p:imp-cgap-import-schema a p:ImportFn ;
    p:fnName "cgap_import_schema" ;
    p:fnSignature "pub unsafe fn cgap_import_schema(schema: *const ArrowSchema) -> i32" ;
    p:fnErrorMapping "InvalidFormat" ;
    p:fnReplaces "admit_frame (schema half)" .

p:imp-cgap-import-array a p:ImportFn ;
    p:fnName "cgap_import_array" ;
    p:fnSignature "pub unsafe fn cgap_import_array(array: *mut ArrowArray, schema: *const ArrowSchema) -> i32" ;
    p:fnErrorMapping "FormatMismatch,InvalidFormat,MissingBuffer,BufferTooShort,Misaligned,NegativeLength" ;
    p:fnReplaces "admit_frame (array half)" .

# --- Array kinds admitted by the import surface ---

p:kind-fixed-size-binary-32 a p:ArrayKind ;
    p:kindLabel "FixedSizeBinaryArray32" ;
    av:formatCode "w:32" ;
    av:bufferCount 2 ;
    p:kindSlotWidths "0:1 1:256" ;
    p:kindAlignment 64 .

p:kind-dictionary-u32-utf8 a p:ArrayKind ;
    p:kindLabel "DictionaryUInt32Utf8" ;
    av:formatCode "i" ;
    av:bufferCount 3 ;
    p:kindSlotWidths "0:1 1:32 2:8" ;
    p:kindAlignment 64 .

p:kind-large-string a p:ArrayKind ;
    p:kindLabel "LargeStringArray" ;
    av:formatCode "U" ;
    av:bufferCount 3 ;
    p:kindSlotWidths "0:1 1:64 2:8" ;
    p:kindAlignment 64 .

p:kind-dense-union a p:ArrayKind ;
    p:kindLabel "DenseUnionArray" ;
    av:formatCode "tu" ;
    av:bufferCount 2 ;
    p:kindSlotWidths "0:8 1:32" ;
    p:kindAlignment 64 .

# --- Branchless validity bit-test law ---

p:bit-test-bitmap a p:BitTestLaw ;
    p:lawExpression "bitmap[i >> 3] & (1 << (i & 7))" .

# --- C-ABI status-code family (TX-7/CG-1: variant -> distinct i32 code) ---
# Ground truth: crates/cgap-arrow/src/foreign.rs ForeignError +
# generated_arrow_primitives.rs status mod. One StatusConstant per family
# member; the fnErrorMapping strings on ImportFn individuals must resolve
# into this closed vocabulary (gate 180_status_closure.rq).

p:StatusConstant a rdfs:Class ;
    rdfs:label "C-ABI Status Constant" ;
    rdfs:comment "One ForeignError family member projected to its distinct i32 status code." .

p:statusVariant a rdf:Property ; rdfs:domain p:StatusConstant ; rdfs:range xsd:string ;
    rdfs:comment "The ForeignError variant name." .
p:statusCode a rdf:Property ; rdfs:domain p:StatusConstant ; rdfs:range xsd:integer ;
    rdfs:comment "The distinct i32 C-ABI status code." .

p:status-ok a p:StatusConstant ; p:statusVariant "OK" ; p:statusCode 0 .
p:status-invalid-format a p:StatusConstant ; p:statusVariant "InvalidFormat" ; p:statusCode 1 .
p:status-format-mismatch a p:StatusConstant ; p:statusVariant "FormatMismatch" ; p:statusCode 2 .
p:status-missing-buffer a p:StatusConstant ; p:statusVariant "MissingBuffer" ; p:statusCode 3 .
p:status-buffer-too-short a p:StatusConstant ; p:statusVariant "BufferTooShort" ; p:statusCode 4 .
p:status-misaligned a p:StatusConstant ; p:statusVariant "Misaligned" ; p:statusCode 5 .
p:status-negative-length a p:StatusConstant ; p:statusVariant "NegativeLength" ; p:statusCode 6 .
