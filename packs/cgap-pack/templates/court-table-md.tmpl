---
to: "generated/court-table.md"
force: true
sparql:
  results: |
    PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
    SELECT ?id ?subject ?mutation ?kill ?receipt WHERE {
      ?court a p:Court ;
             p:courtId ?id ;
             p:courtSubject ?subject ;
             p:courtMutation ?mutation ;
             p:courtKillExit ?kill ;
             p:courtReceipt ?receipt .
    } ORDER BY ?id
