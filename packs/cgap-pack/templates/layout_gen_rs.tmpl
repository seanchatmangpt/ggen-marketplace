force: true
---
to: "crates/cgap-arrow/src/generated_layout.rs"
sparql:
  results: |
    PREFIX av: <https://cgap.chatmangpt.com/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?code ?prefix ?bufs ?slots WHERE {
      {
        SELECT ?l (GROUP_CONCAT(CONCAT(STR(?idx), ":", STR(?w)); separator=" ") AS ?slots)
        WHERE {
          ?l av:hasBufferSlot ?s .
          ?s av:slotIndex ?idx ;
             av:elementBitWidth ?w .
        }
        GROUP BY ?l
      }
      ?l rdf:type/rdfs:subClassOf* av:PhysicalLayout ;
         rdfs:label ?label .
      OPTIONAL { ?l av:formatCode ?code }
      OPTIONAL { ?l av:formatPrefix ?prefix }
      OPTIONAL { ?l av:bufferCount ?bufs }
    } ORDER BY ?label
---

//! Generated by ggen from cgap-pack ontology.ttl — do not edit.
//! Regenerate via `ggen sync run`.
//!
//! One row per modeled Arrow layout: format string (exact code or
//! parameterized prefix), buffer count, and buffer-slot bit widths in slot
//! order ("index:bits" pairs, space-separated). This is the layout dispatch
//! ground truth for cgap-core buffer planning.

#![allow(dead_code)]

/// Physical layout descriptor projected from the ontology.
pub struct LayoutSpec {
    /// Ontology label (e.g. "Int32").
    pub label: &'static str,
    /// Exact Arrow format code, if the type is not parameterized.
    pub code: Option<&'static str>,
    /// Format prefix (e.g. "d:") for parameterized types.
    pub prefix: Option<&'static str>,
    /// Number of top-level buffers.
    pub buffer_count: usize,
    /// Per-slot bit widths in slot-index order (validity bitmap = 1 bit).
    pub slot_bit_widths: &'static [(u8, u16)],
}

/// Format strings: matching a code takes precedence over a prefix.
pub const LAYOUT_SPECS: &[LayoutSpec] = &[
{% for row in results %}
    LayoutSpec {
        label: "{{ row.label }}",
        code: {% if row.code %}Some("{{ row.code }}"){% else %}None{% endif %},
        prefix: {% if row.prefix %}Some("{{ row.prefix }}"){% else %}None{% endif %},
        buffer_count: {{ row.bufs | default(value=0) }},
        slot_bit_widths: &[{% for pair in row.slots | split(pat=" ") %}{% if pair != "" %}({{ pair | split(pat=":") | first }}, {{ pair | split(pat=":") | last }}),{% endif %}{% endfor %}],
    },
{% endfor %}
];
