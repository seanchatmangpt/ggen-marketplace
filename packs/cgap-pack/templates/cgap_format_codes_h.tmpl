---
to: "include/cgap_format_codes.h"
force: true
sparql:
  results: |
    PREFIX av: <https://cgap.chatmangpt.com/>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?label ?code ?prefix WHERE {
      ?l rdf:type/rdfs:subClassOf* av:PhysicalLayout ;
         rdfs:label ?label .
      OPTIONAL { ?l av:formatCode ?code }
      OPTIONAL { ?l av:formatPrefix ?prefix }
    } ORDER BY ?label
---

