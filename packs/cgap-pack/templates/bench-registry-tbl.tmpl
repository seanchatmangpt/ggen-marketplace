---
to: "generated/bench-registry.txt"
force: true
sparql:
  results: |
    PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
    SELECT ?target ?file ?consts ?lever WHERE {
      ?b a p:Bench ;
         p:benchTarget ?target ;
         p:benchFile ?file ;
         p:benchConsts ?consts .
      OPTIONAL {
        ?b p:benchLever ?lv .
        ?lv p:leverId ?lever .
      }
    } ORDER BY ?target
---
target | file | consts | lever
{% for row in results %}
{{ row.target }} | {{ row.file }} | {{ row.consts }} | {{ row.lever }}{% if not loop.last %}
{% endif %}
{%- endfor %}
