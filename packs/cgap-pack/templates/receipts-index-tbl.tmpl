---
force: true
to: "generated/receipts-index.txt"
sparql:
  results: |
    PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
    SELECT ?file ?sha12 ?standing ?lane WHERE {
      ?r a p:Receipt ;
         p:receiptFile ?file ;
         p:receiptSha256 ?sha ;
         p:receiptStanding ?standing ;
         p:receiptLane ?lane .
      BIND(SUBSTR(?sha, 1, 12) AS ?sha12)
    } ORDER BY ?file
---
receipt | sha256[:12] | standing | lane
{% for row in results %}{{ row.file }} | {{ row.sha12 }} | {{ row.standing }} | {{ row.lane }}
{% endfor %}