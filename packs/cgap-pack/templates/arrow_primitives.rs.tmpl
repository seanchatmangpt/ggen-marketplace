---
to: "crates/cgap-arrow/src/generated_arrow_primitives.rs"
force: true
sparql:
  results: |
    PREFIX av: <https://cgap.chatmangpt.com/>
    PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    SELECT ?name ?sig ?errors WHERE {
      ?fn rdf:type p:ImportFn ;
          p:fnName ?name ;
          p:fnSignature ?sig ;
          p:fnErrorMapping ?errors .
    } ORDER BY ?name
  kinds: |
    PREFIX av: <https://cgap.chatmangpt.com/>
    PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    SELECT ?label ?format ?bufs ?widths ?align WHERE {
      ?k rdf:type p:ArrayKind ;
         p:kindLabel ?label ;
         av:formatCode ?format ;
         av:bufferCount ?bufs ;
         p:kindSlotWidths ?widths ;
         p:kindAlignment ?align .
    } ORDER BY ?label
  laws: |
    PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
    PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    SELECT ?expr WHERE {
      ?law rdf:type p:BitTestLaw ;
           p:lawExpression ?expr .
    } ORDER BY ?expr
---

