# PASS witness: distinct codes and a fully-mapped import fn over the closed
# vocabulary (composed against the pack ontology's StatusConstant family).
@prefix p: <https://seanchatmangpt.github.io/packs/cgap-pack#> .

p:witness-fn-ok a p:ImportFn ;
    p:fnName "cgap_witness_ok" ;
    p:fnSignature "pub unsafe fn cgap_witness_ok() -> i32" ;
    p:fnErrorMapping "MissingBuffer,BufferTooShort" .
