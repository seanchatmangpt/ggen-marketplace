# PASS witness: p:Bench with a regex-valid p:benchFile and a lever link.
@prefix p: <https://seanchatmangpt.github.io/packs/cgap-pack#> .
@prefix ex: <https://example.org/cgap-pack/pass/> .

ex:bench a p:Bench ;
    p:benchTarget "chains-seal" ;
    p:benchFile "crates/bench/benches/chains-seal.rs" ;
    p:benchLever p:L5-seal-fused-asc450 .
