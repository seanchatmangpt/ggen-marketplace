# PASS witness: ArrayKind with positive bufferCount and power-of-2 alignment,
# carrying the full arrow_layout fact set (formatCode/bufferCount/slotWidths/
# alignment) so only gate 170's law is under test.
@prefix av: <https://cgap.chatmangpt.com/> .
@prefix p: <https://seanchatmangpt.github.io/packs/cgap-pack#> .

av:witness_kind_ok a p:ArrayKind ;
    p:kindLabel "WitnessKindOk" ;
    av:formatCode "w:32" ;
    av:bufferCount 2 ;
    p:kindSlotWidths "0:1 1:256" ;
    p:kindAlignment 64 .
