# PASS witness: import primitive carrying signature + error mapping, ArrayKind
# with the full arrow_layout fact set (formatCode/bufferCount/slotWidths/
# alignment), and a BitTestLaw with its expression — every arrow_layout.rq
# branch is satisfied, so the gate must return 0 rows.
@prefix av: <https://cgap.chatmangpt.com/> .
@prefix p: <https://seanchatmangpt.github.io/packs/cgap-pack#> .

av:witness_import_ok a p:ImportFn ;
    p:fnSignature "fn witness_load(buf: &Buffer) -> Result<Array, CgapError>" ;
    p:fnErrorMapping "E_BUFFER_OOB => CgapError::OutOfBounds" ;
    p:kindLabel "WitnessImportOk" .

av:witness_kind_ok a p:ArrayKind ;
    p:kindLabel "WitnessKindArrowOk" ;
    av:formatCode "w:32" ;
    av:bufferCount 2 ;
    p:kindSlotWidths "0:1 1:256" ;
    p:kindAlignment 64 .

av:witness_bitlaw_ok a p:BitTestLaw ;
    p:lawLabel "WitnessBitLawOk" ;
    p:lawExpression "(flags >> 3) & 0x1 == 1" .
