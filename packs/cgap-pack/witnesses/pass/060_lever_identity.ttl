# PASS witness: lever carries leverId, leverTarget, and groundedIn.
@prefix p: <https://seanchatmangpt.github.io/packs/cgap-pack#> .
@prefix ex: <https://example.org/cgap-pack/pass/> .

ex:lever a p:ParetoLever ;
    p:leverId "L1-ingress-digest-escalation" ;
    p:leverTarget "<15 ns/frame" ;
    p:groundedIn "crates/cgap-core/src/frame.rs:86-87" ;
    p:leverGate p:gate-060 .
