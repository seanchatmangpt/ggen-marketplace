# PASS witness: targeted lever carries measuredNs (pair complete).
@prefix p: <https://seanchatmangpt.github.io/packs/cgap-pack#> .
@prefix ex: <https://example.org/cgap-pack/pass/> .

ex:lever a p:ParetoLever ;
    p:leverTarget "<10 ms @1M rows" ;
    p:measuredNs 41540000.0 ;
    p:leverGate p:gate-080 .
