# FAIL witness: trips all three closure branches — duplicate statusCode,
# out-of-vocabulary fnErrorMapping token, unmapped error variant.
@prefix p: <https://seanchatmangpt.github.io/packs/cgap-pack#> .

p:witness-status-dup a p:StatusConstant ;
    p:statusVariant "WitnessDup" ;
    p:statusCode 1 .  # duplicates status-invalid-format's code

p:witness-fn-bad a p:ImportFn ;
    p:fnName "cgap_witness_bad" ;
    p:fnSignature "pub unsafe fn cgap_witness_bad() -> i32" ;
    p:fnErrorMapping "NotARealVariant" .

p:witness-status-orphan a p:StatusConstant ;
    p:statusVariant "WitnessOrphan" ;
    p:statusCode 9 .
