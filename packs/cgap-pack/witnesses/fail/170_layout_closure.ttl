# FAIL witness: zero bufferCount, non-pow2 alignment, and a kind missing both
# facts — the gate must return >= 1 row for each.
@prefix av: <https://cgap.chatmangpt.com/> .
@prefix p: <https://seanchatmangpt.github.io/packs/cgap-pack#> .

av:witness_kind_zero a p:ArrayKind ;
    p:kindLabel "WitnessKindZero" ;
    av:bufferCount 0 ;
    p:kindAlignment 64 .

av:witness_kind_48 a p:ArrayKind ;
    p:kindLabel "WitnessKind48" ;
    av:bufferCount 2 ;
    p:kindAlignment 48 .

av:witness_kind_missing a p:ArrayKind ;
    p:kindLabel "WitnessKindMissing" .
