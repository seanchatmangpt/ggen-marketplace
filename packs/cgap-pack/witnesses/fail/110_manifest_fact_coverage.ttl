@prefix p: <https://seanchatmangpt.github.io/packs/cgap-pack#> .
@prefix ex: <https://example.org/cgap-pack/> .

# FAIL witness: p:ws names cgap-gpu, but its p:CrateManifest individual
# lacks p:crateVersion - gate 110 must return cgap-gpu as a row.

p:ws p:witnessCrate "cgap-gpu" .

p:manifest-cgap-gpu a p:CrateManifest ;
    p:crateName "cgap-gpu" ;
    p:crateDescription "GPU execution membrane for the cgap sovereign substrate: Metal Unified Memory zero-copy buffer bridging." ;
    p:cratePublish false .
