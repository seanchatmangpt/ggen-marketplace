# MESSAGE: capModule citation that is not a repo-relative path:line[-line].
# p:capModule must match ^crates/[^ ]+:[0-9]+(-[0-9]+)?$ . A row is a refusal.
# Anti-vacuity: rewrite capModule to an absolute path — gate must fire.
PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
SELECT ?cap ?m WHERE {
  ?cap a p:Capability ;
       p:capModule ?m .
  FILTER(!REGEX(?m, "^crates/[^ ]+:[0-9]+(-[0-9]+)?$"))
}
ORDER BY ?cap ?m
