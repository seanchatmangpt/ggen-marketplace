# MESSAGE: lever asserts mutated-true without a named mutation.
# Every mutated=true p:ParetoLever must name its anti-vacuity mutation.
# A row is a refusal.
# Anti-vacuity: drop p:mutationName from a mutated lever — gate must fire.
PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
SELECT ?lever WHERE {
  ?lever a p:ParetoLever ;
         p:mutated true .
  FILTER NOT EXISTS { ?lever p:mutationName ?m }
}
ORDER BY ?lever
