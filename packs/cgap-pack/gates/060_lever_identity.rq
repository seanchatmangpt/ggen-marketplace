# MESSAGE: Pareto lever missing leverId, leverTarget, or groundedIn.
# Every p:ParetoLever must carry an exact leverId, a target bound, and a
# code grounding citation; missing ANY one is a refusal. A row = refusal.
# Anti-vacuity: drop p:leverId from a lever — gate must fire (witnesses/fail).
PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
SELECT ?lever ?missing WHERE {
  ?lever a p:ParetoLever .
  {
    FILTER NOT EXISTS { ?lever p:leverId ?id }
    BIND("leverId" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?lever p:leverTarget ?t }
    BIND("leverTarget" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?lever p:groundedIn ?g }
    BIND("groundedIn" AS ?missing)
  }
}
ORDER BY ?lever ?missing
