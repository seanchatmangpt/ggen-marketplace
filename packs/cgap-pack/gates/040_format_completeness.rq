# MESSAGE: layout missing its format string.
# Every av:PhysicalLayout must carry av:formatCode or av:formatPrefix, EXCEPT
# av:Dictionary (whose format string is its index type's native code, so it
# carries none of its own). A row = refusal.
# Anti-vacuity: strip formatCode from any layout — the gate must fire.
PREFIX av: <https://cgap.chatmangpt.com/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?layout WHERE {
  ?layout rdf:type/rdfs:subClassOf* av:PhysicalLayout .
  FILTER(?layout != av:Dictionary)
  FILTER NOT EXISTS { ?layout av:formatCode ?code }
  FILTER NOT EXISTS { ?layout av:formatPrefix ?prefix }
}
ORDER BY ?layout
