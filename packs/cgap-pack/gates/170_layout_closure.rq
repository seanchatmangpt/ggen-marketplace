# MESSAGE: ArrayKind layout spec with non-positive bufferCount or non-power-of-2 alignment.
# Every p:ArrayKind individual (the ArrayKindSpec surface the import module
# renders) must carry av:bufferCount > 0 and p:kindAlignment that is a power
# of 2 (closed enumeration 1..65536; this engine has no bitwise operators);
# a missing bufferCount/alignment fact is also a violation — the Arrow
# buffer-geometry law.
# A row = refusal. Anti-vacuity: zero a kind's bufferCount or set its
# alignment to 48 — the gate must fire.
PREFIX av: <https://cgap.chatmangpt.com/>
PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
SELECT ?kind WHERE {
  ?kind a p:ArrayKind ; p:kindLabel ?label .
  OPTIONAL { ?kind av:bufferCount ?b }
  OPTIONAL { ?kind p:kindAlignment ?a }
  FILTER(
    !BOUND(?b) ||
    !BOUND(?a) ||
    ?b <= 0 ||
    ?a <= 0 ||
    (?a NOT IN (1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536))
  )
} ORDER BY ?kind
