# MESSAGE: lever declares a target with neither a measurement nor a typed skip.
# Every p:ParetoLever with a leverTarget must carry either measuredNs or a
# typed p:skipReason. A row is a refusal.
# Anti-vacuity: drop p:measuredNs (no skipReason) from a measured lever —
# gate must fire.
PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
SELECT ?lever WHERE {
  ?lever a p:ParetoLever ;
         p:leverTarget ?t .
  FILTER NOT EXISTS { ?lever p:measuredNs ?m }
  FILTER NOT EXISTS { ?lever p:skipReason ?s }
}
ORDER BY ?lever
