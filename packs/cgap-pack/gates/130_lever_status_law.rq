# MESSAGE: lever claims a mutation (p:mutated true) without a landed/blocked status.
# A mutated lever's p:leverStatus must match ^LANDED- or ^BLOCKED- — a claimed
# mutation still carrying [TARGET-v26.11.2] is an unreceipted claim and refuses.
# A row is a refusal.
# Anti-vacuity: set p:leverStatus "[TARGET-v26.11.2]" on a mutated lever in a
# sandbox copy of ontology.ttl — gate must fire.
PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
SELECT ?lever ?status WHERE {
  ?lever a p:ParetoLever ;
         p:mutated true ;
         p:leverStatus ?status .
  FILTER(!REGEX(?status, "^(LANDED-|BLOCKED-)"))
}
ORDER BY ?lever
