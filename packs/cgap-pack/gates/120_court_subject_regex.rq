# MESSAGE: courtSubject that is not a gate-lawful subject citation.
# Must match ^crates/[^ ]+:[0-9]+(-[0-9]+)?$ or ^scripts/ or ^G[0-9]- .
# A row is a refusal. Anti-vacuity: add a p:Court with an invented
# subject (e.g. "bench kernels") — gate must fire.
PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
SELECT ?court ?s WHERE {
  ?court a p:Court ;
         p:courtSubject ?s .
  FILTER(!REGEX(?s, "^crates/[^ ]+:[0-9]+(-[0-9]+)?$") &&
         !REGEX(?s, "^scripts/") &&
         !REGEX(?s, "^G[0-9]-"))
}
ORDER BY ?court ?s
