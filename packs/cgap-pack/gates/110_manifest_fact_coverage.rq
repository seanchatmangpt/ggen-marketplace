# MESSAGE: workspace crate without a fully-attributed p:CrateManifest individual.
# Every crate named in the known-workspace witness vocabulary must have a
# p:CrateManifest carrying p:crateName AND p:crateVersion. A row is a refusal.
# Anti-vacuity: remove p:crateVersion from any manifest individual (or drop an
# individual entirely) — the gate must return that crate as a row.
PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
SELECT ?name WHERE {
  ?known p:witnessCrate ?name .
  FILTER NOT EXISTS {
    ?manifest a p:CrateManifest ;
              p:crateName ?name ;
              p:crateVersion ?version .
  }
}
ORDER BY ?name
