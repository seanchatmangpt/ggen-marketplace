# MESSAGE: groundedIn citation that is not a repo-relative path:line[-line].
# groundedIn must match ^crates/[^ ]+:[0-9]+(-[0-9]+)?$ . A row is a refusal.
# Anti-vacuity: rewrite groundedIn to an absolute path — gate must fire.
PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
SELECT ?lever ?g WHERE {
  ?lever a p:ParetoLever ;
         p:groundedIn ?g .
  FILTER(!REGEX(?g, "^crates/[^ ]+:[0-9]+(-[0-9]+)?$"))
}
ORDER BY ?lever ?g
