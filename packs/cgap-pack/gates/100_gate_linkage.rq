# MESSAGE: lever with no p:leverGate edge into the court set.
# Every p:ParetoLever must be linked to at least one p:LeverGate individual.
# A row is a refusal.
# Anti-vacuity: drop the p:leverGate triple from a lever — gate must fire.
PREFIX p: <https://seanchatmangpt.github.io/packs/cgap-pack#>
SELECT ?lever WHERE {
  ?lever a p:ParetoLever .
  FILTER NOT EXISTS { ?lever p:leverGate ?gate }
}
ORDER BY ?lever
