@prefix ddui: <https://chatmangpt.com/ontology/dd-ui#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ddui:Grammar a skos:Concept ; skos:prefLabel "Deterministic Dynamic UI grammar" .
ddui:VocabularyItem a skos:Concept ; skos:prefLabel "DDUI vocabulary item" .
ddui:Avatar a skos:Concept ; skos:prefLabel "Avatar" .
ddui:Context a skos:Concept ; skos:prefLabel "Context" .
ddui:Domain a skos:Concept ; skos:prefLabel "Domain lens" .
ddui:Component a skos:Concept ; skos:prefLabel "Bounded UI component" .
ddui:Consequence a skos:Concept ; skos:prefLabel "Authority consequence class" .
ddui:kind a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ddui:order a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ddui:runtimeAiRenderAuthority a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ddui:renderActuationAuthority a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ddui:irreversibleUiSelections a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .
ddui:doBoundary a <http://www.w3.org/1999/02/22-rdf-syntax-ns#Property> .

ddui:grammar-v2 a ddui:Grammar ;
  dcterms:identifier "dd-ui/2" ;
  skos:prefLabel "DDUI grammar v2" ;
  ddui:runtimeAiRenderAuthority false ;
  ddui:renderActuationAuthority false ;
  ddui:irreversibleUiSelections 0 ;
  ddui:doBoundary "BRCE" .

# Avatars
ddui:avatar-ceo a ddui:VocabularyItem, ddui:Avatar ; ddui:kind "avatar" ; ddui:order 10 ; dcterms:identifier "CEO" ; skos:prefLabel "Chief Executive Officer" .
ddui:avatar-cfo a ddui:VocabularyItem, ddui:Avatar ; ddui:kind "avatar" ; ddui:order 20 ; dcterms:identifier "CFO" ; skos:prefLabel "Chief Financial Officer" .
ddui:avatar-cto a ddui:VocabularyItem, ddui:Avatar ; ddui:kind "avatar" ; ddui:order 30 ; dcterms:identifier "CTO" ; skos:prefLabel "Chief Technology Officer" .
ddui:avatar-engineer a ddui:VocabularyItem, ddui:Avatar ; ddui:kind "avatar" ; ddui:order 40 ; dcterms:identifier "ENGINEER" ; skos:prefLabel "Engineer" .
ddui:avatar-auditor a ddui:VocabularyItem, ddui:Avatar ; ddui:kind "avatar" ; ddui:order 50 ; dcterms:identifier "AUDITOR" ; skos:prefLabel "Auditor" .

# Contexts
ddui:context-normal a ddui:VocabularyItem, ddui:Context ; ddui:kind "context" ; ddui:order 110 ; dcterms:identifier "normal" ; skos:prefLabel "Operating" .
ddui:context-incident a ddui:VocabularyItem, ddui:Context ; ddui:kind "context" ; ddui:order 120 ; dcterms:identifier "incident" ; skos:prefLabel "Incident" .
ddui:context-board a ddui:VocabularyItem, ddui:Context ; ddui:kind "context" ; ddui:order 130 ; dcterms:identifier "board" ; skos:prefLabel "Board" .
ddui:context-audit a ddui:VocabularyItem, ddui:Context ; ddui:kind "context" ; ddui:order 140 ; dcterms:identifier "audit" ; skos:prefLabel "Audit" .

# Domain lenses
ddui:domain-ggen a ddui:VocabularyItem, ddui:Domain ; ddui:kind "domain" ; ddui:order 210 ; dcterms:identifier "GGEN" ; skos:prefLabel "Deterministic manufacture" .
ddui:domain-iaas a ddui:VocabularyItem, ddui:Domain ; ddui:kind "domain" ; ddui:order 220 ; dcterms:identifier "IAAS" ; skos:prefLabel "Infrastructure" .
ddui:domain-paas a ddui:VocabularyItem, ddui:Domain ; ddui:kind "domain" ; ddui:order 230 ; dcterms:identifier "PAAS" ; skos:prefLabel "Platform" .
ddui:domain-saas a ddui:VocabularyItem, ddui:Domain ; ddui:kind "domain" ; ddui:order 240 ; dcterms:identifier "SAAS" ; skos:prefLabel "Software product" .
ddui:domain-process a ddui:VocabularyItem, ddui:Domain ; ddui:kind "domain" ; ddui:order 250 ; dcterms:identifier "PROCESS" ; skos:prefLabel "Process intelligence" .
ddui:domain-governance a ddui:VocabularyItem, ddui:Domain ; ddui:kind "domain" ; ddui:order 260 ; dcterms:identifier "GOVERNANCE" ; skos:prefLabel "Governance and authority" .

# Components
ddui:c-exec a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 310 ; dcterms:identifier "ExecutiveSummary" ; skos:prefLabel "Executive summary" .
ddui:c-fin a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 320 ; dcterms:identifier "FinancialSummary" ; skos:prefLabel "Financial summary" .
ddui:c-tech a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 330 ; dcterms:identifier "TechnologyStanding" ; skos:prefLabel "Technology standing" .
ddui:c-work a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 340 ; dcterms:identifier "WorkQueue" ; skos:prefLabel "Work queue" .
ddui:c-kpi a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 350 ; dcterms:identifier "KPI" ; skos:prefLabel "KPI" .
ddui:c-variance a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 360 ; dcterms:identifier "Variance" ; skos:prefLabel "Variance" .
ddui:c-risk a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 370 ; dcterms:identifier "Risk" ; skos:prefLabel "Risk" .
ddui:c-decision a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 380 ; dcterms:identifier "Decision" ; skos:prefLabel "Decision" .
ddui:c-opportunity a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 390 ; dcterms:identifier "Opportunity" ; skos:prefLabel "Opportunity" .
ddui:c-forecast a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 400 ; dcterms:identifier "Forecast" ; skos:prefLabel "Forecast" .
ddui:c-standing a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 410 ; dcterms:identifier "Standing" ; skos:prefLabel "Standing" .
ddui:c-dependency a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 420 ; dcterms:identifier "Dependency" ; skos:prefLabel "Dependency" .
ddui:c-evidence a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 430 ; dcterms:identifier "Evidence" ; skos:prefLabel "Evidence" .
ddui:c-receipt a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 440 ; dcterms:identifier "Receipt" ; skos:prefLabel "Receipt" .
ddui:c-badge a ddui:VocabularyItem, ddui:Component ; ddui:kind "component" ; ddui:order 450 ; dcterms:identifier "ClaimBadge" ; skos:prefLabel "Claim badge" .

# Consequence classes
ddui:q-select a ddui:VocabularyItem, ddui:Consequence ; ddui:kind "consequence" ; ddui:order 510 ; dcterms:identifier "SELECT" ; skos:prefLabel "Selection" .
ddui:q-construct a ddui:VocabularyItem, ddui:Consequence ; ddui:kind "consequence" ; ddui:order 520 ; dcterms:identifier "CONSTRUCT" ; skos:prefLabel "Construction" .
ddui:q-do a ddui:VocabularyItem, ddui:Consequence ; ddui:kind "consequence" ; ddui:order 530 ; dcterms:identifier "DO" ; skos:prefLabel "Consequential actuation" .
