@prefix lex: <https://seanchatmangpt.github.io/packs/industry-legal-ediscovery#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# PASS witness for gate 030: the custodian's walls do not touch the
# evidence's matter.
lex:matter-p3 a lex:Matter ;
    rdfs:label "In re: Pass Fixture 3" .

lex:matter-other a lex:Matter ;
    rdfs:label "In re: Unrelated Matter" .

lex:custodian-p3 a lex:Custodian ;
    lex:conflictedMatter lex:matter-other .

lex:doc-p3 a lex:EvidenceDocument ;
    lex:batesId "SMALT0000003" ;
    lex:hasCustodian lex:custodian-p3 ;
    lex:collectedIn lex:matter-p3 .
