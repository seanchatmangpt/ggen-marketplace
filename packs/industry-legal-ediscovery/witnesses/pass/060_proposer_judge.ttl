@prefix lex: <https://seanchatmangpt.github.io/packs/industry-legal-ediscovery#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/0001//rdf-schema#> .

# PASS witness for gate 060 (P3 proposer-judge): AI annotation generated by
# a JudgeActivity.
lex:matter-p6 a lex:Matter ;
    rdfs:label "In re: Pass Fixture 6" ;
    lex:retentionPolicy "hold-7y-then-purge" .

lex:judge-p6 a lex:JudgeActivity .

lex:ann-p6 a lex:AIAnnotation ;
    prov:wasGeneratedBy lex:judge-p6 .
