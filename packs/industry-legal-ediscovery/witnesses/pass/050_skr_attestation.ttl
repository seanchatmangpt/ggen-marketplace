@prefix lex: <https://seanchatmangpt.github.io/packs/industry-legal-ediscovery#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# PASS witness for gate 050 (P2 SKR): sealed record generated by an activity
# bound to a valid attestation measurement fingerprint.
lex:matter-p5 a lex:Matter ;
    rdfs:label "In re: Pass Fixture 5" ;
    lex:retentionPolicy "hold-7y-then-purge" .

lex:release-p5 a prov:Activity ;
    lex:attestationFingerprint "smq1:9f2c...a17b" .

lex:seal-p5 a lex:SealedRecord ;
    prov:wasGeneratedBy lex:release-p5 .
