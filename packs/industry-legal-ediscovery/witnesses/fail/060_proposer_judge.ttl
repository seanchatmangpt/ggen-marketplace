@prefix lex: <https://seanchatmangpt.github.io/packs/industry-legal-ediscovery#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# FAIL witness for gate 060 (P3 proposer-judge): AI annotation generated by a
# plain activity — unadjudicated AI proposal, the exact law.
lex:matter-f6 a lex:Matter ;
    rdfs:label "In re: Fail Fixture 6" ;
    lex:retentionPolicy "hold-7y-then-purge" .

lex:generator-f6 a prov:Activity .

lex:ann-f6 a lex:AIAnnotation ;
    prov:wasGeneratedBy lex:generator-f6 .
