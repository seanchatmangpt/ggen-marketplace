@prefix lex: <https://seanchatmangpt.github.io/packs/industry-legal-ediscovery#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# FAIL witness for gate 050 (P2 SKR): sealed record generated by an activity
# with NO attestation fingerprint — unattested release, the exact law.
lex:matter-f5 a lex:Matter ;
    rdfs:label "In re: Fail Fixture 5" ;
    lex:retentionPolicy "hold-7y-then-purge" .

lex:release-f5 a prov:Activity .

lex:seal-f5 a lex:SealedRecord ;
    prov:wasGeneratedBy lex:release-f5 .
