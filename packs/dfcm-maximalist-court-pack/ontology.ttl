@prefix dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
dmc:Candidate a rdfs:Class .
dmc:family a rdf:Property .
dmc:standing a rdf:Property .
dmc:assumption a rdf:Property .
dmc:dependency a rdf:Property .
dmc:ctqNovelty a rdf:Property .
dmc:ctqEvidence a rdf:Property .
dmc:rollbackCost a rdf:Property .
dmc:falsifier a rdf:Property .
dmc:deterministic a rdf:Property .
dmc:requiresReceipt a rdf:Property .
dmc:ExperimentStep a rdfs:Class .
dmc:sequenceId a rdf:Property .
dmc:stepIndex a rdf:Property .
dmc:subjectSha a rdf:Property .
dmc:semanticDigest a rdf:Property .
dmc:candidate a rdf:Property .
dmc:predictedGain a rdf:Property .
dmc:realizedGain a rdf:Property .
dmc:stepCost a rdf:Property .
dmc:stepLatencyMs a rdf:Property .
dmc:frontierBefore a rdf:Property .
dmc:frontierAfter a rdf:Property .
dmc:observedAlternative a rdf:Property .
dmc:currentGeneration a rdf:Property .
dmc:stratum a rdf:Property .
dmc:policyDecision a rdf:Property .
dmc:authority a rdf:Property .
dmc:actuationPerformed a rdf:Property .
dmc:receiptDigest a rdf:Property .
dmc:PolicyCalibrationObservation a rdfs:Class .
dmc:predictedStopProbability a rdf:Property .
dmc:realizedDecision a rdf:Property .
dmc:decisionLoss a rdf:Property .
dmc:deadlineMs a rdf:Property .
dmc:sequenceTerminal a rdf:Property .
dmc:policyGeneration a rdf:Property .
dmc:policyDigest a rdf:Property .
dmc:calibrationLabel a rdf:Property .
dmc:observedNetValue a rdf:Property .
dmc:counterfactualObserved a rdf:Property .
dmc:policySwitch a rdf:Property .
dmc:ExperimentRealization a rdfs:Class .
dmc:experimentId a rdf:Property .
dmc:predictedInformationGain a rdf:Property .
dmc:realizedInformationGain a rdf:Property .
dmc:experimentCost a rdf:Property .
dmc:latencyMs a rdf:Property .
dmc:observedAlternativeGain a rdf:Property .
dmc:falseUseful a rdf:Property .
dmc:SearchCandidate a dmc:Candidate ; dmc:family "search" ; dmc:standing "PARTIAL_ALIVE" ; dmc:deterministic true ; dmc:rollbackCost 1 ; dmc:ctqNovelty 6 ; dmc:ctqEvidence 5 ; dmc:requiresReceipt true ; dmc:assumption "bounded discrete action space" ; dmc:falsifier "no admissible path under bounded depth" .
dmc:BanditCandidate a dmc:Candidate ; dmc:family "bandit" ; dmc:standing "PARTIAL_ALIVE" ; dmc:deterministic false ; dmc:rollbackCost 1 ; dmc:ctqNovelty 8 ; dmc:ctqEvidence 4 ; dmc:requiresReceipt true ; dmc:assumption "bounded-drift reward" ; dmc:falsifier "regret exceeds configured envelope" .
dmc:MCTSCandidate a dmc:Candidate ; dmc:family "mcts" ; dmc:standing "PARTIAL_ALIVE" ; dmc:deterministic false ; dmc:rollbackCost 2 ; dmc:ctqNovelty 9 ; dmc:ctqEvidence 4 ; dmc:requiresReceipt true ; dmc:assumption "simulatable transition model" ; dmc:falsifier "rollout variance prevents stable ranking" .
dmc:FixedPointCandidate a dmc:Candidate ; dmc:family "fixed-point" ; dmc:standing "PARTIAL_ALIVE" ; dmc:deterministic true ; dmc:rollbackCost 1 ; dmc:ctqNovelty 7 ; dmc:ctqEvidence 7 ; dmc:requiresReceipt true ; dmc:assumption "monotone transfer function" ; dmc:falsifier "finite-lattice iteration fails to converge" .
dmc:ProcessCandidate a dmc:Candidate ; dmc:family "process-intelligence" ; dmc:standing "PARTIAL_ALIVE" ; dmc:deterministic true ; dmc:rollbackCost 1 ; dmc:ctqNovelty 8 ; dmc:ctqEvidence 7 ; dmc:requiresReceipt true ; dmc:assumption "event identity is preserved" ; dmc:falsifier "conformance cannot separate admitted and refused traces" .
dmc:DistributedCandidate a dmc:Candidate ; dmc:family "distributed" ; dmc:standing "PARTIAL_ALIVE" ; dmc:deterministic false ; dmc:rollbackCost 3 ; dmc:ctqNovelty 9 ; dmc:ctqEvidence 5 ; dmc:requiresReceipt true ; dmc:assumption "fault model is explicit" ; dmc:falsifier "safety or liveness breaks within fault bound" .
dmc:ReplayCandidate a dmc:Candidate ; dmc:family "replay" ; dmc:standing "PARTIAL_ALIVE" ; dmc:deterministic true ; dmc:rollbackCost 1 ; dmc:ctqNovelty 6 ; dmc:ctqEvidence 9 ; dmc:requiresReceipt true ; dmc:assumption "subject and toolchain identities are captured" ; dmc:falsifier "same admitted subject yields non-equivalent receipt" .
dmc:RefusalCandidate a dmc:Candidate ; dmc:family "security-refusal" ; dmc:standing "PARTIAL_ALIVE" ; dmc:deterministic true ; dmc:rollbackCost 1 ; dmc:ctqNovelty 6 ; dmc:ctqEvidence 9 ; dmc:requiresReceipt true ; dmc:assumption "authority is explicit" ; dmc:falsifier "unadmitted intent reaches actuation" .

# Reusable ggen generation-context closure semantics.
dmc:GenerationRule a rdfs:Class .
dmc:TemplateBinding a rdfs:Class .
dmc:ruleName a rdf:Property .
dmc:sourcePack a rdf:Property .
dmc:queryFile a rdf:Property .
dmc:templateFile a rdf:Property .
dmc:outputFile a rdf:Property .
dmc:requiredVariable a rdf:Property .
dmc:projectedVariable a rdf:Property .
dmc:missingVariable a rdf:Property .
dmc:unusedVariable a rdf:Property .
dmc:generationMode a rdf:Property .
dmc:skipEmpty a rdf:Property .
dmc:queryDigest a rdf:Property .
dmc:templateDigest a rdf:Property .
dmc:contextDigest a rdf:Property .
dmc:exactSubject a rdf:Property .
dmc:currentGeneration a rdf:Property .
dmc:bindingState a rdf:Property .
dmc:qualificationTimeoutSeconds a rdf:Property .
