PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
ASK { ?r a dmc:ExperimentRealization ; dmc:subjectSha ?sha ; dmc:semanticDigest ?digest ; dmc:experimentId ?id ; dmc:predictedInformationGain ?predicted ; dmc:realizedInformationGain ?realized ; dmc:frontierBefore ?before ; dmc:frontierAfter ?after ; dmc:experimentCost ?cost ; dmc:latencyMs ?latency ; dmc:currentGeneration true ; dmc:authority "OBSERVE|VERIFY" ; dmc:actuationPerformed false . FILTER regex(str(?sha), "^[0-9a-f]{40}$") FILTER regex(str(?digest), "^[0-9a-f]{64}$") FILTER(?predicted >= 0 && ?realized >= 0 && ?before >= 0 && ?after >= 0 && ?cost >= 0 && ?latency >= 0) }
