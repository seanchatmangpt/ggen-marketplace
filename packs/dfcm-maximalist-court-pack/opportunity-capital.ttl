@prefix dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

dmc:Opportunity a rdfs:Class ; rdfs:subClassOf prov:Entity .
dmc:Composition a rdfs:Class ; rdfs:subClassOf prov:Entity .
dmc:ExecutableCandidate a rdfs:Class ; rdfs:subClassOf prov:Entity .
dmc:Qualification a rdfs:Class ; rdfs:subClassOf prov:Entity .
dmc:MarketplaceSupport a rdfs:Class ; rdfs:subClassOf prov:Entity .
dmc:MissingPrimitive a rdfs:Class ; rdfs:subClassOf prov:Entity .
dmc:changedCapability a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:existingCapability a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:publicOntology a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:marketplacePack a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:repository a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:runtimeSurface a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:verificationSurface a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:composes a rdf:Property ; rdfs:subPropertyOf dcterms:hasPart .
dmc:producesCandidate a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:marketplaceSupport a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:missingPrimitive a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:qualification a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:reversibility a rdf:Property .
dmc:expectedReuse a rdf:Property .
dmc:expectedCapabilitySpaceDelta a rdf:Property .
dmc:executable a rdf:Property .
dmc:nonDominated a rdf:Property .
dmc:frontierGeneration a rdf:Property .
dmc:unlockedBy a rdf:Property ; rdfs:subPropertyOf prov:wasDerivedFrom .
dmc:algorithmVariant a rdf:Property .
dmc:apiSurface a rdf:Property .
dmc:falsifier a rdf:Property ; rdfs:subPropertyOf dcterms:relation .
dmc:receiptDigest a rdf:Property .
dmc:authority a rdf:Property .
dmc:actuationPerformed a rdf:Property .
dmc:standing a rdf:Property .
dmc:estimatedValue a rdf:Property .
dmc:estimatedCost a rdf:Property .
dmc:optionCapitalScore a rdf:Property .
