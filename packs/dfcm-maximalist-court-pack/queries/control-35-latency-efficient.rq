PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?gain ?latency ((?gain * 1000) / (?latency + 1) AS ?gainPerSecond) WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:realizedInformationGain ?gain ; dmc:latencyMs ?latency ; dmc:currentGeneration true .
  FILTER(?gain > 0 && ?latency >= 0)
} ORDER BY DESC(?gainPerSecond) ?experiment
