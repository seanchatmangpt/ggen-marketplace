PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?assumption WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:assumption ?assumption .
  FILTER(?family IN ("process-intelligence", "fixed-point"))
}
ORDER BY DESC(?evidence) ?family
