PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (AVG(IF(?success,1.0,0.0)) AS ?successRate) WHERE {
 ?obs a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilitySuccess ?success .
} GROUP BY ?pack ?rule HAVING(COUNT(?obs) >= 5 && AVG(IF(?success,1.0,0.0)) >= 0.95) ORDER BY DESC(?successRate) ?pack ?rule
