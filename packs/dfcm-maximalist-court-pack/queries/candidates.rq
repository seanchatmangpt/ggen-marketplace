PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?standing ?deterministic ?rollback ?novelty ?evidence WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:standing ?standing ; dmc:deterministic ?deterministic ; dmc:rollbackCost ?rollback ; dmc:ctqNovelty ?novelty ; dmc:ctqEvidence ?evidence .
} ORDER BY ?family
