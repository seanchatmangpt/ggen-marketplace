PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index1 ?decision1 ?decision2 WHERE {
  ?a a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index1 ; dmc:policyDecision ?decision1 .
  ?b a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index2 ; dmc:policyDecision ?decision2 .
  FILTER(?index2 = ?index1 + 1)
  FILTER(?decision1 != ?decision2)
} ORDER BY ?sequence ?index1
