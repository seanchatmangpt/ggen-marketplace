PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?dominator ?dominated
WHERE {
  ?dominator a dmc:Candidate ; dmc:ctqEvidence ?de ; dmc:ctqNovelty ?dn ; dmc:rollbackCost ?dr .
  ?dominated a dmc:Candidate ; dmc:ctqEvidence ?ee ; dmc:ctqNovelty ?en ; dmc:rollbackCost ?er .
  FILTER(?dominator != ?dominated && ?de >= ?ee && ?dn >= ?en && ?dr <= ?er && (?de > ?ee || ?dn > ?en || ?dr < ?er))
}
ORDER BY ?dominated ?dominator
