PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?evidence ?rollback (?rollback / (?evidence + 1) AS ?risk)
WHERE { ?candidate a dmc:Candidate ; dmc:deterministic false ; dmc:ctqEvidence ?evidence ; dmc:rollbackCost ?rollback . }
ORDER BY ?risk DESC(?evidence) ?candidate
