PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?evidence ?novelty (IF(?evidence < ?novelty, ?evidence, ?novelty) AS ?balancedFloor)
WHERE { ?candidate a dmc:Candidate ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty . }
ORDER BY DESC(?balancedFloor) ?candidate
