PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index ?step (?cost - ?gain AS ?observedRegret) WHERE { ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:realizedGain ?gain ; dmc:stepCost ?cost . FILTER(?cost > ?gain) } ORDER BY DESC(?observedRegret) ?sequence ?index
