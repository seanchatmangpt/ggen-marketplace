PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?evidence ?rollback ?efficiency WHERE {
  ?candidate a dmc:Candidate ; dmc:ctqEvidence ?evidence ; dmc:rollbackCost ?rollback .
  FILTER(?rollback > 0)
  BIND(?evidence / ?rollback AS ?efficiency)
}
ORDER BY DESC(?efficiency) ?candidate
