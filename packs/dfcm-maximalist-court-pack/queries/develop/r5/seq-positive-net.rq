PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index ?step (?gain - ?cost AS ?netValue) WHERE { ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:realizedGain ?gain ; dmc:stepCost ?cost . FILTER(?gain > ?cost) } ORDER BY ?sequence ?index
