PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?step ?index ?decision WHERE { ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:policyDecision ?decision . FILTER NOT EXISTS { ?later a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?laterIndex . FILTER(?laterIndex > ?index) } } ORDER BY ?sequence
