PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?digest ?stratum (COUNT(?o) AS ?support) (AVG(?loss) AS ?meanLoss) (AVG(?p) AS ?meanStopProbability)
WHERE { ?o a dmc:PolicyCalibrationObservation ; dmc:currentGeneration true ; dmc:policyDigest ?digest ; dmc:stratum ?stratum ; dmc:decisionLoss ?loss ; dmc:predictedStopProbability ?p . }
GROUP BY ?digest ?stratum
ORDER BY ?meanLoss DESC(?support) ?digest ?stratum
