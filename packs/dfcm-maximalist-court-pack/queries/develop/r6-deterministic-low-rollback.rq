PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?rollback ?evidence ?novelty
WHERE { ?candidate a dmc:Candidate ; dmc:deterministic true ; dmc:rollbackCost ?rollback ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty . FILTER(?rollback <= 2) }
ORDER BY ?rollback DESC(?evidence) DESC(?novelty) ?candidate
