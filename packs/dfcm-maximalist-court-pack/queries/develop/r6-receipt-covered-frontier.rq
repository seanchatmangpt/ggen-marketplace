PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?novelty ?rollback
WHERE { ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty ; dmc:rollbackCost ?rollback ; dmc:requiresReceipt true . }
ORDER BY DESC(?evidence) DESC(?novelty) ?rollback ?candidate
