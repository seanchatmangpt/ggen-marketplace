PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?family (MAX((?evidence + ?novelty) / (?rollback + 1)) AS ?bestDensity)
WHERE { ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty ; dmc:rollbackCost ?rollback . }
GROUP BY ?family
ORDER BY DESC(?bestDensity) ?family
