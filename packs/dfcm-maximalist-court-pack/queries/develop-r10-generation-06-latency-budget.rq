PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?pack ?rule (MAX(xsd:decimal(?latency)) AS ?maxLatencyMs) WHERE {
 ?obs a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityLatencyMs ?latency .
} GROUP BY ?pack ?rule HAVING(COUNT(?obs) >= 5 && MAX(xsd:decimal(?latency)) <= 10000) ORDER BY ?maxLatencyMs ?pack ?rule
