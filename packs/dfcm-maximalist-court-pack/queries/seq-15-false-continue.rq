PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index ?step WHERE {
  ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:policyDecision "CONTINUE" ; dmc:realizedGain ?gain ; dmc:stepCost ?cost .
  FILTER((?gain - ?cost) <= 0)
} ORDER BY ?sequence ?index
