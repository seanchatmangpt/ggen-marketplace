PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?deterministic (AVG(?gain) AS ?meanGain) (COUNT(?step) AS ?support) WHERE {
  ?step a dmc:ExperimentStep ; dmc:candidate ?candidate ; dmc:realizedGain ?gain .
  ?candidate dmc:deterministic ?deterministic .
} GROUP BY ?deterministic ORDER BY ?deterministic
