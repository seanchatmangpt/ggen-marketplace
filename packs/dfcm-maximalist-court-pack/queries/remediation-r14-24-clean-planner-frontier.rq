PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate WHERE {
  ?candidate a dmc:RemediationCandidate ; dmc:reversible true ; dmc:expectedRelief ?relief ; dmc:futureManufacturingCapacity ?capacity ; dmc:falsifierCode ?falsifier ; dmc:sourceSubject ?subject ; dmc:ggenSubject ?ggen .
  FILTER(xsd:decimal(?relief) > 0 && xsd:decimal(?capacity) > 0 && STRLEN(STR(?falsifier)) > 0 && STRLEN(STR(?subject)) > 40 && STRLEN(STR(?ggen)) > 40)
  FILTER NOT EXISTS { ?candidate dmc:authority "DO" }
  FILTER NOT EXISTS { ?candidate dmc:actuationPerformed true }
}
ORDER BY ?candidate
