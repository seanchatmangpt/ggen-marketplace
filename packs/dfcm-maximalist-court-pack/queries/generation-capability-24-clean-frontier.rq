PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?o ?pack ?rule ?generation WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityGeneration ?generation ; dmc:capabilitySuccess true ; dmc:capabilityDeterministic true ; dmc:capabilityCurrent true ; dmc:capabilityCollision false ; dmc:capabilityAuthority "OBSERVE|VERIFY" ; dmc:capabilityActuationPerformed false ; dmc:capabilityReceiptDigest ?receipt .
  FILTER regex(str(?receipt), "^[0-9a-f]{64}$")
} ORDER BY ?pack ?rule DESC(?generation) ?o
