PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?generation (COUNT(DISTINCT ?digest) AS ?digests) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:policyGeneration ?generation ; dmc:policyDigest ?digest ; dmc:currentGeneration true .
} GROUP BY ?generation HAVING(COUNT(DISTINCT ?digest) > 1)
