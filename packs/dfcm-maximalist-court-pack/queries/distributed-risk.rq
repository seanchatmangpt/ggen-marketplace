PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?rollback ?assumption ?falsifier WHERE {
  ?candidate a dmc:Candidate ; dmc:family "distributed" ; dmc:rollbackCost ?rollback ; dmc:assumption ?assumption ; dmc:falsifier ?falsifier .
  BIND("distributed" AS ?family)
}
