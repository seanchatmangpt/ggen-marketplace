PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?decision (AVG(xsd:decimal(?value)) AS ?meanObservedValue) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:realizedDecision ?decision ; dmc:observedNetValue ?value ; dmc:counterfactualObserved true ; dmc:currentGeneration true .
} GROUP BY ?decision ORDER BY ?decision
