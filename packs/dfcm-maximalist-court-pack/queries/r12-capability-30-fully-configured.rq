PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?c ?controller ?pack ?rule WHERE {
 ?c a dmc:ControllerGenerationCapability ; dmc:capabilityControllerDigest ?controller ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityCurrent true ; dmc:capabilityMinSupport ?support ; dmc:capabilityMinSuccessRate ?success ; dmc:capabilityMinDeterminismRate ?det ; dmc:capabilityMaxSemanticMismatchRate ?semantic ; dmc:capabilityMaxOutputMismatchRate ?output ; dmc:capabilityMaxFalseStopRate ?fs ; dmc:capabilityMaxFalseContinueRate ?fc ; dmc:capabilityMaxLatencyMs ?latency ; dmc:capabilityReceiptDigest ?receipt ; dmc:capabilityAuthority "OBSERVE|VERIFY" ; dmc:capabilityActuationPerformed false .
}
