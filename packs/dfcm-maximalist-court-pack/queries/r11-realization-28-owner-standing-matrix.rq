PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?owner ?decision (COUNT(?r) AS ?count) WHERE {
  ?r a dmc:ControllerGenerationRealization ;
     dmc:realizationOwnerStanding ?owner ;
     dmc:realizationControllerDecision ?decision .
} GROUP BY ?owner ?decision ORDER BY ?owner ?decision
