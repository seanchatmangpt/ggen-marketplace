PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack (AVG(IF(?ok && ?current,1.0,0.0)) AS ?currentSuccessRate) WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilitySuccess ?ok ; dmc:capabilityCurrent ?current .
} GROUP BY ?pack ORDER BY ?currentSuccessRate ?pack
