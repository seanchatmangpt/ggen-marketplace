PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate (AVG(?gain / ?rollback) AS ?rollbackNormalizedGain) WHERE {
  ?step a dmc:ExperimentStep ; dmc:candidate ?candidate ; dmc:realizedGain ?gain .
  ?candidate dmc:rollbackCost ?rollback .
  FILTER(?rollback > 0)
} GROUP BY ?candidate ORDER BY DESC(?rollbackNormalizedGain)
