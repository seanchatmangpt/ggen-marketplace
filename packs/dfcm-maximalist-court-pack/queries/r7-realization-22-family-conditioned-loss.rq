PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?family (AVG(xsd:decimal(?loss)) AS ?meanLoss) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:candidate ?candidate ; dmc:decisionLoss ?loss ; dmc:currentGeneration true .
 ?candidate dmc:family ?family .
} GROUP BY ?family ORDER BY DESC(?meanLoss) ?family
