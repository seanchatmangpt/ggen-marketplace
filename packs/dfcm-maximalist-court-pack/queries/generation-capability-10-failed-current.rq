PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?o ?pack ?rule ?failure WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityCurrent true ; dmc:capabilitySuccess false .
  OPTIONAL { ?o dmc:capabilityFailureClass ?failure }
} ORDER BY ?pack ?rule ?o
