PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?subject ?digest WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:subjectSha ?subject ; dmc:semanticDigest ?digest ; dmc:currentGeneration true .
  FILTER(STRLEN(STR(?subject)) = 40 && STRLEN(STR(?digest)) = 64)
} ORDER BY ?experiment
