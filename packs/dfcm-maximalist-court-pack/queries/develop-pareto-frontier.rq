PREFIX dfcm: <https://chatman.ai/dfcm#>
SELECT ?candidate WHERE {
  ?candidate a dfcm:Candidate ; dfcm:evidenceScore ?e ; dfcm:rollbackCost ?r .
  FILTER NOT EXISTS {
    ?other a dfcm:Candidate ; dfcm:evidenceScore ?oe ; dfcm:rollbackCost ?or .
    FILTER(?other != ?candidate && ?oe >= ?e && ?or <= ?r && (?oe > ?e || ?or < ?r))
  }
}
ORDER BY ?candidate
