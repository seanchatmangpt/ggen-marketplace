PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (AVG(xsd:decimal(?loss)) AS ?deadlineLoss) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:decisionLoss ?loss ; dmc:deadlineMs ?deadline ; dmc:stepLatencyMs ?latency ; dmc:currentGeneration true .
 FILTER(xsd:decimal(?latency) > xsd:decimal(?deadline))
}
