PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index1 ?index2 ?gain1 ?gain2 WHERE {
  ?a a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index1 ; dmc:realizedGain ?gain1 .
  ?b a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index2 ; dmc:realizedGain ?gain2 .
  FILTER(?index2 = ?index1 + 1)
  FILTER(?gain2 > ?gain1)
} ORDER BY ?sequence ?index1
