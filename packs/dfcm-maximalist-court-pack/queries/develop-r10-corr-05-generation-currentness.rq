PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller (MAX(?generation) AS ?currentGeneration) WHERE {
 ?link a dmc:ControllerGenerationCorrespondence ; dmc:correspondenceControllerDigest ?controller ; dmc:correspondenceGeneration ?generation ; dmc:correspondenceCurrent true .
} GROUP BY ?controller ORDER BY ?controller
