PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?a ?b WHERE {
  ?a a dmc:Candidate ; dmc:ctqEvidence ?ae ; dmc:ctqNovelty ?an ; dmc:rollbackCost ?ar .
  ?b a dmc:Candidate ; dmc:ctqEvidence ?be ; dmc:ctqNovelty ?bn ; dmc:rollbackCost ?br .
  FILTER(?a != ?b && ?ae >= ?be && ?an >= ?bn && ?ar <= ?br && (?ae > ?be || ?an > ?bn || ?ar < ?br))
} ORDER BY STR(?a) STR(?b)
