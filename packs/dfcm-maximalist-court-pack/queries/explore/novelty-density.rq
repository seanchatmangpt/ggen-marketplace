PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?novelty ?rollback (?novelty / ?rollback AS ?noveltyDensity)
WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqNovelty ?novelty ; dmc:rollbackCost ?rollback .
  FILTER(?rollback > 0)
}
ORDER BY DESC(?noveltyDensity) ?family ?candidate
