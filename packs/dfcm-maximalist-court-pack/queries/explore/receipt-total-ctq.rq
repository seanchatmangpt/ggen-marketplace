PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?novelty (?evidence + ?novelty AS ?totalCtq)
WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:requiresReceipt true ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty .
}
ORDER BY DESC(?totalCtq) ?family ?candidate
