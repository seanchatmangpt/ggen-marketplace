PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?novelty
WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:rollbackCost 1 ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty .
}
ORDER BY DESC(?evidence) DESC(?novelty) ?family ?candidate
