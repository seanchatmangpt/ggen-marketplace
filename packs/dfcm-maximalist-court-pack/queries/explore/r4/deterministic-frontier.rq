PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?evidence ?novelty ?rollback WHERE { ?candidate a dmc:Candidate ; dmc:deterministic true ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty ; dmc:rollbackCost ?rollback . } ORDER BY DESC(?evidence) DESC(?novelty) ASC(?rollback)