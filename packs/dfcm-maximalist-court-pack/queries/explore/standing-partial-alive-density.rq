PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?novelty ?rollback ((?evidence + ?novelty) / ?rollback AS ?density)
WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:standing "PARTIAL_ALIVE" ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty ; dmc:rollbackCost ?rollback .
  FILTER(?rollback > 0)
}
ORDER BY DESC(?density) ?family ?candidate
