PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?novelty (?novelty - ?evidence AS ?margin)
WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty .
  FILTER(?novelty > ?evidence)
}
ORDER BY DESC(?margin) ?family ?candidate
