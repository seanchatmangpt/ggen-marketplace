PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?evidence ?novelty (ABS(?evidence - ?novelty) AS ?gap)
WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence ; dmc:ctqNovelty ?novelty .
  FILTER(ABS(?evidence - ?novelty) <= 1)
}
ORDER BY ?gap DESC(?evidence) DESC(?novelty) ?family
