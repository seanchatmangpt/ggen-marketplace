PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?novelty ?evidence WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:deterministic false ; dmc:ctqNovelty ?novelty ; dmc:ctqEvidence ?evidence .
} ORDER BY DESC(?novelty) DESC(?evidence) STR(?candidate)
