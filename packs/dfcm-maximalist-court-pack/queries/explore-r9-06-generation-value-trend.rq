PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?generation (COUNT(?obs) AS ?support) (AVG(xsd:decimal(?value)) AS ?meanValue) WHERE {
  ?obs a dmc:PolicyCalibrationObservation ; dmc:policyGeneration ?generation ; dmc:observedNetValue ?value .
} GROUP BY ?generation ORDER BY ?generation
