PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?stratum (AVG((?p-?y)*(?p-?y)) AS ?brier) WHERE { ?o a dmc:PolicyCalibrationObservation ; dmc:stratum ?stratum ; dmc:predictedStopProbability ?p ; dmc:realizedDecision ?d . BIND(IF(?d="STOP",1.0,0.0) AS ?y) } GROUP BY ?stratum ORDER BY DESC(?brier)
