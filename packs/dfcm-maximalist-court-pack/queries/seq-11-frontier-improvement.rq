PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index ?step (?before - ?after AS ?frontierImprovement) WHERE {
  ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:frontierBefore ?before ; dmc:frontierAfter ?after .
  FILTER(?after < ?before)
} ORDER BY DESC(?frontierImprovement)
