PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?r ?rule ?output ?digest WHERE {
  ?r a dmc:GenerationRealization ; dmc:realizesRule ?rule ; dmc:realizationState "PASS" ; dmc:outputCurrent true ; dmc:realizedOutput ?output ; dmc:realizedOutputDigest ?digest .
} ORDER BY ?rule ?output
