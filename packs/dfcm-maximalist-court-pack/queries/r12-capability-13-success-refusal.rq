PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?c ?rate ?minimum WHERE {
 ?c a dmc:ControllerGenerationCapability ; dmc:capabilityControllerDigest ?controller ; dmc:capabilityRule ?rule ; dmc:capabilityMinSuccessRate ?minimum .
 { SELECT ?controller ?rule (AVG(IF(?standing="PASS",1,0)) AS ?rate) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationControllerDigest ?controller ; dmc:realizationCapabilityRule ?rule ; dmc:realizationStanding ?standing . } GROUP BY ?controller ?rule }
 FILTER(?rate < ?minimum)
}
