PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller ?rule (AVG(IF(?owner="PASS",1,0)) AS ?ownerPassRate) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationControllerDigest ?controller ; dmc:realizationCapabilityRule ?rule ; dmc:realizationOwnerStanding ?owner . } GROUP BY ?controller ?rule
