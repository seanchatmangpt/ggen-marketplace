PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller (COUNT(DISTINCT ?link) AS ?currentLinks) WHERE {
 ?link a dmc:ControllerGenerationCorrespondence ; dmc:correspondenceControllerDigest ?controller ; dmc:correspondenceCurrent true .
} GROUP BY ?controller HAVING(COUNT(DISTINCT ?link) > 1) ORDER BY DESC(?currentLinks) ?controller
