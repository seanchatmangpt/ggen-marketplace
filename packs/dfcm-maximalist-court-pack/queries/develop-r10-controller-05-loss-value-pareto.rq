PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?digest (AVG(xsd:decimal(?loss)) AS ?meanLoss) (AVG(xsd:decimal(?value)) AS ?meanValue) WHERE {
 ?obs a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?digest ; dmc:decisionLoss ?loss ; dmc:observedNetValue ?value ; dmc:currentGeneration true .
} GROUP BY ?digest HAVING(COUNT(?obs) >= 5) ORDER BY ?meanLoss DESC(?meanValue) ?digest
