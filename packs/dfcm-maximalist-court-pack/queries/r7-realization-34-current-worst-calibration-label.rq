PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?label (COUNT(?o) AS ?support) (AVG(xsd:decimal(?loss)) AS ?meanLoss) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:calibrationLabel ?label ; dmc:decisionLoss ?loss ; dmc:currentGeneration true .
} GROUP BY ?label ORDER BY DESC(?meanLoss) ?label
