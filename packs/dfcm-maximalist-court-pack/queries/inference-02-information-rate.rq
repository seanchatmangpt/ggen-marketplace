PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment (?gain / IF(?latency > 0, ?latency, 1) AS ?informationRate) WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:realizedInformationGain ?gain ; dmc:latencyMs ?latency .
  FILTER(?gain >= 0 && ?latency >= 0)
} ORDER BY DESC(?informationRate)
