PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?digest (COUNT(?obs) AS ?support) (AVG(IF(?truth = "STOP", 1.0, 0.0)) AS ?falseContinueRate) WHERE {
 ?obs a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?digest ; dmc:realizedDecision "CONTINUE" ; dmc:calibrationLabel ?truth ; dmc:currentGeneration true .
} GROUP BY ?digest HAVING(COUNT(?obs) >= 5 && AVG(IF(?truth = "STOP", 1.0, 0.0)) <= 0.2) ORDER BY ?falseContinueRate ?digest
