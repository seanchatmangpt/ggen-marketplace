PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?gain ?alternative ((?alternative - ?gain) AS ?observedRegret) WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:realizedInformationGain ?gain ; dmc:observedAlternativeGain ?alternative ; dmc:currentGeneration true .
  FILTER((?alternative - ?gain) >= 0)
} ORDER BY ?observedRegret ?experiment
