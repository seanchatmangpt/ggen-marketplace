PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT (AVG(xsd:decimal(?loss)) AS ?midConfidenceLoss) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:predictedStopProbability ?p ; dmc:decisionLoss ?loss ; dmc:currentGeneration true .
 FILTER(xsd:decimal(?p)>=0.4 && xsd:decimal(?p)<=0.6)
}
