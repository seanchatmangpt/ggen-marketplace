PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?a ?b ?predictedA ?predictedB ?realizedA ?realizedB WHERE {
  ?a a dmc:ExperimentRealization ; dmc:currentGeneration true ; dmc:predictedInformationGain ?predictedA ; dmc:realizedInformationGain ?realizedA .
  ?b a dmc:ExperimentRealization ; dmc:currentGeneration true ; dmc:predictedInformationGain ?predictedB ; dmc:realizedInformationGain ?realizedB .
  FILTER(STR(?a) < STR(?b))
  FILTER((?predictedA > ?predictedB && ?realizedA < ?realizedB) || (?predictedA < ?predictedB && ?realizedA > ?realizedB))
} ORDER BY ?a ?b
