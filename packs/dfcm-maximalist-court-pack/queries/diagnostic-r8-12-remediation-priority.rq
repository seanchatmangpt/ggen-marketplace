PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?rule ?name
       (COUNT(DISTINCT ?missing) AS ?missingCount)
       (COUNT(DISTINCT ?unused) AS ?unusedCount)
       (IF(BOUND(?timeout), ?timeout, 0) AS ?timeoutSeconds)
WHERE {
  ?rule a dmc:GenerationRule ; dmc:ruleName ?name .
  OPTIONAL { ?rule dmc:missingVariable ?missing }
  OPTIONAL { ?rule dmc:unusedVariable ?unused }
  OPTIONAL { ?rule dmc:qualificationTimeoutSeconds ?timeout }
}
GROUP BY ?rule ?name ?timeout
ORDER BY DESC(?missingCount) DESC(?unusedCount) ?timeoutSeconds ?name
