PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?family ?rollback (AVG(?gain/(1+?rollback)) AS ?value) WHERE { ?c a dmc:Candidate ; dmc:family ?family ; dmc:rollbackCost ?rollback . ?r a dmc:ExperimentRealization ; dmc:experimentId ?id ; dmc:realizedInformationGain ?gain . FILTER(CONTAINS(str(?id),str(?family))) } GROUP BY ?family ?rollback ORDER BY DESC(?value)
