PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?family ?evidence (AVG(?gain/(1+?evidence)) AS ?novelGain) WHERE { ?c a dmc:Candidate ; dmc:family ?family ; dmc:ctqEvidence ?evidence . ?r a dmc:ExperimentRealization ; dmc:experimentId ?id ; dmc:realizedInformationGain ?gain . FILTER(CONTAINS(str(?id),str(?family))) } GROUP BY ?family ?evidence ORDER BY DESC(?novelGain)
