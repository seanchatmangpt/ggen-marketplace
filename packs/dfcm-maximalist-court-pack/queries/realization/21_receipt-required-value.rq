PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?family ?requires (AVG(?gain) AS ?meanGain) WHERE { ?c a dmc:Candidate ; dmc:family ?family ; dmc:requiresReceipt ?requires . ?r a dmc:ExperimentRealization ; dmc:experimentId ?id ; dmc:realizedInformationGain ?gain . FILTER(CONTAINS(str(?id),str(?family))) } GROUP BY ?family ?requires ORDER BY ?family
