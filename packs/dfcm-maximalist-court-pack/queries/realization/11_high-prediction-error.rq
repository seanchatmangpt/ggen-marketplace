PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?r ?predicted ?realized (ABS(?predicted-?realized) AS ?error) WHERE { ?r a dmc:ExperimentRealization ; dmc:predictedInformationGain ?predicted ; dmc:realizedInformationGain ?realized . FILTER(ABS(?predicted-?realized) > 1) } ORDER BY DESC(?error)
