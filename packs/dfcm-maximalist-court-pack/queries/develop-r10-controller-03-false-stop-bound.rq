PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?digest (COUNT(?obs) AS ?support) (AVG(IF(?truth = "CONTINUE", 1.0, 0.0)) AS ?falseStopRate) WHERE {
  ?obs a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?digest ; dmc:realizedDecision "STOP" ; dmc:calibrationLabel ?truth ; dmc:currentGeneration true .
} GROUP BY ?digest HAVING(COUNT(?obs) >= 5 && AVG(IF(?truth = "CONTINUE", 1.0, 0.0)) <= 0.2) ORDER BY ?falseStopRate ?digest
