PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate ?capacity WHERE { ?candidate a dmc:RemediationCandidate ; dmc:futureManufacturingCapacity ?capacity . FILTER(xsd:decimal(?capacity) > 0) } ORDER BY DESC(xsd:decimal(?capacity)) ?candidate
