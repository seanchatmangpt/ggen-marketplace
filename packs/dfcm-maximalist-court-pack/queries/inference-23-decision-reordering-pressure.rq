PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?predicted ?realized WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:predictedInformationGain ?predicted ; dmc:realizedInformationGain ?realized .
  FILTER((?predicted > 0 && ?realized = 0) || (?predicted = 0 && ?realized > 0))
} ORDER BY DESC(ABS(?predicted-?realized))
