PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?generation (COUNT(?r) AS ?support) (AVG(IF(?standing="PASS",1,0)) AS ?successRate) WHERE { ?r a dmc:ControllerGenerationRealization ; dmc:realizationGeneration ?generation ; dmc:realizationStanding ?standing . } GROUP BY ?generation ORDER BY ?generation
