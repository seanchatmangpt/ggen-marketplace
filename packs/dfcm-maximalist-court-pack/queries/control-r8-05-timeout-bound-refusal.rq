PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?rule ?name ?timeout WHERE {
  ?rule a dmc:GenerationRule ; dmc:ruleName ?name .
  OPTIONAL { ?rule dmc:qualificationTimeoutSeconds ?timeout }
  FILTER (!BOUND(?timeout) || xsd:decimal(?timeout) <= 0)
}
ORDER BY ?name
