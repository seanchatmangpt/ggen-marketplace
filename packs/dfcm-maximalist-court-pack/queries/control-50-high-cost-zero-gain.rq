PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?cost ?predicted WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:currentGeneration true ; dmc:realizedInformationGain 0 ; dmc:experimentCost ?cost ; dmc:predictedInformationGain ?predicted .
  FILTER(?cost > 0)
} ORDER BY DESC(?cost) DESC(?predicted) ?experiment
