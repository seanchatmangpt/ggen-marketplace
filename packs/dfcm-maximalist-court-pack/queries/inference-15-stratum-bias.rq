PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?stratum (AVG(?predicted - ?realized) AS ?bias) WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:stratum ?stratum ; dmc:predictedInformationGain ?predicted ; dmc:realizedInformationGain ?realized .
} GROUP BY ?stratum ORDER BY DESC(ABS(?bias))
