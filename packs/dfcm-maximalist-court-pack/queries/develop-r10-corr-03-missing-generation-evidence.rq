PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?link ?pack ?rule WHERE {
 ?link a dmc:ControllerGenerationCorrespondence ; dmc:correspondenceCapabilityPack ?pack ; dmc:correspondenceCapabilityRule ?rule ; dmc:correspondenceCurrent true .
 FILTER NOT EXISTS { ?obs a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityCurrent true }
} ORDER BY ?pack ?rule ?link
