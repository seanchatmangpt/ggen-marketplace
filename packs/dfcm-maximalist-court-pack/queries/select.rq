PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?rollback ?novelty ?evidence WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:rollbackCost ?rollback ; dmc:ctqNovelty ?novelty ; dmc:ctqEvidence ?evidence .
  FILTER(?rollback <= 2 && ?evidence >= 5)
} ORDER BY DESC(?novelty) DESC(?evidence) ?rollback
