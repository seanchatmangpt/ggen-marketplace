PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?sequence ?index ?step (?gain / ?latency AS ?gainPerMs) WHERE {
  ?step a dmc:ExperimentStep ; dmc:sequenceId ?sequence ; dmc:stepIndex ?index ; dmc:realizedGain ?gain ; dmc:stepLatencyMs ?latency .
  FILTER(?latency > 0)
} ORDER BY DESC(?gainPerMs)
