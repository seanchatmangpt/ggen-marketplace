PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?r ?controller ?rule WHERE {
  ?r a dmc:ControllerGenerationRealization ;
     dmc:realizationControllerDigest ?controller ;
     dmc:realizationCapabilityRule ?rule ;
     dmc:realizationCurrent true ;
     dmc:realizationDeterministic true ;
     dmc:realizationExpectedSemanticDigest ?semantic ;
     dmc:realizationActualSemanticDigest ?semantic ;
     dmc:realizationExpectedOutputDigest ?output ;
     dmc:realizationActualOutputDigest ?output ;
     dmc:realizationOwnerStanding "PASS" ;
     dmc:realizationAuthority "OBSERVE|VERIFY" ;
     dmc:realizationActuationPerformed false .
}
