PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?gain ?cost WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:realizedInformationGain ?gain ; dmc:experimentCost ?cost ; dmc:currentGeneration true .
  FILTER(?gain >= ?cost && ?cost >= 0)
} ORDER BY ?cost DESC(?gain) ?experiment
