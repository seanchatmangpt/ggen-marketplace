PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?predicted ?cost WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:currentGeneration true ; dmc:predictedInformationGain ?predicted ; dmc:realizedInformationGain 0 ; dmc:experimentCost ?cost .
  FILTER(?predicted > 0)
} ORDER BY DESC(?predicted) DESC(?cost) ?experiment
