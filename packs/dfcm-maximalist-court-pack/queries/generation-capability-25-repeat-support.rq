PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (COUNT(DISTINCT ?attempt) AS ?repeatSupport) WHERE {
  ?o a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule ; dmc:capabilityAttempt ?attempt .
} GROUP BY ?pack ?rule HAVING(COUNT(DISTINCT ?attempt) >= 2) ORDER BY ?pack ?rule
