PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule (COUNT(?obs) AS ?attempts) WHERE {
 ?obs a dmc:GenerationCapabilityObservation ; dmc:capabilityPack ?pack ; dmc:capabilityRule ?rule .
} GROUP BY ?pack ?rule HAVING(COUNT(?obs) >= 5) ORDER BY DESC(?attempts) ?pack ?rule
