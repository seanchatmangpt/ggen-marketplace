PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?pack ?rule WHERE {
  ?rule a dmc:GenerationRule ; dmc:sourcePack ?pack .
  FILTER NOT EXISTS {
    ?rule dmc:requiredVariable ?variable .
    FILTER NOT EXISTS { ?rule dmc:projectedVariable ?variable }
  }
} ORDER BY ?pack ?rule
