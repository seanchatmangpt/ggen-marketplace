PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?r ?value WHERE {
  ?r a dmc:ControllerGenerationRealization ;
     dmc:realizationControllerDecision "CONTINUE" ;
     dmc:realizationNetValue ?value .
  FILTER(xsd:decimal(?value) <= 0)
}
