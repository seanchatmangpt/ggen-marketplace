PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?policyDigest (AVG(xsd:decimal(?loss)) AS ?meanLoss) WHERE {
 ?o a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?policyDigest ; dmc:decisionLoss ?loss ; dmc:currentGeneration false .
} GROUP BY ?policyDigest ORDER BY DESC(?meanLoss)
