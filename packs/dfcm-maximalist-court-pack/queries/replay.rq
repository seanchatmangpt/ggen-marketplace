PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate ?family ?deterministic ?standing WHERE {
  ?candidate a dmc:Candidate ; dmc:family ?family ; dmc:deterministic ?deterministic ; dmc:standing ?standing ; dmc:requiresReceipt true .
  FILTER(?deterministic = true)
} ORDER BY ?family
