PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?controller (AVG(?latency) AS ?meanLatencyMs) (MAX(?latency) AS ?maxLatencyMs) WHERE {
  ?r a dmc:ControllerGenerationRealization ;
     dmc:realizationControllerDigest ?controller ;
     dmc:realizationLatencyMs ?latency ;
     dmc:realizationCurrent true .
} GROUP BY ?controller ORDER BY DESC(?maxLatencyMs)
