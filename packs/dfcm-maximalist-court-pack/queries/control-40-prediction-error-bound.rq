PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment (ABS(?predicted - ?realized) AS ?absoluteError) WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:predictedInformationGain ?predicted ; dmc:realizedInformationGain ?realized ; dmc:currentGeneration true .
  FILTER(ABS(?predicted - ?realized) <= 1.0)
} ORDER BY ?absoluteError ?experiment
