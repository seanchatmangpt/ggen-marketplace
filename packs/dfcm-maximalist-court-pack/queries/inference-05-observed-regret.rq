PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ((?alternative - ?realized) AS ?observedRegret) WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:realizedInformationGain ?realized ; dmc:observedAlternativeGain ?alternative .
  FILTER(?alternative >= ?realized)
} ORDER BY DESC(?observedRegret)
