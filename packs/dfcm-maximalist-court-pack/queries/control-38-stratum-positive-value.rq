PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?stratum (AVG(?gain - ?cost) AS ?meanNetValue) WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:stratum ?stratum ; dmc:realizedInformationGain ?gain ; dmc:experimentCost ?cost ; dmc:currentGeneration true .
} GROUP BY ?stratum HAVING(AVG(?gain - ?cost) > 0) ORDER BY DESC(?meanNetValue) ?stratum
