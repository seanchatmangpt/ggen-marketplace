PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?rule ?name
       (BOUND(?qd) AS ?hasQueryDigest)
       (BOUND(?td) AS ?hasTemplateDigest)
       (BOUND(?cd) AS ?hasContextDigest)
WHERE {
  ?rule a dmc:GenerationRule ; dmc:ruleName ?name .
  OPTIONAL { ?rule dmc:queryDigest ?qd }
  OPTIONAL { ?rule dmc:templateDigest ?td }
  OPTIONAL { ?rule dmc:contextDigest ?cd }
}
ORDER BY ?name
