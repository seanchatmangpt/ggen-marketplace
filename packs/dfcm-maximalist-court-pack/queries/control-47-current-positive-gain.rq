PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?experiment ?gain ?cost ((?gain - ?cost) AS ?netValue) WHERE {
  ?experiment a dmc:ExperimentRealization ; dmc:currentGeneration true ; dmc:realizedInformationGain ?gain ; dmc:experimentCost ?cost .
  FILTER(?gain > 0)
} ORDER BY DESC(?gain) ?experiment
