PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?digest (COUNT(?obs) AS ?support) (AVG(xsd:decimal(?value)) AS ?meanValue) (AVG(xsd:decimal(?loss)) AS ?meanLoss) WHERE {
 ?obs a dmc:PolicyCalibrationObservation ; dmc:policyDigest ?digest ; dmc:observedNetValue ?value ; dmc:decisionLoss ?loss ; dmc:currentGeneration true ; dmc:receiptDigest ?receipt .
} GROUP BY ?digest HAVING(COUNT(?obs) >= 8 && AVG(xsd:decimal(?value)) > 0 && AVG(xsd:decimal(?loss)) <= 0.2) ORDER BY DESC(?meanValue) ?meanLoss ?digest
