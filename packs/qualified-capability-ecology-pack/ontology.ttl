@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

qce:CapabilityVersion a rdfs:Class, prov:Entity .
qce:CapabilityCandidate a rdfs:Class ; rdfs:subClassOf qce:CapabilityVersion .
qce:QualifiedCapability a rdfs:Class ; rdfs:subClassOf qce:CapabilityVersion .
qce:FrozenCapability a rdfs:Class ; rdfs:subClassOf qce:QualifiedCapability .
qce:RetiredCapability a rdfs:Class ; rdfs:subClassOf qce:CapabilityVersion .

qce:QualificationReceipt a rdfs:Class, prov:Entity .
qce:ExecutionClosure a rdfs:Class, prov:Entity .
qce:RuntimeEpisode a rdfs:Class, prov:Activity .
qce:ObservationReceipt a rdfs:Class, prov:Entity .
qce:EvolutionProposal a rdfs:Class, prov:Entity .
qce:SubstitutionClaim a rdfs:Class, prov:Entity .
qce:SubstitutionReceipt a rdfs:Class, prov:Entity .
qce:RetirementReceipt a rdfs:Class, prov:Entity .
qce:ReplayReceipt a rdfs:Class, prov:Entity .
qce:AuthorityEnvelope a rdfs:Class, prov:Entity .
qce:ResidualWorkMeasurement a rdfs:Class, prov:Entity .

qce:CandidateState a skos:Concept ; skos:prefLabel "candidate" .
qce:QualifiedState a skos:Concept ; skos:prefLabel "qualified" .
qce:FrozenState a skos:Concept ; skos:prefLabel "frozen" .
qce:RetiredState a skos:Concept ; skos:prefLabel "retired" .

qce:subjectRepository a rdf:Property .
qce:subjectCommit a rdf:Property ; rdfs:range xsd:string .
qce:artifactDigest a rdf:Property ; rdfs:range xsd:string .
qce:sourceDigest a rdf:Property ; rdfs:range xsd:string .
qce:qualificationDigest a rdf:Property ; rdfs:range xsd:string .
qce:closureDigest a rdf:Property ; rdfs:range xsd:string .
qce:receiptDigest a rdf:Property ; rdfs:range xsd:string .
qce:replayDigest a rdf:Property ; rdfs:range xsd:string .
qce:authorityDigest a rdf:Property ; rdfs:range xsd:string .
qce:observationDigest a rdf:Property ; rdfs:range xsd:string .
qce:consequenceDigest a rdf:Property ; rdfs:range xsd:string .
qce:evidenceDigest a rdf:Property ; rdfs:range xsd:string .
qce:policyDigest a rdf:Property ; rdfs:range xsd:string .
qce:generatorDigest a rdf:Property ; rdfs:range xsd:string .

qce:qualifies a rdf:Property .
qce:qualifiedBy a rdf:Property .
qce:freezes a rdf:Property .
qce:closureMember a rdf:Property .
qce:executedCapability a rdf:Property .
qce:observedEpisode a rdf:Property .
qce:proposesReplacement a rdf:Property .
qce:replacesCapability a rdf:Property .
qce:originalCapability a rdf:Property .
qce:replacementCapability a rdf:Property .
qce:substitutionReceipt a rdf:Property .
qce:retirementReceipt a rdf:Property .
qce:replayReceipt a rdf:Property .
qce:authorityEnvelope a rdf:Property .
qce:predecessorAuthority a rdf:Property .
qce:successorAuthority a rdf:Property .
qce:residualWork a rdf:Property .

qce:admitted a rdf:Property ; rdfs:range xsd:boolean .
qce:frozen a rdf:Property ; rdfs:range xsd:boolean .
qce:grantsDoAuthority a rdf:Property ; rdfs:range xsd:boolean .
qce:consequencePreserved a rdf:Property ; rdfs:range xsd:boolean .
qce:replayVerified a rdf:Property ; rdfs:range xsd:boolean .
qce:independentVerification a rdf:Property ; rdfs:range xsd:boolean .
qce:humanWorkBefore a rdf:Property ; rdfs:range xsd:decimal .
qce:humanWorkAfter a rdf:Property ; rdfs:range xsd:decimal .
qce:exceptionWork a rdf:Property ; rdfs:range xsd:decimal .
qce:verificationWork a rdf:Property ; rdfs:range xsd:decimal .
qce:correctionWork a rdf:Property ; rdfs:range xsd:decimal .
qce:maintenanceWork a rdf:Property ; rdfs:range xsd:decimal .
qce:netHumanWorkDelta a rdf:Property ; rdfs:range xsd:decimal .
qce:delegationDepth a rdf:Property ; rdfs:range xsd:integer .
qce:authorityCeiling a rdf:Property .
qce:authorityScope a rdf:Property .
