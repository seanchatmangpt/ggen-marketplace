@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qce:CapabilityVersionShape a sh:NodeShape ;
  sh:targetClass qce:CapabilityVersion ;
  sh:property [ sh:path qce:subjectRepository ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path qce:subjectCommit ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{40}$" ] ;
  sh:property [ sh:path qce:artifactDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^(sha256:)?[0-9a-f]{64}$" ] ;
  sh:property [ sh:path qce:grantsDoAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] .

qce:QualificationReceiptShape a sh:NodeShape ;
  sh:targetClass qce:QualificationReceipt ;
  sh:property [ sh:path qce:qualifies ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path qce:qualificationDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^(sha256:)?[0-9a-f]{64}$" ] ;
  sh:property [ sh:path qce:independentVerification ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] .

qce:ExecutionClosureShape a sh:NodeShape ;
  sh:targetClass qce:ExecutionClosure ;
  sh:property [ sh:path qce:closureDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^(sha256:)?[0-9a-f]{64}$" ] ;
  sh:property [ sh:path qce:closureMember ; sh:minCount 1 ] .

qce:RetirementReceiptShape a sh:NodeShape ;
  sh:targetClass qce:RetirementReceipt ;
  sh:property [ sh:path qce:netHumanWorkDelta ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:maxExclusive 0 ] ;
  sh:property [ sh:path qce:replayReceipt ; sh:minCount 1 ; sh:maxCount 1 ] .
