---
to: "qualified-capability-runtime-manifest.json"
sparql:
  rows: |
    PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
    SELECT ?capability ?repo ?sha ?artifactDigest ?closureDigest ?authorityDigest WHERE {
      ?capability a qce:FrozenCapability ;
        qce:subjectRepository ?repo ;
        qce:subjectCommit ?sha ;
        qce:artifactDigest ?artifactDigest ;
        qce:authorityEnvelope ?authority .
      ?closure a qce:ExecutionClosure ;
        qce:closureMember ?capability ;
        qce:closureDigest ?closureDigest .
      ?authority qce:authorityDigest ?authorityDigest .
    }
    ORDER BY ?repo ?sha ?capability
---
{
  "schema": "ggen.qualified-capability-runtime-manifest/1",
  "authority": "none",
  "generated": true,
  "rows": [
{% for row in results %}
    {
      "capability": "{{ row.capability }}",
      "repository": "{{ row.repo }}",
      "commit": "{{ row.sha }}",
      "artifact_digest": "{{ row.artifactDigest }}",
      "closure_digest": "{{ row.closureDigest }}",
      "authority_digest": "{{ row.authorityDigest }}"
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}
