PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?receipt ?before ?after WHERE {
  ?receipt a qce:SubstitutionReceipt ;
    qce:predecessorAuthority ?p ;
    qce:successorAuthority ?s .
  ?p qce:delegationDepth ?before .
  ?s qce:delegationDepth ?after .
  FILTER (xsd:integer(?after) > xsd:integer(?before))
}
