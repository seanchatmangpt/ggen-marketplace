PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?capability ?delta WHERE {
  ?capability a qce:RetiredCapability ; qce:retirementReceipt ?receipt .
  ?receipt a qce:RetirementReceipt .
  OPTIONAL { ?receipt qce:netHumanWorkDelta ?delta }
  FILTER (!BOUND(?delta) || xsd:decimal(?delta) >= 0)
}
