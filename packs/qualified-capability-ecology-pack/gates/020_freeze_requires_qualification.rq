PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
SELECT ?capability WHERE {
  ?capability a qce:FrozenCapability .
  FILTER NOT EXISTS {
    ?receipt a qce:QualificationReceipt ;
      qce:qualifies ?capability ;
      qce:qualificationDigest ?qd ;
      qce:independentVerification true .
  }
}
