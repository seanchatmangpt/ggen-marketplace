PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
SELECT ?claim WHERE {
  ?claim a qce:SubstitutionClaim .
  FILTER (
    NOT EXISTS { ?claim qce:originalCapability ?original } ||
    NOT EXISTS { ?claim qce:replacementCapability ?replacement } ||
    NOT EXISTS {
      ?claim qce:substitutionReceipt ?receipt .
      ?receipt a qce:SubstitutionReceipt ;
        qce:consequencePreserved true ;
        qce:replayVerified true ;
        qce:receiptDigest ?digest .
    }
  )
}
