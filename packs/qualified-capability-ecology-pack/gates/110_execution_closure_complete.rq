# MESSAGE: An execution closure must carry exactly one sha256 closureDigest and at least one closureMember.
PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
SELECT ?closure WHERE {
  ?closure a qce:ExecutionClosure .
  FILTER (
    NOT EXISTS { ?closure qce:closureDigest ?d0 } ||
    EXISTS { ?closure qce:closureDigest ?d1 . ?closure qce:closureDigest ?d2 . FILTER(?d1 != ?d2) } ||
    EXISTS { ?closure qce:closureDigest ?d3 . FILTER(!REGEX(STR(?d3), "^(sha256:)?[0-9a-f]{64}$")) } ||
    NOT EXISTS { ?closure qce:closureMember ?m0 }
  )
}
