PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
SELECT ?candidate WHERE {
  ?candidate a qce:CapabilityCandidate .
  FILTER (
    NOT EXISTS { ?candidate qce:subjectRepository ?repo } ||
    NOT EXISTS { ?candidate qce:subjectCommit ?sha . FILTER(REGEX(STR(?sha), "^[0-9a-f]{40}$")) } ||
    NOT EXISTS { ?candidate qce:artifactDigest ?digest . FILTER(REGEX(STR(?digest), "^(sha256:)?[0-9a-f]{64}$")) }
  )
}
