PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
SELECT ?receipt WHERE {
  VALUES ?type { qce:QualificationReceipt qce:SubstitutionReceipt qce:RetirementReceipt }
  ?receipt a ?type .
  FILTER NOT EXISTS {
    ?receipt qce:replayReceipt ?replay .
    ?replay a qce:ReplayReceipt ;
      qce:replayDigest ?digest ;
      qce:replayVerified true .
  }
}
