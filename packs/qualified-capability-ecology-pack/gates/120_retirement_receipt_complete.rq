# MESSAGE: A retirement receipt must carry exactly one decimal netHumanWorkDelta below zero and exactly one replayReceipt.
PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?receipt WHERE {
  ?receipt a qce:RetirementReceipt .
  FILTER (
    NOT EXISTS { ?receipt qce:netHumanWorkDelta ?n0 } ||
    EXISTS { ?receipt qce:netHumanWorkDelta ?n1 . ?receipt qce:netHumanWorkDelta ?n2 . FILTER(?n1 != ?n2) } ||
    EXISTS { ?receipt qce:netHumanWorkDelta ?n3 . FILTER(datatype(?n3) != xsd:decimal || ?n3 >= 0) } ||
    NOT EXISTS { ?receipt qce:replayReceipt ?r0 } ||
    EXISTS { ?receipt qce:replayReceipt ?r1 . ?receipt qce:replayReceipt ?r2 . FILTER(?r1 != ?r2) }
  )
}
