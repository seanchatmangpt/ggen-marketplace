@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
qce:SupplierProfile a rdfs:Class, prov:Entity .
qce:SupplierObservation a rdfs:Class, prov:Entity .
qce:SupplierSelection a rdfs:Class, prov:Entity .
qce:SupplierSelectionReceipt a rdfs:Class, prov:Entity .
qce:WorkloadIdentity a rdfs:Class, prov:Entity .
qce:supplier a rdf:Property .
qce:selectedSupplier a rdf:Property .
qce:observedSupplier a rdf:Property .
qce:workload a rdf:Property .
qce:workloadDigest a rdf:Property ; rdfs:range xsd:string .
qce:outputDigest a rdf:Property ; rdfs:range xsd:string .
qce:verifierDigest a rdf:Property ; rdfs:range xsd:string .
qce:selectionReceipt a rdf:Property .
qce:intelligenceRank a rdf:Property ; rdfs:range xsd:integer .
qce:equivalentOutcome a rdf:Property ; rdfs:range xsd:boolean .
qce:independentVerifier a rdf:Property ; rdfs:range xsd:boolean .
