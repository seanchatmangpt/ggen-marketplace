@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix ex: <https://example.test/qce/> .
ex:r a qce:SubstitutionReceipt ;
  qce:consequencePreserved false ;
  qce:replayVerified true ;
  qce:receiptDigest "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" .
ex:c a qce:SubstitutionClaim ;
  qce:originalCapability ex:a ;
  qce:replacementCapability ex:b ;
  qce:substitutionReceipt ex:r .
