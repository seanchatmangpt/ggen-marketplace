@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix ex: <https://example.test/qce/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:cap-v1 a qce:CapabilityCandidate, qce:QualifiedCapability, qce:FrozenCapability ;
  qce:subjectRepository "seanchatmangpt/example" ;
  qce:subjectCommit "0123456789abcdef0123456789abcdef01234567" ;
  qce:artifactDigest "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
  qce:frozen true ;
  qce:grantsDoAuthority false ;
  qce:authorityEnvelope ex:auth-v1 .

ex:auth-v1 a qce:AuthorityEnvelope ;
  qce:authorityDigest "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
  qce:delegationDepth 2 .

ex:replay-q a qce:ReplayReceipt ;
  qce:replayDigest "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" ;
  qce:replayVerified true .

ex:qual-q a qce:QualificationReceipt ;
  qce:qualifies ex:cap-v1 ;
  qce:qualificationDigest "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" ;
  qce:independentVerification true ;
  qce:replayReceipt ex:replay-q .

ex:closure a qce:ExecutionClosure ;
  qce:closureMember ex:cap-v1 ;
  qce:closureDigest "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" .

ex:episode a qce:RuntimeEpisode ;
  qce:executedCapability ex:cap-v1 ;
  qce:grantsDoAuthority false .

ex:proposal a qce:EvolutionProposal ;
  qce:proposesReplacement ex:cap-v2 ;
  qce:grantsDoAuthority false .

ex:cap-v2 a qce:CapabilityCandidate, qce:QualifiedCapability, qce:FrozenCapability ;
  qce:subjectRepository "seanchatmangpt/example" ;
  qce:subjectCommit "89abcdef0123456789abcdef0123456789abcdef" ;
  qce:artifactDigest "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" ;
  qce:frozen true ;
  qce:grantsDoAuthority false ;
  qce:authorityEnvelope ex:auth-v2 .

ex:auth-v2 a qce:AuthorityEnvelope ;
  qce:authorityDigest "1111111111111111111111111111111111111111111111111111111111111111" ;
  qce:delegationDepth 2 .

ex:replay-q2 a qce:ReplayReceipt ;
  qce:replayDigest "2222222222222222222222222222222222222222222222222222222222222222" ;
  qce:replayVerified true .

ex:qual-q2 a qce:QualificationReceipt ;
  qce:qualifies ex:cap-v2 ;
  qce:qualificationDigest "3333333333333333333333333333333333333333333333333333333333333333" ;
  qce:independentVerification true ;
  qce:replayReceipt ex:replay-q2 .

ex:replay-sub a qce:ReplayReceipt ;
  qce:replayDigest "4444444444444444444444444444444444444444444444444444444444444444" ;
  qce:replayVerified true .

ex:sub-receipt a qce:SubstitutionReceipt ;
  qce:consequencePreserved true ;
  qce:replayVerified true ;
  qce:receiptDigest "5555555555555555555555555555555555555555555555555555555555555555" ;
  qce:predecessorAuthority ex:auth-v1 ;
  qce:successorAuthority ex:auth-v2 ;
  qce:replayReceipt ex:replay-sub .

ex:claim a qce:SubstitutionClaim ;
  qce:originalCapability ex:cap-v1 ;
  qce:replacementCapability ex:cap-v2 ;
  qce:substitutionReceipt ex:sub-receipt .

ex:replay-retire a qce:ReplayReceipt ;
  qce:replayDigest "6666666666666666666666666666666666666666666666666666666666666666" ;
  qce:replayVerified true .

ex:retire-r a qce:RetirementReceipt ;
  qce:netHumanWorkDelta "-12.5"^^xsd:decimal ;
  qce:replayReceipt ex:replay-retire .

ex:retired-v1 a qce:RetiredCapability ;
  qce:retirementReceipt ex:retire-r .
