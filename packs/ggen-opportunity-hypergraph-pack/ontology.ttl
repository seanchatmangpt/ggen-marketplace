@prefix ogh: <https://ggen.dev/ontology/opportunity-hypergraph#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ogh:Capability a rdfs:Class .
ogh:CompositionCandidate a rdfs:Class .
ogh:OpportunityLedger a rdfs:Class .

ogh:memberCapability a rdf:Property .
ogh:candidateId a rdf:Property .
ogh:arity a rdf:Property .
ogh:repository a rdf:Property .
ogh:marketplaceSupport a rdf:Property .
ogh:missingPrimitive a rdf:Property .
ogh:qualification a rdf:Property .
ogh:reversible a rdf:Property .
ogh:expectedReuse a rdf:Property .
ogh:expectedCapabilitySpaceDelta a rdf:Property .
ogh:dominanceClass a rdf:Property .
ogh:sourceObservation a rdf:Property .
ogh:actionableObservationCount a rdf:Property .
ogh:authority a rdf:Property .
ogh:actuationPerformed a rdf:Property .

ogh:R21Ledger a ogh:OpportunityLedger, prov:Entity ;
  dcterms:title "R21 reversible opportunity-capital ledger" ;
  ogh:actionableObservationCount 3 ;
  ogh:sourceObservation ogh:R19CapitalAccounting, ogh:R19bCapitalFrontier, ogh:R20ObservabilityFactory ;
  ogh:authority "OBSERVE|VERIFY|CONSTRUCT" ;
  ogh:actuationPerformed false .

ogh:R19CapitalAccounting a ogh:Capability ; skos:notation "r19-capital-accounting" .
ogh:R19bCapitalFrontier a ogh:Capability ; skos:notation "r19b-capital-frontier" .
ogh:R20ObservabilityFactory a ogh:Capability ; skos:notation "r20-observability-factory" .
ogh:GgenDeterministicRuntime a ogh:Capability ; skos:notation "ggen-deterministic-runtime" .
ogh:MarketplacePackCorpus a ogh:Capability ; skos:notation "marketplace-pack-corpus" .
ogh:PublicOntologyProjection a ogh:Capability ; skos:notation "public-ontology-projection" .

ogh:C01 a ogh:CompositionCandidate ; ogh:candidateId "C01" ; ogh:arity 2 ; ogh:memberCapability ogh:R19CapitalAccounting, ogh:R20ObservabilityFactory ; ogh:repository "seanchatmangpt/ggen-marketplace" ; ogh:marketplaceSupport "extend:ggen-project-boundary-pack" ; ogh:missingPrimitive "none" ; ogh:qualification "projection+court" ; ogh:reversible true ; ogh:expectedReuse 8 ; ogh:expectedCapabilitySpaceDelta 2 ; ogh:dominanceClass "pareto" .
ogh:C02 a ogh:CompositionCandidate ; ogh:candidateId "C02" ; ogh:arity 2 ; ogh:memberCapability ogh:R19bCapitalFrontier, ogh:R20ObservabilityFactory ; ogh:repository "seanchatmangpt/ggen-marketplace" ; ogh:marketplaceSupport "new:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "none" ; ogh:qualification "projection+court" ; ogh:reversible true ; ogh:expectedReuse 8 ; ogh:expectedCapabilitySpaceDelta 3 ; ogh:dominanceClass "pareto" .
ogh:C03 a ogh:CompositionCandidate ; ogh:candidateId "C03" ; ogh:arity 3 ; ogh:memberCapability ogh:PublicOntologyProjection, ogh:GgenDeterministicRuntime, ogh:MarketplacePackCorpus ; ogh:repository "seanchatmangpt/ggen-marketplace" ; ogh:marketplaceSupport "new:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "none" ; ogh:qualification "pack-qualification" ; ogh:reversible true ; ogh:expectedReuse 10 ; ogh:expectedCapabilitySpaceDelta 5 ; ogh:dominanceClass "pareto" .
ogh:C04 a ogh:CompositionCandidate ; ogh:candidateId "C04" ; ogh:arity 3 ; ogh:memberCapability ogh:R19CapitalAccounting, ogh:R19bCapitalFrontier, ogh:R20ObservabilityFactory ; ogh:repository "seanchatmangpt/ggen-marketplace" ; ogh:marketplaceSupport "new:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "none" ; ogh:qualification "differential-court" ; ogh:reversible true ; ogh:expectedReuse 10 ; ogh:expectedCapabilitySpaceDelta 6 ; ogh:dominanceClass "pareto" .
ogh:C05 a ogh:CompositionCandidate ; ogh:candidateId "C05" ; ogh:arity 2 ; ogh:memberCapability ogh:R19bCapitalFrontier, ogh:GgenDeterministicRuntime ; ogh:repository "seanchatmangpt/ggen" ; ogh:marketplaceSupport "consume:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "consumer-adapter" ; ogh:qualification "prototype" ; ogh:reversible true ; ogh:expectedReuse 7 ; ogh:expectedCapabilitySpaceDelta 4 ; ogh:dominanceClass "candidate" .
ogh:C06 a ogh:CompositionCandidate ; ogh:candidateId "C06" ; ogh:arity 3 ; ogh:memberCapability ogh:R20ObservabilityFactory, ogh:GgenDeterministicRuntime, ogh:PublicOntologyProjection ; ogh:repository "seanchatmangpt/ggen" ; ogh:marketplaceSupport "consume:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "exact-subject-binding" ; ogh:qualification "prototype" ; ogh:reversible true ; ogh:expectedReuse 9 ; ogh:expectedCapabilitySpaceDelta 5 ; ogh:dominanceClass "pareto" .
ogh:C07 a ogh:CompositionCandidate ; ogh:candidateId "C07" ; ogh:arity 3 ; ogh:memberCapability ogh:R19CapitalAccounting, ogh:MarketplacePackCorpus, ogh:PublicOntologyProjection ; ogh:repository "seanchatmangpt/ggen-marketplace" ; ogh:marketplaceSupport "new:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "none" ; ogh:qualification "projection+court" ; ogh:reversible true ; ogh:expectedReuse 9 ; ogh:expectedCapabilitySpaceDelta 4 ; ogh:dominanceClass "candidate" .
ogh:C08 a ogh:CompositionCandidate ; ogh:candidateId "C08" ; ogh:arity 4 ; ogh:memberCapability ogh:R19CapitalAccounting, ogh:R19bCapitalFrontier, ogh:R20ObservabilityFactory, ogh:PublicOntologyProjection ; ogh:repository "seanchatmangpt/ggen-marketplace" ; ogh:marketplaceSupport "new:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "none" ; ogh:qualification "frontier-court" ; ogh:reversible true ; ogh:expectedReuse 11 ; ogh:expectedCapabilitySpaceDelta 8 ; ogh:dominanceClass "pareto" .
ogh:C09 a ogh:CompositionCandidate ; ogh:candidateId "C09" ; ogh:arity 4 ; ogh:memberCapability ogh:R19bCapitalFrontier, ogh:R20ObservabilityFactory, ogh:GgenDeterministicRuntime, ogh:MarketplacePackCorpus ; ogh:repository "seanchatmangpt/ggen" ; ogh:marketplaceSupport "consume:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "runtime-command" ; ogh:qualification "prototype" ; ogh:reversible true ; ogh:expectedReuse 10 ; ogh:expectedCapabilitySpaceDelta 7 ; ogh:dominanceClass "candidate" .
ogh:C10 a ogh:CompositionCandidate ; ogh:candidateId "C10" ; ogh:arity 5 ; ogh:memberCapability ogh:R19CapitalAccounting, ogh:R19bCapitalFrontier, ogh:R20ObservabilityFactory, ogh:MarketplacePackCorpus, ogh:PublicOntologyProjection ; ogh:repository "seanchatmangpt/ggen-marketplace" ; ogh:marketplaceSupport "new:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "none" ; ogh:qualification "frontier-court" ; ogh:reversible true ; ogh:expectedReuse 12 ; ogh:expectedCapabilitySpaceDelta 10 ; ogh:dominanceClass "pareto" .
ogh:C11 a ogh:CompositionCandidate ; ogh:candidateId "C11" ; ogh:arity 5 ; ogh:memberCapability ogh:R19CapitalAccounting, ogh:R20ObservabilityFactory, ogh:GgenDeterministicRuntime, ogh:MarketplacePackCorpus, ogh:PublicOntologyProjection ; ogh:repository "seanchatmangpt/ggen" ; ogh:marketplaceSupport "consume:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "receipt-adapter" ; ogh:qualification "prototype" ; ogh:reversible true ; ogh:expectedReuse 11 ; ogh:expectedCapabilitySpaceDelta 9 ; ogh:dominanceClass "candidate" .
ogh:C12 a ogh:CompositionCandidate ; ogh:candidateId "C12" ; ogh:arity 6 ; ogh:memberCapability ogh:R19CapitalAccounting, ogh:R19bCapitalFrontier, ogh:R20ObservabilityFactory, ogh:GgenDeterministicRuntime, ogh:MarketplacePackCorpus, ogh:PublicOntologyProjection ; ogh:repository "seanchatmangpt/ggen" ; ogh:marketplaceSupport "consume:ggen-opportunity-hypergraph-pack" ; ogh:missingPrimitive "consumer-exact-subject-binding" ; ogh:qualification "prototype" ; ogh:reversible true ; ogh:expectedReuse 12 ; ogh:expectedCapabilitySpaceDelta 12 ; ogh:dominanceClass "pareto" .
