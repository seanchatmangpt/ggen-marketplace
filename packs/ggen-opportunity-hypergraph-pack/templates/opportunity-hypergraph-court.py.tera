import json
from pathlib import Path

manifest = json.loads(Path(__file__).with_name("opportunity-hypergraph.json").read_text())
observations = int(manifest["actionable_observation_count"])
candidates = int(manifest["candidate_count"])
max_arity = int(manifest["max_arity"])
delta = int(manifest["total_capability_space_delta"])
ids = [item for item in manifest["candidate_ids_csv"].split(",") if item]

assert observations > 0, observations
assert candidates >= 3 * observations, (candidates, observations)
assert len(set(ids)) == candidates, (len(set(ids)), candidates)
assert max_arity >= 3, max_arity
assert delta >= candidates, (delta, candidates)
assert "OBSERVE" in manifest["authority"]
assert "VERIFY" in manifest["authority"]
assert "CONSTRUCT" in manifest["authority"]
assert manifest["actuation_performed"] is False
assert manifest["manufacturing_law"].startswith("public ontology ->")
print(f"ALIVE:OPPORTUNITY_HYPERGRAPH:E2={candidates / observations:.2f}")
