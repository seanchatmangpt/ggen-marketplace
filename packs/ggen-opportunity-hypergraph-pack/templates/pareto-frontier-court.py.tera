import json
from pathlib import Path

manifest = json.loads(Path(__file__).with_name("pareto-frontier.json").read_text())
frontier = int(manifest["frontier_count"])
delta = int(manifest["frontier_capability_space_delta"])
reuse = int(manifest["max_expected_reuse"])
ids = [item for item in manifest["frontier_ids_csv"].split(",") if item]

assert frontier >= 6, frontier
assert len(set(ids)) == frontier, (len(set(ids)), frontier)
assert delta > frontier, (delta, frontier)
assert reuse >= 10, reuse
assert manifest["actuation_performed"] is False
assert "selection is downstream" in manifest["selection_policy"]
print(f"ALIVE:OPPORTUNITY_FRONTIER:size={frontier}:delta={delta}")
