# MESSAGE: projection missing required identity (subject, consumer, family, targetRepo, targetPath).
# Canonical archetype 010 for the merged adapter/fleet cluster. Absorbs:
# afm 010_required_identity; fm 010/020/030/040/050_guard; fp 010_required_identity/
# 030_target_repo/040_target_path; fpc 010_required_identity/030_target_repo/040_target_path;
# fr 010_required_identity. A row is a refusal.
PREFIX af: <https://ggen.dev/ontology/adapter-family#>
SELECT ?p WHERE {
  ?p a af:Projection .
  FILTER NOT EXISTS { ?p af:subject ?s ; af:consumer ?c ; af:family ?f ; af:targetRepo ?r ; af:targetPath ?path . }
}
ORDER BY ?p
