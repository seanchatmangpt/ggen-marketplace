# MESSAGE: projection carries an empty target repo, target path, or template key.
# Canonical archetype 080. Absorbs: fp 110_nonempty_repo + 120_nonempty_path +
# 130_nonempty_template; fr 080_template_key (strlen 0). A row is a refusal.
PREFIX af: <https://ggen.dev/ontology/adapter-family#>
SELECT ?p ?field WHERE {
  ?p a af:Projection .
  { ?p af:targetRepo ?field . FILTER(STR(?field) = "") }
  UNION
  { ?p af:targetPath ?field . FILTER(STR(?field) = "") }
  UNION
  { ?p af:templateKey ?field . FILTER(STR(?field) = "") }
}
ORDER BY ?p ?field
