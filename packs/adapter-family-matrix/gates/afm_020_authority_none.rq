# MESSAGE: projection without authority-NONE ceiling.
# Canonical archetype 020. Absorbs: afm 020_authority_none; fm 060_guard; fp 020_authority_none;
# fpc 020_authority_none; fr 020_authority_none. Covers both prior forms: authority missing
# AND authority present but not "NONE". Authority NONE = observation ceiling; BRCE remains
# the sole actuation boundary. A row is a refusal.
PREFIX af: <https://ggen.dev/ontology/adapter-family#>
SELECT ?p WHERE {
  ?p a af:Projection .
  FILTER NOT EXISTS { ?p af:authority "NONE" }
}
ORDER BY ?p
