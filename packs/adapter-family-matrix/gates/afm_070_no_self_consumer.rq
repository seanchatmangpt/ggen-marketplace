# MESSAGE: projection consumes itself (subject = consumer).
# Canonical archetype 070. Absorbs: afm 060_subject_consumer_boundary; fp 070_no_self_consumer.
# A row is a refusal.
PREFIX af: <https://ggen.dev/ontology/adapter-family#>
SELECT ?p WHERE {
  ?p a af:Projection ; af:subject ?s ; af:consumer ?c .
  FILTER(?s = ?c)
}
ORDER BY ?p
