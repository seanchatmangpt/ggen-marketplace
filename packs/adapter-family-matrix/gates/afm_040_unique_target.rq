# MESSAGE: duplicate projection target (repo, path) claimed by two projections.
# Canonical archetype 040. Absorbs: afm 040_unique_target; fm 080_guard; fp 080_unique_target;
# fpc 080_unique_target; fr 070_unique_target. Ordered pair emission prevents mirror dupes.
# A row is a refusal.
PREFIX af: <https://ggen.dev/ontology/adapter-family#>
SELECT ?a ?b ?repo ?path WHERE {
  ?a a af:Projection ; af:targetRepo ?repo ; af:targetPath ?path .
  ?b a af:Projection ; af:targetRepo ?repo ; af:targetPath ?path .
  FILTER(STR(?a) < STR(?b))
}
ORDER BY ?repo ?path ?a ?b
