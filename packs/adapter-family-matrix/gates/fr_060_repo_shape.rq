# MESSAGE: target repo is not owner/repo shaped (missing "/").
# Genuinely-unique conserved gate (not an archetype re-mint): only fleet-family-registry's
# 060_repo_shape carried this constraint. Conserved from packs/fleet-family-registry/
# gates/060_repo_shape.rq, expressed in canonical af: terms under conservation records.
# A row is a refusal.
PREFIX af: <https://ggen.dev/ontology/adapter-family#>
SELECT ?p ?r WHERE {
  ?p a af:Projection ; af:targetRepo ?r .
  FILTER(!CONTAINS(STR(?r), "/"))
}
ORDER BY ?p ?r
