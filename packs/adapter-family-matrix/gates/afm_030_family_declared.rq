# MESSAGE: projection family not a declared AdapterFamily with a template key.
# Canonical archetype 030. Absorbs: afm 030_template_exists; fm 070_guard; fp 090_family_declared;
# fpc 060_family_declared; fr 030_family_registered + 080_template_key. A row is a refusal.
PREFIX af: <https://ggen.dev/ontology/adapter-family#>
SELECT ?p ?f WHERE {
  ?p a af:Projection ; af:family ?f .
  FILTER NOT EXISTS { ?f a af:AdapterFamily ; af:templateKey ?k . }
}
ORDER BY ?p ?f
