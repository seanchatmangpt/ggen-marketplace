# MESSAGE: projection without an exact 40-hex source SHA.
# Canonical archetype 050. Absorbs: afm 050_source_sha; fp 060_source_sha + 140_sha_shape;
# fpc 050_source_sha. Failed edge conserved: fleet-package-compose's re-minted 050 was
# inverted (it fired on VALID SHAs — packs/fleet-package-compose/gates/050_source_sha.rq);
# the canonical form here fires on missing or malformed SHA only. A row is a refusal.
PREFIX af: <https://ggen.dev/ontology/adapter-family#>
SELECT ?p WHERE {
  ?p a af:Projection .
  FILTER NOT EXISTS { ?p af:sourceSha ?sha . FILTER(REGEX(STR(?sha), "^[0-9a-f]{40}$")) }
}
ORDER BY ?p
