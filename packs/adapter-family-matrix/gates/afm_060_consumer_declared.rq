# MESSAGE: projection consumer not declared as an af:Consumer.
# Canonical archetype 060. Absorbs: fp 100_consumer_declared; fpc 070_consumer_declared.
# A row is a refusal.
PREFIX af: <https://ggen.dev/ontology/adapter-family#>
SELECT ?p ?c WHERE {
  ?p a af:Projection ; af:consumer ?c .
  FILTER NOT EXISTS { ?c a af:Consumer . }
}
ORDER BY ?p ?c
