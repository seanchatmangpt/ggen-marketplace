---
to: "{{ path }}"
for_each: "dispatch"
sparql:
  dispatch: |
    PREFIX af: <https://ggen.dev/ontology/adapter-family#>
    SELECT ?projection ?subject ?consumer ?family ?repo ?path ?template WHERE {
      ?projection a af:Projection; af:subject ?subject; af:consumer ?consumer; af:family ?family; af:targetRepo ?repo; af:targetPath ?path.
      ?family af:templateKey ?template.
      FILTER(?template = "elixir")
    } ORDER BY ?subject ?consumer ?family ?path
---
# generated elixir adapter
# subject={{ subject }} consumer={{ consumer }}
# authority=NONE
{{ body | default(value="") }}