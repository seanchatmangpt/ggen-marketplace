# Namespace-level conservation records for the v26.9.30 adapter/fleet consolidation
# (7 packs -> 1 + profile). Canonical namespace: af: <https://ggen.dev/ontology/adapter-family#>.
# The five absorbed namespaces are NOT silently renamed: their vocabulary declarations
# survive verbatim in ontology/<absorbed-pack>.ttl with owl:equivalentClass /
# owl:equivalentProperty mappings onto af: terms, and each namespace is recorded here
# as replaced. Per-pack provenance, asset disposition and failed edges live in
# families/<absorbed-pack>.md. fleet-projection-closure (fp:
# <https://ggen.dev/ontology/fleet-projection#>) is NOT absorbed: it stays a separate
# profile pack holding exact-subject instance data.
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://chatmangpt.com/ontology/adapter-family-registry#>
    dcterms:isReplacedBy <https://ggen.dev/ontology/adapter-family#> ;
    rdfs:label "adapter-family-registry namespace (absorbed 2026-09-30, was packs/adapter-family-registry)" .

<https://ggen.dev/ontology/fleet-matrix#>
    dcterms:isReplacedBy <https://ggen.dev/ontology/adapter-family#> ;
    rdfs:label "fleet-adapter-matrix namespace (absorbed 2026-09-30, was packs/fleet-adapter-matrix)" .

<https://ggen.dev/ontology/fleet-package#>
    dcterms:isReplacedBy <https://ggen.dev/ontology/adapter-family#> ;
    rdfs:label "fleet-package-compiler namespace (absorbed 2026-09-30, was packs/fleet-package-compiler)" .

<https://chatman.ai/fleet-package-compose#>
    dcterms:isReplacedBy <https://ggen.dev/ontology/adapter-family#> ;
    rdfs:label "fleet-package-compose namespace (absorbed 2026-09-30, was packs/fleet-package-compose)" .

<https://ggen.dev/fleet-family-registry#>
    dcterms:isReplacedBy <https://ggen.dev/ontology/adapter-family#> ;
    rdfs:label "fleet-family-registry namespace (absorbed 2026-09-30, was packs/fleet-family-registry)" .
