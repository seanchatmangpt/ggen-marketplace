# Conserved vocabulary module: fleet-package-compiler (fp:), absorbed 2026-09-30.
# Declarations from packs/fleet-package-compiler/ontology.ttl v0.1.0; equivalence axioms
# map every term onto the canonical af: namespace. fp:PackagePlan facts carried exactly
# the af:Projection property set (subject/consumer/family/targetRepo/targetPath/
# templateKey/authority/sourceSha), so the class maps wholesale. fp:mode ("CONSTRUCT_ONLY")
# was the pack-level fence carried from its retired ggen.toml [metadata] table; the merged
# pack's ceiling is <urn:pack:adapter-family-matrix> af:authority "NONE" (root ontology.ttl).
@prefix fp: <https://ggen.dev/ontology/fleet-package#> .
@prefix af: <https://ggen.dev/ontology/adapter-family#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

fp:PackagePlan a owl:Class ; owl:equivalentClass af:Projection .
fp:Family a owl:Class ; owl:equivalentClass af:AdapterFamily .
fp:Consumer a owl:Class ; owl:equivalentClass af:Consumer .
fp:subject a owl:ObjectProperty ; owl:equivalentProperty af:subject .
fp:consumer a owl:ObjectProperty ; owl:equivalentProperty af:consumer .
fp:family a owl:ObjectProperty ; owl:equivalentProperty af:family .
fp:targetRepo a owl:DatatypeProperty ; owl:equivalentProperty af:targetRepo .
fp:targetPath a owl:DatatypeProperty ; owl:equivalentProperty af:targetPath .
fp:templateKey a owl:DatatypeProperty ; owl:equivalentProperty af:templateKey .
fp:authority a owl:DatatypeProperty ; owl:equivalentProperty af:authority .
fp:sourceSha a owl:DatatypeProperty ; owl:equivalentProperty af:sourceSha .
fp:mode a owl:DatatypeProperty ;
    rdfs:seeAlso <urn:pack:adapter-family-matrix> ;
    dcterms:description "Retired pack-mode fence: superseded by the merged pack's af:authority NONE ceiling; no af: equivalent by design." .
