# Conserved vocabulary module: fleet-package-compose (fpc:), absorbed 2026-09-30.
# Declarations from packs/fleet-package-compose/ontology.ttl v26.9.27; equivalence axioms
# map every term onto the canonical af: namespace. fpc: used its own metaclasses
# (fpc:Class, fpc:Property) where every other pack used rdfs:Class / rdf:Property —
# recorded as metaclass mappings, not domain terms.
@prefix fpc: <https://chatman.ai/fleet-package-compose#> .
@prefix af: <https://ggen.dev/ontology/adapter-family#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

fpc:Subject a fpc:Class ; owl:equivalentClass af:Subject .
fpc:Consumer a fpc:Class ; owl:equivalentClass af:Consumer .
fpc:AdapterFamily a fpc:Class ; owl:equivalentClass af:AdapterFamily .
fpc:Projection a fpc:Class ; owl:equivalentClass af:Projection .
fpc:Class rdfs:subClassOf rdfs:Class .
fpc:Property rdfs:subClassOf rdf:Property .
fpc:subject a fpc:Property ; owl:equivalentProperty af:subject .
fpc:consumer a fpc:Property ; owl:equivalentProperty af:consumer .
fpc:family a fpc:Property ; owl:equivalentProperty af:family .
fpc:targetRepo a fpc:Property ; owl:equivalentProperty af:targetRepo .
fpc:targetPath a fpc:Property ; owl:equivalentProperty af:targetPath .
fpc:templateKey a fpc:Property ; owl:equivalentProperty af:templateKey .
fpc:sourceSha a fpc:Property ; owl:equivalentProperty af:sourceSha .
fpc:authority a fpc:Property ; owl:equivalentProperty af:authority .

# Pack-level authority fence (carried over from the retired ggen.toml [pack] authority key).
<https://chatman.ai/fleet-package-compose> fpc:authority "NONE" .
