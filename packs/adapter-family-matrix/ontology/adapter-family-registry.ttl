# Conserved vocabulary module: adapter-family-registry (afr:), absorbed 2026-09-30.
# Declarations verbatim from packs/adapter-family-registry/ontology.ttl v0.1.1;
# equivalence axioms map every term onto the canonical af: namespace. No silent rename.
@prefix afr: <https://chatmangpt.com/ontology/adapter-family-registry#> .
@prefix af: <https://ggen.dev/ontology/adapter-family#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

afr:Subject a rdfs:Class ; owl:equivalentClass af:Subject .
afr:Consumer a rdfs:Class ; owl:equivalentClass af:Consumer .
afr:AdapterFamily a rdfs:Class ; owl:equivalentClass af:AdapterFamily .
afr:Projection a rdfs:Class ; owl:equivalentClass af:Projection .
afr:subject a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range afr:Subject ; owl:equivalentProperty af:subject .
afr:consumer a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range afr:Consumer ; owl:equivalentProperty af:consumer .
afr:adapterFamily a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range afr:AdapterFamily ; owl:equivalentProperty af:family .
afr:targetPath a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range xsd:string ; owl:equivalentProperty af:targetPath .
afr:moduleName a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range xsd:string ; owl:equivalentProperty af:moduleName .
afr:packageName a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range xsd:string ; owl:equivalentProperty af:packageName .
afr:templateKey a rdf:Property ; rdfs:domain afr:AdapterFamily ; rdfs:range xsd:string ; owl:equivalentProperty af:templateKey .
afr:mediaType a rdf:Property ; rdfs:domain afr:AdapterFamily ; rdfs:range xsd:string ; owl:equivalentProperty af:mediaType .
