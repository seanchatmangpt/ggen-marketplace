@prefix af: <https://ggen.dev/ontology/adapter-family#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
af:Projection a rdf:Class . af:AdapterFamily a rdf:Class . af:Consumer a rdf:Class .
af:Subject a rdf:Class .
af:subject a rdf:Property . af:consumer a rdf:Property . af:family a rdf:Property .
af:targetRepo a rdf:Property . af:targetPath a rdf:Property . af:templateKey a rdf:Property .
af:artifactKind a rdf:Property . af:authority a rdf:Property . af:sourceSha a rdf:Property .
# Terms added by the v26.9.30 absorption (canonical homes for conserved vocabulary
# from adapter-family-registry afr:, fleet-adapter-matrix fm:, fleet-package-compiler fp:,
# fleet-package-compose fpc:, fleet-family-registry fr: — see ontology/conservation.ttl
# and families/<absorbed-pack>.md for the term-by-term mapping).
af:moduleName a rdf:Property . af:packageName a rdf:Property . af:mediaType a rdf:Property .
af:name a rdf:Property . af:fileExtension a rdf:Property .
af:templatePath a rdf:Property . af:deterministic a rdf:Property .

# Pack-level authority ceiling (formerly pack.toml authority key).
<urn:pack:adapter-family-matrix> af:authority "NONE" .
