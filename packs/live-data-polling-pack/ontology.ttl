@prefix pack: <urn:ggen-marketplace:live-data-polling-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pack:UseLiveData a pack:ReactHook ;
    rdfs:label "useLiveData" ;
    pack:transport "SWR polling, upgradeable to WebSocket" ;
    pack:mutatesLayout false ;
    pack:updatesEntityState true ;
    pack:updatesEdgeState true ;
    rdfs:comment "Fetches entities+edges on an interval via SWR; only size/color/arc-relevant fields change between polls, positions are recomputed by the caller's own memoized computeLayout call, not inside this hook." .
