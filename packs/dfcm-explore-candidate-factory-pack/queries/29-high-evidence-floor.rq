PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?evidence ?novelty ?rollback WHERE {
  ?candidate a dfcm:Candidate ; dfcm:ctqEvidence ?evidence ; dfcm:ctqNovelty ?novelty ; dfcm:ctqRollback ?rollback .
  FILTER(?evidence >= 5)
} ORDER BY DESC(?novelty) DESC(?rollback) STR(?candidate)
