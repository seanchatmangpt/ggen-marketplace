PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?family ?rollback ?novelty WHERE {
  ?candidate a dfcm:Candidate ; dfcm:family ?family ; dfcm:ctqRollback ?rollback ; dfcm:ctqNovelty ?novelty .
  FILTER(?rollback <= 4)
} ORDER BY DESC(?novelty) ?family STR(?candidate)
