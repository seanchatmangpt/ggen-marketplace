PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?novelty ?rollback WHERE { ?candidate a dfcm:Candidate ; dfcm:ctqNovelty ?novelty ; dfcm:ctqRollback ?rollback . FILTER NOT EXISTS { ?other a dfcm:Candidate ; dfcm:ctqNovelty ?on ; dfcm:ctqRollback ?or . FILTER((?on>=?novelty && ?or>=?rollback) && (?on>?novelty || ?or>?rollback)) } }
ORDER BY DESC(?novelty) DESC(?rollback)