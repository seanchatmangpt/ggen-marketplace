PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?evidence ?rollback WHERE {
  ?candidate a dfcm:Candidate ; dfcm:ctqEvidence ?evidence ; dfcm:ctqRollback ?rollback .
  FILTER NOT EXISTS {
    ?other a dfcm:Candidate ; dfcm:ctqEvidence ?oe ; dfcm:ctqRollback ?or .
    FILTER((?oe >= ?evidence && ?or >= ?rollback) && (?oe > ?evidence || ?or > ?rollback))
  }
}
ORDER BY DESC(?evidence) DESC(?rollback)