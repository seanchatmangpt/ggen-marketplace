PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?novelty ?evidence WHERE {
 ?candidate a dfcm:Candidate ; dfcm:ctqNovelty ?novelty ; dfcm:ctqEvidence ?evidence .
 FILTER NOT EXISTS { ?other a dfcm:Candidate ; dfcm:ctqNovelty ?on ; dfcm:ctqEvidence ?oe . FILTER((?on>=?novelty && ?oe>=?evidence) && (?on>?novelty || ?oe>?evidence)) }
}
ORDER BY DESC(?novelty) DESC(?evidence)