PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?family ?evidence ?rollback WHERE {
  ?candidate a dfcm:Candidate ; dfcm:family ?family ; dfcm:ctqEvidence ?evidence ; dfcm:ctqRollback ?rollback .
  FILTER(?evidence >= 5 && ?rollback >= 5)
} ORDER BY ?family STR(?candidate)
