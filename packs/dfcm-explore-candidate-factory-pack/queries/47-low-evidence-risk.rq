PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?family ?evidence ?novelty WHERE {
  ?candidate a dfcm:Candidate ; dfcm:family ?family ; dfcm:ctqEvidence ?evidence ; dfcm:ctqNovelty ?novelty .
  FILTER(?evidence <= 3)
} ORDER BY DESC(?novelty) ?family STR(?candidate)
