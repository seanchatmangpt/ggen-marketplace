PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?dependency WHERE {
  ?candidate a dfcm:Candidate ; dfcm:dependency ?dependency .
  FILTER NOT EXISTS { ?other a dfcm:Candidate ; dfcm:dependency ?dependency . FILTER(?other != ?candidate) }
} ORDER BY ?dependency STR(?candidate)
