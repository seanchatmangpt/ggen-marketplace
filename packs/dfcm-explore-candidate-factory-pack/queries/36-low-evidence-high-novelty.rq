PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?family ?novelty ?evidence ?falsifier WHERE { ?candidate a dfcm:Candidate ; dfcm:family ?family ; dfcm:ctqNovelty ?novelty ; dfcm:ctqEvidence ?evidence ; dfcm:falsifier ?falsifier . FILTER(?novelty = 5 && ?evidence <= 3) }
ORDER BY ?evidence ?family