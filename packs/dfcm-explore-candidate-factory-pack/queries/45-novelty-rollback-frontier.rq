PREFIX dfcm: <https://seanchatmangpt.github.io/ggen-marketplace/dfcm/explore#>
SELECT ?candidate ?novelty ?rollback WHERE {
  ?candidate a dfcm:Candidate ; dfcm:ctqNovelty ?novelty ; dfcm:ctqRollback ?rollback .
  FILTER NOT EXISTS { ?other a dfcm:Candidate ; dfcm:ctqNovelty ?n2 ; dfcm:ctqRollback ?r2 . FILTER((?n2>=?novelty && ?r2>=?rollback) && (?n2>?novelty || ?r2>?rollback)) }
} ORDER BY DESC(?novelty) DESC(?rollback) STR(?candidate)
