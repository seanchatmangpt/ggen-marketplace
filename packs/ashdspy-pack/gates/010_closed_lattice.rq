# MESSAGE: closed-lattice violation -- an Implementation whose class is
# outside the 8 lattice subclasses (ashdspy:Reuse/Compose/Rule/Plan/
# Constraint/Generate/SpecializedModel/LLM) is a violation row naming it.
# Two unlawful forms: (A) a node typed with the BARE base class
# ashdspy:Implementation carrying no lattice subclass typing, (B) a node
# referenced by ashdspy:routeImplementation (a route already selected it)
# that carries no lattice typing at all. An implementation outside the
# lattice has no precedence, so the KNOWN => Allocation_LLM = 0 law has
# nothing to order -- it is refused by construction.
# Violation-row style (FM-PACK-013): zero rows on a conforming graph, one
# row per lattice-less implementation.
# sparql law (0.3.12 + oxigraph): no FILTER inside EXISTS/OPTIONAL groups;
# group-level FILTER only (compound FILTER(!BOUND() && ...) is group-level
# and portable). The 8 lattice typings are OPTIONAL-witnessed into distinct
# variables; the node is a violation only when ALL 8 are unbound. Multi-
# typing with the base class alongside a lattice class is LAWFUL (recorded
# failed edge: RDF multi-typing is how consumers anchor rungs to legacy
# type names; only lattice-lessness is refused).
PREFIX ashdspy: <https://seanchatmangpt.github.io/packs/ashdspy#>
SELECT ?impl ?kind WHERE {
  {
    ?impl a ashdspy:Implementation .
    OPTIONAL { ?impl a ashdspy:ReuseImplementation . BIND(?impl AS ?w1) }
    OPTIONAL { ?impl a ashdspy:ComposeImplementation . BIND(?impl AS ?w2) }
    OPTIONAL { ?impl a ashdspy:RuleImplementation . BIND(?impl AS ?w3) }
    OPTIONAL { ?impl a ashdspy:PlanImplementation . BIND(?impl AS ?w4) }
    OPTIONAL { ?impl a ashdspy:ConstraintImplementation . BIND(?impl AS ?w5) }
    OPTIONAL { ?impl a ashdspy:GenerateImplementation . BIND(?impl AS ?w6) }
    OPTIONAL { ?impl a ashdspy:SpecializedModelImplementation . BIND(?impl AS ?w7) }
    OPTIONAL { ?impl a ashdspy:LLMImplementation . BIND(?impl AS ?w8) }
    FILTER(!BOUND(?w1) && !BOUND(?w2) && !BOUND(?w3) && !BOUND(?w4) && !BOUND(?w5) && !BOUND(?w6) && !BOUND(?w7) && !BOUND(?w8))
    BIND("bare_implementation_outside_lattice" AS ?kind)
  } UNION {
    ?route a ashdspy:CompiledRoute ; ashdspy:routeImplementation ?impl .
    OPTIONAL { ?impl a ashdspy:ReuseImplementation . BIND(?impl AS ?w1) }
    OPTIONAL { ?impl a ashdspy:ComposeImplementation . BIND(?impl AS ?w2) }
    OPTIONAL { ?impl a ashdspy:RuleImplementation . BIND(?impl AS ?w3) }
    OPTIONAL { ?impl a ashdspy:PlanImplementation . BIND(?impl AS ?w4) }
    OPTIONAL { ?impl a ashdspy:ConstraintImplementation . BIND(?impl AS ?w5) }
    OPTIONAL { ?impl a ashdspy:GenerateImplementation . BIND(?impl AS ?w6) }
    OPTIONAL { ?impl a ashdspy:SpecializedModelImplementation . BIND(?impl AS ?w7) }
    OPTIONAL { ?impl a ashdspy:LLMImplementation . BIND(?impl AS ?w8) }
    FILTER(!BOUND(?w1) && !BOUND(?w2) && !BOUND(?w3) && !BOUND(?w4) && !BOUND(?w5) && !BOUND(?w6) && !BOUND(?w7) && !BOUND(?w8))
    BIND("routed_implementation_without_lattice_type" AS ?kind)
  }
}
ORDER BY ?kind ?impl
