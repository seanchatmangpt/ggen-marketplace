# NEG fixture (gate 030 must FIRE, 1 row): for one Signature, a
# RuleImplementation (rung 3) holds a PASSING CourtVerdict, yet the route
# selects an LLMImplementation. KNOWN => Allocation_LLM = 0: the route is a
# violation row. Every OTHER gate stays clean here on purpose (the LLM
# route carries verdict + both digests; both implementations are
# lattice-typed) so 030's firing is attributable to the lattice law alone.
@prefix ex: <https://example.org/consumer#> .
@prefix ashdspy: <https://seanchatmangpt.github.io/packs/ashdspy#> .

ex:triageSignature a ashdspy:Signature .

ex:ruleImpl a ashdspy:RuleImplementation ;
    ashdspy:forSignature ex:triageSignature ;
    ashdspy:courtVerdict ex:ruleVerdict .

ex:ruleVerdict a ashdspy:CourtVerdict ;
    ashdspy:passed true ;
    ashdspy:verdictDigest "sha256:806df4e1b0310ac66dc025a74c34eb571cbf02f74d4c288bde4d5e7d743c94b5" .

ex:llmImpl a ashdspy:LLMImplementation ;
    ashdspy:forSignature ex:triageSignature .

ex:routeVerdict a ashdspy:CourtVerdict ;
    ashdspy:passed true ;
    ashdspy:verdictDigest "sha256:806df4e1b0310ac66dc025a74c34eb571cbf02f74d4c288bde4d5e7d743c94b5" .

ex:llmRoute a ashdspy:CompiledRoute ;
    ashdspy:compiles ex:triageSignature ;
    ashdspy:routeImplementation ex:llmImpl ;
    ashdspy:courtVerdict ex:routeVerdict ;
    ashdspy:evidenceDigest "sha256:806df4e1b0310ac66dc025a74c34eb571cbf02f74d4c288bde4d5e7d743c94b5" .
