# NEG fixture (gate 040 must FIRE, 2 rows): a CompiledRoute with a verdict
# but NO ashdspy:evidenceDigest, and whose CourtVerdict carries NO
# ashdspy:verdictDigest -- both receipt-shape halves fail on one route.
@prefix ex: <https://example.org/consumer#> .
@prefix ashdspy: <https://seanchatmangpt.github.io/packs/ashdspy#> .

ex:triageSignature a ashdspy:Signature .

ex:ruleImpl a ashdspy:RuleImplementation ;
    ashdspy:forSignature ex:triageSignature .

ex:digestlessVerdict a ashdspy:CourtVerdict ; ashdspy:passed true .

ex:digestlessRoute a ashdspy:CompiledRoute ;
    ashdspy:compiles ex:triageSignature ;
    ashdspy:routeImplementation ex:ruleImpl ;
    ashdspy:courtVerdict ex:digestlessVerdict .
