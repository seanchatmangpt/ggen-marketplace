# NEG fixture (gate 020 must FIRE, 1 row): a CompiledRoute with an
# implementation and an evidence digest but NO ashdspy:courtVerdict --
# selection without a court. (ex:orphanVerdict exists in the graph but is
# not attached to the route, so the witness stays unbound and the gate
# must still fire -- attachment, not existence, is the law.)
@prefix ex: <https://example.org/consumer#> .
@prefix ashdspy: <https://seanchatmangpt.github.io/packs/ashdspy#> .

ex:triageSignature a ashdspy:Signature .

ex:ruleImpl a ashdspy:RuleImplementation ;
    ashdspy:forSignature ex:triageSignature .

ex:orphanVerdict a ashdspy:CourtVerdict ; ashdspy:passed true ;
    ashdspy:verdictDigest "sha256:806df4e1b0310ac66dc025a74c34eb571cbf02f74d4c288bde4d5e7d743c94b5" .

ex:unverifiedRoute a ashdspy:CompiledRoute ;
    ashdspy:compiles ex:triageSignature ;
    ashdspy:routeImplementation ex:ruleImpl ;
    ashdspy:evidenceDigest "sha256:806df4e1b0310ac66dc025a74c34eb571cbf02f74d4c288bde4d5e7d743c94b5" .
