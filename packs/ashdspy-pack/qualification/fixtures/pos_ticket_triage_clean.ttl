# POS fixture (ALL gates must be CLEAN: 0 rows everywhere): a conforming
# consumer graph in the consumer's own namespace -- ticket-triage with a
# RuleImplementation (rung 3) holding a passing CourtVerdict, selected by
# a route carrying verdict + evidence digest. The positive anti-vacuity
# half: a conforming input must be admitted.
@prefix ex: <https://example.org/consumer#> .
@prefix ashdspy: <https://seanchatmangpt.github.io/packs/ashdspy#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ticketTriage a ashdspy:SemanticProgram ;
    ashdspy:signature ex:triageSignature ;
    ashdspy:currentRoute ex:triageRoute .

ex:triageSignature a ashdspy:Signature ;
    ashdspy:input ex:triageIn ;
    ashdspy:output ex:triageUrgency .

ex:triageIn a ashdspy:Input ; ashdspy:fieldName "ticket" ; ashdspy:fieldType "string" .
ex:triageUrgency a ashdspy:Output ; ashdspy:fieldName "urgency" ; ashdspy:fieldType "string" ; ashdspy:oneOf "low" , "high" .

ex:ruleImpl a ashdspy:RuleImplementation ;
    ashdspy:forSignature ex:triageSignature ;
    ashdspy:courtVerdict ex:ruleVerdict .

ex:ruleVerdict a ashdspy:CourtVerdict ;
    ashdspy:passed true ;
    ashdspy:dimension "accuracy" ; ashdspy:score 0.95 ;
    ashdspy:verdictDigest "sha256:806df4e1b0310ac66dc025a74c34eb571cbf02f74d4c288bde4d5e7d743c94b5" .

ex:triageRoute a ashdspy:CompiledRoute ;
    ashdspy:compiles ex:triageSignature ;
    ashdspy:routeImplementation ex:ruleImpl ;
    ashdspy:courtVerdict ex:routeVerdict ;
    ashdspy:evidenceDigest "sha256:806df4e1b0310ac66dc025a74c34eb571cbf02f74d4c288bde4d5e7d743c94b5" .

ex:routeVerdict a ashdspy:CourtVerdict ;
    ashdspy:passed true ;
    ashdspy:verdictDigest "sha256:806df4e1b0310ac66dc025a74c34eb571cbf02f74d4c288bde4d5e7d743c94b5" .
