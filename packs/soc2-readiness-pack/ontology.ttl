# soc2-readiness-pack ontology — PUBLIC-ONTOLOGY-FIRST (no private namespace).
#
# Same doctrine as packs/soc2-audit-pack/ontology.ttl (this pack's sibling,
# a PDDL/POWL case-study fixture for the cng benchmark): no public OWL/RDF
# ontology exists for the AICPA Trust Services Criteria, so the taxonomy is
# modeled as SKOS concept schemes in blank nodes. This pack is
# self-contained (does not require composing soc2-audit-pack) and carries
# the FULL public taxonomy -- all 5 TSC categories, all 9 Common Criteria
# (with CC9's two points of focus), all Availability/Confidentiality/
# Processing-Integrity/Privacy sub-criteria, and the full 10-phase audit
# engagement lifecycle -- not a curated subset. Notation strings match
# soc2-audit-pack's verbatim by construction, so facts from either pack
# join on the same key if a consumer composes both.
#
# COMBINATORIAL DESIGN: the generated control matrix (03-CONTROL-MATRIX)
# is a real cross-product -- every one of the 27 criteria below × its
# implementation status × evidence × test × owner -- rendered as one row
# per criterion REGARDLESS of whether the consumer has supplied a fact for
# it yet. A criterion with no consumer fact renders as "NOT YET ADDRESSED",
# visible by its presence in the table, not by its absence from it. This is
# the deliberate difference from the first version of this pack: gaps must
# be seen, not just omitted.
#
# COMPLIANCE-OVERCLAIM FENCE (structural, not just documentation prose):
# SOC 2 "compliance" is an independent CPA firm's professional attestation,
# issued after a real third-party audit engagement -- it is not a
# mathematical predicate and nothing generated by this pack computes,
# implies, or asserts one. gates/010_no_compliance_verdict.rq refuses any
# consumer fact anywhere in the merged graph asserting a
# compliance/certification/attestation/rendered-opinion claim against a
# prov:Entity or prov:Activity subject -- verified against a real
# adversarial fact in a real `ggen sync run`, not just written and trusted.

@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org:     <http://www.w3.org/ns/org#> .

# === Trust Services Categories (5) ==========================================

_:tscScheme rdf:type skos:ConceptScheme ; rdfs:label "AICPA Trust Services Categories"@en ;
    skos:notation "TSC-CATEGORIES" ;
    dcterms:description "The 5 Trust Services Categories, AICPA 2017 TSC framework (2022 revised points of focus)."@en .

_:tscSecurity rdf:type skos:Concept ; skos:inScheme _:tscScheme ;
    skos:notation "TSC-SECURITY" ; rdfs:label "Security (Common Criteria; mandatory)"@en .
_:tscAvailability rdf:type skos:Concept ; skos:inScheme _:tscScheme ;
    skos:notation "TSC-AVAILABILITY" ; rdfs:label "Availability"@en .
_:tscProcessingIntegrity rdf:type skos:Concept ; skos:inScheme _:tscScheme ;
    skos:notation "TSC-PROCESSING-INTEGRITY" ; rdfs:label "Processing Integrity"@en .
_:tscConfidentiality rdf:type skos:Concept ; skos:inScheme _:tscScheme ;
    skos:notation "TSC-CONFIDENTIALITY" ; rdfs:label "Confidentiality"@en .
_:tscPrivacy rdf:type skos:Concept ; skos:inScheme _:tscScheme ;
    skos:notation "TSC-PRIVACY" ; rdfs:label "Privacy"@en .

# === Common Criteria CC1-CC9 (Security; 10 leaf criteria) ===================

_:ccScheme rdf:type skos:ConceptScheme ; rdfs:label "AICPA Common Criteria (CC1-CC9)"@en ;
    skos:notation "CC-CRITERIA" .

_:cc1 rdf:type skos:Concept ; skos:inScheme _:ccScheme ; skos:broader _:tscSecurity ;
    skos:notation "CC1" ; rdfs:label "CC1: Control Environment"@en .
_:cc2 rdf:type skos:Concept ; skos:inScheme _:ccScheme ; skos:broader _:tscSecurity ;
    skos:notation "CC2" ; rdfs:label "CC2: Communication and Information"@en .
_:cc3 rdf:type skos:Concept ; skos:inScheme _:ccScheme ; skos:broader _:tscSecurity ;
    skos:notation "CC3" ; rdfs:label "CC3: Risk Assessment"@en .
_:cc4 rdf:type skos:Concept ; skos:inScheme _:ccScheme ; skos:broader _:tscSecurity ;
    skos:notation "CC4" ; rdfs:label "CC4: Monitoring Activities"@en .
_:cc5 rdf:type skos:Concept ; skos:inScheme _:ccScheme ; skos:broader _:tscSecurity ;
    skos:notation "CC5" ; rdfs:label "CC5: Control Activities"@en .
_:cc6 rdf:type skos:Concept ; skos:inScheme _:ccScheme ; skos:broader _:tscSecurity ;
    skos:notation "CC6" ; rdfs:label "CC6: Logical and Physical Access Controls"@en .
_:cc7 rdf:type skos:Concept ; skos:inScheme _:ccScheme ; skos:broader _:tscSecurity ;
    skos:notation "CC7" ; rdfs:label "CC7: System Operations"@en .
_:cc8 rdf:type skos:Concept ; skos:inScheme _:ccScheme ; skos:broader _:tscSecurity ;
    skos:notation "CC8" ; rdfs:label "CC8: Change Management"@en .
_:cc9pt1 rdf:type skos:Concept ; skos:inScheme _:ccScheme ; skos:broader _:tscSecurity ;
    skos:notation "CC9-1" ; rdfs:label "CC9.1: General risk mitigation business processes"@en .
_:cc9pt2 rdf:type skos:Concept ; skos:inScheme _:ccScheme ; skos:broader _:tscSecurity ;
    skos:notation "CC9-2" ; rdfs:label "CC9.2: Vendor and business-partner risk management"@en .

# === Availability A1.1-A1.3 ==================================================

_:availabilityScheme rdf:type skos:ConceptScheme ; rdfs:label "AICPA Availability criteria"@en ;
    skos:notation "AVAILABILITY-CRITERIA" .

_:a1pt1 rdf:type skos:Concept ; skos:inScheme _:availabilityScheme ; skos:broader _:tscAvailability ;
    skos:notation "A1-1" ; rdfs:label "A1.1: System availability commitments"@en .
_:a1pt2 rdf:type skos:Concept ; skos:inScheme _:availabilityScheme ; skos:broader _:tscAvailability ;
    skos:notation "A1-2" ; rdfs:label "A1.2: Environmental protections, backup, and capacity monitoring"@en .
_:a1pt3 rdf:type skos:Concept ; skos:inScheme _:availabilityScheme ; skos:broader _:tscAvailability ;
    skos:notation "A1-3" ; rdfs:label "A1.3: Tested recovery procedures"@en .

# === Confidentiality C1.1-C1.2 ==============================================

_:confidentialityScheme rdf:type skos:ConceptScheme ; rdfs:label "AICPA Confidentiality criteria"@en ;
    skos:notation "CONFIDENTIALITY-CRITERIA" .

_:c1pt1 rdf:type skos:Concept ; skos:inScheme _:confidentialityScheme ; skos:broader _:tscConfidentiality ;
    skos:notation "C1-1" ; rdfs:label "C1.1: Data classification"@en .
_:c1pt2 rdf:type skos:Concept ; skos:inScheme _:confidentialityScheme ; skos:broader _:tscConfidentiality ;
    skos:notation "C1-2" ; rdfs:label "C1.2: Protection mechanisms"@en .

# === Processing Integrity PI1.1-PI1.5 =======================================

_:piScheme rdf:type skos:ConceptScheme ; rdfs:label "AICPA Processing Integrity criteria"@en ;
    skos:notation "PROCESSING-INTEGRITY-CRITERIA" .

_:pi1pt1 rdf:type skos:Concept ; skos:inScheme _:piScheme ; skos:broader _:tscProcessingIntegrity ;
    skos:notation "PI1-1" ; rdfs:label "PI1.1: Processing inputs are complete, accurate, and timely"@en .
_:pi1pt2 rdf:type skos:Concept ; skos:inScheme _:piScheme ; skos:broader _:tscProcessingIntegrity ;
    skos:notation "PI1-2" ; rdfs:label "PI1.2: Processing specifications are defined and applied consistently"@en .
_:pi1pt3 rdf:type skos:Concept ; skos:inScheme _:piScheme ; skos:broader _:tscProcessingIntegrity ;
    skos:notation "PI1-3" ; rdfs:label "PI1.3: Processing is complete, accurate, timely, and authorized"@en .
_:pi1pt4 rdf:type skos:Concept ; skos:inScheme _:piScheme ; skos:broader _:tscProcessingIntegrity ;
    skos:notation "PI1-4" ; rdfs:label "PI1.4: Outputs are complete, accurate, timely, and distributed appropriately"@en .
_:pi1pt5 rdf:type skos:Concept ; skos:inScheme _:piScheme ; skos:broader _:tscProcessingIntegrity ;
    skos:notation "PI1-5" ; rdfs:label "PI1.5: Inputs and outputs are stored completely, accurately, and timely as specified"@en .

# === Privacy P1-P8 ===========================================================

_:privacyScheme rdf:type skos:ConceptScheme ; rdfs:label "AICPA Privacy criteria"@en ;
    skos:notation "PRIVACY-CRITERIA" .

_:p1 rdf:type skos:Concept ; skos:inScheme _:privacyScheme ; skos:broader _:tscPrivacy ;
    skos:notation "P1" ; rdfs:label "P1: Notice"@en .
_:p2 rdf:type skos:Concept ; skos:inScheme _:privacyScheme ; skos:broader _:tscPrivacy ;
    skos:notation "P2" ; rdfs:label "P2: Choice and consent"@en .
_:p3 rdf:type skos:Concept ; skos:inScheme _:privacyScheme ; skos:broader _:tscPrivacy ;
    skos:notation "P3" ; rdfs:label "P3: Collection"@en .
_:p4 rdf:type skos:Concept ; skos:inScheme _:privacyScheme ; skos:broader _:tscPrivacy ;
    skos:notation "P4" ; rdfs:label "P4: Use, retention, and disposal"@en .
_:p5 rdf:type skos:Concept ; skos:inScheme _:privacyScheme ; skos:broader _:tscPrivacy ;
    skos:notation "P5" ; rdfs:label "P5: Access"@en .
_:p6 rdf:type skos:Concept ; skos:inScheme _:privacyScheme ; skos:broader _:tscPrivacy ;
    skos:notation "P6" ; rdfs:label "P6: Disclosure to third parties"@en .
_:p7 rdf:type skos:Concept ; skos:inScheme _:privacyScheme ; skos:broader _:tscPrivacy ;
    skos:notation "P7" ; rdfs:label "P7: Quality"@en .
_:p8 rdf:type skos:Concept ; skos:inScheme _:privacyScheme ; skos:broader _:tscPrivacy ;
    skos:notation "P8" ; rdfs:label "P8: Monitoring and enforcement"@en .

# === Implementation status (SKOS concept scheme) ============================
# Every criterion in the matrix renders one of these, deterministically:
# a criterion with no consumer fact is NOT-STARTED by default (not simply
# missing from the table).

_:statusScheme rdf:type skos:ConceptScheme ; rdfs:label "Control implementation status"@en ;
    skos:notation "IMPL-STATUS" .

_:statusNotStarted rdf:type skos:Concept ; skos:inScheme _:statusScheme ;
    skos:notation "NOT-STARTED" ; rdfs:label "Not started"@en .
_:statusPlanned rdf:type skos:Concept ; skos:inScheme _:statusScheme ;
    skos:notation "PLANNED" ; rdfs:label "Planned"@en .
_:statusInProgress rdf:type skos:Concept ; skos:inScheme _:statusScheme ;
    skos:notation "IN-PROGRESS" ; rdfs:label "In progress"@en .
_:statusImplemented rdf:type skos:Concept ; skos:inScheme _:statusScheme ;
    skos:notation "IMPLEMENTED" ; rdfs:label "Implemented, not yet tested"@en .
_:statusTested rdf:type skos:Concept ; skos:inScheme _:statusScheme ;
    skos:notation "TESTED" ; rdfs:label "Implemented and tested"@en .
_:statusException rdf:type skos:Concept ; skos:inScheme _:statusScheme ;
    skos:notation "EXCEPTION" ; rdfs:label "Exception found, remediation pending"@en .
_:statusNA rdf:type skos:Concept ; skos:inScheme _:statusScheme ;
    skos:notation "NOT-APPLICABLE" ; rdfs:label "Not applicable to this engagement's scope"@en .

# === Audit engagement phases (10-phase lifecycle) ===========================
# Identical notations to soc2-audit-pack's own scheme, by construction.

_:engagementScheme rdf:type skos:ConceptScheme ; rdfs:label "SOC2 Type II audit engagement phases"@en ;
    skos:notation "SOC2-AUDIT-PHASES" .

_:auditScoping rdf:type skos:Concept ; skos:inScheme _:engagementScheme ;
    skos:notation "AUDIT-SCOPING" ; rdfs:label "1: Scoping & System Description"@en .
_:auditReadiness rdf:type skos:Concept ; skos:inScheme _:engagementScheme ;
    skos:notation "AUDIT-READINESS" ; rdfs:label "2: Readiness Assessment (Gap Analysis)"@en .
_:auditControlDesignDoc rdf:type skos:Concept ; skos:inScheme _:engagementScheme ;
    skos:notation "AUDIT-CONTROL-DESIGN-DOC" ; rdfs:label "3: Control Design Documentation"@en .
_:auditDesignEval rdf:type skos:Concept ; skos:inScheme _:engagementScheme ;
    skos:notation "AUDIT-DESIGN-EVAL" ; rdfs:label "4: Control Design Evaluation"@en .
_:auditCollectionInit rdf:type skos:Concept ; skos:inScheme _:engagementScheme ;
    skos:notation "AUDIT-COLLECTION-INIT" ; rdfs:label "5: Evidence Collection Period Initiation"@en .
_:auditOeTesting rdf:type skos:Concept ; skos:inScheme _:engagementScheme ;
    skos:notation "AUDIT-OE-TESTING" ; rdfs:label "6: Operating Effectiveness Testing"@en .
_:auditExceptionId rdf:type skos:Concept ; skos:inScheme _:engagementScheme ;
    skos:notation "AUDIT-EXCEPTION-ID" ; rdfs:label "7: Exception Identification"@en .
_:auditRemediation rdf:type skos:Concept ; skos:inScheme _:engagementScheme ;
    skos:notation "AUDIT-REMEDIATION" ; rdfs:label "8: Management Response & Remediation"@en .
_:auditBundleAssembly rdf:type skos:Concept ; skos:inScheme _:engagementScheme ;
    skos:notation "AUDIT-BUNDLE-ASSEMBLY" ; rdfs:label "9: Evidence Bundle Assembly"@en .
_:auditReportHandoff rdf:type skos:Concept ; skos:inScheme _:engagementScheme ;
    skos:notation "AUDIT-REPORT-HANDOFF" ; rdfs:label "10: Auditor Report Handoff (terminal — evidence bundle handed to a human auditor; no opinion produced here)"@en .

# === Evidence types (SKOS concept scheme) ===================================

_:evidenceTypeScheme rdf:type skos:ConceptScheme ; rdfs:label "Evidence artifact types"@en ;
    skos:notation "EVIDENCE-TYPES" .

_:evPolicy rdf:type skos:Concept ; skos:inScheme _:evidenceTypeScheme ;
    skos:notation "POLICY-DOC" ; rdfs:label "Policy or procedure document"@en .
_:evConfig rdf:type skos:Concept ; skos:inScheme _:evidenceTypeScheme ;
    skos:notation "SYSTEM-CONFIG" ; rdfs:label "System configuration (IaC, manifest, code)"@en .
_:evLog rdf:type skos:Concept ; skos:inScheme _:evidenceTypeScheme ;
    skos:notation "LOG-RECORD" ; rdfs:label "Log or audit-trail record"@en .
_:evScreenshot rdf:type skos:Concept ; skos:inScheme _:evidenceTypeScheme ;
    skos:notation "SCREENSHOT" ; rdfs:label "Screenshot or UI capture"@en .
_:evInterview rdf:type skos:Concept ; skos:inScheme _:evidenceTypeScheme ;
    skos:notation "INTERVIEW" ; rdfs:label "Personnel interview / walkthrough notes"@en .
_:evScan rdf:type skos:Concept ; skos:inScheme _:evidenceTypeScheme ;
    skos:notation "AUTOMATED-SCAN" ; rdfs:label "Automated scan or test output"@en .

# === Risk levels (for exception log) ========================================

_:riskScheme rdf:type skos:ConceptScheme ; rdfs:label "Exception risk levels"@en ;
    skos:notation "RISK-LEVELS" .

_:riskLow rdf:type skos:Concept ; skos:inScheme _:riskScheme ;
    skos:notation "LOW" ; rdfs:label "Low"@en .
_:riskMedium rdf:type skos:Concept ; skos:inScheme _:riskScheme ;
    skos:notation "MEDIUM" ; rdfs:label "Medium"@en .
_:riskHigh rdf:type skos:Concept ; skos:inScheme _:riskScheme ;
    skos:notation "HIGH" ; rdfs:label "High"@en .
_:riskCritical rdf:type skos:Concept ; skos:inScheme _:riskScheme ;
    skos:notation "CRITICAL" ; rdfs:label "Critical"@en .
