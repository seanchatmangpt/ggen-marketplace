---
to: "soc2/07-EXCEPTION-LOG.md"
force: true
sparql:
  exceptions: |
    PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
    PREFIX prov:    <http://www.w3.org/ns/prov#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?label ?notation ?riskLabel ?description ?remediation ?remediationStatus WHERE {
      ?exception rdf:type prov:Entity ;
                 rdfs:label ?label ;
                 dcterms:subject ?notation ;
                 dcterms:type "EXCEPTION" .
      OPTIONAL { ?exception dcterms:description ?description . }
      OPTIONAL {
        ?exception dcterms:relation ?riskNotation .
        ?riskConcept skos:notation ?riskNotation ; rdfs:label ?riskLabel ; skos:inScheme ?riskScheme .
        ?riskScheme skos:notation "RISK-LEVELS" .
      }
      OPTIONAL { ?exception dcterms:isReplacedBy ?remediation . }
      OPTIONAL { ?exception dcterms:hasVersion ?remediationStatus . }
    }
    ORDER BY DESC(?riskLabel) ?notation
---
