to: "soc2/03-CONTROL-MATRIX.md"
force: true
sparql:
  rows: |
    PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
    PREFIX prov:    <http://www.w3.org/ns/prov#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?notation ?categoryLabel ?critLabel ?statusNotation ?statusLabel ?owner ?source ?description WHERE {
      ?concept skos:notation ?notation ; rdfs:label ?critLabel ;
               skos:broader ?tscCat .
      ?tscCat skos:inScheme ?tscScheme .
      ?tscScheme skos:notation "TSC-CATEGORIES" .
      ?tscCat rdfs:label ?categoryLabel .
      OPTIONAL {
        ?record rdf:type prov:Entity ; dcterms:subject ?notation .
        OPTIONAL {
          ?record dcterms:type ?statusNotation .
          OPTIONAL {
            ?statusConcept skos:notation ?statusNotation ; rdfs:label ?statusLabel ; skos:inScheme ?statusScheme .
            ?statusScheme skos:notation "IMPL-STATUS" .
          }
        }
        OPTIONAL { ?record dcterms:contributor ?owner . }
        OPTIONAL { ?record dcterms:source ?source . }
        OPTIONAL { ?record dcterms:description ?description . }
      }
    }
    ORDER BY ?categoryLabel ?notation
  totals: |
    PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
    PREFIX prov:    <http://www.w3.org/ns/prov#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT (COUNT(DISTINCT ?notation) AS ?totalCriteria) (COUNT(DISTINCT ?addressedNotation) AS ?addressedCount) (COUNT(DISTINCT ?testedNotation) AS ?testedCount) WHERE {
      ?concept skos:notation ?notation ; skos:broader ?tscCat .
      ?tscCat skos:inScheme ?tscScheme .
      ?tscScheme skos:notation "TSC-CATEGORIES" .
      OPTIONAL {
        ?record rdf:type prov:Entity ; dcterms:subject ?notation .
        BIND(?notation AS ?addressedNotation)
        OPTIONAL {
          ?record dcterms:type "TESTED" .
          BIND(?notation AS ?testedNotation)
        }
      }
    }
