---
to: "soc2/06-ENGAGEMENT-TIMELINE.md"
force: true
sparql:
  phases: |
    PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
    PREFIX prov:    <http://www.w3.org/ns/prov#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?notation ?phaseLabel ?status ?startDate ?endDate ?notes WHERE {
      ?concept skos:notation ?notation ; rdfs:label ?phaseLabel ;
               skos:inScheme ?scheme .
      ?scheme skos:notation "SOC2-AUDIT-PHASES" .
      OPTIONAL {
        ?record rdf:type prov:Activity ; dcterms:subject ?notation ; skos:notation "PHASE-STATUS" .
        OPTIONAL { ?record skos:prefLabel ?status . }
        OPTIONAL { ?record prov:startedAtTime ?startDate . }
        OPTIONAL { ?record prov:endedAtTime ?endDate . }
        OPTIONAL { ?record dcterms:description ?notes . }
      }
    }
    ORDER BY ?notation
---
