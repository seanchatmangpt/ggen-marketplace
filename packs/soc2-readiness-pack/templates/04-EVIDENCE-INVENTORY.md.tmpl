---
to: "soc2/04-EVIDENCE-INVENTORY.md"
force: true
sparql:
  evidence: |
    PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
    PREFIX prov:    <http://www.w3.org/ns/prov#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?label ?notation (COALESCE(?broaderLabel, ?ownLabel) AS ?categoryLabel) ?source ?description WHERE {
      ?entity rdf:type prov:Entity ;
              rdfs:label ?label ;
              dcterms:subject ?notation ;
              dcterms:source ?source .
      OPTIONAL { ?entity dcterms:description ?description . }
      ?concept skos:notation ?notation ; rdfs:label ?ownLabel .
      OPTIONAL {
        ?concept skos:broader ?broader .
        ?broader rdfs:label ?broaderLabel .
      }
    }
    ORDER BY ?notation ?label
---
