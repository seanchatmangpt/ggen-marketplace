sparql:
  org: |
    PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX org:     <http://www.w3.org/ns/org#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?name ?description WHERE {
      ?entity rdf:type org:Organization ; rdfs:label ?name .
      OPTIONAL { ?entity dcterms:description ?description . }
    }
  boundaries: |
    PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
    PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX prov:    <http://www.w3.org/ns/prov#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?label ?boundaryType ?description WHERE {
      ?entity rdf:type prov:Entity ; rdfs:label ?label ; dcterms:type ?boundaryType .
      FILTER(?boundaryType = "SYSTEM-BOUNDARY")
      OPTIONAL { ?entity dcterms:description ?description . }
    }
