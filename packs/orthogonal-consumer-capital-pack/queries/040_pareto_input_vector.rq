PREFIX occ: <https://chatman.ai/ontology/orthogonal-consumer-capital#>
SELECT ?c ?y ?u ?comp ?ig ?f ?cost WHERE { ?c a occ:ConsumerCandidate ; occ:expectedYield ?y ; occ:dependencyUnlocks ?u ; occ:compositionUnlocks ?comp ; occ:informationGain ?ig ; occ:futureCapacity ?f ; occ:manufactureCost ?cost . }
