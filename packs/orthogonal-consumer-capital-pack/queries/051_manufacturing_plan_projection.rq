PREFIX occ: <https://chatman.ai/ontology/orthogonal-consumer-capital#>
SELECT ?repo ?y ?unlocks ?compositions ?capacity WHERE { ?c a occ:ConsumerCandidate ; occ:repository ?repo ; occ:current true ; occ:exactSubject true ; occ:qualified true ; occ:replayVerified true ; occ:falsifierPassed true ; occ:independent true ; occ:sameEvidenceRoot false ; occ:consequentialDo false ; occ:expectedYield ?y ; occ:dependencyUnlocks ?unlocks ; occ:compositionUnlocks ?compositions ; occ:futureCapacity ?capacity . FILTER(?y > 0 && ?unlocks > 0 && ?compositions > 0 && ?capacity >= 3) } ORDER BY DESC(?capacity) DESC(?y)
