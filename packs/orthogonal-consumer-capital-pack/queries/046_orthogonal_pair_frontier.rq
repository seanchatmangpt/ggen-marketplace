PREFIX occ: <https://chatman.ai/ontology/orthogonal-consumer-capital#>
SELECT ?a ?b WHERE { ?a a occ:ConsumerCandidate ; occ:independent true ; occ:sameEvidenceRoot false ; occ:runtimeFamily ?ra ; occ:failureDomain ?fa . ?b a occ:ConsumerCandidate ; occ:independent true ; occ:sameEvidenceRoot false ; occ:runtimeFamily ?rb ; occ:failureDomain ?fb . FILTER(STR(?a) < STR(?b) && ?ra != ?rb && ?fa != ?fb) }
