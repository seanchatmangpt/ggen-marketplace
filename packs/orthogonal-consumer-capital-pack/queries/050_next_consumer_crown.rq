PREFIX occ: <https://chatman.ai/ontology/orthogonal-consumer-capital#>
SELECT ?c WHERE { ?c a occ:ConsumerCandidate ; occ:current true ; occ:exactSubject true ; occ:qualified true ; occ:replayVerified true ; occ:falsifierPassed true ; occ:independent true ; occ:sameEvidenceRoot false ; occ:consequentialDo false ; occ:expectedYield ?y ; occ:dependencyUnlocks ?u ; occ:compositionUnlocks ?comp ; occ:futureCapacity ?f . FILTER(?y > 0 && ?u > 0 && ?comp > 0 && ?f >= 3) } ORDER BY DESC(?f) DESC(?y)
