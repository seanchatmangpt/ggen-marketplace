occ:qualified a rdf:Property .
occ:replayVerified a rdf:Property .
occ:falsifierPassed a rdf:Property .
occ:consequentialDo a rdf:Property .
occ:independent a rdf:Property .
occ:sameEvidenceRoot a rdf:Property .
occ:expectedYield a rdf:Property .
occ:dependencyUnlocks a rdf:Property .
occ:compositionUnlocks a rdf:Property .
occ:reversible a rdf:Property .
occ:authorityCost a rdf:Property .
occ:manufactureCost a rdf:Property .
occ:informationGain a rdf:Property .
