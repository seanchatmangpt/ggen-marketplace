---
to: generated/orthogonal-consumer-capital/consumer-manufacturing-plan.json
force: true
sparql:
  targets: |
    PREFIX occ: <https://chatman.ai/ontology/orthogonal-consumer-capital#>
    SELECT ?repo ?y ?unlocks ?compositions ?capacity WHERE {
      ?c a occ:ConsumerCandidate ; occ:repository ?repo ; occ:current true ; occ:exactSubject true ; occ:qualified true ; occ:replayVerified true ; occ:falsifierPassed true ; occ:independent true ; occ:sameEvidenceRoot false ; occ:consequentialDo false ; occ:expectedYield ?y ; occ:dependencyUnlocks ?unlocks ; occ:compositionUnlocks ?compositions ; occ:futureCapacity ?capacity . FILTER(?y > 0 && ?unlocks > 0 && ?compositions > 0 && ?capacity >= 3)
    } ORDER BY DESC(?capacity) DESC(?y)
for_each: targets
---
{
  "schema": "ggen.orthogonal-consumer-capital/1",
  "authority": "SELECT|CONSTRUCT|VERIFY",
  "consequential_do": false,
  "targets": [
    {"repository":"{{ row.repo }}","expected_yield":{{ row.y }},"dependency_unlocks":{{ row.unlocks }},"composition_unlocks":{{ row.compositions }},"future_capacity":{{ row.capacity }}}
  ]
}
