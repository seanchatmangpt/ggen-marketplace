{
  "schema": "ggen.orthogonal-consumer-capital/1",
  "authority": "SELECT|CONSTRUCT|VERIFY",
  "consequential_do": false,
  "targets": [
  {% for row in results %}{"repository":"{{ row.repo }}","expected_yield":{{ row.y }},"dependency_unlocks":{{ row.unlocks }},"composition_unlocks":{{ row.compositions }},"future_capacity":{{ row.capacity }}}{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
