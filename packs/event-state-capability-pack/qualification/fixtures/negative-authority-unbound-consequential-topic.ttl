# NEGATIVE fixture: fires gate 050_consequential_requires_authority (shape A).
# THE ProviderAvailable != Authorized witness: this realization sets
# escap:providerAvailable true -- the provider EXISTS -- and emits onto the
# consequential order-lifecycle topic WITHOUT any authorityRequirement.
# Provider availability never discharges authority; the gate never reads
# providerAvailable. REFUSED_NO_AUTHORITY class.
@prefix escap: <https://ggen.dev/ontology/event-state-capability#> .

escap:realization-unauthorized-audit-emit a escap:Realization ;
    escap:realizes escap:event-emit ;
    escap:providerRepo "example-unauthorized" ;
    escap:providerModule "emit onto order-lifecycle with provider available and no authority" ;
    escap:versionPinPolicy "none" ;
    escap:providerAvailable true ;
    escap:qualificationCondition escap:qc-notifier-configured ;
    escap:evidenceRequirement "emit receipt" ;
    escap:emitsOn escap:topic-order-lifecycle .
