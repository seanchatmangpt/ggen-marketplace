# NEGATIVE fixture: fires gate 030_delivery_semantics_required (event shape).
# Event.Broadcast is otherwise fully conformed (realization + qualification)
# but declares NO deliverySemantics: the resolver would have to guess whether
# broadcast is at-least-once or fire-and-forget.
@prefix escap: <https://ggen.dev/ontology/event-state-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

escap:event-broadcast a escap:EventCapability, escap:Capability ;
    rdfs:label "Event.Broadcast" ;
    dcterms:identifier "Event.Broadcast" ;
    escap:input "topic, payload" ;
    escap:failureOutcome escap:failure-topic-unavailable .

escap:realization-broadcast a escap:Realization ;
    escap:realizes escap:event-broadcast ;
    escap:providerRepo "example" ;
    escap:providerModule "broadcast offer with no declared delivery semantics" ;
    escap:versionPinPolicy "none" ;
    escap:providerAvailable true ;
    escap:qualificationCondition escap:qc-notifier-configured .
