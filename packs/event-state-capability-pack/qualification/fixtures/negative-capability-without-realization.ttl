# NEGATIVE fixture: fires gate 010_capability_requires_realization.
# Event.Throttle is admitted as a capability but NO realization realizes it:
# the resolver would surface a capability no provider offers.
@prefix escap: <https://ggen.dev/ontology/event-state-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

escap:event-throttle a escap:EventCapability, escap:Capability ;
    rdfs:label "Event.Throttle" ;
    dcterms:identifier "Event.Throttle" ;
    escap:input "topic, rate bound" ;
    escap:output "rate-limited emit" ;
    escap:deliverySemantics escap:atMostOnce .
