# NEGATIVE fixture: fires gate 040_observation_requires_evidence.
# A realization of State.Observe that states NO evidence requirement: an
# observation that cannot show what it saw is a rumor, not a capability.
@prefix escap: <https://ggen.dev/ontology/event-state-capability#> .

escap:realization-blind-observe a escap:Realization ;
    escap:realizes escap:state-observe ;
    escap:providerRepo "example-blind" ;
    escap:providerModule "observer that records nothing" ;
    escap:versionPinPolicy "none" ;
    escap:providerAvailable true ;
    escap:qualificationCondition escap:qc-poller-measures-declared .
