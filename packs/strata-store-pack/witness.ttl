# Content-address KAT (lane L170): the same witnessed-replay pattern as
# strata-chain-pack's shared-head KAT. Three real payloads; each digest below
# was DERIVED by running the pack's own generated module
# (generated/store_engine.rs) via a rustc driver in /tmp/store-kat — never
# invented. Root = SHA-256 over the concatenated keys in BTreeMap
# (lexicographic byte) order, exactly what InMemoryStore::root_digest folds
# over. verify.py recomputes every address and the root from the payloads and
# asserts equality with the pinned literal, plus a one-byte-tamper negative.
sw:store-kat-entry-1
    sw:katPayload "strata-store-kat-payload-1" ;
    sw:katDigest "91b739023c976350dacc820d9d8fa02c5617a10f551d89dde3bf4419a54cb367" .
sw:store-kat-entry-2
    sw:katPayload "strata-store-kat-payload-2" ;
    sw:katDigest "17dcbd0e84f8a571e7f736b176a3d7160d8cb88d28ef59ce0a51482d5e4ba909" .
sw:store-kat-entry-3
    sw:katPayload "strata-store-kat-payload-3" ;
    sw:katDigest "d8de3bf89d034493f711537b87dcf45f0649802194d59bba5db92ca1ee651c28" .

sw:store-kat a sw:GateRun ;
    sw:gate "content-address-kat" ;
    sw:storeKatRoot "a8378cfa4e6e508f54c0287eac99f6e6b07f2fc8b9123bab1f7b2be494f0ef08" ;
    sw:date "2026-10-13" ;
    sw:andon "Green" ;
    sw:zeroRows true .
