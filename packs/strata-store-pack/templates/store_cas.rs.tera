{% for row in results %}{% if loop.first %}{% set_global kat_root = row.root %}{% set_global digest_len = row.digest_len %}{% set_global key_len = row.key_len %}{% endif %}{% endfor %}
/// PINNED CONTENT-ADDRESS KAT ROOT — mirrored from witness.ttl
/// (sw:storeKatRoot); gated by gates/030_store_cas_composition.rq.
pub const STORE_KAT_ROOT: &str = "{{ kat_root }}";

/// Shared digest length in bytes (store KEY_LEN; CAS 64-hex law).
pub const STORE_DIGEST_LEN: usize = {{ digest_len }};

/// Store key width in bytes (so:STORE_CONSTANTS so:keyLen).
pub const STORE_KEY_LEN: usize = {{ key_len }};

/// Number of witnessed content-address KAT entries.
pub const STORE_KAT_DEPTH: usize = {{ results | length }};

/// Witnessed content-address KAT entries (payload, digest), mirrored from
/// witness.ttl sw:store-kat-entry-*.
pub const STORE_KAT_ENTRIES: [(&str, &str); {{ results | length }}] = [
    {% for row in results %}("{{ row.payload }}", "{{ row.digest }}"),
    {% endfor %}];

/// Digest-shape law: ^[0-9a-f]{64}$ — the CAS content-address shape,
/// identical to the store's 32-byte SHA-256 key domain.
pub fn digest_shape_ok(d: &str) -> bool {
    d.len() == 64 && d.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
}

/// Store ↔ CAS admission: the pinned root is a valid CAS content-address
/// witness iff it is well-formed 32-byte hex, non-zero, the shared digest
/// length is 32, the store key width is 32, and the witnessed entry count
/// matches STORE_KAT_DEPTH.
pub fn store_cas_closure() -> Result<(), String> {
    if !digest_shape_ok(STORE_KAT_ROOT) {
        return Err(format!(
            "malformed_root: STORE_KAT_ROOT violates the 64-char lowercase-hex digest-shape law",
        ));
    }
    if STORE_KAT_ROOT.bytes().all(|b| b == b'0') {
        return Err("genesis_root: STORE_KAT_ROOT is the all-zero root; a content-address witness must be a folded root".to_string());
    }
    if STORE_DIGEST_LEN != 32 {
        return Err(format!(
            "wrong_digest_len: shared digest length {} != 32",
            STORE_DIGEST_LEN
        ));
    }
    if STORE_KEY_LEN != 32 {
        return Err(format!(
            "wrong_key_len: store key width {} != 32",
            STORE_KEY_LEN
        ));
    }
    if STORE_KAT_DEPTH != STORE_KAT_ENTRIES.len() {
        return Err(format!(
            "depth_law: pinned depth {} != witnessed entry count {}",
            STORE_KAT_DEPTH,
            STORE_KAT_ENTRIES.len()
        ));
    }
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    // ── SHA-256 (FIPS 180-4) — inline provenance copy ────────────────
    // PROVENANCE: byte-identical inline copy of `pub fn sha256` from
    // packs/strata-hash-pack/generated/hash_merkle.rs (same reuse
    // discipline as templates/store_engine.rs.tera, itself provenance-
    // copied from strata-hash-pack). FIPS 180-4 §6.2; the tests below pin
    // correctness against the published vectors.
    const K: [u32; 64] = [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ];

    const H0: [u32; 8] = [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
    ];

    /// SHA-256 of `data`, per FIPS 180-4 §6.2.
    fn sha256(data: &[u8]) -> [u8; 32] {
        let mut h = H0;
        let bit_len = (data.len() as u64).wrapping_mul(8);
        let mut msg = data.to_vec();
        msg.push(0x80);
        while msg.len() % 64 != 56 {
            msg.push(0);
        }
        msg.extend_from_slice(&bit_len.to_be_bytes());
        for block in msg.chunks_exact(64) {
            let mut w = [0u32; 64];
            for (i, word) in block.chunks_exact(4).enumerate() {
                w[i] = u32::from_be_bytes([word[0], word[1], word[2], word[3]]);
            }
            for i in 16..64 {
                let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
                let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
                w[i] = w[i - 16]
                    .wrapping_add(s0)
                    .wrapping_add(w[i - 7])
                    .wrapping_add(s1);
            }
            let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh) =
                (h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);
            for i in 0..64 {
                let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
                let ch = (e & f) ^ ((!e) & g);
                let t1 = hh
                    .wrapping_add(s1)
                    .wrapping_add(ch)
                    .wrapping_add(K[i])
                    .wrapping_add(w[i]);
                let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
                let maj = (a & b) ^ (a & c) ^ (b & c);
                let t2 = s0.wrapping_add(maj);
                hh = g;
                g = f;
                f = e;
                e = d.wrapping_add(t1);
                d = c;
                c = b;
                b = a;
                a = t1.wrapping_add(t2);
            }
            h[0] = h[0].wrapping_add(a);
            h[1] = h[1].wrapping_add(b);
            h[2] = h[2].wrapping_add(c);
            h[3] = h[3].wrapping_add(d);
            h[4] = h[4].wrapping_add(e);
            h[5] = h[5].wrapping_add(f);
            h[6] = h[6].wrapping_add(g);
            h[7] = h[7].wrapping_add(hh);
        }
        let mut out = [0u8; 32];
        for (i, word) in h.iter().enumerate() {
            out[i * 4..i * 4 + 4].copy_from_slice(&word.to_be_bytes());
        }
        out
    }

    fn hex32(bytes: &[u8]) -> String {
        bytes.iter().map(|b| format!("{b:02x}")).collect()
    }

    /// Store-root fold: SHA-256 over the concatenated keys in BTreeMap
    /// lexicographic byte order — exactly InMemoryStore::root_digest.
    fn store_root_fold(keys: &[[u8; 32]]) -> [u8; 32] {
        let mut sorted = keys.to_vec();
        sorted.sort();
        let mut buf = Vec::with_capacity(sorted.len() * 32);
        for key in &sorted {
            buf.extend_from_slice(key);
        }
        sha256(&buf)
    }

    /// Content-address KAT court: each witnessed entry's digest IS the
    /// SHA-256 of its payload (the store law key == SHA-256(value)), and
    /// the pinned root equals the store-root fold over the re-derived
    /// keys — so the pinned root is a valid CAS content-address witness
    /// (MerkleCommit root over the concatenated keys).
    #[test]
    fn pinned_root_is_valid_cas_content_address() {
        store_cas_closure().expect("pinned KAT root must admit as a CAS content-address witness");
        assert_eq!(STORE_DIGEST_LEN, 32);
        assert_eq!(STORE_KEY_LEN, 32);
        assert_eq!(STORE_KAT_DEPTH, 3);
        let mut keys = Vec::new();
        for (payload, digest) in STORE_KAT_ENTRIES {
            let derived = hex32(&sha256(payload.as_bytes()));
            assert_eq!(derived, digest, "content-address divergence for {}", payload);
            assert!(digest_shape_ok(digest), "entry digest shape violated: {}", digest);
            keys.push(sha256(payload.as_bytes()));
        }
        assert_eq!(hex32(&store_root_fold(&keys)), STORE_KAT_ROOT);
    }

    /// FIPS 180-4 published vectors pin the inline copy ("" and "abc").
    #[test]
    fn sha256_fips_vectors() {
        assert_eq!(
            hex32(&sha256(b"")),
            "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
        );
        assert_eq!(
            hex32(&sha256(b"abc")),
            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
        );
    }

    /// SABOTAGE TWIN — a corrupted root literal keeps the digest SHAPE
    /// (still 64 lowercase hex) but no longer matches the recomputed fold:
    /// shape checks alone cannot admit a wrong root; the fold court can.
    #[test]
    fn sabotage_twin_corrupted_root_is_caught() {
        let mut corrupted = STORE_KAT_ROOT.to_string();
        // 'a' -> 'b': stays inside the lowercase-hex alphabet, so the
        // corruption keeps the digest SHAPE while breaking the PIN.
        assert_eq!(corrupted.as_bytes()[0], b'a');
        corrupted.replace_range(0..1, "b");
        assert!(digest_shape_ok(&corrupted), "corrupted root must keep the digest shape");
        let keys: Vec<[u8; 32]> = STORE_KAT_ENTRIES
            .iter()
            .map(|(p, _)| sha256(p.as_bytes()))
            .collect();
        assert_ne!(
            hex32(&store_root_fold(&keys)),
            corrupted,
            "fold reproduced a corrupted root — court cannot distinguish honest from sabotaged input"
        );
    }
}
