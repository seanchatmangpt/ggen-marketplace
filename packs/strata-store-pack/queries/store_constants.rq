PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX so:   <https://strata.chatman.ai/ontology/store#>

SELECT ?name ?rustType ?value ?comment
WHERE {
  ?c a so:StoreConstant ; rdfs:label "STORE_CONSTANTS" ; so:rustType ?rustType .
  {
    ?c so:defaultCapacity ?value .
    BIND("DEFAULT_CAPACITY" AS ?name)
    BIND("hard cap on distinct entries in one ContentStore (2^20)" AS ?comment)
  } UNION {
    ?c so:keyLen ?value .
    BIND("KEY_LEN" AS ?name)
    BIND("store key width in bytes (SHA-256)" AS ?comment)
  }
}
ORDER BY ?name
