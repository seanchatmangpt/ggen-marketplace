@prefix c4: <https://seanchatmangpt.github.io/ontology/c4#> .
@prefix ex: <https://example.org/c4sample#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:operator a c4:Person ;
    rdfs:label "Operator" ;
    c4:uses ex:agentsPlatform ;
    c4:relLabel "Reviews work orders" .

ex:agentsPlatform a c4:SoftwareSystem ;
    rdfs:label "Agents Platform" ;
    c4:uses ex:ledgerSystem ;
    c4:relLabel "Appends receipts" .

ex:ledgerSystem a c4:SoftwareSystem ;
    rdfs:label "Ledger System" .

ex:webApp a c4:Container ;
    rdfs:label "Web App" ;
    c4:technology "Phoenix" ;
    c4:inSystem ex:agentsPlatform ;
    c4:uses ex:planner ;
    c4:relLabel "Requests plans" .

ex:planner a c4:Container ;
    rdfs:label "Planner" ;
    c4:technology "Python" ;
    c4:inSystem ex:agentsPlatform .
