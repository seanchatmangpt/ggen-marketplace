@prefix c4: <https://seanchatmangpt.github.io/ontology/c4#> .
@prefix aoq: <urn:aoq:> .

# C4 typing overlay for the aoq-pack ontology (FNOX-SJ-VIEW-2). Subjects are the aoq IRIs
# themselves, so every node label is read from aoq-pack/ontology.ttl rdfs:label (not copied here).
# Only typing and edge facts live in this overlay. aoq-pack is not edited.
# The replay script concatenates aoq-pack/ontology.ttl and this file into a scratch ontology.

# System of interest and external system (context view)
<urn:aoq:> a c4:SoftwareSystem ;
    c4:uses aoq:WireStream ;
    c4:relLabel "Carries frames on" .

aoq:WireStream a c4:SoftwareSystem .

# Containers inside the AOQ system (container view)
aoq:Frame a c4:Container ;
    c4:inSystem <urn:aoq:> ;
    c4:uses aoq:Header ;
    c4:relLabel "Starts with" .

aoq:Header a c4:Container ;
    c4:inSystem <urn:aoq:> .

aoq:PartitionStream a c4:Container ;
    c4:inSystem <urn:aoq:> ;
    c4:uses aoq:Ring ;
    c4:relLabel "Backed by" .

aoq:Ring a c4:Container ;
    c4:inSystem <urn:aoq:> .
