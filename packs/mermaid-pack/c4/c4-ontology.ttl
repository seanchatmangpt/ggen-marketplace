@prefix c4: <https://seanchatmangpt.github.io/ontology/c4#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Small C4 vocabulary consumed by templates/c4_context.mmd.tmpl and c4_containers.mmd.tmpl.

c4:Person a owl:Class ; rdfs:label "Person" .
c4:SoftwareSystem a owl:Class ; rdfs:label "SoftwareSystem" .
c4:Container a owl:Class ; rdfs:label "Container" .

c4:inSystem a owl:ObjectProperty ;
    rdfs:label "inSystem" ;
    rdfs:domain c4:Container ;
    rdfs:range c4:SoftwareSystem .

c4:uses a owl:ObjectProperty ;
    rdfs:label "uses" ;
    rdfs:comment "Person/System/Container uses Person/System/Container; label via c4:usesLabel on the subject is not required, edge label is c4:relLabel." .

c4:technology a owl:DatatypeProperty ; rdfs:label "technology" ; rdfs:domain c4:Container .
c4:relLabel a owl:DatatypeProperty ; rdfs:label "relLabel" .
