---
to: "revops/fde20/OPERATING_CONTRACT.md"
sparql:
  offer: |
    PREFIX fde20: <http://seanchatmangpt.github.io/packs/fde20-revops#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?title ?description ?rate ?currency ?unit ?llmRole ?deterministic ?brce ?receipt WHERE { ?o a fde20:Offer ; dcterms:title ?title ; dcterms:description ?description ; fde20:hourlyRate ?rate ; fde20:currency ?currency ; fde20:billingUnit ?unit ; fde20:llmRole ?llmRole ; fde20:deterministicFirst ?deterministic ; fde20:brceRequired ?brce ; fde20:receiptRequired ?receipt . }
  roles: |
    PREFIX fde20: <http://seanchatmangpt.github.io/packs/fde20-revops#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?order ?label ?responsibility WHERE { ?r a fde20:EnterpriseRole ; fde20:roleOrder ?order ; skos:prefLabel ?label ; fde20:responsibility ?responsibility . } ORDER BY ?order
  stages: |
    PREFIX fde20: <http://seanchatmangpt.github.io/packs/fde20-revops#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?order ?label ?slug ?kind ?entry ?exit ?ceiling ?receipt WHERE { ?s a fde20:RevOpsStage ; skos:prefLabel ?label ; fde20:stageOrder ?order ; fde20:stageSlug ?slug ; fde20:operationKind ?kind ; fde20:entryCriterion ?entry ; fde20:exitCriterion ?exit ; fde20:standingCeiling ?ceiling ; fde20:requiresReceipt ?receipt . } ORDER BY ?order
  service: |
    PREFIX fde20: <http://seanchatmangpt.github.io/packs/fde20-revops#>
    SELECT ?availability ?rto ?rpo ?audit ?receipts WHERE { ?s a fde20:ServiceLevelProfile ; fde20:availabilityTarget ?availability ; fde20:rtoMinutes ?rto ; fde20:rpoMinutes ?rpo ; fde20:auditRetentionDays ?audit ; fde20:receiptRetentionDays ?receipts . }
---
