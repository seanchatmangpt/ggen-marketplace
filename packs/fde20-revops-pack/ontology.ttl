@prefix fde20: <http://seanchatmangpt.github.io/packs/fde20-revops#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fde20:TwentyDollarFDE a fde20:Offer, prov:Entity ;
  dcterms:title "$20/hr FDE RevOps — Fortune 5 profile" ;
  dcterms:description "Deterministic-first Fortune 5 FDE RevOps at exactly USD 20/hour. Enterprise readiness is executable admission control; LLM output is bounded exception handling only; every DO consequence is BRCE-receipted." ;
  fde20:hourlyRate "20.00"^^xsd:decimal ; fde20:currency "USD" ; fde20:billingUnit "hour" ;
  fde20:deterministicFirst true ; fde20:llmRole "exception-handling-only" ; fde20:brceRequired true ; fde20:receiptRequired true ;
  fde20:hasChallengerMotion fde20:DefaultChallengerMotion ; fde20:hasServiceLevelProfile fde20:ReferenceServiceLevel ; fde20:hasDeploymentEnvelope fde20:Fortune5DeploymentEnvelope ;
  fde20:hasRole fde20:ExecutiveSponsor, fde20:BusinessOwner, fde20:TechnicalAuthority, fde20:SecurityAuthority, fde20:DataOwner, fde20:ProcurementAuthority, fde20:FinanceAuthority, fde20:ServiceOwner ;
  fde20:hasReadinessDimension fde20:ExecutiveGovernance, fde20:CommercialProcurement, fde20:IdentitySecurity, fde20:DataPrivacy, fde20:PlatformCloud, fde20:SoftwareSupplyChain, fde20:ReliabilityObservability, fde20:ContinuityRecovery, fde20:ChangeRelease, fde20:FinOpsCapacity, fde20:ProcessIntelligence, fde20:PortabilityExit ;
  fde20:hasStage fde20:SignalSelect, fde20:AccountAdmit, fde20:AuthorityResolve, fde20:ChallengerReframe, fde20:WorkflowQualify, fde20:EnterpriseAdmit, fde20:ConstructOffer, fde20:PilotPlan, fde20:Commit, fde20:Deliver, fde20:Operate, fde20:Expand .

fde20:DefaultChallengerMotion a fde20:ChallengerMotion ; skos:prefLabel "$20/hr FDE Fortune 5 Challenger motion" ;
  fde20:teachingThesis "Enterprise FDE cost is dominated by unresolved variation, authority ambiguity, handoffs, waiting, rework, and evidence production—not typing code." ;
  fde20:commercialInsight "When account, authority, process, controls, and evidence are first-class graph objects, Fortune 5 scale does not require proportionally more coordination." ;
  fde20:newWay "Compile admitted enterprise facts into deterministic workflows, controls, deployment contracts, and receipts at $20/hr; humans and LLMs handle bounded exceptions." ;
  fde20:proofStandard "No enterprise-readiness claim without exact-subject execution, authority evidence, control closure, consequence evidence, receipt identity, and replay." ;
  fde20:callToAction "Select one revenue workflow, resolve all eight enterprise authorities, admit twelve readiness dimensions, execute one bounded pilot through BRCE, then expand only from ALIVE evidence." .

fde20:ExecutiveSponsor a fde20:EnterpriseRole, org:Role ; skos:prefLabel "Executive sponsor" ; fde20:roleOrder 1 ; fde20:responsibility "Strategic outcome and escalation authority." .
fde20:BusinessOwner a fde20:EnterpriseRole, org:Role ; skos:prefLabel "Business owner" ; fde20:roleOrder 2 ; fde20:responsibility "Workflow value and acceptance consequence." .
fde20:TechnicalAuthority a fde20:EnterpriseRole, org:Role ; skos:prefLabel "Technical authority" ; fde20:roleOrder 3 ; fde20:responsibility "Architecture, integration, and platform admission." .
fde20:SecurityAuthority a fde20:EnterpriseRole, org:Role ; skos:prefLabel "Security authority" ; fde20:roleOrder 4 ; fde20:responsibility "Identity, threat, secrets, and security admission." .
fde20:DataOwner a fde20:EnterpriseRole, org:Role ; skos:prefLabel "Data owner" ; fde20:roleOrder 5 ; fde20:responsibility "Classification, privacy, residency, and lineage." .
fde20:ProcurementAuthority a fde20:EnterpriseRole, org:Role ; skos:prefLabel "Procurement authority" ; fde20:roleOrder 6 ; fde20:responsibility "Sourcing, contract route, and purchase authority." .
fde20:FinanceAuthority a fde20:EnterpriseRole, org:Role ; skos:prefLabel "Finance authority" ; fde20:roleOrder 7 ; fde20:responsibility "Budget, cost attribution, and economic guardrails." .
fde20:ServiceOwner a fde20:EnterpriseRole, org:Role ; skos:prefLabel "Service owner" ; fde20:roleOrder 8 ; fde20:responsibility "SLO, incident, continuity, and operations." .

fde20:SignalSelect a fde20:RevOpsStage ; skos:prefLabel "Signal select" ; fde20:stageOrder 1 ; fde20:stageSlug "signal-select" ; fde20:operationKind "SELECT" ; fde20:objective "Choose a bounded market signal." ; fde20:entryCriterion "Signal observed with provenance." ; fde20:exitCriterion "Signal admitted or typed-refused." ; fde20:standingCeiling "OBSERVED" ; fde20:requiresReceipt false ; fde20:nextStage fde20:AccountAdmit .
fde20:AccountAdmit a fde20:RevOpsStage ; skos:prefLabel "Account admit" ; fde20:stageOrder 2 ; fde20:stageSlug "account-admit" ; fde20:operationKind "SELECT" ; fde20:objective "Resolve ICP, account, business unit, regulated context, and exclusions." ; fde20:entryCriterion "Account identity resolved." ; fde20:exitCriterion "Account admitted or refused." ; fde20:standingCeiling "ADMITTED" ; fde20:requiresReceipt false ; fde20:nextStage fde20:AuthorityResolve .
fde20:AuthorityResolve a fde20:RevOpsStage ; skos:prefLabel "Authority resolve" ; fde20:stageOrder 3 ; fde20:stageSlug "authority-resolve" ; fde20:operationKind "SELECT" ; fde20:objective "Resolve eight enterprise authorities and decision rights." ; fde20:entryCriterion "Account admitted." ; fde20:exitCriterion "All required authorities resolved." ; fde20:standingCeiling "ADMITTED" ; fde20:requiresReceipt false ; fde20:nextStage fde20:ChallengerReframe .
fde20:ChallengerReframe a fde20:RevOpsStage ; skos:prefLabel "Challenger reframe" ; fde20:stageOrder 4 ; fde20:stageSlug "challenger-reframe" ; fde20:operationKind "CONSTRUCT" ; fde20:objective "Construct a teach-tailor-take-control insight." ; fde20:entryCriterion "Account and authorities admitted." ; fde20:exitCriterion "Reversible Challenger brief provenance-bound." ; fde20:standingCeiling "CANDIDATE" ; fde20:requiresReceipt false ; fde20:nextStage fde20:WorkflowQualify .
fde20:WorkflowQualify a fde20:RevOpsStage ; skos:prefLabel "Workflow qualify" ; fde20:stageOrder 5 ; fde20:stageSlug "workflow-qualify" ; fde20:operationKind "CONSTRUCT" ; fde20:objective "Bound objects, transitions, value, evidence, and economics." ; fde20:entryCriterion "Reframe tied to measurable workflow." ; fde20:exitCriterion "Scope and acceptance admitted or refused." ; fde20:standingCeiling "ADMITTED" ; fde20:requiresReceipt false ; fde20:nextStage fde20:EnterpriseAdmit .
fde20:EnterpriseAdmit a fde20:RevOpsStage ; skos:prefLabel "Enterprise admit" ; fde20:stageOrder 6 ; fde20:stageSlug "enterprise-admit" ; fde20:operationKind "SELECT" ; fde20:objective "Admit Fortune 5 authority, controls, SLO, deployment, and evidence closure." ; fde20:entryCriterion "Workflow qualification admitted." ; fde20:exitCriterion "All enterprise refusal gates clean." ; fde20:standingCeiling "ADMITTED" ; fde20:requiresReceipt false ; fde20:nextStage fde20:ConstructOffer .
fde20:ConstructOffer a fde20:RevOpsStage ; skos:prefLabel "Construct offer" ; fde20:stageOrder 7 ; fde20:stageSlug "construct-offer" ; fde20:operationKind "CONSTRUCT" ; fde20:objective "Compile scope, $20/hr economics, controls, SLO, acceptance, and exclusions." ; fde20:entryCriterion "Enterprise admission clean." ; fde20:exitCriterion "Reversible enterprise offer constructed." ; fde20:standingCeiling "CANDIDATE" ; fde20:requiresReceipt false ; fde20:nextStage fde20:PilotPlan .
fde20:PilotPlan a fde20:RevOpsStage ; skos:prefLabel "Pilot plan" ; fde20:stageOrder 8 ; fde20:stageSlug "pilot-plan" ; fde20:operationKind "CONSTRUCT" ; fde20:objective "Bound blast radius, rollback, telemetry, security, cost, and acceptance." ; fde20:entryCriterion "Enterprise offer constructed." ; fde20:exitCriterion "Pilot evidence DAG explicit." ; fde20:standingCeiling "CANDIDATE" ; fde20:requiresReceipt false ; fde20:nextStage fde20:Commit .
fde20:Commit a fde20:RevOpsStage ; skos:prefLabel "Commit" ; fde20:stageOrder 9 ; fde20:stageSlug "commit" ; fde20:operationKind "DO" ; fde20:objective "Actuate commercial commitment through BRCE." ; fde20:entryCriterion "Offer accepted and authority resolved." ; fde20:exitCriterion "Commercial consequence receipted." ; fde20:standingCeiling "ALIVE" ; fde20:requiresReceipt true ; fde20:authorityBoundary "BRCE" ; fde20:receiptType "commercial-commitment-receipt" ; fde20:nextStage fde20:Deliver .
fde20:Deliver a fde20:RevOpsStage ; skos:prefLabel "Deliver" ; fde20:stageOrder 10 ; fde20:stageSlug "deliver" ; fde20:operationKind "DO" ; fde20:objective "Actuate admitted capability with zero unreceipted actuation." ; fde20:entryCriterion "Committed executable scope exists." ; fde20:exitCriterion "Exact subject executes acceptance evidence." ; fde20:standingCeiling "ALIVE" ; fde20:requiresReceipt true ; fde20:authorityBoundary "BRCE" ; fde20:receiptType "delivery-receipt" ; fde20:nextStage fde20:Operate .
fde20:Operate a fde20:RevOpsStage ; skos:prefLabel "Operate" ; fde20:stageOrder 11 ; fde20:stageSlug "operate" ; fde20:operationKind "DO" ; fde20:objective "Operate under SLO, security, FinOps, conformance, incident, continuity, and audit controls." ; fde20:entryCriterion "Delivery ALIVE and production authority admitted." ; fde20:exitCriterion "Operation stays bounded or emits typed breach/refusal receipts." ; fde20:standingCeiling "ALIVE" ; fde20:requiresReceipt true ; fde20:authorityBoundary "BRCE" ; fde20:receiptType "operations-receipt" ; fde20:nextStage fde20:Expand .
fde20:Expand a fde20:RevOpsStage ; skos:prefLabel "Expand" ; fde20:stageOrder 12 ; fde20:stageSlug "expand" ; fde20:operationKind "SELECT" ; fde20:objective "Select expansion from receipted operating evidence." ; fde20:entryCriterion "Operation has ALIVE receipts." ; fde20:exitCriterion "New signal selected or refused." ; fde20:standingCeiling "OBSERVED" ; fde20:requiresReceipt false .

fde20:ExecutiveGovernance a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Executive governance" ; fde20:dimensionOrder 1 ; fde20:dimensionSlug "executive-governance" ; fde20:hasControl fde20:EG01, fde20:EG02, fde20:EG03 .
fde20:CommercialProcurement a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Commercial and procurement" ; fde20:dimensionOrder 2 ; fde20:dimensionSlug "commercial-procurement" ; fde20:hasControl fde20:CP01, fde20:CP02, fde20:CP03 .
fde20:IdentitySecurity a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Identity and security" ; fde20:dimensionOrder 3 ; fde20:dimensionSlug "identity-security" ; fde20:hasControl fde20:IS01, fde20:IS02, fde20:IS03 .
fde20:DataPrivacy a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Data and privacy" ; fde20:dimensionOrder 4 ; fde20:dimensionSlug "data-privacy" ; fde20:hasControl fde20:DP01, fde20:DP02, fde20:DP03 .
fde20:PlatformCloud a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Platform and cloud" ; fde20:dimensionOrder 5 ; fde20:dimensionSlug "platform-cloud" ; fde20:hasControl fde20:PC01, fde20:PC02, fde20:PC03 .
fde20:SoftwareSupplyChain a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Software supply chain" ; fde20:dimensionOrder 6 ; fde20:dimensionSlug "software-supply-chain" ; fde20:hasControl fde20:SC01, fde20:SC02, fde20:SC03 .
fde20:ReliabilityObservability a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Reliability and observability" ; fde20:dimensionOrder 7 ; fde20:dimensionSlug "reliability-observability" ; fde20:hasControl fde20:RO01, fde20:RO02, fde20:RO03 .
fde20:ContinuityRecovery a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Continuity and recovery" ; fde20:dimensionOrder 8 ; fde20:dimensionSlug "continuity-recovery" ; fde20:hasControl fde20:CR01, fde20:CR02, fde20:CR03 .
fde20:ChangeRelease a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Change and release" ; fde20:dimensionOrder 9 ; fde20:dimensionSlug "change-release" ; fde20:hasControl fde20:CH01, fde20:CH02, fde20:CH03 .
fde20:FinOpsCapacity a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "FinOps and capacity" ; fde20:dimensionOrder 10 ; fde20:dimensionSlug "finops-capacity" ; fde20:hasControl fde20:FC01, fde20:FC02, fde20:FC03 .
fde20:ProcessIntelligence a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Process intelligence" ; fde20:dimensionOrder 11 ; fde20:dimensionSlug "process-intelligence" ; fde20:hasControl fde20:PI01, fde20:PI02, fde20:PI03 .
fde20:PortabilityExit a fde20:ReadinessDimension, prov:Plan ; skos:prefLabel "Portability and exit" ; fde20:dimensionOrder 12 ; fde20:dimensionSlug "portability-exit" ; fde20:hasControl fde20:PE01, fde20:PE02, fde20:PE03 .

fde20:EG01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "EG-01" ; dcterms:title "Outcome charter" ; fde20:acceptanceCriterion "Outcome, baseline, target, owner, and acceptance consequence admitted." ; fde20:evidenceType "outcome-charter" ; fde20:authorityRole fde20:BusinessOwner ; fde20:requiresReceipt false ; fde20:standingCeiling "ADMITTED" .
fde20:EG02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "EG-02" ; dcterms:title "Authority map" ; fde20:acceptanceCriterion "All eight enterprise authorities identity-resolved." ; fde20:evidenceType "authority-map" ; fde20:authorityRole fde20:ExecutiveSponsor ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:EG03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "EG-03" ; dcterms:title "Decision rights" ; fde20:acceptanceCriterion "Decision classes mapped to authority; no ambient execution authority." ; fde20:evidenceType "decision-rights-policy" ; fde20:authorityRole fde20:ExecutiveSponsor ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:CP01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "CP-01" ; dcterms:title "Commercial route" ; fde20:acceptanceCriterion "Sourcing, contract, ordering, and onboarding route explicit." ; fde20:evidenceType "commercial-route" ; fde20:authorityRole fde20:ProcurementAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:CP02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "CP-02" ; dcterms:title "Scope and acceptance" ; fde20:acceptanceCriterion "Scope, exclusions, acceptance evidence, and change boundary machine-readable." ; fde20:evidenceType "scope-acceptance-contract" ; fde20:authorityRole fde20:BusinessOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:CP03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "CP-03" ; dcterms:title "Economic guardrail" ; fde20:acceptanceCriterion "USD 20/hour preserved with attributable downstream cost." ; fde20:evidenceType "economic-receipt" ; fde20:authorityRole fde20:FinanceAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:IS01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "IS-01" ; dcterms:title "Identity and least privilege" ; fde20:acceptanceCriterion "Human, workload, and connector identities receive admitted capabilities only." ; fde20:evidenceType "iam-policy-evidence" ; fde20:authorityRole fde20:SecurityAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:IS02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "IS-02" ; dcterms:title "Secrets and key custody" ; fde20:acceptanceCriterion "Secrets, keys, rotation, revocation, and export rules explicit." ; fde20:evidenceType "key-custody-evidence" ; fde20:authorityRole fde20:SecurityAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:IS03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "IS-03" ; dcterms:title "Threat and abuse boundary" ; fde20:acceptanceCriterion "Threats, abuse cases, refusals, and escalation admitted before production DO." ; fde20:evidenceType "threat-model" ; fde20:authorityRole fde20:SecurityAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:DP01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "DP-01" ; dcterms:title "Data classification" ; fde20:acceptanceCriterion "Sensitivity, purpose, and prohibited use bound to each source." ; fde20:evidenceType "data-classification-register" ; fde20:authorityRole fde20:DataOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:DP02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "DP-02" ; dcterms:title "Residency and privacy" ; fde20:acceptanceCriterion "Residency, retention, deletion, privacy, and cross-border rules explicit." ; fde20:evidenceType "privacy-residency-policy" ; fde20:authorityRole fde20:DataOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:DP03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "DP-03" ; dcterms:title "Lineage and provenance" ; fde20:acceptanceCriterion "Inputs and derived artifacts retain identity, lineage, and replay provenance." ; fde20:evidenceType "provenance-receipt" ; fde20:authorityRole fde20:DataOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:PC01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "PC-01" ; dcterms:title "Infrastructure as code" ; fde20:acceptanceCriterion "Production infrastructure reproducibly constructed from admitted declarative source." ; fde20:evidenceType "iac-plan-and-apply-receipt" ; fde20:authorityRole fde20:TechnicalAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:PC02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "PC-02" ; dcterms:title "Isolation and tenancy" ; fde20:acceptanceCriterion "Tenant, account, project, namespace, network, and environment isolation explicit." ; fde20:evidenceType "isolation-proof" ; fde20:authorityRole fde20:TechnicalAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:PC03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "PC-03" ; dcterms:title "Multi-region deployment" ; fde20:acceptanceCriterion "Failure domains, placement, traffic route, and failover explicit." ; fde20:evidenceType "deployment-topology-receipt" ; fde20:authorityRole fde20:ServiceOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:SC01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "SC-01" ; dcterms:title "Dependency closure" ; fde20:acceptanceCriterion "Runtime, build, generated, and transitive dependencies pinned or bounded." ; fde20:evidenceType "dependency-lock-evidence" ; fde20:authorityRole fde20:TechnicalAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:SC02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "SC-02" ; dcterms:title "SBOM and provenance" ; fde20:acceptanceCriterion "Every releasable artifact has SBOM and signed/content-addressed provenance." ; fde20:evidenceType "sbom-provenance" ; fde20:authorityRole fde20:SecurityAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:SC03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "SC-03" ; dcterms:title "Artifact integrity" ; fde20:acceptanceCriterion "Artifacts digest-verified build-to-deploy; mutation outside release refused." ; fde20:evidenceType "artifact-integrity-receipt" ; fde20:authorityRole fde20:SecurityAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:RO01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "RO-01" ; dcterms:title "Service level objectives" ; fde20:acceptanceCriterion "Availability, latency, correctness, saturation, and error budget declared." ; fde20:evidenceType "slo-definition" ; fde20:authorityRole fde20:ServiceOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:RO02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "RO-02" ; dcterms:title "Telemetry closure" ; fde20:acceptanceCriterion "Logs, metrics, traces, receipts, and events correlate by subject/execution." ; fde20:evidenceType "telemetry-correlation-proof" ; fde20:authorityRole fde20:ServiceOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:RO03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "RO-03" ; dcterms:title "Incident response" ; fde20:acceptanceCriterion "Detect, classify, contain, rollback, recover, communicate, and receipt incidents." ; fde20:evidenceType "incident-drill-receipt" ; fde20:authorityRole fde20:ServiceOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:CR01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "CR-01" ; dcterms:title "Recovery objectives" ; fde20:acceptanceCriterion "RTO/RPO explicit and mapped to backup/failover mechanisms." ; fde20:evidenceType "recovery-objective-profile" ; fde20:authorityRole fde20:ServiceOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:CR02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "CR-02" ; dcterms:title "Backup and restore" ; fde20:acceptanceCriterion "Backups encrypted, identity-bound, retention-governed, and restore-tested." ; fde20:evidenceType "restore-test-receipt" ; fde20:authorityRole fde20:DataOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:CR03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "CR-03" ; dcterms:title "Regional failure drill" ; fde20:acceptanceCriterion "Failure domain isolated and service restored within objectives." ; fde20:evidenceType "regional-failover-receipt" ; fde20:authorityRole fde20:ServiceOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:CH01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "CH-01" ; dcterms:title "Change classification" ; fde20:acceptanceCriterion "Changes routed by consequence through proportionate verification and authority." ; fde20:evidenceType "change-policy" ; fde20:authorityRole fde20:TechnicalAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:CH02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "CH-02" ; dcterms:title "Progressive release" ; fde20:acceptanceCriterion "Bounded rollout, health gates, stop conditions, and reversible progression." ; fde20:evidenceType "release-receipt" ; fde20:authorityRole fde20:ServiceOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:CH03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "CH-03" ; dcterms:title "Rollback" ; fde20:acceptanceCriterion "Consequential release has tested rollback or forward-repair path." ; fde20:evidenceType "rollback-drill-receipt" ; fde20:authorityRole fde20:ServiceOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:FC01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "FC-01" ; dcterms:title "Cost attribution" ; fde20:acceptanceCriterion "Compute, storage, network, model, vendor, and exception cost attributable." ; fde20:evidenceType "cost-attribution-report" ; fde20:authorityRole fde20:FinanceAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:FC02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "FC-02" ; dcterms:title "Budget guardrails" ; fde20:acceptanceCriterion "Budget ceilings and anomalies can refuse/degrade nonessential actuation." ; fde20:evidenceType "budget-policy" ; fde20:authorityRole fde20:FinanceAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ADMITTED" .
fde20:FC03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "FC-03" ; dcterms:title "Capacity proof" ; fde20:acceptanceCriterion "Load, concurrency, queueing, saturation, and scaling measured." ; fde20:evidenceType "capacity-test-receipt" ; fde20:authorityRole fde20:ServiceOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:PI01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "PI-01" ; dcterms:title "OCEL v2 event contract" ; fde20:acceptanceCriterion "Material transitions emit object-centric events linking objects, execution, authority, receipts." ; fde20:evidenceType "ocel-v2-conformance" ; fde20:authorityRole fde20:BusinessOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:PI02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "PI-02" ; dcterms:title "Conformance checking" ; fde20:acceptanceCriterion "Observed execution compared with admitted graph; deviations typed." ; fde20:evidenceType "conformance-report" ; fde20:authorityRole fde20:BusinessOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:PI03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "PI-03" ; dcterms:title "Flow economics" ; fde20:acceptanceCriterion "Lead, touch, wait, WIP, rework, and throughput measurable." ; fde20:evidenceType "flow-economics-report" ; fde20:authorityRole fde20:FinanceAuthority ; fde20:requiresReceipt false ; fde20:standingCeiling "ALIVE" .
fde20:PE01 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "PE-01" ; dcterms:title "Data export" ; fde20:acceptanceCriterion "Data, config, receipts, and process history have machine-readable export." ; fde20:evidenceType "export-test-receipt" ; fde20:authorityRole fde20:DataOwner ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .
fde20:PE02 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "PE-02" ; dcterms:title "Provider portability" ; fde20:acceptanceCriterion "Provider dependencies explicit with graph replacement boundaries." ; fde20:evidenceType "portability-map" ; fde20:authorityRole fde20:TechnicalAuthority ; fde20:requiresReceipt false ; fde20:standingCeiling "ADMITTED" .
fde20:PE03 a fde20:EnterpriseControl, prov:Plan ; fde20:controlCode "PE-03" ; dcterms:title "Exit and revocation" ; fde20:acceptanceCriterion "Termination, revocation, data disposition, key destruction, and evidence retention executable." ; fde20:evidenceType "exit-drill-receipt" ; fde20:authorityRole fde20:ProcurementAuthority ; fde20:requiresReceipt true ; fde20:standingCeiling "ALIVE" .

fde20:ReferenceServiceLevel a fde20:ServiceLevelProfile, prov:Plan ; skos:prefLabel "Fortune 5 reference service-level profile" ; dcterms:description "Qualification default; consumers may tighten it. Weakening below gate floors requires a pack/version change." ; fde20:availabilityTarget "99.95"^^xsd:decimal ; fde20:rtoMinutes 60 ; fde20:rpoMinutes 15 ; fde20:auditRetentionDays 365 ; fde20:receiptRetentionDays 2555 .
fde20:Fortune5DeploymentEnvelope a fde20:DeploymentEnvelope, prov:Plan ; skos:prefLabel "Fortune 5 deployment envelope" ; fde20:regionsMinimum 2 ; fde20:multiCloudCapable true ; fde20:tenantIsolationRequired true ; fde20:infrastructureAsCodeRequired true ; fde20:rollbackRequired true ; fde20:sbomRequired true ; fde20:signedProvenanceRequired true ; fde20:observabilityRequired true ; fde20:ocelV2Required true .
