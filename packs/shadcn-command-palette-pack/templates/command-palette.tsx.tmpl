{% raw %}
"use client";

import { useEffect, useMemo, useState } from "react";
import { Dialog, DialogContent, DialogTitle } from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";

export interface PaletteEntity {
  id: string;
  label: string;
}

export interface CommandPaletteProps {
  entities: PaletteEntity[];
  onSelect: (entity: PaletteEntity) => void;
}

/**
 * Cmd+K / Ctrl+K global command palette. Filters the real entity list
 * passed in — never a hardcoded demo array.
 */
export function CommandPalette({ entities, onSelect }: CommandPaletteProps) {
  const [open, setOpen] = useState(false);
  const [query, setQuery] = useState("");
  const [highlight, setHighlight] = useState(0);

  useEffect(() => {
    function onKeyDown(event: KeyboardEvent) {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        setOpen((prev) => !prev);
      }
    }
    window.addEventListener("keydown", onKeyDown);
    return () => window.removeEventListener("keydown", onKeyDown);
  }, []);

  useEffect(() => {
    if (!open) {
      setQuery("");
      setHighlight(0);
    }
  }, [open]);

  const results = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return entities;
    return entities.filter(
      (entity) => entity.label.toLowerCase().includes(q) || entity.id.toLowerCase().includes(q),
    );
  }, [entities, query]);

  function onKeyDownInput(event: React.KeyboardEvent<HTMLInputElement>) {
    if (event.key === "ArrowDown") {
      event.preventDefault();
      setHighlight((h) => Math.min(h + 1, results.length - 1));
    } else if (event.key === "ArrowUp") {
      event.preventDefault();
      setHighlight((h) => Math.max(h - 1, 0));
    } else if (event.key === "Enter" && results[highlight]) {
      event.preventDefault();
      onSelect(results[highlight]);
      setOpen(false);
    }
  }

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogContent className="p-0 gap-0 overflow-hidden">
        <DialogTitle className="sr-only">Jump to entity</DialogTitle>
        <div className="p-3 border-b">
          <Label htmlFor="command-palette-input" className="sr-only">
            Search entities
          </Label>
          <Input
            id="command-palette-input"
            autoFocus
            placeholder="Jump to entity by name or ID…"
            value={query}
            onChange={(e) => {
              setQuery(e.target.value);
              setHighlight(0);
            }}
            onKeyDown={onKeyDownInput}
          />
        </div>
        <ul className="max-h-72 overflow-y-auto py-1">
          {results.length === 0 ? (
            <li className="px-3 py-2 text-sm text-muted-foreground">No matching entities.</li>
          ) : (
            results.map((entity, index) => (
              <li
                key={entity.id}
                className={`px-3 py-2 text-sm cursor-pointer ${
                  index === highlight ? "bg-accent text-accent-foreground" : ""
                }`}
                onMouseEnter={() => setHighlight(index)}
                onClick={() => {
                  onSelect(entity);
                  setOpen(false);
                }}
              >
                {entity.label}{" "}
                <span className="text-muted-foreground font-mono text-xs">{entity.id}</span>
              </li>
            ))
          )}
        </ul>
      </DialogContent>
    </Dialog>
  );
}
{% endraw %}
