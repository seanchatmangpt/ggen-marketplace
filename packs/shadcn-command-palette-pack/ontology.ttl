@prefix pack: <urn:ggen-marketplace:shadcn-command-palette-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pack:CommandPalette a pack:ReactComponent ;
    rdfs:label "CommandPalette" ;
    pack:shortcut "Cmd+K / Ctrl+K" ;
    pack:host "shadcn Dialog" ;
    pack:filterField "name and id, as-you-type" ;
    pack:selectKey "Enter" ;
    rdfs:comment "Global keyboard-shortcut listener opens a shadcn Dialog with an Input search field; filters the passed entity list client-side; Enter invokes onSelect for the highlighted entity." .
