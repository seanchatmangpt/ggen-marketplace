@prefix gsh: <http://seanchatmangpt.github.io/packs/ggen-self-host#> .

# Minimal exact-revision observation for bounded pack manufacture. No Crown is
# asserted: this fixture proves the pack can compile an observation, not that
# the observed repository has earned self-host standing.
gsh:QualificationProgram
    a gsh:SelfHostProgram ;
    gsh:programId "marketplace-qualification" ;
    gsh:repository "seanchatmangpt/ggen-marketplace" ;
    gsh:revision "synthetic-qualification-subject" ;
    gsh:observationDigest "sha256:synthetic-qualification" ;
    gsh:observerVersion "marketplace-qualification/1" ;
    gsh:fileCount 0 ;
    gsh:crateCount 0 ;
    gsh:workspaceMemberCount 0 ;
    gsh:packCount 0 ;
    gsh:workflowCount 0 ;
    gsh:templateCount 0 ;
    gsh:scriptCount 0 ;
    gsh:generatedCount 0 ;
    gsh:findingCount 0 ;
    gsh:blockingFindingCount 0 ;
    gsh:unknownAuthorityCount 0 .
