@prefix pack: <urn:ggen-marketplace:neako-web-deckgl-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:Project a pack:SourceProject ;
    rdfs:label "nuxt-ui-template-dashboard" ;
    pack:sourcePath "/Users/sac/seth/neako-web"^^xsd:string ;
    pack:framework "Nuxt 3 (Vue)" ;
    pack:packageManager "pnpm" ;
    rdfs:comment "Admitted from a local scan of package.json, components.json (absent), and src/app tree. Not a React project; no shadcn/ui config found." .

pack:DeckGLUsage a pack:TechnologyFinding ;
    pack:concernsProject pack:Project ;
    pack:technology "deck.gl" ;
    pack:status "used" ;
    rdfs:comment "deck.gl is a real, exercised dependency (not merely listed in package.json): app/components/verse/views/GlobeView.vue imports and instantiates Deck core and multiple deck.gl layers for a globe visualization." .

pack:DeckLayer_Deck a pack:DeckGLArtifact ;
    rdfs:label "Deck" ;
    pack:artifactKind "deck.gl core class" ;
    pack:filePath "app/components/verse/views/GlobeView.vue" ;
    rdfs:comment "Instantiated as `new Deck({...})` to drive the globe render surface." .

pack:DeckLayer_GeoJsonLayer a pack:DeckGLArtifact ;
    rdfs:label "GeoJsonLayer" ;
    pack:artifactKind "deck.gl layer class" ;
    pack:filePath "app/components/verse/views/GlobeView.vue" ;
    rdfs:comment "Imported from @deck.gl/layers and instantiated via `new GeoJsonLayer({...})`." .

pack:DeckLayer_ScatterplotLayer a pack:DeckGLArtifact ;
    rdfs:label "ScatterplotLayer" ;
    pack:artifactKind "deck.gl layer class" ;
    pack:filePath "app/components/verse/views/GlobeView.vue" ;
    rdfs:comment "Imported from @deck.gl/layers and instantiated via `new ScatterplotLayer({...})`." .

pack:DeckLayer_TextLayer a pack:DeckGLArtifact ;
    rdfs:label "TextLayer" ;
    pack:artifactKind "deck.gl layer class" ;
    pack:filePath "app/components/verse/views/GlobeView.vue" ;
    rdfs:comment "Imported alongside ScatterplotLayer and GeoJsonLayer from @deck.gl/layers in GlobeView.vue." .

pack:ShadcnUsage a pack:TechnologyFinding ;
    pack:concernsProject pack:Project ;
    pack:technology "shadcn/ui" ;
    pack:status "absent" ;
    rdfs:comment "No shadcn/ui evidence found: no components.json, no components/ui/*.tsx primitives, no class-variance-authority or radix-ui imports in package.json or source. The project's UI layer is @nuxt/ui, a different toolkit; this is stated plainly rather than fabricating shadcn usage." .
