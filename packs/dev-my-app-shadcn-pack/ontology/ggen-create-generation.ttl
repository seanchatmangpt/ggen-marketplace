@prefix gc: <https://ggen.io/ontology/ggen-create#> .

gc:subject a gc:GenerationSubject ;
    gc:name "my-app" ;
    gc:upper "MYAPP" ;
    gc:lower "myapp" ;
    gc:capitalized "My-app" ;
    gc:pascal "MyApp" ;
    gc:camel "myApp" ;
    gc:snake "my_app" ;
    gc:upper_snake "MY_APP" ;
    gc:kebab "my-app" ;
    gc:title "My App" .
