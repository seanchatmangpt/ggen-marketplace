---
to: "dev-my-app-shadcn-pack/src/components/ui/card.tsx"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_dev_my_app_shadcn_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
