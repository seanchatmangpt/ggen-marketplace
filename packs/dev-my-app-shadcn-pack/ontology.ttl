# ---------------------------------------------------------------------------
# deck.gl — absence recorded explicitly, not fabricated
# ---------------------------------------------------------------------------

pack:DeckGlFinding
    a pack:AbsentTechnology ;
    pack:name "deck.gl"^^xsd:string ;
    rdfs:comment "No deck.gl or @deck.gl/* package appears in package.json, and no occurrence of DeckGL, ScatterplotLayer, GeoJsonLayer, HexagonLayer, ArcLayer, or generic Layer/viewport code was found anywhere under src/. deck.gl usage is recorded here as absent, not as an unused-but-declared dependency and not fabricated." .
@prefix gc: <https://ggen.io/ontology/ggen-create#> .

gc:gc_subject_dev_my_app_shadcn_pack a gc:GenerationSubject ;
    gc:name "my-app" ;
    gc:upper "MYAPP" ;
    gc:lower "myapp" ;
    gc:capitalized "My-app" ;
    gc:pascal "MyApp" ;
    gc:camel "myApp" ;
    gc:snake "my_app" ;
    gc:upper_snake "MY_APP" ;
    gc:kebab "my-app" ;
    gc:title "My App" .
