@prefix pack: <urn:ggen-marketplace:dev-my-app-shadcn-pack:> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------

pack:Project
    a pack:SourceProject ;
    pack:sourcePath "/Users/sac/dev/my-app"^^xsd:string ;
    pack:framework "Vite + React 18 + TypeScript"^^xsd:string ;
    pack:packageManager "npm"^^xsd:string ;
    pack:uiLibrary "shadcn-ui"^^xsd:string ;
    pack:shadcnStyle "new-york"^^xsd:string ;
    pack:shadcnBaseColor "zinc"^^xsd:string ;
    rdfs:comment "React/Vite/TypeScript project scanned for real shadcn-ui and deck.gl usage evidence in source files, not just declared dependencies." .

# ---------------------------------------------------------------------------
# shadcn configuration
# ---------------------------------------------------------------------------

pack:ComponentsConfig
    a pack:ShadcnConfig ;
    pack:filePath "components.json"^^xsd:string ;
    pack:style "new-york"^^xsd:string ;
    pack:tailwindConfig "tailwind.config.js"^^xsd:string ;
    pack:tailwindCss "src/index.css"^^xsd:string ;
    rdfs:comment "components.json present at project root, confirming an initialized shadcn-ui setup (aliases: @/components, @/components/ui, @/lib, @/hooks)." .

pack:CnHelper
    a pack:UtilityFunction ;
    pack:name "cn"^^xsd:string ;
    pack:filePath "src/lib/utils.ts"^^xsd:string ;
    rdfs:comment "cn() class-merge helper (clsx + tailwind-merge) defined here, the standard shadcn-ui utility used by every generated primitive." .

# ---------------------------------------------------------------------------
# shadcn primitive component files present on disk (src/components/ui/*.tsx)
# ---------------------------------------------------------------------------

pack:ComponentAccordion a pack:ShadcnComponent ; pack:name "accordion"^^xsd:string ; pack:filePath "src/components/ui/accordion.tsx"^^xsd:string .
