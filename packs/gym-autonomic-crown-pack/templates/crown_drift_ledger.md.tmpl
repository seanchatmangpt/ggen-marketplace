---
to: "artifacts/crown-drift-ledger.md"
sparql:
  receipt: |
    PREFIX crown: <https://seanchatmangpt.github.io/ontology/gym-autonomic-crown#>
    SELECT ?base ?count ?repository WHERE {
      ?r a crown:CrownReceipt ; crown:baseSha ?base ; crown:changedCount ?count ; crown:repository ?repository .
    }
  drifted: |
    PREFIX crown: <https://seanchatmangpt.github.io/ontology/gym-autonomic-crown#>
    SELECT ?path ?current ?latest ?default_ref WHERE {
      ?e a crown:SubmoduleEdge ; crown:driftState crown:Drifted ;
         crown:edgePath ?path ; crown:currentSha ?current ; crown:latestSha ?latest ; crown:defaultRef ?default_ref .
    } ORDER BY ?path
  converged: |
    PREFIX crown: <https://seanchatmangpt.github.io/ontology/gym-autonomic-crown#>
    SELECT ?path ?current ?default_ref WHERE {
      ?e a crown:SubmoduleEdge ; crown:driftState crown:Converged ;
         crown:edgePath ?path ; crown:currentSha ?current ; crown:defaultRef ?default_ref .
    } ORDER BY ?path
---
