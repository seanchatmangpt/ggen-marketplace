PREFIX crown: <https://seanchatmangpt.github.io/ontology/gym-autonomic-crown#>
# VIOLATION gate mirroring CROWN_BLOCKED[NOT_GITLINK] in
# gym-ecosystem/scripts/crown-submodules.py::gitlink(). A path that is not a
# 160000/commit entry is not a submodule edge and must never reach the receipt.
SELECT ?observation ?mode WHERE {
  ?observation a crown:GitlinkObservation ; crown:gitlinkMode ?mode .
  FILTER(?mode != "160000")
}
