PREFIX crown: <https://seanchatmangpt.github.io/ontology/gym-autonomic-crown#>
# VIOLATION gate. This pack manufactures an OBSERVATION receipt. It carries no
# runtime actuation authority: consequential DO (submodule checkout, lock
# rewrite, commit, compare-and-swap push) stays behind the superproject's
# GymAct/BRCE-admitted crown workflow. A receipt claiming any boundary other
# than the literal "gitlinks+lock-only" that
# gym-ecosystem/scripts/crown-submodules.py emits is refused here.
SELECT ?receipt ?boundary WHERE {
  ?receipt a crown:CrownReceipt ; crown:authorityBoundary ?boundary .
  FILTER(?boundary != "gitlinks+lock-only")
}
