PREFIX crown: <https://seanchatmangpt.github.io/ontology/gym-autonomic-crown#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
# VIOLATION gate. Any row = the crown receipt would assert a SHA that no real
# git observation backs. Empty result set = pass.
SELECT ?edge ?missing WHERE {
  { ?edge a crown:SubmoduleEdge .
    FILTER NOT EXISTS { ?o a crown:GitlinkObservation ; sosa:hasFeatureOfInterest ?edge }
    BIND("GitlinkObservation" AS ?missing) }
  UNION
  { ?edge a crown:SubmoduleEdge .
    FILTER NOT EXISTS { ?o a crown:RemoteHeadObservation ; sosa:hasFeatureOfInterest ?edge }
    BIND("RemoteHeadObservation" AS ?missing) }
}
