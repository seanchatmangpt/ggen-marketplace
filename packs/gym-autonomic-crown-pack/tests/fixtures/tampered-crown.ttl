    sosa:hasFeatureOfInterest crown:edge_vendor_SREGym ;
    sosa:usedProcedure crown:GitLsTree ;
    crown:gitlinkMode "100644" ;
    sosa:hasSimpleResult "98147f396db0aaa622c7586d4bec5bdcb4cff20f" .

crown:edge_vendor_SREGym_remotehead a crown:RemoteHeadObservation , sosa:Observation ;
    sosa:hasFeatureOfInterest crown:edge_vendor_SREGym ;
    sosa:usedProcedure crown:GitLsRemoteSymref ;
    sosa:hasSimpleResult "98147f396db0aaa622c7586d4bec5bdcb4cff20f" .

crown:receipt crown:hasEdge crown:edge_vendor_SREGym .

