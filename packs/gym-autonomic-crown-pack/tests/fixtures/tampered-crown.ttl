@prefix crown: <https://seanchatmangpt.github.io/ontology/gym-autonomic-crown#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# ---------------------------------------------------------------------------
# Gym ecosystem autonomic crown vocabulary.
#
# Grounded in the REAL maintenance surface of /Users/sac/gym-ecosystem:
#   - scripts/crown-submodules.py  (plan()/gitlink()/remote_head())
#   - artifacts/autonomic-crown.json (schema .../gym-autonomic-crown/v2)
#   - .gitmodules (13 submodule sections: name/path/url)
#   - .github/workflows/autonomic-crown.yml (authority boundary enforcement)
#
# Every class/property below corresponds to a field the real script actually
# emits or a real git fact it actually reads. Nothing is invented from names.
#
# Public vocabulary reuse:
#   sosa:  gitlink SHA and remote HEAD SHA are genuine observations of a
#          feature-of-interest (the submodule) via a procedure (git ls-tree /
#          git ls-remote) at a result time -- sosa is the correct model.
#   prov:  the receipt is a prov:Entity generated by a prov:Activity that used
#          the working tree and the remotes.
#   dcat:  each submodule remote is a dcat:Distribution accessible at a URL.
#   dcterms/skos: identifiers and controlled drift-state concepts.
# Only crown: terms are minted, for concepts no public vocabulary covers
# (gitlink mode assertion, crown authority boundary, drift comparison).
# ---------------------------------------------------------------------------

crown:CrownReceipt a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment "The autonomic-crown.json receipt document as a whole." .

crown:SubmoduleEdge a rdfs:Class ;
    rdfs:subClassOf sosa:FeatureOfInterest ;
    rdfs:comment "One declared .gitmodules edge: name/path/url." .

crown:GitlinkObservation a rdfs:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:comment "Observation of the 160000-mode gitlink SHA recorded in the superproject tree." .

crown:RemoteHeadObservation a rdfs:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:comment "Observation of the remote default-branch symref and its HEAD SHA." .

crown:DriftState a rdfs:Class ; rdfs:subClassOf skos:Concept .
crown:AuthorityBoundary a rdfs:Class .

crown:Converged a crown:DriftState ; skos:prefLabel "converged"@en ;
    rdfs:comment "gitlink SHA equals remote HEAD SHA; changed=false in the receipt." .
crown:Drifted a crown:DriftState ; skos:prefLabel "drifted"@en ;
    rdfs:comment "gitlink SHA differs from remote HEAD SHA; changed=true in the receipt." .

crown:GitlinksAndLockOnly a crown:AuthorityBoundary ;
    skos:prefLabel "gitlinks+lock-only"@en ;
    rdfs:comment "The literal authority_boundary string the real script emits. The crown may mutate ONLY submodule gitlinks and exact SHA pins in ecosystem.lock.toml. Workflow files and other authored surfaces are outside the boundary and their mutation is CROWN_BLOCKED." .

# --- receipt-level properties (exact receipt key names preserved) -----------
crown:schema a rdf:Property ; rdfs:domain crown:CrownReceipt ; rdfs:range xsd:anyURI .
crown:repository a rdf:Property ; rdfs:domain crown:CrownReceipt ; rdfs:range xsd:anyURI .
crown:baseSha a rdf:Property ; rdfs:domain crown:CrownReceipt ; rdfs:range xsd:string ;
    rdfs:comment "git rev-parse HEAD of the superproject at plan time (receipt key base_sha)." .
crown:authorityBoundary a rdf:Property ; rdfs:domain crown:CrownReceipt ; rdfs:range crown:AuthorityBoundary .
crown:hasEdge a rdf:Property ; rdfs:domain crown:CrownReceipt ; rdfs:range crown:SubmoduleEdge .

# --- edge-level properties -------------------------------------------------
crown:edgeName a rdf:Property ; rdfs:subPropertyOf dcterms:identifier ;
    rdfs:domain crown:SubmoduleEdge ; rdfs:range xsd:string .
crown:edgePath a rdf:Property ; rdfs:domain crown:SubmoduleEdge ; rdfs:range xsd:string .
crown:remote a rdf:Property ; rdfs:domain crown:SubmoduleEdge ; rdfs:range dcat:Distribution .
crown:currentSha a rdf:Property ; rdfs:domain crown:SubmoduleEdge ; rdfs:range xsd:string ;
    rdfs:comment "Receipt key `current`: the observed gitlink SHA." .
crown:latestSha a rdf:Property ; rdfs:domain crown:SubmoduleEdge ; rdfs:range xsd:string ;
    rdfs:comment "Receipt key `latest`: the observed remote default-branch HEAD SHA." .
crown:defaultRef a rdf:Property ; rdfs:domain crown:SubmoduleEdge ; rdfs:range xsd:string ;
    rdfs:comment "Receipt key `default_ref`: the symref target of remote HEAD, e.g. refs/heads/main." .
crown:driftState a rdf:Property ; rdfs:domain crown:SubmoduleEdge ; rdfs:range crown:DriftState .
crown:changed a rdf:Property ; rdfs:domain crown:SubmoduleEdge ; rdfs:range xsd:boolean ;
    rdfs:comment "Receipt key `changed`: literal boolean serialized into the JSON." .
crown:gitlinkMode a rdf:Property ; rdfs:domain crown:GitlinkObservation ; rdfs:range xsd:string ;
    rdfs:comment "Must be 160000 or the real script raises CROWN_BLOCKED[NOT_GITLINK]." .

# --- observation procedures (sosa) -----------------------------------------
crown:GitLsTree a sosa:Procedure ; skos:prefLabel "git ls-tree HEAD -- <path>"@en .
crown:GitLsRemoteSymref a sosa:Procedure ; skos:prefLabel "git ls-remote --symref <url> HEAD"@en .
@prefix crown: <https://seanchatmangpt.github.io/ontology/gym-autonomic-crown#> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

crown:receipt a crown:CrownReceipt , prov:Entity ;
    crown:schema "https://ggen.dev/receipts/gym-autonomic-crown/v2" ;
    crown:repository "https://github.com/seanchatmangpt/gym-ecosystem" ;
    crown:baseSha "1972bb70de606bc6da31ff90b593578a1de5bf74" ;
    crown:authorityBoundary "full-write" ;
    crown:changedCount "1" .

