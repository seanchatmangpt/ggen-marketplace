//! Detached-signature attestation — GENERATED by `ggen sync run` from the
//! `strata-signer-pack` ontology (https://strata.chatman.ai/ontology#). Do not edit by hand.
//!
//! Receipt/frame types consumed from `strata_protocol` (strata-protocol-pack).
//!
//! Single-key invariant: this projection assumes exactly one AttestationKey
//! (st:DefaultKey). The per-row constants are emitted inside the row loop;
//! a multi-key ontology would redeclare the same consts and must extend
//! this template, not patch output.

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct AttestationKey {
    pub key_id: String,
    pub algorithm: String,
    pub signature_len: usize,
    pub public_key_len: usize,
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct DetachedSignature {
    pub digest: String,
    pub value: String,
    pub signer: AttestationKey,
}

impl AttestationKey {
    pub fn default_key() -> Self {
        Self {
            key_id: ATTESTATION_KEY_ID.to_string(),
            algorithm: ATTESTATION_ALGORITHM.to_string(),
            signature_len: SIGNATURE_LEN,
            public_key_len: PUBLIC_KEY_LEN,
        }
    }
}

