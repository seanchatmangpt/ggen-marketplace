//! Signing / digest-binding layer — GENERATED by `ggen sync run` from the
//! `strata-signer-pack` ontology (https://strata.chatman.ai/ontology#). Do not
//! edit by hand; regenerate rather than patching.
//!
//! S3 roadmap slice: the signer pack projects a signing TRAIT + digest-binding
//! adapter, not a real ML-DSA-65 implementation (FIPS 204 ML-DSA-65 lattice
//! crypto is out of scope for a projection; the real sign/verify lives in
//! ~/strata/strata_protocol/src/signer.rs over the ml-dsa crate). Consumers
//! inject the real signer through `PayloadSigner`.
//!
//! Digest binding: `TxSigner::bind_tx_digest` maps raw transaction bytes to
//! the 32-byte SHA-256 digest that ML-DSA-65 attests (st:TxDigestBinding in
//! the ontology; gated by gates/020_digest_binding.rq).

/// Detached ML-DSA-65 signature width in bytes (FIPS 204; ground truth
/// ~/strata/strata_protocol/src/signer.rs SIGNATURE_LEN = 3309).
pub const PAYLOAD_SIGNATURE_LEN: usize = 3309;

/// The signing capability every Strata signer backend provides. The real
/// backend is the ml-dsa crate behind ~/strata signer.rs; any in-crate
/// implementation is a test double, never a crypto implementation.
pub trait PayloadSigner {
    /// Deterministic detached signature over `payload` (3309 bytes).
    fn sign(&self, payload: &[u8]) -> [u8; PAYLOAD_SIGNATURE_LEN];
    /// Verify a detached signature against `payload`.
    fn verify(&self, payload: &[u8], sig: &[u8; PAYLOAD_SIGNATURE_LEN]) -> bool;
}

// ── SHA-256 (FIPS 180-4) — inline provenance copy ────────────────────
// PROVENANCE: byte-identical inline copy of `pub fn sha256` from
// packs/strata-hash-pack/generated/hash_merkle.rs (itself generated from
// packs/strata-hash-pack/templates/hash_merkle.rs.tera). The hash module is
// generated per-pack, so cross-pack consumption would couple two generated
// modules; self-contained wins per S3 decision. FIPS 180-4 §6.2; the test
// vectors below pin correctness. If the hash-pack primitive changes, update
// this copy in templates/signing.rs.tera (the canonical template) and sync.

/// Digest width in bytes for SHA-256 (FIPS 180-4 §6.2).
pub const DIGEST_LEN: usize = 32;

const K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

const H0: [u32; 8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

/// SHA-256 of `data`, per FIPS 180-4 §6.2.
pub fn sha256(data: &[u8]) -> [u8; DIGEST_LEN] {
    let mut h = H0;
    let bit_len = (data.len() as u64).wrapping_mul(8);
    let mut msg = data.to_vec();
    // Padding (§5.1.1): append 0x80, zero-fill to 56 mod 64, then 8-byte
    // big-endian bit length.
    msg.push(0x80);
    while msg.len() % 64 != 56 {
        msg.push(0);
    }
    msg.extend_from_slice(&bit_len.to_be_bytes());

    for block in msg.chunks_exact(64) {
        let mut w = [0u32; 64];
        for (i, word) in block.chunks_exact(4).enumerate() {
            w[i] = u32::from_be_bytes([word[0], word[1], word[2], word[3]]);
        }
        for i in 16..64 {
            let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
            let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16]
                .wrapping_add(s0)
                .wrapping_add(w[i - 7])
                .wrapping_add(s1);
        }
        let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh) =
            (h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);
        for i in 0..64 {
            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            let ch = (e & f) ^ ((!e) & g);
            let t1 = hh
                .wrapping_add(s1)
                .wrapping_add(ch)
                .wrapping_add(K[i])
                .wrapping_add(w[i]);
            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = s0.wrapping_add(maj);
            hh = g;
            g = f;
            f = e;
            e = d.wrapping_add(t1);
            d = c;
            c = b;
            b = a;
            a = t1.wrapping_add(t2);
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        h[5] = h[5].wrapping_add(f);
        h[6] = h[6].wrapping_add(g);
        h[7] = h[7].wrapping_add(hh);
    }
    let mut out = [0u8; DIGEST_LEN];
    for (i, word) in h.iter().enumerate() {
        out[i * 4..i * 4 + 4].copy_from_slice(&word.to_be_bytes());
    }
    out
}

// ── TxSigner adapter ─────────────────────────────────────────────────

/// Adapter binding raw transaction bytes to the attestation plane: hashes the
/// tx bytes to a 32-byte SHA-256 digest (`bind_tx_digest`) and signs/verifies
/// through any `PayloadSigner` backend (the real one being ML-DSA-65 in
/// ~/strata signer.rs).
pub struct TxSigner<S: PayloadSigner> {
    backend: S,
}

impl<S: PayloadSigner> TxSigner<S> {
    pub fn new(backend: S) -> Self {
        Self { backend }
    }

    /// Digest of raw transaction bytes: SHA-256(tx_bytes), 32 bytes — the
    /// digest ML-DSA-65 attests (st:TxDigestBinding).
    pub fn bind_tx_digest(&self, tx_bytes: &[u8]) -> [u8; DIGEST_LEN] {
        sha256(tx_bytes)
    }

    /// Detached signature over the tx digest (3309 bytes).
    pub fn sign_tx(&self, tx_bytes: &[u8]) -> [u8; PAYLOAD_SIGNATURE_LEN] {
        let digest = self.bind_tx_digest(tx_bytes);
        self.backend.sign(&digest)
    }

    /// Verify a detached signature over the tx digest.
    pub fn verify_tx(&self, tx_bytes: &[u8], sig: &[u8; PAYLOAD_SIGNATURE_LEN]) -> bool {
        let digest = self.bind_tx_digest(tx_bytes);
        self.backend.verify(&digest, sig)
    }
}

/// Number of DigestBinding rows projected from the ontology (guard witness).
pub const DIGEST_BINDING_COUNT: usize = {{ results | length }};

#[cfg(test)]
mod tests {
    use super::*;

    /// TEST DOUBLE, NOT a crypto implementation: deterministic XOR-fabric
    /// signer over a fixed 32-byte key. Exists only so the trait/adapter
    /// round-trip is executable in-court; the real backend is the ml-dsa
    /// crate behind ~/strata/strata_protocol/src/signer.rs.
    struct TestSigner {
        key: [u8; 32],
    }

    impl TestSigner {
        fn new(key: [u8; 32]) -> Self {
            Self { key }
        }
    }

    impl PayloadSigner for TestSigner {
        fn sign(&self, payload: &[u8]) -> [u8; PAYLOAD_SIGNATURE_LEN] {
            let mut sig = [0u8; PAYLOAD_SIGNATURE_LEN];
            for (i, o) in sig.iter_mut().enumerate() {
                let p = payload.get(i % payload.len().max(1)).copied().unwrap_or(0);
                *o = p ^ self.key[i % 32] ^ (i as u8);
            }
            sig
        }

        fn verify(&self, payload: &[u8], sig: &[u8; PAYLOAD_SIGNATURE_LEN]) -> bool {
            sig == &self.sign(payload)
        }
    }

    /// Court: wrong-key verify fails.
    #[test]
    fn wrong_key_verify_fails() {
        let signer_a = TxSigner::new(TestSigner::new([1u8; 32]));
        let signer_b = TxSigner::new(TestSigner::new([2u8; 32]));
        let tx = b"tx-bytes-001";
        let sig = signer_a.sign_tx(tx);
        assert_eq!(sig.len(), 3309);
        assert!(!signer_b.verify_tx(tx, &sig), "wrong-key signature must not verify");
    }

    /// Court: tampered payload fails verification.
    #[test]
    fn tampered_payload_fails() {
        let signer = TxSigner::new(TestSigner::new([7u8; 32]));
        let sig = signer.sign_tx(b"tx-bytes-002");
        let mut tampered = b"tx-bytes-002".to_vec();
        tampered[0] ^= 0x01;
        assert!(!signer.verify_tx(&tampered, &sig), "tampered tx must not verify");
    }

    /// Court: digest stability — same bytes → same digest.
    #[test]
    fn digest_stability() {
        let signer = TxSigner::new(TestSigner::new([9u8; 32]));
        let d1 = signer.bind_tx_digest(b"tx-bytes-003");
        let d2 = signer.bind_tx_digest(b"tx-bytes-003");
        assert_eq!(d1, d2);
        assert_eq!(d1.len(), 32);
    }

    /// Court: different tx bytes → different digest (binding is injective
    /// enough to distinguish test inputs).
    #[test]
    fn distinct_bytes_distinct_digest() {
        let signer = TxSigner::new(TestSigner::new([9u8; 32]));
        assert_ne!(signer.bind_tx_digest(b"tx-a"), signer.bind_tx_digest(b"tx-b"));
    }

    /// Court: round-trip — sign then verify passes with the same backend.
    #[test]
    fn round_trip() {
        let signer = TxSigner::new(TestSigner::new([5u8; 32]));
        let tx = b"tx-bytes-roundtrip";
        let sig = signer.sign_tx(tx);
        assert!(signer.verify_tx(tx, &sig));
    }

    /// Court: FIPS 180-4 published SHA-256 vectors pin the inline copy
    /// ("" and "abc" per the specification examples).
    #[test]
    fn sha256_fips_vectors() {
        let empty = sha256(b"");
        assert_eq!(
            empty,
            [
                0xe3, 0xb0, 0xc4, 0x42, 0x98, 0xfc, 0x1c, 0x14, 0x9a, 0xfb, 0xf4, 0xc8, 0x99, 0x6f,
                0xb9, 0x24, 0x27, 0xae, 0x41, 0xe4, 0x64, 0x9b, 0x93, 0x4c, 0xa4, 0x95, 0x99, 0x1b,
                0x78, 0x52, 0xb8, 0x55
            ]
        );
        let abc = sha256(b"abc");
        assert_eq!(
            abc,
            [
                0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea, 0x41, 0x41, 0x40, 0xde, 0x5d, 0xae,
                0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61,
                0xf2, 0x00, 0x15, 0xad
            ]
        );
    }

    /// Court: digest width constant matches the ontology binding (32) and the
    /// signature width matches ML-DSA-65 (3309).
    #[test]
    fn widths_match_binding() {
        assert_eq!(DIGEST_LEN, 32);
        assert_eq!(PAYLOAD_SIGNATURE_LEN, 3309);
        assert!(DIGEST_BINDING_COUNT >= 1);
    }
}
