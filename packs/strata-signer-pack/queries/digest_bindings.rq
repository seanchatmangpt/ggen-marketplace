PREFIX st: <https://strata.chatman.ai/ontology#>

SELECT ?binding ?digest_alg ?digest_len ?sig_alg ?sig_len
WHERE {
  ?binding a st:DigestBinding ;
     st:digestAlgorithm ?digest_alg ;
     st:digestAlgorithmLength ?digest_len ;
     st:bindingSignatureAlgorithm ?sig_alg ;
     st:bindingSignatureLength ?sig_len .
}
ORDER BY ?binding
