# strata-signer-pack ontology — attestation / detached signature vocabulary.

@prefix st:  <https://strata.chatman.ai/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ── Classes ──────────────────────────────────────────────────────────

st:AttestationKey a rdfs:Class ; rdfs:label "AttestationKey" ;
    rdfs:comment "A signing key identity used to attest receipts and frames." .

st:DetachedSignature a rdfs:Class ; rdfs:label "DetachedSignature" ;
    rdfs:comment "A signature over a digest, stored apart from the signed payload." .

# ── Properties ───────────────────────────────────────────────────────

st:keyId a rdf:Property ; rdfs:label "key id" ;
    rdfs:domain st:AttestationKey ; rdfs:range xsd:string .

st:algorithm a rdf:Property ; rdfs:label "algorithm" ;
    rdfs:domain st:AttestationKey ; rdfs:range xsd:string .

st:signatureDigest a rdf:Property ; rdfs:label "signed digest" ;
    rdfs:domain st:DetachedSignature ; rdfs:range xsd:string .

st:signatureValue a rdf:Property ; rdfs:label "signature value" ;
    rdfs:domain st:DetachedSignature ; rdfs:range xsd:string .

st:signedBy a rdf:Property ; rdfs:label "signed by" ;
    rdfs:domain st:DetachedSignature ; rdfs:range st:AttestationKey .

# ── Individuals ──────────────────────────────────────────────────────

st:DefaultKey a st:AttestationKey ;
    st:keyId "strata-default" ;
    st:algorithm "ML-DSA-65" .

# ── Ground-truth constants (~/strata/strata_protocol/src/signer.rs) ──
# FIPS 204 ML-DSA-65: detached signature 3309 bytes, encoded public key
# 1952 bytes, seed 32 bytes, attested payload 72 bytes. signer.rs asserts
# these against the ml-dsa crate's own EncodedSignature/EncodedVerifyingKey
# sizes at compile time.

st:signatureLen a rdf:Property ; rdfs:label "signature length" ;
    rdfs:domain st:AttestationKey ; rdfs:range xsd:integer ;
    rdfs:comment "Detached signature length in bytes (signer.rs SIGNATURE_LEN)." .

st:publicKeyLen a rdf:Property ; rdfs:label "public key length" ;
    rdfs:domain st:AttestationKey ; rdfs:range xsd:integer ;
    rdfs:comment "Encoded verifying-key length in bytes (signer.rs PUBLIC_KEY_LEN)." .

st:DefaultKey st:signatureLen 3309 ;
    st:publicKeyLen 1952 .

# ── S3: digest binding (tx bytes → 32-byte SHA-256 digest signed under
#    ML-DSA-65). The binding layer is generated (generated/signing.rs); the
#    ontology names the algorithms/lengths so the gate can refuse drift.

st:DigestBinding a rdfs:Class ; rdfs:label "DigestBinding" ;
    rdfs:comment "Binds a pre-signature digest (hash algorithm + length) to a signature algorithm + length." .

st:digestAlgorithm a rdf:Property ; rdfs:label "digest algorithm" ;
    rdfs:domain st:DigestBinding ; rdfs:range xsd:string .

st:digestAlgorithmLength a rdf:Property ; rdfs:label "digest algorithm length" ;
    rdfs:domain st:DigestBinding ; rdfs:range xsd:integer .

st:bindingSignatureAlgorithm a rdf:Property ; rdfs:label "binding signature algorithm" ;
    rdfs:domain st:DigestBinding ; rdfs:range xsd:string .

st:bindingSignatureLength a rdf:Property ; rdfs:label "binding signature length" ;
    rdfs:domain st:DigestBinding ; rdfs:range xsd:integer .

st:TxDigestBinding a st:DigestBinding ;
    rdfs:label "TxDigestBinding" ;
    st:digestAlgorithm "SHA-256" ;
    st:digestAlgorithmLength 32 ;
    st:bindingSignatureAlgorithm "ML-DSA-65" ;
    st:bindingSignatureLength 3309 .
