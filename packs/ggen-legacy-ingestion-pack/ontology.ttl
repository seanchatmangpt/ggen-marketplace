@prefix gli: <https://ggen.dev/ontology/ggen-legacy-ingestion#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix csvw: <http://www.w3.org/ns/csvw#> .

gli:fortune5-ingestion a prof:Profile, dcat:Dataset ;
 dcterms:title "ggen-legacy Fortune 5 ingestion compiler profile" ;
 dcterms:description "Preserve → identify → decode → parse → normalize → observe → map → admit/refuse. Unsupported remains visible; consequential extension requires separate authority." ;
 dcterms:source <https://github.com/seanchatmangpt/dslmodel/tree/main/src/dslmodel/readers>, <https://github.com/seanchatmangpt/ggen-legacy/blob/main/architecture/ARD.md> ;
 prof:isProfileOf prov:, dcat:, skos:, sosa:, odrl: ;
 dcat:distribution gli:registry-a, gli:registry-b .

gli:registry-a a dcat:Distribution, csvw:Table ; dcat:downloadURL <https://ggen.dev/ontology/ggen-legacy-ingestion/registry-a.tsv> ; dcat:mediaType "text/tab-separated-values" ; dcterms:conformsTo gli:registry-schema-v1 .
gli:registry-b a dcat:Distribution, csvw:Table ; dcat:downloadURL <https://ggen.dev/ontology/ggen-legacy-ingestion/registry-b.tsv> ; dcat:mediaType "text/tab-separated-values" ; dcterms:conformsTo gli:registry-schema-v1 .
gli:registry-schema-v1 a dcterms:Standard ; dcterms:identifier "ggen.legacy.ingestion.registry.v1" ; dcterms:description "Ordered unique registry of family, format, live-surface, control, and stage obligations. Format execution standing is external evidence." .
gli:cir0-observation a skos:Concept ; skos:prefLabel "CIR-0 Observation" .
gli:semantic-admission a skos:Concept ; skos:prefLabel "Semantic Admission" .
gli:live-observation a sosa:Procedure ; skos:prefLabel "Read-only live observation" .
gli:actuation-policy a odrl:Policy ; dcterms:description "Ingestion grants no ambient filesystem, shell, network, deployment, or production mutation authority." .
