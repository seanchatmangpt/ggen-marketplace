        // by this shell: a zero-length response cannot round-trip the boxed/vec free
        // contract (capacity>=1 reconstruction from a len-0 response is UB), so the
        // generated crate refuses to compile rather than silently substitute.
        compile_error!("unsupported empty_response_policy: only substitute-empty-object is sound under the boxed/vec free contract");
    }
