{
  "schema": "rust.wasi.wasmex.manifest/v1",
  "artifact": {
    "name": "{{ host.artifact_path | split(pat="/") | last }}",
    "path": "{{ host.artifact_path }}",
    "bytes": null,
    "sha256": null,
    "blake3": null
  },
  "host": {
    "module": "{{ host.root_module }}",
    "otp_app": ":{{ host.otp_app }}",
    "runtime": "wasmtime via wasmex ~> 0.14",
    "imports_required": []
  },
  "host_abi": {
    "pack_prefix": "{{ prefix }}",
    "out_mode": "packed_u64",
    "import_mode": "wasi_only",
    "memory_export": "memory",
    "allocator": {
      "alloc": "{{ prefix }}_alloc",
      "free": "{{ prefix }}_free",
      "call": "{{ prefix }}_call"
    },
    "limits": {
      "max_request_bytes": {{ max_request_bytes }},
      "execution_timeout_ms": {{ host.execution_timeout_ms }}
    }
  },
  "exports_used": [
    "memory",
    "{{ prefix }}_alloc",
    "{{ prefix }}_free",
    "{{ prefix }}_call"
  ]
}
