@prefix rww:  <https://ggen.dev/ontology/rust-wasi-wasmex#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<urn:fixture:probe_eval:binding> a rww:PipelineBinding ;
    rww:packPrefix "probe_eval" ;
    rww:maxRequestBytes "16777216"^^xsd:integer ;
    rww:hasGuestCrate <urn:fixture:probe_eval:guest> ;
    rww:hasHostModule <urn:fixture:probe_eval:host> .

<urn:fixture:probe_eval:guest> a rww:GuestRustCrate ;
    rww:crateName "probe_eval_wasm" ;
    rww:targetName "probe_eval" ;
    rww:maxOutstandingBytes "268435456"^^xsd:integer .

<urn:fixture:probe_eval:host> a rww:HostElixirModule ;
    rww:rootModule "ProbeEval.Wasm.GeneratedHost" ;
    rww:otpApp "probe_eval" ;
    rww:artifactPath "priv/wasm/probe_eval.wasm" ;
    rww:executionTimeoutMs "15"^^xsd:integer .
