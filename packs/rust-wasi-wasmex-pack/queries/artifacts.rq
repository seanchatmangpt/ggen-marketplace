# artifacts.rq -- consumed by templates/abi/artifacts.sha256.tmpl (the wasm-artifacts rule).
# Single row over the one wja:WasmModule individual. Projected columns (MUST equal the
# template's {{ }} vars): crate_name, abi_version, and the optional pin facts
#   wasm_sha256, wasm_bytes, registry_sha256, surface_sha256 -- each "" when the consumer
# graph carries no such fact, in which case the template keeps the placeholder skeleton.
# The lawful query for the wasm-artifacts rule; registry.rq is a single-row aggregate of
# scalar module facts and cannot carry pin facts. A module missing crateName or abiVersion
# yields zero rows => engine refuses.

PREFIX wja: <https://ggen.dev/ontology/wasi-json-abi#>

SELECT ?crate_name ?abi_version ?wasm_sha256 ?wasm_bytes ?registry_sha256 ?surface_sha256
WHERE {
  ?m a wja:WasmModule ;
     wja:crateName ?crateRaw ;
     wja:abiVersion ?abiRaw .
  OPTIONAL { ?m wja:wasmSha256 ?ws }
  OPTIONAL { ?m wja:wasmBytes ?wb }
  OPTIONAL { ?m wja:registrySha256 ?rs }
  OPTIONAL { ?m wja:surfaceSha256 ?ss }
  BIND(STR(?crateRaw) AS ?crate_name)
  BIND(STR(?abiRaw) AS ?abi_version)
  BIND(COALESCE(STR(?ws), "") AS ?wasm_sha256)
  BIND(COALESCE(STR(?wb), "") AS ?wasm_bytes)
  BIND(COALESCE(STR(?rs), "") AS ?registry_sha256)
  BIND(COALESCE(STR(?ss), "") AS ?surface_sha256)
}
ORDER BY ?crate_name
LIMIT 1
