@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rww:  <https://ggen.dev/ontology/rust-wasi-wasmex#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

rww:PipelineBindingShape a sh:NodeShape ;
    sh:targetClass rww:PipelineBinding ;
    sh:property [
        sh:path rww:packPrefix ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:pattern "^[a-z][a-z0-9_]*$" ;
    ] ;
    sh:property [
        sh:path rww:maxRequestBytes ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rww:hasGuestCrate ;
        sh:class rww:GuestRustCrate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rww:hasHostModule ;
        sh:class rww:HostElixirModule ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

rww:GuestRustCrateShape a sh:NodeShape ;
    sh:targetClass rww:GuestRustCrate ;
    sh:property [
        sh:path rww:crateName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rww:targetName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rww:maxOutstandingBytes ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

rww:HostElixirModuleShape a sh:NodeShape ;
    sh:targetClass rww:HostElixirModule ;
    sh:property [
        sh:path rww:rootModule ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rww:otpApp ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path rww:executionTimeoutMs ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
