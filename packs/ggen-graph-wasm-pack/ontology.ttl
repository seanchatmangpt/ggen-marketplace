@prefix gwp:  <http://seanchatmangpt.github.io/packs/ggen-graph-wasm#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Vocabulary
#################################################################

gwp:WasmQueryEngineCrateSpec a rdfs:Class ;
    rdfs:label "One Rust crate to manufacture: a wasm32-buildable QueryEngine trait boundary with a native OxigraphEngine impl and a wasm-safe RemoteEngine impl." .

gwp:crateName    a rdf:Property ; rdfs:domain gwp:WasmQueryEngineCrateSpec ; rdfs:comment "cargo package name, kebab-case, e.g. ggen-graph-wasm" .
gwp:cratePath    a rdf:Property ; rdfs:domain gwp:WasmQueryEngineCrateSpec ; rdfs:comment "path relative to the consuming workspace root, e.g. crates/ggen-graph-wasm" .
gwp:crateDescription a rdf:Property ; rdfs:domain gwp:WasmQueryEngineCrateSpec .
gwp:workspaceVersion a rdf:Property ; rdfs:domain gwp:WasmQueryEngineCrateSpec ;
    rdfs:comment "the consuming workspace's [workspace.package] version this crate's Cargo.toml pins `version.workspace = true` against, e.g. 26.8.24." .

gwp:wasmBindgenVersion a rdf:Property ; rdfs:domain gwp:WasmQueryEngineCrateSpec ; rdfs:comment "wasm-bindgen version pin, e.g. 0.2." .
gwp:reqwestVersion     a rdf:Property ; rdfs:domain gwp:WasmQueryEngineCrateSpec ; rdfs:comment "reqwest version pin, used with default-features=false + features=[\"json\"] for the wasm32 fetch backend (no native-only features like system-proxy)." .
gwp:serdeJsonVersion   a rdf:Property ; rdfs:domain gwp:WasmQueryEngineCrateSpec .
gwp:oxigraphVersion    a rdf:Property ; rdfs:domain gwp:WasmQueryEngineCrateSpec ; rdfs:comment "oxigraph version pin for the native-only OxigraphEngine dependency, e.g. 0.5.9 (matching the consuming workspace's own pin, per this pack's echo-don't-diverge discipline)." .
gwp:oxigraphFeatures   a rdf:Property ; rdfs:domain gwp:WasmQueryEngineCrateSpec ; rdfs:comment "oxigraph cargo features to enable, e.g. rdf-12." .

#################################################################
# Worked instance: ggen-graph-wasm targeting /Users/sac/ggen's real workspace
#################################################################

gwp:GgenGraphWasmSpec a gwp:WasmQueryEngineCrateSpec ;
    gwp:crateName "ggen-graph-wasm" ;
    gwp:cratePath "crates/ggen-graph-wasm" ;
    gwp:crateDescription "wasm32-buildable QueryEngine boundary for ggen-graph: OxigraphEngine (native) + RemoteEngine (wasm-safe, delegates SPARQL execution over HTTP)." ;
    gwp:workspaceVersion "26.8.24" ;
    gwp:wasmBindgenVersion "0.2" ;
    gwp:reqwestVersion "0.12" ;
    gwp:serdeJsonVersion "1" ;
    gwp:oxigraphVersion "0.5.9" ;
    gwp:oxigraphFeatures "rdf-12" .
