# MESSAGE: every gwp:WasmQueryEngineCrateSpec must have a non-empty crateName/cratePath/
# crateDescription/workspaceVersion/wasmBindgenVersion/reqwestVersion/serdeJsonVersion/
# oxigraphVersion/oxigraphFeatures. Any row = a violation.
PREFIX gwp: <http://seanchatmangpt.github.io/packs/ggen-graph-wasm#>

SELECT ?s ?missing WHERE {
  VALUES ?missing {
    gwp:crateName gwp:cratePath gwp:crateDescription gwp:workspaceVersion
    gwp:wasmBindgenVersion gwp:reqwestVersion gwp:serdeJsonVersion
    gwp:oxigraphVersion gwp:oxigraphFeatures
  }
  ?s a gwp:WasmQueryEngineCrateSpec .
  FILTER NOT EXISTS { ?s ?missing ?any }
}
ORDER BY ?s ?missing
