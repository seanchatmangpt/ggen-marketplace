---
to: "{{ spec[0].crate_path }}/Cargo.toml"
for_each: "spec"
sparql:
  spec: |
    PREFIX gwp: <http://seanchatmangpt.github.io/packs/ggen-graph-wasm#>
    SELECT DISTINCT ?crate_name ?crate_path ?crate_description ?workspace_version
                    ?wasm_bindgen_version ?reqwest_version ?serde_json_version
                    ?oxigraph_version ?oxigraph_features WHERE {
      ?s a gwp:WasmQueryEngineCrateSpec ;
         gwp:crateName ?crate_name ; gwp:cratePath ?crate_path ;
         gwp:crateDescription ?crate_description ; gwp:workspaceVersion ?workspace_version ;
         gwp:wasmBindgenVersion ?wasm_bindgen_version ; gwp:reqwestVersion ?reqwest_version ;
         gwp:serdeJsonVersion ?serde_json_version ; gwp:oxigraphVersion ?oxigraph_version ;
         gwp:oxigraphFeatures ?oxigraph_features .
    }
---
{# Manufactured manifest -- oxigraph is a native-only optional dependency, gated out of
   the wasm32 dependency graph entirely via [target.'cfg(not(target_arch = "wasm32"))'.
   dependencies], not just a Cargo feature flag alone -- a feature flag left ENABLED by a
   consumer's default-features union would still pull oxigraph into a wasm32 build; the
   [target.cfg(...)] table is what actually keeps it out of `cargo tree --target wasm32-
   unknown-unknown`'s resolved graph regardless of which features are requested. #}
[package]
name = "{{ spec[0].crate_name }}"
version.workspace = true
edition.workspace = true
description = "{{ spec[0].crate_description }}"

[lib]
crate-type = ["rlib", "cdylib"]

[features]
default = []
# Enables OxigraphEngine. A no-op on wasm32 targets (the dependency itself is gated out
# via [target.cfg(...)] below, not by this feature) -- kept as a feature too so native
# consumers can opt out of building oxigraph even natively (e.g. a slim CLI build).
oxigraph-engine = ["dep:oxigraph"]
# Enables RemoteEngine. wasm32-safe; also usable natively (e.g. testing against a real
# remote SPARQL endpoint without linking oxigraph at all).
remote-engine = ["dep:reqwest", "dep:serde_json", "dep:wasm-bindgen"]

[dependencies]
serde = { version = "1", features = ["derive"] }

[target.'cfg(not(target_arch = "wasm32"))'.dependencies]
oxigraph = { version = "{{ spec[0].oxigraph_version }}", features = ["{{ spec[0].oxigraph_features }}"], optional = true }

[target.'cfg(target_arch = "wasm32")'.dependencies]
wasm-bindgen = { version = "{{ spec[0].wasm_bindgen_version }}", optional = true }

[dependencies.reqwest]
version = "{{ spec[0].reqwest_version }}"
default-features = false
features = ["json"]
optional = true

[dependencies.serde_json]
version = "{{ spec[0].serde_json_version }}"
optional = true
