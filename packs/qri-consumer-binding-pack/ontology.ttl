@prefix qcb:  <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> .
@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix dct:  <http://purl.org/dc/terms/> .

# QRI Consumer Binding: the smallest delta over qri/PROV-O/SPDX/DCAT that lets a consumer say
# "this capability contract, this realization profile, this exact artifact, authority NONE".
# Technology-independent: host/runtime knobs live in RealizationProfile individuals, never here.
# Standing is DERIVED from receipts; no class or property here is a mutable status flag.

<https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack>
    a owl:Ontology ;
    owl:versionInfo "26.9.30" ;
    owl:imports <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack> ;
    rdfs:comment "QCB delta. authorityCeiling NONE: nothing here grants DO authority." .

# ---- classes ------------------------------------------------------------------------------
qcb:ConsumerBinding a rdfs:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "ConsumerBinding" ;
    rdfs:comment "Consumer selection input: one contract, one chosen realization, one profile, one exact artifact pin, authorityCeiling NONE." .
qcb:RealizationProfile a rdfs:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "RealizationProfile" ;
    rdfs:comment "Named realization/host profile selected by a binding; host knobs stay in the profile layer, never in the contract." .
qcb:ArtifactPin a rdfs:Class ; rdfs:subClassOf prov:Entity, dcat:Distribution ;
    rdfs:label "ArtifactPin" ;
    rdfs:comment "Exact artifact identity (spdx:Checksum, byte size, media type, registry digest). Identity, never authorization." .
qcb:GeneratedProjection a rdfs:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "GeneratedProjection" ;
    rdfs:comment "Set of files manufactured from a ConsumerBinding by a pack at an exact content digest." .
qcb:ProjectionReceipt a rdfs:Class ; rdfs:subClassOf qri:ReplayReceipt ;
    rdfs:label "ProjectionReceipt" ;
    rdfs:comment "Replay receipt of one projection: pack, generator, binding, contract and output identities." .

# ---- binding properties -------------------------------------------------------------------
qcb:contract a rdf:Property ; rdfs:domain qcb:ConsumerBinding ; rdfs:range qri:CapabilityContract .
qcb:candidateRealization a rdf:Property ; rdfs:domain qcb:ConsumerBinding ; rdfs:range qri:Realization ;
    rdfs:comment "Realizations the consumer considered; more than one without a chosen realization is AMBIGUOUS_REALIZATION." .
qcb:chosenRealization a rdf:Property ; rdfs:domain qcb:ConsumerBinding ; rdfs:range qri:Realization .
qcb:realizationProfile a rdf:Property ; rdfs:domain qcb:ConsumerBinding ; rdfs:range qcb:RealizationProfile .
qcb:artifactPin a rdf:Property ; rdfs:domain qcb:ConsumerBinding ; rdfs:range qcb:ArtifactPin .
qcb:authorityCeiling a rdf:Property ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( qcb:ConsumerBinding qcb:GeneratedProjection qcb:ProjectionReceipt ) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "Closed: exactly the literal NONE. Evidence, standing, signatures and qualification never raise it." .
qcb:requestedProjection a rdf:Property ; rdfs:domain qcb:ConsumerBinding ; rdfs:range xsd:string ;
    rdfs:comment "Closed: host | op-names | tests. Anything else (e.g. typed-bindings) is UNSUPPORTED(projection)." .
qcb:logicalOperation a rdf:Property ; rdfs:domain qcb:ConsumerBinding ; rdfs:range qri:Operation ;
    rdfs:comment "Operation NAMES only (qri:opName). Field types are UNSUPPORTED(projection): the registry has names, not types." .
qcb:profileId a rdf:Property ; rdfs:subPropertyOf dct:identifier ; rdfs:domain qcb:RealizationProfile ; rdfs:range xsd:string ;
    rdfs:comment "Opaque identifier of a RealizationProfile individual. The set of supported identifiers is admission policy (gate 140), not part of this vocabulary." .

# ---- artifact pin properties --------------------------------------------------------------
qcb:checksum a rdf:Property ; rdfs:subPropertyOf spdx:checksum ; rdfs:domain qcb:ArtifactPin ; rdfs:range spdx:Checksum .
qcb:registrySha256 a rdf:Property ; rdfs:domain [ a owl:Class ; owl:unionOf ( qcb:ArtifactPin qri:CapabilityContract ) ] ;
    rdfs:range xsd:string ;
    rdfs:comment "sha256 (lowercase hex) of the operation registry. Pin and contract must agree (gate 120)." .
qcb:abiVersion a rdf:Property ; rdfs:subPropertyOf qri:abiVersion ; rdfs:domain qcb:ArtifactPin ; rdfs:range xsd:string .
# byte size, media type and source: dcat:byteSize, dcat:mediaType, dcat:downloadURL, prov:wasDerivedFrom.

# ---- projection and receipt properties ----------------------------------------------------
qcb:projectionOf a rdf:Property ; rdfs:subPropertyOf prov:wasDerivedFrom ; rdfs:domain qcb:GeneratedProjection ; rdfs:range qcb:ConsumerBinding .
qcb:outputDigest a rdf:Property ; rdfs:range xsd:string ;
    rdfs:comment "sha256 of the sorted (path, sha256) listing of emitted files." .
qcb:projection a rdf:Property ; rdfs:domain qcb:ProjectionReceipt ; rdfs:range qcb:GeneratedProjection .
qcb:packVersion a rdf:Property ; rdfs:domain qcb:ProjectionReceipt ; rdfs:range xsd:string .
qcb:packContentDigest a rdf:Property ; rdfs:domain qcb:ProjectionReceipt ; rdfs:range xsd:string .
qcb:generatorVersion a rdf:Property ; rdfs:domain qcb:ProjectionReceipt ; rdfs:range xsd:string ;
    rdfs:comment "Identity (name and version) of the generator that rendered the projection; opaque to the contract." .
qcb:bindingDigest a rdf:Property ; rdfs:domain qcb:ProjectionReceipt ; rdfs:range xsd:string .
# The contract digest is qri:contractDigest on the bound contract (reused, not duplicated); a receipt reaches it
# through qcb:projection / qcb:projectionOf / qcb:contract.

# ---- refusal vocabulary -------------------------------------------------------------------
qcb:refusalClass a rdf:Property ; rdfs:domain qri:RefusalCode ; rdfs:range xsd:string ;
    rdfs:comment "Neutral class: refused_identity | refused_structure | refused_authority | refused_admission | blocked_resource | unsupported." .
qcb:brokenTerm a rdf:Property ; rdfs:domain qri:RefusalCode ; rdfs:range xsd:string ;
    rdfs:comment "Chatman-equation failure taxonomy term that the refusal names." .
qcb:refusedByGate a rdf:Property ; rdfs:domain qri:RefusalCode ; rdfs:range xsd:string ;
    rdfs:comment "Stem of the gate whose row emits this code." .
qcb:standingLiteral a rdf:Property ; rdfs:domain qri:RefusalCode ; rdfs:range xsd:string ;
    rdfs:comment "Derived literal REFUSED:<CODE>, or UNSUPPORTED:<CODE> for class unsupported. Never stored on a binding or receipt." .

qcb:generation-refusals a skos:ConceptScheme ;
    rdfs:label "generation-refusals" ;
    rdfs:comment "Typed refusals of the consumer-binding projection. A refusal means zero files emitted." .

qcb:AMBIGUOUS_REALIZATION a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "AMBIGUOUS_REALIZATION" ; qcb:refusalClass "refused_structure" ;
    qcb:brokenTerm "admission_vacuous" ; qcb:refusedByGate "100_realization_unambiguous" ;
    qcb:standingLiteral "REFUSED:AMBIGUOUS_REALIZATION" .
qcb:PIN_MISSING a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "PIN_MISSING" ; qcb:refusalClass "refused_identity" ;
    qcb:brokenTerm "R_missing_identity" ; qcb:refusedByGate "090_pin_present" ;
    qcb:standingLiteral "REFUSED:PIN_MISSING" .
qcb:PIN_DIGEST_MALFORMED a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "PIN_DIGEST_MALFORMED" ; qcb:refusalClass "refused_identity" ;
    qcb:brokenTerm "R_missing_identity" ; qcb:refusedByGate "095_pin_digest_wellformed" ;
    qcb:standingLiteral "REFUSED:PIN_DIGEST_MALFORMED" .
qcb:PIN_REGISTRY_MISMATCH a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "PIN_REGISTRY_MISMATCH" ; qcb:refusalClass "refused_identity" ;
    qcb:brokenTerm "mu_on_O" ; qcb:refusedByGate "120_pin_registry_match" ;
    qcb:standingLiteral "REFUSED:PIN_REGISTRY_MISMATCH" .
qcb:CEILING_NOT_NONE a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "CEILING_NOT_NONE" ; qcb:refusalClass "refused_authority" ;
    qcb:brokenTerm "R_missing_authority" ; qcb:refusedByGate "110_authority_ceiling_none" ;
    qcb:standingLiteral "REFUSED:CEILING_NOT_NONE" .
qcb:CONTRACT_DIGEST_MISSING a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "CONTRACT_DIGEST_MISSING" ; qcb:refusalClass "refused_identity" ;
    qcb:brokenTerm "R_missing_identity" ; qcb:refusedByGate "130_contract_digest_present" ;
    qcb:standingLiteral "REFUSED:CONTRACT_DIGEST_MISSING" .
qcb:PROFILE_UNSUPPORTED a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "PROFILE_UNSUPPORTED" ; qcb:refusalClass "unsupported" ;
    qcb:brokenTerm "mu_on_O" ; qcb:refusedByGate "140_profile_supported" ;
    qcb:standingLiteral "UNSUPPORTED:PROFILE_UNSUPPORTED" .
qcb:PROJECTION_TYPE_UNSUPPORTED a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "PROJECTION_TYPE_UNSUPPORTED" ; qcb:refusalClass "unsupported" ;
    qcb:brokenTerm "mu_on_O" ; qcb:refusedByGate "150_projection_type_supported" ;
    qcb:standingLiteral "UNSUPPORTED:PROJECTION_TYPE_UNSUPPORTED" .
qcb:PIN_AMBIGUOUS a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "PIN_AMBIGUOUS" ; qcb:refusalClass "refused_identity" ;
    qcb:brokenTerm "admission_vacuous" ; qcb:refusedByGate "092_pin_exactly_one" ;
    qcb:standingLiteral "REFUSED:PIN_AMBIGUOUS" .
qcb:REALIZATION_CONTRACT_MISMATCH a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "REALIZATION_CONTRACT_MISMATCH" ; qcb:refusalClass "refused_structure" ;
    qcb:brokenTerm "mu_on_O" ; qcb:refusedByGate "105_realization_implements_contract" ;
    qcb:standingLiteral "REFUSED:REALIZATION_CONTRACT_MISMATCH" .
qcb:AUTHORITY_GRANTED a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "AUTHORITY_GRANTED" ; qcb:refusalClass "refused_authority" ;
    qcb:brokenTerm "R_missing_authority" ; qcb:refusedByGate "160_no_authority_grant" ;
    qcb:standingLiteral "REFUSED:AUTHORITY_GRANTED" .
qcb:CONTRACT_DIGEST_MISMATCH a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "CONTRACT_DIGEST_MISMATCH" ; qcb:refusalClass "refused_identity" ;
    qcb:brokenTerm "R_missing_identity" ; qcb:refusedByGate "consume" ;
    qcb:standingLiteral "REFUSED:CONTRACT_DIGEST_MISMATCH" .
qcb:SHAPE_NONCONFORMANT a qri:RefusalCode, skos:Concept ; skos:inScheme qcb:generation-refusals ;
    skos:notation "SHAPE_NONCONFORMANT" ; qcb:refusalClass "refused_structure" ;
    qcb:brokenTerm "mu_on_O" ; qcb:refusedByGate "shacl" ;
    qcb:standingLiteral "REFUSED:SHAPE_NONCONFORMANT" .

# ==== INLINED (was [ontology] imports, refused by ggen v26.8.11 FM-CONFIG-002): ontology/alignments.ttl ====
@prefix qcb:  <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> .
@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# Public vocabularies own their nouns (PROV-O, DCAT, SPDX, ODRL, SKOS, qri). Two relations are used and
# they never contradict ontology.ttl:
#   * entailing links (rdfs:subClassOf / rdfs:subPropertyOf) live ONLY in ontology.ttl; a term listed there
#     is not re-stated here with a weaker skos relation;
#   * this file states the non-entailing skos correspondences and the justification (skos:scopeNote) for
#     every qcb term that has no entailing public parent: the delta it adds over the public term.
# Nothing is imported from any private (non-public) vocabulary.

# --- classes: entailing parents are in ontology.ttl (prov:Entity, dcat:Distribution, qri:ReplayReceipt).
qcb:ConsumerBinding      skos:relatedMatch qri:CapabilityContract ;
    skos:scopeNote "Delta: a selection input tying one contract, one realization, one profile and one pin; no public class carries that tuple." .
qcb:ArtifactPin          skos:relatedMatch spdx:Package ;
    skos:scopeNote "Delta: dcat:Distribution plus an spdx:Checksum, exact byte size and registry digest as one identity; spdx:Package has no byte-size or registry digest." .
qcb:GeneratedProjection  skos:scopeNote "Delta: prov:Entity (ontology.ttl) for the set of files manufactured from one binding; no public class names a file-set projection." .
qcb:ProjectionReceipt    skos:relatedMatch qri:ReplayReceipt ;
    skos:scopeNote "Delta: qri:ReplayReceipt (ontology.ttl) narrowed to the identities of one projection." .
qcb:RealizationProfile   skos:relatedMatch qri:HostProfile ;
    skos:scopeNote "Delta: named host/realization profile; host knobs live in its individuals. Profile identifiers are opaque strings to the contract layer." .

# qri:contractDigest is reused directly (no qcb duplicate): the receipt reaches it through the bound contract.
# --- properties: entailing parents (spdx:checksum, qri:abiVersion, prov:wasDerivedFrom, dct:identifier) are in ontology.ttl.
qcb:checksum             skos:scopeNote "Delta over spdx:checksum: range fixed to spdx:Checksum on a qcb:ArtifactPin; kept as a subproperty so SPDX tooling still reads it." .
qcb:abiVersion           skos:scopeNote "Delta over qri:abiVersion: domain narrowed to qcb:ArtifactPin (the artifact's own declared ABI), qri:abiVersion states the contract's." .
qcb:projectionOf         skos:scopeNote "Delta over prov:wasDerivedFrom: range narrowed to qcb:ConsumerBinding." .
qcb:registrySha256       skos:relatedMatch spdx:checksumValue ;
    skos:scopeNote "Delta: sha256 of the operation registry, compared across pin and contract (gate 120); no public term names a registry digest." .
qcb:bindingDigest        skos:relatedMatch spdx:checksumValue ;
    skos:scopeNote "Delta: digest of the canonical binding graph (RDFC-1.0); spdx:checksumValue carries no algorithm or subject here." .
qcb:outputDigest         skos:relatedMatch spdx:checksumValue ;
    skos:scopeNote "Delta: digest of the sorted (path, sha256) listing of emitted files." .
qcb:packContentDigest    skos:relatedMatch spdx:checksumValue ;
    skos:scopeNote "Delta: digest of the generator pack's content at generation time." .
qcb:packVersion          skos:relatedMatch prov:wasAssociatedWith ;
    skos:relatedMatch owl:versionInfo ;
    skos:scopeNote "Delta: version of the pack that rendered the projection." .
qcb:generatorVersion     skos:relatedMatch prov:wasAssociatedWith ;
    skos:relatedMatch owl:versionInfo ;
    skos:scopeNote "Delta: identity of the generator that rendered the projection; opaque to the contract." .
qcb:authorityCeiling     rdfs:seeAlso odrl:Policy ;
    skos:scopeNote "Delta: an upper bound with the single value NONE. It is not an ODRL permission; odrl:permission and qri:grantsAuthority are refused (gate 160)." .
qcb:artifactPin          skos:relatedMatch dcat:distribution ;
    skos:scopeNote "Delta: binds a ConsumerBinding to exactly one qcb:ArtifactPin; dcat:distribution links a dataset, not a selection tuple." .
qcb:contract             skos:relatedMatch qri:specifiesCapability ;
    skos:scopeNote "Delta: binds a ConsumerBinding to exactly one qri:CapabilityContract." .
qcb:projection           skos:relatedMatch prov:wasDerivedFrom ;
    skos:scopeNote "Delta: receipt-to-projection link (qcb:ProjectionReceipt to qcb:GeneratedProjection)." .
qcb:realizationProfile   skos:relatedMatch prov:used ;
    skos:scopeNote "Delta: selects the qcb:RealizationProfile of the binding." .
qcb:profileId            skos:scopeNote "Delta over dct:identifier: opaque identifier of a profile; the admitted set is admission policy (gate 140), not vocabulary." .
qcb:requestedProjection  skos:relatedMatch dct:type ;
    skos:scopeNote "Delta: which projection kind the consumer asks for; admission policy (gate 150) bounds it." .
qcb:logicalOperation     skos:relatedMatch qri:opName ;
    skos:scopeNote "Delta: operation names the consumer binds; names only." .
qcb:candidateRealization skos:relatedMatch qri:realization ;
    skos:scopeNote "Delta: realizations considered by the consumer; the chosen one must be among them (gate 105)." .
qcb:chosenRealization    skos:relatedMatch qri:realization ;
    skos:scopeNote "Delta: the single realization selected by the binding." .

# --- refusal vocabulary: no public counterpart is adopted (HTTP problem types are transport-specific).
qcb:generation-refusals  skos:relatedMatch qri:refusalScheme ;
    skos:scopeNote "Delta: typed refusal codes of one projection; no public vocabulary defines generation refusal codes." .
qcb:refusalClass         skos:relatedMatch dct:type ;
    skos:scopeNote "Delta: refusal class of a code; refused_* versus unsupported." .
qcb:brokenTerm           skos:relatedMatch skos:notation ;
    skos:scopeNote "Delta: names the broken term of the failure taxonomy a refusal refers to (SRFC-001 section 12)." .
qcb:refusedByGate        skos:relatedMatch prov:wasInfluencedBy ;
    skos:scopeNote "Delta: stem of the gate that emits the code." .
qcb:standingLiteral      skos:relatedMatch skos:notation ;
    skos:scopeNote "Delta: derived literal for a code; never stored on a binding or receipt." .

# ==== INLINED (was [ontology] imports, refused by ggen v26.8.11 FM-CONFIG-002): qualification/consumer.ttl ====
# runners/consume.py swaps the content between the BEGIN/END sentinels below for the consumer's own
# binding file before each ggen pass (single-source law: ggen reads only ontology.ttl, so the swap
# happens on disk, in the capsule copy, before ggen ever runs). The committed block IS the default
# binding qualification/consumer.ttl byte-for-byte; a direct `ggen sync run` without consume.py
# admits that default binding.
# ==== BINDING-SWAP-REGION BEGIN ====
# SPDX-License-Identifier: MIT
#
# Default ConsumerBinding for qri-consumer-binding-pack: the affidavit WASI engine (ABI 1) bound to the
# beam-wasmex realization profile. Contract elements are the qri host-profile facts for the engine
# (observed from the module's import/export sections and registry, see RESOLUTIONS.md); the pin is the
# producer's registry/artifact-pin.json. qri:contractDigest is the RDFC-1.0 sha256 of the contract closure
# (runners/receipt.py contract_digest); consume.py refuses when it does not match. Authority ceiling NONE.
@prefix qcb:  <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> .
@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix ab:   <urn:qcb:binding:affidavit:> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ab:binding a qcb:ConsumerBinding ;
    qcb:contract ab:contract ;
    qcb:chosenRealization ab:realization ;
    qcb:realizationProfile ab:profile ;
    qcb:artifactPin ab:pin ;
    qcb:requestedProjection "host" , "op-names" , "tests" ;
    qcb:authorityCeiling "NONE" ;
    qcb:logicalOperation ab:lop_capabilities , ab:lop_commit , ab:lop_assemble , ab:lop_verify , ab:lop_mine , ab:lop_conform , ab:lop_verify_signature_input , ab:lop_certify_authzen_evidence , ab:lop_certify_spiffe_evidence .

ab:realization a qri:Realization ; qri:implementsContract ab:contract .
ab:profile a qcb:RealizationProfile ; qcb:profileId "beam-wasmex" .

ab:lop_capabilities a qri:Operation ; qri:opName "capabilities" .
ab:lop_commit a qri:Operation ; qri:opName "commit" .
ab:lop_assemble a qri:Operation ; qri:opName "assemble" .
ab:lop_verify a qri:Operation ; qri:opName "verify" .
ab:lop_mine a qri:Operation ; qri:opName "mine" .
ab:lop_conform a qri:Operation ; qri:opName "conform" .
ab:lop_verify_signature_input a qri:Operation ; qri:opName "verify_signature_input" .
ab:lop_certify_authzen_evidence a qri:Operation ; qri:opName "certify_authzen_evidence" .
ab:lop_certify_spiffe_evidence a qri:Operation ; qri:opName "certify_spiffe_evidence" .

ab:pin a qcb:ArtifactPin ;
    qcb:checksum ab:checksum ;
    dcat:byteSize "284650"^^xsd:nonNegativeInteger ;
    dcat:mediaType "application/wasm" ;
    dcat:downloadURL "https://github.com/seanchatmangpt/affidavit/releases/download/v26.9.28/affidavit.wasm" ;
    owl:versionInfo "26.9.28" ;
    qcb:abiVersion "1" ;
    qcb:registrySha256 "ebac457843cd2322af575f02583a4a2a2a11a2488de6ee0eabef468861ebe61b" ;
    dcterms:provenance "local build of affidavit-wasm (cargo --target wasm32-wasip1 --profile wasm) from the affidavit checkout at 8749f0be1ce6836b1c6f30b8ac2957ae0d2ec345 (clean tree); pin equals affidavit-wasm/registry/ARTIFACTS.sha256; ops include certify_authzen_evidence and certify_spiffe_evidence; artifact.url is the intended release location and was NOT published or fetched by this build; the wasm is vendored in this package, so mix ash_affidavit.vendor --check needs no network" .

ab:checksum a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "5e721cc20d07193eee5d489077f4cb534f12c45f948e53247f79f38a5a7761f7" .

ab:capability a qri:Capability .

ab:contract a qri:CapabilityContract ;
    qri:contractDigest "60dc0100b5d3a56131cdf2b9b8ebce83c024b3930963d95e7c888880c060c1e6" ;
    qcb:registrySha256 "ebac457843cd2322af575f02583a4a2a2a11a2488de6ee0eabef468861ebe61b" ;
    qri:specifiesCapability ab:capability ;
    qri:contractVersion "1.0.0" ;
    qri:abiSymbolPrefix "af" ;
    qri:abiKind "core-wasm-json" ;
    qri:abiVersion "1" ;
    qri:invariantSet ab:invariants ;
    qri:refusalScheme ab:refusals ;
    qri:hostProfile ab:host ;
    qri:allowedImport "wasi_snapshot_preview1::environ_get" ,
                      "wasi_snapshot_preview1::environ_sizes_get" ,
                      "wasi_snapshot_preview1::fd_write" ,
                      "wasi_snapshot_preview1::proc_exit" ;
    qri:requiredExport "af_alloc" , "af_call" , "af_free" , "af_abi_version" , "memory" ;
    qri:optionalExport "_initialize" ;
    qri:wasiImport ab:impEnvironGet , ab:impEnvironSizesGet , ab:impFdWrite , ab:impProcExit ;
    qri:operation ab:opCall .

ab:opCall a qri:Operation ; qri:opName "call" ; qri:input ab:inRequest ; qri:output ab:outResponse .
ab:inRequest a qri:Field ; qri:fieldName "request" ; qri:fieldType "bytes" ; qri:fieldOrder 1 .
ab:outResponse a qri:Field ; qri:fieldName "response" ; qri:fieldType "bytes" ; qri:fieldOrder 1 .

ab:invariants a qri:InvariantSet ; qri:requiresInvariant ab:semanticResult , ab:refusalBoundary , ab:determinism .
ab:semanticResult a qri:Invariant ; qri:invariantKind qri:Semantic .
ab:refusalBoundary a qri:Invariant ; qri:invariantKind qri:Refusal .
ab:determinism a qri:Invariant ; qri:invariantKind qri:Determinism .

# Engine flat error codes (registry error_codes). Host-side refusals live in AshAffidavit.Refusal.
ab:refusals a skos:ConceptScheme .
ab:rBadJson a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "bad_json" .
ab:rMissingField a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "missing_field" .
ab:rUnknownOp a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "unknown_op" .
ab:rBadField a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "bad_field" .
ab:rTooLarge a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "too_large" .
ab:rTooDeep a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "too_deep" .
ab:rMissingBuffer a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "missing_buffer" .
ab:rInternal a qri:RefusalCode , skos:Concept ; skos:inScheme ab:refusals ; qri:refusalCode "internal" .

ab:host a qri:HostProfile ;
    qri:freeSymbol "af_free" ; qri:freeArity 2 ; qri:lenType "u32" ;
    qri:allocZeroPolicy "refuse-resource_limit" ; qri:reqConsumed true ;
    qri:outMode "packed_u64" ; qri:errorCollapse "flat_code" ;
    qri:requestCap 16777216 ; qri:pathEnv "AFFIDAVIT_WASM_PATH" ;
    qri:manifestRel "priv/affidavit/MANIFEST.json" ; qri:wasmRel "priv/affidavit/affidavit.wasm" ;
    qri:manifestSchema "ash_affidavit.affidavit.manifest/v1" ; qri:pinFormat "sha256-hex" ;
    qri:moduleRoot "AshAffidavit" ; qri:taskModuleRoot "AshAffidavit" ; qri:otpApp "ash_affidavit" ;
    qri:handleNoun "engine" ; qri:taxonomyNamespace "chatman" ; qri:refusalModule "AshAffidavit.Refusal" ;
    qri:telemetryRoot "ash_affidavit" ; qri:okKey "ok" ; qri:opKey "op" ;
    qri:poolStrategy "rest_for_one" ; qri:poolSizeSource "schedulers_online" ;
    qri:engineId "Affidavit" ; qri:probeOp "capabilities" ; qri:probeExpectKey "abi_version" ;
    qri:recycleOn "abi_failure" , "call_exited" , "call_trapped" , "call_timeout" , "fuel_exhausted" ;
    qri:hostLimit ab:limFuelPerMs , ab:limInstantiateFuel , ab:limMemoryLimitBytes , ab:limRecycleBytes , ab:limMaxQueue , ab:limMaxResponseBytes , ab:limTableElements , ab:limInstances , ab:limTables , ab:limMemories , ab:limTimeoutMs , ab:limAbiTimeout , ab:limMargin , ab:limRetryBaseMs , ab:limRetryMaxMs , ab:limInitializeTimeoutMult , ab:limBackoffExpCap , ab:limMaxRedirects .

# Limits: ash_graphlaw defaults reused unchanged (the engine states stack_size_bytes 16 MiB and
# max_json_depth 64 itself; the host limits below bound the host side only).
ab:limFuelPerMs a qri:HostLimit ; qri:limitName "fuel_per_ms" ; qri:limitDefault 1000000 ; qri:limitOrder 1 .
ab:limInstantiateFuel a qri:HostLimit ; qri:limitName "instantiate_fuel" ; qri:limitDefault 1000000000 ; qri:limitOrder 2 .
ab:limMemoryLimitBytes a qri:HostLimit ; qri:limitName "memory_limit_bytes" ; qri:limitDefault 268435456 ; qri:limitOrder 3 .
ab:limRecycleBytes a qri:HostLimit ; qri:limitName "recycle_bytes" ; qri:limitDefault 134217728 ; qri:limitOrder 4 .
ab:limMaxQueue a qri:HostLimit ; qri:limitName "max_queue" ; qri:limitDefault 64 ; qri:limitOrder 5 .
ab:limMaxResponseBytes a qri:HostLimit ; qri:limitName "max_response_bytes" ; qri:limitDefault 33554432 ; qri:limitOrder 6 .
ab:limTableElements a qri:HostLimit ; qri:limitName "table_elements" ; qri:limitDefault 100000 ; qri:limitOrder 7 .
ab:limInstances a qri:HostLimit ; qri:limitName "instances" ; qri:limitDefault 10 ; qri:limitOrder 8 .
ab:limTables a qri:HostLimit ; qri:limitName "tables" ; qri:limitDefault 10 ; qri:limitOrder 9 .
ab:limMemories a qri:HostLimit ; qri:limitName "memories" ; qri:limitDefault 4 ; qri:limitOrder 10 .
ab:limTimeoutMs a qri:HostLimit ; qri:limitName "timeout_ms" ; qri:limitDefault 5000 ; qri:limitOrder 11 .
ab:limAbiTimeout a qri:HostLimit ; qri:limitName "abi_timeout" ; qri:limitDefault 1000 ; qri:limitOrder 12 .
ab:limMargin a qri:HostLimit ; qri:limitName "margin" ; qri:limitDefault 1000 ; qri:limitOrder 13 .
ab:limRetryBaseMs a qri:HostLimit ; qri:limitName "retry_base_ms" ; qri:limitDefault 500 ; qri:limitOrder 14 .
ab:limRetryMaxMs a qri:HostLimit ; qri:limitName "retry_max_ms" ; qri:limitDefault 30000 ; qri:limitOrder 15 .
ab:limInitializeTimeoutMult a qri:HostLimit ; qri:limitName "initialize_timeout_mult" ; qri:limitDefault 10 ; qri:limitOrder 16 .
ab:limBackoffExpCap a qri:HostLimit ; qri:limitName "backoff_exp_cap" ; qri:limitDefault 16 ; qri:limitOrder 17 .
ab:limMaxRedirects a qri:HostLimit ; qri:limitName "max_redirects" ; qri:limitDefault 5 ; qri:limitOrder 18 .

# WASI imports exactly as parsed from the module's import section (all (i32,...)->i32 except proc_exit).
ab:impEnvironGet a qri:WasiImport ; qri:importName "environ_get" ; qri:importParams "i32,i32" ; qri:importResults "i32" .
ab:impEnvironSizesGet a qri:WasiImport ; qri:importName "environ_sizes_get" ; qri:importParams "i32,i32" ; qri:importResults "i32" .
ab:impFdWrite a qri:WasiImport ; qri:importName "fd_write" ; qri:importParams "i32,i32,i32,i32" ; qri:importResults "i32" .
ab:impProcExit a qri:WasiImport ; qri:importName "proc_exit" ; qri:importParams "i32" ; qri:importResults "" .

# ==== BINDING-SWAP-REGION END ====
