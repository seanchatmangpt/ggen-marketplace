# Fail witness: pass graph with exactly one defect for gate 150_projection_type_supported.
@prefix qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> .
@prefix qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <urn:qcb:witness:> .

ex:binding a qcb:ConsumerBinding ;
    qcb:chosenRealization ex:realization ;

    qcb:contract ex:contract ;
    qcb:realizationProfile ex:profile ;
    qcb:artifactPin ex:pin ;
    qcb:requestedProjection "typed-bindings" ;
    qcb:authorityCeiling "NONE" ;
    qcb:logicalOperation ex:op .

ex:realization a qri:Realization ; qri:implementsContract ex:contract .
ex:op a qri:Operation ; qri:opName "assemble" .
ex:profile a qcb:RealizationProfile ; qcb:profileId "node-wasi" .

ex:contract a qri:CapabilityContract ;
    qri:contractVersion "1.0.0" ;
    qri:contractDigest "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" ;
    qcb:registrySha256 "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90" .

ex:pin a qcb:ArtifactPin ;
    qcb:checksum ex:checksum ;
    dcat:byteSize "660847"^^xsd:nonNegativeInteger ;
    dcat:mediaType "application/wasm" ;
    qcb:abiVersion "1" ;
    qcb:registrySha256 "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90" .

ex:checksum a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "5cc37aea8e59f7139e2ff5d43ab3c3c82931285b6400cf45f943c61d21a41402" .

ex:projection a qcb:GeneratedProjection ;
    qcb:projectionOf ex:binding ;
    prov:wasGeneratedBy ex:generation ;
    qcb:outputDigest "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" ;
    qcb:authorityCeiling "NONE" .

ex:generation a prov:Activity .

ex:receipt a qcb:ProjectionReceipt ;
    qcb:projection ex:projection ;
    qcb:packVersion "26.9.30" ;
    qcb:generatorVersion "26.9.28" ;
    qcb:packContentDigest "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" ;
    qcb:bindingDigest "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" ;
    qcb:outputDigest "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" ;
    qcb:authorityCeiling "NONE" .
