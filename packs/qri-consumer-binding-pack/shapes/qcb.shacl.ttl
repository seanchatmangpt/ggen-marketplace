@prefix qcb:  <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> .
@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .

# SHACL Core only. Authority: ceiling is exactly the literal "NONE" on binding, projection, receipt.

qcb:ConsumerBindingShape a sh:NodeShape ;
    sh:targetClass qcb:ConsumerBinding ;
    sh:property [ sh:path qcb:contract ; sh:class qri:CapabilityContract ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:chosenRealization ; sh:class qri:Realization ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:realizationProfile ; sh:class qcb:RealizationProfile ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:artifactPin ; sh:class qcb:ArtifactPin ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:requestedProjection ; sh:in ( "host" "op-names" "tests" ) ] ;
    sh:property [ sh:path qcb:authorityCeiling ; sh:datatype xsd:string ; sh:hasValue "NONE" ; sh:minCount 1 ; sh:maxCount 1 ] .

qcb:BoundContractShape a sh:NodeShape ;
    sh:targetObjectsOf qcb:contract ;
    sh:property [ sh:path qri:contractDigest ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qri:contractVersion ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:registrySha256 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ; sh:maxCount 1 ] .

qcb:RealizationProfileShape a sh:NodeShape ;
    sh:targetClass qcb:RealizationProfile ;
    sh:property [ sh:path qcb:profileId ; sh:datatype xsd:string ; sh:in ( "node-wasi" "beam-wasmex" ) ; sh:minCount 1 ; sh:maxCount 1 ] .

qcb:ArtifactPinShape a sh:NodeShape ;
    sh:targetClass qcb:ArtifactPin ;
    sh:property [ sh:path qcb:checksum ; sh:class spdx:Checksum ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:byteSize ; sh:datatype xsd:nonNegativeInteger ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path dcat:mediaType ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:registrySha256 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:abiVersion ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:maxCount 1 ] .

qcb:ChecksumShape a sh:NodeShape ;
    sh:targetObjectsOf qcb:checksum ;
    sh:property [ sh:path spdx:algorithm ; sh:hasValue spdx:checksumAlgorithm_sha256 ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path spdx:checksumValue ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] .

qcb:GeneratedProjectionShape a sh:NodeShape ;
    sh:targetClass qcb:GeneratedProjection ;
    sh:property [ sh:path qcb:projectionOf ; sh:class qcb:ConsumerBinding ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:class prov:Activity ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:outputDigest ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:authorityCeiling ; sh:datatype xsd:string ; sh:hasValue "NONE" ; sh:minCount 1 ; sh:maxCount 1 ] .

qcb:ProjectionReceiptShape a sh:NodeShape ;
    sh:targetClass qcb:ProjectionReceipt ;
    sh:property [ sh:path qcb:projection ; sh:class qcb:GeneratedProjection ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:packVersion ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:generatorVersion ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:packContentDigest ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:bindingDigest ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:outputDigest ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path qcb:authorityCeiling ; sh:datatype xsd:string ; sh:hasValue "NONE" ; sh:minCount 1 ; sh:maxCount 1 ] .
