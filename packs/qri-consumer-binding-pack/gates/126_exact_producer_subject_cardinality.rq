# MESSAGE: REFUSED:PRODUCER_SUBJECT_CARDINALITY
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?pin (COUNT(DISTINCT ?producer) AS ?count) WHERE {
  ?pin a qcb:ArtifactPin .
  OPTIONAL { ?pin prov:wasDerivedFrom ?producer . }
}
GROUP BY ?pin
HAVING(COUNT(DISTINCT ?producer) != 1)
ORDER BY ?pin
