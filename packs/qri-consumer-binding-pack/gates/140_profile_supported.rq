# MESSAGE: UNSUPPORTED:PROFILE_UNSUPPORTED (unsupported, mu_on_O): the chosen qcb:RealizationProfile must carry a qcb:profileId from the closed set node-wasi | beam-wasmex. UNSUPPORTED is not REFUSED.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?subject ?code WHERE {
  ?subject a qcb:ConsumerBinding ; qcb:realizationProfile ?p .
  OPTIONAL { ?p qcb:profileId ?id }
  FILTER ( !BOUND(?id) || !(STR(?id) IN ("node-wasi", "beam-wasmex")) )
  BIND("PROFILE_UNSUPPORTED" AS ?code)
}
ORDER BY ?subject
