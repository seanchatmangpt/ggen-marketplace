# MESSAGE: UNSUPPORTED:PROJECTION_TYPE_UNSUPPORTED (unsupported, mu_on_O): qcb:requestedProjection must be one of host | op-names | tests; typed field bindings are UNSUPPORTED(projection) because the registry carries names only.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?subject ?code WHERE {
  ?subject a qcb:ConsumerBinding ; qcb:requestedProjection ?r .
  FILTER ( !(STR(?r) IN ("host", "op-names", "tests")) )
  BIND("PROJECTION_TYPE_UNSUPPORTED" AS ?code)
}
ORDER BY ?subject
