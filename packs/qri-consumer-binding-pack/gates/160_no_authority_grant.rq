# MESSAGE: REFUSED:AUTHORITY_GRANTED (refused_authority, R_missing_authority): no node of the binding graph (binding, contract, realization, pin, projection, receipt) may assert odrl:permission or qri:grantsAuthority; capability, evidence, standing and qualification never imply authority.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?subject ?code WHERE {
  ?subject ?p ?o .
  VALUES ?p { odrl:permission qri:grantsAuthority }
  BIND("AUTHORITY_GRANTED" AS ?code)
}
ORDER BY ?subject
