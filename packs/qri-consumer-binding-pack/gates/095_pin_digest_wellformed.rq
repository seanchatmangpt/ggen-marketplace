# MESSAGE: REFUSED:PIN_DIGEST_MALFORMED (refused_identity, R_missing_identity): the pin checksum must be sha256 (spdx:checksumAlgorithm_sha256) with a 64-char lowercase hex value.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?subject ?code WHERE {
  ?subject a qcb:ConsumerBinding ; qcb:artifactPin ?pin .
  ?pin qcb:checksum ?ck .
  ?ck spdx:checksumValue ?v .
  OPTIONAL { ?ck spdx:algorithm ?alg }
  FILTER ( !REGEX(STR(?v), "^[0-9a-f]{64}$") || !BOUND(?alg) || ?alg != spdx:checksumAlgorithm_sha256 )
  BIND("PIN_DIGEST_MALFORMED" AS ?code)
}
ORDER BY ?subject
