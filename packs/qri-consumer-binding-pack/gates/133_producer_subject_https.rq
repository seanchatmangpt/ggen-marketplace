# MESSAGE: REFUSED:PRODUCER_SUBJECT_NONCANONICAL_URI: producer subject must use canonical GitHub HTTPS commit URI.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?pin ?producer WHERE {
  ?pin a qcb:ArtifactPin ; prov:wasDerivedFrom ?producer .
  FILTER(!isIRI(?producer) || !REGEX(STR(?producer), "^https://github[.]com/[^/]+/[^/]+/commit/[0-9a-f]{40}$"))
}
ORDER BY ?pin
