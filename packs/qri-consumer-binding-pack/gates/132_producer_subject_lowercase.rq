# MESSAGE: REFUSED:PRODUCER_SUBJECT_NONCANONICAL: immutable producer SHA must use canonical lowercase hexadecimal.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?pin ?producer WHERE {
  ?pin a qcb:ArtifactPin ; prov:wasDerivedFrom ?producer .
  FILTER(isIRI(?producer))
  FILTER(REGEX(STR(?producer), "/commit/[0-9A-Fa-f]{40}$"))
  FILTER(!REGEX(STR(?producer), "/commit/[0-9a-f]{40}$"))
}
ORDER BY ?pin
