# MESSAGE: REFUSED:PRODUCER_SUBJECT_MISSING: artifact pins require an immutable producer commit URI.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?subject ?code WHERE {
  ?subject a qcb:ConsumerBinding ; qcb:artifactPin ?pin .
  OPTIONAL { ?pin prov:wasDerivedFrom ?producer }
  FILTER (!BOUND(?producer) || !isIRI(?producer) || !REGEX(STR(?producer), "^https://github[.]com/[^/]+/[^/]+/commit/[0-9a-f]{40}$"))
  BIND("PRODUCER_SUBJECT_MISSING" AS ?code)
}
ORDER BY ?subject
