# MESSAGE: REFUSED:PRODUCER_RELEASE_REPO_MISMATCH: producer commit and artifact release must share repository identity.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?pin ?producer ?download WHERE {
  ?pin a qcb:ArtifactPin ; prov:wasDerivedFrom ?producer ; dcat:downloadURL ?download .
  BIND(REPLACE(STR(?producer), "/commit/[0-9a-f]{40}$", "") AS ?producerRepo)
  BIND(REPLACE(STR(?download), "/releases/.*$", "") AS ?releaseRepo)
  FILTER(?producerRepo != ?releaseRepo)
}
ORDER BY ?pin
