# MESSAGE: REFUSED:REALIZATION_CONTRACT_MISMATCH (refused_structure, mu_on_O): the chosen realization must declare qri:implementsContract for the bound qcb:contract and, when qcb:candidateRealization nodes are declared, must be one of them.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?subject ?code WHERE {
  ?subject a qcb:ConsumerBinding ; qcb:chosenRealization ?r ; qcb:contract ?c .
  FILTER ( NOT EXISTS { ?r qri:implementsContract ?c }
        || ( EXISTS { ?subject qcb:candidateRealization ?any } && NOT EXISTS { ?subject qcb:candidateRealization ?r } ) )
  BIND("REALIZATION_CONTRACT_MISMATCH" AS ?code)
}
ORDER BY ?subject
