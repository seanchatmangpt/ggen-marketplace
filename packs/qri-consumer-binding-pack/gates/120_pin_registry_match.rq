# MESSAGE: REFUSED:PIN_REGISTRY_MISMATCH (refused_identity, mu_on_O): the pin's qcb:registrySha256 must equal the bound contract's qcb:registrySha256; a differing or one-sided registry digest is refused.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?subject ?code WHERE {
  ?subject a qcb:ConsumerBinding ; qcb:artifactPin ?pin ; qcb:contract ?contract .
  OPTIONAL { ?pin qcb:registrySha256 ?pinReg }
  OPTIONAL { ?contract qcb:registrySha256 ?conReg }
  FILTER ( BOUND(?pinReg) || BOUND(?conReg) )
  FILTER ( !BOUND(?pinReg) || !BOUND(?conReg) || STR(?pinReg) != STR(?conReg) )
  BIND("PIN_REGISTRY_MISMATCH" AS ?code)
}
ORDER BY ?subject
