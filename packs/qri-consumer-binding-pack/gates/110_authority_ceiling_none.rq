# MESSAGE: REFUSED:CEILING_NOT_NONE (refused_authority, R_missing_authority): qcb:authorityCeiling must be present exactly once with the plain xsd:string literal "NONE" (no language tag, no other datatype) on every ConsumerBinding, GeneratedProjection and ProjectionReceipt.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?subject ?code WHERE {
  { ?subject a qcb:ConsumerBinding } UNION { ?subject a qcb:GeneratedProjection } UNION { ?subject a qcb:ProjectionReceipt }
  FILTER ( NOT EXISTS { ?subject qcb:authorityCeiling ?any }
        || EXISTS { ?subject qcb:authorityCeiling ?c . FILTER ( !isLiteral(?c) || DATATYPE(?c) != xsd:string || STR(?c) != "NONE" ) } )
  BIND("CEILING_NOT_NONE" AS ?code)
}
ORDER BY ?subject
