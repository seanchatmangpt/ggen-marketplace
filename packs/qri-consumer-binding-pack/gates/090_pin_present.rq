# MESSAGE: REFUSED:PIN_MISSING (refused_identity, R_missing_identity): a ConsumerBinding must carry exactly one qcb:artifactPin with an spdx:Checksum; no pin, no projection.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?subject ?code WHERE {
  ?subject a qcb:ConsumerBinding .
  FILTER NOT EXISTS { ?subject qcb:artifactPin ?pin . ?pin qcb:checksum ?ck . ?ck spdx:checksumValue ?v }
  BIND("PIN_MISSING" AS ?code)
}
ORDER BY ?subject
