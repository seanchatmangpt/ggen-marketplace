# MESSAGE: REFUSED:PIN_AMBIGUOUS (refused_identity, admission_vacuous): a ConsumerBinding must carry exactly one qcb:artifactPin; several pins are refused, never resolved by ordering.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?subject ?code WHERE {
  ?subject a qcb:ConsumerBinding .
  { SELECT ?subject (COUNT(DISTINCT ?pin) AS ?pins) WHERE {
      ?subject a qcb:ConsumerBinding ; qcb:artifactPin ?pin .
    } GROUP BY ?subject }
  FILTER ( ?pins > 1 )
  BIND("PIN_AMBIGUOUS" AS ?code)
}
ORDER BY ?subject
