# MESSAGE: REFUSED:PRODUCER_REPOSITORY_MISMATCH: producer subject must belong to the artifact producer repository.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?pin ?producer ?url WHERE {
  ?pin a qcb:ArtifactPin ; prov:wasDerivedFrom ?producer ; dcat:downloadURL ?url .
  BIND(REPLACE(STR(?producer), "/commit/[0-9a-f]{40}$", "") AS ?producerRepo)
  BIND(REPLACE(STR(?url), "/releases/.*$", "") AS ?artifactRepo)
  FILTER (?producerRepo != ?artifactRepo)
}
ORDER BY ?pin
