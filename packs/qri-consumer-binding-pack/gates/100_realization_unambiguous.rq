# MESSAGE: REFUSED:AMBIGUOUS_REALIZATION (refused_structure, admission_vacuous): a ConsumerBinding must name exactly one qcb:chosenRealization; several candidates without a selection are refused, never guessed.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?subject ?code WHERE {
  ?subject a qcb:ConsumerBinding .
  { SELECT ?subject (COUNT(DISTINCT ?c) AS ?chosen) WHERE {
      ?subject a qcb:ConsumerBinding .
      OPTIONAL { ?subject qcb:chosenRealization ?c }
    } GROUP BY ?subject }
  FILTER ( ?chosen != 1 )
  BIND("AMBIGUOUS_REALIZATION" AS ?code)
}
ORDER BY ?subject
