# Projection query: expose immutable producer subject as an input to receipt/binding identity.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?binding ?pin ?producer WHERE {
  ?binding a qcb:ConsumerBinding ; qcb:artifactPin ?pin .
  ?pin prov:wasDerivedFrom ?producer .
  FILTER(isIRI(?producer) && REGEX(STR(?producer), "^https://github[.]com/[^/]+/[^/]+/commit/[0-9a-f]{40}$"))
}
ORDER BY ?binding ?pin ?producer
