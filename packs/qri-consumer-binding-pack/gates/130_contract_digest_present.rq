# MESSAGE: REFUSED:CONTRACT_DIGEST_MISSING (refused_identity, R_missing_identity): the bound qri:CapabilityContract must carry qri:contractDigest as 64-char lowercase hex sha256.
PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX spdx: <http://spdx.org/rdf/terms#>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
SELECT ?subject ?code WHERE {
  ?binding a qcb:ConsumerBinding ; qcb:contract ?subject .
  OPTIONAL { ?subject qri:contractDigest ?d }
  FILTER ( !BOUND(?d) || !REGEX(STR(?d), "^[0-9a-f]{64}$") )
  BIND("CONTRACT_DIGEST_MISSING" AS ?code)
}
ORDER BY ?subject
