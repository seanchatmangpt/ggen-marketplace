# SPDX-License-Identifier: MIT
#
# ConsumerBinding for the node-wasi realization profile: the same affidavit engine, pin and ceiling as
# consumer.ttl, with no qri:hostProfile (beam knobs) on the contract. Derived from consumer.ttl by
# dropping the host-profile closure, setting qcb:profileId "node-wasi" and recomputing qri:contractDigest.
@prefix ab: <urn:qcb:binding:affidavit:> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> .
@prefix qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ab:binding a qcb:ConsumerBinding ;
    qcb:artifactPin ab:pin ;
    qcb:authorityCeiling "NONE" ;
    qcb:chosenRealization ab:realization ;
    qcb:contract ab:contract ;
    qcb:logicalOperation ab:lop_assemble,
        ab:lop_capabilities,
        ab:lop_certify_authzen_evidence,
        ab:lop_certify_spiffe_evidence,
        ab:lop_commit,
        ab:lop_conform,
        ab:lop_derive_subject_digest,
        ab:lop_jcs_canonicalize,
        ab:lop_mine,
        ab:lop_range_proof_verify,
        ab:lop_smt_absence_verify,
        ab:lop_verify,
        ab:lop_verify_signature,
        ab:lop_verify_signature_input ;
    qcb:realizationProfile ab:profile ;
    qcb:requestedProjection "host",
        "op-names",
        "tests" .

ab:rBadField a skos:Concept,
        qri:RefusalCode ;
    skos:inScheme ab:refusals ;
    qri:refusalCode "bad_field" .

ab:rBadJson a skos:Concept,
        qri:RefusalCode ;
    skos:inScheme ab:refusals ;
    qri:refusalCode "bad_json" .

ab:rInternal a skos:Concept,
        qri:RefusalCode ;
    skos:inScheme ab:refusals ;
    qri:refusalCode "internal" .

ab:rMissingBuffer a skos:Concept,
        qri:RefusalCode ;
    skos:inScheme ab:refusals ;
    qri:refusalCode "missing_buffer" .

ab:rMissingField a skos:Concept,
        qri:RefusalCode ;
    skos:inScheme ab:refusals ;
    qri:refusalCode "missing_field" .

ab:rTooDeep a skos:Concept,
        qri:RefusalCode ;
    skos:inScheme ab:refusals ;
    qri:refusalCode "too_deep" .

ab:rTooLarge a skos:Concept,
        qri:RefusalCode ;
    skos:inScheme ab:refusals ;
    qri:refusalCode "too_large" .

ab:rUnknownOp a skos:Concept,
        qri:RefusalCode ;
    skos:inScheme ab:refusals ;
    qri:refusalCode "unknown_op" .

ab:capability a qri:Capability .

ab:checksum a spdx:Checksum ;
    spdx:algorithm spdx:checksumAlgorithm_sha256 ;
    spdx:checksumValue "5cc37aea8e59f7139e2ff5d43ab3c3c82931285b6400cf45f943c61d21a41402" .

ab:determinism a qri:Invariant ;
    qri:invariantKind qri:Determinism .

ab:impEnvironGet a qri:WasiImport ;
    qri:importName "environ_get" ;
    qri:importParams "i32,i32" ;
    qri:importResults "i32" .

ab:impEnvironSizesGet a qri:WasiImport ;
    qri:importName "environ_sizes_get" ;
    qri:importParams "i32,i32" ;
    qri:importResults "i32" .

ab:impFdWrite a qri:WasiImport ;
    qri:importName "fd_write" ;
    qri:importParams "i32,i32,i32,i32" ;
    qri:importResults "i32" .

ab:impProcExit a qri:WasiImport ;
    qri:importName "proc_exit" ;
    qri:importParams "i32" ;
    qri:importResults "" .

ab:inRequest a qri:Field ;
    qri:fieldName "request" ;
    qri:fieldOrder 1 ;
    qri:fieldType "bytes" .

ab:invariants a qri:InvariantSet ;
    qri:requiresInvariant ab:determinism,
        ab:refusalBoundary,
        ab:semanticResult .

ab:lop_assemble a qri:Operation ;
    qri:opName "assemble" .

ab:lop_capabilities a qri:Operation ;
    qri:opName "capabilities" .

ab:lop_certify_authzen_evidence a qri:Operation ;
    qri:opName "certify_authzen_evidence" .

ab:lop_certify_spiffe_evidence a qri:Operation ;
    qri:opName "certify_spiffe_evidence" .

ab:lop_derive_subject_digest a qri:Operation ;
    qri:opName "derive_subject_digest" .

ab:lop_jcs_canonicalize a qri:Operation ;
    qri:opName "jcs_canonicalize" .

ab:lop_range_proof_verify a qri:Operation ;
    qri:opName "range_proof_verify" .

ab:lop_smt_absence_verify a qri:Operation ;
    qri:opName "smt_absence_verify" .

ab:lop_verify_signature a qri:Operation ;
    qri:opName "verify_signature" .

ab:lop_commit a qri:Operation ;
    qri:opName "commit" .

ab:lop_conform a qri:Operation ;
    qri:opName "conform" .

ab:lop_mine a qri:Operation ;
    qri:opName "mine" .

ab:lop_verify a qri:Operation ;
    qri:opName "verify" .

ab:lop_verify_signature_input a qri:Operation ;
    qri:opName "verify_signature_input" .

ab:opCall a qri:Operation ;
    qri:input ab:inRequest ;
    qri:opName "call" ;
    qri:output ab:outResponse .

ab:outResponse a qri:Field ;
    qri:fieldName "response" ;
    qri:fieldOrder 1 ;
    qri:fieldType "bytes" .

ab:pin a qcb:ArtifactPin ;
    dcterms:provenance "local build of affidavit-wasm (cargo --target wasm32-wasip1 --profile wasm) from the affidavit checkout at 4f654d21f3863ad89a11a62325c1dbf875cf72df; pin equals affidavit-wasm/registry/ARTIFACTS.sha256 and registry/artifact-pin.json; ops add verify_signature and derive_subject_digest alongside certify_authzen_evidence and certify_spiffe_evidence; artifact.url is the intended release location and was NOT published or fetched by this build; the wasm is vendored in this package, so mix ash_affidavit.vendor --check needs no network" ;
    owl:versionInfo "26.10.5" ;
    dcat:byteSize "660847"^^xsd:nonNegativeInteger ;
    dcat:downloadURL "https://github.com/seanchatmangpt/affidavit/releases/download/v26.10.5/affidavit.wasm" ;
    dcat:mediaType "application/wasm" ;
    qcb:abiVersion "1" ;
    qcb:checksum ab:checksum ;
    qcb:registrySha256 "2fcaae611aaf069317123c0e1fe0c2978b2bd9c72aeadf2888aaee8be34d2ee5" .

ab:profile a qcb:RealizationProfile ;
    qcb:profileId "node-wasi" .

ab:realization a qri:Realization ;
    qri:implementsContract ab:contract .

ab:refusalBoundary a qri:Invariant ;
    qri:invariantKind qri:Refusal .

ab:semanticResult a qri:Invariant ;
    qri:invariantKind qri:Semantic .

ab:contract a qri:CapabilityContract ;
    qcb:registrySha256 "2fcaae611aaf069317123c0e1fe0c2978b2bd9c72aeadf2888aaee8be34d2ee5" ;
    qri:abiKind "core-wasm-json" ;
    qri:abiSymbolPrefix "af" ;
    qri:abiVersion "1" ;
    qri:allowedImport "wasi_snapshot_preview1::environ_get",
        "wasi_snapshot_preview1::environ_sizes_get",
        "wasi_snapshot_preview1::fd_write",
        "wasi_snapshot_preview1::proc_exit",
        "wasi_snapshot_preview1::random_get" ;
    qri:contractDigest "b83254fdd311cdfbe4ed97322eb0fc71aefc3ac9c9c87454b32ef627c1b24de6" ;
    qri:contractVersion "1.0.0" ;
    qri:invariantSet ab:invariants ;
    qri:operation ab:opCall ;
    qri:optionalExport "_initialize" ;
    qri:refusalScheme ab:refusals ;
    qri:requiredExport "af_abi_version",
        "af_alloc",
        "af_call",
        "af_free",
        "memory" ;
    qri:specifiesCapability ab:capability ;
    qri:wasiImport ab:impEnvironGet,
        ab:impEnvironSizesGet,
        ab:impFdWrite,
        ab:impProcExit,
        ab:impRandomGet .

ab:refusals a skos:ConceptScheme .
ab:rMalformed a skos:Concept,
        qri:RefusalCode ;
    skos:inScheme ab:refusals ;
    qri:refusalCode "malformed" .

ab:impRandomGet a qri:WasiImport ;
    qri:importName "random_get" ;
    qri:importParams "i32,i32" ;
    qri:importResults "i32" .

