---
to: generated/tests/authority_boundary_test.exs
when: "PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> ASK { ?b a qcb:ConsumerBinding ; qcb:requestedProjection \"tests\" ; qcb:realizationProfile ?rp . ?rp qcb:profileId \"beam-wasmex\" }"
sparql:
  host: |
    PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?root ?ceiling ?wasm_rel WHERE {
      ?b a qcb:ConsumerBinding ; qcb:contract ?c ; qcb:authorityCeiling ?ceiling .
      ?c qri:hostProfile ?hp .
      ?hp qri:moduleRoot ?root ; qri:wasmRel ?wasm_rel .
    }
    ORDER BY ?root
---
{#- SPDX-License-Identifier: MIT -#}
{%- set h = host[0] -%}
# SPDX-License-Identifier: MIT
# GENERATED by qri-consumer-binding-pack. Authority non-escalation court for the generated beam host.
# Drives the generated {{ h.root }}.Host with every request of the op-examples file (default: next to
# {{ h.wasm_rel }}, override with AUTHORITY_EXAMPLES) and asserts on the real responses: no
# "authority" field other than {{ h.ceiling | json_encode() | safe }}, no standing ALIVE.
defmodule {{ h.root }}.Generated.AuthorityBoundaryTest do
  use ExUnit.Case, async: false

  alias {{ h.root }}.Host

  @ceiling {{ h.ceiling | json_encode() | safe }}
  @examples_path System.get_env("AUTHORITY_EXAMPLES") ||
                   Path.join(Path.dirname({{ h.wasm_rel | json_encode() | safe }}), "op-examples.json")

  defp walk(%{} = map, fun, path),
    do: Enum.each(map, fn {k, v} -> fun.(k, v, path <> "." <> k) && walk(v, fun, path <> "." <> k) end)

  defp walk(list, fun, path) when is_list(list),
    do: list |> Enum.with_index() |> Enum.each(fn {v, i} -> walk(v, fun, path <> "[#{i}]") end)

  defp walk(_scalar, _fun, _path), do: :ok

  test "no op response escalates authority or claims standing ALIVE" do
    {:ok, host} = start_supervised({Host, name: :authority_boundary_host})
    assert is_pid(host)
    %{"examples" => examples} = @examples_path |> File.read!() |> Jason.decode!()
    assert examples != []

    {:ok, counter} = Agent.start_link(fn -> 0 end)

    for %{"op" => op, "request" => request} <- examples do
      {:ok, response} = Host.request(:authority_boundary_host, request)

      walk(response, fn
        "authority", value, path ->
          Agent.update(counter, &(&1 + 1))
          assert value == @ceiling, "#{op} #{path}"
          true

        "standing", value, path ->
          refute value == "ALIVE", "#{op} #{path}"
          true

        _key, _value, _path ->
          true
      end, "$")
    end

    assert Agent.get(counter, & &1) > 0, "positive control: at least one response states its authority"
  end
end
