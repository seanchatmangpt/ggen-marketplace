---
to: generated/node-wasi/authority-boundary.test.mjs
when: "PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> ASK { ?b a qcb:ConsumerBinding ; qcb:requestedProjection \"tests\" ; qcb:realizationProfile ?rp . ?rp qcb:profileId \"node-wasi\" }"
sparql:
  ceiling: |
    PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
    SELECT ?ceiling WHERE { ?b a qcb:ConsumerBinding ; qcb:authorityCeiling ?ceiling . }
    ORDER BY ?ceiling
---
{#- SPDX-License-Identifier: MIT -#}
// SPDX-License-Identifier: MIT
// GENERATED by qri-consumer-binding-pack. Authority non-escalation court for the node-wasi host.
// Run: AUTHORITY_WASM=<module> AUTHORITY_EXAMPLES=<op-examples.json> node --test authority-boundary.test.mjs
// Asserts on real responses of the real module: no response carries an `authority` other than the
// ceiling, no response carries standing ALIVE, and the host constant equals the ceiling.
import test from 'node:test';
import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { AUTHORITY, load } from './host.mjs';

const CEILING = {{ ceiling[0].ceiling | json_encode() | safe }};
const wasm = process.env.AUTHORITY_WASM;
const examplesPath = process.env.AUTHORITY_EXAMPLES;

function walk(value, visit, path = '$') {
  if (Array.isArray(value)) value.forEach((v, i) => walk(v, visit, `${path}[${i}]`));
  else if (value && typeof value === 'object') {
    for (const [k, v] of Object.entries(value)) {
      visit(k, v, `${path}.${k}`);
      walk(v, visit, `${path}.${k}`);
    }
  }
}

test('host authority constant equals the binding ceiling', () => {
  assert.equal(AUTHORITY, CEILING);
  assert.equal(AUTHORITY, 'NONE');
});

test('no op response escalates authority or claims standing ALIVE', { skip: !wasm || !examplesPath }, async () => {
  const engine = await load(wasm);
  const examples = JSON.parse(readFileSync(examplesPath, 'utf8')).examples;
  assert.ok(examples.length > 0, 'positive control: at least one example');
  let authorityFields = 0;
  for (const example of examples) {
    const response = engine.request(example.request);
    walk(response, (key, value, path) => {
      if (key === 'authority') {
        authorityFields += 1;
        assert.equal(value, CEILING, `${example.op} ${path}`);
      }
      if (key === 'standing') assert.notEqual(value, 'ALIVE', `${example.op} ${path}`);
    });
  }
  assert.ok(authorityFields > 0, 'positive control: at least one response states its authority');
});
