---
to: generated/node-wasi/host.mjs
when: "PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#> ASK { ?b a qcb:ConsumerBinding ; qcb:requestedProjection \"host\" ; qcb:realizationProfile ?rp . ?rp qcb:profileId \"node-wasi\" }"
sparql:
  host: |
    PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    PREFIX dcat: <http://www.w3.org/ns/dcat#>
    PREFIX spdx: <http://spdx.org/rdf/terms#>
    SELECT ?prefix ?abi ?sha ?bytes ?cap ?path_env ?registry ?ceiling WHERE {
      ?b a qcb:ConsumerBinding ; qcb:contract ?c ; qcb:artifactPin ?p ; qcb:authorityCeiling ?ceiling .
      ?c qri:abiSymbolPrefix ?prefix .
      ?p qcb:abiVersion ?abi ; dcat:byteSize ?bytes ; qcb:checksum ?ck ; qcb:registrySha256 ?registry .
      ?ck spdx:checksumValue ?sha .
      OPTIONAL { ?c qri:hostProfile ?hp . ?hp qri:requestCap ?rc }
      OPTIONAL { ?c qri:hostProfile ?hp2 . ?hp2 qri:pathEnv ?pe }
      BIND(COALESCE(?rc, 16777216) AS ?cap)
      BIND(COALESCE(?pe, "WASM_PATH") AS ?path_env)
    }
    ORDER BY ?sha
    LIMIT 1
  exports: |
    PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?name WHERE { ?b a qcb:ConsumerBinding ; qcb:contract ?c . ?c qri:requiredExport ?name . }
    ORDER BY ?name
  imports: |
    PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?name WHERE { ?b a qcb:ConsumerBinding ; qcb:contract ?c . ?c qri:allowedImport ?name . }
    ORDER BY ?name
  operations: |
    PREFIX qcb: <https://seanchatmangpt.github.io/packs/qri-consumer-binding-pack#>
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?name WHERE { ?b a qcb:ConsumerBinding ; qcb:logicalOperation ?o . ?o qri:opName ?name . }
    ORDER BY ?name
---
{#- SPDX-License-Identifier: MIT -#}
{%- set h = host[0] -%}
// SPDX-License-Identifier: MIT
// GENERATED by qri-consumer-binding-pack (profile node-wasi). Do not edit: change the binding or the
// pack template and regenerate. Zero dependencies (node:fs, node:crypto, node:wasi).
//
// Authority ceiling NONE. The pin is identity, never authorization: this host verifies the module
// bytes against the pin BEFORE compiling, checks the import surface against the contract's allowed
// imports, and returns the engine's computation as data. Nothing here grants or implies authority.
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { WASI } from 'node:wasi';

export const AUTHORITY = {{ h.ceiling | json_encode() | safe }};
export const PIN = Object.freeze({
  sha256: {{ h.sha | json_encode() | safe }},
  bytes: {{ h.bytes }},
  abiVersion: {{ h.abi }},
  registrySha256: {{ h.registry | json_encode() | safe }},
});
export const PREFIX = {{ h.prefix | json_encode() | safe }};
export const PATH_ENV = {{ h.path_env | json_encode() | safe }};
export const REQUEST_CAP = {{ h.cap }};
export const REQUIRED_EXPORTS = Object.freeze([
{%- for e in exports %}
  {{ e.name | json_encode() | safe }},
{%- endfor %}
]);
export const ALLOWED_IMPORTS = Object.freeze([
{%- for i in imports %}
  {{ i.name | json_encode() | safe }},
{%- endfor %}
]);
export const OPS = Object.freeze([
{%- for o in operations %}
  {{ o.name | json_encode() | safe }},
{%- endfor %}
]);

/** Closed class of every host and engine code; the same placement as the BEAM host's refusal module. */
export const CLASSES = Object.freeze({
  invalid_json: 'refused_input', invalid_encoding: 'refused_input',
  bad_json: 'refused_input', missing_field: 'refused_input', bad_field: 'refused_input',
  wasm_digest_mismatch: 'refused_identity', wasm_import_surface_mismatch: 'refused_identity',
  wasm_missing_export: 'refused_identity', wasm_invalid: 'refused_identity',
  wasm_not_vendored: 'blocked_resource', wasm_unreadable: 'blocked_resource',
  resource_limit: 'blocked_resource', saturated: 'blocked_resource', host_not_started: 'blocked_resource',
  call_timeout: 'blocked_resource', fuel_exhausted: 'blocked_resource',
  too_large: 'blocked_resource', too_deep: 'blocked_resource', missing_buffer: 'blocked_resource',
  call_trapped: 'trap', call_exited: 'trap', abi_failure: 'trap', instantiation_failed: 'trap',
  malformed_response: 'trap', internal: 'trap',
  unknown_op: 'unsupported', engine_unclassified: 'unsupported',
});

/** Class of a code; a code outside the closed set is `unsupported`, carried verbatim by the caller. */
export function classOf(code) {
  return Object.hasOwn(CLASSES, code) ? CLASSES[code] : 'unsupported';
}

/** Typed host refusal; `code` is stable, `detail` is data, `class` places the code. */
export class Refusal extends Error {
  constructor(code, message, detail = {}) {
    super(message);
    this.name = 'Refusal';
    this.code = code;
    this.class = classOf(code);
    this.detail = detail;
  }
}

/** Verify module bytes against the pin. Refuses before any compile. */
export function verifyBytes(bytes) {
  const sha = createHash('sha256').update(bytes).digest('hex');
  if (sha !== PIN.sha256) {
    throw new Refusal('wasm_digest_mismatch', 'module sha256 differs from the pin', { expected: PIN.sha256, actual: sha });
  }
  return sha;
}

/** Load the module at `path`: read, pin check, compile, import-surface check, instantiate, ABI check. */
export async function load(path = process.env[PATH_ENV]) {
  if (!path) throw new Refusal('wasm_not_vendored', `no module path (pass one or set ${PATH_ENV})`);
  let bytes;
  try {
    bytes = readFileSync(path);
  } catch (error) {
    throw new Refusal('wasm_unreadable', 'module is not readable', { path, error: String(error.code ?? error) });
  }
  const sha256 = verifyBytes(bytes);
  let module;
  try {
    module = await WebAssembly.compile(bytes);
  } catch (error) {
    throw new Refusal('wasm_invalid', 'module does not compile', { error: String(error) });
  }
  for (const imp of WebAssembly.Module.imports(module)) {
    const key = `${imp.module}::${imp.name}`;
    if (!ALLOWED_IMPORTS.includes(key)) {
      throw new Refusal('wasm_invalid', 'module imports outside the allowed surface', { import: key });
    }
  }
  const exported = new Set(WebAssembly.Module.exports(module).map((e) => e.name));
  for (const name of REQUIRED_EXPORTS) {
    if (!exported.has(name)) throw new Refusal('wasm_missing_export', 'required export missing', { export: name });
  }
  const wasi = new WASI({ version: 'preview1', args: [], env: {} });
  let instance;
  try {
    instance = await WebAssembly.instantiate(module, wasi.getImportObject());
    wasi.initialize(instance);
  } catch (error) {
    throw new Refusal('instantiation_failed', 'module did not instantiate', { error: String(error) });
  }
  const x = instance.exports;
  const abi = x[`${PREFIX}_abi_version`]();
  if (abi !== PIN.abiVersion) {
    throw new Refusal('abi_failure', 'abi version differs from the pin', { expected: PIN.abiVersion, actual: abi });
  }
  const alloc = x[`${PREFIX}_alloc`];
  const call = x[`${PREFIX}_call`];
  const free = x[`${PREFIX}_free`];
  const memory = x.memory;
  const encoder = new TextEncoder();
  const decoder = new TextDecoder('utf-8', { fatal: true });
  return {
    sha256,
    abiVersion: abi,
    /** One request: object in, parsed response object out. A request buffer is consumed by the call. */
    request(requestObject) {
      return this.requestBytes(encoder.encode(JSON.stringify(requestObject)));
    },
    /** One request as raw bytes (malformed JSON and empty buffers reach the engine unchanged). */
    requestBytes(payload) {
      if (payload.length > REQUEST_CAP) {
        throw new Refusal('resource_limit', 'request exceeds the ABI limit', { bytes: payload.length, limit: REQUEST_CAP });
      }
      const ptr = alloc(payload.length);
      if (ptr === 0) throw new Refusal('abi_failure', 'engine refused the request allocation', { bytes: payload.length });
      new Uint8Array(memory.buffer, ptr, payload.length).set(payload);
      let packed;
      try {
        packed = BigInt.asUintN(64, call(ptr, payload.length));
      } catch (error) {
        throw new Refusal('call_trapped', 'engine trapped', { error: String(error) });
      }
      const outPtr = Number(packed >> 32n);
      const outLen = Number(packed & 0xffffffffn);
      const body = new Uint8Array(memory.buffer, outPtr, outLen).slice();
      free(outPtr, outLen);
      try {
        const parsed = JSON.parse(decoder.decode(body));
        if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('not an object');
        if (parsed.ok === false && parsed.error && typeof parsed.error.code === 'string') {
          parsed.class = classOf(parsed.error.code);
        }
        return parsed;
      } catch (error) {
        throw new Refusal('malformed_response', 'engine response is not a JSON object', { error: String(error) });
      }
    },
  };
}

// CLI: node host.mjs --check <wasm> | --call '<json>' <wasm>. Exit 0 ok, 3 typed refusal (JSON on stdout).
if (import.meta.url === `file://${process.argv[1]}`) {
  const args = process.argv.slice(2);
  const mode = args[0];
  try {
    if (mode === '--check') {
      const engine = await load(args[1]);
      console.log(JSON.stringify({ abi_version: engine.abiVersion, authority: AUTHORITY, ok: true, sha256: engine.sha256 }));
    } else if (mode === '--call') {
      const engine = await load(args[2]);
      console.log(JSON.stringify(engine.request(JSON.parse(args[1]))));
    } else {
      console.error('usage: host.mjs --check <wasm> | --call <json> <wasm>');
      process.exit(2);
    }
  } catch (error) {
    if (error instanceof Refusal) {
      console.log(JSON.stringify({ authority: AUTHORITY, class: error.class, code: error.code, detail: error.detail, ok: false }));
      process.exit(3);
    }
    throw error;
  }
}
