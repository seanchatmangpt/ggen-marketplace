@prefix mcf: <https://ggen.dev/ontology/multicell-consumer#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mcf:ConsumerFactory a prov:Entity .
mcf:ConsumerCell a prov:Entity .
mcf:CompositionPlan a prov:Entity .
mcf:QualificationContract a prov:Entity .

mcf:factory mcf:authority "SELECT|CONSTRUCT|VERIFY" ; mcf:actuationPerformed false ; mcf:minCells 2 ; mcf:requiresExactSubject true ; mcf:requiresIndependentQualification true .

mcf:mdbookCell a mcf:ConsumerCell ; mcf:pack "mdbook-pattern-language-pack" ; mcf:role "documentation" .
mcf:consequenceCell a mcf:ConsumerCell ; mcf:pack "consequence-ir-pack" ; mcf:role "consequence-ir" .
mcf:standingCell a mcf:ConsumerCell ; mcf:pack "standing-ladder-pack" ; mcf:role "evidentiary-standing" .
mcf:dfcmCell a mcf:ConsumerCell ; mcf:pack "dfcm-maximalist-court-pack" ; mcf:role "option-court" .

mcf:referencePlan a mcf:CompositionPlan ; mcf:cell mcf:mdbookCell, mcf:consequenceCell, mcf:standingCell, mcf:dfcmCell ; mcf:selectedCellCount 4 ; mcf:preservedUnselectedOptions true ; mcf:authority "SELECT" ; mcf:actuationPerformed false .
