import json
from pathlib import Path

def test_multicell_manifest():
    data=json.loads(Path('generated/multicell/consumer-manifest.json').read_text())
    assert data['schema']=='ggen.multicell-consumer/1'
    assert data['actuation_performed'] is False
    assert data['qualification']=='independent'
    assert all(cell['count'] >= 2 for cell in data['cells'])
