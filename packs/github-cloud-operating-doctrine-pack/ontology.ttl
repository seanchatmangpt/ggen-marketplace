@prefix gcd:  <https://ggen.dev/ontology/github-cloud-operating-doctrine#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Chatman Ecosystem — GitHub Cloud Operating Doctrine
# GitHub is modeled as an authenticated remote object/execution graph.
# CLI implementations are optional transports, never sovereign prerequisites.

gcd:TransportPlane a rdfs:Class ; rdfs:label "Transport plane" .
gcd:AuthorityPrincipal a rdfs:Class ; rdfs:label "Authority principal" .
gcd:DependencyRoute a rdfs:Class ; rdfs:label "Private dependency route" .
gcd:DoctrineRule a rdfs:Class ; rdfs:label "Doctrine rule" .
gcd:Standing a rdfs:Class ; rdfs:label "Standing" .
gcd:SkillSemantic a rdfs:Class ; rdfs:label "Skill semantic contract" .

gcd:order a rdf:Property ; rdfs:range xsd:integer .
gcd:slug a rdf:Property ; rdfs:range xsd:string .
gcd:title a rdf:Property ; rdfs:range xsd:string .
gcd:role a rdf:Property ; rdfs:range xsd:string .
gcd:condition a rdf:Property ; rdfs:range xsd:string .
gcd:semanticOutcome a rdf:Property ; rdfs:range xsd:string .
gcd:forbidsAssumption a rdf:Property ; rdfs:range xsd:string .

# Canonical transport precedence.
gcd:GitHubConnector a gcd:TransportPlane ; gcd:order 1 ; gcd:slug "github-connector" ; gcd:role "CONTROL_PLANE" ; rdfs:label "GitHub Connector" ; rdfs:comment "Repository, Git object, pull request, check, workflow, log, artifact, release, and status control through the connected GitHub App." .
gcd:GitHubActions a gcd:TransportPlane ; gcd:order 2 ; gcd:slug "github-actions" ; gcd:role "REMOTE_EXECUTION_PLANE" ; rdfs:label "GitHub Actions" ; rdfs:comment "Repository-native remote compiler and integration execution plane; evidence producer, not truth oracle." .
gcd:ArtifactTransport a gcd:TransportPlane ; gcd:order 3 ; gcd:slug "artifacts" ; gcd:role "MATERIALIZATION_PLANE" ; rdfs:label "Artifact Transport" ; rdfs:comment "Immutable workflow artifacts, source capsules, Git bundles, packages, releases, verifier reports, and receipts." .
gcd:LocalVerificationCapsule a gcd:TransportPlane ; gcd:order 4 ; gcd:slug "local-verification-capsule" ; gcd:role "VERIFICATION_CAPSULE" ; rdfs:label "Local Verification Capsule" ; rdfs:comment "Inspect, replay, compare, hash, and independently verify exact materialized identities." .
gcd:CliFallback a gcd:TransportPlane ; gcd:order 5 ; gcd:slug "cli-fallback" ; gcd:role "OPTIONAL_ACCELERATOR" ; rdfs:label "CLI Fallback" ; rdfs:comment "Local git, gh, SSH, package managers, Docker, and direct network are optional accelerators and fallbacks." .

# Skills define workflow semantics, not a mandatory executable transport.
gcd:GithubSkill a gcd:SkillSemantic ; gcd:slug "github" ; gcd:semanticOutcome "orient structured GitHub objects and route specialized work" ; gcd:forbidsAssumption "local CLI is mandatory" .
gcd:GhFixCiSkill a gcd:SkillSemantic ; gcd:slug "gh-fix-ci" ; gcd:semanticOutcome "exact-head checks -> failing logs -> first causal failure -> diff relevance -> repair -> verification -> new exact-head observation" ; gcd:forbidsAssumption "the gh binary is required for semantic completion" .
gcd:YeetSkill a gcd:SkillSemantic ; gcd:slug "yeet" ; gcd:semanticOutcome "freeze scope -> manufacture intentional commit -> verify -> publish branch -> draft PR -> reobserve identities" ; gcd:forbidsAssumption "git push is the only lawful publication transport" .
gcd:AddressCommentsSkill a gcd:SkillSemantic ; gcd:slug "gh-address-comments" ; gcd:semanticOutcome "inspect actionable review feedback -> implement bounded repairs -> republish -> reobserve" ; gcd:forbidsAssumption "local checkout authority defines GitHub authority" .

# Authority domains must never be conflated.
gcd:ChatGPTConnectorPrincipal a gcd:AuthorityPrincipal ; gcd:slug "chatgpt-github-app" ; rdfs:label "ChatGPT GitHub App principal" .
gcd:ActionsTokenPrincipal a gcd:AuthorityPrincipal ; gcd:slug "actions-github-token" ; rdfs:label "Repository-scoped Actions GITHUB_TOKEN principal" .
gcd:LocalRuntimePrincipal a gcd:AuthorityPrincipal ; gcd:slug "local-runtime" ; rdfs:label "ChatGPT local runtime principal" .

# Cross-private dependency ladder. A failed earlier edge does not close later edges.
gcd:ExistingImmutablePackage a gcd:DependencyRoute ; gcd:order 1 ; gcd:slug "existing-immutable-package" ; rdfs:label "Existing immutable package" ; rdfs:comment "Search exact-SHA-bound packages, GHCR artifacts, registries, and release assets before dynamic private cloning." .
gcd:ExistingBuildArtifact a gcd:DependencyRoute ; gcd:order 2 ; gcd:slug "existing-build-artifact" ; rdfs:label "Existing build artifact" ; rdfs:comment "Search retained successful dependency-repository runs for exact source capsules, bundles, packages, binaries, WASM, and verifier products." .
gcd:DependencySideManufacture a gcd:DependencyRoute ; gcd:order 3 ; gcd:slug "dependency-side-immutable-artifact" ; rdfs:label "Dependency-side immutable artifact manufacture" ; rdfs:comment "If authorized, build B@exact-SHA once, emit a reusable immutable product, digest it, and receipt it." .
gcd:ExistingAppToken a gcd:DependencyRoute ; gcd:order 4 ; gcd:slug "existing-app-token-strategy" ; rdfs:label "Existing GitHub App/token strategy" ; rdfs:comment "Reuse already-approved cross-repository authority; never invent credentials or request a PAT as the first familiar answer." .
gcd:SameRepositoryMaterialization a gcd:DependencyRoute ; gcd:order 5 ; gcd:slug "same-repository-materialization" ; rdfs:label "Same-repository materialization" ; rdfs:comment "Move dependency materialization to an authorized control plane and let the consumer operate on an admitted immutable capsule." .
gcd:ReusableBuildProduct a gcd:DependencyRoute ; gcd:order 6 ; gcd:slug "reusable-build-product" ; rdfs:label "Reusable build product" ; rdfs:comment "Publish stable dependency capability once and let many consumers depend on package identity plus digest rather than a live private clone." .
gcd:LawfulVendoring a gcd:DependencyRoute ; gcd:order 7 ; gcd:slug "lawful-vendoring" ; rdfs:label "Lawful vendoring" ; rdfs:comment "Vendor an exact source snapshot only when repository doctrine permits it and it does not create an illicit shadow source of truth." .

# Crown standings.
gcd:Alive a gcd:Standing ; gcd:slug "ALIVE" ; gcd:condition "requested acceptance boundary established with exact identities and evidence" .
gcd:RouteFailed a gcd:Standing ; gcd:slug "ROUTE_FAILED" ; gcd:condition "one transport or principal path failed while another lawful route may remain" .
gcd:NextRouteIdentified a gcd:Standing ; gcd:slug "NEXT_ROUTE_IDENTIFIED" ; gcd:condition "at least one relevant lawful authorized route remains and must be executed" .
gcd:Blocked a gcd:Standing ; gcd:slug "BLOCKED" ; gcd:condition "no lawful authorized route to the requested acceptance boundary remains after connector, artifact, authority, dependency-manufacture, and compatible execution routes are exhausted" .

# The 28 constitutional sections. The comments are the generated human contract.
gcd:R01 a gcd:DoctrineRule ; gcd:order 1 ; gcd:title "Canonical GitHub Topology" ; rdfs:comment "Model four cooperating planes: connector control, Actions remote execution, artifact materialization, and local verification. CLI/network tools surround the topology but are not the architecture." .
gcd:R02 a gcd:DoctrineRule ; gcd:order 2 ; gcd:title "Connector First" ; rdfs:comment "Before declaring a GitHub capability unavailable, dynamically inspect the currently exposed connector surface. Current capabilities outrank stale transport assumptions." .
gcd:R03 a gcd:DoctrineRule ; gcd:order 3 ; gcd:title "Skill Semantics vs Transport" ; rdfs:comment "Installed skills define workflow semantics. Semantic completion may lawfully use connector-native objects, Actions, artifacts, a local capsule, or CLI as appropriate." .
gcd:R04 a gcd:DoctrineRule ; gcd:order 4 ; gcd:title "Canonical Publication Path" ; rdfs:comment "When local Git transport is unavailable, publish through GitHub objects: exact base -> blobs -> tree -> commit(parent=base) -> non-force ref update -> reobserve remote SHA -> create/update draft PR." .
gcd:R05 a gcd:DoctrineRule ; gcd:order 5 ; gcd:title "Scope Protection Still Applies" ; rdfs:comment "Record base tree, intended changed paths, task branch, PR, and current head. Never overwrite unrelated work, stale blob identities, or an unexpectedly moved branch head; force=false by default." .
gcd:R06 a gcd:DoctrineRule ; gcd:order 6 ; gcd:title "Exact-Head Law" ; rdfs:comment "Every CI statement is indexed by repository and commit SHA. PR head, workflow-run head, and evaluated commit must be identical; older green runs have no authority over newer heads." .
gcd:R07 a gcd:DoctrineRule ; gcd:order 7 ; gcd:title "Evidence-First CI Repair" ; rdfs:comment "Resolve exact head, enumerate checks, inspect failing jobs and logs, capture first causal error, classify diff relevance, repair narrowly, verify, publish, and observe the new exact-head CI." .
gcd:R08 a gcd:DoctrineRule ; gcd:order 8 ; gcd:title "Do Not Repair Unrelated Failures" ; rdfs:comment "Classify failures as DIFF_CAUSED, PREEXISTING, INFRASTRUCTURE, DEPENDENCY, TOOLCHAIN, NETWORK, FLAKE, EXTERNAL, or UNKNOWN. Do not mutate unrelated source merely to make a dashboard green." .
gcd:R09 a gcd:DoctrineRule ; gcd:order 9 ; gcd:title "Local Checkout Is Optional" ; rdfs:comment "Choose the minimal exact source representation required by the acceptance boundary: checkout, archive, bundle, artifact, sparse tree, connector tree, blobs, or remote Actions checkout." .
gcd:R10 a gcd:DoctrineRule ; gcd:order 10 ; gcd:title "Local Network Is Not GitHub Authority" ; rdfs:comment "Container internet, connector access, Actions internet, artifact transport, and API authority are distinct. curl/git failures do not imply repository unavailability." .
gcd:R11 a gcd:DoctrineRule ; gcd:order 11 ; gcd:title "Actions GITHUB_TOKEN Is Not Connector Authority" ; rdfs:comment "The ChatGPT GitHub App and repository-scoped Actions token are different principals. Failure of the default Actions token proves only that principal-route failed." .
gcd:R12 a gcd:DoctrineRule ; gcd:order 12 ; gcd:title "Cross-Private Repository Dependency Ladder" ; rdfs:comment "Exhaust exact immutable packages, retained artifacts, dependency-side manufacture, existing app/token strategies, same-repository materialization, reusable build products, then lawful vendoring before external credential escalation." .
gcd:R13 a gcd:DoctrineRule ; gcd:order 13 ; gcd:title "Secrets Are Not the First Answer" ; rdfs:comment "SECRET_ENUMERATION_UNAVAILABLE is not DEPENDENCY_AUTHORITY_BLOCKED. Inspect existing workflows, apps, packages, artifacts, releases, and visible organization patterns before requesting human credentials." .
gcd:R14 a gcd:DoctrineRule ; gcd:order 14 ; gcd:title "Prefer Artifact Flow Over Credential Flow" ; rdfs:comment "Prefer source -> build once -> verify once -> immutable artifact -> receipt -> many consumers over repeated private clones with repeated credentials and builds." .
gcd:R15 a gcd:DoctrineRule ; gcd:order 15 ; gcd:title "GitHub Actions Is a Remote Compiler, Not Truth" ; rdfs:comment "Use Actions for unavailable toolchains and matrices, then materialize resulting artifacts for digest verification and independent replay whenever possible. A green workflow is evidence, not system truth." .
gcd:R16 a gcd:DoctrineRule ; gcd:order 16 ; gcd:title "Artifacts Are First-Class Transport" ; rdfs:comment "Search retained artifacts for toolchains, source trees, Git bundles, fixtures, binaries, dependencies, and reports before declaring capability unavailable or rebuilding duplicate inventory." .
gcd:R17 a gcd:DoctrineRule ; gcd:order 17 ; gcd:title "GitHub Workflow Changes" ; rdfs:comment "Eliminate false tests, duplicate workflows/compiles, obsolete jobs, unnecessary matrices, and stale triggers; reduce cold installs/network/private clones/fanout; raise exact-head identity, determinism, locality, artifact identity, and receipts." .
gcd:R18 a gcd:DoctrineRule ; gcd:order 18 ; gcd:title "Workflow Queue Is Topology" ; rdfs:comment "A queued Actions job means RUNNER_NOT_ASSIGNED, not WORKFLOW_FAILED. Try existing artifacts, compatible runners, quieter authorized execution, or local compatible proof without gratuitous fan-out." .
gcd:R19 a gcd:DoctrineRule ; gcd:order 19 ; gcd:title "Draft PR Is the Default Publication Boundary" ; rdfs:comment "Publish through a purpose branch, intentional commit, and draft PR. Include what, why, impact, root cause, verification, exact head, and residual risk. Never merge or close unless explicitly authorized." .
gcd:R20 a gcd:DoctrineRule ; gcd:order 20 ; gcd:title "Existing Task Objects Should Be Reused" ; rdfs:comment "Inspect existing task branches and pull requests first. Prefer the correct existing object; avoid duplicate branches, duplicate PRs, one-commit PR spam, and parallel WIP for the same defect." .
gcd:R21 a gcd:DoctrineRule ; gcd:order 21 ; gcd:title "GitHub Mutation Receipt" ; rdfs:comment "For each mutation record operation, repository, previous identity, new identity, authority, and observed consequence; include base/tree/commit/ref/PR identities as applicable." .
gcd:R22 a gcd:DoctrineRule ; gcd:order 22 ; gcd:title "No False Branded Blockers" ; rdfs:comment "Do not report GH_FIX_CI=BLOCKED or YEET=BLOCKED merely because local gh/git transport failed when the semantic GitHub consequence succeeded through another lawful route." .
gcd:R23 a gcd:DoctrineRule ; gcd:order 23 ; gcd:title "Do Not Worship the CLI" ; rdfs:comment "The objective is verified GitHub consequence, not making gh or git push work. CLI tools are implementations of GitHub operations, not the ontology of GitHub." .
gcd:R24 a gcd:DoctrineRule ; gcd:order 24 ; gcd:title "Authority Escalation Rule" ; rdfs:comment "Human intervention is the last relevant edge. Prove connector, artifact, package, app, workflow, dependency manufacture, materialization, tree reconstruction, and compatible execution cannot satisfy acceptance before requesting minimal external authority." .
gcd:R25 a gcd:DoctrineRule ; gcd:order 25 ; gcd:title "BLOCKED Definition for GitHub" ; rdfs:comment "BLOCKED is lawful only when the acceptance boundary is unmet and every available connector, artifact, authority, dependency-manufacture, and compatible execution substitute has been exhausted. If a route remains, use NEXT_ROUTE_IDENTIFIED and execute it." .
gcd:R26 a gcd:DoctrineRule ; gcd:order 26 ; gcd:title "Canonical Chatman GitHub Loop" ; rdfs:comment "Observe repo -> admit exact SHA -> materialize only required source -> implement -> verify -> connector publish -> draft PR -> observe exact head -> Actions/logs/artifacts -> local replay -> receipt; CI repair loops through first causal failure until ALIVE." .
gcd:R27 a gcd:DoctrineRule ; gcd:order 27 ; gcd:title "Governing GitHub Sentence" ; rdfs:comment "Treat GitHub as an authenticated remote object and execution graph. A CLI failure is a failed route and a repository-scoped token failure is a failed principal; neither is a failed task while a lawful path remains." .
gcd:R28 a gcd:DoctrineRule ; gcd:order 28 ; gcd:title "Clean-Session Default" ; rdfs:comment "Discover connector capabilities and GitHub skills, resolve exact repo/SHA, inspect existing branches/PRs, prefer connector-native publication, use exact-head Actions evidence and artifacts aggressively, separate principals, reobserve every mutation, and never stop because the laptop-style path is absent." .
