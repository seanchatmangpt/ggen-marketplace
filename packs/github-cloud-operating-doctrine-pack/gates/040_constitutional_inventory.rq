PREFIX gcd: <https://ggen.dev/ontology/github-cloud-operating-doctrine#>

SELECT ?violation
WHERE {
  {
    { SELECT (COUNT(?rule) AS ?count) WHERE { ?rule a gcd:DoctrineRule . } }
    FILTER (?count != 28)
    BIND(gcd:DoctrineRuleCardinality AS ?violation)
  }
  UNION
  {
    { SELECT (COUNT(?principal) AS ?count) WHERE { ?principal a gcd:AuthorityPrincipal . } }
    FILTER (?count != 3)
    BIND(gcd:AuthorityPrincipalCardinality AS ?violation)
  }
  UNION
  {
    FILTER NOT EXISTS { gcd:R06 gcd:title "Exact-Head Law" . }
    BIND(gcd:ExactHeadLawMissing AS ?violation)
  }
  UNION
  {
    FILTER NOT EXISTS { gcd:R22 gcd:title "No False Branded Blockers" . }
    BIND(gcd:FalseBlockerLawMissing AS ?violation)
  }
}
