PREFIX gcd: <https://ggen.dev/ontology/github-cloud-operating-doctrine#>

SELECT ?violation
WHERE {
  {
    FILTER NOT EXISTS {
      gcd:Blocked a gcd:Standing ;
        gcd:slug "BLOCKED" ;
        gcd:condition "no lawful authorized route to the requested acceptance boundary remains after connector, artifact, authority, dependency-manufacture, and compatible execution routes are exhausted" .
    }
    BIND(gcd:BlockedWithoutExhaustion AS ?violation)
  }
  UNION
  {
    FILTER NOT EXISTS {
      gcd:NextRouteIdentified a gcd:Standing ;
        gcd:slug "NEXT_ROUTE_IDENTIFIED" ;
        gcd:condition "at least one relevant lawful authorized route remains and must be executed" .
    }
    BIND(gcd:MissingNextRouteStanding AS ?violation)
  }
}
