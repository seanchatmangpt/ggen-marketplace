@prefix pack: <urn:ggen-marketplace:deckgl-orthographic-layers-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pack:OpsDeckCanvas a pack:ReactComponent ;
    rdfs:label "OpsDeckCanvas" ;
    pack:view "OrthographicView" ;
    pack:targetSource "computed from data bounding box, not hardcoded" ;
    rdfs:comment "Top-level deck.gl canvas: composes ScatterplotLayer, ArcLayer, TextLayer over OrthographicView." .

pack:DependsOnLayout a pack:PackDependency ;
    rdfs:label "deterministic-layout-pack" ;
    pack:importedSymbol "computeLayout" ;
    pack:relation "consumes, does not duplicate" ;
    rdfs:comment "OpsDeckCanvas imports computeLayout from lib/layout/computeLayout (deterministic-layout-pack's output path) rather than reimplementing layout." .

pack:ScatterplotUsage a pack:LayerUsage ;
    rdfs:label "ScatterplotLayer" ;
    pack:getPosition "from computeLayout map" ;
    pack:getRadius "from a real metric field on the entity" ;
    pack:getFillColor "fixed documented status->RGBA lookup table" ;
    pack:pickable true .

pack:ArcUsage a pack:LayerUsage ;
    rdfs:label "ArcLayer" ;
    pack:edgePolicy "only real asserted edges from data, never fabricated" ;
    pack:getWidth "from a real weight/direction field" .

pack:TextUsage a pack:LayerUsage ;
    rdfs:label "TextLayer" ;
    pack:getPosition "node position offset by [radius, 8px]" ;
    pack:getColor "theme foreground CSS variable" .
