@prefix ec: <https://seanchatman.dev/ontology/evidence-capital#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ec:CapitalController a ec:Capability ; ec:authority "SELECT" ; ec:requiresExactSubject true .
ec:RealizedGain a ec:Metric ; ec:minimum "0.0"^^xsd:decimal .
ec:FalseCapitalRate a ec:Metric ; ec:maximum "0.2"^^xsd:decimal .
ec:RootConcentration a ec:Metric ; ec:maximum "0.8"^^xsd:decimal .
ec:ConsequentialDo a ec:Authority ; ec:exclusiveBroker "BRCE" .
