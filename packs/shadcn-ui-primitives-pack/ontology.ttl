@prefix pack: <urn:ggen-marketplace:shadcn-ui-primitives-pack:> .
@prefix sc: <urn:ggen-marketplace:shadcn-ui-primitives-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pack:GapEvidence a pack:AdmittedFinding ;
    rdfs:label "missing ui primitives" ;
    pack:method "grep every *-shadcn-pack templates/ for to: components/ui/*.tsx" ;
    pack:result """only alert.tsx, input.tsx, dialog.tsx (ai-chatbot-shadcn-pack) and
        button.tsx (nextjs-ai-sdk-pack, jotp-benchmark-site-shadcn-pack) existed; card,
        badge, label, skeleton, separator, tabs, table were absent everywhere""" ;
    rdfs:comment """Surfaced by composing ops-dashboard-legend-pack's components (which import
        all of these) into a real consumer and finding the imports had no pack-provided
        source.""" .

pack:Card a pack:ReactComponent ; rdfs:label "Card family" .
pack:Badge a pack:ReactComponent ; rdfs:label "Badge" .
pack:Label a pack:ReactComponent ; rdfs:label "Label" .
pack:Skeleton a pack:ReactComponent ; rdfs:label "Skeleton" .
pack:Separator a pack:ReactComponent ; rdfs:label "Separator" .
pack:Tabs a pack:ReactComponent ; rdfs:label "Tabs family" .
pack:Table a pack:ReactComponent ; rdfs:label "Table family" .

# --- Gate-checkable facts (checked by gates/*.rq, fail-closed) ---

sc:ComponentPrimitive a rdfs:Class ;
    rdfs:label "Component primitive" ;
    rdfs:comment "A shadcn/ui primitive this pack projects; each requires the cn helper." .

sc:HelperProjection a rdfs:Class ;
    rdfs:label "Helper projection" ;
    rdfs:comment "A projected helper module the pack's primitives import." .

sc:name a rdfs:Property ;
    rdfs:label "primitive name" .
sc:toPath a rdfs:Property ;
    rdfs:label "projection target path" .
sc:requiresHelper a rdfs:Property ;
    rdfs:label "required helper module name" .
sc:requiresDep a rdfs:Property ;
    rdfs:label "required npm dependency" .
sc:path a rdfs:Property ;
    rdfs:label "helper projection path" .

pack:Card a sc:ComponentPrimitive ;
    sc:name "Card" ;
    sc:toPath "components/ui/card.tsx" ;
    sc:requiresHelper "cn" .

pack:Badge a sc:ComponentPrimitive ;
    sc:name "Badge" ;
    sc:toPath "components/ui/badge.tsx" ;
    sc:requiresHelper "cn" ;
    sc:requiresDep "class-variance-authority" .

pack:Label a sc:ComponentPrimitive ;
    sc:name "Label" ;
    sc:toPath "components/ui/label.tsx" ;
    sc:requiresHelper "cn" .

pack:Skeleton a sc:ComponentPrimitive ;
    sc:name "Skeleton" ;
    sc:toPath "components/ui/skeleton.tsx" ;
    sc:requiresHelper "cn" .

pack:Separator a sc:ComponentPrimitive ;
    sc:name "Separator" ;
    sc:toPath "components/ui/separator.tsx" ;
    sc:requiresHelper "cn" .

pack:Tabs a sc:ComponentPrimitive ;
    sc:name "Tabs" ;
    sc:toPath "components/ui/tabs.tsx" ;
    sc:requiresHelper "cn" ;
    sc:requiresDep "@radix-ui/react-tabs" .

pack:Table a sc:ComponentPrimitive ;
    sc:name "Table" ;
    sc:toPath "components/ui/table.tsx" ;
    sc:requiresHelper "cn" .

# cn helper lives in lib/utils.ts (templates/060_lib_utils_ts.tmpl)
pack:LibUtilsCn a sc:HelperProjection ;
    rdfs:label "cn helper (clsx + tailwind-merge)" ;
    sc:path "lib/utils.ts" .

# --- v0.3.0 Field form family (additive; research receipt:
# /Users/sac/cmms/docs/research/shadcn-registry-and-forms-deep-research.md —
# Field replaced the legacy Form/FormField wrapper; cn is now an npm dep) ---

# Declared deps the pack contract admits (gate 020 checks requiresDep against
# these individuals, fail-closed).
pack:DepCn a sc:DeclaredDep ; sc:packageName "cn" .
pack:DepCva a sc:DeclaredDep ; sc:packageName "class-variance-authority" .
pack:DepRadixTabs a sc:DeclaredDep ; sc:packageName "@radix-ui/react-tabs" .
pack:DepReactHookForm a sc:DeclaredDep ; sc:packageName "react-hook-form" .
pack:DepResolvers a sc:DeclaredDep ; sc:packageName "@hookform/resolvers" .
pack:DepZod a sc:DeclaredDep ; sc:packageName "zod" .

sc:DeclaredDep a rdfs:Class ;
    rdfs:label "Declared npm dependency" ;
    rdfs:comment """An npm dependency declared in pack.toml [consumer_contract];
        a ComponentPrimitive may only requireDep these.""" .

pack:Field a sc:ComponentPrimitive ;
    sc:name "Field" ;
    sc:toPath "components/ui/field.tsx" ;
    sc:requiresHelper "cn" ;
    sc:requiresDep "cn" .

pack:FieldLabel a sc:ComponentPrimitive ;
    sc:name "FieldLabel" ;
    sc:toPath "components/ui/field.tsx" ;
    sc:requiresHelper "cn" ;
    sc:requiresDep "cn" .

pack:FieldError a sc:ComponentPrimitive ;
    sc:name "FieldError" ;
    sc:toPath "components/ui/field.tsx" ;
    sc:requiresHelper "cn" ;
    sc:requiresDep "cn" .

pack:FieldDescription a sc:ComponentPrimitive ;
    sc:name "FieldDescription" ;
    sc:toPath "components/ui/field.tsx" ;
    sc:requiresHelper "cn" ;
    sc:requiresDep "cn" .

pack:FieldSet a sc:ComponentPrimitive ;
    sc:name "FieldSet" ;
    sc:toPath "components/ui/field.tsx" ;
    sc:requiresHelper "cn" ;
    sc:requiresDep "cn" .

pack:FieldGroup a sc:ComponentPrimitive ;
    sc:name "FieldGroup" ;
    sc:toPath "components/ui/field.tsx" ;
    sc:requiresHelper "cn" ;
    sc:requiresDep "cn" .

pack:FieldContent a sc:ComponentPrimitive ;
    sc:name "FieldContent" ;
    sc:toPath "components/ui/field.tsx" ;
    sc:requiresHelper "cn" ;
    sc:requiresDep "cn" .

pack:UseFormHookExample a sc:ComponentPrimitive ;
    sc:name "use-form-hook example" ;
    sc:toPath "docs/examples/use-form-hook.tsx" ;
    sc:requiresHelper "cn" ;
    sc:requiresDep "react-hook-form" , "@hookform/resolvers" , "zod" ;
    rdfs:comment "Consumer-side form example (docs/examples), not a components/ui primitive." .
