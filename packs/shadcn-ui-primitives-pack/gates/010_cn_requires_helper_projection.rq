# MESSAGE: any sc:ComponentPrimitive with sc:requiresHelper "cn" must have a matching
# sc:HelperProjection to "lib/utils.ts" in the pack graph; any returned row is refused.
# The cn helper is imported by every primitive template (`import { cn } from "@/lib/utils"`),
# so syncing without the helper projection produces broken imports. Fail-closed: the gate
# refuses whenever the helper projection is absent or renamed.
PREFIX sc: <urn:ggen-marketplace:shadcn-ui-primitives-pack:>
SELECT ?subject WHERE {
  ?subject a sc:ComponentPrimitive ;
           sc:requiresHelper "cn" .
  FILTER NOT EXISTS {
    ?projection a sc:HelperProjection ;
                sc:path "lib/utils.ts" .
  }
}
ORDER BY ?subject
