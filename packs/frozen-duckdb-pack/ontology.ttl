<urn:frozen-duckdb:evidence:makefile> a prov:Entity ;
    rdfs:label "Makefile — rendered header: GENERATED by ggen sync run (rule render-makefile-verify in ggen.toml); edit schema/verify.ttl / schema/verify-gates.rq, never this file; target-name law: claims verify/verify-* only (sync/gates belong to C10)" .

<urn:frozen-duckdb:evidence:milestone-dryrun> a prov:Entity ;
