<urn:frozen-duckdb:evidence:gitignore> a prov:Entity ;
    rdfs:label ".gitignore — secrets-law rows: '.ggen-v2/' and 'frozen-test-project/.ggen/' untracked (runtime ggen receipt state, commit 0019831)" .

<urn:frozen-duckdb:evidence:publish-runbook> a prov:Entity ;
