# frozen-duckdb-pack ontology — the frozen-duckdb domain laws as marketplace facts.
#
# 源 hierarchy: marketplace.toml -> packs/frozen-duckdb-pack/pack.toml -> THIS file
#   -> templates/ -> gates/. Generated files are consequences: edit this ontology
#   or the templates, never the projection.
#
# Vocabulary law: standard vocabularies only. Classes and predicates come
# exclusively from rdf:/rdfs:/dcterms:/skos:/prov:/xsd:. Laws are skos:Concept
# members of skos:Collections (the law collection and the config-form
# collection); their stable handles are skos:notation literals; evidence
# anchors are prov:Entity individuals carrying an rdfs:label that names a
# repo-relative path (with the owning symbol/lines); version correspondences
# are prov:Collection version-maps whose prov:hadMember are prov:Entity
# individuals carrying prov:value version strings. No private predicate or
# class namespace is introduced (see README.md "Vocabulary law").

@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# The law collection
# ---------------------------------------------------------------------------

<urn:frozen-duckdb:laws> a skos:Collection ;
    dcterms:title "frozen-duckdb domain laws" ;
    dcterms:description "The nine laws a consumer of prebuilt (frozen) DuckDB binaries must hold: version pinning (mirror + duckdb-rs encoding), release-asset naming, central-cache normalization, DOCS_RS no-link builds, and soname/rpath propagation -- plus the four ggen-composition laws the v1.5.5 wave-4/5 composition witnessed (consumer config schema, rendered-consequence ownership, single-writer fact files, receipt runtime state). Distilled from the frozen-duckdb repository (v1.5.5 wave, docs/sjira/v26.9.21) so future repos consume them instead of hand-rolling build.rs, fetch scripts, cache plumbing, ggen.toml config and receipt plumbing." ;
    skos:member <urn:frozen-duckdb:law:version-pinning> ,
                <urn:frozen-duckdb:law:release-asset-name> ,
                <urn:frozen-duckdb:law:cache-normalization> ,
                <urn:frozen-duckdb:law:docs-rs-no-link> ,
                <urn:frozen-duckdb:law:soname-rpath> ,
                <urn:frozen-duckdb:law:ggen-consumer-config> ,
                <urn:frozen-duckdb:law:rendered-consequence-ownership> ,
                <urn:frozen-duckdb:law:fact-file-per-concern> ,
                <urn:frozen-duckdb:law:receipt-runtime-state> .

# ---------------------------------------------------------------------------
# Law 1 — version pinning (mirror + duckdb-rs crate-version encoding)
# ---------------------------------------------------------------------------

<urn:frozen-duckdb:law:version-pinning> a skos:Concept ;
    skos:notation "version-pinning" ;
    dcterms:title "Consumer crate version mirrors the bundled upstream DuckDB engine release" ;
    dcterms:description "A frozen-duckdb consumer crate carries the same version as the upstream DuckDB engine it embeds: crate 1.5.5 ships DuckDB 1.5.5, so a consumer's crate pin names the engine era it will load at runtime. The upstream duckdb-rs crate encodes the engine release in its crate version as MAJOR.(MAJOR*10000+MINOR*100+PATCH).0 -- engine 1.5.5 becomes 1.10505.0. Derived pins (crates.io dependency pins, duckdb-rs source-build clone branches, standalone test workspaces) must be translated with this formula, never guessed or swept to a neighboring float." ;
    skos:example "frozen-duckdb 1.5.5 <-> DuckDB 1.5.5; duckdb = \"1.10505\" crates.io pin; duckdb-rs clone --branch v1.10505.0" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:workspace-cargo-toml> ,
                        <urn:frozen-duckdb:evidence:test-dependency-cargo-toml> ,
                        <urn:frozen-duckdb:evidence:handwritten-md> ,
                        <urn:frozen-duckdb:evidence:milestone-md> .

# Version correspondences: prov:Collection version-maps whose members are the
# crate-version and engine-version entities. Gates verify the encoding
# arithmetic over exactly this shape; the sys build.rs template renders the
# pinned engine version from it. Consumers assert their own version-map with
# the same shape.

<urn:frozen-duckdb:version:engine-1-5-5> a prov:Entity ;
    dcterms:title "DuckDB engine release" ;
    prov:value "1.5.5" .

<urn:frozen-duckdb:version:crate-1-10505-0> a prov:Entity ;
    dcterms:title "duckdb-rs crate version" ;
    prov:value "1.10505.0" .

<urn:frozen-duckdb:version-map:1-5-5> a prov:Entity , prov:Collection ;
    dcterms:title "duckdb-rs 1.10505.0 encodes DuckDB 1.5.5" ;
    prov:hadMember <urn:frozen-duckdb:version:crate-1-10505-0> ,
                   <urn:frozen-duckdb:version:engine-1-5-5> ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:test-dependency-cargo-toml> ,
                        <urn:frozen-duckdb:evidence:integration-guide> .

# ---------------------------------------------------------------------------
# Law 2 — release asset naming
# ---------------------------------------------------------------------------

<urn:frozen-duckdb:law:release-asset-name> a skos:Concept ;
    skos:notation "release-asset-name" ;
    dcterms:title "Release assets are libduckdb_{arch}.{dylib|so} matching the ensure_binary() download URLs" ;
    dcterms:description "A frozen DuckDB release asset is named libduckdb_{arch}.dylib on macOS and libduckdb_{arch}.so on Linux (Windows is a documented local-compile fallback), and the ensure_binary() downloader fetches exactly {base}/{tag}/libduckdb_{arch}.{ext} with the same platform extension used for the cached copy. The download URL asset and the cached binary name must carry the same extension on the host, or the download would write a file the linker cannot use. macOS assets are universal -- one dylib serving arm64 and x86_64 -- since DuckDB 1.5.x. Linux release assets may 404 until the release tag exists; the documented fallback is a pinned local compile (law: version-pinning supplies the branch)." ;
    skos:example "libduckdb_arm64.dylib; libduckdb_x86_64.so; https://github.com/seanchatmangpt/frozen-duckdb/releases/download/v1.5.5/libduckdb_arm64.dylib" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:builder-lib-rs> ,
                        <urn:frozen-duckdb:evidence:setup-env-sh> ,
                        <urn:frozen-duckdb:evidence:milestone-md> .

<urn:frozen-duckdb:asset-base-url> a prov:Entity ;
    dcterms:title "release download base URL" ;
    prov:value "https://github.com/seanchatmangpt/frozen-duckdb/releases/download" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:builder-lib-rs> .

# ---------------------------------------------------------------------------
# Law 3 — central cache normalization
# ---------------------------------------------------------------------------

<urn:frozen-duckdb:law:cache-normalization> a skos:Concept ;
    skos:notation "cache-normalization" ;
    dcterms:title "Every acquisition path normalizes ~/.frozen-duckdb/cache/v{version}-{arch}/" ;
    dcterms:description "Whichever acquisition path wins (cached hit, prebuilt copy, release download, pinned local compile), the resulting layout is identical: ~/.frozen-duckdb/cache/v{version}-{arch}/ containing the arch-suffixed binary libduckdb_{arch}.{dylib|so}, the pinned engine version's headers under duckdb/ (bindgen reads {cache}/duckdb/duckdb.h; release downloads carry only the dylib, so the headers ship vendored inside frozen-duckdb-builder), and a plain link name libduckdb.{dylib,so} created beside the arch-suffixed binary so -lduckdb resolves. Dead fallback names (e.g. libfrozen_mega_*) must not reappear; the link name carries the host platform extension." ;
    skos:example "~/.frozen-duckdb/cache/v1.5.5-arm64/{libduckdb_arm64.dylib, libduckdb.dylib, duckdb/duckdb.h}" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:builder-lib-rs> ,
                        <urn:frozen-duckdb:evidence:handwritten-md> .

<urn:frozen-duckdb:cache-root> a prov:Entity ;
    dcterms:title "central cache root" ;
    prov:value "~/.frozen-duckdb/cache" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:builder-lib-rs> .

# ---------------------------------------------------------------------------
# Law 4 — DOCS_RS no-link builds
# ---------------------------------------------------------------------------

<urn:frozen-duckdb:law:docs-rs-no-link> a skos:Concept ;
    skos:notation "docs-rs-no-link" ;
    dcterms:title "DOCS_RS=1 builds generate bindings from vendored headers and skip linking and rpath" ;
    dcterms:description "Docs builds run on Linux where no libduckdb .so asset may exist and no compiler toolchain is available. The build script therefore branches on the DOCS_RS environment variable: under DOCS_RS=1 it generates bindings from the vendored headers and skips library lookup, cargo:rustc-link-lib and rpath emission entirely -- rustdoc never links, so docs.rs typechecks without the dylib. The build script must declare rerun-if-env-changed=DOCS_RS so a DOCS_RS transition (appearing or disappearing) re-runs it." ;
    skos:example "if env::var(\"DOCS_RS\").is_ok() { docs_rs_main(); }" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:sys-build-rs> ,
                        <urn:frozen-duckdb:evidence:handwritten-md> .

<urn:frozen-duckdb:env:docs-rs> a prov:Entity ;
    dcterms:title "docs.rs no-link trigger environment variable" ;
    prov:value "DOCS_RS" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:sys-build-rs> .

# ---------------------------------------------------------------------------
# Law 5 — soname/rpath propagation
# ---------------------------------------------------------------------------

<urn:frozen-duckdb:law:soname-rpath> a skos:Concept ;
    skos:notation "soname-rpath" ;
    dcterms:title "DuckDB >= 1.5 dylibs carry the neutral install name @rpath/libduckdb.dylib; consumers embed the rpath" ;
    dcterms:description "DuckDB >= 1.5 dylibs carry the neutral install name @rpath/libduckdb.dylib -- there is no versioned soname -- so the plain link name is what matters at load time. Consumers must embed the runtime search path at link time (cargo:rustc-link-arg=-Wl,-rpath,{lib_dir}); a link-time -L does not survive to load time, and without the rpath the loader aborts with 'Library not loaded: @rpath/libduckdb.dylib'. The unscoped rustc-link-arg also covers the crate's own test harness. Compatibility symlinks libduckdb.dylib, libduckdb.1.dylib and libduckdb.1.4.dylib pointing at the arch dylib keep older loaders and tools working; on Linux the same law makes -lduckdb resolve against libduckdb.so." ;
    skos:example "@rpath/libduckdb.dylib; -Wl,-rpath,{lib_dir}; ln -sf libduckdb_arm64.dylib libduckdb.dylib" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:sys-build-rs> ,
                        <urn:frozen-duckdb:evidence:setup-env-sh> ,
                        <urn:frozen-duckdb:evidence:handwritten-md> .

# ---------------------------------------------------------------------------
# Law 6 — ggen consumer config (wave-4/5 composition law)
# ---------------------------------------------------------------------------

<urn:frozen-duckdb:law:ggen-consumer-config> a skos:Concept ;
    skos:notation "ggen-consumer-config" ;
    dcterms:title "On the declarative ggen schema, packs bind through [ontology].imports; [[ontology.pack]] does not exist and the two config schemas are exclusive" ;
    dcterms:description "A ggen 26.8.18 consumer on the declarative schema binds pack ontologies through [ontology].imports (absolute paths -- tilde is NOT expanded), never through [[ontology.pack]], which the schema refuses with [FM-CONFIG-003] unknown field 'pack' (OntologyConfig admits only source/imports/base_iri/prefixes/standard_only). The declarative and frontmatter config schemas are exclusive in one file: a [packs] table is refused as schema-ambiguous ([FM-CONFIG-101], a frontmatter marker), and rules = [] alongside [[generation.rules]] is a duplicate-key error ([FM-CONFIG-103]). Pack frontmatter templates (to:/sparql: contracts) are NOT parsed by declarative generation rules -- rules render template text as plain Tera with the rule query bound to results, and TemplateSource::Pack does not exist on this schema ('skipped: pack resolution is not implemented for the declarative-rules schema yet'). A declarative consumer therefore re-expresses wanted renderings as [[generation.rules]] whose queries select the pack's facts and whose templates bind rows via {% for r in results %} -- never the undocumented single-row-flattening form (bare {{ variable }}, the [FM-GEN-008] TEMPLATE_VARIABLE_MISSING trap)." ;
    skos:example "[ontology] imports = [\"/abs/path/packs/frozen-duckdb-pack/ontology.ttl\"]; [[generation.rules]] template binds {% for r in results %}" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:ggen-toml> ,
                        <urn:frozen-duckdb:evidence:ci-projection-md> ,
                        <urn:frozen-duckdb:evidence:handwritten-md> .

# The config forms themselves: one collection, each member a form with an
# operative/refused status. Gate 025 refuses a member without a status, an
# "operative" claim outside the lawful operative set, or a "refused" claim
# whose error code is not anchored to witnessed evidence.

<urn:frozen-duckdb:config-forms> a skos:Collection ;
    dcterms:title "ggen 26.8.18 consumer config forms" ;
    dcterms:description "The pack-binding and rule-surface forms a consumer ggen.toml can declare, with their witnessed status on the declarative schema (ggen 26.8.18, frozen-duckdb v1.5.5 wave). Exactly the two operative forms bind; the refused forms carry the error code that proves the refusal." ;
    skos:member <urn:frozen-duckdb:config:ontology-imports> ,
                <urn:frozen-duckdb:config:generation-rules> ,
                <urn:frozen-duckdb:config:ontology-pack> ,
                <urn:frozen-duckdb:config:packs-table> ,
                <urn:frozen-duckdb:config:pack-template-source> .

<urn:frozen-duckdb:config:ontology-imports> a skos:Concept ;
    skos:notation "[ontology].imports" ;
    dcterms:title "operative pack binding: graph-merge the pack ontology via imports" ;
    dcterms:description "The operative pack binding on the declarative schema: [ontology].imports unions the pack's ontology.ttl into the sync graph, closure-recorded and content-hashed into every receipt. Paths must be absolute -- tilde is not expanded." ;
    prov:value "operative" .

<urn:frozen-duckdb:config:generation-rules> a skos:Concept ;
    skos:notation "[[generation.rules]]" ;
    dcterms:title "operative render surface: declarative generation rules" ;
    dcterms:description "The operative render surface on the declarative schema: [[generation.rules]] with query + template + output_file + mode. Rule templates are plain Tera; the rule query result is bound as results and rows are iterated with {% for r in results %}. Overwrite mode makes the rule the owner of its output_file." ;
    prov:value "operative" .

<urn:frozen-duckdb:config:ontology-pack> a skos:Concept ;
    skos:notation "[[ontology.pack]]" ;
    dcterms:title "refused: no pack-declaration field exists under [ontology]" ;
    dcterms:description "Ticket/bootstrap-declared form; ggen 26.8.18 refuses it: [FM-CONFIG-003] unknown field 'pack', expected one of source/imports/base_iri/prefixes/standard_only. Empirically probed (CI_PROJECTION.md row 2, /tmp scratch, C2/C4/C5/C7/C8/C11)." ;
    prov:value "refused" ;
    dcterms:references <urn:frozen-duckdb:evidence:ci-projection-md> .

<urn:frozen-duckdb:config:packs-table> a skos:Concept ;
    skos:notation "[packs]" ;
    dcterms:title "refused on the declarative schema: schema-ambiguous frontmatter marker" ;
    dcterms:description "A [packs] table is refused with [FM-CONFIG-101] schema ambiguity (frontmatter:packs_table_shaped conflicts with declarative markers); it is inert as a pack loader on the declarative schema -- sync resolves [[packs]] only as a rule-local file-source registry and pack ontologies/gates/templates do not auto-bind." ;
    prov:value "refused" ;
    dcterms:references <urn:frozen-duckdb:evidence:ci-projection-md> .

<urn:frozen-duckdb:config:pack-template-source> a skos:Concept ;
    skos:notation "TemplateSource::Pack" ;
    dcterms:title "refused: no pack-sourced template variant exists on the declarative schema" ;
    dcterms:description "template = { pack = ... } is refused with [FM-CONFIG-003] 'data did not match any variant of untagged enum TemplateSource' (probed in all three shapes); pack .tmpl files carry frontmatter contracts that declarative rules render raw, so pack templates cannot be emitters here." ;
    prov:value "refused" ;
    dcterms:references <urn:frozen-duckdb:evidence:ci-projection-md> .

# ---------------------------------------------------------------------------
# Law 7 — rendered-consequence ownership
# ---------------------------------------------------------------------------

<urn:frozen-duckdb:law:rendered-consequence-ownership> a skos:Concept ;
    skos:notation "rendered-consequence-ownership" ;
    dcterms:title "A rendered file is owned by exactly one generation rule; hand-unioned blocks are clobbered by the next sync" ;
    dcterms:description "Every rendered file has exactly one owning rule (its output_file under Overwrite mode). Hand-unioning extra blocks into a rendered file loses them to the next successful sync -- the wave-4 dry run's Makefile was (a) clobbered by every sync because the hand-added C10 block was not in render-makefile-verify's rule and (b) truncated by a merge, leaving make genesis-check unrunnable. The lawful repair moves the block into the owning rule's template at the source (ggen.toml), re-renders, and re-verifies byte-identity of the pre-existing projection; a rendered-consequence fact must name its owning rule. Target-name discipline is part of ownership: rendered Makefile targets claim only their documented namespace (verify/verify-*), never a sibling rule's (sync/gates)." ;
    skos:example "Makefile: '# GENERATED by ggen sync run (rule render-makefile-verify in ggen.toml)' -- edit schema/verify.ttl / the rule, never the projection" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:makefile> ,
                        <urn:frozen-duckdb:evidence:milestone-dryrun> .

# ---------------------------------------------------------------------------
# Law 8 — single-writer fact files (domain.ttl multi-writer hazard)
# ---------------------------------------------------------------------------

<urn:frozen-duckdb:law:fact-file-per-concern> a skos:Concept ;
    skos:notation "fact-file-per-concern" ;
    dcterms:title "One source file, one writer, one concern: pack-owned fact files instead of a shared multi-writer ontology" ;
    dcterms:description "Turtle has no standard 3-way merge, so a shared ontology file written by multiple branches/writers is a standing clobber hazard: the wave-4 domain.ttl union dropped C4's fd:project fact block entirely (its comment header survived, the facts did not), the query behind dry-run-publish-shapes returned zero rows, and the render failed with TEMPLATE_VARIABLE_MISSING variable 'v'; a C2 merge resolution earlier clobbered the canonical union outright and had to be restored byte-identical. The remedy is structural: facts live in per-concern, single-writer files (consumer-owned schema/<concern>.ttl, or pack-owned ontology files bound through [ontology].imports) and are never hand-appended into another writer's file. Consumer facts stay in consumer fact files; pack facts stay in pack files; a concern bleeding into a foreign file is the violation the gates refuse." ;
    skos:example "schema/domain.ttl + schema/changelog.ttl + schema/verify.ttl + schema/reconciliation-vocab.ttl -- one concern per file, unioned by [ontology].imports, not by hand" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:handwritten-md> ,
                        <urn:frozen-duckdb:evidence:milestone-dryrun> ,
                        <urn:frozen-duckdb:evidence:ggen-toml> .

# ---------------------------------------------------------------------------
# Law 9 — receipt runtime state
# ---------------------------------------------------------------------------

<urn:frozen-duckdb:law:receipt-runtime-state> a skos:Concept ;
    skos:notation "receipt-runtime-state" ;
    dcterms:title "ggen receipt state (.ggen/, .ggen-v2/) is untracked runtime state, never committed; chains are BLAKE3-signed" ;
    dcterms:description "ggen's runtime receipt state -- .ggen/ (signing keys) and .ggen-v2/ (receipt.json + receipt-log.jsonl) -- is untracked runtime state under the secrets law: it is gitignored (frozen-duckdb .gitignore rows '.ggen-v2/' and 'frozen-test-project/.ggen/'), never committed, and regenerated by every sync. Receipts are evidence, not source: each record chains prev_chain_hash_hex -> chain_hash_hex and carries a signature, and 'ggen receipt verify' validates the chain (valid/signed/signature_valid). A repo's tracked tree therefore carries no receipt bytes; importing receipt files from another machine is a provenance break, not a shortcut." ;
    skos:example ".ggen-v2/receipt.json: prev_chain_hash_hex -> chain_hash_hex (BLAKE3), signed; ggen receipt verify -> valid: true" ;
    prov:wasDerivedFrom <urn:frozen-duckdb:evidence:gitignore> ,
                        <urn:frozen-duckdb:evidence:publish-runbook> ,
                        <urn:frozen-duckdb:evidence:receipt-json> .

