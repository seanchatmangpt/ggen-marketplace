<urn:frozen-duckdb:evidence:integration-guide> a prov:Entity ;
    rdfs:label "docs/guides/integration.md — upstream build output 'Compiling duckdb v1.10505.0' (duckdb-rs crate version encoding DuckDB 1.5.5)" .

<urn:frozen-duckdb:evidence:ggen-toml> a prov:Entity ;
    rdfs:label "ggen.toml — consumer config header note: [[ontology.pack]] does not exist on ggen 26.8.18's declarative schema (FM-CONFIG-003); [[ontology]].imports is the operative pack binding; [[packs]] documents registry intent only; 13 imports (absolute paths, one concern per file: schema/reconciliation-vocab.ttl, schema/changelog.ttl, schema/verify.ttl + pack ontologies)" .

<urn:frozen-duckdb:evidence:ci-projection-md> a prov:Entity ;
