// GENERATED by ggen from frozen-duckdb-pack (templates/sys_build_rs.tmpl).
// Edit admitted RDF/template source, not this projection.
//
// frozen-duckdb-sys build script implementing the frozen-duckdb domain laws:
//   - law docs-rs-no-link: under the docs.rs no-link trigger, generate
//     bindings from the vendored headers and skip library lookup, linking and
//     rpath emission (rustdoc never links).
//   - law cache-normalization: resolve the normalized central cache
//     v{version}-{arch} layout (binary + plain link name + duckdb/ headers).
//   - law soname-rpath: DuckDB >= 1.5 dylibs carry the neutral install name
//     @rpath/libduckdb.dylib, so embed the runtime search path here -- a
//     link-time -L does not survive to load time.
//   - law release-asset-name / version-pinning: asset and pin constants below
//     are projected from the pack ontology.

use std::env;
use std::path::PathBuf;

{% for row in constants %}const {{ row.title | replace(from="release download base URL", to="RELEASE_BASE_URL") | replace(from="central cache root", to="CACHE_ROOT") | replace(from="docs.rs no-link trigger environment variable", to="DOCS_RS_TRIGGER") }}: &str = "{{ row.value }}";
{% endfor %}
// Pinned engine release (law version-pinning: the consumer crate mirrors the
// bundled upstream DuckDB engine; duckdb-rs encodes it as
// MAJOR.(MAJOR*10000+MINOR*100+PATCH).0).
const DUCKDB_VERSION: &str = "{{ engine[0].engine }}";

fn main() {
    // Law docs-rs-no-link: docs builds typecheck without the dylib.
    if env::var(DOCS_RS_TRIGGER).is_ok() {
        docs_rs_main();
        return;
    }

    let arch = arch_name();
    let ext = library_extension();

    // Law cache-normalization: one normalized layout for every acquisition
    // path; plain link name beside the arch-suffixed binary.
    let lib_dir = expand_home(CACHE_ROOT)
        .join(format!("v{}-{}", DUCKDB_VERSION, arch));

    // Law release-asset-name: the download asset and the cached binary carry
    // the same platform extension.
    let asset_name = format!("libduckdb_{}.{}", arch, ext);
    let link_name = format!("libduckdb.{}", ext);
    let release_url = format!("{}/{}/{}", RELEASE_BASE_URL, format!("v{}", DUCKDB_VERSION), asset_name);

    println!("cargo:rustc-link-search=native={}", lib_dir.display());
    println!("cargo:rustc-link-lib=dylib=duckdb");

    // Law soname-rpath: DuckDB >= 1.5 dylibs carry the neutral install name
    // @rpath/libduckdb.dylib; embed the runtime search path here.
    println!("cargo:rustc-link-arg=-Wl,-rpath,{}", lib_dir.display());

    println!("cargo:rerun-if-env-changed={}", DOCS_RS_TRIGGER);
    println!("cargo:rerun-if-env-changed=FROZEN_DUCKDB_CACHE_DIR");
    println!("cargo:DUCKDB_LIB_DIR={}", lib_dir.display());
    println!("cargo:DUCKDB_INCLUDE_DIR={}", lib_dir.join("duckdb").display());

    // Constants are asserted so a drift between projected law facts and the
    // generated script is caught by any consumer test that prints them.
    let _ = (link_name, release_url);
}

fn arch_name() -> String {
    let arch = env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_default();
    match arch.as_str() {
        "x86_64" => "x86_64".to_string(),
        "aarch64" => "arm64".to_string(),
        other => other.to_string(),
    }
}

// The linker and the dynamic loader cannot resolve a leading tilde; expand it
// against HOME (the cache-root fact is documented in its portable form).
fn expand_home(p: &str) -> PathBuf {
    if let Some(rest) = p.strip_prefix("~/") {
        if let Ok(home) = env::var("HOME") {
            return PathBuf::from(home).join(rest);
        }
    }
    PathBuf::from(p)
}

fn library_extension() -> &'static str {
    let os = env::var("CARGO_CFG_TARGET_OS").unwrap_or_default();
    match os.as_str() {
        "macos" => "dylib",
        _ => "so",
    }
}

fn docs_rs_main() {
    // Law docs-rs-no-link: generate bindings from the vendored headers only.
    // No cargo:rustc-link-lib, no link-search, no rpath: rustdoc never links.
    let manifest_dir = env::var("CARGO_MANIFEST_DIR").unwrap_or_default();
    let vendored = PathBuf::from(manifest_dir).join("vendored-headers");
    println!("cargo:rerun-if-changed={}", vendored.display());
    println!("cargo:DUCKDB_INCLUDE_DIR={}", vendored.display());
}
