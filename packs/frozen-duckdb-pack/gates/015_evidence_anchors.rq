# MESSAGE: every prov:wasDerivedFrom anchor in the merged graph (pack
# ontology + consumer fixture) must resolve to a declared prov:Entity with an
# rdfs:label naming its repo-relative path. A row below = a dangling evidence
# anchor -- provenance that inspection cannot follow. An empty result = every
# law and consumer fact is traceable to a witnessed file.
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?subject ?anchor WHERE {
  ?subject prov:wasDerivedFrom ?anchor .
  FILTER NOT EXISTS {
    ?anchor a prov:Entity ;
            rdfs:label ?anchorLabel .
  }
}
ORDER BY ?subject ?anchor
