# MESSAGE: every law in the frozen-duckdb law collection must carry the
# properties its gates, templates and consumers read with no fallback --
# skos:notation (the stable law handle), dcterms:title and
# dcterms:description. A row below = a law missing a load-bearing property;
# an empty result = the law set is projection-complete.
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?law ?missing WHERE {
  <urn:frozen-duckdb:laws> skos:member ?law .
  { BIND(dcterms:title AS ?missing) }
  UNION
  { BIND(dcterms:description AS ?missing) }
  UNION
  { BIND(skos:notation AS ?missing) }
  FILTER NOT EXISTS { ?law ?missing ?anyValue }
}
ORDER BY ?law ?missing
