@prefix cnv: <https://clap-noun-verb.dev/ontology#> .

# Specimen fixture, folded from packs/clap-noun-verb-specimen-pack (retired,
# v26.9.30 consolidation wave, lane 6). Individuals are verbatim; this is an
# opt-in fixture exactly like the specimen pack was: the compiler packs never
# depend on this graph, and it is NOT part of ontology.ttl (law only), so
# framework composition cannot inject specimen command surface into a
# consumer CLI. Load this file deliberately; do not glob-merge it with
# consumer.ttl (both fixtures define a `system ping` surface by design).

cnv:SpecimenCli
    a cnv:Cli ;
    cnv:binaryName "cnv-specimen" ;
    cnv:crateName "cnv-specimen" ;
    cnv:version "0.1.0" ;
    cnv:edition "2024" ;
    cnv:rustVersion "1.85" ;
    cnv:about "Minimal zero-code clap-noun-verb specimen." ;
    cnv:hasNoun cnv:SpecimenSystemNoun .

cnv:SpecimenSystemNoun
    a cnv:Noun ;
    cnv:name "system" ;
    cnv:about "Inspect the optional specimen." ;
    cnv:hasCommand cnv:SpecimenPing .

cnv:SpecimenPing
    a cnv:Command ;
    cnv:name "ping" ;
    cnv:about "Return the specimen liveness value." ;
    cnv:belongsToNoun cnv:SpecimenSystemNoun ;
    cnv:hasBehavior cnv:SpecimenPingBehavior .

cnv:SpecimenPingBehavior
    a cnv:StaticJsonBehavior ;
    cnv:jsonValue "{\"status\":\"alive\",\"source\":\"clap-noun-verb-specimen-pack\"}" .
