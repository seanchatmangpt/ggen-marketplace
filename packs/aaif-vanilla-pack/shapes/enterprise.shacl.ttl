@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix aaif: <https://aaif.io/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

aaif:Fortune5DeploymentShape a sh:NodeShape ;
    sh:targetClass aaif:Fortune5Deployment ;
    sh:property [
        sh:path aaif:hasTier1Router ;
        sh:class aaif:Tier1IngressRouter ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Fortune 5 deployment must declare exactly one Tier-1 Edge Ingress Router." ;
    ] ;
    sh:property [
        sh:path aaif:hasTier2DataPlane ;
        sh:class aaif:Tier2AgentDataPlane ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Fortune 5 deployment must declare exactly one Tier-2 Internal Agent Data Plane." ;
    ] ;
    sh:property [
        sh:path aaif:hasWorkerSandbox ;
        sh:class aaif:SandboxedWorker ;
        sh:minCount 1 ;
        sh:message "Fortune 5 deployment must declare at least one Sandboxed Worker." ;
    ] .

aaif:Tier2AgentDataPlaneShape a sh:NodeShape ;
    sh:targetClass aaif:Tier2AgentDataPlane ;
    sh:property [
        sh:path aaif:maxLatencyBudgetMs ;
        sh:datatype xsd:integer ;
        sh:maxInclusive 15 ;
        sh:minCount 1 ;
        sh:message "Tier-2 Data Plane must enforce p99 latency budget <= 15ms." ;
    ] ;
    sh:property [
        sh:path aaif:hasInferencePool ;
        sh:class aaif:InferencePool ;
        sh:minCount 1 ;
        sh:message "Tier-2 Data Plane must bind to a GAIE InferencePool." ;
    ] .

aaif:SandboxedWorkerShape a sh:NodeShape ;
    sh:targetClass aaif:SandboxedWorker ;
    sh:property [
        sh:path aaif:readOnlyRootFilesystem ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "Sandboxed Worker must have readOnlyRootFilesystem enabled." ;
    ] ;
    sh:property [
        sh:path aaif:runAsNonRoot ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "Sandboxed Worker must runAsNonRoot." ;
    ] ;
    sh:property [
        sh:path aaif:dropAllCapabilities ;
        sh:hasValue true ;
        sh:minCount 1 ;
        sh:message "Sandboxed Worker must drop all Linux capabilities." ;
    ] .
