# goose_config.rq — consumed by templates/goose_config.yaml.tmpl (aaif-vanilla-pack)
#
# Single-row projection idiom (legacy renderer used first-row context).
# Projected columns (MUST equal template's {{ }} vars):
#   provider - aaif:provider of the aaif:GooseConfig (active provider key)
#   model    - aaif:model of the aaif:GooseConfig (model under the provider)
#
# All facts mandatory: a partial aaif:GooseConfig individual yields zero rows
# and the engine refuses — defaults never render.

PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?provider ?model
WHERE {
  ?s a aaif:GooseConfig ;
     aaif:provider ?provider_raw ;
     aaif:model ?model_raw .
  BIND(STR(?provider_raw) AS ?provider)
  BIND(STR(?model_raw) AS ?model)
}
ORDER BY ?s
LIMIT 1
