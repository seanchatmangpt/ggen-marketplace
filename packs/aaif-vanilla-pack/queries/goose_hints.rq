# goose_hints.rq — consumed by templates/goose_hints.tmpl (aaif-vanilla-pack)
#
# Single-row projection idiom (legacy renderer used first-row context).
# Projected columns (MUST equal template's {{ }} vars):
#   goosehints - aaif:goosehints of the aaif:GooseContext (project-hints body
#                rendered verbatim under the .goosehints banner)
#
# Mandatory: a missing aaif:GooseContext / aaif:goosehints triple yields zero
# rows and the engine refuses — defaults never render.

PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?goosehints
WHERE {
  ?s a aaif:GooseContext ;
     aaif:goosehints ?goosehints_raw .
  BIND(STR(?goosehints_raw) AS ?goosehints)
}
ORDER BY ?s
LIMIT 1
