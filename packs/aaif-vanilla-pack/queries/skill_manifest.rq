# skill_manifest.rq — consumed by templates/skill/SKILL.md.tmpl (aaif-vanilla-pack)
#
# Single-row projection idiom (legacy renderer used first-row context).
# Projected columns (MUST equal template's {{ }} vars):
#   skillManifestName          - aaif:skillManifestName of the aaif:SkillManifest
#   skillManifestDescription   - aaif:skillManifestDescription ("Use when ...")
#   skillManifestGate          - aaif:skillManifestGate
#   skillManifestCourts        - aaif:skillManifestCourts
#   skillManifestLegacyDefects - aaif:skillManifestLegacyDefects
#   skillManifestCutDate       - aaif:skillManifestCutDate
#
# All six fields are mandatory; a missing field yields zero rows and the
# engine refuses — defaults never render.

PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?skillManifestName ?skillManifestDescription ?skillManifestGate
       ?skillManifestCourts ?skillManifestLegacyDefects ?skillManifestCutDate
WHERE {
  ?s a aaif:SkillManifest ;
     aaif:skillManifestName ?skillManifestName ;
     aaif:skillManifestDescription ?skillManifestDescription ;
     aaif:skillManifestGate ?skillManifestGate ;
     aaif:skillManifestCourts ?skillManifestCourts ;
     aaif:skillManifestLegacyDefects ?skillManifestLegacyDefects ;
     aaif:skillManifestCutDate ?skillManifestCutDate .
}
ORDER BY ?s
LIMIT 1
