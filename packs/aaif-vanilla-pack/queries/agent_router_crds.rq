# agent_router_crds.rq — consumed by templates/agent_router_crds.yaml.tmpl (aaif-vanilla-pack)
#
# Single-row projection idiom (legacy renderer used first-row context).
# Projected columns (MUST equal template's {{ }} vars):
#   name             - aaif:name of the aaif:Router
#   primary_backend  - aaif:primaryBackend of the aaif:Router
#                      (Envoy AI Gateway AIServiceBackend name, primary tier)
#   fallback_backend - aaif:fallbackBackend of the aaif:Router
#                      (AIServiceBackend name, fallback tier)
#
# All facts mandatory: a partial aaif:Router individual yields zero rows and
# the engine refuses — defaults never render.

PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?name ?primary_backend ?fallback_backend
WHERE {
  ?s a aaif:Router ;
     aaif:name ?name_raw ;
     aaif:primaryBackend ?primary_backend_raw ;
     aaif:fallbackBackend ?fallback_backend_raw .
  BIND(STR(?name_raw) AS ?name)
  BIND(STR(?primary_backend_raw) AS ?primary_backend)
  BIND(STR(?fallback_backend_raw) AS ?fallback_backend)
}
ORDER BY ?s
LIMIT 1
