# open_response.rq — consumed by templates/open_responses/response.json.tmpl
#
# Single-row projection idiom. Projected columns (MUST equal template vars):
#   openResponseId            - aaif:openResponseId
#   openResponseCreatedAt     - aaif:openResponseCreatedAt (integer Unix seconds)
#   openResponseStatus        - aaif:openResponseStatus
#   openResponseModel         - aaif:openResponseModel
#   openResponseOutputType    - aaif:openResponseOutputType
#   openResponseOutputText    - aaif:openResponseOutputText
#   usageInputTokens          - aaif:usageInputTokens (integer)
#   usageOutputTokens         - aaif:usageOutputTokens (integer)
#   usageTotalTokens          - aaif:usageTotalTokens (integer)
#   responseExtensionNamespace - aaif:responseExtensionNamespace (namespaced extension key)
#   responseExtensionValue     - aaif:responseExtensionValue (raw JSON object)
#
# All fields mandatory; missing -> zero rows -> engine refuses.

PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?openResponseId ?openResponseCreatedAt ?openResponseStatus ?openResponseModel ?openResponseOutputType
       ?openResponseOutputText ?usageInputTokens ?usageOutputTokens ?usageTotalTokens
       ?responseExtensionNamespace ?responseExtensionValue
WHERE {
  ?s a aaif:OpenResponse ;
     aaif:openResponseId ?openResponseId ;
     aaif:openResponseCreatedAt ?openResponseCreatedAt ;
     aaif:openResponseStatus ?openResponseStatus ;
     aaif:openResponseModel ?openResponseModel ;
     aaif:openResponseOutputType ?openResponseOutputType ;
     aaif:openResponseOutputText ?openResponseOutputText ;
     aaif:usageInputTokens ?usageInputTokens ;
     aaif:usageOutputTokens ?usageOutputTokens ;
     aaif:usageTotalTokens ?usageTotalTokens ;
     aaif:responseExtensionNamespace ?responseExtensionNamespace ;
     aaif:responseExtensionValue ?responseExtensionValue .
}
ORDER BY ?s
LIMIT 1
