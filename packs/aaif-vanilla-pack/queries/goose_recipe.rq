# goose_recipe.rq — consumed by templates/goose_recipe.yaml.tmpl (aaif-vanilla-pack)
#
# Single-row projection idiom (legacy renderer used first-row context).
# Projected columns (MUST equal template's {{ }} vars):
#   title        - aaif:recipeTitle of the aaif:GooseRecipe
#   description  - aaif:recipeDescription of the aaif:GooseRecipe
#   instructions - aaif:recipeInstructions of the aaif:GooseRecipe (block scalar)
#   prompt       - aaif:recipePrompt of the aaif:GooseRecipe (block scalar)
#
# All facts mandatory: a partial aaif:GooseRecipe individual yields zero rows
# and the engine refuses — defaults never render.

PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?title ?description ?instructions ?prompt
WHERE {
  ?s a aaif:GooseRecipe ;
     aaif:recipeTitle ?title_raw ;
     aaif:recipeDescription ?description_raw ;
     aaif:recipeInstructions ?instructions_raw ;
     aaif:recipePrompt ?prompt_raw .
  BIND(STR(?title_raw) AS ?title)
  BIND(STR(?description_raw) AS ?description)
  BIND(STR(?instructions_raw) AS ?instructions)
  BIND(STR(?prompt_raw) AS ?prompt)
}
ORDER BY ?s
LIMIT 1
