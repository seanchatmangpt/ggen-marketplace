# openenv_manifest.rq — consumed by templates/openenv/manifest.json.tmpl
#
# Single-row projection idiom. Projected columns (MUST equal template vars):
#   openEnvId               - aaif:openEnvId
#   openEnvResetMethod      - aaif:openEnvResetMethod
#   openEnvStepMethod       - aaif:openEnvStepMethod
#   openEnvStateMethod      - aaif:openEnvStateMethod
#   openEnvCloseMethod      - aaif:openEnvCloseMethod
#   openEnvObservationSchema - aaif:openEnvObservationSchema (raw JSON object)
#   openEnvActionSchema     - aaif:openEnvActionSchema (raw JSON object)
#
# All fields mandatory; missing -> zero rows -> engine refuses.

PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?openEnvId ?openEnvResetMethod ?openEnvStepMethod ?openEnvStateMethod
       ?openEnvCloseMethod ?openEnvObservationSchema ?openEnvActionSchema
WHERE {
  ?s a aaif:OpenEnvManifest ;
     aaif:openEnvId ?openEnvId ;
     aaif:openEnvResetMethod ?openEnvResetMethod ;
     aaif:openEnvStepMethod ?openEnvStepMethod ;
     aaif:openEnvStateMethod ?openEnvStateMethod ;
     aaif:openEnvCloseMethod ?openEnvCloseMethod ;
     aaif:openEnvObservationSchema ?openEnvObservationSchema ;
     aaif:openEnvActionSchema ?openEnvActionSchema .
}
ORDER BY ?s
LIMIT 1
