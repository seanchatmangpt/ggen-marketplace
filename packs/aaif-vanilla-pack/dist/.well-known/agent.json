{
  "name": "ggen-marketplace Agent",
  "description": "Autonomous semantic manufacturing pack registry, discovery, qualification, and catalog indexing agent.",
  "url": "https://marketplace.ggen.dev",
  "version": "26.10.2",
  "supported_interfaces": [
    {
      "url": "https://marketplace.ggen.dev/a2a/v1",
      "protocol_binding": "HTTP+JSON",
      "protocol_version": "1.0"
    },
    {
      "url": "https://marketplace.ggen.dev/grpc",
      "protocol_binding": "GRPC",
      "protocol_version": "1.0"
    }
  ],
  "capabilities": {
    "streaming": true,
    "push_notifications": true,
    "extended_agent_card": true
  },
  "security_schemes": {
    "bearer_auth": {
      "http_auth_security_scheme": {
        "scheme": "Bearer",
        "bearer_format": "JWT",
        "description": "Enterprise JWT Bearer Token"
      }
    },
    "oauth2": {
      "oauth2_security_scheme": {
        "flows": {
          "client_credentials": {
            "token_url": "https://marketplace.ggen.dev/oauth/token",
            "scopes": {
              "agent:execute": "Permission to invoke agent tasks",
              "agent:read": "Permission to inspect task status"
            }
          }
        }
      }
    }
  },
  "default_input_modes": ["text/plain", "application/json"],
  "default_output_modes": ["text/plain", "application/json"],
  "skills": [
    {
      "id": "task_execution",
      "name": "Autonomous Task Execution",
      "description": "Handles enterprise workflows conforming to AAIF standards",
      "tags": ["automation", "orchestration", "enterprise"]
    }
  ]
}
