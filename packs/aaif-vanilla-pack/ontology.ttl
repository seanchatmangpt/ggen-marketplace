@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix aaif: <https://aaif.io/ontology#> .

aaif:Ontology a owl:Ontology ;
    rdfs:label "Agentic AI Foundation (AAIF) Vanilla Standards Ontology" ;
    rdfs:comment "Exhaustive formal representation of upstream AAIF open standards: A2A, MCP, Agentgateway, Agent Router, Goose, and AGENTS.md." .

# ==============================================================================
# 1. A2A PROTOCOL (a2aproject/A2A - specification/a2a.proto)
# ==============================================================================

aaif:A2AService a owl:Class ;
    rdfs:label "A2A Service" ;
    rdfs:comment "A2A Service interface providing RPC operations for agent interaction." .

aaif:AgentCard a owl:Class ;
    rdfs:label "A2A Agent Card" ;
    rdfs:comment "A self-describing manifest for an agent containing identity, capabilities, and skills." .

aaif:Task a owl:Class ;
    rdfs:label "A2A Task" ;
    rdfs:comment "The core unit of action for A2A with lifecycle status, history, and artifacts." .

aaif:TaskStatus a owl:Class ;
    rdfs:label "A2A Task Status" ;
    rdfs:comment "Container for the lifecycle state and message of a task." .

aaif:Message a owl:Class ;
    rdfs:label "A2A Message" ;
    rdfs:comment "One unit of communication between client and server." .

aaif:Part a owl:Class ;
    rdfs:label "A2A Message Part" ;
    rdfs:comment "Container for a section of communication content (text, raw bytes, url, or structured data)." .

aaif:Artifact a owl:Class ;
    rdfs:label "A2A Artifact" ;
    rdfs:comment "Represents task outputs containing one or more parts." .

# All 11 A2A RPC Methods
aaif:SendMessage a owl:Class ;
    rdfs:label "A2A SendMessage RPC" .

aaif:SendStreamingMessage a owl:Class ;
    rdfs:label "A2A SendStreamingMessage RPC" .

aaif:GetTask a owl:Class ;
    rdfs:label "A2A GetTask RPC" .

aaif:ListTasks a owl:Class ;
    rdfs:label "A2A ListTasks RPC" .

aaif:CancelTask a owl:Class ;
    rdfs:label "A2A CancelTask RPC" .

aaif:SubscribeToTask a owl:Class ;
    rdfs:label "A2A SubscribeToTask RPC" .

aaif:CreateTaskPushNotificationConfig a owl:Class ;
    rdfs:label "A2A CreateTaskPushNotificationConfig RPC" .

aaif:GetTaskPushNotificationConfig a owl:Class ;
    rdfs:label "A2A GetTaskPushNotificationConfig RPC" .

aaif:ListTaskPushNotificationConfigs a owl:Class ;
    rdfs:label "A2A ListTaskPushNotificationConfigs RPC" .

aaif:GetExtendedAgentCard a owl:Class ;
    rdfs:label "A2A GetExtendedAgentCard RPC" .

aaif:DeleteTaskPushNotificationConfig a owl:Class ;
    rdfs:label "A2A DeleteTaskPushNotificationConfig RPC" .

# A2A Task Lifecycle States
aaif:TaskStateSubmitting a owl:Class ; rdfs:label "TASK_STATE_SUBMITTED" .
aaif:TaskStateWorking a owl:Class ; rdfs:label "TASK_STATE_WORKING" .
aaif:TaskStateCompleted a owl:Class ; rdfs:label "TASK_STATE_COMPLETED" .
aaif:TaskStateFailed a owl:Class ; rdfs:label "TASK_STATE_FAILED" .
aaif:TaskStateCanceled a owl:Class ; rdfs:label "TASK_STATE_CANCELED" .
aaif:TaskStateInputRequired a owl:Class ; rdfs:label "TASK_STATE_INPUT_REQUIRED" .
aaif:TaskStateRejected a owl:Class ; rdfs:label "TASK_STATE_REJECTED" .
aaif:TaskStateAuthRequired a owl:Class ; rdfs:label "TASK_STATE_AUTH_REQUIRED" .

# A2A Security Schemes
aaif:SecurityScheme a owl:Class ; rdfs:label "A2A Security Scheme" .
aaif:APIKeySecurityScheme a owl:Class ; rdfs:subClassOf aaif:SecurityScheme .
aaif:HTTPAuthSecurityScheme a owl:Class ; rdfs:subClassOf aaif:SecurityScheme .
aaif:OAuth2SecurityScheme a owl:Class ; rdfs:subClassOf aaif:SecurityScheme .
aaif:OpenIdConnectSecurityScheme a owl:Class ; rdfs:subClassOf aaif:SecurityScheme .
aaif:MutualTlsSecurityScheme a owl:Class ; rdfs:subClassOf aaif:SecurityScheme .

# A2A Datatype and Object Properties
aaif:name a owl:DatatypeProperty ; rdfs:label "name" ; rdfs:range xsd:string .
aaif:description a owl:DatatypeProperty ; rdfs:label "description" ; rdfs:range xsd:string .
aaif:url a owl:DatatypeProperty ; rdfs:label "url" ; rdfs:range xsd:anyURI .
aaif:version a owl:DatatypeProperty ; rdfs:label "version" ; rdfs:range xsd:string .
aaif:contextId a owl:DatatypeProperty ; rdfs:label "contextId" ; rdfs:range xsd:string .
aaif:taskId a owl:DatatypeProperty ; rdfs:label "taskId" ; rdfs:range xsd:string .
aaif:role a owl:DatatypeProperty ; rdfs:label "role" ; rdfs:range xsd:string .
aaif:taskState a owl:DatatypeProperty ; rdfs:label "taskState" ; rdfs:range xsd:string .

# ==============================================================================
# 2. MODEL CONTEXT PROTOCOL (modelcontextprotocol/specification)
# ==============================================================================

aaif:Tool a owl:Class ; rdfs:label "MCP Tool" .
aaif:Resource a owl:Class ; rdfs:label "MCP Resource" .
aaif:Prompt a owl:Class ; rdfs:label "MCP Prompt" .
aaif:CallToolRequest a owl:Class ; rdfs:label "MCP CallToolRequest" .
aaif:CallToolResult a owl:Class ; rdfs:label "MCP CallToolResult" .
aaif:LoggingMessageNotification a owl:Class ; rdfs:label "MCP LoggingMessageNotification" .

# Transports & Notifications
aaif:StdioTransport a owl:Class ; rdfs:label "stdio Transport" .
aaif:StreamableHttpTransport a owl:Class ; rdfs:label "streamable_http Transport" .

aaif:ToolListChangedNotification a owl:Class ; rdfs:label "ToolListChangedNotification" .
aaif:PromptListChangedNotification a owl:Class ; rdfs:label "PromptListChangedNotification" .
aaif:ResourceUpdatedNotification a owl:Class ; rdfs:label "ResourceUpdatedNotification" .
aaif:ProgressNotification a owl:Class ; rdfs:label "ProgressNotification" .

aaif:uri a owl:DatatypeProperty ; rdfs:label "uri" ; rdfs:range xsd:anyURI .
aaif:mimeType a owl:DatatypeProperty ; rdfs:label "mimeType" ; rdfs:range xsd:string .
aaif:inputSchema a owl:DatatypeProperty ; rdfs:label "inputSchema" ; rdfs:range xsd:string .

# ==============================================================================
# 3. AGENTGATEWAY L7 PROXY (agentgateway/agentgateway)
# ==============================================================================

aaif:Gateway a owl:Class ; rdfs:label "Agentgateway Instance" .
aaif:AgentgatewayConfig a owl:Class ; rdfs:label "Agentgateway Root Configuration" .

# Policies & Routing Directives
aaif:A2aPolicy a owl:Class ; rdfs:label "A2aPolicy" .
aaif:McpAuthorization a owl:Class ; rdfs:label "McpAuthorization" .
aaif:LocalFrontendPolicies a owl:Class ; rdfs:label "LocalFrontendPolicies" .
aaif:GcpAuth a owl:Class ; rdfs:label "GcpAuth" .
aaif:AwsAuth a owl:Class ; rdfs:label "AwsAuth" .
aaif:AzureAuth a owl:Class ; rdfs:label "AzureAuth" .

aaif:config a owl:DatatypeProperty ; rdfs:domain aaif:Gateway ; rdfs:range xsd:string .
aaif:binds a owl:DatatypeProperty ; rdfs:domain aaif:Gateway ; rdfs:range xsd:string .
aaif:frontendPolicies a owl:DatatypeProperty ; rdfs:domain aaif:Gateway ; rdfs:range xsd:string .
aaif:policies a owl:DatatypeProperty ; rdfs:domain aaif:Gateway ; rdfs:range xsd:string .
aaif:routes a owl:DatatypeProperty ; rdfs:domain aaif:Gateway ; rdfs:range xsd:string .
aaif:llm a owl:DatatypeProperty ; rdfs:domain aaif:Gateway ; rdfs:range xsd:string .
aaif:mcp a owl:DatatypeProperty ; rdfs:domain aaif:Gateway ; rdfs:range xsd:string .
aaif:port a owl:DatatypeProperty ; rdfs:domain aaif:Gateway ; rdfs:range xsd:integer .
aaif:xdsAddress a owl:DatatypeProperty ; rdfs:domain aaif:Gateway ; rdfs:range xsd:string .
aaif:authIssuer a owl:DatatypeProperty ; rdfs:domain aaif:Gateway ; rdfs:range xsd:string .

# ==============================================================================
# 4. ENVOY AI GATEWAY / AGENT ROUTER (theagentrouter/agent-router)
# ==============================================================================

# Complete Set of 6 CRD Kinds
aaif:AIGatewayRoute a owl:Class ; rdfs:label "AIGatewayRoute" .
aaif:AIServiceBackend a owl:Class ; rdfs:label "AIServiceBackend" .
aaif:BackendSecurityPolicy a owl:Class ; rdfs:label "BackendSecurityPolicy" .
aaif:MCPRoute a owl:Class ; rdfs:label "MCPRoute" .
aaif:GatewayConfig a owl:Class ; rdfs:label "GatewayConfig" .
aaif:QuotaPolicy a owl:Class ; rdfs:label "QuotaPolicy" .

aaif:primaryBackend a owl:DatatypeProperty ; rdfs:range xsd:string .
aaif:fallbackBackend a owl:DatatypeProperty ; rdfs:range xsd:string .
aaif:backendProvider a owl:DatatypeProperty ; rdfs:range xsd:string .

# ==============================================================================
# 5. GOOSE OPEN RUNTIME ARCHITECTURE (aaif-goose/goose & goose-docs.ai)
# ==============================================================================

aaif:GooseConfig a owl:Class ; rdfs:label "Goose Configuration" .
aaif:GooseRecipe a owl:Class ; rdfs:label "Goose Recipe" .
aaif:GooseContext a owl:Class ; rdfs:label "Goose Context Engineering" .
aaif:GooseToolConfig a owl:Class ; rdfs:label "Goose Tool & Permission Configuration" .

# Recipe Core Schema Directives
aaif:recipeTitle a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .
aaif:recipeDescription a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .
aaif:recipeInstructions a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .
aaif:recipePrompt a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .
aaif:recipeParameters a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .
aaif:recipeActivities a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .
aaif:recipeExtensions a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .
aaif:recipeResponse a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .
aaif:recipeRetry a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .
aaif:recipeSettings a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .
aaif:recipeSubRecipes a owl:DatatypeProperty ; rdfs:domain aaif:GooseRecipe ; rdfs:range xsd:string .

# Context Engineering Directives (.goosehints, skills, subagents, hooks, plugins)
aaif:goosehints a owl:DatatypeProperty ; rdfs:domain aaif:GooseContext ; rdfs:range xsd:string .
aaif:skills a owl:DatatypeProperty ; rdfs:domain aaif:GooseContext ; rdfs:range xsd:string .
aaif:subagents a owl:DatatypeProperty ; rdfs:domain aaif:GooseContext ; rdfs:range xsd:string .
aaif:hooks a owl:DatatypeProperty ; rdfs:domain aaif:GooseContext ; rdfs:range xsd:string .
aaif:plugins a owl:DatatypeProperty ; rdfs:domain aaif:GooseContext ; rdfs:range xsd:string .
aaif:promptTemplates a owl:DatatypeProperty ; rdfs:domain aaif:GooseContext ; rdfs:range xsd:string .

# Tool & Permission Directives
aaif:permissionModes a owl:DatatypeProperty ; rdfs:domain aaif:GooseToolConfig ; rdfs:range xsd:string .
aaif:toolPermissions a owl:DatatypeProperty ; rdfs:domain aaif:GooseToolConfig ; rdfs:range xsd:string .
aaif:codeMode a owl:DatatypeProperty ; rdfs:domain aaif:GooseToolConfig ; rdfs:range xsd:string .
aaif:toolShim a owl:DatatypeProperty ; rdfs:domain aaif:GooseToolConfig ; rdfs:range xsd:string .
aaif:allowlist a owl:DatatypeProperty ; rdfs:domain aaif:GooseToolConfig ; rdfs:range xsd:string .

# Global Goose Settings
aaif:provider a owl:DatatypeProperty ; rdfs:domain aaif:GooseConfig ; rdfs:range xsd:string .
aaif:model a owl:DatatypeProperty ; rdfs:domain aaif:GooseConfig ; rdfs:range xsd:string .
aaif:temperature a owl:DatatypeProperty ; rdfs:domain aaif:GooseConfig ; rdfs:range xsd:float .
aaif:maxTokens a owl:DatatypeProperty ; rdfs:domain aaif:GooseConfig ; rdfs:range xsd:integer .
aaif:maxTurns a owl:DatatypeProperty ; rdfs:domain aaif:GooseConfig ; rdfs:range xsd:integer .
aaif:searchPaths a owl:DatatypeProperty ; rdfs:domain aaif:GooseConfig ; rdfs:range xsd:string .

# Supported Upstream Goose Provider Backends
aaif:GooseProviderOpenAI a owl:Class ; rdfs:subClassOf aaif:GooseConfig .
aaif:GooseProviderAnthropic a owl:Class ; rdfs:subClassOf aaif:GooseConfig .
aaif:GooseProviderGoogle a owl:Class ; rdfs:subClassOf aaif:GooseConfig .
aaif:GooseProviderOllama a owl:Class ; rdfs:subClassOf aaif:GooseConfig .
aaif:GooseProviderBedrock a owl:Class ; rdfs:subClassOf aaif:GooseConfig .

# ==============================================================================
# 6. AGENTS.MD REPOSITORY GUIDELINES (agentsmd/agents.md)
# ==============================================================================

aaif:AgentsMd a owl:Class ; rdfs:label "AGENTS.md Specification" .
aaif:devEnvironment a owl:DatatypeProperty ; rdfs:domain aaif:AgentsMd ; rdfs:range xsd:string .
aaif:testing a owl:DatatypeProperty ; rdfs:domain aaif:AgentsMd ; rdfs:range xsd:string .
aaif:codingConventions a owl:DatatypeProperty ; rdfs:domain aaif:AgentsMd ; rdfs:range xsd:string .
aaif:commands a owl:DatatypeProperty ; rdfs:domain aaif:AgentsMd ; rdfs:range xsd:string .
aaif:boundaries a owl:DatatypeProperty ; rdfs:domain aaif:AgentsMd ; rdfs:range xsd:string .

# ==============================================================================
# 7. AAIF SWARM MESH & MULTI-AGENT COORDINATION
# ==============================================================================

aaif:Swarm a owl:Class ; rdfs:label "Coordinated Agentic AI Foundation Swarm" .
aaif:hasMemberAgent a owl:ObjectProperty ; rdfs:domain aaif:Swarm ; rdfs:range aaif:Agent .
aaif:swarmCoordinator a owl:ObjectProperty ; rdfs:domain aaif:Swarm ; rdfs:range aaif:Agent .
aaif:delegatesTo a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:Agent .
aaif:requiresMcpServer a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:Tool .
aaif:routedViaGateway a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:Gateway .
aaif:routedViaRouter a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:Router .
aaif:swarmRole a owl:DatatypeProperty ; rdfs:domain aaif:Agent ; rdfs:range xsd:string .

# ==============================================================================
# 8. AGENT SKILLS & CAPABILITY EXPOSURE
# ==============================================================================

aaif:Skill a owl:Class ; rdfs:label "A2A Agent Skill" .
aaif:hasSkill a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:Skill .
aaif:skillId a owl:DatatypeProperty ; rdfs:domain aaif:Skill ; rdfs:range xsd:string .
aaif:skillName a owl:DatatypeProperty ; rdfs:domain aaif:Skill ; rdfs:range xsd:string .
aaif:skillDescription a owl:DatatypeProperty ; rdfs:domain aaif:Skill ; rdfs:range xsd:string .
aaif:skillTag a owl:DatatypeProperty ; rdfs:domain aaif:Skill ; rdfs:range xsd:string .
aaif:skillAttestationDigest a owl:DatatypeProperty ; rdfs:domain aaif:Skill ; rdfs:range xsd:string .

# ==============================================================================
# 9. INHERENT PROTOCOL SECURITY & DEFENSE-IN-DEPTH
# Grounded in ~/ash_a2a, arXiv:2610.00392 (ELA-ITL), arXiv:2609.33914, arXiv:2609.10871
# ==============================================================================

aaif:SecurityScheme a owl:Class ; rdfs:label "Authentication & Authorization Scheme" .
aaif:BearerAuthScheme a owl:Class ; rdfs:subClassOf aaif:SecurityScheme ; rdfs:label "HTTP Bearer Scheme" .
aaif:OAuth2Scheme a owl:Class ; rdfs:subClassOf aaif:SecurityScheme ; rdfs:label "OAuth2 Scheme" .
aaif:MTLSScheme a owl:Class ; rdfs:subClassOf aaif:SecurityScheme ; rdfs:label "Mutual TLS Scheme" .

aaif:hasSecurityScheme a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:SecurityScheme .
aaif:schemeName a owl:DatatypeProperty ; rdfs:domain aaif:SecurityScheme ; rdfs:range xsd:string .
aaif:authType a owl:DatatypeProperty ; rdfs:domain aaif:SecurityScheme ; rdfs:range xsd:string .

# Task Ownership & Context Scoping (mitigates A2ABreak Cross-Client Context Injection)
aaif:OwnerScoping a owl:Class ; rdfs:label "Task & Context Owner Scoping Contract" .
aaif:ownerPrincipalKey a owl:DatatypeProperty ; rdfs:range xsd:string .
aaif:enforcesOwnerScoping a owl:DatatypeProperty ; rdfs:domain aaif:Agent ; rdfs:range xsd:boolean .
aaif:enforcesContextIsolation a owl:DatatypeProperty ; rdfs:domain aaif:Agent ; rdfs:range xsd:boolean .

# Credential Hygiene & Stripping (mitigates credential leaks on SSE / wire)
aaif:CredentialStripping a owl:Class ; rdfs:label "Wire Credential Stripping Invariant" .
aaif:stripsInternalKeys a owl:DatatypeProperty ; rdfs:domain aaif:Agent ; rdfs:range xsd:boolean .

# Envelope-Layer Defense (ELA-ITL isomorphic model: arXiv:2610.00392)
aaif:EnvelopeDefensePolicy a owl:Class ; rdfs:label "Three-Layer Isomorphic Envelope Defense" .
aaif:hasEnvelopeDefense a owl:ObjectProperty ; rdfs:domain aaif:Gateway ; rdfs:range aaif:EnvelopeDefensePolicy .
aaif:untrustedInputTagging a owl:DatatypeProperty ; rdfs:domain aaif:EnvelopeDefensePolicy ; rdfs:range xsd:boolean .
aaif:promptInjectionInterception a owl:DatatypeProperty ; rdfs:domain aaif:EnvelopeDefensePolicy ; rdfs:range xsd:boolean .
aaif:egressCredentialSanitization a owl:DatatypeProperty ; rdfs:domain aaif:EnvelopeDefensePolicy ; rdfs:range xsd:boolean .

# Cryptographic Attestation & Merkle Case Evidence (arXiv:2609.33914)
aaif:MerkleCaseEvidence a owl:Class ; rdfs:label "Merkle-Linked Case Evidence Commitment" .
aaif:caseMerkleRoot a owl:DatatypeProperty ; rdfs:range xsd:string .
aaif:jwsCardSigning a owl:DatatypeProperty ; rdfs:domain aaif:Agent ; rdfs:range xsd:boolean .

# ==============================================================================
# 10. AGENT PASSPORT SYSTEM (APS - AAIF Proposal Issue #14)
# Cryptographic identity, scoped delegation, and signed accountability receipts
# ==============================================================================

aaif:AgentPassport a owl:Class ; rdfs:label "Ed25519-Anchored Agent Passport" .
aaif:hasPassport a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:AgentPassport .
aaif:passportId a owl:DatatypeProperty ; rdfs:domain aaif:AgentPassport ; rdfs:range xsd:string .
aaif:ed25519PublicKey a owl:DatatypeProperty ; rdfs:domain aaif:AgentPassport ; rdfs:range xsd:string .
aaif:passportGrade a owl:DatatypeProperty ; rdfs:domain aaif:AgentPassport ; rdfs:range xsd:string .

aaif:DelegationChain a owl:Class ; rdfs:label "Scoped Authority Delegation Chain" .
aaif:hasDelegationChain a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:DelegationChain .
aaif:parentPrincipal a owl:DatatypeProperty ; rdfs:domain aaif:DelegationChain ; rdfs:range xsd:string .
aaif:delegatedPrincipal a owl:DatatypeProperty ; rdfs:domain aaif:DelegationChain ; rdfs:range xsd:string .
aaif:monotonicNarrowingEnforced a owl:DatatypeProperty ; rdfs:domain aaif:DelegationChain ; rdfs:range xsd:boolean .
aaif:signedAccountabilityReceipt a owl:DatatypeProperty ; rdfs:domain aaif:DelegationChain ; rdfs:range xsd:string .

# ==============================================================================
# 11. TRACE SPECIFICATION (AAIF Proposal Issue #42)
# Verifiable runtime attestation, compliance evidence, and tamper-evident audit
# ==============================================================================

aaif:TraceAttestation a owl:Class ; rdfs:label "TRACE Compliance Attestation" .
aaif:hasTraceAttestation a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:TraceAttestation .
aaif:traceId a owl:DatatypeProperty ; rdfs:domain aaif:TraceAttestation ; rdfs:range xsd:string .
aaif:complianceEvidenceHash a owl:DatatypeProperty ; rdfs:domain aaif:TraceAttestation ; rdfs:range xsd:string .
aaif:provableExecutionWitness a owl:DatatypeProperty ; rdfs:domain aaif:TraceAttestation ; rdfs:range xsd:string .
aaif:verifiableLogAuditChain a owl:DatatypeProperty ; rdfs:domain aaif:TraceAttestation ; rdfs:range xsd:boolean .

# ==============================================================================
# 12. BIDIRECTIONAL (BiDi) STREAMING & MID-FLIGHT STEERING (A2A v1.1 #1995)
# Full-duplex streaming channels and continuous in-flight task control
# ==============================================================================

aaif:BiDiStreamingChannel a owl:Class ; rdfs:label "BiDi Streaming Channel" .
aaif:hasStreamingChannel a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:BiDiStreamingChannel .
aaif:streamTransport a owl:DatatypeProperty ; rdfs:domain aaif:BiDiStreamingChannel ; rdfs:range xsd:string .
aaif:supportsMidFlightSteering a owl:DatatypeProperty ; rdfs:domain aaif:BiDiStreamingChannel ; rdfs:range xsd:boolean .
aaif:realTimeArtifactStreaming a owl:DatatypeProperty ; rdfs:domain aaif:BiDiStreamingChannel ; rdfs:range xsd:boolean .

# ==============================================================================
# 13. PROGRESSIVE TOOL DISCOVERY (MCP SEP-2549 / MCP Roadmap 2026-08)
# Dynamic catalog narrowing preventing context exhaustion
# ==============================================================================

aaif:ProgressiveDiscovery a owl:Class ; rdfs:label "MCP Progressive Tool Discovery" .
aaif:hasProgressiveDiscovery a owl:ObjectProperty ; rdfs:domain aaif:Tool ; rdfs:range aaif:ProgressiveDiscovery .
aaif:rootCatalogOnly a owl:DatatypeProperty ; rdfs:domain aaif:ProgressiveDiscovery ; rdfs:range xsd:boolean .
aaif:narrowingScope a owl:DatatypeProperty ; rdfs:domain aaif:ProgressiveDiscovery ; rdfs:range xsd:string .

# ==============================================================================
# 14. MULTI-ROUND ELICITATION & NEGOTIATION (A2A #2149, #2143)
# Structured human-in-the-loop and multi-round negotiation interaction models
# ==============================================================================

aaif:ElicitationContract a owl:Class ; rdfs:label "A2A Structured Elicitation Contract" .
aaif:hasElicitation a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:ElicitationContract .
aaif:negotiationRoundMax a owl:DatatypeProperty ; rdfs:domain aaif:ElicitationContract ; rdfs:range xsd:integer .
aaif:formSchemaIri a owl:DatatypeProperty ; rdfs:domain aaif:ElicitationContract ; rdfs:range xsd:anyURI .

# ==============================================================================
# 15. ASH_A2A HIGH-ASSURANCE BEAM/WASM EXECUTION RUNTIME
# Grounded in ~/ash_a2a: unforgeable auth, card signing, affidavit WASM
# ==============================================================================

aaif:AshA2AExecutionRuntime a owl:Class ; rdfs:label "AshA2A High-Assurance BEAM Runtime" .
aaif:hasAshA2ABackend a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:AshA2AExecutionRuntime .
aaif:ashA2AVersion a owl:DatatypeProperty ; rdfs:domain aaif:AshA2AExecutionRuntime ; rdfs:range xsd:string .
aaif:beamNodeName a owl:DatatypeProperty ; rdfs:domain aaif:AshA2AExecutionRuntime ; rdfs:range xsd:string .
aaif:wasmAffidavitEngineEnabled a owl:DatatypeProperty ; rdfs:domain aaif:AshA2AExecutionRuntime ; rdfs:range xsd:boolean .
aaif:unforgeablePrincipalAuth a owl:DatatypeProperty ; rdfs:domain aaif:AshA2AExecutionRuntime ; rdfs:range xsd:boolean .

# ==============================================================================
# 16. AUTOFDE-LAB FORMAL DECISION PLANNING ENGINE
# Grounded in scikit-decide: solver matching, bounded rollouts, Bellman gates
# ==============================================================================

aaif:AutofdeDecisionEngine a owl:Class ; rdfs:label "autofde-lab Decision Planning Engine" .
aaif:hasAutofdeEngine a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:AutofdeDecisionEngine .
aaif:decisionSolverType a owl:DatatypeProperty ; rdfs:domain aaif:AutofdeDecisionEngine ; rdfs:range xsd:string .
aaif:boundedRolloutDepth a owl:DatatypeProperty ; rdfs:domain aaif:AutofdeDecisionEngine ; rdfs:range xsd:integer .
aaif:bellmanOptimalityGated a owl:DatatypeProperty ; rdfs:domain aaif:AutofdeDecisionEngine ; rdfs:range xsd:boolean .
aaif:ocel2AuditTrailEmitted a owl:DatatypeProperty ; rdfs:domain aaif:AutofdeDecisionEngine ; rdfs:range xsd:boolean .

# ==============================================================================
# 17. FORTUNE 5 ZERO-TRUST WORKLOAD IDENTITY & AUTHZEN PDP
# Grounded in ~/ash_a2a SPIFFE.PDPBinding & AuthZEN.DecisionGate
# ==============================================================================

aaif:SPIFFEWorkloadIdentity a owl:Class ; rdfs:label "SPIFFE Workload SVID Identity" .
aaif:hasSpiffeIdentity a owl:ObjectProperty ; rdfs:domain aaif:Agent ; rdfs:range aaif:SPIFFEWorkloadIdentity .
aaif:spiffeId a owl:DatatypeProperty ; rdfs:domain aaif:SPIFFEWorkloadIdentity ; rdfs:range xsd:string .
aaif:trustDomain a owl:DatatypeProperty ; rdfs:domain aaif:SPIFFEWorkloadIdentity ; rdfs:range xsd:string .
