PREFIX aaif: <https://aaif.io/ontology#>

# FAIL-CLOSED GATE: An enterprise AAIF Agent MUST declare an Inline DLP policy
# that redacts PII and PHI and specifies a data residency region lock.
SELECT ?agent ?dlp WHERE {
    ?agent a aaif:Agent ;
           aaif:hasPassport ?passport .

    OPTIONAL {
        ?agent aaif:hasDLPPolicy ?dlp .
        ?dlp aaif:redactsPII true ;
             aaif:redactsPHI true ;
             aaif:residencyRegionLock ?region .
    }

    FILTER (!BOUND(?dlp) || !BOUND(?region))
}
