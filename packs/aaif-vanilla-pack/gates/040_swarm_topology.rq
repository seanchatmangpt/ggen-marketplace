# MESSAGE: every aaif:Swarm must have at least one coordinator and one member agent.
# Any row returned indicates an invalid or disjoint swarm topology.
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?swarm ?missing WHERE {
  {
    ?swarm a aaif:Swarm .
    BIND(aaif:swarmCoordinator AS ?missing)
    FILTER NOT EXISTS { ?swarm aaif:swarmCoordinator ?any }
  } UNION {
    ?swarm a aaif:Swarm .
    BIND(aaif:hasMemberAgent AS ?missing)
    FILTER NOT EXISTS { ?swarm aaif:hasMemberAgent ?any }
  }
}
ORDER BY ?swarm ?missing
