PREFIX aaif: <https://aaif.io/ontology#>

# FAIL-CLOSED GATE: If an agent declares TRACE attestation, it MUST include a compliance evidence hash,
# a provable execution witness, and verifiable log audit chain = true.
SELECT ?agent ?trace WHERE {
    ?agent a aaif:Agent ;
           aaif:hasTraceAttestation ?trace .

    OPTIONAL {
        ?trace aaif:complianceEvidenceHash ?hash ;
               aaif:provableExecutionWitness ?witness ;
               aaif:verifiableLogAuditChain true .
    }

    FILTER (!BOUND(?hash) || !BOUND(?witness))

}
ORDER BY ?agent
