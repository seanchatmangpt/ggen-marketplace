PREFIX aaif: <https://aaif.io/ontology#>

# Fail-closed gate: Any enterprise agent with a CMEK encryption policy MUST specify:
# 1. A valid Cloud KMS / HSM key URI
# 2. A FIPS 140 compliance level >= 2
SELECT ?agent ?policy WHERE {
  ?agent a aaif:Agent ;
         aaif:hasCMEKPolicy ?policy .
  FILTER NOT EXISTS {
    ?policy aaif:kmsKeyUri ?uri ;
            aaif:fips140Level ?level .
    FILTER (?level >= 2)
  }

}
ORDER BY ?agent
