PREFIX aaif: <https://aaif.io/ontology#>

# FAIL-CLOSED GATE: If an agent has a delegation chain, it MUST have an AgentPassport with an Ed25519 key
# and explicitly enforce monotonic authority narrowing.
SELECT ?agent ?passport WHERE {
    ?agent a aaif:Agent ;
           aaif:hasDelegationChain ?chain .
    
    OPTIONAL {
        ?agent aaif:hasPassport ?passport .
        ?passport aaif:ed25519PublicKey ?key .
        ?chain aaif:monotonicNarrowingEnforced true .
    }

    FILTER (!BOUND(?passport) || !BOUND(?key))

}
ORDER BY ?agent
