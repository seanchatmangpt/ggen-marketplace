PREFIX aaif: <https://aaif.io/ontology#>

# FAIL-CLOSED GATE: If an agent declares a BiDi streaming channel, it MUST declare a stream transport
# and explicitly support mid-flight steering.
SELECT ?agent ?channel WHERE {
    ?agent a aaif:Agent ;
           aaif:hasStreamingChannel ?channel .

    OPTIONAL {
        ?channel aaif:streamTransport ?transport ;
                 aaif:supportsMidFlightSteering true .
    }

    FILTER (!BOUND(?transport))

}
ORDER BY ?agent
