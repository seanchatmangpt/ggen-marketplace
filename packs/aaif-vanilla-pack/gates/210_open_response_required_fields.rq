# MESSAGE: every aaif:OpenResponse must carry id, model, output block,
# status, and usage token accounting, and created_at MUST be an integer
# Unix timestamp in seconds (xsd:integer) -- an ISO-8601 string or a
# missing created_at is a D1 conformance violation, not admissible.
# A response object without usage accounting is not admissible on the wire.
PREFIX aaif: <https://aaif.io/ontology#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?response WHERE {
  ?response a aaif:OpenResponse .
  FILTER NOT EXISTS {
    ?response aaif:openResponseId ?id ;
              aaif:openResponseModel ?m ;
              aaif:openResponseCreatedAt ?ts ;
              aaif:openResponseOutputType ?ot ;
              aaif:openResponseOutputText ?tx ;
              aaif:openResponseStatus ?st ;
              aaif:usageInputTokens ?in ;
              aaif:usageOutputTokens ?out ;
              aaif:usageTotalTokens ?tot .
    FILTER(datatype(?ts) = xsd:integer)
  }
}
ORDER BY ?response
