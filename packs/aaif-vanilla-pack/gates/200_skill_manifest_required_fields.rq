# MESSAGE: every aaif:SkillManifest must carry name, "Use when..." description,
# mechanical gate, courts, and cut date. A SKILL.md without a trigger
# description or gate is prose, not a contract.
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?manifest WHERE {
  ?manifest a aaif:SkillManifest .
  FILTER NOT EXISTS {
    ?manifest aaif:skillManifestName ?n ;
              aaif:skillManifestDescription ?d ;
              aaif:skillManifestGate ?g ;
              aaif:skillManifestCourts ?c ;
              aaif:skillManifestCutDate ?cd .
  }
}
ORDER BY ?manifest
