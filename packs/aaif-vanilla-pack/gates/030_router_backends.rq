# MESSAGE: every aaif:Router must specify primaryBackend.
# Any row returned indicates a router lacking primary upstream routing target.
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?router ?missing WHERE {
  ?router a aaif:Router .
  BIND(aaif:primaryBackend AS ?missing)
  FILTER NOT EXISTS { ?router ?missing ?any }
}
ORDER BY ?router
