# MESSAGE: every aaif:Gateway must configure an envelope defense policy (arXiv:2610.00392).
# Gateways without envelope defense fail closed against indirect prompt injection (A2A-TIBA).
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?gateway WHERE {
  ?gateway a aaif:Gateway .
  FILTER NOT EXISTS {
    ?gateway aaif:hasEnvelopeDefense ?policy .
    ?policy aaif:untrustedInputTagging true .
  }
}
ORDER BY ?gateway
