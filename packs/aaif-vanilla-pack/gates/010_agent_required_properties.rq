# MESSAGE: every aaif:Agent must have a non-empty name, description, url, and version.
# Any row returned indicates an invalid agent specification failing closed.
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?agent ?missing WHERE {
  {
    ?agent a aaif:Agent .
    BIND(aaif:name AS ?missing)
  } UNION {
    ?agent a aaif:Agent .
    BIND(aaif:description AS ?missing)
  } UNION {
    ?agent a aaif:Agent .
    BIND(aaif:url AS ?missing)
  } UNION {
    ?agent a aaif:Agent .
    BIND(aaif:version AS ?missing)
  }
  FILTER NOT EXISTS { ?agent ?missing ?any }
}
ORDER BY ?agent ?missing
