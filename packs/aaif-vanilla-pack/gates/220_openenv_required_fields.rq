# MESSAGE: every aaif:OpenEnvManifest must declare the full reset/step/
# state/close 4-method contract plus observation and action schemas. An
# environment missing any method is not a lawful OpenEnv surface.
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?env WHERE {
  ?env a aaif:OpenEnvManifest .
  FILTER NOT EXISTS {
    ?env aaif:openEnvId ?id ;
         aaif:openEnvResetMethod ?r ;
         aaif:openEnvStepMethod ?s ;
         aaif:openEnvStateMethod ?st ;
         aaif:openEnvCloseMethod ?cl ;
         aaif:openEnvObservationSchema ?obs ;
         aaif:openEnvActionSchema ?act .
  }
}
ORDER BY ?env
