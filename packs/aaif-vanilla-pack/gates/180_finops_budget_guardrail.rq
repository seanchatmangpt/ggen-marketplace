PREFIX aaif: <https://aaif.io/ontology#>

# Fail-closed gate: Any enterprise agent with a FinOps budget guardrail MUST specify:
# 1. An organizational cost-center tag
# 2. A hard budget ceiling in USD
# 3. An active circuit breaker flag (circuitBreaksOnLimit true)
SELECT ?agent ?guardrail WHERE {
  ?agent a aaif:Agent ;
         aaif:hasFinOpsGuardrail ?guardrail .
  FILTER NOT EXISTS {
    ?guardrail aaif:costCenterTag ?tag ;
               aaif:hardBudgetCeilingUsd ?ceiling ;
               aaif:circuitBreaksOnLimit true .
  }
}
