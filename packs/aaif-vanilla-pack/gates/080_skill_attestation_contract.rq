# MESSAGE: every aaif:Skill must carry an attestation digest or tag contract.
# Unattested skills permit rogue agent capability claims (arXiv:2609.10871 §4.4.5).
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?skill WHERE {
  ?skill a aaif:Skill .
  FILTER NOT EXISTS {
    ?skill aaif:skillTag ?tag .
  }
}
ORDER BY ?skill
