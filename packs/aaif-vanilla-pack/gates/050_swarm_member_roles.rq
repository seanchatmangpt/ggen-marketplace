# MESSAGE: every aaif:Agent in a Swarm must have an assigned swarmRole.
# Any row returned indicates an unassigned or ambiguous agent role in the swarm.
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?agent ?missing WHERE {
  ?swarm a aaif:Swarm ;
         aaif:hasMemberAgent ?agent .
  BIND(aaif:swarmRole AS ?missing)
  FILTER NOT EXISTS { ?agent aaif:swarmRole ?any }
}
ORDER BY ?agent
