# MESSAGE: every aaif:Agent must declare an explicit authentication/security scheme.
# An unauthenticated agent permits anonymous spoofing and fails closed.
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?agent WHERE {
  ?agent a aaif:Agent .
  FILTER NOT EXISTS {
    ?agent aaif:hasSecurityScheme ?scheme .
  }
}
ORDER BY ?agent
