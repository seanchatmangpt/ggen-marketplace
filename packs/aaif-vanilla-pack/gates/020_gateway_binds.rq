# MESSAGE: every aaif:Gateway must specify port and xdsAddress.
# Any row returned indicates an incomplete gateway configuration.
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?gateway ?missing WHERE {
  {
    ?gateway a aaif:Gateway .
    BIND(aaif:port AS ?missing)
  } UNION {
    ?gateway a aaif:Gateway .
    BIND(aaif:xdsAddress AS ?missing)
  }
  FILTER NOT EXISTS { ?gateway ?missing ?any }
}
ORDER BY ?gateway ?missing
