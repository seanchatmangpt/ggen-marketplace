PREFIX aaif: <https://aaif.io/ontology#>

# Fail-closed gate: Any enterprise agent configured for SIEM telemetry egress MUST declare:
# 1. A siemType (e.g. splunk-hec, chronicle, datadog)
# 2. A valid siemEndpoint URI
SELECT ?agent ?siem WHERE {
  ?agent a aaif:Agent ;
         aaif:hasSIEMEgress ?siem .
  FILTER NOT EXISTS {
    ?siem aaif:siemType ?type ;
          aaif:siemEndpoint ?endpoint .
  }

}
ORDER BY ?agent
