# MESSAGE: every aaif:OpenSandboxReceipt must carry image, command,
# stdout/stderr digests, and a seal. A receipt without digests proves
# nothing about the execution it witnesses.
PREFIX aaif: <https://aaif.io/ontology#>

SELECT ?receipt WHERE {
  ?receipt a aaif:OpenSandboxReceipt .
  FILTER NOT EXISTS {
    ?receipt aaif:receiptId ?id ;
             aaif:sandboxImage ?img ;
             aaif:sandboxCommand ?cmd ;
             aaif:stdoutDigest ?so ;
             aaif:stderrDigest ?se ;
             aaif:receiptSeal ?seal .
  }
}
ORDER BY ?receipt
