PREFIX aaif: <https://aaif.io/ontology#>

# FAIL-CLOSED GATE: An enterprise AAIF Agent MUST carry an AffidavitTrustPlane
# declaring post-quantum or hybrid algorithm, sealed receipt protocol, and rolling BLAKE3 chain.
SELECT ?agent ?atp WHERE {
    ?agent a aaif:Agent ;
           aaif:hasPassport ?passport .

    OPTIONAL {
        ?agent aaif:hasAffidavitTrustPlane ?atp .
        ?atp aaif:postQuantumAlgorithm ?algo ;
             aaif:sealedReceiptProtocol ?proto ;
             aaif:blake3EventChainRollingHash ?blake ;
             aaif:certifyDontDecideInvariant true .
    }

    FILTER (!BOUND(?atp) || !BOUND(?algo) || !BOUND(?proto))

}
ORDER BY ?agent
