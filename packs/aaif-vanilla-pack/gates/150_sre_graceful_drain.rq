PREFIX aaif: <https://aaif.io/ontology#>

# FAIL-CLOSED GATE: An enterprise AAIF Agent MUST have a Graceful Drain Contract
# specifying checkpoint intervals, drain timeout, and state migration support.
SELECT ?agent ?drain WHERE {
    ?agent a aaif:Agent ;
           aaif:hasPassport ?passport .

    OPTIONAL {
        ?agent aaif:hasDrainContract ?drain .
        ?drain aaif:checkpointIntervalSeconds ?interval ;
               aaif:drainTimeoutSeconds ?timeout ;
               aaif:supportsStateMigration true .
    }

    FILTER (!BOUND(?drain) || !BOUND(?interval))
}
