{# ggen template: renders to open_responses/response.json (Open Responses canonical object) #}{
  "object": "response",
  "id": "{{ openResponseId }}",
  "created_at": {{ openResponseCreatedAt }},
  "status": "{{ openResponseStatus }}",
  "model": "{{ openResponseModel }}",
  "output": [
    {
      "type": "{{ openResponseOutputType }}",
      "role": "assistant",
      "status": "{{ openResponseStatus }}",
      "content": [
        {
          "type": "output_text",
          "text": "{{ openResponseOutputText }}",
          "annotations": []
        }
      ]
    }
  ],
  "usage": {
    "input_tokens": {{ usageInputTokens }},
    "output_tokens": {{ usageOutputTokens }},
    "total_tokens": {{ usageTotalTokens }},
    "input_tokens_details": {"cached_tokens": 0},
    "output_tokens_details": {"reasoning_tokens": 0}
  },
  "{{ responseExtensionNamespace }}": {{ responseExtensionValue }}
}
