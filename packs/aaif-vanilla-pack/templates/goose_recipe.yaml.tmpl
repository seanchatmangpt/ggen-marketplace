{# ggen template: renders to .config/goose/recipes/default.yaml (frontmatter stripped 2026-10-05; legacy renderer render_aaif_pack.py consumed the to:/sparql: frontmatter; ggen DeclarativeRules now own routing) #}version: "1.0.0"
title: "{{ title }}"
description: "{{ description }}"
instructions: |
  {{ instructions }}
prompt: |
  {{ prompt }}
parameters:
  - key: target_scope
    input_type: string
    requirement: optional
    default: "current_workspace"
    description: "Target directory or module scope"
activities:
  - "message: Ready to run recipe {{ title }}"
  - "Execute default task"
  - "Run verification suite"
extensions:
  - type: builtin
    name: developer
    bundled: true
    timeout: 300
retry:
  max_retries: 3
  timeout_seconds: 60
  checks:
    - type: shell
      command: "git status"