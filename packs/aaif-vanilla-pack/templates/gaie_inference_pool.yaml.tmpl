# Generated Gateway API Inference Extension Pool
apiVersion: inference.networking.k8s.io/v1
kind: InferencePool
metadata:
  name: {{ pool_name | default(value="vllm-cluster-pool") }}
  namespace: {{ namespace | default(value="agent-system") }}
spec:
  selector:
    app: {{ app_label | default(value="vllm-inference-worker") }}
  targetPorts:
    - {{ port | default(value=8000) }}
  endpointPickerRef:
    group: ""
    kind: Service
    name: {{ epp_service | default(value="llm-d-router-epp-service") }}
    port: {{ epp_port | default(value=9002) }}
