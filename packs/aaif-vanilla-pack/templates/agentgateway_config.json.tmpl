{# ggen template: renders to agentgateway/config.json (frontmatter stripped 2026-10-05; legacy renderer render_aaif_pack.py consumed the to:/sparql: frontmatter; ggen DeclarativeRules now own routing) #}{
  "config": {
    "logging": {
      "format": "json"
    }
  },
  "frontendPolicies": {
    "cors": {
      "allowOrigins": ["*"],
      "allowHeaders": ["content-type", "authorization", "cache-control"]
    }
  },
  "binds": [
    {
      "port": {{ port }},
      "listeners": [
        {
          "routes": [
            {
              "policies": {
                "a2a": {},
                "mcp": {}
              },
              "backends": [
                {
                  "host": "{{ xds_address }}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}