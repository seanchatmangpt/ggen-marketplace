{# ggen template: renders to opensandbox/receipt.json (OpenSandbox execution receipt) #}{
  "object": "sandbox_receipt",
  "id": "{{ receiptId }}",
  "image": "{{ sandboxImage }}",
  "command": "{{ sandboxCommand }}",
  "network_jailed": {{ networkJailed }},
  "digests": {
    "stdout": "{{ stdoutDigest }}",
    "stderr": "{{ stderrDigest }}"
  },
  "seal": "{{ receiptSeal }}"
}
