{# ggen template: renders to openenv/manifest.json (OpenEnv 4-method environment contract) #}{
  "id": "{{ openEnvId }}",
  "methods": {
    "reset": "{{ openEnvResetMethod }}",
    "step": "{{ openEnvStepMethod }}",
    "state": "{{ openEnvStateMethod }}",
    "close": "{{ openEnvCloseMethod }}"
  },
  "observation_schema": {{ openEnvObservationSchema }},
  "action_schema": {{ openEnvActionSchema }}
}
