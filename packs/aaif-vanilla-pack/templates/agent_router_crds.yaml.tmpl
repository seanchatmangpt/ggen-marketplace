{# ggen template: renders to k8s/agent-router.yaml (frontmatter stripped 2026-10-05; legacy renderer render_aaif_pack.py consumed the to:/sparql: frontmatter; ggen DeclarativeRules now own routing) #}apiVersion: aigateway.envoyproxy.io/v1alpha1
kind: GatewayConfig
metadata:
  name: {{ name }}-gw-config
spec:
  tracing:
    enabled: true
---
apiVersion: aigateway.envoyproxy.io/v1alpha1
kind: BackendSecurityPolicy
metadata:
  name: {{ name }}-sec-policy
spec:
  anthropicAPIKey:
    secretRef:
      name: anthropic-credentials
---
apiVersion: aigateway.envoyproxy.io/v1alpha1
kind: AIServiceBackend
metadata:
  name: {{ primary_backend }}
spec:
  provider:
    type: GCPVertexAI
---
apiVersion: aigateway.envoyproxy.io/v1alpha1
kind: AIServiceBackend
metadata:
  name: {{ fallback_backend }}
spec:
  provider:
    type: OpenAI
---
apiVersion: aigateway.envoyproxy.io/v1alpha1
kind: AIGatewayRoute
metadata:
  name: {{ name }}-route
spec:
  rules:
    - matches:
        - headers:
            - name: x-model-tier
              value: primary
      backends:
        - name: {{ primary_backend }}
          weight: 100
    - matches:
        - headers:
            - name: x-model-tier
              value: fallback
      backends:
        - name: {{ fallback_backend }}
          weight: 100
---
apiVersion: aigateway.envoyproxy.io/v1alpha1
kind: MCPRoute
metadata:
  name: {{ name }}-mcp-route
spec:
  backendRefs:
    - name: mcp-upstream-service
---
apiVersion: aigateway.envoyproxy.io/v1alpha1
kind: QuotaPolicy
metadata:
  name: {{ name }}-quota
spec:
  rules:
    - limit: 1000
      period: 1m
