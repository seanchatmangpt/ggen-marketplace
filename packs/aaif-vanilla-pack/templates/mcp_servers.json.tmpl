{# ggen template: renders to mcp/mcp_servers.json (frontmatter stripped 2026-10-05; legacy renderer render_aaif_pack.py consumed the to:/sparql: frontmatter; ggen DeclarativeRules now own routing) #}{
  "mcpServers": {
{% if mcpServer %}
    "autofde_decision_fabric": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "autofde_lab.aaif"]
    },
{% endif %}
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "remote_service": {
      "type": "streamable_http",
      "url": "https://mcp.internal.net/sse",
      "headers": {
        "Authorization": "Bearer ${MCP_REMOTE_TOKEN}"
      }
    }
  }
}
