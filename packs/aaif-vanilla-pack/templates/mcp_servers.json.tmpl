---
to: "mcp/mcp_servers.json"
for_each: "agent"
sparql:
  agent: |
    PREFIX aaif: <https://aaif.io/ontology#>
    SELECT ?name ?mcpServer WHERE {
      ?s a aaif:Agent ; aaif:name ?name .
      OPTIONAL { ?s aaif:requiresMcpServer ?mcpServer . }
    }
---
{
  "mcpServers": {
{% if mcpServer %}
    "autofde_decision_fabric": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "autofde_lab.aaif"]
    },
{% endif %}
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "remote_service": {
      "type": "streamable_http",
      "url": "https://mcp.internal.net/sse",
      "headers": {
        "Authorization": "Bearer ${MCP_REMOTE_TOKEN}"
      }
    }
  }
}
