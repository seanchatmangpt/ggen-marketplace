---
to: ".config/goose/config.yaml"
for_each: "goose"
sparql:
  goose: |
    PREFIX aaif: <https://aaif.io/ontology#>
    SELECT ?provider ?model WHERE {
      ?s a aaif:GooseConfig ;
         aaif:provider ?provider ;
         aaif:model ?model .
    }
---
active_provider: {{ provider }}
providers:
  {{ provider }}:
    enabled: true
    model: {{ model }}
    configured: true

GOOSE_MODE: "smart_approve"
GOOSE_TEMPERATURE: 0.7
GOOSE_MAX_TURNS: 1000

extensions:
  developer:
    enabled: true
    type: builtin
    name: developer
    bundled: true
    timeout: 300
