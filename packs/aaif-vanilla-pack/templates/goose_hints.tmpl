---
to: ".goosehints"
for_each: "hints"
sparql:
  hints: |
    PREFIX aaif: <https://aaif.io/ontology#>
    SELECT ?goosehints WHERE {
      ?s a aaif:GooseContext ;
         aaif:goosehints ?goosehints .
    }
---
