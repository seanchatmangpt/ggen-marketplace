---
to: "AGENTS.md"
for_each: "agent"
sparql:
  agent: |
    PREFIX aaif: <https://aaif.io/ontology#>
    SELECT ?name ?description ?dev_environment ?testing ?coding_conventions ?commands ?boundaries WHERE {
      ?s a aaif:Agent ;
         aaif:name ?name ;
         aaif:description ?description .
      OPTIONAL { ?agents_md a aaif:AgentsMd ;
                   aaif:devEnvironment ?dev_environment ;
                   aaif:testing ?testing ;
                   aaif:codingConventions ?coding_conventions ;
                   aaif:commands ?commands ;
                   aaif:boundaries ?boundaries . }
    }
---
