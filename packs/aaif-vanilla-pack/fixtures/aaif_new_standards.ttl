@prefix aaif: <https://aaif.io/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Canonical minimal fixtures for the 4 newly covered AAIF standards:
# Agent Skills (SKILL.md), Open Responses, OpenEnv, OpenSandbox.
# 80/20 law: canonical contract only, no SDK imports.

# --- Agent Skills fixture skill ---
aaif:LedgerAuditSkill a aaif:SkillManifest ;
    aaif:skillManifestName "ledger-audit" ;
    aaif:skillManifestDescription "Use when auditing session receipts or verifying landed claims against on-disk evidence." ;
    aaif:skillManifestGate "receipt-lint: standing line required after H1, closed vocabulary only" ;
    aaif:skillManifestCourts "ledger-audit must flip on a receipt with a missing Standing line (anti-vacuity)" ;
    aaif:skillManifestLegacyDefects "none registered" ;
    aaif:skillManifestCutDate "2027-05-12" .

# --- Open Responses fixture ---
aaif:LedgerAuditResponse a aaif:OpenResponse ;
    aaif:openResponseId "resp_01HV3M9K7Q" ;
    aaif:openResponseModel "aaif-agent-1" ;
    aaif:openResponseCreatedAt 1794441600 ;
    aaif:openResponseOutputType "message" ;
    aaif:openResponseOutputText "Ledger audit complete: 9 receipts verified, 0 stale standing claims." ;
    aaif:openResponseStatus "completed" ;
    aaif:usageInputTokens 512 ;
    aaif:usageOutputTokens 64 ;
    aaif:usageTotalTokens 576 ;
    aaif:responseExtensionNamespace "metadata" ;
    aaif:responseExtensionValue "{\"audit_run\": \"ledger-audit@1\"}" .

# --- OpenEnv fixture ---
aaif:LedgerAuditEnv a aaif:OpenEnvManifest ;
    aaif:openEnvId "ledger-audit-env" ;
    aaif:openEnvResetMethod "reset(seed: int) -> observation" ;
    aaif:openEnvStepMethod "step(action) -> (observation, reward, terminated, truncated, info)" ;
    aaif:openEnvStateMethod "state() -> env_state" ;
    aaif:openEnvCloseMethod "close() -> None" ;
    aaif:openEnvObservationSchema "{\"type\": \"object\", \"required\": [\"ledger_path\", \"receipt_count\"]}" ;
    aaif:openEnvActionSchema "{\"type\": \"object\", \"required\": [\"op\"], \"op\": {\"enum\": [\"verify\", \"replay\"]}}" .

# --- OpenSandbox fixture ---
aaif:LedgerAuditSandboxReceipt a aaif:OpenSandboxReceipt ;
    aaif:receiptId "rcpt_01HV3MA2XP" ;
    aaif:sandboxImage "ghcr.io/aaif/ledger-audit@sha256:9f2c..." ;
    aaif:sandboxCommand "python3 scripts/audit_receipts.py" ;
    aaif:sandboxNetworkJailed true ;
    aaif:stdoutDigest "sha256:4b1d..." ;
    aaif:stderrDigest "sha256:e07a..." ;
    aaif:receiptSeal "PQ-SEAL-v1:ML-DSA-65:<opaque>" .
