@prefix aaif: <https://aaif.io/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

aaif:DemoAgent a aaif:Agent ;
    aaif:name "Enterprise Assistant" ;
    aaif:description "Autonomous enterprise support and task execution agent conforming to AAIF standards." ;
    aaif:url "https://agent.example.com" ;
    aaif:version "1.0.0" ;
    aaif:hasSecurityScheme aaif:DemoBearerAuth ;
    aaif:enforcesOwnerScoping true ;
    aaif:enforcesContextIsolation true ;
    aaif:stripsInternalKeys true ;
    aaif:jwsCardSigning true .

aaif:DemoBearerAuth a aaif:BearerAuthScheme ;
    aaif:schemeName "bearer_auth" ;
    aaif:authType "Bearer" .

aaif:DemoEnvelopeDefense a aaif:EnvelopeDefensePolicy ;
    aaif:untrustedInputTagging true ;
    aaif:promptInjectionInterception true ;
    aaif:egressCredentialSanitization true .

aaif:DemoGateway a aaif:Gateway ;
    aaif:port 8080 ;
    aaif:xdsAddress "http://127.0.0.1:9977" ;
    aaif:authIssuer "https://auth.example.com" ;
    aaif:hasEnvelopeDefense aaif:DemoEnvelopeDefense .

aaif:DemoRouter a aaif:Router ;
    aaif:name "enterprise-router" ;
    aaif:primaryBackend "vertex-gemini" ;
    aaif:fallbackBackend "openai-gpt4o" .

aaif:DemoGoose a aaif:GooseConfig ;
    aaif:provider "openai" ;
    aaif:model "gpt-4o" ;
    aaif:temperature 0.7 ;
    aaif:maxTurns 1000 .

aaif:DemoGooseRecipe a aaif:GooseRecipe ;
    aaif:recipeTitle "Automated Code Review" ;
    aaif:recipeDescription "Analyze PR code diffs and report issues" ;
    aaif:recipeInstructions "Review code diffs against project standards." ;
    aaif:recipePrompt "Run lint, check tests, and summarize feedback." .

aaif:DemoGooseContext a aaif:GooseContext ;
    aaif:goosehints "Always run unit tests before committing changes. Adhere to typed APIs." .

aaif:DemoAgentsMd a aaif:AgentsMd ;
    aaif:devEnvironment "Start with containerized services; use local debug loop." ;
    aaif:testing "Execute automated test ladder before git commit." ;
    aaif:codingConventions "Clean typed interfaces conforming to AAIF open schemas." ;
    aaif:commands "make test, make lint, make build" ;
    aaif:boundaries "No hardcoded credentials, zero unreceipted actions." .
