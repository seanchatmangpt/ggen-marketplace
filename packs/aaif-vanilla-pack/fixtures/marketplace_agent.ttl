@prefix aaif: <https://aaif.io/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ggen-marketplace self-hosted Agent instance conforming to AAIF standards suite
aaif:MarketplaceAgent a aaif:Agent ;
    aaif:name "ggen-marketplace Agent" ;
    aaif:description "Autonomous semantic manufacturing pack registry, discovery, qualification, and catalog indexing agent." ;
    aaif:url "https://marketplace.ggen.dev" ;
    aaif:version "26.10.2" ;
    aaif:hasSecurityScheme aaif:MarketplaceBearerAuth ;
    aaif:enforcesOwnerScoping true ;
    aaif:enforcesContextIsolation true ;
    aaif:stripsInternalKeys true ;
    aaif:jwsCardSigning true .

aaif:MarketplaceBearerAuth a aaif:BearerAuthScheme ;
    aaif:schemeName "bearer_auth" ;
    aaif:authType "Bearer" .

aaif:MarketplaceEnvelopeDefense a aaif:EnvelopeDefensePolicy ;
    aaif:untrustedInputTagging true ;
    aaif:promptInjectionInterception true ;
    aaif:egressCredentialSanitization true .

aaif:MarketplaceGateway a aaif:Gateway ;
    aaif:port 8080 ;
    aaif:xdsAddress "http://127.0.0.1:9977" ;
    aaif:authIssuer "https://auth.ggen.dev" ;
    aaif:hasEnvelopeDefense aaif:MarketplaceEnvelopeDefense .

aaif:MarketplaceRouter a aaif:Router ;
    aaif:name "marketplace-router" ;
    aaif:primaryBackend "vertex-gemini" ;
    aaif:fallbackBackend "openai-gpt4o" .

aaif:MarketplaceGoose a aaif:GooseConfig ;
    aaif:provider "anthropic" ;
    aaif:model "claude-3-7-sonnet" ;
    aaif:temperature 0.2 ;
    aaif:maxTurns 500 .

aaif:MarketplaceGooseRecipe a aaif:GooseRecipe ;
    aaif:recipeTitle "Pack Qualification & Verification Loop" ;
    aaif:recipeDescription "Execute Chicago-style qualification courts, check SPARQL gates, and verify deterministic projection." ;
    aaif:recipeInstructions "Run marketplace.py validate, execute pytest test courts, and audit byte-reproducibility." ;
    aaif:recipePrompt "Validate pack admission, execute gates with fail-witnesses, and inspect receipt chains." .

aaif:MarketplaceGooseContext a aaif:GooseContext ;
    aaif:goosehints "Never commit unadmitted packs. Run pytest before pushing. Zero unreceipted actuation." .

aaif:MarketplaceAgentsMd a aaif:AgentsMd ;
    aaif:devEnvironment "Python 3.11+, Rust 1.80+, Homebrew pytest, ggen v26.9.28." ;
    aaif:testing "Run Chicago-style test suite with real collaborators via pytest tests/." ;
    aaif:codingConventions "Strict adherence to typed SPARQL gates, RDF ontologies, and deterministic projections." ;
    aaif:commands "python3.11 scripts/marketplace.py validate, pytest tests/, ggen sync run --dry-run" ;
    aaif:boundaries "No symlinks under packs/, fail-closed admission, zero ambient execution authority." .
