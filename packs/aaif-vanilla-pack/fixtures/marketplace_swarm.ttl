@prefix aaif: <https://aaif.io/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# AAIF SWARM FIXTURE: ggen-marketplace Multi-Agent Swarm
# ==============================================================================

aaif:MarketplaceSwarm a aaif:Swarm ;
    aaif:name "ggen-marketplace Autonomous Swarm" ;
    aaif:swarmCoordinator aaif:CoordinatorAgent ;
    aaif:hasMemberAgent aaif:CoordinatorAgent, aaif:QualificationAgent, aaif:ProjectionAgent .

# 1. Swarm Coordinator Agent
aaif:CoordinatorAgent a aaif:Agent ;
    aaif:name "Marketplace Coordinator" ;
    aaif:description "Swarm intake, task delegation, and work order orchestration agent." ;
    aaif:url "https://marketplace.ggen.dev/coordinator" ;
    aaif:version "26.10.2" ;
    aaif:swarmRole "coordinator" ;
    aaif:hasSecurityScheme aaif:SwarmBearerAuth ;
    aaif:enforcesOwnerScoping true ;
    aaif:enforcesContextIsolation true ;
    aaif:stripsInternalKeys true ;
    aaif:jwsCardSigning true ;
    aaif:delegatesTo aaif:QualificationAgent, aaif:ProjectionAgent .

# 2. Qualification Worker Agent
aaif:QualificationAgent a aaif:Agent ;
    aaif:name "Marketplace Qualification Worker" ;
    aaif:description "Adversarial test court runner, SPARQL gate auditor, and receipt issuer." ;
    aaif:url "https://marketplace.ggen.dev/qualifier" ;
    aaif:version "26.10.2" ;
    aaif:hasSecurityScheme aaif:SwarmBearerAuth ;
    aaif:enforcesOwnerScoping true ;
    aaif:enforcesContextIsolation true ;
    aaif:stripsInternalKeys true ;
    aaif:jwsCardSigning true ;
    aaif:swarmRole "qualifier" .

# 3. Projection Engine Agent
aaif:ProjectionAgent a aaif:Agent ;
    aaif:name "Marketplace Projection Worker" ;
    aaif:description "Deterministic code generation, template synthesis, and catalog projector." ;
    aaif:url "https://marketplace.ggen.dev/projector" ;
    aaif:version "26.10.2" ;
    aaif:hasSecurityScheme aaif:SwarmBearerAuth ;
    aaif:enforcesOwnerScoping true ;
    aaif:enforcesContextIsolation true ;
    aaif:stripsInternalKeys true ;
    aaif:jwsCardSigning true ;
    aaif:swarmRole "projector" .

aaif:SwarmBearerAuth a aaif:BearerAuthScheme ;
    aaif:schemeName "bearer_auth" ;
    aaif:authType "Bearer" .

aaif:SwarmEnvelopeDefense a aaif:EnvelopeDefensePolicy ;
    aaif:untrustedInputTagging true ;
    aaif:promptInjectionInterception true ;
    aaif:egressCredentialSanitization true .

# Swarm Gateway & Mesh Routing
aaif:SwarmGateway a aaif:Gateway ;
    aaif:port 8080 ;
    aaif:xdsAddress "http://127.0.0.1:9977" ;
    aaif:authIssuer "https://auth.ggen.dev" ;
    aaif:hasEnvelopeDefense aaif:SwarmEnvelopeDefense .

aaif:SwarmRouter a aaif:Router ;
    aaif:name "marketplace-swarm-router" ;
    aaif:primaryBackend "vertex-gemini" ;
    aaif:fallbackBackend "anthropic-claude" .

# Autonomous Swarm Developer Configuration (Goose)
aaif:SwarmGoose a aaif:GooseConfig ;
    aaif:provider "anthropic" ;
    aaif:model "claude-3-7-sonnet" ;
    aaif:temperature 0.2 ;
    aaif:maxTurns 1000 .

aaif:SwarmGooseRecipe a aaif:GooseRecipe ;
    aaif:recipeTitle "Swarm Multi-Agent Coordination Loop" ;
    aaif:recipeDescription "Coordinate qualification and projection passes across the agent swarm." ;
    aaif:recipeInstructions "Coordinator receives request, delegates qualification to qualifier, delegates synthesis to projector." ;
    aaif:recipePrompt "Execute full swarm loop with receipts." .

aaif:SwarmGooseContext a aaif:GooseContext ;
    aaif:goosehints "Enforce zero unreceipted actuation. Coordinate through A2A RPCs and MCP tool isolation." .

aaif:SwarmAgentsMd a aaif:AgentsMd ;
    aaif:devEnvironment "Python 3.11+, Rust 1.80+, Homebrew pytest, ggen v26.9.28." ;
    aaif:testing "Run Chicago-style multi-agent test courts with pytest tests/." ;
    aaif:codingConventions "Strict compliance with AAIF open standards (A2A, MCP, Agentgateway, Router, Goose, AGENTS.md)." ;
    aaif:commands "pytest tests/test_aaif_vanilla_pack_court.py, python3.11 scripts/marketplace.py validate aaif-vanilla-pack" ;
    aaif:boundaries "Fail-closed admission, no ambient execution authority, immutable receipt logs." .
