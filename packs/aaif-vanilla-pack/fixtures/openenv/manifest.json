{
  "id": "ledger-audit-env",
  "methods": {
    "reset": "reset(seed: int) -> observation",
    "step": "step(action) -> (observation, reward, terminated, truncated, info)",
    "state": "state() -> env_state",
    "close": "close() -> None"
  },
  "observation_schema": {
    "type": "object",
    "required": ["ledger_path", "receipt_count"]
  },
  "action_schema": {
    "type": "object",
    "required": ["op"],
    "properties": {
      "op": { "enum": ["verify", "replay"] }
    }
  }
}
