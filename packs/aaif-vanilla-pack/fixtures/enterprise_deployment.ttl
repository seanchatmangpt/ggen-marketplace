@prefix aaif: <https://aaif.io/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<urn:enterprise:f5-deployment> a aaif:Fortune5Deployment ;
    aaif:hasTier1Router <urn:enterprise:tier1-router> ;
    aaif:hasTier2DataPlane <urn:enterprise:tier2-dataplane> ;
    aaif:hasWorkerSandbox <urn:enterprise:goose-worker> .

<urn:enterprise:tier1-router> a aaif:Tier1IngressRouter .

<urn:enterprise:tier2-dataplane> a aaif:Tier2AgentDataPlane ;
    aaif:maxLatencyBudgetMs 15 ;
    aaif:celRule "request.auth.claims.role == 'LeadAnalyst' || target.tool != 'system_execute'" ;
    aaif:hasInferencePool <urn:enterprise:vllm-pool> .

<urn:enterprise:vllm-pool> a aaif:InferencePool .

<urn:enterprise:goose-worker> a aaif:SandboxedWorker ;
    aaif:runAsNonRoot true ;
    aaif:readOnlyRootFilesystem true ;
    aaif:dropAllCapabilities true .
