@prefix stl: <http://seanchatmangpt.github.io/packs/standing-ladder#> .
@prefix dcp: <http://seanchatmangpt.github.io/packs/domain-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Qualification-only external fact identity. The canonical capability facts
# are owned by domain-capability-pack; this fixture supplies only the minimum
# typed identity needed to prove that a StandingClaim cannot point at a
# dangling IRI when standing-ladder-pack is qualified in isolation.
dcp:sregym-run-kubectl a dcp:Capability ;
    dcterms:source "packs/domain-capability-pack/ontology.ttl#dcp:sregym-run-kubectl" .

stl:sregym-run-kubectl-claim a stl:StandingClaim ;
    stl:aboutFact dcp:sregym-run-kubectl ;
    stl:hasStanding stl:ADMITTED ;
    dcterms:description "Qualification worked example: the externally owned SREGym run_kubectl capability reaches ADMITTED only through six single-rung evidenced transitions." .

stl:sregym-run-kubectl-t1 a stl:StandingTransition ;
    stl:aboutClaim stl:sregym-run-kubectl-claim ;
    stl:fromState stl:UNKNOWN ; stl:toState stl:OBSERVED ; stl:transitionOrder 1 ;
    stl:evidenceRef "OBSERVED: directly read from gymact SREGYM_CAPABILITIES and represented by domain-capability-pack; qualification fixture preserves only the referenced fact identity." .

stl:sregym-run-kubectl-t2 a stl:StandingTransition ;
    stl:aboutClaim stl:sregym-run-kubectl-claim ;
    stl:fromState stl:OBSERVED ; stl:toState stl:VALIDATED ; stl:transitionOrder 2 ;
    stl:evidenceRef "VALIDATED: domain-capability-pack exact-count admission established the SREGym capability inventory against the observed source." .

stl:sregym-run-kubectl-t3 a stl:StandingTransition ;
    stl:aboutClaim stl:sregym-run-kubectl-claim ;
    stl:fromState stl:VALIDATED ; stl:toState stl:DERIVED ; stl:transitionOrder 3 ;
    stl:evidenceRef "DERIVED: the admitted capability fact participates in the downstream AutoFDE Lab capability projection rather than remaining an unconnected observation." .

stl:sregym-run-kubectl-t4 a stl:StandingTransition ;
    stl:aboutClaim stl:sregym-run-kubectl-claim ;
    stl:fromState stl:DERIVED ; stl:toState stl:CANDIDATE ; stl:transitionOrder 4 ;
    stl:evidenceRef "CANDIDATE: selected as the explicit qualification specimen for the standing-ladder law; this does not change the capability's external runtime authority." .

stl:sregym-run-kubectl-t5 a stl:StandingTransition ;
    stl:aboutClaim stl:sregym-run-kubectl-claim ;
    stl:fromState stl:CANDIDATE ; stl:toState stl:EXPERIMENTALLY_SUPPORTED ; stl:transitionOrder 5 ;
    stl:evidenceRef "EXPERIMENTALLY_SUPPORTED: the standing-ladder qualification court executes a real ggen sync over this exact claim and transition chain." .

stl:sregym-run-kubectl-t6 a stl:StandingTransition ;
    stl:aboutClaim stl:sregym-run-kubectl-claim ;
    stl:fromState stl:EXPERIMENTALLY_SUPPORTED ; stl:toState stl:ADMITTED ; stl:transitionOrder 6 ;
    stl:evidenceRef "ADMITTED: gates/010_no_skipped_states.rq must observe the complete chain and the typed aboutFact in the same admitted union graph before manufacture proceeds." .
