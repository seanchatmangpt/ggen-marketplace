# Conserved from cs2-projection-matrix/fixtures/fleet.ttl (prefix: cs2_).
# IRIs repointed from the absorbed pack's marketplace# spelling to this pack's
# single pm: IRI (the collision: cs2 minted the same ontology IRI its
# ontology.ttl declared while its data used a third spelling — all three now
# one owner). adapterKind/enabled/sourceRepository/consumerRepository/
# consumerSlug resolve via ontology/cs2-adapter.ttl. Court/qualification data
# only — not a generation input.
@prefix pm: <https://ggen.dev/ontology/projection-matrix#> .

<urn:subject:rfc-cs2-001> a pm:Subject ;
  pm:sourceRepository <https://github.com/seanchatmangpt/ggen-marketplace> ;
  pm:sourceSha "PIN_AT_CONSUMPTION" ;
  pm:sourceDigest "sha256:PIN_AT_CONSUMPTION" .

<urn:consumer:xaas> a pm:Consumer ;
  pm:consumerRepository <https://github.com/seanchatmangpt/xaas> ;
  pm:consumerSlug "xaas" .

<urn:consumer:gymact> a pm:Consumer ;
  pm:consumerRepository <https://github.com/seanchatmangpt/gymact> ;
  pm:consumerSlug "gymact" .

<urn:consumer:semantic-jira> a pm:Consumer ;
  pm:consumerRepository <https://github.com/seanchatmangpt/semantic-jira> ;
  pm:consumerSlug "semantic-jira" .

<urn:projection:cs2:xaas> a pm:Projection ;
  pm:subject <urn:subject:rfc-cs2-001> ; pm:consumer <urn:consumer:xaas> ;
  pm:targetPath "generated/cs2/binding.ttl" ; pm:adapterKind "turtle" ; pm:enabled true .

<urn:projection:cs2:gymact> a pm:Projection ;
  pm:subject <urn:subject:rfc-cs2-001> ; pm:consumer <urn:consumer:gymact> ;
  pm:targetPath "generated/cs2/binding.ttl" ; pm:adapterKind "turtle" ; pm:enabled true .

<urn:projection:cs2:semantic-jira> a pm:Projection ;
  pm:subject <urn:subject:rfc-cs2-001> ; pm:consumer <urn:consumer:semantic-jira> ;
  pm:targetPath "generated/cs2/binding.ttl" ; pm:adapterKind "turtle" ; pm:enabled true .
