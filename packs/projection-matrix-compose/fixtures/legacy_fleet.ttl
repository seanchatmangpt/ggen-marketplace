# Conserved from projection-matrix-pack/fixtures/fleet.ttl (prefix: legacy_).
# IRIs repointed from the retired https://chatmangpt.com/ggen/projection-matrix#
# vocabulary to this pack's single pm: IRI (1:1 term conservation records in
# ontology/core.ttl). Court/qualification data only — not a generation input.
@prefix pm: <https://ggen.dev/ontology/projection-matrix#> .
@prefix ex: <https://ggen.dev/fixture/legacy/> .
# sourceSha added at consolidation: the retired subset vocabulary had no
# sourceSha term; the merged gate ladder (010) requires it on every Subject.
ex:cs2 a pm:Subject ; pm:sourceSha "RFC-CS2-001" ; pm:sourceDigest "sha256:fixture-cs2" .
ex:ptd a pm:Subject ; pm:sourceSha "RFC-PTD-001" ; pm:sourceDigest "sha256:fixture-ptd" .
ex:xaas a pm:Consumer . ex:gymact a pm:Consumer . ex:sjira a pm:Consumer .
ex:elixir a pm:Adapter . ex:json a pm:Adapter .
ex:p1 a pm:Projection ; pm:subject ex:cs2 ; pm:consumer ex:xaas ; pm:adapter ex:elixir ; pm:targetPath "lib/generated/cs2.ex" ; pm:moduleName "Generated.CS2" .
ex:p2 a pm:Projection ; pm:subject ex:cs2 ; pm:consumer ex:gymact ; pm:adapter ex:json ; pm:targetPath "priv/generated/cs2.json" ; pm:packageName "cs2" .
ex:p3 a pm:Projection ; pm:subject ex:ptd ; pm:consumer ex:sjira ; pm:adapter ex:json ; pm:targetPath "priv/generated/ptd.json" ; pm:packageName "ptd" .
