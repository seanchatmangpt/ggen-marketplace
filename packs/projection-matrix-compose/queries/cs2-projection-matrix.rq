PREFIX pm: <https://ggen.dev/ontology/projection-matrix#>

SELECT ?projection ?subject ?consumer ?sourceRepository ?sourceSha ?sourceDigest
       ?consumerRepository ?consumerSlug ?targetPath ?adapterKind
WHERE {
  ?projection a pm:Projection ;
    pm:subject ?subject ;
    pm:consumer ?consumer ;
    pm:targetPath ?targetPath ;
    pm:adapterKind ?adapterKind ;
    pm:enabled true .
  ?subject a pm:Subject ;
    pm:sourceRepository ?sourceRepository ;
    pm:sourceSha ?sourceSha ;
    pm:sourceDigest ?sourceDigest .
  ?consumer a pm:Consumer ;
    pm:consumerRepository ?consumerRepository ;
    pm:consumerSlug ?consumerSlug .
}
ORDER BY ?subject ?consumer ?targetPath ?adapterKind
