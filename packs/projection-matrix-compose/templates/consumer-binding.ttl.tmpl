---
to: "generated/{{ projectionKey }}/consumer-binding.ttl"
for_each: "binding"
sparql:
  binding: |
    PREFIX pm: <https://ggen.dev/ontology/projection-matrix#>
    SELECT ?projectionKey ?projection ?subject ?consumer ?adapter ?targetPath ?sourceSha ?sourceDigest ?moduleName ?packageName
    WHERE {
      ?projection a pm:Projection ;
        pm:subject ?subject ; pm:consumer ?consumer ; pm:adapter ?adapter ; pm:targetPath ?targetPath .
      ?subject pm:sourceSha ?sourceSha ; pm:sourceDigest ?sourceDigest .
      OPTIONAL { ?projection pm:moduleName ?moduleName }
      OPTIONAL { ?projection pm:packageName ?packageName }
      BIND(REPLACE(STR(?projection), "[:/#]+", "_") AS ?projectionKey)
    }
    ORDER BY ?projectionKey
---
@prefix bind: <https://ggen.dev/generated/binding#> .
<{{ projection }}> a bind:ConsumerBinding ;
 bind:subject <{{ subject }}> ; bind:consumer <{{ consumer }}> ; bind:adapter <{{ adapter }}> ;
 bind:targetPath "{{ targetPath }}" ; bind:sourceSha "{{ sourceSha }}" ; bind:sourceDigest "{{ sourceDigest }}"{% if moduleName %} ;
 bind:moduleName "{{ moduleName }}"{% endif %}{% if packageName %} ; bind:packageName "{{ packageName }}"{% endif %} .
