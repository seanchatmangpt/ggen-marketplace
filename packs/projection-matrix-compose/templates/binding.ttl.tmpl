---
to: "generated/binding.ttl"
for_each: "binding"
sparql:
  binding: |
    PREFIX pm: <https://ggen.dev/ontology/projection-matrix#>
    SELECT ?projection ?subject ?consumer ?adapter ?targetPath ?sourceIdentity ?sourceDigest
    WHERE {
      ?projection a pm:Projection ; pm:subject ?subject ; pm:consumer ?consumer ; pm:adapter ?adapter ; pm:targetPath ?targetPath .
      ?subject pm:sourceSha ?sourceSha ; pm:sourceDigest ?sourceDigest .
      OPTIONAL { ?projection pm:sourceIdentity ?sourceIdentity }
    }
    ORDER BY ?consumer ?subject ?adapter ?targetPath
---
@prefix pm: <https://ggen.dev/ontology/projection-matrix#> .
@prefix bind: <https://ggen.dev/generated/binding#> .

bind:this
  a pm:Projection ;
  pm:subject <{{ subject }}> ;
  pm:consumer <{{ consumer }}> ;
  pm:adapter <{{ adapter }}> ;
  pm:targetPath "{{ targetPath }}" ;
{% if sourceIdentity %}  pm:sourceIdentity "{{ sourceIdentity }}" ;{% endif %}
{% if sourceDigest %}  pm:sourceDigest "{{ sourceDigest }}" ;{% endif %}
  pm:emits "{{ targetPath }}" .
