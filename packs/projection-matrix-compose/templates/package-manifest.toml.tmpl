[projection]
subject = "{{ subject }}"
consumer = "{{ consumer }}"
adapter = "{{ adapter }}"
target_path = "{{ targetPath }}"
source_sha = "{{ sourceSha }}"
source_digest = "{{ sourceDigest }}"
{% if moduleName %}module_name = "{{ moduleName }}"{% endif %}
{% if packageName %}package_name = "{{ packageName }}"{% endif %}
