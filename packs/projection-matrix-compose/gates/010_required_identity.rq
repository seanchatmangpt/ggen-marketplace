# MESSAGE: every pm:Projection must name its subject, consumer and targetPath plus exactly one adapter slot (pm:adapter or pm:adapterKind), and every pm:Subject must carry sourceSha and sourceDigest; any row is a refusal.
PREFIX pm: <https://ggen.dev/ontology/projection-matrix#>
SELECT ?s ?missing WHERE {
  {
    ?s a pm:Projection .
    VALUES ?missing { pm:subject pm:consumer pm:targetPath }
    FILTER NOT EXISTS { ?s ?missing ?v }
  } UNION {
    ?s a pm:Projection .
    BIND(pm:adapter AS ?missing)
    FILTER NOT EXISTS { ?s pm:adapter ?a }
    FILTER NOT EXISTS { ?s pm:adapterKind ?k }
  } UNION {
    ?s a pm:Subject .
    VALUES ?missing { pm:sourceSha pm:sourceDigest }
    FILTER NOT EXISTS { ?s ?missing ?v }
  }
}
ORDER BY ?s ?missing
