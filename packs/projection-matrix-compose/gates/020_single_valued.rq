# MESSAGE: functional pm: properties (projection slots and subject identity) are single-valued; any multi-valued binding is a refusal.
PREFIX pm: <https://ggen.dev/ontology/projection-matrix#>
SELECT ?s ?p (COUNT(?v) AS ?n) WHERE {
  {
    ?s a pm:Projection ; ?p ?v .
    VALUES ?p { pm:subject pm:consumer pm:adapter pm:adapterKind pm:targetPath pm:moduleName pm:packageName }
  } UNION {
    ?s a pm:Subject ; ?p ?v .
    VALUES ?p { pm:sourceSha pm:sourceDigest }
  }
}
GROUP BY ?s ?p
HAVING (COUNT(?v) > 1)
ORDER BY ?s ?p
