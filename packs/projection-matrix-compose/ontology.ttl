# ===== SOURCE: ontology/bindings.ttl =====
# projection-matrix-compose — bindings module (generation contract).
#
# The generation contract lives here as declared facts (NOT in pack.toml
# [[inputs]]/[[projections]] tables — the ggen pack loader does not admit
# those under FM-PACK-003); consumers bind these rules in their own
# ggen.toml. Relocated from this pack's own pre-consolidation ontology.ttl.
#
# Legacy renderer vocabulary conserved from projection-matrix-pack: its
# binding.ttl renderer referenced pm:sourceIdentity and pm:emits without
# ever declaring either term (recorded failed edge: dead template vocabulary
# — the renderer emitted empty/unbound values against its own fixture).
# Declared here so the conserved templates/binding.ttl.tmpl resolves against
# the union graph instead of silently referencing undeclared IRIs.

@prefix pm: <https://ggen.dev/ontology/projection-matrix#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pm:Input a rdfs:Class ; rdfs:label "Input" ; rdfs:comment "One RDF input bound into the generation contract." .
pm:ProjectionRule a rdfs:Class ; rdfs:label "Projection Rule" ; rdfs:comment "One query x template x output binding a consumer's ggen.toml admits." .
pm:path a rdf:Property ; rdfs:domain pm:Input ; rdfs:range xsd:string .
pm:format a rdf:Property ; rdfs:domain pm:Input ; rdfs:range xsd:string .
pm:query a rdf:Property ; rdfs:domain pm:ProjectionRule ; rdfs:range xsd:string .
pm:template a rdf:Property ; rdfs:domain pm:ProjectionRule ; rdfs:range xsd:string .
pm:output a rdf:Property ; rdfs:domain pm:ProjectionRule ; rdfs:range xsd:string .
pm:ruleName a rdf:Property ; rdfs:domain pm:ProjectionRule ; rdfs:range xsd:string .

# Legacy binding renderer vocabulary (conserved, was undeclared).
pm:sourceIdentity a rdf:Property ; rdfs:domain pm:Projection ; rdfs:range xsd:string ;
  rdfs:comment "Legacy renderer identity string conserved from projection-matrix-pack's binding renderer; was referenced undeclared there (recorded failed edge)." .
pm:emits a rdf:Property ; rdfs:domain pm:Projection ; rdfs:range xsd:string ;
  rdfs:comment "Legacy renderer output-path echo conserved from projection-matrix-pack; was referenced undeclared there (recorded failed edge)." .

pm:FleetInput a pm:Input ; pm:path "fixtures/core_fleet.ttl" ; pm:format "turtle" .

pm:ConsumerBindingsRule a pm:ProjectionRule ;
  pm:ruleName "consumer-bindings" ;
  pm:query "queries/consumer-bindings.rq" ;
  pm:template "templates/consumer-binding.ttl.tmpl" ;
  pm:output "generated/{{ consumer_slug }}/bindings/{{ subject_slug }}.ttl" .

pm:PackageManifestsRule a pm:ProjectionRule ;
  pm:ruleName "package-manifests" ;
  pm:query "queries/consumer-bindings.rq" ;
  pm:template "templates/package-manifest.toml.tmpl" ;
  pm:output "generated/{{ consumer_slug }}/{{ subject_slug }}/pack.toml" .

# ===== SOURCE: ontology/cs2-adapter.ttl =====
# projection-matrix-compose — cs2 adapter module (conserved from
# cs2-projection-matrix).
#
# cs2-projection-matrix minted THIS pack's exact namespace IRI
# (https://ggen.dev/ontology/projection-matrix#) with divergent terms — the
# two-owners-one-IRI collision resolved by making this pack the single pm:
# owner and absorbing the divergence as this module. pm:adapterKind is
# CONSERVED as a compose module term: the cs2 profile models the adapter slot
# as a closed kind string in place of a pm:Adapter resource. Its remaining
# in-use vocabulary (sourceRepository, consumerRepository, consumerSlug,
# enabled) was used by its fixture/query/template but never declared anywhere
# (recorded failed edge: undeclared in-use vocabulary); declared here so the
# conserved queries/cs2-projection-matrix.rq and the cs2 renderer resolve
# against the union graph.

@prefix pm: <https://ggen.dev/ontology/projection-matrix#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pm:adapterKind a rdf:Property ; rdfs:domain pm:Projection ; rdfs:range xsd:string ;
  rdfs:comment "CS2-profile adapter discriminator (closed kind string, e.g. turtle) in place of a pm:adapter resource. Exactly one of pm:adapter / pm:adapterKind must be present on a Projection (gates/010_required_identity.rq); the value must name an admitted pm:AdapterKind (gates/030_value_constraints.rq)." .

pm:AdapterKind a rdfs:Class ; rdfs:label "Adapter Kind" ;
  rdfs:comment "One admitted closed adapter-kind value. pm:adapterKind strings anti-join against this vocabulary — admit a new kind by adding ONE individual here, never by editing the gate." .
pm:kindName a rdf:Property ; rdfs:domain pm:AdapterKind ; rdfs:range xsd:string ;
  rdfs:comment "Matches a pm:Projection's pm:adapterKind literal exactly." .

pm:Kind_turtle a pm:AdapterKind ; pm:kindName "turtle" .
pm:Kind_json a pm:AdapterKind ; pm:kindName "json" .
pm:Kind_elixir a pm:AdapterKind ; pm:kindName "elixir" .

pm:sourceRepository a rdf:Property ; rdfs:domain pm:Subject ; rdfs:range xsd:string ;
  rdfs:comment "CS2-profile subject origin repository (was used undeclared in cs2-projection-matrix; recorded failed edge)." .
pm:consumerRepository a rdf:Property ; rdfs:domain pm:Consumer ; rdfs:range xsd:string ;
  rdfs:comment "CS2-profile consumer origin repository (was used undeclared in cs2-projection-matrix; recorded failed edge)." .
pm:consumerSlug a rdf:Property ; rdfs:domain pm:Consumer ; rdfs:range xsd:string ;
  rdfs:comment "CS2-profile consumer slug used in generated output paths (was used undeclared in cs2-projection-matrix; recorded failed edge)." .
pm:enabled a rdf:Property ; rdfs:domain pm:Projection ; rdfs:range xsd:boolean ;
  rdfs:comment "CS2-profile projection enablement flag (was used undeclared in cs2-projection-matrix; recorded failed edge)." .

