@prefix pm: <https://ggen.dev/ontology/projection-matrix#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
pm:Subject a rdfs:Class . pm:Consumer a rdfs:Class . pm:Adapter a rdfs:Class . pm:Projection a rdfs:Class .
pm:subject a rdf:Property ; rdfs:domain pm:Projection ; rdfs:range pm:Subject .
pm:consumer a rdf:Property ; rdfs:domain pm:Projection ; rdfs:range pm:Consumer .
pm:adapter a rdf:Property ; rdfs:domain pm:Projection ; rdfs:range pm:Adapter .
pm:targetPath a rdf:Property ; rdfs:domain pm:Projection ; rdfs:range xsd:string .
pm:sourceSha a rdf:Property ; rdfs:domain pm:Subject ; rdfs:range xsd:string .
pm:sourceDigest a rdf:Property ; rdfs:domain pm:Subject ; rdfs:range xsd:string .
pm:moduleName a rdf:Property ; rdfs:domain pm:Projection ; rdfs:range xsd:string .
pm:packageName a rdf:Property ; rdfs:domain pm:Projection ; rdfs:range xsd:string .

# Generation contract relocated from pack.toml ([[inputs]], [[projections]]),
# which the ggen pack loader does not admit (FM-PACK-003). Declared as facts;
# consumers bind them in their own ggen.toml.
pm:Input a rdfs:Class .
pm:ProjectionRule a rdfs:Class .
pm:path a rdf:Property .
pm:format a rdf:Property .
pm:query a rdf:Property .
pm:template a rdf:Property .
pm:output a rdf:Property .
pm:ruleName a rdf:Property .

pm:FleetInput a pm:Input ; pm:path "fixtures/fleet.ttl" ; pm:format "turtle" .

pm:ConsumerBindingsRule a pm:ProjectionRule ;
  pm:ruleName "consumer-bindings" ;
  pm:query "queries/consumer-bindings.rq" ;
  pm:template "templates/consumer-binding.ttl.tmpl" ;
  pm:output "generated/{{ consumer_slug }}/bindings/{{ subject_slug }}.ttl" .

pm:PackageManifestsRule a pm:ProjectionRule ;
  pm:ruleName "package-manifests" ;
  pm:query "queries/consumer-bindings.rq" ;
  pm:template "templates/package-manifest.toml.tmpl" ;
  pm:output "generated/{{ consumer_slug }}/{{ subject_slug }}/pack.toml" .
