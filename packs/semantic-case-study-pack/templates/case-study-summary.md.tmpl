---
to: case-study-summary.md
sparql:
  cases: |
    PREFIX cs: <urn:xaas:case-study:>
    SELECT ?case ?caseId ?title ?boundSubject ?authorityCeiling ?evidenceCeiling ?humanGate WHERE {
      ?case a cs:CaseStudy ; cs:caseId ?caseId ; cs:boundSubject ?boundSubject ;
            cs:authorityCeiling ?authorityCeiling ; cs:evidenceCeiling ?evidenceCeiling .
      OPTIONAL { ?case cs:title ?title }
      OPTIONAL { ?case cs:humanGate ?humanGate }
    } ORDER BY ?caseId
  claims: |
    PREFIX cs: <urn:xaas:case-study:>
    SELECT ?claimId ?claimText ?standing ?evidencePath ?exactSubject ?authorityCeiling WHERE {
      ?claim a cs:Claim ; cs:claimId ?claimId ; cs:claimText ?claimText ; cs:standing ?standing ;
             cs:authorityCeiling ?authorityCeiling ; cs:supportedBy ?evidence .
      ?evidence cs:evidencePath ?evidencePath ; cs:exactSubject ?exactSubject .
    } ORDER BY ?claimId
  nonclaims: |
    PREFIX cs: <urn:xaas:case-study:>
    SELECT ?nonClaimId ?nonClaimLabel WHERE {
      ?nc a cs:NonClaim ; cs:nonClaimId ?nonClaimId ; cs:nonClaimLabel ?nonClaimLabel .
    } ORDER BY ?nonClaimId
  assumptions: |
    PREFIX cs: <urn:xaas:case-study:>
    SELECT ?assumptionId ?question ?interimAssumption ?answerStatus WHERE {
      ?a a cs:Assumption ; cs:assumptionId ?assumptionId ; cs:question ?question ;
         cs:interimAssumption ?interimAssumption ; cs:answerStatus ?answerStatus .
    } ORDER BY ?assumptionId
  falsifiers: |
    PREFIX cs: <urn:xaas:case-study:>
    SELECT ?falsifierId ?falsifierObservation ?falsifierCommand WHERE {
      ?f a cs:Falsifier ; cs:falsifierId ?falsifierId ; cs:falsifierObservation ?falsifierObservation .
      OPTIONAL { ?f cs:falsifierCommand ?falsifierCommand }
    } ORDER BY ?falsifierId
---
