@prefix cs: <urn:xaas:case-study:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix min: <urn:example:semantic-case-study:minimal:> .

# PASS witness shared by all four gate stems: one minimal honest case study
# that satisfies every SHACL shape and returns zero rows from every gate.
# Bound to the exact authoring head of this pack. Repository-local fixture
# evidence only; authority ceiling CONSTRUCT; human gate disclosed.

min:case a cs:CaseStudy ;
  cs:caseId "minimal-pass" ;
  cs:title "Minimal honest case study" ;
  cs:boundSubject "seanchatmangpt/ggen-marketplace@f491458bfd673df7f816c092f6cfe7dc4c3f5acf" ;
  cs:authorityCeiling "CONSTRUCT" ;
  cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ;
  cs:humanGate "ENGINEER_DISPOSITION_REQUIRED" ;
  cs:currentConformance "REPO_LOCAL_FIXTURE" .

min:e01 a cs:Evidence ; cs:evidenceId "E01" ;
  cs:evidencePath "packs/semantic-case-study-pack/witnesses/pass/010_claim_requires_evidence.ttl" ;
  cs:exactSubject "seanchatmangpt/ggen-marketplace@f491458bfd673df7f816c092f6cfe7dc4c3f5acf" ;
  cs:validator "python3 packs/semantic-case-study-pack/runners/semantic_runner.py" ;
  cs:result "PASS witness: SHACL conforms, 0 gate refusal rows" .

min:f01 a cs:Falsifier ; cs:falsifierId "F01" ;
  cs:falsifierCommand "python3 packs/semantic-case-study-pack/runners/semantic_runner.py --gate gates/010_claim_requires_evidence.rq --witness witnesses/fail/010_claim_requires_evidence.ttl --expectation fail" ;
  cs:falsifierObservation "The fail witness for this gate returns zero refusal rows, or the pass witness stops conforming." .

min:c01 a cs:Claim ; cs:claimId "C01" ; cs:claimOf min:case ;
  cs:claimText "The bound subject contains this pack's witnesses and gates exactly as cited." ;
  cs:standing "ALIVE_FIXTURE" ;
  cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "SELECT" ;
  cs:supportedBy min:e01 ; cs:falsifiedBy min:f01 ;
  cs:renderedBy min:deck .

min:deck a cs:Projection ; cs:projectionOf min:case ; cs:rendersClaim min:c01 .
