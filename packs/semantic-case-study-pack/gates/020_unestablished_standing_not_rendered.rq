# MESSAGE: a claim whose standing is unestablished (UNKNOWN, BLOCKED,
# BUILD_BROKEN, UNSUPPORTED, or a typed REFUSED_*) must never be rendered as
# a supported claim in any projection. UNKNOWN != SUPPORTED, and a blocked or
# refused element cannot borrow the surface of a slide to become supported.
# DESIGN and ALIVE/PARTIAL_ALIVE claims may render: DESIGN is an honestly
# argued state (the seed's WD deck renders it while disclosing assumptions
# via cs:dependsOn), and PARTIAL_ALIVE discloses its own partiality.
#
# Each row names the projection element, the unestablished claim, and the
# standing that must not be rendered as supported.
PREFIX cs: <urn:xaas:case-study:>

SELECT ?subject ?claim ?standing WHERE {
  ?claim a cs:Claim ;
         cs:standing ?standing ;
         cs:renderedBy ?subject .
  FILTER(?standing IN ("UNKNOWN", "BLOCKED", "BUILD_BROKEN", "UNSUPPORTED")
         || STRSTARTS(?standing, "REFUSED_"))
}
ORDER BY ?subject ?claim
