# MESSAGE: the authority ceiling of a case or a claim admits only NONE,
# SELECT, and CONSTRUCT. SELECT != CONSTRUCT != DO (no unreceipted
# actuation): a ceiling of DO, ACTUATE, EXECUTE -- or any other value outside
# the admitted set -- is refused wherever it is asserted. A case study
# documents; it never actuates.
#
# Each row names the offending subject, its ceiling value, and the reason.
PREFIX cs: <urn:xaas:case-study:>

SELECT ?subject ?ceiling ?reason WHERE {
  ?subject cs:authorityCeiling ?ceiling .
  FILTER(?ceiling NOT IN ("NONE", "SELECT", "CONSTRUCT"))
  BIND("authority-ceiling-exceeds-CONSTRUCT" AS ?reason)
}
ORDER BY ?subject
