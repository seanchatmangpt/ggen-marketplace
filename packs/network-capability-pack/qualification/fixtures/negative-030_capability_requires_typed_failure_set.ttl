# FIRES ONLY gates/030_capability_requires_typed_failure_set.rq:
# Remote.Ping models a failure outcome (tls-error) but never the universal
# dns-failure/connect-timeout classes, so name-resolution and transport failures
# are silently absorbable.
@prefix ncap:    <https://ggen.dev/ontology/network-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ncap:neg-thin-failures a ncap:Capability ;
    dcterms:identifier "Remote.Ping" ;
    ncap:consequenceClass "READ" ;
    ncap:input "endpoint" ;
    ncap:output "latency" ;
    ncap:hasPrecondition ncap:precondition-endpoint-resolution ;
    ncap:hasOutcome ncap:outcome-success, ncap:failure-tls-error ;
    ncap:requiresEvidence "earl:request-response-receipt" ;
    ncap:requiresAuthority false ;
    ncap:determinism "nondeterministic" ;
    ncap:retryClass "idempotent-retry" ;
    ncap:realizedBy ncap:neg-thin-realization .

ncap:neg-thin-realization a ncap:Realization ;
    dcterms:identifier "fixture.ping-step-thin-failures" ;
    ncap:qualificationCondition "fixture-scoped provider pinned by consumer lock" .
