# FIRES ONLY gates/020_realization_requires_qualification_conditions.rq:
# the realization of Remote.Ping states no ncap:qualificationCondition, so it
# admits itself (Generated != Admitted violation).
@prefix ncap:    <https://ggen.dev/ontology/network-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ncap:neg-ping a ncap:Capability ;
    dcterms:identifier "Remote.Ping" ;
    ncap:consequenceClass "READ" ;
    ncap:input "endpoint" ;
    ncap:output "latency" ;
    ncap:hasPrecondition ncap:precondition-endpoint-resolution ;
    ncap:hasOutcome ncap:outcome-success, ncap:failure-dns-failure, ncap:failure-connect-timeout ;
    ncap:requiresEvidence "earl:request-response-receipt" ;
    ncap:requiresAuthority false ;
    ncap:determinism "nondeterministic" ;
    ncap:retryClass "idempotent-retry" ;
    ncap:realizedBy ncap:neg-unconditioned-realization .

ncap:neg-unconditioned-realization a ncap:Realization ;
    dcterms:identifier "fixture.ping-step-unconditioned" .
