# positive.ttl -- minimal COMPLETE capability instance. Union of ontology.ttl and
# this file must yield ZERO rows under every gate (the ontology's own eight
# capabilities are the primary positive instance; this fixture adds a
# fixture-scoped READ and DO capability exercising the same contract).
@prefix ncap:    <https://ggen.dev/ontology/network-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ncap:pos-get a ncap:Capability ;
    dcterms:identifier "Pos.Get" ;
    ncap:consequenceClass "READ" ;
    ncap:input "url" ;
    ncap:output "response" ;
    ncap:hasPrecondition ncap:precondition-endpoint-resolution ;
    ncap:hasOutcome ncap:outcome-success, ncap:failure-dns-failure, ncap:failure-connect-timeout,
        ncap:failure-read-timeout, ncap:failure-http-4xx, ncap:failure-http-5xx, ncap:failure-tls-error ;
    ncap:requiresEvidence "earl:request-response-receipt" ;
    ncap:requiresAuthority false ;
    ncap:determinism "nondeterministic" ;
    ncap:retryClass "idempotent-retry" ;
    ncap:realizedBy ncap:pos-real-get .

ncap:pos-real-get a ncap:Realization ;
    dcterms:identifier "fixture.get-step" ;
    ncap:providerModule "fixture.GetStep" ;
    ncap:providerRepo "https://fixture.invalid/network-capability-pack" ;
    ncap:qualificationCondition "fixture-scoped provider pinned by consumer lock" .

ncap:pos-post a ncap:Capability ;
    dcterms:identifier "Pos.Post" ;
    ncap:consequenceClass "DO" ;
    ncap:input "url" ; ncap:input "body" ;
    ncap:output "response" ;
    ncap:hasPrecondition ncap:precondition-endpoint-resolution ;
    ncap:hasOutcome ncap:outcome-success, ncap:failure-dns-failure, ncap:failure-connect-timeout,
        ncap:failure-read-timeout, ncap:failure-http-4xx, ncap:failure-http-5xx, ncap:failure-tls-error ;
    ncap:requiresEvidence "earl:request-response-receipt" ;
    ncap:requiresAuthority true ;
    ncap:authorityScope "consequential-endpoint" ;
    ncap:determinism "nondeterministic" ;
    ncap:retryClass "no-retry" ;
    ncap:realizedBy ncap:pos-real-post .

ncap:pos-real-post a ncap:Realization ;
    dcterms:identifier "fixture.post-step" ;
    ncap:providerModule "fixture.PostStep" ;
    ncap:providerRepo "https://fixture.invalid/network-capability-pack" ;
    ncap:qualificationCondition "fixture-scoped provider pinned by consumer lock" .
