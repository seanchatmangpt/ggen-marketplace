---
to: "nextjs-ai-sdk-ui-shadcn-pack/components/ui/{{ row.lower }}.tsx"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_nextjs_ai_sdk_ui_shadcn_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}"use client";

import { forwardRef, type {% endraw %}{{ row.capitalized }}{% raw %}HTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "@/lib/utils";

const {% endraw %}{{ row.lower }}{% raw %}Variants = cva("inline-flex items-center justify-center gap-2 rounded-md text-sm font-medium transition-colors disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring", {
  variants: {
    variant: { default: "bg-primary text-primary-foreground hover:bg-primary/90", outline: "border bg-background hover:bg-accent", ghost: "hover:bg-accent" },
    size: { default: "h-9 px-4 py-2", icon: "size-9", "icon-sm": "size-8" },
  },
  defaultVariants: { variant: "default", size: "default" },
});

export type {% endraw %}{{ row.capitalized }}{% raw %}Props = {% endraw %}{{ row.capitalized }}{% raw %}HTMLAttributes<HTMLButtonElement> & VariantProps<typeof {% endraw %}{{ row.lower }}{% raw %}Variants>;
export const {% endraw %}{{ row.capitalized }}{% raw %} = forwardRef<HTMLButtonElement, {% endraw %}{{ row.capitalized }}{% raw %}Props>(({ className, variant, size, ...props }, ref) => <{% endraw %}{{ row.lower }}{% raw %} ref={ref} className={cn({% endraw %}{{ row.lower }}{% raw %}Variants({ variant, size }), className)} {...props} />);
{% endraw %}{{ row.capitalized }}{% raw %}.displayName = "{% endraw %}{{ row.capitalized }}{% raw %}";
{% endraw %}