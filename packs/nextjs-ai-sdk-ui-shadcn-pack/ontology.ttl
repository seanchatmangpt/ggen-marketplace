@prefix pack: <urn:ggen-marketplace:nextjs-ai-sdk-ui-shadcn-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:Project a pack:SourceProject ;
    rdfs:label "nextjs-ai-sdk" ;
    pack:sourcePath "/Users/sac/ggen/examples/nextjs-ai-sdk"^^xsd:string ;
    pack:framework "Next.js 16 / React 19" ;
    pack:packageManager "pnpm@10.14.0" ;
    pack:hasShadcnConfig true ;
    pack:usesDeckGl false ;
    rdfs:comment "Admitted from a real filesystem scan of package.json, components.json, and the app/components/lib source trees on 2026-08-17. No copied source; this pack records only observed facts." .

pack:ComponentsJsonConfig a pack:ShadcnConfig ;
    pack:filePath "components.json" ;
    pack:style "new-york" ;
    pack:uiAlias "@/components/ui" ;
    rdfs:comment "shadcn CLI config is present with style=new-york and iconLibrary=lucide, indicating the project was scaffolded for shadcn, but see pack:Button for the extent of actual usage." .

pack:Button a pack:ShadcnComponent ;
    rdfs:label "Button" ;
    pack:filePath "components/ui/button.tsx" ;
    pack:usesCva true ;
    pack:usesCn true ;
    rdfs:comment "Only shadcn-style primitive found under components/ui/. Built with class-variance-authority (buttonVariants) and the cn() helper from lib/utils.ts, matching the shadcn composition pattern, but is NOT Radix-backed: no @radix-ui/* package appears in package.json dependencies or devDependencies." .

pack:CnUtility a pack:HelperFunction ;
    rdfs:label "cn" ;
    pack:filePath "lib/utils.ts" ;
    pack:implementation "clsx + tailwind-merge" ;
    rdfs:comment "Canonical shadcn className-merging helper; confirmed present and used, not just declared." .

pack:ToolElement a pack:ConsumerOfCn ;
    rdfs:label "components/ai-elements/tool.tsx" ;
    pack:filePath "components/ai-elements/tool.tsx" ;
    rdfs:comment "Bespoke AI SDK chat UI component that imports cn(); not a shadcn-generated file itself." .

pack:ConfirmationElement a pack:ConsumerOfCn ;
    rdfs:label "components/ai-elements/confirmation.tsx" ;
    pack:filePath "components/ai-elements/confirmation.tsx" ;
    rdfs:comment "Bespoke component consuming cn(); not a shadcn-generated file." .

pack:PromptInputElement a pack:ConsumerOfCn ;
    rdfs:label "components/ai-elements/prompt-input.tsx" ;
    pack:filePath "components/ai-elements/prompt-input.tsx" ;
    rdfs:comment "Bespoke component consuming cn(); not a shadcn-generated file." .

pack:MessageElement a pack:ConsumerOfCn ;
    rdfs:label "components/ai-elements/message.tsx" ;
    pack:filePath "components/ai-elements/message.tsx" ;
    rdfs:comment "Bespoke component consuming cn(); not a shadcn-generated file." .

pack:ConversationElement a pack:ConsumerOfCn ;
    rdfs:label "components/ai-elements/conversation.tsx" ;
    pack:filePath "components/ai-elements/conversation.tsx" ;
    rdfs:comment "Bespoke component consuming cn(); not a shadcn-generated file." .

pack:DeckGlFinding a pack:NegativeFinding ;
    rdfs:label "deck.gl absent" ;
    rdfs:comment "Grepped package.json and all .tsx/.ts source for 'deck.gl', 'DeckGL', 'Layer', 'ScatterplotLayer', 'GeoJsonLayer', 'HexagonLayer', 'ArcLayer', and viewport/view-state code. Zero matches anywhere in the project. deck.gl is not a dependency and not used; there is no partial or dead usage to record." .

pack:RadixFinding a pack:NegativeFinding ;
    rdfs:label "radix-ui absent" ;
    rdfs:comment "Grepped package.json for 'radix'. No @radix-ui/* package appears in dependencies or devDependencies, despite components.json configuring a shadcn 'new-york' style that upstream normally implies Radix primitives. pack:Button is therefore a hand-rolled shadcn-shaped component, not a full shadcn/Radix component." .
@prefix gc: <https://ggen.io/ontology/ggen-create#> .

gc:gc_subject_nextjs_ai_sdk_ui_shadcn_pack a gc:GenerationSubject ;
    gc:name "button" ;
    gc:upper "BUTTON" ;
    gc:lower "button" ;
    gc:capitalized "Button" ;
    gc:pascal "Button" ;
    gc:camel "button" ;
    gc:snake "button" ;
    gc:upper_snake "BUTTON" ;
    gc:kebab "button" ;
    gc:title "Button" .
