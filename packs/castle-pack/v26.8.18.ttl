@prefix castle: <https://chatmangpt.com/ontology/castle#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# CASTLE v26.8.18 extension ontology. This module extends, rather than
# duplicates, ontology.ttl so existing generated Binding/Fortune5Requirement
# projections remain source-authoritative while the global runtime gains a
# public semantic vocabulary.

castle:GlobalConstitution a rdfs:Class, prov:Entity ;
  rdfs:label "CASTLE global constitution" .
castle:CastleCell a rdfs:Class, prov:Entity ;
  rdfs:label "CASTLE regional authority cell" .
castle:AdapterBinding a rdfs:Class, prov:Entity ;
  rdfs:label "Bounded provider adapter binding" .
castle:ProtocolSurface a rdfs:Class, prov:Entity ;
  rdfs:label "Transport-normalized protocol surface" .
castle:ObservationAdmission a rdfs:Class, prov:Entity ;
  rdfs:label "O to O-star admission" .
castle:AirgapBundle a rdfs:Class, prov:Entity ;
  rdfs:label "Zero-network zero-secret CONSTRUCT bundle" .
castle:BRCEPrepareReceipt a rdfs:Class, prov:Entity ;
  rdfs:label "Receipt manufactured before consequential actuation" .
castle:BRCEOutcomeReceipt a rdfs:Class, prov:Entity ;
  rdfs:label "Receipt binding observed provider consequence" .
castle:ReceiptCheckpoint a rdfs:Class, prov:Entity ;
  rdfs:label "Monotonic cross-cell receipt checkpoint" .
castle:ReconciliationDecision a rdfs:Class, prov:Entity ;
  rdfs:label "Consequence reconciliation decision" .
castle:ChaosEvidence a rdfs:Class, prov:Entity ;
  rdfs:label "Receipted failure-domain exercise evidence" .
castle:CryptoProfile a rdfs:Class, prov:Entity ;
  rdfs:label "Cryptographic capability admission profile" .
castle:RuntimeExecutionRequest a rdfs:Class, prov:Entity ;
  rdfs:label "Portable CONSTRUCT-to-DO request" .
castle:ConstructCheckpoint a rdfs:Class, prov:Entity ;
  rdfs:label "Deterministic inert CONSTRUCT identity checkpoint" .
castle:ProviderSemanticsVersion a rdfs:Class, prov:Entity ;
  rdfs:label "Versioned provider semantics identity" .

castle:provider a rdf:Property .
castle:region a rdf:Property .
castle:authorityDomain a rdf:Property .
castle:residency a rdf:Property .
castle:subjectPrefix a rdf:Property .
castle:workloadIdentity a rdf:Property .
castle:ambientCredentials a rdf:Property .
castle:allowedTransition a rdf:Property .
castle:providerSemanticsKey a rdf:Property .
castle:providerSemanticsVersion a rdf:Property .
castle:constitutionId a rdf:Property .
castle:ontologyVersion a rdf:Property .
castle:invariantSetDigest a rdf:Property .
castle:receiptHeadDigest a rdf:Property .
castle:sequence a rdf:Property .
castle:standing a rdf:Property .
castle:replayAllowed a rdf:Property .
castle:identityHash a rdf:Property .
castle:signatureSuite a rdf:Property .
castle:defaultAuthority a rdf:Property .
castle:requiresConstructCheckpoint a rdf:Property .
castle:requiresPrepareReceipt a rdf:Property .

castle:v26-8-18-global-release a prov:Entity, odrl:Policy ;
  dcterms:title "CASTLE v26.8.18 Fortune-5 Global Cloud" ;
  dcterms:hasVersion "26.8.18" ;
  dcterms:description "Cellular global authority fabric with admitted O-star observations, deterministic CONSTRUCT checkpoints, BRCE-wrapped DO, regional receipt durability, semantic replay invalidation, air-gap CONSTRUCT, typed reconciliation, chaos qualification, and crypto-suite admission." ;
  castle:defaultAuthority "CONSTRUCT_ONLY" ;
  castle:requiresConstructCheckpoint true ;
  castle:requiresPrepareReceipt true ;
  prov:wasDerivedFrom castle:fortune5-readiness-profile .

castle:v26-8-18-crypto-profile a castle:CryptoProfile ;
  castle:identityHash "blake3-256", "sha256" ;
  castle:signatureSuite "ed25519" ;
  dcterms:description "BLAKE3-256 remains canonical Castle content identity; SHA-256 is emitted for enterprise interoperability. Unimplemented PQC suites are explicitly UNSUPPORTED rather than inferred." .

castle:v26-8-18-brce-policy a odrl:Policy ;
  dcterms:title "Zero unreceipted actuation" ;
  dcterms:description "A provider transition has no official DO standing without an admitted CONSTRUCT, a pre-actuation BRCE receipt, an observed outcome receipt, and OCEL evidence." ;
  castle:requiresConstructCheckpoint true ;
  castle:requiresPrepareReceipt true .

castle:v26-8-18-cell-policy a odrl:Policy ;
  dcterms:title "Cellular least authority" ;
  dcterms:description "Failure domain approximates authority domain. Cells bind provider, region, residency, subject scope, workload identity, transition allowlist, local receipt durability, and provider semantics. Ambient credentials are refused." ;
  castle:ambientCredentials false .

castle:v26-8-18-reconciliation-policy a odrl:Policy ;
  dcterms:title "Unknown consequence is not replay authority" ;
  dcterms:description "If provider consequence cannot be established after PREPARE, standing is UNKNOWN:CONSEQUENCE_UNCONFIRMED and automatic replay is prohibited until reconciliation closes the transition." ;
  castle:standing "UNKNOWN:CONSEQUENCE_UNCONFIRMED" ;
  castle:replayAllowed false .

castle:v26-8-18-airgap-policy a odrl:Policy ;
  dcterms:title "Air-gap CONSTRUCT" ;
  dcterms:description "Air-gap CONSTRUCT bundles have zero network and secret dependencies. Returned results remain CONSTRUCT-only and lose standing if network or secret material was used." ;
  castle:defaultAuthority "CONSTRUCT_ONLY" .

castle:v26-8-18-protocol-policy a odrl:Policy ;
  dcterms:title "Protocol parity without ambient authority" ;
  dcterms:description "CLI, API, MCP, A2A, human, planner, and replay inputs normalize into SELECT, CONSTRUCT, or DO intents. Transport authentication alone never creates DO authority." ;
  castle:defaultAuthority "CONSTRUCT_ONLY" .
