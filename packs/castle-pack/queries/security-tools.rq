PREFIX castle: <https://chatmangpt.com/ontology/castle#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?id ?ecosystem ?nativeSurface ?normalizedOutput ?boundary
WHERE {
  ?tool a castle:SecurityTool ;
    dcterms:identifier ?id ;
    castle:ecosystem ?ecosystem ;
    castle:nativeSurface ?nativeSurface ;
    castle:normalizedOutput ?normalizedOutput ;
    castle:toolBoundary ?boundary ;
    castle:directActuationAuthority false .
}
ORDER BY ?id
