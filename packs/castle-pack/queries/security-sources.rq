PREFIX castle: <https://chatmangpt.com/ontology/castle#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?id ?authority ?version ?versionPolicy ?kind ?machineSurface ?sourceUri
WHERE {
  ?source a castle:SecuritySource ;
    dcterms:identifier ?id ;
    castle:authority ?authority ;
    castle:versionLabel ?version ;
    castle:versionPolicy ?versionPolicy ;
    castle:securityKind ?kind ;
    castle:machineSurface ?machineSurface ;
    castle:sourceUri ?sourceUri .
}
ORDER BY ?id
