PREFIX castle: <https://chatmangpt.com/ontology/castle#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?kind ?order ?identifier ?slug ?role ?authority ?predicate ?consequence
WHERE {
  ?binding a castle:Binding ;
    castle:kind ?kind ;
    castle:order ?order ;
    castle:identifier ?identifier ;
    castle:slug ?slug ;
    dcterms:description ?role ;
    castle:authority ?authority ;
    castle:predicate ?predicate ;
    castle:consequence ?consequence .
}
ORDER BY ?order
