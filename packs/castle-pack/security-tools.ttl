@prefix castle: <https://chatmangpt.com/ontology/castle#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

castle:SecurityTool a rdfs:Class ; rdfs:subClassOf prov:Entity .
castle:ecosystem a rdf:Property .
castle:nativeSurface a rdf:Property .
castle:normalizedOutput a rdf:Property .
castle:toolBoundary a rdf:Property .
castle:directActuationAuthority a rdf:Property .

# Tool rows describe evidence/admission bridges only. Every row is explicitly
# denied ambient CASTLE DO authority; native enforcers remain behind CASTLE admission.
castle:tool-aws-security-hub a castle:SecurityTool ; dcterms:identifier "aws-security-hub" ; castle:ecosystem "AWS" ; castle:nativeSurface "Security Hub findings / ASFF" ; castle:normalizedOutput "OCSF/STIX/evidence" ; castle:toolBoundary "ObserveOnly" ; castle:directActuationAuthority false .
