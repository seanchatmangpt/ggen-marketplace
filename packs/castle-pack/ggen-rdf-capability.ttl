@prefix castle: <https://chatmangpt.com/ontology/castle#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Imported semantic capability declaration. The primary CASTLE ontology remains
# stable; this module binds its RDF execution plane to one exact ggen subject.
castle:ggen-rdf-control-plane a castle:Binding, castle:Component, prov:SoftwareAgent ;
  castle:kind "component" ;
  castle:order 5 ;
  castle:identifier "GgenRDFControlPlane" ;
  castle:slug "ggen-rdf-control-plane" ;
  dcterms:description "Provide CASTLE RDF parsing, deterministic canonical graph state, BLAKE3 graph hashing, SPARQL SELECT/ASK/CONSTRUCT, property-path traversal, and GraphLaw semantic validation through the exact-revision ggen-engine capability." ;
  dcterms:source <https://github.com/seanchatmangpt/ggen> ;
  dcterms:identifier "ggen-engine@26.8.15#162e466d8f07d0a75a468b4441b4bc8b1aad369b" ;
  castle:authority "SEMANTIC_ONLY" ;
  castle:predicate "semantic:ggen-engine@26.8.15#162e466d8f07d0a75a468b4441b4bc8b1aad369b" ;
  castle:consequence 0 .

# The goal calculus and dependency CONSTRUCT consume admitted semantic graph
# facts; neither is permitted to silently replace the RDF engine with local
# parser/query semantics.
castle:dfcm-goal-inversion dcterms:requires castle:ggen-rdf-control-plane .
castle:dependency-construct dcterms:requires castle:ggen-rdf-control-plane .
