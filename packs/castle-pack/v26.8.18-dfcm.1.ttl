@prefix castle: <https://chatmangpt.com/ontology/castle#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# CASTLE v26.8.18+dfcm.1 closure ontology. This module extends the immutable
# v26.8.18 semantic release. It deliberately adds no castle:Binding or
# castle:Fortune5Requirement instances, so existing generated consumer
# projections remain consequences of their existing owning RDF facts.

castle:DfcmClosureQualification a rdfs:Class, prov:Entity ;
  rdfs:label "DfCM whole-subject closure qualification" .
castle:PqcRuntimeProof a rdfs:Class, prov:Entity ;
  rdfs:label "Executed post-quantum signature runtime proof" .
castle:ReadOnlyProviderProbe a rdfs:Class, prov:Activity ;
  rdfs:label "Typed bounded read-only provider observation" .
castle:LiveProviderObservation a rdfs:Class, prov:Entity ;
  rdfs:label "Fresh observed live-provider evidence" .
castle:ProviderPolicyBinding a rdfs:Class, prov:Entity ;
  rdfs:label "Adapter binding admitted against exact provider command policy" .
castle:BoundRuntimeConfig a rdfs:Class, prov:Entity ;
  rdfs:label "Runtime configuration included in deterministic CONSTRUCT identity" .
castle:DurableReplicaState a rdfs:Class, prov:Entity ;
  rdfs:label "Content-verified persistent cross-cell receipt replica state" .
castle:ProtocolDispatchAdmission a rdfs:Class, prov:Entity ;
  rdfs:label "Transport admission distinct from in-process DO admission" .
castle:LiveDeploymentQualification a rdfs:Class, prov:Entity ;
  rdfs:label "Static plus live adapter deployment qualification" .

castle:probePurpose a rdf:Property .
castle:programFamily a rdf:Property .
castle:identityBindingVerified a rdf:Property .
castle:observationDigest a rdf:Property .
castle:observedAt a rdf:Property .
castle:maxEvidenceAge a rdf:Property .
castle:adapterPolicyBound a rdf:Property .
castle:evidenceStoreBound a rdf:Property .
castle:replicaStateDigest a rdf:Property .
castle:transportStanding a rdf:Property .
castle:requiresLiveEvidence a rdf:Property .
castle:pqcParameterSet a rdf:Property .
castle:runtimeProofRequired a rdf:Property .
castle:arbitraryArgumentsAllowed a rdf:Property .
castle:inheritedEnvironmentAllowed a rdf:Property .

castle:v26-8-18-dfcm-1-release a prov:Entity, odrl:Policy ;
  dcterms:title "CASTLE v26.8.18+dfcm.1 DfCM Full Closure" ;
  dcterms:hasVersion "26.8.18+dfcm.1" ;
  dcterms:description "Closure release binding exact provider policy and evidence sink into CONSTRUCT identity, executing real ML-DSA and SLH-DSA self-proofs, manufacturing typed read-only live-provider observations, preserving durable monotonic receipt replication, and separating transport admission from consequential DO standing." ;
  castle:defaultAuthority "CONSTRUCT_ONLY" ;
  castle:requiresConstructCheckpoint true ;
  castle:requiresPrepareReceipt true ;
  castle:requiresLiveEvidence true ;
  prov:wasDerivedFrom castle:v26-8-18-global-release .

castle:v26-8-18-dfcm-1-runtime-binding-policy a odrl:Policy ;
  dcterms:title "Provider policy is part of CONSTRUCT identity" ;
  dcterms:description "Cell identity, evidence-store identity, caller configuration, exact provider program/arguments, transition allowlist and workload identity are serialized into the deterministic runtime configuration before CONSTRUCT capability manufacture. Changing any bound field changes the CONSTRUCT digest and invalidates a prior DO checkpoint." ;
  castle:adapterPolicyBound true ;
  castle:evidenceStoreBound true ;
  castle:requiresConstructCheckpoint true .

castle:v26-8-18-dfcm-1-live-observation-policy a odrl:Policy ;
  dcterms:title "Static topology is not live standing" ;
  dcterms:description "A statically valid CastleCell becomes a live ALIVE subject only from fresh version and authority-context observations for every admitted adapter. Missing evidence is UNKNOWN, unavailable provider observation is BLOCKED, and identity or provider-semantic mismatch is REFUSED." ;
  castle:requiresLiveEvidence true ;
  castle:defaultAuthority "OBSERVATION_ONLY" .

castle:v26-8-18-dfcm-1-probe-policy a odrl:Policy ;
  dcterms:title "Typed read-only probe law" ;
  dcterms:description "Provider probes use a closed operation vocabulary with fixed argument vectors, bounded output/time, no shell, and no inherited ambient environment. Probe success is evidence only and never provider mutation authority." ;
  castle:arbitraryArgumentsAllowed false ;
  castle:inheritedEnvironmentAllowed false ;
  castle:defaultAuthority "OBSERVATION_ONLY" .

castle:v26-8-18-dfcm-1-protocol-policy a odrl:Policy ;
  dcterms:title "Transport admission is not DO admission" ;
  dcterms:description "SELECT and CONSTRUCT may be ALIVE at the transport layer because they are inert. Even a fully receipt-shaped DO intent is only PARTIAL_ALIVE at transport admission and must re-enter the opaque in-process ConstructAdmission and BRCE path before consequential execution." ;
  castle:transportStanding "PARTIAL_ALIVE:DO_INTENT_REQUIRES_IN_PROCESS_ADMISSION" ;
  castle:defaultAuthority "CONSTRUCT_ONLY" .

castle:v26-8-18-dfcm-1-pqc-profile a castle:CryptoProfile, castle:PqcRuntimeProof ;
  dcterms:title "Executed FIPS-204/FIPS-205 algorithm runtime" ;
  dcterms:description "CASTLE ships executable ML-DSA-65 and SLH-DSA-SHAKE-128f sign/verify self-tests and refuses runtime standing if either execution fails. Algorithm implementation is not itself a production trust-root grant or external certification." ;
  castle:identityHash "blake3-256", "sha256" ;
  castle:signatureSuite "ed25519", "ml-dsa", "slh-dsa" ;
  castle:pqcParameterSet "ML-DSA-65", "SLH-DSA-SHAKE-128f" ;
  castle:runtimeProofRequired true .

castle:v26-8-18-dfcm-1-replication-policy a odrl:Policy ;
  dcterms:title "Durable monotonic replica state" ;
  dcterms:description "Receipt checkpoints are admitted monotonically, serialized inside a BLAKE3-verifying envelope, fsynced and atomically renamed. Reload verifies the envelope digest before it may protect against rollback or equivocation." .

castle:v26-8-18-dfcm-1-closure-policy a odrl:Policy ;
  dcterms:title "DfCM whole-subject crown" ;
  dcterms:description "Whole live deployment standing is ALIVE only when static deployment, exact live adapter evidence, accepted crypto profile, executed PQC runtime proof and protocol authority fence are simultaneously ALIVE. A missing live edge remains UNKNOWN rather than being inferred from a green build." ;
  castle:requiresLiveEvidence true ;
  castle:runtimeProofRequired true .
