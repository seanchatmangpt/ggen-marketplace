# MESSAGE: P1 data-provenance gate — batch record without an isolated storage scope.
# Every p11:BatchRecord must reference a p11:IsolatedStorageScope carrying a
# per-batch p11:journalPath (per-batch journal path law: one journal per batch,
# never a shared journal). A row is a refusal.
PREFIX p11:  <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?record WHERE {
  ?record a/rdfs:subClassOf* p11:BatchRecord .
  FILTER NOT EXISTS {
    ?record p11:hasJournalScope ?scope .
    ?scope a p11:IsolatedStorageScope ;
           p11:journalPath ?path .
  }
}
ORDER BY ?record
