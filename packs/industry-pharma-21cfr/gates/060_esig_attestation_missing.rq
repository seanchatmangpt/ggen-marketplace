# MESSAGE: P2 SKR/attestation gate — e-signature without an attestation fingerprint.
# Every p11:ESignature must carry p11:attestationFingerprint — a sha256:...
# measurement fingerprint over key material (the AZ-2 SKR shape). A row is a refusal.
PREFIX p11:  <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#>
SELECT ?sig WHERE {
  ?sig a p11:ESignature .
  FILTER NOT EXISTS {
    ?sig p11:attestationFingerprint ?fp .
    FILTER(STRSTARTS(STR(?fp), "sha256:"))
  }
}
ORDER BY ?sig
