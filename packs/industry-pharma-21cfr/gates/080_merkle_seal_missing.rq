# MESSAGE: P5 Merkle seal gate — completed record without a sealed Merkle root.
# Every BatchRecord with p11:completionStatus "completed" must reference a
# p11:MerkleSeal carrying p11:sealedRoot (sha256:...) and a 320-byte
# p11:receiptDigest. A row is a refusal.
PREFIX p11:  <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?record WHERE {
  ?record a/rdfs:subClassOf* p11:BatchRecord ;
          p11:completionStatus "completed" .
  FILTER NOT EXISTS {
    ?record p11:hasMerkleSeal ?seal .
    ?seal a p11:MerkleSeal ;
          p11:sealedRoot ?root ;
          p11:receiptDigest ?digest .
    FILTER(STRSTARTS(STR(?root), "sha256:"))
  }
}
ORDER BY ?record
