# MESSAGE: deviation without a linked CAPA (21 CFR 211.192 / Part 11 quality loop).
# Every p11:Deviation must carry a p11:hasCapa to a p11:CAPA with a p11:action.
# A row is a refusal.
PREFIX p11:  <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#>
SELECT ?deviation WHERE {
  ?deviation a p11:Deviation .
  FILTER NOT EXISTS {
    ?deviation p11:hasCapa ?capa .
    ?capa p11:action ?action .
  }
}
ORDER BY ?deviation