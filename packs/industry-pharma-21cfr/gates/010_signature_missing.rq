# MESSAGE: electronic record without a PROV-O-attributed e-signature (21 CFR 11.50/11.70).
# Every p11:ElectronicRecord must carry an p11:eSignature bound to a prov:Agent.
# A row is a refusal.
PREFIX p11:  <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?record WHERE {
  ?record a/rdfs:subClassOf* p11:ElectronicRecord .
  FILTER NOT EXISTS {
    ?record p11:eSignature ?sig .
    ?sig prov:agent ?agent .
    ?agent a prov:Agent .
  }
}
ORDER BY ?record