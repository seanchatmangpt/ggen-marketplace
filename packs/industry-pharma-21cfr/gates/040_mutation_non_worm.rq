# MESSAGE: record mutation not written through a WORM store (Part 11 immutability).
# Every p11:RecordMutation must carry p11:writtenVia to a p11:WormStore.
# A mutation through any non-WORM path is a refusal.
PREFIX p11:  <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#>
SELECT ?mutation WHERE {
  ?mutation a p11:RecordMutation .
  FILTER NOT EXISTS {
    ?mutation p11:writtenVia ?store .
    ?store a p11:WormStore .
  }
}
ORDER BY ?mutation