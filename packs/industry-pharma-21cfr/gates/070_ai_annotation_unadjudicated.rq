# MESSAGE: P3 proposer gate — AI annotation mutating a record without adjudication.
# Every p11:QualityAnnotation with p11:aiDerived true must be p11:adjudicatedBy
# a p11:JudgeActivity carrying a p11:verdict BEFORE any mutation of the record
# it proposes. A row is a refusal.
PREFIX p11:  <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#>
SELECT ?annotation WHERE {
  ?annotation a p11:QualityAnnotation ;
              p11:aiDerived true .
  FILTER NOT EXISTS {
    ?annotation p11:adjudicatedBy ?judge .
    ?judge a p11:JudgeActivity ;
           p11:verdict ?verdict .
  }
}
ORDER BY ?annotation
