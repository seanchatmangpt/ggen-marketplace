# FAIL witness for 050_journal_scope_missing: otherwise-compliant record with NO
# isolated storage scope. The single flipped law is 050; every other gate silent
# (not completed, so the Merkle gate does not fire; signed + attested + trailed).
@prefix p11:  <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

p11:qa7 a prov:Agent .
p11:esig a p11:ESignature ;
    prov:agent p11:qa7 ;
    p11:signatureValue "PS256:ok" ;
    p11:attestationFingerprint "sha256:aa11" .
p11:trail a p11:AuditTrail ;
    p11:who "qa7" ; p11:what "create" ;
    p11:when "2026-10-21T10:00:00Z"^^xsd:dateTime ;
    p11:why "211.188" ;
    prov:endedAtTime "2026-10-21T10:00:00Z"^^xsd:dateTime .
p11:batch-noscope a p11:BatchRecord ;
    prov:wasAttributedTo p11:qa7 ;
    p11:eSignature p11:esig ;
    p11:hasAuditTrail p11:trail .
# no p11:hasJournalScope -> gate 050 must refuse (exactly one law flipped)
