# PASS witness for 020_audit_trail_missing: compliant record with complete trail
# (pillar-complete: SKR attestation fingerprint, per-batch journal scope).
@prefix p11:  <https://seanchatmangpt.github.io/packs/industry-pharma-21cfr#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

p11:qa7 a prov:Agent .
p11:esig a p11:ESignature ;
    prov:agent p11:qa7 ;
    p11:signatureValue "PS256:ok" ;
    p11:attestationFingerprint "sha256:aa11" .
p11:trail a p11:AuditTrail ;
    p11:who "qa7" ; p11:what "create" ;
    p11:when "2026-10-21T10:00:00Z"^^xsd:dateTime ;
    p11:why "211.188" ;
    prov:endedAtTime "2026-10-21T10:00:00Z"^^xsd:dateTime .
p11:scope a p11:IsolatedStorageScope ;
    p11:journalPath "journals/batch-x/journal.ndjson" .
p11:batch-x a p11:BatchRecord ;
    prov:wasAttributedTo p11:qa7 ;
    p11:eSignature p11:esig ;
    p11:hasAuditTrail p11:trail ;
    p11:hasJournalScope p11:scope .
