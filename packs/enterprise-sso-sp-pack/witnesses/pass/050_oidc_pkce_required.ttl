@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

essp:pass-sp-050 a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:pass-050" ;
    essp:spRole essp:roleSp ;
    essp:entityId "urn:sjira:sp:pass-050" ;
    essp:acsUrl "https://sjira.example/sso/oidc/callback" .

essp:pass-idp-050 a essp:ExternalIdentityProvider ;
    essp:idpId "urn:customer:idp:pass-050" ;
    essp:idpEntityId "https://idp.customer.example" ;
    essp:idpDiscoveryUrl "https://idp.customer.example/.well-known/openid-configuration" .

essp:pass-map-050 a essp:ClaimMapping ;
    essp:mappingId "pass-050" ;
    essp:hasClaimRule essp:pass-rule-050 .

essp:pass-rule-050 a essp:ClaimRule ;
    essp:idpClaimName "groups" ;
    essp:idpClaimValue "sjira-admins" ;
    essp:productRole "admin" .

essp:pass-binding-050 a essp:FederationBinding ;
    essp:bindingId "pass-050" ;
    essp:forServiceProvider essp:pass-sp-050 ;
    essp:trustsIdp essp:pass-idp-050 ;
    essp:usesProtocol essp:protocolOidc ;
    essp:tenantKey "pass" ;
    essp:clientId "sjira-pass-rp" ;
    essp:clientSecretRef "vault:sjira/sso/pass/oidc" ;
    essp:redirectUri "https://sjira.example/sso/oidc/callback" ;
    essp:pkceRequired true ;
    essp:claimMapping essp:pass-map-050 .
