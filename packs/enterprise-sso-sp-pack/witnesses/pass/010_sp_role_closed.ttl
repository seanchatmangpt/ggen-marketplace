@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Pass witness: ProductServiceProvider declares essp:roleSp → gate returns 0 rows.
essp:pass-sp a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:pass" ;
    essp:spRole essp:roleSp ;
    essp:entityId "urn:sjira:sp:pass" ;
    essp:acsUrl "https://sjira.example/sso/saml/acs" ;
    rdfs:label "pass SP" .
