@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .

essp:pass-sp-060 a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:pass-060" ;
    essp:spRole essp:roleSp ;
    essp:entityId "urn:sjira:sp:pass-060" ;
    essp:acsUrl "https://sjira.example/sso/saml/acs" .

essp:pass-idp-060 a essp:ExternalIdentityProvider ;
    essp:idpId "urn:customer:idp:pass-060" ;
    essp:idpEntityId "https://idp.customer.example/metadata" ;
    essp:idpMetadataUrl "https://idp.customer.example/metadata" .

essp:pass-map-060 a essp:ClaimMapping ;
    essp:mappingId "pass-060" ;
    essp:hasClaimRule essp:pass-rule-060 .

essp:pass-rule-060 a essp:ClaimRule ;
    essp:idpClaimName "groups" ;
    essp:idpClaimValue "sjira-readers" ;
    essp:productRole "reader" .

essp:pass-binding-060 a essp:FederationBinding ;
    essp:bindingId "pass-060" ;
    essp:forServiceProvider essp:pass-sp-060 ;
    essp:trustsIdp essp:pass-idp-060 ;
    essp:usesProtocol essp:protocolSaml2 ;
    essp:tenantKey "pass" ;
    essp:nameIdFormat "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress" ;
    essp:claimMapping essp:pass-map-060 .
