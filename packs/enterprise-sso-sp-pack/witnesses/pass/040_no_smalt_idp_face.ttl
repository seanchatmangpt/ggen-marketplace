@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .

essp:pass-sp-040 a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:pass-040" ;
    essp:spRole essp:roleSp ;
    essp:entityId "urn:sjira:sp:pass-040" ;
    essp:acsUrl "https://sjira.example/sso/saml/acs" .

essp:pass-idp-040 a essp:ExternalIdentityProvider ;
    essp:idpId "urn:customer:idp:okta-pass" ;
    essp:idpEntityId "https://customer.okta.com" ;
    essp:idpMetadataUrl "https://customer.okta.com/app/exk/sso/saml/metadata" .

essp:pass-binding-040 a essp:FederationBinding ;
    essp:bindingId "pass-040" ;
    essp:forServiceProvider essp:pass-sp-040 ;
    essp:trustsIdp essp:pass-idp-040 ;
    essp:usesProtocol essp:protocolSaml2 ;
    essp:tenantKey "pass" ;
    essp:nameIdFormat "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress" .
