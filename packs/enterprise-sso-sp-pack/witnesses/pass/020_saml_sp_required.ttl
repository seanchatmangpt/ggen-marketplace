@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .

essp:pass-sp-020 a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:pass-020" ;
    essp:spRole essp:roleSp ;
    essp:entityId "urn:sjira:sp:pass-020" ;
    essp:acsUrl "https://sjira.example/sso/saml/acs" .

essp:pass-idp-020 a essp:ExternalIdentityProvider ;
    essp:idpId "urn:customer:idp:pass-020" ;
    essp:idpEntityId "https://idp.customer.example/metadata" ;
    essp:idpMetadataUrl "https://idp.customer.example/metadata" .

essp:pass-binding-020 a essp:FederationBinding ;
    essp:bindingId "pass-020" ;
    essp:forServiceProvider essp:pass-sp-020 ;
    essp:trustsIdp essp:pass-idp-020 ;
    essp:usesProtocol essp:protocolSaml2 ;
    essp:tenantKey "pass" ;
    essp:nameIdFormat "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress" .
