@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .

# Fail: saml2 binding with no IdP metadata / nameIdFormat.
essp:fail-sp-020 a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:fail-020" ;
    essp:spRole essp:roleSp ;
    essp:entityId "urn:sjira:sp:fail-020" ;
    essp:acsUrl "https://sjira.example/sso/saml/acs" .

essp:fail-binding-020 a essp:FederationBinding ;
    essp:bindingId "fail-020" ;
    essp:forServiceProvider essp:fail-sp-020 ;
    essp:usesProtocol essp:protocolSaml2 ;
    essp:tenantKey "fail" .
