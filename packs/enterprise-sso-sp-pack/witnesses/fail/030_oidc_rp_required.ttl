@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .

# Fail: oidc binding missing clientId / redirectUri / discovery.
essp:fail-sp-030 a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:fail-030" ;
    essp:spRole essp:roleSp ;
    essp:entityId "urn:sjira:sp:fail-030" .

essp:fail-binding-030 a essp:FederationBinding ;
    essp:bindingId "fail-030" ;
    essp:forServiceProvider essp:fail-sp-030 ;
    essp:usesProtocol essp:protocolOidc ;
    essp:tenantKey "fail" .
