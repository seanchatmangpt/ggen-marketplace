@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Fail witness: ProductServiceProvider missing spRole → gate must return >=1 row.
essp:fail-sp a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:fail" ;
    essp:entityId "urn:sjira:sp:fail" ;
    essp:acsUrl "https://sjira.example/sso/saml/acs" ;
    rdfs:label "fail SP (no role)" .
