@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .

# Fail: trusts Smalt IdP entity — gate must flip.
essp:fail-sp-040 a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:fail-040" ;
    essp:spRole essp:roleSp ;
    essp:entityId "urn:sjira:sp:fail-040" ;
    essp:acsUrl "https://sjira.example/sso/saml/acs" .

essp:fail-smalt-idp a essp:ExternalIdentityProvider ;
    essp:idpId "urn:smalt:identity:saml" ;
    essp:idpEntityId "urn:smalt:identity:saml" ;
    essp:idpMetadataUrl "http://127.0.0.1:9445/metadata" .

essp:fail-binding-040 a essp:FederationBinding ;
    essp:bindingId "fail-040" ;
    essp:forServiceProvider essp:fail-sp-040 ;
    essp:trustsIdp essp:fail-smalt-idp ;
    essp:usesProtocol essp:protocolSaml2 ;
    essp:tenantKey "fail" ;
    essp:nameIdFormat "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress" .
