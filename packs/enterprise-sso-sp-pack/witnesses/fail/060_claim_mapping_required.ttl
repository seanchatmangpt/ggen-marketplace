@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .

# Fail: federation binding with no claimMapping / ClaimRule.
essp:fail-sp-060 a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:fail-060" ;
    essp:spRole essp:roleSp ;
    essp:entityId "urn:sjira:sp:fail-060" ;
    essp:acsUrl "https://sjira.example/sso/saml/acs" .

essp:fail-idp-060 a essp:ExternalIdentityProvider ;
    essp:idpId "urn:customer:idp:fail-060" ;
    essp:idpEntityId "https://idp.customer.example/metadata" ;
    essp:idpMetadataUrl "https://idp.customer.example/metadata" .

essp:fail-binding-060 a essp:FederationBinding ;
    essp:bindingId "fail-060" ;
    essp:forServiceProvider essp:fail-sp-060 ;
    essp:trustsIdp essp:fail-idp-060 ;
    essp:usesProtocol essp:protocolSaml2 ;
    essp:tenantKey "fail" ;
    essp:nameIdFormat "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress" .
