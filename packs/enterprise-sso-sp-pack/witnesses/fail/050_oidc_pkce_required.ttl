@prefix essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#> .

# Fail: oidc binding without pkceRequired true.
essp:fail-sp-050 a essp:ProductServiceProvider ;
    essp:spId "urn:sjira:sp:fail-050" ;
    essp:spRole essp:roleSp ;
    essp:entityId "urn:sjira:sp:fail-050" ;
    essp:acsUrl "https://sjira.example/sso/oidc/callback" .

essp:fail-idp-050 a essp:ExternalIdentityProvider ;
    essp:idpId "urn:customer:idp:fail-050" ;
    essp:idpEntityId "https://idp.customer.example" ;
    essp:idpDiscoveryUrl "https://idp.customer.example/.well-known/openid-configuration" .

essp:fail-binding-050 a essp:FederationBinding ;
    essp:bindingId "fail-050" ;
    essp:forServiceProvider essp:fail-sp-050 ;
    essp:trustsIdp essp:fail-idp-050 ;
    essp:usesProtocol essp:protocolOidc ;
    essp:tenantKey "fail" ;
    essp:clientId "sjira-fail-rp" ;
    essp:clientSecretRef "vault:sjira/sso/fail/oidc" ;
    essp:redirectUri "https://sjira.example/sso/oidc/callback" .
