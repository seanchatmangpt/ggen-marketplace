# MESSAGE: ProductServiceProvider missing essp:spRole essp:roleSp (or claiming non-SP role).
# This pack admits SJ product as Service Provider / Relying Party only.
# Smalt owns IdP faces; an SP individual without roleSp is refused.
PREFIX essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#>
SELECT ?sp ?violation WHERE {
  ?sp a essp:ProductServiceProvider .
  OPTIONAL { ?sp essp:spRole ?role }
  FILTER(!BOUND(?role) || ?role != essp:roleSp)
  BIND("ProductServiceProvider must declare essp:spRole essp:roleSp (IdP roles are out of scope for this pack)" AS ?violation)
}
ORDER BY ?sp
