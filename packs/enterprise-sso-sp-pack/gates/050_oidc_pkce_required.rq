# MESSAGE: OIDC federation binding missing essp:pkceRequired true (RFC 7636).
# Public clients / auth-code flows on the SJ product RP must require PKCE.
PREFIX essp: <https://seanchatmangpt.github.io/packs/enterprise-sso-sp#>
SELECT ?binding ?violation WHERE {
  ?binding a essp:FederationBinding ;
           essp:usesProtocol essp:protocolOidc .
  OPTIONAL { ?binding essp:pkceRequired ?pkce }
  FILTER(!BOUND(?pkce) || ?pkce != true)
  BIND("oidc binding must declare essp:pkceRequired true (RFC 7636)" AS ?violation)
}
ORDER BY ?binding
