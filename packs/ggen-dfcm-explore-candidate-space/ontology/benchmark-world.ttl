@prefix dfcm: <https://ggen.io/dfcm/explore#> .
dfcm:BenchmarkWorld a dfcm:Candidate ; dfcm:family "simulation-benchmark" ; dfcm:assumption "world identity, seed, observations, and authority are fixed" ; dfcm:falsifier "candidate comparison changes the benchmark world" ; dfcm:rollbackCost "low" ; dfcm:standing dfcm:Retained .
