@prefix dfcm: <https://ggen.io/dfcm/explore#> .
dfcm:MetricTopology a dfcm:Candidate ; dfcm:family "topology-metric" ; dfcm:assumption "candidate distance has observable features" ; dfcm:falsifier "distinct semantic candidates collapse to zero distance" ; dfcm:rollbackCost "low" ; dfcm:standing dfcm:Retained .
