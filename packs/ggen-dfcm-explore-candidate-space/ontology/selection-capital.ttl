@prefix dfcm: <https://ggen.io/dfcm/explore#> .
dfcm:SelectionCapital a dfcm:Candidate ; dfcm:family "combinatorial-maximalism" ; dfcm:assumption "reversible alternatives have measurable future option value" ; dfcm:falsifier "candidate preservation cost exceeds admitted option value bound" ; dfcm:rollbackCost "low" ; dfcm:standing dfcm:Retained .
