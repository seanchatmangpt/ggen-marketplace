---
to: "infrastructure/data/transactional/txn_durability_contract.ttl"
force: true
sparql:
  programs: |
    PREFIX f5td: <http://seanchatmangpt.github.io/packs/fortune5-transaction-data-law#>
    SELECT ?programId ?catalogGroup ?catalogVersion ?catalogPackId ?directActuation
    WHERE {
      ?p a f5td:TransactionDataProgram ;
         f5td:programId ?programId ;
         f5td:catalogGroup ?catalogGroup ;
         f5td:catalogVersion ?catalogVersion ;
         f5td:catalogPackId ?catalogPackId ;
         f5td:directActuation ?directActuation .
    }
    ORDER BY ?programId
  policies: |
    PREFIX f5td: <http://seanchatmangpt.github.io/packs/fortune5-transaction-data-law#>
    SELECT ?policyId ?title ?dataClassId ?multiZone ?encryption ?backup
           ?backupDays ?pitr ?replicationId ?replicationMode ?replicationTitle
           ?evidence ?directActuation ?replDirect
    WHERE {
      ?pol a f5td:DurabilityPolicy ;
           f5td:policyId ?policyId ;
           f5td:title ?title ;
           f5td:appliesToDataClass ?dc ;
           f5td:multiZoneRequired ?multiZone ;
           f5td:encryptionAtRest ?encryption ;
           f5td:backupEnabled ?backup ;
           f5td:backupRetentionDays ?backupDays ;
           f5td:pitrEnabled ?pitr ;
           f5td:hasReplicationPolicy ?repl ;
           f5td:evidenceRequired ?evidence ;
           f5td:directActuation ?directActuation .
      ?dc f5td:dataClassId ?dataClassId .
      ?repl f5td:replicationId ?replicationId ;
           f5td:title ?replicationTitle ;
           f5td:replicationMode ?replicationMode ;
           f5td:directActuation ?replDirect .
    }
    ORDER BY ?policyId
---
# GENERATED by ggen sync from fortune5-transaction-data-law-pack — do not edit by hand.
# Flattened projection of admitted durability facts (broker-only; no secrets).
@prefix f5td: <http://seanchatmangpt.github.io/packs/fortune5-transaction-data-law#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

{% for row in policies -%}
f5td:proj-dc-{{ row.dataClassId }} a f5td:DataClass ;
    f5td:dataClassId "{{ row.dataClassId }}" .

f5td:proj-repl-{{ row.replicationId }} a f5td:ReplicationPolicy ;
    f5td:replicationId "{{ row.replicationId }}" ;
    f5td:title "{{ row.replicationTitle }}" ;
    f5td:replicationMode "{{ row.replicationMode }}" ;
    f5td:directActuation {{ row.replDirect }} .

f5td:proj-policy-{{ row.policyId }} a f5td:DurabilityPolicy ;
    f5td:policyId "{{ row.policyId }}" ;
    f5td:title "{{ row.title }}" ;
    f5td:appliesToDataClass f5td:proj-dc-{{ row.dataClassId }} ;
    f5td:multiZoneRequired {{ row.multiZone }} ;
    f5td:encryptionAtRest {{ row.encryption }} ;
    f5td:backupEnabled {{ row.backup }} ;
    f5td:backupRetentionDays "{{ row.backupDays }}"^^xsd:integer ;
    f5td:pitrEnabled {{ row.pitr }} ;
    f5td:hasReplicationPolicy f5td:proj-repl-{{ row.replicationId }} ;
    f5td:evidenceRequired {{ row.evidence }} ;
    f5td:directActuation {{ row.directActuation }} .
{% endfor %}

{% for row in programs -%}
f5td:proj-program-{{ row.programId }} a f5td:TransactionDataProgram ;
    f5td:programId "{{ row.programId }}" ;
    f5td:catalogGroup "{{ row.catalogGroup }}" ;
    f5td:catalogVersion "{{ row.catalogVersion }}" ;
    f5td:catalogPackId "{{ row.catalogPackId }}" ;
    f5td:directActuation {{ row.directActuation }} .
{% endfor %}
