@prefix f5td: <http://seanchatmangpt.github.io/packs/fortune5-transaction-data-law#> .

# Falsifier for gates/020 catalogPackId == fortune5-transaction-data-law-pack.

f5td:bad-catalog-program a f5td:TransactionDataProgram ;
    f5td:programId "fortune5-transaction-data-drift" ;
    f5td:catalogGroup "transaction-data" ;
    f5td:catalogVersion "26.7.31" ;
    f5td:catalogPackId "fortune5-transaction-data-other" ;
    f5td:hasDurabilityPolicy f5td:TransactionalDurability ;
    f5td:directActuation false .
