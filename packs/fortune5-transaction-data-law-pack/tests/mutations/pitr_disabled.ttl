@prefix f5td: <http://seanchatmangpt.github.io/packs/fortune5-transaction-data-law#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Falsifier for gates/020 pitrEnabled=true + SHACL hasValue true.

f5td:bad-pitr-policy a f5td:DurabilityPolicy ;
    f5td:policyId "DUR-BAD-PITR" ;
    f5td:title "Durability policy without PITR" ;
    f5td:appliesToDataClass f5td:Transactional ;
    f5td:multiZoneRequired true ;
    f5td:encryptionAtRest true ;
    f5td:backupEnabled true ;
    f5td:backupRetentionDays "35"^^xsd:integer ;
    f5td:pitrEnabled false ;
    f5td:hasReplicationPolicy f5td:SyncReplica ;
    f5td:evidenceRequired true ;
    f5td:directActuation false .
