@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix f5td: <http://seanchatmangpt.github.io/packs/fortune5-transaction-data-law#> .

# SHACL twin of gates/010_durability_contract.rq and
# gates/020_broker_only_no_actuation.rq.
# Path is shapes/f5td.shacl.ttl (not root shapes.ttl — pack contract refuses that name).
# Manual: ggen graph validate --files ontology.ttl --shapes shapes/f5td.shacl.ttl

f5td:TransactionDataProgramShape a sh:NodeShape ;
    sh:targetClass f5td:TransactionDataProgram ;
    sh:closed false ;
    sh:property [
        sh:path f5td:programId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
        sh:message "TransactionDataProgram missing programId" ;
    ] ;
    sh:property [
        sh:path f5td:catalogGroup ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:hasValue "transaction-data" ;
        sh:message "TransactionDataProgram catalogGroup must be transaction-data" ;
    ] ;
    sh:property [
        sh:path f5td:catalogVersion ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
        sh:message "TransactionDataProgram missing catalogVersion" ;
    ] ;
    sh:property [
        sh:path f5td:catalogPackId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:hasValue "fortune5-transaction-data-law-pack" ;
        sh:message "catalogPackId must equal fortune5-transaction-data-law-pack" ;
    ] ;
    sh:property [
        sh:path f5td:hasDurabilityPolicy ;
        sh:minCount 1 ; sh:class f5td:DurabilityPolicy ;
        sh:message "TransactionDataProgram must declare at least one DurabilityPolicy" ;
    ] ;
    sh:property [
        sh:path f5td:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:message "TransactionDataProgram directActuation must be false (broker-only)" ;
    ] ;
    sh:severity sh:Violation .

f5td:DurabilityPolicyShape a sh:NodeShape ;
    sh:targetClass f5td:DurabilityPolicy ;
    sh:closed false ;
    sh:property [
        sh:path f5td:policyId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5td:title ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5td:appliesToDataClass ;
        sh:minCount 1 ; sh:class f5td:DataClass ;
    ] ;
    sh:property [
        sh:path f5td:multiZoneRequired ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "multiZoneRequired must be true" ;
    ] ;
    sh:property [
        sh:path f5td:encryptionAtRest ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "encryptionAtRest must be true" ;
    ] ;
    sh:property [
        sh:path f5td:backupEnabled ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "backupEnabled must be true" ;
    ] ;
    sh:property [
        sh:path f5td:backupRetentionDays ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "backupRetentionDays must be a positive xsd:integer" ;
    ] ;
    sh:property [
        sh:path f5td:pitrEnabled ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "pitrEnabled must be true" ;
    ] ;
    sh:property [
        sh:path f5td:hasReplicationPolicy ;
        sh:minCount 1 ; sh:class f5td:ReplicationPolicy ;
    ] ;
    sh:property [
        sh:path f5td:evidenceRequired ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "evidenceRequired must be true" ;
    ] ;
    sh:property [
        sh:path f5td:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:message "DurabilityPolicy directActuation must be false (broker-only)" ;
    ] ;
    sh:severity sh:Violation .

f5td:ReplicationPolicyShape a sh:NodeShape ;
    sh:targetClass f5td:ReplicationPolicy ;
    sh:property [
        sh:path f5td:replicationId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5td:title ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5td:replicationMode ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:in ( "sync" "async" ) ;
        sh:message "replicationMode must be sync or async" ;
    ] ;
    sh:property [
        sh:path f5td:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
    ] ;
    sh:severity sh:Violation .

f5td:DataClassShape a sh:NodeShape ;
    sh:targetClass f5td:DataClass ;
    sh:property [
        sh:path f5td:dataClassId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:severity sh:Violation .
