# MESSAGE: a frozen identity is single-valued; two digests for one subject are ambiguous.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
SELECT DISTINCT ?subject ?property WHERE {
  VALUES ?property {
    ecap:implementationDigest
    ecap:closureDigest
    ecap:cohortDigest
    ecap:evidenceDigest
  }
  ?subject ?property ?first , ?second .
  FILTER(?first != ?second)
}
ORDER BY ?subject ?property
