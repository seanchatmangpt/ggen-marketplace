# MESSAGE: paired evidence needs champion, candidate, cohortDigest and evidenceDigest.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
SELECT ?evidence ?missing WHERE {
  {
    ?evidence a ecap:PairedEvidence .
    OPTIONAL { ?evidence ecap:champion ?v . BIND(?v AS ?w) }
    FILTER(!BOUND(?w))
    BIND("champion" AS ?missing)
  }
  UNION
  {
    ?evidence a ecap:PairedEvidence .
    OPTIONAL { ?evidence ecap:candidate ?v . BIND(?v AS ?w) }
    FILTER(!BOUND(?w))
    BIND("candidate" AS ?missing)
  }
  UNION
  {
    ?evidence a ecap:PairedEvidence .
    OPTIONAL { ?evidence ecap:cohortDigest ?v . BIND(?v AS ?w) }
    FILTER(!BOUND(?w))
    BIND("cohortDigest" AS ?missing)
  }
  UNION
  {
    ?evidence a ecap:PairedEvidence .
    OPTIONAL { ?evidence ecap:evidenceDigest ?v . BIND(?v AS ?w) }
    FILTER(!BOUND(?w))
    BIND("evidenceDigest" AS ?missing)
  }
}
ORDER BY ?evidence ?missing
