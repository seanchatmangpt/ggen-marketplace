# MESSAGE: executable closure and every member need immutable digest identity.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
SELECT ?subject ?missing WHERE {
  {
    ?subject a ecap:ExecutionClosure .
    OPTIONAL {
      ?subject ecap:closureDigest ?digest .
      BIND(?digest AS ?closureWitness)
    }
    FILTER(!BOUND(?closureWitness))
    BIND("closureDigest" AS ?missing)
  }
  UNION
  {
    ?closure a ecap:ExecutionClosure ;
             ecap:closureMember ?subject .
    OPTIONAL {
      ?subject ecap:implementationDigest ?digest .
      BIND(?digest AS ?implementationWitness)
    }
    FILTER(!BOUND(?implementationWitness))
    BIND("implementationDigest" AS ?missing)
  }
}
ORDER BY ?subject ?missing
