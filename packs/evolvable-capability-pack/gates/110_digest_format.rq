# MESSAGE: every ecap digest must be a plain sha256:<64 lowercase hex> literal.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
SELECT ?subject ?property ?digest WHERE {
  VALUES ?property {
    ecap:implementationDigest
    ecap:closureDigest
    ecap:cohortDigest
    ecap:evidenceDigest
  }
  ?subject ?property ?digest .
  FILTER(!isLiteral(?digest) || !REGEX(STR(?digest), "^sha256:[0-9a-f]{64}$"))
}
ORDER BY ?subject ?property ?digest
