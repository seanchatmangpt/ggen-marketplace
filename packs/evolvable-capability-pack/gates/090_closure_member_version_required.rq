# MESSAGE: every frozen closure member must carry an explicit version identity.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?closure ?capability WHERE {
  ?closure a ecap:ExecutionClosure ;
           ecap:closureMember ?capability .
  OPTIONAL {
    ?capability dcterms:hasVersion ?version .
    BIND(?version AS ?witness)
  }
  FILTER(!BOUND(?witness))
}
ORDER BY ?closure ?capability
