# MESSAGE: a released capability must preserve both admission and release evidence.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
SELECT ?capability ?missing WHERE {
  {
    ?capability a ecap:Capability ;
                ecap:lifecycleState ecap:Released .
    OPTIONAL {
      ?capability ecap:admissionEvidence ?admission .
      BIND(?admission AS ?admissionWitness)
    }
    FILTER(!BOUND(?admissionWitness))
    BIND("admissionEvidence" AS ?missing)
  }
  UNION
  {
    ?capability a ecap:Capability ;
                ecap:lifecycleState ecap:Released .
    OPTIONAL {
      ?capability ecap:releaseEvidence ?release .
      BIND(?release AS ?releaseWitness)
    }
    FILTER(!BOUND(?releaseWitness))
    BIND("releaseEvidence" AS ?missing)
  }
}
ORDER BY ?capability ?missing
