# MESSAGE: promotion requires paired champion/candidate evidence.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
SELECT ?promotion WHERE {
  ?promotion a ecap:Promotion .
  OPTIONAL {
    ?promotion ecap:pairedEvidence ?evidence .
    BIND(?evidence AS ?witness)
  }
  FILTER(!BOUND(?witness))
}
ORDER BY ?promotion
