# MESSAGE: cohortDigest and evidenceDigest are single-valued identities of paired evidence.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
SELECT DISTINCT ?evidence ?property WHERE {
  VALUES ?property { ecap:cohortDigest ecap:evidenceDigest }
  ?evidence ?property ?first , ?second .
  FILTER(?first != ?second)
}
ORDER BY ?evidence ?property
