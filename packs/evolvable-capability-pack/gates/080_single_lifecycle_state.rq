# MESSAGE: one capability resource may carry only one lifecycle state.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
# Keyed on the lifecycleState property itself, not on `a ecap:Capability`, so
# an untyped subject holding Released and Candidate at once is still refused.
SELECT ?capability ?stateA ?stateB WHERE {
  ?capability ecap:lifecycleState ?stateA ;
              ecap:lifecycleState ?stateB .
  FILTER(?stateA != ?stateB)
}
ORDER BY ?capability ?stateA ?stateB
