# MESSAGE: closureDigest and implementationDigest are single-valued identities.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
SELECT ?subject ?field WHERE {
  {
    ?subject a ecap:ExecutionClosure ;
             ecap:closureDigest ?a ;
             ecap:closureDigest ?b .
    FILTER(?a != ?b)
    BIND("closureDigest" AS ?field)
  }
  UNION
  {
    ?closure a ecap:ExecutionClosure ;
             ecap:closureMember ?subject .
    ?subject ecap:implementationDigest ?a ;
             ecap:implementationDigest ?b .
    FILTER(?a != ?b)
    BIND("implementationDigest" AS ?field)
  }
}
ORDER BY ?subject ?field
