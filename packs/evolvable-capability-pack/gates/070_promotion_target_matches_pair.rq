# MESSAGE: a promotion may promote only the candidate named by its paired evidence.
PREFIX ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#>
SELECT ?promotion ?promoted ?pairedCandidate WHERE {
  ?promotion a ecap:Promotion ;
             ecap:promotes ?promoted ;
             ecap:pairedEvidence ?evidence .
  ?evidence ecap:candidate ?pairedCandidate .
  FILTER(?promoted != ?pairedCandidate)
}
ORDER BY ?promotion
