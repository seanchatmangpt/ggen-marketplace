@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:neg:candidate> a ecap:Capability ;
  ecap:lifecycleState ecap:Candidate ;
  dcterms:hasVersion "3" ;
  ecap:implementationDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" .

<urn:neg:closure> a ecap:ExecutionClosure ;
  ecap:closureDigest "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
  ecap:closureMember <urn:neg:candidate> .
