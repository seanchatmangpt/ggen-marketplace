# Court-507 A4 (permanent): a closure member with no rdf:type triple. The
# ontology's rdfs:domain/range are not entailed by either engine, so gate 030
# now refuses the untyped member directly (gate 130 names the same defect as
# untypedCapability).
@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:neg:untyped> ecap:lifecycleState ecap:Released ;
  dcterms:hasVersion "6" ;
  ecap:implementationDigest "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" ;
  ecap:admissionEvidence <urn:neg:untyped-admission> ;
  ecap:releaseEvidence <urn:neg:untyped-release> .

<urn:neg:untyped-admission> a prov:Entity .
<urn:neg:untyped-release> a prov:Entity .

<urn:neg:closure> a ecap:ExecutionClosure ;
  ecap:closureDigest "sha256:f15907ee0b2a166589c3a611d56d45779a772b0655d9986f9ad3269031067bc6" ;
  ecap:closureMember <urn:neg:untyped> .
