# Court-507 A1 (permanent): an Admitted capability frozen into a closure.
# Before gate 030 required the Released state by sameTerm, this was admitted
# by every gate; the ggen runtime projected it into the frozen closure.
@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:neg:admitted> a ecap:Capability ;
  ecap:lifecycleState ecap:Admitted ;
  dcterms:hasVersion "4" ;
  ecap:implementationDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" .

<urn:neg:closure> a ecap:ExecutionClosure ;
  ecap:closureDigest "sha256:4cca448e0b9ee7a3e75cb1f1173456aa4aad0e3fed6debb95a0cd8812eb890a2" ;
  ecap:closureMember <urn:neg:admitted> .
