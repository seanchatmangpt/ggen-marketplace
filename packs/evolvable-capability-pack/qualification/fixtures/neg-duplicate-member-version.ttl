# Court-507 A2 (permanent): one closure member carrying two distinct versions.
# Admitted by all 14 gates before gate 090 refused duplicate identities; ggen
# exit 0 projected duplicate member rows with versions 3 and 2 together.
@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:neg:dupversion> a ecap:Capability ;
  ecap:lifecycleState ecap:Released ;
  dcterms:hasVersion "3" , "2" ;
  ecap:implementationDigest "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
  ecap:admissionEvidence <urn:neg:dupversion-admission> ;
  ecap:releaseEvidence <urn:neg:dupversion-release> .

<urn:neg:dupversion-admission> a prov:Entity .
<urn:neg:dupversion-release> a prov:Entity .

<urn:neg:closure> a ecap:ExecutionClosure ;
  ecap:closureDigest "sha256:b0197c0f60099be9a2b3b003bdb8694c8cfbda0d32d3eba100e975d04947678d" ;
  ecap:closureMember <urn:neg:dupversion> .
