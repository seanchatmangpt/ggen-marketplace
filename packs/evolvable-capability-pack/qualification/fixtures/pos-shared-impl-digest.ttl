# Court-507 A5 (permanent, pinned lawful): two capabilities sharing one
# implementation digest. Digest identity is per-subject (gate 100 refuses a
# second digest on one subject); the same implementation may lawfully serve
# two capability versions, so this shape stays admitted by every gate and the
# closure digest stays bound to both member rows.
@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:pos:alpha> a ecap:Capability ;
  ecap:lifecycleState ecap:Released ;
  dcterms:hasVersion "7" ;
  ecap:implementationDigest "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" ;
  ecap:admissionEvidence <urn:pos:alpha-admission> ;
  ecap:releaseEvidence <urn:pos:alpha-release> .

<urn:pos:beta> a ecap:Capability ;
  ecap:lifecycleState ecap:Released ;
  dcterms:hasVersion "8" ;
  ecap:implementationDigest "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" ;
  ecap:admissionEvidence <urn:pos:beta-admission> ;
  ecap:releaseEvidence <urn:pos:beta-release> .

<urn:pos:alpha-admission> a prov:Entity .
<urn:pos:alpha-release> a prov:Entity .
<urn:pos:beta-admission> a prov:Entity .
<urn:pos:beta-release> a prov:Entity .

<urn:pos:closure> a ecap:ExecutionClosure ;
  ecap:closureDigest "sha256:7bd87e06529938b04819afb7b37ea9b04ccfa29fce8923be3e56c31f6fda4a35" ;
  ecap:closureMember <urn:pos:alpha> , <urn:pos:beta> .
