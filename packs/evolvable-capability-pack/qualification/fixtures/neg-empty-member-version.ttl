# Court-507 A6 (permanent): an empty-string version. It satisfied the old
# gate 090 (any dcterms:hasVersion witness) while ggen projected version ""
# indistinguishably from the missing-version default; gate 090 now requires a
# non-empty value.
@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:neg:emptyversion> a ecap:Capability ;
  ecap:lifecycleState ecap:Released ;
  dcterms:hasVersion "" ;
  ecap:implementationDigest "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" ;
  ecap:admissionEvidence <urn:neg:emptyversion-admission> ;
  ecap:releaseEvidence <urn:neg:emptyversion-release> .

<urn:neg:emptyversion-admission> a prov:Entity .
<urn:neg:emptyversion-release> a prov:Entity .

<urn:neg:closure> a ecap:ExecutionClosure ;
  ecap:closureDigest "sha256:e816f0e9d8ad258c6a264721cb90be7300f5102bd9cdf3bea5050edb4452380b" ;
  ecap:closureMember <urn:neg:emptyversion> .
