@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<urn:test:champion> a ecap:Capability ;
  ecap:lifecycleState ecap:Released ;
  dcterms:hasVersion "1" ;
  ecap:implementationDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
  ecap:admissionEvidence <urn:test:champion-admission> ;
  ecap:releaseEvidence <urn:test:champion-release> .

<urn:test:candidate> a ecap:Capability ;
  ecap:lifecycleState ecap:Released ;
  dcterms:hasVersion "2" ;
  ecap:implementationDigest "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
  ecap:admissionEvidence <urn:test:candidate-admission> ;
  ecap:releaseEvidence <urn:test:candidate-release> .

<urn:test:champion-admission> a prov:Entity .
<urn:test:champion-release> a prov:Entity .
<urn:test:candidate-admission> a prov:Entity .
<urn:test:candidate-release> a prov:Entity .

<urn:test:pair> a ecap:PairedEvidence ;
  ecap:champion <urn:test:champion> ;
  ecap:candidate <urn:test:candidate> ;
  ecap:cohortDigest "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" ;
  ecap:evidenceDigest "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" .

<urn:test:promotion> a ecap:Promotion ;
  ecap:pairedEvidence <urn:test:pair> ;
  ecap:promotes <urn:test:candidate> .

<urn:test:closure> a ecap:ExecutionClosure ;
  ecap:closureDigest "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" ;
  ecap:closureMember <urn:test:candidate> .
