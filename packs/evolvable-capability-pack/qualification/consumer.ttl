@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Qualification-only external fact identity. The Core1 profile individual is
# owned by ggen-pack-spec-pack (SLP-QUAL-001 shape, standing-ladder-pack
# precedent); this fixture restates only the typed identity needed so
# gp:profile gp:Core1 is not a dangling reference when
# evolvable-capability-pack is qualified in isolation. Canonical facts
# remain owned by ggen-pack-spec-pack/ontology.ttl.
gp:Core1 a gp:Profile ;
    dcterms:source "packs/ggen-pack-spec-pack/ontology.ttl#gp:Core1" .
