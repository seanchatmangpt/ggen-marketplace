@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:witness:released> a ecap:Capability ;
  ecap:lifecycleState ecap:Released ;
  ecap:admissionEvidence <urn:witness:admission> ;
  ecap:releaseEvidence <urn:witness:release> .

<urn:witness:admission> a prov:Entity .
<urn:witness:release> a prov:Entity .
