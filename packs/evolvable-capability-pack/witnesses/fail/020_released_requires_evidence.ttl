@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .

<urn:witness:released> a ecap:Capability ;
  ecap:lifecycleState ecap:Released .

# Untyped released subject without evidence (rdfs:domain is not entailed).
<urn:witness:untyped-released> ecap:lifecycleState ecap:Released .

# Evidence present but not a prov:Entity: a bare literal and an untyped IRI.
<urn:witness:hollow-evidence> a ecap:Capability ;
  ecap:lifecycleState ecap:Released ;
  ecap:admissionEvidence "trust me" ;
  ecap:releaseEvidence <urn:witness:nowhere> .
