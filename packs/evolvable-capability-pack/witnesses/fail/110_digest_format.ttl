@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Truncated hex, upper-case hex, wrong algorithm, an IRI instead of a literal,
# and a quote-bearing literal that previously broke out of the JSON projection.
<urn:witness:capability> a ecap:Capability ;
  ecap:implementationDigest "sha256:e" .

<urn:witness:closure> a ecap:ExecutionClosure ;
  ecap:closureDigest "sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" ;
  ecap:closureMember <urn:witness:capability> .

<urn:witness:pair> a ecap:PairedEvidence ;
  ecap:cohortDigest "md5:d41d8cd98f00b204e9800998ecf8427e" ;
  ecap:evidenceDigest <urn:witness:not-a-literal> .

<urn:witness:injected> a ecap:Capability ;
  ecap:implementationDigest "sha256:a\", \"authority\": \"DO" .

# Well-formed hex in a non-plain carrier: an IRI, a typed literal, a
# language-tagged literal, a trailing newline, and trailing junk.
<urn:witness:carriers> a ecap:Capability ;
  ecap:implementationDigest <sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa> ;
  ecap:implementationDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"^^xsd:anyURI ;
  ecap:implementationDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"@en ;
  ecap:implementationDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n" ;
  ecap:implementationDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaazz" .
