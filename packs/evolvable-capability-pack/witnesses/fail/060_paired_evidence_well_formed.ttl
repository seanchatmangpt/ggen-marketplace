@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .

<urn:witness:champion> a ecap:Capability ;
  ecap:lifecycleState ecap:Candidate .

<urn:witness:candidate> a ecap:Capability ;
  ecap:lifecycleState ecap:Admitted .

<urn:witness:other> a ecap:Capability ;
  ecap:lifecycleState ecap:Admitted .

# Pair evidence is valid in shape but names a different candidate than the
# capability actually promoted, and its champion is not released.
<urn:witness:pair> a ecap:PairedEvidence ;
  ecap:champion <urn:witness:champion> ;
  ecap:candidate <urn:witness:other> ;
  ecap:cohortDigest "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" .

<urn:witness:promotion> a ecap:Promotion ;
  ecap:pairedEvidence <urn:witness:pair> ;
  ecap:promotes <urn:witness:candidate> .

# Self-paired evidence: the champion is the candidate.
<urn:witness:self-pair> a ecap:PairedEvidence ;
  ecap:champion <urn:witness:candidate> ;
  ecap:candidate <urn:witness:candidate> ;
  ecap:cohortDigest "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" .

<urn:witness:self-promotion> a ecap:Promotion ;
  ecap:pairedEvidence <urn:witness:self-pair> ;
  ecap:promotes <urn:witness:candidate> .

# Untyped, empty evidence node and a promotion that promotes nothing.
<urn:witness:hollow-promotion> a ecap:Promotion ;
  ecap:pairedEvidence <urn:witness:hollow> .
