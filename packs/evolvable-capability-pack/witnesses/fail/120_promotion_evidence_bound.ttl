@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .

# Champion is not released: the incumbent the candidate beat was never live.
<urn:witness:champion> a ecap:Capability ;
  ecap:lifecycleState ecap:Candidate .

<urn:witness:pair> a ecap:PairedEvidence ;
  ecap:champion <urn:witness:champion> ;
  ecap:candidate <urn:witness:candidate> .

<urn:witness:promotion> a ecap:Promotion ;
  ecap:pairedEvidence <urn:witness:pair> ;
  ecap:promotes <urn:witness:candidate> .

# Untyped evidence node: every completeness gate keyed on ecap:PairedEvidence
# is blind to it. A promotion that promotes nothing.
<urn:witness:hollow-promotion> a ecap:Promotion ;
  ecap:pairedEvidence <urn:witness:hollow> .
