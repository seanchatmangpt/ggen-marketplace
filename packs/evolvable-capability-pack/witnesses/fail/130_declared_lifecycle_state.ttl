@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .

<urn:witness:stateless> a ecap:Capability .

<urn:witness:invented> a ecap:Capability ;
  ecap:lifecycleState ecap:Deployed .

# Untyped closure member with no state, and an untyped subject with a state.
<urn:witness:closure> a ecap:ExecutionClosure ;
  ecap:closureMember <urn:witness:untyped-member> .
<urn:witness:untyped-stateful> ecap:lifecycleState ecap:Released .
