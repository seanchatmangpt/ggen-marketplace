@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .

# Released and Retired at once would otherwise satisfy the released-only
# closure gate while the capability is withdrawn.
<urn:witness:zombie> a ecap:Capability ;
  ecap:lifecycleState ecap:Released , ecap:Retired .

<urn:witness:stateless> a ecap:Capability .

<urn:witness:invented> a ecap:Capability ;
  ecap:lifecycleState ecap:Deployed .
