@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .

<urn:witness:capability> a ecap:Capability ;
  ecap:lifecycleState ecap:Released ;
  ecap:lifecycleState ecap:Retired .

# Untyped closure member holding Released and Candidate at once.
<urn:witness:untyped-member> ecap:lifecycleState ecap:Released ;
  ecap:lifecycleState ecap:Candidate .
<urn:witness:closure> a ecap:ExecutionClosure ;
  ecap:closureMember <urn:witness:untyped-member> .
