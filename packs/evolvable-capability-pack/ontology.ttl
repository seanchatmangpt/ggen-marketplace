@prefix ecap: <https://seanchatmangpt.github.io/packs/evolvable-capability#> .
@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:ggen:pack:evolvable-capability-pack>
    a gp:Pack ;
    gp:name "evolvable-capability-pack" ;
    gp:version "0.1.0" ;
    gp:profile gp:Core1 .

# Public-vocabulary boundary:
# - prov:Entity / prov:Activity / prov:wasDerivedFrom cover lineage.
# - earl:TestResult covers independently observed court results.
# - skos:Concept covers the lifecycle vocabulary.
# - dcterms:identifier / dcterms:hasVersion cover public identity metadata.
# Failed edge: none of those vocabularies states that deployment selection is
# closed over only released versions, nor that a promotion requires a paired
# champion/candidate observation from an identical cohort. ecap names only
# that missing contract.

ecap:Capability a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Evolvable capability" .

ecap:PairedEvidence a rdfs:Class ;
    rdfs:subClassOf earl:TestResult ;
    rdfs:label "Paired champion/candidate evidence" .

ecap:Promotion a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Capability promotion" .

ecap:ExecutionClosure a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Frozen execution closure" .

ecap:LifecycleState a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Capability lifecycle state" .

ecap:Candidate a ecap:LifecycleState ;
    skos:prefLabel "candidate" .
ecap:Admitted a ecap:LifecycleState ;
    skos:prefLabel "admitted" .
ecap:Released a ecap:LifecycleState ;
    skos:prefLabel "released" .
ecap:Retired a ecap:LifecycleState ;
    skos:prefLabel "retired" .

ecap:lifecycleState a rdf:Property ;
    rdfs:domain ecap:Capability ;
    rdfs:range ecap:LifecycleState .

ecap:implementationDigest a rdf:Property ;
    rdfs:domain ecap:Capability ;
    rdfs:range xsd:string .

ecap:admissionEvidence a rdf:Property ;
    rdfs:domain ecap:Capability ;
    rdfs:range prov:Entity .

ecap:releaseEvidence a rdf:Property ;
    rdfs:domain ecap:Capability ;
    rdfs:range prov:Entity .

ecap:champion a rdf:Property ;
    rdfs:domain ecap:PairedEvidence ;
    rdfs:range ecap:Capability .

ecap:candidate a rdf:Property ;
    rdfs:domain ecap:PairedEvidence ;
    rdfs:range ecap:Capability .

ecap:cohortDigest a rdf:Property ;
    rdfs:domain ecap:PairedEvidence ;
    rdfs:range xsd:string .

ecap:evidenceDigest a rdf:Property ;
    rdfs:range xsd:string .

ecap:pairedEvidence a rdf:Property ;
    rdfs:domain ecap:Promotion ;
    rdfs:range ecap:PairedEvidence .

ecap:promotes a rdf:Property ;
    rdfs:domain ecap:Promotion ;
    rdfs:range ecap:Capability .

ecap:closureMember a rdf:Property ;
    rdfs:domain ecap:ExecutionClosure ;
    rdfs:range ecap:Capability .

ecap:closureDigest a rdf:Property ;
    rdfs:domain ecap:ExecutionClosure ;
    rdfs:range xsd:string .
