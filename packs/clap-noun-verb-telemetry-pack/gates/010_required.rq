# MESSAGE: every cnv-telemetry:Config node must contain the fields required to render a real telemetry.rs; any row is a refusal.
PREFIX cnv-telemetry: <https://clap-noun-verb.dev/ontology/telemetry#>
SELECT ?subject ?missing WHERE {
  ?subject a cnv-telemetry:Config .
  VALUES ?missing { cnv-telemetry:schemaVersion cnv-telemetry:cliVersion }
  FILTER NOT EXISTS { ?subject ?missing ?value }
}
ORDER BY ?subject ?missing
