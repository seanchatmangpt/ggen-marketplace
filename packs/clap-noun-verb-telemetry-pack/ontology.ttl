# Vocabulary for cnv-telemetry:Config -- the one admitted individual a
# consuming project declares to generate its src/telemetry.rs.
@prefix cnv-telemetry: <https://clap-noun-verb.dev/ontology/telemetry#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cnv-telemetry:Config a rdfs:Class ;
    rdfs:comment "One consuming project's telemetry envelope configuration -- the knobs clap-noun-verb-telemetry-pack's template substitutes into a generated src/telemetry.rs." .

cnv-telemetry:schemaVersion a rdf:Property ;
    rdfs:domain cnv-telemetry:Config ;
    rdfs:comment "AutonomicTelemetryEnvelope's schema_version stamp." .

cnv-telemetry:cliVersion a rdf:Property ;
    rdfs:domain cnv-telemetry:Config ;
    rdfs:comment "AutonomicTelemetryEnvelope's cli_version stamp -- should track the consuming crate's real published version." .
