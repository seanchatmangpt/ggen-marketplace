@prefix rch: <https://ggen.dev/ontology/realization-calibration#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

rch:Capability a rdfs:Class .
rch:CompositionEdge a rdfs:Class .
rch:Candidate a rdfs:Class .
rch:Qualification a rdfs:Class .
rch:Realization a rdfs:Class .
rch:Calibration a rdfs:Class .
rch:Frontier a rdfs:Class .
rch:Receipt a rdfs:Class .

rch:sourceCapability a rdf:Property .
rch:targetCapability a rdf:Property .
rch:candidate a rdf:Property .
rch:qualification a rdf:Property .
rch:realization a rdf:Property .
rch:expectedDelta a rdf:Property .
rch:observedDelta a rdf:Property .
rch:successes a rdf:Property .
rch:failures a rdf:Property .
rch:posteriorMean a rdf:Property .
rch:reversible a rdf:Property .
rch:current a rdf:Property .
rch:authority a rdf:Property .
rch:actuationPerformed a rdf:Property .
rch:receiptDigest a rdf:Property .
rch:exactSubject a rdf:Property .
rch:marketplaceSupport a rdf:Property .
rch:missingPrimitive a rdf:Property .
rch:expectedReuse a rdf:Property .
rch:standing a rdf:Property .

rch:SELECT a skos:Concept ; skos:prefLabel "SELECT" .
rch:Calibration prov:wasDerivedFrom rch:Realization ; dcterms:type "deterministic-evidence-calibration" .
rch:Receipt odrl:permission [ odrl:action rch:SELECT ] .
