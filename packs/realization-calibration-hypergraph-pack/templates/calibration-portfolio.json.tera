{
  "schema": "ggen.realization-calibration/1",
  "authority": "SELECT|CONSTRUCT|VERIFY",
  "actuation_performed": false,
  "frontier": [
  {% for row in results %}{"edge":"{{ row.edge }}","source":"{{ row.source }}","target":"{{ row.target }}","posterior":{{ row.posterior }},"calibrated_delta":{{ row.calibratedDelta }},"reuse_adjusted_yield":{{ row.reuseAdjustedYield }}}{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
