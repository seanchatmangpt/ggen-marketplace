PREFIX rch: <https://ggen.dev/ontology/realization-calibration#>
SELECT ?edge ?successes ?failures ?posterior WHERE {
  ?edge a rch:CompositionEdge ; rch:successes ?successes ; rch:failures ?failures .
  BIND((xsd:decimal(?successes) + 1.0) / (xsd:decimal(?successes) + xsd:decimal(?failures) + 2.0) AS ?posterior)
}
ORDER BY DESC(?posterior) ?edge
