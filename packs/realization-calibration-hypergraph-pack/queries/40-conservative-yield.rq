PREFIX rch: <https://ggen.dev/ontology/realization-calibration#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?edge ?expected ?conservativeYield WHERE {
  ?edge a rch:CompositionEdge ; rch:expectedDelta ?expected ; rch:successes ?s ; rch:failures ?f .
  BIND((xsd:decimal(?s) + 1.0) / (xsd:decimal(?s) + xsd:decimal(?f) + 3.0) AS ?lowerProxy)
  BIND(xsd:decimal(?expected) * ?lowerProxy AS ?conservativeYield)
}
ORDER BY DESC(?conservativeYield) ?edge
