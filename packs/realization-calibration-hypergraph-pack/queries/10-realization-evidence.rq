PREFIX rch: <https://ggen.dev/ontology/realization-calibration#>
SELECT ?realization ?edge ?expected ?observed ?successes ?failures WHERE {
  ?realization a rch:Realization ; rch:current true ; rch:expectedDelta ?expected ; rch:observedDelta ?observed .
  OPTIONAL { ?realization <http://www.w3.org/ns/prov#wasDerivedFrom> ?edge . }
  OPTIONAL { ?edge rch:successes ?successes ; rch:failures ?failures . }
}
ORDER BY ?realization
