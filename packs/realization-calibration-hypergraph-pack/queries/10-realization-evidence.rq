PREFIX rch: <https://ggen.dev/ontology/realization-calibration#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?realization ?edge ?expected ?observed ?successes ?failures WHERE {
  ?realization a rch:Realization ; rch:current true ; rch:observedDelta ?observed ; prov:wasDerivedFrom ?edge .
  ?edge rch:expectedDelta ?expected ; rch:successes ?successes ; rch:failures ?failures .
}
ORDER BY ?realization
