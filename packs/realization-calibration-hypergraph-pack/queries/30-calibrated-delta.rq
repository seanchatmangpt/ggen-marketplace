PREFIX rch: <https://ggen.dev/ontology/realization-calibration#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?edge ?expected ?posterior ?calibratedDelta WHERE {
  ?edge a rch:CompositionEdge ; rch:expectedDelta ?expected ; rch:successes ?successes ; rch:failures ?failures .
  BIND((xsd:decimal(?successes) + 1.0) / (xsd:decimal(?successes) + xsd:decimal(?failures) + 2.0) AS ?posterior)
  BIND(xsd:decimal(?expected) * ?posterior AS ?calibratedDelta)
}
ORDER BY DESC(?calibratedDelta) ?edge
