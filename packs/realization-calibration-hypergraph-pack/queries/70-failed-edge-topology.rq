PREFIX rch: <https://ggen.dev/ontology/realization-calibration#>
SELECT ?edge ?source ?target ?failures ?missing WHERE {
  ?edge a rch:CompositionEdge ; rch:sourceCapability ?source ; rch:targetCapability ?target ; rch:failures ?failures .
  FILTER(?failures > 0)
  OPTIONAL { ?edge rch:missingPrimitive ?missing }
}
ORDER BY DESC(?failures) ?edge
