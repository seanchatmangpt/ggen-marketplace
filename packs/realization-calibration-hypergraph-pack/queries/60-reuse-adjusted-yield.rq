PREFIX rch: <https://ggen.dev/ontology/realization-calibration#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?edge ?calibratedDelta ?reuse ?reuseAdjustedYield WHERE {
  ?edge a rch:CompositionEdge ; rch:expectedDelta ?expected ; rch:expectedReuse ?reuse ; rch:successes ?s ; rch:failures ?f .
  BIND((xsd:decimal(?s) + 1.0) / (xsd:decimal(?s) + xsd:decimal(?f) + 2.0) AS ?posterior)
  BIND(xsd:decimal(?expected) * ?posterior AS ?calibratedDelta)
  BIND(?calibratedDelta * (1.0 + xsd:decimal(?reuse)) AS ?reuseAdjustedYield)
}
ORDER BY DESC(?reuseAdjustedYield) ?edge
