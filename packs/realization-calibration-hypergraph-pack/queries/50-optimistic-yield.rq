PREFIX rch: <https://ggen.dev/ontology/realization-calibration#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?edge ?expected ?optimisticYield WHERE {
  ?edge a rch:CompositionEdge ; rch:expectedDelta ?expected ; rch:successes ?s ; rch:failures ?f .
  BIND((xsd:decimal(?s) + 2.0) / (xsd:decimal(?s) + xsd:decimal(?f) + 2.0) AS ?upperProxy)
  BIND(xsd:decimal(?expected) * ?upperProxy AS ?optimisticYield)
}
ORDER BY DESC(?optimisticYield) ?edge
