PREFIX rch: <https://ggen.dev/ontology/realization-calibration#>
ASK WHERE {
  FILTER NOT EXISTS {
    ?r a rch:Realization ; rch:current true .
    FILTER NOT EXISTS {
      ?r rch:exactSubject ?subject ; rch:receiptDigest ?digest ; rch:standing ?standing .
      FILTER(STRLEN(STR(?digest)) = 64 && ?standing IN ("ALIVE", "PARTIAL_ALIVE"))
    }
  }
}
