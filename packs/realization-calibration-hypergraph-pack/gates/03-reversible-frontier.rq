PREFIX rch: <https://ggen.dev/ontology/realization-calibration#>
ASK WHERE {
  FILTER NOT EXISTS {
    ?edge a rch:CompositionEdge .
    FILTER NOT EXISTS { ?edge rch:reversible true ; rch:sourceCapability ?s ; rch:targetCapability ?t ; rch:expectedDelta ?d ; rch:successes ?ok ; rch:failures ?bad }
  }
}
