PREFIX lm: <https://ggen.io/ontology/legal-matter#>
SELECT ?kind ?cls ?field ?zod ?custody
WHERE {
  {
    lm:CaseSpace lm:custodyBinding ?custody .
    BIND("custody" AS ?kind) BIND("CaseSpace" AS ?cls) BIND("" AS ?field) BIND("" AS ?zod)
  }
  UNION
  {
    ?f a lm:Field ; lm:belongsTo lm:CaseSpace ; lm:fieldName ?field ; lm:zodExpr ?zod .
    BIND("field" AS ?kind) BIND("CaseSpace" AS ?cls) BIND("" AS ?custody)
  }
}
ORDER BY ?kind ?field
