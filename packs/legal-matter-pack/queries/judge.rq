PREFIX lm: <https://ggen.io/ontology/legal-matter#>
SELECT ?kind ?cls ?field ?zod ?members ?constName ?tsName
WHERE {
  {
    ?e a lm:Enum ; lm:constName ?constName ; lm:tsName ?tsName ; lm:members ?members .
    FILTER(?constName IN ("JudgeLeanEnumSchema", "RulingStandingEnumSchema"))
    BIND("enum" AS ?kind) BIND("" AS ?cls) BIND("" AS ?field)
    BIND("" AS ?zod)
  }
  UNION
  {
    ?f a lm:Field ; lm:belongsTo ?clsIri ; lm:fieldName ?field ; lm:zodExpr ?zod .
    FILTER(?clsIri IN (lm:JudgeProfile, lm:Ruling, lm:CaseSpec, lm:Motion, lm:JudgeRuling))
    BIND("field" AS ?kind)
    BIND(REPLACE(STR(?clsIri), "^.*[#/]", "") AS ?cls)
    BIND("" AS ?members) BIND("" AS ?constName) BIND("" AS ?tsName)
  }
}
ORDER BY ?kind ?cls ?field
