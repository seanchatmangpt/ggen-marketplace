// Sum-to-100 law on all three Positioning families (lm:sumConstraint "100").
// JurorPositioning/AggregateBreakdown extend Positioning's fields via
// .extend() on the strict base object, then carry the same refine.
export const PositioningBaseSchema = PositioningSchema;

type PositioningShape = { plaintiff: number; neutral: number; defendant: number };
function sharesSumTo100(p: PositioningShape): boolean {
  return p.plaintiff + p.neutral + p.defendant === 100;
}

export const PositioningRefinedSchema = PositioningBaseSchema.refine(sharesSumTo100, {
  message: "positioning shares must sum exactly to 100",
});
export type PositioningRefined = z.infer<typeof PositioningRefinedSchema>;
export type Positioning = PositioningRefined;

export const JurorPositioningRefinedSchema = JurorPositioningSchema.refine(sharesSumTo100, {
  message: "positioning shares must sum exactly to 100",
});
export type JurorPositioning = z.infer<typeof JurorPositioningRefinedSchema>;

export const AggregateBreakdownRefinedSchema = AggregateBreakdownSchema.refine(sharesSumTo100, {
  message: "positioning shares must sum exactly to 100",
});
export type AggregateBreakdown = z.infer<typeof AggregateBreakdownRefinedSchema>;

export type SimulationResult = z.infer<typeof SimulationResultSchema>;
