# Inverted verify gate: refusal rows (rv: pattern) must be well-formed:
# every rv:RefusalClass individual carries rv:className AND rv:classKind.
# MUST return zero rows.
PREFIX lm: <https://ggen.io/ontology/legal-matter#>
PREFIX rv: <urn:refusal-vocabulary:>

SELECT ?subject WHERE {
  {
    ?s a rv:RefusalClass .
    OPTIONAL { ?s rv:className ?cn }
    FILTER (!bound(?cn))
    BIND(STR(?s) AS ?subject)
  }
  UNION
  {
    ?s a rv:RefusalClass .
    OPTIONAL { ?s rv:classKind ?k }
    FILTER (!bound(?k))
    BIND(STR(?s) AS ?subject)
  }
}
