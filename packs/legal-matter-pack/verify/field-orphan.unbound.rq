# Inverted verify gate: MUST return zero rows.
# A row = an lm:Field whose lm:belongsTo does not resolve to a declared
# domain class (orphan field) — a contract line projected from nothing.
PREFIX lm: <https://ggen.io/ontology/legal-matter#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?field WHERE {
  ?f a lm:Field ; lm:belongsTo ?cls ; lm:fieldName ?field .
  OPTIONAL { ?cls a rdfs:Class . BIND(?cls AS ?ok) }
  FILTER (!bound(?ok))
}
