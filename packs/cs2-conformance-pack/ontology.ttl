@prefix cs2: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/cs2#> .
@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:ggen:pack:cs2-conformance-pack> a gp:Pack ;
  gp:name "cs2-conformance-pack" ;
  gp:version "26.9.26" .

cs2:ConformanceSubject a rdfs:Class ; rdfs:subClassOf prov:Entity .
cs2:Projection a rdfs:Class ; rdfs:subClassOf prov:Entity .
cs2:ExecutableWitness a rdfs:Class ; rdfs:subClassOf prov:Entity .
cs2:ReplayReceipt a rdfs:Class ; rdfs:subClassOf prov:Entity .
cs2:Refusal a rdfs:Class ; rdfs:subClassOf prov:Entity .

cs2:subjectId a rdf:Property ; rdfs:range xsd:string .
cs2:rootDigest a rdf:Property ; rdfs:range xsd:string .
cs2:sourceRepo a rdf:Property ; rdfs:range xsd:string .
cs2:sourceSha a rdf:Property ; rdfs:range xsd:string .
cs2:sourceDigest a rdf:Property ; rdfs:range xsd:string .
cs2:projectionKind a rdf:Property ; rdfs:range xsd:string .
cs2:projectionDigest a rdf:Property ; rdfs:range xsd:string .
cs2:projectsSubject a rdf:Property ; rdfs:range cs2:ConformanceSubject .
cs2:witnessesProjection a rdf:Property ; rdfs:range cs2:Projection .
cs2:executableEntry a rdf:Property ; rdfs:range xsd:string .
cs2:receiptDigest a rdf:Property ; rdfs:range xsd:string .
cs2:refusalCode a rdf:Property ; rdfs:range xsd:string .
cs2:observedSubject a rdf:Property ; rdfs:range xsd:string .
cs2:expectedSubject a rdf:Property ; rdfs:range xsd:string .
cs2:authorityCeiling a rdf:Property ; rdfs:range xsd:string .
cs2:grantsDoAuthority a rdf:Property ; rdfs:range xsd:boolean .

cs2:rfcCs2_001 a cs2:ConformanceSubject ;
  dcterms:title "RFC-CS2-001" ;
  cs2:subjectId "RFC-CS2-001" ;
  cs2:authorityCeiling "OBSERVE|SELECT|CONSTRUCT" ;
  cs2:grantsDoAuthority false .

cs2:contractV1 a prov:Entity ;
  dcterms:title "CS2 exact-root projection contract v1" ;
  cs2:expectedSubject "RFC-CS2-001" ;
  cs2:authorityCeiling "OBSERVE|SELECT|CONSTRUCT" ;
  cs2:grantsDoAuthority false .
