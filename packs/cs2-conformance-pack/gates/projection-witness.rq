PREFIX cs2: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/cs2#>
ASK {
  ?projection a cs2:Projection ;
    cs2:projectsSubject ?subject ;
    cs2:projectionDigest ?digest .
  FILTER NOT EXISTS {
    ?witness a cs2:ExecutableWitness ;
      cs2:witnessesProjection ?projection ;
      cs2:executableEntry ?entry .
  }
}
