PREFIX cs2: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/cs2#>
ASK {
  ?subject a cs2:ConformanceSubject .
  FILTER (
    NOT EXISTS { ?subject cs2:sourceRepo ?repo } ||
    NOT EXISTS { ?subject cs2:sourceSha ?sha } ||
    NOT EXISTS { ?subject cs2:sourceDigest ?digest } ||
    NOT EXISTS { ?subject cs2:rootDigest ?root }
  )
}
