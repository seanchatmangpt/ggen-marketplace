{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seanchatmangpt.github.io/ggen-marketplace/schema/cs2/exact-subject.schema.json",
  "title": "RFC-CS2-001 Exact Subject",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject","source_repo","source_sha","source_digest","root_digest"],
  "properties": {
    "subject": {"const": "RFC-CS2-001"},
    "source_repo": {"type":"string","minLength":3},
    "source_sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "source_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "root_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
