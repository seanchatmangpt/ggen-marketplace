{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://seanchatmangpt.github.io/ggen-marketplace/schema/cs2/receipt.schema.json",
  "title":"RFC-CS2-001 Replay Receipt",
  "type":"object",
  "additionalProperties":false,
  "required":["contract","exact_subject","projection_digests","authority_ceiling","grants_do_authority","receipt_digest"],
  "properties":{
    "contract":{"const":"RFC-CS2-001"},
    "exact_subject":{"$ref":"exact-subject.schema.json"},
    "projection_digests":{"type":"array","items":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"uniqueItems":true},
    "authority_ceiling":{"const":"OBSERVE|SELECT|CONSTRUCT"},
    "grants_do_authority":{"const":false},
    "receipt_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
