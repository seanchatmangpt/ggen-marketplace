{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://seanchatmangpt.github.io/ggen-marketplace/schema/cs2/witness.schema.json",
  "title":"RFC-CS2-001 Executable Witness",
  "type":"object",
  "additionalProperties":false,
  "required":["contract","projection_digest","executable_entry","authority_ceiling","grants_do_authority","witness_digest"],
  "properties":{
    "contract":{"const":"RFC-CS2-001"},
    "projection_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "executable_entry":{"type":"string","minLength":1},
    "authority_ceiling":{"const":"OBSERVE|SELECT|CONSTRUCT"},
    "grants_do_authority":{"const":false},
    "witness_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
