{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seanchatmangpt.github.io/ggen-marketplace/schema/cs2/projection.schema.json",
  "title": "RFC-CS2-001 Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract","projection_kind","subject","payload","authority_ceiling","grants_do_authority","projection_digest"],
  "properties": {
    "contract": {"const":"RFC-CS2-001"},
    "projection_kind": {"type":"string","minLength":1},
    "subject": {"$ref":"exact-subject.schema.json"},
    "payload": {"type":"object"},
    "authority_ceiling": {"const":"OBSERVE|SELECT|CONSTRUCT"},
    "grants_do_authority": {"const":false},
    "projection_digest": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
