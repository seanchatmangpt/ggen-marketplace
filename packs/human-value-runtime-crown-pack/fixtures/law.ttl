@prefix hv: <https://ggen.dev/ontology/human-value-runtime#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

hv:RuntimeCrownScenario a hv:HumanValueScenario ;
  hv:scenarioId "runtime-crown-law" ;
  hv:standing "HUMAN_VALUE_UNKNOWN" .

hv:RuntimeProvider a hv:DynamicValueProvider .
hv:RuntimeWorld a hv:GeneratedWorld ; hv:provider hv:RuntimeProvider .
hv:RuntimeResource a hv:AshResource .
hv:AcquireAction a hv:AshAction .
hv:QualifyAction a hv:AshAction .
hv:RuntimeRecord a hv:AshRecord ; prov:wasGeneratedBy hv:AcquireAction .
hv:HumanRoute a hv:PhoenixRoute .
hv:HumanLiveView a hv:LiveView .
hv:BrowserJourney a hv:PlaywrightJourney .
hv:FromCustomer a hv:RevenueFromCustomer ; hv:synthetic true ; hv:evidenceClass "SYNTHETIC_SOFTWARE_BEHAVIOR_ONLY" ; hv:derivedFromRecord hv:RuntimeRecord ; hv:observedBy hv:BrowserJourney .
hv:ForCustomer a hv:RevenueForCustomer ; hv:synthetic true ; hv:evidenceClass "SYNTHETIC_SOFTWARE_BEHAVIOR_ONLY" ; hv:derivedFromRecord hv:RuntimeRecord ; hv:observedBy hv:BrowserJourney .
hv:RuntimeReceipt a hv:ValueReceipt ; hv:standing "VALUE_PARTIAL_PENDING_PLAYWRIGHT" ; hv:journey hv:BrowserJourney ; hv:ashRecord hv:RuntimeRecord ; hv:phoenixRoute hv:HumanRoute ; hv:liveView hv:HumanLiveView .
