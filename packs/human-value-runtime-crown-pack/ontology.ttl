@prefix hv: <https://ggen.dev/ontology/human-value-runtime#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hv:HumanValueScenario a rdfs:Class ; rdfs:subClassOf prov:Activity .
hv:AcceptanceCriterion a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .
hv:DynamicValueProvider a rdfs:Class ; rdfs:subClassOf prov:SoftwareAgent .
hv:GeneratedWorld a rdfs:Class ; rdfs:subClassOf prov:Entity .
hv:AshResource a rdfs:Class ; rdfs:subClassOf prov:Entity .
hv:AshAction a rdfs:Class ; rdfs:subClassOf prov:Activity .
hv:AshRecord a rdfs:Class ; rdfs:subClassOf prov:Entity .
hv:PhoenixRoute a rdfs:Class ; rdfs:subClassOf prov:Entity .
hv:LiveView a rdfs:Class ; rdfs:subClassOf prov:SoftwareAgent .
hv:PlaywrightJourney a rdfs:Class ; rdfs:subClassOf prov:Activity .
hv:RenderedValue a rdfs:Class ; rdfs:subClassOf prov:Entity .
hv:ValueReceipt a rdfs:Class ; rdfs:subClassOf prov:Entity .
hv:StaticLiteralFinding a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .
hv:Andon a rdfs:Class ; rdfs:subClassOf prov:Entity .
hv:RevenueFromCustomer a rdfs:Class ; rdfs:subClassOf hv:RenderedValue .
hv:RevenueForCustomer a rdfs:Class ; rdfs:subClassOf hv:RenderedValue .

hv:scenarioId a rdf:Property ; rdfs:range xsd:string .
hv:runId a rdf:Property ; rdfs:range xsd:string .
hv:seed a rdf:Property ; rdfs:range xsd:integer .
hv:provider a rdf:Property ; rdfs:range hv:DynamicValueProvider .
hv:generatedWorld a rdf:Property ; rdfs:range hv:GeneratedWorld .
hv:ashResource a rdf:Property ; rdfs:range hv:AshResource .
hv:ashAction a rdf:Property ; rdfs:range hv:AshAction .
hv:ashRecord a rdf:Property ; rdfs:range hv:AshRecord .
hv:phoenixRoute a rdf:Property ; rdfs:range hv:PhoenixRoute .
hv:liveView a rdf:Property ; rdfs:range hv:LiveView .
hv:journey a rdf:Property ; rdfs:range hv:PlaywrightJourney .
hv:renderedValue a rdf:Property ; rdfs:range hv:RenderedValue .
hv:valueReceipt a rdf:Property ; rdfs:range hv:ValueReceipt .
hv:staticFinding a rdf:Property ; rdfs:range hv:StaticLiteralFinding .
hv:standing a rdf:Property ; rdfs:range xsd:string .
hv:synthetic a rdf:Property ; rdfs:range xsd:boolean .
hv:acquiredAt a rdf:Property ; rdfs:range xsd:dateTime .
hv:observedBy a rdf:Property ; rdfs:range hv:PlaywrightJourney .
hv:derivedFromRecord a rdf:Property ; rdfs:range hv:AshRecord .
hv:evidenceClass a rdf:Property ; rdfs:range xsd:string .
hv:staticClassification a rdf:Property ; rdfs:range xsd:string .
hv:exactSubject a rdf:Property ; rdfs:range xsd:string .
hv:screenshot a rdf:Property ; rdfs:range prov:Entity .
hv:trace a rdf:Property ; rdfs:range prov:Entity .

hv:VALUE_ALIVE a skos:Concept ; skos:prefLabel "VALUE_ALIVE" .
hv:VALUE_PARTIAL a skos:Concept ; skos:prefLabel "VALUE_PARTIAL" .
hv:VALUE_REFUSED a skos:Concept ; skos:prefLabel "VALUE_REFUSED" .
hv:SYNTHETIC_SOFTWARE_BEHAVIOR_ONLY a skos:Concept ; skos:prefLabel "Synthetic software behavior only" .
