const { test, expect } = require('@playwright/test');

test('dynamic acquisition reaches the human with provenance', async ({ page }) => {
  await page.goto('{{ route }}');
  await page.getByRole('button', { name: '{{ acquire_label }}' }).click();
  const first = page.locator('[data-world]').first();
  const firstScenario = await first.getAttribute('data-scenario-id');
  await page.getByRole('button', { name: '{{ acquire_label }}' }).click();
  const second = page.locator('[data-world]').first();
  await expect(page.locator('[data-world]')).toHaveCount(2);
  expect(await second.getAttribute('data-scenario-id')).not.toBe(firstScenario);
  await expect(page.locator('#human-value-receipt')).not.toBeEmpty();
});
