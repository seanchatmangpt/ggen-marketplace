defmodule {{ module_name }} do
  @provider __MODULE__ |> Atom.to_string()
  @currency "{{ currency | default(value="USD") }}"

  def acquire(run_id, seed) when is_binary(run_id) and is_integer(seed) do
    %{run_id: run_id, seed: seed, provider: @provider, currency: @currency, acquired_at: DateTime.utc_now(), synthetic: true}
  end
end
