defmodule {{ module_name }} do
  use {{ web_module }}, :live_view

  @impl true
  def mount(_params, _session, socket) do
    {:ok, assign(socket, :run_id, "runtime-#{System.system_time(:microsecond)}")}
  end

  @impl true
  def render(assigns) do
    ~H"""
    <main data-human-value-run={@run_id}>
      <button phx-click="acquire">Acquire value world</button>
      <section id="human-value-worlds"></section>
      <pre id="human-value-receipt"></pre>
    </main>
    """
  end
end
