PREFIX hc: <urn:autofde-lab:hook-contract:>
SELECT ?module ?class_name ?hook ?raises ?signature ?contract ?skip
WHERE {
  ?h a hc:Hook ;
     hc:module ?module ; hc:className ?class_name ; hc:hookName ?hook ;
     hc:raises ?raises ; hc:signature ?signature ; hc:contract ?contract ;
     hc:skipReason ?skip .
}
ORDER BY ?module ?class_name ?hook
