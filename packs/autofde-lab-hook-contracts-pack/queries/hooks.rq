PREFIX hc: <urn:autofde-lab:hook-contract:>
SELECT ?module ?class_name ?hook ?raises ?n_req ?kwreq ?skip ?contract
WHERE {
  ?h a hc:Hook ;
     hc:module ?module ; hc:className ?class_name ; hc:hookName ?hook ;
     hc:raises ?raises ; hc:requiredArgs ?n_req ; hc:requiredKwOnly ?kwreq ;
     hc:skipReason ?skip ; hc:contract ?contract .
}
ORDER BY ?module ?class_name ?hook
