defmodule BeamPM.PostLLM.Authority do
  @moduledoc false
  @allowed_action "{{ c.action }}"
  @refusal_code "{{ c.refusal_code }}"
  @refusal_reason "{{ c.refusal_reason }}"

  def allowed_action, do: @allowed_action

  def admit(%BeamPM.PostLLM.Intent{} = intent, context) do
    cond do
      intent.phase != :select -> refuse(intent.subject, "SELECT boundary has not promoted this intent")
      intent.authority != :requested -> refuse(intent.subject, "explicit DO authority was not requested")
      intent.action != @allowed_action -> refuse(intent.subject, "ODRL action is not admitted")
      Map.get(context, :policy) != :admitted -> refuse(intent.subject, "policy context is not admitted")
      true -> :ok
    end
  end

  defp refuse(subject, reason), do: BeamPM.PostLLM.Refusal.new(@refusal_code, @refusal_reason <> ": " <> reason, subject) |> BeamPM.PostLLM.Refusal.tagged()
end

defmodule BeamPM.PostLLM.KnowledgeHook do
  @moduledoc "Pure knowledge hook: manufactures candidate intents and never actuates."

  def manufacture(observation, capability, payload, opts \\ []) do
    id = BeamPM.PostLLM.Digest.sha256({:knowledge_hook, observation, capability, payload})
    %BeamPM.PostLLM.Intent{
      id: id,
      subject: BeamPM.PostLLM.ExactSubject.subject(),
      capability: capability,
      action: BeamPM.PostLLM.Authority.allowed_action(),
      payload: payload,
      phase: :construct,
      authority: :none,
      reversible: Keyword.get(opts, :reversible, true),
      cost: Keyword.get(opts, :cost, 0),
      evidence: Keyword.get(opts, :evidence, 0)
    }
  end
end

defmodule BeamPM.PostLLM.DfCM do
  @moduledoc "Deterministic reversible-first option ordering; ranking has no DO authority."

  def rank(candidates) when is_list(candidates) do
    Enum.sort_by(candidates, fn candidate ->
      {if(candidate.reversible, do: 0, else: 1), candidate.cost, -candidate.evidence, candidate.id}
    end)
  end
end

defmodule BeamPM.PostLLM.Select do
  @moduledoc "Pure SELECT transition. Promotion requests authority but still cannot actuate."

  def request_do(%BeamPM.PostLLM.Intent{phase: :construct} = intent), do: %{intent | phase: :select, authority: :requested}
  def request_do(%BeamPM.PostLLM.Intent{} = intent), do: BeamPM.PostLLM.Refusal.new("SELECT_REFUSED", "intent is not at the construct boundary", intent.subject) |> BeamPM.PostLLM.Refusal.tagged()
end

