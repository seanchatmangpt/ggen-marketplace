defmodule BeamPM.PostLLM.Receipt do
  @moduledoc false
  @replay_key "{{ c.replay_key }}"
  @enforce_keys [:id, :subject, :intent, :result, :recorded_at, :replay_key]
  defstruct [:id, :subject, :intent, :result, :recorded_at, :replay_key]

  def new(%BeamPM.PostLLM.Intent{} = intent, result, recorded_at) do
    payload = {intent.subject, intent, result, recorded_at, @replay_key}
    %__MODULE__{
      id: BeamPM.PostLLM.Digest.sha256(payload),
      subject: intent.subject,
      intent: intent,
      result: result,
      recorded_at: recorded_at,
      replay_key: @replay_key
    }
  end

  def verify(%__MODULE__{} = receipt) do
    receipt.id == BeamPM.PostLLM.Digest.sha256({receipt.subject, receipt.intent, receipt.result, receipt.recorded_at, receipt.replay_key})
  end
end

defmodule BeamPM.PostLLM.BRCE do
  @moduledoc "Exclusive DO boundary: exact subject -> capability -> context -> authority -> actuation -> receipt."

  def execute(%BeamPM.PostLLM.Intent{} = intent, context, actuator, recorded_at) when is_function(actuator, 1) do
    with :ok <- BeamPM.PostLLM.ExactSubject.admit(intent.subject),
         :ok <- BeamPM.PostLLM.Capability.admit(intent.capability),
         :ok <- BeamPM.PostLLM.PolicyContext.validate(context),
         :ok <- BeamPM.PostLLM.Authority.admit(intent, context) do
      actuate_with_receipt(intent, actuator, recorded_at)
    end
  end

  def execute(%BeamPM.PostLLM.Intent{} = intent, _context, _actuator, _recorded_at),
    do: BeamPM.PostLLM.Refusal.new("ACTUATOR_REFUSED", "actuator must be an explicitly supplied arity-1 function", intent.subject) |> BeamPM.PostLLM.Refusal.tagged()

  defp actuate_with_receipt(intent, actuator, recorded_at) do
    try do
      consequence = actuator.(intent)
      receipt = BeamPM.PostLLM.Receipt.new(intent, {:ok, consequence}, recorded_at)
      {:ok, consequence, receipt}
    rescue
      error ->
        failure = {:exception, error.__struct__, Exception.message(error)}
        receipt = BeamPM.PostLLM.Receipt.new(intent, {:error, failure}, recorded_at)
        {:error, failure, receipt}
    catch
      kind, reason ->
        failure = {kind, reason}
        receipt = BeamPM.PostLLM.Receipt.new(intent, {:error, failure}, recorded_at)
        {:error, failure, receipt}
    end
  end
end

defmodule BeamPM.PostLLM.Replay do
  @moduledoc "Replay manufactures a fresh non-authorized intent; it never actuates."

  def manufacture(%BeamPM.PostLLM.Receipt{} = receipt) do
    if BeamPM.PostLLM.Receipt.verify(receipt) do
      {:ok, %{receipt.intent | phase: :construct, authority: :none}}
    else
      BeamPM.PostLLM.Refusal.new("REPLAY_REFUSED", "receipt integrity check failed", receipt.subject) |> BeamPM.PostLLM.Refusal.tagged()
    end
  end
end

defmodule BeamPM.PostLLM.Compensation do
  @moduledoc "Compensation is manufactured as an intent and must re-enter SELECT and BRCE."

  def manufacture(%BeamPM.PostLLM.Receipt{} = receipt, payload) do
    candidate = BeamPM.PostLLM.KnowledgeHook.manufacture({:compensation_for, receipt.id}, "compensate", payload, reversible: true, evidence: 1)
    %{candidate | id: BeamPM.PostLLM.Digest.sha256({:compensation, receipt.id, payload})}
  end
end

defmodule BeamPM.PostLLM.Standing do
  @moduledoc false
  @dimensions [:observed, :admitted, :executed, :changed, :verified, :inferred, :refused, :blocked, :unsupported]
  def dimensions, do: @dimensions

  def classify(evidence) when is_map(evidence) do
    cond do
      Map.get(evidence, :unsupported) -> :unsupported
      Map.get(evidence, :blocked) -> :blocked
      Map.get(evidence, :build_broken) -> :build_broken
      Map.get(evidence, :executed) && Map.get(evidence, :verified) -> :alive
      Map.get(evidence, :observed) || Map.get(evidence, :admitted) || Map.get(evidence, :executed) -> :partial_alive
      true -> :unknown
    end
  end
end

