defmodule BeamPM.PostLLM.Digest do
  @moduledoc false
  def sha256(term) do
    term
    |> :erlang.term_to_binary([:deterministic])
    |> :crypto.hash(:sha256)
    |> Base.encode16(case: :lower)
  end
end

defmodule BeamPM.PostLLM.Refusal do
  @moduledoc false
  @enforce_keys [:code, :reason]
  defstruct [:code, :reason, :subject]

  def new(code, reason, subject \\ nil), do: %__MODULE__{code: code, reason: reason, subject: subject}
  def tagged(%__MODULE__{} = refusal), do: {:refused, refusal.code, refusal.reason, refusal.subject}
end

defmodule BeamPM.PostLLM.ExactSubject do
  @moduledoc false
  @subject %{repo: "{{ c.repo }}", base: "{{ c.base }}", head: "{{ c.head }}"}

  def subject, do: @subject
  def exact?(candidate), do: candidate == @subject

  def admit(candidate) do
    if exact?(candidate),
      do: :ok,
      else: BeamPM.PostLLM.Refusal.new("SUBJECT_MISMATCH", "candidate does not match the admitted exact subject", candidate) |> BeamPM.PostLLM.Refusal.tagged()
  end
end

