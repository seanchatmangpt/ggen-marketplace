---
to: generated/post_llm/runtime.ex
sparql:
  contracts: |
    PREFIX rt: <https://ggen.dev/ontology/runtime-integration#>
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
    SELECT ?integration ?repo ?base ?head ?action ?replay_key ?refusal_code ?refusal_reason WHERE {
      ?integration a rt:RuntimeContract ;
        rt:hasSubject ?subject ;
        rt:hasAuthorityPolicy ?policy ;
        rt:replayKey ?replay_key ;
        rt:refusalCode ?refusal_code ;
        rt:refusalReason ?refusal_reason .
      ?subject a rt:ExactSubject ;
        dct:isPartOf ?repo ;
        dct:source ?base ;
        dct:identifier ?head .
      ?policy odrl:permission ?permission .
      ?permission odrl:action ?action .
    } ORDER BY ?integration LIMIT 1
  capabilities: |
    PREFIX rt: <https://ggen.dev/ontology/runtime-integration#>
    SELECT ?capability WHERE {
      ?integration a rt:RuntimeContract ; rt:enablesCapability ?capability .
    } ORDER BY ?capability
---
{% for c in contracts %}
