@prefix rt: <https://ggen.dev/ontology/runtime-integration#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

rt:RuntimeContract a rdfs:Class ; rdfs:subClassOf prov:Entity .
rt:ExactSubject a rdfs:Class ; rdfs:subClassOf prov:Entity .

rt:hasSubject a rdf:Property .
rt:hasAuthorityPolicy a rdf:Property .
rt:replayKey a rdf:Property .
rt:refusalCode a rdf:Property .
rt:refusalReason a rdf:Property .
rt:enablesCapability a rdf:Property .

# Authority itself remains ODRL. Exact subject identity remains DCTERMS.
# Runtime execution evidence is projected as PROV-compatible receipt/event data.
