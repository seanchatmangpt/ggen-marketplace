@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# DERIVED by scripts/derive_autofde.py from AutoFDE Lab's real OpenClaw bridge.
# Every title, description, parameter name and JSON type below is read out of
# src/autofde_lab/openclaw_bridge.py::_TOOL_SPECS; every replaySafe flag out of
# integrations/openclaw/openclaw.plugin.json::toolMetadata. Nothing is invented.

<urn:autofde-lab:mcp:server>
    a <urn:gymmcp:McpServer> ;
    dct:identifier "autofde_lab" ;
    dct:title "scikit-decide" ;
    dct:hasVersion "0.1.0" ;
    prov:wasDerivedFrom <urn:autofde-lab:src:openclaw_bridge.py> .

<urn:autofde-lab:mcp:op:catalog>
    a sosa:Procedure ;
    dct:title "catalog" ;
    dct:description "List registered scikit-decide domains and solvers." ;
    dct:type <urn:gymact:consequence:read> ;
    <urn:gymmcp:replaySafe> true ;
    <urn:gymmcp:hasParameter> <urn:autofde-lab:mcp:op:catalog:param:kind> .

<urn:autofde-lab:mcp:op:catalog:param:kind>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "kind" ;
    dct:type "string" ;
    <urn:gymmcp:required> false .

<urn:autofde-lab:mcp:op:describe>
    a sosa:Procedure ;
    dct:title "describe" ;
    dct:description "Describe one registered domain or solver." ;
    dct:type <urn:gymact:consequence:read> ;
    <urn:gymmcp:replaySafe> true ;
    <urn:gymmcp:hasParameter> <urn:autofde-lab:mcp:op:describe:param:kind> ;
    <urn:gymmcp:hasParameter> <urn:autofde-lab:mcp:op:describe:param:name> .

<urn:autofde-lab:mcp:op:describe:param:kind>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "kind" ;
    dct:type "string" ;
    <urn:gymmcp:required> true .

<urn:autofde-lab:mcp:op:describe:param:name>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "name" ;
    dct:type "string" ;
    <urn:gymmcp:required> true .

<urn:autofde-lab:mcp:op:match>
    a sosa:Procedure ;
    dct:title "match" ;
    dct:description "Construct a registered domain and list compatible solvers." ;
    dct:type <urn:gymact:consequence:do> ;
    <urn:gymmcp:replaySafe> false ;
    <urn:gymmcp:requiresAdmission> true ;
    <urn:gymmcp:hasParameter> <urn:autofde-lab:mcp:op:match:param:domain> .

<urn:autofde-lab:mcp:op:match:param:domain>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "domain" ;
    dct:type "object" ;
    <urn:gymmcp:required> true .

<urn:autofde-lab:mcp:op:run>
    a sosa:Procedure ;
    dct:title "run" ;
    dct:description "Run a bounded rollout using registered subjects only." ;
    dct:type <urn:gymact:consequence:do> ;
    <urn:gymmcp:replaySafe> false ;
    <urn:gymmcp:requiresAdmission> true ;
    <urn:gymmcp:hasParameter> <urn:autofde-lab:mcp:op:run:param:domain> ;
    <urn:gymmcp:hasParameter> <urn:autofde-lab:mcp:op:run:param:rollout> ;
    <urn:gymmcp:hasParameter> <urn:autofde-lab:mcp:op:run:param:solve> ;
    <urn:gymmcp:hasParameter> <urn:autofde-lab:mcp:op:run:param:solver> ;
    <urn:gymmcp:hasParameter> <urn:autofde-lab:mcp:op:run:param:timeout_seconds> .

<urn:autofde-lab:mcp:op:run:param:domain>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "domain" ;
    dct:type "object" ;
    <urn:gymmcp:required> true .

<urn:autofde-lab:mcp:op:run:param:rollout>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "rollout" ;
    dct:type "object" ;
    <urn:gymmcp:required> false .

<urn:autofde-lab:mcp:op:run:param:solve>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "solve" ;
    dct:type "boolean" ;
    <urn:gymmcp:required> false .

<urn:autofde-lab:mcp:op:run:param:solver>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "solver" ;
    dct:type "object" ;
    <urn:gymmcp:required> false .

<urn:autofde-lab:mcp:op:run:param:timeout_seconds>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "timeout_seconds" ;
    dct:type "number" ;
    <urn:gymmcp:required> false .
