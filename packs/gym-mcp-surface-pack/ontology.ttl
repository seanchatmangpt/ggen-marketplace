@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Shared gym MCP-surface vocabulary.
#
# Reused, not minted: dct: (title/description/type/identifier/hasVersion),
# sosa:Procedure (an operation, exactly as chatgptgym-gymact-bridge-pack models it),
# skos: (consequence concepts), prov: (derivation from the gym's real source).
# Minted only where no public vocabulary covers the concept: the MCP server node,
# tool parameters, replay safety, and the admission obligation.
#################################################################

<urn:gymmcp:McpServer> a skos:Concept ;
    skos:prefLabel "MCP server projection of a gym operation surface" ;
    dct:description "Carries the tool-name namespace (dct:identifier), display name, and version." .

<urn:gymmcp:Parameter> a skos:Concept ;
    skos:prefLabel "One MCP tool input-schema property" .

<urn:gymmcp:hasParameter> a skos:Concept ;
    skos:prefLabel "Relates an operation to one of its input parameters" .

<urn:gymmcp:required> a skos:Concept ;
    skos:prefLabel "Parameter appears in the tool inputSchema required array" .

<urn:gymmcp:replaySafe> a skos:Concept ;
    skos:prefLabel "Re-executing this call cannot change observable state" ;
    dct:description "Grounded in the real replaySafe flags carried by AutoFDE Lab's integrations/openclaw/openclaw.plugin.json toolMetadata block." .

<urn:gymmcp:requiresAdmission> a skos:Concept ;
    skos:prefLabel "Execution must pass GymAct/BRCE admission" ;
    dct:description "Obligation that replaces chatgptgym-gymact-bridge-pack's pack-local DO title whitelist, so the boundary travels between gyms." .

#################################################################
# Self-description: this pack's own projection surface, so the pack is
# runnable standalone. Both operations are observational -- projecting a
# graph into a tool catalog writes source files and actuates nothing.
#################################################################

<urn:gymmcp:server:self>
    a <urn:gymmcp:McpServer> ;
    dct:identifier "gymmcp" ;
    dct:title "gym-mcp-surface" ;
    dct:hasVersion "26.9.1" ;
    prov:wasDerivedFrom <urn:pack:chatgptgym-gymact-bridge-pack> .

<urn:gymmcp:capability:project-rust-surface>
    a sosa:Procedure ;
    dct:title "project-rust-surface" ;
    dct:description "Project an admitted gym operation graph into a Rust MCP tool catalog." ;
    dct:type <urn:gymact:consequence:read> ;
    <urn:gymmcp:replaySafe> true ;
    <urn:gymmcp:hasParameter> <urn:gymmcp:param:project-rust-surface:graph> .

<urn:gymmcp:param:project-rust-surface:graph>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "graph" ;
    dct:type "string" ;
    <urn:gymmcp:required> true .

<urn:gymmcp:capability:project-tools-list>
    a sosa:Procedure ;
    dct:title "project-tools-list" ;
    dct:description "Project an admitted gym operation graph into an MCP tools/list document." ;
    dct:type <urn:gymact:consequence:read> ;
    <urn:gymmcp:replaySafe> true ;
    <urn:gymmcp:hasParameter> <urn:gymmcp:param:project-tools-list:graph> .

<urn:gymmcp:param:project-tools-list:graph>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "graph" ;
    dct:type "string" ;
    <urn:gymmcp:required> true .
