@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shared MCP-surface profile for gym operation graphs.
#
# Consequence classification deliberately reuses the GymAct concepts
# (<urn:gymact:consequence:read> / <urn:gymact:consequence:do>) established by
# chatgptgym-gymact-bridge-pack, so a gym that already classifies its operations
# needs no reclassification to gain an MCP projection.

<urn:gymmcp:shape:server>
    a sh:NodeShape ;
    sh:targetClass <urn:gymmcp:McpServer> ;
    sh:property [
        sh:path dct:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An MCP server node must declare exactly one string dct:identifier used as the tool-name namespace."
    ] ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path dct:hasVersion ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

<urn:gymmcp:shape:operation>
    a sh:NodeShape ;
    sh:targetClass sosa:Procedure ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "An operation represented as sosa:Procedure must declare exactly one string dct:title."
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An MCP-projected operation must carry a description; an undescribed tool is not callable by a model."
    ] ;
    sh:property [
        sh:path dct:type ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( <urn:gymact:consequence:read> <urn:gymact:consequence:do> ) ;
        sh:message "An operation must classify consequence as READ or DO using the GymAct concepts."
    ] ;
    sh:property [
        sh:path <urn:gymmcp:replaySafe> ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path <urn:gymmcp:requiresAdmission> ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] .

<urn:gymmcp:shape:parameter>
    a sh:NodeShape ;
    sh:targetClass <urn:gymmcp:Parameter> ;
    sh:property [
        sh:path dct:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] ;
    sh:property [
        sh:path dct:type ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "string" "integer" "number" "boolean" "array" "object" )
    ] ;
    sh:property [
        sh:path <urn:gymmcp:required> ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] .
