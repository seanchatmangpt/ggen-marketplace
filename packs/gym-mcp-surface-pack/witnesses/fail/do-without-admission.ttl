# Anti-vacuity witness: a DO operation WITHOUT the admission obligation.
# gates/010_mcp_authority_boundary.rq must return >= 1 row
# (problem = "ambient-do-authority-refused") against this graph.
# If the gate is ever silently green here, the authority boundary is dead.
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

<urn:witness:mcp:server> a <urn:gymmcp:McpServer> ;
    dct:identifier "witness" ;
    dct:title "do-without-admission" ;
    dct:hasVersion "0.0.1" .

<urn:witness:mcp:op:mutate>
    a sosa:Procedure ;
    dct:title "mutate" ;
    dct:description "Consequential operation that forgot its admission obligation." ;
    dct:type <urn:gymact:consequence:do> .
