# Anti-vacuity witness: TWO server nodes in one graph.
# gates/010_mcp_authority_boundary.rq must return >= 1 row
# (problem = "multiple-mcp-server-nodes-refused") against this graph.
# This is also the standing proof that family modules may never be merged
# into the kernel graph for rendering: one rendering graph = one server.
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

<urn:witness:mcp:server:a> a <urn:gymmcp:McpServer> ;
    dct:identifier "witness_a" ;
    dct:title "two-servers" ;
    dct:hasVersion "0.0.1" .

<urn:witness:mcp:server:b> a <urn:gymmcp:McpServer> ;
    dct:identifier "witness_b" ;
    dct:title "two-servers" ;
    dct:hasVersion "0.0.1" .

<urn:witness:mcp:op:inspect>
    a sosa:Procedure ;
    dct:title "inspect" ;
    dct:description "Observational operation, valid in isolation." ;
    dct:type <urn:gymact:consequence:read> .
