---
to: "src/mcp_tool_surface.rs"
shape:
  - shapes/mcp_surface.shacl.ttl
sparql:
  srv: |
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?ns ?title ?version
    WHERE {
      ?s a <urn:gymmcp:McpServer> ;
         dct:identifier ?ns ;
         dct:title ?title ;
         dct:hasVersion ?version .
    }
    ORDER BY ?ns
  ops: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id ?description ?consequence_class ?replay_safe ?admission
    WHERE {
      ?cap a sosa:Procedure ;
           dct:title ?id ;
           dct:description ?description ;
           dct:type ?class .
      OPTIONAL { ?cap <urn:gymmcp:replaySafe> ?rs }
      OPTIONAL { ?cap <urn:gymmcp:requiresAdmission> ?ra }
      BIND(IF(CONTAINS(STR(?class), "consequence:do"), "Do", "Read") AS ?consequence_class)
      BIND(IF(BOUND(?rs) && ?rs = true, "true", "false") AS ?replay_safe)
      BIND(IF(BOUND(?ra) && ?ra = true, "true", "false") AS ?admission)
    }
    ORDER BY ?id
  params: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?op ?name ?json_type ?required
    WHERE {
      ?cap a sosa:Procedure ; dct:title ?op ; <urn:gymmcp:hasParameter> ?p .
      ?p dct:identifier ?name ; dct:type ?json_type .
      OPTIONAL { ?p <urn:gymmcp:required> ?rq }
      BIND(IF(BOUND(?rq) && ?rq = true, "true", "false") AS ?required)
    }
    ORDER BY ?op ?name
---
//! GENERATED by ggen from an admitted gym operation graph. Do not edit.
//!
//! This file manufactures MCP tool *intents* only. It carries no runtime actuation
//! authority: an operation classified `Do` also carries `requires_admission`, and a
//! caller must obtain GymAct/BRCE admission before any consequential execution.
//! `Read` operations are observational.
{% for s in srv -%}
pub const MCP_SERVER_NAME: &str = "{{ s.title }}";
pub const MCP_SERVER_VERSION: &str = "{{ s.version }}";
pub const MCP_TOOL_NAMESPACE: &str = "{{ s.ns }}";
{% endfor %}
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct McpParameter {
    pub name: &'static str,
    pub json_type: &'static str,
    pub required: bool,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct McpTool {
    /// Namespaced MCP tool name as advertised over `tools/list`.
    pub name: &'static str,
    /// Bare operation id inside the gym's own operation vocabulary.
    pub operation_id: &'static str,
    pub description: &'static str,
    /// "Read" (observational) or "Do" (consequential).
    pub consequence_class: &'static str,
    /// True when re-executing the call cannot change observable state.
    pub replay_safe: bool,
    /// True when the call must pass GymAct/BRCE admission before execution.
    pub requires_admission: bool,
    pub parameters: &'static [McpParameter],
}
{% for row in ops %}
const PARAMS_{{ row.id | upper | replace(from="-", to="_") }}: &[McpParameter] = &[
{%- for p in params %}{% if p.op == row.id %}
    McpParameter { name: "{{ p.name }}", json_type: "{{ p.json_type }}", required: {{ p.required }} },
{%- endif %}{% endfor %}
];
{%- endfor %}

{% for s in srv -%}
pub const MCP_TOOLS: &[McpTool] = &[
{%- for row in ops %}
    McpTool {
        name: "{{ s.ns }}.{{ row.id }}",
        operation_id: "{{ row.id }}",
        description: "{{ row.description }}",
        consequence_class: "{{ row.consequence_class }}",
        replay_safe: {{ row.replay_safe }},
        requires_admission: {{ row.admission }},
        parameters: PARAMS_{{ row.id | upper | replace(from="-", to="_") }},
    },
{%- endfor %}
];
{% endfor %}
pub fn lookup_mcp_tool(name: &str) -> Option<&'static McpTool> {
    MCP_TOOLS
        .iter()
        .find(|tool| tool.name == name || tool.operation_id == name)
}

/// Tools a caller may execute without GymAct/BRCE admission.
pub fn observational_tools() -> impl Iterator<Item = &'static McpTool> {
    MCP_TOOLS
        .iter()
        .filter(|tool| !tool.requires_admission && tool.consequence_class == "Read")
}
