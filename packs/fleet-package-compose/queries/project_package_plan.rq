PREFIX fpc: <https://chatman.ai/fleet-package-compose#>
SELECT ?subject ?consumer ?family ?repo ?path ?template ?sha WHERE { ?p a fpc:Projection; fpc:subject ?subject; fpc:consumer ?consumer; fpc:family ?family; fpc:targetRepo ?repo; fpc:targetPath ?path; fpc:sourceSha ?sha . ?family fpc:templateKey ?template . } ORDER BY ?consumer ?family ?path
