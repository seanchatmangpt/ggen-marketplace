PREFIX ocr: <https://ggen.dev/ontology/option-capital-recombination#>
SELECT ?candidate (COUNT(DISTINCT ?unlocked) * COUNT(DISTINCT ?verifier) AS ?qualifiedDelta) WHERE { ?candidate a ocr:Candidate ; ocr:unlocks ?unlocked ; ocr:verifiedBy ?verifier . } GROUP BY ?candidate ORDER BY DESC(?qualifiedDelta) STR(?candidate)
