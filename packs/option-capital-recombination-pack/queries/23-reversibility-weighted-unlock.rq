PREFIX ocr: <https://ggen.dev/ontology/option-capital-recombination#>
SELECT ?candidate (?reversibility * COUNT(DISTINCT ?unlocked) AS ?weightedDelta) WHERE { ?candidate a ocr:Candidate ; ocr:reversibility ?reversibility ; ocr:unlocks ?unlocked . } GROUP BY ?candidate ?reversibility ORDER BY DESC(?weightedDelta) STR(?candidate)
