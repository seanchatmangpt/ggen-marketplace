PREFIX ocr: <https://ggen.dev/ontology/option-capital-recombination#>
SELECT ?candidate (COUNT(DISTINCT ?unlocked) * COUNT(DISTINCT ?consumer) AS ?consumerDelta) WHERE { ?candidate a ocr:Candidate ; ocr:unlocks ?unlocked ; ocr:targetsConsumer ?consumer . } GROUP BY ?candidate ORDER BY DESC(?consumerDelta) STR(?candidate)
