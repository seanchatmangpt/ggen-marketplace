@prefix ocr: <https://ggen.dev/ontology/option-capital-recombination#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ocr:prov-o a ocr:PublicOntology .
ocr:skos a ocr:PublicOntology .
ocr:dqv a ocr:PublicOntology .
ocr:ggen-marketplace a ocr:Repository .
ocr:ggen a ocr:Repository .
ocr:consumer-a a ocr:Consumer .
ocr:consumer-b a ocr:Consumer .
ocr:verifier-a a ocr:Verifier .
ocr:verifier-b a ocr:Verifier .
ocr:falsifier-a a ocr:Falsifier .
ocr:falsifier-b a ocr:Falsifier .
ocr:runtime-cli a ocr:RuntimeSurface .
ocr:runtime-api a ocr:RuntimeSurface .
ocr:cap-frontier a ocr:Capability .
ocr:cap-compose a ocr:Capability .
ocr:cap-qualify a ocr:Capability .

ocr:candidate-frontier a ocr:Candidate ; ocr:reversibility 0.98 ; ocr:candidateLeverage 10 ; ocr:reuseLeverage 8 ; ocr:consumerLeverage 4 ; ocr:authority "SELECT" ; ocr:standing "ADMITTED" ; ocr:usesOntology ocr:prov-o ; ocr:targetsRepository ocr:ggen-marketplace ; ocr:targetsConsumer ocr:consumer-a, ocr:consumer-b ; ocr:verifiedBy ocr:verifier-a ; ocr:falsifiedBy ocr:falsifier-a ; ocr:unlocks ocr:runtime-cli, ocr:cap-compose ; prov:wasDerivedFrom <dfcm/measure/latest> .
ocr:candidate-compose a ocr:Candidate ; ocr:reversibility 0.95 ; ocr:candidateLeverage 6 ; ocr:reuseLeverage 10 ; ocr:consumerLeverage 6 ; ocr:authority "CONSTRUCT" ; ocr:standing "ADMITTED" ; ocr:usesOntology ocr:skos ; ocr:targetsRepository ocr:ggen ; ocr:targetsConsumer ocr:consumer-a ; ocr:verifiedBy ocr:verifier-a, ocr:verifier-b ; ocr:falsifiedBy ocr:falsifier-b ; ocr:unlocks ocr:runtime-api, ocr:cap-qualify ; prov:wasDerivedFrom <dfcm/frontier/current> .
ocr:candidate-qualify a ocr:Candidate ; ocr:reversibility 0.90 ; ocr:candidateLeverage 4 ; ocr:reuseLeverage 6 ; ocr:consumerLeverage 10 ; ocr:authority "SELECT" ; ocr:standing "ADMITTED" ; ocr:usesOntology ocr:dqv ; ocr:targetsRepository ocr:ggen-marketplace ; ocr:targetsConsumer ocr:consumer-b ; ocr:verifiedBy ocr:verifier-b ; ocr:falsifiedBy ocr:falsifier-a ; ocr:unlocks ocr:cap-frontier ; prov:wasDerivedFrom <dfcm/portfolio/latest> .

ocr:compose-frontier-qualify a ocr:Composition ; ocr:sourceCapability ocr:cap-frontier ; ocr:targetCapability ocr:cap-qualify .
ocr:compose-compose-qualify a ocr:Composition ; ocr:sourceCapability ocr:cap-compose ; ocr:targetCapability ocr:cap-qualify .
