PREFIX typer: <https://ggen.io/ontology/typer-azure#>
SELECT ?kind ?app ?appName ?resourceType ?apiVersion ?option ?flag ?pyname ?pytype ?required ?help ?choices ?openEnum
WHERE {
  {
    ?app a typer:TyperSubApp ;
         typer:appName ?appName ;
         typer:resourceType ?resourceType ;
         typer:apiVersion ?apiVersion .
    BIND("app" AS ?kind)
    BIND("" AS ?option)
    BIND("" AS ?flag)
    BIND("" AS ?pyname)
    BIND("" AS ?pytype)
    BIND("" AS ?required)
    BIND("" AS ?help)
    BIND("" AS ?choices)
    BIND("" AS ?openEnum)
  }
  UNION
  {
    ?app a typer:TyperSubApp ;
         typer:appName ?appName ;
         typer:resourceType ?resourceType ;
         typer:apiVersion ?apiVersion .
    ?option typer:belongsTo ?app ;
            a typer:TyperOption ;
            typer:flagName ?flag ;
            typer:pythonName ?pyname ;
            typer:pythonType ?pytype ;
            typer:required ?required .
    OPTIONAL { ?option typer:help ?help }
    OPTIONAL { ?option typer:choice ?choices }
    OPTIONAL { ?option typer:openEnum ?openEnum }
  }
}
ORDER BY ?kind ?flag
