# MESSAGE: a TyperSubApp must carry appName/resourceType/apiVersion — the
# template interpolates all three into the generated module; a row missing
# any renders a broken/non-Typer module.
PREFIX typer: <https://ggen.io/ontology/typer-azure#>
SELECT ?app ?missing WHERE {
  ?app a typer:TyperSubApp .
  VALUES ?missing { typer:appName typer:resourceType typer:apiVersion }
  FILTER NOT EXISTS { ?app ?missing ?value }
}
