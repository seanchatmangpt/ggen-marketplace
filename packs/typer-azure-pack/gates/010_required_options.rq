# MESSAGE: every TyperOption must carry flag/python/required metadata, and
# every TyperSubApp must expose at least one option (a generated module with
# no options is a mint defect, not a valid CLI).
PREFIX typer: <https://ggen.io/ontology/typer-azure#>
SELECT ?option ?missing WHERE {
  VALUES ?cls { typer:TyperSubApp typer:TyperOption }
  ?s a ?cls .
  {
    ?s a typer:TyperOption .
    VALUES ?missing { typer:flagName typer:pythonName typer:pythonType typer:required }
    FILTER NOT EXISTS { ?s ?missing ?value }
  } UNION {
    ?s a typer:TyperSubApp .
    FILTER NOT EXISTS { ?o typer:belongsTo ?s }
  }
}
