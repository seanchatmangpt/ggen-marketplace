# chicago-pytest-dataclass pack ontology — Chicago-style pytest proofs over
# ggen-generated Python dataclass modules.
#
# Sibling to chicago-tdd-tools-pack, which covers the Rust CLI-boundary axis
# (spawn a real binary, assert exit code / stdout). This pack covers the axis
# that autofde-lab hand-writes ten times over (tests/test_constitution_*_chicago.py):
# import the REAL generated module, assert its real __all__, construct every
# real dataclass with real field values, assert on the real constructed state,
# and provoke a real dataclasses.FrozenInstanceError. No unittest.mock, no
# Mock/MagicMock/patch/monkeypatch anywhere in the generated output.
#
# AUTHORITY BOUNDARY (same as chicago-tdd-tools-pack): this pack carries NO
# runtime actuation authority. It generates tests that IMPORT and CONSTRUCT
# pure data objects. It generates nothing that actuates, and consequential DO
# stays behind GymAct/BRCE admission.

@prefix cpd:     <http://seanchatmangpt.github.io/packs/chicago-pytest-dataclass#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .

<http://seanchatmangpt.github.io/packs/chicago-pytest-dataclass>
  a owl:Ontology ;
  dcterms:title "Chicago-style pytest dataclass proofs" ;
  dcterms:description "Facts describing real, generated Python dataclass modules, from which a runnable Chicago-style pytest proof module is manufactured." ;
  dcterms:created "2026-09-06"^^xsd:date .

# ── Schema ──────────────────────────────────────────────────────────

cpd:DataclassProof
  a rdfs:Class , prov:Entity ;
  rdfs:label "Dataclass Proof" ;
  rdfs:comment "One Chicago-style proof over one real dataclass in one really-importable module: real import, real construction, real state assertions, real FrozenInstanceError." .

cpd:FieldSpec
  a rdfs:Class ;
  rdfs:label "Field Spec" ;
  rdfs:comment "One real field of the proved dataclass, with the real literal value the generated test will construct it with and assert back." .

cpd:module      a rdfs:Property ; rdfs:label "importable module path" ; rdfs:range xsd:string .
cpd:className   a rdfs:Property ; rdfs:label "dataclass name as exported"; rdfs:range xsd:string .
cpd:frozen      a rdfs:Property ; rdfs:label "dataclass is frozen"       ; rdfs:range xsd:boolean .
cpd:coversAxiom a rdfs:Property ; rdfs:label "axiom this proof covers"   ; rdfs:range xsd:string .
cpd:hasField    a rdfs:Property ; rdfs:label "field of the proved class" ; rdfs:range cpd:FieldSpec .
cpd:fieldName   a rdfs:Property ; rdfs:label "python field name"         ; rdfs:range xsd:string .
cpd:sampleExpr  a rdfs:Property ;
  rdfs:label "python literal expression" ;
  rdfs:comment "A real Python literal (not a factory, not a mock) that the generated test constructs the field with and asserts equal afterwards. Kept a literal so the assertion is state-based, per Chicago discipline." ;
  rdfs:range xsd:string .
cpd:declaresExports a rdfs:Property ;
  rdfs:label "module whose __all__ is proved exhaustively" ;
  rdfs:comment "Marks a cpd:module string as one whose full __all__ list is asserted, so a class silently dropped from the generated module fails the proof rather than passing silently." ;
  rdfs:range xsd:string .

# ── Individuals — grounded in the REAL generated module
#    /Users/sac/gym-ecosystem/vendor/autofde-lab/src/autofde_lab/constitution/evidence.py
#    (itself ggen-generated from ontology/evidence.ttl). Every className,
#    fieldName and default shape below was read off that real file, not invented.

cpd:evidence-Artifact
  a cpd:DataclassProof ;
  rdfs:label "Artifact marker dataclass proof" ;
  cpd:module "autofde_lab.constitution.evidence" ;
  cpd:className "Artifact" ;
  cpd:frozen true ;
  cpd:coversAxiom "afl:Artifact projects to a real frozen marker dataclass with zero fields" .

cpd:evidence-Level4Witness
  a cpd:DataclassProof ;
  rdfs:label "Level4Witness marker dataclass proof" ;
  cpd:module "autofde_lab.constitution.evidence" ;
  cpd:className "Level4Witness" ;
  cpd:frozen true ;
  cpd:coversAxiom "afl:Level4Witness projects to a real frozen marker dataclass with zero fields" .

cpd:evidence-ArtifactManifest
  a cpd:DataclassProof ;
  rdfs:label "ArtifactManifest dataclass proof" ;
  cpd:module "autofde_lab.constitution.evidence" ;
  cpd:className "ArtifactManifest" ;
  cpd:frozen true ;
  cpd:coversAxiom "afl:ArtifactManifest binds artifact/source/dependency identity refs as real tuple fields" ;
  cpd:hasField [ a cpd:FieldSpec ; cpd:fieldName "binds_entity"        ; cpd:sampleExpr "(\"urn:autofde-lab:entity:t1\",)" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "dependency_revision" ; cpd:sampleExpr "(\"urn:autofde-lab:dep:oxigraph-0.4\",)" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "manifests_artifact"  ; cpd:sampleExpr "(\"urn:autofde-lab:artifact:receipt.json\",)" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "source_revision"     ; cpd:sampleExpr "(\"urn:autofde-lab:src:e6b4224\",)" ] .

cpd:evidence-PostconditionObservation
  a cpd:DataclassProof ;
  rdfs:label "PostconditionObservation dataclass proof" ;
  cpd:module "autofde_lab.constitution.evidence" ;
  cpd:className "PostconditionObservation" ;
  cpd:frozen true ;
  cpd:coversAxiom "a postcondition observation carries asserted postconditions, an observed actuation and an observer" ;
  cpd:hasField [ a cpd:FieldSpec ; cpd:fieldName "asserts_postcondition" ; cpd:sampleExpr "(\"urn:autofde-lab:post:exit0\",)" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "observes_actuation"    ; cpd:sampleExpr "\"urn:autofde-lab:act:run-1\"" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "performed_by"          ; cpd:sampleExpr "\"urn:autofde-lab:observer:pytest\"" ] .

cpd:evidence-Receipt
  a cpd:DataclassProof ;
  rdfs:label "Receipt dataclass proof" ;
  cpd:module "autofde_lab.constitution.evidence" ;
  cpd:className "Receipt" ;
  cpd:frozen true ;
  cpd:coversAxiom "a receipt evidences an actuation and an observation and can be caused by a prior receipt" ;
  cpd:hasField [ a cpd:FieldSpec ; cpd:fieldName "caused_by_receipt"    ; cpd:sampleExpr "(\"urn:autofde-lab:receipt:0\",)" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "evidences_actuation"  ; cpd:sampleExpr "(\"urn:autofde-lab:act:run-1\",)" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "evidences_observation"; cpd:sampleExpr "(\"urn:autofde-lab:obs:1\",)" ] .

cpd:evidence-ReceiptDAG
  a cpd:DataclassProof ;
  rdfs:label "ReceiptDAG dataclass proof" ;
  cpd:module "autofde_lab.constitution.evidence" ;
  cpd:className "ReceiptDAG" ;
  cpd:frozen true ;
  cpd:coversAxiom "a receipt DAG is a real prov:Collection of receipt identity refs" ;
  cpd:hasField [ a cpd:FieldSpec ; cpd:fieldName "contains_receipt" ; cpd:sampleExpr "(\"urn:autofde-lab:receipt:0\", \"urn:autofde-lab:receipt:1\")" ] .

cpd:evidence-Replay
  a cpd:DataclassProof ;
  rdfs:label "Replay dataclass proof" ;
  cpd:module "autofde_lab.constitution.evidence" ;
  cpd:className "Replay" ;
  cpd:frozen true ;
  cpd:coversAxiom "a replay names the trial it replays and the receipts it replays" ;
  cpd:hasField [ a cpd:FieldSpec ; cpd:fieldName "replay_of_trial" ; cpd:sampleExpr "\"urn:autofde-lab:trial:7\"" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "replays_receipt" ; cpd:sampleExpr "(\"urn:autofde-lab:receipt:0\",)" ] .

cpd:evidence-VerifierRun
  a cpd:DataclassProof ;
  rdfs:label "VerifierRun dataclass proof" ;
  cpd:module "autofde_lab.constitution.evidence" ;
  cpd:className "VerifierRun" ;
  cpd:frozen true ;
  cpd:coversAxiom "a verifier run reads an artifact manifest by identity, never by filename" ;
  cpd:hasField [ a cpd:FieldSpec ; cpd:fieldName "reads_manifest" ; cpd:sampleExpr "(\"urn:autofde-lab:manifest:1\",)" ] .

cpd:evidence-EvidenceWitness
  a cpd:DataclassProof ;
  rdfs:label "EvidenceWitness dataclass proof" ;
  cpd:module "autofde_lab.constitution.evidence" ;
  cpd:className "EvidenceWitness" ;
  cpd:frozen true ;
  cpd:coversAxiom "one connected causal witness joins actuation, authority, manifest, observation, receipt DAG and replay by identity" ;
  cpd:hasField [ a cpd:FieldSpec ; cpd:fieldName "actuation"                 ; cpd:sampleExpr "\"urn:autofde-lab:act:run-1\"" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "authority"                 ; cpd:sampleExpr "\"urn:autofde-lab:auth:envelope-1\"" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "derived_by_verifier"       ; cpd:sampleExpr "\"urn:autofde-lab:verifier:1\"" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "manifest"                  ; cpd:sampleExpr "\"urn:autofde-lab:manifest:1\"" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "postcondition_observation" ; cpd:sampleExpr "\"urn:autofde-lab:obs:1\"" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "receipt_dag"               ; cpd:sampleExpr "\"urn:autofde-lab:dag:1\"" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "replay"                    ; cpd:sampleExpr "\"urn:autofde-lab:replay:1\"" ] ,
               [ a cpd:FieldSpec ; cpd:fieldName "witness_for"               ; cpd:sampleExpr "\"urn:autofde-lab:trial:7\"" ] .

# Exhaustive-export axiom: the module's whole public surface, so a class
# silently dropped by a future ontology edit fails loudly.
cpd:evidence-module-exports
  a cpd:DataclassProof ;
  rdfs:label "evidence module __all__ exhaustiveness" ;
  cpd:module "autofde_lab.constitution.evidence" ;
  cpd:declaresExports "Artifact,ArtifactManifest,DependencyRevision,EvidenceWitness,Level4Witness,Observer,Postcondition,PostconditionObservation,Receipt,ReceiptDAG,Replay,SourceRevision,VerifierRun" ;
  cpd:coversAxiom "the generated evidence module exports exactly thirteen constitution classes" .
