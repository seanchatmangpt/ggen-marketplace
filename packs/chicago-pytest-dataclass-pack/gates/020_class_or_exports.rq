# GATE: a proof must either prove one class (cpd:className + cpd:frozen)
# or prove a module's exhaustive exports (cpd:declaresExports) -- never neither.
PREFIX cpd: <http://seanchatmangpt.github.io/packs/chicago-pytest-dataclass#>
SELECT ?p WHERE {
  ?p a cpd:DataclassProof .
  FILTER NOT EXISTS { ?p cpd:className ?c }
  FILTER NOT EXISTS { ?p cpd:declaresExports ?e }
}
