# GATE (authority boundary, mirrors chicago-tdd-tools-pack): this pack proves
# pure data projections only. A proof whose sample expression looks like a
# call/actuation rather than a literal is a boundary violation -- consequential
# DO stays behind GymAct/BRCE admission, never inside a generated test.
PREFIX cpd: <http://seanchatmangpt.github.io/packs/chicago-pytest-dataclass#>
SELECT ?f ?s WHERE {
  ?f cpd:sampleExpr ?s .
  FILTER(REGEX(?s, "(subprocess|os\\.system|requests\\.|open\\(|Popen|eval\\(|__import__)"))
}
