# GATE: every cpd:FieldSpec must carry BOTH a real field name and a real
# literal sample expression -- a field with no asserted value would render a
# construction with no state assertion, which is not a Chicago-style proof.
PREFIX cpd: <http://seanchatmangpt.github.io/packs/chicago-pytest-dataclass#>
SELECT ?f WHERE {
  ?p cpd:hasField ?f .
  { FILTER NOT EXISTS { ?f cpd:fieldName ?n } }
  UNION
  { FILTER NOT EXISTS { ?f cpd:sampleExpr ?s } }
}
