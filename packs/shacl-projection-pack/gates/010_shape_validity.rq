# MESSAGE: every projected artifact linked via sp:derivedFromShape must resolve to a real,
# renderable SHACL graph. Primitive sh:datatype and nested sh:node fields are admitted;
# repetition is explicit through sp:collection. Any returned row is a refusal.
PREFIX sp:   <http://seanchatmangpt.github.io/packs/shacl-projection#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?projection ?violation WHERE {
  {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    FILTER NOT EXISTS { ?prop sh:path ?p }
    BIND("SHACL property shape missing required sh:path" AS ?violation)
  } UNION {
    # Every field has exactly one structural value kind: primitive datatype OR nested node.
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    FILTER NOT EXISTS { ?prop sh:datatype ?dt }
    FILTER NOT EXISTS { ?prop sh:node ?node }
    BIND("SHACL property shape requires sh:datatype or sh:node" AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    ?prop sh:datatype ?dt ; sh:node ?node .
    BIND("SHACL property shape cannot declare both sh:datatype and sh:node" AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    ?prop sh:datatype ?dt .
    FILTER (!(?dt = xsd:string || ?dt = xsd:boolean || ?dt = xsd:integer || ?dt = xsd:long || ?dt = xsd:decimal || ?dt = xsd:float || ?dt = xsd:double))
    BIND(CONCAT("sh:datatype not one of the admitted python-type-mappable XSD types: ", STR(?dt)) AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    ?prop sh:node ?node .
    FILTER NOT EXISTS { ?node a sh:NodeShape }
    BIND("sh:node target must be a real sh:NodeShape" AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    ?prop sh:node ?node .
    FILTER NOT EXISTS { ?node sp:projectionName ?name }
    BIND("nested sh:NodeShape requires explicit sp:projectionName" AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    ?prop sh:path ?p .
    BIND(REPLACE(STR(?p), "^.*[/#:]", "") AS ?localName)
    FILTER (!REGEX(?localName, "^[a-zA-Z_][a-zA-Z0-9_]*$"))
    BIND(CONCAT("sh:path local name is not a valid projected identifier: ", ?localName) AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?propA , ?propB .
    ?propA sh:path ?pathA . ?propB sh:path ?pathB .
    BIND(REPLACE(STR(?pathA), "^.*[/#:]", "") AS ?nameA)
    BIND(REPLACE(STR(?pathB), "^.*[/#:]", "") AS ?nameB)
    FILTER (?propA != ?propB && ?nameA = ?nameB && STR(?propA) < STR(?propB))
    BIND(CONCAT("duplicate field name within one shape: ", ?nameA) AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    ?prop sp:nullable ?nullable .
    FILTER (?nullable != true && ?nullable != false)
    BIND("sp:nullable must be an xsd:boolean" AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    ?prop sp:collection ?collection .
    FILTER (?collection != true && ?collection != false)
    BIND("sp:collection must be an xsd:boolean" AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    ?prop sh:in ?enumList ; sh:datatype ?dt .
    FILTER (?dt != xsd:string)
    BIND("sh:in projection currently requires sh:datatype xsd:string" AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    ?prop sh:in ?enumList .
    FILTER NOT EXISTS { ?enumList rdf:rest*/rdf:first ?enumValue }
    BIND("sh:in list must contain at least one value" AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    ?shape sh:property ?prop .
    ?prop sh:in ?enumList .
    ?enumList rdf:rest*/rdf:first ?enumValue .
    FILTER (REGEX(STR(?enumValue), "[\\\"\\\\\\n\\r]"))
    BIND("sh:in string contains unsupported quote, backslash, or newline" AS ?violation)
  } UNION {
    ?projection sp:derivedFromShape ?shape .
    FILTER NOT EXISTS {
      ?shape sh:property ?outProp .
      ?outProp sp:isPrimaryOutput true .
    }
    BIND("shape has zero properties marked sp:isPrimaryOutput true -- refused, none fabricated" AS ?violation)
  }
}
ORDER BY ?projection ?violation
