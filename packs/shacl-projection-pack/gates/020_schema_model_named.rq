# MESSAGE: every shp:SchemaModel projected to zod / JSON Schema must have exactly one non-empty shp:className and an shp:derivedFromShape link. Any row is a refusal.
PREFIX shp: <http://seanchatmangpt.github.io/packs/shacl-projection#>
SELECT ?projection ?violation WHERE {
  {
    ?projection a shp:SchemaModel .
    FILTER NOT EXISTS { ?projection shp:className ?n }
    BIND("shp:SchemaModel missing shp:className" AS ?violation)
  } UNION {
    ?projection a shp:SchemaModel .
    FILTER NOT EXISTS { ?projection shp:derivedFromShape ?s }
    BIND("shp:SchemaModel missing shp:derivedFromShape" AS ?violation)
  } UNION {
    ?projection a shp:SchemaModel ; shp:className ?n .
    FILTER (!REGEX(STR(?n), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("shp:className is not a valid identifier" AS ?violation)
  }
}
