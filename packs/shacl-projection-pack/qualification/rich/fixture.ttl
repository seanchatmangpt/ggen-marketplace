@prefix ex: <urn:shacl-rich:> .
@prefix sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:ChildShape a sh:NodeShape ;
    sp:projectionName "ChildGenerated" ;
    sh:property [
        sh:path ex:id ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path ex:score ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path ex:tags ;
        sh:datatype xsd:string ;
        sp:collection true ;
        sp:isPrimaryOutput true
    ] .

ex:ParentShape a sh:NodeShape ;
    sp:projectionName "ParentGenerated" ;
    sh:property [
        sh:path ex:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sp:isPrimaryOutput true
    ], [
        sh:path ex:labels ;
        sh:datatype xsd:string ;
        sp:collection true ;
        sp:isPrimaryOutput true
    ], [
        sh:path ex:items ;
        sh:node ex:ChildShape ;
        sp:collection true ;
        sp:isPrimaryOutput true
    ], [
        sh:path ex:primary ;
        sh:node ex:ChildShape ;
        sp:nullable true ;
        sp:isPrimaryOutput true
    ] .

ex:ChildPydantic a sp:PydanticModel ;
    sp:derivedFromShape ex:ChildShape ;
    sp:className "ChildGenerated" ;
    dcterms:description "Qualified nested child model" .

ex:ParentPydantic a sp:PydanticModel ;
    sp:derivedFromShape ex:ParentShape ;
    sp:className "ParentGenerated" ;
    dcterms:description "Qualified rich parent model" .

ex:ChildZod a sp:ZodSchema ;
    sp:derivedFromShape ex:ChildShape ;
    sp:schemaName "ChildGenerated" .

ex:ParentZod a sp:ZodSchema ;
    sp:derivedFromShape ex:ParentShape ;
    sp:schemaName "ParentGenerated" .
