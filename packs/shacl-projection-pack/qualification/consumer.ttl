@prefix shp:  <http://seanchatmangpt.github.io/packs/shacl-projection#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <http://example.org/qual#> .

ex:WidgetShape a sh:NodeShape ;
    sh:property [ sh:path ex:name ; sh:datatype xsd:string ; shp:isPrimaryOutput true ] ,
                [ sh:path ex:count ; sh:datatype xsd:integer ; shp:isPrimaryOutput true ] ,
                [ sh:path ex:active ; sh:datatype xsd:boolean ; shp:isPrimaryOutput true ] .

ex:Widget a shp:SchemaModel ; shp:className "Widget" ; shp:derivedFromShape ex:WidgetShape .
