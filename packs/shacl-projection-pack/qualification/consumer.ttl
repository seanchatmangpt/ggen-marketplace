@prefix sp:  <http://seanchatmangpt.github.io/packs/shacl-projection#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:  <http://example.org/qual#> .

ex:WidgetShape a sh:NodeShape ;
    sh:property [ sh:path ex:name ; sh:datatype xsd:string ; sp:isPrimaryOutput true ] ,
                [ sh:path ex:count ; sh:datatype xsd:integer ; sp:isPrimaryOutput true ] ,
                [ sh:path ex:active ; sh:datatype xsd:boolean ; sp:isPrimaryOutput true ] .

ex:Widget a sp:SchemaModel ; sp:className "Widget" ; sp:derivedFromShape ex:WidgetShape .
