---
to: "src/shacl_zod_schemas.ts"
sparql:
  models: "PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> PREFIX sh: <http://www.w3.org/ns/shacl#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?className WHERE { ?m a sp:SchemaModel ; sp:className ?className ; sp:derivedFromShape ?s } ORDER BY ?className"
  fields: "PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> PREFIX sh: <http://www.w3.org/ns/shacl#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?modelClassName ?fieldName ?zodType WHERE { ?m a sp:SchemaModel ; sp:derivedFromShape ?shape ; sp:className ?modelClassName . ?shape sh:property ?prop . ?prop sh:path ?path ; sh:datatype ?dt . BIND(REPLACE(STR(?path), \"^.*[/#]\", \"\") AS ?fieldName) BIND(IF(?dt = <http://www.w3.org/2001/XMLSchema#string>, \"z.string()\", IF(?dt = <http://www.w3.org/2001/XMLSchema#boolean>, \"z.boolean()\", IF(?dt IN (<http://www.w3.org/2001/XMLSchema#integer>, <http://www.w3.org/2001/XMLSchema#long>), \"z.number().int()\", \"z.number()\"))) AS ?zodType) } ORDER BY ?modelClassName ?fieldName"
---
// Generated by shacl-projection-pack (zod target) from real sh:NodeShape facts.
import { z } from "zod";
{% for m in models %}
export const {{ m.className }}Schema = z.object({
{% for f in fields %}{% if f.modelClassName == m.className %}  {{ f.fieldName }}: {{ f.zodType }},
{% endif %}{% endfor %}});
export type {{ m.className }} = z.infer<typeof {{ m.className }}Schema>;
{% endfor %}
