PREFIX sw: <https://ggen.dev/ontology/swarmsh-autonomic-coordination#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?identifier ?title ?version ?authority ?qualification
WHERE {
  sw:Release26_8_25 a sw:Release ;
    dcterms:identifier ?identifier ;
    dcterms:title ?title ;
    sw:version ?version ;
    sw:authority ?authority ;
    sw:qualification ?qualification .
}
