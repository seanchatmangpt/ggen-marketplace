PREFIX sw: <https://ggen.dev/ontology/swarmsh-autonomic-coordination#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?order ?slug ?rustVariant ?name ?category ?authority ?outcome ?falsifier ?proofSurface
WHERE {
  ?capability a sw:Capability ;
    sw:order ?order ;
    sw:slug ?slug ;
    sw:rustVariant ?rustVariant ;
    skos:prefLabel ?name ;
    sw:category ?category ;
    sw:authority ?authority ;
    sw:outcome ?outcome ;
    sw:falsifier ?falsifier ;
    sw:proofSurface ?proofSurface .
}
ORDER BY ?order
