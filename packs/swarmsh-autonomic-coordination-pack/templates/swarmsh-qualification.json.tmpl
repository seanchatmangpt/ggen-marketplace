{
  "schema": "https://ggen.dev/schemas/swarmsh-qualification-v26.8.25.json",
  "release": "26.8.25",
  "pack": "swarmsh-autonomic-coordination-pack",
  "generated_authority": "construct-only",
  "required_release_proofs": [
    "deterministic-regeneration",
    "exact-head-runtime",
    "receipt-integrity",
    "replay-integrity",
    "zero-ambient-do-authority"
  ],
  "capabilities": [
{% for row in results %}    {
      "order": {{ row["order"] }},
      "slug": "{{ row["slug"] }}",
      "category": "{{ row["category"] }}",
      "authority": "{{ row["authority"] }}",
      "proof_surface": "{{ row["proofSurface"] }}",
      "falsifier": "{{ row["falsifier"] }}"
    }{% if not loop.last %},{% endif %}
{% endfor %}  ]
}
