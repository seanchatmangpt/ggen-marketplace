---
to: scripts/test_invariants.sh
force: true
sparql:
  checks: |
    PREFIX ivg: <https://ggen.dev/ontology/invariant-gate#>
    SELECT ?target WHERE {
      ?c a ivg:InvariantCheck ; ivg:target ?target .
    } ORDER BY ?target
  fixtures: |
    PREFIX ivg: <https://ggen.dev/ontology/invariant-gate#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?slug ?label ?mutate WHERE {
      ?f a ivg:Fixture ; ivg:slug ?slug ; ivg:mutate ?mutate ; rdfs:label ?label .
    } ORDER BY ?slug
---
#!/bin/sh
# GENERATED by invariant-gate-pack from declared ivg:Fixture facts.
# Do not hand-edit; edit the owning ontology and re-run `ggen sync run`.
# Positive case: the real tree must pass (exit 0).
# Negative cases: each mutated fixture copy must be rejected (exit 1).
# This script exits 0 iff every expectation holds.
set -u
REPO=$(cd "$(dirname "$0")/.." && pwd)
CHECKER="$REPO/scripts/invariant_gate.py"
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
failures=0

fixture_tree() {
    # Copy every path the checker reads (derived from ivg:target facts).
    for rel in {% for c in checks %}"{{ c.target }}" {% endfor %}; do
        mkdir -p "$1/$(dirname "$rel")"
        cp "$REPO/$rel" "$1/$rel"
    done
}

expect() { # expect <desc> <want> <got>
    if [ "$2" = "$3" ]; then
        echo "PASS $1 (exit $3)"
    else
        echo "FAIL $1 (want exit $2, got $3)"
        failures=$((failures + 1))
    fi
}

# Positive: unmodified tree.
python3 "$CHECKER" --root "$REPO"; expect "real tree accepted" 0 $?
{% for f in fixtures %}
# Fixture {{ f.slug }}: {{ f.label }}
mkdir -p "$TMP/{{ f.slug }}"
fixture_tree "$TMP/{{ f.slug }}"
R="$TMP/{{ f.slug }}" S="$REPO" sh -c '{{ f.mutate }}'
python3 "$CHECKER" --root "$TMP/{{ f.slug }}" >/dev/null; expect "{{ f.label }}" 1 $?
{%- endfor %}
echo "test_invariants: $failures failure(s)"
[ "$failures" -eq 0 ]
