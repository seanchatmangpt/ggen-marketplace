---
to: scripts/invariant_gate.py
force: true
sparql:
  checks: |
    PREFIX ivg: <https://ggen.dev/ontology/invariant-gate#>
    SELECT ?id ?kind ?target ?expect ?tokens ?labels ?allowed ?forbidden ?requiredKeys ?hexHash WHERE {
      ?c a ivg:InvariantCheck ; ivg:id ?id ; ivg:kind ?kind ; ivg:target ?target .
      OPTIONAL { ?c ivg:expect ?expect }
      OPTIONAL { ?c ivg:tokens ?tokens }
      OPTIONAL { ?c ivg:labels ?labels }
      OPTIONAL { ?c ivg:allowed ?allowed }
      OPTIONAL { ?c ivg:forbidden ?forbidden }
      OPTIONAL { ?c ivg:requiredKeys ?requiredKeys }
      OPTIONAL { ?c ivg:hexHash ?hexHash }
    } ORDER BY ?id
---
#!/usr/bin/env python3
"""Executable invariant gate -- GENERATED by invariant-gate-pack from declared
ivg:InvariantCheck facts. Do not hand-edit; edit the owning ontology and
re-run `ggen sync run`.

Checks the declared core claims of the consumer profile. Zero-dependency:
stdlib only. Exit codes: 0 = all invariants hold, 1 = at least one violated.
Usage: invariant_gate.py [--root DIR]   (default: repo root)
"""

import argparse
import json
import re
import sys
from pathlib import Path

CHECKS = [
{%- for c in checks %}
    {"id": "{{ c.id }}", "kind": "{{ c.kind }}", "target": "{{ c.target }}",
     "expect": "{{ c.expect }}", "tokens": "{{ c.tokens }}",
     "labels": "{{ c.labels }}", "allowed": "{{ c.allowed }}",
     "forbidden": "{{ c.forbidden }}", "requiredKeys": "{{ c.requiredKeys }}",
     "hexHash": "{{ c.hexHash }}"},
{%- endfor %}
]


def split_list(value):
    return [item for item in value.split("|") if item]


def strip_comments_and_literals(text):
    """Remove quoted literals (kept as "" placeholder) and comments.

    '#' only starts a comment outside IRIs, so namespace fragments such as
    <http://...#> survive; '.' inside IRIs is likewise preserved.
    """
    no_strings = re.sub(r'"[^"]*"', '""', text)
    out_lines = []
    for line in no_strings.splitlines():
        cut, in_iri = None, False
        for i, ch in enumerate(line):
            if ch == "<":
                in_iri = True
            elif ch == ">":
                in_iri = False
            elif ch == "#" and not in_iri and (i == 0 or line[i - 1] in " \t"):
                cut = i
                break
        out_lines.append(line if cut is None else line[:cut])
    return "\n".join(out_lines)


def statements(graph_text):
    """Yield top-level Turtle statements (split on '.' at bracket depth 0)."""
    clean = strip_comments_and_literals(graph_text)
    stmt, depth, in_iri = [], 0, False
    for ch in clean:
        if ch == "<":
            in_iri = True
        elif ch == ">":
            in_iri = False
        elif ch == "[":
            depth += 1
        elif ch == "]":
            depth -= 1
        if ch == "." and depth == 0 and not in_iri:
            joined = "".join(stmt).strip()
            if joined:
                yield joined
            stmt = []
        else:
            stmt.append(ch)
    tail = "".join(stmt).strip()
    if tail:
        yield tail


def check_one(root, spec):
    path = root / spec["target"]
    if spec["kind"] in ("skos-topconcepts-count", "preflabel-set",
                        "prefix-allowlist", "turtle-blank-subjects"):
        text = path.read_text(encoding="utf-8")
        graph = strip_comments_and_literals(text)
    if spec["kind"] == "tokens-present":
        text = path.read_text(encoding="utf-8")
        missing = [t for t in split_list(spec["tokens"]) if t not in text]
        return not missing, "missing tokens: %s" % (missing,)
    if spec["kind"] == "skos-topconcepts-count":
        n = len(re.findall(r"\bskos:hasTopConcept\s*\[", graph))
        return n == int(spec["expect"]), "found %d top concepts, expected %s" % (
            n, spec["expect"])
    if spec["kind"] == "preflabel-set":
        labels = re.findall(r'skos:prefLabel\s+"([^"]+)"', text)
        want = sorted(split_list(spec["labels"]))
        return sorted(labels) == want, "prefLabels %s" % (sorted(labels),)
    if spec["kind"] == "prefix-allowlist":
        allowed = set(split_list(spec["allowed"]))
        prefix_iris = re.findall(r"@prefix\s+\w+:\s+<([^>]+)>", graph)
        bad = [iri for iri in prefix_iris if iri not in allowed]
        private = []
        for tok in split_list(spec["forbidden"]):
            hits = re.findall(r"\b" + re.escape(tok), graph)
            if hits:
                private.append((tok, len(hits)))
        return not bad and not private, "non-allowlisted IRIs: %s; forbidden uses: %s" % (
            bad, private)
    if spec["kind"] == "turtle-blank-subjects":
        subjects = [
            stmt.split()[0]
            for stmt in statements(text)
            if stmt.split() and not stmt.startswith(("@prefix", "@base"))
        ]
        bad_subjects = [s for s in subjects if s not in ("[]", "[")]
        return bool(subjects) and not bad_subjects, "statement subjects: %s" % (
            subjects or ["<none>"],)
    if spec["kind"] == "jsonl-records":
        keys = set(split_list(spec["requiredKeys"]))
        hex_hash = spec["hexHash"] == "true"
        lines = [ln for ln in path.read_text(encoding="utf-8").splitlines() if ln.strip()]
        violations = []
        for idx, line in enumerate(lines, 1):
            try:
                rec = json.loads(line)
                if not keys <= set(rec):
                    violations.append((idx, "missing keys"))
                elif hex_hash and not re.fullmatch(r"[0-9a-f]{64}", str(rec.get("hash", ""))):
                    violations.append((idx, "hash not 64-hex"))
            except json.JSONDecodeError as exc:
                violations.append((idx, "invalid JSON: %s" % exc))
        return bool(lines) and not violations, "%d records, violations: %s" % (
            len(lines), violations)
    return False, "unknown kind %s" % spec["kind"]


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--root", type=Path, default=Path(__file__).resolve().parent.parent,
        help="repo root to check (default: this repo)",
    )
    args = parser.parse_args()

    failed = 0
    for spec in CHECKS:
        ok, detail = check_one(args.root, spec)
        print("%s %-24s %s" % ("PASS" if ok else "FAIL", spec["id"], detail))
        if not ok:
            failed += 1
    print("invariant gate: %d/%d hold" % (len(CHECKS) - failed, len(CHECKS)))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
