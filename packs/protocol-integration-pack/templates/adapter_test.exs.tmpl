---
to: "{{ adapter_test_path }}"
for_each: "spec"
sparql:
  spec: |
    PREFIX pr: <https://ggen.dev/ontology/protocol-integration#>
    SELECT DISTINCT ?adapter_test_path ?adapter_test_module_name ?adapter_module_name ?adapter_entrypoint_module WHERE {
      ?s a pr:PriorArtAdapter ; pr:adapterTestPath ?adapter_test_path ;
         pr:adapterTestModuleName ?adapter_test_module_name ;
         pr:adapterModuleName ?adapter_module_name ;
         pr:adapterEntrypointModule ?adapter_entrypoint_module .
      FILTER NOT EXISTS { ?s pr:priorArtFixtureOnly true }
    }
---
{# Real-collaborator test, no mocks -- mirrors
   ash-extension-core-pack/templates/composition_test.exs.tmpl's "compile a
   real fixture, call real Info/behaviour functions" style. This asserts on
   the adapter's real Code.ensure_loaded?/1 result against the real
   entrypoint module, never a stubbed return. #}
defmodule {{ adapter_test_module_name }} do
  use ExUnit.Case, async: true

  test "{{ adapter_module_name }}.available?/0 reflects the real dependency" do
    assert {{ adapter_module_name }}.available?() == Code.ensure_loaded?({{ adapter_entrypoint_module }})
  end
end
