---
to: "{{ adapter_test_path }}"
for_each: "spec"
sparql:
  spec: |
    PREFIX pr: <https://ggen.dev/ontology/protocol-integration#>
    SELECT DISTINCT ?adapter_test_path ?adapter_test_module_name ?adapter_module_name ?adapter_binary_path WHERE {
      ?s a pr:PriorArtAdapter ; pr:integrationMode "cli-subprocess" ;
         pr:adapterTestPath ?adapter_test_path ;
         pr:adapterTestModuleName ?adapter_test_module_name ;
         pr:adapterModuleName ?adapter_module_name ;
         pr:adapterBinaryPath ?adapter_binary_path .
      FILTER NOT EXISTS { ?s pr:priorArtFixtureOnly true }
    }
---
{# Real-collaborator test, no mocking of System.cmd -- calls the generated
   adapter's real call/1 against the REAL binary path at {{ adapter_binary_path }}
   and asserts on the real returned exit code (0 or non-zero, whichever the
   real binary/fixture actually produces), never a stubbed Port or canned
   {output, exit_code} tuple. Mirrors adapter_test.exs.tmpl's
   "assert on the real Code.ensure_loaded?/1 result" style, adapted to
   subprocess exit-code truth instead of in-process module-loaded truth. #}
defmodule {{ adapter_test_module_name }} do
  use ExUnit.Case, async: true

  test "{{ adapter_module_name }}.available?/0 reflects the real binary at {{ adapter_binary_path }}" do
    assert {{ adapter_module_name }}.available?() == File.exists?("{{ adapter_binary_path }}")
  end

  test "{{ adapter_module_name }}.call/1 runs the real binary and returns a real exit code" do
    if {{ adapter_module_name }}.available?() do
      {_output, exit_code} = {{ adapter_module_name }}.call([])
      assert is_integer(exit_code)
    else
      :ok
    end
  end
end
