---
to: "lib/mix/tasks/{{ real_dependency_app }}_adapter.install.ex"
for_each: "spec"
sparql:
  spec: |
    PREFIX pr: <https://ggen.dev/ontology/protocol-integration#>
    SELECT DISTINCT ?real_dependency_app ?real_dependency_coordinate WHERE {
      ?s a pr:PriorArtAdapter ; pr:realDependencyApp ?real_dependency_app ;
         pr:realDependencyCoordinate ?real_dependency_coordinate .
      FILTER NOT EXISTS { ?s pr:priorArtFixtureOnly true }
    }
---
{# Igniter dependency installer for a real PriorArtAdapter binding -- mirrors
   ash-extension-core-pack/templates/install.ex.tmpl's exact dual-branch shape
   (whole file gated by Code.ensure_loaded?(Igniter), plain Mix.Task fallback
   that prints manual instructions when Igniter isn't a project dependency),
   but calls the real Igniter.Project.Deps.add_dep/2 (confirmed at
   /Users/sac/ash_a2a/deps/igniter/lib/igniter/project/deps.ex:26) instead of
   Igniter.Project.Formatter -- this template adds a mix.exs dependency, it
   does not touch the formatter. real_dependency_coordinate is spliced
   verbatim (not string-quoted) because it is already real Elixir tuple
   source, e.g. {:ash_a2a, path: "../ash_a2a"} -- echoed, never re-derived. #}
if Code.ensure_loaded?(Igniter) do
defmodule Mix.Tasks.{{ real_dependency_app | capitalize }}Adapter.Install do
  @moduledoc "Adds `{{ real_dependency_coordinate }}` to this project's mix.exs dependencies."
  use Igniter.Mix.Task

  @impl Igniter.Mix.Task
  def info(_argv, _composing_task) do
    %Igniter.Mix.Task.Info{
      group: :{{ real_dependency_app }},
      example: "mix {{ real_dependency_app }}_adapter.install",
      positional: [],
      schema: [],
      required: []
    }
  end

  @impl Igniter.Mix.Task
  def igniter(igniter) do
    Igniter.Project.Deps.add_dep(igniter, {{ real_dependency_coordinate }})
  end
end
else
  defmodule Mix.Tasks.{{ real_dependency_app | capitalize }}Adapter.Install do
    @moduledoc "Igniter is not installed, so `{{ real_dependency_app }}_adapter.install` cannot patch mix.exs automatically. Add `{{ real_dependency_coordinate }}` to your deps/0 by hand."
    use Mix.Task

    @impl Mix.Task
    def run(_argv) do
      Mix.shell().info("""
      Add `{{ real_dependency_coordinate }}` to the deps list in mix.exs by hand --
      Igniter is not a dependency of this project, so this task cannot patch
      files automatically.
      """)
    end
  end
end
