# FIRES gates/060_authority_gap_unmodeled_on_halt.rq (and nothing else):
# a workflow that was HALTED (authority suspended — the human-approval gap) and a
# resume of that workflow with NO dcap:authorityEnvelope -> qce:AuthorityEnvelope
# carrying qce:authorityDigest. The resume tries to cross the authority gap on
# inherited/ambient authority. Not version-crossed, so gate 050 stays clean.
@prefix dcap:    <https://ggen.dev/ontology/durability-capability#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

dcap:wf-gapped a dcap:WorkflowSubject ;
    dcap:workflowIdentity "urn:wf:demo:gapped" ;
    dcap:projectionVersion "v26.9.30" .

dcap:halt-gapped a dcap:HaltClaim ;
    dcap:haltsWorkflow dcap:wf-gapped ;
    dcap:authoritySuspended true ;
    dcap:haltedAt "2026-09-30T09:00:00Z"^^xsd:dateTime .

dcap:rc-gapped a dcap:ResumeClaim ;
    dcap:resumesWorkflow dcap:wf-gapped ;
    dcap:versionBoundaryCrossed false ;
    dcap:resumeOutcome "ALIVE" .
