# FIRES gates/070_realization_without_qualification_conditions.rq (and nothing else):
# a realization with complete provider metadata but ZERO qualification conditions —
# it would resolve unconditionally, with no stated boundary for admission.
@prefix dcap: <https://ggen.dev/ontology/durability-capability#> .

dcap:real-unconditional a dcap:Realization ;
    dcap:realizes dcap:capability-checkpoint ;
    dcap:providerRepo "demo" ;
    dcap:providerModule "Demo.UnconditionalCheckpoint" ;
    dcap:sourceCoordinates "lib/demo/unconditional_checkpoint.ex" ;
    dcap:versionPinPolicy "demo pin" ;
    dcap:inspected false .
