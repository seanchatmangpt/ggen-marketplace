PREFIX dspc: <https://seanchatmangpt.github.io/ontology/dfcm-selection-portfolio-consensus#>
SELECT ?candidate ?id ?utility ?rollback ?uncertainty WHERE {
  ?candidate a dspc:Candidate ;
    dspc:candidateId ?id ;
    dspc:utilityLower ?utility ;
    dspc:rollbackCost ?rollback ;
    dspc:uncertaintyWidth ?uncertainty .
}
ORDER BY DESC(?utility) ?rollback ?uncertainty ?id
