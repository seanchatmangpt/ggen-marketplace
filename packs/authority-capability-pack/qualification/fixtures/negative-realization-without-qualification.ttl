# NEGATIVE fixture for gates/040_realization_without_qualification.rq (fires
# it). A realization with provider metadata but no version-pin policy, no
# qualification conditions, and no ceiling: an unqualified promotion of an
# implementation to a capability.
@prefix authcap: <https://ggen.dev/ontology/authority-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/authcap/> .

ex:cap a authcap:Capability ;
    dcterms:identifier "Authority.Audit" ;
    authcap:capabilityFamily "authority" ;
    authcap:input "subject under audit" ;
    authcap:output "audit verdict" ;
    authcap:outcome ex:o ;
    authcap:authorityCeiling "observe" ;
    authcap:realization ex:r .

ex:o a authcap:Outcome ;
    authcap:outcomeKind "success" .

ex:r a authcap:Realization ;
    dcterms:identifier "audit-r" ;
    authcap:providerRepo "somewhere" ;
    authcap:bindingModule "Somewhere.Audit" ;
    authcap:sourceFile "lib/somewhere/audit.ex" .
