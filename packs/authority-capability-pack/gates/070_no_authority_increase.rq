# MESSAGE: no authority increase at the realization boundary. A realization
# may never claim a higher authority ceiling than the capability it realizes
# (observe < select < construct). ProviderAvailable != Authorized: shipping an
# implementation does not upgrade the authority its capability demands. Any
# row is a refusal.
PREFIX authcap: <https://ggen.dev/ontology/authority-capability#>
SELECT ?cap ?realization ?capCeiling ?realizationCeiling WHERE {
  VALUES (?capCeiling ?capRank) { ("observe" 0) ("select" 1) ("construct" 2) }
  VALUES (?realizationCeiling ?realizationRank) { ("observe" 0) ("select" 1) ("construct" 2) }
  ?cap authcap:authorityCeiling ?capCeiling ;
       authcap:realization ?realization .
  ?realization authcap:authorityCeiling ?realizationCeiling .
  FILTER (?realizationRank > ?capRank)
}
ORDER BY ?cap ?realization
