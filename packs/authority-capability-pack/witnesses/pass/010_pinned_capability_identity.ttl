# PASS witness for gates/010_pinned_capability_identity.rq: pinned-shape
# typing done right — the pinned identifier is on a typed capability, the
# consequential IDs carry the consequential type, no duplicates. This compact
# graph returns zero rows for gate 010 (semantic anti-vacuity runs over
# qualification/fixtures/ via qualification/verify.py).
@prefix authcap: <https://ggen.dev/ontology/authority-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/authcap/> .

ex:verify a authcap:Capability ;
    dcterms:identifier "Authority.Verify" .

ex:grant a authcap:Capability, authcap:ConsequentialCapability ;
    dcterms:identifier "Authority.Grant" .

ex:act a authcap:Capability, authcap:ConsequentialCapability ;
    dcterms:identifier "Actuation.Execute" .
