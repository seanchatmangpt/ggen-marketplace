# PASS witness for gates/060_grant_without_authority.rq: a consequential
# capability that names its authorizing capability AND carries a first-class
# REFUSED_NO_AUTHORITY refusal outcome.
@prefix authcap: <https://ggen.dev/ontology/authority-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/authcap/> .

ex:grant a authcap:Capability, authcap:ConsequentialCapability ;
    dcterms:identifier "Authority.Grant" ;
    authcap:capabilityFamily "authority" ;
    authcap:input "operator authority cut" ;
    authcap:output "minted lease" ;
    authcap:outcome ex:ok, ex:refused ;
    authcap:authorityCeiling "construct" ;
    qce:authorityEnvelope ex:env ;
    authcap:authorizingCapability ex:verify .

ex:verify a authcap:Capability ;
    dcterms:identifier "Authority.Verify" ;
    authcap:capabilityFamily "authority" ;
    authcap:input "envelope material" ;
    authcap:output "verdict" ;
    authcap:outcome ex:ok ;
    authcap:authorityCeiling "observe" .

ex:env a qce:AuthorityEnvelope ;
    qce:delegationDepth 0 .

ex:ok a authcap:Outcome ;
    authcap:outcomeKind "success" .
ex:refused a authcap:Outcome ;
    authcap:outcomeKind "refusal" ;
    authcap:refusalCode "REFUSED_NO_AUTHORITY" .
