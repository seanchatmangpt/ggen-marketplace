# NEGATIVE fixture for gates/010_pinned_capability_identity.rq (fires it).
# ex:impostor claims the pinned identifier "Actuation.Execute" without the
# authcap:Capability type; ex:twin duplicates the pinned identifier
# "Authority.Verify" across a second capability individual. Both are
# resolution-breaking identity violations.
@prefix authcap: <https://ggen.dev/ontology/authority-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.test/authcap/> .

ex:impostor dcterms:identifier "Actuation.Execute" .

ex:twin a authcap:Capability ;
    dcterms:identifier "Authority.Verify" .
