---
to: "lib/types.ts"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_trialbase_dashboard_shadcn_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}export interface Case {
  id: string
  title: string
  caseNumber: string
  status: "active" | "pending" | "closed" | "urgent"
  categories: string[]
  upcomingActions: number
  client: {
    name: string
    email: string
    phone: string
    avatar?: string
  }
  timeline: TimelineItem[]
  documents: Document[]
}

export interface TimelineItem {
  title: string
  date: string
  description: string
  category: string
  documents?: string[]
  actions?: {
    label: string
    primary?: boolean
  }[]
}

export interface Document {
  name: string
  type: string
  date: string
  size: string
}

{% endraw %}