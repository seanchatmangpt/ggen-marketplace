---
to: "components/app-sidebar.tsx"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_trialbase_dashboard_shadcn_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}"use client"
import { Search } from "lucide-react"
import { Input } from "@/components/ui/input"
import {
  Sidebar,
  SidebarContent,
  SidebarHeader,
  SidebarRail,
  SidebarGroup,
  SidebarGroupLabel,
  SidebarGroupContent,
} from "@/components/ui/sidebar"
import { CaseList } from "@/components/case-list"
import { SidebarNav } from "@/components/sidebar-nav"
import type { Case } from "@/lib/types"

interface AppSidebarProps {
  cases: Case[]
  onSelectCase: (caseData: Case) => void
  selectedCaseId: string | null
  searchQuery: string
  setSearchQuery: (query: string) => void
}

export function AppSidebar({ cases, onSelectCase, selectedCaseId, searchQuery, setSearchQuery }: AppSidebarProps) {
  return (
    <Sidebar className="h-[calc(100vh-3.5rem)]">
      <SidebarHeader className="p-4">
        <h2 className="text-lg font-semibold mb-3">{% endraw %}{{ row.capitalized }}{% raw %}</h2>
        <div className="relative">
          <Search className="absolute left-2 top-2.5 h-4 w-4 text-muted-foreground" />
          <Input
            placeholder="Search..."
            className="pl-8"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
          />
        </div>
      </SidebarHeader>
      <SidebarContent className="overflow-y-auto">
        <SidebarGroup>
          <SidebarGroupLabel>Navigation</SidebarGroupLabel>
          <SidebarGroupContent>
            <SidebarNav />
          </SidebarGroupContent>
        </SidebarGroup>

        <SidebarGroup>
          <SidebarGroupLabel>Your Cases</SidebarGroupLabel>
          <SidebarGroupContent>
            <CaseList cases={cases} onSelectCase={onSelectCase} selectedCaseId={selectedCaseId} compact={true} />
          </SidebarGroupContent>
        </SidebarGroup>
      </SidebarContent>
      <SidebarRail />
    </Sidebar>
  )
}

{% endraw %}