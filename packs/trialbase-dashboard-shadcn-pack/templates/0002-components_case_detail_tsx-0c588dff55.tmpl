---
to: "components/case-detail.tsx"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_trialbase_dashboard_shadcn_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}"use client"

import { useState } from "react"
import { ArrowLeft, MessageSquare, PlusCircle } from "lucide-react"
import { Button } from "@/components/ui/button"
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs"
import type { Case } from "@/lib/types"
import { CaseTimeline } from "@/components/case-timeline"
import { CaseDocuments } from "@/components/case-documents"
import { CaseChatbot } from "@/components/case-chatbot"
import { Badge } from "@/components/ui/badge"
import { getStatusColor } from "@/lib/utils"
import Link from "next/link"

interface CaseDetailProps {
  caseData: Case
  onBack: () => void
}

export function CaseDetail({ caseData, onBack }: CaseDetailProps) {
  const [activeTab, setActiveTab] = useState("timeline")

  return (
    <div className="h-full flex flex-col">
      <div className="bg-white dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800 p-4 sticky top-0 z-10">
        <div className="flex items-center">
          <Button variant="ghost" size="sm" onClick={onBack} className="md:hidden mr-2">
            <ArrowLeft className="h-4 w-4" />
          </Button>
          <div className="flex-1">
            <div className="flex items-center gap-2">
              <h2 className="text-xl font-semibold">{caseData.title}</h2>
              <Badge className={getStatusColor(caseData.status)}>{caseData.status}</Badge>
            </div>
            <p className="text-sm text-muted-foreground">{caseData.caseNumber}</p>
          </div>
          <Link href="/chat" className="mr-2">
            <Button size="sm" variant="outline" className="gap-1">
              <MessageSquare className="h-4 w-4" />
              <span className="hidden sm:inline">Chat</span>
            </Button>
          </Link>
          <Button size="sm" className="gap-1">
            <PlusCircle className="h-4 w-4" />
            <span className="hidden sm:inline">New Action</span>
          </Button>
        </div>

        <Tabs value={activeTab} onValueChange={setActiveTab} className="mt-4">
          <TabsList className="grid grid-cols-4 w-full">
            <TabsTrigger value="timeline">Timeline</TabsTrigger>
            <TabsTrigger value="documents">Documents</TabsTrigger>
            <TabsTrigger value="client">Client</TabsTrigger>
            <TabsTrigger value="ai" className="relative">
              AI Assistant
              <span className="absolute -top-1 -right-1 bg-primary text-primary-foreground text-xs rounded-full h-4 w-4 flex items-center justify-center">
                2
              </span>
            </TabsTrigger>
          </TabsList>
        </Tabs>
      </div>

      <div className="flex-1 overflow-y-auto">
        <TabsContent value="timeline" className="m-0 p-0 h-full">
          <CaseTimeline caseData={caseData} />
        </TabsContent>

        <TabsContent value="documents" className="m-0 p-0 h-full">
          <CaseDocuments caseData={caseData} />
        </TabsContent>

        <TabsContent value="client" className="m-0 p-0 h-full">
          <div className="p-4">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-medium">Client Communication</h3>
              <Link href="/chat">
                <Button size="sm" className="gap-1">
                  <MessageSquare className="h-4 w-4" />
                  <span>Open Chat</span>
                </Button>
              </Link>
            </div>
            <CaseChatbot caseData={caseData} />
          </div>
        </TabsContent>

        <TabsContent value="ai" className="m-0 p-0 h-full">
          <div className="p-4">
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-lg font-medium">AI Assistant</h3>
              <Link href="/chat">
                <Button size="sm" className="gap-1">
                  <MessageSquare className="h-4 w-4" />
                  <span>Open Chat</span>
                </Button>
              </Link>
            </div>
            <div className="border rounded-lg p-4 bg-muted/30">
              <div className="flex items-start gap-3 mb-4">
                <div className="bg-primary/20 p-2 rounded-full">
                  <div className="w-6 h-6 flex items-center justify-center text-primary">AI</div>
                </div>
                <div>
                  <p className="text-sm font-medium">Document Analysis Complete</p>
                  <p className="text-sm text-muted-foreground mt-1">
                    I've analyzed the latest filing in this case and found several key points that may be relevant to
                    your strategy.
                  </p>
                  <Button variant="link" size="sm" className="px-0 h-auto mt-1">
                    View analysis
                  </Button>
                </div>
              </div>

              <div className="flex items-start gap-3">
                <div className="bg-primary/20 p-2 rounded-full">
                  <div className="w-6 h-6 flex items-center justify-center text-primary">AI</div>
                </div>
                <div>
                  <p className="text-sm font-medium">Deadline Alert</p>
                  <p className="text-sm text-muted-foreground mt-1">
                    Based on the court's scheduling order, you have a response brief due in 7 days.
                  </p>
                  <Button variant="link" size="sm" className="px-0 h-auto mt-1">
                    Prepare draft
                  </Button>
                </div>
              </div>
            </div>
          </div>
        </TabsContent>
      </div>
    </div>
  )
}

{% endraw %}