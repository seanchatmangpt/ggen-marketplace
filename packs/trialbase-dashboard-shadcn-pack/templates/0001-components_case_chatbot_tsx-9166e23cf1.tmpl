---
to: "components/case-chatbot.tsx"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_trialbase_dashboard_shadcn_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}"use client"

import type React from "react"

import { useState } from "react"
import { Send } from "lucide-react"
import { Button } from "@/components/ui/button"
import { Input } from "@/components/ui/input"
import type { Case } from "@/lib/types"
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar"

interface CaseChatbotProps {
  caseData: Case
}

export function CaseChatbot({ caseData }: CaseChatbotProps) {
  const [message, setMessage] = useState("")

  // Mock messages for the prototype
  const messages = [
    {
      id: 1,
      sender: "system",
      content: "Client communication for case: " + caseData.title,
      timestamp: "Today, 9:30 AM",
    },
    {
      id: 2,
      sender: "bot",
      content: `Hello ${caseData.client.name}, I'm your automated assistant for the ${caseData.title} case. Your attorney has asked me to collect some information from you.`,
      timestamp: "Today, 9:31 AM",
    },
    {
      id: 3,
      sender: "client",
      content: "Hi, what information do you need?",
      timestamp: "Today, 9:35 AM",
    },
    {
      id: 4,
      sender: "bot",
      content:
        "We need to confirm the details of the incident that occurred on March 15th. Could you please provide any additional information that wasn't in your initial statement?",
      timestamp: "Today, 9:36 AM",
    },
    {
      id: 5,
      sender: "client",
      content:
        "Yes, I remembered that there was a witness I didn't mention before. Her name is Sarah Johnson and she saw the entire incident.",
      timestamp: "Today, 9:40 AM",
    },
    {
      id: 6,
      sender: "attorney",
      content:
        "Thank you for that information. I'll reach out to Sarah Johnson to get her statement. Do you have her contact information?",
      timestamp: "Today, 10:15 AM",
      name: "Jennifer Parker",
    },
  ]

  const handleSendMessage = () => {
    if (message.trim()) {
      // In a real implementation, this would send the message to the backend
      setMessage("")
    }
  }

  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault()
      handleSendMessage()
    }
  }

  return (
    <div className="border rounded-lg flex flex-col h-[500px]">
      <div className="flex-1 overflow-y-auto p-4 space-y-4">
        {messages.map((msg) => (
          <div key={msg.id} className="flex flex-col">
            <div className={`flex items-start gap-2 max-w-[80%] ${msg.sender === "client" ? "ml-auto" : ""}`}>
              {msg.sender !== "client" && (
                <Avatar className="h-8 w-8">
                  <AvatarImage src={msg.sender === "attorney" ? "/placeholder.svg?height=32&width=32" : undefined} />
                  <AvatarFallback>
                    {msg.sender === "bot" ? "AI" : msg.sender === "attorney" ? "JP" : "SYS"}
                  </AvatarFallback>
                </Avatar>
              )}

              <div
                className={`rounded-lg p-3 ${
                  msg.sender === "client"
                    ? "bg-primary text-primary-foreground"
                    : msg.sender === "attorney"
                      ? "bg-blue-100 dark:bg-blue-900"
                      : "bg-muted"
                }`}
              >
                {msg.sender === "attorney" && <div className="text-xs font-medium mb-1">{msg.name}</div>}
                <p className="text-sm">{msg.content}</p>
              </div>

              {msg.sender === "client" && (
                <Avatar className="h-8 w-8">
                  <AvatarImage src={caseData.client.avatar} />
                  <AvatarFallback>{caseData.client.name.charAt(0)}</AvatarFallback>
                </Avatar>
              )}
            </div>
            <div className={`text-xs text-muted-foreground mt-1 ${msg.sender === "client" ? "text-right" : "ml-10"}`}>
              {msg.timestamp}
            </div>
          </div>
        ))}
      </div>

      <div className="border-t p-3">
        <div className="flex gap-2">
          <Input
            placeholder="Type your message..."
            value={message}
            onChange={(e) => setMessage(e.target.value)}
            onKeyDown={handleKeyDown}
          />
          <Button size="icon" onClick={handleSendMessage} disabled={!message.trim()}>
            <Send className="h-4 w-4" />
          </Button>
        </div>
        <div className="text-xs text-muted-foreground mt-2">
          Messages are reviewed by your attorney before being sent to the client
        </div>
      </div>
    </div>
  )
}

{% endraw %}