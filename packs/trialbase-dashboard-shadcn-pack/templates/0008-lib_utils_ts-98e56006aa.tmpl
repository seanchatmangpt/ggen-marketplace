---
to: "trialbase-dashboard-shadcn-pack/lib/utils.ts"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_trialbase_dashboard_shadcn_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}import { type ClassValue, clsx } from "clsx"
import { twMerge } from "tailwind-merge"
import {
  RatioIcon as Balance,
  Calendar,
  FileText,
  MessageSquare,
  PenSquare,
  PuzzleIcon as PuzzlePiece,
  DollarSign,
} from "lucide-react"

export function cn(...inputs: ClassValue[]) {
  return twMerge(clsx(inputs))
}

export function getStatusColor(status: string) {
  switch (status.toLowerCase()) {
    case "active":
      return "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300"
    case "pending":
      return "bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300"
    case "urgent":
      return "bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300"
    case "closed":
      return "bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300"
    default:
      return "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300"
  }
}

export function getCategoryIcon(category: string) {
  switch (category.toLowerCase()) {
    case "depositions & testimony":
      return <PenSquare className="h-4 w-4 text-primary" />
    case "court proceedings":
      return <Balance className="h-4 w-4 text-primary" />
    case "document filings":
      return <FileText className="h-4 w-4 text-primary" />
    case "deadlines & due dates":
      return <Calendar className="h-4 w-4 text-primary" />
    case "client interactions":
      return <MessageSquare className="h-4 w-4 text-primary" />
    case "strategy & planning":
      return <PuzzlePiece className="h-4 w-4 text-primary" />
    case "financial matters":
      return <DollarSign className="h-4 w-4 text-primary" />
    default:
      return <FileText className="h-4 w-4 text-primary" />
  }
}

{% endraw %}