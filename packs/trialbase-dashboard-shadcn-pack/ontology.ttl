@prefix pack: <urn:ggen-marketplace:trialbase-dashboard-shadcn-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gc: <https://ggen.io/ontology/ggen-create#> .

pack:Project a pack:AdmittedProject ;
    rdfs:label "trialbase-dashboard" ;
    pack:originZip "~/Downloads/trialbase-dashboard (1).zip"^^xsd:string ;
    pack:extractedPath "/tmp/dl-extract/trialbase-dashboard"^^xsd:string ;
    pack:framework "Next.js 15.2.4 (React 19, TypeScript, Tailwind CSS)" ;
    pack:packageManager "pnpm (pnpm-lock.yaml present)" ;
    pack:productName "TrialBase" ;
    rdfs:comment "Legal-case-management dashboard admitted from a zip extracted to the given path; \"TrialBase\" appears as the app title in app/layout.tsx, the header brand text in components/header.tsx, and the domain suffix (@trialbase.com) of mock user emails in lib/mock-users.ts." .

pack:ShadcnUsage a pack:TechnologyFinding ;
    rdfs:label "shadcn/ui" ;
    pack:status "real" ;
    pack:componentsJsonPresent true ;
    pack:componentsJsonStyle "default" ;
    pack:componentsJsonBaseColor "neutral" ;
    pack:cnCallSiteCount 46 ;
    pack:cvaFileCount 9 ;
    pack:radixImportFileCount 32 ;
    pack:uiPrimitiveFileCount 49 ;
    rdfs:comment "shadcn/ui is genuinely used: components.json exists with style=default and baseColor=neutral, 49 shadcn/ui primitive files are present on disk under components/ui/, the cn() class-merge helper (lib/utils.ts) is called at 46 source-file sites, class-variance-authority (cva) is used in 9 files, and @radix-ui/* headless primitives are imported in 32 files." .

pack:DeckGlUsage a pack:TechnologyFinding ;
    rdfs:label "deck.gl" ;
    pack:status "absent" ;
    rdfs:comment "deck.gl is NOT used and NOT a dependency: package.json lists no deck.gl or @deck.gl/* package, and a source-wide grep for deck.gl/DeckGL/layer-class names found zero matches." .

pack:FileCaseDetail a pack:RealArtifact ;
    rdfs:label "case-detail.tsx" ;
    pack:filePath "components/case-detail.tsx" ;
    pack:lineCount 137 ;
    rdfs:comment "Case detail view component; renders a single legal case's information." .

pack:FileCaseList a pack:RealArtifact ;
    rdfs:label "case-list.tsx" ;
    pack:filePath "components/case-list.tsx" ;
    pack:lineCount 110 ;
    rdfs:comment "List/table view of legal cases." .

pack:FileCaseChatbot a pack:RealArtifact ;
    rdfs:label "case-chatbot.tsx" ;
    pack:filePath "components/case-chatbot.tsx" ;
    pack:lineCount 138 ;
    rdfs:comment "Per-case AI chatbot panel component." .

pack:FileDashboardView a pack:RealArtifact ;
    rdfs:label "dashboard-view.tsx" ;
    pack:filePath "components/dashboard-view.tsx" ;
    pack:lineCount 53 ;
    rdfs:comment "Top-level dashboard layout component composing tiles and lists." .

pack:FileAppSidebar a pack:RealArtifact ;
    rdfs:label "app-sidebar.tsx" ;
    pack:filePath "components/app-sidebar.tsx" ;
    pack:lineCount 59 ;
    rdfs:comment "Application navigation sidebar; contains the \"TrialBase\" brand text." .

pack:FileMockData a pack:RealArtifact ;
    rdfs:label "mock-data.ts" ;
    pack:filePath "lib/mock-data.ts" ;
    pack:lineCount 247 ;
    rdfs:comment "Mock legal-case dataset backing the dashboard UI in absence of a real API." .

pack:FileTypes a pack:RealArtifact ;
    rdfs:label "types.ts" ;
    pack:filePath "lib/types.ts" ;
    pack:lineCount 36 ;
    rdfs:comment "Shared TypeScript domain types (Case, etc.) for the dashboard." .

pack:FileUtils a pack:RealArtifact ;
    rdfs:label "utils.ts" ;
    pack:filePath "lib/utils.ts" ;
    rdfs:comment "Defines the cn() class-merge helper (clsx + tailwind-merge) plus getStatusColor/getCategoryIcon domain helpers used across the dashboard." .

gc:gc_subject_trialbase_dashboard_shadcn_pack a gc:GenerationSubject ;
    gc:name "TrialBase" ;
    gc:upper "TRIALBASE" ;
    gc:lower "trialbase" ;
    gc:capitalized "TrialBase" ;
    gc:pascal "TrialBase" ;
    gc:camel "trialBase" ;
    gc:snake "trial_base" ;
    gc:upper_snake "TRIAL_BASE" ;
    gc:kebab "trial-base" ;
    gc:title "Trial Base" .
