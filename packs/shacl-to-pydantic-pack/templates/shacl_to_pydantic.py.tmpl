---
to: "src/shacl_pydantic_models.py"
sparql:
  models: "PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?className ?description WHERE { ?model a sp:PydanticModel ; sp:derivedFromShape ?shape ; sp:className ?className . OPTIONAL { ?model dcterms:description ?description } } ORDER BY ?className"
  fields: "PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> PREFIX sh: <http://www.w3.org/ns/shacl#> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?modelClassName ?fieldName ?pythonType ?description ?nullable ?collection (GROUP_CONCAT(CONCAT('\\\"', STR(?enumValue), '\\\"'); separator=', ') AS ?enumValues) WHERE { ?model a sp:PydanticModel ; sp:derivedFromShape ?shape ; sp:className ?modelClassName . ?shape sh:property ?prop . ?prop sh:path ?path ; sh:datatype ?dt . BIND(REPLACE(STR(?path), \"^.*[/#:]\", \"\") AS ?fieldName) BIND(IF(?dt = <http://www.w3.org/2001/XMLSchema#string>, \"str\", IF(?dt = <http://www.w3.org/2001/XMLSchema#boolean>, \"bool\", IF(?dt IN (<http://www.w3.org/2001/XMLSchema#integer>, <http://www.w3.org/2001/XMLSchema#long>), \"int\", \"float\"))) AS ?pythonType) OPTIONAL { ?prop sh:description ?descRaw } OPTIONAL { ?prop dcterms:description ?descRaw2 } OPTIONAL { ?prop sp:nullable ?nullableRaw } OPTIONAL { ?prop sp:collection ?collectionRaw } OPTIONAL { ?prop sh:in ?enumList . ?enumList rdf:rest*/rdf:first ?enumValue } BIND(COALESCE(?descRaw, ?descRaw2, CONCAT(?fieldName, \" field\")) AS ?description) BIND(COALESCE(STR(?nullableRaw), \"false\") AS ?nullable) BIND(COALESCE(STR(?collectionRaw), \"false\") AS ?collection) } GROUP BY ?modelClassName ?fieldName ?pythonType ?description ?nullable ?collection ORDER BY ?modelClassName ?fieldName"
  nested_fields: "PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> PREFIX sh: <http://www.w3.org/ns/shacl#> PREFIX dcterms: <http://purl.org/dc/terms/> SELECT ?modelClassName ?fieldName ?nestedType ?description ?nullable ?collection WHERE { ?model a sp:PydanticModel ; sp:derivedFromShape ?shape ; sp:className ?modelClassName . ?shape sh:property ?prop . ?prop sh:path ?path ; sh:node ?nestedShape . ?nestedShape sp:projectionName ?nestedType . BIND(REPLACE(STR(?path), \"^.*[/#:]\", \"\") AS ?fieldName) OPTIONAL { ?prop sh:description ?descRaw } OPTIONAL { ?prop dcterms:description ?descRaw2 } OPTIONAL { ?prop sp:nullable ?nullableRaw } OPTIONAL { ?prop sp:collection ?collectionRaw } BIND(COALESCE(?descRaw, ?descRaw2, CONCAT(?fieldName, \" field\")) AS ?description) BIND(COALESCE(STR(?nullableRaw), \"false\") AS ?nullable) BIND(COALESCE(STR(?collectionRaw), \"false\") AS ?collection) } ORDER BY ?modelClassName ?fieldName"
---
"""Pydantic models derived from admitted SHACL shapes.

Primitive and nested/repeated fields are projected from the source graph. Names are echoed
from explicit graph facts; the template does not synthesize target identifiers.
"""

from __future__ import annotations

import typing

import pydantic

{% for m in models %}
class {{ m.className }}(pydantic.BaseModel):
    """{{ m.description | default(value=m.className) }}"""

{% for f in fields %}{% if f.modelClassName == m.className %}    {{ f.fieldName }}: {% if f.collection == "true" %}list[{% endif %}{% if f.enumValues %}typing.Literal[{{ f.enumValues }}]{% else %}{{ f.pythonType }}{% endif %}{% if f.collection == "true" %}]{% endif %}{% if f.nullable == "true" %} | None{% endif %} = pydantic.Field(description="{{ f.description }}")
{% endif %}{% endfor %}{% for f in nested_fields %}{% if f.modelClassName == m.className %}    {{ f.fieldName }}: {% if f.collection == "true" %}list[{% endif %}{{ f.nestedType }}{% if f.collection == "true" %}]{% endif %}{% if f.nullable == "true" %} | None{% endif %} = pydantic.Field(description="{{ f.description }}")
{% endif %}{% endfor %}
{% endfor %}
{% for m in models %}{{ m.className }}.model_rebuild()
{% endfor %}