# === BEGIN GA1 Arrow C Data Interface vocabulary (WO ga1, p08-cdata) ===
# Byte-layout ontology (catalog §9): wire registers, fields, offset/size,
# format-string and flag constants. Ground truth: cgap_c_data.h + p08-cdata.

arcus:WireRegister a rdfs:Class ;
    rdfs:label "Wire register" ;
    rdfs:comment "A C-ABI struct twin: byte-array twin with typed accessors and build-breaking layout assertions." .

arcus:WireField a rdfs:Class ;
    rdfs:label "Wire field" ;
    rdfs:comment "One field of a WireRegister: wireName (const stem), offset, sizeBytes, wireKind (int|ptr|release), fieldOf." .

arcus:FormatConst a rdfs:Class ;
    rdfs:label "Format constant" ;
    rdfs:comment "Arrow format-string constant: goConst + value." .

arcus:FlagConst a rdfs:Class ;
    rdfs:label "Flag constant" ;
    rdfs:comment "ArrowSchema.flags bitmask constant: goConst + value." .

arcus:wire-arrow-schema a arcus:WireRegister ; arcus:goName "ArrowSchemaTwin" ;
    arcus:sizeConst "ArrowSchemaSize" ; arcus:sizeBytes 72 ;
    rdfs:label "struct ArrowSchema twin (72 bytes)" ;
    prov:wasDerivedFrom arcus:src-cgap-c-data-h .

arcus:wire-arrow-array a arcus:WireRegister ; arcus:goName "ArrowArrayTwin" ;
    arcus:sizeConst "ArrowArraySize" ; arcus:sizeBytes 80 ;
    rdfs:label "struct ArrowArray twin [80]byte" ;
    prov:wasDerivedFrom arcus:src-cgap-c-data-h .

arcus:src-cgap-c-data-h a prov:Entity ;
    dcterms:title "cgap C data interface header" ;
    dcterms:source <file:///Users/sac/cgap/include/cgap_c_data.h> .

arcus:wf-schema-format a arcus:WireField ; arcus:wireName "SchemaFormat" ;
    arcus:offset 0 ; arcus:sizeBytes 8 ; arcus:wireKind "ptr" ;
    arcus:fieldOf arcus:wire-arrow-schema .

arcus:wf-schema-name a arcus:WireField ; arcus:wireName "SchemaName" ;
    arcus:offset 8 ; arcus:sizeBytes 8 ; arcus:wireKind "ptr" ;
    arcus:fieldOf arcus:wire-arrow-schema .

arcus:wf-schema-metadata a arcus:WireField ; arcus:wireName "SchemaMetadata" ;
    arcus:offset 16 ; arcus:sizeBytes 8 ; arcus:wireKind "ptr" ;
    arcus:fieldOf arcus:wire-arrow-schema .

arcus:wf-schema-flags a arcus:WireField ; arcus:wireName "SchemaFlags" ;
    arcus:offset 24 ; arcus:sizeBytes 8 ; arcus:wireKind "int" ;
    arcus:fieldOf arcus:wire-arrow-schema .

arcus:wf-schema-n-children a arcus:WireField ; arcus:wireName "SchemaNChildren" ;
    arcus:offset 32 ; arcus:sizeBytes 8 ; arcus:wireKind "int" ;
    arcus:fieldOf arcus:wire-arrow-schema .

arcus:wf-schema-children a arcus:WireField ; arcus:wireName "SchemaChildren" ;
    arcus:offset 40 ; arcus:sizeBytes 8 ; arcus:wireKind "ptr" ;
    arcus:fieldOf arcus:wire-arrow-schema .

arcus:wf-schema-dictionary a arcus:WireField ; arcus:wireName "SchemaDictionary" ;
    arcus:offset 48 ; arcus:sizeBytes 8 ; arcus:wireKind "ptr" ;
    arcus:fieldOf arcus:wire-arrow-schema .

arcus:wf-schema-release a arcus:WireField ; arcus:wireName "SchemaRelease" ;
    arcus:offset 56 ; arcus:sizeBytes 8 ; arcus:wireKind "release" ;
    arcus:fieldOf arcus:wire-arrow-schema .

arcus:wf-schema-private-data a arcus:WireField ; arcus:wireName "SchemaPrivateData" ;
    arcus:offset 64 ; arcus:sizeBytes 8 ; arcus:wireKind "ptr" ;
    arcus:fieldOf arcus:wire-arrow-schema .

arcus:wf-array-length a arcus:WireField ; arcus:wireName "ArrayLength" ;
    arcus:offset 0 ; arcus:sizeBytes 8 ; arcus:wireKind "int" ;
    arcus:fieldOf arcus:wire-arrow-array .

arcus:wf-array-null-count a arcus:WireField ; arcus:wireName "ArrayNullCount" ;
    arcus:offset 8 ; arcus:sizeBytes 8 ; arcus:wireKind "int" ;
    arcus:fieldOf arcus:wire-arrow-array .

arcus:wf-array-offset a arcus:WireField ; arcus:wireName "ArrayOffset" ;
    arcus:offset 16 ; arcus:sizeBytes 8 ; arcus:wireKind "int" ;
    arcus:fieldOf arcus:wire-arrow-array .

arcus:wf-array-n-buffers a arcus:WireField ; arcus:wireName "ArrayNBuffers" ;
    arcus:offset 24 ; arcus:sizeBytes 8 ; arcus:wireKind "int" ;
    arcus:fieldOf arcus:wire-arrow-array .

arcus:wf-array-n-children a arcus:WireField ; arcus:wireName "ArrayNChildren" ;
    arcus:offset 32 ; arcus:sizeBytes 8 ; arcus:wireKind "int" ;
    arcus:fieldOf arcus:wire-arrow-array .

arcus:wf-array-buffers a arcus:WireField ; arcus:wireName "ArrayBuffers" ;
    arcus:offset 40 ; arcus:sizeBytes 8 ; arcus:wireKind "ptr" ;
    arcus:fieldOf arcus:wire-arrow-array .

arcus:wf-array-children a arcus:WireField ; arcus:wireName "ArrayChildren" ;
    arcus:offset 48 ; arcus:sizeBytes 8 ; arcus:wireKind "ptr" ;
    arcus:fieldOf arcus:wire-arrow-array .

arcus:wf-array-dictionary a arcus:WireField ; arcus:wireName "ArrayDictionary" ;
    arcus:offset 56 ; arcus:sizeBytes 8 ; arcus:wireKind "ptr" ;
    arcus:fieldOf arcus:wire-arrow-array .

arcus:wf-array-release a arcus:WireField ; arcus:wireName "ArrayRelease" ;
    arcus:offset 64 ; arcus:sizeBytes 8 ; arcus:wireKind "release" ;
    arcus:fieldOf arcus:wire-arrow-array .

arcus:wf-array-private-data a arcus:WireField ; arcus:wireName "ArrayPrivateData" ;
    arcus:offset 72 ; arcus:sizeBytes 8 ; arcus:wireKind "ptr" ;
    arcus:fieldOf arcus:wire-arrow-array .

arcus:fmt-struct a arcus:FormatConst ; arcus:goConst "FormatStruct" ;
    arcus:value "+s" ; rdfs:label "struct format" .

arcus:fmt-utf8 a arcus:FormatConst ; arcus:goConst "FormatUTF8" ;
    arcus:value "u" ; rdfs:label "utf8 format" .

arcus:fmt-large-utf8 a arcus:FormatConst ; arcus:goConst "FormatLargeUTF8" ;
    arcus:value "U" ; rdfs:label "large utf8 format" .

arcus:fmt-int64 a arcus:FormatConst ; arcus:goConst "FormatInt64" ;
    arcus:value "l" ; rdfs:label "int64 format" .

arcus:fmt-fixed-binary-32 a arcus:FormatConst ; arcus:goConst "FormatFixedBinary32" ;
    arcus:value "w:32" ; rdfs:label "fixed-size binary 32 format" .

arcus:flag-dictionary-ordered a arcus:FlagConst ; arcus:goConst "FlagDictionaryOrdered" ;
    arcus:value 1 ; rdfs:label "ARROW_FLAG_DICTIONARY_ORDERED" .

arcus:flag-nullable a arcus:FlagConst ; arcus:goConst "FlagNullable" ;
    arcus:value 2 ; rdfs:label "ARROW_FLAG_NULLABLE" .

arcus:flag-map-keys-sorted a arcus:FlagConst ; arcus:goConst "FlagMapKeysSorted" ;
    arcus:value 4 ; rdfs:label "ARROW_FLAG_MAP_KEYS_SORTED" .

# ---------------- columnar SPOG arrays (p08/p02 ground truth) ----------------
# Five Arrow-C-Data-layout columnar primitives backing the SPOG quad store.
# Layout facts are ontology individuals: templates project buffer-count consts,
# offset tables and zero-copy readers from them; gates refuse incomplete facts.

arcus:SpogArray a rdfs:Class ;
    rdfs:label "Columnar SPOG array" ;
    rdfs:comment "One Arrow-layout columnar array primitive with complete buffer-layout facts (bufferCount, byteWidth, alignment, offsetType, purpose)." .

arcus:SpogUnionChild a rdfs:Class ;
    rdfs:label "DenseUnion child" ;
    rdfs:comment "One typed child of the DenseUnion Object array: int8 type_id slot, Go name, Go value type." .

arcus:id a owl:DatatypeProperty ; rdfs:label "array identifier (snake_case)" .
arcus:bufferCount a owl:DatatypeProperty ; rdfs:label "number of Arrow buffers" .
arcus:byteWidth a owl:DatatypeProperty ; rdfs:label "per-element byte width in the value buffer" .
arcus:alignment a owl:DatatypeProperty ; rdfs:label "required byte alignment of the value buffer" .
arcus:offsetType a owl:DatatypeProperty ; rdfs:label "offset encoding: fixed | int64 | int32+int8 | int64-slab" .
arcus:purpose a owl:DatatypeProperty ; rdfs:label "SPOG role of the array" .
arcus:handLawSeam a owl:DatatypeProperty ; rdfs:label "OUT-OF-GENGEN seam left as hand-law" .
arcus:typeId a owl:DatatypeProperty ; rdfs:label "DenseUnion int8 type_id slot" .
arcus:childGoType a owl:DatatypeProperty ; rdfs:label "Go value type of the union child" .
arcus:childOf a owl:ObjectProperty ; rdfs:label "parent DenseUnion array" .

arcus:src-spog-columnar-plan a prov:Entity ;
    dcterms:title "arcus v26.11.3 columnar SPOG plan (p08 cdata / p02 arena ground truth)" ;
    dcterms:source <https://internal/arcus/jira/v26.11.3> .

arcus:spog-fixed-size-binary-32 a arcus:SpogArray ;
    arcus:id "fixed_size_binary_32" ; arcus:goName "FixedSizeBinary32" ;
    arcus:bufferCount 2 ; arcus:byteWidth 32 ; arcus:alignment 32 ;
    arcus:offsetType "fixed" ;
    arcus:purpose "S subject column: BLAKE3 IRI receipts — 1 validity bitmap + 1 contiguous 32B data buffer" ;
    arcus:handLawSeam "SIMD load path" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

arcus:spog-dictionary-uint32-utf8 a arcus:SpogArray ;
    arcus:id "dictionary_uint32_utf8" ; arcus:goName "DictionaryUInt32Utf8" ;
    arcus:bufferCount 3 ; arcus:byteWidth 4 ; arcus:alignment 8 ;
    arcus:offsetType "int64-slab" ;
    arcus:purpose "P and G columns: uint32 keys into a bosym-style symbol slab (validity + uint32 keys + slab offsets/data)" ;
    arcus:handLawSeam "SIMD load path" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

arcus:spog-large-string a arcus:SpogArray ;
    arcus:id "large_string" ; arcus:goName "LargeString" ;
    arcus:bufferCount 3 ; arcus:byteWidth 8 ; arcus:alignment 8 ;
    arcus:offsetType "int64" ;
    arcus:purpose "O literal payloads: int64 offsets, >2GiB streams" ;
    arcus:handLawSeam "SIMD load path" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

arcus:spog-dense-union a arcus:SpogArray ;
    arcus:id "dense_union" ; arcus:goName "DenseUnion" ;
    arcus:bufferCount 2 ; arcus:byteWidth 1 ; arcus:alignment 8 ;
    arcus:offsetType "int32+int8" ;
    arcus:purpose "O polymorphic RDF Object: int8 type_id + int32 value_offset selecting one typed child" ;
    arcus:handLawSeam "SIMD load path" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

arcus:spog-fixed-size-list-4 a arcus:SpogArray ;
    arcus:id "fixed_size_list_4" ; arcus:goName "FixedSizeList4" ;
    arcus:bufferCount 2 ; arcus:byteWidth 16 ; arcus:alignment 8 ;
    arcus:offsetType "fixed" ;
    arcus:purpose "Quad spine: S/P/O/G as 4x uint32 = 16B blocks; 4 quads per 64B cache line" ;
    arcus:handLawSeam "SIMD load path" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

arcus:uchild-iri a arcus:SpogUnionChild ;
    arcus:typeId 0 ; arcus:goName "ObjIRI" ; arcus:childGoType "uint32" ;
    arcus:childOf arcus:spog-dense-union ;
    rdfs:comment "IRI as uint32 symbol-slab index into the DictionaryUInt32Utf8 symbol space" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

arcus:uchild-blank-node a arcus:SpogUnionChild ;
    arcus:typeId 1 ; arcus:goName "ObjBlankNode" ; arcus:childGoType "uint32" ;
    arcus:childOf arcus:spog-dense-union ;
    rdfs:comment "BlankNode as uint32 symbol-slab index" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

arcus:uchild-int64 a arcus:SpogUnionChild ;
    arcus:typeId 2 ; arcus:goName "ObjInt64" ; arcus:childGoType "int64" ;
    arcus:childOf arcus:spog-dense-union ;
    rdfs:comment "xsd:integer-class literal payload as raw int64" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

arcus:uchild-double a arcus:SpogUnionChild ;
    arcus:typeId 3 ; arcus:goName "ObjDouble" ; arcus:childGoType "float64" ;
    arcus:childOf arcus:spog-dense-union ;
    rdfs:comment "xsd:double payload as raw float64" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

arcus:uchild-boolean a arcus:SpogUnionChild ;
    arcus:typeId 4 ; arcus:goName "ObjBoolean" ; arcus:childGoType "bool" ;
    arcus:childOf arcus:spog-dense-union ;
    rdfs:comment "xsd:boolean payload as bool" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

arcus:uchild-literal a arcus:SpogUnionChild ;
    arcus:typeId 5 ; arcus:goName "ObjLiteral" ; arcus:childGoType "uint32" ;
    arcus:childOf arcus:spog-dense-union ;
    rdfs:comment "lexical-form literal as uint32 LargeString row index" ;
    prov:wasDerivedFrom arcus:src-spog-columnar-plan .

# ---------------------------------------------------------------------------
# Bitmap + IPC streaming primitives (GA3, v26.11.3).
# Ground truth: cgap-arrow ipc.rs MetaHeader (64B, "IPC1") is the REAL layout
# encoded below; the 128-byte BLAKE3-hashed header is a PROPOSED evolution
# individual, never conflated with the implemented 64B one.
# ---------------------------------------------------------------------------

arcus:KernelPrimitive a rdfs:Class ;
    rdfs:label "Kernel primitive" ;
    rdfs:comment "One bitmap/IPC streaming law projected into Go: primName (Go identifier root), primKind (dispatch section), law (the exact bitmap/byte law), seam (generated | arcus:hand-law | proposed), status (implemented | proposed)." .

arcus:src-cgap-arrow-ipc a prov:Entity ;
    dcterms:title "cgap-arrow ipc.rs MetaHeader (64B IPC1 ground truth)" ;
    dcterms:source <file:///Users/sac/cgap/crates/cgap-arrow/src/ipc.rs> .

arcus:src-oabi-breakdown a prov:Entity ;
    dcterms:title "O-ABI 128-byte BLAKE3-hashed header proposal (replaces FlatBuffers)" ;
    dcterms:source <https://internal/arcus/oabi-proposal> .

arcus:prim-validity-bitmap a arcus:KernelPrimitive ; arcus:primName "ValidityBitmap" ;
    arcus:primKind "bitmap" ;
    arcus:law "LSB-first, 1 bit per row: byte = i>>3, bit = i&7" ;
    arcus:seam "generated" ; arcus:status "implemented" ;
    prov:wasDerivedFrom arcus:src-cgap-arrow-ipc .

arcus:prim-boolean-array-packed a arcus:KernelPrimitive ; arcus:primName "BooleanArrayPacked" ;
    arcus:primKind "bitmap" ;
    arcus:law "8 boolean flags packed per byte, LSB-first" ;
    arcus:seam "generated" ; arcus:status "implemented" ;
    prov:wasDerivedFrom arcus:src-cgap-arrow-ipc .

arcus:prim-popcount-law a arcus:KernelPrimitive ; arcus:primName "PopcountLaw" ;
    arcus:primKind "popcount" ;
    arcus:law "math/bits.OnesCount8 per byte, word-at-a-time OnesCount64: O(1) per word null counts" ;
    arcus:seam "generated" ; arcus:status "implemented" ;
    prov:wasDerivedFrom arcus:src-cgap-arrow-ipc .

arcus:prim-mask-filter a arcus:KernelPrimitive ; arcus:primName "MaskFilter" ;
    arcus:primKind "filter" ;
    arcus:law "compaction kernel: select src lanes where mask bit is set; branchless compress (vpcompress analog) is hand law" ;
    arcus:seam "arcus:hand-law" ; arcus:status "implemented" ;
    prov:wasDerivedFrom arcus:src-cgap-arrow-ipc .

arcus:prim-ipc-continuation a arcus:KernelPrimitive ; arcus:primName "IpcContinuation" ;
    arcus:primKind "ipc-frame" ;
    arcus:law "0xFFFFFFFF 8-byte continuation token (continuation + metadata_size prefix; EOS = 0xFFFFFFFF 0x00000000)" ;
    arcus:seam "generated" ; arcus:status "implemented" ;
    prov:wasDerivedFrom arcus:src-cgap-arrow-ipc .

arcus:prim-oabi-header a arcus:KernelPrimitive ; arcus:primName "OabiHeader" ;
    arcus:primKind "ipc-header" ;
    arcus:law "64-byte MetaHeader, IPC1 magic 0x49504331 @0x00, version u16 @0x04, flags u16 @0x06, schema_digest[32] @0x08, body_len u32 @0x28, alignment u32 @0x2C (8|64), seq u32 @0x30, reserved0 @0x34, header_digest FNV-1a32 over bytes [0x00,0x38) @0x38, zero tail [0x3C,0x40)" ;
    arcus:seam "generated" ; arcus:status "implemented" ;
    prov:wasDerivedFrom arcus:src-cgap-arrow-ipc .

arcus:prim-oabi-header-blake3-128 a arcus:KernelPrimitive ; arcus:primName "OabiHeaderBlake3_128" ;
    arcus:primKind "ipc-header-proposed" ;
    arcus:law "PROPOSED evolution: 128-byte BLAKE3-hashed header replacing the FNV-1a 64B MetaHeader and the deferred FlatBuffers metadata; NOT wire law yet" ;
    arcus:seam "proposed" ; arcus:status "proposed" ;
    prov:wasDerivedFrom arcus:src-oabi-breakdown .

arcus:prim-record-batch-slicer a arcus:KernelPrimitive ; arcus:primName "RecordBatchSlicer" ;
    arcus:primKind "slicer" ;
    arcus:law "slice(offset,length) as offset-integer update over one backing buffer: zero copy, no data movement" ;
    arcus:seam "generated" ; arcus:status "implemented" ;
    prov:wasDerivedFrom arcus:src-cgap-arrow-ipc .

arcus:prim-stream-writer a arcus:KernelPrimitive ; arcus:primName "StreamWriter" ;
    arcus:primKind "stream" ;
    arcus:law "writev/sendmsg vectored emission to a Unix domain socket in fixed emit order: continuation, metaSize, meta, metaPad, body, bodyPad, EOS" ;
    arcus:seam "generated" ; arcus:status "implemented" ;
    prov:wasDerivedFrom arcus:src-cgap-arrow-ipc .


# ---------------------------------------------------------------------------
# Flight projection (PG-A9 PART A step 3): arcus:Feed — one wire-format feed
# per dialect operation, projected into the flight transcode table. Frame
# flags are the cgap frame.rs law: FLAG_ARROW 0x01, FLAG_PARQUET 0x02,
# FLAG_BN3 0x04, FLAG_GITPACK 0x08. prov:wasDerivedFrom is mandatory (gate
# 090_feed_closure).
# ---------------------------------------------------------------------------

arcus:Feed a rdfs:Class ;
    rdfs:label "Flight feed" ;
    rdfs:comment "One dialect operation's wire feed: wireFormat, cgap frameFlag (closed set 0x01|0x02|0x04|0x08), its bijection-partner transcoder, and mandatory prov:wasDerivedFrom. Projected into the flightOpTable allowlist (PG-A9 PART A step 3)." .

arcus:Transcoder a rdfs:Class ;
    rdfs:label "Flight transcoder" ;
    rdfs:comment "The codec seam one feed's payload crosses at the boundary. Bijection partner of exactly one arcus:Feed (gate 090_feed_closure)." .

arcus:src-flight-frame-law a prov:Entity ;
    dcterms:title "cgap frame format law (PG-A9 PART A)" ;
    dcterms:source <file:///Users/sac/cgap/cgap-core/src/frame.rs> .

arcus:src-flight-ontology-plan a prov:Entity ;
    dcterms:title "PG-A9 arcus flight implementation plan (PART A step 3)" ;
    dcterms:source <file:///Users/sac/arcus/docs/jira/v26.11.3/receipts/ga-6-arcus-flight.md> .

arcus:feed-aws-eventbridge-put-events a arcus:Feed ;
    arcus:feedOf arcus:op-aws-eventbridge-put-events ;
    arcus:wireFormat "json-envelope" ;
    arcus:frameFlag "0x01" ;
    arcus:transcoder arcus:transcoder-eventbridge-json-arrow ;
    prov:wasDerivedFrom arcus:src-flight-frame-law .

arcus:feed-aws-s3-put-object a arcus:Feed ;
    arcus:feedOf arcus:op-aws-s3-put-object ;
    arcus:wireFormat "parquet" ;
    arcus:frameFlag "0x02" ;
    arcus:transcoder arcus:transcoder-s3-parquet-arrow ;
    prov:wasDerivedFrom arcus:src-flight-frame-law .

arcus:feed-gcp-pubsub-publish a arcus:Feed ;
    arcus:feedOf arcus:op-gcp-pubsub-publish ;
    arcus:wireFormat "json-envelope" ;
    arcus:frameFlag "0x01" ;
    arcus:transcoder arcus:transcoder-pubsub-json-arrow ;
    prov:wasDerivedFrom arcus:src-flight-frame-law .

arcus:feed-azure-eventhubs-send a arcus:Feed ;
    arcus:feedOf arcus:op-azure-eventhubs-send ;
    arcus:wireFormat "json-envelope" ;
    arcus:frameFlag "0x01" ;
    arcus:transcoder arcus:transcoder-eventhubs-json-arrow ;
    prov:wasDerivedFrom arcus:src-flight-frame-law .

arcus:feed-kafka-produce a arcus:Feed ;
    arcus:feedOf arcus:op-kafka-produce ;
    arcus:wireFormat "gitpack" ;
    arcus:frameFlag "0x08" ;
    arcus:transcoder arcus:transcoder-kafka-gitpack-arrow ;
    prov:wasDerivedFrom arcus:src-flight-frame-law .

# Lane 14 (v26.11.6): the Fetch face mirrors the Produce feed law — the
# broker re-serves batch bytes verbatim (gitpack frameFlag 0x08), the same
# transcoder partner as produce.
arcus:feed-kafka-fetch a arcus:Feed ;
    arcus:feedOf arcus:op-kafka-fetch ;
    arcus:wireFormat "gitpack" ;
    arcus:frameFlag "0x08" ;
    arcus:transcoder arcus:transcoder-kafka-gitpack-arrow-fetch ;
    prov:wasDerivedFrom arcus:src-flight-frame-law .

arcus:feed-stripe-webhook-construct-event a arcus:Feed ;
    arcus:feedOf arcus:op-stripe-webhook-construct-event ;
    arcus:wireFormat "json-envelope" ;
    arcus:frameFlag "0x01" ;
    arcus:transcoder arcus:transcoder-stripe-json-arrow ;
    prov:wasDerivedFrom arcus:src-flight-frame-law .

arcus:transcoder-eventbridge-json-arrow a arcus:Transcoder ;
    rdfs:label "EventBridge JSON envelope to Arrow" ;
