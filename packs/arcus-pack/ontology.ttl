@prefix arcus: <urn:arcus:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Canonical arcus graph. Construction only: no generated adapter has ambient
# actuation authority; every operation is admitted by an ontology-projected
# allowlist table and an absent operation is a typed refusal, never nil,nil.

arcus:Dialect a rdfs:Class ;
    rdfs:label "Cloud-ingest dialect" ;
    rdfs:comment "A provider-specific ingest surface (one per external cloud)." .

arcus:Service a rdfs:Class ;
    rdfs:label "Provider service" ;
    rdfs:comment "A provider service endpoint bearing a basePath and authMode (sigv4 | oauth2 | shared-key | none)." .

arcus:Operation a rdfs:Class ;
    rdfs:label "Dialect operation" ;
    rdfs:comment "One wire-level operation: dot-namespaced id, closed HTTP method, templated path, authScope, errorShape, request and response shapes, closed status set, and mandatory prov:wasDerivedFrom." .

arcus:ErrorShape a rdfs:Class ;
    rdfs:label "Error shape" ;
    rdfs:comment "Typed error envelope projected into Go error types." .

arcus:Shape a rdfs:Class ;
    rdfs:label "Request or response shape" ;
    rdfs:comment "Concrete Go struct projected from a Shape individual." .

arcus:Field a rdfs:Class ;
    rdfs:label "Shape field" ;
    rdfs:comment "One field of a Shape: fieldName, goName (mandatory when fieldName carries an initialism), goType, jsonTag." .

arcus:dialect-aws-eventbridge a arcus:Dialect ; dcterms:identifier "aws-eventbridge" ;
    rdfs:label "AWS EventBridge" ; arcus:slug "aws-eventbridge" ; arcus:goName "AWSEventBridge" ;
    arcus:basePath "/" ; arcus:authMode "sigv4" ;
    prov:wasDerivedFrom arcus:src-c4-external-clouds .

