# ---------------------------------------------------------------------------
# AOQ1 Go twin (W2-B, wave-2-membrane-plan §1; ZD-13 wire-law correction).
# The lawful AOQ1 wire law is the sidecar's (aoq_sidecar.rs), NOT
# cgap-arrow's IPC MetaHeader: codec-sealed AoqHeader (FNV-1a32 over
# [0x00,0x3C) stored at 0x3C) leads the 120-byte metadata block, body_len
# u32 LE at window offset 72..76, blake3 tag 16B at 76..92, then
# pad_to(body_len,64) and EOS. Response leg: 4-byte LE frozen-band status
# word; refusals are never echoes.
# Ground truth: include/cgap_aoq.h + aoq_sidecar.rs (the wire authority).
# ---------------------------------------------------------------------------

arcus:src-cgap-aoq-h a prov:Entity ;
    dcterms:title "cgap AOQ1 header field law (generated C header)" ;
    dcterms:source <file:///Users/sac/cgap/include/cgap_aoq.h> .

arcus:src-aoq-sidecar a prov:Entity ;
    dcterms:title "cgap AoQ kernel sidecar — the AOQ1 wire authority" ;
    dcterms:source <file:///Users/sac/cgap/crates/cgap-ffi/src/bin/aoq_sidecar.rs> .

arcus:src-aoq-status-maps a prov:Entity ;
    dcterms:title "cgap AOQ frozen-band status words (0x4347A001..A009)" ;
    dcterms:source <file:///Users/sac/cgap/crates/cgap-ffi/src/aoq/status_maps.rs> .

arcus:prim-aoq-header a arcus:KernelPrimitive ; arcus:primName "AoqHeader" ;
    arcus:primKind "aoq-header" ;
    arcus:law "64-byte AoqHeader, little-endian per cgap_aoq.h/codec.rs: magic 0x414F5131 u32 LE @0x00, version u16 @0x04 (=3, v3 wire law 2026-11-04), epoch u16 @0x06 (closed enum 0|1|2|65535), key_id u64 @0x08, frame_ordinal u32 @0x10, seq u32 @0x14, reserved-zero [0x18,0x3C), header_digest FNV-1a32 over [0x00,0x3C) stored @0x3C" ;
    arcus:seam "generated" ; arcus:status "implemented" ;
    prov:wasDerivedFrom arcus:src-cgap-aoq-h .

arcus:prim-aoq-session-uds a arcus:KernelPrimitive ; arcus:primName "AoqSessionUds" ;
    arcus:primKind "aoq-session" ;
    arcus:law "AOQ1 window over UDS: prefix (0xFFFFFFFF continuation + metaSize 120 LE) + 64B codec-sealed AoqHeader + body_len u32 LE @72..76 + blake3(body)[..16] tag @76..92 + zero pad to metaSize 120 + body + pad_to(body_len,64) + EOS (0xFFFFFFFF,0x00000000); response = 4-byte LE frozen-band status word (0x4347A001..A009); refusals are never echoes; request framing that is incomplete, oversize, or tag-gate-failing is refused with a status word before any accept" ;
    arcus:seam "arcus:hand-law" ; arcus:status "implemented" ;
    prov:wasDerivedFrom arcus:src-aoq-sidecar .
