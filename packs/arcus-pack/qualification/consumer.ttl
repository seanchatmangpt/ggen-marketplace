# Seed consumer binding: one arcus consumer bound to one dialect + operation
# from the canonical graph. Qualification uses this to verify that a consumer
# grounded in the pack sees exactly the projected allowlist (no more, no less).
@prefix arcus: <urn:arcus:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

arcus:consumer-arcus-ingest a arcus:Consumer ;
    dcterms:title "arcus seed consumer (cloud-ingest service)" ;
    arcus:bindsDialect arcus:dialect-aws-eventbridge ;
    arcus:bindsOperation arcus:op-aws-eventbridge-put-events ;
    prov:wasDerivedFrom arcus:src-c4-external-clouds .
