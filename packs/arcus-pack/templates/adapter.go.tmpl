---
to: internal/arcus/adapter/adapter.go
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/arcus-pack
sparql:
  operations: >
    PREFIX arcus: <urn:arcus:>
    SELECT ?id ?method ?path ?dialect ?goName ?status ?padK WHERE {
      { SELECT ?op ?id ?method ?path ?dialect ?goName ?status ?kl WHERE {
          ?op a arcus:Operation ; arcus:id ?id ; arcus:method ?method ; arcus:path ?path ;
              arcus:status ?status ; arcus:dialect ?dialect .
          ?dialect arcus:goName ?goName .
          BIND(STRLEN(?id) AS ?kl)
      } }
      { SELECT (MAX(?kl2) AS ?mkl) WHERE {
          ?op2 a arcus:Operation ; arcus:id ?id2 .
          BIND(STRLEN(?id2) AS ?kl2)
      } }
      BIND((?mkl - ?kl) AS ?padK)
    } ORDER BY ?id
---
// Code generated by ggen from packs/arcus-pack/ontology.ttl. DO NOT EDIT.
// Generated-dispatcher law: the table below is the allowlist. An operation
// absent from the graph is refused with a concrete *RefusalError, never nil, nil.

package adapter

import (
	"fmt"
	"net/http"
)

// RefusalError is the concrete typed refusal for operations outside the
// ontology-projected allowlist.
type RefusalError struct {
	OpID string
	Msg  string
}

func (e *RefusalError) Error() string { return fmt.Sprintf("arcus: refused op %q: %s", e.OpID, e.Msg) }

// opEntry is one allowlist row. Rendered literal keys only — this is a data
// table, not reflection.
type opEntry struct {
	ID      string
	Method  string
	Path    string
	Dialect string
}

{% set padstr = "                                " %}var opTable = map[string]opEntry{
{% for op in operations %}	"{{ op.id }}":{{ padstr | truncate(length=op.padK, end="") }} {ID: "{{ op.id }}", Method: "{{ op.method }}", Path: "{{ op.path }}", Dialect: "{{ op.goName }}"},
{% endfor %}}

// Dispatch admits only operations present in the graph. Anything else is a
// typed refusal.
func Dispatch(id string, req *http.Request) (*http.Response, error) {
	entry, ok := opTable[id]
	if !ok {
		return nil, &RefusalError{OpID: id, Msg: "not in ontology-projected allowlist"}
	}
	if req.Method != entry.Method {
		return nil, &RefusalError{OpID: id, Msg: fmt.Sprintf("method %s, want %s", req.Method, entry.Method)}
	}
	// Path substitution is done by the hand-written byte-append expander in
	// custom_handlers.go; this dispatcher owns admission only.
	return doRequest(entry, req)
}

func HasOperation(id string) bool { _, ok := opTable[id]; return ok }
