	"continuation",
	"metaSize",
	"meta",
	"metaPad",
	"body",
	"bodyPad",
	"eos",
}

// oabiPadTo rounds n up to a multiple of a (a a power of two).
func oabiPadTo(n int, a int) int { return (n + a - 1) & ^(a - 1) }

// oabiMetaSpan is the metadata_size wire word for an alignment: the 64-byte
// header plus zero padding that lands the body on the alignment boundary.
func oabiMetaSpan(alignment int) int {
	return oabiPadTo(oabiPrefixSize+oabiMetaHeaderSize, alignment) - oabiPrefixSize
}

// oabiWindowLen is the full frame length for a body at alignment.
func oabiWindowLen(bodyLen int, alignment int) int {
	span := oabiMetaSpan(alignment)
	return oabiPrefixSize + span + bodyLen + oabiPadTo(bodyLen, alignment) + oabiEOSSize
}

// oabiFrame writes one encapsulated message into out: prefix, sealed meta,
// padding, body, body padding, EOS. Returns the window bytes written.
func oabiFrame(out []byte, h OabiHeader, body []byte) ([]byte, error) {
	if h.Alignment != 8 && h.Alignment != 64 {
		return nil, &OabiHeaderError{Field: "alignment", Msg: "must be 8 or 64"}
	}
	if int(h.BodyLen) != len(body) {
		return nil, &OabiHeaderError{Field: "body_len", Msg: "disagrees with body"}
	}
	total := oabiWindowLen(len(body), int(h.Alignment))
	if len(out) < total {
		return nil, &OabiHeaderError{Field: "out", Msg: "short window"}
	}
	span := oabiMetaSpan(int(h.Alignment))
	le32(out[0:], oabiContinuation)
	le32(out[4:], uint32(span))
	if _, err := OabiHeaderEncode(out[oabiPrefixSize:], h); err != nil {
		return nil, err
	}
	for i := oabiPrefixSize + oabiMetaHeaderSize; i < oabiPrefixSize+span; i++ {
		out[i] = 0
	}
	w := oabiPrefixSize + span
	copy(out[w:], body)
	w += len(body)
	for i := w; i < w+oabiPadTo(len(body), int(h.Alignment)); i++ {
		out[i] = 0
	}
	w += oabiPadTo(len(body), int(h.Alignment))
	le32(out[w:], oabiContinuation)
	le32(out[w+4:], oabiEOS)
	return out[:total], nil
}

// StreamWriter emits encapsulated messages to a Unix domain socket with
// vectored writes (net.Buffers writev on *net.UnixConn).
type StreamWriter struct {
	Conn *net.UnixConn
}

// Emit frames one message and writes it to the socket in the emit-order
// table above. Buf must be at least oabiWindowLen(len(body), alignment).
func (sw *StreamWriter) Emit(buf []byte, h OabiHeader, body []byte) error {
	window, err := oabiFrame(buf, h, body)
	if err != nil {
		return err
	}
	span := oabiMetaSpan(int(h.Alignment))
	buffers := net.Buffers{
		window[:oabiPrefixSize],
		window[oabiPrefixSize : oabiPrefixSize+span],
		window[oabiPrefixSize+span : oabiPrefixSize+span+len(body)],
		window[oabiPrefixSize+span+len(body) : len(window)-oabiEOSSize],
		window[len(window)-oabiEOSSize:],
	}
	_, err = buffers.WriteTo(sw.Conn)
	return err
}

// ---------------------------------------------------------------------------
// Little-endian helpers (allocation-free, no encoding/binary).
// ---------------------------------------------------------------------------

func le16(b []byte, v uint16) { b[0] = byte(v); b[1] = byte(v >> 8) }

func le32(b []byte, v uint32) {
	b[0] = byte(v)
	b[1] = byte(v >> 8)
	b[2] = byte(v >> 16)
	b[3] = byte(v >> 24)
}

func rd16(b []byte) uint16 { return uint16(b[0]) | uint16(b[1])<<8 }

func rd32(b []byte) uint32 {
	return uint32(b[0]) | uint32(b[1])<<8 | uint32(b[2])<<16 | uint32(b[3])<<24
}
