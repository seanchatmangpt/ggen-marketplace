// ---------------------------------------------------------------------------

// BitmapCount counts set bits in b.
func BitmapCount(b []byte) int {
	n := 0
	for _, w := range b {
		n += bits.OnesCount8(w)
	}
	return n
}

// BitmapCount64 counts set bits in whole uint64 words.
func BitmapCount64(words []uint64) int {
	n := 0
	for _, w := range words {
		n += bits.OnesCount64(w)
	}
	return n
}

