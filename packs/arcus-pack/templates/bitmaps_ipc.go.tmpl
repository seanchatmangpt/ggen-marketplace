	h.Version = rd16(b[oabiOffVersion:])
	h.Flags = rd16(b[oabiOffFlags:])
	copy(h.SchemaDigest[:], b[oabiOffSchemaDigest:oabiOffBodyLen])
	h.BodyLen = rd32(b[oabiOffBodyLen:])
	h.Alignment = rd32(b[oabiOffAlignment:])
	h.Seq = rd32(b[oabiOffSeq:])
	h.Reserved0 = rd32(b[oabiOffReserved0:])
	h.HeaderDigest = rd32(b[oabiOffHeaderDigest:])
	copy(h.PadTail[:], b[oabiMetaHeaderSize-4:])
	return h
}

// fnv1a32 is the FNV-1a 32-bit hash over b (header_digest law).
func fnv1a32(b []byte) uint32 {
	h := uint32(0x811C9DC5)
	for _, c := range b {
		h ^= uint32(c)
		h *= 0x01000193
	}
	return h
