// BitmapSet sets bit i (LSB-first) in b. BCE-friendly: caller bounds b.
func BitmapSet(b []byte, i int) {
	b[uint(i)>>3] |= 1 << (uint(i) & 7)
}

// BitmapClear clears bit i.
func BitmapClear(b []byte, i int) {
	b[uint(i)>>3] &^= 1 << (uint(i) & 7)
}

// BitmapIsSet reports whether bit i is set.
func BitmapIsSet(b []byte, i int) bool {
	return b[uint(i)>>3]&(1<<(uint(i)&7)) != 0
}

