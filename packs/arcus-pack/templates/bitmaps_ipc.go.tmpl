		return OabiHeader{}, &OabiHeaderError{Field: "window", Msg: "short"}
	}
	h := oabiDecode(b[:oabiMetaHeaderSize])
	if h.Magic != oabiMetaHeaderMagic {
		return OabiHeader{}, &OabiHeaderError{Field: "magic", Msg: "not IPC1"}
	}
	if h.Reserved0 != 0 || h.PadTail != [4]byte{} {
		return OabiHeader{}, &OabiHeaderError{Field: "reserved", Msg: "nonzero"}
	}
	var raw [oabiMetaHeaderSize]byte
	oabiEncode(raw[:], &h)
	if fnv1a32(raw[:oabiHeaderDigestSpan]) != h.HeaderDigest {
		return OabiHeader{}, &OabiHeaderError{Field: "header_digest", Msg: "mismatch"}
	}
	if h.Alignment != 8 && h.Alignment != 64 {
		return OabiHeader{}, &OabiHeaderError{Field: "alignment", Msg: "must be 8 or 64"}
	}
	return h, nil
}

