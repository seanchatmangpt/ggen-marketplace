// ---------------------------------------------------------------------------
// OabiHeader — REAL 64-byte MetaHeader layout per cgap-arrow ipc.rs
// (repr(C), offsets pinned): magic "IPC1" @0x00, version @0x04, flags @0x06,
// schema_digest[32] @0x08, body_len @0x28, alignment @0x2C (8|64),
// seq @0x30, reserved0 @0x34 (zero), header_digest FNV-1a32 over
// [0x00,0x38) @0x38, zero tail @0x3C.
// ---------------------------------------------------------------------------

const (
	oabiOffMagic                = 0x00
	oabiOffVersion              = 0x04
	oabiOffFlags                = 0x06
	oabiOffSchemaDigest         = 0x08
	oabiOffBodyLen              = 0x28
	oabiOffAlignment            = 0x2C
	oabiOffSeq                  = 0x30
	oabiOffReserved0            = 0x34
	oabiOffHeaderDigest         = 0x38
	oabiMetaHeaderMagic  uint32 = 0x49504331 // "IPC1"
	oabiHeaderDigestSpan        = 0x38
)

// OabiHeader is the byte-array twin of the 64-byte MetaHeader. Layout is
// carried by bytes, not by struct memory layout.
type OabiHeader struct {
	Magic        uint32
	Version      uint16
	Flags        uint16
	SchemaDigest [32]byte
	BodyLen      uint32
	Alignment    uint32
	Seq          uint32
	Reserved0    uint32
	HeaderDigest uint32
	PadTail      [4]byte
}

// oabiEncode writes the 64-byte wire image of h into out (byte-array twin:
// encode is a pure byte layout function, no unsafe, no reflection).
func oabiEncode(out []byte, h *OabiHeader) {
	le32(out[oabiOffMagic:], h.Magic)
	le16(out[oabiOffVersion:], h.Version)
	le16(out[oabiOffFlags:], h.Flags)
	copy(out[oabiOffSchemaDigest:oabiOffBodyLen], h.SchemaDigest[:])
	le32(out[oabiOffBodyLen:], h.BodyLen)
	le32(out[oabiOffAlignment:], h.Alignment)
	le32(out[oabiOffSeq:], h.Seq)
	le32(out[oabiOffReserved0:], h.Reserved0)
	le32(out[oabiOffHeaderDigest:], h.HeaderDigest)
	copy(out[oabiMetaHeaderSize-4:], h.PadTail[:])
}

// oabiDecode parses a 64-byte MetaHeader window.
func oabiDecode(b []byte) OabiHeader {
