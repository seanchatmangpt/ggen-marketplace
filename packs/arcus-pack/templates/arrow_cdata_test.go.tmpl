		s.pl = LeaseBuffers(s.slab, len(s.slab)/2)
	}
	return s.pl.Pointers()
}

// unpin delegates to the hand-law Unpin (idempotent, typed no-op on the
// second call).
func (s *pinnerLeaseSeam) unpin() {
