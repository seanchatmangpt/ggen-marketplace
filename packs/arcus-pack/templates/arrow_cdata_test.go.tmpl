// TestAccessorAllocsPerRunZero — the accessor surface must be
// allocation-free: zero-copy is the whole point of byte-array twins.
func TestAccessorAllocsPerRunZero(t *testing.T) {
	var arr ArrowArrayTwin
	var schema ArrowSchemaTwin
	perms := testing.AllocsPerRun(100, func() {
		schema.SetSchemaFlags(FlagNullable)
		_ = schema.SchemaFlags()
		_ = schema.SchemaRelease()
		arr.SetArrayLength(42)
		_ = arr.ArrayLength()
		_ = arr.ArrayNullCount()
		_ = arr.ArrayRelease()
	})
	if perms != 0 {
		t.Fatalf("accessors allocate: %v allocs/run, want 0", perms)
	}
}

// TestPackBuffersCourt — real slab, real pointer array; assert final state.
func TestPackBuffersCourt(t *testing.T) {
	slab := make([]byte, 64)
	for i := range slab {
		slab[i] = byte(i)
	}
	buffers := PackBuffers(slab, 32)
	validity := (*[32]byte)(buffers[0])
	values := (*[32]byte)(buffers[1])
	if validity[0] != 0 || values[0] != 32 {
		t.Fatalf("buffer packing diverged: validity[0]=%d values[0]=%d", validity[0], values[0])
	}
}

