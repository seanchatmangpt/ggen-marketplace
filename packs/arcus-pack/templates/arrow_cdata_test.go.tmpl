---
to: internal/arcus/cdata/arrow_cdata_test.go
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/arcus-pack
sparql:
  registers: >
    PREFIX arcus: <urn:arcus:>
    SELECT ?goName ?sizeConst ?sizeBytes WHERE {
      ?reg a arcus:WireRegister ; arcus:goName ?goName ;
           arcus:sizeConst ?sizeConst ; arcus:sizeBytes ?sizeBytes .
    } ORDER BY ?goName
  fields: >
    PREFIX arcus: <urn:arcus:>
    SELECT ?regGo ?wireName ?offset ?size ?kind WHERE {
      ?f a arcus:WireField ; arcus:wireName ?wireName ;
         arcus:offset ?offset ; arcus:sizeBytes ?size ;
         arcus:wireKind ?kind ; arcus:fieldOf ?reg .
      ?reg arcus:goName ?regGo .
    } ORDER BY ?regGo ?offset
---
