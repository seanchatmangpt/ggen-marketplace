		s.pl.Unpin()
		s.pl = nil
	}
}

// TestPinnerLeaseSeam exercises the seam's real behavior: a leased slab
// yields non-nil buffer pointers into the pinned memory, and the spent
// lease traps on double-export (the hand-law double-export discipline).
func TestPinnerLeaseSeam(t *testing.T) {
	slab := make([]byte, 32)
	seam := newPinnerLeaseSeam(slab)
	buffers := seam.lease()
	if buffers[0] == nil || buffers[1] == nil {
		t.Fatalf("lease returned nil buffer pointer: %#v", buffers)
	}
	seam.unpin() // hand-law Unpin; idempotent second call must not panic
	seam.unpin()
}
