		t.Fatalf("{{ reg.sizeConst }} = %d, ontology says {{ reg.sizeBytes }}", {{ reg.sizeConst }})
	}
	var twin {{ reg.goName }}
{%- for f in fields %}
{%- if f.regGo == reg.goName and f.kind == "int" %}
	twin.Set{{ f.wireName }}({{ f.offset }}*3 + 1)
	if got := twin.{{ f.wireName }}(); got != {{ f.offset }}*3+1 {
		t.Fatalf("{{ f.wireName }} @{{ f.offset }}: got %d want %d", got, {{ f.offset }}*3+1)
	}
{%- endif %}
{%- endfor %}
{%- for f in fields %}
{%- if f.regGo == reg.goName and f.kind == "ptr" %}
	{
		addr := unsafe.Pointer(&twin)
		twin.Set{{ f.wireName }}(addr)
		if got := twin.{{ f.wireName }}(); got != addr {
			t.Fatalf("{{ f.wireName }} ptr @{{ f.offset }}: got %#x want %#x", got, addr)
		}
		twin.Set{{ f.wireName }}(nil)
		if twin.{{ f.wireName }}() != nil {
			t.Fatalf("{{ f.wireName }}: clear failed")
		}
	}
{%- endif %}
{%- endfor %}
{%- for f in fields %}
{%- if f.regGo == reg.goName and f.kind == "release" %}
	{
		sentinel := uintptr({{ f.offset }})*3 + 1
		if prev := twin.Swap{{ f.wireName }}(sentinel); prev != 0 {
			t.Fatalf("Swap{{ f.wireName }} first call: prev = %#x, want 0", prev)
		}
		if prev := twin.Swap{{ f.wireName }}(0); prev != sentinel {
			t.Fatalf("Swap{{ f.wireName }} second call: prev = %#x, want sentinel %#x (release-once law)", prev, sentinel)
		}
		if twin.{{ f.wireName }}() != 0 {
			t.Fatalf("{{ f.wireName }}: not zero after swap-out")
		}
	}
{%- endif %}
{%- endfor %}
}
