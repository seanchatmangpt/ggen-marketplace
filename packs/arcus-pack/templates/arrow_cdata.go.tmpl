---
to: internal/arcus/cdata/arrow_cdata.go
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/arcus-pack
sparql:
  registers: >
    PREFIX arcus: <urn:arcus:>
    SELECT ?goName ?sizeConst ?sizeBytes ?padC WHERE {
      { SELECT ?reg ?goName ?sizeConst ?sizeBytes ?cnl WHERE {
          ?reg a arcus:WireRegister ; arcus:goName ?goName ;
               arcus:sizeConst ?sizeConst ; arcus:sizeBytes ?sizeBytes .
          BIND(STRLEN(?sizeConst) AS ?cnl)
      } }
      { SELECT ?reg (MAX(?nl3) AS ?mnl) WHERE {
          ?f3 a arcus:WireField ; arcus:fieldOf ?reg ; arcus:wireName ?wn3 ;
               arcus:offset ?of3 .
          BIND(STRLEN(CONCAT(?wn3, "Offset")) AS ?nl3)
      } GROUP BY ?reg }
      BIND(IF(?mnl - ?cnl < 0, 0, ?mnl - ?cnl) AS ?padC)
    } ORDER BY ?goName
  fields: >
    PREFIX arcus: <urn:arcus:>
    SELECT ?regGo ?wireName ?offset ?end ?size ?kind ?padN ?padV WHERE {
      { SELECT ?f ?reg ?regGo ?wireName ?offset ?end ?size ?kind ?nl ?vl WHERE {
          ?f a arcus:WireField ; arcus:wireName ?wireName ;
             arcus:offset ?offset ; arcus:sizeBytes ?size ;
             arcus:wireKind ?kind ; arcus:fieldOf ?reg .
          ?reg arcus:goName ?regGo .
          BIND(?offset + ?size AS ?end)
          BIND(STRLEN(CONCAT(?wireName, "Offset")) AS ?nl)
          BIND(STRLEN(STR(?offset)) AS ?vl)
      } }
      { SELECT ?reg (MAX(?nl2) AS ?mnl) (MAX(?vl2) AS ?mvl) WHERE {
          ?f2 a arcus:WireField ; arcus:fieldOf ?reg ; arcus:wireName ?wn2 ;
               arcus:offset ?of2 .
          BIND(STRLEN(CONCAT(?wn2, "Offset")) AS ?nl2)
          BIND(STRLEN(STR(?of2)) AS ?vl2)
      } GROUP BY ?reg }
      BIND(IF(?mnl - ?nl < 0, 0, ?mnl - ?nl) AS ?padN)
      BIND(IF(?mvl - ?vl < 0, 0, ?mvl - ?vl) AS ?padV)
    } ORDER BY ?regGo ?offset
  formats: >
    PREFIX arcus: <urn:arcus:>
    SELECT ?goConst ?value ?pad WHERE {
      { SELECT ?c ?goConst ?value ?cl WHERE {
          ?c a arcus:FormatConst ; arcus:goConst ?goConst ; arcus:value ?value .
          BIND(STRLEN(?goConst) AS ?cl)
      } }
      { SELECT (MAX(?cl2) AS ?mcl) WHERE {
          ?c2 a arcus:FormatConst ; arcus:goConst ?gc2 .
          BIND(STRLEN(?gc2) AS ?cl2)
      } }
      BIND(?mcl - ?cl AS ?pad)
    } ORDER BY ?goConst
  flags: >
    PREFIX arcus: <urn:arcus:>
    SELECT ?goConst ?value ?pad WHERE {
      { SELECT ?c ?goConst ?value ?cl WHERE {
          ?c a arcus:FlagConst ; arcus:goConst ?goConst ; arcus:value ?value .
          BIND(STRLEN(?goConst) AS ?cl)
      } }
      { SELECT (MAX(?cl3) AS ?mcl3) WHERE {
          ?c3 a arcus:FlagConst ; arcus:goConst ?gc3 .
          BIND(STRLEN(?gc3) AS ?cl3)
      } }
      BIND(?mcl3 - ?cl AS ?pad)
    } ORDER BY ?goConst
---
