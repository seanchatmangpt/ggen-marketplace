func TestBitmapRoundTrip(t *testing.T) {
	b := make([]byte, 16)
	for i := 0; i < 128; i++ {
		if BitmapIsSet(b, i) {
			t.Fatalf("bit %d set in zeroed bitmap", i)
		}
		BitmapSet(b, i)
		if !BitmapIsSet(b, i) {
			t.Fatalf("bit %d not set after BitmapSet", i)
		}
		BitmapClear(b, i)
		if BitmapIsSet(b, i) {
			t.Fatalf("bit %d not cleared", i)
		}
	}
	if got := BitmapCount(b); got != 0 {
		t.Fatalf("BitmapCount=%d want 0", got)
	}
}

func TestBitmapLSBFirstLayout(t *testing.T) {
	b := make([]byte, 8)
	BitmapSet(b, 0)
	if b[0] != 0x01 {
		t.Fatalf("LSB-first law: b[0]=%#x want 0x01", b[0])
	}
	BitmapSet(b, 7)
	if b[0] != 0x81 {
		t.Fatalf("bit i&7 law: b[0]=%#x want 0x81", b[0])
	}
	BitmapSet(b, 8)
	if b[1] != 0x01 || b[0] != 0x81 {
		t.Fatalf("byte i>>3 law: b=%v", b)
	}
	if BitmapCount(b) != 3 {
		t.Fatalf("BitmapCount=%d want 3", BitmapCount(b))
	}
}

func TestPopcountMatchesQuick(t *testing.T) {
	f := func(ws []uint64) bool {
		total := 0
		var bytes []byte
		for _, w := range ws {
			for i := 0; i < 8; i++ {
				bytes = append(bytes, byte(w>>(8*uint(i))))
			}
			total += BitmapCount64([]uint64{w})
		}
		return BitmapCount(bytes) == total
	}
	if err := quick.Check(f, nil); err != nil {
		t.Fatal(err)
	}
}

func TestMaskFilterScalar(t *testing.T) {
	src := []uint64{10, 20, 30, 40, 50, 60, 70, 80}
	dst := make([]uint64, len(src))
	// mask bits 0,2,5
	n := MaskFilter(dst, src, 0b100101)
	if n != 3 {
		t.Fatalf("MaskFilter n=%d want 3", n)
	}
	want := []uint64{10, 30, 60}
