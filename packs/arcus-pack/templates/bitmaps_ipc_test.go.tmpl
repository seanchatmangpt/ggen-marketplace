func TestFrameLayout(t *testing.T) {
	h := SealOabiHeader(OabiHeader{Magic: 0x49504331, Version: 1, BodyLen: 3, Alignment: 8})
	body := []byte{7, 8, 9}
	buf := make([]byte, oabiWindowLen(len(body), 8))
	window, err := oabiFrame(buf, h, body)
	if err != nil {
		t.Fatal(err)
	}
	// Emit-order law: continuation at 0, EOS tail, body lands on alignment.
	if rd32(window[0:4]) != 0xFFFFFFFF {
		t.Fatal("continuation token missing at 0")
	}
	if rd32(window[4:8]) != uint32(oabiMetaSpan(8)) {
		t.Fatalf("metaSize=%d want %d", rd32(window[4:8]), oabiMetaSpan(8))
	}
	if got, want := len(window), oabiWindowLen(3, 8); got != want {
		t.Fatalf("window len %d want %d", got, want)
	}
	if window[len(window)-8] != 0xFF || window[len(window)-4:] == nil {
		t.Fatal("EOS tail malformed")
	}
	if rd32(window[len(window)-4:]) != 0x00000000 {
		t.Fatal("EOS zero word missing")
	}
	if window[oabiPrefixSize+oabiMetaSpan(8)] != body[0] {
		t.Fatal("body not at aligned offset")
	}
	// meta padding bytes are zero.
	for i := oabiPrefixSize + 64; i < oabiPrefixSize+oabiMetaSpan(8); i++ {
		if window[i] != 0 {
			t.Fatalf("metaPad nonzero at %d", i)
		}
	}
	if BitmapCount64([]uint64{0xFFFFFFFFFFFFFFFF}) != 64 {
		t.Fatal("popcount word law")
	}
}

