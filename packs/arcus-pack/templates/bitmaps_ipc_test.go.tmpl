func TestOabiHeaderRefusals(t *testing.T) {
	h := SealOabiHeader(OabiHeader{Magic: 0x49504331, Version: 1, BodyLen: 4, Alignment: 64})
	var raw [64]byte
	if _, err := OabiHeaderEncode(raw[:], h); err != nil {
		t.Fatal(err)
	}
	// Mutation court 1: bad magic must refuse.
	bad := raw
	bad[0x00] ^= 0xFF
	if _, err := OabiHeaderDecode(bad[:]); err == nil {
		t.Fatal("bad magic admitted")
	}
	// Mutation court 2: flipped body byte must break the sealed digest.
	bad = raw
	bad[0x28] ^= 0x01
	if _, err := OabiHeaderDecode(bad[:]); err == nil {
		t.Fatal("tampered header admitted")
	}
	// Mutation court 3: nonzero reserved must refuse.
	bad = raw
	bad[0x34] = 1
	if _, err := OabiHeaderDecode(bad[:]); err == nil {
		t.Fatal("nonzero reserved admitted")
	}
	// Mutation court 4: alignment outside {8,64} must refuse.
	h2 := SealOabiHeader(OabiHeader{Magic: 0x49504331, Alignment: 16})
	var raw2 [64]byte
	if _, err := OabiHeaderEncode(raw2[:], h2); err == nil {
		t.Fatal("alignment 16 admitted at encode")
	}
}

func TestOabiHeaderOffsetLayout(t *testing.T) {
	// Ground-truth pin: cgap-arrow ipc.rs MetaHeader offsets.
	h := SealOabiHeader(OabiHeader{
		Magic:        0x49504331,
		Version:      1,
		SchemaDigest: [32]byte{0xAB},
		BodyLen:      0xDEADBEEF,
		Alignment:    8,
		Seq:          42,
	})
	var raw [64]byte
	if _, err := OabiHeaderEncode(raw[:], h); err != nil {
		t.Fatal(err)
	}
	if raw[0x00] != 0x31 || raw[0x03] != 0x49 {
		t.Fatalf("magic LE bytes at 0x00: %v", raw[0x00:0x04])
	}
	if raw[0x08] != 0xAB {
		t.Fatalf("schema_digest at 0x08: %v", raw[0x08:0x0C])
	}
	if rd32(raw[0x28:0x2C]) != 0xDEADBEEF {
		t.Fatalf("body_len at 0x28: %v", raw[0x28:0x2C])
	}
	if rd32(raw[0x2C:0x30]) != 8 {
		t.Fatalf("alignment at 0x2C")
	}
	if rd32(raw[0x30:0x34]) != 42 {
		t.Fatalf("seq at 0x30")
	}
	if h.HeaderDigest != fnv1a32(raw[:0x38]) {
		t.Fatal("digest is not FNV-1a over [0,0x38)")
	}
}

