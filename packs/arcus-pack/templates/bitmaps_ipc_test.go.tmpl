	root := RecordBatchSlice{Buf: buf, Offset: 0, Length: len(buf)}
	sub, err := root.Slice(2, 4)
	if err != nil {
		t.Fatal(err)
	}
	sub.Bytes()[0] = 0xFF
	if buf[2] != 0xFF {
		t.Fatal("Slice copied data; zero-copy law broken")
	}
	if _, err := root.Slice(-1, 2); err == nil {
		t.Fatal("negative offset admitted")
	}
	if _, err := root.Slice(6, 4); err == nil {
		t.Fatal("out-of-window slice admitted")
	}
}

