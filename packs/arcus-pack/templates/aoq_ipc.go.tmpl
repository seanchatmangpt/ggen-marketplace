		panic("arcus/adapter: SetAoqTagHook(nil) - nil-set is a boot-law violation (fail-closed)")
	}
	aoqTagHookMu.Lock()
	defer aoqTagHookMu.Unlock()
	if aoqTagHook != nil {
		return &AoqHeaderError{Field: "tag_hook", Msg: "tag seam already installed (set-once law; refusal, never a silent replace)"}
	}
	aoqTagHook = h
	return nil
}

// AoqTagHook returns the installed tag seam or nil when unset. Readers
// (Emit, hand-law boundaries) call this accessor; court-only seam swaps
// live in the hand-law scaffolding (tag_hook_court.go) under the same
// mutex — never a lawful production path.
func AoqTagHook() func(body []byte) [AoqTagBytes]byte {
