// aoqEncodeHeader writes the 64-byte wire image of h into out. Reserved
// tail is written zero (reserved-zero law). Mirrors cgap-aoq codec::encode.
func aoqEncodeHeader(out []byte, h *AoqHeader) {
	le32(out[AoqOffMagic:], h.Magic)
	le16(out[AoqOffVersion:], h.Version)
	le16(out[AoqOffEpoch:], h.Epoch)
	for i := 0; i < 8; i++ {
		out[AoqOffKeyID+i] = byte(h.KeyID >> (8 * i))
	}
	le32(out[AoqOffFrameOrdinal:], h.FrameOrdinal)
	le32(out[AoqOffSeq:], h.Seq)
	for i := range out[AoqOffReserved:AoqOffHeaderDigest] {
		out[AoqOffReserved+i] = 0
	}
	le32(out[AoqOffHeaderDigest:], h.HeaderDigest)
}

// aoqDecodeHeader parses the 64-byte AoqHeader window.
func aoqDecodeHeader(b []byte) AoqHeader {
