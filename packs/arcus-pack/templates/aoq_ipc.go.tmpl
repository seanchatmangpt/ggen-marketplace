// AoqPadTo64 rounds n up to a multiple of 64 (ipc::pad_to law).
func AoqPadTo64(n int) int { return (n + 63) &^ 63 }

// AoqWindowLen is the full AOQ1 window length for a body: prefix + metaSpan
// + body + body pad + EOS (window_len law with alignment 64).
func AoqWindowLen(bodyLen int) int {
	return AoqPrefixSize + AoqMetaSpan + bodyLen + AoqPadTo64(bodyLen) + AoqEOSSize
}

// AoqTagHook is the cryptographic body-tag seam (hand law), held behind a
// package sync.RWMutex (set-once seam law). arcus is stdlib-only: blake3
// stays OUT of the generated twin; the host installs a real
// blake3(body)[..16] implementation ONCE at boot via SetAoqTagHook. Nil-set
// is a boot-law panic; a double-set with a different implementation is the
// typed AoqHeaderError set-once refusal and the original stays installed.
// Readers go through the AoqTagHook accessor — never a bare var read.
