	aoqTagHookMu sync.RWMutex
	aoqTagHook   func(body []byte) [AoqTagBytes]byte
)

// SetAoqTagHook installs the cryptographic body-tag seam (set-once law).
// Setting nil panics (boot-law violation: a nil seam must stay unset, not
// installed as nil). A second install with a different implementation
// returns the typed set-once refusal and the original stays installed.
func SetAoqTagHook(h func(body []byte) [AoqTagBytes]byte) error {
