	h.Magic = rd32(b[AoqOffMagic:])
	h.Version = rd16(b[AoqOffVersion:])
	h.Epoch = rd16(b[AoqOffEpoch:])
	for i := 0; i < 8; i++ {
		h.KeyID |= uint64(b[AoqOffKeyID+i]) << (8 * i)
	}
	h.FrameOrdinal = rd32(b[AoqOffFrameOrdinal:])
	h.Seq = rd32(b[AoqOffSeq:])
	copy(h.Reserved[:], b[AoqOffReserved:AoqOffHeaderDigest])
	h.HeaderDigest = rd32(b[AoqOffHeaderDigest:])
	return h
}

// AoqHeaderEncode encodes the sealed 64-byte wire image of h into out.
func AoqHeaderEncode(out []byte, h AoqHeader) ([]byte, error) {
	if len(out) < AoqHeaderSize {
		return nil, &AoqHeaderError{Field: "out", Msg: "short buffer"}
	}
	sealing := h
	var raw [AoqHeaderSize]byte
	aoqEncodeHeader(raw[:], &sealing)
	sealing.HeaderDigest = fnv1a32(raw[:aoqHeaderDigestSpan])
	aoqEncodeHeader(out[:AoqHeaderSize], &sealing)
	return out[:AoqHeaderSize], nil
}

// AoqHeaderDecode validates a 64-byte AoqHeader window: magic, version,
// epoch closed enum, reserved-zero tail, sealed digest.
func AoqHeaderDecode(b []byte) (AoqHeader, error) {
	if len(b) < AoqHeaderSize {
		return AoqHeader{}, &AoqHeaderError{Field: "window", Msg: "short"}
	}
	h := aoqDecodeHeader(b[:AoqHeaderSize])
	if h.Magic != Aoq1Magic {
		return AoqHeader{}, &AoqHeaderError{Field: "magic", Msg: "not AOQ1"}
	}
	if h.Version != Aoq1Version {
		return AoqHeader{}, &AoqHeaderError{Field: "version", Msg: "unsupported"}
	}
	switch h.Epoch {
	case 0, 1, 2, 65535:
	default:
		return AoqHeader{}, &AoqHeaderError{Field: "epoch", Msg: "outside closed enum"}
	}
	for _, c := range h.Reserved {
		if c != 0 {
			return AoqHeader{}, &AoqHeaderError{Field: "reserved", Msg: "nonzero"}
		}
	}
	var raw [AoqHeaderSize]byte
	aoqEncodeHeader(raw[:], &h)
	if fnv1a32(raw[:aoqHeaderDigestSpan]) != h.HeaderDigest {
		return AoqHeader{}, &AoqHeaderError{Field: "header_digest", Msg: "mismatch"}
	}
	return h, nil
}

// ---------------------------------------------------------------------------
// AoqSessionUds — AOQ1 window law over UDS (window-absolute offsets).
// ---------------------------------------------------------------------------

const (
	// AoqContinuation is the Arrow IPC continuation marker.
	AoqContinuation uint32 = 0xFFFFFFFF
	// AoqEOSWord is the end-of-stream word in the metadata_size slot.
	AoqEOSWord uint32 = 0x00000000
	// AoqPrefixSize is continuation + metadata_size.
	AoqPrefixSize = 8
	// AoqMetaSpan is the metadata_size wire word for alignment-64 AOQ1
	// windows: 64B AoqHeader + 4B body_len + 16B tag + 36B zero pad.
	AoqMetaSpan = 120
	// AoqBodyLenAt / AoqTagAt are window-absolute pad-law offsets
	// (sidecar read_window law; cgap-arrow ipc.rs AOQ1_TAG_AT law).
	AoqBodyLenAt = 72
	AoqTagAt     = 76
	// AoqTagBytes is the blake3 body-tag width.
	AoqTagBytes = 16
	// AoqEOSSize is continuation + zero.
	AoqEOSSize = 8
	// AoqMaxBody is the sidecar's DoS bound; larger body_len refuses.
	AoqMaxBody = 1 << 20
)

// Frozen-band status words (cgap-ffi aoq/status_maps.rs law; closed band
// 0x4347A001..A009 — a word outside the band is a typed refusal, never a
// guessed name).
const (
	AoqStatusOK                 uint32 = 0x4347A001
	AoqStatusPending            uint32 = 0x4347A002
	AoqStatusBusy               uint32 = 0x4347A003
	AoqStatusIncompleteFrame    uint32 = 0x4347A004
	AoqStatusDigestMismatch     uint32 = 0x4347A005
	AoqStatusEpochMismatch      uint32 = 0x4347A006
	AoqStatusKeyUnknown         uint32 = 0x4347A007
	AoqStatusEpochRetired       uint32 = 0x4347A008
	AoqStatusUnsupportedVersion uint32 = 0x4347A009
)

// AoqStatusName maps a wire status word to its frozen-band name; the second
// return is false outside the closed band (typed refusal, never a guess).
func AoqStatusName(word uint32) (string, bool) {
	switch word {
	case AoqStatusOK:
		return "OK", true
	case AoqStatusPending:
		return "PENDING", true
	case AoqStatusBusy:
		return "BUSY", true
	case AoqStatusIncompleteFrame:
		return "INCOMPLETE_FRAME", true
	case AoqStatusDigestMismatch:
		return "DIGEST_MISMATCH", true
	case AoqStatusEpochMismatch:
		return "EPOCH_MISMATCH", true
	case AoqStatusKeyUnknown:
		return "KEY_UNKNOWN", true
	case AoqStatusEpochRetired:
		return "EPOCH_RETIRED", true
	case AoqStatusUnsupportedVersion:
		return "UNSUPPORTED_VERSION", true
	}
	return "", false
}

// AoqStatusWord is the inverse map (builders).
func AoqStatusWord(label string) (uint32, bool) {
	switch label {
	case "OK":
		return AoqStatusOK, true
	case "PENDING":
		return AoqStatusPending, true
	case "BUSY":
		return AoqStatusBusy, true
	case "INCOMPLETE_FRAME":
