---
to: internal/arcus/adapter/aoq_ipc.go
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/arcus-pack
sparql:
  prims: >
    PREFIX arcus: <urn:arcus:>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?name ?kind ?law ?seam ?status WHERE {
      ?p a arcus:KernelPrimitive ; arcus:primName ?name ; arcus:primKind ?kind ;
         arcus:law ?law ; arcus:seam ?seam ; arcus:status ?status .
      FILTER (STRSTARTS(?kind, "aoq"))
    } ORDER BY ?name
---
{% for p in prims %}// Primitive: {{ p.name }} [{{ p.kind }}] seam={{ p.seam }} status={{ p.status }} — {{ p.law }}
{% endfor %}
