// AoqHeader is the byte-law carrier of the 64-byte codec-sealed header.
type AoqHeader struct {
	Magic        uint32
	Version      uint16
	Epoch        uint16
	KeyID        uint64
	FrameOrdinal uint32
	Seq          uint32
	Reserved     [36]byte
	HeaderDigest uint32
}

// AoqNewHeader returns a header with version 2, reserved zeroed, and the
// FNV-1a32 digest sealed over [0x00,0x3C) (codec::encode law).
