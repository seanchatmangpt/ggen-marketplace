	AoqOffVersion      = 0x04
	AoqOffEpoch        = 0x06
	AoqOffKeyID        = 0x08
	AoqOffFrameOrdinal = 0x10
	AoqOffSeq          = 0x14
	AoqOffReserved     = 0x18
