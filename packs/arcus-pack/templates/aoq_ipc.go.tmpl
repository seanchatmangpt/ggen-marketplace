// AoqFrame writes one AOQ1 window into buf: prefix (continuation +
// metaSize 120 LE), sealed 64B AoqHeader, body_len u32 LE at 72..76,
// tag at 76..92, zero pad to metaSpan, body, pad64 zeros, EOS.
// tag must be the caller-supplied cryptographic body tag (AoqTagHook).
func AoqFrame(buf []byte, h AoqHeader, body []byte, tag [AoqTagBytes]byte) ([]byte, error) {
	if len(body) > AoqMaxBody {
		return nil, &AoqHeaderError{Field: "body_len", Msg: "oversize"}
	}
	if len(buf) < AoqWindowLen(len(body)) {
		return nil, &AoqHeaderError{Field: "out", Msg: "short window"}
	}
	if _, err := AoqHeaderEncode(buf[AoqPrefixSize:AoqPrefixSize+AoqHeaderSize], h); err != nil {
		return nil, err
	}
	le32(buf[0:], AoqContinuation)
	le32(buf[4:], uint32(AoqMetaSpan))
	le32(buf[AoqBodyLenAt:], uint32(len(body)))
	copy(buf[AoqTagAt:], tag[:])
	for i := AoqTagAt + AoqTagBytes; i < AoqPrefixSize+AoqMetaSpan; i++ {
		buf[i] = 0
	}
	w := AoqPrefixSize + AoqMetaSpan
	copy(buf[w:], body)
	w += len(body)
	for i := w; i < w+AoqPadTo64(len(body)); i++ {
		buf[i] = 0
	}
	w += AoqPadTo64(len(body))
	le32(buf[w:], AoqContinuation)
	le32(buf[w+4:], AoqEOSWord)
	return buf[:AoqWindowLen(len(body))], nil
}

// AoqParseWindow validates one full AOQ1 window: framing (continuation,
// metaSpan 120), sealed header, body_len law, EOS, and — when tagCheck is
// non-nil — the cryptographic tag gate over the carried body. Returns the
// header and the body (zero-copy view into buf).
func AoqParseWindow(buf []byte, tagCheck func(body []byte, tag [AoqTagBytes]byte) error) (AoqHeader, []byte, error) {
	if len(buf) < AoqPrefixSize+AoqMetaSpan+AoqEOSSize {
		return AoqHeader{}, nil, &AoqHeaderError{Field: "window", Msg: "short"}
	}
	if rd32(buf[0:]) != AoqContinuation {
		return AoqHeader{}, nil, &AoqHeaderError{Field: "continuation", Msg: "missing"}
	}
	if int(rd32(buf[4:])) != AoqMetaSpan {
		return AoqHeader{}, nil, &AoqHeaderError{Field: "meta_size", Msg: "not the align-64 span"}
	}
	h, err := AoqHeaderDecode(buf[AoqPrefixSize : AoqPrefixSize+AoqHeaderSize])
	if err != nil {
		return h, nil, err
	}
	bodyLen := int(rd32(buf[AoqBodyLenAt:]))
	if bodyLen > AoqMaxBody {
		return AoqHeader{}, nil, &AoqHeaderError{Field: "body_len", Msg: "oversize"}
	}
	total := AoqWindowLen(bodyLen)
	if len(buf) < total {
		return AoqHeader{}, nil, &AoqHeaderError{Field: "window", Msg: "truncated body"}
	}
	eosAt := AoqPrefixSize + AoqMetaSpan + bodyLen + AoqPadTo64(bodyLen)
	if rd32(buf[eosAt:]) != AoqContinuation || rd32(buf[eosAt+4:]) != AoqEOSWord {
		return AoqHeader{}, nil, &AoqHeaderError{Field: "eos", Msg: "missing"}
	}
	body := buf[AoqPrefixSize+AoqMetaSpan : AoqPrefixSize+AoqMetaSpan+bodyLen]
	if tagCheck != nil {
		var tag [AoqTagBytes]byte
		copy(tag[:], buf[AoqTagAt:AoqTagAt+AoqTagBytes])
		if err := tagCheck(body, tag); err != nil {
			return h, nil, err
		}
	}
	return h, body, nil
}

// ---------------------------------------------------------------------------
// AoqStreamWriter — vectored emission of one AOQ1 window to a Unix domain
// socket in fixed emit order: continuation, metaSize, meta(header+pad law),
// body, bodyPad, EOS.
// ---------------------------------------------------------------------------

// AoqStreamWriter emits AOQ1 windows to a Unix domain socket with vectored
// writes (net.Buffers writev on *net.UnixConn). The cryptographic tag comes
// from the AoqTagHook() accessor; a nil hook is a typed refusal (never a
// zero tag).
type AoqStreamWriter struct {
	Conn *net.UnixConn
}

// Emit frames one AOQ1 window and writes it to the socket.
func (sw *AoqStreamWriter) Emit(buf []byte, h AoqHeader, body []byte) error {
	hook := AoqTagHook()
	if hook == nil {
		return &AoqHeaderError{Field: "tag_hook", Msg: "no cryptographic tag seam installed (fail-closed)"}
	}
	tag := hook(body)
	if _, err := AoqFrame(buf, h, body, tag); err != nil {
		return err
	}
	pad := AoqPadTo64(len(body))
	w := AoqPrefixSize + AoqMetaSpan
	buffers := net.Buffers{
		buf[:AoqPrefixSize],
		buf[AoqPrefixSize:w],
		buf[w : w+len(body)],
		buf[w+len(body) : w+len(body)+pad],
		buf[w+len(body)+pad:],
	}
	_, err := buffers.WriteTo(sw.Conn)
	return err
}

