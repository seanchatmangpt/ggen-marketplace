// aoqCGAPHeaderPath resolves the sibling-repo ground-truth header via the
// CGAP_ROOT seam: env override first, then the repo-relative sibling
// <repo>/../cgap (resolved from this template's output path), then the
// historical /Users/sac/cgap as last resort. Skip-not-fail when genuinely
// absent everywhere.
func aoqCGAPHeaderPath(t *testing.T) string {
	if v := os.Getenv("CGAP_ROOT"); v != "" {
		return filepath.Join(v, "include", "cgap_aoq.h")
	}
	if _, thisFile, _, ok := runtime.Caller(0); ok {
		// The rendered test lives at <repo>/internal/arcus/adapter — four
		// dirs below the repo root — so the sibling checkout is ../cgap.
		sibling := filepath.Join(thisFile, "..", "..", "..", "..", "..", "cgap", "include", "cgap_aoq.h")
		if _, err := os.Stat(sibling); err == nil {
			return sibling
		}
	}
	return "/Users/sac/cgap/include/cgap_aoq.h"
}

// aoqParseHeaderDefines extracts CGAP_AOQ1_* defines from the generated
// header. Absent sibling checkout = disclosed skip; present checkout with
// drifted defines = loud court failure.
func aoqParseHeaderDefines(t *testing.T, path string) map[string]uint64 {
	t.Helper()
	data, err := os.ReadFile(path)
	if err != nil {
		t.Skipf("DISCLOSED SKIP: cgap_aoq.h unavailable (%v)", err)
	}
	re := regexp.MustCompile(`#define\s+(CGAP_AOQ1_[A-Z0-9_]+)\s+(0x[0-9A-Fa-f]+|\d+)`)
	out := make(map[string]uint64)
	for _, m := range re.FindAllStringSubmatch(string(data), -1) {
		v, err := strconv.ParseUint(m[2], 0, 64)
		if err != nil {
			t.Fatalf("unparseable define %s=%s: %v", m[1], m[2], err)
		}
		out[m[1]] = v
	}
	return out
}

func TestAoqHeaderDriftCourt(t *testing.T) {
	defs := aoqParseHeaderDefines(t, aoqCGAPHeaderPath(t))
	if got := defs["CGAP_AOQ1_HEADER_SIZE"]; got != AoqHeaderSize {
		t.Fatalf("CGAP_AOQ1_HEADER_SIZE %d != AoqHeaderSize %d", got, AoqHeaderSize)
	}
	if got := defs["CGAP_AOQ1_MAGIC"]; got != uint64(Aoq1Magic) {
		t.Fatalf("CGAP_AOQ1_MAGIC %#x != Aoq1Magic %#x", got, Aoq1Magic)
	}
	if got := defs["CGAP_AOQ1_VERSION"]; got != uint64(Aoq1Version) {
		t.Fatalf("CGAP_AOQ1_VERSION %d != Aoq1Version %d", got, Aoq1Version)
	}
	offsets := map[string]int{
		"CGAP_AOQ1_MAGIC_OFFSET":         AoqOffMagic,
		"CGAP_AOQ1_VERSION_OFFSET":       AoqOffVersion,
		"CGAP_AOQ1_EPOCH_OFFSET":         AoqOffEpoch,
		"CGAP_AOQ1_KEY_ID_OFFSET":        AoqOffKeyID,
		"CGAP_AOQ1_FRAME_ORDINAL_OFFSET": AoqOffFrameOrdinal,
		"CGAP_AOQ1_SEQ_OFFSET":           AoqOffSeq,
		"CGAP_AOQ1_RESERVED_OFFSET":      AoqOffReserved,
		"CGAP_AOQ1_HEADER_DIGEST_OFFSET": AoqOffHeaderDigest,
	}
	for define, goConst := range offsets {
		if got := defs[define]; got != uint64(goConst) {
			t.Fatalf("%s %d != offset %d", define, got, goConst)
		}
	}
	sizes := map[string]int{
		"CGAP_AOQ1_MAGIC_SIZE":         4,
		"CGAP_AOQ1_VERSION_SIZE":       2,
		"CGAP_AOQ1_EPOCH_SIZE":         2,
		"CGAP_AOQ1_KEY_ID_SIZE":        8,
		"CGAP_AOQ1_FRAME_ORDINAL_SIZE": 4,
		"CGAP_AOQ1_SEQ_SIZE":           4,
		"CGAP_AOQ1_RESERVED_SIZE":      36,
		"CGAP_AOQ1_HEADER_DIGEST_SIZE": 4,
	}
	for define, want := range sizes {
		if got := defs[define]; got != uint64(want) {
			t.Fatalf("%s %d != %d", define, got, want)
		}
	}
}

func TestAoqHeaderRoundTrip(t *testing.T) {
	epoch := uint16(1)
	keyID := uint64(0xA071)
	h := AoqNewHeader(epoch, keyID, 7, 42)
	var buf [AoqHeaderSize]byte
	if _, err := AoqHeaderEncode(buf[:], h); err != nil {
		t.Fatalf("encode: %v", err)
	}
	got, err := AoqHeaderDecode(buf[:])
	if err != nil {
		t.Fatalf("decode: %v", err)
	}
	want := AoqNewHeader(epoch, keyID, 7, 42)
	if got != want {
		t.Fatalf("round trip mismatch: %+v vs %+v", got, want)
	}
	// Reserved-zero law: [0x18,0x3C) must read zero on the wire image.
	for i := AoqOffReserved; i < AoqOffHeaderDigest; i++ {
		if buf[i] != 0 {
			t.Fatalf("reserved byte %d nonzero on wire image", i)
		}
	}
	// Digest law: bytes at 0x3C are FNV-1a32 over [0x00,0x3C).
	raw := buf
	raw[AoqOffHeaderDigest], raw[AoqOffHeaderDigest+1], raw[AoqOffHeaderDigest+2], raw[AoqOffHeaderDigest+3] = 0, 0, 0, 0
	if fnv1a32(raw[:AoqOffHeaderDigest]) != got.HeaderDigest {
		t.Fatalf("sealed digest mismatch")
	}
}

// aoqSetTagHookForCourt writes the seam slot directly (package-internal
// court state setup only). Production installs through SetAoqTagHook —
// the set-once law courts exercise that path; this helper exists so the
// round-trip courts can save/restore the slot without the setter law.
func aoqSetTagHookForCourt(h func(body []byte) [AoqTagBytes]byte) {
	aoqTagHookMu.Lock()
	aoqTagHook = h
	aoqTagHookMu.Unlock()
}

// aoqCourtTagA / aoqCourtTagB are the two distinguishable court tag laws
// used by the set-once and race courts.
func aoqCourtTagA(body []byte) [AoqTagBytes]byte {
	var tag [AoqTagBytes]byte
	for i := range tag {
		tag[i] = byte(0xA0 + i)
	}
	return tag
}

func aoqCourtTagB(body []byte) [AoqTagBytes]byte {
	var tag [AoqTagBytes]byte
	for i := range tag {
		tag[i] = byte(0xA0 ^ i)
	}
	return tag
}

func TestAoqWindowRoundTripAndMutationCourts(t *testing.T) {
	orig := AoqTagHook()
	defer aoqSetTagHookForCourt(orig)
	aoqSetTagHookForCourt(aoqCourtTagA)
	body := []byte("aoq1 twin court body")
	var buf [512]byte
	window, err := AoqFrame(buf[:], AoqNewHeader(1, 0xA071, 0, 5), body, AoqTagHook()(body))
	if err != nil {
		t.Fatalf("AoqFrame: %v", err)
	}
	if len(window) != AoqWindowLen(len(body)) {
		t.Fatalf("window len %d != law %d", len(window), AoqWindowLen(len(body)))
	}
	if rd32(window[0:]) != AoqContinuation || int(rd32(window[4:])) != AoqMetaSpan {
		t.Fatalf("prefix law violated: %x", window[0:8])
	}
	if got := rd32(window[AoqBodyLenAt:]); got != uint32(len(body)) {
		t.Fatalf("body_len law violated at 72: %d", got)
	}
	var tag [AoqTagBytes]byte
	copy(tag[:], window[AoqTagAt:AoqTagAt+AoqTagBytes])
	if tag != AoqTagHook()(body) {
		t.Fatalf("tag not carried at 76..92")
	}
	h, gotBody, err := AoqParseWindow(window, nil)
	if err != nil {
		t.Fatalf("AoqParseWindow: %v", err)
	}
	want := AoqNewHeader(1, 0xA071, 0, 5)
	if h != want {
		t.Fatalf("header round trip mismatch")
	}
	if string(gotBody) != string(body) {
		t.Fatalf("body round trip mismatch")
	}
	// Mutation courts: each framing class flips on a real mutation.
	if _, _, err := AoqParseWindow(window[:AoqPrefixSize+AoqMetaSpan-1], nil); err == nil {
		t.Fatalf("short window accepted")
	}
	mut := append([]byte(nil), window...)
	mut[0] = 0x00
	if _, _, err := AoqParseWindow(mut, nil); err == nil {
		t.Fatalf("bad continuation accepted")
	}
	mut = append([]byte(nil), window...)
	mut[5] = 0x01
	if _, _, err := AoqParseWindow(mut, nil); err == nil {
		t.Fatalf("bad meta span accepted")
	}
	mut = append([]byte(nil), window...)
	mut[AoqOffHeaderDigest+AoqPrefixSize] ^= 0xFF
	if _, _, err := AoqParseWindow(mut, nil); err == nil {
		t.Fatalf("bad header digest accepted")
	}
	mut = append([]byte(nil), window...)
	eosAt := AoqPrefixSize + AoqMetaSpan + len(body) + AoqPadTo64(len(body))
	mut[eosAt] ^= 0xFF
	if _, _, err := AoqParseWindow(mut, nil); err == nil {
		t.Fatalf("bad EOS accepted")
	}
	// Tag gate: a tampered body under a stale tag must refuse when the
	// check is armed (the sidecar's read_verified law, mirrored).
	if _, _, err := AoqParseWindow(window, func(body []byte, tag [AoqTagBytes]byte) error { return nil }); err != nil {
		t.Fatalf("passing tag gate must pass: %v", err)
	}
	mut = append([]byte(nil), window...)
	mut[AoqTagAt] ^= 0xFF
	if _, _, err := AoqParseWindow(mut, func(body []byte, tag [AoqTagBytes]byte) error {
		return &AoqHeaderError{Field: "tag", Msg: "mismatch"}
	}); err == nil {
		t.Fatalf("failing tag gate accepted")
	}
}

func TestAoqStatusBandClosed(t *testing.T) {
	labels := []string{"OK", "PENDING", "BUSY", "INCOMPLETE_FRAME", "DIGEST_MISMATCH", "EPOCH_MISMATCH", "KEY_UNKNOWN", "EPOCH_RETIRED", "UNSUPPORTED_VERSION"}
	for _, label := range labels {
		word, ok := AoqStatusWord(label)
		if !ok {
			t.Fatalf("status word lookup refused: %s", label)
		}
		name, ok := AoqStatusName(word)
		if !ok || name != label {
			t.Fatalf("status name lookup refused or drifted: %s", label)
		}
	}
	if _, ok := AoqStatusName(0x4347A000); ok {
		t.Fatalf("word below the frozen band accepted")
	}
	if _, ok := AoqStatusName(0x4347A00A); ok {
		t.Fatalf("word above the frozen band accepted")
	}
}

// TestAoqTagSeamSetOnceCourt proves the set-once seam law end to end:
// nil-set panics (boot law), the first install via SetAoqTagHook wins, a
// double-set with a different implementation is the typed AoqHeaderError
// refusal and the original stays installed, and Emit still refuses
// fail-closed while the seam is unset.
func TestAoqTagSeamSetOnceCourt(t *testing.T) {
	// Nil-set is a boot-law panic, never a silent nil install.
	func() {
		defer func() {
			if recover() == nil {
				t.Fatalf("SetAoqTagHook(nil) must panic (boot-law violation), got a clean return")
			}
		}()
		SetAoqTagHook(nil)
	}()

	orig := AoqTagHook()
	defer aoqSetTagHookForCourt(orig)
	aoqSetTagHookForCourt(nil) // court starts from the unset seam

	// Unset seam: Emit refuses fail-closed (typed, never a zero tag).
	sw := &AoqStreamWriter{}
	var body []byte
	err := sw.Emit(nil, AoqNewHeader(1, 0xA071, 0, 0), body)
	var hookErr *AoqHeaderError
	if err == nil || !errors.As(err, &hookErr) || hookErr.Field != "tag_hook" {
		t.Fatalf("unset seam must refuse Emit with the typed tag_hook refusal, got %v", err)
	}

	// First install via the setter: typed nil refusal, then success.
	if err := SetAoqTagHook(aoqCourtTagA); err != nil {
		t.Fatalf("first SetAoqTagHook must install: %v", err)
	}
	if AoqTagHook() == nil {
		t.Fatalf("accessor lost the installed seam")
	}

	// Double-set with a different implementation: typed refusal, original
	// stays installed (never a silent replace, never a panic).
	err = SetAoqTagHook(aoqCourtTagB)
	if err == nil {
		t.Fatalf("double-set with a different impl must refuse")
	}
	if !errors.As(err, &hookErr) || hookErr.Field != "tag_hook" {
		t.Fatalf("double-set refusal must be the typed tag_hook refusal, got %v", err)
	}
	body = []byte("set-once witness")
	if got := AoqTagHook()(body); got != aoqCourtTagA(body) {
		t.Fatalf("original seam was replaced by the refused install")
	}
}

// TestAoqTagSeamRaceCourt is the -race court for the set-once seam: one
// goroutine installs through SetAoqTagHook (the single lawful write) while
// readers hammer the accessor through the Emit path and the setter's
// refusal path concurrently. Under the RWMutex this must be race-clean;
// reverting the seam to a plain var in a sandbox copy must flip this court
// under -race (non-vacuity).
func TestAoqTagSeamRaceCourt(t *testing.T) {
	orig := AoqTagHook()
	defer aoqSetTagHookForCourt(orig)
	aoqSetTagHookForCourt(nil)

	var wg sync.WaitGroup
	wg.Add(3)

	// Reader 1: hammer the accessor through the Emit (Seal) path. Emits
	// refuse while the seam is unset, then carry aoqCourtTagA after it.
	go func() {
		defer wg.Done()
		// Real UnixConn with a dead peer: writev fails fast (EPIPE) once
		// the hook installs, so the race hammers the accessor through the
		// full Emit path without a nil-Conn segfault or buffer backpressure.
		ln, err := net.Listen("unix", filepath.Join(t.TempDir(), "race.sock"))
		if err != nil {
			t.Errorf("race court listener: %v", err)
			return
		}
		conn, err := net.Dial("unix", ln.Addr().String())
		if err != nil {
			t.Errorf("race court dial: %v", err)
			return
		}
		uc := conn.(*net.UnixConn)
		ln.Close() // dead peer: every subsequent write errors immediately
		sw := &AoqStreamWriter{Conn: uc}
		defer uc.Close()
		var buf [512]byte
		h := AoqNewHeader(1, 0xA071, 0, 0)
		for i := 0; i < 20000; i++ {
			_ = sw.Emit(buf[:], h, nil)
		}
	}()

	// Reader 2: hammer the accessor directly.
	go func() {
		defer wg.Done()
		for i := 0; i < 20000; i++ {
			if hook := AoqTagHook(); hook != nil {
				_ = hook(nil)
			}
		}
	}()

	// Writer: the one lawful install, plus refused double-sets (each must
	// come back as the typed refusal, not a replace).
	go func() {
		defer wg.Done()
		if err := SetAoqTagHook(aoqCourtTagA); err != nil {
			t.Errorf("race court install refused: %v", err)
			return
		}
		for i := 0; i < 20000; i++ {
			if err := SetAoqTagHook(aoqCourtTagB); err == nil {
				t.Errorf("race court double-set was not refused")
				return
			}
		}
	}()
	wg.Wait()

	if got := AoqTagHook()(nil); got != aoqCourtTagA(nil) {
		t.Fatalf("race court left the seam other than the first install")
	}
}

func TestAoqStreamWriterEmitRealUDS(t *testing.T) {
	orig := AoqTagHook()
	defer aoqSetTagHookForCourt(orig)
	aoqSetTagHookForCourt(aoqCourtTagB)
	dir := t.TempDir()
	path := filepath.Join(dir, "aoq-emit.sock")
	l, err := net.Listen("unix", path)
	if err != nil {
		t.Skipf("DISCLOSED SKIP: UDS unavailable: %v", err)
	}
	done := make(chan []byte, 1)
	go func() {
		c, err := l.Accept()
		if err != nil {
			done <- nil
			return
		}
		defer c.Close()
		got := make([]byte, 512)
		n, err := io.ReadFull(c, got[:AoqWindowLen(0)])
		if err != nil {
			t.Errorf("accept-side read: %v", err)
			done <- nil
			return
		}
		done <- got[:n]
	}()
	conn, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: path, Net: "unix"})
	if err != nil {
		t.Skipf("DISCLOSED SKIP: dial refused: %v", err)
	}
	defer conn.Close()
	sw := &AoqStreamWriter{Conn: conn}
	var buf [512]byte
	h := AoqNewHeader(1, 0xA071, 9, 3)
	if err := sw.Emit(buf[:], h, nil); err != nil {
		t.Fatalf("emit: %v", err)
	}
	got := <-done
	if got == nil {
		t.Fatalf("accept side failed")
	}
	h2, body, err := AoqParseWindow(got, nil)
	if err != nil {
		t.Fatalf("parse emitted window: %v", err)
	}
	if h2 != h || len(body) != 0 {
		t.Fatalf("emitted header/body mismatch")
	}
}
