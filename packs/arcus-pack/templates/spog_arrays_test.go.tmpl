// TestQuadSpineCacheLineLaw: 16B blocks mean quad i sits at 16*(i mod 4)
// within its 64B cache line — 4 quads per line, per the ontology purpose fact.
func TestQuadSpineCacheLineLaw(t *testing.T) {
	if QuadsPerCacheLine != 4 {
		t.Fatalf("QuadsPerCacheLine = %d, want 4", QuadsPerCacheLine)
	}
	n := 8
	bitmapLen := (n + 7) / 8
	span := make([]byte, bitmapLen+n*16)
	r := NewFixedSizeList4(span, n)
	for i := 0; i < n; i++ {
		off := bitmapLen + i*16
		binary.LittleEndian.PutUint32(span[off:], uint32(i))
		binary.LittleEndian.PutUint32(span[off+4:], uint32(i*10))
		binary.LittleEndian.PutUint32(span[off+8:], uint32(i*100))
		binary.LittleEndian.PutUint32(span[off+12:], uint32(i*1000))
	}
	for i := 0; i < n; i++ {
		q := r.QuadAt(i)
		want := Quad{S: uint32(i), P: uint32(i * 10), O: uint32(i * 100), G: uint32(i * 1000)}
		if q != want {
			t.Fatalf("QuadAt(%d) = %+v, want %+v", i, q, want)
		}
		if (i*16)%64 != (i%QuadsPerCacheLine)*16 {
			t.Fatalf("cache-line law violated at row %d", i)
		}
	}
}

