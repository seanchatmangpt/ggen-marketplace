---
to: internal/arcus/adapter/types.go
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/arcus-pack
sparql:
  shapes: >
    PREFIX arcus: <urn:arcus:>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?goName ?label WHERE {
      ?shape a arcus:Shape ; arcus:goName ?goName .
      OPTIONAL { ?shape rdfs:label ?label }
    } ORDER BY ?goName
  fields: >
    PREFIX arcus: <urn:arcus:>
    SELECT ?shapeName ?goName ?goType ?jsonTag ?padN ?padT WHERE {
      { SELECT ?shape ?shapeName ?goName ?goType ?jsonTag ?nl ?tl WHERE {
          ?field a arcus:Field ; arcus:fieldOf ?shape ; arcus:goName ?goName ;
                 arcus:goType ?goType ; arcus:jsonTag ?jsonTag .
          ?shape arcus:goName ?shapeName .
          BIND(STRLEN(?goName) AS ?nl)
          BIND(STRLEN(?goType) AS ?tl)
      } }
      { SELECT ?shape (MAX(?nl2) AS ?mnl) (MAX(?tl2) AS ?mtl) WHERE {
          ?f2 a arcus:Field ; arcus:fieldOf ?shape ; arcus:goName ?gn2 ; arcus:goType ?gt2 .
          BIND(STRLEN(?gn2) AS ?nl2)
          BIND(STRLEN(?gt2) AS ?tl2)
      } GROUP BY ?shape }
      BIND((?mnl - ?nl) AS ?padN)
      BIND((?mtl - ?tl) AS ?padT)
    } ORDER BY ?shapeName ?goName
---
// Code generated by ggen from packs/arcus-pack/ontology.ttl. DO NOT EDIT.
// Concrete structs only: no interfaces, no map[string]any on hot paths, no reflection.

package adapter{% set pad = "                    " %}
{% for shape in shapes %}
// {{ shape.label }} — projected from the canonical arcus graph.
type {{ shape.goName }} struct {
{%- for field in fields %}
{%- if field.shapeName == shape.goName %}
	{{ field.goName }}{{ pad | truncate(length=field.padN, end="") }} {{ field.goType }}{{ pad | truncate(length=field.padT, end="") }} `json:"{{ field.jsonTag }}"`
{%- endif -%}
{%- endfor %}
}
{% endfor %}