# MESSAGE: initialism law — any Field whose fieldName contains URL, ID, or API must carry arcus:goName.
PREFIX arcus: <urn:arcus:>
SELECT ?field ?fieldName WHERE {
  ?field a arcus:Field ; arcus:fieldName ?fieldName .
  FILTER (ISLITERAL(?fieldName) && (CONTAINS(?fieldName, "URL") || CONTAINS(?fieldName, "ID") || CONTAINS(?fieldName, "API")))
  FILTER NOT EXISTS { ?field arcus:goName ?goName }
} ORDER BY ?field
