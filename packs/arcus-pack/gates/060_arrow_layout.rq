# MESSAGE: GA1 layout-closure law — every arcus:WireField individual must carry
# a complete layout fact triple (offset, sizeBytes, wireKind). A row returned
# here is an incomplete byte-layout fact in the graph; the projection would
# render a twin whose accessor slices at an unproven offset.
PREFIX arcus: <urn:arcus:>
SELECT ?register ?field ?offset ?size WHERE {
  ?field a arcus:WireField ; arcus:fieldOf ?register .
  OPTIONAL { ?field arcus:offset ?o }
  OPTIONAL { ?field arcus:sizeBytes ?s }
  OPTIONAL { ?field arcus:wireKind ?k }
  BIND(COALESCE(?o, -1) AS ?offset)
  BIND(COALESCE(?s, -1) AS ?size)
  FILTER(!BOUND(?o) || !BOUND(?s) || !BOUND(?k))
} ORDER BY ?offset ?field
