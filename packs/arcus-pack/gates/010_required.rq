# MESSAGE: every arcus Operation must have id, method, path, status, and provenance.
PREFIX arcus: <urn:arcus:>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?op WHERE {
  ?op a arcus:Operation .
  FILTER (
    NOT EXISTS { ?op arcus:id ?id } ||
    NOT EXISTS { ?op arcus:method ?method } ||
    NOT EXISTS { ?op arcus:path ?path } ||
    NOT EXISTS { ?op arcus:status ?status } ||
    NOT EXISTS { ?op prov:wasDerivedFrom ?source }
  )
} ORDER BY ?op
