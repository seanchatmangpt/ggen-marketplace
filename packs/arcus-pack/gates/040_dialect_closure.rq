# MESSAGE: every arcus Dialect slug must be one of the sovereign cloud edge dialects.
PREFIX arcus: <urn:arcus:>
SELECT ?dialect ?slug WHERE {
  ?dialect a arcus:Dialect ; arcus:slug ?slug .
  FILTER (?slug NOT IN ("aws-eventbridge", "aws-s3", "gcp-pubsub", "azure-eventhubs", "kafka", "stripe-webhook", "aws-kinesis", "aws-sqs"))
} ORDER BY ?dialect
