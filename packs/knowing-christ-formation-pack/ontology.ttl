@prefix kcf: <http://seanchatmangpt.github.io/packs/knowing-christ-formation#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

kcf:FormationProgram a rdfs:Class ;
    rdfs:label "Formation program" .

kcf:FormationStep a rdfs:Class ;
    rdfs:label "Formation step" .

kcf:SafetyFence a rdfs:Class ;
    rdfs:label "Formation safety fence" .

kcf:goal a rdf:Property .
kcf:cadence a rdf:Property .
kcf:authority a rdf:Property .
kcf:hasStep a rdf:Property .
kcf:order a rdf:Property .
kcf:scriptureRef a rdf:Property .
kcf:practice a rdf:Property .
kcf:fenceCode a rdf:Property .
kcf:forbids a rdf:Property .

kcf:knowing-christ-v1 a kcf:FormationProgram ;
    dcterms:title "Knowing Christ: A Daily 12-Step Formation Process" ;
    dcterms:description "A Scripture-reference formation process. It does not score conversion, infer spiritual standing, claim revelation, or replace pastoral judgment." ;
    kcf:goal "know_christ" ;
    kcf:cadence "daily_process_not_project" ;
    kcf:authority "CONSTRUCT_ONLY_NO_DO" ;
    kcf:hasStep
        kcf:step-01-empty-hands,
        kcf:step-02-ask-daily,
        kcf:step-03-sow-freely,
        kcf:step-04-discern-seed,
        kcf:step-05-leave-the-harvest,
        kcf:step-06-thorns-and-pruning,
        kcf:step-07-daily-dying,
        kcf:step-08-pray-honestly,
        kcf:step-09-trust-providence,
        kcf:step-10-practice-the-word,
        kcf:step-11-relationship-over-recognition,
        kcf:step-12-press-on-to-know-christ ;
    kcf:forbids
        kcf:no-conversion-score,
        kcf:no-spiritual-leaderboard,
        kcf:no-recognition-as-goal,
        kcf:no-prosperity-formula,
        kcf:no-ai-revelation-claims,
        kcf:no-pastoral-authority,
        kcf:no-private-confession-storage .

kcf:step-01-empty-hands a kcf:FormationStep ;
    kcf:order 1 ;
    dcterms:title "Empty Hands" ;
    kcf:scriptureRef "Job 1:21", "Job 42:10-17" ;
    skos:definition "Receive life as gift rather than treating restoration as an earned result." ;
    kcf:practice "Name what you are trying to control and release the result to God." .

kcf:step-02-ask-daily a kcf:FormationStep ;
    kcf:order 2 ;
    dcterms:title "Ask Daily" ;
    kcf:scriptureRef "Matthew 6:9-13" ;
    skos:definition "Prayer is a daily relationship and dependence, not a project milestone." ;
    kcf:practice "Pray the Lord's Prayer slowly and ask for today's bread, forgiveness, and guidance." .

kcf:step-03-sow-freely a kcf:FormationStep ;
    kcf:order 3 ;
    dcterms:title "Sow Freely" ;
    kcf:scriptureRef "Proverbs 11:24-25" ;
    skos:definition "Practice generosity without turning generosity into a transaction for gain." ;
    kcf:practice "Refresh someone today without requiring recognition or repayment." .

kcf:step-04-discern-seed a kcf:FormationStep ;
    kcf:order 4 ;
    dcterms:title "Discern the Seed" ;
    kcf:scriptureRef "Matthew 13:24-30" ;
    skos:definition "Wheat and weeds can coexist before the harvest; visible results are not final judgment." ;
    kcf:practice "Separate what you observed from the judgment you are tempted to make about it." .

kcf:step-05-leave-the-harvest a kcf:FormationStep ;
    kcf:order 5 ;
    dcterms:title "Leave the Harvest to God" ;
    kcf:scriptureRef "Matthew 13:28-30" ;
    skos:definition "Do not destroy good growth while trying to force an early judgment." ;
    kcf:practice "Choose one situation where patience is more faithful than forced resolution." .

kcf:step-06-thorns-and-pruning a kcf:FormationStep ;
    kcf:order 6 ;
    dcterms:title "Thorns and Pruning" ;
    kcf:scriptureRef "Mark 4:18-19", "John 15:1-5" ;
    skos:definition "Distinguish what chokes growth from the pruning that makes room for fruit." ;
    kcf:practice "Identify one distraction, fear, or attachment that is crowding out attention to Christ." .

kcf:step-07-daily-dying a kcf:FormationStep ;
    kcf:order 7 ;
    dcterms:title "Daily Dying" ;
    kcf:scriptureRef "Luke 9:23-24" ;
    skos:definition "Following Jesus is repeated surrender, not a completed spiritual project." ;
    kcf:practice "Choose one concrete act of self-denial that makes room to love God or neighbor." .

kcf:step-08-pray-honestly a kcf:FormationStep ;
    kcf:order 8 ;
    dcterms:title "Pray Honestly" ;
    kcf:scriptureRef "Psalm 13", "Psalm 51", "Psalm 139:23-24" ;
    skos:definition "David's prayers model honest speech before God: lament, repentance, praise, and examination." ;
    kcf:practice "Tell God the truth about what you fear, want, regret, and hope for." .

kcf:step-09-trust-providence a kcf:FormationStep ;
    kcf:order 9 ;
    dcterms:title "Trust Providence" ;
    kcf:scriptureRef "Genesis 39:2-3", "Genesis 50:19-21" ;
    skos:definition "Joseph's story emphasizes God's presence and providence through suffering without promising an easy outcome." ;
    kcf:practice "Name one painful circumstance without pretending to know its final meaning." .

kcf:step-10-practice-the-word a kcf:FormationStep ;
    kcf:order 10 ;
    dcterms:title "Practice the Word" ;
    kcf:scriptureRef "Matthew 7:24-27" ;
    skos:definition "Hearing becomes formation through practice; information alone is not the foundation." ;
    kcf:practice "Turn one teaching of Jesus you already understand into a specific action today." .

kcf:step-11-relationship-over-recognition a kcf:FormationStep ;
    kcf:order 11 ;
    dcterms:title "Relationship Over Recognition" ;
    kcf:scriptureRef "Matthew 7:21-23" ;
    skos:definition "Recognition and impressive results are not the goal; knowing Christ and doing the Father's will cannot be replaced by performance." ;
    kcf:practice "Do one faithful thing that nobody needs to notice." .

kcf:step-12-press-on-to-know-christ a kcf:FormationStep ;
    kcf:order 12 ;
    dcterms:title "Press On to Know Christ" ;
    kcf:scriptureRef "Philippians 3:7-17" ;
    skos:definition "The process has a direction but not a recognition score: know Christ and keep pressing on." ;
    kcf:practice "Pray: God, I want to know you. Then take the next faithful action already made clear to you." .

kcf:no-conversion-score a kcf:SafetyFence ; kcf:fenceCode "NO_CONVERSION_SCORE" .
kcf:no-spiritual-leaderboard a kcf:SafetyFence ; kcf:fenceCode "NO_SPIRITUAL_LEADERBOARD" .
kcf:no-recognition-as-goal a kcf:SafetyFence ; kcf:fenceCode "NO_RECOGNITION_AS_GOAL" .
kcf:no-prosperity-formula a kcf:SafetyFence ; kcf:fenceCode "NO_PROSPERITY_FORMULA" .
kcf:no-ai-revelation-claims a kcf:SafetyFence ; kcf:fenceCode "NO_AI_REVELATION_CLAIMS" .
kcf:no-pastoral-authority a kcf:SafetyFence ; kcf:fenceCode "NO_PASTORAL_AUTHORITY" .
kcf:no-private-confession-storage a kcf:SafetyFence ; kcf:fenceCode "NO_PRIVATE_CONFESSION_STORAGE" .
