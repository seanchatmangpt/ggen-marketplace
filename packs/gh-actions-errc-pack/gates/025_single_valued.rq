# MESSAGE: proof-relevant ERRC functions are single-valued; any contradictory pair is a refusal.
PREFIX errc: <http://seanchatmangpt.github.io/packs/gh-actions-errc#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?subject ?violation ?property ?left ?right WHERE {
  VALUES ?property {
    errc:operator
    errc:priority
    errc:subject
    errc:decisionRule
    errc:authorityRequirement
    errc:reversible
    errc:actuationMode
    errc:falsifier
    errc:standing
    errc:proposalOnly
    errc:operatorOrder
    dcterms:identifier
    dcterms:date
    errc:identityStanding
    errc:direction
    errc:dimension
    errc:relation
    errc:beforeValue
    errc:afterValue
    errc:digestAlgorithm
    errc:digest
    errc:replayMaterial
    errc:replayCommand
  }
  ?subject ?property ?left, ?right .
  FILTER(?left != ?right)
  BIND("single-valued-property-collision" AS ?violation)
}
ORDER BY ?subject ?property ?left ?right
