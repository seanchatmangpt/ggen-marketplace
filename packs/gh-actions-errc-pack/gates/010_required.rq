# MESSAGE: ERRC objects are admissible only when their proof-relevant fields exist; any row is a refusal.
PREFIX errc: <http://seanchatmangpt.github.io/packs/gh-actions-errc#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?subject ?violation WHERE {
  {
    ?subject a errc:Recommendation .
    VALUES (?property ?violation) {
      (errc:operator "recommendation-operator-missing")
      (errc:subject "recommendation-subject-missing")
      (errc:decisionRule "recommendation-rule-missing")
      (errc:supportedBy "recommendation-evidence-missing")
      (errc:delta "recommendation-delta-missing")
      (errc:protectsInvariant "recommendation-invariant-missing")
      (errc:authorityRequirement "recommendation-authority-missing")
      (errc:reversible "recommendation-reversibility-missing")
      (errc:actuationMode "recommendation-actuation-mode-missing")
      (errc:falsifier "recommendation-falsifier-missing")
      (errc:standing "recommendation-standing-missing")
      (errc:statement "recommendation-statement-missing")
      (errc:impact "recommendation-impact-missing")
    }
    FILTER NOT EXISTS { ?subject ?property ?value }
  } UNION {
    ?subject a errc:Evidence .
    VALUES (?property ?violation) {
      (dcterms:identifier "evidence-id-missing")
      (errc:subject "evidence-subject-missing")
      (dcterms:date "evidence-date-missing")
      (errc:sourceRef "evidence-source-ref-missing")
      (errc:observation "evidence-observation-missing")
      (errc:standing "evidence-standing-missing")
    }
    FILTER NOT EXISTS { ?subject ?property ?value }
  } UNION {
    ?subject a errc:Delta .
    VALUES (?property ?violation) {
      (errc:dimension "delta-dimension-missing")
      (errc:relation "delta-relation-missing")
      (errc:beforeValue "delta-before-missing")
      (errc:afterValue "delta-after-missing")
    }
    FILTER NOT EXISTS { ?subject ?property ?value }
  } UNION {
    ?subject a errc:Subject .
    VALUES (?property ?violation) {
      (errc:sourceRef "subject-ref-missing")
      (errc:identityStanding "subject-identity-standing-missing")
    }
    FILTER NOT EXISTS { ?subject ?property ?value }
  } UNION {
    ?subject a errc:DecisionReceipt .
    VALUES (?property ?violation) {
      (dcterms:identifier "receipt-id-missing")
      (errc:subject "receipt-subject-missing")
      (errc:decisionRule "receipt-rule-missing")
      (errc:bindsEvidence "receipt-evidence-missing")
      (errc:bindsRecommendation "receipt-recommendation-missing")
      (errc:replayMaterial "receipt-replay-material-missing")
      (errc:digestAlgorithm "receipt-digest-algorithm-missing")
      (errc:digest "receipt-digest-missing")
      (errc:replayCommand "receipt-replay-command-missing")
      (errc:falsifier "receipt-falsifier-missing")
      (errc:standing "receipt-standing-missing")
    }
    FILTER NOT EXISTS { ?subject ?property ?value }
  }
}
ORDER BY ?subject ?violation
