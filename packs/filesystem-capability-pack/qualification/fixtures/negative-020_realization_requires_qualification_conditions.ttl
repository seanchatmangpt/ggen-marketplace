# FIRES ONLY gates/020_realization_requires_qualification_conditions.rq:
# the realization of File.Stat states no fscap:qualificationCondition, so it
# admits itself (Generated != Admitted violation).
@prefix fscap:   <https://ggen.dev/ontology/filesystem-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

fscap:neg-stat a fscap:Capability ;
    dcterms:identifier "File.Stat" ;
    fscap:consequenceClass "READ" ;
    fscap:input "path" ;
    fscap:output "file-info" ;
    fscap:hasPrecondition fscap:precondition-path-safety ;
    fscap:hasOutcome fscap:outcome-success, fscap:failure-enoent, fscap:failure-eacces ;
    fscap:requiresEvidence "earl:request-receipt" ;
    fscap:requiresAuthority false ;
    fscap:idempotent true ;
    fscap:realizedBy fscap:neg-unconditioned-realization .

fscap:neg-unconditioned-realization a fscap:Realization ;
    dcterms:identifier "fixture.stat-step-unconditioned" .
