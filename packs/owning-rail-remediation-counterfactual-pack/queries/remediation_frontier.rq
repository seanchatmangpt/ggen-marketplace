PREFIX orc: <https://seanchatmangpt.github.io/ontology/owning-rail-remediation-counterfactual#>
SELECT ?r ?pre ?post ?propensity ?rollback WHERE {
  ?r a orc:Remediation ;
    orc:preBlockers ?pre ;
    orc:postBlockers ?post ;
    orc:propensity ?propensity ;
    orc:rollbackCost ?rollback .
}
ORDER BY (?post - ?pre) ?rollback
