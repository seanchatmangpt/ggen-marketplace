# G1 MESSAGE: design element without bot:containedIn storey.
# Every design element MUST belong to a storey via BOT containment.
# Each row is a refusal.
PREFIX bot: <https://w3id.org/bot#>
PREFIX cad: <https://seanchatmangpt.github.io/packs/industry-semantic-cad-bim#>

SELECT ?element WHERE {
  ?element a bot:Element .
  FILTER NOT EXISTS {
    ?element bot:containedIn ?storey .
    ?storey a bot:Storey .
  }
}
ORDER BY ?element
