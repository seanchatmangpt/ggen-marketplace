# G1 MESSAGE: design element with no bot:Storey membership.
# Every design element MUST belong to a storey via BOT element membership
# (storey -> element, bot:hasElement; BOT 0.3.x has no containedIn term).
# Each row is a refusal.
PREFIX bot: <https://w3id.org/bot#>
PREFIX cad: <https://seanchatmangpt.github.io/packs/industry-semantic-cad-bim#>

SELECT ?element WHERE {
  ?element a bot:Element .
  FILTER NOT EXISTS {
    ?storey a bot:Storey ;
            bot:hasElement ?element .
  }
}
ORDER BY ?element
