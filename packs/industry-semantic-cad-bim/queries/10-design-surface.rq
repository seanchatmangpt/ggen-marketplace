# Design surface for walkthrough rendering: elements with storey + geometry.
PREFIX bot: <https://w3id.org/bot#>
PREFIX cad: <https://seanchatmangpt.github.io/packs/industry-semantic-cad-bim#>

SELECT ?element ?storey ?geometry ?format WHERE {
  ?element a bot:Element ;
           bot:containedIn ?storey .
  ?storey a bot:Storey .
  OPTIONAL {
    ?element cad:hasGeometry ?geometry .
    ?geometry cad:geometryFormat ?format .
  }
}
ORDER BY ?storey ?element
