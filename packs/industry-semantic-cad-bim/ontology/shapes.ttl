# Static SHACL shapes for industry-semantic-cad-bim — the three refusal laws
# (mirrors gates/010,020,030 and templates/cad-shacl.ttl.tera). Consumed by
# runners/semantic_runner.py for the pass-witness SHACL leg.
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cad:  <https://seanchatmangpt.github.io/packs/industry-semantic-cad-bim#> .
@prefix bot:  <https://w3id.org/bot#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# G1: every element MUST have bot:hasElement membership from a bot:Storey
# (BOT 0.3.x direction: storey -> element; no containedIn term exists).
cad:G1-ElementStoreyContainmentShape a sh:NodeShape ;
    sh:targetClass bot:Element ;
    sh:property [
        sh:path [ sh:inversePath bot:hasElement ] ;
        sh:minCount 1 ;
        sh:class bot:Storey ;
        sh:message "design element without bot:hasElement storey membership" ;
    ] .

# G2: every revision MUST have a prov:wasRevisionOf predecessor — except root.
cad:G2-RevisionPredecessorShape a sh:NodeShape ;
    sh:targetClass cad:DesignRevision ;
    sh:not [
        sh:property [
            sh:path rdf:type ;
            sh:hasValue cad:RootRevision ;
        ] ;
    ] ;
    sh:property [
        sh:path prov:wasRevisionOf ;
        sh:minCount 1 ;
        sh:message "design revision without prov:wasRevisionOf predecessor (root exempt)" ;
    ] .

# G3: no orphan geometry — every geometry MUST be claimed by an element.
cad:G3-OrphanGeometryShape a sh:NodeShape ;
    sh:targetClass cad:Geometry ;
    sh:property [
        sh:path [ sh:inversePath cad:hasGeometry ] ;
        sh:minCount 1 ;
        sh:class bot:Element ;
        sh:message "orphan geometry: attachable to no element" ;
    ] .
