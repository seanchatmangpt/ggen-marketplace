# PASS witness G2: root exempt, every other revision has a predecessor; expect 0 rows.
# Lawful under ALL gates (exactly-one-law discipline): root sealed (G7), every
# revision attested (G5); no artifacts/geometry/AI contributions present.
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix cad:  <https://seanchatmangpt.github.io/packs/industry-semantic-cad-bim#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.invalid/cad/> .

ex:seal0 a cad:MerkleSeal ; cad:receiptDigest "" .

ex:act0 a cad:AttestedActivity ; cad:attestationFingerprint "sha256:aa" .
ex:act1 a cad:AttestedActivity ; cad:attestationFingerprint "sha256:bb" .
ex:act2 a cad:AttestedActivity ; cad:attestationFingerprint "sha256:cc" .

ex:rev0 a cad:DesignRevision, cad:RootRevision ;
    cad:revisionIndex 0 ;
    cad:sealedRoot ex:seal0 ;
    prov:wasGeneratedBy ex:act0 ;
    prov:generatedAtTime "2026-10-21T00:00:00Z"^^xsd:dateTime .

ex:rev1 a cad:DesignRevision ;
    cad:revisionIndex 1 ;
    prov:wasRevisionOf ex:rev0 ;
    prov:wasGeneratedBy ex:act1 ;
    prov:generatedAtTime "2026-10-21T01:00:00Z"^^xsd:dateTime .

ex:rev2 a cad:DesignRevision ;
    cad:revisionIndex 2 ;
    prov:wasRevisionOf ex:rev1 ;
    prov:wasGeneratedBy ex:act2 ;
    prov:generatedAtTime "2026-10-21T02:00:00Z"^^xsd:dateTime .
