# industry-semantic-cad-bim ontology.
# Spatial structure: BOT (Building Topology Ontology, w3id.org/bot).
# Revision chain: PROV-O (w3.org/ns/prov). cad: extends, never redeclares.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix cad:  <https://seanchatmangpt.github.io/packs/industry-semantic-cad-bim#> .
@prefix bot:  <https://w3id.org/bot#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://seanchatmangpt.github.io/packs/industry-semantic-cad-bim> a owl:Ontology ;
    rdfs:label "Semantic CAD/BIM design-revision ontology" ;
    rdfs:comment "Event-sourced temporal KG for building designs: BOT spatial structure, PROV-O revision chain. Rendered artifacts are projections; authority NONE." ;
    owl:imports <https://w3id.org/bot> , <http://www.w3.org/ns/prov#> ;
    rdfs:seeAlso <https://w3id.org/bot> , <https://www.w3.org/TR/prov-o/> .

## Design artifacts: the Blob WORM face (immutable design artifacts).
cad:DesignArtifact a rdfs:Class ;
    rdfs:label "Design artifact" ;
    rdfs:comment "Immutable content-addressed design artifact; stored in Blob under WORM immutability policy; the prov:Entity side of the design ledger." ;
    rdfs:subClassOf prov:Entity .

cad:artifactDigest a rdf:Property ;
    rdfs:label "artifact digest" ;
    rdfs:comment "Content digest of artifact bytes in Blob, e.g. sha256:... Identical bytes = identical digest." ;
    rdfs:domain cad:DesignArtifact ;
    rdfs:range xsd:string .

cad:blobUrl a rdf:Property ;
    rdfs:label "blob url" ;
    rdfs:comment "Loopback data-plane URL of the artifact in the Blob container." ;
    rdfs:domain cad:DesignArtifact ;
    rdfs:range xsd:string .

## Design revisions: the time-travel axis.
cad:DesignRevision a rdfs:Class ;
    rdfs:label "Design revision" ;
    rdfs:comment "A revision of the design graph. Non-root revisions MUST carry prov:wasRevisionOf to their predecessor; the root revision is typed cad:RootRevision and is exempt." ;
    rdfs:subClassOf prov:Entity .

cad:RootRevision a rdfs:Class ;
    rdfs:label "Root revision" ;
    rdfs:comment "The first revision in a chain; exempt from the predecessor gate." ;
    rdfs:subClassOf cad:DesignRevision .

cad:revisionIndex a rdf:Property ;
    rdfs:label "revision index" ;
    rdfs:comment "Monotone integer index of the revision in its chain (0 = root)." ;
    rdfs:domain cad:DesignRevision ;
    rdfs:range xsd:integer .

cad:revisionOfArtifact a rdf:Property ;
    rdfs:label "revision of artifact" ;
    rdfs:comment "The DesignArtifact this revision decodes from (Blob face)." ;
    rdfs:domain cad:DesignRevision ;
    rdfs:range cad:DesignArtifact .

## Geometry: never orphan.
cad:Geometry a rdfs:Class ;
    rdfs:label "Geometry" ;
    rdfs:comment "Decoded geometry payload. Every Geometry MUST be the object of cad:hasGeometry from some element (bot:Element or subclass); a Geometry attachable to no element is an orphan and is refused." ;
    rdfs:subClassOf prov:Entity .

cad:hasGeometry a rdf:Property ;
    rdfs:label "has geometry" ;
    rdfs:comment "Links a design element to its decoded geometry." ;
    rdfs:domain bot:Element ;
    rdfs:range cad:Geometry .

cad:geometryFormat a rdf:Property ;
    rdfs:label "geometry format" ;
    rdfs:comment "Decode format of the geometry payload, e.g. IFC-STEP, obj, gltf." ;
    rdfs:domain cad:Geometry ;
    rdfs:range xsd:string .

## Cosmos KG face: temporal documents, bitemporal versioning.
cad:kgDocument a rdf:Property ;
    rdfs:label "KG document" ;
    rdfs:comment "Cosmos document id holding the valid-time-bounded projection of this revision." ;
    rdfs:domain cad:DesignRevision ;
    rdfs:range xsd:string .

cad:validFrom a rdf:Property ;
    rdfs:label "valid from" ;
    rdfs:comment "Valid-time lower bound of the revision's KG documents." ;
    rdfs:domain cad:DesignRevision ;
    rdfs:range xsd:dateTime .

cad:validUntil a rdf:Property ;
    rdfs:label "valid until" ;
    rdfs:comment "Valid-time upper bound of the revision's KG documents; open when absent." ;
    rdfs:domain cad:DesignRevision ;
    rdfs:range xsd:dateTime .

## Bot supersedes nothing: BOT element membership is the storey-membership law
## (storey -> element, bot:hasElement; BOT 0.3.x defines no containedIn term).
## Refusal laws (enforced as gates + SHACL):
##   G1 every bot:Element is bot:hasElement-object of some bot:Storey
##   G2 every cad:DesignRevision has prov:wasRevisionOf some cad:DesignRevision,
##      except cad:RootRevision
##   G3 every cad:Geometry is cad:hasGeometry-object of some bot:Element
