PREFIX insa: <urn:insa-law:>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Project the eight-vow order law: one row per VowTransition, ordered by
# ordinal, with state labels and the typed refusal surfaced on failure.
SELECT ?ordinal ?fromState ?toState ?edgeFn ?receiptBinding ?refusalVariant ?fromLabel ?toLabel
WHERE {
  ?tx a insa:VowTransition ;
      insa:ordinal ?ordinal ;
      insa:fromState ?from ; insa:toState ?to ;
      insa:edgeFn ?edgeFn ;
      insa:receiptBinding ?receiptBinding ;
      insa:onRefusal ?err .
  ?from rdfs:label ?fromLabel .
  ?to rdfs:label ?toLabel .
  ?err insa:rustVariant ?refusalVariant .
  BIND(STRAFTER(STR(?from), "urn:insa-law:state-") AS ?fromState)
  BIND(STRAFTER(STR(?to), "urn:insa-law:state-") AS ?toState)
}
ORDER BY ?ordinal
