//! insa eight-vow order law — GENERATED by `ggen sync run` from the
//! `insa-law-pack` ontology. Do not edit by hand.
//!
//! Canonical projection of insa-replaw's sealed eight-vow typestate law:
//! VowEngine (eight_vow.rs L172-321) advances
//! Source -> Pattern -> Field -> Motion -> Receiver -> Fruit -> Receipt -> Rest;
//! each edge maps to one bridge fn (eight_vow_bridge.rs L129-544) and one
//! typed BridgeError refusal (eight_vow_bridge.rs L44-48).
//! Consumed by graphlaw's N3/LawState layer for vow-ordering checks.
//! Classification only: nothing here grants runtime actuation authority.

/// One lawful edge of the eight-vow typestate machine.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct VowOrderRow {
    /// 1-based position in the linear chain (no skips).
    pub ordinal: u8,
    /// From-state label (sealed VowState marker, eight_vow.rs L48-92).
    pub from_state: &'static str,
    /// To-state label.
    pub to_state: &'static str,
    /// Bridge edge function (eight_vow_bridge.rs L129-544).
    pub edge_fn: &'static str,
    /// VowRecord field whose closure condition gates the edge (L116-133).
    pub receipt_binding: &'static str,
    /// BridgeError variant surfaced when the edge's condition fails.
    pub refusal: &'static str,
}

/// The linear eight-vow order law: 8 rows, no gaps, no duplicates.
pub const VOW_ORDER: [VowOrderRow; 8] = [
{% for row in results %}    VowOrderRow {
        ordinal: {{ row.ordinal }},
        from_state: "{{ row.fromState }}",
        to_state: "{{ row.toState }}",
        edge_fn: "{{ row.edgeFn }}",
        receipt_binding: "{{ row.receiptBinding }}",
        refusal: "{{ row.refusalVariant }}",
    },
{% endfor %}];

/// The pinned typestate chain from the insa source, for the cross-check test
/// below. Provenance: insa-replaw/src/eight_vow.rs L172-321 (confirm_source,
/// verify_pattern, open_field, admit_motion, bind_receiver, actuate_fruit,
/// issue_receipt, seal) and eight_vow_bridge.rs L129-544.
pub const PINNED_CHAIN: [(&str, &str, &str); 8] = [
    ("1", "source", "pattern"),
    ("2", "pattern", "field"),
    ("3", "field", "motion"),
    ("4", "motion", "receiver"),
    ("5", "receiver", "fruit"),
    ("6", "fruit", "receipt"),
    ("7", "receipt", "rest"),
    ("8", "rest", "rest"),
];

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_exactly_8_rows() {
        assert_eq!(VOW_ORDER.len(), 8);
    }

    #[test]
    fn test_chain_matches_pinned_typestate_order() {
        // Cross-check hook: the projected table's chain equals the typestate
        // order of insa-replaw/src/eight_vow.rs (pinned in PINNED_CHAIN and
        // in pinned/insa_eight_vow_chain.txt with provenance header).
        assert_eq!(VOW_ORDER.len(), PINNED_CHAIN.len());
        for (row, (ord, from, to)) in VOW_ORDER.iter().zip(PINNED_CHAIN.iter()) {
            assert_eq!(row.ordinal.to_string(), *ord);
            assert_eq!(row.from_state, *from);
            assert_eq!(row.to_state, *to);
        }
    }

    #[test]
    fn test_linear_chain_no_gaps_or_duplicates() {
        let mut seen_from = std::collections::HashSet::new();
        for (i, row) in VOW_ORDER.iter().enumerate() {
            assert_eq!(row.ordinal as usize, i + 1, "no gaps");
            assert!(!seen_from.contains(row.edge_fn), "duplicate edge");
            seen_from.insert(row.edge_fn);
            if i + 1 < VOW_ORDER.len() {
                assert_eq!(row.to_state, VOW_ORDER[i + 1].from_state, "chain closure");
            }
        }
    }

    #[test]
    fn test_every_bridge_error_exercised() {
        let all = [
            "SourceRouteRejected",
            "AdmissionRefused",
            "FieldRegistrationFailed",
            "EpochExecutionFailed",
            "ReceiverObligationFailed",
            "FruitRoutingFailed",
            "LineageCommitFailed",
            "SealMismatch",
        ];
        for variant in all {
            assert!(
                VOW_ORDER.iter().any(|r| r.refusal == variant),
                "BridgeError::{variant} exercised by zero transitions"
            );
        }
    }
}
