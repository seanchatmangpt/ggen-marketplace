# MESSAGE: any returned row refuses manufacture. G1: exactly 8 VowTransition
# individuals exist (eight_vow.rs declares 8 states / 8 edges, L172-321).
PREFIX insa: <urn:insa-law:>
SELECT ?s ?problem WHERE {
  {
    SELECT (COUNT(DISTINCT ?tx) AS ?n) WHERE { ?tx a insa:VowTransition }
  }
  FILTER (?n != 8)
  BIND("transition-count-not-8" AS ?problem)
  BIND(insa:pack AS ?s)
}
