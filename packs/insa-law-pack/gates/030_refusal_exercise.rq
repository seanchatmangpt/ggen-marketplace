# MESSAGE: any returned row refuses manufacture. G3: every BridgeError variant
# (eight_vow_bridge.rs L44-48, 8 variants) is exercised by at least one
# VowTransition's onRefusal -- refusals are part of the law, not dead vocabulary.
PREFIX insa: <urn:insa-law:>
SELECT ?err ?problem WHERE {
  ?err a insa:BridgeError .
  FILTER NOT EXISTS { ?tx a insa:VowTransition ; insa:onRefusal ?err }
  BIND("bridge-error-exercised-by-zero-transitions" AS ?problem)
}
