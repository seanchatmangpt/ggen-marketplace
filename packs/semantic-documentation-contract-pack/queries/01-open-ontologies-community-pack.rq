PREFIX sd: <https://ggen.dev/ontology/semantic-documentation#>
SELECT ?pack_id ?pack_name ?pack_description ?pack_domain ?pack_url ?pack_format ?pack_maintainer ?pack_homepage ?pack_license WHERE {
  ?distribution a sd:OpenOntologiesDistribution ;
    sd:packId ?pack_id ;
    sd:packName ?pack_name ;
    sd:packDescription ?pack_description ;
    sd:packDomain ?pack_domain ;
    sd:packUrl ?pack_url ;
    sd:packFormat ?pack_format ;
    sd:packMaintainer ?pack_maintainer ;
    sd:packHomepage ?pack_homepage ;
    sd:packLicense ?pack_license .
}
ORDER BY ?pack_id
