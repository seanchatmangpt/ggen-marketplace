PREFIX sd: <https://ggen.dev/ontology/semantic-documentation#>
SELECT ?c4_profile ?diataxis_profile ?agent_context_profile WHERE {
  ?bundle a sd:ProjectionBundle ;
    sd:c4Profile ?c4 ;
    sd:diataxisProfile ?diataxis ;
    sd:agentContextProfile ?agent .
  ?c4 sd:projectionKind ?c4_profile .
  ?diataxis sd:projectionKind ?diataxis_profile .
  ?agent sd:projectionKind ?agent_context_profile .
}
ORDER BY ?c4_profile ?diataxis_profile ?agent_context_profile
