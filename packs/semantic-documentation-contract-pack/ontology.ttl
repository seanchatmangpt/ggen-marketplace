@prefix sd: <https://ggen.dev/ontology/semantic-documentation#> .
@prefix sp: <https://ggen.dev/ontology/semantic-projection#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Canonical semantic-documentation vocabulary. It deliberately reuses PROV-O
# for derivation and semantic-projection-pack terms for sovereignty/projection.
sd:SemanticDocumentationDataset a rdfs:Class .
sd:RevisionBoundSubject a rdfs:Class .
sd:SourceEvidence a rdfs:Class .
sd:DocumentationEvidence a rdfs:Class .
sd:AdmissionReceipt a rdfs:Class .
sd:ProjectionProfile a rdfs:Class .
sd:ProjectionBundle a rdfs:Class .
sd:OpenOntologiesDistribution a rdfs:Class .

# Compiler/documentation projection vocabulary consumed directly by Litho.
sd:RustItem a rdfs:Class ; rdfs:subClassOf sd:SourceEvidence .
sd:DocFragment a rdfs:Class ; rdfs:subClassOf sd:DocumentationEvidence .
sd:SourceSpan a rdfs:Class .
sd:DocumentationReference a rdfs:Class .
sd:DocumentationKind a rdfs:Class .
sd:RustdocMarkdown a sd:DocumentationKind ; sd:grantsDoAuthority false .

sd:repository a rdf:Property ; rdfs:range xsd:string .
sd:revision a rdf:Property ; rdfs:range xsd:string .
sd:sourceGraph a rdf:Property ; rdfs:range xsd:string .
sd:documentationGraph a rdf:Property ; rdfs:range xsd:string .
sd:extractor a rdf:Property ; rdfs:range xsd:string .
sd:rustdocFormatVersion a rdf:Property ; rdfs:range xsd:integer .
sd:hasEvidence a rdf:Property .
sd:documents a rdf:Property .
sd:hasAdmissionReceipt a rdf:Property .
sd:hasProjectionProfile a rdf:Property .
sd:evidenceKind a rdf:Property ; rdfs:range xsd:string .
sd:grantsDoAuthority a rdf:Property ; rdfs:range xsd:boolean .
sd:standing a rdf:Property ; rdfs:range xsd:string .
sd:validator a rdf:Property ; rdfs:range xsd:string .
sd:admitted a rdf:Property ; rdfs:range xsd:boolean .
sd:projectionKind a rdf:Property ; rdfs:range xsd:string .
sd:c4Profile a rdf:Property .
sd:diataxisProfile a rdf:Property .
sd:agentContextProfile a rdf:Property .

sd:rootItem a rdf:Property .
sd:localId a rdf:Property ; rdfs:range xsd:string .
sd:itemKind a rdf:Property ; rdfs:range xsd:string .
sd:visibility a rdf:Property ; rdfs:range xsd:string .
sd:name a rdf:Property ; rdfs:range xsd:string .
sd:fullyQualifiedPath a rdf:Property ; rdfs:range xsd:string .
sd:definedAt a rdf:Property ; rdfs:range sd:SourceSpan .
sd:sourceFile a rdf:Property ; rdfs:domain sd:SourceSpan ; rdfs:range xsd:string .
sd:startLine a rdf:Property ; rdfs:domain sd:SourceSpan ; rdfs:range xsd:integer .
sd:startColumn a rdf:Property ; rdfs:domain sd:SourceSpan ; rdfs:range xsd:integer .
sd:endLine a rdf:Property ; rdfs:domain sd:SourceSpan ; rdfs:range xsd:integer .
sd:endColumn a rdf:Property ; rdfs:domain sd:SourceSpan ; rdfs:range xsd:integer .
sd:references a rdf:Property .
sd:from a rdf:Property .
sd:to a rdf:Property .
sd:linkLabel a rdf:Property ; rdfs:range xsd:string .
sd:documentationKind a rdf:Property ; rdfs:range sd:DocumentationKind .

# Open Ontologies community-pack projection fields. These remain data; they
# grant no runtime authority and are not themselves a registry publication.
sd:packId a rdf:Property ; rdfs:range xsd:string .
sd:packName a rdf:Property ; rdfs:range xsd:string .
sd:packDescription a rdf:Property ; rdfs:range xsd:string .
sd:packDomain a rdf:Property ; rdfs:range xsd:string .
sd:packUrl a rdf:Property ; rdfs:range xsd:string .
sd:packFormat a rdf:Property ; rdfs:range xsd:string .
sd:packMaintainer a rdf:Property ; rdfs:range xsd:string .
sd:packHomepage a rdf:Property ; rdfs:range xsd:string .
sd:packLicense a rdf:Property ; rdfs:range xsd:string .

# Exact real candidate subject implemented in deepwiki-rs PR #1. This records
# only what exists at that immutable head: the semantic compiler implementation.
# Open Ontologies SHACL execution and ALIVE standing are intentionally not asserted.
sd:LithoSemanticDocumentationCompiler a sd:RevisionBoundSubject ;
    sd:repository "seanchatmangpt/deepwiki-rs" ;
    sd:revision "fc0f287ad5b1313965de2df64771af543dcb8a85" ;
    sd:grantsDoAuthority false .

sd:LithoSemanticDocumentationCandidate a sd:SemanticDocumentationDataset ;
    sd:repository "seanchatmangpt/deepwiki-rs" ;
    sd:revision "fc0f287ad5b1313965de2df64771af543dcb8a85" ;
    sd:sourceGraph "urn:litho:graph:source:fc0f287ad5b1313965de2df64771af543dcb8a85" ;
    sd:documentationGraph "urn:litho:graph:documentation:fc0f287ad5b1313965de2df64771af543dcb8a85" ;
    sd:extractor "rustdoc-json" ;
    sd:standing "PARTIAL_ALIVE" ;
    sd:grantsDoAuthority false ;
    sd:hasEvidence sd:LithoImplementationEvidence ;
    sd:hasAdmissionReceipt sd:OpenOntologiesAdmissionPending ;
    sd:hasProjectionProfile sd:C4Projection, sd:DiataxisProjection, sd:AgentContextProjection .

sd:LithoImplementationEvidence a sd:SourceEvidence ;
    dct:source "https://github.com/seanchatmangpt/deepwiki-rs/commit/fc0f287ad5b1313965de2df64771af543dcb8a85" ;
    sd:evidenceKind "semantic-compiler-implementation" ;
    prov:wasDerivedFrom sd:LithoSemanticDocumentationCompiler ;
    sd:grantsDoAuthority false .

sd:OpenOntologiesAdmissionPending a sd:AdmissionReceipt ;
    sd:validator "open-ontologies-shacl" ;
    sd:admitted false ;
    sd:standing "UNKNOWN" ;
    sd:grantsDoAuthority false .

sd:C4Projection a sd:ProjectionProfile ;
    sd:projectionKind "C4" ; sp:isSovereign false ; sd:grantsDoAuthority false .
sd:DiataxisProjection a sd:ProjectionProfile ;
    sd:projectionKind "Diataxis" ; sp:isSovereign false ; sd:grantsDoAuthority false .
sd:AgentContextProjection a sd:ProjectionProfile ;
    sd:projectionKind "agent-context" ; sp:isSovereign false ; sd:grantsDoAuthority false .

sd:DefaultProjectionBundle a sd:ProjectionBundle ;
    sd:c4Profile sd:C4Projection ;
    sd:diataxisProfile sd:DiataxisProjection ;
    sd:agentContextProfile sd:AgentContextProjection ;
    sd:grantsDoAuthority false .

# Registry-ready data projection for Open Ontologies. The URL points at the
# eventual canonical main-branch source and is not claimed published here.
sd:OpenOntologiesCommunityDistribution a sd:OpenOntologiesDistribution ;
    sd:packId "semantic-documentation-contract" ;
    sd:packName "Semantic Documentation Contract" ;
    sd:packDescription "Revision-bound RDF documentation contract with provenance, projection sovereignty, authority fencing, and admission standing." ;
    sd:packDomain "software" ;
    sd:packUrl "https://raw.githubusercontent.com/seanchatmangpt/ggen-marketplace/main/packs/semantic-documentation-contract-pack/ontology.ttl" ;
    sd:packFormat "turtle" ;
    sd:packMaintainer "@seanchatmangpt" ;
    sd:packHomepage "https://github.com/seanchatmangpt/ggen-marketplace/tree/main/packs/semantic-documentation-contract-pack" ;
    sd:packLicense "MIT" ;
    sd:grantsDoAuthority false .
