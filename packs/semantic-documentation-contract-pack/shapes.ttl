@prefix sd: <https://ggen.dev/ontology/semantic-documentation#> .
@prefix sp: <https://ggen.dev/ontology/semantic-projection#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Portable SHACL companion for Open Ontologies and other validators. Native
# marketplace gates remain the repository qualification boundary.
sd:SemanticDocumentationDatasetShape a sh:NodeShape ;
    sh:targetClass sd:SemanticDocumentationDataset ;
    sh:property [ sh:path sd:repository ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path sd:revision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 7 ] ;
    sh:property [ sh:path sd:sourceGraph ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sd:documentationGraph ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sd:grantsDoAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] .

sd:SourceEvidenceShape a sh:NodeShape ;
    sh:targetClass sd:SourceEvidence ;
    sh:property [ sh:path dct:source ; sh:minCount 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ] ;
    sh:property [ sh:path sd:grantsDoAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] .

sd:DocumentationEvidenceShape a sh:NodeShape ;
    sh:targetClass sd:DocumentationEvidence ;
    sh:property [ sh:path sd:documents ; sh:minCount 1 ] ;
    sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ] ;
    sh:property [ sh:path sd:grantsDoAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] .

sd:ProjectionProfileShape a sh:NodeShape ;
    sh:targetClass sd:ProjectionProfile ;
    sh:property [ sh:path sd:projectionKind ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sp:isSovereign ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] ;
    sh:property [ sh:path sd:grantsDoAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] .

sd:AdmissionReceiptShape a sh:NodeShape ;
    sh:targetClass sd:AdmissionReceipt ;
    sh:property [ sh:path sd:validator ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sd:admitted ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path sd:standing ; sh:minCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path sd:grantsDoAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] .
