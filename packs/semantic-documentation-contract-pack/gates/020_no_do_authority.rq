PREFIX sd: <https://ggen.dev/ontology/semantic-documentation#>
SELECT ?thing ?reason WHERE {
  VALUES ?type {
    sd:SemanticDocumentationDataset
    sd:RevisionBoundSubject
    sd:SourceEvidence
    sd:DocumentationEvidence
    sd:AdmissionReceipt
    sd:ProjectionProfile
    sd:ProjectionBundle
    sd:OpenOntologiesDistribution
    sd:SourceSpan
    sd:DocumentationReference
    sd:DocumentationKind
  }
  ?thing a ?type .
  {
    ?thing sd:grantsDoAuthority true .
    BIND("semantic documentation must never grant DO authority" AS ?reason)
  }
  UNION
  {
    FILTER NOT EXISTS { ?thing sd:grantsDoAuthority false }
    BIND("missing explicit no-DO authority fence" AS ?reason)
  }
}
ORDER BY ?thing ?reason
