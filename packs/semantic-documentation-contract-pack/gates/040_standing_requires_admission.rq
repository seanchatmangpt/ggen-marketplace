PREFIX sd: <https://ggen.dev/ontology/semantic-documentation#>
SELECT ?thing ?reason WHERE {
  {
    ?thing a sd:AdmissionReceipt ; sd:standing "ALIVE" .
    FILTER NOT EXISTS { ?thing sd:admitted true }
    BIND("ALIVE admission receipt lacks admitted=true" AS ?reason)
  }
  UNION
  {
    ?dataset a sd:SemanticDocumentationDataset ; sd:standing "ALIVE" ; sd:hasAdmissionReceipt ?thing .
    FILTER NOT EXISTS { ?thing sd:admitted true }
    BIND("ALIVE dataset lacks admitted receipt" AS ?reason)
  }
  UNION
  {
    ?dataset a sd:SemanticDocumentationDataset ; sd:standing "ALIVE" .
    FILTER NOT EXISTS { ?dataset sd:hasAdmissionReceipt ?thing }
    BIND("ALIVE dataset lacks admission receipt link" AS ?reason)
  }
}
ORDER BY ?thing ?reason
