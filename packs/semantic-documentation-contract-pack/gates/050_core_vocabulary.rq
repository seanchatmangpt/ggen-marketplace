PREFIX sd: <https://ggen.dev/ontology/semantic-documentation#>
SELECT ?term WHERE {
  VALUES ?term {
    sd:SemanticDocumentationDataset sd:RevisionBoundSubject
    sd:SourceEvidence sd:DocumentationEvidence sd:AdmissionReceipt
    sd:ProjectionProfile sd:ProjectionBundle sd:OpenOntologiesDistribution
    sd:RustItem sd:DocFragment sd:SourceSpan sd:DocumentationReference
    sd:DocumentationKind sd:RustdocMarkdown
    sd:repository sd:revision sd:sourceGraph sd:documentationGraph
    sd:extractor sd:rustdocFormatVersion sd:hasEvidence sd:documents
    sd:grantsDoAuthority sd:standing sd:rootItem sd:localId sd:itemKind
    sd:visibility sd:name sd:fullyQualifiedPath sd:definedAt sd:sourceFile
    sd:startLine sd:startColumn sd:endLine sd:endColumn sd:references
    sd:from sd:to sd:linkLabel sd:documentationKind
  }
  FILTER NOT EXISTS { ?term ?predicate ?object }
}
ORDER BY ?term
