@prefix sd: <https://ggen.dev/ontology/semantic-documentation#> .
@prefix sp: <https://ggen.dev/ontology/semantic-projection#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .

# Independent positive consumer fixture used by the repository-native semantic
# qualification court. It exercises exact identity, evidence lineage,
# non-sovereign projections, pending admission, and no-DO authority.
sd:ConsumerSubject a sd:RevisionBoundSubject ;
    sd:repository "example/consumer" ;
    sd:revision "0123456789abcdef" ;
    sd:grantsDoAuthority false .

sd:ConsumerDataset a sd:SemanticDocumentationDataset ;
    sd:repository "example/consumer" ;
    sd:revision "0123456789abcdef" ;
    sd:sourceGraph "urn:example:source:0123456789abcdef" ;
    sd:documentationGraph "urn:example:docs:0123456789abcdef" ;
    sd:extractor "compiler-ir" ;
    sd:standing "PARTIAL_ALIVE" ;
    sd:grantsDoAuthority false ;
    sd:hasEvidence sd:ConsumerSourceEvidence ;
    sd:hasAdmissionReceipt sd:ConsumerAdmissionPending ;
    sd:hasProjectionProfile sd:ConsumerProjection .

sd:ConsumerSourceEvidence a sd:SourceEvidence ;
    dct:source "swh:1:rev:0123456789abcdef" ;
    prov:wasDerivedFrom sd:ConsumerSubject ;
    sd:evidenceKind "compiler-source" ;
    sd:grantsDoAuthority false .

sd:ConsumerProjection a sd:ProjectionProfile ;
    sd:projectionKind "reference" ;
    sp:isSovereign false ;
    sd:grantsDoAuthority false .

sd:ConsumerAdmissionPending a sd:AdmissionReceipt ;
    sd:validator "open-ontologies" ;
    sd:admitted false ;
    sd:standing "UNKNOWN" ;
    sd:grantsDoAuthority false .
