@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# These are pure process/observation records. They define no bpma:AdmittedActuation
# and therefore cannot create repository, deploy, publish, communicate, or spend.

bpm:frontier_source_release_rt a bpm:RecordType ;
    bpm:recordName "frontier_source_release" ;
    bpm:recordDoc "Observed external frontier announcement with provenance and extracted-claim payload; observation only, never authority." ;
    bpm:hasField bpm:frontier_source_release_source_url_f ,
                 bpm:frontier_source_release_publisher_f ,
                 bpm:frontier_source_release_published_at_f ,
                 bpm:frontier_source_release_content_digest_f ,
                 bpm:frontier_source_release_claims_f .

bpm:frontier_source_release_source_url_f a bpm:Field ;
    bpm:fieldName "source_url" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Canonical external source URL." ; bpm:fieldRequired "true" ; bpm:fieldOrder 1 .
bpm:frontier_source_release_publisher_f a bpm:Field ;
    bpm:fieldName "publisher" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Observed publisher identity." ; bpm:fieldRequired "true" ; bpm:fieldOrder 2 .
bpm:frontier_source_release_published_at_f a bpm:Field ;
    bpm:fieldName "published_at" ; bpm:fieldType "datetime" ;
    bpm:fieldDoc "Observed publication timestamp." ; bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
bpm:frontier_source_release_content_digest_f a bpm:Field ;
    bpm:fieldName "content_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Exact digest of the admitted source representation." ; bpm:fieldRequired "true" ; bpm:fieldOrder 4 .
bpm:frontier_source_release_claims_f a bpm:Field ;
    bpm:fieldName "claims" ; bpm:fieldType "map" ;
    bpm:fieldDoc "Normalized observed claims; candidate semantic extraction, not execution evidence." ; bpm:fieldRequired "true" ; bpm:fieldOrder 5 .

bpm:frontier_opportunity_rt a bpm:RecordType ;
    bpm:recordName "frontier_opportunity" ;
    bpm:recordDoc "DfCM-selected bounded response opportunity derived from an observed release." ;
    bpm:hasField bpm:frontier_opportunity_source_digest_f ,
                 bpm:frontier_opportunity_response_mode_f ,
                 bpm:frontier_opportunity_target_repository_f ,
                 bpm:frontier_opportunity_required_capability_f ,
                 bpm:frontier_opportunity_benchmark_id_f .

bpm:frontier_opportunity_source_digest_f a bpm:Field ;
    bpm:fieldName "source_digest" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Digest linking this opportunity to its observed source release." ; bpm:fieldRequired "true" ; bpm:fieldOrder 1 .
bpm:frontier_opportunity_response_mode_f a bpm:Field ;
    bpm:fieldName "response_mode" ; bpm:fieldType "atom" ;
    bpm:fieldDoc "One of reuse, compose, extend, invent, benchmark, formalize, automate, eliminate." ; bpm:fieldRequired "true" ; bpm:fieldOrder 2 .
bpm:frontier_opportunity_target_repository_f a bpm:Field ;
    bpm:fieldName "target_repository" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Repository coordinate selected for implementation; selection confers no DO authority." ; bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
bpm:frontier_opportunity_required_capability_f a bpm:Field ;
    bpm:fieldName "required_capability" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Capability the response must manufacture or prove." ; bpm:fieldRequired "true" ; bpm:fieldOrder 4 .
bpm:frontier_opportunity_benchmark_id_f a bpm:Field ;
    bpm:fieldName "benchmark_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Executable benchmark identity." ; bpm:fieldRequired "true" ; bpm:fieldOrder 5 .

bpm:frontier_benchmark_rt a bpm:RecordType ;
    bpm:recordName "frontier_benchmark" ;
    bpm:recordDoc "Executable comparison contract produced from a frontier announcement." ;
    bpm:hasField bpm:frontier_benchmark_benchmark_id_f ,
                 bpm:frontier_benchmark_metric_f ,
                 bpm:frontier_benchmark_acceptance_f ,
                 bpm:frontier_benchmark_falsifier_f .

bpm:frontier_benchmark_benchmark_id_f a bpm:Field ;
    bpm:fieldName "benchmark_id" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Stable benchmark identity." ; bpm:fieldRequired "true" ; bpm:fieldOrder 1 .
bpm:frontier_benchmark_metric_f a bpm:Field ;
    bpm:fieldName "metric" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Measured comparison quantity." ; bpm:fieldRequired "true" ; bpm:fieldOrder 2 .
bpm:frontier_benchmark_acceptance_f a bpm:Field ;
    bpm:fieldName "acceptance_predicate" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Predicate that must be observed before the claim can be earned." ; bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
bpm:frontier_benchmark_falsifier_f a bpm:Field ;
    bpm:fieldName "falsifier" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Observation that defeats the benchmark claim." ; bpm:fieldRequired "true" ; bpm:fieldOrder 4 .

bpm:frontier_evidence_rt a bpm:RecordType ;
    bpm:recordName "frontier_evidence" ;
    bpm:recordDoc "Exact-subject verifier/replay evidence supporting an earned frontier-response claim." ;
    bpm:hasField bpm:frontier_evidence_subject_identity_f ,
                 bpm:frontier_evidence_verifier_identity_f ,
                 bpm:frontier_evidence_receipt_ref_f ,
                 bpm:frontier_evidence_replay_ref_f ,
                 bpm:frontier_evidence_standing_f .

bpm:frontier_evidence_subject_identity_f a bpm:Field ;
    bpm:fieldName "subject_identity" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Exact implementation subject, normally repository plus commit/digest." ; bpm:fieldRequired "true" ; bpm:fieldOrder 1 .
bpm:frontier_evidence_verifier_identity_f a bpm:Field ;
    bpm:fieldName "verifier_identity" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Exact verifier identity." ; bpm:fieldRequired "true" ; bpm:fieldOrder 2 .
bpm:frontier_evidence_receipt_ref_f a bpm:Field ;
    bpm:fieldName "receipt_ref" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Execution receipt reference." ; bpm:fieldRequired "true" ; bpm:fieldOrder 3 .
bpm:frontier_evidence_replay_ref_f a bpm:Field ;
    bpm:fieldName "replay_ref" ; bpm:fieldType "string" ;
    bpm:fieldDoc "Replay-verification reference." ; bpm:fieldRequired "true" ; bpm:fieldOrder 4 .
bpm:frontier_evidence_standing_f a bpm:Field ;
    bpm:fieldName "standing" ; bpm:fieldType "atom" ;
    bpm:fieldDoc "Bounded standing; publication consumers must require ALIVE for an earned claim." ; bpm:fieldRequired "true" ; bpm:fieldOrder 5 .
