{
  "schema": "ggen.counterfactual-frontier/1",
  "authority": "SELECT|CONSTRUCT|VERIFY",
  "actuation_performed": false,
  "frontier": [
  {% for row in results %}{"candidate":"{{ row.candidate }}","reversibility":{{ row.reversibility }},"expected_reuse":{{ row.reuse }},"expected_capability_space_delta":{{ row.delta }}}{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
