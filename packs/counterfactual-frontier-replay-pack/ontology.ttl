cfr:Candidate a prov:Entity .
cfr:Composition a prov:Entity .
cfr:Qualification a prov:Entity .
cfr:Replay a prov:Activity .
cfr:Frontier a skos:ConceptScheme .
cfr:OptionCapitalQuality a dqv:Dimension .

cfr:candidateA a cfr:Candidate ; cfr:capability "fanout-realization" ; cfr:repository "seanchatmangpt/ggen-marketplace" ; cfr:reversibility 1.0 ; cfr:expectedReuse 0.90 ; cfr:expectedCapabilitySpaceDelta 4.0 ; cfr:qualified true ; cfr:standing "PARTIAL_ALIVE" ; cfr:current true ; cfr:authority "VERIFY" ; cfr:actuationPerformed false ; cfr:receiptDigest "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" .
cfr:candidateB a cfr:Candidate ; cfr:capability "rebloom-convergence" ; cfr:repository "seanchatmangpt/ggen-marketplace" ; cfr:reversibility 0.95 ; cfr:expectedReuse 0.85 ; cfr:expectedCapabilitySpaceDelta 3.0 ; cfr:qualified true ; cfr:standing "PARTIAL_ALIVE" ; cfr:current true ; cfr:authority "VERIFY" ; cfr:actuationPerformed false ; cfr:receiptDigest "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" .
cfr:candidateC a cfr:Candidate ; cfr:capability "marketplace-pack" ; cfr:repository "seanchatmangpt/ggen-marketplace" ; cfr:reversibility 1.0 ; cfr:expectedReuse 1.0 ; cfr:expectedCapabilitySpaceDelta 5.0 ; cfr:qualified true ; cfr:standing "PARTIAL_ALIVE" ; cfr:current true ; cfr:authority "CONSTRUCT" ; cfr:actuationPerformed false ; cfr:receiptDigest "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" .

cfr:compositionAB a cfr:Composition ; cfr:member cfr:candidateA, cfr:candidateB ; cfr:order 2 ; cfr:branchingFactor 2 ; cfr:replayKey "ab-r24" ; cfr:qualified true .
cfr:compositionABC a cfr:Composition ; cfr:member cfr:candidateA, cfr:candidateB, cfr:candidateC ; cfr:order 3 ; cfr:branchingFactor 3 ; cfr:replayKey "abc-r24" ; cfr:qualified true .

cfr:controller cfr:authority "SELECT|CONSTRUCT|VERIFY" ; cfr:actuationPerformed false ; cfr:requiresCurrentEvidence true ; cfr:requiresReceipt true ; cfr:preserveParetoFrontier true ; cfr:zeroUnreceiptedActuation true .
