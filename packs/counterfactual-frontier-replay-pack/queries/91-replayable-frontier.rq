PREFIX cfr: <https://ggen.dev/ontology/counterfactual-frontier-replay#>
SELECT ?candidate ?receipt ?authority WHERE {
  ?candidate a cfr:Candidate ; cfr:qualified true ; cfr:current true ; cfr:receiptDigest ?receipt ; cfr:authority ?authority ; cfr:actuationPerformed false .
  FILTER(STRLEN(STR(?receipt)) = 64 && ?authority != "DO")
}
ORDER BY ?candidate
