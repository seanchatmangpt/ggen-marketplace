PREFIX cfr: <https://ggen.dev/ontology/counterfactual-frontier-replay#>
SELECT ?candidate ?other WHERE {
  ?candidate a cfr:Candidate ; cfr:reversibility ?r ; cfr:expectedReuse ?u ; cfr:expectedCapabilitySpaceDelta ?d .
  ?other a cfr:Candidate ; cfr:reversibility ?r2 ; cfr:expectedReuse ?u2 ; cfr:expectedCapabilitySpaceDelta ?d2 .
  FILTER(?candidate != ?other && ?r2 >= ?r && ?u2 >= ?u && ?d2 >= ?d && (?r2 > ?r || ?u2 > ?u || ?d2 > ?d))
}
ORDER BY ?candidate ?other
