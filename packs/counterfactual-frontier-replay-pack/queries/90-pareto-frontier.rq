PREFIX cfr: <https://ggen.dev/ontology/counterfactual-frontier-replay#>
SELECT ?candidate ?reversibility ?reuse ?delta WHERE {
  ?candidate a cfr:Candidate ; cfr:reversibility ?reversibility ; cfr:expectedReuse ?reuse ; cfr:expectedCapabilitySpaceDelta ?delta ; cfr:qualified true ; cfr:current true ; cfr:actuationPerformed false .
  FILTER NOT EXISTS {
    ?other a cfr:Candidate ; cfr:reversibility ?r2 ; cfr:expectedReuse ?u2 ; cfr:expectedCapabilitySpaceDelta ?d2 ; cfr:qualified true ; cfr:current true ; cfr:actuationPerformed false .
    FILTER(?other != ?candidate && ?r2 >= ?reversibility && ?u2 >= ?reuse && ?d2 >= ?delta && (?r2 > ?reversibility || ?u2 > ?reuse || ?d2 > ?delta))
  }
}
ORDER BY DESC(?delta) DESC(?reuse) DESC(?reversibility) ?candidate
