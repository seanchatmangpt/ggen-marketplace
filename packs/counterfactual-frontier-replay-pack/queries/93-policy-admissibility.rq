PREFIX cfr: <https://ggen.dev/ontology/counterfactual-frontier-replay#>
SELECT ?candidate ?authority ?standing WHERE {
  ?candidate a cfr:Candidate ; cfr:authority ?authority ; cfr:standing ?standing ; cfr:qualified true ; cfr:current true ; cfr:actuationPerformed false .
  FILTER(?authority != "DO")
}
ORDER BY ?authority ?candidate
