PREFIX cfr: <https://ggen.dev/ontology/counterfactual-frontier-replay#>
SELECT ?composition ?order ?branching WHERE {
  ?composition a cfr:Composition ; cfr:order ?order ; cfr:branchingFactor ?branching ; cfr:qualified true .
  FILTER(?order >= 2 && ?branching >= 2)
}
ORDER BY DESC(?branching) DESC(?order) ?composition
