PREFIX cfr: <https://ggen.dev/ontology/counterfactual-frontier-replay#>
SELECT ?candidate ?repository ?standing WHERE {
  ?candidate a cfr:Candidate ; cfr:repository ?repository ; cfr:standing ?standing ; cfr:qualified true ; cfr:current true ; cfr:actuationPerformed false .
  FILTER(?standing = "ALIVE" || ?standing = "PARTIAL_ALIVE")
}
ORDER BY ?repository ?candidate
