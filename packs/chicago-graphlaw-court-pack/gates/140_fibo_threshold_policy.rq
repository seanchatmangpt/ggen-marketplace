# ASK true = violation (gate refuses). Evaluated over ontology.ttl + cases/*.ttl.
PREFIX cc: <https://chicago.graphlaw.dev/court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  { cc:fibo_court cc:thresholdMicros ?t . FILTER(?t != 10000000000000) }
  UNION
  { FILTER NOT EXISTS { cc:fibo_court cc:thresholdMicros ?x } }
}
