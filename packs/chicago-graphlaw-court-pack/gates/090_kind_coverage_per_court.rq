# ASK true = violation (gate refuses). Evaluated over ontology.ttl + cases/*.ttl.
PREFIX cc: <https://chicago.graphlaw.dev/court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  ?court a cc:Court .
  VALUES ?k { "positive" "negative" "invariance" "cross-authority" "boundary-mutation" }
  FILTER NOT EXISTS { ?c cc:court ?court ; cc:kind ?k . }
}
