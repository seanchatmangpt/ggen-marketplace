# ASK true = violation (gate refuses). Evaluated over ontology.ttl + cases/*.ttl.
PREFIX cc: <https://chicago.graphlaw.dev/court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  ?c a cc:Case .
  { VALUES ?p { cc:court cc:caseId cc:ordinal cc:kind cc:title cc:op cc:request cc:expect cc:coversAxiom cc:ceiling }
    FILTER NOT EXISTS { ?c ?p ?v } }
  UNION
  { ?c cc:court ?ct . FILTER NOT EXISTS { ?ct a cc:Court } }
}
