# ASK true = violation (gate refuses). Evaluated over ontology.ttl + cases/*.ttl.
PREFIX cc: <https://chicago.graphlaw.dev/court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  { ?c cc:court cc:cross_authority_court ; cc:ordinal ?o . FILTER(?o < 1 || ?o > 499) }
  UNION
  { ?c cc:court cc:fibo_court ; cc:ordinal ?o . FILTER(?o < 500 || ?o > 999) }
}
