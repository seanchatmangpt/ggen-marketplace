# ASK true = violation (gate refuses). Evaluated over ontology.ttl + cases/*.ttl.
PREFIX cc: <https://chicago.graphlaw.dev/court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  ?c a cc:Case ; cc:kind ?k .
  FILTER NOT EXISTS {
    VALUES (?k2 ?cls) { ("positive" cc:PositiveCase) ("negative" cc:NegativeCase) ("invariance" cc:InvarianceCase)
                        ("cross-authority" cc:CrossAuthorityCase) ("boundary-mutation" cc:BoundaryMutationCase) }
    FILTER(STR(?k) = ?k2)
    ?c a ?cls .
  }
}
