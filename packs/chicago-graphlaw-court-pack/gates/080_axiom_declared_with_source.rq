# ASK true = violation (gate refuses). Evaluated over ontology.ttl + cases/*.ttl.
PREFIX cc: <https://chicago.graphlaw.dev/court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  { ?c cc:coversAxiom ?ax . FILTER NOT EXISTS { ?ax a cc:Axiom } }
  UNION
  { ?ax a cc:Axiom . FILTER NOT EXISTS { ?ax cc:source ?s . FILTER(STRLEN(STR(?s)) > 0) } }
}
