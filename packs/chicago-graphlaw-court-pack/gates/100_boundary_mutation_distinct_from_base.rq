# ASK true = violation (gate refuses). Evaluated over ontology.ttl + cases/*.ttl.
PREFIX cc: <https://chicago.graphlaw.dev/court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  ?c cc:kind "boundary-mutation" .
  { FILTER NOT EXISTS { ?c cc:mutates ?b } }
  UNION
  { ?c cc:mutates ?b . FILTER NOT EXISTS { ?b a cc:Case } }
  UNION
  { ?c cc:mutates ?b ; cc:expect ?e . ?b cc:expect ?e2 . FILTER(STR(?e) = STR(?e2)) }
}
