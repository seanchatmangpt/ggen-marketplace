# ASK true = violation (gate refuses). Evaluated over ontology.ttl + cases/*.ttl.
PREFIX cc: <https://chicago.graphlaw.dev/court#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
  { ?c cc:compare ?x . FILTER NOT EXISTS { ?c cc:requestB ?b } }
  UNION
  { ?c cc:requestB ?b . FILTER NOT EXISTS { ?c cc:compare ?x } }
}
