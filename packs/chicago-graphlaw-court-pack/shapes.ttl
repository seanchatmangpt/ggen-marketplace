@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix cc:  <https://chicago.graphlaw.dev/court#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cc:CourtShape a sh:NodeShape ;
  sh:targetClass cc:Court ;
  sh:property [ sh:path cc:courtId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cc:testFile ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^tests/[a-z0-9_]+\\.rs$" ] ;
  sh:property [ sh:path cc:authority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "NONE" ] ;
  sh:property [ sh:path cc:consequence ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "EVIDENCE_ONLY" ] ;
  sh:property [ sh:path cc:standing ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

cc:FiboCourtShape a sh:NodeShape ;
  sh:targetNode cc:fibo_court ;
  sh:property [ sh:path cc:thresholdMicros ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:integer ; sh:hasValue 10000000000000 ] .

cc:CaseShape a sh:NodeShape ;
  sh:targetClass cc:Case ;
  sh:property [ sh:path cc:court ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cc:Court ] ;
  sh:property [ sh:path cc:caseId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                sh:pattern "^[a-z][a-z0-9_]{2,63}$" ] ;
  sh:property [ sh:path cc:ordinal ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 999 ] ;
  sh:property [ sh:path cc:kind ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:in ( "positive" "negative" "invariance" "cross-authority" "boundary-mutation" ) ] ;
  sh:property [ sh:path cc:title ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cc:op ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cc:request ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cc:expect ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cc:requestB ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cc:expectB ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cc:compare ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path cc:byteIdentity ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path cc:mutates ; sh:maxCount 1 ; sh:class cc:Case ] ;
  sh:property [ sh:path cc:coversAxiom ; sh:minCount 1 ; sh:class cc:Axiom ] ;
  sh:property [ sh:path cc:ceiling ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "observe" "select" "construct" ) ] .

cc:AxiomShape a sh:NodeShape ;
  sh:targetClass cc:Axiom ;
  sh:property [ sh:path cc:source ; sh:minCount 1 ; sh:datatype xsd:string ] .
