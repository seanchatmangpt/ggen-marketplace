@prefix cc: <https://chicago.graphlaw.dev/court#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cc:ax_min a cc:Axiom ; cc:source "verify/fixtures: synthetic self-proof axiom" .

cc:case_xa_pos a cc:PositiveCase, cc:Case ;
  cc:court cc:cross_authority_court ; cc:caseId "xa_pos" ; cc:ordinal 1 ;
  cc:kind "positive" ; cc:title "min fixture positive" ; cc:op "n3" ;
  cc:request "{\"op\": \"n3\", \"text\": \"@prefix : <urn:x:> .\\n:a :p :b .\\n{ ?x :p ?y } => { ?y :q ?x } .\"}" ;
  cc:expect "[{\"ptr\": \"/ok\", \"eq\": true}, {\"ptr\": \"/derived\", \"contains\": \":b :q :a\"}]" ;
  cc:coversAxiom cc:ax_min ; cc:ceiling "observe" .

cc:case_xa_neg a cc:NegativeCase, cc:Case ;
  cc:court cc:cross_authority_court ; cc:caseId "xa_neg" ; cc:ordinal 2 ;
  cc:kind "negative" ; cc:title "min fixture negative" ; cc:op "n3" ;
  cc:request "{\"op\": \"n3\", \"text\": \"{ ?x a } =>\"}" ;
  cc:expect "[{\"ptr\": \"/ok\", \"eq\": false}]" ;
  cc:coversAxiom cc:ax_min ; cc:ceiling "observe" .

cc:case_xa_inv a cc:InvarianceCase, cc:Case ;
  cc:court cc:cross_authority_court ; cc:caseId "xa_inv" ; cc:ordinal 3 ;
  cc:kind "invariance" ; cc:title "min fixture invariance" ; cc:op "n3" ;
  cc:request "{\"op\": \"n3\", \"text\": \"@prefix : <urn:x:> .\\n:a :p :b .\\n{ ?x :p ?y } => { ?y :q ?x } .\"}" ;
  cc:expect "[{\"ptr\": \"/ok\", \"eq\": true}, {\"ptr\": \"/derived\", \"contains\": \":b :q :a\"}]" ;
  cc:coversAxiom cc:ax_min ; cc:ceiling "observe" ;
  cc:requestB "{\"op\": \"n3\", \"text\": \"@prefix : <urn:x:> .\\n:a :p :b .\\n{ ?x :p ?y } => { ?y :q ?x } .\"}" ;
  cc:expectB "[{\"ptr\": \"/ok\", \"eq\": true}, {\"ptr\": \"/derived\", \"contains\": \":b :q :a\"}]" ;
  cc:compare "[{\"a\": \"/derived\", \"rel\": \"eq\", \"b\": \"/derived\"}]" .

cc:case_xa_xa a cc:CrossAuthorityCase, cc:Case ;
  cc:court cc:cross_authority_court ; cc:caseId "xa_xa" ; cc:ordinal 4 ;
  cc:kind "cross-authority" ; cc:title "min fixture cross-authority" ; cc:op "n3" ;
  cc:request "{\"op\": \"n3\", \"text\": \"@prefix : <urn:x:> .\\n:a :p :b .\\n{ ?x :p ?y } => { ?y :q ?x } .\"}" ;
  cc:expect "[{\"ptr\": \"/ok\", \"eq\": true}, {\"ptr\": \"/derived\", \"contains\": \":b :q :a\"}]" ;
  cc:coversAxiom cc:ax_min ; cc:ceiling "observe" ;
  cc:requestB "{\"op\": \"n3\", \"text\": \"@prefix : <urn:x:> .\\n:a :p :b .\\n{ ?x :p ?y } => { ?y :q ?x } .\"}" ;
  cc:compare "[{\"a\": \"/derived\", \"rel\": \"eq\", \"b\": \"/derived\"}]" .

cc:case_xa_mut a cc:BoundaryMutationCase, cc:Case ;
  cc:court cc:cross_authority_court ; cc:caseId "xa_mut" ; cc:ordinal 5 ;
  cc:kind "boundary-mutation" ; cc:title "min fixture boundary-mutation" ; cc:op "n3" ;
  cc:request "{\"op\": \"n3\", \"text\": \"@prefix : <urn:x:> .\\n:a :p :b .\"}" ;
  cc:expect "[{\"ptr\": \"/ok\", \"eq\": true}, {\"ptr\": \"/derived\", \"eq\": \"\"}]" ;
  cc:coversAxiom cc:ax_min ; cc:ceiling "observe" ;
  cc:mutates cc:case_xa_pos .

