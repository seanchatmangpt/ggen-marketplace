    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/nquads\",\"contains\":\"<https://chicago.graphlaw.dev/fin/id#tx-eur-20m> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://chicago.graphlaw.dev/fin#HighValueTransaction> .\"}]" ;
    cc:coversAxiom cc:ax_fin_fx_admitted_rate, cc:ax_fin_threshold_inclusive ;
