    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_usd_25m.ttl\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":1000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":false},{\"ptr\":\"/error/kind\",\"eq\":\"EngineRejected\"},{\"ptr\":\"/error/details/code\",\"eq\":\"LeaseRefused\"},{\"ptr\":\"/error/details/reason\",\"eq\":\"expired\"},{\"ptr\":\"/error/details/step\",\"eq\":\"derive:n3\"},{\"ptr\":\"/error/details/lease_id\",\"eq\":\"lease-fin-1\"}]" ;
    cc:coversAxiom cc:ax_fin_plan_not_authority ;
    cc:ceiling "construct" .

cc:case_fibo_lease_out_of_scope_refuses_derivation a cc:NegativeCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_lease_out_of_scope_refuses_derivation" ;
    cc:ordinal 604 ;
    cc:kind "negative" ;
    cc:title "A construct lease scoped only to admit:plan refuses the derive:n3 step" ;
    cc:op "law" ;
    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_usd_25m.ttl\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"admit:plan\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":false},{\"ptr\":\"/error/kind\",\"eq\":\"EngineRejected\"},{\"ptr\":\"/error/details/code\",\"eq\":\"LeaseRefused\"},{\"ptr\":\"/error/details/reason\",\"eq\":\"out_of_scope\"},{\"ptr\":\"/error/details/step\",\"eq\":\"derive:n3\"},{\"ptr\":\"/error/details/lease_id\",\"eq\":\"lease-fin-1\"}]" ;
    cc:coversAxiom cc:ax_fin_plan_not_authority ;
    cc:ceiling "construct" .

cc:case_fibo_lease_plan_out_of_scope_refused a cc:NegativeCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_lease_plan_out_of_scope_refused" ;
    cc:ordinal 605 ;
    cc:kind "negative" ;
    cc:title "A select lease scoped only to derive:n3 refuses the plan step (twin: fibo_identity_base_plan_admits)" ;
    cc:op "law" ;
    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> . @prefix rea: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:tx-usd-25m ctr:hasCounterparty id:party-globex ; rea:transactedUnder id:contract-c1 ; tx:consideration id:amt-1 . id:contract-c1 fin:partOfMasterAgreement id:ma-1 . id:amt-1 cur:hasCurrency iso:USD ; fin:amountMicros 25000000000000 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"plan\",\"plan\":{\"actions\":[{\"name\":\"prepare-settlement-tx-usd-25m\",\"pre\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasCounterparty> <https://chicago.graphlaw.dev/fin/id#party-globex> .\\n<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/transactedUnder> <https://chicago.graphlaw.dev/fin/id#contract-c1> .\\n<https://chicago.graphlaw.dev/fin/id#contract-c1> <https://chicago.graphlaw.dev/fin#partOfMasterAgreement> <https://chicago.graphlaw.dev/fin/id#ma-1> .\\n<https://chicago.graphlaw.dev/fin/id#amt-1> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/USD> .\\n<https://chicago.graphlaw.dev/fin/id#amt-1> <https://chicago.graphlaw.dev/fin#amountMicros> \\\"25000000000000\\\"^^<http://www.w3.org/2001/XMLSchema#integer> .\",\"add\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\",\"del\":\"\"}],\"goal\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\"}}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"select\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":false},{\"ptr\":\"/error/kind\",\"eq\":\"EngineRejected\"},{\"ptr\":\"/error/details/code\",\"eq\":\"LeaseRefused\"},{\"ptr\":\"/error/details/reason\",\"eq\":\"out_of_scope\"},{\"ptr\":\"/error/details/step\",\"eq\":\"admit:plan\"},{\"ptr\":\"/error/details/lease_id\",\"eq\":\"lease-fin-1\"}]" ;
    cc:coversAxiom cc:ax_fin_plan_not_authority ;
    cc:ceiling "select" .

