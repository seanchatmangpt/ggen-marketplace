cc:case_fibo_master_agreement_change_moves_digest_not_verdict a cc:BoundaryMutationCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_master_agreement_change_moves_digest_not_verdict" ;
    cc:ordinal 540 ;
    cc:kind "boundary-mutation" ;
    cc:title "Equal amounts under master agreement ma-2 instead of ma-1 yield a distinct RDFC identity" ;
    cc:op "canonical" ;
    cc:request "{\"op\":\"canonical\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_usd_25m.ttl\",\"dialect\":\"turtle\"}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/id\",\"eq\":\"sha256:080b4b09292c53d64c650bfbbbe88787495c93a0bc4b5d8cc90cc0da47c1bfb4\"}]" ;
    cc:requestB "{\"op\":\"canonical\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_usd_25m_masterM2.ttl\",\"dialect\":\"turtle\"}}" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/id\",\"eq\":\"sha256:026fcc179d67276fc416f10f9f92d3ba5d352565b2282e15b8c88866e82bff65\"}]" ;
    cc:compare "[{\"a\":\"/id\",\"b\":\"/id\",\"rel\":\"neq\"}]" ;
    cc:mutates cc:case_fibo_usd_25m_high_value_control ;
    cc:byteIdentity true ;
    cc:coversAxiom cc:ax_fin_identity_rdfc ;
    cc:ceiling "observe" .

cc:case_fibo_master_agreement_change_moves_plan_digest a cc:BoundaryMutationCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_master_agreement_change_moves_plan_digest" ;
    cc:ordinal 541 ;
    cc:kind "boundary-mutation" ;
    cc:title "The receipt plan_sha256 for the prepared plan differs when the pinned master agreement differs" ;
    cc:op "law" ;
    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> . @prefix rea: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:tx-usd-25m ctr:hasCounterparty id:party-globex ; rea:transactedUnder id:contract-c1 ; tx:consideration id:amt-1 . id:contract-c1 fin:partOfMasterAgreement id:ma-1 . id:amt-1 cur:hasCurrency iso:USD ; fin:amountMicros 25000000000000 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"plan\",\"plan\":{\"actions\":[{\"name\":\"prepare-settlement-tx-usd-25m\",\"pre\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasCounterparty> <https://chicago.graphlaw.dev/fin/id#party-globex> .\\n<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/transactedUnder> <https://chicago.graphlaw.dev/fin/id#contract-c1> .\\n<https://chicago.graphlaw.dev/fin/id#contract-c1> <https://chicago.graphlaw.dev/fin#partOfMasterAgreement> <https://chicago.graphlaw.dev/fin/id#ma-1> .\\n<https://chicago.graphlaw.dev/fin/id#amt-1> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/USD> .\\n<https://chicago.graphlaw.dev/fin/id#amt-1> <https://chicago.graphlaw.dev/fin#amountMicros> \\\"25000000000000\\\"^^<http://www.w3.org/2001/XMLSchema#integer> .\",\"add\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\",\"del\":\"\"}],\"goal\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\"}}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"select\",\"scope\":[\"admit:plan\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/receipts/0/plan_sha256\",\"contains\":\"sha256:\"}]" ;
    cc:requestB "{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> . @prefix rea: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:tx-usd-25m ctr:hasCounterparty id:party-globex ; rea:transactedUnder id:contract-c1 ; tx:consideration id:amt-1 . id:contract-c1 fin:partOfMasterAgreement id:ma-2 . id:amt-1 cur:hasCurrency iso:USD ; fin:amountMicros 25000000000000 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"plan\",\"plan\":{\"actions\":[{\"name\":\"prepare-settlement-tx-usd-25m\",\"pre\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasCounterparty> <https://chicago.graphlaw.dev/fin/id#party-globex> .\\n<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/transactedUnder> <https://chicago.graphlaw.dev/fin/id#contract-c1> .\\n<https://chicago.graphlaw.dev/fin/id#amt-1> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/USD> .\\n<https://chicago.graphlaw.dev/fin/id#amt-1> <https://chicago.graphlaw.dev/fin#amountMicros> \\\"25000000000000\\\"^^<http://www.w3.org/2001/XMLSchema#integer> .\\n<https://chicago.graphlaw.dev/fin/id#contract-c1> <https://chicago.graphlaw.dev/fin#partOfMasterAgreement> <https://chicago.graphlaw.dev/fin/id#ma-2> .\",\"add\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\",\"del\":\"\"}],\"goal\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\"}}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"select\",\"scope\":[\"admit:plan\"],\"expires_unix\":2000}}" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/receipts/0/plan_sha256\",\"contains\":\"sha256:\"}]" ;
    cc:compare "[{\"a\":\"/receipts/0/plan_sha256\",\"b\":\"/receipts/0/plan_sha256\",\"rel\":\"neq\"}]" ;
    cc:mutates cc:case_fibo_identity_base_plan_admits ;
    cc:coversAxiom cc:ax_fin_prepared_effect, cc:ax_fin_identity_rdfc ;
    cc:ceiling "select" .

cc:case_fibo_master_agreement_change_keeps_verdict a cc:InvarianceCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_master_agreement_change_keeps_verdict" ;
    cc:ordinal 542 ;
    cc:kind "invariance" ;
    cc:title "The high-value verdict is identical under ma-1 and ma-2 even though the identity digest differs" ;
    cc:op "law" ;
    cc:request "[{\"op\":\"law\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_usd_25m.ttl\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/0/value\",\"eq\":\"25000000000000\"},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"true\"}]" ;
    cc:requestB "[{\"op\":\"law\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_usd_25m_masterM2.ttl\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/0/value\",\"eq\":\"25000000000000\"},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"true\"}]" ;
    cc:compare "[{\"a\":\"/rows/0/2/value\",\"b\":\"/rows/0/2/value\",\"rel\":\"eq\"}]" ;
    cc:coversAxiom cc:ax_fin_identity_rdfc, cc:ax_fin_threshold_inclusive ;
    cc:ceiling "construct" .

cc:case_fibo_eur_plan_admitted_with_admitted_rate a cc:PositiveCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_eur_plan_admitted_with_admitted_rate" ;
    cc:ordinal 543 ;
    cc:kind "positive" ;
    cc:title "Plan pinned to the admitted EURUSD 1.10 rate is admitted on the state that carries that rate" ;
    cc:op "law" ;
    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_eur_20m.ttl\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"plan\",\"plan\":{\"actions\":[{\"name\":\"prepare-settlement-tx-eur-20m\",\"pre\":\"<https://chicago.graphlaw.dev/fin/id#rate-eurusd-1> <https://chicago.graphlaw.dev/fin#rateValue> \\\"1100000\\\"^^<http://www.w3.org/2001/XMLSchema#integer> .\\n<https://chicago.graphlaw.dev/fin/id#rate-eurusd-1> <https://chicago.graphlaw.dev/fin#admittedBy> <https://chicago.graphlaw.dev/fin/id#fx-desk> .\\n<https://chicago.graphlaw.dev/fin/id#amt-tx-eur-20m> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/EUR> .\\n<https://chicago.graphlaw.dev/fin/id#amt-tx-eur-20m> <https://chicago.graphlaw.dev/fin#amountMicros> \\\"20000000000000\\\"^^<http://www.w3.org/2001/XMLSchema#integer> .\",\"add\":\"<https://chicago.graphlaw.dev/fin/id#tx-eur-20m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\",\"del\":\"\"}],\"goal\":\"<https://chicago.graphlaw.dev/fin/id#tx-eur-20m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\"}}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"select\",\"scope\":[\"admit:plan\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/receipts\",\"len\":1},{\"ptr\":\"/receipts/0/plan_sha256\",\"contains\":\"sha256:\"}]" ;
    cc:coversAxiom cc:ax_fin_fx_admitted_rate, cc:ax_fin_prepared_effect ;
    cc:ceiling "select" .

cc:case_fibo_eur_rate_change_after_admission_invalidates_plan a cc:BoundaryMutationCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_eur_rate_change_after_admission_invalidates_plan" ;
    cc:ordinal 544 ;
    cc:kind "boundary-mutation" ;
    cc:title "Changing the admitted rate to 1.05 after the plan was prepared refuses it (the verdict would still be high value)" ;
    cc:op "law" ;
    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_eur_20m_rate_1_05.ttl\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"plan\",\"plan\":{\"actions\":[{\"name\":\"prepare-settlement-tx-eur-20m\",\"pre\":\"<https://chicago.graphlaw.dev/fin/id#rate-eurusd-1> <https://chicago.graphlaw.dev/fin#rateValue> \\\"1100000\\\"^^<http://www.w3.org/2001/XMLSchema#integer> .\\n<https://chicago.graphlaw.dev/fin/id#rate-eurusd-1> <https://chicago.graphlaw.dev/fin#admittedBy> <https://chicago.graphlaw.dev/fin/id#fx-desk> .\\n<https://chicago.graphlaw.dev/fin/id#amt-tx-eur-20m> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/EUR> .\\n<https://chicago.graphlaw.dev/fin/id#amt-tx-eur-20m> <https://chicago.graphlaw.dev/fin#amountMicros> \\\"20000000000000\\\"^^<http://www.w3.org/2001/XMLSchema#integer> .\",\"add\":\"<https://chicago.graphlaw.dev/fin/id#tx-eur-20m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\",\"del\":\"\"}],\"goal\":\"<https://chicago.graphlaw.dev/fin/id#tx-eur-20m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\"}}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"select\",\"scope\":[\"admit:plan\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":false},{\"ptr\":\"/error/details/code\",\"eq\":\"PlanRefused\"},{\"ptr\":\"/error/details/index\",\"eq\":0},{\"ptr\":\"/error/details/unmet\",\"eq\":[\"<https://chicago.graphlaw.dev/fin/id#rate-eurusd-1> <https://chicago.graphlaw.dev/fin#rateValue> \\\"1100000\\\"^^<http://www.w3.org/2001/XMLSchema#integer> .\"]}]" ;
    cc:mutates cc:case_fibo_eur_plan_admitted_with_admitted_rate ;
    cc:coversAxiom cc:ax_fin_fx_admitted_rate, cc:ax_fin_prepared_effect ;
    cc:ceiling "select" .

cc:case_fibo_eur_unadmitted_rate_derives_nothing a cc:NegativeCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_eur_unadmitted_rate_derives_nothing" ;
    cc:ordinal 545 ;
    cc:kind "negative" ;
    cc:title "EUR 20M with a rate that has no admittedBy is not converted and is not high value (twin: fibo_eur_20m_admitted_rate_high)" ;
    cc:op "law" ;
    cc:request "[{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:t tx:consideration id:a . id:a cur:hasCurrency iso:EUR ; fin:amountMicros 20000000000000 ; fin:rateRef id:r . id:r a cur:ExchangeRate ; fin:rateValue 1100000 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/0/value\",\"eq\":\"20000000000000\"},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"false\"}]" ;
    cc:coversAxiom cc:ax_fin_fx_admitted_rate ;
    cc:ceiling "construct" .

cc:case_fibo_eur_rate_1_05_stays_high_value_but_new_identity a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_eur_rate_1_05_stays_high_value_but_new_identity" ;
    cc:ordinal 546 ;
    cc:kind "cross-authority" ;
    cc:title "N3 verdict is value-based (still high value at 1.05) while the RDFC identity moves with the rate" ;
    cc:op "law" ;
    cc:request "[{\"op\":\"law\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_eur_20m_rate_1_05.ttl\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"true\"}]" ;
    cc:requestB "{\"op\":\"canonical\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_eur_20m_rate_1_05.ttl\",\"dialect\":\"turtle\"}}" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/id\",\"eq\":\"sha256:d00a2dcd593f899f0639c004d15186ac1e2dad01a48c37266895dc8ce219dc60\"}]" ;
    cc:coversAxiom cc:ax_fin_fx_admitted_rate, cc:ax_fin_identity_rdfc ;
    cc:ceiling "construct" .

cc:case_fibo_shapes_two_currencies_refused a cc:NegativeCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_shapes_two_currencies_refused" ;
    cc:ordinal 550 ;
    cc:kind "negative" ;
    cc:title "A MonetaryAmount with two currencies does not conform (twin: fibo_usd_25m_shapes_conform)" ;
    cc:op "shacl" ;
    cc:request "{\"op\":\"shacl\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:a a cur:MonetaryAmount ; cur:hasCurrency iso:USD, iso:EUR ; cur:hasAmount 1.0 ; fin:amountMicros 1000000 .\",\"dialect\":\"turtle\"},\"shapes\":\"$FILE:tests/fixtures/fibo/shapes.ttl\"}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/conforms\",\"eq\":false},{\"ptr\":\"/results\",\"len\":1},{\"ptr\":\"/results/0/component\",\"contains\":\"MaxCount\"}]" ;
    cc:coversAxiom cc:ax_fin_one_amount_shape ;
    cc:ceiling "observe" .

cc:case_fibo_shapes_two_decimals_refused a cc:NegativeCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_shapes_two_decimals_refused" ;
    cc:ordinal 551 ;
    cc:kind "negative" ;
    cc:title "A MonetaryAmount with two decimal amounts does not conform" ;
    cc:op "shacl" ;
    cc:request "{\"op\":\"shacl\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:a a cur:MonetaryAmount ; cur:hasCurrency iso:USD ; cur:hasAmount 1.0, 2.0 ; fin:amountMicros 1000000 .\",\"dialect\":\"turtle\"},\"shapes\":\"$FILE:tests/fixtures/fibo/shapes.ttl\"}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/conforms\",\"eq\":false},{\"ptr\":\"/results\",\"len\":1},{\"ptr\":\"/results/0/component\",\"contains\":\"MaxCount\"}]" ;
    cc:coversAxiom cc:ax_fin_one_amount_shape ;
    cc:ceiling "observe" .

cc:case_fibo_shapes_missing_counterparty_refused a cc:NegativeCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_shapes_missing_counterparty_refused" ;
    cc:ordinal 552 ;
    cc:kind "negative" ;
    cc:title "A MarketTransaction without a counterparty does not conform" ;
    cc:op "shacl" ;
