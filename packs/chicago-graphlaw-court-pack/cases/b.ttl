w.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\",\"del\":\"\"}],\"goal\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\"}},{\"step\":\"record-receipts\"},{\"step\":\"require-receipt\",\"step_name\":\"plan-action\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"select\",\"scope\":[\"admit:plan\",\"admit:require-receipt\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/states\",\"len\":4},{\"ptr\":\"/nquads\",\"contains\":\"urn:graphlaw:p:lease_id\"}]" ;
    cc:coversAxiom cc:ax_fin_receipt_hop ;
    cc:ceiling "select" .

