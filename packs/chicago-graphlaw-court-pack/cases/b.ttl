    cc:expect "[{\"ptr\":\"/ok\",\"eq\":false},{\"ptr\":\"/error/details/code\",\"eq\":\"ReceiptRequired\"},{\"ptr\":\"/error/details/step\",\"eq\":\"plan-action\"}]" ;
