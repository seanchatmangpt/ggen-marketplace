    cc:title "Reversing the Datalog rule order yields byte-identical facts" ;
    cc:op "datalog" ;
    cc:request "{\"op\":\"datalog\",\"rules\":[{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"]]},{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?z\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"],[\"?y\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?z\"]]}],\"facts\":[[\"https://chicago.graphlaw.dev/fin/id#party-a\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-b\"],[\"https://chicago.graphlaw.dev/fin/id#party-b\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-c\"],[\"https://chicago.graphlaw.dev/fin/id#party-c\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-a\"],[\"https://chicago.graphlaw.dev/fin/id#party-d\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-a\"],[\"https://chicago.graphlaw.dev/fin/id#party-e\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-f\"]]}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/count\",\"eq\":13}]" ;
    cc:requestB "{\"op\":\"datalog\",\"rules\":[{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?z\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"],[\"?y\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?z\"]]},{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"]]}],\"facts\":[[\"https://chicago.graphlaw.dev/fin/id#party-a\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-b\"],[\"https://chicago.graphlaw.dev/fin/id#party-b\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-c\"],[\"https://chicago.graphlaw.dev/fin/id#party-c\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-a\"],[\"https://chicago.graphlaw.dev/fin/id#party-d\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-a\"],[\"https://chicago.graphlaw.dev/fin/id#party-e\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-f\"]]}" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/count\",\"eq\":13}]" ;
    cc:compare "[{\"a\":\"/facts\",\"b\":\"/facts\",\"rel\":\"eq\"}]" ;
    cc:coversAxiom cc:ax_fin_delegation_closure ;
    cc:ceiling "observe" .

cc:case_fibo_delegation_dropped_edge_changes_closure a cc:BoundaryMutationCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_delegation_dropped_edge_changes_closure" ;
    cc:ordinal 572 ;
    cc:kind "boundary-mutation" ;
    cc:title "Dropping the c->a edge breaks the cycle: the closure shrinks to the 8-pair least fixpoint and party-b no longer reaches party-a" ;
    cc:op "datalog" ;
    cc:request "{\"op\":\"datalog\",\"rules\":[{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"]]},{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?z\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"],[\"?y\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?z\"]]}],\"facts\":[[\"https://chicago.graphlaw.dev/fin/id#party-a\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-b\"],[\"https://chicago.graphlaw.dev/fin/id#party-b\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-c\"],[\"https://chicago.graphlaw.dev/fin/id#party-d\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-a\"],[\"https://chicago.graphlaw.dev/fin/id#party-e\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-f\"]]}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/count\",\"eq\":7},{\"ptr\":\"/facts\",\"eq\":[[\"https://chicago.graphlaw.dev/fin/id#party-a\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-b\"],[\"https://chicago.graphlaw.dev/fin/id#party-a\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-c\"],[\"https://chicago.graphlaw.dev/fin/id#party-b\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-c\"],[\"https://chicago.graphlaw.dev/fin/id#party-d\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-a\"],[\"https://chicago.graphlaw.dev/fin/id#party-d\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-b\"],[\"https://chicago.graphlaw.dev/fin/id#party-d\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-c\"],[\"https://chicago.graphlaw.dev/fin/id#party-e\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-f\"]]}]" ;
    cc:mutates cc:case_fibo_delegation_closure_with_cycle ;
    cc:coversAxiom cc:ax_fin_delegation_closure ;
    cc:ceiling "observe" .

cc:case_fibo_delegation_datalog_matches_owl_rl a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_delegation_datalog_matches_owl_rl" ;
    cc:ordinal 573 ;
    cc:kind "cross-authority" ;
    cc:title "Datalog closure and OWL RL entailment (fin:delegatesTo a owl:TransitiveProperty) agree on 13 delegatesTo pairs over the same graph" ;
    cc:op "datalog" ;
    cc:request "{\"op\":\"datalog\",\"rules\":[{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"]]},{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?z\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?y\"],[\"?y\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"?z\"]]}],\"facts\":[[\"https://chicago.graphlaw.dev/fin/id#party-a\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-b\"],[\"https://chicago.graphlaw.dev/fin/id#party-b\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-c\"],[\"https://chicago.graphlaw.dev/fin/id#party-c\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-a\"],[\"https://chicago.graphlaw.dev/fin/id#party-d\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-a\"],[\"https://chicago.graphlaw.dev/fin/id#party-e\",\"https://chicago.graphlaw.dev/fin#delegatesTo\",\"https://chicago.graphlaw.dev/fin/id#party-f\"]]}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/count\",\"eq\":13}]" ;
    cc:requestB "[{\"op\":\"entail\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/delegation.ttl\",\"dialect\":\"turtle\"},\"regime\":\"owl-rl\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT (COUNT(*) AS ?c) WHERE { ?x fin:delegatesTo ?y }\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/0/value\",\"eq\":\"13\"}]" ;
    cc:coversAxiom cc:ax_fin_delegation_closure ;
    cc:ceiling "observe" .

cc:case_fibo_xauth_micros_decimal_below a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_xauth_micros_decimal_below" ;
    cc:ordinal 580 ;
    cc:kind "cross-authority" ;
    cc:title "Integer-micros rule and FIBO-decimal rule give the same verdict (not high) at 9999999.999999" ;
    cc:op "law" ;
    cc:request "[{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:t tx:consideration id:a . id:a cur:hasCurrency iso:USD ; fin:amountMicros 9999999999999 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/0/value\",\"eq\":\"9999999999999\"},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"false\"}]" ;
    cc:requestB "[{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:t tx:consideration id:a . id:a cur:hasCurrency iso:USD ; cur:hasAmount 9999999.999999 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/1/value\",\"eq\":\"9999999.999999\"},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"false\"}]" ;
    cc:compare "[{\"a\":\"/rows/0/2/value\",\"b\":\"/rows/0/2/value\",\"rel\":\"eq\"}]" ;
    cc:coversAxiom cc:ax_fin_threshold_inclusive ;
    cc:ceiling "construct" .

cc:case_fibo_xauth_micros_decimal_at a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_xauth_micros_decimal_at" ;
