    cc:expect "[{\"ptr\":\"/ok\",\"eq\":false},{\"ptr\":\"/error/kind\",\"eq\":\"EngineRejected\"},{\"ptr\":\"/error/details/code\",\"eq\":\"PlanRefused\"},{\"ptr\":\"/error/details/index\",\"eq\":0},{\"ptr\":\"/error/details/unmet\",\"eq\":[\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasCounterparty> <https://chicago.graphlaw.dev/fin/id#party-globex> .\"]},{\"ptr\":\"/error/details/violated_absent\",\"len\":0}]" ;
    cc:mutates cc:case_fibo_identity_base_plan_admits ;
    cc:coversAxiom cc:ax_fin_prepared_effect ;
    cc:ceiling "select" .

