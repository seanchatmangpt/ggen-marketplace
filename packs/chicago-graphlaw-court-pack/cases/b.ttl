cc:case_fibo_identity_base_plan_admits a cc:PositiveCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_identity_base_plan_admits" ;
    cc:ordinal 530 ;
    cc:kind "positive" ;
    cc:title "Plan prepared for the exact 25M transaction identity (counterparty, currency, contract, amount, master) is admitted under a select lease" ;
    cc:op "law" ;
    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> . @prefix rea: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:tx-usd-25m ctr:hasCounterparty id:party-globex ; rea:transactedUnder id:contract-c1 ; tx:consideration id:amt-1 . id:contract-c1 fin:partOfMasterAgreement id:ma-1 . id:amt-1 cur:hasCurrency iso:USD ; fin:amountMicros 25000000000000 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"plan\",\"plan\":{\"actions\":[{\"name\":\"prepare-settlement-tx-usd-25m\",\"pre\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasCounterparty> <https://chicago.graphlaw.dev/fin/id#party-globex> .\\n<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/transactedUnder> <https://chicago.graphlaw.dev/fin/id#contract-c1> .\\n<https://chicago.graphlaw.dev/fin/id#contract-c1> <https://chicago.graphlaw.dev/fin#partOfMasterAgreement> <https://chicago.graphlaw.dev/fin/id#ma-1> .\\n<https://chicago.graphlaw.dev/fin/id#amt-1> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/USD> .\\n<https://chicago.graphlaw.dev/fin/id#amt-1> <https://chicago.graphlaw.dev/fin#amountMicros> \\\"25000000000000\\\"^^<http://www.w3.org/2001/XMLSchema#integer> .\",\"add\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\",\"del\":\"\"}],\"goal\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\"}}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"select\",\"scope\":[\"admit:plan\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/receipts\",\"len\":1},{\"ptr\":\"/receipts/0/lease_id\",\"eq\":\"lease-fin-1\"},{\"ptr\":\"/receipts/0/step\",\"eq\":\"plan-action\"},{\"ptr\":\"/receipts/0/parent\",\"eq\":\"sha256:1f14f1340d1e251ebc8ebd2cfece8b4345976444ac82a171a342db044ef45f53\"},{\"ptr\":\"/nquads\",\"contains\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\"}]" ;
    cc:coversAxiom cc:ax_fin_prepared_effect, cc:ax_fin_identity_rdfc ;
    cc:ceiling "select" .

