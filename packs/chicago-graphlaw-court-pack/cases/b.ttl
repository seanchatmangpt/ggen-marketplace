# chicago-graphlaw-court-pack / cases / b.ttl  --  Lane B (FIBO court), ordinals 500-999.
#
# SYNTHETIC financial subject only: no real parties, accounts, or payment rail.
# The USD 10,000,000 (10_000_000_000_000 micros) high-value threshold is OUR policy, not FIBO's
# and not a regulation; FIBO defines no threshold and no ceiling.
# Standing: finite published corpus passes on exact subject; authority NONE; synthetic subject;
# no general financial safety claim.
# FIBO source pin: ggen-marketplace 2b6126abf11017527ce400b6001c063e252fdfb6, ontologies/public/fibo (MIT).
# Fixtures: graphlaw tests/fixtures/fibo/ (read via "$FILE:" tokens relative to CARGO_MANIFEST_DIR).
# UNSUPPORTED[money-ceiling]: lease Ceiling is Observe/Select/Construct only; the money boundary is N3 policy.
# UNSUPPORTED[abi:no-receipt-signing]: no signed-receipt claims are made here.
# UNSUPPORTED[convert-fibo-rdfxml]: FIBO RDF/XML is refused by the convert op (DTD); fixtures are hand-authored Turtle.
# Generated by hand-authoring tool; every request/expect literal is JSON (RFC 6901 pointers).
@prefix cc: <https://chicago.graphlaw.dev/court#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


cc:ax_fin_threshold_inclusive a cc:Axiom ;
    rdfs:label "USD 10M (10_000_000_000_000 micros) threshold is inclusive (math:notLessThan)" ;
    cc:source "Chicago-court policy tests/fixtures/fibo/policy_high_value.n3; NOT FIBO, NOT a regulation" .


cc:ax_fin_fibo_vocabulary a cc:Axiom ;
    rdfs:label "Instance data uses real FIBO IRIs (MarketTransaction, MonetaryAmount, MasterAgreement, ...)" ;
    cc:source "FIBO (MIT) pinned at ggen-marketplace 2b6126abf11017527ce400b6001c063e252fdfb6 path ontologies/public/fibo" .


cc:ax_fin_one_amount_shape a cc:Axiom ;
    rdfs:label "A MonetaryAmount carries exactly one currency, one xsd:decimal and one integer micros value" ;
    cc:source "W3C SHACL https://www.w3.org/TR/shacl/ ; tests/fixtures/fibo/shapes.ttl" .


cc:ax_fin_identity_rdfc a cc:Axiom ;
    rdfs:label "Transaction identity is the RDFC-1.0 digest: counterparty, currency, contract, amount and master agreement each move it" ;
    cc:source "W3C RDF Dataset Canonicalization RDFC-1.0 https://www.w3.org/TR/rdf-canon/" .


cc:ax_fin_prepared_effect a cc:Axiom ;
    rdfs:label "A plan prepared against an exact transaction state is refused when any identity triple differs" ;
    cc:source "graphlaw docs/refusals.md PlanRefused; src/plan.rs Plan::admit" .


cc:ax_fin_fx_admitted_rate a cc:Axiom ;
    rdfs:label "Non-USD amounts convert to USD only through an admitted exchange rate; changing the rate after admission invalidates the plan" ;
    cc:source "FIBO cur:ExchangeRate (IRI only); rate admission rule is Chicago-court policy" .


cc:ax_fin_dvp_atomic a cc:Axiom ;
    rdfs:label "Delivery-versus-payment settles only when cash leg and security leg are both ready; cash alone is incomplete" ;
    cc:source "PDDL negative preconditions (pre_not / goal_not); graphlaw tests/plan_negation.rs; FIBO fi:SecuritiesTransaction (IRI only)" .


cc:ax_fin_delegation_closure a cc:Axiom ;
    rdfs:label "Delegation is a transitive closure that terminates on cycles" ;
    cc:source "Souffle transitive-closure tutorial https://souffle-lang.github.io/tutorial ; OWL 2 RL owl:TransitiveProperty https://www.w3.org/TR/owl2-profiles/" .


cc:ax_fin_plan_not_authority a cc:Axiom ;
    rdfs:label "Plan admission is not construct authority: a select-ceiling lease admits a plan but cannot derive" ;
    cc:source "graphlaw docs/abi-reference.md section 13 (Step::required_ceiling); UNSUPPORTED[money-ceiling]" .


cc:ax_fin_receipt_hop a cc:Axiom ;
    rdfs:label "A receipt gate passes only after the receipt is recorded into state" ;
    cc:source "graphlaw docs/refusals.md ReceiptRequired; UNSUPPORTED[abi:no-receipt-signing]" .


cc:case_fibo_usd_25m_high_value_control a cc:PositiveCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_usd_25m_high_value_control" ;
    cc:ordinal 501 ;
    cc:kind "positive" ;
    cc:title "USD 25M MarketTransaction: N3 policy derives HighValueTransaction under a construct lease (positive control)" ;
    cc:op "law" ;
    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_usd_25m.ttl\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/nquads\",\"contains\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://chicago.graphlaw.dev/fin#HighValueTransaction> .\"},{\"ptr\":\"/receipts\",\"len\":1},{\"ptr\":\"/receipts/0/lease_id\",\"eq\":\"lease-fin-1\"}]" ;
    cc:byteIdentity true ;
    cc:note "Money boundary lives in the N3 policy: the lease Ceiling has no money dimension (UNSUPPORTED[money-ceiling]). Threshold is Chicago-court policy, not FIBO's." ;
    cc:coversAxiom cc:ax_fin_threshold_inclusive, cc:ax_fin_fibo_vocabulary ;
    cc:ceiling "construct" .

cc:case_fibo_usd_25m_shapes_conform a cc:PositiveCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_usd_25m_shapes_conform" ;
    cc:ordinal 502 ;
    cc:kind "positive" ;
    cc:title "tx_usd_25m.ttl conforms to the market-transaction and one-currency/one-decimal shapes" ;
    cc:op "shacl" ;
    cc:request "{\"op\":\"shacl\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_usd_25m.ttl\",\"dialect\":\"turtle\"},\"shapes\":\"$FILE:tests/fixtures/fibo/shapes.ttl\"}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/conforms\",\"eq\":true},{\"ptr\":\"/results\",\"len\":0}]" ;
    cc:byteIdentity true ;
    cc:coversAxiom cc:ax_fin_one_amount_shape, cc:ax_fin_fibo_vocabulary ;
    cc:ceiling "observe" .

cc:case_fibo_eur_20m_admitted_rate_high a cc:PositiveCase, cc:Case ;
