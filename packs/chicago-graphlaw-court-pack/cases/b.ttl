cc:case_fibo_xauth_decimal_lexical_forms_share_verdict_not_digest a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_xauth_decimal_lexical_forms_share_verdict_not_digest" ;
    cc:ordinal 583 ;
    cc:kind "cross-authority" ;
    cc:title "25000000.0 and 25000000.000000 have the same value-based verdict but distinct RDFC digests (RDFC hashes lexical forms)" ;
    cc:op "law" ;
    cc:request "[{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:t tx:consideration id:a . id:a cur:hasCurrency iso:USD ; cur:hasAmount 25000000.0 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/1/value\",\"eq\":\"25000000.0\"},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"true\"}]" ;
    cc:requestB "[{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:t tx:consideration id:a . id:a cur:hasCurrency iso:USD ; cur:hasAmount 25000000.000000 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/1/value\",\"eq\":\"25000000.000000\"},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"true\"}]" ;
    cc:compare "[{\"a\":\"/rows/0/2/value\",\"b\":\"/rows/0/2/value\",\"rel\":\"eq\"}]" ;
    cc:coversAxiom cc:ax_fin_identity_rdfc, cc:ax_fin_threshold_inclusive ;
    cc:ceiling "construct" .

cc:case_fibo_xauth_decimal_lexical_forms_distinct_digests a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_xauth_decimal_lexical_forms_distinct_digests" ;
    cc:ordinal 584 ;
    cc:kind "cross-authority" ;
    cc:title "RDFC-1.0 gives distinct identities to 25000000.0 and 25000000.000000 although N3 treats them as one value" ;
    cc:op "canonical" ;
    cc:request "{\"op\":\"canonical\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:t tx:consideration id:a . id:a cur:hasCurrency iso:USD ; cur:hasAmount 25000000.0 .\",\"dialect\":\"turtle\"}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/id\",\"eq\":\"sha256:c1039ecdf93e6a6de747ea89b331338e930badf7e4fc8d6b2838f05cc05f0c72\"}]" ;
    cc:requestB "{\"op\":\"canonical\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:t tx:consideration id:a . id:a cur:hasCurrency iso:USD ; cur:hasAmount 25000000.000000 .\",\"dialect\":\"turtle\"}}" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/id\",\"eq\":\"sha256:10967160cbf3208a9145fb49aa47f2000b95928e3e496a89c37d4e4a79660673\"}]" ;
    cc:compare "[{\"a\":\"/id\",\"b\":\"/id\",\"rel\":\"neq\"}]" ;
    cc:coversAxiom cc:ax_fin_identity_rdfc ;
    cc:ceiling "observe" .

cc:case_fibo_identity_statement_order_and_prefix_invariant a cc:InvarianceCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_identity_statement_order_and_prefix_invariant" ;
    cc:ordinal 590 ;
    cc:kind "invariance" ;
    cc:title "The same transaction graph with statements reordered and prefixes renamed has the same RDFC digest" ;
    cc:op "canonical" ;
    cc:request "{\"op\":\"canonical\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> . @prefix rea: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:tx-usd-25m ctr:hasCounterparty id:party-globex ; rea:transactedUnder id:contract-c1 ; tx:consideration id:amt-1 . id:contract-c1 fin:partOfMasterAgreement id:ma-1 . id:amt-1 cur:hasCurrency iso:USD ; fin:amountMicros 25000000000000 .\",\"dialect\":\"turtle\"}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/id\",\"eq\":\"sha256:1f14f1340d1e251ebc8ebd2cfece8b4345976444ac82a171a342db044ef45f53\"}]" ;
    cc:requestB "{\"op\":\"canonical\",\"data\":{\"text\":\"@prefix i: <https://chicago.graphlaw.dev/fin/id#> . @prefix f: <https://chicago.graphlaw.dev/fin#> . @prefix c: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix o: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix t: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix k: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> . @prefix r: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/> . i:amt-1 f:amountMicros 25000000000000 ; c:hasCurrency o:USD . i:contract-c1 f:partOfMasterAgreement i:ma-1 . i:tx-usd-25m t:consideration i:amt-1 ; r:transactedUnder i:contract-c1 ; k:hasCounterparty i:party-globex .\",\"dialect\":\"turtle\"}}" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/id\",\"eq\":\"sha256:1f14f1340d1e251ebc8ebd2cfece8b4345976444ac82a171a342db044ef45f53\"}]" ;
    cc:compare "[{\"a\":\"/id\",\"b\":\"/id\",\"rel\":\"eq\"}]" ;
    cc:coversAxiom cc:ax_fin_identity_rdfc ;
    cc:ceiling "observe" .

cc:case_fibo_verdict_statement_order_invariant a cc:InvarianceCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_verdict_statement_order_invariant" ;
    cc:ordinal 591 ;
    cc:kind "invariance" ;
    cc:title "The N3 verdict for the 25M transaction does not depend on Turtle statement order" ;
    cc:op "law" ;
    cc:request "[{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> . @prefix rea: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:tx-usd-25m ctr:hasCounterparty id:party-globex ; rea:transactedUnder id:contract-c1 ; tx:consideration id:amt-1 . id:contract-c1 fin:partOfMasterAgreement id:ma-1 . id:amt-1 cur:hasCurrency iso:USD ; fin:amountMicros 25000000000000 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"true\"}]" ;
    cc:requestB "[{\"op\":\"law\",\"data\":{\"text\":\"@prefix i: <https://chicago.graphlaw.dev/fin/id#> . @prefix f: <https://chicago.graphlaw.dev/fin#> . @prefix c: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix o: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix t: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix k: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> . @prefix r: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/> . i:amt-1 f:amountMicros 25000000000000 ; c:hasCurrency o:USD . i:contract-c1 f:partOfMasterAgreement i:ma-1 . i:tx-usd-25m t:consideration i:amt-1 ; r:transactedUnder i:contract-c1 ; k:hasCounterparty i:party-globex .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"true\"}]" ;
    cc:compare "[{\"a\":\"/rows/0/2/value\",\"b\":\"/rows/0/2/value\",\"rel\":\"eq\"}]" ;
    cc:coversAxiom cc:ax_fin_threshold_inclusive ;
    cc:ceiling "construct" .

cc:case_fibo_lease_observe_ceiling_refuses_derivation a cc:NegativeCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_lease_observe_ceiling_refuses_derivation" ;
    cc:ordinal 600 ;
    cc:kind "negative" ;
    cc:title "An observe-ceiling lease cannot run the construct-level N3 derivation (twin: fibo_usd_25m_high_value_control)" ;
    cc:op "law" ;
    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_usd_25m.ttl\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"observe\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":false},{\"ptr\":\"/error/kind\",\"eq\":\"EngineRejected\"},{\"ptr\":\"/error/details/code\",\"eq\":\"LeaseRefused\"},{\"ptr\":\"/error/details/reason\",\"eq\":\"ceiling\"},{\"ptr\":\"/error/details/step\",\"eq\":\"derive:n3\"},{\"ptr\":\"/error/details/lease_id\",\"eq\":\"lease-fin-1\"}]" ;
    cc:coversAxiom cc:ax_fin_plan_not_authority ;
    cc:ceiling "observe" .

cc:case_fibo_lease_select_ceiling_refuses_derivation a cc:NegativeCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_lease_select_ceiling_refuses_derivation" ;
    cc:ordinal 601 ;
    cc:kind "negative" ;
    cc:title "A select-ceiling lease admits plans but still cannot derive: plan admission is not construct authority" ;
    cc:op "law" ;
    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"$FILE:tests/fixtures/fibo/tx_usd_25m.ttl\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"select\",\"scope\":[\"derive:n3\",\"admit:plan\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":false},{\"ptr\":\"/error/kind\",\"eq\":\"EngineRejected\"},{\"ptr\":\"/error/details/code\",\"eq\":\"LeaseRefused\"},{\"ptr\":\"/error/details/reason\",\"eq\":\"ceiling\"},{\"ptr\":\"/error/details/step\",\"eq\":\"derive:n3\"},{\"ptr\":\"/error/details/lease_id\",\"eq\":\"lease-fin-1\"}]" ;
    cc:coversAxiom cc:ax_fin_plan_not_authority ;
    cc:ceiling "select" .

cc:case_fibo_lease_plan_then_derive_stops_at_derive a cc:NegativeCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_lease_plan_then_derive_stops_at_derive" ;
    cc:ordinal 602 ;
    cc:kind "negative" ;
    cc:title "Under a select lease the plan step is admitted but the following derive step is refused; no state is returned" ;
    cc:op "law" ;
    cc:request "{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix ctr: <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/> . @prefix rea: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:tx-usd-25m ctr:hasCounterparty id:party-globex ; rea:transactedUnder id:contract-c1 ; tx:consideration id:amt-1 . id:contract-c1 fin:partOfMasterAgreement id:ma-1 . id:amt-1 cur:hasCurrency iso:USD ; fin:amountMicros 25000000000000 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"plan\",\"plan\":{\"actions\":[{\"name\":\"prepare-settlement-tx-usd-25m\",\"pre\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/Agreements/Contracts/hasCounterparty> <https://chicago.graphlaw.dev/fin/id#party-globex> .\\n<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/REATransactions/transactedUnder> <https://chicago.graphlaw.dev/fin/id#contract-c1> .\\n<https://chicago.graphlaw.dev/fin/id#contract-c1> <https://chicago.graphlaw.dev/fin#partOfMasterAgreement> <https://chicago.graphlaw.dev/fin/id#ma-1> .\\n<https://chicago.graphlaw.dev/fin/id#amt-1> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/hasCurrency> <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/USD> .\\n<https://chicago.graphlaw.dev/fin/id#amt-1> <https://chicago.graphlaw.dev/fin#amountMicros> \\\"25000000000000\\\"^^<http://www.w3.org/2001/XMLSchema#integer> .\",\"add\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\",\"del\":\"\"}],\"goal\":\"<https://chicago.graphlaw.dev/fin/id#tx-usd-25m> <https://chicago.graphlaw.dev/fin#status> <https://chicago.graphlaw.dev/fin#settlementPrepared> .\"}},{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"select\",\"scope\":[\"admit:plan\",\"derive:n3\"],\"expires_unix\":2000}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":false},{\"ptr\":\"/error/kind\",\"eq\":\"EngineRejected\"},{\"ptr\":\"/error/details/code\",\"eq\":\"LeaseRefused\"},{\"ptr\":\"/error/details/reason\",\"eq\":\"ceiling\"},{\"ptr\":\"/error/details/step\",\"eq\":\"derive:n3\"},{\"ptr\":\"/error/details/lease_id\",\"eq\":\"lease-fin-1\"}]" ;
    cc:coversAxiom cc:ax_fin_plan_not_authority ;
    cc:ceiling "select" .

cc:case_fibo_lease_expired_refuses_derivation a cc:NegativeCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_lease_expired_refuses_derivation" ;
    cc:ordinal 603 ;
    cc:kind "negative" ;
