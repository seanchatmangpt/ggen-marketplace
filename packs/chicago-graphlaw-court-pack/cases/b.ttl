cc:case_fibo_boundary_micros_9999999999999 a cc:BoundaryMutationCase, cc:Case ;
    cc:court cc:fibo_court ;
    cc:caseId "fibo_boundary_micros_9999999999999" ;
    cc:ordinal 510 ;
    cc:kind "boundary-mutation" ;
    cc:title "USD 9_999_999.999999 (one micro below threshold) is not high value" ;
    cc:op "law" ;
    cc:request "[{\"op\":\"law\",\"data\":{\"text\":\"@prefix tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> . @prefix cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> . @prefix iso: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> . @prefix fin: <https://chicago.graphlaw.dev/fin#> . @prefix id: <https://chicago.graphlaw.dev/fin/id#> . id:t tx:consideration id:a . id:a cur:hasCurrency iso:USD ; fin:amountMicros 9999999999999 .\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"$FILE:tests/fixtures/fibo/policy_high_value.n3\"}],\"unverified_lease\":true,\"now_unix\":1000,\"lease\":{\"id\":\"lease-fin-1\",\"holder\":\"agent-fin\",\"ceiling\":\"construct\",\"scope\":[\"derive:n3\"],\"expires_unix\":2000}},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"PREFIX tx: <https://spec.edmcouncil.org/fibo/ontology/FND/TransactionsExt/MarketTransactions/> PREFIX cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> PREFIX fin: <https://chicago.graphlaw.dev/fin#> SELECT ?m ?d ?hv WHERE { ?t tx:consideration ?a . OPTIONAL { ?a fin:amountMicros ?m } OPTIONAL { ?a cur:hasAmount ?d } BIND(EXISTS{ ?t a fin:HighValueTransaction } AS ?hv) }\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/kind\",\"eq\":\"solutions\"},{\"ptr\":\"/rows/0/0/value\",\"eq\":\"9999999999999\"},{\"ptr\":\"/rows/0/2/value\",\"eq\":\"false\"}]" ;
    cc:mutates cc:case_fibo_usd_25m_high_value_control ;
    cc:coversAxiom cc:ax_fin_threshold_inclusive ;
    cc:ceiling "construct" .

