# Lane A (502): cross-authority convergence cases for the chicago-graphlaw court pack.
#
# Court: cc:cross_authority_court  ->  graphlaw tests/chicago_cross_authority.rs (GENERATED, never hand-edited).
# Ordinal range: 1-499 (Lane A). Case ids use the xa_ prefix. Axioms use cc:ax_xa_*.
#
# Subject: one reachability problem over the synthetic graph a->b, b->c, c->b, c->d in namespace
# https://chicago.graphlaw.dev/ (predicates :edge and :reachable). No financial content, no real payment rail.
# Expected closure: nine :reachable pairs, including the cycle-induced b->b and c->c.
#
# Convergence: N3 (n3 op, law n3 step), OWL-RL (entail op, law owl-rl step) and the SPARQL 1.1 edge+ path
# each project their :reachable triples with a SPARQL CONSTRUCT and must reach the identical RDFC id
# (canonical op). Datalog returns facts, not a graph, so it is compared by exact sorted facts:
# UNSUPPORTED[datalog-canonical-projection]. SHACL, ShEx and SPARQL ASK/COUNT run over the closure.
#
# Request/expect DSL (RESOLUTIONS R3): cc:request/cc:requestB is a JSON ABI request, or a JSON array chain
# where a string value exactly "$PREV:/ptr" is replaced by that RFC 6901 pointer into the previous response.
# cc:expect is a JSON array of {ptr, eq|contains|len|absent}. cc:compare is a JSON array of
# {a, rel, b} (rel eq|neq) over pointers into response A (cc:request) and response B (cc:requestB).
# cc:byteIdentity true: single non-chain request also run through common::native and common::wasm; raw
# responses must be byte-identical (a missing wasm module is a hard failure).
#
# Unsupported in this lane:
#   UNSUPPORTED[generated-oversize-payload]: request_bytes, atoms_per_field and plan_actions caps need
#     payloads too large for a case literal; tests/resource_limits.rs already covers them natively.
#     json_depth and n3_iterations are plain requests and are generated here.
#   UNSUPPORTED[datalog-canonical-projection]: see above.
#   UNSUPPORTED[non-json-request]: a non-JSON or non-object request body cannot be expressed as a case.
#   UNSUPPORTED[abi:no-receipt-signing]: the ABI signs no receipts; lease cases use unverified leases.
#
# Standing: finite published corpus passes on exact subject; authority NONE; synthetic subject; no general financial safety claim.
# Ceiling: passing proves only the cases below on the pinned graphlaw subject. It claims no complete
# N3, OWL 2 RL, SPARQL, SHACL, ShEx, RDFC or Datalog conformance. authority=NONE, EVIDENCE_ONLY.

@prefix cc: <https://chicago.graphlaw.dev/court#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cc:ax_xa_reach_lfp a cc:Axiom ;
    cc:title "Transitive closure of a binary relation is its least fixpoint under the base rule plus the recursive rule, cycles included." ;
    cc:source "https://souffle-lang.github.io/tutorial" .

cc:ax_xa_n3_chain a cc:Axiom ;
    cc:title "N3 implications fire when their premise matches and chain to fixpoint." ;
    cc:source "https://w3c.github.io/N3/spec/semantics.html" .

cc:ax_xa_owlrl_trans a cc:Axiom ;
    cc:title "OWL 2 RL rules prp-spo1 and prp-trp materialize rdfs:subPropertyOf and owl:TransitiveProperty." ;
    cc:source "https://www.w3.org/TR/owl2-profiles/#OWL_2_RL" .

cc:ax_xa_sparql_path a cc:Axiom ;
    cc:title "SPARQL 1.1 one-or-more property path edge+ denotes the transitive closure of edge." ;
    cc:source "https://www.w3.org/TR/sparql11-query/#propertypaths" .

cc:ax_xa_sparql_ask a cc:Axiom ;
    cc:title "SPARQL ASK and aggregate SELECT report solutions over the queried dataset." ;
    cc:source "https://www.w3.org/TR/sparql11-query/#ask" .

cc:ax_xa_rdfc_identity a cc:Axiom ;
    cc:title "RDFC-1.0 assigns isomorphic datasets the same canonical form, so equal ids mean equal RDF state." ;
    cc:source "https://www.w3.org/TR/rdf-canon/" .

cc:ax_xa_order_inv a cc:Axiom ;
    cc:title "RDF graphs and Datalog fact sets are sets: statement, fact and rule order carry no meaning." ;
    cc:source "https://www.w3.org/TR/rdf11-concepts/#section-rdf-graph" .

cc:ax_xa_shacl_conf a cc:Axiom ;
    cc:title "SHACL and ShEx validation reports conformance by shape; sh:hasValue requires the value among the values of the path." ;
    cc:source "https://www.w3.org/TR/shacl/#HasValueConstraintComponent" .

cc:ax_xa_mutation_sensitivity a cc:Axiom ;
    cc:title "Reachability is monotone in the edge set: removing or adding an edge changes the closure." ;
    cc:source "https://souffle-lang.github.io/tutorial" .

cc:ax_xa_failclosed a cc:Axiom ;
    cc:title "GraphLaw ABI fails closed: malformed or unsupported input yields ok false with a typed error kind, never a partial success." ;
    cc:source "graphlaw/docs/refusals.md" .

cc:ax_xa_resource_ceiling a cc:Axiom ;
    cc:title "GraphLaw ABI resource caps refuse with typed ResourceLimit details {code, limit, observed, max} before heavy work." ;
    cc:source "graphlaw/docs/abi-reference.md" .

cc:ax_xa_lease_ceiling a cc:Axiom ;
    cc:title "A law step runs only under a lease whose ceiling, scope and expiry admit it; Observe < Select < Construct." ;
    cc:source "graphlaw/src/law.rs" .

cc:ax_xa_native_wasm a cc:Axiom ;
    cc:title "The native ABI and the wasm module return byte-identical responses for the same request." ;
    cc:source "graphlaw/docs/abi-reference.md" .

cc:case_xa_reach_n3_vs_owlrl_rdfc a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_reach_n3_vs_owlrl_rdfc" ;
    cc:ordinal 1 ;
    cc:kind "cross-authority" ;
    cc:title "N3 rules and OWL-RL entailment reach the identical RDFC state for the reachability closure" ;
    cc:op "n3+entail" ;
    cc:request "[{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/derived\",\"dialect\":\"turtle\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:requestB "[{\"op\":\"entail\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n:edge rdfs:subPropertyOf :reachable .\\n:reachable a owl:TransitiveProperty .\\n\",\"dialect\":\"turtle\"},\"regime\":\"owl-rl\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:compare "[{\"a\":\"/id\",\"rel\":\"eq\",\"b\":\"/id\"}]" ;
    cc:note "Projection: CONSTRUCT of the :reachable triples, then canonical. The OWL-RL arm uses rdfs:subPropertyOf plus owl:TransitiveProperty." ;
    cc:coversAxiom cc:ax_xa_reach_lfp, cc:ax_xa_n3_chain, cc:ax_xa_owlrl_trans, cc:ax_xa_rdfc_identity ;
    cc:ceiling "construct" .

cc:case_xa_reach_n3_vs_sparql_path_rdfc a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_reach_n3_vs_sparql_path_rdfc" ;
    cc:ordinal 2 ;
    cc:kind "cross-authority" ;
    cc:title "N3 closure and the SPARQL 1.1 edge+ property path reach the identical RDFC state" ;
    cc:op "n3+sparql" ;
    cc:request "[{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/derived\",\"dialect\":\"turtle\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:requestB "[{\"op\":\"sparql\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n\",\"dialect\":\"turtle\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/edge>+ ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:compare "[{\"a\":\"/id\",\"rel\":\"eq\",\"b\":\"/id\"}]" ;
    cc:coversAxiom cc:ax_xa_reach_lfp, cc:ax_xa_n3_chain, cc:ax_xa_sparql_path, cc:ax_xa_rdfc_identity ;
    cc:ceiling "construct" .

cc:case_xa_reach_n3_vs_law_n3_rdfc a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_reach_n3_vs_law_n3_rdfc" ;
    cc:ordinal 3 ;
    cc:kind "cross-authority" ;
    cc:title "N3 op and the law op n3 step reach the identical RDFC state" ;
    cc:op "n3+law" ;
    cc:request "[{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/derived\",\"dialect\":\"turtle\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:requestB "[{\"op\":\"law\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"n3\",\"rules\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"}]},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:compare "[{\"a\":\"/id\",\"rel\":\"eq\",\"b\":\"/id\"}]" ;
    cc:coversAxiom cc:ax_xa_reach_lfp, cc:ax_xa_n3_chain, cc:ax_xa_rdfc_identity ;
    cc:ceiling "construct" .

cc:case_xa_reach_owlrl_vs_law_owlrl_rdfc a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_reach_owlrl_vs_law_owlrl_rdfc" ;
    cc:ordinal 4 ;
    cc:kind "cross-authority" ;
    cc:title "entail owl-rl op and the law op owl-rl step reach the identical RDFC state" ;
    cc:op "entail+law" ;
    cc:request "[{\"op\":\"entail\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n:edge rdfs:subPropertyOf :reachable .\\n:reachable a owl:TransitiveProperty .\\n\",\"dialect\":\"turtle\"},\"regime\":\"owl-rl\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:requestB "[{\"op\":\"law\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n:edge rdfs:subPropertyOf :reachable .\\n:reachable a owl:TransitiveProperty .\\n\",\"dialect\":\"turtle\"},\"steps\":[{\"step\":\"owl-rl\"}]},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:compare "[{\"a\":\"/id\",\"rel\":\"eq\",\"b\":\"/id\"}]" ;
    cc:coversAxiom cc:ax_xa_reach_lfp, cc:ax_xa_owlrl_trans, cc:ax_xa_rdfc_identity ;
    cc:ceiling "construct" .

cc:case_xa_reach_datalog_exact_facts a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_reach_datalog_exact_facts" ;
    cc:ordinal 5 ;
    cc:kind "cross-authority" ;
    cc:title "Datalog computes the exact least fixpoint of edge/reachable (Souffle transitive-closure shape)" ;
    cc:op "datalog" ;
    cc:request "{\"op\":\"datalog\",\"rules\":[{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?y\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/edge\",\"?y\"]]},{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?z\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?y\"],[\"?y\",\"https://chicago.graphlaw.dev/edge\",\"?z\"]]}],\"facts\":[[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/d\"]]}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/count\",\"eq\":13},{\"ptr\":\"/facts\",\"eq\":[[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"]]}]" ;
    cc:byteIdentity true ;
    cc:note "UNSUPPORTED[datalog-canonical-projection]: Datalog returns facts, not an RDF graph, so its arm is compared by exact sorted facts rather than by RDFC id." ;
    cc:coversAxiom cc:ax_xa_reach_lfp, cc:ax_xa_native_wasm ;
    cc:ceiling "construct" .

cc:case_xa_reach_n3_derived_closure_text a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_reach_n3_derived_closure_text" ;
    cc:ordinal 6 ;
    cc:kind "cross-authority" ;
    cc:title "n3 op derives all nine reachable pairs including the cycle-induced b-reaches-b and c-reaches-c" ;
    cc:op "n3" ;
    cc:request "{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/derived\",\"contains\":\":a :reachable :d .\"},{\"ptr\":\"/derived\",\"contains\":\":b :reachable :b .\"},{\"ptr\":\"/derived\",\"contains\":\":c :reachable :c .\"}]" ;
    cc:byteIdentity true ;
    cc:coversAxiom cc:ax_xa_reach_lfp, cc:ax_xa_n3_chain, cc:ax_xa_native_wasm ;
    cc:ceiling "construct" .

cc:case_xa_reach_owlrl_entail_closure a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_reach_owlrl_entail_closure" ;
    cc:ordinal 7 ;
    cc:kind "cross-authority" ;
    cc:title "entail owl-rl materializes the closure with a fixed added-triple count" ;
    cc:op "entail" ;
    cc:request "{\"op\":\"entail\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n:edge rdfs:subPropertyOf :reachable .\\n:reachable a owl:TransitiveProperty .\\n\",\"dialect\":\"turtle\"},\"regime\":\"owl-rl\"}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/added\",\"eq\":115},{\"ptr\":\"/nquads\",\"contains\":\"<https://chicago.graphlaw.dev/a> <https://chicago.graphlaw.dev/reachable> <https://chicago.graphlaw.dev/d> .\"},{\"ptr\":\"/nquads\",\"contains\":\"<https://chicago.graphlaw.dev/c> <https://chicago.graphlaw.dev/reachable> <https://chicago.graphlaw.dev/c> .\"}]" ;
    cc:byteIdentity true ;
    cc:coversAxiom cc:ax_xa_reach_lfp, cc:ax_xa_owlrl_trans, cc:ax_xa_native_wasm ;
    cc:ceiling "construct" .

cc:case_xa_reach_sparql_count_n3_vs_owlrl a cc:CrossAuthorityCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_reach_sparql_count_n3_vs_owlrl" ;
    cc:ordinal 8 ;
    cc:kind "cross-authority" ;
    cc:title "SPARQL COUNT over the N3 closure equals COUNT over the OWL-RL closure" ;
    cc:op "n3+entail+sparql" ;
    cc:request "[{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/derived\",\"dialect\":\"turtle\"},\"query\":\"SELECT (COUNT(*) AS ?n) WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"}]" ;
    cc:requestB "[{\"op\":\"entail\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n:edge rdfs:subPropertyOf :reachable .\\n:reachable a owl:TransitiveProperty .\\n\",\"dialect\":\"turtle\"},\"regime\":\"owl-rl\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"SELECT (COUNT(*) AS ?n) WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/0/value\",\"eq\":\"9\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/rows/0/0/value\",\"eq\":\"9\"}]" ;
    cc:compare "[{\"a\":\"/rows\",\"rel\":\"eq\",\"b\":\"/rows\"}]" ;
    cc:coversAxiom cc:ax_xa_reach_lfp, cc:ax_xa_sparql_ask, cc:ax_xa_rdfc_identity ;
    cc:ceiling "construct" .

cc:case_xa_inv_n3_statement_order a cc:InvarianceCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_inv_n3_statement_order" ;
    cc:ordinal 20 ;
    cc:kind "invariance" ;
    cc:title "N3 closure RDFC id is invariant to statement order (facts and rules reversed)" ;
    cc:op "n3" ;
    cc:request "[{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/derived\",\"dialect\":\"turtle\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:requestB "[{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:c :edge :d .\\n:c :edge :b .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n:b :edge :c .\\n:a :edge :b .\\n\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/derived\",\"dialect\":\"turtle\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:compare "[{\"a\":\"/id\",\"rel\":\"eq\",\"b\":\"/id\"}]" ;
    cc:coversAxiom cc:ax_xa_order_inv, cc:ax_xa_n3_chain, cc:ax_xa_rdfc_identity ;
    cc:ceiling "construct" .

cc:case_xa_inv_datalog_fact_rule_order a cc:InvarianceCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_inv_datalog_fact_rule_order" ;
    cc:ordinal 21 ;
    cc:kind "invariance" ;
    cc:title "Datalog fixpoint is invariant to fact order and rule order" ;
    cc:op "datalog" ;
    cc:request "{\"op\":\"datalog\",\"rules\":[{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?y\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/edge\",\"?y\"]]},{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?z\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?y\"],[\"?y\",\"https://chicago.graphlaw.dev/edge\",\"?z\"]]}],\"facts\":[[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/d\"]]}" ;
    cc:requestB "{\"op\":\"datalog\",\"rules\":[{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?z\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?y\"],[\"?y\",\"https://chicago.graphlaw.dev/edge\",\"?z\"]]},{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?y\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/edge\",\"?y\"]]}],\"facts\":[[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"]]}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/facts\",\"eq\":[[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"]]}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/facts\",\"eq\":[[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"]]}]" ;
    cc:compare "[{\"a\":\"/facts\",\"rel\":\"eq\",\"b\":\"/facts\"}]" ;
    cc:coversAxiom cc:ax_xa_order_inv, cc:ax_xa_reach_lfp ;
    cc:ceiling "construct" .

cc:case_xa_inv_owlrl_statement_order a cc:InvarianceCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_inv_owlrl_statement_order" ;
    cc:ordinal 22 ;
    cc:kind "invariance" ;
    cc:title "OWL-RL closure RDFC id is invariant to statement order" ;
    cc:op "entail" ;
    cc:request "[{\"op\":\"entail\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n:edge rdfs:subPropertyOf :reachable .\\n:reachable a owl:TransitiveProperty .\\n\",\"dialect\":\"turtle\"},\"regime\":\"owl-rl\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:requestB "[{\"op\":\"entail\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n:edge rdfs:subPropertyOf :reachable .\\n:reachable a owl:TransitiveProperty .\\n:c :edge :d .\\n:c :edge :b .\\n:b :edge :c .\\n:a :edge :b .\\n\",\"dialect\":\"turtle\"},\"regime\":\"owl-rl\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":9},{\"ptr\":\"/id\",\"eq\":\"sha256:07f321dfa2119518c580fb235466a1c28d90a677e9c459cbbb8417ddf1c37e52\"}]" ;
    cc:compare "[{\"a\":\"/id\",\"rel\":\"eq\",\"b\":\"/id\"}]" ;
    cc:coversAxiom cc:ax_xa_order_inv, cc:ax_xa_owlrl_trans, cc:ax_xa_rdfc_identity ;
    cc:ceiling "construct" .

cc:case_xa_inv_canonical_bnode_labels a cc:InvarianceCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_inv_canonical_bnode_labels" ;
    cc:ordinal 23 ;
    cc:kind "invariance" ;
    cc:title "RDFC id is invariant to blank node relabeling" ;
    cc:op "canonical" ;
    cc:request "{\"op\":\"canonical\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n_:x :edge :b . _:x :edge _:y .\",\"dialect\":\"turtle\"}}" ;
    cc:requestB "{\"op\":\"canonical\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n_:q :edge _:r . _:q :edge :b .\",\"dialect\":\"turtle\"}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":2},{\"ptr\":\"/id\",\"eq\":\"sha256:29daf608ef3e3ce61827ab7467bff8dab3ea241d92297b704872c3bef2e4bbbd\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":2}]" ;
    cc:compare "[{\"a\":\"/id\",\"rel\":\"eq\",\"b\":\"/id\"}]" ;
    cc:coversAxiom cc:ax_xa_rdfc_identity, cc:ax_xa_order_inv ;
    cc:ceiling "observe" .

cc:case_xa_inv_canonical_serialization a cc:InvarianceCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_inv_canonical_serialization" ;
    cc:ordinal 24 ;
    cc:kind "invariance" ;
    cc:title "RDFC id is invariant to serialization dialect (Turtle vs N-Triples)" ;
    cc:op "canonical" ;
    cc:request "{\"op\":\"canonical\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\",\"dialect\":\"turtle\"}}" ;
    cc:requestB "{\"op\":\"canonical\",\"data\":{\"text\":\"<https://chicago.graphlaw.dev/a> <https://chicago.graphlaw.dev/edge> <https://chicago.graphlaw.dev/b> .\\n\",\"dialect\":\"ntriples\"}}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/id\",\"eq\":\"sha256:f588e41d5d04256bb065a5070ea12b1a6b2acb44620994d31c939c75ff35954f\"}]" ;
    cc:expectB "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":1}]" ;
    cc:compare "[{\"a\":\"/id\",\"rel\":\"eq\",\"b\":\"/id\"}]" ;
    cc:coversAxiom cc:ax_xa_rdfc_identity, cc:ax_xa_order_inv ;
    cc:ceiling "observe" .

cc:case_xa_mut_n3_drop_edge_cd a cc:BoundaryMutationCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_mut_n3_drop_edge_cd" ;
    cc:ordinal 30 ;
    cc:kind "boundary-mutation" ;
    cc:title "N3 negative control: dropping edge c-to-d shrinks the closure from nine pairs to six" ;
    cc:op "n3" ;
    cc:request "[{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/derived\",\"dialect\":\"turtle\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":6}]" ;
    cc:mutates cc:case_xa_reach_n3_vs_owlrl_rdfc ;
    cc:note "Base case pins quads 9 and the ID9 hash. This control must differ from it." ;
    cc:coversAxiom cc:ax_xa_mutation_sensitivity, cc:ax_xa_n3_chain ;
    cc:ceiling "construct" .

cc:case_xa_mut_owlrl_drop_edge_cd a cc:BoundaryMutationCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_mut_owlrl_drop_edge_cd" ;
    cc:ordinal 31 ;
    cc:kind "boundary-mutation" ;
    cc:title "OWL-RL negative control: dropping edge c-to-d shrinks the closure to six pairs" ;
    cc:op "entail" ;
    cc:request "[{\"op\":\"entail\",\"data\":{\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\\n:edge rdfs:subPropertyOf :reachable .\\n:reachable a owl:TransitiveProperty .\\n\",\"dialect\":\"turtle\"},\"regime\":\"owl-rl\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"},\"query\":\"CONSTRUCT { ?x <https://chicago.graphlaw.dev/reachable> ?y } WHERE { ?x <https://chicago.graphlaw.dev/reachable> ?y }\"},{\"op\":\"canonical\",\"data\":{\"text\":\"$PREV:/nquads\",\"dialect\":\"nquads\"}}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/quads\",\"eq\":6}]" ;
    cc:mutates cc:case_xa_reach_owlrl_vs_law_owlrl_rdfc ;
    cc:coversAxiom cc:ax_xa_mutation_sensitivity, cc:ax_xa_owlrl_trans ;
    cc:ceiling "construct" .

cc:case_xa_mut_datalog_drop_edge_cd a cc:BoundaryMutationCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_mut_datalog_drop_edge_cd" ;
    cc:ordinal 32 ;
    cc:kind "boundary-mutation" ;
    cc:title "Datalog negative control: dropping edge c-to-d yields nine facts (three edges plus six reachable)" ;
    cc:op "datalog" ;
    cc:request "{\"op\":\"datalog\",\"rules\":[{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?y\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/edge\",\"?y\"]]},{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?z\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?y\"],[\"?y\",\"https://chicago.graphlaw.dev/edge\",\"?z\"]]}],\"facts\":[[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"]]}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/count\",\"eq\":9},{\"ptr\":\"/facts\",\"eq\":[[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"]]}]" ;
    cc:mutates cc:case_xa_reach_datalog_exact_facts ;
    cc:coversAxiom cc:ax_xa_mutation_sensitivity, cc:ax_xa_reach_lfp ;
    cc:ceiling "construct" .

cc:case_xa_mut_datalog_add_edge_da a cc:BoundaryMutationCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_mut_datalog_add_edge_da" ;
    cc:ordinal 33 ;
    cc:kind "boundary-mutation" ;
    cc:title "Datalog negative control: adding edge d-to-a makes every node reach every node (sixteen reachable facts plus five edges)" ;
    cc:op "datalog" ;
    cc:request "{\"op\":\"datalog\",\"rules\":[{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?y\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/edge\",\"?y\"]]},{\"head\":[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?z\"],\"body\":[[\"?x\",\"https://chicago.graphlaw.dev/reachable\",\"?y\"],[\"?y\",\"https://chicago.graphlaw.dev/edge\",\"?z\"]]}],\"facts\":[[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/d\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/a\"]]}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/count\",\"eq\":21},{\"ptr\":\"/facts\",\"eq\":[[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/a\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/a\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/a\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/b\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/a\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/c\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"],[\"https://chicago.graphlaw.dev/d\",\"https://chicago.graphlaw.dev/edge\",\"https://chicago.graphlaw.dev/a\"],[\"https://chicago.graphlaw.dev/d\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/a\"],[\"https://chicago.graphlaw.dev/d\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/b\"],[\"https://chicago.graphlaw.dev/d\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/c\"],[\"https://chicago.graphlaw.dev/d\",\"https://chicago.graphlaw.dev/reachable\",\"https://chicago.graphlaw.dev/d\"]]}]" ;
    cc:mutates cc:case_xa_reach_datalog_exact_facts ;
    cc:coversAxiom cc:ax_xa_mutation_sensitivity, cc:ax_xa_reach_lfp ;
    cc:ceiling "construct" .

cc:case_xa_pos_shacl_closure_conforms a cc:PositiveCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_pos_shacl_closure_conforms" ;
    cc:ordinal 40 ;
    cc:kind "positive" ;
    cc:title "SHACL: node a satisfies sh:hasValue :d on :reachable after the N3 closure" ;
    cc:op "n3+shacl" ;
    cc:request "[{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"},{\"op\":\"shacl\",\"data\":{\"text\":\"$PREV:/derived\",\"dialect\":\"turtle\"},\"shapes\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n@prefix sh: <http://www.w3.org/ns/shacl#> .\\n:AReachesD a sh:NodeShape ; sh:targetNode :a ; sh:property [ sh:path :reachable ; sh:hasValue :d ] .\\n\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/conforms\",\"eq\":true},{\"ptr\":\"/results\",\"len\":0}]" ;
    cc:coversAxiom cc:ax_xa_shacl_conf, cc:ax_xa_n3_chain ;
    cc:ceiling "construct" .

cc:case_xa_pos_sparql_ask_ad a cc:PositiveCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_pos_sparql_ask_ad" ;
    cc:ordinal 41 ;
    cc:kind "positive" ;
    cc:title "SPARQL ASK: a reaches d in the N3 closure" ;
    cc:op "n3+sparql" ;
    cc:request "[{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"},{\"op\":\"sparql\",\"data\":{\"text\":\"$PREV:/derived\",\"dialect\":\"turtle\"},\"query\":\"ASK { <https://chicago.graphlaw.dev/a> <https://chicago.graphlaw.dev/reachable> <https://chicago.graphlaw.dev/d> }\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/kind\",\"eq\":\"boolean\"},{\"ptr\":\"/value\",\"eq\":true}]" ;
    cc:coversAxiom cc:ax_xa_sparql_ask, cc:ax_xa_n3_chain ;
    cc:ceiling "construct" .

cc:case_xa_pos_shex_closure_conforms a cc:PositiveCase, cc:Case ;
    cc:court cc:cross_authority_court ;
    cc:caseId "xa_pos_shex_closure_conforms" ;
    cc:ordinal 42 ;
    cc:kind "positive" ;
    cc:title "ShEx: node a conforms to a shape requiring at least one IRI :reachable value after the N3 closure" ;
    cc:op "n3+shex" ;
    cc:request "[{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:a :edge :b .\\n:b :edge :c .\\n:c :edge :b .\\n:c :edge :d .\\n{ ?x :edge ?y } => { ?x :reachable ?y } .\\n{ ?x :reachable ?y . ?y :edge ?z } => { ?x :reachable ?z } .\\n\"},{\"op\":\"shex\",\"data\":{\"text\":\"$PREV:/derived\",\"dialect\":\"turtle\"},\"schema\":\"PREFIX : <https://chicago.graphlaw.dev/> :S { :reachable IRI+ }\",\"map\":\"<https://chicago.graphlaw.dev/a>@<https://chicago.graphlaw.dev/S>\"}]" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/conforms\",\"eq\":true},{\"ptr\":\"/entries/0/status\",\"eq\":\"Conformant\"}]" ;
    cc:coversAxiom cc:ax_xa_shacl_conf ;
    cc:ceiling "construct" .

cc:case_xa_pos_n3_single_rule a cc:PositiveCase, cc:Case ;
