    cc:caseId "xa_pos_n3_single_rule" ;
    cc:ordinal 43 ;
    cc:kind "positive" ;
    cc:title "N3: one implication fires and chains to fixpoint" ;
    cc:op "n3" ;
    cc:request "{\"op\":\"n3\",\"text\":\"@prefix : <https://chicago.graphlaw.dev/> .\\n:weather a :Raining .\\n{ ?x a :Raining } => { ?x a :Cloudy } .\\n{ ?x a :Cloudy } => { ?x a :Observable } .\\n\"}" ;
    cc:expect "[{\"ptr\":\"/ok\",\"eq\":true},{\"ptr\":\"/derived\",\"contains\":\":weather a :Observable .\"}]" ;
