fn run(req: &Value) -> Value {
    serde_json::from_slice(&graphlaw::abi::call(req.to_string().as_bytes()))
        .expect("GraphLaw ABI returns JSON")
}

/// Replace `"$PREV:/ptr"` with the value at `/ptr` in the previous chain response and
/// `"$FILE:rel/path"` with the file text (relative to CARGO_MANIFEST_DIR).
fn substitute(v: &Value, prev: Option<&Value>) -> Value {
    match v {
        Value::String(s) => {
            if let Some(p) = s.strip_prefix("$PREV:") {
                let prev = prev.expect("$PREV in the first request of a chain");
                return prev
                    .pointer(p)
                    .unwrap_or_else(|| panic!("$PREV pointer {p} absent in {prev}"))
                    .clone();
            }
            if let Some(path) = s.strip_prefix("$FILE:") {
                let full = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join(path);
                return Value::String(
                    std::fs::read_to_string(&full)
                        .unwrap_or_else(|e| panic!("$FILE {path}: {e}")),
                );
            }
            v.clone()
        }
        Value::Array(a) => Value::Array(a.iter().map(|x| substitute(x, prev)).collect()),
        Value::Object(m) => Value::Object(
            m.iter()
                .map(|(k, x)| (k.clone(), substitute(x, prev)))
                .collect(),
        ),
        _ => v.clone(),
    }
}

/// Execute one request, or a chain (JSON array); returns the last response.
fn execute(spec: &str) -> Value {
    let parsed: Value = serde_json::from_str(spec).expect("case request is JSON");
    match parsed {
        Value::Array(steps) => {
            let mut prev: Option<Value> = None;
            for step in &steps {
                let req = substitute(step, prev.as_ref());
                prev = Some(run(&req));
            }
            prev.expect("empty request chain")
        }
        single => run(&substitute(&single, None)),
    }
}

fn assert_expect(resp: &Value, expect: &str, label: &str) {
    let list: Value = serde_json::from_str(expect).expect("case expectation is JSON");
    for a in list.as_array().expect("expectation is a JSON array") {
        let ptr = a["ptr"].as_str().expect("assertion has a ptr");
        assert!(ptr.is_empty() || ptr.starts_with('/'), "bad pointer {ptr}");
        let got = resp.pointer(ptr);
        if let Some(want) = a.get("eq") {
            assert_eq!(got, Some(want), "{label}: {ptr} eq; response {resp}");
        } else if let Some(want) = a.get("contains") {
            match got {
                Some(Value::String(s)) => assert!(
                    s.contains(want.as_str().expect("contains needs a string on strings")),
                    "{label}: {ptr} lacks {want}; response {resp}"
                ),
                Some(Value::Array(items)) => assert!(
                    items.contains(want),
                    "{label}: {ptr} lacks {want}; response {resp}"
                ),
                other => panic!("{label}: {ptr} contains on {other:?}; response {resp}"),
            }
        } else if let Some(want) = a.get("len") {
            let len = match got {
                Some(Value::Array(x)) => x.len(),
                Some(Value::String(s)) => s.len(),
                Some(Value::Object(m)) => m.len(),
                other => panic!("{label}: {ptr} len on {other:?}; response {resp}"),
            };
            assert_eq!(Some(len as u64), want.as_u64(), "{label}: {ptr} len; response {resp}");
        } else if a.get("absent") == Some(&Value::Bool(true)) {
            assert!(got.is_none(), "{label}: {ptr} should be absent; response {resp}");
        } else {
            panic!("{label}: unknown assertion form {a}");
        }
    }
}

fn assert_compare(a: &Value, b: &Value, compare: &str) {
    let list: Value = serde_json::from_str(compare).expect("compare is JSON");
    for c in list.as_array().expect("compare is a JSON array") {
        let pa = c["a"].as_str().expect("compare.a");
        let pb = c["b"].as_str().expect("compare.b");
        let va = a.pointer(pa).unwrap_or_else(|| panic!("compare: {pa} absent in {a}"));
        let vb = b.pointer(pb).unwrap_or_else(|| panic!("compare: {pb} absent in {b}"));
        match c["rel"].as_str().expect("compare.rel") {
            "eq" => assert_eq!(va, vb, "compare {pa} eq {pb}"),
            "neq" => assert_ne!(va, vb, "compare {pa} neq {pb}"),
            other => panic!("unknown compare rel {other}"),
        }
    }
}

fn case(
    label: &str,
    req: &str,
    expect: &str,
    req_b: Option<&str>,
    expect_b: Option<&str>,
    compare: Option<&str>,
    byte_identity: bool,
) {
    let a = execute(req);
    assert_expect(&a, expect, label);
    let b = req_b.map(|r| {
        let b = execute(r);
        if let Some(e) = expect_b {
            assert_expect(&b, e, label);
        }
        b
    });
    if let (Some(c), Some(b)) = (compare, b.as_ref()) {
        assert_compare(&a, b, c);
    }
    if byte_identity {
        let parsed: Value = serde_json::from_str(req).expect("case request is JSON");
        assert!(parsed.is_object(), "byteIdentity needs a single request");
        let r = substitute(&parsed, None);
        assert_eq!(
            common::native_bytes(&r),
            common::wasm_bytes(&r),
            "{label}: native and wasm responses differ"
        );
    }
}
