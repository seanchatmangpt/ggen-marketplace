@prefix gg: <https://ggen.dev/ontology/governance-gate#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix earl: <http://www.w3.org/ns/earl#> .

gg:GovernanceGateProfile a dcterms:Standard ;
  dcterms:identifier "ggen.governance-gate/1" ;
  dcterms:title "Deterministic Governance Gate Contract" ;
  dcterms:description "A governance gate is admitted evidence plus executable policy; consequential commitment additionally requires explicit authority and a prepared receipt before DO." .

gg:defaultProfile a prov:Entity ;
  gg:schema "ggen.governance-gate/1" ;
  gg:failClosed true ;
  gg:requiresAdmission true ;
  gg:requiresExplicitAuthority true ;
  gg:requiresPreparedReceipt true ;
  gg:proposalImpliesAuthority false ;
  gg:admissionImpliesAuthority false ;
  gg:authorityImpliesPreparedReceipt false ;
  gg:emitsReplayableReceipt true .

# Public vocabulary anchors. Authority evidence is an ODRL permission, observed
# consequence is a PROV activity/entity relation, verification is an EARL
# assertion. These are reused directly rather than wrapped in private classes.
gg:authorityVocabulary odrl:Permission .
gg:observationVocabulary prov:Entity .
gg:consequenceVocabulary prov:Activity .
gg:verificationVocabulary earl:Assertion .

# Disposable relation residue not supplied by the public vocabularies above.
gg:schema a prov:Entity .
gg:failClosed a prov:Entity .
gg:requiresAdmission a prov:Entity .
gg:requiresExplicitAuthority a prov:Entity .
gg:requiresPreparedReceipt a prov:Entity .
gg:proposalImpliesAuthority a prov:Entity .
gg:admissionImpliesAuthority a prov:Entity .
gg:authorityImpliesPreparedReceipt a prov:Entity .
gg:emitsReplayableReceipt a prov:Entity .
