@prefix gg: <https://ggen.dev/ontology/governance-gate#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gg:GovernanceGateProfileShape a sh:NodeShape ;
  sh:targetObjectsOf gg:schema ;
  sh:closed false .

gg:DefaultProfileShape a sh:NodeShape ;
  sh:targetNode gg:defaultProfile ;
  sh:property [ sh:path gg:schema ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "ggen.governance-gate/1" ] ;
  sh:property [ sh:path gg:failClosed ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
  sh:property [ sh:path gg:requiresAdmission ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
  sh:property [ sh:path gg:requiresExplicitAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
  sh:property [ sh:path gg:requiresPreparedReceipt ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
  sh:property [ sh:path gg:proposalImpliesAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] ;
  sh:property [ sh:path gg:admissionImpliesAuthority ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] ;
  sh:property [ sh:path gg:authorityImpliesPreparedReceipt ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue false ] ;
  sh:property [ sh:path gg:emitsReplayableReceipt ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] .
