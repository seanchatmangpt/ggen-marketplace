@prefix xcb: <https://ggen.dev/ontology/xaas-castle-bridge#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema: <https://schema.org/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

# xcb:* is generator/control metadata. Runtime semantic identity is carried by
# public ontology IRIs; xcb never grants execution authority.
xcb:BridgeContract a rdfs:Class .
xcb:EdgeSpec a rdfs:Class .
xcb:ERRCDecision a rdfs:Class .
xcb:InnovationPrimitive a rdfs:Class .
xcb:PublicOntology a rdfs:Class .
xcb:ProofObligation a rdfs:Class .

xcb:protocol a rdf:Property .
xcb:sequence a rdf:Property .
xcb:edgeName a rdf:Property .
xcb:fromPlane a rdf:Property .
xcb:toPlane a rdf:Property .
xcb:authority a rdf:Property .
xcb:doBoundary a rdf:Property .
xcb:receiptBefore a rdf:Property .
xcb:receiptAfter a rdf:Property .
xcb:replayable a rdf:Property .
xcb:recoveryRequired a rdf:Property .
xcb:publicClass a rdf:Property .
xcb:sourceRepo a rdf:Property .
xcb:sourceSha a rdf:Property .
xcb:packSha a rdf:Property .
xcb:ashR2rmlSha a rdf:Property .
xcb:consumerBaseSha a rdf:Property .
xcb:zeroUnreceiptedActuation a rdf:Property .
xcb:outerTransactionOwnsExternalDo a rdf:Property .
xcb:category a rdf:Property .
xcb:decision a rdf:Property .
xcb:rationale a rdf:Property .
xcb:priority a rdf:Property .
xcb:expectedLeverage a rdf:Property .
xcb:reversibility a rdf:Property .
xcb:consumerFanout a rdf:Property .
xcb:packName a rdf:Property .
xcb:purpose a rdf:Property .
xcb:requirement a rdf:Property .
xcb:ontologyPrefix a rdf:Property .
xcb:ontologyIri a rdf:Property .
xcb:required a rdf:Property .
xcb:ambientCommandPolicy a rdf:Property .

xcb:bridge a xcb:BridgeContract, prov:Plan ;
  dcterms:title "XaaS outer control plane to CASTLE BRCE bridge" ;
  xcb:protocol "CASTLE_PAAS_XAAS_BRIDGE_V2" ;
  xcb:sourceRepo "seanchatmangpt/castle" ;
  xcb:sourceSha "a71801dcc0c0783eb8a4544cbee8b40bb0b30296" ;
  xcb:packSha "238b408c5cf74e8334046165ac87102026bd8c1e" ;
  xcb:ashR2rmlSha "067954ad406fd637fd47646bdb10c4580809c79d" ;
  xcb:consumerBaseSha "5b7fb55ffff02d7434c634ce7d80d54f68fd76e7" ;
  xcb:zeroUnreceiptedActuation true ;
  xcb:outerTransactionOwnsExternalDo false ;
  xcb:recoveryRequired true ;
  xcb:ambientCommandPolicy false .

# Public semantic substrate used by the composed control planes.
xcb:prov a xcb:PublicOntology ; xcb:ontologyPrefix "prov" ; xcb:ontologyIri "http://www.w3.org/ns/prov#" ; xcb:required true .
xcb:odrl a xcb:PublicOntology ; xcb:ontologyPrefix "odrl" ; xcb:ontologyIri "http://www.w3.org/ns/odrl/2/" ; xcb:required true .
xcb:dcat a xcb:PublicOntology ; xcb:ontologyPrefix "dcat" ; xcb:ontologyIri "http://www.w3.org/ns/dcat#" ; xcb:required true .
xcb:dcterms a xcb:PublicOntology ; xcb:ontologyPrefix "dcterms" ; xcb:ontologyIri "http://purl.org/dc/terms/" ; xcb:required true .
xcb:skos a xcb:PublicOntology ; xcb:ontologyPrefix "skos" ; xcb:ontologyIri "http://www.w3.org/2004/02/skos/core#" ; xcb:required true .
xcb:sosa a xcb:PublicOntology ; xcb:ontologyPrefix "sosa" ; xcb:ontologyIri "http://www.w3.org/ns/sosa/" ; xcb:required true .
xcb:shacl a xcb:PublicOntology ; xcb:ontologyPrefix "sh" ; xcb:ontologyIri "http://www.w3.org/ns/shacl#" ; xcb:required true .
xcb:org a xcb:PublicOntology ; xcb:ontologyPrefix "org" ; xcb:ontologyIri "http://www.w3.org/ns/org#" ; xcb:required true .
xcb:schema a xcb:PublicOntology ; xcb:ontologyPrefix "schema" ; xcb:ontologyIri "https://schema.org/" ; xcb:required true .

# The correspondence chain. Exactly one edge is consequential DO.
xcb:edge10 a xcb:EdgeSpec ; xcb:sequence 10 ; xcb:edgeName "public-semantic-projection" ; xcb:fromPlane "XaaS.Ash" ; xcb:toPlane "Xaas.Semantics.Registry" ; xcb:authority "VERIFY_ONLY" ; xcb:doBoundary false ; xcb:receiptBefore false ; xcb:receiptAfter false ; xcb:replayable true ; xcb:publicClass "http://www.w3.org/ns/prov#Entity" .
xcb:edge20 a xcb:EdgeSpec ; xcb:sequence 20 ; xcb:edgeName "outer-admission" ; xcb:fromPlane "Xaas.Semantics.Registry" ; xcb:toPlane "Xaas.Actuation.prepare_external" ; xcb:authority "ADMIT_ONLY" ; xcb:doBoundary false ; xcb:receiptBefore false ; xcb:receiptAfter true ; xcb:replayable true ; xcb:publicClass "http://www.w3.org/ns/prov#Activity" .
xcb:edge30 a xcb:EdgeSpec ; xcb:sequence 30 ; xcb:edgeName "castle-construct" ; xcb:fromPlane "Xaas.Castle.Reactor" ; xcb:toPlane "castle construct manufacture" ; xcb:authority "CONSTRUCT_ONLY" ; xcb:doBoundary false ; xcb:receiptBefore true ; xcb:receiptAfter true ; xcb:replayable true ; xcb:publicClass "http://www.w3.org/ns/prov#Plan" .
xcb:edge40 a xcb:EdgeSpec ; xcb:sequence 40 ; xcb:edgeName "outer-construct-checkpoint" ; xcb:fromPlane "castle construct manufacture" ; xcb:toPlane "Xaas.Actuation.checkpoint_external" ; xcb:authority "RECEIPT_ONLY" ; xcb:doBoundary false ; xcb:receiptBefore true ; xcb:receiptAfter true ; xcb:replayable true ; xcb:publicClass "http://www.w3.org/ns/prov#Entity" .
xcb:edge50 a xcb:EdgeSpec ; xcb:sequence 50 ; xcb:edgeName "nested-brce-do" ; xcb:fromPlane "Xaas.Operations.RouteCastleRun.execute" ; xcb:toPlane "CASTLE BRCE" ; xcb:authority "BRCE_ONLY" ; xcb:doBoundary true ; xcb:receiptBefore true ; xcb:receiptAfter true ; xcb:replayable true ; xcb:recoveryRequired true ; xcb:publicClass "http://www.w3.org/ns/odrl/2/Request" .
xcb:edge60 a xcb:EdgeSpec ; xcb:sequence 60 ; xcb:edgeName "nested-receipt-seal" ; xcb:fromPlane "CASTLE durable evidence" ; xcb:toPlane "Xaas.Actuation.seal_external" ; xcb:authority "RECEIPT_ONLY" ; xcb:doBoundary false ; xcb:receiptBefore true ; xcb:receiptAfter true ; xcb:replayable true ; xcb:publicClass "http://www.w3.org/ns/prov#Entity" .
xcb:edge70 a xcb:EdgeSpec ; xcb:sequence 70 ; xcb:edgeName "crash-recovery-verification" ; xcb:fromPlane "CASTLE evidence verify" ; xcb:toPlane "XaaS outer receipt recovery" ; xcb:authority "VERIFY_ONLY" ; xcb:doBoundary false ; xcb:receiptBefore true ; xcb:receiptAfter true ; xcb:replayable true ; xcb:recoveryRequired true ; xcb:publicClass "http://www.w3.org/ns/prov#Activity" .
xcb:edge80 a xcb:EdgeSpec ; xcb:sequence 80 ; xcb:edgeName "deterministic-replay" ; xcb:fromPlane "XaaS sealed outer receipt" ; xcb:toPlane "caller" ; xcb:authority "VERIFY_ONLY" ; xcb:doBoundary false ; xcb:receiptBefore true ; xcb:receiptAfter true ; xcb:replayable true ; xcb:publicClass "http://www.w3.org/ns/prov#Entity" .

# ERRC is executable/queryable design data, not a slide artifact.
xcb:eliminate10 a xcb:ERRCDecision ; xcb:category "ELIMINATE" ; xcb:priority 10 ; xcb:decision "duplicate CASTLE PaaS Ash resource plane inside XaaS" ; xcb:rationale "XaaS already owns 69 Ash resources and seven domains; compose through the native RouteCastle capability instead" ; xcb:expectedLeverage 9.8 ; xcb:reversibility 1.0 .
xcb:eliminate20 a xcb:ERRCDecision ; xcb:category "ELIMINATE" ; xcb:priority 20 ; xcb:decision "ambient provider command or program input" ; xcb:rationale "server-owned adapter profiles only; graph/model/API data never receives shell authority" ; xcb:expectedLeverage 9.7 ; xcb:reversibility 1.0 .
xcb:eliminate30 a xcb:ERRCDecision ; xcb:category "ELIMINATE" ; xcb:priority 30 ; xcb:decision "fiction that Postgres rollback reverses external BRCE consequences" ; xcb:rationale "external DO uses durable construct checkpoint plus content-addressed CASTLE evidence recovery" ; xcb:expectedLeverage 10.0 ; xcb:reversibility 1.0 .
xcb:reduce10 a xcb:ERRCDecision ; xcb:category "REDUCE" ; xcb:priority 10 ; xcb:decision "handwritten immutable bridge identity and topology" ; xcb:rationale "ggen manufactures contract, edge catalog, SHACL, ERRC and proof surfaces from one RDF source" ; xcb:expectedLeverage 9.6 ; xcb:reversibility 1.0 .
xcb:reduce20 a xcb:ERRCDecision ; xcb:category "REDUCE" ; xcb:priority 20 ; xcb:decision "public mutation surface" ; xcb:rationale "RouteCastleRun remains read-only on JSON:API/GraphQL; execute stays private behind Reactor context" ; xcb:expectedLeverage 9.4 ; xcb:reversibility 1.0 .
xcb:reduce30 a xcb:ERRCDecision ; xcb:category "REDUCE" ; xcb:priority 30 ; xcb:decision "private semantic vocabulary standing" ; xcb:rationale "bridge runtime identities project to published PROV-O, ODRL, DCAT, DCTERMS, SKOS, SOSA, SHACL, ORG and Schema.org IRIs" ; xcb:expectedLeverage 8.9 ; xcb:reversibility 1.0 .
xcb:raise10 a xcb:ERRCDecision ; xcb:category "RAISE" ; xcb:priority 10 ; xcb:decision "exact supplier identity binding" ; xcb:rationale "contract pins CASTLE PaaS source, CASTLE PaaS pack and ash_r2rml source identities" ; xcb:expectedLeverage 9.5 ; xcb:reversibility 1.0 .
xcb:raise20 a xcb:ERRCDecision ; xcb:category "RAISE" ; xcb:priority 20 ; xcb:decision "receipt nesting and replay evidence" ; xcb:rationale "outer XaaS intent/receipt binds the inner CASTLE construct, PREPARE/OUTCOME receipts and durable evidence identity" ; xcb:expectedLeverage 10.0 ; xcb:reversibility 1.0 .
xcb:raise30 a xcb:ERRCDecision ; xcb:category "RAISE" ; xcb:priority 30 ; xcb:decision "ggen-marketplace share of implementation" ; xcb:rationale "static contracts, topology, proof obligations, ERRC, docs and tests are manufactured rather than handwritten" ; xcb:expectedLeverage 9.8 ; xcb:reversibility 1.0 .
xcb:create10 a xcb:ERRCDecision ; xcb:category "CREATE" ; xcb:priority 10 ; xcb:decision "reusable external-consequence control-plane composition" ; xcb:rationale "general pattern: outer durable admission/checkpoint + inner BRCE kernel + nested receipt DAG" ; xcb:expectedLeverage 10.0 ; xcb:reversibility 1.0 .
xcb:create20 a xcb:ERRCDecision ; xcb:category "CREATE" ; xcb:priority 20 ; xcb:decision "crash-recoverable nested receipt DAG" ; xcb:rationale "retry verifies content-addressed evidence before considering any second DO" ; xcb:expectedLeverage 10.0 ; xcb:reversibility 1.0 .
xcb:create30 a xcb:ERRCDecision ; xcb:category "CREATE" ; xcb:priority 30 ; xcb:decision "marketplace innovation composition profile" ; xcb:rationale "bridge composes leverage, option-capital, replay, lineage, consequence IR, causality, certification and Chicago-test packs" ; xcb:expectedLeverage 9.9 ; xcb:reversibility 1.0 .

# Existing marketplace primitives deliberately composed by this pack.
xcb:innovation10 a xcb:InnovationPrimitive ; xcb:packName "composition-leverage-matrix-pack" ; xcb:purpose "maximize reusable composition leverage" ; xcb:expectedLeverage 9.8 ; xcb:consumerFanout 8 .
xcb:innovation20 a xcb:InnovationPrimitive ; xcb:packName "closed-loop-option-capital-pack" ; xcb:purpose "preserve reversible option capital before irreversible selection" ; xcb:expectedLeverage 9.7 ; xcb:consumerFanout 8 .
xcb:innovation30 a xcb:InnovationPrimitive ; xcb:packName "counterfactual-frontier-replay-pack" ; xcb:purpose "treat replay/recovery as a first-class frontier" ; xcb:expectedLeverage 10.0 ; xcb:consumerFanout 8 .
xcb:innovation40 a xcb:InnovationPrimitive ; xcb:packName "capability-lineage-propagation-pack" ; xcb:purpose "propagate source and consequence identities" ; xcb:expectedLeverage 9.5 ; xcb:consumerFanout 8 .
xcb:innovation50 a xcb:InnovationPrimitive ; xcb:packName "consequence-ir-pack" ; xcb:purpose "name the consequence before actuation" ; xcb:expectedLeverage 9.9 ; xcb:consumerFanout 8 .
xcb:innovation60 a xcb:InnovationPrimitive ; xcb:packName "control-plane-causality-observability-pack" ; xcb:purpose "make nested control-plane causality observable" ; xcb:expectedLeverage 9.6 ; xcb:consumerFanout 8 .
xcb:innovation70 a xcb:InnovationPrimitive ; xcb:packName "certification-assist-evidence-control-pack" ; xcb:purpose "bind qualification evidence to the exact admitted subject" ; xcb:expectedLeverage 9.5 ; xcb:consumerFanout 8 .
xcb:innovation80 a xcb:InnovationPrimitive ; xcb:packName "chicago-tdd-tools-pack" ; xcb:purpose "qualify with real Postgres, Ash, Reactor and exact CASTLE binary" ; xcb:expectedLeverage 9.8 ; xcb:consumerFanout 8 .
xcb:innovation90 a xcb:InnovationPrimitive ; xcb:packName "ash-reactor-domain-error-contract-pack" ; xcb:purpose "keep Reactor failure/refusal typed and non-ambient" ; xcb:expectedLeverage 9.6 ; xcb:consumerFanout 8 .
xcb:innovation100 a xcb:InnovationPrimitive ; xcb:packName "consumer-realization-frontier-pack" ; xcb:purpose "qualify the consumer consequence, not only the producer pack" ; xcb:expectedLeverage 9.7 ; xcb:consumerFanout 8 .

xcb:proof10 a xcb:ProofObligation ; xcb:sequence 10 ; xcb:requirement "exactly one xcb:EdgeSpec has xcb:doBoundary true" .
xcb:proof20 a xcb:ProofObligation ; xcb:sequence 20 ; xcb:requirement "the sole DO edge has authority BRCE_ONLY and both pre/post receipt evidence" .
xcb:proof30 a xcb:ProofObligation ; xcb:sequence 30 ; xcb:requirement "all four ERRC categories are present" .
xcb:proof40 a xcb:ProofObligation ; xcb:sequence 40 ; xcb:requirement "ambient command policy is false" .
xcb:proof50 a xcb:ProofObligation ; xcb:sequence 50 ; xcb:requirement "recovery verification precedes any repeated external DO attempt" .
