---
to: "generated/castle_bridge/innovation.json"
skip_empty: false
sparql:
  results: |
    PREFIX xcb: <https://ggen.dev/ontology/xaas-castle-bridge#>
    SELECT ?packName ?purpose ?expectedLeverage ?consumerFanout WHERE {
      ?i a xcb:InnovationPrimitive ; xcb:packName ?packName ; xcb:purpose ?purpose ;
        xcb:expectedLeverage ?expectedLeverage ; xcb:consumerFanout ?consumerFanout .
    } ORDER BY DESC(?expectedLeverage) ?packName
---
{
  "standing": "PARTIAL_ALIVE",
  "authority": "SELECT|CONSTRUCT|VERIFY",
  "actuation_performed": false,
  "compositions": [
{% for row in results %}    {"pack":"{{ row["packName"] }}","purpose":"{{ row["purpose"] }}","expected_leverage":{{ row["expectedLeverage"] }},"consumer_fanout":{{ row["consumerFanout"] }}}{% if not loop.last %},{% endif %}
{% endfor %}  ]
}
