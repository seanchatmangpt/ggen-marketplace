---
to: "lib/xaas/generated/castle_bridge_contract.ex"
skip_empty: false
for_each: results
sparql:
  results: |
    PREFIX xcb: <https://ggen.dev/ontology/xaas-castle-bridge#>
    SELECT ?protocol ?sourceRepo ?sourceSha ?packSha ?ashR2rmlSha ?consumerBaseSha ?zero ?outerOwns ?recovery WHERE {
      xcb:bridge a xcb:BridgeContract ;
        xcb:protocol ?protocol ; xcb:sourceRepo ?sourceRepo ; xcb:sourceSha ?sourceSha ;
        xcb:packSha ?packSha ; xcb:ashR2rmlSha ?ashR2rmlSha ; xcb:consumerBaseSha ?consumerBaseSha ;
        xcb:zeroUnreceiptedActuation ?zero ; xcb:outerTransactionOwnsExternalDo ?outerOwns ;
        xcb:recoveryRequired ?recovery .
    }
---
# GENERATED by ggen-marketplace/xaas-castle-bridge-pack. Do not hand-edit.
defmodule Xaas.Castle.Generated.Contract do
  @identity %{
    protocol: "{{ protocol }}",
    castle_repo: "{{ sourceRepo }}",
    castle_paas_source_sha: "{{ sourceSha }}",
    castle_paas_pack_sha: "{{ packSha }}",
    ash_r2rml_sha: "{{ ashR2rmlSha }}",
    xaas_base_sha: "{{ consumerBaseSha }}",
    zero_unreceipted_actuation: {{ zero }},
    outer_transaction_owns_external_do: {{ outerOwns }},
    recovery_required: {{ recovery }},
    xaas_actuation: "public-ontology->durable-admission/prepared-receipt->construct-checkpoint->external-reactor->sealed-receipt->replay",
    castle_actuation: "construct->admission->brce-prepare->do->brce-outcome->content-addressed-evidence->verify/recover"
  }

  def identity, do: @identity
end
