---
to: "priv/semantic/generated/castle_bridge_shacl.ttl"
skip_empty: false
for_each: results
sparql:
  results: |
    PREFIX xcb: <https://ggen.dev/ontology/xaas-castle-bridge#>
    SELECT ?protocol WHERE { xcb:bridge xcb:protocol ?protocol . }
---
# GENERATED by ggen-marketplace/xaas-castle-bridge-pack. Do not hand-edit.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xcb: <https://ggen.dev/ontology/xaas-castle-bridge#> .

xcb:BridgeShape a sh:NodeShape ;
  sh:targetClass prov:Plan ;
  sh:property [ sh:path xcb:protocol ; sh:hasValue "{{ protocol }}" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path xcb:zeroUnreceiptedActuation ; sh:hasValue true ; sh:minCount 1 ] ;
  sh:property [ sh:path xcb:outerTransactionOwnsExternalDo ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path xcb:ambientCommandPolicy ; sh:hasValue false ; sh:minCount 1 ] .

xcb:DoEdgeShape a sh:NodeShape ;
  sh:targetSubjectsOf xcb:doBoundary ;
  sh:or (
    [ sh:property [ sh:path xcb:doBoundary ; sh:hasValue false ] ]
    [ sh:and (
        [ sh:property [ sh:path xcb:authority ; sh:hasValue "BRCE_ONLY" ] ]
        [ sh:property [ sh:path xcb:receiptBefore ; sh:hasValue true ] ]
        [ sh:property [ sh:path xcb:receiptAfter ; sh:hasValue true ] ]
      ) ]
  ) .
