---
to: "lib/xaas/castle.ex"
sparql:
  results: |
    PREFIX xcb: <https://ggen.dev/ontology/xaas-castle-bridge#>
    SELECT ?protocol ?sourceSha ?packSha ?ashR2rmlSha WHERE {
      xcb:bridge a xcb:BridgeContract ; xcb:protocol ?protocol ; xcb:sourceSha ?sourceSha ;
        xcb:packSha ?packSha ; xcb:ashR2rmlSha ?ashR2rmlSha .
    }
for_each: results
inject: true
after:
  pattern: '^\s*@protocol\s+"CASTLE_PAAS_XAAS_BRIDGE_V1"\s*$'
  matcher: regex
  scope: line
  occurrence: unique
skip_if:
  pattern: "GGEN:XAAS_CASTLE_CONTRACT:BEGIN"
  matcher: contains
  scope: file
  occurrence: first
skip_empty: false
---
  # GGEN:XAAS_CASTLE_CONTRACT:BEGIN
  # Marketplace-owned immutable contract override. Do not hand-edit.
  @castle_paas_source_sha "{{ sourceSha }}"
  @castle_paas_pack_sha "{{ packSha }}"
  @ash_r2rml_sha "{{ ashR2rmlSha }}"
  @protocol :"{{ protocol }}"
  # GGEN:XAAS_CASTLE_CONTRACT:END
