# MESSAGE: bridge edge runtime classes must terminate in admitted public ontology namespaces
PREFIX xcb: <https://ggen.dev/ontology/xaas-castle-bridge#>
SELECT ?edge ?class WHERE {
  ?edge a xcb:EdgeSpec ; xcb:publicClass ?class .
  FILTER NOT EXISTS {
    ?ontology a xcb:PublicOntology ; xcb:ontologyIri ?namespace .
    FILTER(STRSTARTS(STR(?class), STR(?namespace)))
  }
}
