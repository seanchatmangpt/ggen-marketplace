# MESSAGE: external consequential DO requires an explicit durable recovery proof path
PREFIX xcb: <https://ggen.dev/ontology/xaas-castle-bridge#>
SELECT ?edge WHERE {
  xcb:bridge a xcb:BridgeContract ; xcb:outerTransactionOwnsExternalDo false .
  ?edge a xcb:EdgeSpec ; xcb:doBoundary true .
  FILTER NOT EXISTS { ?edge xcb:recoveryRequired true . }
}
