PREFIX xcb: <https://ggen.dev/ontology/xaas-castle-bridge#>
SELECT ?edge ?authority ?before ?after WHERE {
  ?edge a xcb:EdgeSpec ; xcb:doBoundary true ; xcb:authority ?authority ; xcb:receiptBefore ?before ; xcb:receiptAfter ?after .
  FILTER (?authority != "BRCE_ONLY" || ?before != true || ?after != true)
}
