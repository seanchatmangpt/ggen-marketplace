# MESSAGE: bridge suppliers and consumer base must be exact lowercase Git SHA-1 identities
PREFIX xcb: <https://ggen.dev/ontology/xaas-castle-bridge#>
SELECT ?sourceSha ?packSha ?ashR2rmlSha ?consumerBaseSha WHERE {
  xcb:bridge a xcb:BridgeContract ;
    xcb:sourceSha ?sourceSha ;
    xcb:packSha ?packSha ;
    xcb:ashR2rmlSha ?ashR2rmlSha ;
    xcb:consumerBaseSha ?consumerBaseSha .
  FILTER (
    !REGEX(STR(?sourceSha), "^[0-9a-f]{40}$") ||
    !REGEX(STR(?packSha), "^[0-9a-f]{40}$") ||
    !REGEX(STR(?ashR2rmlSha), "^[0-9a-f]{40}$") ||
    !REGEX(STR(?consumerBaseSha), "^[0-9a-f]{40}$")
  )
}
