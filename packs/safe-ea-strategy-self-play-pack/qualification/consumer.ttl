@prefix sp: <https://ggen.dev/ontology/self-play#> .

# Minimal deterministic, no-DO positive fixture for marketplace manufacture.
sp:QualificationProgram
    a sp:SelfPlayProgram ;
    sp:programId "marketplace-qualification" ;
    sp:executionMode sp:DeterministicRuleSelfPlay ;
    sp:llmCalls 0 ;
    sp:directActuation false ;
    sp:requiredBroker "BRCE" ;
    sp:hasScenario sp:QualificationScenario ;
    sp:witness "synthetic-witness" ;
    sp:falsifier "qualification-gate-refusal" ;
    sp:independentVerifier "evidence-verifier" ;
    sp:receiptVerifier "receipt-verifier" ;
    sp:replayCommand "ggen sync run" .

sp:QualificationScenario
    a sp:Scenario ;
    sp:scenarioId "qualification-scenario" ;
    sp:maxRounds 1 ;
    sp:coversUseCase sp:SafePortfolioEpicFunnel,
                     sp:SafePiPlanning,
                     sp:SafeDependencyResolution,
                     sp:SafeArchitectureRunway,
                     sp:SafeSystemDemoReleaseGate,
                     sp:SafeInspectAndAdapt,
                     sp:EaOperatingModel,
                     sp:EaCoreDiagram,
                     sp:EaDigitizedPlatform,
                     sp:EaEngagementModel,
                     sp:EaValueRealization,
                     sp:EaTransitionArchitecture ;
    sp:hasPolicy sp:QualificationVerifierPolicy ;
    sp:hasAction sp:QualificationVerifyAction ;
    sp:hasInitialMetric sp:QualificationInitial ;
    sp:hasInvariant sp:QualificationInvariant ;
    sp:hasGoal sp:QualificationGoal .

sp:QualificationVerifierPolicy
    a sp:ActorPolicy ;
    sp:actorRole sp:EvidenceVerifier ;
    sp:minimumUtility 0 ;
    sp:hasWeight sp:QualificationWeight ;
    sp:authorityToken "qualification-only" .

sp:QualificationVerifyAction
    a sp:Action ;
    sp:actionId "verify" ;
    sp:actorRole sp:EvidenceVerifier ;
    sp:choiceGroup "qualification" ;
    sp:brokerIntent false ;
    sp:hasEffect sp:QualificationEffect ;
    sp:requiresAuthority "qualification-only" ;
    sp:hasEvidence sp:QualificationEvidence .

sp:QualificationInitial a sp:Metric .
sp:QualificationInvariant a sp:Invariant .
sp:QualificationGoal a sp:Goal .
sp:QualificationWeight a sp:UtilityWeight .
sp:QualificationEffect a sp:Effect .
sp:QualificationEvidence a sp:Evidence .
