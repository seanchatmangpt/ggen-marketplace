---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch12",
  "files_and_dirs": {
    "README.md": true,
    "budget-guardrails.yaml": true,
    "checkout-api-hpa.yaml": true,
    "checkout-api-vpa.yaml": true,
    "cost-alerts.yaml": true,
    "cost-allocation-labels.py": true,
    "cost-analyzer.py": true,
    "cost-anomaly-detector.py": true,
    "cost-labeling-examples.yaml": true,
    "exercise-12-1-setup.sh": true,
    "ggen-create.json": true,
    "hpa-config.yaml": true,
    "install-kubecost.sh": true,
    "install-opencost.sh": true,
    "karpenter-provisioner.yaml": true,
    "kubecost-cost-allocation.yaml": true,
    "kyverno-require-resources.yaml": true,
    "node-pool-strategy.yaml": true,
    "opencost-cost-allocation.yaml": true,
    "pod-disruption-budget.yaml": true,
    "spot-instance-handler.yaml": true,
    "test-cost-optimization.py": true,
    "vpa-config.yaml": true
  },
  "templatize_using_name": "{% endraw %}{{ row.capitalized }}{% raw %}",
  "gen_parent_dir": false
}
{% endraw %}