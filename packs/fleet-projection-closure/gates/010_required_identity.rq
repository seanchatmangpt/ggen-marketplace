PREFIX fp: <https://ggen.dev/ontology/fleet-projection#>
SELECT ?p ?reason WHERE { ?p a fp:Projection . { FILTER NOT EXISTS { ?p fp:subject ?s } BIND("missing subject" AS ?reason) } UNION { FILTER NOT EXISTS { ?p fp:consumer ?c } BIND("missing consumer" AS ?reason) } UNION { FILTER NOT EXISTS { ?p fp:family ?f } BIND("missing family" AS ?reason) } }
