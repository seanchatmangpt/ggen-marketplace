PREFIX fp: <https://ggen.dev/ontology/fleet-projection#>
SELECT ?subject ?consumer ?family ?repo ?path ?sourceRepo ?sourceSha WHERE {
 ?p a fp:Projection ; fp:subject ?subject ; fp:consumer ?consumer ; fp:family ?family ; fp:targetRepository ?repo ; fp:targetPath ?path ; fp:sourceRepository ?sourceRepo ; fp:sourceSha ?sourceSha ; fp:authority "NONE" .
}
ORDER BY ?consumer ?family ?path
