<%
# ggen_igniter EEx template -> test/beam4pm_rf2_conformance_test.exs
#
# Chicago-style qualification: every collaborator is REAL - the real
# generated module (bound as module_name below), the real compiled oracle
# binary (bound as oracle_name), the real canonical dataset (bound as
# dataset_path), a real on-disk mutated copy of it, and real receipt files
# on disk. No mocks anywhere in this suite.
#
# Bindings: oracle_name, wire_op, dataset_path, module_name (same "spec"
# query as beam4pm_rf2_conformance.ex.eex).
%># GENERATED by ggen_igniter from the admitted rf2:AdmittedOracleStream graph. Do not edit.
defmodule <%= module_name %>Test do
  use ExUnit.Case, async: false

  @moduletag :tmp_dir

  # Resolved from RF2_ORACLE_BIN / RF2_CLEAN_XES / RF2_MUTATED_XES env vars
  # (set by this stream's own scratch verification harness) so this test
  # module has no hardcoded absolute paths of its own - a real, portable
  # qualification suite, not one wired to one machine's scratch layout.
  defp oracle_bin, do: System.fetch_env!("RF2_ORACLE_BIN")
  defp clean_xes, do: System.fetch_env!("RF2_CLEAN_XES")
  defp mutated_xes, do: System.fetch_env!("RF2_MUTATED_XES")

  describe "real clean conformance check against <%= dataset_path %>" do
    test "matches the exact real observed fitness/place/transition constants", %{tmp_dir: dir} do
      assert {:ok, out} =
               <%= module_name %>.run(oracle_bin(), clean_xes(), mutated_xes(),
                 receipts_dir: dir,
                 run_id: "clean-ok"
               )

      expected = <%= module_name %>.expected_clean_fitness()

      assert_in_delta out.clean["log_fitness"], expected.log_fitness, 1.0e-9
      assert_in_delta out.clean["average_fitness"], expected.average_fitness, 1.0e-9
      assert_in_delta out.clean["perfectly_fitting_frac"], expected.perfectly_fitting_frac, 1.0e-9
      assert out.clean["total_costs"] == expected.total_costs

      assert File.exists?(out.receipt_path)
      receipt = out.receipt_path |> File.read!() |> JSON.decode!()
      assert receipt["receipt_schema"] == "beam4pm-rf2-conformance/v1"
      assert receipt["outcome"] == "checked"
      assert receipt["clean"]["model_place_count"] == expected.model_place_count
      assert receipt["clean"]["model_transition_count"] == expected.model_transition_count
      assert receipt["clean"]["num_variants_aligned"] == expected.num_variants_aligned
    end
  end

  describe "real falsify discrimination against a mutated log, SAME fixed clean model" do
    test "the mutated run's fitness is measurably (and strictly) lower than the clean run's", %{
      tmp_dir: dir
    } do
      assert {:ok, out} =
               <%= module_name %>.run(oracle_bin(), clean_xes(), mutated_xes(),
                 receipts_dir: dir,
                 run_id: "falsify-discriminates"
               )

      # A real, observed, strictly-positive numeric difference - not "the
      # numbers merely differ" (they could differ in either direction by
      # chance; this pipeline requires clean > mutated specifically).
      assert out.log_fitness_delta > 0.0
      assert out.average_fitness_delta > 0.0

      assert out.clean["log_fitness"] > out.falsify["log_fitness"]
      assert out.clean["average_fitness"] > out.falsify["average_fitness"]

      # Same fixed model on both sides of the comparison (falsify aligned
      # the mutated log against the model discovered from the CLEAN log,
      # per model_xes_path) - this is what makes the drop meaningful rather
      # than an artifact of re-discovering a different model each time.
      # (model_place_count/model_transition_count are top-level result
      # fields, not part of the fitness sub-map `out.falsify` holds - read
      # them from the real receipt, which persists the full result.)
      expected = <%= module_name %>.expected_clean_fitness()
      receipt = out.receipt_path |> File.read!() |> JSON.decode!()
      assert receipt["falsify"]["model_place_count"] == expected.model_place_count
      assert receipt["falsify"]["model_transition_count"] == expected.model_transition_count
      assert receipt["falsify_discrimination"]["log_fitness_delta"] > 0.0
      assert receipt["falsify_discrimination"]["average_fitness_delta"] > 0.0
    end
  end

  describe "compensate/2: an oracle crash never produces a silent failure" do
    test "a nonexistent oracle binary path is refused with a real receipt, not a crash", %{
      tmp_dir: dir
    } do
      bogus_oracle = Path.join(dir, "definitely_not_a_real_oracle_binary")

      assert {:error, {:oracle_failed, _reason}} =
               <%= module_name %>.run(bogus_oracle, clean_xes(), mutated_xes(),
                 receipts_dir: dir,
                 run_id: "crash-refused"
               )

      receipt_path = Path.join(dir, "crash-refused.json")
      assert File.exists?(receipt_path)
      receipt = receipt_path |> File.read!() |> JSON.decode!()
      assert receipt["receipt_schema"] == "beam4pm-rf2-conformance/v1"
      assert receipt["outcome"] == "refused"
      assert receipt["oracle_bin"] == bogus_oracle
      assert receipt["clean"] == nil
      assert receipt["falsify"] == nil
    end
  end
end
