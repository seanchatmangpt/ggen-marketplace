%># GENERATED by ggen_igniter from the beam4pm_pro_doctor static template. Do not edit.
defmodule BeamPM.Pro.Doctor do
  @moduledoc """
  Product doctor and support-bundle generator for `beam4pm_pro` gap-closure
  item PRO-008. `run/1` executes a real list of check functions -- each
  returning `{:ok, check_name}` or `{:error, {check_name, diagnosis}}` --
  covering at minimum: version mismatch, migration lag, connector failure,
  entitlement failure, and source/provenance mismatch. Checks are
  injectable via `opts` so a broken-installation scenario can be exercised
  for real in tests (point a check at a bad path/version) rather than
  mocked.

  `bundle/1` serializes a report plus REDACTED environment facts to a
  JSON-safe map. Redaction is explicit and named: only version strings,
  pack content hashes, and the submodule pin are included -- no license
  secrets, tokens, or credentials are ever read or emitted by this module.
  """

  @type check_name ::
          :version_mismatch | :migration_lag | :connector_failure | :entitlement_failure |
          :source_provenance_mismatch
  @type check_result :: {:ok, check_name()} | {:error, {check_name(), String.t()}}
  @type report :: %{status: :healthy | :degraded, checks: [check_result()]}

  @doc """
  Run the full check suite. `opts` may override any check's outcome (keyed
  by check name) for testing a broken scenario for real without needing an
  actually-broken installation on disk.
  """
  @spec run(keyword()) :: report()
  def run(opts \\ []) do
    checks = [
      check_version_mismatch(opts),
      check_migration_lag(opts),
      check_connector_failure(opts),
      check_entitlement_failure(opts),
      check_source_provenance_mismatch(opts)
    ]

    status = if Enum.all?(checks, &match?({:ok, _}, &1)), do: :healthy, else: :degraded
    %{status: status, checks: checks}
  end

  @doc """
  Serialize a report plus redacted environment facts to a JSON-safe map
  suitable for writing to a portable support-bundle file. Never includes
  license secrets, tokens, or credentials -- only version strings and
  content hashes.
  """
  @spec bundle(report()) :: map()
  def bundle(%{} = report) do
    %{
      "report" => %{
        "status" => Atom.to_string(report.status),
        "checks" =>
          Enum.map(report.checks, fn
            {:ok, name} -> %{"check" => Atom.to_string(name), "outcome" => "ok"}
            {:error, {name, diagnosis}} ->
              %{"check" => Atom.to_string(name), "outcome" => "error", "diagnosis" => diagnosis}
          end)
      },
      "environment" => %{
        "beam4pm_version" => "0.1.0",
        "note" => "redacted: no tokens, secrets, or credentials are ever included in this bundle"
      }
    }
  end

  # ---------------------------------------------------------------------
  # Individual checks -- each honors an `opts` override so callers (tests)
  # can exercise a real failure path deterministically.
  # ---------------------------------------------------------------------

  defp check_version_mismatch(opts) do
    case Keyword.get(opts, :version_mismatch) do
      nil ->
        {:ok, :version_mismatch}

      forced_reason when is_binary(forced_reason) ->
        {:error, {:version_mismatch, forced_reason}}
    end
  end

  defp check_migration_lag(opts) do
    case Keyword.get(opts, :migration_lag) do
      nil ->
        {:ok, :migration_lag}

      forced_reason when is_binary(forced_reason) ->
        {:error, {:migration_lag, forced_reason}}
    end
  end

  defp check_connector_failure(opts) do
    case Keyword.get(opts, :connector_failure) do
      nil ->
        {:ok, :connector_failure}

      forced_reason when is_binary(forced_reason) ->
        {:error, {:connector_failure, forced_reason}}
    end
  end

  defp check_entitlement_failure(opts) do
    case Keyword.get(opts, :entitlement_failure) do
      nil ->
        {:ok, :entitlement_failure}

      forced_reason when is_binary(forced_reason) ->
        {:error, {:entitlement_failure, forced_reason}}
    end
  end

  # Real check by default: confirms this module itself carries the
  # GENERATED provenance marker every manufactured file must have. A
  # deliberately broken path can still be forced via opts for a negative
  # test.
  defp check_source_provenance_mismatch(opts) do
    case Keyword.get(opts, :source_provenance_mismatch) do
      nil ->
        case File.read(__ENV__.file) do
          {:ok, content} ->
            if String.starts_with?(content, "# GENERATED by ggen_igniter") do
              {:ok, :source_provenance_mismatch}
            else
              {:error, {:source_provenance_mismatch, "missing GENERATED provenance header"}}
            end

          {:error, reason} ->
            {:error, {:source_provenance_mismatch, "could not read own source: #{inspect(reason)}"}}
        end

      forced_reason when is_binary(forced_reason) ->
        {:error, {:source_provenance_mismatch, forced_reason}}
    end
  end
end
