<%
# ggen_igniter EEx template -> test/beam4pm_rf1_dfg_test.exs
#
# STREAM RF1 Chicago qualification. No bindings required (see
# beam4pm_rf1_dfg.ex.eex's header comment) -- both the real oracle binary
# path and the two real canonical dataset paths are fixed for this stream.
%># GENERATED by ggen_igniter from STREAM RF1's fixed dfg-discovery template. Do not edit.
defmodule BeamPM.RF1.DfgDiscoveryTest do
  @moduledoc """
  Chicago-style qualification of STREAM RF1 (`BeamPM.RF1.DfgDiscovery`): a
  real `rf1-dfg-oracle` native binary (real `process_mining` 0.6.2 XES
  import + `log_to_activity_projection` + `discover_dfg` + case_centric
  queries), invoked through a real `Port` against two real canonical XES
  fixtures (`/Users/sac/wasm4pm/fixtures/shared/{small-example,
  roadtraffic100traces}.xes`) and two real deliberately-wrong inputs (a
  nonexistent path; a REAL byte-truncated copy of `small-example.xes`), with
  real `beam4pm-rf1-dfg/v1` receipt files on disk for every scenario.

  Each of the four scenarios is its own separate `DfgDiscovery.run/2` call
  (see that module's moduledoc for why: a real, directly-observed Reactor
  scheduling behavior -- stopping scheduling of not-yet-started independent
  sibling steps as soon as any one step fails, even under `async?: false`
  -- made "one call exercises all four scenarios" both non-deterministic and
  incomplete; one call per scenario is fully deterministic and was verified
  to complete every time).
  """

  use ExUnit.Case, async: false

  alias BeamPM.RF1.DfgDiscovery
  alias BeamPM.RF1.DfgOracleBridge

  @moduletag :tmp_dir

  @small_example_xes "/Users/sac/wasm4pm/fixtures/shared/small-example.xes"
  @roadtraffic_xes "/Users/sac/wasm4pm/fixtures/shared/roadtraffic100traces.xes"

  defp oracle_bin do
    path = Path.expand("native/rf1-dfg-oracle/target/release/rf1-dfg-oracle")

    unless File.exists?(path) do
      raise "rf1-dfg-oracle binary not found at #{path} -- run " <>
              "`cargo build --release` in native/rf1-dfg-oracle/ first, and run mix test " <>
              "from the project root"
    end

    path
  end

  defp truncated_xes do
    path = Path.expand("qualification/fixtures/rf1_small_example_truncated.xes")

    unless File.exists?(path) do
      raise "truncated small-example.xes fixture not found at #{path}"
    end

    path
  end

  defp real_fixture!(path) do
    unless File.exists?(path) do
      raise "real canonical XES fixture not found at #{path} -- this stream requires the " <>
              "real wasm4pm canonical datasets"
    end

    path
  end

  defp base_paths(tmp_dir, run_id) do
    %{
      oracle_bin: oracle_bin(),
      small_example_xes: real_fixture!(@small_example_xes),
      roadtraffic_xes: real_fixture!(@roadtraffic_xes),
      nonexistent_xes: Path.join(tmp_dir, "definitely-does-not-exist-#{run_id}.xes"),
      truncated_xes: truncated_xes(),
      receipts_dir: tmp_dir,
      run_id: run_id
    }
  end

  defp read_receipt!(tmp_dir, run_id, scenario) do
    path = Path.join(tmp_dir, "#{run_id}-#{scenario}.json")
    assert File.exists?(path), "expected a real receipt at #{path}"
    path |> File.read!() |> JSON.decode!()
  end

  # Builds the exact same wire payload the bridge itself sends, so a
  # standalone shell invocation is a genuinely fair, byte-for-byte
  # comparison against `DfgOracleBridge.run/2` -- NOT the raw XES file piped
  # directly (that would be testing something the oracle never claims to
  # accept as its whole stdin).
  defp shell_invoke_oracle!(oracle_bin, xes_path) do
    payload_file = Path.join(System.tmp_dir!(), "rf1-shell-probe-#{System.unique_integer([:positive])}.json")
    File.write!(payload_file, JSON.encode!(%{"op" => "dfg_discover", "xes_path" => xes_path}))
    {raw, 0} = System.shell("#{oracle_bin} < #{payload_file}")
    File.rm(payload_file)
    JSON.decode!(String.trim_trailing(raw, "\n"))
  end

  test "real fixtures this stream depends on actually exist" do
    assert File.exists?(@small_example_xes)
    assert File.exists?(@roadtraffic_xes)
    assert File.exists?(truncated_xes())

    # The falsify fixture must be a REAL prefix of the original (a real
    # byte-truncation), not an unrelated file -- and it must be strictly
    # smaller, i.e. genuinely corrupted/incomplete, not accidentally equal.
    full = File.read!(@small_example_xes)
    truncated = File.read!(truncated_xes())
    assert byte_size(truncated) > 0
    assert byte_size(truncated) < byte_size(full)
    assert String.starts_with?(full, truncated)
  end

  test ":check_small_example -- real oracle run, EXACT observed num_cases/num_variants/edges/activities",
       %{tmp_dir: tmp_dir} do
    run_id = "rf1-check-small-#{System.unique_integer([:positive])}"
    paths = base_paths(tmp_dir, run_id)

    assert {:ok, %{scenario: :check_small_example, result: result}} =
             DfgDiscovery.run(:check_small_example, paths)

    assert result.active == true
    observed = result.observed

    assert observed["num_cases"] == 2
    assert observed["num_variants"] == 2
    assert observed["activities"] == ["Mail rejection", "No Activity", "Register client"]

    assert Enum.sort_by(observed["edges"], &{&1["source"], &1["target"]}) == [
             %{"source" => "", "target" => "", "frequency" => 3},
             %{"source" => "Register client", "target" => "Mail rejection", "frequency" => 1}
           ]

    assert observed["top_variant"] in [
             ["Register client", "Mail rejection"],
             ["No Activity", "No Activity", "No Activity", "No Activity"]
           ]

    receipt = read_receipt!(tmp_dir, run_id, "check_small_example")
    assert receipt["receipt_schema"] == "beam4pm-rf1-dfg/v1"
    assert receipt["scenario"] == "check_small_example"
    assert receipt["dataset"] == @small_example_xes
    assert receipt["outcome"] == "passed"
    assert receipt["observed"]["num_cases"] == 2
    assert receipt["replay"]["oracle_bin"] == oracle_bin()
    assert result.receipt_path == Path.join(tmp_dir, "#{run_id}-check_small_example.json")

    # A step gated inactive by `:scenario` does real, honest nothing --
    # confirm the sibling scenarios' receipts were NOT also written by this
    # one call.
    refute File.exists?(Path.join(tmp_dir, "#{run_id}-check_roadtraffic.json"))
    refute File.exists?(Path.join(tmp_dir, "#{run_id}-falsify_wrong_path.json"))
    refute File.exists?(Path.join(tmp_dir, "#{run_id}-falsify_truncated_xes.json"))
  end

  test ":check_roadtraffic -- real oracle run, EXACT observed num_cases/num_variants/18-edge DFG/top variant",
       %{tmp_dir: tmp_dir} do
    run_id = "rf1-check-road-#{System.unique_integer([:positive])}"
    paths = base_paths(tmp_dir, run_id)

    assert {:ok, %{scenario: :check_roadtraffic, result: result}} =
             DfgDiscovery.run(:check_roadtraffic, paths)

    assert result.active == true
    observed = result.observed

    assert observed["num_cases"] == 100
    assert observed["num_variants"] == 10
    assert length(observed["activities"]) == 10
    assert length(observed["edges"]) == 18

    assert observed["top_variant"] == [
             "Create Fine",
             "Send Fine",
             "Insert Fine Notification",
             "Add penalty",
             "Send for Credit Collection"
           ]

    assert %{"source" => "Create Fine", "target" => "Send Fine", "frequency" => 77} in observed[
             "edges"
           ]

    assert %{"source" => "Send Fine", "target" => "Insert Fine Notification", "frequency" => 56} in observed[
             "edges"
           ]

    assert %{"source" => "Payment", "target" => "Payment", "frequency" => 5} in observed["edges"]

    receipt = read_receipt!(tmp_dir, run_id, "check_roadtraffic")
    assert receipt["receipt_schema"] == "beam4pm-rf1-dfg/v1"
    assert receipt["outcome"] == "passed"
    assert receipt["dataset"] == @roadtraffic_xes
  end

  test ":falsify_wrong_path -- real nonexistent path detected (never a silently-empty result), " <>
         "compensate/2 writes a typed refusal receipt",
       %{tmp_dir: tmp_dir} do
    run_id = "rf1-falsify-wrong-path-#{System.unique_integer([:positive])}"
    paths = base_paths(tmp_dir, run_id)

    assert {:error, {:falsify_detected, :nonexistent_path, bad_path, status, raw}} =
             DfgDiscovery.run(:falsify_wrong_path, paths)

    assert bad_path == paths.nonexistent_xes
    assert status != 0
    assert raw =~ "No such file"

    receipt = read_receipt!(tmp_dir, run_id, "falsify_wrong_path")
    assert receipt["receipt_schema"] == "beam4pm-rf1-dfg/v1"
    assert receipt["outcome"] == "falsify_detected"
    assert receipt["observed"] == nil
    assert receipt["dataset"] == paths.nonexistent_xes
    assert receipt["falsify"]["expected_failure"] == true
    assert receipt["falsify"]["detected"] == true
    assert receipt["falsify"]["exit_status"] != 0
    assert receipt["falsify"]["stderr_excerpt"] =~ "No such file"

    # The other three scenarios' steps really did nothing this call.
    refute File.exists?(Path.join(tmp_dir, "#{run_id}-check_small_example.json"))
    refute File.exists?(Path.join(tmp_dir, "#{run_id}-check_roadtraffic.json"))
    refute File.exists?(Path.join(tmp_dir, "#{run_id}-falsify_truncated_xes.json"))
  end

  test ":falsify_truncated_xes -- real byte-truncated XES detected via rust4pm's own real " <>
         "XML/XES parse failure (never silently-zero traces), compensate/2 writes a typed " <>
         "refusal receipt",
       %{tmp_dir: tmp_dir} do
    run_id = "rf1-falsify-truncated-#{System.unique_integer([:positive])}"
    paths = base_paths(tmp_dir, run_id)

    assert {:error, {:falsify_detected, :truncated_xes, truncated_path, status, raw}} =
             DfgDiscovery.run(:falsify_truncated_xes, paths)

    assert truncated_path == paths.truncated_xes
    assert status != 0
    assert raw =~ "XES Error" or raw =~ "XMLParsingError"

    receipt = read_receipt!(tmp_dir, run_id, "falsify_truncated_xes")
    assert receipt["receipt_schema"] == "beam4pm-rf1-dfg/v1"
    assert receipt["outcome"] == "falsify_detected"
    assert receipt["observed"] == nil
    assert receipt["dataset"] == paths.truncated_xes
    assert receipt["falsify"]["expected_failure"] == true
    assert receipt["falsify"]["detected"] == true
    assert receipt["falsify"]["exit_status"] != 0

    assert receipt["falsify"]["stderr_excerpt"] =~ "XES Error" or
             receipt["falsify"]["stderr_excerpt"] =~ "XMLParsingError"
  end

  test "unknown scenario is refused fail-closed, not silently ignored", %{tmp_dir: tmp_dir} do
    run_id = "rf1-unknown-#{System.unique_integer([:positive])}"
    paths = base_paths(tmp_dir, run_id)

    assert_raise ArgumentError, ~r/unknown scenario/, fn ->
      DfgDiscovery.run(:not_a_real_scenario, paths)
    end
  end

  test "DfgOracleBridge.run/2 (the Port bridge) matches a plain shell-redirect invocation of " <>
         "the same real oracle binary, byte-for-byte (same decoded map), on " <>
         "roadtraffic100traces.xes (deterministic, no tie)" do
    assert {:ok, %{exit_status: 0, decoded: bridged}} =
             DfgOracleBridge.run(oracle_bin(), real_fixture!(@roadtraffic_xes))

    shelled = shell_invoke_oracle!(oracle_bin(), real_fixture!(@roadtraffic_xes))

    assert bridged == shelled
    assert bridged["num_cases"] == 100
    assert bridged["num_variants"] == 10
  end

  test "verify_observed/2 detects a deliberately WRONG expected value (proves the :check " <>
         "step's assertion is not vacuous)" do
    {:ok, %{decoded: real_observed}} =
      DfgOracleBridge.run(oracle_bin(), real_fixture!(@roadtraffic_xes))

    # Sanity: the REAL observed output passes as-is.
    assert DfgDiscovery.verify_observed(:roadtraffic, real_observed) == :ok

    # A single field deliberately corrupted (a real map, one real field
    # swapped for a wrong value -- not a mock of the comparison function)
    # must be caught, with the mismatch naming the corrupted field.
    wrong_num_cases = Map.put(real_observed, "num_cases", 999)
    assert {:mismatch, reason} = DfgDiscovery.verify_observed(:roadtraffic, wrong_num_cases)
    assert reason =~ "num_cases"

    wrong_edges = Map.put(real_observed, "edges", [])
    assert {:mismatch, edge_reason} = DfgDiscovery.verify_observed(:roadtraffic, wrong_edges)
    assert edge_reason =~ "edges"

    wrong_top_variant = Map.put(real_observed, "top_variant", ["Not", "A", "Real", "Variant"])

    assert {:mismatch, top_variant_reason} =
             DfgDiscovery.verify_observed(:roadtraffic, wrong_top_variant)

    assert top_variant_reason =~ "top_variant"

    # The small-example tie set is itself a real, bounded, falsifiable
    # membership check -- a THIRD, wrong sequence must still be rejected.
    {:ok, %{decoded: small_observed}} =
      DfgOracleBridge.run(oracle_bin(), real_fixture!(@small_example_xes))

    assert DfgDiscovery.verify_observed(:small_example, small_observed) == :ok

    wrong_variant = Map.put(small_observed, "top_variant", ["Totally", "Wrong"])
    assert {:mismatch, _} = DfgDiscovery.verify_observed(:small_example, wrong_variant)
  end
end
