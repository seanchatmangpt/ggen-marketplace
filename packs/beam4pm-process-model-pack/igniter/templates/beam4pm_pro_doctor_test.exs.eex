<%
# ggen_igniter EEx template -> test/beam4pm_pro_doctor_test.exs
# Bindings: NONE required -- fully static.
%># GENERATED by ggen_igniter from the beam4pm_pro_doctor static template. Do not edit.
defmodule BeamPM.Pro.DoctorTest do
  use ExUnit.Case, async: true

  alias BeamPM.Pro.Doctor

  test "run/0 against this real, healthy checkout reports :healthy with 5 real passing checks" do
    report = Doctor.run()
    assert report.status == :healthy
    assert length(report.checks) == 5
    assert Enum.all?(report.checks, &match?({:ok, _}, &1))
  end

  test "the real source_provenance_mismatch check reads this module's own on-disk GENERATED header" do
    report = Doctor.run()
    assert {:ok, :source_provenance_mismatch} in report.checks
  end

  test "an injected version_mismatch failure is diagnosed by name, not a crash" do
    report = Doctor.run(version_mismatch: "beam4pm 0.1.0 incompatible with ggen_igniter 99.0.0")
    assert report.status == :degraded

    assert {:error, {:version_mismatch, "beam4pm 0.1.0 incompatible with ggen_igniter 99.0.0"}} in
             report.checks
  end

  test "an injected migration_lag failure is diagnosed by name" do
    report = Doctor.run(migration_lag: "3 pending migrations not applied")
    assert {:error, {:migration_lag, "3 pending migrations not applied"}} in report.checks
    assert report.status == :degraded
  end

  test "an injected connector_failure failure is diagnosed by name" do
    report = Doctor.run(connector_failure: "SAP connector unreachable")
    assert {:error, {:connector_failure, "SAP connector unreachable"}} in report.checks
  end

  test "an injected entitlement_failure failure is diagnosed by name" do
    report = Doctor.run(entitlement_failure: "no active entitlement grant for this tenant")
    assert {:error, {:entitlement_failure, "no active entitlement grant for this tenant"}} in
             report.checks
  end

  test "an injected source_provenance_mismatch failure is diagnosed by name" do
    report = Doctor.run(source_provenance_mismatch: "GENERATED header missing")
    assert {:error, {:source_provenance_mismatch, "GENERATED header missing"}} in report.checks
  end

  test "multiple simultaneous injected failures are all reported, and status is :degraded" do
    report =
      Doctor.run(
        version_mismatch: "v1",
        connector_failure: "v2"
      )

    assert report.status == :degraded
    assert Enum.count(report.checks, &match?({:error, _}, &1)) == 2
  end

  test "bundle/1 never includes secret-shaped keys and is JSON-safe (plain strings/maps/lists)" do
    report = Doctor.run()
    bundle = Doctor.bundle(report)

    refute Map.has_key?(bundle, "token")
    refute Map.has_key?(bundle, "secret")
    refute Map.has_key?(bundle, "license_key")
    assert is_binary(bundle["environment"]["beam4pm_version"])
    assert is_list(bundle["report"]["checks"])
  end

  test "bundle/1 reflects a degraded status and each check's diagnosis" do
    report = Doctor.run(entitlement_failure: "expired")
    bundle = Doctor.bundle(report)

    assert bundle["report"]["status"] == "degraded"

    assert Enum.any?(bundle["report"]["checks"], fn c ->
             c["check"] == "entitlement_failure" and c["outcome"] == "error" and
               c["diagnosis"] == "expired"
           end)
  end
end
