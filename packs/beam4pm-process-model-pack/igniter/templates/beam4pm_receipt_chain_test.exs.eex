<%
# ggen_igniter EEx template -> test/beam4pm_receipt_chain_test.exs
#
# Bindings (union of beam4pm_actuation.ex.eex's and
# beam4pm_process_governor.ex.eex's own queries -- this template renders no
# NEW query, it re-derives the same graph-admitted names those two already
# depend on, so a graph change that would break either of THEM also fails
# THIS render loudly rather than silently drifting):
#   admitted          - list of string-keyed maps: "action_name", "gym_op"
#   admitted_requires - list of string-keyed maps: "action_name", "fact"
#   transitions       - list of string-keyed maps: "process_id",
#                       "initial_state", "ordinal", "from_state", "to_state",
#                       "actuation_name"
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

norm_int = fn v ->
  case norm.(v) do
    nil -> nil
    s when is_binary(s) -> s |> Integer.parse() |> elem(0)
    n when is_integer(n) -> n
  end
end

admitted_rows =
  admitted
  |> Enum.map(fn a -> %{name: norm.(a["action_name"]), gym_op: norm.(a["gym_op"])} end)
  |> Enum.sort_by(& &1.name)

requires_rows =
  Enum.map(admitted_requires, fn r -> %{name: norm.(r["action_name"]), fact: norm.(r["fact"])} end)

requires_for = fn name ->
  requires_rows |> Enum.filter(&(&1.name == name)) |> Enum.map(& &1.fact) |> Enum.sort()
end

# Same discipline as beam4pm_actuation_test.exs.eex's inc_row check: this
# chain-falsifier suite drives the toy-counter fixture gym's `inc` op
# directly via BeamPM.Actuation.run/2, so the admission graph MUST admit
# exactly one actuation released as gym op "inc".
inc_row =
  case Enum.filter(admitted_rows, &(&1.gym_op == "inc")) do
    [row] -> row
    other -> raise "admission graph must admit exactly one gym op \"inc\" actuation, got: #{inspect(other)}"
  end

inc_requires = requires_for.(inc_row.name)
inc_name_lit = inspect(inc_row.name)
inc_requires_lit = "[" <> Enum.map_join(inc_requires, ", ", &inspect/1) <> "]"

transition_rows =
  transitions
  |> Enum.map(fn t ->
    %{
      process_id: norm.(t["process_id"]),
      ordinal: norm_int.(t["ordinal"]),
      actuation_name: norm.(t["actuation_name"])
    }
  end)

# Same discipline as beam4pm_process_governor_test.exs.eex: the composition
# test below drives the real 2-step increment_counter -> observe_counter
# governed process, so the graph must admit exactly one such process.
toy_counter_process_id =
  transition_rows
  |> Enum.filter(&(&1.actuation_name in ["increment_counter", "observe_counter"]))
  |> Enum.group_by(& &1.process_id)
  |> Enum.filter(fn {_pid, rs} ->
    Enum.sort_by(rs, & &1.ordinal) |> Enum.map(& &1.actuation_name) ==
      ["increment_counter", "observe_counter"]
  end)
  |> case do
    [{pid, _rs}] ->
      pid

    other ->
      raise "receipt-chain composition test requires exactly one 2-step process over " <>
              "increment_counter -> observe_counter, got: " <> inspect(other)
  end
%># GENERATED by ggen_igniter (sibling of beam4pm_actuation_test.exs.eex). Do not edit.
defmodule BeamPM.ReceiptChainTest do
  @moduledoc """
  Chicago-style qualification of the stream-EX2 hash-chained-receipt
  extension (`BeamPM.ReceiptChain`): real sequential `BeamPM.Actuation.run/2`
  calls against the real `qualification/fixtures/toy_gym_bridge.py`
  subprocess (a deterministic fake ENVIRONMENT, not a mock of our own code),
  real `beam4pm-brce/v1` receipt files on disk, real sha256 recomputation of
  their real bytes, and a REAL falsifier: a receipt file is deliberately
  corrupted on disk and `BeamPM.ReceiptChain.verify/2` must detect the
  break, not merely be asserted to.

  The `tip index` group qualifies the O(1) per-chain tip index behind
  `BeamPM.ReceiptChain.link_fields/3` against the retained Theta(N) scan
  (`link_fields_by_scan/2`, the read-only reference oracle): answer identity
  before every one of hundreds of randomly interleaved multi-chain writes,
  the crash window (index recorded, receipt never written), a tampered or
  stale index entry, the DISCLOSED divergence under an out-of-band writer
  (caught by the untouched `verify/2`, never silently accepted), and a
  wall-clock falsifier that the per-write cost no longer scales with the
  directory. Receipts in that group are real JSON files written to real
  paths -- the module's contract is over files on disk, so the filesystem
  is the collaborator, not a stand-in for one.
  """

  use ExUnit.Case, async: false

  alias BeamPM.Actuation
  alias BeamPM.ProcessGovernor
  alias BeamPM.ReceiptChain

  @moduletag :tmp_dir

  @inc_action <%= inc_name_lit %>
  @inc_requires <%= inc_requires_lit %>
  @governed_process_id <%= inspect(toy_counter_process_id) %>

  defp bridge_path do
    path = Path.expand("qualification/fixtures/toy_gym_bridge.py")

    unless File.exists?(path) do
      raise "fixture gym bridge not found at #{path} - run mix test from the project root"
    end

    path
  end

  defp inc_action, do: %{action_name: @inc_action, preconditions: @inc_requires, effects: []}

  defp sha256_hex!(path) do
    path |> File.read!() |> then(&:crypto.hash(:sha256, &1)) |> Base.encode16(case: :lower)
  end

  test "3 real sequential actuations: each receipt's prev_receipt_hash really matches the prior receipt's real recomputed hash",
       %{tmp_dir: tmp_dir} do
    chain_id = "manual-toy-counter-chain"

    run = fn n ->
      run_id = "act-chain-#{n}"

      {:ok, out} =
        Actuation.run(inc_action(), [
          gym: "toy-counter",
          bridge: bridge_path(),
          receipts_dir: tmp_dir,
          run_id: run_id,
          chain_id: chain_id
        ])

      {run_id, out.receipt_path}
    end

    {run_id1, path1} = run.(1)
    {run_id2, path2} = run.(2)
    {run_id3, path3} = run.(3)

    receipt1 = path1 |> File.read!() |> JSON.decode!()
    receipt2 = path2 |> File.read!() |> JSON.decode!()
    receipt3 = path3 |> File.read!() |> JSON.decode!()

    # Genesis: seq 1, no parent.
    assert receipt1["chain_id"] == chain_id
    assert receipt1["chain_seq"] == 1
    assert receipt1["prev_receipt_path"] == nil
    assert receipt1["prev_receipt_hash"] == nil

    # Real, independently-recomputed linkage: receipt2's prev_receipt_hash
    # must equal sha256 of receipt1's REAL file bytes on disk right now
    # (computed here, in the test, completely independently of
    # BeamPM.ReceiptChain's own internals).
    assert receipt2["chain_id"] == chain_id
    assert receipt2["chain_seq"] == 2
    assert receipt2["prev_receipt_path"] == path1
    assert receipt2["prev_receipt_hash"] == sha256_hex!(path1)

    assert receipt3["chain_id"] == chain_id
    assert receipt3["chain_seq"] == 3
    assert receipt3["prev_receipt_path"] == path2
    assert receipt3["prev_receipt_hash"] == sha256_hex!(path2)

    # Toy-counter is a real stateful subprocess: each independent
    # Actuation.run/2 call resets it, so all three receipts show the exact
    # same real reset->inc observation transition - proving these are 3
    # real, distinct, sequential actuation attempts, not one replayed call.
    for receipt <- [receipt1, receipt2, receipt3] do
      assert receipt["execution"]["performed"] == true
      assert receipt["execution"]["observation_before"] == %{"counter" => 0, "steps" => 0}
      assert receipt["execution"]["observation_after"] == %{"counter" => 1, "steps" => 1}
    end

    # BeamPM.ReceiptChain.verify/2: real, independent replay verification
    # over the whole directory confirms the chain is unbroken end to end.
    assert {:ok, %{chain_id: ^chain_id, length: 3, receipt_paths: [^path1, ^path2, ^path3]}} =
             ReceiptChain.verify(tmp_dir, chain_id)

    # Sanity: a completely different chain_id in the SAME directory sees
    # nothing (chain scoping is real, not directory-wide).
    assert {:ok, %{chain_id: "unrelated", length: 0, receipt_paths: []}} =
             ReceiptChain.verify(tmp_dir, "unrelated")

    _ = {run_id1, run_id2, run_id3}
  end

  test "REAL FALSIFIER: corrupting a receipt file on disk is detected by ReceiptChain.verify/2, not merely asserted",
       %{tmp_dir: tmp_dir} do
    chain_id = "falsifier-chain"

    run = fn n ->
      run_id = "act-falsifier-#{n}"

      {:ok, out} =
        Actuation.run(inc_action(), [
          gym: "toy-counter",
          bridge: bridge_path(),
          receipts_dir: tmp_dir,
          run_id: run_id,
          chain_id: chain_id
        ])

      out.receipt_path
    end

    path1 = run.(1)
    path2 = run.(2)
    path3 = run.(3)

    # Sanity: untampered chain verifies clean before we touch anything.
    assert {:ok, %{length: 3}} = ReceiptChain.verify(tmp_dir, chain_id)

    # Deliberately corrupt the MIDDLE receipt (path2) directly on disk -
    # mutate a real field (never touching chain_id/chain_seq/receipt_schema,
    # so it still decodes and still looks chain-shaped), which changes its
    # real byte content and therefore its real sha256. Neither path1 nor
    # path3 is touched - in particular path3's own recorded
    # prev_receipt_hash (which points at path2) is NOT updated, exactly
    # mirroring ex4pm's "tampered stored parent, untouched child" scenario.
    original = path2 |> File.read!() |> JSON.decode!()
    original_hash = sha256_hex!(path2)

    tampered =
      Map.update!(original, "admission", fn a -> Map.put(a, "reason", "TAMPERED " <> a["reason"]) end)

    File.write!(path2, JSON.encode!(tampered))

    tampered_hash = sha256_hex!(path2)
    assert tampered_hash != original_hash, "the corruption must actually change the file's bytes"

    # path1 is byte-for-byte untouched (only path2 was mutated).
    assert path1 |> File.read!() |> JSON.decode!() |> Map.fetch!("chain_seq") == 1

    # The REAL falsifier: verify/2 must catch this, not just be told to.
    assert {:error, {:chain_broken, 3, :hash_mismatch}} = ReceiptChain.verify(tmp_dir, chain_id)

    # And the break is exactly localized: seq 3 is the receipt whose
    # recorded prev_receipt_hash (pointing at path2) no longer recomputes,
    # because path2's real bytes changed underneath it.
    assert path3 |> File.read!() |> JSON.decode!() |> Map.fetch!("prev_receipt_hash") == original_hash
    assert original_hash != sha256_hex!(path2)
  end

  test "genesis-only chain (a single receipt) verifies trivially", %{tmp_dir: tmp_dir} do
    chain_id = "single-link-chain"

    {:ok, out} =
      Actuation.run(inc_action(), [
        gym: "toy-counter",
        bridge: bridge_path(),
        receipts_dir: tmp_dir,
        run_id: "act-solo",
        chain_id: chain_id
      ])

    assert {:ok, %{chain_id: ^chain_id, length: 1, receipt_paths: [path]}} =
             ReceiptChain.verify(tmp_dir, chain_id)

    assert path == out.receipt_path
  end

  test "no chain_id opt: receipt shape is byte-for-byte today's beam4pm-brce/v1 shape, zero new keys",
       %{tmp_dir: tmp_dir} do
    {:ok, out} =
      Actuation.run(inc_action(), gym: "toy-counter", bridge: bridge_path(), receipts_dir: tmp_dir)

    receipt = out.receipt_path |> File.read!() |> JSON.decode!()

    refute Map.has_key?(receipt, "chain_id")
    refute Map.has_key?(receipt, "chain_seq")
    refute Map.has_key?(receipt, "prev_receipt_path")
    refute Map.has_key?(receipt, "prev_receipt_hash")

    assert Map.keys(receipt) |> Enum.sort() ==
             Enum.sort(["receipt_schema", "action", "admission", "execution", "events", "replay"])
  end

  test "composes with BeamPM.ProcessGovernor: chain_id defaults to process_id automatically, real 2-step chain verifies",
       %{tmp_dir: tmp_dir} do
    opts = [gym: "toy-counter", bridge: bridge_path(), receipts_dir: tmp_dir]

    assert {:ok, final} = ProcessGovernor.run(@governed_process_id, opts)
    assert length(final.receipts) == 2

    [process_receipt2, process_receipt1] = final.receipts

    actuation_path1 = process_receipt1.actuation.receipt_path
    actuation_path2 = process_receipt2.actuation.receipt_path

    receipt1 = actuation_path1 |> File.read!() |> JSON.decode!()
    receipt2 = actuation_path2 |> File.read!() |> JSON.decode!()

    # ProcessGovernor never asked for a chain_id explicitly, yet both
    # underlying beam4pm-brce/v1 receipts are chained, scoped by the exact
    # process_id ProcessGovernor.apply_transition/3 delegated with.
    assert receipt1["chain_id"] == @governed_process_id
    assert receipt2["chain_id"] == @governed_process_id
    assert receipt1["chain_seq"] == 1
    assert receipt2["chain_seq"] == 2
    assert receipt2["prev_receipt_hash"] == sha256_hex!(actuation_path1)

    # This is a SEPARATE evidence trail from ProcessGovernor's own
    # embed-by-reference ("actuation" field) - both agree on identity, but
    # the hash chain additionally proves receipt1's bytes are untampered.
    assert process_receipt1.actuation.receipt_path == actuation_path1
    assert process_receipt2.actuation.receipt_path == actuation_path2

    assert {:ok,
            %{
              chain_id: @governed_process_id,
              length: 2,
              receipt_paths: [^actuation_path1, ^actuation_path2]
            }} = ReceiptChain.verify(tmp_dir, @governed_process_id)
  end

  # -- tip index: O(1) link_fields/3 vs the retained scan oracle ---------

  @brce_schema "beam4pm-brce/v1"
  @tip_index_schema "beam4pm-chain-tip/v1"

  # A minimal, real beam4pm-brce/v1-shaped receipt file carrying exactly the
  # fields BeamPM.ReceiptChain's own decode_chain_receipt/2 reads, plus a
  # payload so every file's bytes (and therefore sha256) are distinct.
  # Written to a REAL path on disk: the module's contract is over files, so
  # the filesystem is the real collaborator here, not BeamPM.Actuation.
  defp write_chained_receipt!(path, link, payload) do
    File.write!(
      path,
      JSON.encode!(%{
        "receipt_schema" => @brce_schema,
        "chain_id" => link.chain_id,
        "chain_seq" => link.chain_seq,
        "prev_receipt_path" => link.prev_receipt_path,
        "prev_receipt_hash" => link.prev_receipt_hash,
        "payload" => payload
      })
    )

    path
  end

  defp write_json!(path, body), do: File.write!(path, JSON.encode!(body))

  # Two receipts of `chain_id` through the indexed writer, so the indexed
  # path (not just the genesis/scan-fallback path) is what later calls hit.
  defp seed_indexed_chain!(tmp_dir, chain_id, prefix) do
    p1 = Path.join(tmp_dir, "#{prefix}-1.json")
    write_chained_receipt!(p1, ReceiptChain.link_fields(tmp_dir, chain_id, p1), "#{prefix}-1")
    p2 = Path.join(tmp_dir, "#{prefix}-2.json")
    write_chained_receipt!(p2, ReceiptChain.link_fields(tmp_dir, chain_id, p2), "#{prefix}-2")
    {p1, p2}
  end

  test "tip index: link_fields/3 == retained scan oracle before every one of 360 randomly interleaved writes across 7 chains (+40 unchained noise files), and the untouched verify/2 accepts every chain",
       %{tmp_dir: tmp_dir} do
    chains = ["alpha", "beta", "gamma", "delta", "epsilon", "tenant/acme process #7", "zeta"]
    :rand.seed(:exsss, {2026, 9, 5})

    counts =
      Enum.reduce(1..400, %{}, fn i, counts ->
        if rem(i, 10) == 0 do
          # Unchained noise the scan must read-and-discard and the index
          # never touches: a bare brce receipt (no chain fields) or a
          # foreign-schema JSON file, alternating.
          schema = if rem(i, 20) == 0, do: @brce_schema, else: "other/v1"
          write_json!(Path.join(tmp_dir, "noise-#{i}.json"), %{"receipt_schema" => schema, "i" => i})
          counts
        else
          chain = Enum.random(chains)
          path = Path.join(tmp_dir, "r-#{i}.json")
          expected = ReceiptChain.link_fields_by_scan(tmp_dir, chain)
          actual = ReceiptChain.link_fields(tmp_dir, chain, path)

          assert actual == expected,
                 "write #{i} chain #{inspect(chain)}: index #{inspect(actual)} != scan #{inspect(expected)}"

          write_chained_receipt!(path, actual, i)
          Map.update(counts, chain, 1, &(&1 + 1))
        end
      end)

    assert counts |> Map.values() |> Enum.sum() == 360

    # The untouched verify/2 -- whole-directory replay from disk, never
    # consulting the index -- accepts every chain at exactly its write count.
    for {chain, n} <- counts do
      assert {:ok, %{chain_id: ^chain, length: ^n}} = ReceiptChain.verify(tmp_dir, chain)
    end

    # The index is one hidden file per chain in a subdirectory the scan's
    # top-level *.json filter never sees; a path-unsafe chain_id gets a
    # filesystem-safe, deterministic filename that still records the plain id.
    index_dir = Path.join(tmp_dir, ".chain-tips")
    assert File.dir?(index_dir)
    assert index_dir |> File.ls!() |> length() == map_size(counts)
    unsafe_index = ReceiptChain.tip_index_path(tmp_dir, "tenant/acme process #7")
    assert Path.dirname(unsafe_index) == index_dir
    assert Path.basename(unsafe_index) =~ ~r/\A[0-9a-f]{64}\.json\z/
    assert (unsafe_index |> File.read!() |> JSON.decode!())["chain_id"] == "tenant/acme process #7"
  end

  test "tip index: crash window (tip recorded, receipt never written) is repaired by the validated read + scan fallback, and the REAL Actuation writer continues unbroken",
       %{tmp_dir: tmp_dir} do
    chain_id = "crash-window-chain"

    run = fn n ->
      {:ok, out} =
        Actuation.run(inc_action(), [
          gym: "toy-counter",
          bridge: bridge_path(),
          receipts_dir: tmp_dir,
          run_id: "act-crash-#{n}",
          chain_id: chain_id
        ])

      out.receipt_path
    end

    path1 = run.(1)
    path2 = run.(2)

    # The exact state a process dying between BeamPM.Actuation's
    # put_chain_fields/2 and its File.write! leaves behind: the index already
    # names seq 3 at a path that never gets written.
    ghost = Path.join(tmp_dir, "act-crash-ghost.json")
    assert %{chain_seq: 3, prev_receipt_path: ^path2} = ReceiptChain.link_fields(tmp_dir, chain_id, ghost)
    refute File.exists?(ghost)
    index = ReceiptChain.tip_index_path(tmp_dir, chain_id) |> File.read!() |> JSON.decode!()
    assert index["chain_seq"] == 3 and index["receipt_path"] == ghost

    # Next call: the index names a file that does not exist -> validated read
    # misses -> scan -> the same answer the oracle gives, and the index is
    # rebuilt from it.
    expected = ReceiptChain.link_fields_by_scan(tmp_dir, chain_id)
    assert %{chain_seq: 3, prev_receipt_path: ^path2} = expected
    assert ReceiptChain.link_fields(tmp_dir, chain_id, Path.join(tmp_dir, "act-crash-3.json")) == expected

    # And the REAL writer continues from the repaired state: real receipt 3
    # chains to real receipt 2 by recomputed sha256, whole chain verifies.
    path3 = run.(3)
    receipt3 = path3 |> File.read!() |> JSON.decode!()
    assert receipt3["chain_seq"] == 3
    assert receipt3["prev_receipt_path"] == path2
    assert receipt3["prev_receipt_hash"] == sha256_hex!(path2)

    assert {:ok, %{length: 3, receipt_paths: [^path1, ^path2, ^path3]}} =
             ReceiptChain.verify(tmp_dir, chain_id)
  end

  test "tip index: a tampered or stale index entry is a MISS (never trusted, never an error) -- garbage, another chain's real receipt, wrong seq, a copy outside receipts_dir, deleted",
       %{tmp_dir: tmp_dir} do
    {_a1, a2} = seed_indexed_chain!(tmp_dir, "chain-a", "a")
    {_b1, b2} = seed_indexed_chain!(tmp_dir, "chain-b", "b")

    index_path = ReceiptChain.tip_index_path(tmp_dir, "chain-a")
    next = Path.join(tmp_dir, "a-3.json")
    expected = ReceiptChain.link_fields_by_scan(tmp_dir, "chain-a")
    assert %{chain_seq: 3, prev_receipt_path: ^a2} = expected

    entry = fn seq, path ->
      JSON.encode!(%{
        "index_schema" => @tip_index_schema,
        "chain_id" => "chain-a",
        "chain_seq" => seq,
        "receipt_path" => path
      })
    end

    # (1) garbage bytes -> miss -> scan; the index is rebuilt valid afterwards.
    File.write!(index_path, "{not json")
    assert ReceiptChain.link_fields(tmp_dir, "chain-a", next) == expected
    rebuilt = index_path |> File.read!() |> JSON.decode!()
    assert rebuilt["chain_id"] == "chain-a" and rebuilt["chain_seq"] == 3 and rebuilt["receipt_path"] == next

    # (2) points at a REAL, valid tip receipt -- of ANOTHER chain.
    File.write!(index_path, entry.(2, b2))
    assert ReceiptChain.link_fields(tmp_dir, "chain-a", next) == expected

    # (3) the right file, but the index claims a seq the receipt does not record.
    File.write!(index_path, entry.(7, a2))
    assert ReceiptChain.link_fields(tmp_dir, "chain-a", next) == expected

    # (4) a byte-identical copy of the real tip, but OUTSIDE receipts_dir's top
    # level -- a file the scan could never see must never be admitted by the
    # index either (prev_receipt_path must stay a2, not the copy).
    outside = Path.join(tmp_dir, "elsewhere")
    File.mkdir_p!(outside)
    copy = Path.join(outside, "a-2-copy.json")
    File.cp!(a2, copy)
    File.write!(index_path, entry.(2, copy))
    assert ReceiptChain.link_fields(tmp_dir, "chain-a", next) == expected

    # (5) deleted entirely.
    File.rm!(index_path)
    assert ReceiptChain.link_fields(tmp_dir, "chain-a", next) == expected

    # (6) the legacy 2-arity writer entry point: same answer as the oracle, and
    # it invalidates the index so a scan-only writer can never leave a
    # stale-but-valid tip behind.
    assert ReceiptChain.link_fields(tmp_dir, "chain-a") == expected
    refute File.exists?(index_path)

    # chain-b was never touched by any of the above.
    assert {:ok, %{length: 2}} = ReceiptChain.verify(tmp_dir, "chain-b")
  end

  test "DISCLOSED LIMIT: a well-formed next-link receipt injected WITHOUT the writer makes index and scan diverge -- and the untouched verify/2 turns that into a visible :duplicate_or_missing_seq, never silent acceptance",
       %{tmp_dir: tmp_dir} do
    chain_id = "foreign-injection-chain"
    {_p1, _p2} = seed_indexed_chain!(tmp_dir, chain_id, "f")

    # A foreign process computes a perfectly consistent seq-3 link with the
    # oracle and drops it into the flat directory, bypassing link_fields/3.
    foreign_link = ReceiptChain.link_fields_by_scan(tmp_dir, chain_id)
    assert foreign_link.chain_seq == 3
    write_chained_receipt!(Path.join(tmp_dir, "f-3-foreign.json"), foreign_link, "foreign")

    # The scan now sees seq 3 -> next is 4. The index still names f-2 (which
    # is real and valid) -> next is 3. Divergent, and stated so.
    scan = ReceiptChain.link_fields_by_scan(tmp_dir, chain_id)
    indexed_path = Path.join(tmp_dir, "f-3-indexed.json")
    indexed = ReceiptChain.link_fields(tmp_dir, chain_id, indexed_path)
    assert scan.chain_seq == 4
    assert indexed.chain_seq == 3
    refute scan == indexed

    # The indexed writer writes its seq-3 receipt; the independent oracle
    # catches the duplicate rather than accepting either writer's output.
    write_chained_receipt!(indexed_path, indexed, "indexed")

    assert {:error, {:chain_broken, _seq, :duplicate_or_missing_seq}} =
             ReceiptChain.verify(tmp_dir, chain_id)
  end

  test "tip index: per-write cost no longer scales with the directory -- at 3,000 foreign-chain receipts the indexed link is identical to the scan and at least 20x faster",
       %{tmp_dir: tmp_dir} do
    chain_id = "hot-chain"
    {_h1, h2} = seed_indexed_chain!(tmp_dir, chain_id, "hot")

    # 3,000 foreign receipts (100 other chains x 30), every one a real scan
    # candidate the scan must read, decode, and discard.
    for c <- 1..100, s <- 1..30 do
      write_json!(Path.join(tmp_dir, "foreign-#{c}-#{s}.json"), %{
        "receipt_schema" => @brce_schema,
        "chain_id" => "foreign-#{c}",
        "chain_seq" => s,
        "prev_receipt_path" => nil,
        "prev_receipt_hash" => nil
      })
    end

    assert %{chain_seq: 3, prev_receipt_path: ^h2} = ReceiptChain.link_fields_by_scan(tmp_dir, chain_id)

    # Steady-state per-write cycle, five real times: take the link for the
    # receipt about to be written (timed -- this is the cost under test),
    # then actually write that receipt, so the NEXT cycle's validated read
    # finds a real tip. A link never followed by its write is the crash
    # window, which correctly falls back to the scan -- timing that would
    # measure the scan, not the index. Identity with the oracle is asserted
    # on every cycle, outside the timer.
    index_us =
      Enum.min(
        for k <- 3..7 do
          path = Path.join(tmp_dir, "hot-#{k}.json")
          expected = ReceiptChain.link_fields_by_scan(tmp_dir, chain_id)
          {us, link} = :timer.tc(fn -> ReceiptChain.link_fields(tmp_dir, chain_id, path) end)
          assert link == expected
          assert link.chain_seq == k
          write_chained_receipt!(path, link, "hot-#{k}")
          us
        end
      )

    scan_us =
      Enum.min(for _ <- 1..5, do: elem(:timer.tc(fn -> ReceiptChain.link_fields_by_scan(tmp_dir, chain_id) end), 0))

    assert index_us * 20 <= scan_us,
           "indexed #{index_us}us vs scan #{scan_us}us at N=3,007 -- the index no longer " <>
             "removes the directory-size dimension from the write path"

    assert {:ok, %{length: 7}} = ReceiptChain.verify(tmp_dir, chain_id)
  end
end
