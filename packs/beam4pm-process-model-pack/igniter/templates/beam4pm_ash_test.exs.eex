<%
# ggen_igniter EEx template -> generated/elixir/test/beam4pm_ash_test.exs
#
# Chicago-style ExUnit tests: for EVERY admitted bpm:RecordType, a real
# Ash.create! through the real Ash.DataLayer.Ets, a real Ash.read! back, and
# exact field-value assertions using the fixed deterministic sample values.
# No mocks anywhere.
#
# Same engine-shape normalization + in-template re-sorting as
# beam4pm_ash.ex.eex (never trust engine row order).
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

to_int = fn v -> v |> norm.() |> String.to_integer() end

camel = fn name ->
  name |> String.split("_") |> Enum.map(&String.capitalize/1) |> Enum.join()
end

recs =
  records
  |> Enum.map(fn r -> %{name: norm.(r["record_name"])} end)
  |> Enum.sort_by(& &1.name)

flds =
  Enum.map(fields, fn f ->
    %{
      record: norm.(f["record_name"]),
      name: norm.(f["field_name"]),
      type: norm.(f["field_type"]),
      required: norm.(f["field_required"]) == "true",
      order: to_int.(f["field_order"])
    }
  end)

fields_for = fn rec ->
  flds |> Enum.filter(&(&1.record == rec)) |> Enum.sort_by(& &1.order)
end

# Deterministic sample values (fixed cross-stream contract), as Elixir source text.
sample = fn f ->
  case f.type do
    "string" -> ~s("sample_#{f.name}")
    "datetime" -> ~s("2026-08-29T12:00:00Z")
    "integer" -> "42"
    "float" -> "3.5"
    "boolean" -> "true"
    "atom" -> ":sample_atom"
    "list_string" -> ~s(["alpha", "beta"])
    "map" -> ~s(%{"k" => "v"})
  end
end

# Expected read-back value: identical to the input except datetime, which the
# Ash :utc_datetime type casts from the ISO8601 string to a DateTime.
expected = fn f ->
  case f.type do
    "datetime" -> "~U[2026-08-29 12:00:00Z]"
    _ -> sample.(f)
  end
end

tests =
  Enum.map_join(recs, "\n", fn r ->
    rf = fields_for.(r.name)
    mod = "BeamPM.Ash.Resources.#{camel.(r.name)}"
    params = Enum.map_join(rf, ",\n", fn f -> "        #{f.name}: #{sample.(f)}" end)

    asserts =
      Enum.map_join(rf, "\n", fn f ->
        "    assert read_back.#{f.name} == #{expected.(f)}"
      end)

    Enum.join(
      [
        "  test \"#{r.name}: real Ash ETS create/read round-trips every field\" do",
        "    params =",
        "      %{",
        params,
        "      }",
        "",
        "    created =",
        "      #{mod}",
        "      |> Ash.Changeset.for_create(:create, params)",
        "      |> Ash.create!()",
        "",
        "    [read_back] = Ash.read!(#{mod})",
        "    assert read_back.id == created.id",
        asserts,
        "  end"
      ],
      "\n"
    ) <> "\n"
  end)

rendered =
  "# GENERATED by ggen_igniter from the admitted bpm:RecordType graph. Do not edit.\n" <>
    "# Chicago-style: real Ash.create!/Ash.read! against the real ETS data layer - no mocks.\n" <>
    "defmodule BeamPM.AshGeneratedTest do\n" <>
    "  use ExUnit.Case, async: false\n\n" <>
    tests <>
    "end\n"
%><%= rendered %>