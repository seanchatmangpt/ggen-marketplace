<%
# ggen_igniter EEx template -> test/beam4pm_pro_simulation_test.exs
# Bindings: NONE required -- fully static.
%># GENERATED by ggen_igniter from the beam4pm_pro_simulation static template. Do not edit.
defmodule BeamPM.Pro.SimulationTest do
  use ExUnit.Case, async: true

  alias BeamPM.Pro.Simulation

  @edges [{"a", "b", 5}, {"b", "c", 3}, {"c", "a", 1}]

  test "apply_change/2 removes a matching edge, no-op if absent" do
    assert Simulation.apply_change(@edges, {:remove, "b", "c"}) == [{"a", "b", 5}, {"c", "a", 1}]
    assert Simulation.apply_change(@edges, {:remove, "x", "y"}) == @edges
  end

  test "apply_change/2 adds a new edge, no-op if it already exists" do
    result = Simulation.apply_change(@edges, {:add, "c", "d", 2})
    assert {"c", "d", 2} in result
    assert Simulation.apply_change(@edges, {:add, "a", "b", 99}) == @edges
  end

  test "reachable_from/2 computes real forward reachability" do
    assert Simulation.reachable_from(@edges, "a") == MapSet.new(["a", "b", "c"])
    assert Simulation.reachable_from([{"a", "b", 1}], "b") == MapSet.new(["b"])
  end

  test "removing an edge changes real reachability" do
    reduced = Simulation.apply_change(@edges, {:remove, "b", "c"})
    assert Simulation.reachable_from(reduced, "a") == MapSet.new(["a", "b"])
  end

  test "has_cycle?/1 detects a real cycle a -> b -> c -> a" do
    assert Simulation.has_cycle?(@edges) == true
  end

  test "has_cycle?/1 returns false for an acyclic graph" do
    assert Simulation.has_cycle?([{"a", "b", 1}, {"b", "c", 1}]) == false
  end

  test "removing the closing edge breaks the cycle" do
    acyclic = Simulation.apply_change(@edges, {:remove, "c", "a"})
    assert Simulation.has_cycle?(acyclic) == false
  end

  test "adding an edge can introduce a cycle" do
    base = [{"x", "y", 1}, {"y", "z", 1}]
    assert Simulation.has_cycle?(base) == false
    with_cycle = Simulation.apply_change(base, {:add, "z", "x", 1})
    assert Simulation.has_cycle?(with_cycle) == true
  end

  test "gaps/0 names real, not-yet-implemented simulation capabilities" do
    gaps = Simulation.gaps()
    assert :discrete_event_simulation in gaps
    assert is_list(gaps)
    refute gaps == []
  end
end
