<%
# ggen_igniter EEx template -> test/beam4pm_ash_kernel_test.exs
#
# Split out of the former single-file beam4pm_ash_test.exs.eex 2026-09-02
# (see beam4pm_ash_resource_test.exs.eex's header): this is the static
# BeamPM.AutonomyKernelGeneratedTest module that lived in the same monolith
# test file but has no per-record shape of its own, so it does not belong
# in the --for-each resource-test split. No query bindings used -- content
# is fully static, preserved verbatim.
rendered = "# GENERATED by ggen_igniter. Do not edit.\n"
%><%= rendered %>
defmodule BeamPM.AutonomyKernelGeneratedTest do
  use ExUnit.Case, async: false
  alias BeamPM.Autonomy.Kernel

  defp candidates do
    [
      %{id: "fast-risky", utility: 0.95, risk: 0.9, reversibility: 0.2, evidence: 0.5},
      %{id: "safe-reversible", utility: 0.8, risk: 0.1, reversibility: 1.0, evidence: 0.9},
      %{id: "explore", utility: 0.6, risk: 0.2, reversibility: 0.95, evidence: 0.7}
    ]
  end

  test "DfCM frontier preserves all alternatives and is deterministic" do
    a = Kernel.frontier(candidates(), %{state: 7, evidence: ["r1"]})
    b = Kernel.frontier(candidates(), %{state: 7, evidence: ["r1"]})
    assert length(a.candidates) == 3
    assert a.selected == nil
    assert a.authority == nil
    assert a == b
    assert Enum.map(a.candidates, & &1.id) == ["safe-reversible", "explore", "fast-risky"]
  end

  test "counterfactual simulation can never masquerade as execution" do
    frontier = Kernel.frontier(candidates(), :observed)
    assert {:ok, cf} = Kernel.simulate(frontier, "safe-reversible", %{outcome: :better})
    assert cf.kind == :counterfactual
    refute cf.executed?
    assert {:refused, :not_an_execution_receipt} = Kernel.replay(cf, cf.prediction)
  end

  test "SELECT and hook intent do not actuate" do
    table = :ets.new(:beam4pm_no_do, [:set, :public])
    frontier = Kernel.frontier(candidates(), :observed)
    assert {:ok, selection} = Kernel.select(frontier, %{max_risk: 0.3, min_evidence: 0.6})
    refute selection.authorized?
    assert {:ok, intent} = Kernel.intent(selection, "knowledge-hook-1")
    refute intent.authorized?
    refute intent.executed?
    assert :ets.lookup(table, :k) == []
  end

  test "authority is exact-intent and exact-candidate scoped" do
    frontier = Kernel.frontier(candidates(), :observed)
    {:ok, selection} = Kernel.select(frontier, %{max_risk: 0.3})
    {:ok, intent} = Kernel.intent(selection, "hook")
    assert {:refused, :intent_identity_mismatch} = Kernel.grant(intent, %{authority_id: "a", intent_hash: "wrong", candidate_id: intent.candidate_id, do: true})
    assert {:refused, :scope_mismatch} = Kernel.grant(intent, %{authority_id: "a", intent_hash: Kernel.digest(intent), candidate_id: "other", do: true})
  end

  test "BRCE is the exclusive DO boundary and binds actual ETS consequence" do
    table = :ets.new(:beam4pm_brce, [:set, :public])
    frontier = Kernel.frontier(candidates(), :observed)
    {:ok, selection} = Kernel.select(frontier, %{max_risk: 0.3, min_reversibility: 0.9})
    {:ok, intent} = Kernel.intent(selection, "hook")
    {:ok, grant} = Kernel.grant(intent, %{authority_id: "authority-1", intent_hash: Kernel.digest(intent), candidate_id: intent.candidate_id, do: true})
    assert :ets.lookup(table, :status) == []
    assert {:ok, receipt} = Kernel.brce_do(intent, grant, {:ets_put, table, :status, :executed})
    assert :ets.lookup(table, :status) == [{:status, :executed}]
    assert receipt.kind == :execution_receipt
    assert receipt.executed?
    assert receipt.standing == :alive
    assert {:ok, replay} = Kernel.replay(receipt, {:ets_value, :status, [{:status, :executed}]})
    assert replay.verified?
    assert {:ok, learning} = Kernel.learn(replay, frontier)
    assert learning.policy_update == %{evidence_delta: 1, authority_delta: 0}
  end

  test "tampered consequence is refused and cannot learn" do
    table = :ets.new(:beam4pm_tamper, [:set, :public])
    frontier = Kernel.frontier(candidates(), :observed)
    {:ok, selection} = Kernel.select(frontier, %{max_risk: 0.3})
    {:ok, intent} = Kernel.intent(selection, "hook")
    {:ok, grant} = Kernel.grant(intent, %{authority_id: "authority-1", intent_hash: Kernel.digest(intent), candidate_id: intent.candidate_id, do: true})
    {:ok, receipt} = Kernel.brce_do(intent, grant, {:ets_put, table, :x, 1})
    assert {:refused, :consequence_mismatch} = Kernel.replay(receipt, {:ets_value, :x, [{:x, 2}]})
    assert {:refused, :unverified_replay} = Kernel.learn(%{kind: :replay_result, verified?: false}, frontier)
  end
end
