<%
# ggen_igniter EEx template -> test/beam4pm_ash_resources_test.exs
# (single output, NOT --for-each -- see scripts/igniter_sync.sh section 2a's
# updated comment for why this differs from 1a's lib/ split).
#
# Real signal worth keeping: that each Ash.Resource's ATTRIBUTES correctly
# mirror its admitted bpm:RecordType's fields (name/type wiring is a real,
# catchable defect class in the resource-generation template) -- proven by
# a real Ash.create!/Ash.read! round-trip per resource, no mocks. NOT worth
# keeping as 592 separate ExUnit test files/processes: that was testing
# Ash's own ETS DataLayer create/read mechanics repeatedly (Ash's own test
# suite already covers that upstream), not beam4pm's field mapping. One
# runtime loop over all admitted resources proves the exact same per-
# resource, per-field assertions (still individually checked, labeled by
# record name on failure) at ~592x fewer test-process spawns.
#
# Bindings: full raw `records`/`fields` lists (needs norm.()).
norm = fn
  nil -> nil
  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") -> String.slice(v, 1..-2//1)
      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end
      true -> v
    end
  v -> to_string(v)
end

to_int = fn v -> v |> norm.() |> String.to_integer() end
camel = fn name -> name |> String.split("_") |> Enum.map(&String.capitalize/1) |> Enum.join() end

sample = fn type ->
  case type do
    "string" -> ~s("sample_x")
    "datetime" -> ~s("2026-08-29T12:00:00Z")
    "integer" -> "42"
    "float" -> "3.5"
    "boolean" -> "true"
    "atom" -> ":sample_atom"
    "list_string" -> ~s(["alpha", "beta"])
    "map" -> ~s(%{"k" => "v"})
  end
end
expected = fn type -> if type == "datetime", do: "~U[2026-08-29 12:00:00Z]", else: sample.(type) end

record_names = records |> Enum.map(&norm.(&1["record_name"])) |> Enum.uniq() |> Enum.sort()

entries =
  Enum.map(record_names, fn rname ->
    rf =
      fields
      |> Enum.filter(fn f -> norm.(f["record_name"]) == rname end)
      |> Enum.map(fn f ->
        %{
          name: norm.(f["field_name"]),
          type: norm.(f["field_type"]),
          order: to_int.(f["field_order"])
        }
      end)
      |> Enum.sort_by(& &1.order)

    params = Enum.map_join(rf, ",\n", fn f -> "          #{f.name}: #{sample.(f.type)}" end)
    expected_kv = Enum.map_join(rf, ",\n", fn f -> ~s(          #{f.name}: #{expected.(f.type)}) end)

    Enum.join(
      [
        "    %{",
        "      name: #{inspect(rname)},",
        "      mod: BeamPM.Ash.Resources.#{camel.(rname)},",
        "      params: %{",
        params,
        "      },",
        "      expected: %{",
        expected_kv,
        "      }",
        "    }"
      ],
      "\n"
    )
  end)

resources_list = Enum.join(entries, ",\n")

rendered =
  Enum.join(
    [
      "# GENERATED by ggen_igniter. Do not edit.",
      "defmodule BeamPM.Ash.ResourcesGeneratedTest do",
      "  use ExUnit.Case, async: false",
      "",
      "  @resources [",
      resources_list,
      "  ]",
      "",
      "  test \"every admitted Ash resource: real Ash ETS create/read round-trips every field\" do",
      "    for r <- @resources do",
      "      created =",
      "        r.mod",
      "        |> Ash.Changeset.for_create(:create, r.params)",
      "        |> Ash.create!()",
      "",
      "      [read_back] = Ash.read!(r.mod)",
      "      assert read_back.id == created.id, \"#{r.name}: read-back id did not match created id\"",
      "",
      "      for {k, v} <- r.expected do",
      "        assert Map.get(read_back, k) == v,",
      "               \"#{r.name}: field #{k} expected #{inspect(v)}, got #{inspect(Map.get(read_back, k))}\"",
      "      end",
      "    end",
      "  end",
      "end"
    ],
    "\n"
  ) <> "\n"
%><%= rendered %>
