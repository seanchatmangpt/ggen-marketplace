<%
# ggen_igniter EEx template -> test/beam4pm_ash/resources/<record_name>_test.exs
# (one invocation per admitted bpm:RecordType row, via `mix ggen_igniter.sync
# --for-each records`). Chicago-style ExUnit: a real Ash ETS create/read
# round-trip for this one admitted record type. No mocks.
#
# Split out of the former single-file beam4pm_ash_test.exs.eex 2026-09-02,
# mirroring beam4pm_ash_resource.ex.eex's split -- same measured
# marginal-compile-cost rationale applies to `mix test` compilation of the
# test suite itself. Semantics preserved verbatim; only the file boundary
# moved. `test/test_helper.exs` (unchanged, already ExUnit.start()) covers
# this nested test/beam4pm_ash/resources/ directory automatically -- mix's
# default test_paths ["test"] recurses, so no new test_helper is needed.
#
# Bindings: record_name (row-local, already-normalized plain string per
# --for-each) and the full raw `fields` list (needs norm.()), same shape as
# beam4pm_ash_resource.ex.eex.
norm = fn
  nil -> nil
  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") -> String.slice(v, 1..-2//1)
      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end
      true -> v
    end
  v -> to_string(v)
end

to_int = fn v -> v |> norm.() |> String.to_integer() end
camel = fn name -> name |> String.split("_") |> Enum.map(&String.capitalize/1) |> Enum.join() end

this_name = record_name

rf =
  fields
  |> Enum.filter(fn f -> norm.(f["record_name"]) == this_name end)
  |> Enum.map(fn f ->
    %{
      name: norm.(f["field_name"]),
      type: norm.(f["field_type"]),
      required: norm.(f["field_required"]) == "true",
      order: to_int.(f["field_order"])
    }
  end)
  |> Enum.sort_by(& &1.order)

sample = fn f ->
  case f.type do
    "string" -> ~s("sample_#{f.name}")
    "datetime" -> ~s("2026-08-29T12:00:00Z")
    "integer" -> "42"
    "float" -> "3.5"
    "boolean" -> "true"
    "atom" -> ":sample_atom"
    "list_string" -> ~s(["alpha", "beta"])
    "map" -> ~s(%{"k" => "v"})
  end
end
expected = fn f -> if f.type == "datetime", do: "~U[2026-08-29 12:00:00Z]", else: sample.(f) end

mod = "BeamPM.Ash.Resources.#{camel.(this_name)}"
params = Enum.map_join(rf, ",\n", fn f -> "      #{f.name}: #{sample.(f)}" end)
asserts = Enum.map_join(rf, "\n", fn f -> "    assert read_back.#{f.name} == #{expected.(f)}" end)

rendered =
  Enum.join(
    [
      "# GENERATED by ggen_igniter. Do not edit.",
      "defmodule BeamPM.Ash.Resources.#{camel.(this_name)}Test do",
      "  use ExUnit.Case, async: false",
      "",
      "  test \"#{this_name}: real Ash ETS create/read round-trips every field\" do",
      "    params =",
      "      %{",
      params,
      "      }",
      "",
      "    created =",
      "      #{mod}",
      "      |> Ash.Changeset.for_create(:create, params)",
      "      |> Ash.create!()",
      "",
      "    [read_back] = Ash.read!(#{mod})",
      "    assert read_back.id == created.id",
      asserts,
      "  end",
      "end"
    ],
    "\n"
  ) <> "\n"
%><%= rendered %>
