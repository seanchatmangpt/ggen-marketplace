<%
# ggen_igniter EEx template -> lib/beam4pm_ocel_ingest.ex
#
# Bindings (from `mix ggen_igniter.sync
#   --query routes=.../admitted_ingest_routes.rq`):
#   routes - list of string-keyed maps: "route_path", "http_method", "record_type"
#
# Engine-shape note (same convention as beam4pm_actuation.ex.eex): `--engine
# oxigraph` (the default) returns RAW N-Triples-style terms (IRIs
# angle-bracketed, literals quoted and possibly datatype-tagged); `--engine
# sparql` returns plain unwrapped Elixir values. norm/1 handles both. Row
# order is NEVER trusted - all rows are re-sorted here with Enum.sort_by.
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

route_rows =
  routes
  |> Enum.map(fn r ->
    %{
      path: norm.(r["route_path"]),
      method: norm.(r["http_method"]) |> to_string() |> String.upcase(),
      record_type: norm.(r["record_type"])
    }
  end)
  |> Enum.sort_by(& &1.path)

routes_doc =
  Enum.map_join(route_rows, "\n", fn r ->
    "    * `#{r.method} #{r.path}` -> decodes into an admitted `#{r.record_type}`"
  end)

route_clauses =
  Enum.map_join(route_rows, "\n\n", fn r ->
    plug_method = String.downcase(r.method)

    """
      #{plug_method}(#{inspect(r.path)}) do
        handle_ingest(conn, #{inspect(r.record_type)})
      end
    """
  end)
%># GENERATED by ggen_igniter from the admitted bpmi:AdmittedIngestRoute graph. Do not edit.
defmodule BeamPM.OcelIngest.Router do
  @moduledoc """
  Real network-facing OCEL v2 ingestion endpoint -- beam4pm's own manufactured
  equivalent of ex4pm's retired `ex4pm_stream`/`ex4pm_web` umbrella apps, not
  a dependency on ex4pm. `BeamPM.OcelIngest.Router` is independence, not
  reuse: it decodes directly into beam4pm's own already-admitted
  `BeamPM.Types.OcelEvent`/`BeamPM.Types.OcelObject` structs (generated by
  `ggen` from the `bpm:RecordType` graph), never a second, parallel OCEL wire
  format and never a call into ex4pm.

  Admitted routes, from the `bpmi:AdmittedIngestRoute` admission graph
  (`ontology.ttl`) -- a route not listed here does not exist, it is a real
  404, never a silent catch-all:

  <%= routes_doc %>

  A malformed or unadmitted payload never crashes the plug pipeline: every
  path returns a typed JSON response (`200`/`201` for a real admitted
  decode, `422` for a real validation refusal from the generated `new/1`
  constructor, `404` for any route not in the admission graph above).
  """

  use Plug.Router

  plug(Plug.Parsers, parsers: [:json], json_decoder: JSON, pass: ["application/json"])
  plug(:match)
  plug(:dispatch)

<%= route_clauses %>
  match(_) do
    send_json(conn, 404, %{"ok" => false, "error" => "route_not_admitted"})
  end

  # -- Internal: per-record-type real decode + admission ---------------------

  defp handle_ingest(conn, "ocel_event") do
    case conn.body_params do
      %{"events" => events} when is_list(events) ->
        results = Enum.map(events, &decode_one(&1, :ocel_event))
        respond_batch(conn, results)

      single when is_map(single) ->
        respond_one(conn, decode_one(single, :ocel_event))

      _ ->
        send_json(conn, 422, %{"ok" => false, "error" => "expected a JSON object or {\"events\": [...]}"})
    end
  end

  defp handle_ingest(conn, "ocel_object") do
    case conn.body_params do
      %{"objects" => objects} when is_list(objects) ->
        results = Enum.map(objects, &decode_one(&1, :ocel_object))
        respond_batch(conn, results)

      single when is_map(single) ->
        respond_one(conn, decode_one(single, :ocel_object))

      _ ->
        send_json(conn, 422, %{"ok" => false, "error" => "expected a JSON object or {\"objects\": [...]}"})
    end
  end

  # `new/1`'s generated constructors detect a missing field by key
  # ABSENCE (`Map.has_key?/2`), not by a nil value, so a raw JSON field that
  # is absent (or explicitly `null`) must be dropped from the attrs map
  # entirely here -- never passed through as `field: nil`, which would read
  # as "present but nil" and silently skip the real validation.
  defp present(raw, key, target) do
    case Map.get(raw, key) do
      nil -> %{}
      value -> %{target => value}
    end
  end

  # Real OCEL 2.0 JSON export shape nests each event/object's own
  # relationships (E2O for events, O2O for objects) directly under it
  # (`"relationships": [...]`) rather than as a separate top-level
  # collection -- `BeamPM.Types.OcelRelationship` carries only
  # `qualifier`/`object_id` (the ontology's admitted shape has no separate
  # "owner" field), so nesting under the owning event/object in the wire
  # payload IS how ownership is represented, matching the real OCEL 2.0
  # spec's own JSON structure rather than inventing a parallel format.
  defp decode_relationships(raw) do
    case Map.get(raw, "relationships") do
      nil ->
        {:ok, []}

      rels when is_list(rels) ->
        results =
          Enum.map(rels, fn r ->
            attrs =
              %{}
              |> Map.merge(present(r, "qualifier", :qualifier))
              |> Map.merge(present(r, "object_id", :object_id))

            BeamPM.Types.OcelRelationship.new(attrs)
          end)

        case Enum.split_with(results, &match?({:ok, _}, &1)) do
          {oks, []} ->
            {:ok, Enum.map(oks, fn {:ok, r} -> r end)}

          {_, [{:error, {:missing_field, field}} | _]} ->
            {:error, {:relationship_missing_field, field}}
        end

      _ ->
        {:error, {:invalid_field, :relationships}}
    end
  end

  defp decode_one(raw, :ocel_event) when is_map(raw) do
    attrs =
      %{}
      |> Map.merge(present(raw, "event_id", :event_id))
      |> Map.merge(present(raw, "event_type", :event_type))
      |> Map.merge(present(raw, "event_time", :event_time))
      |> Map.merge(present(raw, "attributes", :attributes))

    with {:ok, record} <- BeamPM.Types.OcelEvent.new(attrs),
         {:ok, rels} <- decode_relationships(raw) do
      {:ok, record, rels}
    end
  end

  defp decode_one(raw, :ocel_object) when is_map(raw) do
    attrs =
      %{}
      |> Map.merge(present(raw, "object_id", :object_id))
      |> Map.merge(present(raw, "object_type", :object_type))
      |> Map.merge(present(raw, "attributes", :attributes))

    with {:ok, record} <- BeamPM.Types.OcelObject.new(attrs),
         {:ok, rels} <- decode_relationships(raw) do
      {:ok, record, rels}
    end
  end

  defp respond_one(conn, {:ok, record, rels}) do
    send_json(conn, 201, %{"ok" => true, "record" => record_to_json(record, rels)})
  end

  defp respond_one(conn, {:error, {:missing_field, field}}) do
    send_json(conn, 422, %{"ok" => false, "error" => "missing_field", "field" => to_string(field)})
  end

  defp respond_one(conn, {:error, {:relationship_missing_field, field}}) do
    send_json(conn, 422, %{
      "ok" => false,
      "error" => "missing_field",
      "field" => to_string(field),
      "in" => "relationships"
    })
  end

  defp respond_one(conn, {:error, {:invalid_field, field}}) do
    send_json(conn, 422, %{"ok" => false, "error" => "invalid_field", "field" => to_string(field)})
  end

  defp respond_batch(conn, results) do
    {oks, errors} =
      Enum.reduce(results, {[], []}, fn
        {:ok, record, rels}, {oks, errors} ->
          {[record_to_json(record, rels) | oks], errors}

        {:error, {:missing_field, field}}, {oks, errors} ->
          {oks, [to_string(field) | errors]}

        {:error, {:relationship_missing_field, field}}, {oks, errors} ->
          {oks, ["relationships." <> to_string(field) | errors]}

        {:error, {:invalid_field, field}}, {oks, errors} ->
          {oks, [to_string(field) | errors]}
      end)

    status = if errors == [], do: 201, else: 422

    send_json(conn, status, %{
      "ok" => errors == [],
      "accepted" => Enum.reverse(oks),
      "rejected_missing_fields" => Enum.reverse(errors)
    })
  end

  defp record_to_json(%BeamPM.Types.OcelEvent{} = e, rels) do
    %{
      "event_id" => e.event_id,
      "event_type" => e.event_type,
      "event_time" => e.event_time,
      "attributes" => e.attributes,
      "relationships" => Enum.map(rels, &relationship_to_json/1)
    }
  end

  defp record_to_json(%BeamPM.Types.OcelObject{} = o, rels) do
    %{
      "object_id" => o.object_id,
      "object_type" => o.object_type,
      "attributes" => o.attributes,
      "relationships" => Enum.map(rels, &relationship_to_json/1)
    }
  end

  defp relationship_to_json(%BeamPM.Types.OcelRelationship{} = r) do
    %{"qualifier" => r.qualifier, "object_id" => r.object_id}
  end

  defp send_json(conn, status, payload) do
    conn
    |> Plug.Conn.put_resp_content_type("application/json")
    |> Plug.Conn.send_resp(status, JSON.encode!(payload))
  end
end
