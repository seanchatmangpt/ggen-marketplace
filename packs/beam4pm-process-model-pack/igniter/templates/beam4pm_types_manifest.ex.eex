<%
# Cross-engine identity probe: reproduce, byte-for-byte, the output of the
# real Rust ggen + Tera template
# (beam4pm-process-model-pack/templates/beam4pm_types_manifest.ex.tmpl)
# through ggen_igniter + EEx, so the two manufacturing engines can be diffed
# against the same admitted graph. The GENERATED marker is kept as "by ggen"
# deliberately - identical content is the point of the probe.
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

to_int = fn v -> v |> norm.() |> String.to_integer() end

recs =
  records
  |> Enum.map(fn r -> %{name: norm.(r["record_name"])} end)
  |> Enum.sort_by(& &1.name)

flds =
  Enum.map(fields, fn f ->
    %{
      record: norm.(f["record_name"]),
      name: norm.(f["field_name"]),
      order: to_int.(f["field_order"])
    }
  end)

fields_for = fn rec ->
  flds |> Enum.filter(&(&1.record == rec)) |> Enum.sort_by(& &1.order)
end

moduledoc =
  "Reflection manifest over the admitted bpm:RecordType graph: every admitted record " <>
    "name, and each record's ordered field-name list, without needing to know the " <>
    "individual struct modules."

rendered =
  "# GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.\n" <>
    "defmodule BeamPM.Types.Manifest do\n" <>
    "  @moduledoc \"#{moduledoc}\"\n" <>
    "\n" <>
    "  @spec record_names() :: [atom()]\n" <>
    "  def record_names, do: [" <>
    Enum.map_join(recs, ", ", &(":" <> &1.name)) <>
    "]\n" <>
    "\n" <>
    "  @spec fields(atom()) :: [atom()]\n" <>
    Enum.map_join(recs, "", fn r ->
      "  def fields(:#{r.name}), do: [" <>
        Enum.map_join(fields_for.(r.name), ", ", &(":" <> &1.name)) <> "]\n"
    end) <>
    "  def fields(_), do: []\n" <>
    "end\n"
%><%= rendered %>