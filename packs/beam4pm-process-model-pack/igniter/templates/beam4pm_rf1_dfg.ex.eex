<%
# ggen_igniter EEx template -> lib/beam4pm_rf1_dfg.ex
#
# STREAM RF1: rust4pm's (process_mining 0.6.2) real XES importer +
# core::event_data::case_centric::utils::activity_projection::log_to_activity_projection
# + discovery::case_centric::dfg::discover_dfg + the case_centric activity-
# projection queries (get_num_cases/get_num_variants/get_projection_activities/
# get_top_n_variants).
#
# Bindings: NONE required. Unlike beam4pm_ash.ex.eex (which fans out over a
# `--query records=...` result), this stream has exactly two fixed canonical
# datasets and their exact observed values -- discovered by REALLY RUNNING the
# real rf1-dfg-oracle binary against them (never guessed) -- so this template
# is rendered with `--ontology <trivial>.ttl` and no `--query` at all. The
# observed constants below are baked in as real Elixir literals, sourced
# verbatim from `runs/small-example.json` / `runs/roadtraffic100traces.json`
# in the STREAM RF1 scratch tree (real oracle stdout, pretty-printed).
%># GENERATED by ggen_igniter from STREAM RF1's fixed dfg-discovery template. Do not edit.
defmodule BeamPM.RF1.DfgOracleBridge do
  @moduledoc """
  One-shot Port-based wrapper around the real `rf1-dfg-oracle` native binary
  (`native/rf1-dfg-oracle/`, `process_mining = "=0.6.2"` pinned, mirroring
  `qualification/rust4pm-oracle`'s proven feature-flag recipe:
  `default-features = false`).

  Wire contract (FIXED):

      stdin:  {"op":"dfg_discover","xes_path":"<path>"}
      stdout: {"edges":[{"source":s,"target":t,"frequency":n}, ...],
               "num_cases":N,"num_variants":N,
               "top_variant":[...activity names...],
               "activities":[...sorted activity names...]}
      exit:   0 on success; nonzero with a stderr reason otherwise.

  A real subprocess collaborator (Chicago discipline): this bridge only
  frames the request/response; the real XES import, activity projection, and
  DFG discovery are all performed by rust4pm itself inside the oracle
  binary. No part of this module fakes the oracle's output.

  ## Why a real file + `sh -c "... < file"`, not raw `Port.command` bytes

  The oracle reads its ENTIRE stdin to EOF (`std::io::stdin().read_to_string`)
  before producing any output, then exits. A live Erlang port's stdin has no
  half-close primitive reachable from `Port.command/2` -- `Port.close/1`
  tears down BOTH directions of the port immediately, which was verified
  directly (real probe, real broken-pipe panic from a real oracle binary run
  under a bare `Port.command` + `Port.close` sequence) to race the child's
  stdout write against the just-closed read side and lose the response. The
  robust, real fix (also verified directly, five repeated real runs, byte-
  identical output every time on the deterministic dataset): write the exact
  same JSON payload the bare CLI takes on stdin to a real temporary file, then
  spawn `sh -c "<oracle> < <payload_file> 2>&1"` -- the oracle's stdin is then
  a genuine file descriptor with a natural EOF, exactly like the documented
  `./rf1-dfg-oracle < payload.json` CLI invocation, just automated under a
  Port. `2>&1` merges the oracle's real stderr into the captured stream so a
  falsify step can inspect the real parse-failure/IO-failure text, not just
  the exit status.
  """

  @spec run(String.t(), String.t(), non_neg_integer()) ::
          {:ok, %{exit_status: 0, decoded: map(), raw: String.t()}}
          | {:error, {:oracle_failed, non_neg_integer(), String.t()}}
          | {:error, {:oracle_bad_json, String.t()}}
          | {:error, {:oracle_timeout, non_neg_integer()}}
  def run(oracle_bin, xes_path, timeout \\ 15_000)
      when is_binary(oracle_bin) and is_binary(xes_path) do
    payload = JSON.encode!(%{"op" => "dfg_discover", "xes_path" => xes_path})

    payload_file =
      Path.join(
        System.tmp_dir!(),
        "rf1-dfg-oracle-#{System.unique_integer([:positive, :monotonic])}.json"
      )

    File.write!(payload_file, payload)

    sh = System.find_executable("sh") || raise "rf1-dfg-oracle bridge: \"sh\" not found on PATH"
    cmd = "#{oracle_bin} < #{payload_file} 2>&1"

    port =
      Port.open({:spawn_executable, sh}, [
        :binary,
        :exit_status,
        :use_stdio,
        {:line, 16_777_216},
        args: ["-c", cmd]
      ])

    result = collect(port, [], timeout)
    File.rm(payload_file)
    result
  end

  defp collect(port, acc, timeout) do
    receive do
      {^port, {:data, {:eol, chunk}}} ->
        collect(port, [chunk, "\n" | acc], timeout)

      {^port, {:data, {:noeol, chunk}}} ->
        collect(port, [chunk | acc], timeout)

      {^port, {:exit_status, status}} ->
        raw =
          acc
          |> Enum.reverse()
          |> IO.iodata_to_binary()
          |> String.trim_trailing("\n")

        finalize(status, raw)
    after
      timeout ->
        Port.close(port)
        {:error, {:oracle_timeout, timeout}}
    end
  end

  defp finalize(0, raw) do
    case JSON.decode(raw) do
      {:ok, decoded} -> {:ok, %{exit_status: 0, decoded: decoded, raw: raw}}
      {:error, _reason} -> {:error, {:oracle_bad_json, raw}}
    end
  end

  defp finalize(status, raw), do: {:error, {:oracle_failed, status, raw}}
end

defmodule BeamPM.RF1.DfgDiscovery do
  @moduledoc """
  STREAM RF1 Chicago-validation pipeline (`use Reactor`, NOT `Ash.Reactor`):
  four named steps, each a real invocation of the real `rf1-dfg-oracle`
  binary (real `process_mining` 0.6.2 XES import ->
  `log_to_activity_projection` -> `discover_dfg` + case_centric queries)
  against a real dataset, each asserting a real, specific, non-trivial fact
  -- never just "exit 0".

    * `:check_small_example` -- `small-example.xes` (2 traces, one with
      events carrying no `concept:name`), asserts the EXACT observed
      `num_cases`/`num_variants`/edge-set/activity-set.
    * `:check_roadtraffic` -- `roadtraffic100traces.xes` (100 traces),
      asserts the EXACT observed `num_cases`/`num_variants`/18-edge DFG/
      10-activity set/top variant.
    * `:falsify_wrong_path` -- points the oracle at a nonexistent XES path;
      asserts the pipeline detects the oracle's real nonzero exit +
      stderr (never a silently-empty success) and `compensate/2`-writes a
      typed refusal receipt.
    * `:falsify_truncated_xes` -- points the oracle at a REAL byte-truncated
      (cut at 50%) copy of `small-example.xes`; asserts the pipeline detects
      rust4pm's own real XML/XES parse failure (never silently-zero traces)
      and `compensate/2`-writes a typed refusal receipt.

  ## Why one `:scenario` input gates which step does real work

  All four steps are declared unconditionally in this ONE Reactor module
  (matching STREAM RF1's spec literally), but only ONE of them performs its
  real oracle invocation per `run/2` call -- gated by the `:scenario` input.
  The other three take a real, honest, unconditional early-return branch
  (`{:ok, :not_this_scenario}`) instead of touching the oracle at all.

  This is NOT the original design. The original design declared all four
  steps as unconditionally active and mutually independent (no `result/1`
  dependency among them), on the theory that a single `Reactor.run/4` call
  with `async?: false` would run every ready step to completion regardless
  of another step's failure. That theory was tested directly (a real
  `mix run` invocation, real `IO.inspect` of the raw result) against THIS
  reactor with its two real falsify steps both wired to fail-by-design, and
  falsified: only 3 of the 4 receipts landed on disk, and which of the two
  falsify steps' error survived into `Reactor.Error.Invalid.errors` was
  non-deterministic across repeated real runs (`falsify_wrong_path` present
  in one real run, `falsify_truncated_xes` present and `falsify_wrong_path`
  MISSING in another) -- proving Reactor stops scheduling not-yet-started
  ready steps as soon as any step fails, even for structurally-independent
  siblings, even under `async?: false`. Gating on `:scenario` so that
  exactly one step is ever real-and-fallible per invocation (mirroring
  `BeamPM.Actuation`'s own established pattern: one `use Reactor` pipeline,
  exercised via several separate `run/2` calls with different inputs, one
  per test) sidesteps that real scheduling behavior entirely rather than
  fighting it, and every scenario now completes fully and deterministically.

  ## Receipts (`beam4pm-rf1-dfg/v1`, one real JSON file per real `run/2` call)

  The one ACTIVE step -- passed check, or detected-and-compensated falsify
  -- writes exactly one receipt at `<receipts_dir>/<run_id>-<scenario>.json`
  documenting: function group, dataset used, real output values asserted
  (or, for a falsify step, the real detected failure), and outcome.
  """

  use Reactor

  alias BeamPM.RF1.DfgOracleBridge

  @receipt_schema "beam4pm-rf1-dfg/v1"
  @function_group "RF1: rust4pm XES import + log_to_activity_projection + discover_dfg + case_centric queries"

  @scenarios [
    :check_small_example,
    :check_roadtraffic,
    :falsify_wrong_path,
    :falsify_truncated_xes
  ]

  # -- Real observed values (baked in from an actual run of rf1-dfg-oracle;
  #    never guessed -- see runs/small-example.json / runs/roadtraffic100traces.json
  #    in the STREAM RF1 scratch tree for the exact captured stdout these were
  #    transcribed from). ---------------------------------------------------

  @small_example_num_cases 2
  @small_example_num_variants 2
  @small_example_activities ["Mail rejection", "No Activity", "Register client"]
  @small_example_edges [
    %{"source" => "", "target" => "", "frequency" => 3},
    %{"source" => "Register client", "target" => "Mail rejection", "frequency" => 1}
  ]
  # REAL, DISCLOSED non-determinism: both trace-1 ("Register client" ->
  # "Mail rejection") and trace-2 (four events with no `concept:name`,
  # classified "No Activity", producing "No Activity" x4) occur exactly
  # once each -- a genuine tie. `process_mining`'s own
  # `EventLogActivityProjection` construction goes through a `HashSet`/
  # `HashMap` whose iteration order is randomized per OS process, so which
  # of the two tied variants `get_top_n_variants(_, 1)` returns is NOT
  # stable across process runs -- verified directly (5 repeated real runs
  # of the bare oracle CLI against this exact file produced both orderings).
  # Asserting one exact sequence here would be asserting a coin flip, not a
  # fact about the algorithm -- so `:check_small_example` asserts SET
  # MEMBERSHIP in these two real, exhaustively-enumerated possibilities
  # instead of a single exact sequence. This is still a real, specific,
  # non-trivial, falsifiable assertion (a third, wrong sequence is rejected
  # exactly the same as before), not a vacuous "well, whatever it returns".
  @small_example_top_variant_ties [
    ["Register client", "Mail rejection"],
    ["No Activity", "No Activity", "No Activity", "No Activity"]
  ]

  @roadtraffic_num_cases 100
  @roadtraffic_num_variants 10
  @roadtraffic_activities [
    "Add penalty",
    "Create Fine",
    "Insert Date Appeal to Prefecture",
    "Insert Fine Notification",
    "Notify Result Appeal to Offender",
    "Payment",
    "Receive Result Appeal from Prefecture",
    "Send Appeal to Prefecture",
    "Send Fine",
    "Send for Credit Collection"
  ]
  @roadtraffic_edges [
    %{"source" => "Add penalty", "target" => "Payment", "frequency" => 20},
    %{"source" => "Add penalty", "target" => "Send Appeal to Prefecture", "frequency" => 1},
    %{"source" => "Add penalty", "target" => "Send for Credit Collection", "frequency" => 36},
    %{"source" => "Create Fine", "target" => "Payment", "frequency" => 23},
    %{"source" => "Create Fine", "target" => "Send Fine", "frequency" => 77},
    %{"source" => "Insert Date Appeal to Prefecture", "target" => "Add penalty", "frequency" => 1},
    %{"source" => "Insert Fine Notification", "target" => "Add penalty", "frequency" => 52},
    %{
      "source" => "Insert Fine Notification",
      "target" => "Insert Date Appeal to Prefecture",
      "frequency" => 1
    },
    %{"source" => "Insert Fine Notification", "target" => "Payment", "frequency" => 4},
    %{"source" => "Notify Result Appeal to Offender", "target" => "Payment", "frequency" => 1},
    %{"source" => "Payment", "target" => "Add penalty", "frequency" => 4},
    %{"source" => "Payment", "target" => "Insert Fine Notification", "frequency" => 1},
    %{"source" => "Payment", "target" => "Payment", "frequency" => 5},
    %{"source" => "Payment", "target" => "Send Fine", "frequency" => 1},
    %{
      "source" => "Receive Result Appeal from Prefecture",
      "target" => "Notify Result Appeal to Offender",
      "frequency" => 1
    },
    %{
      "source" => "Send Appeal to Prefecture",
      "target" => "Receive Result Appeal from Prefecture",
      "frequency" => 1
    },
    %{"source" => "Send Fine", "target" => "Insert Fine Notification", "frequency" => 56},
    %{"source" => "Send Fine", "target" => "Payment", "frequency" => 5}
  ]
  @roadtraffic_top_variant [
    "Create Fine",
    "Send Fine",
    "Insert Fine Notification",
    "Add penalty",
    "Send for Credit Collection"
  ]

  input(:scenario)
  input(:paths)

  # side_effect: mutating (real subprocess) only when `scenario ==
  # :check_small_example` -- real oracle run against the real canonical
  # small-example.xes fixture; asserts the exact observed values above. No
  # compensate/2: this step is not expected to ever fail in normal
  # operation (unlike the falsify steps below, whose entire purpose IS to
  # fail); an unexpected failure here is an honest, unrecovered crash.
  step :check_small_example do
    argument(:scenario, input(:scenario))
    argument(:paths, input(:paths))

    run(fn %{scenario: scenario, paths: paths}, _context ->
      if scenario == :check_small_example do
        xes_path = Map.fetch!(paths, :small_example_xes)
        oracle_bin = Map.fetch!(paths, :oracle_bin)

        case DfgOracleBridge.run(oracle_bin, xes_path) do
          {:ok, %{decoded: out}} ->
            case verify_observed(:small_example, out) do
              :ok ->
                path =
                  write_check_receipt!(
                    paths,
                    "check_small_example",
                    xes_path,
                    out,
                    "passed",
                    nil
                  )

                {:ok, active(:check_small_example, %{receipt_path: path, observed: out})}

              {:mismatch, reason} ->
                _ =
                  write_check_receipt!(
                    paths,
                    "check_small_example",
                    xes_path,
                    out,
                    "assertion_failed",
                    reason
                  )

                {:error, {:assertion_failed, reason}}
            end

          {:error, reason} ->
            {:error, {:oracle_unexpectedly_failed, reason}}
        end
      else
        {:ok, inactive(:check_small_example)}
      end
    end)

    max_retries(0)
  end

  # side_effect: mutating (real subprocess) only when `scenario ==
  # :check_roadtraffic` -- real oracle run against the real canonical
  # roadtraffic100traces.xes fixture (100 traces); asserts the exact
  # observed values above, including the (here genuinely deterministic,
  # no-tie) top variant.
  step :check_roadtraffic do
    argument(:scenario, input(:scenario))
    argument(:paths, input(:paths))

    run(fn %{scenario: scenario, paths: paths}, _context ->
      if scenario == :check_roadtraffic do
        xes_path = Map.fetch!(paths, :roadtraffic_xes)
        oracle_bin = Map.fetch!(paths, :oracle_bin)

        case DfgOracleBridge.run(oracle_bin, xes_path) do
          {:ok, %{decoded: out}} ->
            case verify_observed(:roadtraffic, out) do
              :ok ->
                path =
                  write_check_receipt!(paths, "check_roadtraffic", xes_path, out, "passed", nil)

                {:ok, active(:check_roadtraffic, %{receipt_path: path, observed: out})}

              {:mismatch, reason} ->
                _ =
                  write_check_receipt!(
                    paths,
                    "check_roadtraffic",
                    xes_path,
                    out,
                    "assertion_failed",
                    reason
                  )

                {:error, {:assertion_failed, reason}}
            end

          {:error, reason} ->
            {:error, {:oracle_unexpectedly_failed, reason}}
        end
      else
        {:ok, inactive(:check_roadtraffic)}
      end
    end)

    max_retries(0)
  end

  # side_effect: mutating (real subprocess) only when `scenario ==
  # :falsify_wrong_path` -- THE deliberately-wrong input: a nonexistent XES
  # path. `max_retries 0`: a falsify attempt must never be silently retried
  # into looking like something else. On the real, expected failure,
  # `compensate/2` writes a typed refusal receipt -- never a silent crash,
  # and (this is the property under test) never a silently-empty "success".
  step :falsify_wrong_path do
    argument(:scenario, input(:scenario))
    argument(:paths, input(:paths))

    run(fn %{scenario: scenario, paths: paths}, _context ->
      if scenario == :falsify_wrong_path do
        oracle_bin = Map.fetch!(paths, :oracle_bin)
        bad_path = Map.fetch!(paths, :nonexistent_xes)

        case DfgOracleBridge.run(oracle_bin, bad_path) do
          {:ok, %{decoded: out}} ->
            # The one truly bad outcome for a falsify step: a "successful",
            # silently-empty (or worse, non-empty but wrong) result instead
            # of a detected failure. Fail LOUDLY if this ever happens.
            {:error, {:falsify_did_not_detect_failure, :nonexistent_path, out}}

          {:error, {:oracle_failed, status, raw}} when status != 0 ->
            {:error, {:falsify_detected, :nonexistent_path, bad_path, status, raw}}

          {:error, other} ->
            {:error, {:falsify_detected_unexpected_shape, :nonexistent_path, other}}
        end
      else
        {:ok, inactive(:falsify_wrong_path)}
      end
    end)

    compensate(fn reason, %{scenario: scenario, paths: paths} ->
      if scenario == :falsify_wrong_path do
        _ = write_falsify_receipt!(paths, "falsify_wrong_path", reason)
      end

      :ok
    end)

    max_retries(0)
  end

  # side_effect: mutating (real subprocess + real corrupted file) only when
  # `scenario == :falsify_truncated_xes` -- THE other deliberately-wrong
  # input: a REAL byte-truncated (cut at 50%,
  # `qualification/fixtures/rf1_small_example_truncated.xes`) copy of
  # `small-example.xes`. Confirms rust4pm's own real XML/XES parser detects
  # the corruption (a real `UnclosedTag` `XMLParsingError`, not a fabricated
  # one) rather than returning a silently-empty or partial log.
  step :falsify_truncated_xes do
    argument(:scenario, input(:scenario))
    argument(:paths, input(:paths))

    run(fn %{scenario: scenario, paths: paths}, _context ->
      if scenario == :falsify_truncated_xes do
        oracle_bin = Map.fetch!(paths, :oracle_bin)
        truncated_path = Map.fetch!(paths, :truncated_xes)

        case DfgOracleBridge.run(oracle_bin, truncated_path) do
          {:ok, %{decoded: out}} ->
            {:error, {:falsify_did_not_detect_failure, :truncated_xes, out}}

          {:error, {:oracle_failed, status, raw}} when status != 0 ->
            if raw =~ "XES Error" or raw =~ "XMLParsingError" or raw =~ "XML Error" do
              {:error, {:falsify_detected, :truncated_xes, truncated_path, status, raw}}
            else
              # A real failure happened, but not the SPECIFIC real XML/XES
              # parse failure this falsify step exists to prove -- a
              # different real bug (e.g. the fixture path itself went
              # missing) must not be reported as "the corruption was
              # detected".
              {:error, {:falsify_detected_wrong_reason, :truncated_xes, status, raw}}
            end

          {:error, other} ->
            {:error, {:falsify_detected_unexpected_shape, :truncated_xes, other}}
        end
      else
        {:ok, inactive(:falsify_truncated_xes)}
      end
    end)

    compensate(fn reason, %{scenario: scenario, paths: paths} ->
      if scenario == :falsify_truncated_xes do
        _ = write_falsify_receipt!(paths, "falsify_truncated_xes", reason)
      end

      :ok
    end)

    max_retries(0)
  end

  # side_effect: pure -- runs only once ALL FOUR sibling steps have
  # succeeded (structurally gated via `result/1` on each). On a `:check_*`
  # scenario this is the ordinary, always-reached success path (the two
  # falsify steps trivially no-op when inactive). On a `:falsify_*` scenario
  # this step never runs at all -- the active falsify step genuinely fails,
  # so Reactor never schedules a step depending on its result -- which is
  # exactly why `run/2` below never needs to inspect this step's output on
  # the falsify path; the typed `{:error, ...}` from the active step's own
  # failure is already everything that path needs to report.
  step :summarize do
    argument(:scenario, input(:scenario))
    argument(:small_example, result(:check_small_example))
    argument(:roadtraffic, result(:check_roadtraffic))
    argument(:wrong_path, result(:falsify_wrong_path))
    argument(:truncated, result(:falsify_truncated_xes))

    run(fn args, _context ->
      active_result =
        [args.small_example, args.roadtraffic, args.wrong_path, args.truncated]
        |> Enum.find(& &1.active)

      {:ok, %{scenario: args.scenario, result: active_result}}
    end)

    max_retries(0)
  end

  return(:summarize)

  # -- Public entry point -----------------------------------------------

  @doc """
  Runs the RF1 dfg-discovery Reactor pipeline for exactly one `scenario`
  (one of `#{inspect(@scenarios)}`).

  `paths` (a map) required keys: `:oracle_bin`, `:small_example_xes`,
  `:roadtraffic_xes`, `:nonexistent_xes`, `:truncated_xes`, `:receipts_dir`.
  Optional: `:run_id` (defaults to a fresh unique id).

  Returns `{:ok, %{scenario: scenario, result: %{receipt_path: path,
  observed: map}}}` for a passing `:check_*` scenario, or
  `{:error, {:falsify_detected, reason}}` for a `:falsify_*` scenario that
  correctly detected its real wrong input (a real refusal receipt exists on
  disk at `receipt_path/1` either way -- see that function). Any other
  return shape (an `:assertion_failed`, or a falsify step that did NOT
  detect its wrong input) is a real finding, surfaced verbatim rather than
  coerced into one of the two expected shapes above.
  """
  @spec run(atom(), map()) :: {:ok, map()} | {:error, term()}
  def run(scenario, paths) when is_atom(scenario) and is_map(paths) do
    unless scenario in @scenarios do
      raise ArgumentError, "unknown scenario #{inspect(scenario)} (known: #{inspect(@scenarios)})"
    end

    {:ok, _} = Application.ensure_all_started(:reactor)
    paths = normalize_paths!(paths)

    case Reactor.run(__MODULE__, %{scenario: scenario, paths: paths}, %{}, async?: false) do
      {:ok, out} ->
        {:ok, out}

      {:error, error} ->
        case tagged_reasons(error) do
          [{_step, reason}] -> {:error, reason}
          other -> {:error, {:unexpected_reactor_error, other, error}}
        end
    end
  end

  @doc "The real receipt path a given scenario/run_id would write to (or did write to)."
  @spec receipt_path(map(), atom()) :: String.t()
  def receipt_path(paths, scenario) when is_atom(scenario) do
    paths = normalize_paths!(paths)
    Path.join(paths.receipts_dir, "#{paths.run_id}-#{scenario}.json")
  end

  @doc "Public, directly-testable comparison used by the two :check steps."
  @spec verify_observed(:small_example | :roadtraffic, map()) :: :ok | {:mismatch, String.t()}
  def verify_observed(:small_example, out) do
    expected = %{
      "num_cases" => @small_example_num_cases,
      "num_variants" => @small_example_num_variants,
      "activities" => @small_example_activities,
      "edges" => @small_example_edges
    }

    with :ok <- compare_scalar_fields(out, expected),
         :ok <- compare_top_variant_membership(out, @small_example_top_variant_ties) do
      :ok
    end
  end

  def verify_observed(:roadtraffic, out) do
    expected = %{
      "num_cases" => @roadtraffic_num_cases,
      "num_variants" => @roadtraffic_num_variants,
      "activities" => @roadtraffic_activities,
      "edges" => @roadtraffic_edges,
      "top_variant" => @roadtraffic_top_variant
    }

    compare_scalar_fields(out, expected)
  end

  defp compare_scalar_fields(out, expected) do
    mismatches =
      for {key, expected_value} <- expected,
          actual_value = Map.get(out, key),
          normalize_for_compare(actual_value) != normalize_for_compare(expected_value) do
        "#{key}: expected #{inspect(expected_value)}, got #{inspect(actual_value)}"
      end

    case mismatches do
      [] -> :ok
      _ -> {:mismatch, Enum.join(mismatches, "; ")}
    end
  end

  defp compare_top_variant_membership(out, allowed_ties) do
    actual = Map.get(out, "top_variant")

    if actual in allowed_ties do
      :ok
    else
      {:mismatch,
       "top_variant: expected one of #{inspect(allowed_ties)} (known real tie), got #{inspect(actual)}"}
    end
  end

  # `edges` rows are string-keyed maps either way (real oracle JSON, or a
  # real observed map re-decoded from a receipt file) -- sorted here so
  # field-order/row-order never causes a false mismatch; only real content
  # differences are ever reported.
  defp normalize_for_compare(edges) when is_list(edges) do
    Enum.sort_by(edges, fn
      %{} = row -> {Map.get(row, "source"), Map.get(row, "target")}
      other -> other
    end)
  end

  defp normalize_for_compare(other), do: other

  # -- Internal helpers ------------------------------------------------------

  defp active(scenario, extra), do: Map.merge(%{scenario: scenario, active: true}, extra)
  defp inactive(scenario), do: %{scenario: scenario, active: false}

  defp normalize_paths!(paths) do
    %{
      oracle_bin: Map.fetch!(paths, :oracle_bin),
      small_example_xes: Map.fetch!(paths, :small_example_xes),
      roadtraffic_xes: Map.fetch!(paths, :roadtraffic_xes),
      nonexistent_xes: Map.fetch!(paths, :nonexistent_xes),
      truncated_xes: Map.fetch!(paths, :truncated_xes),
      receipts_dir: Map.fetch!(paths, :receipts_dir),
      run_id:
        Map.get(
          paths,
          :run_id,
          "rf1-#{System.system_time(:millisecond)}-#{System.unique_integer([:positive])}"
        )
    }
  end

  defp receipt_path_internal(paths, scenario) do
    Path.join(paths.receipts_dir, "#{paths.run_id}-#{scenario}.json")
  end

  defp write_check_receipt!(paths, scenario, dataset, observed, outcome, mismatch_reason) do
    receipt = %{
      "receipt_schema" => @receipt_schema,
      "function_group" => @function_group,
      "scenario" => scenario,
      "dataset" => dataset,
      "outcome" => outcome,
      "observed" => observed,
      "mismatch_reason" => mismatch_reason,
      "falsify" => nil,
      "replay" => %{
        "oracle_bin" => paths.oracle_bin,
        "invocation" => "sh -c \"#{paths.oracle_bin} < <payload.json> 2>&1\"",
        "payload" => JSON.encode!(%{"op" => "dfg_discover", "xes_path" => dataset})
      }
    }

    path = receipt_path_internal(paths, scenario)
    File.mkdir_p!(Path.dirname(path))
    File.write!(path, JSON.encode!(receipt))
    path
  end

  defp write_falsify_receipt!(paths, scenario, reason) do
    {dataset, detected?, exit_status, stderr_excerpt} = falsify_receipt_fields(paths, reason)

    receipt = %{
      "receipt_schema" => @receipt_schema,
      "function_group" => @function_group,
      "scenario" => scenario,
      "dataset" => dataset,
      "outcome" => if(detected?, do: "falsify_detected", else: "falsify_did_not_detect"),
      "observed" => nil,
      "mismatch_reason" => nil,
      "falsify" => %{
        "expected_failure" => true,
        "detected" => detected?,
        "exit_status" => exit_status,
        "stderr_excerpt" => stderr_excerpt
      },
      "replay" => %{
        "oracle_bin" => paths.oracle_bin,
        "invocation" => "sh -c \"#{paths.oracle_bin} < <payload.json> 2>&1\""
      }
    }

    path = receipt_path_internal(paths, scenario)
    File.mkdir_p!(Path.dirname(path))
    File.write!(path, JSON.encode!(receipt))
    path
  end

  defp falsify_receipt_fields(_paths, {:falsify_detected, :nonexistent_path, dataset, status, raw}) do
    {dataset, true, status, raw}
  end

  defp falsify_receipt_fields(_paths, {:falsify_detected, :truncated_xes, dataset, status, raw}) do
    {dataset, true, status, raw}
  end

  defp falsify_receipt_fields(paths, {:falsify_detected_wrong_reason, :truncated_xes, status, raw}) do
    {paths.truncated_xes, false, status, raw}
  end

  defp falsify_receipt_fields(paths, {:falsify_did_not_detect_failure, :nonexistent_path, out}) do
    {paths.nonexistent_xes, false, nil, inspect(out)}
  end

  defp falsify_receipt_fields(paths, {:falsify_did_not_detect_failure, :truncated_xes, out}) do
    {paths.truncated_xes, false, nil, inspect(out)}
  end

  defp falsify_receipt_fields(_paths, other) do
    {nil, false, nil, inspect(other)}
  end

  # Pulls every real per-step `{step_name, tagged_reason}` pair back out of
  # Reactor's nested Splode error class (mirrors
  # `BeamPM.Actuation.principal_reason/1`'s structural matching, widened to
  # collect ALL tagged leaf reasons instead of just the first -- with the
  # `:scenario` gate above, exactly one step can ever actually fail per real
  # invocation, so this list is always length 1 in real operation).
  defp tagged_reasons(%{errors: errors}) when is_list(errors) do
    Enum.flat_map(errors, &tagged_reasons/1)
  end

  defp tagged_reasons(%{step: %{name: name}, error: reason}) do
    [{name, reason}]
  end

  defp tagged_reasons(%{error: nested}), do: tagged_reasons(nested)
  defp tagged_reasons(_other), do: []
end
