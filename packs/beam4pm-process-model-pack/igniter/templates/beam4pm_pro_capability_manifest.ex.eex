<%
# ggen_igniter EEx template -> lib/beam4pm_pro_capability_manifest.ex
#
# beam4pm_pro gap-closure item PRO-001 ("current-status truth source"): a
# machine-readable capability manifest introspected from EXACT current repo
# state, plus a verifier that fails the moment a customer-facing status claim
# disagrees with reality.
#
# Bindings: `admitted` (from --query admitted=admitted_actions.rq), the real
# bpma:AdmittedActuation graph -- gives admitted_actuations_fact/0 its real,
# ontology-bound evidence list (B4PM-1705), never hand-copied. Every other
# capability fact stays runtime-introspected (Code.ensure_loaded?/1 etc.),
# unaffected.
norm = fn
  nil -> nil
  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") -> String.slice(v, 1..-2//1)
      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end
      true -> v
    end
  v -> to_string(v)
end

actuation_rows =
  admitted
  |> Enum.map(fn a -> {norm.(a["action_name"]), norm.(a["gym_op"])} end)
  |> Enum.uniq()
  |> Enum.sort_by(fn {name, _} -> name end)

evidence_literal =
  "[" <> Enum.map_join(actuation_rows, ", ", fn {name, op} -> inspect("#{name} -> #{op}") end) <> "]"
%># GENERATED by ggen_igniter from the beam4pm_pro_capability_manifest template. Do not edit.
defmodule BeamPM.Pro.CapabilityManifest do
  @moduledoc """
  Machine-readable capability manifest for `beam4pm_pro` gap-closure item
  PRO-001 ("current-status truth source"). Every fact in `capabilities/0` is
  produced by introspecting the ACTUAL current repository state at call time
  -- never a hand-maintained claim -- so `verify/1` can catch a customer-facing
  status document the moment it drifts from reality.

  Delegates rather than reimplements wherever a real check already exists
  elsewhere in this codebase: `BeamPM.Rust4PM.wasm_built?/0` for the WASM
  engine, `BeamPM.Types.Manifest.record_names/0` for admitted record types.
  No probe ever raises -- every check is wrapped so a missing dependency
  degrades that one capability to `:unverified` with an explanatory evidence
  string, rather than crashing the whole manifest.
  """

  @type status :: :alive | :partial | :blocked | :unsupported | :unverified
  @type capability_fact :: %{capability: atom(), status: status(), evidence: [String.t()]}
  @type mismatch :: %{capability: atom(), claimed: atom(), actual: atom()}

  @doc "Every capability fact, deterministically sorted by capability atom."
  @spec capabilities() :: [capability_fact()]
  def capabilities do
    [
      rust4pm_wasm_engine_fact(),
      admitted_record_types_fact(),
      admitted_actuations_fact(),
      module_fact(:beam4pm_discovery_module, BeamPM.Discovery),
      module_fact(:beam4pm_billing_module, BeamPM.Billing),
      module_fact(:beam4pm_entitlement_module, BeamPM.Entitlement),
      module_fact(:beam4pm_precision_module, BeamPM.Precision),
      module_fact(:beam4pm_receipt_chain_module, BeamPM.ReceiptChain)
    ]
    |> Enum.sort_by(& &1.capability)
  end

  @doc "Look up a single capability fact, or nil for an unrecognized atom."
  @spec capability(atom()) :: capability_fact() | nil
  def capability(name) when is_atom(name) do
    Enum.find(capabilities(), &(&1.capability == name))
  end

  @doc "Just the :status field for a capability, or nil if unrecognized."
  @spec status(atom()) :: status() | nil
  def status(name) when is_atom(name) do
    case capability(name) do
      nil -> nil
      fact -> fact.status
    end
  end

  @doc "Just the :evidence list for a capability, or [] if unrecognized."
  @spec evidence_for(atom()) :: [String.t()]
  def evidence_for(name) when is_atom(name) do
    case capability(name) do
      nil -> []
      fact -> fact.evidence
    end
  end

  @doc """
  Verify a claimed-status map (e.g. parsed from a README front-matter block)
  against the real introspected state. An empty claim is vacuously
  consistent. Every mismatch (including an unrecognized claimed capability,
  reported with `actual: :unknown_capability`) is collected, not just the
  first.
  """
  @spec verify(%{atom() => atom()}) :: {:ok, :consistent} | {:error, {:contradicts, [mismatch()]}}
  def verify(claimed) when is_map(claimed) do
    mismatches =
      claimed
      |> Enum.map(fn {cap, claimed_status} ->
        actual_status =
          case capability(cap) do
            nil -> :unknown_capability
            fact -> fact.status
          end

        if actual_status == claimed_status do
          nil
        else
          %{capability: cap, claimed: claimed_status, actual: actual_status}
        end
      end)
      |> Enum.reject(&is_nil/1)

    if mismatches == [] do
      {:ok, :consistent}
    else
      {:error, {:contradicts, mismatches}}
    end
  end

  # ---------------------------------------------------------------------
  # Individual probes -- each one wrapped so a missing dependency degrades
  # to :unverified rather than raising.
  # ---------------------------------------------------------------------

  defp rust4pm_wasm_engine_fact do
    if Code.ensure_loaded?(BeamPM.Rust4PM) do
      if BeamPM.Rust4PM.wasm_built?() do
        %{
          capability: :rust4pm_wasm_engine,
          status: :alive,
          evidence: ["BeamPM.Rust4PM.wasm_built?/0 -> true"]
        }
      else
        reason =
          if function_exported?(BeamPM.Rust4PM, :wasm_missing_reason, 0) do
            BeamPM.Rust4PM.wasm_missing_reason()
          else
            "unknown"
          end

        %{
          capability: :rust4pm_wasm_engine,
          status: :unsupported,
          evidence: ["BeamPM.Rust4PM.wasm_built?/0 -> false", "reason: #{reason}"]
        }
      end
    else
      %{
        capability: :rust4pm_wasm_engine,
        status: :unverified,
        evidence: ["Code.ensure_loaded?(BeamPM.Rust4PM) -> false"]
      }
    end
  rescue
    e ->
      %{
        capability: :rust4pm_wasm_engine,
        status: :unverified,
        evidence: ["probe raised: #{Exception.message(e)}"]
      }
  end

  defp admitted_actuations_fact do
    %{
      capability: :admitted_actuations,
      status: :alive,
      evidence: <%= evidence_literal %>
    }
  end

  defp admitted_record_types_fact do
    if Code.ensure_loaded?(BeamPM.Types.Manifest) and
         function_exported?(BeamPM.Types.Manifest, :record_names, 0) do
      count = length(BeamPM.Types.Manifest.record_names())

      %{
        capability: :admitted_record_types,
        status: :alive,
        evidence: ["BeamPM.Types.Manifest.record_names/0 -> #{count} admitted types"]
      }
    else
      %{
        capability: :admitted_record_types,
        status: :unverified,
        evidence: ["Code.ensure_loaded?(BeamPM.Types.Manifest) -> false"]
      }
    end
  rescue
    e ->
      %{
        capability: :admitted_record_types,
        status: :unverified,
        evidence: ["probe raised: #{Exception.message(e)}"]
      }
  end

  defp module_fact(capability_name, module) do
    if Code.ensure_loaded?(module) do
      %{
        capability: capability_name,
        status: :alive,
        evidence: ["Code.ensure_loaded?(#{inspect(module)}) -> true"]
      }
    else
      %{
        capability: capability_name,
        status: :unverified,
        evidence: ["Code.ensure_loaded?(#{inspect(module)}) -> false"]
      }
    end
  rescue
    e ->
      %{
        capability: capability_name,
        status: :unverified,
        evidence: ["probe raised: #{Exception.message(e)}"]
      }
  end
end
