<%
# ggen_igniter EEx template -> lib/beam4pm_process_governor.ex
#
# Bindings (from `mix ggen_igniter.sync
#   --query transitions=.../process_transitions.rq`):
#   transitions - list of string-keyed maps: "process_id", "initial_state",
#                 "ordinal", "from_state", "to_state", "actuation_name"
#
# Engine-shape note (same convention as beam4pm_actuation.ex.eex): `--engine
# oxigraph` (the default) returns RAW N-Triples-style terms (IRIs
# angle-bracketed, literals quoted and possibly datatype-tagged); `--engine
# sparql` returns plain unwrapped Elixir values. norm/1 and norm_int/1
# handle both. Row order is NEVER trusted - all rows are re-sorted here
# with Enum.sort_by, same as the admitted-actuations allowlist.
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

norm_int = fn v ->
  case norm.(v) do
    nil -> nil
    s when is_binary(s) -> s |> Integer.parse() |> elem(0)
    n when is_integer(n) -> n
  end
end

transition_rows =
  transitions
  |> Enum.map(fn t ->
    %{
      process_id: norm.(t["process_id"]),
      initial_state: norm.(t["initial_state"]),
      ordinal: norm_int.(t["ordinal"]),
      from_state: norm.(t["from_state"]),
      to_state: norm.(t["to_state"]),
      actuation_name: norm.(t["actuation_name"])
    }
  end)
  |> Enum.sort_by(&{&1.process_id, &1.ordinal})

contracts_rows =
  transition_rows
  |> Enum.group_by(& &1.process_id)
  |> Enum.map(fn {process_id, rows} ->
    initial_state = rows |> hd() |> Map.fetch!(:initial_state)

    transitions =
      rows
      |> Enum.sort_by(& &1.ordinal)
      |> Enum.map(
        &%{
          ordinal: &1.ordinal,
          from_state: &1.from_state,
          to_state: &1.to_state,
          actuation_name: &1.actuation_name
        }
      )

    %{process_id: process_id, initial_state: initial_state, transitions: transitions}
  end)
  |> Enum.sort_by(& &1.process_id)

transition_literal = fn t ->
  "%{ordinal: #{t.ordinal}, from_state: #{inspect(t.from_state)}, to_state: #{inspect(t.to_state)}, actuation_name: #{inspect(t.actuation_name)}}"
end

contracts_entries =
  Enum.map_join(contracts_rows, ",\n", fn c ->
    ts = Enum.map_join(c.transitions, ",\n        ", transition_literal)

    "    #{inspect(c.process_id)} => %{\n" <>
      "      initial_state: #{inspect(c.initial_state)},\n" <>
      "      transitions: [\n        #{ts}\n      ]\n" <>
      "    }"
  end)

contracts_doc =
  Enum.map_join(contracts_rows, "\n", fn c ->
    steps =
      Enum.map_join(c.transitions, "\n", fn t ->
        "        #{t.ordinal}. #{inspect(t.from_state)} -> #{inspect(t.to_state)} via admitted actuation #{inspect(t.actuation_name)}"
      end)

    "    * `#{c.process_id}` (initial state #{inspect(c.initial_state)}):\n#{steps}"
  end)
%># GENERATED by ggen_igniter from the admitted bpmg:ProcessContract graph. Do not edit.
defmodule BeamPM.ProcessGovernor do
  @moduledoc """
  Multi-step, stateful PROCESS governance layered ON TOP of the real,
  already-qualified `BeamPM.Actuation` BRCE pipeline (gates PI7/PI8) -
  never a second, parallel plan/policy/authority/receipt/replay
  implementation.

  ## First-principles rewrite rationale (see also
  docs/first-principles-rewrite-rationale.md in the rewrite deliverable)

  A concurrently-merged `BeamPM.Governor` module independently reimplemented
  the ENTIRE Planner!=Policy!=Authority boundary a second time (plan
  candidate, policy decision, authority grant, `apply_transition/5`,
  receipt, replay) with zero shared code, zero I/O of any kind (so it could
  not actually be a DO/actuation path despite claiming to be one), an
  unauthenticated `authority_digest` accepted from the CALLER with no
  verification against anything the module itself computed, bare
  `is_map/1`-guarded dot-access that crashes with `KeyError` on any
  caller-supplied partial map instead of returning a typed refusal, a
  receipt shape incompatible with `BeamPM.Codec`/`BeamPM.Discovery` and the
  established `beam4pm-brce/v1` schema, and in-memory-only receipts lost on
  crash/restart. This module replaces it.

  This module adds EXACTLY ONE genuinely new capability `BeamPM.Actuation`
  does not have: a named, ordered SEQUENCE of admitted actuations forming
  one governed multi-step process, with an exact-state-hash precondition
  fencing each step. It reimplements NOTHING `BeamPM.Actuation` already
  does: `apply_transition/3` below DELEGATES the actual admit/execute/
  receipt work to `BeamPM.Actuation.run/2` for the transition's
  graph-declared `actuation_name` - it never re-derives an admission
  verdict, never opens a gym bridge port itself, and never invents a
  second hash/receipt scheme for the underlying consequence. The
  per-transition CONSEQUENCE receipt IS the real, already-qualified
  `beam4pm-brce/v1` receipt `BeamPM.Actuation.run/2` writes; this module's
  own process-level receipt (also written to disk, unlike the reimplemented
  module's in-memory-only receipt) only EMBEDS a reference to it
  (`run_id` + `receipt_path`), never a competing hash chain.

  What IS new (stream EX2): `actuation_opts_for/3` below defaults
  `chain_id: process_id` into every delegated `BeamPM.Actuation.run/2` call
  (unless the caller already supplied a `:chain_id`), so a governed
  process's own sequence of per-transition `beam4pm-brce/v1` receipts is
  automatically hash-chained by `BeamPM.ReceiptChain` -- each transition's
  actuation receipt embeds the sha256 of the immediately-prior transition's
  actuation receipt file. This is a SEPARATE, complementary evidence trail
  to this module's own `"actuation"` embed-by-reference: the embed proves
  WHICH receipt belongs to which transition; the hash chain proves that
  receipt's own prior sibling has not been tampered with since. See
  `BeamPM.ReceiptChain`'s moduledoc for the full design and
  `BeamPM.ReceiptChain.verify/2` for real, independent chain-replay
  verification.

  ## Authority doctrine (unchanged from BeamPM.Actuation, restated once)

  `plan_transition/2` is a Planner-stage function: it returns an INERT
  candidate (the graph-declared next step) and confers zero actuation
  authority. `apply_transition/3` is the only function that can cause a
  real-world consequence, and it can do so ONLY by calling
  `BeamPM.Actuation.run/2`, which is itself the exclusive DO boundary for
  beam4pm. There is no `authority_digest`, no second admission map, and no
  bare unvalidated map accepted where a real `BeamPM.Types` struct exists -
  `admitted_requires/1` below consults `BeamPM.Actuation.admitted_actuations/0`
  as the single source of truth for what an actuation name requires, rather
  than duplicating that bookkeeping.

  ## Exact-state-hash fencing (the one legitimate new idea worth keeping)

  `initial_snapshot/2` and every successful `apply_transition/3` compute
  `state_hash/2` (`sha256(process_id <> "|" <> state)`), a pure fingerprint
  used ONLY as an optimistic-concurrency precondition: `plan_transition/2`
  captures the hash the snapshot must still carry at apply-time
  (`expected_state_hash`), and `apply_transition/3` refuses (never crashes)
  if the snapshot presented no longer carries that exact hash - e.g. a
  stale snapshot, or a candidate built for a different state. This hash is
  NEVER used as a consequence-receipt identity; that identity is always
  `BeamPM.Actuation`'s own `run_id`/`receipt_path`.

  ## Graph-derived process contracts rendered into this build

  <%= contracts_doc %>

  ## Receipts (every path, `beam4pm-process-governor/v1`, on disk)

  Every `apply_transition/3` call - applied, refused, or execution-failed -
  ends in exactly one process-level receipt written to
  `<receipts_dir>/process/<process_id>-t<ordinal>-<run_id>.json`. When
  `BeamPM.Actuation.run/2` was actually called (fencing and admission both
  passed), the process receipt's `"actuation"` field embeds that REAL
  `beam4pm-brce/v1` receipt's `run_id` and `receipt_path` - it never copies
  or re-derives that receipt's contents. A pre-actuation refusal (fencing
  or an unadmitted `actuation_name`) embeds `"actuation": null`: no
  `BeamPM.Actuation.run/2` call was ever made, so no such receipt exists.

  ## Replay and mining (`replay/2`)

  A governed process run is a SEQUENCE of real `beam4pm-brce/v1` actuation
  receipts, one per applied transition, each still verifiable and
  re-mineable exactly as `scripts/actuation_selfmine.exs` already proves
  for a single actuation. `replay/2` re-opens every embedded receipt,
  confirms it still exists and its `receipt_schema`/`action_name` match
  what was recorded, and re-mines the WHOLE process run as one OCEL trace
  by chaining the real per-transition events together and re-tagging each
  event's `case_id` attribute to the process-level id for that one
  cross-transition trace (every `event_type`, `event_time`, and other
  attribute is the real value `BeamPM.Actuation` recorded - this is a
  disclosed re-projection for cross-transition aggregation, never a
  fabrication of new events). A refused or execution-failed transition
  simply ends the chain at that point, exactly mirroring how a single
  refused `BeamPM.Actuation.run/2` call already shows up as a shorter real
  activity sequence / missing DFG edges rather than a silent gap.
  """

  alias BeamPM.Actuation
  alias BeamPM.Actuation.Session
  alias BeamPM.Codec
  alias BeamPM.Discovery
  alias BeamPM.Types.DfgEdge
  alias BeamPM.Types.LogTrace
  alias BeamPM.Types.OcelEvent

  @process_receipt_schema "beam4pm-process-governor/v1"
  @actuation_receipt_schema "beam4pm-brce/v1"

  # Graph-derived process contracts (bpmg:ProcessContract + bpmg:ProcessTransition
  # individuals). Data-driven, never hardcoded: this literal is manufactured
  # by ggen_igniter from the admitted graph, the same way
  # BeamPM.Actuation's own @admitted_actuations is.
  @contracts %{
<%= contracts_entries %>
  }

  # -- Planner stage: proposal only, zero actuation authority ----------------

  @doc """
  A fresh snapshot of `process_id` at its graph-declared initial state.
  Pure - touches nothing outside this process.
  """
  @spec initial_snapshot(String.t(), keyword()) :: {:ok, map()} | {:error, {:refused, String.t()}}
  def initial_snapshot(process_id, _opts \\ []) when is_binary(process_id) do
    case Map.fetch(@contracts, process_id) do
      {:ok, %{initial_state: state}} ->
        {:ok,
         %{
           process_id: process_id,
           state: state,
           state_hash: state_hash(process_id, state),
           receipts: []
         }}

      :error ->
        {:error, {:refused, unknown_process_reason(process_id)}}
    end
  end

  @doc """
  An INERT planning candidate for the graph-declared transition at
  `ordinal` within `snapshot`'s process - proposal only, confers zero
  actuation authority, never touches the environment. Captures the exact
  state hash the snapshot must still carry at `apply_transition/3` time
  (`expected_state_hash`).
  """
  @spec plan_transition(map(), pos_integer()) :: {:ok, map()} | {:error, {:refused, String.t()}}
  def plan_transition(%{process_id: process_id}, ordinal) when is_integer(ordinal) do
    case fetch_transition(process_id, ordinal) do
      {:ok, t} ->
        {:ok,
         %{
           process_id: process_id,
           ordinal: t.ordinal,
           from_state: t.from_state,
           to_state: t.to_state,
           actuation_name: t.actuation_name,
           expected_state_hash: state_hash(process_id, t.from_state)
         }}

      {:error, reason} ->
        {:error, {:refused, reason}}
    end
  end

  # -- The only function that can cause a real-world consequence -------------

  @doc """
  Applies one planned `candidate` to `snapshot` by DELEGATING to
  `BeamPM.Actuation.run/2` for `candidate.actuation_name` - never
  reimplementing admission, execution, or receipt-writing.

  Fencing order (fail-closed, never crashes on a malformed candidate):

    1. `candidate.expected_state_hash` must equal `snapshot.state_hash`
       exactly (exact-state-hash precondition) - refused otherwise, with
       zero call into `BeamPM.Actuation`.
    2. `candidate.actuation_name` must be admitted by
       `BeamPM.Actuation.admitted_actuations/0` (the single source of
       truth) - refused otherwise, with zero call into `BeamPM.Actuation`.
    3. Only then is `BeamPM.Actuation.run/2` called, with the graph-required
       precondition facts for that actuation name supplied directly (this
       module IS the planner for that step).

  Required `actuation_opts`: `:gym`, `:bridge` (passed straight through to
  `BeamPM.Actuation.run/2`). Optional: `:run_id` (defaults to
  `"<process_id>-t<ordinal>"`), `:receipts_dir` (defaults like
  `BeamPM.Actuation.run/2`'s own default).

  Returns `{:ok, new_snapshot, process_receipt}` on success,
  `{:error, {:refused, reason}, process_receipt}` for a refusal (state
  unchanged), or `{:error, {:execution_failed, reason}, process_receipt}`
  for a real environment failure (state unchanged). In every case exactly
  one process-level receipt exists on disk afterward; `process_receipt.actuation`
  embeds the real `BeamPM.Actuation` receipt reference whenever one was
  actually written (i.e. whenever `BeamPM.Actuation.run/2` was actually
  called).
  """
  @spec apply_transition(map(), map(), keyword()) ::
          {:ok, map(), map()}
          | {:error, {:refused, String.t()} | {:execution_failed, term()}, map()}
  def apply_transition(
        %{process_id: process_id, state_hash: snapshot_hash} = snapshot,
        %{expected_state_hash: expected_hash} = candidate,
        actuation_opts
      )
      when is_list(actuation_opts) do
    run_opts = actuation_opts_for(process_id, candidate, actuation_opts)
    run_id = Keyword.fetch!(run_opts, :run_id)

    case fence_exact_state(snapshot_hash, expected_hash, candidate) do
      {:error, reason} ->
        receipt = build_and_write_receipt(candidate, run_id, run_opts, :refused, reason, nil)
        {:error, {:refused, reason}, receipt}

      :ok ->
        apply_admitted_transition(snapshot, candidate, run_id, run_opts)
    end
  end

  defp apply_admitted_transition(snapshot, candidate, run_id, run_opts) do
    case admitted_requires(candidate.actuation_name) do
      {:error, reason} ->
        receipt = build_and_write_receipt(candidate, run_id, run_opts, :refused, reason, nil)
        {:error, {:refused, reason}, receipt}

      {:ok, requires} ->
        action_input = %{
          action_name: candidate.actuation_name,
          preconditions: requires,
          effects: []
        }

        dispatch_actuation(snapshot, candidate, run_id, run_opts, Actuation.run(action_input, run_opts))
    end
  end

  defp dispatch_actuation(snapshot, candidate, run_id, run_opts, {:ok, actuation_out}) do
    next_state = candidate.to_state

    receipt =
      build_and_write_receipt(candidate, run_id, run_opts, :applied, nil, actuation_out.receipt_path)

    new_snapshot = %{
      snapshot
      | state: next_state,
        state_hash: state_hash(candidate.process_id, next_state),
        receipts: [receipt | snapshot.receipts]
    }

    {:ok, new_snapshot, receipt}
  end

  defp dispatch_actuation(_snapshot, candidate, run_id, run_opts, {:error, {:refused, reason} = tagged}) do
    path = actuation_receipt_path_if_written(run_opts)
    receipt = build_and_write_receipt(candidate, run_id, run_opts, :refused, inspect(reason), path)
    {:error, tagged, receipt}
  end

  defp dispatch_actuation(
         _snapshot,
         candidate,
         run_id,
         run_opts,
         {:error, {:execution_failed, reason} = tagged}
       ) do
    path = actuation_receipt_path_if_written(run_opts)

    receipt =
      build_and_write_receipt(candidate, run_id, run_opts, :execution_failed, inspect(reason), path)

    {:error, tagged, receipt}
  end

  # Defensive completeness against BeamPM.Actuation.run/2's documented
  # return type: every observed error shape today is one of the two typed
  # tags matched above (proven by BeamPM.ActuationTest), but this catch-all
  # keeps apply_transition/3 fail-closed with a real on-disk receipt rather
  # than a FunctionClauseError if that contract ever widens.
  defp dispatch_actuation(_snapshot, candidate, run_id, run_opts, {:error, other}) do
    path = actuation_receipt_path_if_written(run_opts)
    receipt = build_and_write_receipt(candidate, run_id, run_opts, :execution_failed, inspect(other), path)
    {:error, {:execution_failed, other}, receipt}
  end

  @doc """
  Convenience entry point (mirrors `BeamPM.Actuation.run/2`'s role as the
  guaranteed entry point over the lower-level building blocks): applies
  EVERY transition of `process_id`, in graph order, starting from a fresh
  `initial_snapshot/2`, stopping at the first refusal or execution failure.

  Returns `{:ok, final_snapshot}` once every transition has been applied,
  or `{:error, reason, partial_snapshot}` at the first non-applied
  transition - `partial_snapshot.receipts` holds every process receipt
  produced so far, including the one for the failed step.

  ## Continuous-session mode (`continuous: true`, opt-in, additive)

  Default `actuation_opts` (no `:continuous` key, or `continuous: false` -
  every existing caller's actual behavior): each transition delegates to a
  FRESH `BeamPM.Actuation.run/2` call, which opens its own bridge, resets
  it, steps once, then closes it - N independent one-shot environment
  resets for an N-transition process, never a continuous multi-step
  transition on one running target.

  `continuous: true`: opens exactly ONE `BeamPM.Actuation.Session` (one
  bridge open + one reset) BEFORE the first transition, threads that same
  session through every transition's delegated `Actuation.run/2` call (each
  doing exactly one gym step against the SAME already-open bridge, via
  `actuation_opts[:session]` - see `BeamPM.Actuation`'s `:execute` step),
  and closes the session EXACTLY ONCE after the last transition - on every
  exit path (success, refusal, or execution failure) via `try/after`, never
  leaking the bridge subprocess. Requires the same `:gym`/`:bridge` keys as
  the default mode; `apply_transition/3`, `apply_admitted_transition/4`,
  `dispatch_actuation/5`, and `actuation_opts_for/3` are entirely unchanged
  and unaware this mode exists - only which bridge lifecycle
  `BeamPM.Actuation`'s `:execute` step reuses differs.
  """
  @spec run(String.t(), keyword()) :: {:ok, map()} | {:error, term(), map()}
  def run(process_id, actuation_opts) when is_binary(process_id) and is_list(actuation_opts) do
    case {initial_snapshot(process_id), Map.fetch(@contracts, process_id)} do
      {{:ok, snapshot}, {:ok, %{transitions: transitions}}} ->
        if Keyword.get(actuation_opts, :continuous, false) do
          run_transitions_continuous(transitions, snapshot, actuation_opts)
        else
          run_transitions(transitions, snapshot, actuation_opts)
        end

      {{:error, tagged}, _} ->
        {:error, tagged, %{receipts: []}}
    end
  end

  defp run_transitions(transitions, snapshot, actuation_opts) do
    Enum.reduce_while(transitions, {:ok, snapshot}, fn t, {:ok, snap} ->
      with {:ok, candidate} <- plan_transition(snap, t.ordinal),
           {:ok, new_snap, _receipt} <- apply_transition(snap, candidate, actuation_opts) do
        {:cont, {:ok, new_snap}}
      else
        {:error, reason} -> {:halt, {:error, reason, snap}}
        {:error, reason, receipt} -> {:halt, {:error, reason, %{snap | receipts: [receipt | snap.receipts]}}}
      end
    end)
  end

  # Continuous-session variant of run_transitions/3: opens exactly ONE
  # BeamPM.Actuation.Session before the fold, threads it (read-only from
  # apply_transition/3's perspective - it flows in via actuation_opts[:session]
  # and is never mutated by the unmodified delegation chain below it) across
  # every transition, updates its last_observation after each successfully
  # applied transition (so the NEXT transition's receipt-level
  # observation_before reflects the real post-step state, not the initial
  # reset's state), and closes it exactly once via try/after regardless of
  # how the fold ends.
  defp run_transitions_continuous(transitions, snapshot, actuation_opts) do
    gym = Keyword.fetch!(actuation_opts, :gym)
    bridge = Keyword.fetch!(actuation_opts, :bridge)
    bridge_timeout = Keyword.get(actuation_opts, :bridge_timeout, 10_000)

    case Session.open(bridge, gym, bridge_timeout) do
      {:error, reason} ->
        {:error, {:execution_failed, {:session_open, reason}}, %{snapshot | receipts: []}}

      {:ok, session} ->
        try do
          {result, _final_session} =
            Enum.reduce_while(transitions, {{:ok, snapshot}, session}, fn t, {{:ok, snap}, sess} ->
              run_opts = Keyword.put(actuation_opts, :session, sess)

              with {:ok, candidate} <- plan_transition(snap, t.ordinal),
                   {:ok, new_snap, receipt} <- apply_transition(snap, candidate, run_opts) do
                new_sess =
                  case actuation_observation(receipt) do
                    {:ok, obs} -> Session.update_observation(sess, obs)
                    :error -> sess
                  end

                {:cont, {{:ok, new_snap}, new_sess}}
              else
                {:error, reason} ->
                  {:halt, {{:error, reason, snap}, sess}}

                {:error, reason, receipt} ->
                  {:halt, {{:error, reason, %{snap | receipts: [receipt | snap.receipts]}}, sess}}
              end
            end)

          result
        after
          _ = Session.close(session, bridge_timeout)
        end
    end
  end

  # Re-reads the just-written beam4pm-brce/v1 actuation receipt (if one was
  # actually written for this process-level receipt) to pull out its real
  # observation_after - used only to thread the session's last_observation
  # forward between continuous-mode transitions, never as a consequence
  # identity (that stays run_id/receipt_path throughout this module).
  defp actuation_observation(%{actuation: %{receipt_path: path}}) when is_binary(path) do
    with true <- File.exists?(path),
         {:ok, raw} <- File.read(path),
         {:ok, decoded} <- JSON.decode(raw),
         obs when is_map(obs) <- decoded["execution"]["observation_after"] do
      {:ok, obs}
    else
      _ -> :error
    end
  end

  defp actuation_observation(_), do: :error

  @doc "The graph-derived process contracts rendered into this build."
  @spec contracts() :: map()
  def contracts, do: @contracts

  # -- Replay: re-verify every embedded actuation receipt, re-mine as one ----
  # -- OCEL trace --------------------------------------------------------

  @doc """
  Replays `process_receipts` (oldest-first) for `process_id`: for every
  receipt whose `:actuation` is not `nil` (i.e. `BeamPM.Actuation.run/2`
  was actually called and wrote a real receipt), re-opens the embedded
  `receipt_path`, re-decodes it, and asserts its `receipt_schema` is still
  `"beam4pm-brce/v1"` and its `action.action_name` still matches the
  embedded `actuation_name` - a real re-verification against the real
  file, never a re-derivation from an in-memory hash.

  Returns `{:ok, %{final_state: state, mined_trace: %LogTrace{}, dfg: [%DfgEdge{}]}}`
  on a fully-consistent chain, or `{:error, {:replay_broken, ordinal, reason}}`
  at the first receipt that no longer verifies.
  """
  @spec replay(String.t(), [map()]) ::
          {:ok, %{final_state: String.t(), mined_trace: LogTrace.t(), dfg: [DfgEdge.t()]}}
          | {:error, {:replay_broken, pos_integer(), term()}}
  def replay(process_id, process_receipts)
      when is_binary(process_id) and is_list(process_receipts) do
    seed_state = @contracts |> Map.get(process_id, %{initial_state: nil}) |> Map.fetch!(:initial_state)

    process_receipts
    |> Enum.reduce_while({:ok, [], seed_state}, fn receipt, {:ok, events_acc, state_acc} ->
      case verify_and_mine_one(receipt) do
        {:ok, events} ->
          next_state = if receipt.outcome == :applied, do: receipt.to_state, else: state_acc
          {:cont, {:ok, events_acc ++ events, next_state}}

        {:error, reason} ->
          {:halt, {:error, {:replay_broken, receipt.ordinal, reason}}}
      end
    end)
    |> case do
      {:ok, all_events, final_state} ->
        # Every re-tagged event shares the same "case_id" (process_id), so a
        # non-empty combined event list always groups into exactly one
        # trace. An all-refused run (zero real actuation events anywhere)
        # is the one case Discovery.traces_from_events cannot represent (it
        # only emits a trace for a case that has at least one event) - a
        # real, still-valid empty LogTrace is constructed for that case
        # instead of a fabricated one.
        trace =
          case Discovery.traces_from_events(all_events, "case_id") do
            [t] ->
              t

            [] ->
              {:ok, t} = LogTrace.new(%{case_id: process_id, activity_sequence: []})
              t
          end

        dfg = Discovery.dfg_from_traces([trace])
        {:ok, %{final_state: final_state, mined_trace: trace, dfg: dfg}}

      {:error, _} = err ->
        err
    end
  end

  # -- Internal: fencing, admission lookup, delegation ------------------------

  defp fence_exact_state(snapshot_hash, expected_hash, candidate) do
    if snapshot_hash == expected_hash do
      :ok
    else
      {:error,
       "exact-state fence: transition #{candidate.ordinal} (#{inspect(candidate.from_state)} -> " <>
         "#{inspect(candidate.to_state)}) expected state_hash #{inspect(expected_hash)} but " <>
         "snapshot carries #{inspect(snapshot_hash)} - snapshot is stale or was built for a " <>
         "different state"}
    end
  end

  defp admitted_requires(actuation_name) do
    case Map.fetch(Actuation.admitted_actuations(), actuation_name) do
      {:ok, %{requires: requires}} ->
        {:ok, requires}

      :error ->
        {:error,
         "transition targets actuation_name #{inspect(actuation_name)} which is not admitted " <>
           "by BeamPM.Actuation.admitted_actuations/0 " <>
           "(#{inspect(Map.keys(Actuation.admitted_actuations()))})"}
    end
  end

  defp actuation_opts_for(process_id, candidate, actuation_opts) do
    run_id = Keyword.get(actuation_opts, :run_id, "#{process_id}-t#{candidate.ordinal}")
    # EX2: default the hash-chain scope to this governed process, unless the
    # caller already named one explicitly.
    chain_id = Keyword.get(actuation_opts, :chain_id, process_id)

    actuation_opts
    |> Keyword.delete(:run_id)
    |> Keyword.delete(:chain_id)
    |> Keyword.put(:run_id, run_id)
    |> Keyword.put(:chain_id, chain_id)
  end

  defp actuation_receipt_path_if_written(run_opts) do
    receipts_dir =
      Keyword.get(run_opts, :receipts_dir, Path.join(File.cwd!(), "receipts/actuations"))

    run_id = Keyword.fetch!(run_opts, :run_id)
    path = Path.join(receipts_dir, run_id <> ".json")
    if File.exists?(path), do: path, else: nil
  end

  defp build_and_write_receipt(candidate, run_id, run_opts, outcome, reason, actuation_receipt_path) do
    receipt = %{
      receipt_schema: @process_receipt_schema,
      process_id: candidate.process_id,
      ordinal: candidate.ordinal,
      from_state: candidate.from_state,
      to_state: candidate.to_state,
      actuation_name: candidate.actuation_name,
      run_id: run_id,
      outcome: outcome,
      reason: reason,
      actuation:
        case actuation_receipt_path do
          nil -> nil
          path -> %{run_id: run_id, receipt_path: path, receipt_schema: @actuation_receipt_schema}
        end
    }

    write_process_receipt!(receipt, run_opts)
  end

  defp write_process_receipt!(receipt, run_opts) do
    receipts_dir =
      Keyword.get(run_opts, :receipts_dir, Path.join(File.cwd!(), "receipts/actuations"))

    path =
      Path.join([receipts_dir, "process", "#{receipt.process_id}-t#{receipt.ordinal}-#{receipt.run_id}.json"])

    File.mkdir_p!(Path.dirname(path))

    json_safe = %{
      "receipt_schema" => receipt.receipt_schema,
      "process_id" => receipt.process_id,
      "ordinal" => receipt.ordinal,
      "from_state" => receipt.from_state,
      "to_state" => receipt.to_state,
      "actuation_name" => receipt.actuation_name,
      "run_id" => receipt.run_id,
      "outcome" => to_string(receipt.outcome),
      "reason" => receipt.reason,
      "actuation" =>
        case receipt.actuation do
          nil ->
            nil

          a ->
            %{"run_id" => a.run_id, "receipt_path" => a.receipt_path, "receipt_schema" => a.receipt_schema}
        end
    }

    File.write!(path, JSON.encode!(json_safe))
    Map.put(receipt, :process_receipt_path, path)
  end

  defp fetch_transition(process_id, ordinal) do
    case Map.fetch(@contracts, process_id) do
      :error ->
        {:error, unknown_process_reason(process_id)}

      {:ok, %{transitions: transitions}} ->
        case Enum.find(transitions, &(&1.ordinal == ordinal)) do
          nil ->
            {:error,
             "process_id #{inspect(process_id)} has no admitted transition at ordinal " <>
               "#{inspect(ordinal)} (graph-derived ordinals: " <>
               "#{inspect(Enum.map(transitions, & &1.ordinal))})"}

          t ->
            {:ok, t}
        end
    end
  end

  defp unknown_process_reason(process_id) do
    "process_id #{inspect(process_id)} is not an admitted bpmg:ProcessContract " <>
      "(graph-derived allowlist: #{inspect(Map.keys(@contracts))})"
  end

  defp state_hash(process_id, state) do
    :sha256
    |> :crypto.hash(process_id <> "|" <> state)
    |> Base.encode16(case: :lower)
  end

  # -- Internal: replay verification + real-event re-mining -------------------

  defp verify_and_mine_one(%{actuation: nil}) do
    # A pre-actuation refusal (fencing or unadmitted-actuation-name): no
    # BeamPM.Actuation receipt was ever written, so there is nothing to
    # re-verify and nothing to mine - the trace simply does not grow past
    # this point, which IS the refusal boundary.
    {:ok, []}
  end

  defp verify_and_mine_one(%{actuation: %{receipt_path: nil}}) do
    {:error, :actuation_receipt_never_written}
  end

  defp verify_and_mine_one(%{actuation: %{receipt_path: path}} = receipt) do
    with true <- File.exists?(path),
         {:ok, raw} <- File.read(path),
         {:ok, decoded} <- JSON.decode(raw),
         true <- decoded["receipt_schema"] == @actuation_receipt_schema,
         true <- decoded["action"]["action_name"] == receipt.actuation_name do
      events =
        decoded["events"]
        |> Enum.map(fn m ->
          {:ok, %OcelEvent{} = ev} = Codec.from_map(:ocel_event, m)
          %{ev | attributes: Map.put(ev.attributes || %{}, "case_id", receipt.process_id)}
        end)

      {:ok, events}
    else
      false -> {:error, {:receipt_verification_failed, path}}
      {:error, reason} -> {:error, reason}
    end
  end
end
