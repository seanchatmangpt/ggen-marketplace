<%
# ggen_igniter EEx template -> lib/beam4pm_ash.ex
#
# Bindings (from `mix ggen_igniter.sync --query records=... --query fields=...`):
#   records - list of string-keyed maps: "record_name", "record_doc"
#   fields  - list of string-keyed maps: "record_name", "field_name", "field_type",
#             "field_doc", "field_required", "field_order"
#
# Engine-shape note: `--engine oxigraph` (the default) returns RAW N-Triples-style
# terms (IRIs angle-bracketed, literals quoted and possibly datatype-tagged);
# `--engine sparql` returns plain unwrapped Elixir values. norm/1 handles both.
# Row order is NEVER trusted (the sparql hex engine has a real, documented
# ORDER BY bug) - all rows are re-sorted here with Enum.sort_by.
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

to_int = fn v -> v |> norm.() |> String.to_integer() end

camel = fn name ->
  name |> String.split("_") |> Enum.map(&String.capitalize/1) |> Enum.join()
end

recs =
  records
  |> Enum.map(fn r -> %{name: norm.(r["record_name"]), doc: norm.(r["record_doc"])} end)
  |> Enum.sort_by(& &1.name)

flds =
  Enum.map(fields, fn f ->
    %{
      record: norm.(f["record_name"]),
      name: norm.(f["field_name"]),
      type: norm.(f["field_type"]),
      doc: norm.(f["field_doc"]),
      required: norm.(f["field_required"]) == "true",
      order: to_int.(f["field_order"])
    }
  end)

fields_for = fn rec ->
  flds |> Enum.filter(&(&1.record == rec)) |> Enum.sort_by(& &1.order)
end

# bpm:fieldType -> Ash attribute type (source text)
ash_type = fn
  "string" -> ":string"
  "integer" -> ":integer"
  "float" -> ":float"
  "boolean" -> ":boolean"
  "datetime" -> ":utc_datetime"
  "atom" -> ":atom"
  "list_string" -> "{:array, :string}"
  "map" -> ":map"
end

resource_blocks =
  Enum.map_join(recs, "\n", fn r ->
    attrs =
      Enum.map_join(fields_for.(r.name), "\n", fn f ->
        "    attribute :#{f.name}, #{ash_type.(f.type)}, public?: true" <>
          if(f.required, do: ", allow_nil?: false", else: "")
      end)

    Enum.join(
      [
        "defmodule BeamPM.Ash.Resources.#{camel.(r.name)} do",
        "  @moduledoc \"#{r.doc}\"",
        "  use Ash.Resource,",
        "    domain: BeamPM.Ash.Domain,",
        "    data_layer: Ash.DataLayer.Ets,",
        "    validate_domain_inclusion?: false",
        "",
        "  attributes do",
        "    uuid_primary_key :id",
        attrs,
        "  end",
        "",
        "  actions do",
        "    default_accept :*",
        "    defaults [:create, :read]",
        "  end",
        "end"
      ],
      "\n"
    ) <> "\n"
  end)

domain_block =
  Enum.join(
    [
      "defmodule BeamPM.Ash.Domain do",
      "  @moduledoc \"GENERATED Ash domain over all admitted bpm:RecordType resources.\"",
      "  use Ash.Domain, validate_config_inclusion?: false",
      "",
      "  resources do",
      Enum.map_join(recs, "\n", fn r ->
        "    resource BeamPM.Ash.Resources.#{camel.(r.name)}"
      end),
      "  end",
      "end"
    ],
    "\n"
  ) <> "\n"

rendered =
  "# GENERATED by ggen_igniter from the admitted bpm:RecordType graph. Do not edit.\n\n" <>
    resource_blocks <> "\n" <> domain_block
%><%= rendered %>

defmodule BeamPM.Autonomy.Kernel do
  @moduledoc """
  GENERATED post-LLM autonomy kernel.

  The kernel preserves a DfCM candidate frontier, keeps SELECT separate from
  authority, manufactures non-actuating intents, permits DO only through BRCE,
  binds actual consequences into receipts, verifies replay, and emits bounded
  learning signals. Model/LLM output can propose candidates; it never receives
  actuation authority from this module.
  """

  @type candidate :: %{
          required(:id) => String.t(),
          required(:utility) => number(),
          required(:risk) => number(),
          required(:reversibility) => number(),
          required(:evidence) => number(),
          optional(atom()) => term()
        }

  @spec frontier([candidate()], term()) :: map()
  def frontier(candidates, observation) when is_list(candidates) and candidates != [] do
    ranked =
      candidates
      |> Enum.map(&Map.put(&1, :score, score(&1)))
      |> Enum.sort_by(fn c -> {-c.score, c.id} end)

    %{
      kind: :dfcm_frontier,
      standing: :alive,
      observation_hash: digest(observation),
      candidates: ranked,
      selected: nil,
      authority: nil
    }
  end

  @spec simulate(map(), String.t(), term()) :: {:ok, map()} | {:refused, atom()}
  def simulate(%{kind: :dfcm_frontier, candidates: candidates}, candidate_id, predicted) do
    if Enum.any?(candidates, &(&1.id == candidate_id)) do
      {:ok,
       %{
         kind: :counterfactual,
         candidate_id: candidate_id,
         prediction: predicted,
         prediction_hash: digest(predicted),
         executed?: false
       }}
    else
      {:refused, :unknown_candidate}
    end
  end

  @spec select(map(), map()) :: {:ok, map()} | {:refused, atom()}
  def select(%{kind: :dfcm_frontier, candidates: candidates} = frontier, policy)
      when is_map(policy) do
    max_risk = Map.get(policy, :max_risk, 1.0)
    min_evidence = Map.get(policy, :min_evidence, 0.0)
    min_reversibility = Map.get(policy, :min_reversibility, 0.0)

    case Enum.find(candidates, fn c ->
           c.risk <= max_risk and c.evidence >= min_evidence and
             c.reversibility >= min_reversibility
         end) do
      nil ->
        {:refused, :no_admissible_candidate}

      candidate ->
        {:ok,
         %{
           kind: :selection,
           frontier_hash: digest(frontier),
           candidate: candidate,
           policy_hash: digest(policy),
           authorized?: false
         }}
    end
  end

  @spec intent(map(), String.t()) :: {:ok, map()} | {:refused, atom()}
  def intent(%{kind: :selection, candidate: candidate, authorized?: false} = selection, hook_id)
      when is_binary(hook_id) do
    {:ok,
     %{
       kind: :actuation_intent,
       hook_id: hook_id,
       candidate_id: candidate.id,
       selection_hash: digest(selection),
       authorized?: false,
       executed?: false
     }}
  end

  def intent(_, _), do: {:refused, :invalid_selection}

  @spec grant(map(), map()) :: {:ok, map()} | {:refused, atom()}
  def grant(%{kind: :actuation_intent} = intent, authority) when is_map(authority) do
    required_intent_hash = digest(intent)

    cond do
      Map.get(authority, :intent_hash) != required_intent_hash ->
        {:refused, :intent_identity_mismatch}

      Map.get(authority, :candidate_id) != intent.candidate_id ->
        {:refused, :scope_mismatch}

      Map.get(authority, :do, false) != true ->
        {:refused, :do_not_authorized}

      true ->
        {:ok,
         %{
           kind: :authority_grant,
           candidate_id: intent.candidate_id,
           intent_hash: required_intent_hash,
           authority_id: Map.fetch!(authority, :authority_id),
           do: true
         }}
    end
  end

  @spec brce_do(map(), map(), tuple()) :: {:ok, map()} | {:refused, atom()}
  def brce_do(
        %{kind: :actuation_intent} = intent,
        %{kind: :authority_grant, do: true} = grant,
        {:ets_put, table, key, value}
      ) do
    cond do
      grant.intent_hash != digest(intent) ->
        {:refused, :grant_identity_mismatch}

      grant.candidate_id != intent.candidate_id ->
        {:refused, :grant_scope_mismatch}

      true ->
        true = :ets.insert(table, {key, value})
        consequence = {:ets_value, key, :ets.lookup(table, key)}

        {:ok,
         %{
           kind: :execution_receipt,
           standing: :alive,
           candidate_id: intent.candidate_id,
           intent_hash: digest(intent),
           grant_hash: digest(grant),
           consequence: consequence,
           consequence_hash: digest(consequence),
           executed?: true
         }}
    end
  end

  def brce_do(_, _, _), do: {:refused, :brce_boundary_violation}

  @spec replay(map(), term()) :: {:ok, map()} | {:refused, atom()}
  def replay(%{kind: :execution_receipt, executed?: true} = receipt, observed_consequence) do
    if digest(observed_consequence) == receipt.consequence_hash do
      {:ok,
       %{
         kind: :replay_result,
         verified?: true,
         receipt_hash: digest(receipt),
         consequence_hash: receipt.consequence_hash
       }}
    else
      {:refused, :consequence_mismatch}
    end
  end

  def replay(_, _), do: {:refused, :not_an_execution_receipt}

  @spec learn(map(), map()) :: {:ok, map()} | {:refused, atom()}
  def learn(%{kind: :replay_result, verified?: true} = replay, frontier) do
    {:ok,
     %{
       kind: :learning_signal,
       verified?: true,
       replay_hash: digest(replay),
       frontier_hash: digest(frontier),
       policy_update: %{evidence_delta: 1, authority_delta: 0}
     }}
  end

  def learn(_, _), do: {:refused, :unverified_replay}

  @spec digest(term()) :: String.t()
  def digest(term) do
    :crypto.hash(:sha256, :erlang.term_to_binary(term))
    |> Base.encode16(case: :lower)
  end

  defp score(candidate) do
    candidate.utility * 100 + candidate.reversibility * 20 + candidate.evidence * 10 -
      candidate.risk * 50
  end
end
