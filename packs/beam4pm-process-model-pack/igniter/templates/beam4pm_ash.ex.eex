<%
# ggen_igniter EEx template -> generated/elixir/lib/beam4pm_ash.ex
#
# Bindings (from `mix ggen_igniter.sync --query records=... --query fields=...`):
#   records - list of string-keyed maps: "record_name", "record_doc"
#   fields  - list of string-keyed maps: "record_name", "field_name", "field_type",
#             "field_doc", "field_required", "field_order"
#
# Engine-shape note: `--engine oxigraph` (the default) returns RAW N-Triples-style
# terms (IRIs angle-bracketed, literals quoted and possibly datatype-tagged);
# `--engine sparql` returns plain unwrapped Elixir values. norm/1 handles both.
# Row order is NEVER trusted (the sparql hex engine has a real, documented
# ORDER BY bug) - all rows are re-sorted here with Enum.sort_by.
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

to_int = fn v -> v |> norm.() |> String.to_integer() end

camel = fn name ->
  name |> String.split("_") |> Enum.map(&String.capitalize/1) |> Enum.join()
end

recs =
  records
  |> Enum.map(fn r -> %{name: norm.(r["record_name"]), doc: norm.(r["record_doc"])} end)
  |> Enum.sort_by(& &1.name)

flds =
  Enum.map(fields, fn f ->
    %{
      record: norm.(f["record_name"]),
      name: norm.(f["field_name"]),
      type: norm.(f["field_type"]),
      doc: norm.(f["field_doc"]),
      required: norm.(f["field_required"]) == "true",
      order: to_int.(f["field_order"])
    }
  end)

fields_for = fn rec ->
  flds |> Enum.filter(&(&1.record == rec)) |> Enum.sort_by(& &1.order)
end

# bpm:fieldType -> Ash attribute type (source text)
ash_type = fn
  "string" -> ":string"
  "integer" -> ":integer"
  "float" -> ":float"
  "boolean" -> ":boolean"
  "datetime" -> ":utc_datetime"
  "atom" -> ":atom"
  "list_string" -> "{:array, :string}"
  "map" -> ":map"
end

resource_blocks =
  Enum.map_join(recs, "\n", fn r ->
    attrs =
      Enum.map_join(fields_for.(r.name), "\n", fn f ->
        "    attribute :#{f.name}, #{ash_type.(f.type)}, public?: true" <>
          if(f.required, do: ", allow_nil?: false", else: "")
      end)

    Enum.join(
      [
        "defmodule BeamPM.Ash.Resources.#{camel.(r.name)} do",
        "  @moduledoc \"#{r.doc}\"",
        "  use Ash.Resource,",
        "    domain: BeamPM.Ash.Domain,",
        "    data_layer: Ash.DataLayer.Ets,",
        "    validate_domain_inclusion?: false",
        "",
        "  attributes do",
        "    uuid_primary_key :id",
        attrs,
        "  end",
        "",
        "  actions do",
        "    default_accept :*",
        "    defaults [:create, :read]",
        "  end",
        "end"
      ],
      "\n"
    ) <> "\n"
  end)

domain_block =
  Enum.join(
    [
      "defmodule BeamPM.Ash.Domain do",
      "  @moduledoc \"GENERATED Ash domain over all admitted bpm:RecordType resources.\"",
      "  use Ash.Domain, validate_config_inclusion?: false",
      "",
      "  resources do",
      Enum.map_join(recs, "\n", fn r ->
        "    resource BeamPM.Ash.Resources.#{camel.(r.name)}"
      end),
      "  end",
      "end"
    ],
    "\n"
  ) <> "\n"

rendered =
  "# GENERATED by ggen_igniter from the admitted bpm:RecordType graph. Do not edit.\n\n" <>
    resource_blocks <> "\n" <> domain_block
%><%= rendered %>