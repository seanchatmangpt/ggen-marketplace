<%
# ggen_igniter EEx template -> test/beam4pm_pro_compatibility_test.exs
# Bindings: NONE required -- fully static.
%># GENERATED by ggen_igniter from the beam4pm_pro_compatibility static template. Do not edit.
defmodule BeamPM.Pro.CompatibilityTest do
  use ExUnit.Case, async: true

  alias BeamPM.Pro.Compatibility

  test "matrix/0 returns real Version-requirement strings for every known component" do
    matrix = Compatibility.matrix()
    assert map_size(matrix) > 0

    for {_component, requirement} <- matrix do
      # A real, parseable Version requirement -- Version.match?/2 would
      # raise on a malformed one, so this doubles as a validity check.
      assert Version.match?("0.1.0", requirement) in [true, false]
    end
  end

  test "an empty version map is trivially compatible" do
    assert Compatibility.check(%{}) == {:ok, :compatible}
  end

  test "a version satisfying every bound is compatible" do
    assert Compatibility.check(%{beam4pm: "0.1.0", ggen_igniter: "26.8.30"}) ==
             {:ok, :compatible}
  end

  test "a version below the minimum bound is refused with the exact component and reason" do
    assert {:error, {:incompatible, :ggen_igniter, reason}} =
             Compatibility.check(%{ggen_igniter: "25.0.0"})

    assert reason =~ "25.0.0"
  end

  test "a version above the maximum bound is refused" do
    assert {:error, {:incompatible, :ggen_igniter, reason}} =
             Compatibility.check(%{ggen_igniter: "27.0.0"})

    assert reason =~ "27.0.0"
  end

  test "an unknown component is a typed refusal, not a crash" do
    assert Compatibility.check(%{totally_unknown_component: "1.0.0"}) ==
             {:error, {:incompatible, :totally_unknown_component, "unknown component (not in the compatibility matrix)"}}
  end

  test "an unparseable version string is a typed refusal, not a crash" do
    assert {:error, {:incompatible, :beam4pm, reason}} =
             Compatibility.check(%{beam4pm: "not-a-version"})

    assert reason =~ "unparseable"
  end

  test "check/1 reports a deterministic first violation across multiple bad components" do
    result = Compatibility.check(%{beam4pm: "0.1.0", ggen_igniter: "25.0.0"})
    assert {:error, {:incompatible, :ggen_igniter, _reason}} = result
  end
end
