<%
# ggen_igniter EEx template -> test/beam4pm_pro_license_test.exs
# Bindings: NONE required -- fully static.
%># GENERATED by ggen_igniter from the beam4pm_pro_license static template. Do not edit.
defmodule BeamPM.Pro.LicenseTest do
  use ExUnit.Case, async: true

  alias BeamPM.Pro.License

  @secret "real-secret-key-for-tests-only"

  defp fresh_license(overrides \\ %{}) do
    base = %License{
      license_id: "lic_" <> Base.encode16(:crypto.strong_rand_bytes(4), case: :lower),
      scope: "acme-corp",
      issued_at: DateTime.utc_now(),
      expires_at: DateTime.add(DateTime.utc_now(), 3600, :second)
    }

    struct(base, overrides)
  end

  test "a validly signed, unexpired, correctly scoped license verifies as :valid" do
    license = fresh_license() |> License.sign(@secret)

    assert License.verify(license, %{expected_scope: "acme-corp", trusted_key: @secret}) ==
             {:ok, :valid}
  end

  test "an expired license is refused with :expired" do
    license =
      fresh_license(%{expires_at: DateTime.add(DateTime.utc_now(), -60, :second)})
      |> License.sign(@secret)

    assert License.verify(license, %{expected_scope: "acme-corp", trusted_key: @secret}) ==
             {:error, :expired}
  end

  test "a license verified against the wrong scope is refused" do
    license = fresh_license(%{scope: "acme-corp"}) |> License.sign(@secret)

    assert License.verify(license, %{expected_scope: "other-corp", trusted_key: @secret}) ==
             {:error, {:wrong_scope, "other-corp", "acme-corp"}}
  end

  test "a tampered license (one byte of the signed payload mutated) is refused" do
    license = fresh_license() |> License.sign(@secret)
    tampered = %{license | scope: license.scope <> "x"}

    assert License.verify(tampered, %{expected_scope: license.scope <> "x", trusted_key: @secret}) ==
             {:error, :tampered}
  end

  test "a license signed with a different key fails signature verification" do
    license = fresh_license() |> License.sign("wrong-key")

    assert License.verify(license, %{expected_scope: license.scope, trusted_key: @secret}) ==
             {:error, :tampered}
  end

  test "an unsigned license is refused as :tampered, never silently valid" do
    license = fresh_license()

    assert License.verify(license, %{expected_scope: license.scope, trusted_key: @secret}) ==
             {:error, :tampered}
  end

  test "verification with no trusted key available is a disclosed :offline_unverifiable outcome" do
    license = fresh_license() |> License.sign(@secret)

    assert License.verify(license, %{expected_scope: license.scope, trusted_key: nil}) ==
             {:error, :offline_unverifiable}
  end

  test "canonical_payload/1 is stable for the same license and changes when a field changes" do
    license = fresh_license()
    assert License.canonical_payload(license) == License.canonical_payload(license)

    changed = %{license | scope: license.scope <> "-changed"}
    assert License.canonical_payload(license) != License.canonical_payload(changed)
  end
end
