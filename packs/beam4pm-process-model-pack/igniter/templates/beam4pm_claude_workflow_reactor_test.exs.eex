<%
# ggen_igniter EEx template -> test/beam4pm_claude_workflow_reactor_test.exs
#
# beam4pm-pro-revenue-suite practice-family qualification. No bindings
# required (see beam4pm_claude_workflow_reactor.ex.eex's header comment) --
# every pinned constant below was derived by hand, once, from the real
# committed journal fixture (derivation commands recorded inline), never
# guessed.
%># GENERATED by ggen_igniter from the claude-workflow-reactor static template. Do not edit.
defmodule BeamPM.ClaudeWorkflowReactorTest do
  @moduledoc """
  Chicago-style qualification of `BeamPM.ClaudeWorkflowReactor`: the real
  Reactor DAG run end-to-end (`Reactor.run(..., async?: false)`) over the
  real committed subagent journal of the 19-agent Claude Code workflow that
  manufactured the beam4pm-pro-revenue-suite
  (`qualification/fixtures/claude-workflows/journal.jsonl` -- byte-for-byte
  copy of `wf_7ff433b3-60a`'s journal, bound below by SHA-256). No mocks:
  the collaborators are the real file, the real JSON decoder, and the real
  Reactor scheduler.

  All pinned expectations (wave sizes, ordinal spans, phase labels, the
  fixture digest) were hand-derived ONCE from the raw journal at test
  authoring time; the derivation commands are recorded next to each
  constant so any of them can be independently recomputed.
  """

  use ExUnit.Case, async: false

  alias BeamPM.ClaudeWorkflowReactor

  @moduletag :tmp_dir

  @journal Path.expand("qualification/fixtures/claude-workflows/journal.jsonl")

  # Derivation (run once at authoring time against the source journal,
  # which the fixture is a byte-for-byte copy of):
  #   shasum -a 256 .../wf_7ff433b3-60a/journal.jsonl
  @journal_sha256 "4388d1e6381d01ab24fe938515f82ecd347d1b8cfd1a41bb02430bfc1306a1a5"
  @journal_bytes 187_684
  @journal_lines 38

  # Derivation: mapping each journal line to S(tarted)/R(esult) yields
  #   SSSSSSRRRRRRSSSRRRSRSSSSSSSSSRRRRRRRRR
  # (one-off `python3` pass over the raw JSONL at authoring time). Applying
  # the documented wave rule -- a `started` opens a new wave iff a `result`
  # intervened since the previous `started` -- gives four waves of sizes
  # 6/3/1/9, with ordinal spans (first started line, last result line):
  #   wave 0: lines  1..12   (6 agents)
  #   wave 1: lines 13..18   (3 agents)
  #   wave 2: lines 19..20   (1 agent)
  #   wave 3: lines 21..38   (9 agents)
  # The documented ordinal phase heuristic labels these
  # measure/develop/actuate/qualify -- this real journal has NO interior
  # singleton before a develop wave, so `:design` does not occur here (its
  # reachability is proven separately on `label_phases/1` below).
  @expected_agent_counts [6, 3, 1, 9]
  @expected_spans [{1, 12}, {13, 18}, {19, 20}, {21, 38}]
  @expected_phases [:measure, :develop, :actuate, :qualify]

  defp real_journal! do
    unless File.exists?(@journal) do
      raise "real journal fixture not found at #{@journal} -- commit " <>
              "qualification/fixtures/claude-workflows/journal.jsonl first"
    end

    @journal
  end

  defp decoded_journal_lines! do
    real_journal!()
    |> File.read!()
    |> String.split("\n", trim: true)
    |> Enum.map(&JSON.decode!/1)
  end

  test "real journal fixture exists and is byte-bound to the recorded digest" do
    bytes = File.read!(real_journal!())

    assert byte_size(bytes) == @journal_bytes
    assert Base.encode16(:crypto.hash(:sha256, bytes), case: :lower) == @journal_sha256
    assert length(String.split(bytes, "\n", trim: true)) == @journal_lines
  end

  test "end-to-end Reactor.run reconstructs the real 19-agent workflow: waves, spans, phases, digest" do
    {:ok, _} = Application.ensure_all_started(:reactor)

    assert {:ok, receipt} =
             Reactor.run(
               ClaudeWorkflowReactor,
               %{journal_path: real_journal!()},
               %{},
               async?: false
             )

    assert receipt.total_agents == 19
    assert Enum.map(receipt.waves, & &1.agent_count) == @expected_agent_counts
    assert Enum.sum(Enum.map(receipt.waves, & &1.agent_count)) == 19
    assert Enum.map(receipt.waves, & &1.ordinal_span) == @expected_spans
    assert Enum.map(receipt.waves, & &1.phase) == @expected_phases
    assert Enum.all?(receipt.waves, &(&1.phase in ClaudeWorkflowReactor.phases()))
    assert receipt.journal_sha256 == @journal_sha256

    # Every started agentId has a matching result agentId (19 pairs) --
    # asserted against the raw journal, decoded independently in-test, not
    # against the module's own parse.
    decoded = decoded_journal_lines!()
    started = for %{"type" => "started", "agentId" => id} <- decoded, do: id
    results = for %{"type" => "result", "agentId" => id} <- decoded, do: id

    assert length(started) == 19
    assert length(results) == 19
    assert Enum.sort(started) == Enum.sort(results)

    # The waves partition exactly the started agent set -- nothing lost,
    # nothing invented.
    wave_ids = Enum.flat_map(receipt.waves, & &1.agent_ids)
    assert Enum.sort(wave_ids) == Enum.sort(started)
  end

  test "receipt is identical across repeated runs (both the run/1 wrapper and raw Reactor.run)" do
    {:ok, _} = Application.ensure_all_started(:reactor)

    assert {:ok, first} = ClaudeWorkflowReactor.run(real_journal!())
    assert {:ok, second} = ClaudeWorkflowReactor.run(real_journal!())

    assert {:ok, raw} =
             Reactor.run(
               ClaudeWorkflowReactor,
               %{journal_path: real_journal!()},
               %{},
               async?: false
             )

    assert first == second
    assert first == raw
  end

  test "a corrupted journal line is a typed refusal with the real line number, never a silent skip",
       %{tmp_dir: tmp_dir} do
    real_lines =
      real_journal!()
      |> File.read!()
      |> String.split("\n", trim: true)
      |> Enum.take(3)

    corrupt_path = Path.join(tmp_dir, "corrupt-journal.jsonl")

    File.write!(
      corrupt_path,
      Enum.join(real_lines ++ [~s({"type":"started","agentId":)], "\n") <> "\n"
    )

    assert {:error, {:malformed_journal_line, 4}} = ClaudeWorkflowReactor.run(corrupt_path)
  end

  test "a decodable line with an unknown type or missing keys is malformed too (schema is closed)",
       %{tmp_dir: tmp_dir} do
    real_lines =
      real_journal!()
      |> File.read!()
      |> String.split("\n", trim: true)
      |> Enum.take(2)

    wrong_type = ~s({"type":"teleported","key":"v2:x","agentId":"a0"})
    missing_result = ~s({"type":"result","key":"v2:x","agentId":"a0"})

    wrong_type_path = Path.join(tmp_dir, "wrong-type-journal.jsonl")
    File.write!(wrong_type_path, Enum.join(real_lines ++ [wrong_type], "\n") <> "\n")
    assert {:error, {:malformed_journal_line, 3}} = ClaudeWorkflowReactor.run(wrong_type_path)

    missing_result_path = Path.join(tmp_dir, "missing-result-journal.jsonl")
    File.write!(missing_result_path, Enum.join(real_lines ++ [missing_result], "\n") <> "\n")
    assert {:error, {:malformed_journal_line, 3}} = ClaudeWorkflowReactor.run(missing_result_path)
  end

  test "an unreadable journal path is a typed refusal", %{tmp_dir: tmp_dir} do
    missing = Path.join(tmp_dir, "does-not-exist.jsonl")

    assert {:error, {:journal_unreadable, ^missing, :enoent}} =
             ClaudeWorkflowReactor.run(missing)
  end

  test "label_phases/1 can reach all five labels, and degenerate wave lists stay total" do
    # A synthetic wave structure exercising the full ladder (a real input
    # to the real public function -- its contract only reads :agent_ids):
    # multi -> singleton -> multi -> singleton -> multi.
    ladder = [
      %{agent_ids: ["a", "b"], ordinal_span: {1, 4}},
      %{agent_ids: ["c"], ordinal_span: {5, 6}},
      %{agent_ids: ["d", "e"], ordinal_span: {7, 10}},
      %{agent_ids: ["f"], ordinal_span: {11, 12}},
      %{agent_ids: ["g", "h"], ordinal_span: {13, 16}}
    ]

    assert Enum.map(ClaudeWorkflowReactor.label_phases(ladder), & &1.phase) ==
             [:measure, :design, :develop, :actuate, :qualify]

    assert Enum.map(
             ClaudeWorkflowReactor.label_phases([%{agent_ids: ["a"], ordinal_span: {1, 2}}]),
             & &1.phase
           ) == [:measure]

    assert Enum.map(
             ClaudeWorkflowReactor.label_phases([
               %{agent_ids: ["a"], ordinal_span: {1, 2}},
               %{agent_ids: ["b"], ordinal_span: {3, 4}}
             ]),
             & &1.phase
           ) == [:measure, :qualify]

    assert ClaudeWorkflowReactor.label_phases([]) == []
  end
end
