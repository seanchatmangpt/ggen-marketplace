<%
# ggen_igniter EEx template -> lib/beam4pm_pro_simulation.ex
#
# beam4pm_pro gap-closure item PRO-012 ("what-if simulation over a
# discovered DFG"). Verified 3-0 as a standard commercial-tier feature
# (Celonis "Process Simulation", Apromore "advanced simulation
# capabilities") absent from beam4pm's current module list per the
# deep-research synthesis of 2026-08-31 -- a real, previously-unfilled gap.
#
# Deliberately scoped to a directly-founded-graph-theory operation over the
# real DFG shape beam4pm_discovery already produces (a list of
# {from_activity, to_activity, frequency} edges) rather than a full
# discrete-event simulation engine: proposing an edge removal or addition
# and recomputing real reachability + cycle facts on the resulting graph,
# so a user can ask "if we removed this path, would activity X still be
# reachable / would this create/break a cycle" and get a real, checkable
# answer -- not a synthetic random-walk simulation.
#
# Bindings: NONE required -- fully static (operates on real runtime DFG
# data passed in by the caller).
%># GENERATED by ggen_igniter from the beam4pm_pro_simulation static template. Do not edit.
defmodule BeamPM.Pro.Simulation do
  @moduledoc """
  What-if simulation over a discovered directly-follows graph (DFG) for
  `beam4pm_pro` gap-closure item PRO-012.

  Takes the same `{from, to, frequency}` edge shape `BeamPM.Discovery.
  dfg_from_traces/1` already produces and answers real, checkable
  structural questions about a PROPOSED change to that graph -- edge
  removal or addition -- before anyone commits to it: is a given activity
  still reachable from the start activities, and does the change introduce
  or remove a cycle.

  This module does NOT implement discrete-event/token simulation (no
  throughput, waiting-time, or resource-contention modelling) -- that
  remains real, named future work (see `gaps/0`), not silently omitted.
  """

  @type dfg_edge :: {from :: String.t(), to :: String.t(), frequency :: non_neg_integer()}

  @doc """
  Apply a what-if change to `edges` and return the resulting edge list.
  `change` is `{:remove, from, to}` or `{:add, from, to, frequency}`.
  Removing an edge that doesn't exist, or adding one that already exists,
  is a no-op on that respective side (idempotent, never raises).
  """
  @spec apply_change([dfg_edge()], {:remove, String.t(), String.t()} | {:add, String.t(), String.t(), non_neg_integer()}) ::
          [dfg_edge()]
  def apply_change(edges, {:remove, from, to}) when is_list(edges) do
    Enum.reject(edges, fn {f, t, _freq} -> f == from and t == to end)
  end

  def apply_change(edges, {:add, from, to, frequency}) when is_list(edges) do
    if Enum.any?(edges, fn {f, t, _freq} -> f == from and t == to end) do
      edges
    else
      edges ++ [{from, to, frequency}]
    end
  end

  @doc """
  Real reachability: the set of activities reachable from `start_activity`
  by following `edges` forward, computed via breadth-first traversal (no
  approximation).
  """
  @spec reachable_from([dfg_edge()], String.t()) :: MapSet.t(String.t())
  def reachable_from(edges, start_activity) when is_list(edges) and is_binary(start_activity) do
    adjacency =
      Enum.reduce(edges, %{}, fn {from, to, _freq}, acc ->
        Map.update(acc, from, [to], &[to | &1])
      end)

    bfs(adjacency, [start_activity], MapSet.new([start_activity]))
  end

  defp bfs(_adjacency, [], visited), do: visited

  defp bfs(adjacency, [current | rest], visited) do
    neighbors = Map.get(adjacency, current, [])
    new_neighbors = Enum.reject(neighbors, &MapSet.member?(visited, &1))
    next_visited = Enum.reduce(new_neighbors, visited, &MapSet.put(&2, &1))
    bfs(adjacency, rest ++ new_neighbors, next_visited)
  end

  @doc """
  Real cycle detection over `edges` via DFS with a recursion-stack set --
  returns true iff the directed graph contains at least one cycle.
  """
  @spec has_cycle?([dfg_edge()]) :: boolean()
  def has_cycle?(edges) when is_list(edges) do
    adjacency =
      Enum.reduce(edges, %{}, fn {from, to, _freq}, acc ->
        Map.update(acc, from, [to], &[to | &1])
      end)

    nodes = Enum.uniq(Enum.flat_map(edges, fn {from, to, _freq} -> [from, to] end))

    {result, _visited} =
      Enum.reduce_while(nodes, {false, MapSet.new()}, fn node, {_found, visited} ->
        if MapSet.member?(visited, node) do
          {:cont, {false, visited}}
        else
          case dfs_cycle(adjacency, node, MapSet.new(), visited) do
            {true, new_visited} -> {:halt, {true, new_visited}}
            {false, new_visited} -> {:cont, {false, new_visited}}
          end
        end
      end)

    result
  end

  defp dfs_cycle(adjacency, node, on_stack, visited) do
    on_stack = MapSet.put(on_stack, node)
    visited = MapSet.put(visited, node)

    Enum.reduce_while(Map.get(adjacency, node, []), {false, visited}, fn neighbor, {_found, acc_visited} ->
      cond do
        MapSet.member?(on_stack, neighbor) ->
          {:halt, {true, acc_visited}}

        MapSet.member?(acc_visited, neighbor) ->
          {:cont, {false, acc_visited}}

        true ->
          case dfs_cycle(adjacency, neighbor, on_stack, acc_visited) do
            {true, nv} -> {:halt, {true, nv}}
            {false, nv} -> {:cont, {false, nv}}
          end
      end
    end)
  end

  @doc """
  Named, honest list of simulation capabilities this module deliberately
  does NOT implement yet.
  """
  @spec gaps() :: [atom()]
  def gaps do
    [:discrete_event_simulation, :throughput_modeling, :resource_contention, :waiting_time_estimation]
  end
end
