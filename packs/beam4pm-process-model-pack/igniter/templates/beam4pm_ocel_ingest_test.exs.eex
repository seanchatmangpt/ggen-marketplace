<%
# ggen_igniter EEx template -> test/beam4pm_ocel_ingest_test.exs
#
# Bindings (same query as beam4pm_ocel_ingest.ex.eex):
#   routes - list of string-keyed maps: "route_path", "http_method", "record_type"
#
# Chicago-style qualification: every collaborator is REAL. `Plug.Test`
# builds a real `%Plug.Conn{}` and drives it through the REAL, generated
# `BeamPM.OcelIngest.Router.call/2` plug pipeline (JSON parsing, routing,
# real `BeamPM.Types.OcelEvent.new/1`/`OcelObject.new/1` constructors) -
# nothing here is mocked or stubbed; this is the standard real-collaborator
# way to test a Plug, the same discipline as beam4pm_actuation_test.exs's
# real python3 subprocess.
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

route_rows =
  routes
  |> Enum.map(fn r ->
    %{
      path: norm.(r["route_path"]),
      method: norm.(r["http_method"]) |> to_string() |> String.downcase(),
      record_type: norm.(r["record_type"])
    }
  end)
  |> Enum.sort_by(& &1.path)

events_route = Enum.find(route_rows, &(&1.record_type == "ocel_event")) || raise "admission graph drift: no ocel_event route admitted"
objects_route = Enum.find(route_rows, &(&1.record_type == "ocel_object")) || raise "admission graph drift: no ocel_object route admitted"
%># GENERATED by ggen_igniter from the admitted bpmi:AdmittedIngestRoute graph. Do not edit.
defmodule BeamPM.OcelIngest.RouterTest do
  use ExUnit.Case, async: true
  import Plug.Test
  import Plug.Conn

  alias BeamPM.OcelIngest.Router

  @events_path <%= inspect(events_route.path) %>
  @objects_path <%= inspect(objects_route.path) %>

  test "<%= events_route.method %> <%= events_route.path %> admits a real, complete OCEL event" do
    body =
      JSON.encode!(%{
        "event_id" => "e-1",
        "event_type" => "Create Order",
        "event_time" => "2026-09-09T00:00:00Z",
        "attributes" => %{"case_id" => "c-1"}
      })

    conn =
      conn(:post, @events_path, body)
      |> put_req_header("content-type", "application/json")
      |> Router.call(Router.init([]))

    assert conn.status == 201
    resp = JSON.decode!(conn.resp_body)
    assert resp["ok"] == true
    assert resp["record"]["event_id"] == "e-1"
    assert resp["record"]["event_type"] == "Create Order"
  end

  test "<%= events_route.method %> <%= events_route.path %> refuses a real event missing a required field" do
    body = JSON.encode!(%{"event_type" => "Create Order", "event_time" => "2026-09-09T00:00:00Z"})

    conn =
      conn(:post, @events_path, body)
      |> put_req_header("content-type", "application/json")
      |> Router.call(Router.init([]))

    assert conn.status == 422
    resp = JSON.decode!(conn.resp_body)
    assert resp["ok"] == false
    assert resp["error"] == "missing_field"
    assert resp["field"] == "event_id"
  end

  test "<%= events_route.method %> <%= events_route.path %> accepts a real batch with a mix of valid and invalid events" do
    body =
      JSON.encode!(%{
        "events" => [
          %{"event_id" => "e-1", "event_type" => "Create Order", "event_time" => "2026-09-09T00:00:00Z"},
          %{"event_type" => "Ship Order", "event_time" => "2026-09-09T01:00:00Z"}
        ]
      })

    conn =
      conn(:post, @events_path, body)
      |> put_req_header("content-type", "application/json")
      |> Router.call(Router.init([]))

    assert conn.status == 422
    resp = JSON.decode!(conn.resp_body)
    assert resp["ok"] == false
    assert length(resp["accepted"]) == 1
    assert resp["rejected_missing_fields"] == ["event_id"]
  end

  test "<%= objects_route.method %> <%= objects_route.path %> admits a real, complete OCEL object" do
    body = JSON.encode!(%{"object_id" => "o-1", "object_type" => "Order", "attributes" => %{}})

    conn =
      conn(:post, @objects_path, body)
      |> put_req_header("content-type", "application/json")
      |> Router.call(Router.init([]))

    assert conn.status == 201
    resp = JSON.decode!(conn.resp_body)
    assert resp["ok"] == true
    assert resp["record"]["object_id"] == "o-1"
  end

  test "an unadmitted route is a real 404, never a silent catch-all" do
    conn =
      conn(:get, "/not-in-the-admission-graph")
      |> Router.call(Router.init([]))

    assert conn.status == 404
    resp = JSON.decode!(conn.resp_body)
    assert resp["error"] == "route_not_admitted"
  end

  test "real BeamPM.Discovery can mine a case-centric trace from ingested events end to end" do
    events_body =
      JSON.encode!(%{
        "events" => [
          %{"event_id" => "e-1", "event_type" => "Create Order", "event_time" => "2026-09-09T00:00:00Z", "attributes" => %{"case_id" => "c-42"}},
          %{"event_id" => "e-2", "event_type" => "Ship Order", "event_time" => "2026-09-09T01:00:00Z", "attributes" => %{"case_id" => "c-42"}}
        ]
      })

    conn =
      conn(:post, @events_path, events_body)
      |> put_req_header("content-type", "application/json")
      |> Router.call(Router.init([]))

    assert conn.status == 201
    resp = JSON.decode!(conn.resp_body)

    events =
      Enum.map(resp["accepted"], fn r ->
        {:ok, event} =
          BeamPM.Types.OcelEvent.new(%{
            event_id: r["event_id"],
            event_type: r["event_type"],
            event_time: r["event_time"],
            attributes: r["attributes"]
          })

        event
      end)

    [trace] = BeamPM.Discovery.traces_from_events(events, "case_id")
    assert trace.case_id == "c-42"
    assert trace.activity_sequence == ["Create Order", "Ship Order"]
  end

  test "<%= events_route.method %> <%= events_route.path %> admits a real event with nested E2O relationships" do
    body =
      JSON.encode!(%{
        "event_id" => "e-1",
        "event_type" => "Create Order",
        "event_time" => "2026-09-09T00:00:00Z",
        "relationships" => [
          %{"qualifier" => "places", "object_id" => "o-order-1"},
          %{"qualifier" => "for_customer", "object_id" => "o-customer-1"}
        ]
      })

    conn =
      conn(:post, @events_path, body)
      |> put_req_header("content-type", "application/json")
      |> Router.call(Router.init([]))

    assert conn.status == 201
    resp = JSON.decode!(conn.resp_body)
    assert resp["ok"] == true
    rels = resp["record"]["relationships"]
    assert length(rels) == 2
    assert Enum.any?(rels, &(&1["object_id"] == "o-order-1" and &1["qualifier"] == "places"))
  end

  test "<%= events_route.method %> <%= events_route.path %> refuses a real event whose nested relationship is missing a required field" do
    body =
      JSON.encode!(%{
        "event_id" => "e-1",
        "event_type" => "Create Order",
        "event_time" => "2026-09-09T00:00:00Z",
        "relationships" => [%{"qualifier" => "places"}]
      })

    conn =
      conn(:post, @events_path, body)
      |> put_req_header("content-type", "application/json")
      |> Router.call(Router.init([]))

    assert conn.status == 422
    resp = JSON.decode!(conn.resp_body)
    assert resp["ok"] == false
    assert resp["error"] == "missing_field"
    assert resp["field"] == "object_id"
    assert resp["in"] == "relationships"
  end

  test "<%= objects_route.method %> <%= objects_route.path %> admits a real object with nested O2O relationships" do
    body =
      JSON.encode!(%{
        "object_id" => "o-order-1",
        "object_type" => "Order",
        "relationships" => [%{"qualifier" => "contains", "object_id" => "o-item-1"}]
      })

    conn =
      conn(:post, @objects_path, body)
      |> put_req_header("content-type", "application/json")
      |> Router.call(Router.init([]))

    assert conn.status == 201
    resp = JSON.decode!(conn.resp_body)
    assert resp["ok"] == true
    assert [%{"qualifier" => "contains", "object_id" => "o-item-1"}] = resp["record"]["relationships"]
  end

  test "a record with no relationships key gets a real empty relationships list, not a missing key" do
    body = JSON.encode!(%{"event_id" => "e-1", "event_type" => "Create Order", "event_time" => "2026-09-09T00:00:00Z"})

    conn =
      conn(:post, @events_path, body)
      |> put_req_header("content-type", "application/json")
      |> Router.call(Router.init([]))

    assert conn.status == 201
    resp = JSON.decode!(conn.resp_body)
    assert resp["record"]["relationships"] == []
  end
end
