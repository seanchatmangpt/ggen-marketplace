<%
# ggen_igniter EEx template -> lib/beam4pm_rf2_conformance.ex
#
# Bindings (single-row query "spec", flattened):
#   oracle_name  - the real Rust oracle binary's crate name
#   wire_op      - the wire-contract "op" value the oracle understands
#   dataset_path - the real canonical XES dataset this stream is admitted
#                  against (receipt.xes)
#   module_name  - the manufactured module's name ("BeamPM.Rf2Conformance")
%># GENERATED by ggen_igniter from the admitted rf2:AdmittedOracleStream graph. Do not edit.
defmodule <%= module_name %>.OracleBridge do
  @moduledoc """
  One-shot Port-based subprocess bridge for the real `<%= oracle_name %>`
  Rust binary (single-JSON-in/single-JSON-out on stdin/stdout, exits after
  one request - see the oracle's own module doc for the exact wire
  contract). Unlike `BeamPM.Actuation.GymBridge` (a long-lived server
  process spoken to over repeated request/reply lines), this oracle reads
  ALL of stdin via `read_to_string`, computes, and only then writes its one
  JSON line - so half-closing just stdin on a live `Port` (which Erlang's
  port driver does not cleanly support without also cutting off stdout) is
  avoided entirely: the input is written to a real temp file and the real
  subprocess is spawned with shell input redirection
  (`'<oracle>' < '<tmpfile>'`), still a real `Port.open({:spawn_executable,
  ...})` subprocess - not `System.cmd/3`, not any mock.
  """

  @spec run(String.t(), map(), non_neg_integer()) :: {:ok, map()} | {:error, term()}
  def run(oracle_bin, payload, timeout \\ 60_000) when is_binary(oracle_bin) and is_map(payload) do
    sh = System.find_executable("sh") || "/bin/sh"
    tmp = Path.join(System.tmp_dir!(), "rf2-oracle-in-#{System.unique_integer([:positive])}.json")
    File.write!(tmp, JSON.encode!(payload))

    try do
      cmd = "#{shell_quote(oracle_bin)} < #{shell_quote(tmp)}"
      port = Port.open({:spawn_executable, sh}, [:binary, :exit_status, args: ["-c", cmd]])
      collect(port, [], timeout)
    rescue
      e -> {:error, {:oracle_spawn_failed, Exception.message(e)}}
    after
      File.rm(tmp)
    end
  end

  defp collect(port, acc, timeout) do
    receive do
      {^port, {:data, chunk}} ->
        collect(port, [chunk | acc], timeout)

      {^port, {:exit_status, 0}} ->
        decode(acc)

      {^port, {:exit_status, status}} ->
        {:error, {:oracle_exited, status, raw(acc)}}
    after
      timeout ->
        Port.close(port)
        {:error, {:oracle_timeout, timeout}}
    end
  end

  defp raw(acc), do: acc |> Enum.reverse() |> IO.iodata_to_binary() |> String.trim()

  defp decode(acc) do
    case JSON.decode(raw(acc)) do
      {:ok, %{} = map} -> {:ok, map}
      {:ok, other} -> {:error, {:oracle_bad_shape, other}}
      {:error, _decode_error} -> {:error, {:oracle_bad_json, raw(acc)}}
    end
  end

  defp shell_quote(s), do: "'" <> String.replace(s, "'", "'\\''") <> "'"
end

defmodule <%= module_name %> do
  @moduledoc """
  RF2 conformance-checking qualification pipeline (real
  `process_mining::conformance::case_centric` collaborator, via the real
  `<%= oracle_name %>` Rust binary): a plain `use Reactor` pipeline with a
  real `:check_clean` step (real XES import -> real `discover_alpha+++`
  Petri net -> real `align_variants` -> real `compute_fitness`, asserted
  against the exact fitness/place/transition counts observed from one real
  run against `<%= dataset_path %>`) and a real `:check_falsify` step
  (aligns a mutated copy of the SAME log - one real activity renamed to a
  nonsense string absent from the model - against the SAME fixed clean-
  discovered Petri net, and requires the resulting fitness to be strictly,
  measurably lower). `compensate/2` on both oracle-invoking steps turns any
  oracle crash into a typed, receipted refusal - never a silent crash,
  never an unreceipted run.

  ## Why the falsify step re-uses the CLEAN model (not a freshly-discovered
  one)

  `discover_alpha+++` is unsupervised: re-discovering a model straight from
  the mutated log would happily learn a brand-new transition for the
  nonsense activity and mask the defect (Alpha+++ has no ground truth to
  reject an activity by). The oracle's `model_xes_path` field lets this
  step discover the model from the untouched clean log and align the
  mutated log's variants against that SAME fixed model - the only shape
  where "an activity name that cannot appear in the discovered model" is
  literally true.

  ## Receipts (`beam4pm-rf2-conformance/v1`, one per run)

  This is a validation-only pipeline (no environment mutation, no
  `bpma:AdmittedActuation` admission concept applies) - it uses the
  lighter receipt shape the manufacturing doctrine permits for pure
  checks, but still writes exactly ONE real JSON file per run at
  `<receipts_dir>/<run_id>.json` documenting: function group, dataset(s)
  used, the real output values asserted, and the falsify outcome -- on
  every path (success, a failed conformance-value check, a failed
  discrimination check, or an oracle crash).
  """

  use Reactor

  alias <%= module_name %>.OracleBridge

  @receipt_schema "beam4pm-rf2-conformance/v1"
  @function_group "process_mining::conformance::case_centric (align_variants, align_empty_trace, compute_fitness) over a real discover_alpha+++ Petri net"

  # Real observed constants -- measured ONCE from a real
  # `<%= oracle_name %>` run (op `<%= wire_op %>`) against the real,
  # unmutated `<%= dataset_path %>`, ggen 26.9.x / process_mining 0.6.2,
  # AlignmentOptions{max_states: 5_000_000, ..default()}. See
  # qualification/rf2-conformance-oracle/README.md (or this stream's
  # manufacturing receipt) for the exact command used to reproduce them.
  # Tight float tolerance (not a loose range): these are bit-for-bit
  # deterministic given the same crate version, log, and config.
  @clean_log_fitness 0.9033816425120773
  @clean_average_fitness 0.8886023685534454
  @clean_perfectly_fitting_frac 0.6645746164574616
  @clean_total_costs 1660
  @clean_model_place_count 22
  @clean_model_transition_count 31
  @clean_num_variants_aligned 116
  @float_tolerance 1.0e-9

  input(:oracle_bin)
  input(:clean_xes_path)
  input(:mutated_xes_path)
  input(:run_opts)

  # side_effect: mutating (real subprocess) - the real conformance check
  # against the untouched clean log. `max_retries 0`: a check attempt must
  # never be silently retried.
  step :check_clean do
    argument(:oracle_bin, input(:oracle_bin))
    argument(:clean_xes_path, input(:clean_xes_path))

    run(fn %{oracle_bin: oracle_bin, clean_xes_path: clean_xes_path}, _context ->
      payload = %{
        "op" => "<%= wire_op %>",
        "xes_path" => clean_xes_path,
        "case_attr_key" => "concept:name"
      }

      case OracleBridge.run(oracle_bin, payload) do
        {:ok, %{"fitness" => fitness} = result} ->
          diffs = clean_diffs(fitness, result)

          if diffs == [] do
            {:ok, %{result: result, fitness: fitness}}
          else
            {:error, {:conformance_check_failed, diffs}}
          end

        {:ok, other} ->
          {:error, {:conformance_check_failed, [{:unexpected_shape, other}]}}

        {:error, reason} ->
          {:error, {:oracle_failed, reason}}
      end
    end)

    compensate(fn reason, %{oracle_bin: oracle_bin, run_opts: run_opts} ->
      _path =
        write_receipt!(run_opts, %{
          "outcome" => "refused",
          "reason" => inspect(reason),
          "oracle_bin" => oracle_bin,
          "clean" => nil,
          "falsify" => nil
        })

      :ok
    end)

    argument(:run_opts, input(:run_opts))
    max_retries(0)
  end

  # side_effect: mutating (real subprocess) - the discrimination proof:
  # aligns a mutated log against the SAME fixed clean-discovered model and
  # requires a real, strictly-lower fitness (not a loose "different").
  step :check_falsify do
    argument(:oracle_bin, input(:oracle_bin))
    argument(:clean_xes_path, input(:clean_xes_path))
    argument(:mutated_xes_path, input(:mutated_xes_path))
    argument(:clean, result(:check_clean))
    argument(:run_opts, input(:run_opts))

    run(fn %{
             oracle_bin: oracle_bin,
             clean_xes_path: clean_xes_path,
             mutated_xes_path: mutated_xes_path,
             clean: clean
           },
           _context ->
      payload = %{
        "op" => "<%= wire_op %>",
        "xes_path" => mutated_xes_path,
        "model_xes_path" => clean_xes_path,
        "case_attr_key" => "concept:name"
      }

      case OracleBridge.run(oracle_bin, payload) do
        {:ok, %{"fitness" => mutated_fitness} = mutated_result} ->
          clean_fitness = clean.fitness

          log_fitness_delta = clean_fitness["log_fitness"] - mutated_fitness["log_fitness"]
          avg_fitness_delta = clean_fitness["average_fitness"] - mutated_fitness["average_fitness"]

          cond do
            log_fitness_delta <= 0.0 ->
              {:error,
               {:falsify_did_not_discriminate,
                %{
                  metric: "log_fitness",
                  clean: clean_fitness["log_fitness"],
                  mutated: mutated_fitness["log_fitness"],
                  delta: log_fitness_delta
                }}}

            avg_fitness_delta <= 0.0 ->
              {:error,
               {:falsify_did_not_discriminate,
                %{
                  metric: "average_fitness",
                  clean: clean_fitness["average_fitness"],
                  mutated: mutated_fitness["average_fitness"],
                  delta: avg_fitness_delta
                }}}

            true ->
              {:ok,
               %{
                 result: mutated_result,
                 fitness: mutated_fitness,
                 log_fitness_delta: log_fitness_delta,
                 average_fitness_delta: avg_fitness_delta
               }}
          end

        {:ok, other} ->
          {:error, {:conformance_check_failed, [{:unexpected_shape, other}]}}

        {:error, reason} ->
          {:error, {:oracle_failed, reason}}
      end
    end)

    compensate(fn reason, %{oracle_bin: oracle_bin, clean: clean, run_opts: run_opts} ->
      _path =
        write_receipt!(run_opts, %{
          "outcome" => "refused",
          "reason" => inspect(reason),
          "oracle_bin" => oracle_bin,
          "clean" => clean.result,
          "falsify" => nil
        })

      :ok
    end)

    max_retries(0)
  end

  # side_effect: mutating (evidence only) - writes the ONE real
  # `beam4pm-rf2-conformance/v1` receipt for a fully successful run.
  step :finalize do
    argument(:oracle_bin, input(:oracle_bin))
    argument(:clean, result(:check_clean))
    argument(:falsify, result(:check_falsify))
    argument(:run_opts, input(:run_opts))

    run(fn %{oracle_bin: oracle_bin, clean: clean, falsify: falsify, run_opts: run_opts}, _context ->
      path =
        write_receipt!(run_opts, %{
          "outcome" => "checked",
          "reason" => "clean conformance values matched; falsify run discriminated",
          "oracle_bin" => oracle_bin,
          "clean" => clean.result,
          "falsify" => falsify.result,
          "falsify_discrimination" => %{
            "log_fitness_delta" => falsify.log_fitness_delta,
            "average_fitness_delta" => falsify.average_fitness_delta
          }
        })

      {:ok,
       %{
         receipt_path: path,
         clean: clean.fitness,
         falsify: falsify.fitness,
         log_fitness_delta: falsify.log_fitness_delta,
         average_fitness_delta: falsify.average_fitness_delta
       }}
    end)

    max_retries(0)
  end

  return(:finalize)

  # -- Public entry point (guaranteed receipt on every path) -----------------

  @doc """
  Runs the full RF2 conformance qualification: real clean check, real
  falsify discrimination check, one real receipt on every path.

  Required opts: none. Optional: `:run_id`, `:receipts_dir` (defaults to
  `receipts/rf2_conformance` under the current working directory).
  """
  @spec run(String.t(), String.t(), String.t(), keyword()) ::
          {:ok, map()} | {:error, term()}
  def run(oracle_bin, clean_xes_path, mutated_xes_path, opts \\ [])
      when is_binary(oracle_bin) and is_binary(clean_xes_path) and is_binary(mutated_xes_path) do
    {:ok, _} = Application.ensure_all_started(:reactor)
    run_opts = normalize_opts!(opts)

    case Reactor.run(
           __MODULE__,
           %{
             oracle_bin: oracle_bin,
             clean_xes_path: clean_xes_path,
             mutated_xes_path: mutated_xes_path,
             run_opts: run_opts
           },
           %{},
           async?: false
         ) do
      {:ok, out} ->
        {:ok, out}

      {:error, error} ->
        reason = principal_reason(error)
        _path = ensure_failure_receipt!(run_opts, reason)
        {:error, reason}
    end
  end

  @doc "The exact real observed clean-run constants this stream asserts against."
  @spec expected_clean_fitness() :: map()
  def expected_clean_fitness do
    %{
      log_fitness: @clean_log_fitness,
      average_fitness: @clean_average_fitness,
      perfectly_fitting_frac: @clean_perfectly_fitting_frac,
      total_costs: @clean_total_costs,
      model_place_count: @clean_model_place_count,
      model_transition_count: @clean_model_transition_count,
      num_variants_aligned: @clean_num_variants_aligned
    }
  end

  # -- Internal helpers ------------------------------------------------------

  defp clean_diffs(fitness, result) do
    []
    |> check_float(fitness["log_fitness"], @clean_log_fitness, "log_fitness")
    |> check_float(fitness["average_fitness"], @clean_average_fitness, "average_fitness")
    |> check_float(
      fitness["perfectly_fitting_frac"],
      @clean_perfectly_fitting_frac,
      "perfectly_fitting_frac"
    )
    |> check_exact(fitness["total_costs"], @clean_total_costs, "total_costs")
    |> check_exact(result["model_place_count"], @clean_model_place_count, "model_place_count")
    |> check_exact(
      result["model_transition_count"],
      @clean_model_transition_count,
      "model_transition_count"
    )
    |> check_exact(
      result["num_variants_aligned"],
      @clean_num_variants_aligned,
      "num_variants_aligned"
    )
  end

  defp check_float(diffs, actual, expected, name) when is_number(actual) do
    if abs(actual - expected) <= @float_tolerance do
      diffs
    else
      [{name, expected, actual} | diffs]
    end
  end

  defp check_float(diffs, actual, expected, name), do: [{name, expected, actual} | diffs]

  defp check_exact(diffs, actual, expected, _name) when actual == expected, do: diffs
  defp check_exact(diffs, actual, expected, name), do: [{name, expected, actual} | diffs]

  defp normalize_opts!(opts) do
    %{
      receipts_dir:
        Keyword.get(opts, :receipts_dir, Path.join(File.cwd!(), "receipts/rf2_conformance")),
      run_id:
        Keyword.get(
          opts,
          :run_id,
          "rf2-#{System.system_time(:millisecond)}-#{System.unique_integer([:positive])}"
        )
    }
  end

  defp receipt_path(run_opts) do
    Path.join(run_opts.receipts_dir, run_opts.run_id <> ".json")
  end

  defp write_receipt!(run_opts, fields) do
    receipt =
      Map.merge(
        %{
          "receipt_schema" => @receipt_schema,
          "function_group" => @function_group,
          "run_id" => run_opts.run_id
        },
        fields
      )

    path = receipt_path(run_opts)
    File.mkdir_p!(Path.dirname(path))
    File.write!(path, JSON.encode!(receipt))
    path
  end

  defp ensure_failure_receipt!(run_opts, reason) do
    path = receipt_path(run_opts)

    if File.exists?(path) do
      path
    else
      write_receipt!(run_opts, %{
        "outcome" => "refused",
        "reason" => inspect(reason),
        "clean" => nil,
        "falsify" => nil
      })
    end
  end

  # Pulls the FIRST typed leaf reason back out of Reactor's nested Splode
  # error class, matched structurally (same real shape
  # `BeamPM.Actuation.principal_reason/1` relies on).
  defp principal_reason(error) do
    case find_tagged_reason(error) do
      {:ok, reason} -> reason
      :error -> {:conformance_run_failed, error}
    end
  end

  defp find_tagged_reason(%{errors: errors}) when is_list(errors) do
    Enum.reduce_while(errors, :error, fn e, :error ->
      case find_tagged_reason(e) do
        {:ok, _} = found -> {:halt, found}
        :error -> {:cont, :error}
      end
    end)
  end

  defp find_tagged_reason(%{error: {:conformance_check_failed, _} = tagged}), do: {:ok, tagged}
  defp find_tagged_reason(%{error: {:falsify_did_not_discriminate, _} = tagged}), do: {:ok, tagged}
  defp find_tagged_reason(%{error: {:oracle_failed, _} = tagged}), do: {:ok, tagged}
  defp find_tagged_reason(%{error: nested}), do: find_tagged_reason(nested)
  defp find_tagged_reason(_other), do: :error
end
