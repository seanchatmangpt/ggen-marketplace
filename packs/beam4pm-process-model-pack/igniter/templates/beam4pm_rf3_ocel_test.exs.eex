<%
# ggen_igniter EEx template -> test/beam4pm_rf3_ocel_test.exs
#
# Bindings: NONE -- see beam4pm_rf3_ocel.ex.eex's header for why this stream
# has no admission-graph data to bind. `run_opts()` below resolves real paths
# at TEST run time (oracle binary, fixtures), not at render time, so this
# template renders identically regardless of where the consuming app is
# checked out.
%># GENERATED by ggen_igniter from the RF3 (process_mining::bindings::slim_ocel_bindings)
# oracle manifest. Do not edit.
defmodule BeamPM.RF3OcelTest do
  use ExUnit.Case, async: false

  alias BeamPM.RF3Ocel

  # Real paths -- no mocks. `RF3_ORACLE_BIN` lets the integrator point this at
  # the app's own compiled `priv/rf3_ocel_oracle/rf3-ocel-oracle` once this
  # stream is merged; the scratch verification harness (this session) points
  # it at the oracle crate's own `target/release` build via env vars set by
  # the harness's render/run script.
  defp run_opts(extra \\ []) do
    receipts_dir =
      Path.join([System.tmp_dir!(), "rf3_ocel_receipts", "run-#{System.unique_integer([:positive])}"])

    Keyword.merge(
      [
        oracle_bin: System.fetch_env!("RF3_ORACLE_BIN"),
        positive_fixture_path: System.fetch_env!("RF3_POSITIVE_FIXTURE"),
        n13_fixture_path: System.fetch_env!("RF3_N13_FIXTURE"),
        n14_fixture_path: System.fetch_env!("RF3_N14_FIXTURE"),
        n05_fixture_path: System.fetch_env!("RF3_N05_FIXTURE"),
        receipts_dir: receipts_dir
      ],
      extra
    )
  end

  defp read_receipt!(receipt_path) do
    receipt_path
    |> File.read!()
    |> JSON.decode!()
  end

  describe ":check_positive -- real, self-authored, well-formed OCEL 2.0 JSON" do
    test "reports real, specific, non-trivial event/object/type counts" do
      assert {:ok, out} = RF3Ocel.run(:check_positive, run_opts())

      assert out.verified.num_events == 2
      assert out.verified.num_objects == 2
      assert out.verified.e2o_relationship_count == 3
      assert out.verified.o2o_relationship_count == 1

      receipt = read_receipt!(out.receipt_path)
      assert receipt["receipt_schema"] == "beam4pm-rf3-ocel/v1"
      assert receipt["outcome"] == "passed"
      assert receipt["oracle_out"]["ok"] == true
      assert receipt["oracle_out"]["num_events"] == 2
      assert receipt["oracle_out"]["num_objects"] == 2

      assert receipt["oracle_out"]["type_stats"]["event_type_counts"] == %{
               "Create Order" => 1,
               "Ship Order" => 1
             }

      assert receipt["oracle_out"]["type_stats"]["object_type_counts"] == %{
               "Order" => 1,
               "Item" => 1
             }
    end
  end

  describe ":check_roundtrip -- programmatic SlimLinkedOCEL build + construct_ocel round trip" do
    test "the reconstructed-and-re-linked counts are byte-identical to the original build" do
      assert {:ok, out} = RF3Ocel.run(:check_roundtrip, run_opts())

      assert out.verified.built_num_events == 2
      assert out.verified.built_num_objects == 2
      assert out.verified.roundtrip_identical == true

      receipt = read_receipt!(out.receipt_path)
      built = receipt["oracle_out"]["built"]
      reconstructed = receipt["oracle_out"]["reconstructed_ocel"]
      roundtrip = receipt["oracle_out"]["roundtrip"]

      assert built["num_events"] == 2
      assert built["num_objects"] == 2
      assert built["e2o_relationship_count"] == 3
      assert built["o2o_relationship_count"] == 1

      # The real round-trip proof: build -> locel_construct_ocel -> re-link
      # via slim_link_ocel -> re-measure. Every one of these must match the
      # ORIGINAL build exactly.
      assert reconstructed["num_events"] == built["num_events"]
      assert reconstructed["num_objects"] == built["num_objects"]
      assert reconstructed["e2o_relationship_count"] == built["e2o_relationship_count"]
      assert reconstructed["o2o_relationship_count"] == built["o2o_relationship_count"]
      assert roundtrip["num_events"] == built["num_events"]
      assert roundtrip["num_objects"] == built["num_objects"]
      assert roundtrip["type_stats"] == built["type_stats"]
    end
  end

  describe ":falsify_duplicate_object -- REAL n13-duplicate-object-id.ocel.json" do
    test "process_mining silently dedups (no crash, no refusal); this pipeline refuses" do
      assert {:error, {:refused, reason}} = RF3Ocel.run(:falsify_duplicate_object, run_opts())
      assert {:assertion_failed, {:duplicate_object_id_silently_deduped_by_process_mining, _facts}} =
               reason
    end

    test "the typed refusal receipt discloses the real raw-vs-effective counts, never a crash" do
      {:error, _reason} = RF3Ocel.run(:falsify_duplicate_object, run_opts())

      # Re-run with a fresh receipts_dir we can inspect directly (run/2's
      # {:error, _} does not itself return the receipt path).
      receipts_dir =
        Path.join([System.tmp_dir!(), "rf3_ocel_receipts", "inspect-#{System.unique_integer([:positive])}"])

      run_id = "n13-inspect"
      opts = run_opts(receipts_dir: receipts_dir, run_id: run_id)
      assert {:error, _} = RF3Ocel.run(:falsify_duplicate_object, opts)

      receipt = read_receipt!(Path.join(receipts_dir, run_id <> ".json"))
      assert receipt["outcome"] == "refused"
      assert receipt["oracle_out"]["ok"] == true
      # The oracle itself never refused -- process_mining accepted the file.
      # The RAW (pre-slim-link) struct still carries BOTH "order-1" entries...
      assert receipt["oracle_out"]["raw"]["num_objects"] == 2
      assert receipt["oracle_out"]["raw"]["distinct_object_ids"] == 1
      # ...while the slim-linked/reconstructed view has already silently
      # dropped the duplicate down to one object.
      assert receipt["oracle_out"]["num_objects"] == 1
      assert receipt["reason"] =~ "duplicate_object_id_silently_deduped_by_process_mining"
    end
  end

  describe ":falsify_undeclared_type -- REAL n14-undeclared-event-type.ocel.json" do
    test "process_mining silently auto-declares the type (zero warning); this pipeline refuses" do
      assert {:error, {:refused, reason}} = RF3Ocel.run(:falsify_undeclared_type, run_opts())

      assert {:assertion_failed,
              {:undeclared_event_type_silently_auto_declared_by_process_mining, _facts}} = reason
    end

    test "the typed refusal receipt names the real undeclared type" do
      receipts_dir =
        Path.join([System.tmp_dir!(), "rf3_ocel_receipts", "inspect-#{System.unique_integer([:positive])}"])

      run_id = "n14-inspect"
      opts = run_opts(receipts_dir: receipts_dir, run_id: run_id)
      assert {:error, _} = RF3Ocel.run(:falsify_undeclared_type, opts)

      receipt = read_receipt!(Path.join(receipts_dir, run_id <> ".json"))
      assert receipt["outcome"] == "refused"
      assert receipt["oracle_out"]["ok"] == true
      assert receipt["oracle_out"]["raw"]["undeclared_event_types_used"] == ["Teleport Order"]
      # process_mining still counted the event under its auto-declared type --
      # it did not drop it the way it dropped n13's duplicate object.
      assert receipt["oracle_out"]["num_events"] == 2
      assert receipt["reason"] =~ "undeclared_event_type_silently_auto_declared_by_process_mining"
    end
  end

  describe ":falsify_dangling_o2o -- REAL n05-o2o-dangling.ocel.json (bonus coverage)" do
    test "process_mining silently drops the dangling O2O at finalize(); this pipeline refuses" do
      assert {:error, {:refused, reason}} = RF3Ocel.run(:falsify_dangling_o2o, run_opts())

      assert {:assertion_failed,
              {:dangling_o2o_relationship_silently_dropped_by_process_mining, _facts}} = reason
    end
  end

  describe "compensate/2 never crashes on a malformed scenario" do
    test "an unadmitted scenario atom is a typed refusal, not a FunctionClauseError/crash" do
      assert {:error, {:refused, reason}} = RF3Ocel.run(:not_a_real_scenario, run_opts())
      assert reason =~ "is not one of the admitted RF3 scenarios"
    end
  end
end
