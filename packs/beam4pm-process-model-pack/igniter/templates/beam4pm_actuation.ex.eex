<%
# ggen_igniter EEx template -> lib/beam4pm_actuation.ex
#
# Bindings (from `mix ggen_igniter.sync
#   --query admitted=.../admitted_actions.rq
#   --query admitted_requires=.../admitted_requires.rq`):
#   admitted          - list of string-keyed maps: "action_name", "gym_op"
#   admitted_requires - list of string-keyed maps: "action_name", "fact"
#
# Engine-shape note (same convention as beam4pm_ash.ex.eex): `--engine
# oxigraph` (the default) returns RAW N-Triples-style terms (IRIs
# angle-bracketed, literals quoted and possibly datatype-tagged); `--engine
# sparql` returns plain unwrapped Elixir values. norm/1 handles both. Row
# order is NEVER trusted - all rows are re-sorted here with Enum.sort_by.
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

admitted_rows =
  admitted
  |> Enum.map(fn a -> %{name: norm.(a["action_name"]), gym_op: norm.(a["gym_op"])} end)
  |> Enum.sort_by(& &1.name)

requires_rows =
  Enum.map(admitted_requires, fn r -> %{name: norm.(r["action_name"]), fact: norm.(r["fact"])} end)

requires_for = fn name ->
  requires_rows |> Enum.filter(&(&1.name == name)) |> Enum.map(& &1.fact) |> Enum.sort()
end

allowlist_entries =
  Enum.map_join(admitted_rows, ",\n", fn a ->
    reqs = a.name |> requires_for.() |> Enum.map_join(", ", &inspect/1)
    "    #{inspect(a.name)} => %{gym_op: #{inspect(a.gym_op)}, requires: [#{reqs}]}"
  end)

allowlist_doc =
  Enum.map_join(admitted_rows, "\n", fn a ->
    reqs =
      case requires_for.(a.name) do
        [] -> "no required precondition facts"
        facts -> "requires precondition fact(s) " <> Enum.map_join(facts, ", ", &inspect/1)
      end

    "    * `#{a.name}` -> gym op `#{a.gym_op}` (#{reqs})"
  end)
%># GENERATED by ggen_igniter from the admitted bpma:AdmittedActuation graph. Do not edit.
defmodule BeamPM.Actuation.GymBridge do
  @moduledoc """
  Port-based wrapper around one gym bridge subprocess speaking the FIXED
  beam4pm gym bridge wire protocol: `python3 <bridge.py> --gym <name>`,
  JSON lines on stdin/stdout:

      in:  {"op":"reset"}                 out: {"ok":true,"observation":<json>}
      in:  {"op":"step","action":<json>}  out: {"ok":true,"observation":<json>,
                                                "reward":<num>,"done":<bool>,
                                                "info":<json>}
      in:  {"op":"close"}                 out: {"ok":true}  then exit 0
      any error: {"ok":false,"error":"<reason>"} on stdout.

  A real subprocess collaborator (Chicago discipline): no part of this
  module fakes the environment - a dead bridge surfaces as a typed
  `{:error, {:bridge_exited, status}}`, never a silent success.
  """

  defstruct [:port, :bridge_py, :gym]

  @type t :: %__MODULE__{port: port(), bridge_py: String.t(), gym: String.t()}

  @doc "Spawns `python3 bridge_py --gym gym` as a line-oriented binary port."
  @spec open(String.t(), String.t()) :: {:ok, t()} | {:error, term()}
  def open(bridge_py, gym) when is_binary(bridge_py) and is_binary(gym) do
    case System.find_executable("python3") do
      nil ->
        {:error, :python3_not_found}

      python3 ->
        port =
          Port.open({:spawn_executable, python3}, [
            :binary,
            :exit_status,
            {:line, 1_048_576},
            args: [bridge_py, "--gym", gym]
          ])

        {:ok, %__MODULE__{port: port, bridge_py: bridge_py, gym: gym}}
    end
  end

  @doc """
  Sends one JSON-line request and awaits one JSON-line reply.

  `{:ok, reply}` only for a well-formed `{"ok":true,...}` reply; every other
  outcome is a typed error: `{:bridge_error, reason}` (the bridge's own
  `{"ok":false,...}`), `{:bridge_exited, status}` (abrupt subprocess death),
  `{:bridge_timeout, ms}`, `{:bridge_bad_json, line}`.
  """
  @spec request(t(), map(), non_neg_integer()) :: {:ok, map()} | {:error, term()}
  def request(%__MODULE__{port: port}, payload, timeout \\ 10_000) when is_map(payload) do
    Port.command(port, [JSON.encode!(payload), "\n"])
    receive_line(port, [], timeout)
  rescue
    # Port.command/2 on an already-dead port raises ArgumentError.
    ArgumentError -> {:error, {:bridge_exited, :port_closed}}
  end

  @doc "Politely closes the bridge (close op), then hard-closes the port."
  @spec close(t()) :: :ok
  def close(%__MODULE__{port: port} = bridge, timeout \\ 2_000) do
    if Port.info(port) != nil do
      # Same real gap as request/3's default: a close op that itself does
      # real teardown work (e.g. a blocking `kubectl delete namespace`) can
      # legitimately exceed a hardcoded 2s -- the caller's own
      # actuation_opts[:bridge_timeout] is the single source of truth for
      # how long this bridge's operations are allowed to take, reset/step
      # included, so close respects it too rather than force-killing a
      # still-real teardown mid-flight (which would recreate the exact
      # partial-state race this option exists to prevent).
      _ = request(bridge, %{"op" => "close"}, timeout)

      receive do
        {^port, {:exit_status, _status}} -> :ok
      after
        1_000 -> :ok
      end

      if Port.info(port) != nil, do: Port.close(port)
    end

    :ok
  rescue
    ArgumentError -> :ok
  end

  defp receive_line(port, acc, timeout) do
    receive do
      {^port, {:data, {:eol, chunk}}} ->
        [chunk | acc] |> Enum.reverse() |> IO.iodata_to_binary() |> decode_reply()

      {^port, {:data, {:noeol, chunk}}} ->
        receive_line(port, [chunk | acc], timeout)

      {^port, {:exit_status, status}} ->
        {:error, {:bridge_exited, status}}
    after
      timeout -> {:error, {:bridge_timeout, timeout}}
    end
  end

  defp decode_reply(line) do
    case JSON.decode(line) do
      {:ok, %{"ok" => true} = reply} -> {:ok, reply}
      {:ok, %{"ok" => false, "error" => reason}} -> {:error, {:bridge_error, reason}}
      {:ok, other} -> {:error, {:bridge_protocol, other}}
      {:error, _decode_error} -> {:error, {:bridge_bad_json, line}}
    end
  end
end

defmodule BeamPM.Actuation.Session do
  @moduledoc """
  Caller-owned lifecycle for a `BeamPM.Actuation.GymBridge` port meant to
  survive more than one `BeamPM.Actuation.run/2` call: opened + reset
  EXACTLY ONCE, then threaded across N `Actuation.run/2` calls (each doing
  exactly one gym "step" against the SAME already-running port), then
  closed EXACTLY ONCE.

  Exists to close a real defect: `BeamPM.Actuation.run/2`'s own `:execute`
  step always does open -> reset -> step -> close, in that fixed order, on
  EVERY call (see the `:execute` step's `nil`-session branch below, which
  is that exact unmodified behavior). A caller driving several admitted
  actuations in sequence against ONE continuously-running environment (e.g.
  `BeamPM.ProcessGovernor.run/2` in `continuous: true` mode) would otherwise
  reset that environment back to its initial state before every single
  step - not a continuous multi-step transition on one running target, N
  independent one-shot resets. Passing `session: %Session{}` in
  `actuation_opts` (see `normalize_opts!/1` below) makes `:execute` skip
  open/reset/close entirely and reuse this session's already-open bridge.

  Purely additive and opt-in: no `:session` key in `actuation_opts` (the
  default, and the ONLY thing every existing caller of `Actuation.run/2`
  passes) takes the unmodified nil-session `:execute` branch, byte-identical
  to this module's behavior before `Session` existed.
  """

  alias BeamPM.Actuation.GymBridge

  defstruct [:bridge, :gym, :bridge_py, :last_observation]

  @type t :: %__MODULE__{
          bridge: GymBridge.t(),
          gym: String.t(),
          bridge_py: String.t(),
          last_observation: map() | nil
        }

  @doc """
  Opens ONE `GymBridge` subprocess for `gym` (via `bridge_py`) and sends
  ONE `reset` request against it. On any failure - bridge spawn failure, or
  a failed/timed-out reset - self-guards against a port leak by closing the
  bridge it just opened before returning the typed error, so this function
  is safe to call even outside a `try/after`.
  """
  @spec open(String.t(), String.t(), non_neg_integer()) :: {:ok, t()} | {:error, term()}
  def open(bridge_py, gym, bridge_timeout \\ 10_000)
      when is_binary(bridge_py) and is_binary(gym) do
    case GymBridge.open(bridge_py, gym) do
      {:error, reason} ->
        {:error, {:bridge_open, reason}}

      {:ok, bridge} ->
        case GymBridge.request(bridge, %{"op" => "reset"}, bridge_timeout) do
          {:ok, %{"observation" => obs}} ->
            {:ok,
             %__MODULE__{bridge: bridge, gym: gym, bridge_py: bridge_py, last_observation: obs}}

          {:error, reason} ->
            _ = GymBridge.close(bridge, bridge_timeout)
            {:error, reason}
        end
    end
  end

  @doc "Returns `session` with `last_observation` replaced - used to thread the real observation forward between steps for accurate receipt `observation_before` fields."
  @spec update_observation(t(), map()) :: t()
  def update_observation(%__MODULE__{} = session, observation) when is_map(observation),
    do: %{session | last_observation: observation}

  @doc "Sends ONE `close` request then hard-closes the port. Idempotent with `GymBridge.close/2`'s own dead-port guard."
  @spec close(t(), non_neg_integer()) :: :ok
  def close(%__MODULE__{bridge: bridge}, bridge_timeout \\ 2_000),
    do: GymBridge.close(bridge, bridge_timeout)
end

defmodule BeamPM.Actuation do
  @moduledoc """
  BRCE actuation pipeline (gates PI7/PI8): a plain `use Reactor` pipeline
  (NOT `Ash.Reactor`) that takes one planner-constructed `planning_action`
  through validate -> admit -> execute -> observe+receipt, with typed
  refusals and compensation - never a silent crash, never an unreceipted
  actuation attempt.

  ## Authority doctrine (SELECT / CONSTRUCT / DO stay separate)

  The planner's `planning_action` carries NO execution authority and NO
  execution payload. The ONLY admitted action shapes are the
  `bpma:AdmittedActuation` individuals in the admission graph
  (`ontology/actuation-admission.ttl`), rendered by ggen_igniter into
  `@admitted_actuations` below - the concrete gym op released to the
  execute step comes from that graph data, through the admission boundary,
  never from the planner's input map. Admission is data-driven: edit the
  graph and re-run `mix ggen_igniter.sync`; never hand-edit this module.

  Graph-derived allowlist rendered into this build:

  <%= allowlist_doc %>

  ## Receipts (every path, `beam4pm-brce/v1`)

  Every attempt - admitted+performed, refused, or execution-failed - ends in
  exactly one consequence receipt at `<receipts_dir>/<run_id>.json`:

    * success: written by the `:finalize` step (`performed: true`, real
      before/after observations, reward, done, four OCEL events
      plan/admit/execute/observe).
    * execute failure (bridge crash, protocol error): written by the
      `:execute` step's `compensate/2` (`admitted: true, performed: false`,
      error captured) - Reactor's own compensation hook, never a silent
      crash - then `run/2` returns `{:error, {:execution_failed, reason}}`.
    * refusal (invalid action shape, or not admitted by the graph):
      `run/2`'s failure path writes the refusal receipt
      (`admitted: false, performed: false`) and returns
      `{:error, {:refused, reason}}`.

  `run/2` is the guaranteed-receipt entry point; calling
  `Reactor.run(__MODULE__, ...)` directly only guarantees receipts on the
  success and execute-failure paths.

  ## Hash-chained receipts (stream EX2 extension, additive and opt-in)

  Every receipt `write_receipt!/2` produces (success, compensation, AND
  refusal - all three call sites share this one helper) MAY additionally
  carry `"chain_id"`/`"chain_seq"`/`"prev_receipt_path"`/
  `"prev_receipt_hash"`, linking it to the immediately-prior receipt in the
  same named chain by the sha256 of that prior receipt's real on-disk
  bytes. This is purely additive: passing no `:chain_id` in `actuation_opts`
  (the default) keeps today's exact `beam4pm-brce/v1` shape, zero new keys.
  `BeamPM.ProcessGovernor.apply_transition/3` supplies `chain_id:
  process_id` by default so a governed process's actuation receipts chain
  automatically; see `BeamPM.ReceiptChain`'s moduledoc for the full design
  rationale (adapted from ex4pm's real `Ex4pm.Evidence.Replay.Chain`) and
  `BeamPM.ReceiptChain.verify/2` for real, independent chain-replay
  verification.
  """

  use Reactor

  alias BeamPM.Actuation.GymBridge
  alias BeamPM.Codec
  alias BeamPM.ReceiptChain
  alias BeamPM.Types.OcelEvent
  alias BeamPM.Types.PlanningAction
  alias BeamPM.Types.PolicyDecision

  @receipt_schema "beam4pm-brce/v1"

  # Graph-derived admission allowlist (bpma:AdmittedActuation individuals).
  # Data-driven, never hardcoded: this literal is manufactured by
  # ggen_igniter from the admission graph.
  @admitted_actuations %{
<%= allowlist_entries %>
  }

  input(:action_input)
  input(:actuation_opts)

  # side_effect: pure - validates the raw planner output into a real
  # BeamPM.Types.PlanningAction; a malformed action is a typed refusal.
  step :validate_action do
    argument(:action_input, input(:action_input))
    argument(:actuation_opts, input(:actuation_opts))

    run(fn %{action_input: action_input, actuation_opts: opts}, _context ->
      case PlanningAction.new(action_input) do
        {:ok, %PlanningAction{} = action} ->
          {:ok, %{action: action, plan_event: event(opts, 1, "plan", %{})}}

        {:error, reason} ->
          {:error, {:refused, {:invalid_action, reason}}}
      end
    end)

    max_retries(0)
  end

  # side_effect: pure - evaluates the action against the graph-derived
  # allowlist and binds the admission outcome as a real
  # BeamPM.Types.PolicyDecision. Fail-closed: anything not explicitly
  # admitted is a typed `{:error, {:refused, reason}}`.
  step :admit do
    argument(:validated, result(:validate_action))
    argument(:actuation_opts, input(:actuation_opts))

    run(fn %{validated: %{action: action}, actuation_opts: opts}, _context ->
      case admission_verdict(action) do
        {:admitted, gym_op} ->
          {:ok, decision} =
            PolicyDecision.new(%{
              decision_id: "pd-" <> Map.fetch!(opts, :run_id),
              verdict: :admitted,
              reason:
                "action_name #{inspect(action.action_name)} admitted by graph-derived " <>
                  "allowlist; released gym op #{inspect(gym_op)}"
            })

          {:ok,
           %{
             policy_decision: decision,
             gym_op: gym_op,
             admit_event: event(opts, 2, "admit", %{"verdict" => "admitted"})
           }}

        {:refused, reason} ->
          {:error, {:refused, reason}}
      end
    end)

    max_retries(0)
  end

  # side_effect: mutating - the ONLY step that touches the environment
  # (drives the real gym bridge subprocess). Runs only if :admit succeeded
  # (its `result(:admit)` argument gates it structurally). `max_retries 0`:
  # an actuation attempt must never be silently retried. On ITS OWN failure
  # the compensate/2 hook below emits a real failure consequence receipt
  # (performed: false, error captured) - never a silent crash.
  step :execute do
    argument(:validated, result(:validate_action))
    argument(:admitted, result(:admit))
    argument(:actuation_opts, input(:actuation_opts))

    run(fn %{admitted: %{gym_op: gym_op}, actuation_opts: opts}, _context ->
      gym_action = %{"op" => gym_op}
      action_json = JSON.encode!(gym_action)

      case Map.get(opts, :session) do
        nil ->
          gym = Map.fetch!(opts, :gym)
          bridge_py = Map.fetch!(opts, :bridge)
          bridge_timeout = Map.fetch!(opts, :bridge_timeout)

          case GymBridge.open(bridge_py, gym) do
            {:error, reason} ->
              {:error, {:execution_failed, {:bridge_open, reason}}}

            {:ok, bridge} ->
              result =
                with {:ok, %{"observation" => obs_before}} <-
                       GymBridge.request(bridge, %{"op" => "reset"}, bridge_timeout),
                     {:ok, step_reply} <-
                       GymBridge.request(
                         bridge,
                         %{"op" => "step", "action" => gym_action},
                         bridge_timeout
                       ) do
                  {:ok,
                   %{
                     observation_before: obs_before,
                     observation_after: Map.get(step_reply, "observation"),
                     reward: Map.get(step_reply, "reward"),
                     done: Map.get(step_reply, "done"),
                     info: Map.get(step_reply, "info"),
                     action_json: action_json,
                     execute_event:
                       event(opts, 3, "execute", %{"gym" => gym, "action_json" => action_json})
                   }}
                else
                  {:error, reason} -> {:error, {:execution_failed, reason}}
                end

              _ = GymBridge.close(bridge, bridge_timeout)
              result
          end

        %BeamPM.Actuation.Session{bridge: bridge, gym: gym, last_observation: obs_before} ->
          # Continuous-session mode (opt-in via actuation_opts[:session]):
          # the SAME already-open, already-reset bridge is reused for every
          # transition in the caller's sequence - no open, no reset, no
          # close here. The caller (BeamPM.ProcessGovernor.run/2's
          # `continuous: true` path) owns the session's whole lifecycle: one
          # BeamPM.Actuation.Session.open/3 before the sequence, one
          # BeamPM.Actuation.Session.close/2 after it, via try/after.
          bridge_timeout = Map.fetch!(opts, :bridge_timeout)

          case GymBridge.request(bridge, %{"op" => "step", "action" => gym_action}, bridge_timeout) do
            {:ok, step_reply} ->
              {:ok,
               %{
                 observation_before: obs_before,
                 observation_after: Map.get(step_reply, "observation"),
                 reward: Map.get(step_reply, "reward"),
                 done: Map.get(step_reply, "done"),
                 info: Map.get(step_reply, "info"),
                 action_json: action_json,
                 execute_event:
                   event(opts, 3, "execute", %{"gym" => gym, "action_json" => action_json})
               }}

            {:error, reason} ->
              {:error, {:execution_failed, reason}}
          end
      end
    end)

    compensate(fn reason, %{validated: validated, admitted: admitted, actuation_opts: opts} ->
      # BRCE compensation: an ADMITTED actuation attempt ran against the
      # real environment and failed. Emit a real failure consequence
      # receipt (admitted: true, performed: false, error captured) so the
      # attempt is never silent, then accept the failure (`:ok` - Reactor
      # then fails the run with the original typed error).
      error_text = failure_reason_text(reason)

      events = [
        validated.plan_event,
        admitted.admit_event,
        event(opts, 3, "execute", %{"outcome" => "failed", "error" => error_text})
      ]

      _path =
        write_receipt!(opts, %{
          action_map: Codec.to_map(validated.action),
          admitted: true,
          policy_decision: admitted.policy_decision,
          reason: admitted.policy_decision.reason,
          execution: %{
            "performed" => false,
            "observation_before" => nil,
            "observation_after" => nil,
            "reward" => nil,
            "done" => nil,
            "error" => error_text
          },
          events: events,
          action_json: JSON.encode!(%{"op" => admitted.gym_op})
        })

      :ok
    end)

    max_retries(0)
  end

  # side_effect: mutating (evidence only) - builds the FIXED
  # beam4pm-brce/v1 consequence receipt with real OCEL events and writes it
  # to `<receipts_dir>/<run_id>.json`. `max_retries 0`: a receipt write must
  # never be silently re-run.
  step :finalize do
    argument(:validated, result(:validate_action))
    argument(:admitted, result(:admit))
    argument(:executed, result(:execute))
    argument(:actuation_opts, input(:actuation_opts))

    run(fn %{validated: v, admitted: a, executed: e, actuation_opts: opts}, _context ->
      observe_event =
        event(opts, 4, "observe", %{"reward" => e.reward, "done" => e.done})

      events = [v.plan_event, a.admit_event, e.execute_event, observe_event]

      path =
        write_receipt!(opts, %{
          action_map: Codec.to_map(v.action),
          admitted: true,
          policy_decision: a.policy_decision,
          reason: a.policy_decision.reason,
          execution: %{
            "performed" => true,
            "observation_before" => e.observation_before,
            "observation_after" => e.observation_after,
            "reward" => e.reward,
            "done" => e.done
          },
          events: events,
          action_json: e.action_json
        })

      {:ok,
       %{
         receipt_path: path,
         run_id: Map.fetch!(opts, :run_id),
         performed: true,
         observation_before: e.observation_before,
         observation_after: e.observation_after,
         reward: e.reward,
         done: e.done,
         events: events
       }}
    end)

    max_retries(0)
  end

  return(:finalize)

  # -- Public entry point (guaranteed receipt on every path) -----------------

  @doc """
  Runs one full actuation attempt for `action_input` (an atom-keyed map for
  `BeamPM.Types.PlanningAction.new/1`).

  Required opts: `:gym` (gym name), `:bridge` (path to the bridge .py).
  Optional: `:run_id` (defaults to a fresh unique id), `:receipts_dir`
  (defaults to `receipts/actuations` under the current working directory).

  Returns `{:ok, %{receipt_path: ..., performed: true, ...}}`,
  `{:error, {:refused, reason}}`, or `{:error, {:execution_failed, reason}}` -
  and in ALL three cases exactly one consequence receipt exists on disk at
  `<receipts_dir>/<run_id>.json` afterward.
  """
  @spec run(map(), keyword()) ::
          {:ok, map()} | {:error, {:refused, term()} | {:execution_failed, term()} | term()}
  def run(action_input, opts) when is_map(action_input) and is_list(opts) do
    {:ok, _} = Application.ensure_all_started(:reactor)
    opts = normalize_opts!(opts)

    case Reactor.run(__MODULE__, %{action_input: action_input, actuation_opts: opts}, %{},
           async?: false
         ) do
      {:ok, out} ->
        {:ok, out}

      {:error, error} ->
        reason = principal_reason(error)
        _path = ensure_failure_receipt!(action_input, opts, reason)
        {:error, reason}
    end
  end

  @doc """
  The data-driven admission verdict for one validated action: `{:admitted,
  gym_op}` only when the action's `action_name` is a graph-admitted
  actuation AND every graph-required precondition fact
  (`bpma:requiresFact`) appears in the action's own preconditions;
  `{:refused, reason}` otherwise. Fail-closed.
  """
  @spec admission_verdict(PlanningAction.t()) :: {:admitted, String.t()} | {:refused, String.t()}
  def admission_verdict(%PlanningAction{} = action) do
    case Map.fetch(@admitted_actuations, action.action_name) do
      :error ->
        {:refused,
         "action_name #{inspect(action.action_name)} is not an admitted actuation " <>
           "(graph-derived allowlist: #{inspect(Map.keys(@admitted_actuations))})"}

      {:ok, %{gym_op: gym_op, requires: requires}} ->
        case requires -- (action.preconditions || []) do
          [] ->
            {:admitted, gym_op}

          missing ->
            {:refused,
             "action_name #{inspect(action.action_name)} is missing required " <>
               "precondition fact(s) #{inspect(missing)} (graph-derived bpma:requiresFact)"}
        end
    end
  end

  @doc "The graph-derived admission allowlist rendered into this build."
  @spec admitted_actuations() :: %{String.t() => %{gym_op: String.t(), requires: [String.t()]}}
  def admitted_actuations, do: @admitted_actuations

  # -- Internal helpers ------------------------------------------------------

  defp normalize_opts!(opts) do
    %{
      gym: Keyword.fetch!(opts, :gym),
      bridge: Keyword.fetch!(opts, :bridge),
      receipts_dir:
        Keyword.get(opts, :receipts_dir, Path.join(File.cwd!(), "receipts/actuations")),
      run_id:
        Keyword.get(
          opts,
          :run_id,
          "act-#{System.system_time(:millisecond)}-#{System.unique_integer([:positive])}"
        ),
      chain_id: Keyword.get(opts, :chain_id),
      # Real gap, found by real testing: the toy in-memory gym bridge never
      # needed more than GymBridge.request/3's own 10_000ms default, but a
      # real production actuation target (e.g. a real Kubernetes rollout)
      # can legitimately take longer -- without this being configurable,
      # Elixir gives up and force-closes the Port mid-operation, leaving
      # the real environment in a partially-actuated state for the next
      # attempt to trip over. Purely additive: omitted, behavior is
      # byte-identical to before this option existed.
      bridge_timeout: Keyword.get(opts, :bridge_timeout, 10_000),
      # Continuous-session extension (additive, opt-in): a
      # `%BeamPM.Actuation.Session{}` supplied by a caller (today, only
      # `BeamPM.ProcessGovernor.run/2`'s `continuous: true` path) that owns
      # an already-open, already-reset bridge spanning several
      # `Actuation.run/2` calls. `nil` (the default, and every existing
      # caller's actual behavior) keeps the unmodified open/reset/step/close
      # `:execute` branch, byte-identical to before this option existed.
      session: Keyword.get(opts, :session)
    }
  end

  defp event(opts, ordinal, event_type, extra_attrs) do
    run_id = Map.fetch!(opts, :run_id)

    {:ok, ev} =
      OcelEvent.new(%{
        event_id: "#{run_id}-#{ordinal}-#{event_type}",
        event_type: event_type,
        event_time: DateTime.utc_now() |> DateTime.to_iso8601(),
        attributes: Map.merge(%{"case_id" => run_id}, extra_attrs)
      })

    ev
  end

  defp receipt_path(opts) do
    Path.join(Map.fetch!(opts, :receipts_dir), Map.fetch!(opts, :run_id) <> ".json")
  end

  defp write_receipt!(opts, fields) do
    receipt =
      %{
        "receipt_schema" => @receipt_schema,
        "action" => Map.fetch!(fields, :action_map),
        "admission" => %{
          "admitted" => Map.fetch!(fields, :admitted),
          "policy_decision" => Codec.to_map(Map.fetch!(fields, :policy_decision)),
          "reason" => Map.fetch!(fields, :reason)
        },
        "execution" => Map.fetch!(fields, :execution),
        "events" => Enum.map(Map.fetch!(fields, :events), &Codec.to_map/1),
        "replay" => %{
          "gym" => Map.fetch!(opts, :gym),
          "bridge_cmd" =>
            "python3 #{Map.fetch!(opts, :bridge)} --gym #{Map.fetch!(opts, :gym)}",
          "action_json" => Map.fetch!(fields, :action_json)
        }
      }
      |> put_chain_fields(opts)

    path = receipt_path(opts)
    File.mkdir_p!(Path.dirname(path))
    File.write!(path, JSON.encode!(receipt))
    path
  end

  # EX2 hash-chained-receipt extension (additive, opt-in via
  # `actuation_opts[:chain_id]` -- see BeamPM.ReceiptChain's moduledoc for
  # the full ex4pm-adapted design). No `:chain_id` -> today's exact
  # beam4pm-brce/v1 shape, zero new keys, zero behavior change.
  defp put_chain_fields(receipt, opts) do
    case Map.get(opts, :chain_id) do
      nil ->
        receipt

      chain_id when is_binary(chain_id) ->
        %{chain_seq: seq, prev_receipt_path: prev_path, prev_receipt_hash: prev_hash} =
          ReceiptChain.link_fields(Map.fetch!(opts, :receipts_dir), chain_id)

        receipt
        |> Map.put("chain_id", chain_id)
        |> Map.put("chain_seq", seq)
        |> Map.put("prev_receipt_path", prev_path)
        |> Map.put("prev_receipt_hash", prev_hash)
    end
  end

  # Guarantees a refusal receipt exists after a failed run. The execute
  # step's compensate/2 already wrote the failure receipt on the
  # execution-failed path (checked via File.exists?), so this only writes
  # for refusals (validate/admit), where no receipt exists yet.
  defp ensure_failure_receipt!(action_input, opts, reason) do
    path = receipt_path(opts)

    if File.exists?(path) do
      path
    else
      action_map =
        case PlanningAction.new(action_input) do
          {:ok, action} -> Codec.to_map(action)
          {:error, _} -> Map.new(action_input, fn {k, v} -> {to_string(k), v} end)
        end

      reason_text = failure_reason_text(reason)

      {:ok, decision} =
        PolicyDecision.new(%{
          decision_id: "pd-" <> Map.fetch!(opts, :run_id),
          verdict: :refused,
          reason: reason_text
        })

      events = [
        event(opts, 1, "plan", %{}),
        event(opts, 2, "admit", %{"verdict" => "refused", "reason" => reason_text})
      ]

      write_receipt!(opts, %{
        action_map: action_map,
        admitted: false,
        policy_decision: decision,
        reason: reason_text,
        execution: %{
          "performed" => false,
          "observation_before" => nil,
          "observation_after" => nil,
          "reward" => nil,
          "done" => nil
        },
        events: events,
        action_json: ""
      })
    end
  end

  # Pulls the FIRST typed leaf reason ({:refused, _} or {:execution_failed,
  # _}) back out of Reactor's nested Splode error class
  # (%Reactor.Error.Invalid{errors: [%{step: ..., error: reason}, ...]}) -
  # same real shape GgenIgniter.Reactors.ReconcileReactor.failed_step_info/1
  # relies on, matched structurally rather than by struct name.
  defp principal_reason(error) do
    case find_tagged_reason(error) do
      {:ok, reason} -> reason
      :error -> {:actuation_failed, error}
    end
  end

  defp find_tagged_reason(%{errors: errors}) when is_list(errors) do
    Enum.reduce_while(errors, :error, fn e, :error ->
      case find_tagged_reason(e) do
        {:ok, _} = found -> {:halt, found}
        :error -> {:cont, :error}
      end
    end)
  end

  defp find_tagged_reason(%{error: {:refused, _} = tagged}), do: {:ok, tagged}
  defp find_tagged_reason(%{error: {:execution_failed, _} = tagged}), do: {:ok, tagged}
  defp find_tagged_reason(%{error: nested}), do: find_tagged_reason(nested)
  defp find_tagged_reason(_other), do: :error

  defp failure_reason_text({:refused, {:invalid_action, inner}}),
    do: "invalid planning_action: #{inspect(inner)}"

  defp failure_reason_text({:refused, reason}) when is_binary(reason), do: reason
  defp failure_reason_text({:refused, reason}), do: inspect(reason)

  defp failure_reason_text({:execution_failed, inner}),
    do: "execution failed: #{inspect(inner)}"

  defp failure_reason_text(other), do: inspect(other)
end
