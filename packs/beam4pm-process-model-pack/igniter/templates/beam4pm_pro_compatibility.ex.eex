<%
# ggen_igniter EEx template -> lib/beam4pm_pro_compatibility.ex
#
# beam4pm_pro gap-closure item PRO-003 ("compatibility manifest"): a version
# matrix binding OSS beam4pm, the ggen_igniter engine, and the
# beam4pm-process-model-pack -- refused before mutation with a typed
# diagnostic naming the exact incompatible dimension. Uses Elixir's real
# Version.match?/2 (semver), never hand-rolled parsing.
#
# Bindings: `admitted` (from --query admitted=admitted_actions.rq), the real
# bpma:AdmittedActuation graph -- gives admitted_actuations/0 its real,
# ontology-bound action-name list (B4PM-1706), never hand-maintained. The
# semver matrix itself stays hand-seeded from this repo's own mix.exs,
# mix.lock, and pack.toml at authoring time (not invented): beam4pm 0.1.0,
# ggen_igniter 26.8.30 (mix.lock), beam4pm-process-model-pack 0.1.1
# (pack.toml) -- no ontology graph backs semver bounds, so this part
# legitimately stays static.
norm = fn
  nil -> nil
  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") -> String.slice(v, 1..-2//1)
      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end
      true -> v
    end
  v -> to_string(v)
end

action_names =
  admitted
  |> Enum.map(fn a -> norm.(a["action_name"]) end)
  |> Enum.uniq()
  |> Enum.sort()

actuations_literal = "[" <> Enum.map_join(action_names, ", ", &inspect/1) <> "]"
%># GENERATED by ggen_igniter from the beam4pm_pro_compatibility template. Do not edit.
defmodule BeamPM.Pro.Compatibility do
  @moduledoc """
  Version compatibility matrix for `beam4pm_pro` gap-closure item PRO-003.
  Binds every component this product depends on to a real semver
  requirement string, and refuses an incompatible pairing BEFORE any
  mutation with a typed diagnostic naming the exact component and bound
  violated -- using Elixir's own `Version.match?/2`, never hand-rolled
  version parsing.
  """

  @type component :: atom()
  @type check_result :: {:ok, :compatible} | {:error, {:incompatible, component(), String.t()}}

  # Real semver requirement strings -- each bound uses `Version` requirement
  # syntax (e.g. ">= 0.1.0 and < 1.0.0"), checked via Version.match?/2.
  @matrix %{
    beam4pm: ">= 0.1.0 and < 1.0.0",
    ggen_igniter: ">= 26.8.0 and < 27.0.0",
    beam4pm_process_model_pack: ">= 0.1.0 and < 1.0.0"
  }

  @doc "The full compatibility matrix: component -> real Version requirement string."
  @spec matrix() :: %{component() => String.t()}
  def matrix, do: @matrix

  # Real bpma:AdmittedActuation action names bound from admitted_actions.rq
  # at manufacturing time -- the actual BRCE actuation surface this
  # compatibility manifest is claiming compatibility FOR, never a
  # hand-maintained list.
  @admitted_actuations <%= actuations_literal %>

  @doc """
  The admitted BRCE actuation action names (from `BeamPM.Actuation`'s
  ontology-bound allowlist) that this compatibility matrix's bounds were
  authored against -- ontology-bound, sorted, and re-derived on every
  regeneration rather than hand-maintained.
  """
  @spec admitted_actuations() :: [String.t()]
  def admitted_actuations, do: @admitted_actuations

  @doc """
  Check one `{component => version_string}` map against the matrix. Returns
  `{:ok, :compatible}` only when every component present in `versions` is
  both known to the matrix and satisfies its bound; the FIRST violation
  found is returned (checked in a deterministic, sorted component order),
  never a silent partial pass.
  """
  @spec check(%{component() => String.t()}) :: check_result()
  def check(versions) when is_map(versions) do
    versions
    |> Map.keys()
    |> Enum.sort()
    |> Enum.reduce_while({:ok, :compatible}, fn component, _acc ->
      case check_one(component, Map.fetch!(versions, component)) do
        {:ok, :compatible} -> {:cont, {:ok, :compatible}}
        error -> {:halt, error}
      end
    end)
  end

  defp check_one(component, version_string) do
    case Map.fetch(@matrix, component) do
      :error ->
        {:error, {:incompatible, component, "unknown component (not in the compatibility matrix)"}}

      {:ok, requirement} ->
        case Version.parse(version_string) do
          :error ->
            {:error, {:incompatible, component, "unparseable version string: #{inspect(version_string)}"}}

          {:ok, parsed} ->
            if Version.match?(parsed, requirement) do
              {:ok, :compatible}
            else
              {:error,
               {:incompatible, component,
                "#{version_string} does not satisfy requirement #{inspect(requirement)}"}}
            end
        end
    end
  end
end
