<%
# ggen_igniter EEx template -> test/beam4pm_revenue_economics_test.exs
#
# Chicago qualification of the beam4pm-pro-revenue-suite economics family.
# No bindings required (see beam4pm_revenue_economics.ex.eex's header) --
# every collaborator is real: the committed BPI-2020 stratified fixtures
# (sha256-asserted in-test BEFORE parsing), the real BeamPM.Revenue.Xes
# :xmerl parser, the real BeamPM.Discovery / BeamPM.Precision algorithms,
# and the real BeamPM.Types validating constructors. Zero mocks, zero
# stubs, state-based assertions only.
#
# PINNED CONSTANTS -- derivation record (authored once, 2026-08-30):
# derived from the committed fixtures by an independent single-pass Python
# mirror (xml.etree + datetime) replicating the implementation semantics
# exactly -- timestamps normalized to UTC ".mmmZ" milliseconds; per-case
# event order (event_time, event_id); loop rule "a ' REJECTED by '
# activity with a later 'SUBMITTED'-bearing activity"; cycle-to-cash =
# first 'SUBMITTED'-bearing event -> last 'Payment Handled' event;
# durations = integer_milliseconds / 1000 (IEEE double); float totals
# folded in ascending sorted order from 0.0 -- then cross-checked
# bit-identical by a standalone :xmerl Elixir probe before being pinned.
%># GENERATED by ggen_igniter from the revenue-economics static template. Do not edit.
defmodule BeamPM.Revenue.EconomicsTest do
  @moduledoc """
  Chicago-style qualification of `BeamPM.Revenue.Xes` and
  `BeamPM.Revenue.Economics` against the committed, sha256-pinned BPI-2020
  stratified fixtures (`qualification/fixtures/bpi2020/*.xes` -- real
  money-process traces: declarations, approvals, rejections, payments).

  All money figures asserted here are anonymization-RESCALED BPI-2020
  units, never EUR. All strata facts (paid_clean/rework_paid/rejected_only/
  no_payment, quotas 20/15/10/5) are RE-DERIVED in-test from the parsed
  activity sequences, not trusted from the extraction script.
  """

  use ExUnit.Case, async: false

  alias BeamPM.Discovery
  alias BeamPM.Revenue.Economics
  alias BeamPM.Revenue.Xes
  alias BeamPM.Types.CaseStats
  alias BeamPM.Types.LogTrace
  alias BeamPM.Types.OcelEvent
  alias BeamPM.Types.SojournTime

  @international_xes Path.expand("qualification/fixtures/bpi2020/international_50.xes")
  @international_sha256 "e0733f79a524d72437020c6877f1321d8abaca220d21a40f7ca8ee217520c88e"

  @domestic_xes Path.expand("qualification/fixtures/bpi2020/domestic_50.xes")
  @domestic_sha256 "0f134ff3632281b2f93836fb7c45c3cea3dbdae8f93b6d2bb80e626406edfd2c"

  # sha256 asserted BEFORE parsing: the pinned constants below are facts
  # about exactly these bytes, so a drifted fixture must fail here, not as
  # a confusing constant mismatch further down.
  defp parse!(path, expected_sha256) do
    assert File.exists?(path), "committed fixture missing at #{path}"

    actual_sha256 = Base.encode16(:crypto.hash(:sha256, File.read!(path)), case: :lower)

    assert actual_sha256 == expected_sha256,
           "fixture #{path} drifted: sha256 #{actual_sha256}, pinned #{expected_sha256}"

    assert {:ok, parsed} = Xes.parse_file(path)
    parsed
  end

  # In-test stratum re-derivation (same classification the extraction
  # script used: Payment Handled presence x REJECTED presence).
  defp strata(traces) do
    groups =
      Enum.group_by(traces, fn %LogTrace{} = trace ->
        has_payment = Enum.any?(trace.activity_sequence, &(&1 == "Payment Handled"))
        has_rejected = Enum.any?(trace.activity_sequence, &String.contains?(&1, "REJECTED"))

        cond do
          has_payment and not has_rejected -> :paid_clean
          has_payment and has_rejected -> :rework_paid
          has_rejected -> :rejected_only
          true -> :no_payment
        end
      end)

    Map.merge(%{paid_clean: [], rework_paid: [], rejected_only: [], no_payment: []}, groups)
  end

  defp case_ids(traces), do: traces |> Enum.map(& &1.case_id) |> Enum.sort()

  test "Xes.parse_file: sha-pinned international fixture -> 497 OcelEvents, 50 traces, " <>
         "string \"case\" wiring into Discovery, UTC normalization of real +02:00 stamps" do
    %{events: events, trace_attrs: trace_attrs} = parse!(@international_xes, @international_sha256)

    assert length(events) == 497
    assert Enum.all?(events, &match?(%OcelEvent{}, &1))
    assert Enum.all?(events, &is_binary(&1.attributes["case"]))

    traces = Discovery.traces_from_events(events, "case")
    assert length(traces) == 50
    assert map_size(trace_attrs) == 50
    assert Enum.sort(Map.keys(trace_attrs)) == case_ids(traces)

    # Stratification conservation, re-derived from parsed data: the M5
    # extraction quotas were paid_clean/rework_paid/rejected_only/
    # no_payment = 20/15/10/5.
    by_stratum = strata(traces)
    assert length(by_stratum.paid_clean) == 20
    assert length(by_stratum.rework_paid) == 15
    assert length(by_stratum.rejected_only) == 10
    assert length(by_stratum.no_payment) == 5

    # Trace-level rescaled amount survives parsing (fixture value, verbatim).
    assert trace_attrs["declaration 76457"]["Amount"] == 39.66456144659199

    # Real DST-offset normalization: this event is stored in the fixture as
    # 2016-10-05T00:00:00.000+02:00 and must come back UTC at fixed
    # millisecond precision (lexicographic order == chronological order).
    start_trip = Enum.find(events, &(&1.event_id == "rv_travel permit 76455_6"))
    assert start_trip.event_type == "Start trip"
    assert start_trip.event_time == "2016-10-04T22:00:00.000Z"
  end

  test "rework_cost: paid_clean never flagged, every rework_paid case flagged, pinned " <>
         "rescaled total, full-pipeline determinism across two parses" do
    %{events: events, trace_attrs: trace_attrs} = parse!(@international_xes, @international_sha256)
    traces = Discovery.traces_from_events(events, "case")
    by_stratum = strata(traces)

    assert %{per_case: per_case, loop_case_ids: loop_ids, total_weighted_cost: total} =
             Economics.rework_cost(traces, trace_attrs)

    assert length(per_case) == 16
    assert loop_ids == Enum.map(per_case, & &1.case_id)
    assert loop_ids == Enum.sort(loop_ids)
    assert Enum.all?(per_case, &match?(%{case_id: _, loop_count: _, weighted_cost: _}, &1))

    # Every rework_paid case (REJECTED + paid) is loop-bearing; no
    # paid_clean case ever is (its stratum has zero REJECTED events).
    rework_paid_ids = case_ids(by_stratum.rework_paid)
    assert rework_paid_ids -- loop_ids == []
    assert Enum.filter(case_ids(by_stratum.paid_clean), &(&1 in loop_ids)) == []

    # The single non-rework_paid loop case is a rejected-then-resubmitted
    # declaration that never reached payment -- and its rescaled Amount is
    # 0.0 in the real data (never-approved declarations carry zero approved
    # amount), so it weighs nothing while still counting as rework.
    assert loop_ids -- rework_paid_ids == ["declaration 84753"]
    assert "declaration 84753" in case_ids(by_stratum.rejected_only)

    assert %{case_id: "declaration 84753", loop_count: 2, weighted_cost: 0.0} in per_case

    # First row in ascending case_id order (pinned from the fixture bytes).
    assert hd(per_case) == %{
             case_id: "declaration 143502",
             loop_count: 2,
             weighted_cost: 393.48237017561524
           }

    # Pinned ascending-canonical-summation total (rescaled units, not EUR).
    assert total == 10469.904256967046

    # Full-pipeline determinism: a second parse + recompute is
    # term-identical (floats compared exactly, no epsilon).
    %{events: events2, trace_attrs: trace_attrs2} =
      parse!(@international_xes, @international_sha256)

    traces2 = Discovery.traces_from_events(events2, "case")

    assert Economics.rework_cost(traces2, trace_attrs2) ==
             %{per_case: per_case, loop_case_ids: loop_ids, total_weighted_cost: total}
  end

  test "rework_cost NegativeRefusal: a loop-bearing case with no amount attribute is a " <>
         "typed refusal, never a silent 0.0" do
    {:ok, trace} =
      LogTrace.new(%{
        case_id: "synthetic 1",
        activity_sequence: [
          "Declaration SUBMITTED by EMPLOYEE",
          "Declaration REJECTED by ADMINISTRATION",
          "Declaration REJECTED by EMPLOYEE",
          "Declaration SUBMITTED by EMPLOYEE"
        ]
      })

    assert Economics.rework_cost([trace], %{}) == {:error, {:missing_amount, "synthetic 1"}}

    # Same trace WITH an amount is admitted, and both post-rejection
    # markers count under the disclosed loop rule.
    assert %{
             per_case: [%{case_id: "synthetic 1", loop_count: 2, weighted_cost: 12.5}],
             loop_case_ids: ["synthetic 1"],
             total_weighted_cost: 12.5
           } = Economics.rework_cost([trace], %{"synthetic 1" => %{"Amount" => 12.5}})
  end

  test "cycle_to_cash: conservation over all 50 cases, open obligations are exactly the " <>
         "cases with no Payment Handled event, pinned durations, first CaseStats/SojournTime " <>
         "producers" do
    %{events: events, trace_attrs: _} = parse!(@international_xes, @international_sha256)
    traces = Discovery.traces_from_events(events, "case")

    assert %{
             case_stats: case_stats,
             sojourns: sojourns,
             cycle_to_cash: cycle_to_cash,
             open_obligations: open_obligations
           } = result = Economics.cycle_to_cash(traces, events)

    # Conservation: every case lands in exactly one bucket.
    assert map_size(cycle_to_cash) + length(open_obligations) == 50
    assert map_size(cycle_to_cash) == 35
    assert length(open_obligations) == 15

    # The open set is exactly the cases with no "Payment Handled" event --
    # re-derived here independently. NOTE: by the extraction strata this is
    # rejected_only (10) UNION no_payment (5) = 15 cases; the no_payment
    # stratum alone (5) is a strict subset, since rejected_only cases also
    # never reached payment.
    expected_open =
      traces
      |> Enum.reject(fn %LogTrace{} = trace ->
        Enum.any?(trace.activity_sequence, &(&1 == "Payment Handled"))
      end)
      |> case_ids()

    assert open_obligations == expected_open

    by_stratum = strata(traces)
    assert case_ids(by_stratum.no_payment) -- open_obligations == []
    assert Enum.sort(case_ids(by_stratum.rejected_only) ++ case_ids(by_stratum.no_payment)) ==
             open_obligations

    # Pinned cycle-to-cash durations (whole seconds -- fixture stamps carry
    # .000 ms), derived once from the raw XML (see header derivation
    # record): first-SUBMITTED-bearing event -> last Payment Handled.
    assert cycle_to_cash["declaration 73564"] == 7_356_897.0
    assert cycle_to_cash["declaration 143502"] == 519_339.0

    # First real CaseStats producer: 50 rows, all through the validating
    # constructor. The pinned duration spans Start trip (2016) -> payment
    # (2017), which is why it dwarfs the case's cycle-to-cash.
    assert length(case_stats) == 50
    assert Enum.all?(case_stats, &match?(%CaseStats{}, &1))

    pinned_stats = Enum.find(case_stats, &(&1.case_id == "declaration 73564"))
    assert pinned_stats.event_count == 10
    assert pinned_stats.duration_seconds == 31_449_600.0

    # First real SojournTime producer: one dwell per non-final event,
    # 497 events - 50 cases = 447 rows.
    assert length(sojourns) == 447
    assert Enum.all?(sojourns, &match?(%SojournTime{}, &1))
    assert Enum.all?(sojourns, &(is_float(&1.seconds) and &1.seconds >= 0.0))

    # Determinism: recomputation is term-identical.
    assert Economics.cycle_to_cash(traces, events) == result
  end

  test "cycle_to_cash NegativeRefusal: non-ISO8601 and semantically impossible event times " <>
         "are typed refusals naming the offending event" do
    {:ok, trace} =
      LogTrace.new(%{
        case_id: "synthetic 1",
        activity_sequence: ["Declaration SUBMITTED by EMPLOYEE", "Payment Handled"]
      })

    {:ok, good} =
      OcelEvent.new(%{
        event_id: "evt-good",
        event_type: "Declaration SUBMITTED by EMPLOYEE",
        event_time: "2020-01-06T09:00:00.000Z",
        attributes: %{"case" => "synthetic 1"}
      })

    # Shape failure: offset-form timestamp (the entitlement-pack regex
    # admits only normalized Z-suffixed UTC).
    {:ok, bad_shape} =
      OcelEvent.new(%{
        event_id: "evt-bad-shape",
        event_type: "Payment Handled",
        event_time: "2020-01-06 09:00:00+01:00",
        attributes: %{"case" => "synthetic 1"}
      })

    assert Economics.cycle_to_cash([trace], [good, bad_shape]) ==
             {:error, {:malformed_event_time, "evt-bad-shape"}}

    # Semantic failure: regex-passing but impossible calendar date.
    {:ok, bad_semantics} =
      OcelEvent.new(%{
        event_id: "evt-bad-month",
        event_type: "Payment Handled",
        event_time: "2020-13-40T09:00:00.000Z",
        attributes: %{"case" => "synthetic 1"}
      })

    assert Economics.cycle_to_cash([trace], [good, bad_semantics]) ==
             {:error, {:malformed_event_time, "evt-bad-month"}}
  end

  test "cycle_to_cash cross-log sanity: sha-pinned domestic fixture, independent 50-case " <>
         "log, same conservation shape" do
    %{events: events, trace_attrs: _} = parse!(@domestic_xes, @domestic_sha256)

    assert length(events) == 244

    traces = Discovery.traces_from_events(events, "case")
    assert length(traces) == 50

    by_stratum = strata(traces)
    assert length(by_stratum.paid_clean) == 20
    assert length(by_stratum.rework_paid) == 15
    assert length(by_stratum.rejected_only) == 10
    assert length(by_stratum.no_payment) == 5

    assert %{
             case_stats: case_stats,
             sojourns: sojourns,
             cycle_to_cash: cycle_to_cash,
             open_obligations: open_obligations
           } = Economics.cycle_to_cash(traces, events)

    assert map_size(cycle_to_cash) == 35
    assert length(open_obligations) == 15
    assert length(case_stats) == 50
    assert length(sojourns) == 244 - 50

    # Pinned domestic case: its FIRST event is the submission and its LAST
    # is the payment, so cycle-to-cash equals the full case duration -- a
    # structural cross-check between the two independent computations.
    assert cycle_to_cash["declaration 86716"] == 613_329.0

    pinned_stats = Enum.find(case_stats, &(&1.case_id == "declaration 86716"))
    assert pinned_stats.event_count == 4
    assert pinned_stats.duration_seconds == 613_329.0
  end

  test "conformance_leakage: paid_clean DFG model flags every deviating case incl. all " <>
         "rework_paid, pinned first finding and rescaled amount-at-risk total, replay, " <>
         "empty-model refusal" do
    %{events: events, trace_attrs: trace_attrs} = parse!(@international_xes, @international_sha256)
    traces = Discovery.traces_from_events(events, "case")
    by_stratum = strata(traces)

    # Model mined from the 20 paid_clean traces with the EXISTING generated
    # miner (real collaborator, no re-derivation here).
    model_edges = Discovery.dfg_from_traces(by_stratum.paid_clean)
    assert length(model_edges) == 18

    scored = by_stratum.rework_paid ++ by_stratum.rejected_only ++ by_stratum.no_payment
    assert length(scored) == 30

    assert %{
             findings: findings,
             flagged_case_ids: flagged_case_ids,
             total_amount_at_risk: total_amount_at_risk,
             unweighted_findings: unweighted_findings
           } = result = Economics.conformance_leakage(model_edges, scored, trace_attrs)

    # On this fixture every non-paid_clean case deviates from the clean
    # model (REJECTED edges, reminder edges, or missing payment terminus).
    assert length(findings) == 30
    assert flagged_case_ids == case_ids(scored)
    assert case_ids(by_stratum.rework_paid) -- flagged_case_ids == []
    assert unweighted_findings == 0

    # Pinned first finding (ascending case_id order): DFG adjacent-pair
    # fitness 5/9 and ETC escaping-edge precision at alpha 0.0 -- NOT
    # alignment-based conformance (see the module's vocabulary disclosure).
    assert hd(findings) == %{
             case_id: "declaration 143502",
             fitness: 0.5555555555555556,
             precision: 0.41666666666666663,
             amount_at_risk: 393.48237017561524
           }

    # Pinned rescaled total. It numerically equals rework_cost's pinned
    # total on this fixture BY DERIVATION, not by copy-paste: every
    # rejected_only/no_payment case in the real data carries Amount 0.0
    # (never-approved declarations have zero approved amount), so both
    # ascending sums reduce to the same 15 nonzero rework_paid amounts.
    assert total_amount_at_risk == 10469.904256967046

    # Model-member scoring: the model's own first trace fits perfectly and
    # has an in-range pinned ETC precision -- and is NOT flagged.
    member = by_stratum.paid_clean |> Enum.sort_by(& &1.case_id) |> hd()
    assert member.case_id == "declaration 73564"

    member_result = Discovery.conformance(model_edges, member)
    assert member_result.fitness == 1.0
    assert member_result.precision == 0.6428571428571428
    assert member_result.precision > 0.0 and member_result.precision <= 1.0

    member_leakage = Economics.conformance_leakage(model_edges, [member], trace_attrs)
    assert member_leakage.findings == []
    assert member_leakage.flagged_case_ids == []
    assert member_leakage.total_amount_at_risk == 0.0

    # ReceiptReplay: recomputing from (model_edges, flagged case ids) alone
    # reproduces the findings and the total exactly.
    flagged_set = MapSet.new(flagged_case_ids)
    flagged_traces = Enum.filter(scored, &MapSet.member?(flagged_set, &1.case_id))
    replay = Economics.conformance_leakage(model_edges, flagged_traces, trace_attrs)
    assert replay.findings == findings
    assert replay.total_amount_at_risk == total_amount_at_risk
    assert replay == result

    # An empty model would spuriously flag everything -- typed refusal.
    assert Economics.conformance_leakage([], scored, trace_attrs) == {:error, :empty_model}
  end

  test "conformance_leakage: a finding without any amount attribute is kept, unweighted, " <>
         "and excluded from the total" do
    %{events: events, trace_attrs: trace_attrs} = parse!(@international_xes, @international_sha256)
    traces = Discovery.traces_from_events(events, "case")
    by_stratum = strata(traces)
    model_edges = Discovery.dfg_from_traces(by_stratum.paid_clean)

    {:ok, synthetic} =
      LogTrace.new(%{
        case_id: "synthetic leak",
        activity_sequence: [
          "Declaration SUBMITTED by EMPLOYEE",
          "Declaration TELEPORTED by NOBODY"
        ]
      })

    result = Economics.conformance_leakage(model_edges, [synthetic], trace_attrs)

    assert [
             %{case_id: "synthetic leak", fitness: fitness, precision: precision, amount_at_risk: nil}
           ] = result.findings

    assert fitness == 0.0
    assert is_float(precision)
    assert result.flagged_case_ids == ["synthetic leak"]
    assert result.total_amount_at_risk == 0.0
    assert result.unweighted_findings == 1
  end

  # -- Multi-tenant activity vocabulary (runtime argument, not a fixed
  # -- module attribute) -- see BeamPM.Revenue.Economics's "Activity
  # -- vocabulary" moduledoc section.

  test "default_vocabulary/0 is exactly the BPI-2020 markers rework_cost/2 and " <>
         "cycle_to_cash/2 use when no third argument is given" do
    assert Economics.default_vocabulary() == %{
             rejected_marker: " REJECTED by ",
             submitted_marker: "SUBMITTED",
             payment_activity: "Payment Handled"
           }
  end

  test "rework_cost/cycle_to_cash: a second tenant's own vocabulary scores its " <>
         "differently-worded process correctly on the SAME compiled node, while the " <>
         "BPI-2020 default silently misclassifies it" do
    # Tenant #2: a support-ticket process, not BPI-2020's declaration
    # grammar -- "FILED" (submission), "REOPENED" (rework), "Ticket Closed"
    # (cash terminus). None of these contain the BPI-2020 markers.
    tenant2_vocabulary = %{
      rejected_marker: "REOPENED",
      submitted_marker: "FILED",
      payment_activity: "Ticket Closed"
    }

    {:ok, reworked_trace} =
      LogTrace.new(%{
        case_id: "ticket-1",
        activity_sequence: [
          "Ticket FILED by CUSTOMER",
          "Ticket REOPENED by AGENT",
          "Ticket FILED by CUSTOMER",
          "Ticket Closed"
        ]
      })

    {:ok, clean_trace} =
      LogTrace.new(%{
        case_id: "ticket-2",
        activity_sequence: ["Ticket FILED by CUSTOMER", "Ticket Closed"]
      })

    traces = [reworked_trace, clean_trace]
    trace_attrs = %{"ticket-1" => %{"Amount" => 50.0}, "ticket-2" => %{"Amount" => 20.0}}

    # Correct, with tenant #2's own vocabulary: exactly the reworked ticket
    # is flagged, weighted by its own Amount.
    assert Economics.rework_cost(traces, trace_attrs, tenant2_vocabulary) == %{
             per_case: [%{case_id: "ticket-1", loop_count: 1, weighted_cost: 50.0}],
             loop_case_ids: ["ticket-1"],
             total_weighted_cost: 50.0
           }

    # Wrong, under the BPI-2020 default (rework_cost/2): neither activity
    # contains " REJECTED by " or "SUBMITTED", so the real rework case is
    # silently invisible -- zero rows, not an error. This is the pre-fix
    # failure mode for any tenant whose vocabulary differs from BPI-2020's,
    # reproduced here rather than merely asserted.
    assert Economics.rework_cost(traces, trace_attrs) == %{
             per_case: [],
             loop_case_ids: [],
             total_weighted_cost: 0.0
           }

    events = [
      ticket_event("evt-1a", "ticket-1", "Ticket FILED by CUSTOMER", "2026-01-01T00:00:00.000Z"),
      ticket_event("evt-1b", "ticket-1", "Ticket REOPENED by AGENT", "2026-01-02T00:00:00.000Z"),
      ticket_event("evt-1c", "ticket-1", "Ticket FILED by CUSTOMER", "2026-01-03T00:00:00.000Z"),
      ticket_event("evt-1d", "ticket-1", "Ticket Closed", "2026-01-05T00:00:00.000Z"),
      ticket_event("evt-2a", "ticket-2", "Ticket FILED by CUSTOMER", "2026-02-01T00:00:00.000Z"),
      ticket_event("evt-2b", "ticket-2", "Ticket Closed", "2026-02-02T00:00:00.000Z")
    ]

    # Correct, with tenant #2's own vocabulary: both cases reach their cash
    # terminus (first FILED -> last Ticket Closed), conservation holds, and
    # the first real CaseStats/SojournTime producers still fire per case
    # regardless of which vocabulary scored the cash-cycle endpoints.
    assert %{
             case_stats: case_stats,
             sojourns: sojourns,
             cycle_to_cash: cycle_to_cash,
             open_obligations: []
           } = Economics.cycle_to_cash(traces, events, tenant2_vocabulary)

    assert map_size(cycle_to_cash) == 2
    assert cycle_to_cash["ticket-1"] == 345_600.0
    assert cycle_to_cash["ticket-2"] == 86_400.0
    assert length(case_stats) == 2
    assert length(sojourns) == 4

    # Wrong, under the BPI-2020 default (cycle_to_cash/2): neither case has
    # a "SUBMITTED"-bearing event, so BOTH land in open_obligations with no
    # fabricated duration -- silently wrong for tenant #2, never a crash.
    assert Economics.cycle_to_cash(traces, events) == %{
             case_stats: case_stats,
             sojourns: sojourns,
             cycle_to_cash: %{},
             open_obligations: ["ticket-1", "ticket-2"]
           }
  end

  test "rework_cost/cycle_to_cash NegativeRefusal: a malformed vocabulary is a typed " <>
         "refusal, never a crash or a silent zero-match" do
    assert Economics.rework_cost([], %{}, %{rejected_marker: "x"}) ==
             {:error, {:invalid_vocabulary, %{rejected_marker: "x"}}}

    bad_vocabulary = %{rejected_marker: "x", submitted_marker: "y", payment_activity: 123}

    assert Economics.rework_cost([], %{}, bad_vocabulary) ==
             {:error, {:invalid_vocabulary, bad_vocabulary}}

    assert Economics.cycle_to_cash([], [], bad_vocabulary) ==
             {:error, {:invalid_vocabulary, bad_vocabulary}}
  end

  defp ticket_event(event_id, case_id, event_type, event_time) do
    {:ok, event} =
      OcelEvent.new(%{
        event_id: event_id,
        event_type: event_type,
        event_time: event_time,
        attributes: %{"case" => case_id}
      })

    event
  end
end
