# data passed in by the caller, not on ontology-time bindings).
%># GENERATED by ggen_igniter from the beam4pm_pro_ocpm_discovery static template. Do not edit.
defmodule BeamPM.Pro.OcpmDiscovery do
  @moduledoc """
  Object-centric process mining (OCPM) discovery primitives for
  `beam4pm_pro` gap-closure item PRO-011.

  Operates on lists of `ocel_event`/`ocel_object`-shaped maps (see
  `BeamPM.Types.new_ocel_event/1`, `BeamPM.Types.new_ocel_object/1`), NOT on
  a fixed ontology query -- OCPM discovery is a runtime-data operation, not
  a manifest-time one.

  Two real, bounded primitives:

    * `object_type_interactions/2` -- for each event, which distinct
      object types co-occur (an event referencing both an `order` and a
      `package` object is a real cross-object-type interaction, the
      structural signal every downstream OCPM algorithm -- object graphs,
      divergence detection -- is built from).
    * `object_type_activity_frequency/2` -- how often each object type
      participates in each activity (event type), the OCPM analogue of a
      single-case activity frequency table.

  This module does NOT implement object-centric Petri net synthesis,
  divergence-free log transformation, or multi-instance DFG construction --
  those remain real, named future work (see `gaps/0`), not silently
  omitted.
  """

  @type ocel_event :: %{required(:event_id) => String.t(), required(:event_type) => String.t()}
  @type ocel_object :: %{required(:object_id) => String.t(), required(:object_type) => String.t()}
  @type event_object_link :: {event_id :: String.t(), object_id :: String.t()}

  @doc """
  Count how many events involve each SET of co-occurring object types.

  `links` is a list of `{event_id, object_id}` pairs (the E2O relation
  OCEL 2.0 calls `object_id_list` per event). Returns a map from a sorted
  list of object-type names to the count of events exhibiting exactly that
  object-type combination.
  """
  @spec object_type_interactions([event_object_link()], [ocel_object()]) :: %{
          [String.t()] => non_neg_integer()
        }
  def object_type_interactions(links, objects) when is_list(links) and is_list(objects) do
    object_type_by_id = Map.new(objects, fn %{object_id: id, object_type: t} -> {id, t} end)

    links
    |> Enum.group_by(fn {event_id, _object_id} -> event_id end)
    |> Enum.map(fn {_event_id, event_links} ->
      event_links
      |> Enum.map(fn {_event_id, object_id} -> Map.get(object_type_by_id, object_id) end)
      |> Enum.reject(&is_nil/1)
      |> Enum.uniq()
      |> Enum.sort()
    end)
    |> Enum.reject(&(&1 == []))
    |> Enum.frequencies()
  end

  @doc """
  Per-object-type activity frequency: for each `{object_type, event_type}`
  pair, how many distinct events of that type touched at least one object
  of that type.
  """
  @spec object_type_activity_frequency([event_object_link()], [ocel_event()], [ocel_object()]) ::
          %{{String.t(), String.t()} => non_neg_integer()}
  def object_type_activity_frequency(links, events, objects)
      when is_list(links) and is_list(events) and is_list(objects) do
    object_type_by_id = Map.new(objects, fn %{object_id: id, object_type: t} -> {id, t} end)
    event_type_by_id = Map.new(events, fn %{event_id: id, event_type: t} -> {id, t} end)

    links
    |> Enum.map(fn {event_id, object_id} ->
      {Map.get(object_type_by_id, object_id), Map.get(event_type_by_id, event_id), event_id}
    end)
    |> Enum.reject(fn {ot, et, _} -> is_nil(ot) or is_nil(et) end)
    |> Enum.uniq_by(fn {ot, et, event_id} -> {ot, et, event_id} end)
    |> Enum.map(fn {ot, et, _event_id} -> {ot, et} end)
    |> Enum.frequencies()
  end

  @doc """
  Named, honest list of OCPM capabilities this module deliberately does
  NOT implement yet -- called out per the no-overclaiming discipline
  rather than left for a reader to discover by absence.
  """
  @spec gaps() :: [atom()]
  def gaps do
    [
      :object_centric_petri_net_synthesis,
      :divergence_free_log_transformation,
      :multi_instance_dfg,
      :convergence_detection
    ]
  end
end
