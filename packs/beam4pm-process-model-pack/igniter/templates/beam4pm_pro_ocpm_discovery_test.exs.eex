<%
# ggen_igniter EEx template -> test/beam4pm_pro_ocpm_discovery_test.exs
# Bindings: NONE required -- fully static.
%># GENERATED by ggen_igniter from the beam4pm_pro_ocpm_discovery static template. Do not edit.
defmodule BeamPM.Pro.OcpmDiscoveryTest do
  use ExUnit.Case, async: true

  alias BeamPM.Pro.OcpmDiscovery

  @objects [
    %{object_id: "o1", object_type: "order"},
    %{object_id: "o2", object_type: "package"},
    %{object_id: "o3", object_type: "order"}
  ]

  @events [
    %{event_id: "e1", event_type: "place_order"},
    %{event_id: "e2", event_type: "ship"}
  ]

  test "object_type_interactions/2 counts co-occurring object-type sets per event" do
    links = [{"e1", "o1"}, {"e2", "o1"}, {"e2", "o2"}]

    result = OcpmDiscovery.object_type_interactions(links, @objects)

    assert result == %{["order"] => 1, ["order", "package"] => 1}
  end

  test "object_type_interactions/2 dedupes object types within one event" do
    links = [{"e1", "o1"}, {"e1", "o3"}]

    result = OcpmDiscovery.object_type_interactions(links, @objects)

    assert result == %{["order"] => 1}
  end

  test "object_type_activity_frequency/3 counts per object-type/event-type pairs" do
    links = [{"e1", "o1"}, {"e2", "o1"}, {"e2", "o2"}]

    result = OcpmDiscovery.object_type_activity_frequency(links, @events, @objects)

    assert result == %{
             {"order", "place_order"} => 1,
             {"order", "ship"} => 1,
             {"package", "ship"} => 1
           }
  end

  test "unknown object ids are dropped from a per-event interaction set rather than crashing" do
    links = [{"e1", "unknown-object"}]

    assert OcpmDiscovery.object_type_interactions(links, @objects) == %{}
  end

  test "unknown object OR event ids are dropped from activity frequency rather than crashing" do
    links = [{"e1", "unknown-object"}, {"unknown-event", "o1"}]

    assert OcpmDiscovery.object_type_activity_frequency(links, @events, @objects) == %{}
  end

  test "a link naming a real object but an unrecognized event id still contributes to interactions -- interactions key only on object identity, not event validity" do
    links = [{"unknown-event", "o1"}]

    assert OcpmDiscovery.object_type_interactions(links, @objects) == %{["order"] => 1}
  end

  test "gaps/0 names real, not-yet-implemented OCPM capabilities" do
    gaps = OcpmDiscovery.gaps()

    assert :object_centric_petri_net_synthesis in gaps
    assert :divergence_free_log_transformation in gaps
    assert is_list(gaps)
    refute gaps == []
  end
end
