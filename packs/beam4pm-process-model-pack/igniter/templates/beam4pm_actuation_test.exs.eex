<%
# ggen_igniter EEx template -> generated/elixir/test/beam4pm_actuation_test.exs
#
# Bindings (same two queries as beam4pm_actuation.ex.eex):
#   admitted          - list of string-keyed maps: "action_name", "gym_op"
#   admitted_requires - list of string-keyed maps: "action_name", "fact"
#
# Chicago-style qualification: every collaborator is REAL - the real
# generated BeamPM.Actuation reactor, a real python3 gym bridge subprocess
# (qualification/fixtures/toy_gym_bridge.py - a deterministic fake
# ENVIRONMENT, not a mock of our code), real receipt files on disk, and the
# real BeamPM.Discovery miner run over the receipt's real OCEL events.
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

admitted_rows =
  admitted
  |> Enum.map(fn a -> %{name: norm.(a["action_name"]), gym_op: norm.(a["gym_op"])} end)
  |> Enum.sort_by(& &1.name)

requires_rows =
  Enum.map(admitted_requires, fn r -> %{name: norm.(r["action_name"]), fact: norm.(r["fact"])} end)

requires_for = fn name ->
  requires_rows |> Enum.filter(&(&1.name == name)) |> Enum.map(& &1.fact) |> Enum.sort()
end

# The observation-transition test drives the toy-counter fixture gym's `inc`
# op, so the admission graph MUST admit exactly one actuation released as
# gym op "inc" - fail the render loudly (not silently skip) on graph drift.
inc_row =
  case Enum.filter(admitted_rows, &(&1.gym_op == "inc")) do
    [row] -> row
    other -> raise "admission graph must admit exactly one gym op \"inc\" actuation, got: #{inspect(other)}"
  end

inc_requires = requires_for.(inc_row.name)

if inc_requires == [] do
  raise "admission graph must give #{inspect(inc_row.name)} at least one bpma:requiresFact " <>
          "(the missing-precondition refusal test depends on it)"
end

non_admitted_name = "not_an_admitted_action_name"

if Enum.any?(admitted_rows, &(&1.name == non_admitted_name)) do
  raise "admission graph unexpectedly admits #{inspect(non_admitted_name)}"
end

inc_name_lit = inspect(inc_row.name)
inc_requires_lit = "[" <> Enum.map_join(inc_requires, ", ", &inspect/1) <> "]"
allowlist_names_lit = "[" <> Enum.map_join(admitted_rows, ", ", &inspect(&1.name)) <> "]"
%># GENERATED by ggen_igniter from the admitted bpma:AdmittedActuation graph. Do not edit.
defmodule BeamPM.ActuationTest do
  @moduledoc """
  Chicago-style qualification of the BRCE actuation pipeline
  (`BeamPM.Actuation`, gates PI7/PI8): real Reactor runs, a real python3 gym
  bridge subprocess (`qualification/fixtures/toy_gym_bridge.py` - a
  deterministic fake ENVIRONMENT speaking the fixed wire protocol, not a
  mock of our own code), real `beam4pm-brce/v1` receipt files on disk, and
  the real `BeamPM.Discovery` miner run over each receipt's OCEL events.
  """

  use ExUnit.Case, async: false

  alias BeamPM.Actuation
  alias BeamPM.Codec
  alias BeamPM.Discovery
  alias BeamPM.Types.DfgEdge
  alias BeamPM.Types.LogTrace
  alias BeamPM.Types.OcelEvent

  @moduletag :tmp_dir

  # Graph-derived qualification data (rendered by ggen_igniter):
  @inc_action <%= inc_name_lit %>
  @inc_requires <%= inc_requires_lit %>
  @allowlist_names <%= allowlist_names_lit %>

  defp bridge_path do
    path = Path.expand("qualification/fixtures/toy_gym_bridge.py")

    unless File.exists?(path) do
      raise "fixture gym bridge not found at #{path} - run mix test from the project root"
    end

    path
  end

  defp run_opts(tmp_dir, run_id, gym) do
    [gym: gym, bridge: bridge_path(), receipts_dir: tmp_dir, run_id: run_id]
  end

  defp read_receipt!(tmp_dir, run_id) do
    path = Path.join(tmp_dir, run_id <> ".json")
    assert File.exists?(path), "expected consequence receipt at #{path}"
    path |> File.read!() |> JSON.decode!()
  end

  defp mined_events!(receipt, run_id) do
    events =
      Enum.map(receipt["events"], fn m ->
        {:ok, %OcelEvent{} = ev} = Codec.from_map(:ocel_event, m)
        ev
      end)

    assert Enum.all?(events, fn %OcelEvent{} = ev ->
             is_map(ev.attributes) and ev.attributes["case_id"] == run_id
           end),
           "every OCEL event must carry the actuation run id as case_id"

    events
  end

  defp dfg_tuples(events, case_key) do
    events
    |> Discovery.traces_from_events(case_key)
    |> Discovery.dfg_from_traces()
    |> Enum.map(fn %DfgEdge{} = e -> {e.source_activity, e.target_activity, e.frequency} end)
  end

  test "graph-derived allowlist is rendered, data-driven, and fail-closed" do
    allow = Actuation.admitted_actuations()
    assert Enum.sort(Map.keys(allow)) == @allowlist_names
    assert %{gym_op: "inc", requires: @inc_requires} = allow[@inc_action]
    refute Map.has_key?(allow, "not_an_admitted_action_name")
  end

  test "admitted action: performed receipt with exact observation transition, DFG-mineable events",
       %{tmp_dir: tmp_dir} do
    run_id = "act-admitted-#{System.unique_integer([:positive])}"

    action = %{
      action_name: @inc_action,
      preconditions: @inc_requires,
      effects: ["counter_incremented"]
    }

    assert {:ok, out} = Actuation.run(action, run_opts(tmp_dir, run_id, "toy-counter"))
    assert out.performed == true
    assert out.receipt_path == Path.join(tmp_dir, run_id <> ".json")

    receipt = read_receipt!(tmp_dir, run_id)
    assert receipt["receipt_schema"] == "beam4pm-brce/v1"

    assert receipt["action"]["action_name"] == @inc_action
    assert receipt["action"]["preconditions"] == @inc_requires

    assert receipt["admission"]["admitted"] == true
    assert receipt["admission"]["policy_decision"]["verdict"] == "admitted"
    assert receipt["admission"]["policy_decision"]["decision_id"] == "pd-" <> run_id

    # Exact deterministic toy-counter transition: inc from the reset state.
    exec = receipt["execution"]
    assert exec["performed"] == true
    assert exec["observation_before"] == %{"counter" => 0, "steps" => 0}
    assert exec["observation_after"] == %{"counter" => 1, "steps" => 1}
    assert exec["reward"] == 1.0
    assert exec["done"] == false

    # Replayable: the receipt names the real bridge invocation and the exact
    # graph-released action payload.
    assert receipt["replay"]["gym"] == "toy-counter"
    assert receipt["replay"]["action_json"] == ~s({"op":"inc"})
    assert receipt["replay"]["bridge_cmd"] =~ "toy_gym_bridge.py --gym toy-counter"
    assert String.starts_with?(receipt["replay"]["bridge_cmd"], "python3 ")

    # Mine the receipt's real OCEL events with the real BeamPM.Discovery:
    # one case (this run), activity sequence plan -> admit -> execute ->
    # observe, and exactly the three actuation DFG edges.
    events = mined_events!(receipt, run_id)
    assert length(events) == 4

    assert [%LogTrace{case_id: ^run_id, activity_sequence: ["plan", "admit", "execute", "observe"]}] =
             Discovery.traces_from_events(events, "case_id")

    assert dfg_tuples(events, "case_id") == [
             {"admit", "execute", 1},
             {"execute", "observe", 1},
             {"plan", "admit", 1}
           ]
  end

  test "refused action (not in graph allowlist): typed refusal AND refusal receipt",
       %{tmp_dir: tmp_dir} do
    run_id = "act-refused-#{System.unique_integer([:positive])}"

    action = %{
      action_name: "not_an_admitted_action_name",
      preconditions: [],
      effects: []
    }

    assert {:error, {:refused, reason}} =
             Actuation.run(action, run_opts(tmp_dir, run_id, "toy-counter"))

    assert reason =~ "not an admitted actuation"

    receipt = read_receipt!(tmp_dir, run_id)
    assert receipt["receipt_schema"] == "beam4pm-brce/v1"
    assert receipt["admission"]["admitted"] == false
    assert receipt["admission"]["policy_decision"]["verdict"] == "refused"
    assert receipt["admission"]["reason"] =~ "not an admitted actuation"
    assert receipt["execution"]["performed"] == false
    assert receipt["execution"]["observation_before"] == nil
    assert receipt["execution"]["observation_after"] == nil
    assert receipt["replay"]["action_json"] == ""

    events = mined_events!(receipt, run_id)
    assert Enum.map(events, & &1.event_type) == ["plan", "admit"]
    assert dfg_tuples(events, "case_id") == [{"plan", "admit", 1}]
  end

  test "refused action (missing graph-required precondition fact): data-driven refusal",
       %{tmp_dir: tmp_dir} do
    run_id = "act-missing-fact-#{System.unique_integer([:positive])}"

    action = %{action_name: @inc_action, preconditions: [], effects: []}

    assert {:error, {:refused, reason}} =
             Actuation.run(action, run_opts(tmp_dir, run_id, "toy-counter"))

    assert reason =~ "missing required precondition fact"
    assert reason =~ hd(@inc_requires)

    receipt = read_receipt!(tmp_dir, run_id)
    assert receipt["admission"]["admitted"] == false
    assert receipt["execution"]["performed"] == false
  end

  test "invalid action shape: typed refusal AND refusal receipt", %{tmp_dir: tmp_dir} do
    run_id = "act-invalid-#{System.unique_integer([:positive])}"

    assert {:error, {:refused, {:invalid_action, {:missing_field, :action_name}}}} =
             Actuation.run(%{preconditions: []}, run_opts(tmp_dir, run_id, "toy-counter"))

    receipt = read_receipt!(tmp_dir, run_id)
    assert receipt["admission"]["admitted"] == false
    assert receipt["execution"]["performed"] == false
    assert receipt["admission"]["reason"] =~ "invalid planning_action"
  end

  test "bridge crash mid-actuation: typed execution failure AND compensation receipt",
       %{tmp_dir: tmp_dir} do
    run_id = "act-crash-#{System.unique_integer([:positive])}"

    action = %{
      action_name: @inc_action,
      preconditions: @inc_requires,
      effects: ["counter_incremented"]
    }

    # The crashy fixture gym resets fine, then exits(3) abruptly on the
    # first step request - a real mid-actuation environment crash.
    assert {:error, {:execution_failed, {:bridge_exited, 3}}} =
             Actuation.run(action, run_opts(tmp_dir, run_id, "crashy"))

    receipt = read_receipt!(tmp_dir, run_id)
    assert receipt["receipt_schema"] == "beam4pm-brce/v1"

    # Compensation receipt: the action WAS admitted, the attempt happened,
    # nothing was performed to completion, and the error is captured.
    assert receipt["admission"]["admitted"] == true
    assert receipt["admission"]["policy_decision"]["verdict"] == "admitted"
    assert receipt["execution"]["performed"] == false
    assert receipt["execution"]["error"] =~ "bridge_exited"
    assert receipt["replay"]["gym"] == "crashy"
    assert receipt["replay"]["action_json"] == ~s({"op":"inc"})

    events = mined_events!(receipt, run_id)
    assert Enum.map(events, & &1.event_type) == ["plan", "admit", "execute"]

    execute_event = Enum.find(events, &(&1.event_type == "execute"))
    assert execute_event.attributes["outcome"] == "failed"
    assert execute_event.attributes["error"] =~ "bridge_exited"

    assert dfg_tuples(events, "case_id") == [
             {"admit", "execute", 1},
             {"plan", "admit", 1}
           ]
  end
end
