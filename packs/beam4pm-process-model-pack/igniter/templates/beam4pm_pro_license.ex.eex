%># GENERATED by ggen_igniter from the beam4pm_pro_license static template. Do not edit.
defmodule BeamPM.Pro.License do
  @moduledoc """
  Commercial license evidence for `beam4pm_pro` gap-closure item PRO-007.

  Deliberately DISTINCT from `BeamPM.Entitlement` and any BRCE/actuation
  authority: a `License` here is evidence to be verified, never a runtime
  grant on its own. A caller that wants to actuate something still goes
  through the real admission/entitlement path -- `verify/2` only tells the
  caller whether the license EVIDENCE is currently valid.

  Signatures are real HMAC-SHA256 (via `:crypto.mac/4`) over the canonical
  field encoding, not a placeholder -- `sign/2` produces a genuinely
  verifiable signed license for tests and for real issuance.
  """

  import Bitwise, only: [bxor: 2, bor: 2]

  @type t :: %__MODULE__{
          license_id: String.t(),
          scope: String.t(),
          issued_at: DateTime.t(),
          expires_at: DateTime.t(),
          signature: binary() | nil
        }

  @enforce_keys [:license_id, :scope, :issued_at, :expires_at]
  defstruct [:license_id, :scope, :issued_at, :expires_at, :signature]

  @type verify_outcome ::
          {:ok, :valid}
          | {:error, :expired}
          | {:error, {:wrong_scope, String.t(), String.t()}}
          | {:error, :tampered}
          | {:error, :offline_unverifiable}

  @doc """
  Canonical byte encoding of a license's identity fields (excluding the
  signature itself) -- what `sign/2` signs and `verify/2` re-derives to
  check.
  """
  @spec canonical_payload(t()) :: binary()
  def canonical_payload(%__MODULE__{} = license) do
    :erlang.term_to_binary(
      {license.license_id, license.scope, license.issued_at, license.expires_at},
      minor_version: 2
    )
  end

  @doc "Sign a license with a real HMAC-SHA256 over its canonical payload."
  @spec sign(t(), binary()) :: t()
  def sign(%__MODULE__{} = license, secret_key) when is_binary(secret_key) do
    mac = :crypto.mac(:hmac, :sha256, secret_key, canonical_payload(license))
    %{license | signature: mac}
  end

  @doc """
  Verify a license against an expected scope and trusted key, returning
  exactly one of five typed outcomes. `trusted_key` may be `nil` to model an
  offline/degraded verification context (e.g. no network reach to a key
  service) -- that is a real, disclosed outcome (`:offline_unverifiable`),
  never a silent pass.
  """
  @spec verify(t(), %{expected_scope: String.t(), trusted_key: binary() | nil}) ::
          verify_outcome()
  def verify(%__MODULE__{} = _license, %{expected_scope: _expected_scope, trusted_key: nil}) do
    {:error, :offline_unverifiable}
  end

  def verify(%__MODULE__{} = license, %{expected_scope: expected_scope, trusted_key: trusted_key})
      when is_binary(trusted_key) do
    expected_mac = :crypto.mac(:hmac, :sha256, trusted_key, canonical_payload(license))

    cond do
      license.signature == nil or not secure_compare(expected_mac, license.signature) ->
        {:error, :tampered}

      DateTime.compare(DateTime.utc_now(), license.expires_at) == :gt ->
        {:error, :expired}

      license.scope != expected_scope ->
        {:error, {:wrong_scope, expected_scope, license.scope}}

      true ->
        {:ok, :valid}
    end
  end

  # Constant-time comparison -- a license signature check must not leak
  # timing information about how many leading bytes matched. Accumulates a
  # bitwise OR of every byte-pair XOR across the FULL length before
  # branching once at the end, rather than short-circuiting on Elixir's
  # own binary equality.
  defp secure_compare(a, b) when is_binary(a) and is_binary(b) and byte_size(a) == byte_size(b) do
    a
    |> :binary.bin_to_list()
    |> Enum.zip(:binary.bin_to_list(b))
    |> Enum.reduce(0, fn {x, y}, acc -> bor(acc, bxor(x, y)) end)
    |> Kernel.==(0)
  end

  defp secure_compare(_a, _b), do: false
end
