<%
# ggen_igniter EEx template -> test/beam4pm_process_governor_test.exs
#
# Bindings (same query as beam4pm_process_governor.ex.eex):
#   transitions - list of string-keyed maps: "process_id", "initial_state",
#                 "ordinal", "from_state", "to_state", "actuation_name"
#
# Chicago-style qualification: every collaborator is REAL - the real
# generated BeamPM.ProcessGovernor delegating to the real generated
# BeamPM.Actuation reactor, a real python3 gym bridge subprocess
# (qualification/fixtures/toy_gym_bridge.py - a deterministic fake
# ENVIRONMENT, not a mock of our code), real receipt files on disk at BOTH
# levels (process-level AND the embedded beam4pm-brce/v1 actuation-level
# receipt), and the real BeamPM.Discovery miner run over the combined,
# re-tagged real OCEL events pulled back out of those files by replay/2.
norm = fn
  nil ->
    nil

  v when is_binary(v) ->
    cond do
      String.starts_with?(v, "<") and String.ends_with?(v, ">") ->
        String.slice(v, 1..-2//1)

      String.starts_with?(v, "\"") ->
        case Regex.run(~r/\A"(.*)"(?:\^\^<[^>]*>|@[A-Za-z0-9\-]+)?\z/s, v) do
          [_, lex] -> lex
          nil -> v
        end

      true ->
        v
    end

  v ->
    to_string(v)
end

norm_int = fn v ->
  case norm.(v) do
    nil -> nil
    s when is_binary(s) -> s |> Integer.parse() |> elem(0)
    n when is_integer(n) -> n
  end
end

rows =
  transitions
  |> Enum.map(fn t ->
    %{
      process_id: norm.(t["process_id"]),
      ordinal: norm_int.(t["ordinal"]),
      from_state: norm.(t["from_state"]),
      to_state: norm.(t["to_state"]),
      actuation_name: norm.(t["actuation_name"])
    }
  end)

# The two-step happy-path test below drives the toy-counter fixture gym
# through both its admitted actuations, so the graph MUST admit exactly one
# process whose ordinal-1/ordinal-2 actuation names are exactly
# increment_counter/observe_counter - fail the render loudly (not silently
# skip) on graph drift, same discipline as beam4pm_actuation_test.exs.eex's
# inc_row check.
toy_counter_rows =
  rows
  |> Enum.filter(&(&1.actuation_name in ["increment_counter", "observe_counter"]))
  |> Enum.group_by(& &1.process_id)
  |> Enum.filter(fn {_pid, rs} ->
    Enum.sort_by(rs, & &1.ordinal) |> Enum.map(& &1.actuation_name) ==
      ["increment_counter", "observe_counter"]
  end)

toy_counter_process_id =
  case toy_counter_rows do
    [{pid, _rs}] ->
      pid

    other ->
      raise "process-governor graph must admit exactly one 2-step process over " <>
              "increment_counter -> observe_counter for this qualification suite, got: " <>
              inspect(other)
  end
%># GENERATED by ggen_igniter from the admitted bpmg:ProcessContract graph. Do not edit.
defmodule BeamPM.ProcessGovernorTest do
  @moduledoc """
  Chicago-style qualification of `BeamPM.ProcessGovernor`: real multi-step
  delegation to the real `BeamPM.Actuation` Reactor pipeline, a real python3
  gym bridge subprocess, real receipt files on disk at both levels, and the
  real `BeamPM.Discovery` miner run over the combined, replayed trace.

  Every scenario below is a first-principles-rewrite falsifier of the
  concurrently-merged `BeamPM.Governor` this module replaces: (1) a full
  multi-step run proves real delegation with real consequence, never a
  zero-I/O restatement; (2) an exact-state-mismatch refusal proves
  fail-closed fencing without a `KeyError` crash on a stale snapshot;
  (3) a non-admitted-actuation-name refusal proves `apply_transition/3`
  never accepts an unverified caller-supplied authority claim (contrast the
  reimplemented module's unauthenticated `authority_digest`); (4) a bridge
  crash proves the embedded actuation reference still resolves to a real
  compensation receipt.
  """

  use ExUnit.Case, async: false

  alias BeamPM.ProcessGovernor

  @moduletag :tmp_dir

  @process_id <%= inspect(toy_counter_process_id) %>

  defp bridge_path do
    path = Path.expand("qualification/fixtures/toy_gym_bridge.py")

    unless File.exists?(path) do
      raise "fixture gym bridge not found at #{path} - run mix test from the project root"
    end

    path
  end

  defp opts(tmp_dir, gym) do
    [gym: gym, bridge: bridge_path(), receipts_dir: tmp_dir]
  end

  defp read_json!(path) do
    assert File.exists?(path), "expected receipt file at #{path}"
    path |> File.read!() |> JSON.decode!()
  end

  test "graph-derived process contracts are rendered, data-driven, and fail-closed" do
    contracts = ProcessGovernor.contracts()
    assert %{initial_state: _, transitions: [t1, t2]} = contracts[@process_id]
    assert t1.ordinal == 1 and t2.ordinal == 2
    assert t1.actuation_name == "increment_counter"
    assert t2.actuation_name == "observe_counter"

    assert {:error, {:refused, reason}} = ProcessGovernor.initial_snapshot("not_an_admitted_process")
    assert reason =~ "is not an admitted bpmg:ProcessContract"
  end

  test "full two-step governed process run: real delegation, real consequence, replayable as one trace",
       %{tmp_dir: tmp_dir} do
    assert {:ok, final} = ProcessGovernor.run(@process_id, opts(tmp_dir, "toy-counter"))
    assert final.state == "observed"
    assert length(final.receipts) == 2

    [receipt2, receipt1] = final.receipts
    assert receipt1.ordinal == 1 and receipt1.outcome == :applied
    assert receipt2.ordinal == 2 and receipt2.outcome == :applied

    # Each transition's process receipt embeds a REAL, independently
    # verifiable beam4pm-brce/v1 actuation receipt, never a fabricated hash.
    for receipt <- [receipt1, receipt2] do
      assert receipt.actuation.receipt_schema == "beam4pm-brce/v1"
      actuation_json = read_json!(receipt.actuation.receipt_path)
      assert actuation_json["receipt_schema"] == "beam4pm-brce/v1"
      assert actuation_json["admission"]["admitted"] == true
      assert actuation_json["execution"]["performed"] == true
    end

    assert read_json!(receipt1.actuation.receipt_path)["action"]["action_name"] == "increment_counter"
    assert read_json!(receipt2.actuation.receipt_path)["action"]["action_name"] == "observe_counter"

    # The process-level receipt is ALSO real and on disk (unlike the
    # reimplemented module's in-memory-only receipt, lost on crash/restart).
    process_json1 = read_json!(receipt1.process_receipt_path)
    assert process_json1["receipt_schema"] == "beam4pm-process-governor/v1"
    assert process_json1["outcome"] == "applied"
    assert process_json1["actuation"]["receipt_schema"] == "beam4pm-brce/v1"

    # replay/2 re-verifies BOTH embedded actuation receipts still exist and
    # match, then re-mines the WHOLE process run as one real OCEL trace via
    # the real BeamPM.Discovery - not two disconnected single-actuation
    # traces.
    assert {:ok, replayed} = ProcessGovernor.replay(@process_id, Enum.reverse(final.receipts))
    assert replayed.final_state == "observed"

    assert %BeamPM.Types.LogTrace{
             case_id: @process_id,
             activity_sequence: [
               "plan",
               "admit",
               "execute",
               "observe",
               "plan",
               "admit",
               "execute",
               "observe"
             ]
           } = replayed.mined_trace

    dfg_tuples =
      Enum.map(replayed.dfg, fn e -> {e.source_activity, e.target_activity, e.frequency} end)

    assert {"observe", "plan", 1} in dfg_tuples
    assert {"admit", "execute", 2} in dfg_tuples
    assert {"plan", "admit", 2} in dfg_tuples
    assert {"execute", "observe", 2} in dfg_tuples
  end

  test "refused transition (exact-state-hash fence): stale snapshot never crashes, never calls Actuation",
       %{tmp_dir: tmp_dir} do
    assert {:ok, snapshot} = ProcessGovernor.initial_snapshot(@process_id)
    assert {:ok, t2_candidate} = ProcessGovernor.plan_transition(snapshot, 2)

    # snapshot is still at the INITIAL state (t1 was never applied); feeding
    # a t2 candidate (whose expected_state_hash was captured for t1's
    # to_state, not the initial state) must be a typed refusal, never a
    # crash and never a silently-accepted actuation.
    assert {:error, {:refused, reason}, receipt} =
             ProcessGovernor.apply_transition(snapshot, t2_candidate, opts(tmp_dir, "toy-counter"))

    assert reason =~ "exact-state fence"
    assert receipt.outcome == :refused
    assert receipt.actuation == nil, "a fencing refusal must never call BeamPM.Actuation"

    # The refusal is still a real, on-disk process receipt (never silently
    # dropped), and replay/2 confirms it is the trace boundary: zero events.
    process_json = read_json!(receipt.process_receipt_path)
    assert process_json["outcome"] == "refused"
    assert process_json["actuation"] == nil

    assert {:ok, replayed} = ProcessGovernor.replay(@process_id, [receipt])
    assert replayed.mined_trace.activity_sequence == []
  end

  test "refused transition (non-admitted actuation name): fail-closed, zero unauthenticated authority accepted",
       %{tmp_dir: tmp_dir} do
    assert {:ok, snapshot} = ProcessGovernor.initial_snapshot(@process_id)

    # A hand-crafted candidate (not produced by plan_transition/2) whose
    # actuation_name is NOT in BeamPM.Actuation.admitted_actuations/0 - the
    # exact shape a corrupted or maliciously-constructed candidate would
    # take. Contrast the reimplemented module's require_authority/2, which
    # accepted ANY caller-supplied `authority_digest` string with zero
    # verification.
    forged_candidate = %{
      process_id: @process_id,
      ordinal: 1,
      from_state: snapshot.state,
      to_state: "anywhere",
      actuation_name: "not_an_admitted_action_name",
      expected_state_hash: snapshot.state_hash
    }

    assert {:error, {:refused, reason}, receipt} =
             ProcessGovernor.apply_transition(snapshot, forged_candidate, opts(tmp_dir, "toy-counter"))

    assert reason =~ "is not admitted by BeamPM.Actuation.admitted_actuations/0"
    assert receipt.actuation == nil, "a non-admitted actuation name must never reach BeamPM.Actuation.run/2"

    refute File.exists?(Path.join(tmp_dir, receipt.run_id <> ".json")),
           "BeamPM.Actuation.run/2 must never have been called for a non-admitted actuation_name"
  end

  test "bridge crash mid-transition: real compensation receipt embedded, process trace ends at the boundary",
       %{tmp_dir: tmp_dir} do
    assert {:ok, snapshot} = ProcessGovernor.initial_snapshot(@process_id)
    assert {:ok, candidate} = ProcessGovernor.plan_transition(snapshot, 1)

    assert {:error, {:execution_failed, {:bridge_exited, 3}}, receipt} =
             ProcessGovernor.apply_transition(snapshot, candidate, opts(tmp_dir, "crashy"))

    assert receipt.outcome == :execution_failed
    assert receipt.actuation.receipt_schema == "beam4pm-brce/v1"

    actuation_json = read_json!(receipt.actuation.receipt_path)
    assert actuation_json["admission"]["admitted"] == true
    assert actuation_json["execution"]["performed"] == false
    assert actuation_json["execution"]["error"] =~ "bridge_exited"

    assert {:ok, replayed} = ProcessGovernor.replay(@process_id, [receipt])
    assert replayed.mined_trace.activity_sequence == ["plan", "admit", "execute"]

    initial_state = ProcessGovernor.contracts()[@process_id].initial_state
    assert replayed.final_state == initial_state
  end
end
