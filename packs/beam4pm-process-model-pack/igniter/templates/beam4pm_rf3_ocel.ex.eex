<%
# ggen_igniter EEx template -> lib/beam4pm_rf3_ocel.ex
#
# Bindings: NONE -- this template renders statically, unlike
# beam4pm_actuation.ex.eex / beam4pm_process_governor.ex.eex, which interpolate
# a SPARQL-derived admission graph (`bpma:AdmittedActuation` /
# `bpmg:ProcessContract` individuals) into `@admitted_actuations`/`@contracts`
# literals. This stream (RF3: process_mining::bindings::slim_ocel_bindings +
# process_mining's real OCEL 2.0 JSON importer) exercises zero execution
# authority and admits no gym op -- there is no admission-graph-shaped data
# for a pure oracle-differential-testing pipeline to consult, so this
# manifest has no bindings to declare. All per-deployment configuration
# (the compiled oracle binary's path, fixture paths) is supplied at call time
# via `run/2`'s `run_opts`, not baked in at render time.
%># GENERATED by ggen_igniter from the RF3 (process_mining::bindings::slim_ocel_bindings)
# oracle manifest. Do not edit.
defmodule BeamPM.RF3Ocel.Oracle do
  @moduledoc """
  One-shot subprocess wrapper for `rf3-ocel-oracle` (the real Rust binary built
  from `process_mining = "=0.6.2"`, `features = ["bindings"]`).

  Real subprocess collaborator (Chicago discipline): writes the JSON request to
  a real temp file, invokes `<oracle_bin> < <tmpfile>` through `/bin/sh -c`
  (Erlang `Port`s have no half-close primitive for a live pipe, so a real file
  redirect -- rather than `Port.command/2` followed by an attempt to signal
  EOF on stdin alone -- is what gives the child process a natural end-of-input;
  the shell adds no logic of its own, it only performs the redirect), and
  decodes the single JSON reply from real stdout. A nonzero exit, a timeout, or
  undecodable stdout all surface as a typed `{:error, ...}` -- never a crash,
  and never a fabricated success.
  """

  @spec call(String.t(), map(), non_neg_integer()) :: {:ok, map()} | {:error, term()}
  def call(oracle_bin, request, timeout \\ 10_000)
      when is_binary(oracle_bin) and is_map(request) do
    tmp =
      Path.join(
        System.tmp_dir!(),
        "rf3-ocel-oracle-req-#{System.unique_integer([:positive, :monotonic])}.json"
      )

    File.write!(tmp, JSON.encode!(request))

    try do
      run_via_shell(oracle_bin, tmp, timeout)
    after
      File.rm(tmp)
    end
  end

  defp run_via_shell(oracle_bin, tmp_path, timeout) do
    sh = System.find_executable("sh") || "/bin/sh"
    cmd = "exec #{shell_quote(oracle_bin)} < #{shell_quote(tmp_path)}"

    port =
      Port.open({:spawn_executable, sh}, [
        :binary,
        :exit_status,
        args: ["-c", cmd]
      ])

    collect(port, [], timeout)
  end

  defp shell_quote(s), do: "'" <> String.replace(s, "'", "'\\''") <> "'"

  defp collect(port, acc, timeout) do
    receive do
      {^port, {:data, chunk}} ->
        collect(port, [chunk | acc], timeout)

      {^port, {:exit_status, 0}} ->
        decode_reply(acc)

      {^port, {:exit_status, status}} ->
        {:error, {:oracle_nonzero_exit, status, IO.iodata_to_binary(Enum.reverse(acc))}}
    after
      timeout -> {:error, {:oracle_timeout, timeout}}
    end
  end

  defp decode_reply(acc) do
    raw = acc |> Enum.reverse() |> IO.iodata_to_binary()

    case JSON.decode(raw) do
      {:ok, decoded} when is_map(decoded) -> {:ok, decoded}
      {:ok, other} -> {:error, {:oracle_bad_reply_shape, other}}
      {:error, decode_error} -> {:error, {:oracle_bad_json, raw, decode_error}}
    end
  end
end

defmodule BeamPM.RF3Ocel do
  @moduledoc """
  Chicago-style Reactor pipeline for STREAM RF3
  (`process_mining::bindings::slim_ocel_bindings` + process_mining's real OCEL
  2.0 JSON importer, `process_mining = "=0.6.2"`, `features = ["bindings"]`).

  ## Real-function ground truth this pipeline exercises (via `rf3-ocel-oracle`,
  no mocks anywhere in this chain)

  * `process_mining::core::event_data::object_centric::ocel_json::import_ocel_json_path`
    -- the real OCEL 2.0 JSON importer. It is a PLAIN `serde_json` deserialize
    into `Vec<OCELEvent>`/`Vec<OCELObject>`: no duplicate-id check, no
    declared-type check, no referential-integrity check on relationships.
  * `process_mining::bindings::{num_events, num_objects, ocel_type_stats,
    slim_link_ocel}` -- real, `pub` functions at the top of
    `process_mining::bindings` (not inside `slim_ocel_bindings.rs`, which is a
    PRIVATE module of one-line trampolines around `SlimLinkedOCEL`'s own real
    public methods, reachable only through the crate's dynamic binding-call
    registry -- this pipeline exercises the identical underlying
    `SlimLinkedOCEL::new/add_event_type/add_object_type/add_event/add_object/
    add_e2o/add_o2o/construct_ocel` methods directly instead).
  * `SlimLinkedOCEL::from_ocel` (== `bindings::slim_link_ocel`) SILENTLY drops
    a duplicate object id (stderr warning, object count shrinks by one) and
    SILENTLY auto-declares an undeclared event type used by an event (zero
    warning at all) -- process_mining performs NEITHER check as a refusal.
    **This pipeline is the layer that turns those two silent behaviors into a
    typed refusal**, by comparing the oracle's disclosed raw-vs-declared facts
    itself; it does not claim process_mining refuses what it does not.

  ## Admission doctrine (this stream has none, disclosed here rather than
  hidden)

  Unlike `BeamPM.Actuation`, this pipeline holds no admission allowlist and no
  `bpma:AdmittedActuation` graph binding: every scenario below only ever reads
  a fixed local OCEL fixture through the read-only oracle and writes a
  receipt. `:execute` never opens a gym bridge, never touches a Port beyond
  the oracle subprocess, and confers no actuation authority of any kind.

  ## Scenarios (`input(:scenario)`)

    * `:check_positive` -- `ocel_stats` on a real, well-formed, self-authored
      positive OCEL 2.0 JSON fixture (documented as self-authored, not a
      wasm4pm fixture, because none of wasm4pm's fixtures are both genuinely
      lawful data AND OCEL-2.0-JSON-shaped -- `fixtures/negative/*.ocel.json`
      are deliberate adversarial fixtures for a DIFFERENT validator, and
      `fixtures/real/trace-conform-accepted/expected-ocel.json` uses
      wasm4pm's own OCEL-1.0-style shape, confirmed by this same oracle to
      fail process_mining's importer with `missing field \`eventTypes\``).
    * `:check_roundtrip` -- `ocel_build_slim`: builds a real 2-event/2-object
      `SlimLinkedOCEL` programmatically, reconstructs it via
      `construct_ocel` (== `locel_construct_ocel`), re-links the
      reconstruction back through `slim_link_ocel`, and asserts the
      re-measured counts/type-stats are BYTE-for-byte identical to the
      original build -- the real round-trip proof.
    * `:falsify_duplicate_object` -- the REAL `n13-duplicate-object-id.ocel.json`
      adversarial fixture from `wasm4pm/fixtures/negative/`. process_mining
      itself does not refuse it (silent dedup); THIS pipeline refuses,
      because `raw.distinct_object_ids != raw.num_objects` is a real,
      oracle-disclosed fact.
    * `:falsify_undeclared_type` -- the REAL `n14-undeclared-event-type.ocel.json`
      adversarial fixture. process_mining silently auto-declares the
      undeclared type (zero warning even); THIS pipeline refuses because
      `raw.undeclared_event_types_used` is non-empty.
    * `:falsify_dangling_o2o` (bonus coverage beyond the four required
      scenarios) -- the REAL `n05-o2o-dangling.ocel.json` fixture.
      process_mining silently drops the dangling O2O relationship at
      `finalize()` (stderr warning, but no refusal); THIS pipeline refuses
      because `reconstructed.o2o_relationship_count < raw.o2o_relationship_count`.

  ## Receipts (every path, `beam4pm-rf3-ocel/v1`)

  Every `run/2` call -- passed, or refused -- ends in exactly one receipt at
  `<receipts_dir>/<run_id>.json`. `compensate/2` on `:run_oracle` and on
  `:verify` both turn a detected failure into a typed, receipted refusal
  rather than letting Reactor crash the process; `run/2` itself guarantees a
  receipt on every remaining path (a malformed `scenario` atom).
  """

  use Reactor

  alias BeamPM.RF3Ocel.Oracle

  @receipt_schema "beam4pm-rf3-ocel/v1"

  input(:scenario)
  input(:run_opts)

  step :build_request do
    argument(:scenario, input(:scenario))
    argument(:run_opts, input(:run_opts))

    run(fn %{scenario: scenario, run_opts: opts}, _context ->
      case request_for(scenario, opts) do
        {:ok, request} -> {:ok, request}
        {:error, reason} -> {:error, {:refused, reason}}
      end
    end)

    max_retries(0)
  end

  # side_effect: mutating -- the ONLY step that touches the environment (a
  # real Rust subprocess speaking the fixed rf3-ocel-oracle wire contract).
  # `max_retries 0`: an oracle call must never be silently retried. On ITS OWN
  # failure `compensate/2` writes a real typed-refusal receipt -- never a
  # silent crash.
  step :run_oracle do
    argument(:request, result(:build_request))
    argument(:run_opts, input(:run_opts))

    run(fn %{request: request, run_opts: opts}, _context ->
      case Oracle.call(Map.fetch!(opts, :oracle_bin), request) do
        {:ok, decoded} -> {:ok, decoded}
        {:error, reason} -> {:error, {:oracle_failed, reason}}
      end
    end)

    compensate(fn reason, %{run_opts: opts} ->
      _path =
        write_receipt!(opts, %{
          scenario: Map.get(opts, :__scenario_for_receipt__, :unknown),
          outcome: :refused,
          reason: failure_reason_text({:oracle_failed, reason}),
          oracle_out: nil,
          verified: %{}
        })

      :ok
    end)

    max_retries(0)
  end

  # side_effect: pure -- applies the scenario's real, specific,
  # non-trivial assertion(s) against the oracle's REAL decoded output. This
  # is the step that turns process_mining's silent acceptance of a
  # structurally malformed fixture into a typed refusal for the two
  # `:falsify_*` scenarios (and the bonus third): the oracle never lies about
  # what it saw, but it also never refuses on our behalf, so the verification
  # here is what makes each falsify scenario non-vacuous.
  step :verify do
    argument(:scenario, input(:scenario))
    argument(:oracle_out, result(:run_oracle))
    argument(:run_opts, input(:run_opts))

    run(fn %{scenario: scenario, oracle_out: out, run_opts: opts}, _context ->
      case verify(scenario, out) do
        {:ok, facts} ->
          path =
            write_receipt!(opts, %{
              scenario: scenario,
              outcome: :passed,
              reason: nil,
              oracle_out: out,
              verified: facts
            })

          {:ok, %{receipt_path: path, scenario: scenario, oracle_out: out, verified: facts}}

        {:error, reason} ->
          {:error, {:assertion_failed, reason}}
      end
    end)

    compensate(fn reason, %{scenario: scenario, oracle_out: out, run_opts: opts} ->
      _path =
        write_receipt!(opts, %{
          scenario: scenario,
          outcome: :refused,
          reason: failure_reason_text(reason),
          oracle_out: out,
          verified: %{}
        })

      :ok
    end)

    max_retries(0)
  end

  return(:verify)

  # -- Public entry point (guaranteed receipt on every path) -----------------

  @doc """
  Runs one RF3 scenario end to end. `scenario` is one of `:check_positive`,
  `:check_roundtrip`, `:falsify_duplicate_object`, `:falsify_undeclared_type`,
  `:falsify_dangling_o2o`.

  Required `run_opts`: `:oracle_bin` (path to the compiled `rf3-ocel-oracle`
  binary), `:positive_fixture_path`, `:n13_fixture_path`, `:n14_fixture_path`,
  `:n05_fixture_path` (real fixture paths). Optional: `:run_id`,
  `:receipts_dir`.

  Returns `{:ok, %{verified: facts, ...}}` for a `:check_*` scenario whose
  real assertions held, or for a `:falsify_*` scenario in the degenerate case
  where the real adversarial fixture's known defect is no longer observed
  (which would make that check vacuous -- surfaced as a passing result so a
  human notices the fixture changed, rather than silently refusing).
  Returns `{:error, {:refused, reason}}` for a `:check_*` scenario whose
  assertions genuinely failed, OR -- the expected, correct outcome against
  the real fixtures shipped with this stream -- for a `:falsify_*` scenario
  that correctly detected its fixture's real structural defect: garbage in,
  typed refusal out, non-vacuously. In every case exactly one receipt exists
  on disk at `<receipts_dir>/<run_id>.json` afterward.
  """
  @spec run(atom(), keyword()) :: {:ok, map()} | {:error, {:refused, term()} | term()}
  def run(scenario, opts) when is_atom(scenario) and is_list(opts) do
    {:ok, _} = Application.ensure_all_started(:reactor)
    norm_opts = normalize_opts!(opts)

    case Reactor.run(
           __MODULE__,
           %{scenario: scenario, run_opts: Map.put(norm_opts, :__scenario_for_receipt__, scenario)},
           %{},
           async?: false
         ) do
      {:ok, out} ->
        {:ok, out}

      {:error, error} ->
        reason = principal_reason(error)
        _path = ensure_failure_receipt!(scenario, norm_opts, reason)
        {:error, reason}
    end
  end

  # -- Internal: per-scenario request construction ----------------------------

  defp request_for(:check_positive, opts) do
    {:ok, %{"op" => "ocel_stats", "ocel_path" => Map.fetch!(opts, :positive_fixture_path)}}
  end

  defp request_for(:check_roundtrip, _opts) do
    {:ok, %{"op" => "ocel_build_slim"}}
  end

  defp request_for(:falsify_duplicate_object, opts) do
    {:ok, %{"op" => "ocel_stats", "ocel_path" => Map.fetch!(opts, :n13_fixture_path)}}
  end

  defp request_for(:falsify_undeclared_type, opts) do
    {:ok, %{"op" => "ocel_stats", "ocel_path" => Map.fetch!(opts, :n14_fixture_path)}}
  end

  defp request_for(:falsify_dangling_o2o, opts) do
    {:ok, %{"op" => "ocel_stats", "ocel_path" => Map.fetch!(opts, :n05_fixture_path)}}
  end

  defp request_for(other, _opts) do
    {:error, "scenario #{inspect(other)} is not one of the admitted RF3 scenarios"}
  end

  # -- Internal: per-scenario verification (real, specific, non-trivial) -----

  defp verify(:check_positive, %{"ok" => true} = out) do
    with 2 <- out["num_events"],
         2 <- out["num_objects"],
         %{"Create Order" => 1, "Ship Order" => 1} <- out["type_stats"]["event_type_counts"],
         %{"Order" => 1, "Item" => 1} <- out["type_stats"]["object_type_counts"],
         3 <- out["raw"]["e2o_relationship_count"],
         1 <- out["raw"]["o2o_relationship_count"] do
      {:ok,
       %{
         num_events: out["num_events"],
         num_objects: out["num_objects"],
         e2o_relationship_count: out["raw"]["e2o_relationship_count"],
         o2o_relationship_count: out["raw"]["o2o_relationship_count"]
       }}
    else
      _ -> {:error, {:positive_fixture_did_not_match_expected_shape, out}}
    end
  end

  defp verify(:check_positive, out), do: {:error, {:oracle_reported_not_ok, out}}

  defp verify(:check_roundtrip, %{"ok" => true} = out) do
    built = out["built"]
    reconstructed = out["reconstructed_ocel"]
    roundtrip = out["roundtrip"]

    cond do
      built["num_events"] != 2 or built["num_objects"] != 2 ->
        {:error, {:built_slim_wrong_shape, built}}

      built["e2o_relationship_count"] != 3 or built["o2o_relationship_count"] != 1 ->
        {:error, {:built_slim_wrong_relationship_counts, built}}

      reconstructed["num_events"] != built["num_events"] or
          reconstructed["num_objects"] != built["num_objects"] ->
        {:error, {:reconstructed_ocel_diverged_from_built, %{built: built, reconstructed: reconstructed}}}

      roundtrip["num_events"] != built["num_events"] or
          roundtrip["num_objects"] != built["num_objects"] or
          roundtrip["type_stats"] != built["type_stats"] ->
        {:error, {:roundtrip_not_identical_to_built, %{built: built, roundtrip: roundtrip}}}

      true ->
        {:ok,
         %{
           built_num_events: built["num_events"],
           built_num_objects: built["num_objects"],
           roundtrip_identical: true
         }}
    end
  end

  defp verify(:check_roundtrip, out), do: {:error, {:oracle_reported_not_ok, out}}

  # A FALSIFY step reports success (`{:ok, ...}`) ONLY in the degenerate case
  # where the real adversarial fixture no longer shows its known defect
  # (fixture edited out from under us, or process_mining started refusing it
  # itself) -- i.e. the one case where this check WOULD be vacuous, which is
  # itself worth surfacing as a passing (rather than silently-refused)
  # result so a human notices the fixture changed. The expected, REAL-fixture
  # outcome -- the defect genuinely observed -- is a typed refusal: garbage
  # in, refusal out, non-vacuously, via `compensate/2` below.
  defp verify(:falsify_duplicate_object, %{"ok" => true} = out) do
    raw = out["raw"]

    if raw["distinct_object_ids"] != raw["num_objects"] do
      {:error,
       {:duplicate_object_id_silently_deduped_by_process_mining,
        %{
          raw_num_objects: raw["num_objects"],
          distinct_object_ids: raw["distinct_object_ids"],
          effective_num_objects_after_slim_link: out["num_objects"]
        }}}
    else
      {:ok,
       %{
         defect_no_longer_present_check_would_have_been_vacuous: true,
         raw_num_objects: raw["num_objects"],
         distinct_object_ids: raw["distinct_object_ids"]
       }}
    end
  end

  defp verify(:falsify_duplicate_object, out), do: {:error, {:oracle_reported_not_ok, out}}

  defp verify(:falsify_undeclared_type, %{"ok" => true} = out) do
    undeclared = out["raw"]["undeclared_event_types_used"]

    if is_list(undeclared) and undeclared != [] do
      {:error,
       {:undeclared_event_type_silently_auto_declared_by_process_mining,
        %{undeclared_event_types_used: undeclared}}}
    else
      {:ok,
       %{
         defect_no_longer_present_check_would_have_been_vacuous: true,
         undeclared_event_types_used: undeclared
       }}
    end
  end

  defp verify(:falsify_undeclared_type, out), do: {:error, {:oracle_reported_not_ok, out}}

  defp verify(:falsify_dangling_o2o, %{"ok" => true} = out) do
    raw_o2o = out["raw"]["o2o_relationship_count"]
    reconstructed_o2o = out["reconstructed"]["o2o_relationship_count"]

    if reconstructed_o2o < raw_o2o do
      {:error,
       {:dangling_o2o_relationship_silently_dropped_by_process_mining,
        %{raw_o2o_relationship_count: raw_o2o, reconstructed_o2o_relationship_count: reconstructed_o2o}}}
    else
      {:ok,
       %{
         defect_no_longer_present_check_would_have_been_vacuous: true,
         raw_o2o_relationship_count: raw_o2o,
         reconstructed_o2o_relationship_count: reconstructed_o2o
       }}
    end
  end

  defp verify(:falsify_dangling_o2o, out), do: {:error, {:oracle_reported_not_ok, out}}

  defp verify(other, _out), do: {:error, {:no_verifier_for_scenario, other}}

  # -- Internal: opts, receipts, error unwrapping (mirrors BeamPM.Actuation) --

  defp normalize_opts!(opts) do
    %{
      oracle_bin: Keyword.fetch!(opts, :oracle_bin),
      positive_fixture_path: Keyword.fetch!(opts, :positive_fixture_path),
      n13_fixture_path: Keyword.fetch!(opts, :n13_fixture_path),
      n14_fixture_path: Keyword.fetch!(opts, :n14_fixture_path),
      n05_fixture_path: Keyword.get(opts, :n05_fixture_path),
      receipts_dir:
        Keyword.get(opts, :receipts_dir, Path.join(File.cwd!(), "receipts/rf3_ocel")),
      run_id:
        Keyword.get(
          opts,
          :run_id,
          "rf3-#{System.system_time(:millisecond)}-#{System.unique_integer([:positive])}"
        )
    }
  end

  defp receipt_path(opts) do
    Path.join(Map.fetch!(opts, :receipts_dir), Map.fetch!(opts, :run_id) <> ".json")
  end

  defp write_receipt!(opts, fields) do
    receipt = %{
      "receipt_schema" => @receipt_schema,
      "scenario" => to_string(Map.fetch!(fields, :scenario)),
      "run_id" => Map.fetch!(opts, :run_id),
      "outcome" => to_string(Map.fetch!(fields, :outcome)),
      "reason" => Map.get(fields, :reason),
      "oracle_out" => Map.get(fields, :oracle_out),
      "verified" => Map.get(fields, :verified, %{}),
      "replay" => %{
        "oracle_bin" => Map.fetch!(opts, :oracle_bin)
      }
    }

    path = receipt_path(opts)
    File.mkdir_p!(Path.dirname(path))
    File.write!(path, JSON.encode!(receipt))
    path
  end

  defp ensure_failure_receipt!(scenario, opts, reason) do
    path = receipt_path(opts)

    if File.exists?(path) do
      path
    else
      write_receipt!(opts, %{
        scenario: scenario,
        outcome: :refused,
        reason: failure_reason_text(reason),
        oracle_out: nil,
        verified: %{}
      })
    end
  end

  defp principal_reason(error) do
    case find_tagged_reason(error) do
      {:ok, reason} -> reason
      :error -> {:rf3_ocel_failed, error}
    end
  end

  defp find_tagged_reason(%{errors: errors}) when is_list(errors) do
    Enum.reduce_while(errors, :error, fn e, :error ->
      case find_tagged_reason(e) do
        {:ok, _} = found -> {:halt, found}
        :error -> {:cont, :error}
      end
    end)
  end

  defp find_tagged_reason(%{error: {:refused, _} = tagged}), do: {:ok, tagged}
  defp find_tagged_reason(%{error: {:assertion_failed, _} = inner}), do: {:ok, {:refused, inner}}
  defp find_tagged_reason(%{error: {:oracle_failed, _} = inner}), do: {:ok, {:refused, inner}}
  defp find_tagged_reason(%{error: nested}), do: find_tagged_reason(nested)
  defp find_tagged_reason(_other), do: :error

  defp failure_reason_text({:refused, reason}) when is_binary(reason), do: reason
  defp failure_reason_text({:refused, reason}), do: inspect(reason)
  defp failure_reason_text({:oracle_failed, inner}), do: "oracle failed: #{inspect(inner)}"
  defp failure_reason_text({:assertion_failed, inner}), do: "assertion failed: #{inspect(inner)}"
  defp failure_reason_text(other), do: inspect(other)
end
