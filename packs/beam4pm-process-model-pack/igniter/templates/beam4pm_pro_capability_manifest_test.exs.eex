<%
# ggen_igniter EEx template -> test/beam4pm_pro_capability_manifest_test.exs
# Bindings: NONE required -- fully static.
%># GENERATED by ggen_igniter from the beam4pm_pro_capability_manifest static template. Do not edit.
defmodule BeamPM.Pro.CapabilityManifestTest do
  use ExUnit.Case, async: true

  alias BeamPM.Pro.CapabilityManifest

  test "capabilities/0 returns a non-empty list of well-shaped facts" do
    facts = CapabilityManifest.capabilities()
    assert facts != []

    for fact <- facts do
      assert Map.has_key?(fact, :capability)
      assert Map.has_key?(fact, :status)
      assert Map.has_key?(fact, :evidence)
      assert fact.status in [:alive, :partial, :blocked, :unsupported, :unverified]
      assert is_list(fact.evidence)
    end
  end

  test "capabilities/0 is deterministically sorted by capability atom" do
    facts = CapabilityManifest.capabilities()
    assert Enum.sort_by(facts, & &1.capability) == facts
  end

  test "capabilities/0 is stable across repeated calls" do
    assert CapabilityManifest.capabilities() == CapabilityManifest.capabilities()
  end

  test "admitted_record_types reflects the real BeamPM.Types.Manifest count" do
    fact = CapabilityManifest.capability(:admitted_record_types)
    assert fact.status == :alive
    real_count = length(BeamPM.Types.Manifest.record_names())
    assert Enum.any?(fact.evidence, &String.contains?(&1, "#{real_count} admitted types"))
  end

  test "rust4pm_wasm_engine status matches the real BeamPM.Rust4PM.wasm_built?/0 delegate" do
    fact = CapabilityManifest.capability(:rust4pm_wasm_engine)
    expected = if BeamPM.Rust4PM.wasm_built?(), do: :alive, else: :unsupported
    assert fact.status == expected
  end

  test "capability/1 returns nil for an unknown atom" do
    assert CapabilityManifest.capability(:nonexistent_capability_xyz) == nil
  end

  test "status/1 and evidence_for/1 are consistent with capability/1" do
    fact = CapabilityManifest.capability(:admitted_record_types)
    assert CapabilityManifest.status(:admitted_record_types) == fact.status
    assert CapabilityManifest.evidence_for(:admitted_record_types) == fact.evidence
  end

  test "status/1 and evidence_for/1 degrade gracefully for an unknown atom" do
    assert CapabilityManifest.status(:nonexistent_capability_xyz) == nil
    assert CapabilityManifest.evidence_for(:nonexistent_capability_xyz) == []
  end

  test "verify/1 with an empty claimed map is vacuously consistent" do
    assert CapabilityManifest.verify(%{}) == {:ok, :consistent}
  end

  test "verify/1 round-trips: claiming exactly the real statuses is consistent" do
    claimed =
      CapabilityManifest.capabilities()
      |> Map.new(fn fact -> {fact.capability, fact.status} end)

    assert CapabilityManifest.verify(claimed) == {:ok, :consistent}
  end

  test "verify/1 catches one deliberately wrong claim" do
    real = CapabilityManifest.capability(:admitted_record_types)
    wrong_status = if real.status == :alive, do: :blocked, else: :alive

    assert {:error, {:contradicts, mismatches}} =
             CapabilityManifest.verify(%{admitted_record_types: wrong_status})

    assert mismatches == [
             %{capability: :admitted_record_types, claimed: wrong_status, actual: real.status}
           ]
  end

  test "verify/1 collects every mismatch, not just the first" do
    real_facts = CapabilityManifest.capabilities()
    [f1, f2 | _] = real_facts
    wrong1 = if f1.status == :alive, do: :blocked, else: :alive
    wrong2 = if f2.status == :alive, do: :blocked, else: :alive

    assert {:error, {:contradicts, mismatches}} =
             CapabilityManifest.verify(%{f1.capability => wrong1, f2.capability => wrong2})

    assert length(mismatches) == 2
  end

  test "verify/1 reports an unrecognized claimed capability as unknown_capability" do
    assert {:error, {:contradicts, [mismatch]}} =
             CapabilityManifest.verify(%{nonexistent_capability_xyz: :alive})

    assert mismatch == %{
             capability: :nonexistent_capability_xyz,
             claimed: :alive,
             actual: :unknown_capability
           }
  end
end
