<%
# ggen_igniter EEx template -> lib/beam4pm_claude_workflow_reactor.ex
#
# beam4pm-pro-revenue-suite practice family: BeamPM.ClaudeWorkflowReactor
# models the Claude Code multi-agent manufacturing workflow that built this
# very suite (Measure fan-out -> Design synthesis -> Develop fan-out ->
# sequential Actuate -> Qualify) as a real `use Reactor` DAG over the real
# subagent journal it left behind -- dogfooding the process-intelligence
# product on the process that manufactures it.
#
# Bindings: NONE required. Like beam4pm_rf1_dfg.ex.eex, this template is
# fully static -- the journal schema below was verified by directly reading
# every line of the real committed fixture
# (qualification/fixtures/claude-workflows/journal.jsonl, 38 JSONL events),
# not queried from RDF -- so it is rendered with `--ontology ontology.ttl`
# and a dummy `--query` its body never references.
%># GENERATED by ggen_igniter from the claude-workflow-reactor static template. Do not edit.
defmodule BeamPM.ClaudeWorkflowReactor do
  # Defined before @moduledoc so the moduledoc's `inspect(@phases)`
  # interpolation reads the real closed set, not an unset attribute.
  @phases [:measure, :design, :develop, :actuate, :qualify]

  @moduledoc """
  A real `use Reactor` DAG (plain `Reactor`, NOT `Ash.Reactor` -- same
  choice as `BeamPM.RF1.DfgDiscovery`) that reconstructs the wave structure
  of a Claude Code multi-agent manufacturing workflow from the workflow's
  own subagent journal (JSONL), and labels the waves with the ordinal
  manufacturing-phase shape the beam4pm suite itself was built under:
  Measure fan-out -> Design synthesis -> Develop fan-out -> sequential
  Actuate -> Qualify.

  ## Verified journal schema (the honesty constraint)

  The journal this module reads carries EXACTLY these keys, verified by
  reading every line of the real fixture
  (`qualification/fixtures/claude-workflows/journal.jsonl`) rather than
  assumed from documentation:

    * `started` events: `{"type", "key", "agentId"}` -- nothing else.
    * `result` events: `{"type", "key", "agentId", "result"}` -- nothing else.

  There are NO timestamps and NO phase fields anywhere in the journal.
  Two consequences are therefore part of this module's contract, not
  implementation detail:

    * `ordinal_span` is JOURNAL-LINE distance -- `{first started line,
      last result line}` over a wave's agents -- and must NEVER be read or
      presented as wall-clock duration. No wall-clock claim is derivable
      from this data, so none is made.
    * Phase labels are an ORDINAL HEURISTIC over wave structure, not
      recorded facts. The exact, total labeling rule: the first wave is
      `:measure` (the initial fan-out); the final wave, when at least two
      waves exist, is `:qualify`; an interior multi-agent wave (2+ agents)
      is `:develop`; an interior singleton wave before any `:develop` wave
      is `:design` (synthesis); an interior singleton wave after a
      `:develop` wave is `:actuate` (sequential actuation). The closed
      label set is `#{inspect(@phases)}`.

  ## Wave derivation (single ordered scan)

  A `started` event opens a NEW wave iff at least one `result` event has
  intervened since the previous `started` event (the very first `started`
  always opens a wave); otherwise it extends the current wave. This is the
  concurrency structure the journal actually records: an unbroken run of
  `started` lines is one fan-out, and a `result` landing in between means
  the orchestrator began collecting before dispatching again.

  ## Steps

    * `:parse_journal` -- reads the file, JSON-decodes every non-empty
      line, validates the verified schema above; a line that fails either
      is the typed refusal `{:error, {:malformed_journal_line, n}}` (real
      file line number), never a silent skip.
    * `:derive_waves` -- the ordered scan above, plus each wave's
      `ordinal_span`.
    * `:label_phases` -- the ordinal heuristic above.
    * `:receipt` -- `%{total_agents, waves: [%{phase, agent_count,
      agent_ids, ordinal_span}], journal_sha256}`; `total_agents` counts
      DISTINCT started agentIds; `journal_sha256` is the lowercase hex
      SHA-256 of the exact journal bytes read, binding the receipt to its
      evidence.

  Why beam4pm models its own manufacturing workflow: the product's claim is
  that real operational processes can be reconstructed from the event data
  they already emit. The workflow that manufactured this suite emitted a
  journal; refusing to mine it would be exempting ourselves from our own
  claim.
  """

  use Reactor

  input(:journal_path)

  # side_effect: read-only file IO. Refusals are typed, never silent:
  # an unreadable path and a malformed line are distinct error shapes.
  step :parse_journal do
    argument(:journal_path, input(:journal_path))

    run(fn %{journal_path: path}, _context ->
      with {:ok, bytes} <- read_journal(path),
           {:ok, entries} <- decode_lines(bytes) do
        {:ok,
         %{
           entries: entries,
           journal_sha256: Base.encode16(:crypto.hash(:sha256, bytes), case: :lower)
         }}
      end
    end)

    max_retries(0)
  end

  # side_effect: pure -- the single ordered scan documented in the
  # moduledoc, over the already-validated entries.
  step :derive_waves do
    argument(:parsed, result(:parse_journal))

    run(fn %{parsed: parsed}, _context ->
      {:ok, derive_waves(parsed.entries)}
    end)

    max_retries(0)
  end

  # side_effect: pure -- the ordinal phase heuristic documented in the
  # moduledoc, over the derived waves.
  step :label_phases do
    argument(:waves, result(:derive_waves))

    run(fn %{waves: waves}, _context ->
      {:ok, label_phases(waves)}
    end)

    max_retries(0)
  end

  # side_effect: pure -- assembles the receipt, binding it to the journal
  # bytes via the sha256 computed in :parse_journal.
  step :receipt do
    argument(:parsed, result(:parse_journal))
    argument(:labeled, result(:label_phases))

    run(fn %{parsed: parsed, labeled: labeled}, _context ->
      total_agents =
        parsed.entries
        |> Enum.filter(&(&1.type == "started"))
        |> Enum.map(& &1.agent_id)
        |> Enum.uniq()
        |> length()

      {:ok,
       %{
         total_agents: total_agents,
         waves:
           Enum.map(labeled, fn wave ->
             %{
               phase: wave.phase,
               agent_count: length(wave.agent_ids),
               agent_ids: wave.agent_ids,
               ordinal_span: wave.ordinal_span
             }
           end),
         journal_sha256: parsed.journal_sha256
       }}
    end)

    max_retries(0)
  end

  return(:receipt)

  # -- Public entry point -----------------------------------------------

  @doc """
  Runs the workflow-reconstruction Reactor pipeline over the journal at
  `journal_path` (mirrors `BeamPM.RF1.DfgDiscovery.run/2`'s
  `Reactor.run(__MODULE__, ..., async?: false)` pattern).

  Returns `{:ok, receipt}` (see the `:receipt` step's shape in the
  moduledoc), or a typed error unwrapped from Reactor's error class:
  `{:error, {:journal_unreadable, path, posix_reason}}` or
  `{:error, {:malformed_journal_line, n}}`.
  """
  @spec run(String.t()) :: {:ok, map()} | {:error, term()}
  def run(journal_path) when is_binary(journal_path) do
    {:ok, _} = Application.ensure_all_started(:reactor)

    case Reactor.run(__MODULE__, %{journal_path: journal_path}, %{}, async?: false) do
      {:ok, receipt} ->
        {:ok, receipt}

      {:error, error} ->
        case tagged_reasons(error) do
          [{_step, reason} | _] -> {:error, reason}
          [] -> {:error, {:unexpected_reactor_error, error}}
        end
    end
  end

  @doc """
  Public, directly-testable wave derivation (used by `:derive_waves`).

  Takes the validated entry list (`%{line:, type:, agent_id:}` maps, in
  journal order) and returns waves as `%{agent_ids: [...],
  ordinal_span: {first_started_line, last_result_line}}` maps, in order.
  `last_result_line` is `nil` when no result event exists for any of the
  wave's agents (never a fabricated line number).
  """
  @spec derive_waves([map()]) :: [map()]
  def derive_waves(entries) when is_list(entries) do
    {waves_rev, _result_since_last_started} =
      Enum.reduce(entries, {[], true}, fn entry, {waves, result_since_last_started} ->
        case entry.type do
          "started" ->
            waves =
              if result_since_last_started do
                [%{agent_ids: [], started_lines: []} | waves]
              else
                waves
              end

            [wave | rest] = waves

            wave = %{
              wave
              | agent_ids: wave.agent_ids ++ [entry.agent_id],
                started_lines: wave.started_lines ++ [entry.line]
            }

            {[wave | rest], false}

          "result" ->
            {waves, true}
        end
      end)

    result_lines =
      entries
      |> Enum.filter(&(&1.type == "result"))
      |> Enum.reduce(%{}, fn e, acc -> Map.update(acc, e.agent_id, e.line, &max(&1, e.line)) end)

    waves_rev
    |> Enum.reverse()
    |> Enum.map(fn wave ->
      first_started = List.first(wave.started_lines)

      last_result =
        wave.agent_ids
        |> Enum.map(&Map.get(result_lines, &1))
        |> Enum.reject(&is_nil/1)
        |> case do
          [] -> nil
          lines -> Enum.max(lines)
        end

      %{agent_ids: wave.agent_ids, ordinal_span: {first_started, last_result}}
    end)
  end

  @doc """
  Public, directly-testable ordinal phase labeling (used by
  `:label_phases`): first wave `:measure`; final wave `:qualify` when at
  least two waves exist; interior multi-agent wave `:develop`; interior
  singleton `:design` before any `:develop`, `:actuate` after one. Total
  over every wave list; labels drawn only from `#{inspect(@phases)}`.
  """
  @spec label_phases([map()]) :: [map()]
  def label_phases(waves) when is_list(waves) do
    n = length(waves)

    {labeled, _develop_seen} =
      waves
      |> Enum.with_index()
      |> Enum.map_reduce(false, fn {wave, idx}, develop_seen ->
        phase =
          cond do
            idx == 0 -> :measure
            idx == n - 1 -> :qualify
            length(wave.agent_ids) >= 2 -> :develop
            develop_seen -> :actuate
            true -> :design
          end

        {Map.put(wave, :phase, phase), develop_seen or phase == :develop}
      end)

    labeled
  end

  @doc "The closed phase-label set."
  @spec phases() :: [atom()]
  def phases, do: @phases

  # -- Internal helpers ------------------------------------------------------

  defp read_journal(path) do
    case File.read(path) do
      {:ok, bytes} -> {:ok, bytes}
      {:error, reason} -> {:error, {:journal_unreadable, path, reason}}
    end
  end

  defp decode_lines(bytes) do
    bytes
    |> String.split("\n")
    |> Enum.with_index(1)
    |> Enum.reject(fn {line, _n} -> line == "" end)
    |> Enum.reduce_while({:ok, []}, fn {line, n}, {:ok, acc} ->
      case decode_line(line, n) do
        {:ok, entry} -> {:cont, {:ok, [entry | acc]}}
        {:error, _} = err -> {:halt, err}
      end
    end)
    |> case do
      {:ok, acc} -> {:ok, Enum.reverse(acc)}
      err -> err
    end
  end

  # Validates the VERIFIED schema, not a guessed one: `started` carries
  # exactly {type, key, agentId}; `result` additionally carries `result`.
  # Anything else -- bad JSON, an unknown type, a missing key -- is the
  # same typed refusal, with the real file line number.
  defp decode_line(line, n) do
    case JSON.decode(line) do
      {:ok, %{"type" => "started", "agentId" => agent_id, "key" => key}}
      when is_binary(agent_id) and is_binary(key) ->
        {:ok, %{line: n, type: "started", agent_id: agent_id}}

      {:ok, %{"type" => "result", "agentId" => agent_id, "key" => key, "result" => _result}}
      when is_binary(agent_id) and is_binary(key) ->
        {:ok, %{line: n, type: "result", agent_id: agent_id}}

      {:ok, _other_shape} ->
        {:error, {:malformed_journal_line, n}}

      {:error, _} ->
        {:error, {:malformed_journal_line, n}}
    end
  end

  # Pulls the real per-step `{step_name, tagged_reason}` pairs back out of
  # Reactor's nested Splode error class (same structural matching as
  # `BeamPM.RF1.DfgDiscovery.tagged_reasons/1`).
  defp tagged_reasons(%{errors: errors}) when is_list(errors) do
    Enum.flat_map(errors, &tagged_reasons/1)
  end

  defp tagged_reasons(%{step: %{name: name}, error: reason}) do
    [{name, reason}]
  end

  defp tagged_reasons(%{error: nested}), do: tagged_reasons(nested)
  defp tagged_reasons(_other), do: []
end
