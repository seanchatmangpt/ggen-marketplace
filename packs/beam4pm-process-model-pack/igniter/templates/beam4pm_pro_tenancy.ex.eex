# ggen_igniter EEx template -> lib/beam4pm_pro_tenancy.ex
#
# beam4pm_pro gap-closure item PRO-010 ("principal/tenant/RBAC model"): a
# canonical principal/tenant/role/capability + data-boundary policy for any
# future web/API/agent surface -- fail-closed by construction.
#
# Bindings: NONE required -- fully static.
%># GENERATED by ggen_igniter from the beam4pm_pro_tenancy static template. Do not edit.
defmodule BeamPM.Pro.Tenancy do
  @moduledoc """
  Principal/tenant/RBAC model for `beam4pm_pro` gap-closure item PRO-010.

  `authorize/3` checks tenant boundary BEFORE role/capability, deliberately:
  cross-tenant access is the cheapest and most fundamental refusal (a
  structural identity mismatch, not a permissions question), and checking
  it first means a caller can never reach role logic for a resource outside
  their tenant, even by omission or a role-map bug. There is no default-allow
  path -- a principal whose role is not in `@role_capabilities` is refused,
  not silently granted the capability.
  """

  @type tenant_id :: String.t()
  @type capability :: :read | :write | :admin

  @type principal :: %{
          id: String.t(),
          tenant_id: tenant_id(),
          roles: [atom()]
        }

  @type authorize_result ::
          :ok
          | {:error, {:cross_tenant, tenant_id(), tenant_id()}}
          | {:error, {:insufficient_role, [atom()], capability()}}

  @role_capabilities %{
    admin: [:read, :write, :admin],
    editor: [:read, :write],
    viewer: [:read]
  }

  @doc "The static role -> granted-capabilities map."
  @spec role_capabilities() :: %{atom() => [capability()]}
  def role_capabilities, do: @role_capabilities

  @doc """
  Authorize `principal` for `capability` on a resource owned by
  `resource_tenant_id`. Tenant boundary is checked FIRST and fails closed;
  only a same-tenant principal proceeds to the role/capability check, which
  also fails closed for any role not present in `role_capabilities/0`.
  """
  @spec authorize(principal(), tenant_id(), capability()) :: authorize_result()
  def authorize(%{tenant_id: principal_tenant} = principal, resource_tenant_id, capability)
      when is_binary(resource_tenant_id) and capability in [:read, :write, :admin] do
    cond do
      principal_tenant != resource_tenant_id ->
        {:error, {:cross_tenant, principal_tenant, resource_tenant_id}}

      has_capability?(principal.roles, capability) ->
        :ok

      true ->
        {:error, {:insufficient_role, principal.roles, capability}}
    end
  end

  defp has_capability?(roles, capability) when is_list(roles) do
    Enum.any?(roles, fn role ->
      capability in Map.get(@role_capabilities, role, [])
    end)
  end
end
