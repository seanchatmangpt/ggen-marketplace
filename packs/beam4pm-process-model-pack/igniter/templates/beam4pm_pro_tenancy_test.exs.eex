<%
# ggen_igniter EEx template -> test/beam4pm_pro_tenancy_test.exs
# Bindings: NONE required -- fully static.
%># GENERATED by ggen_igniter from the beam4pm_pro_tenancy static template. Do not edit.
defmodule BeamPM.Pro.TenancyTest do
  use ExUnit.Case, async: true

  alias BeamPM.Pro.Tenancy

  test "same-tenant admin is allowed every capability" do
    admin = %{id: "u1", tenant_id: "acme", roles: [:admin]}
    assert Tenancy.authorize(admin, "acme", :read) == :ok
    assert Tenancy.authorize(admin, "acme", :write) == :ok
    assert Tenancy.authorize(admin, "acme", :admin) == :ok
  end

  test "same-tenant viewer is denied write" do
    viewer = %{id: "u2", tenant_id: "acme", roles: [:viewer]}
    assert Tenancy.authorize(viewer, "acme", :read) == :ok
    assert Tenancy.authorize(viewer, "acme", :write) ==
             {:error, {:insufficient_role, [:viewer], :write}}
  end

  test "cross-tenant admin is denied even though the role would otherwise suffice -- proves tenant check runs first" do
    admin = %{id: "u3", tenant_id: "acme", roles: [:admin]}

    assert Tenancy.authorize(admin, "other-corp", :read) ==
             {:error, {:cross_tenant, "acme", "other-corp"}}
  end

  test "an unrecognized role is denied, never a default-allow" do
    unknown_role = %{id: "u4", tenant_id: "acme", roles: [:totally_unrecognized_role]}

    assert Tenancy.authorize(unknown_role, "acme", :read) ==
             {:error, {:insufficient_role, [:totally_unrecognized_role], :read}}
  end

  test "a principal with no roles at all is denied every capability" do
    no_roles = %{id: "u5", tenant_id: "acme", roles: []}
    assert Tenancy.authorize(no_roles, "acme", :read) ==
             {:error, {:insufficient_role, [], :read}}
  end

  test "editor role grants read and write but not admin" do
    editor = %{id: "u6", tenant_id: "acme", roles: [:editor]}
    assert Tenancy.authorize(editor, "acme", :read) == :ok
    assert Tenancy.authorize(editor, "acme", :write) == :ok

    assert Tenancy.authorize(editor, "acme", :admin) ==
             {:error, {:insufficient_role, [:editor], :admin}}
  end

  test "a principal with multiple roles is granted if any role has the capability" do
    multi = %{id: "u7", tenant_id: "acme", roles: [:viewer, :editor]}
    assert Tenancy.authorize(multi, "acme", :write) == :ok
  end

  test "role_capabilities/0 exposes the static map with no default-allow entry" do
    caps = Tenancy.role_capabilities()
    refute Map.has_key?(caps, :guest)
    assert caps[:admin] == [:read, :write, :admin]
  end
end
