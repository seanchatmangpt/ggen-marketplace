# beam4pm-process-model-pack vocabulary and reusable governed kernel.
#
# Consumer process-mining record definitions remain consumer-owned. The pack
# additionally supplies one reusable execution-kernel contract whose purpose is
# infrastructure: it defines the lawful lifecycle used by the generated
# governor itself, not a domain/business process.

@prefix bpm:  <https://ggen.dev/ontology/beam-process-model#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

bpm:RecordType a rdfs:Class ;
    rdfs:label "Record Type" ;
    rdfs:comment "One admitted BEAM record/struct type projected into generated code." .

bpm:Field a rdfs:Class ;
    rdfs:label "Field" ;
    rdfs:comment "One typed, ordered field belonging to a bpm:RecordType." .

bpm:recordName a rdf:Property ; rdfs:domain bpm:RecordType ; rdfs:range xsd:string .
bpm:recordDoc a rdf:Property ; rdfs:domain bpm:RecordType ; rdfs:range xsd:string .
bpm:hasField a rdf:Property ; rdfs:domain bpm:RecordType ; rdfs:range bpm:Field .
bpm:fieldName a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string .
bpm:fieldType a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string ;
    rdfs:comment "Closed set: string, integer, float, boolean, datetime, atom, list_string, map." .
bpm:fieldDoc a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string .
bpm:fieldRequired a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string ;
    rdfs:comment "Plain string literal true or false; templates compare it as a string." .
bpm:fieldOrder a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:integer .

# --- Shared field-type vocabulary (2026-09-04) ------------------------
#
# Externalizes the bpm:fieldType -> per-language-representation mapping as
# a single, SPARQL-joinable ontology fact instead of the same 8-branch
# if/elif dispatch ladder repeated in every consuming template (measured
# before this change: 26 "field_type ==" comparisons across 12 template
# files in this pack alone). Every affected template's `fields` query now
# performs one generic JOIN against this vocabulary via the existing
# ?f bpm:fieldType ?field_type binding and a matching bpm:FieldType
# individual's bpm:fieldTypeName -- admitting a 9th field type means
# adding ONE bpm:FieldType individual here; it touches ZERO template
# files (the prior architecture required editing 12 template files plus
# this file's own enum comment plus gates/020_field_type_enum.rq -- 14
# sites -- for the same change).
#
# A field_type with no matching bpm:FieldType individual now makes that
# field DISAPPEAR from every affected template's `fields` result set (a
# visible, mandatory-JOIN empty-match failure) rather than the prior
# silent gap this exact duplication produced in
# templates/beam4pm_types.schema.json.tmpl (an if/elif chain with no
# else/default branch: a field type falling through every arm emitted a
# JSON Schema property with no "type" key and no generator error).
#
# The literal token __FIELD__ inside a sample*Expr value below is plain
# string data (not Turtle or Tera syntax), substituted at render time via
# Tera's `replace` filter with the field's own bpm:fieldName. Only the
# "string" type's samples use it -- it is the only type whose original
# hand-written literals were field-name-parameterized (every other type
# used a fixed literal regardless of field name).

bpm:FieldType a rdfs:Class ;
    rdfs:label "Field Type" ;
    rdfs:comment "One admitted value of the closed bpm:fieldType vocabulary (string, integer, float, boolean, datetime, atom, list_string, map), carrying every per-language projection (Erlang, Elixir, Gleam, JSON Schema, Ash) and sample-value fact so templates fetch a resolved expression by SPARQL JOIN instead of hardcoding a duplicated if/elif dispatch ladder." .

bpm:fieldTypeName a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Matches a bpm:Field's bpm:fieldType literal value exactly." .
bpm:erlangTypeExpr a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Erlang typespec expression, e.g. binary()." .
bpm:elixirTypeExpr a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Elixir @type expression, e.g. String.t()." .
bpm:gleamTypeExpr a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Gleam type expression, e.g. String. Two disclosed projection divergences from Erlang/Elixir (atom -> String, map -> dict.Dict(String, String)) are real projection facts here, not a template-level special case." .
bpm:jsonSchemaType a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "JSON Schema draft-07 \"type\" value." .
bpm:jsonSchemaItemsType a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Empty string unless jsonSchemaType is array, in which case the array's \"items\".\"type\" value." .
bpm:isAtomCodec a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Plain string literal true or false (same convention as bpm:fieldRequired): whether beam4pm_codec/BeamPM.Codec must atom_to_binary/binary_to_atom-convert this type's values." .
bpm:ashTypeExpr a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Ash attribute type expression (source text) for the fourth sibling projection (VISION-2030 section 4/23 Polyglot BEAM), e.g. :string or {:array, :string}. JOINed by igniter/queries/ash_fields.rq into both igniter Ash templates in place of the former hardcoded 8-branch dispatch ladder, so an unmapped type is a visible, named render refusal instead of a FunctionClauseError. datetime is :utc_datetime_usec, never :utc_datetime -- Ash's :utc_datetime is constraints: [precision: :second] and truncates the microseconds every other leg carries verbatim on the wire (measured: 12:00:00.123456Z read back as 12:00:00Z, DateTime.compare :lt). gates/035_field_type_ash_expr.rq refuses a bpm:FieldType carrying anything but exactly one value." .
bpm:sampleMinErlang a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Minimal fixed Erlang sample literal used by beam4pm_types_tests.erl (constructor-only tests, not codec/roundtrip)." .
bpm:sampleMinElixir a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Minimal fixed Elixir sample literal used by beam4pm_types_test.exs (constructor-only tests, not codec/roundtrip)." .
bpm:sampleErlang a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Codec/roundtrip Erlang sample INPUT literal (beam4pm_codec_tests.erl, beam4pm_roundtrip.erl). May contain __FIELD__." .
bpm:sampleErlangEncoded a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "The sampleErlang value after round-tripping through beam4pm_codec:to_map/1 -- differs from sampleErlang only for atom (binary-ified). May contain __FIELD__." .
bpm:sampleElixir a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Codec/roundtrip Elixir sample INPUT literal (beam4pm_codec_test.exs, beam4pm_roundtrip.ex). May contain __FIELD__." .
bpm:sampleElixirEncoded a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "The sampleElixir value after round-tripping through BeamPM.Codec.to_map/1 -- differs from sampleElixir only for atom (string-ified). May contain __FIELD__." .

bpm:FieldType_string a bpm:FieldType ;
    bpm:fieldTypeName "string" ;
    bpm:erlangTypeExpr "binary()" ;
    bpm:elixirTypeExpr "String.t()" ;
    bpm:gleamTypeExpr "String" ;
    bpm:jsonSchemaType "string" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":string" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "<<\"x\">>" ;
    bpm:sampleMinElixir "\"x\"" ;
    bpm:sampleErlang "<<\"sample___FIELD__\">>" ;
    bpm:sampleErlangEncoded "<<\"sample___FIELD__\">>" ;
    bpm:sampleElixir "\"sample___FIELD__\"" ;
    bpm:sampleElixirEncoded "\"sample___FIELD__\"" .

bpm:FieldType_integer a bpm:FieldType ;
    bpm:fieldTypeName "integer" ;
    bpm:erlangTypeExpr "integer()" ;
    bpm:elixirTypeExpr "integer()" ;
    bpm:gleamTypeExpr "Int" ;
    bpm:jsonSchemaType "integer" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":integer" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "1" ;
    bpm:sampleMinElixir "1" ;
    bpm:sampleErlang "42" ;
    bpm:sampleErlangEncoded "42" ;
    bpm:sampleElixir "42" ;
    bpm:sampleElixirEncoded "42" .

bpm:FieldType_float a bpm:FieldType ;
    bpm:fieldTypeName "float" ;
    bpm:erlangTypeExpr "float()" ;
    bpm:elixirTypeExpr "float()" ;
    bpm:gleamTypeExpr "Float" ;
    bpm:jsonSchemaType "number" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":float" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "1.0" ;
    bpm:sampleMinElixir "1.0" ;
    bpm:sampleErlang "3.5" ;
    bpm:sampleErlangEncoded "3.5" ;
    bpm:sampleElixir "3.5" ;
    bpm:sampleElixirEncoded "3.5" .

bpm:FieldType_boolean a bpm:FieldType ;
    bpm:fieldTypeName "boolean" ;
    bpm:erlangTypeExpr "boolean()" ;
    bpm:elixirTypeExpr "boolean()" ;
    bpm:gleamTypeExpr "Bool" ;
    bpm:jsonSchemaType "boolean" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":boolean" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "true" ;
    bpm:sampleMinElixir "true" ;
    bpm:sampleErlang "true" ;
    bpm:sampleErlangEncoded "true" ;
    bpm:sampleElixir "true" ;
    bpm:sampleElixirEncoded "true" .

bpm:FieldType_datetime a bpm:FieldType ;
    bpm:fieldTypeName "datetime" ;
    bpm:erlangTypeExpr "binary()" ;
    bpm:elixirTypeExpr "String.t()" ;
    bpm:gleamTypeExpr "String" ;
    bpm:jsonSchemaType "string" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":utc_datetime_usec" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "<<\"2026-01-01T00:00:00Z\">>" ;
    bpm:sampleMinElixir "\"2026-01-01T00:00:00Z\"" ;
    # The codec/roundtrip fixture carries all six microsecond digits on purpose:
    # datetime is an opaque binary()/String.t()/JSON string on the Erlang,
    # Elixir and JSON legs (it round-trips unchanged), while the Ash leg parses
    # it into a %DateTime{} -- so this is the one fixture that can catch an Ash
    # attribute type that silently truncates sub-second precision. A
    # no-fraction value here would make that truncation invisible to every
    # generated test (it was, until 2026-09-05).
    bpm:sampleErlang "<<\"2026-08-29T12:00:00.123456Z\">>" ;
    bpm:sampleErlangEncoded "<<\"2026-08-29T12:00:00.123456Z\">>" ;
    bpm:sampleElixir "\"2026-08-29T12:00:00.123456Z\"" ;
    bpm:sampleElixirEncoded "\"2026-08-29T12:00:00.123456Z\"" .

bpm:FieldType_atom a bpm:FieldType ;
    bpm:fieldTypeName "atom" ;
    bpm:erlangTypeExpr "atom()" ;
    bpm:elixirTypeExpr "atom()" ;
    bpm:gleamTypeExpr "String" ;
    bpm:jsonSchemaType "string" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":atom" ;
    bpm:isAtomCodec "true" ;
    bpm:sampleMinErlang "some_atom" ;
    bpm:sampleMinElixir ":some_atom" ;
    bpm:sampleErlang "sample_atom" ;
    bpm:sampleErlangEncoded "<<\"sample_atom\">>" ;
    bpm:sampleElixir ":sample_atom" ;
    bpm:sampleElixirEncoded "\"sample_atom\"" .

bpm:FieldType_list_string a bpm:FieldType ;
    bpm:fieldTypeName "list_string" ;
    bpm:erlangTypeExpr "[binary()]" ;
    bpm:elixirTypeExpr "[String.t()]" ;
    bpm:gleamTypeExpr "List(String)" ;
    bpm:jsonSchemaType "array" ;
    bpm:jsonSchemaItemsType "string" ;
    bpm:ashTypeExpr "{:array, :string}" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "[<<\"a\">>]" ;
    bpm:sampleMinElixir "[\"a\"]" ;
    bpm:sampleErlang "[<<\"alpha\">>, <<\"beta\">>]" ;
    bpm:sampleErlangEncoded "[<<\"alpha\">>, <<\"beta\">>]" ;
    bpm:sampleElixir "[\"alpha\", \"beta\"]" ;
    bpm:sampleElixirEncoded "[\"alpha\", \"beta\"]" .

bpm:FieldType_map a bpm:FieldType ;
    bpm:fieldTypeName "map" ;
    bpm:erlangTypeExpr "map()" ;
    bpm:elixirTypeExpr "map()" ;
    bpm:gleamTypeExpr "dict.Dict(String, String)" ;
    bpm:jsonSchemaType "object" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":map" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "#{}" ;
    bpm:sampleMinElixir "%{}" ;
    bpm:sampleErlang "#{<<\"k\">> => <<\"v\">>}" ;
    bpm:sampleErlangEncoded "#{<<\"k\">> => <<\"v\">>}" ;
    bpm:sampleElixir "%{\"k\" => \"v\"}" ;
    bpm:sampleElixirEncoded "%{\"k\" => \"v\"}" .

# NOTE (2026-08-30): an earlier revision of this file added a
# "post-LLM governed execution vocabulary" (bpm:ProcessContract,
# bpm:TransitionSpec, bpm:governed_kernel and 8 sibling classes) plus a
# hand-rolled BeamPM.Governor template pair. A 4-lens adversarial audit
# (CONFIRMED_CRITICAL on every lens) found it duplicated the real, tested
# BeamPM.Actuation Reactor pipeline with zero shared code, performed ZERO
# real I/O despite claiming to be a BRCE actuation boundary, used a receipt
# schema un-mineable by BeamPM.Discovery, crashed unhandled on malformed
# input, and — critically — accepted a forged authority_digest without
# verifying it was ever computed by the module itself. It was also never
# actually consumed by beam4pm (the submodule pin predated it). Removed
# entirely and replaced by BeamPM.ProcessGovernor
# (igniter/templates/beam4pm_process_governor.ex.eex), which adds the one
# legitimate capability the original had (named, ordered, exact-state-hash-
# fenced multi-step process governance) as a thin layer that DELEGATES
# every admit/execute/receipt decision to the real BeamPM.Actuation --
# never reimplementing it. See docs/first-principles-rewrite-rationale.md
# in the consuming project for the full audit-to-rewrite record.

# --- Hand-authored-source admission vocabulary (2026-09-05) --------------
#
# VISION-2030 section 2 requires that a direct (non-manufactured) source
# intervention be "visible, bounded, and counted as manufacturing debt", and
# section 24 names "ggen-only manufacture requires routine privileged
# handwritten source commits" as a falsifier of the whole thesis. Before
# this vocabulary existed, a consumer had no way to STATE that a file under
# a manufactured root (src/, lib/, test/, gleam/src, ...) is hand-authored
# on purpose: the only provenance signal was the per-file "GENERATED by
# ggen" marker, so an unmarked file was simply invisible to every gate
# (gate_m2_check.sh only ever looks for MARKED files) and the doctrine's
# privileged-exception path only covered edits to files that already carry
# the marker. beam4pm measured 33 such unmarked files (12 native-engine
# facades, 14 hand-authored ExUnit qualification files, 1 OTP app resource
# file, 6 hand-authored reference docs) with zero admission records.
#
# One bpm:HandAuthoredSource individual per unmarked file (declared in the
# CONSUMER's ontology.ttl, never here) turns that prose falsifier into a
# mechanical check: templates/beam4pm_hand_authored_source.tsv.tmpl renders
# the admitted set as a machine-readable manifest, the consumer's
# scripts/gate_authorship_check.sh diffs it against the real tree (refusing
# an unmarked file with no individual, an individual whose path is gone, an
# individual whose file now carries the marker, a content-sha256 drift, an
# expired admission), templates/beam4pm_hand_authored_source.md.tmpl
# renders the same set as a counted reference doc, and
# templates/beam4pm_authorship_gate_test.exs.tmpl renders the Chicago test
# that runs the real gate as a subprocess against the real tree AND against
# planted temp fixtures that must be refused.
#
# bpm:AuthorshipKind is a CLOSED vocabulary (gates/060 anti-joins against
# it, exactly like gates/020 does for bpm:FieldType), each kind carrying
# bpm:countsAsDebt and a bpm:debtCeiling that gates/070 enforces as a hard
# per-kind count ceiling -- so the class cannot quietly become the place
# where hand-authoring gets normalized. Raising a ceiling is a visible edit
# to THIS file, reviewed as a pack change, never an ambient grant.

bpm:AuthorshipKind a rdfs:Class ;
    rdfs:label "Authorship Kind" ;
    rdfs:comment "Closed vocabulary of reasons a file under a manufactured root may lawfully lack ggen provenance. Each kind states whether it is counted as manufacturing debt (VISION-2030 section 2) and the maximum number of admitted files it may hold." .

bpm:authorshipKindName a rdf:Property ; rdfs:domain bpm:AuthorshipKind ; rdfs:range xsd:string ;
    rdfs:comment "Stable snake_case key joined by bpm:HandAuthoredSource individuals (via bpm:authorshipKind) and printed into the manifest." .
bpm:authorshipKindDoc a rdf:Property ; rdfs:domain bpm:AuthorshipKind ; rdfs:range xsd:string .
bpm:countsAsDebt a rdf:Property ; rdfs:domain bpm:AuthorshipKind ; rdfs:range xsd:string ;
    rdfs:comment "Plain string literal true or false; templates and the shell gate compare it as a string (same convention as bpm:fieldRequired). true: every file of this kind is counted as manufacturing debt and must carry bpm:contentSha256 + bpm:admissionExpires + bpm:sunsetPlan." .
bpm:debtCeiling a rdf:Property ; rdfs:domain bpm:AuthorshipKind ; rdfs:range xsd:integer ;
    rdfs:comment "Hard maximum number of bpm:HandAuthoredSource individuals that may name this kind; gates/070_hand_authored_source_ceiling.rq refuses the whole sync when exceeded." .

bpm:AuthorshipKind_native_engine_facade a bpm:AuthorshipKind ;
    bpm:authorshipKindName "native_engine_facade" ;
    bpm:countsAsDebt "true" ;
    bpm:debtCeiling 7 ;
    bpm:authorshipKindDoc "A thin, delegation-only BEAM facade (Erlang / Elixir / Gleam) over ONE native engine hosted via wasm whose surface has NOT yet been admitted as bpm:Engine / bpm:EngineOp facts. Since pack 0.1.17 templates/beam4pm_engine.{ex,erl,gleam}.tmpl render every admitted engine's three facades, so this kind is the shrinking remainder (ferroplan, rust4pm in the reference consumer; petgraph and tract are manufactured). Ceiling lowered 12 -> 6 when those two converted: a converted engine cannot quietly return to hand-authoring. Ceiling raised 6 -> 7 (2026-09-18, v26.9.18 autofde-lab parity wave integration): the wave's two lib facades -- lib/beam4pm_dfcm.ex (planning crown + standalone AutoFDE CLI bridge, wrappers by agents P1/P2/P3/P4/P5/P7) and lib/beam4pm_autofde_bridge.ex (persistent stdio port-bridge GenServer, agent P8) -- landed together in the parity/integration merge; both are real delegation-only seams over autofde-lab, disclosed and counted, not silently exempted." .

bpm:AuthorshipKind_hand_authored_qualification a bpm:AuthorshipKind ;
    bpm:authorshipKindName "hand_authored_qualification" ;
    bpm:countsAsDebt "true" ;
    bpm:debtCeiling 50 ;
    bpm:authorshipKindDoc "A hand-authored ExUnit qualification file under test/ (VISION-2030 section 2 lists tests-as-specification among lawful inputs, but this pack's convention manufactures every test from a template, so an unmanufactured test is counted as debt). Sunset: migrate its fixture bindings into ontology facts and render it from a .tmpl/.eex like the beam4pm_types_test.exs family. Ceiling raised 16 -> 24 (2026-09-09): a beam4pm branch-integration merge surfaced 8 real, pre-existing hand-authored files (lib/beam4pm_application.ex, lib/beam4pm_contracts.ex + test, lib/beam4pm_powl_discovery.ex + test, two new B4PM-1703/1709 mix tasks + tests, test/beam4pm_ws3_dfcm_self_healing_test.exs) that predate GATE AUTHORSHIP's own manufacture and were never previously surfaced as unadmitted debt -- disclosed and counted here, not silently exempted. Ceiling raised 24 -> 27 (2026-09-09, same session): B4PM-1702's single-record-patch codemod (lib/ggen_igniter/patch_field.ex, its mix task, and its test) is a deliberately hand-authored alternative manufacturing path -- the codemod's own capability IS being an alternative to a full EEx re-render, so it cannot itself be ggen output. Ceiling raised 27 -> 30 (2026-09-10, v26.9.10 release-candidate integration): feat/ocel-evidence-architecture's Phases 3/4/6 surfaced 3 real hand-authored files wiring/verifying the :telemetry->OcelEvent/OTel/BRCE evidence chain (BeamPM.Evidence.OtelBridge, BeamPM.Evidence.ReceiptBridge, and the generalized Chicago-style evidence-chain end-to-end test) -- none is a bpm:RecordType projection or template-rendered file, analogous to the already-admitted lib/beam4pm_application.ex and lib/beam4pm_ocel_ingest.ex. Ceiling raised 30 -> 32 (2026-09-11, HDDL/FOND FreedomGym plan-execute-conform loop, Step 5): 2 new real Chicago qualification tests for BeamPM.PowlConformance (test/beam4pm_powl_conformance_test.exs -- a real in-test OCEL log, real deviation detection; test/beam4pm_powl_conformance_e2e_test.exs -- the real cross-repo e2e leg reading ash_a2a's real captured OCEL ingest events) -- neither is a bpm:RecordType projection or template-rendered file; the conformance-orchestration module itself was admitted under native_engine_facade instead (no ceiling pressure there). Ceiling raised 32 -> 33 (2026-09-13, v26.9.12 branch-fleet integration merge): feat/eds-core's test/beam4pm_ws3_dfcm_self_healing-adjacent EDS qualification test surfaced alongside the independently-developed feat/ppcx-conformance-deviation-to-ontology branch's deviation-admission test in the same integration merge -- both are real, distinct hand-authored Chicago tests admitted concurrently on separate branches; neither duplicates the other, so both are disclosed and counted rather than one being silently dropped. Ceiling raised 33 -> 35 (2026-09-13, same v26.9.12 integration): the eds-core branch's own pre-existing lib/beam4pm_research_erc.ex (real ERC ledger reader) and lib/mix/tasks/eds.ledger.ex (real mix task over it) surfaced as previously-unadmitted debt in the same merge -- both real hand-authored files, disclosed and counted, not silently exempted. Ceiling raised 35 -> 44 (2026-09-18, v26.9.18 autofde-lab parity wave integration): the wave landed 9 real qualification files in one integration merge -- test/beam4pm_dfcm_test.exs (canonical bridge suite, previously uncommitted working-tree state), and the per-agent parity/consent qualifications test/beam4pm_dfcm_fabric_parity_test.exs (P1), test/beam4pm_dfcm_ocel_validate_parity_test.exs (P2), test/beam4pm_dfcm_sa2a_validate_card_test.exs (P3), test/beam4pm_sa2a_admit_parity_test.exs (P4), test/beam4pm_dfcm_sa2a_replay_test.exs (P5), test/beam4pm_dfcm_cmca_parity_test.exs (P7), test/beam4pm_autofde_bridge_test.exs (P8), test/beam4pm_graphlaw_parity_test.exs (P10) -- all real-engine Chicago qualifications against autofde-lab, admitted concurrently on separate branches, disclosed and counted rather than one being silently dropped. Ceiling raised 44 -> 50 (2026-09-18, same integration, post-render gate run): the authorship gate surfaced agent P10's six hand-authored TTL corpus files under test/fixtures/graphlaw_parity/ as unadmitted debt (REFUSED_UNADMITTED x6 -- P10's branch-scoped run never executed the full gate), admitted as sha-bound qualification debt; the flip-ledger test itself pins their digests." .

bpm:AuthorshipKind_manufacturing_input a bpm:AuthorshipKind ;
    bpm:authorshipKindName "manufacturing_input" ;
    bpm:countsAsDebt "false" ;
    bpm:debtCeiling 4 ;
    bpm:authorshipKindDoc "Project scaffolding that happens to live under a manufactured root but is a lawful manufacturing input in the same class as ggen.toml / rebar.config / mix.exs (e.g. src/beam4pm.app.src). Not counted as debt; still admitted so the tree has zero unexplained unmarked files." .

bpm:AuthorshipKind_reference_evidence a bpm:AuthorshipKind ;
    bpm:authorshipKindName "reference_evidence" ;
    bpm:countsAsDebt "false" ;
    bpm:debtCeiling 8 ;
    bpm:authorshipKindDoc "A hand-authored reference document under docs/reference/ sitting beside the manufactured ones (VISION-2030 section 2: reference evidence is a lawful input). Not counted as debt; admitted so a doc that only LOOKS manufactured cannot hide there unexplained." .

bpm:HandAuthoredSource a rdfs:Class ;
    rdfs:label "Hand-Authored Source" ;
    rdfs:comment "One admitted, counted exception: a file under a manufactured root that carries no GENERATED marker on purpose. Declared by the consumer, one individual per file, with the capability-object fields the privileged-exception doctrine requires (subject/path, authorizing principal, reason, acceptance command, expiration). Rendered into schema/beam4pm_hand_authored_source.tsv and docs/reference/beam4pm_hand_authored_source.md; enforced by the consumer's scripts/gate_authorship_check.sh." .

bpm:sourcePath a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "Repo-root-relative path of the admitted file, exactly as `git ls-files` prints it." .
bpm:authorshipKind a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range bpm:AuthorshipKind .
bpm:authorizingPrincipal a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string .
bpm:admissionReason a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "Why manufacturing this exact file is currently disproportionate (or why it is a lawful input), stated for THIS file, not the kind." .
bpm:acceptanceCommand a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "A shell command, run from the repo root, that really exercises the admitted file. Executed by scripts/gate_authorship_check.sh --exercise, which refuses a failing command and a vacuous one (every ExUnit test skipped) unless bpm:acceptancePrerequisite names an absent artifact." .
bpm:acceptancePrerequisite a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "Optional repo-root-relative path of a build artifact the acceptance command needs (e.g. a wasm engine). When absent on disk the gate reports ACCEPTANCE_BLOCKED_PREREQUISITE instead of refusing as vacuous." .
bpm:contentSha256 a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "Lowercase hex sha256 of the file's bytes at admission. Required for debt kinds: any later edit surfaces as REFUSED_SHA_DRIFT until re-admitted with the new digest -- an edit to admitted hand-authored source is new debt, never a free ride." .
bpm:admittedAtCommit a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "Abbreviated commit SHA of the consumer tree the admission was measured against." .
bpm:admissionExpires a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "ISO-8601 date (plain string literal, YYYY-MM-DD) after which the gate refuses the admission as REFUSED_EXPIRED; the debt must then be eliminated or visibly renewed. Required for debt kinds." .
bpm:sunsetPlan a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "How this particular debt is meant to be eliminated (which template family / which ontology facts would replace the hand-authored file). Required for debt kinds." .

# ===========================================================================
# Native engine surfaces (pack 0.1.17) -- bpm:Engine / bpm:EngineOp / bpm:EngineArg
# ===========================================================================
#
# VISION-2030 section 2 ("the exception is visible, bounded, and counted as
# manufacturing debt") / section 24 falsifier ("ggen-only manufacture requires
# routine privileged handwritten source commits"). Until this vocabulary
# existed the largest block of admitted debt in the reference consumer
# (beam4pm: 12 of 26 counted files) was the four native-engine facade
# triples -- src/beam4pm_<engine>.erl, lib/beam4pm_<engine>.ex,
# gleam/src/beam4pm/<engine>.gleam over the rust4pm, ferroplan, petgraph and
# tract wasm32-wasip1 engines -- each admitted with the sunset plan "admit the
# engine's function surface as ontology facts and render all three facades
# from one pack template family". Measured before (beam4pm cycle 7): the
# tract and petgraph Elixir wrappers differ by a rename only (89 identical
# core lines after s/tr_/pg_/), ferroplan's core is comment-stripped identical
# to petgraph's, and rust4pm's differs in exactly one behavioral line (its
# read_response error collapse); every Erlang facade is a pure 1:1
# delegation and every Gleam facade is a pure @external declaration. One
# template family therefore fits, and that family is templates/
# beam4pm_engine.{ex,erl,gleam}.tmpl (for_each: engines) plus
# templates/beam4pm_engine_ops.tsv.tmpl (the op manifest the consumer's
# scripts/gate_engine_dispatch_check.sh diffs against the crate's own
# string-literal dispatch arms).
#
# What is a FACT here and what is TEMPLATE: the engine's identity (module
# names, wasm export prefix, artifact path, build script, dispatch source,
# health id, timeout budgets, error-collapse variant) and its op surface
# (name, wire name, order, doc, timeout class, kind, per-leg exposure,
# optional predicate naming) and each op's args (name, wire key, closed arg
# type, closed encoding, closed mode, default) are facts declared by the
# CONSUMER, one individual each. Everything else -- the wasmex lifecycle,
# the linear-memory JSON ABI call sequence, restart-on-trap, the .Health
# probe -- is template, identical across engines by construction. The
# per-arg type / encoding / mode vocabularies below are CLOSED (gates/090
# anti-joins against them exactly like gates/020 does for bpm:FieldType):
# a consumer names a member, never writes Elixir in RDF. Adding a member is
# a reviewed edit to THIS file.
#
# Behavioral-identity notes the closed vocabularies exist to carry (each was
# a measured difference between the hand-authored facades that a naive
# "name + arity" fact schema would have erased):
#   - bpm:opElixirPredicate: Elixir names `is_cyclic?`/`session_valid?`;
#     the wire op, the Erlang function and the Gleam function drop the `?`.
#   - bpm:ArgMode_keyword: an option read from the trailing `opts` keyword
#     list with a default (petgraph add_edge `weight`, 1.0) -- Elixir arity
#     unchanged, Erlang renders an extra explicit-arity head that builds
#     `[{weight, W}]`, Gleam binds only the minimal head.
#   - bpm:ArgMode_optional: an optional positional (`config \\ nil`,
#     `extra \\ %{}`, `attributes \\ []`) -- Erlang renders both arities,
#     Gleam binds only the minimal head.
#   - bpm:ArgEncoding_omit_when_nil (rust4pm put_optional) vs
#     bpm:ArgEncoding_merge_map (ferroplan Map.merge) vs base64 (tract
#     model_b64, rust4pm content_b64) vs tensor_list (tract run) vs pair_list
#     (ferroplan session_observe Tuple.to_list).
#   - bpm:argWireKey: the JSON key when it differs from the arg name
#     (rust4pm xes_to_ocel sends `log_handle` as "handle").
#   - bpm:ErrorCollapse_any_key_raw: rust4pm's `%{"error" => msg} ->
#     {:error, {:engine, msg}}` (any error key, raw message -- pinned by its
#     facades test asserting the raw "unknown log handle " prefix) vs the
#     other three engines' single-key `inspect(err)` collapse, which
#     deliberately passes a structured refusal envelope through as {:ok, _}.
#   - bpm:EngineOpKind_host_helper: `*_path` conveniences that File.read!
#     host-side and delegate to a wire op (no dispatch arm of their own; the
#     dispatch gate exempts them by kind).

bpm:Engine a rdfs:Class ;
    rdfs:label "Native Engine" ;
    rdfs:comment "One native engine compiled to wasm32-wasip1 and hosted inside the BEAM by Elixir/wasmex behind the linear-memory JSON ABI (<prefix>_alloc / <prefix>_call / <prefix>_dealloc). Declared by the consumer, one individual per engine; rendered by templates/beam4pm_engine.{ex,erl,gleam}.tmpl into lib/beam4pm_<engineName>.ex (BeamPM.<engineModule> + .Health), src/beam4pm_<engineName>.erl and gleam/src/beam4pm/<engineName>.gleam, and listed op-by-op in schema/beam4pm_engine_ops.tsv." .

bpm:engineName a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:string ;
    rdfs:comment "snake_case key. File stem of all three facades (src/beam4pm_<name>.erl, lib/beam4pm_<name>.ex, gleam/src/beam4pm/<name>.gleam), the Erlang module name beam4pm_<name>, and the Gleam module beam4pm/<name>." .
bpm:engineModule a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:string ;
    rdfs:comment "Elixir module suffix under BeamPM.: the wrapper is BeamPM.<module>, its named Wasmex GenServer BeamPM.<module>.Engine, its probe BeamPM.<module>.Health; Erlang and Gleam delegate to 'Elixir.BeamPM.<module>'." .
bpm:engineDoc a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:string ;
    rdfs:comment "One paragraph (single line) naming what the engine computes and which crate/submodule builds it. Rendered into every facade's module doc." .
bpm:engineOrdinal a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:integer ;
    rdfs:comment "Stable render order across engines." .
bpm:wasmExportPrefix a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:string ;
    rdfs:comment "The wasm module's export prefix: <prefix>_alloc(len) -> ptr, <prefix>_call(ptr, len) -> packed_u64, <prefix>_dealloc(ptr, len)." .
bpm:wasmArtifactPath a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:string ;
    rdfs:comment "Repo-root-relative path of the built wasm32-wasip1 artifact (Path.expand'ed by the wrapper's wasm_path/0)." .
bpm:wasmBuildScript a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:string ;
    rdfs:comment "Repo-root-relative build script named in the wrapper's wasm_missing_reason/0." .
bpm:wasmBuildHint a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:string ;
    rdfs:comment "Optional extra clause appended to wasm_missing_reason/0 after the build-script name (e.g. a git submodule init hint)." .
bpm:dispatchSource a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:string ;
    rdfs:comment "Repo-root-relative path of the crate source file holding the engine's string-literal \"<op>\" => match arms (its dispatch set). Not always lib.rs (ferroplan dispatches in crates/ferroplan-wasm/src/wasi_abi.rs). The consumer's scripts/gate_engine_dispatch_check.sh refuses a wire EngineOp whose wire name is not one of those arms." .
bpm:healthId a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:string ;
    rdfs:comment "The atom BeamPM.<module>.Health.status/0 reports as :id (e.g. rust4pm_wasm)." .
bpm:handleNoun a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:string ;
    rdfs:comment "Prose noun for the integer handles the engine mints (graph, model, session, log/net) -- module-doc text only." .
bpm:cheapTimeoutMs a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:integer ;
    rdfs:comment "Per-op default wasmex call timeout, in ms, for ops of bpm:TimeoutClass_cheap; also the budget for the best-effort request-buffer dealloc." .
bpm:heavyTimeoutMs a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range xsd:integer ;
    rdfs:comment "Per-op default wasmex call timeout, in ms, for ops of bpm:TimeoutClass_heavy. Required iff the engine has at least one heavy op (gates/080); the template emits @heavy_timeout only then, so no engine carries an unused attribute." .
bpm:errorCollapse a rdf:Property ; rdfs:domain bpm:Engine ; rdfs:range bpm:ErrorCollapse .

bpm:ErrorCollapse a rdfs:Class ;
    rdfs:comment "Closed vocabulary: how the wrapper's read_response/5 turns a decoded {\"error\": ...} JSON response into {:error, {:engine, _}}." .
bpm:errorCollapseName a rdf:Property ; rdfs:domain bpm:ErrorCollapse ; rdfs:range xsd:string .
bpm:ErrorCollapse_single_key_inspect a bpm:ErrorCollapse ;
    bpm:errorCollapseName "single_key_inspect" ;
    rdfs:comment "Only a response whose SOLE top-level key is \"error\" is an op failure, collapsed to {:error, {:engine, inspect(err)}}; a response carrying \"error\" alongside other keys (a structured refusal envelope) passes through as {:ok, decoded}. petgraph, tract, ferroplan." .
bpm:ErrorCollapse_any_key_raw a bpm:ErrorCollapse ;
    bpm:errorCollapseName "any_key_raw" ;
    rdfs:comment "Any response carrying an \"error\" key is an op failure, collapsed to {:error, {:engine, msg}} with the raw decoded message. rust4pm -- pinned by its facades test asserting the raw \"unknown log handle \" prefix." .

bpm:TimeoutClass a rdfs:Class ;
    rdfs:comment "Closed vocabulary: which of the engine's two default timeout budgets an op draws." .
bpm:timeoutClassName a rdf:Property ; rdfs:domain bpm:TimeoutClass ; rdfs:range xsd:string .
bpm:TimeoutClass_cheap a bpm:TimeoutClass ; bpm:timeoutClassName "cheap" .
bpm:TimeoutClass_heavy a bpm:TimeoutClass ; bpm:timeoutClassName "heavy" .

bpm:EngineOpKind a rdfs:Class ;
    rdfs:comment "Closed vocabulary: wire (one JSON request to the engine, one dispatch arm) or host_helper (File.read! host-side, then delegate to a wire op; no dispatch arm of its own)." .
bpm:engineOpKindName a rdf:Property ; rdfs:domain bpm:EngineOpKind ; rdfs:range xsd:string .
bpm:EngineOpKind_wire a bpm:EngineOpKind ; bpm:engineOpKindName "wire" .
bpm:EngineOpKind_host_helper a bpm:EngineOpKind ; bpm:engineOpKindName "host_helper" .

bpm:EngineOp a rdfs:Class ;
    rdfs:label "Native Engine Op" ;
    rdfs:comment "One public function of an engine's surface. Rendered as one Elixir def (trailing opts \\ [] keyword list, :timeout override), one Erlang delegation per exposed arity, and one Gleam @external at the minimal arity." .
bpm:opEngine a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range bpm:Engine .
bpm:opName a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range xsd:string ;
    rdfs:comment "The Erlang and Gleam function name and, unless bpm:opWireName says otherwise, the JSON \"op\" value. The Elixir name is this plus a trailing ? when bpm:opElixirPredicate is \"true\"." .
bpm:opOrder a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range xsd:integer .
bpm:opDoc a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range xsd:string ;
    rdfs:comment "Single-line doc, rendered as the Elixir @doc, the Erlang %% comment and the Gleam /// comment." .
bpm:opTimeoutClass a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range bpm:TimeoutClass .
bpm:opKind a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range bpm:EngineOpKind .
bpm:opWireName a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range xsd:string ;
    rdfs:comment "Optional JSON \"op\" value when it differs from bpm:opName." .
bpm:opElixirPredicate a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range xsd:string ;
    rdfs:comment "Plain string \"true\": the Elixir function is named <opName>? (is_cyclic?, session_valid?); Erlang and Gleam keep the bare name and call the quoted Elixir atom." .
bpm:opDelegatesTo a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range bpm:EngineOp ;
    rdfs:comment "host_helper only: the wire op on the same engine that receives File.read!(path) as its first positional argument." .
bpm:opExposeErlang a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range xsd:string ;
    rdfs:comment "Plain string \"false\" to omit the op from the Erlang facade (default: exposed)." .
bpm:opExposeGleam a rdf:Property ; rdfs:domain bpm:EngineOp ; rdfs:range xsd:string ;
    rdfs:comment "Plain string \"false\" to omit the op from the Gleam facade (default: exposed)." .

bpm:ArgMode a rdfs:Class ;
    rdfs:comment "Closed vocabulary: how an op argument reaches the Elixir function." .
bpm:argModeName a rdf:Property ; rdfs:domain bpm:ArgMode ; rdfs:range xsd:string .
bpm:ArgMode_required a bpm:ArgMode ; bpm:argModeName "required" ;
    rdfs:comment "Positional, required. Counts toward every leg's arity." .
bpm:ArgMode_optional a bpm:ArgMode ; bpm:argModeName "optional" ;
    rdfs:comment "Positional with an Elixir default (bpm:argDefault, e.g. nil / %{} / []) placed before opts. Erlang renders both arities; Gleam binds the minimal head only. At most one per op (gates/090)." .
bpm:ArgMode_keyword a bpm:ArgMode ; bpm:argModeName "keyword" ;
    rdfs:comment "Read from the trailing opts keyword list as Keyword.get(opts, :<argName>, <argDefault>). Erlang renders an extra head taking it positionally and building [{<argName>, Value}]; Gleam binds the minimal head only. At most one per op (gates/090)." .

bpm:ArgEncoding a rdfs:Class ;
    rdfs:comment "Closed vocabulary: the host-side transform between the Elixir argument and the JSON request." .
bpm:argEncodingName a rdf:Property ; rdfs:domain bpm:ArgEncoding ; rdfs:range xsd:string .
bpm:ArgEncoding_passthrough a bpm:ArgEncoding ; bpm:argEncodingName "passthrough" ;
    rdfs:comment "\"<wireKey>\" => <arg>, verbatim." .
bpm:ArgEncoding_base64 a bpm:ArgEncoding ; bpm:argEncodingName "base64" ;
    rdfs:comment "\"<wireKey>\" => Base.encode64(<arg>) -- raw bytes a JSON string cannot carry (ONNX protobuf, gzip, XML)." .
bpm:ArgEncoding_tensor_list a bpm:ArgEncoding ; bpm:argEncodingName "tensor_list" ;
    rdfs:comment "\"<wireKey>\" => the atom-keyed %{shape:, data:} tensor list re-keyed to the wire's string keys." .
bpm:ArgEncoding_pair_list a bpm:ArgEncoding ; bpm:argEncodingName "pair_list" ;
    rdfs:comment "\"<wireKey>\" => Enum.map(<arg>, &Tuple.to_list/1) -- a list of 2-tuples as JSON pairs." .
bpm:ArgEncoding_omit_when_nil a bpm:ArgEncoding ; bpm:argEncodingName "omit_when_nil" ;
    rdfs:comment "|> put_optional(\"<wireKey>\", <arg>): the key is omitted entirely when the arg is nil so the engine applies its own default. Requires bpm:ArgMode_optional." .
bpm:ArgEncoding_merge_map a bpm:ArgEncoding ; bpm:argEncodingName "merge_map" ;
    rdfs:comment "|> Map.merge(<arg>): the arg is a map of extra top-level request fields. Requires bpm:ArgMode_optional." .

bpm:EngineArgType a rdfs:Class ;
    rdfs:comment "Closed vocabulary of argument types, each carrying its Elixir typespec, guard, Erlang type and Gleam type -- the engine-surface analogue of bpm:FieldType's per-language type expressions." .
bpm:argTypeName a rdf:Property ; rdfs:domain bpm:EngineArgType ; rdfs:range xsd:string .
bpm:argElixirType a rdf:Property ; rdfs:domain bpm:EngineArgType ; rdfs:range xsd:string .
bpm:argElixirGuard a rdf:Property ; rdfs:domain bpm:EngineArgType ; rdfs:range xsd:string ;
    rdfs:comment "Optional guard function name (is_integer, is_binary, ...); absent means the positional arg is unguarded (Path.t(), map() | nil, list())." .
bpm:argErlangType a rdf:Property ; rdfs:domain bpm:EngineArgType ; rdfs:range xsd:string .
bpm:argErlangTypeDecl a rdf:Property ; rdfs:domain bpm:EngineArgType ; rdfs:range xsd:string ;
    rdfs:comment "Optional local -type declaration the Erlang facade must emit once when any exposed op uses this type (handle() and result() are always emitted)." .
bpm:argGleamType a rdf:Property ; rdfs:domain bpm:EngineArgType ; rdfs:range xsd:string .

bpm:EngineArgType_handle a bpm:EngineArgType ; bpm:argTypeName "handle" ;
    bpm:argElixirType "non_neg_integer()" ; bpm:argElixirGuard "is_integer" ;
    bpm:argErlangType "handle()" ; bpm:argGleamType "Int" .
bpm:EngineArgType_string a bpm:EngineArgType ; bpm:argTypeName "string" ;
    bpm:argElixirType "String.t()" ; bpm:argElixirGuard "is_binary" ;
    bpm:argErlangType "binary()" ; bpm:argGleamType "String" .
bpm:EngineArgType_binary a bpm:EngineArgType ; bpm:argTypeName "binary" ;
    bpm:argElixirType "binary()" ; bpm:argElixirGuard "is_binary" ;
    bpm:argErlangType "binary()" ; bpm:argGleamType "BitArray" .
bpm:EngineArgType_path a bpm:EngineArgType ; bpm:argTypeName "path" ;
    bpm:argElixirType "Path.t()" ;
    bpm:argErlangType "binary()" ; bpm:argGleamType "String" .
bpm:EngineArgType_integer a bpm:EngineArgType ; bpm:argTypeName "integer" ;
    bpm:argElixirType "non_neg_integer()" ; bpm:argElixirGuard "is_integer" ;
    bpm:argErlangType "non_neg_integer()" ; bpm:argGleamType "Int" .
bpm:EngineArgType_number a bpm:EngineArgType ; bpm:argTypeName "number" ;
    bpm:argElixirType "number()" ; bpm:argElixirGuard "is_number" ;
    bpm:argErlangType "number()" ; bpm:argGleamType "Float" .
bpm:EngineArgType_boolean a bpm:EngineArgType ; bpm:argTypeName "boolean" ;
    bpm:argElixirType "boolean()" ; bpm:argElixirGuard "is_boolean" ;
    bpm:argErlangType "boolean()" ; bpm:argGleamType "Bool" .
bpm:EngineArgType_map a bpm:EngineArgType ; bpm:argTypeName "map" ;
    bpm:argElixirType "map()" ; bpm:argElixirGuard "is_map" ;
    bpm:argErlangType "map()" ; bpm:argGleamType "Dynamic" .
bpm:EngineArgType_optional_map a bpm:EngineArgType ; bpm:argTypeName "optional_map" ;
    bpm:argElixirType "map() | nil" ;
    bpm:argErlangType "map() | nil" ; bpm:argGleamType "Dynamic" .
bpm:EngineArgType_list a bpm:EngineArgType ; bpm:argTypeName "list" ;
    bpm:argElixirType "list()" ;
    bpm:argErlangType "list()" ; bpm:argGleamType "Dynamic" .
bpm:EngineArgType_list_string a bpm:EngineArgType ; bpm:argTypeName "list_string" ;
    bpm:argElixirType "[String.t()]" ; bpm:argElixirGuard "is_list" ;
    bpm:argErlangType "[binary()]" ; bpm:argGleamType "List(String)" .
bpm:EngineArgType_tensor_list a bpm:EngineArgType ; bpm:argTypeName "tensor_list" ;
    bpm:argElixirType "[%{shape: [non_neg_integer()], data: [number()]}]" ; bpm:argElixirGuard "is_list" ;
    bpm:argErlangType "[tensor()]" ;
    bpm:argErlangTypeDecl "-type tensor() :: #{shape := [non_neg_integer()], data := [number()]}." ;
    bpm:argGleamType "Dynamic" .
bpm:EngineArgType_fact_pairs a bpm:EngineArgType ; bpm:argTypeName "fact_pairs" ;
    bpm:argElixirType "[{String.t(), boolean()}]" ; bpm:argElixirGuard "is_list" ;
    bpm:argErlangType "[{binary(), boolean()}]" ; bpm:argGleamType "List(#(String, Bool))" .

bpm:EngineArg a rdfs:Class ;
    rdfs:label "Native Engine Op Argument" ;
    rdfs:comment "One argument of one bpm:EngineOp, in bpm:argOrder." .
bpm:argOp a rdf:Property ; rdfs:domain bpm:EngineArg ; rdfs:range bpm:EngineOp .
bpm:argName a rdf:Property ; rdfs:domain bpm:EngineArg ; rdfs:range xsd:string ;
    rdfs:comment "snake_case Elixir/Gleam parameter name; the Erlang variable is its CamelCase form." .
bpm:argOrder a rdf:Property ; rdfs:domain bpm:EngineArg ; rdfs:range xsd:integer .
bpm:argWireKey a rdf:Property ; rdfs:domain bpm:EngineArg ; rdfs:range xsd:string ;
    rdfs:comment "Optional JSON key when it differs from bpm:argName." .
bpm:argType a rdf:Property ; rdfs:domain bpm:EngineArg ; rdfs:range bpm:EngineArgType .
bpm:argEncoding a rdf:Property ; rdfs:domain bpm:EngineArg ; rdfs:range bpm:ArgEncoding ;
    rdfs:comment "Default bpm:ArgEncoding_passthrough." .
bpm:argMode a rdf:Property ; rdfs:domain bpm:EngineArg ; rdfs:range bpm:ArgMode ;
    rdfs:comment "Default bpm:ArgMode_required." .
bpm:argDefault a rdf:Property ; rdfs:domain bpm:EngineArg ; rdfs:range xsd:string ;
    rdfs:comment "The Elixir default literal for optional/keyword modes (nil, %{}, [], 1.0). Required for those modes (gates/080)." .

# ===========================================================================
# One-shot CLI bridge wrappers (pack 0.1.20) -- bpm:CliBridge / bpm:CliCommand / bpm:CliArg
# ===========================================================================
#
# v26.9.18 parity-wave class (1): the reference consumer hand-wrote a family of
# typed one-shot CLI wrapper functions in BeamPM.Dfcm over the standalone
# autofde-lab Typer CLI (ocel_validate/1, sa2a_replay/1, catalog/0,
# graphlaw_*, sa2a_admit/2, fabric_match/2, fabric_solve/2, ...), each admitted
# as counted manufacturing debt with the sunset plan "admit the CLI's command
# surface as ontology facts and render the wrappers". Measured before: every
# wrapper repeats the SAME shape -- resolve the binary (Application env ->
# ENV var -> default path), build an argv prefix from a fixed group +
# subcommand, append per-argument values (verbatim, JSON-encoded, or behind a
# --flag), System.cmd once, JSON-decode stdout, and collapse the outcome into
# {:ok, map()} or a TYPED {:error, term()} that keeps the lab's own refusal
# envelope instead of hiding it. One template family therefore fits, and that
# family is templates/beam4pm_cli_bridge.ex.tmpl (for_each: bridges).
#
# What is a FACT here and what is TEMPLATE (the bpm:Engine split, repeated):
# the bridge's identity (module name, binary resolution ladder, default
# timeout) and each command's surface (group, subcommand, doc, closed result
# shape, refusal-reason atom, timeout budget, args) are facts declared by the
# CONSUMER, one individual each. Everything else -- the resolution ladder, the
# single System.cmd + JSON decode, the Task-based timeout with brutal-kill
# reaping, the per-shape collapse into typed refusals -- is template,
# identical across bridges by construction. The arg-mode / arg-encoding /
# arg-type / result-shape vocabularies below are CLOSED (gates/110 anti-joins
# against them exactly like gates/090 for the engine vocabularies): a consumer
# names a member, never writes Elixir in RDF. Adding a member is a reviewed
# edit to THIS file.
#
# Witnessing (the 柵 this family adds over the engine family): a rendered
# command must be WITNESSED -- the consumer's graph carries one bpm:CliWitness
# per admitted bpm:CliCommand, recorded from a REAL run of the exact
# group/subcommand against the real binary (date, exact command line, observed
# exit code 0, sha256 of the observed stdout envelope). gates/110 refuses a
# rendered command no witness names and a witness missing its observed
# evidence, so a fabricated command (or a vacuous, evidence-free witness)
# cannot reach render. The gate cannot re-run the CLI; what it enforces is
# that the admission RECORD carries observed evidence, the same scope as the
# authorship gate's sha256/admission fields.
#
# Failed edges recorded (per the search ladder, silent pruning forbidden):
#   - protocol-integration-pack's pr:PriorArtAdapter cli-subprocess adapter was
#     considered and REJECTED as the owner: it renders a raw System.cmd
#     passthrough ({output, exit_code} tuple, no JSON envelope decode, no
#     typed refusal shapes, one fixed subcommand, no resolution ladder) -- a
#     different capability family, not a prior art for this one.
#   - Only an Elixir leg is rendered this wave (the hand-written wrappers are
#     Elixir-only); bpm:cliArgElixirType/bpm:cliArgElixirGuard therefore carry
#     no Erlang/Gleam siblings -- adding those legs is a reviewed extension,
#     not an existing column left empty.
#   - bpm:ArgMode_optional/keyword (the engine family's optional positional
#     and opts-keyword modes) have NO CLI analogue yet: every hand-written
#     wrapper's arguments are required. An optional --flag (e.g.
#     graphlaw_validate/2's :shacl opt) needs a keyword-flag mode -- a named,
#     unrendered gap that keeps those wrappers hand-written until admitted.

bpm:CliBridge a rdfs:Class ;
    rdfs:label "One-shot CLI Bridge" ;
    rdfs:comment "One external CLI binary the consumer wraps with typed one-shot functions. Declared by the consumer, one individual per binary; rendered by templates/beam4pm_cli_bridge.ex.tmpl into lib/beam4pm_cli_<bridgeName>.ex as module BeamPM.<bridgeModule> with one public function per admitted bpm:CliCommand plus cli_path/0, cli_available?/0 and the shared run_cli/2,3 runner." .

bpm:bridgeName a rdf:Property ; rdfs:domain bpm:CliBridge ; rdfs:range xsd:string ;
    rdfs:comment "snake_case key. File stem of the rendered wrapper (lib/beam4pm_cli_<name>.ex) and the binary's prose name in docs." .
bpm:bridgeModule a rdf:Property ; rdfs:domain bpm:CliBridge ; rdfs:range xsd:string ;
    rdfs:comment "Elixir module suffix under BeamPM.: the rendered wrapper is BeamPM.<module> (e.g. DfcmCli). Distinct from any hand-authored module that still carries the not-yet-rendered wrappers." .
bpm:bridgeDoc a rdf:Property ; rdfs:domain bpm:CliBridge ; rdfs:range xsd:string ;
    rdfs:comment "One paragraph (single line) rendered into the module doc: what the wrapped CLI is and where it lives." .
bpm:bridgeOrdinal a rdf:Property ; rdfs:domain bpm:CliBridge ; rdfs:range xsd:integer ;
    rdfs:comment "Stable render order across bridges." .
bpm:cliOtpApp a rdf:Property ; rdfs:domain bpm:CliBridge ; rdfs:range xsd:string ;
    rdfs:comment "First rung of the resolution ladder: Application.get_env(:<cliOtpApp>, :<cliAppEnvKey>) (e.g. beam4pm)." .
bpm:cliAppEnvKey a rdf:Property ; rdfs:domain bpm:CliBridge ; rdfs:range xsd:string ;
    rdfs:comment "The application-env key of the first rung (e.g. autofde_cli_path)." .
bpm:cliEnvVar a rdf:Property ; rdfs:domain bpm:CliBridge ; rdfs:range xsd:string ;
    rdfs:comment "Second rung: System.get_env/<cliEnvVar> (e.g. AUTOFDE_CLI_PATH)." .
bpm:cliDefaultPath a rdf:Property ; rdfs:domain bpm:CliBridge ; rdfs:range xsd:string ;
    rdfs:comment "Third rung: repo-root-relative default, Path.expand'ed (e.g. priv/bin/autofde, the trampoline)." .
bpm:cliDefaultTimeoutMs a rdf:Property ; rdfs:domain bpm:CliBridge ; rdfs:range xsd:integer ;
    rdfs:comment "Default budget, in ms, for the shared run_cli/2 runner (run_cli/1 delegates to it). Each command's own bpm:cmdTimeoutMs overrides per call." .

bpm:CliCommand a rdfs:Class ;
    rdfs:label "One-shot CLI Command Wrapper" ;
    rdfs:comment "One public wrapper function over one <group> <subcommand> invocation of a bridge's binary. Rendered with the exact @doc (including any doctest) from bpm:cmdDoc, a typespec derived from the admitted bpm:CliArg types, and the collapse behavior of its bpm:cmdResultShape." .
bpm:cmdBridge a rdf:Property ; rdfs:domain bpm:CliCommand ; rdfs:range bpm:CliBridge .
bpm:cmdName a rdf:Property ; rdfs:domain bpm:CliCommand ; rdfs:range xsd:string ;
    rdfs:comment "snake_case Elixir function name (e.g. ocel_validate, fabric_cache_stats)." .
bpm:cmdGroup a rdf:Property ; rdfs:domain bpm:CliCommand ; rdfs:range xsd:string ;
    rdfs:comment "First CLI argv word (e.g. ocel, sa2a, fabric). Every observed invocation of the wrapped CLIs is <group> <subcommand> ...; a group-less command is a schema extension, not a silent omission (recorded failed edge)." .
bpm:cmdSubcommand a rdf:Property ; rdfs:domain bpm:CliCommand ; rdfs:range xsd:string ;
    rdfs:comment "Second CLI argv word (e.g. validate, replay, cache-stats -- hyphens allowed here; only the FUNCTION name is snake_case)." .
bpm:cmdOrder a rdf:Property ; rdfs:domain bpm:CliCommand ; rdfs:range xsd:integer .
bpm:cmdDoc a rdf:Property ; rdfs:domain bpm:CliCommand ; rdfs:range xsd:string ;
    rdfs:comment "The FULL rendered @doc body, consumer-authored, carried verbatim (newlines and indentation included; a doctest travels inside this fact and must name the RENDERED module BeamPM.<bridgeModule>). Multi-line Turtle string." .
bpm:cmdResultShape a rdf:Property ; rdfs:domain bpm:CliCommand ; rdfs:range bpm:CliResultShape .
bpm:cmdResultFields a rdf:Property ; rdfs:domain bpm:CliCommand ; rdfs:range xsd:string ;
    rdfs:comment "ok_map shapes only: space-separated top-level JSON keys projected into the returned atom-keyed map, in order; the key named \"ok\" binds the envelope's guarded boolean, every other key via Map.fetch!/2 (missing key = KeyError, a loud projection bug, never nil-fabrication)." .
bpm:cmdRefusalReason a rdf:Property ; rdfs:domain bpm:CliCommand ; rdfs:range xsd:string ;
    rdfs:comment "The atom naming this command's typed refusal tuple (e.g. ocel_validate_error, replay_refused). ok_map renders {:error, {<reason>, err, resp}} for an error-keyed envelope; typed_refusal renders {:error, {<reason>, resp}} for the CLI's own ok:false verdict." .
bpm:cmdTimeoutMs a rdf:Property ; rdfs:domain bpm:CliCommand ; rdfs:range xsd:integer ;
    rdfs:comment "Per-command budget, in ms, for the one System.cmd run (Task.yield + Task.shutdown(:brutal_kill); the orphaned port dies with its owner). Exceeding it is the typed refusal {:error, {:cli_timeout, ms}} -- never a hang, never a silent nil." .

bpm:CliResultShape a rdfs:Class ;
    rdfs:comment "Closed vocabulary: how the runner's {:ok, decoded} / {:error, _} outcome collapses for one command." .
bpm:resultShapeName a rdf:Property ; rdfs:domain bpm:CliResultShape ; rdfs:range xsd:string .
bpm:CliResultShape_ok_map a bpm:CliResultShape ; bpm:resultShapeName "ok_map" ;
    rdfs:comment "The CLI exits 0 with a top-level \"ok\" boolean. ok=true -> {:ok, atom-keyed projection per bpm:cmdResultFields}; an envelope carrying a top-level \"error\" key -> {:error, {<cmdRefusalReason>, err, resp}}; every other exit-0 decode passes through untouched; runner failures verbatim. (ocel_validate/1's measured shape.)" .
bpm:CliResultShape_batch a bpm:CliResultShape ; bpm:resultShapeName "batch" ;
    rdfs:comment "The CLI exits 0 with a bare payload (no \"ok\" envelope): counters/aggregate batches returned WHOLE as {:ok, payload}. No envelope branching; runner failures verbatim. (fabric cache-stats' measured shape.)" .
bpm:CliResultShape_typed_refusal a bpm:CliResultShape ; bpm:resultShapeName "typed_refusal" ;
    rdfs:comment "Success is {:ok, resp} iff the CLI exits 0 with \"ok\": true; the lab's own refusal (verdict JSON on stdout, THEN exit 1) is decoded and surfaced as {:error, {<cmdRefusalReason>, resp}} -- the CLI's verdict travels, never hidden behind a raw exit; every other outcome verbatim. (sa2a_replay/1's measured shape.)" .

bpm:CliArgMode a rdfs:Class ;
    rdfs:comment "Closed vocabulary: how one argument reaches the CLI invocation." .
bpm:cliArgModeName a rdf:Property ; rdfs:domain bpm:CliArgMode ; rdfs:range xsd:string .
bpm:CliArgMode_positional a bpm:CliArgMode ; bpm:cliArgModeName "positional" ;
    rdfs:comment "Appended to argv in bpm:cliArgOrder, in position (value JSON-encoded first when bpm:CliArgEncoding_json)." .
bpm:CliArgMode_flags a bpm:CliArgMode ; bpm:cliArgModeName "flags" ;
    rdfs:comment "Appended as [<bpm:cliArgFlag>, value]; the flag text is a fact (--expected-hash), the value JSON-encoded first when bpm:CliArgEncoding_json. Requires bpm:cliArgFlag (gates/100)." .
bpm:CliArgMode_json_stdin a bpm:CliArgMode ; bpm:cliArgModeName "json_stdin" ;
    rdfs:comment "Value JSON-encoded and piped via System.cmd's :stdin option; NEVER in argv. (The autofde cmca allocate inline-JSON form crashes on macOS for long JSON -- OSError 63, observed 2026-09-18 -- so stdin is the honest large-payload channel.)" .
bpm:CliArgMode_temp_file a bpm:CliArgMode ; bpm:cliArgModeName "temp_file" ;
    rdfs:comment "Value JSON-encoded into a unique temp file whose PATH is appended to argv; the file is removed in an after clause even on refusal (the cmca_allocate/2 measured shape)." .

bpm:CliArgEncoding a rdfs:Class ;
    rdfs:comment "Closed vocabulary: the host-side transform of an argument VALUE before it reaches argv or stdin (positional/flags only; json_stdin and temp_file encode by definition -- declaring raw on those is a gates/100 contradiction)." .
bpm:cliArgEncodingName a rdf:Property ; rdfs:domain bpm:CliArgEncoding ; rdfs:range xsd:string .
bpm:CliArgEncoding_raw a bpm:CliArgEncoding ; bpm:cliArgEncodingName "raw" ;
    rdfs:comment "Value verbatim (the CLI parses it; paths, hashes, plain strings)." .
bpm:CliArgEncoding_json a bpm:CliArgEncoding ; bpm:cliArgEncodingName "json" ;
    rdfs:comment "JSON.encode!/1 before splicing (maps an --domain-arguments-style flag carries)." .

bpm:CliArgType a rdfs:Class ;
    rdfs:comment "Closed vocabulary of argument types, each carrying its Elixir typespec + guard -- the CLI-surface analogue of bpm:EngineArgType (Elixir leg only this wave; see the failed-edge note above)." .
bpm:cliArgTypeName a rdf:Property ; rdfs:domain bpm:CliArgType ; rdfs:range xsd:string .
bpm:cliArgElixirType a rdf:Property ; rdfs:domain bpm:CliArgType ; rdfs:range xsd:string .
bpm:cliArgElixirGuard a rdf:Property ; rdfs:domain bpm:CliArgType ; rdfs:range xsd:string .
bpm:CliArgType_string a bpm:CliArgType ; bpm:cliArgTypeName "string" ;
    bpm:cliArgElixirType "String.t()" ; bpm:cliArgElixirGuard "is_binary" .
bpm:CliArgType_map a bpm:CliArgType ; bpm:cliArgTypeName "map" ;
    bpm:cliArgElixirType "map()" ; bpm:cliArgElixirGuard "is_map" .

bpm:CliArg a rdfs:Class ;
    rdfs:label "One-shot CLI Command Argument" ;
    rdfs:comment "One argument of one bpm:CliCommand, in bpm:cliArgOrder (1-based, argv order across positional and flags modes; json_stdin/temp_file args take an order too, for the function-signature parameter order)." .
bpm:argCommand a rdf:Property ; rdfs:domain bpm:CliArg ; rdfs:range bpm:CliCommand .
bpm:cliArgName a rdf:Property ; rdfs:domain bpm:CliArg ; rdfs:range xsd:string ;
    rdfs:comment "snake_case Elixir parameter name." .
bpm:cliArgOrder a rdf:Property ; rdfs:domain bpm:CliArg ; rdfs:range xsd:integer .
bpm:cliArgType a rdf:Property ; rdfs:domain bpm:CliArg ; rdfs:range bpm:CliArgType .
bpm:cliArgMode a rdf:Property ; rdfs:domain bpm:CliArg ; rdfs:range bpm:CliArgMode ;
    rdfs:comment "Default bpm:CliArgMode_positional." .
bpm:cliArgFlag a rdf:Property ; rdfs:domain bpm:CliArg ; rdfs:range xsd:string ;
    rdfs:comment "The literal flag text including dashes (e.g. --expected-hash). Required iff bpm:CliArgMode_flags (gates/100)." .
bpm:cliArgEncoding a rdf:Property ; rdfs:domain bpm:CliArg ; rdfs:range bpm:CliArgEncoding ;
    rdfs:comment "Default bpm:CliArgEncoding_raw." .

bpm:CliWitness a rdfs:Class ;
    rdfs:label "CLI Command Qualification Witness" ;
    rdfs:comment "Consumer-declared, evidence-bearing admission record: one REAL observed run of the exact command against the real binary, recorded BEFORE the command's facts may render (gates/110 refuses an unwitnessed command). One per bpm:CliCommand. Inspection is not execution -- the witness exists so the graph only ever names invocations that were actually run and whose stdout envelope was captured." .
bpm:witnessCommand a rdf:Property ; rdfs:domain bpm:CliWitness ; rdfs:range bpm:CliCommand .
bpm:witnessedAt a rdf:Property ; rdfs:domain bpm:CliWitness ; rdfs:range xsd:string ;
    rdfs:comment "ISO-8601 date (YYYY-MM-DD) of the observed run." .
bpm:witnessCommandline a rdf:Property ; rdfs:domain bpm:CliWitness ; rdfs:range xsd:string ;
    rdfs:comment "The exact argv observed, single line (e.g. 'priv/bin/autofde ocel validate <fixture>'), minus secret payloads." .
bpm:witnessExitCode a rdf:Property ; rdfs:domain bpm:CliWitness ; rdfs:range xsd:integer ;
    rdfs:comment "The observed process exit code; gates/110 admits only 0 (a witnessed failure is a finding, not a qualification)." .
bpm:witnessEnvelopeSha256 a rdf:Property ; rdfs:domain bpm:CliWitness ; rdfs:range xsd:string ;
    rdfs:comment "sha256 hex of the captured stdout envelope file. The gate enforces presence (a witness without captured evidence is vacuous); binding the hash to the bytes is the admitting session's receipt, not the gate's." .
# --- Cross-engine parity qualification (pack 0.1.20) -----------------------
#
# The v26.9.18 parity wave hand-wrote ~1000 lines in a recurring test class
# (P2 ocel_validate vs RF3Ocel, P5 sa2a replay, P10 graphlaw corners, and the
# fabric-vs-ferroplan cross-validation): every instance is "run two real
# engines over the same pinned corpus, pin each engine's verdict vocabulary
# with digests, and hold one planted tamper falsifier that proves a corpus
# flip is witnessed by BOTH engines." This vocabulary retires the class: a
# consumer admits ONE bpm:ParityCheck individual (with ordered corpus entries,
# digest pins, expected shared-verdict steps, and the tamper falsifier's
# mechanical parameters) and templates/beam4pm_parity_check_test.exs.tmpl
# renders the whole Chicago-style qualification test file from those facts.
#
# Existence is two-layered, matching the pack's graph-vs-disk discipline:
# graph-level -- every bpm:hasCorpus entry must resolve to a consumer-admitted
# bpm:QualificationFixture path (gates/100 refuses an unadmitted corpus path),
# and disk-level -- the rendered test itself asserts File.exists? plus the
# entry's sha256 pin at runtime, so a fixture admitted but deleted from disk
# trips the same way a verdict flip does.

bpm:ParityCheck a rdfs:Class ;
    rdfs:label "Parity Check" ;
    rdfs:comment "One cross-engine parity qualification: two named engines (left/right) run over byte-identical admitted corpus files, their verdicts are pinned, and one planted tamper falsifier must flip both engines in the same place. Rendered per individual by templates/beam4pm_parity_check_test.exs.tmpl into the consumer's test/ tree." .

bpm:checkName a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "snake_case check identity; unique (gates/120), rendered into the test file name and module doc." .
bpm:checkDoc a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "One-paragraph module-doc text naming both engines, their specs, and any known attributed divergence." .
bpm:checkOrdinal a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:integer .
bpm:testPath a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "Repo-root-relative output path of the rendered test (e.g. test/beam4pm_parity_<check_name>_test.exs). Unique (gates/120)." .
bpm:testModule a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "Full Elixir module name of the rendered test (e.g. BeamPM.ParityQualification.FerroplanVsLabFabric)." .
bpm:leftCommand a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "Human-witnessed command line of the LEFT leg, rendered verbatim into the module doc (e.g. the autofde-lab venv python -m autofde_lab.cli fabric solve invocation). Execution mechanics come from bpm:leftCommandKind + parameters, never from parsing this string." .
bpm:rightCommand a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "Human-witnessed BEAM call of the RIGHT leg, rendered verbatim into the module doc (e.g. BeamPM.Ferroplan.hddl_solve/2 over the wasm)." .
bpm:leftCommandKind a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range bpm:ParityCommandKind .
bpm:rightCommandKind a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range bpm:ParityCommandKind .
bpm:leftDomain a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "Registered fabric domain name for the lab_fabric_solve arm (e.g. HTNDomain). Required for that kind; unused otherwise." .
bpm:leftSolver a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "Solver name for the lab_fabric_solve arm (e.g. Astar). Required for that kind; unused otherwise." .
bpm:hasCorpus a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range bpm:ParityCorpus .
bpm:hasDigestPin a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range bpm:ParityDigestPin .
bpm:hasExpectedStep a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range bpm:ParityExpectedStep .
bpm:consentLaw a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "The law that makes running the two engines over the same corpus a lawful comparison and states what counts as agreement; rendered into the module doc. Agreement here = the shared expected-step ladder appears in BOTH engines' verdict vocabularies; any other divergence must be attributed in bpm:checkDoc, never normalized away." .
bpm:tamperFalsifier a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "The falsifier's claim, rendered into the tamper test: what a one-token corpus mutation must do to BOTH engines' verdicts. Executed against a temp copy -- real corpus files are never mutated." .
bpm:tamperFind a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "Literal token the tamper falsifier replaces in the temp copy of the corpus entry named by bpm:tamperCorpusOrder." .
bpm:tamperReplace a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:string ;
    rdfs:comment "Replacement token; the rendered test asserts BOTH engines' verdicts now carry this token where the original appeared, and that the lab trajectory digest flipped off its pin." .
bpm:tamperCorpusOrder a rdf:Property ; rdfs:domain bpm:ParityCheck ; rdfs:range xsd:integer ;
    rdfs:comment "The bpm:corpusOrder of the entry the falsifier copies and mutates." .

bpm:ParityCorpus a rdfs:Class ;
    rdfs:label "Parity Corpus Entry" ;
    rdfs:comment "One ordered, sha256-pinned input file shared byte-identically by both legs of a bpm:ParityCheck. Path must resolve to a consumer-admitted bpm:QualificationFixture (gates/100) and must exist on disk with the pinned digest at test runtime." .
bpm:corpusPath a rdf:Property ; rdfs:domain bpm:ParityCorpus ; rdfs:range xsd:string ;
    rdfs:comment "Repo-root-relative path (the lab CLI's domain-arguments convention), passed to the lab leg verbatim and Path.expand'ed for BEAM-side reads." .
bpm:corpusSha256 a rdf:Property ; rdfs:domain bpm:ParityCorpus ; rdfs:range xsd:string ;
    rdfs:comment "Hex sha256 of the file bytes; required (gates/110), asserted at test runtime." .
bpm:corpusOrder a rdf:Property ; rdfs:domain bpm:ParityCorpus ; rdfs:range xsd:integer ;
    rdfs:comment "1-based order; order 1/2 are the domain/problem pair for the lab_fabric_solve and beam_hddl_solve arms." .

bpm:ParityDigestPin a rdfs:Class ;
    rdfs:label "Parity Digest Pin" ;
    rdfs:comment "One pinned digest of a leg's receipt vocabulary (P10 flip-ledger style): any engine/seam bump trips the pin and the test names the flip. Empty rows forbidden; 'no flip' is a row." .
bpm:pinKey a rdf:Property ; rdfs:domain bpm:ParityDigestPin ; rdfs:range xsd:string ;
    rdfs:comment "Response field the pin holds (e.g. input_sha256, receipt_sha256, trajectory_sha256)." .
bpm:pinValue a rdf:Property ; rdfs:domain bpm:ParityDigestPin ; rdfs:range xsd:string .

bpm:ParityExpectedStep a rdfs:Class ;
    rdfs:label "Parity Expected Step" ;
    rdfs:comment "One entry of the SHARED verdict ladder both engines must witness: the lab rollout executes it as an exact step action name in bpm:stepOrder, and the BEAM engine's own plan vocabulary must contain it. This is the parity contract -- agreement means the same ladder in two receipt vocabularies, not byte-identical responses." .
bpm:stepOrder a rdf:Property ; rdfs:domain bpm:ParityExpectedStep ; rdfs:range xsd:integer .
bpm:stepAction a rdf:Property ; rdfs:domain bpm:ParityExpectedStep ; rdfs:range xsd:string .

bpm:QualificationFixture a rdfs:Class ;
    rdfs:label "Qualification Fixture" ;
    rdfs:comment "One consumer-admitted qualification input file (graph-level existence proof for parity corpus entries, PDDL fixtures, and every other corpus the pack projects). Admitted by the consumer's own ontology with its observed sha256; the pack's gates anti-join corpus paths against this set, and rendered tests re-assert existence + digest on disk at runtime." .
bpm:fixturePath a rdf:Property ; rdfs:domain bpm:QualificationFixture ; rdfs:range xsd:string ;
    rdfs:comment "Repo-root-relative path, unique across admitted fixtures (gates/120 refuses duplicates)." .
bpm:fixtureSha256 a rdf:Property ; rdfs:domain bpm:QualificationFixture ; rdfs:range xsd:string ;
    rdfs:comment "Observed hex sha256 of the fixture bytes at admission time." .
bpm:fixtureDoc a rdf:Property ; rdfs:domain bpm:QualificationFixture ; rdfs:range xsd:string .

bpm:ParityCommandKind a rdfs:Class ;
    rdfs:comment "Closed vocabulary: how a parity leg is executed. Each member names one rendered helper arm in templates/beam4pm_parity_check_test.exs.tmpl -- adding a kind is ONE vocabulary member plus ONE template arm, the EngineOpKind discipline." .
bpm:commandKindName a rdf:Property ; rdfs:domain bpm:ParityCommandKind ; rdfs:range xsd:string .
bpm:ParityCommandKind_lab_fabric_solve a bpm:ParityCommandKind ;
    bpm:commandKindName "lab_fabric_solve" ;
    rdfs:comment "Subprocess leg: AUTOFDE_LAB_ROOT's .venv/bin/python3 -m autofde_lab.cli fabric solve <leftDomain> --solver <leftSolver> --domain-arguments {domain_path: corpus[1], problem_path: corpus[2]} run with cwd = repo root; stdout's leading log lines are skipped to the first '{' (observed lab envelope convention, same as the hand-written fabric test); requires the corpus' first two entries in that order." .
bpm:ParityCommandKind_beam_hddl_solve a bpm:ParityCommandKind ;
    bpm:commandKindName "beam_hddl_solve" ;
    rdfs:comment "In-process leg: BeamPM.Ferroplan.start/0 then Ferroplan.hddl_solve(read(corpus[1]), read(corpus[2])) over the wasm engine; a response carrying an \"error\" envelope is a typed engine refusal and fails the check, never a silent pass." .
# Persistent stdio JSON-lines port bridges (pack 0.1.20) -- bpm:PortBridge /
# bpm:BridgeOp / bpm:BridgeArg
# ===========================================================================
#
# Generalizes the reference consumer's hand-written persistent port bridge
# (beam4pm lib/beam4pm_autofde_bridge.ex, v26.9.18 parity wave class 3): ONE
# long-lived OS interpreter behind ONE BEAM Port serving many requests over
# newline-delimited single-line JSON (so call 2+ skips the per-call
# interpreter boot a one-shot CLI bridge pays), wrapped in a GenServer that
# owns the framing buffer, a FIFO waiter queue, per-request timeouts, the
# :bridge_down contract and the lazy/forced restart law. Measured shape of
# the hand-written original: the GenServer + port plumbing + reply dispatch
# is identical modulo names, the spawn command and the op table are
# per-bridge facts, and the one-shot CLI path (oneshot_cmca_allocate et al)
# is a DIFFERENT recurring class -- bpm:CliBridge / the CLI-bridge wrapper
# family (v26.9.18 class 1), not this one. Recorded failed edge: folding the
# one-shot path into this template family would have welded two different
# lifecycles (per-call System.cmd vs persistent Port) into one template for
# no shared line beyond JSON decode.
#
# What is a FACT here and what is TEMPLATE: the bridge's identity (names,
# doc, ordinal), its spawn command (interpreter, args, env, cwd, optional
# checkout-root resolution), framing, restart policy, timeout budgets and
# its op surface (name, wire name, order, doc, reply shape, per-op timeout,
# arg list with closed types/encodings) are facts declared by the CONSUMER,
# one individual each. Everything else -- the GenServer, the Port lifecycle
# (lazy ensure, close, exit_status handling), the FIFO waiter queue, the
# strict-ordering timeout poisoning, the line drain/dispatch, restart/1 and
# os_pid/1 -- is template, identical across bridges by construction
# (templates/beam4pm_port_bridge.ex.tmpl) with its Chicago qualification
# rendered alongside (templates/beam4pm_port_bridge_test.exs.tmpl).
#
# bpm:opRequestShape is deliberately NOT a literal: it is the bridge op's
# ordered bpm:BridgeArg set, so the wire example rendered into the moduledoc
# cannot drift from the request-builder code the same facts render (one
# source of truth, the same doctrine as the 0.1.6 FieldType externalization).
# bpm:opReplyShape IS a literal -- the reply envelope is produced by the
# remote interpreter and can only be DESCRIBED, never built, by this pack --
# and it is mandatory (gates/100 refuses an op without one): an op whose
# reply shape nobody wrote down is an untestable wire promise.
#
# The __ROOT__ token inside bpm:envValue / bpm:bridgeCwd values is plain
# string data (same convention as FieldType's __FIELD__ samples),
# substituted at render time with the resolved checkout root (or unused when
# the bridge declares no root resolution).
#
# Disclosed divergence, caught by the rendered qualification 2026-09-18: the
# hand-written original's request/3 carries a LEADING default
# (server \\ @registered_name). Elixir binds supplied args from the first
# parameter and fills defaults in the tail, so its generated 2-arity clause
# is request(server, req) -- a caller writing request(req_map, 100) binds
# server=req_map and fails the is_map(req) guard (FunctionClauseError;
# measured). The original never called it below 3-arity with two positionals
# (its own test uses request/1, which is generated unambiguously), so the
# trap stayed latent; the template keeps the original's API byte-for-byte and
# the rendered qualification pins the safe explicit-3-arity raw call instead.

bpm:PortBridge a rdfs:Class ;
    rdfs:label "Persistent Port Bridge" ;
    rdfs:comment "One long-lived OS interpreter process serving many requests over one BEAM Port with newline-delimited single-line JSON framing (one reply line per request line, in request order). Declared by the consumer, one individual per bridge; rendered by templates/beam4pm_port_bridge.ex.tmpl into lib/beam4pm_<bridgeName>_bridge.ex (BeamPM.<bridgeModule>) and its Chicago qualification into test/beam4pm_<bridgeName>_bridge_test.exs." .

bpm:bridgeName a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "snake_case key. File stem lib/beam4pm_<name>_bridge.ex, generated test test/beam4pm_<name>_bridge_test.exs, and the :beam4pm/<name>_bridge telemetry/event prefix." .
bpm:bridgeModule a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "Elixir module suffix under BeamPM.: the GenServer is BeamPM.<module> (also its own registered name, exactly like the hand-written original)." .
bpm:bridgeDoc a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "One paragraph (single line) naming what the remote interpreter computes and where it lives. Rendered into the module doc's opening." .
bpm:bridgeOrdinal a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:integer ;
    rdfs:comment "Stable render order across bridges." .
bpm:bridgeCommand a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "Interpreter program for :spawn_executable, resolved with System.find_executable/1 (e.g. python3). When bpm:bridgeInterpreterPref is set and the resolved root carries that relative interpreter, it wins (the lab venv's .venv/bin/python3 over PATH python3)." .
bpm:bridgeCommandArgs a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "Space-split argument string passed after the interpreter (e.g. `-u -m autofde_lab.beam.beam_port_bridge` or `-u qualification/echo_port_bridge.py`). Plain string data split on single spaces; arguments containing spaces are not expressible (recorded limitation, none observed)." .
bpm:bridgeFraming a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range bpm:BridgeFraming .
bpm:bridgeRestartPolicy a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range bpm:BridgeRestartPolicy .
bpm:bridgeDefaultTimeoutMs a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:integer ;
    rdfs:comment "Per-request reply timeout in ms when the caller passes none; also the restart/1 call budget." .
bpm:bridgeCallSlackMs a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:integer ;
    rdfs:comment "Extra ms added to the caller timeout for the wrapping GenServer.call/3 (the reply must come back through one hop). Default 5000." .
bpm:bridgeOsPidTimeoutMs a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:integer ;
    rdfs:comment "os_pid/1 call budget in ms. Default 5000." .
bpm:bridgeRootAppEnv a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "First root-resolution candidate: Application.get_env(:beam4pm, <this atom>) (e.g. autofde_lab_root)." .
bpm:bridgeRootEnvVar a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "Second root-resolution candidate: System.get_env/1 of this name (e.g. AUTOFDE_LAB_ROOT)." .
bpm:bridgeRootFallbacks a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "Space-split list of further root candidates, each Path.expand'ed against the cwd (e.g. `../autofde-lab ~/autofde-lab`). A candidate counts only when bpm:bridgeRootProbe exists under it." .
bpm:bridgeRootProbe a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "Path (relative to the candidate root) that must exist for a root candidate to be accepted (e.g. src/autofde_lab)." .
bpm:bridgeInterpreterPref a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "Optional path relative to the resolved root of a preferred interpreter (e.g. .venv/bin/python3); used when it exists, else System.find_executable(bridgeCommand)." .
bpm:bridgeCwd a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "Optional {:cd, _} for the port; __ROOT__ substitutes the resolved root. Set it to __ROOT__ for module-spawned interpreters that import siblings relative to their checkout." .
bpm:bridgeScriptProbe a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range xsd:string ;
    rdfs:comment "Path that must exist before spawn (relative to the resolved root when root resolution is declared, else to the cwd). Drives available?/0, missing_reason/0 and the ensure_port refusal -- a bridge that cannot be spawned is a NAMED {:error, {:bridge_down, reason}}, never a fake." .
bpm:bridgeProbeOp a rdf:Property ; rdfs:domain bpm:PortBridge ; rdfs:range bpm:BridgeOp ;
    rdfs:comment "MANDATORY: the cheapest no-argument op of this bridge (the hand-written original's ping), used by the generated qualification to boot the port, round-trip a real reply, and verify recovery after restart and kill -9. gates/100 refuses a probe that is not a no-argument op of the same bridge." .

bpm:BridgeEnv a rdfs:Class ;
    rdfs:label "Bridge Port Environment Variable" ;
    rdfs:comment "One extra environment variable set on the spawned port process (the OS environment is inherited whole, exactly like the hand-written original; these are merged on top)." .
bpm:envBridge a rdf:Property ; rdfs:domain bpm:BridgeEnv ; rdfs:range bpm:PortBridge .
bpm:envName a rdf:Property ; rdfs:domain bpm:BridgeEnv ; rdfs:range xsd:string .
bpm:envValue a rdf:Property ; rdfs:domain bpm:BridgeEnv ; rdfs:range xsd:string ;
    rdfs:comment "The literal value; the token __ROOT__ substitutes the resolved checkout root (e.g. __ROOT__/src)." .

bpm:BridgeFraming a rdfs:Class ;
    rdfs:comment "Closed vocabulary: how requests and replies are framed over the port's stdio." .
bpm:framingName a rdf:Property ; rdfs:domain bpm:BridgeFraming ; rdfs:range xsd:string .
bpm:Framing_lines_json a bpm:BridgeFraming ; bpm:framingName "lines_json" ;
    rdfs:comment "Newline-delimited single-line JSON objects; exactly one reply line per request line, in request order; blank request lines ignored by the interpreter; every remote failure is an {\"ok\": false, ...} envelope LINE, never a dead port. The only framing witnessed against a real interpreter (autofde-lab beam_port_bridge.py @ fe81a552)." .

bpm:BridgeRestartPolicy a rdfs:Class ;
    rdfs:comment "Closed vocabulary: what happens when the port dies (exit_status) or a reply times out (which poisons strict reply ordering)." .
bpm:restartPolicyName a rdf:Property ; rdfs:domain bpm:BridgeRestartPolicy ; rdfs:range xsd:string .
bpm:RestartPolicy_lazy a bpm:BridgeRestartPolicy ; bpm:restartPolicyName "lazy" ;
    rdfs:comment "The witnessed law (hand-written original): on death/timeout close the port, fail every remaining waiter {:error, :bridge_down}, and boot a fresh interpreter only on the NEXT request; restart/1 forces eagerly by just closing. No interpreter runs while the bridge is idle." .
bpm:RestartPolicy_eager a bpm:BridgeRestartPolicy ; bpm:restartPolicyName "eager" ;
    rdfs:comment "Same close/fail law, but a fresh interpreter is spawned immediately in the exit_status handler (best-effort; a failed eager spawn leaves the bridge down until the next request, which retries lazily). Choose lazy unless a real consumer needs warm-port semantics; every bridge witnessed so far is lazy." .

bpm:BridgeOp a rdfs:Class ;
    rdfs:label "Port Bridge Op" ;
    rdfs:comment "One public function of a bridge's surface: builds the request line (op wire name + ordered args), sends it through the GenServer, and awaits the reply line. Rendered as one typed Elixir wrapper per op; the moduledoc's wire-contract table is rendered from the same facts." .
bpm:opBridge a rdf:Property ; rdfs:domain bpm:BridgeOp ; rdfs:range bpm:PortBridge .
bpm:opName a rdf:Property ; rdfs:domain bpm:BridgeOp ; rdfs:range xsd:string ;
    rdfs:comment "snake_case Elixir function name and, unless bpm:opWireName says otherwise, the JSON \"op\" value." .
bpm:opOrder a rdf:Property ; rdfs:domain bpm:BridgeOp ; rdfs:range xsd:integer .
bpm:opDoc a rdf:Property ; rdfs:domain bpm:BridgeOp ; rdfs:range xsd:string ;
    rdfs:comment "Single-line doc, rendered as the wrapper's @doc." .
bpm:opReplyShape a rdf:Property ; rdfs:domain bpm:BridgeOp ; rdfs:range xsd:string ;
    rdfs:comment "MANDATORY (gates/100 refuses an op without one): the reply envelope the remote interpreter sends for this op, as a single-line wire example, e.g. {\"ok\": true, \"plan\": {...}}. Rendered into the moduledoc's request->reply table and each wrapper's @doc. The reply is produced by the interpreter, so this is a described fact, never generated code." .
bpm:opWireName a rdf:Property ; rdfs:domain bpm:BridgeOp ; rdfs:range xsd:string ;
    rdfs:comment "Optional JSON \"op\" value when it differs from bpm:opName." .
bpm:opTimeoutMs a rdf:Property ; rdfs:domain bpm:BridgeOp ; rdfs:range xsd:integer ;
    rdfs:comment "Optional per-op default reply timeout overriding bpm:bridgeDefaultTimeoutMs for this op's wrapper (heavy solves vs cheap pings)." .
bpm:opSampleRequest a rdf:Property ; rdfs:domain bpm:BridgeOp ; rdfs:range xsd:string ;
    rdfs:comment "Optional single-line JSON request body (complete, with \"op\") rendered into the generated qualification as the payload of the timeout test: the test sends it with a 100 ms budget against an interpreter instructed to sleep past it, asserting the strict-ordering poisoning law end to end. Required on exactly the op the qualification should time out (gates/100: at most one per bridge)." .

bpm:BridgeArg a rdfs:Class ;
    rdfs:label "Port Bridge Op Argument" ;
    rdfs:comment "One argument of one bpm:BridgeOp, in bpm:argOrder. The ordered arg set IS the op's request shape (there is no separate descriptive literal to drift from it)." .
bpm:argOp a rdf:Property ; rdfs:domain bpm:BridgeArg ; rdfs:range bpm:BridgeOp .
bpm:argName a rdf:Property ; rdfs:domain bpm:BridgeArg ; rdfs:range xsd:string ;
    rdfs:comment "snake_case Elixir parameter name." .
bpm:argOrder a rdf:Property ; rdfs:domain bpm:BridgeArg ; rdfs:range xsd:integer .
bpm:argWireKey a rdf:Property ; rdfs:domain bpm:BridgeArg ; rdfs:range xsd:string ;
    rdfs:comment "Optional JSON key when it differs from bpm:argName." .
bpm:argType a rdf:Property ; rdfs:domain bpm:BridgeArg ; rdfs:range bpm:BridgeArgType .
bpm:argEncoding a rdf:Property ; rdfs:domain bpm:BridgeArg ; rdfs:range bpm:BridgeArgEncoding ;
    rdfs:comment "Default bpm:BridgeArgEncoding_passthrough." .
bpm:argSample a rdf:Property ; rdfs:domain bpm:BridgeArg ; rdfs:range xsd:string ;
    rdfs:comment "Optional Elixir literal (e.g. 2, \"x\") rendered into the generated qualification as this argument's sample value. An op whose EVERY argument carries a sample gets a real happy-path round-trip test; an op with any unsampled argument gets none (the qualification is fact-complete or silent, never half-built)." .

bpm:BridgeArgType a rdfs:Class ;
    rdfs:comment "Closed vocabulary of bridge-op argument types, each carrying its Elixir typespec + guard -- the port-bridge analogue of the bpm:EngineArgType vocabulary." .
bpm:argTypeName a rdf:Property ; rdfs:domain bpm:BridgeArgType ; rdfs:range xsd:string .
bpm:bridgeArgElixirType a rdf:Property ; rdfs:domain bpm:BridgeArgType ; rdfs:range xsd:string .
bpm:bridgeArgElixirGuard a rdf:Property ; rdfs:domain bpm:BridgeArgType ; rdfs:range xsd:string ;
    rdfs:comment "Optional guard function name (is_binary, is_integer, is_map, is_list); absent means the positional arg is unguarded." .
bpm:bridgeArgWireExample a rdf:Property ; rdfs:domain bpm:BridgeArgType ; rdfs:range xsd:string ;
    rdfs:comment "Type tag rendered into the moduledoc wire-contract line, e.g. <string> or <list_map>." .

bpm:BridgeArgType_string a bpm:BridgeArgType ; bpm:argTypeName "string" ;
    bpm:bridgeArgElixirType "String.t()" ; bpm:bridgeArgElixirGuard "is_binary" ;
    bpm:bridgeArgWireExample "<string>" .
bpm:BridgeArgType_integer a bpm:BridgeArgType ; bpm:argTypeName "integer" ;
    bpm:bridgeArgElixirType "non_neg_integer()" ; bpm:bridgeArgElixirGuard "is_integer" ;
    bpm:bridgeArgWireExample "<integer>" .
bpm:BridgeArgType_number a bpm:BridgeArgType ; bpm:argTypeName "number" ;
    bpm:bridgeArgElixirType "number()" ; bpm:bridgeArgElixirGuard "is_number" ;
    bpm:bridgeArgWireExample "<number>" .
bpm:BridgeArgType_boolean a bpm:BridgeArgType ; bpm:argTypeName "boolean" ;
    bpm:bridgeArgElixirType "boolean()" ; bpm:bridgeArgElixirGuard "is_boolean" ;
    bpm:bridgeArgWireExample "<boolean>" .
bpm:BridgeArgType_map a bpm:BridgeArgType ; bpm:argTypeName "map" ;
    bpm:bridgeArgElixirType "map()" ; bpm:bridgeArgElixirGuard "is_map" ;
    bpm:bridgeArgWireExample "<map>" .
bpm:BridgeArgType_list_map a bpm:BridgeArgType ; bpm:argTypeName "list_map" ;
    bpm:bridgeArgElixirType "[map()]" ; bpm:bridgeArgElixirGuard "is_list" ;
    bpm:bridgeArgWireExample "<list_map>" .
bpm:BridgeArgType_term a bpm:BridgeArgType ; bpm:argTypeName "term" ;
    bpm:bridgeArgElixirType "term()" ;
    bpm:bridgeArgWireExample "<term>" ;
    rdfs:comment "Unguarded pass-anythrough value for interpreters that accept JSON-independent payloads (already-encoded structures). No guard is rendered." .

bpm:BridgeArgEncoding a rdfs:Class ;
    rdfs:comment "Closed vocabulary: the host-side transform between the Elixir argument and the JSON request line. Atom keys must be stringified for JSON -- the witnessed interpreters all take string-keyed maps -- so the stringify family exists precisely to keep consumer call sites idiomatic (atom keys) while the wire stays string-keyed." .
bpm:bridgeArgEncodingName a rdf:Property ; rdfs:domain bpm:BridgeArgEncoding ; rdfs:range xsd:string .
bpm:BridgeArgEncoding_passthrough a bpm:BridgeArgEncoding ; bpm:bridgeArgEncodingName "passthrough" ;
    rdfs:comment "\"<wireKey>\" => <arg>, verbatim (scalars, pre-stringified maps)." .
bpm:BridgeArgEncoding_stringify a bpm:BridgeArgEncoding ; bpm:bridgeArgEncodingName "stringify" ;
    rdfs:comment "\"<wireKey>\" => stringify_keys(<arg>) -- deep atom-to-string key rewrite (the hand-written original's stringify_keys/1)." .
bpm:BridgeArgEncoding_stringify_list a bpm:BridgeArgEncoding ; bpm:bridgeArgEncodingName "stringify_list" ;
    rdfs:comment "\"<wireKey>\" => Enum.map(<arg>, &stringify_keys/1) -- per-element deep key rewrite for list-of-map args." .
