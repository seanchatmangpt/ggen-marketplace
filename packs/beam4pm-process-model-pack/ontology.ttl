# beam4pm-process-model-pack vocabulary and reusable governed kernel.
#
# Consumer process-mining record definitions remain consumer-owned. The pack
# additionally supplies one reusable execution-kernel contract whose purpose is
# infrastructure: it defines the lawful lifecycle used by the generated
# governor itself, not a domain/business process.

@prefix bpm:  <https://ggen.dev/ontology/beam-process-model#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

bpm:RecordType a rdfs:Class ;
    rdfs:label "Record Type" ;
    rdfs:comment "One admitted BEAM record/struct type projected into generated code." .

bpm:Field a rdfs:Class ;
    rdfs:label "Field" ;
    rdfs:comment "One typed, ordered field belonging to a bpm:RecordType." .

bpm:recordName a rdf:Property ; rdfs:domain bpm:RecordType ; rdfs:range xsd:string .
bpm:recordDoc a rdf:Property ; rdfs:domain bpm:RecordType ; rdfs:range xsd:string .
bpm:hasField a rdf:Property ; rdfs:domain bpm:RecordType ; rdfs:range bpm:Field .
bpm:fieldName a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string .
bpm:fieldType a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string ;
    rdfs:comment "Closed set: string, integer, float, boolean, datetime, atom, list_string, map." .
bpm:fieldDoc a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string .
bpm:fieldRequired a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string ;
    rdfs:comment "Plain string literal true or false; templates compare it as a string." .
bpm:fieldOrder a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:integer .

# --- Shared field-type vocabulary (2026-09-04) ------------------------
#
# Externalizes the bpm:fieldType -> per-language-representation mapping as
# a single, SPARQL-joinable ontology fact instead of the same 8-branch
# if/elif dispatch ladder repeated in every consuming template (measured
# before this change: 26 "field_type ==" comparisons across 12 template
# files in this pack alone). Every affected template's `fields` query now
# performs one generic JOIN against this vocabulary via the existing
# ?f bpm:fieldType ?field_type binding and a matching bpm:FieldType
# individual's bpm:fieldTypeName -- admitting a 9th field type means
# adding ONE bpm:FieldType individual here; it touches ZERO template
# files (the prior architecture required editing 12 template files plus
# this file's own enum comment plus gates/020_field_type_enum.rq -- 14
# sites -- for the same change).
#
# A field_type with no matching bpm:FieldType individual now makes that
# field DISAPPEAR from every affected template's `fields` result set (a
# visible, mandatory-JOIN empty-match failure) rather than the prior
# silent gap this exact duplication produced in
# templates/beam4pm_types.schema.json.tmpl (an if/elif chain with no
# else/default branch: a field type falling through every arm emitted a
# JSON Schema property with no "type" key and no generator error).
#
# The literal token __FIELD__ inside a sample*Expr value below is plain
# string data (not Turtle or Tera syntax), substituted at render time via
# Tera's `replace` filter with the field's own bpm:fieldName. Only the
# "string" type's samples use it -- it is the only type whose original
# hand-written literals were field-name-parameterized (every other type
# used a fixed literal regardless of field name).

bpm:FieldType a rdfs:Class ;
    rdfs:label "Field Type" ;
    rdfs:comment "One admitted value of the closed bpm:fieldType vocabulary (string, integer, float, boolean, datetime, atom, list_string, map), carrying every per-language projection (Erlang, Elixir, Gleam, JSON Schema, Ash) and sample-value fact so templates fetch a resolved expression by SPARQL JOIN instead of hardcoding a duplicated if/elif dispatch ladder." .

bpm:fieldTypeName a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Matches a bpm:Field's bpm:fieldType literal value exactly." .
bpm:erlangTypeExpr a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Erlang typespec expression, e.g. binary()." .
bpm:elixirTypeExpr a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Elixir @type expression, e.g. String.t()." .
bpm:gleamTypeExpr a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Gleam type expression, e.g. String. Two disclosed projection divergences from Erlang/Elixir (atom -> String, map -> dict.Dict(String, String)) are real projection facts here, not a template-level special case." .
bpm:jsonSchemaType a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "JSON Schema draft-07 \"type\" value." .
bpm:jsonSchemaItemsType a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Empty string unless jsonSchemaType is array, in which case the array's \"items\".\"type\" value." .
bpm:isAtomCodec a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Plain string literal true or false (same convention as bpm:fieldRequired): whether beam4pm_codec/BeamPM.Codec must atom_to_binary/binary_to_atom-convert this type's values." .
bpm:ashTypeExpr a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Ash attribute type expression (source text) for the fourth sibling projection (VISION-2030 section 4/23 Polyglot BEAM), e.g. :string or {:array, :string}. JOINed by igniter/queries/ash_fields.rq into both igniter Ash templates in place of the former hardcoded 8-branch dispatch ladder, so an unmapped type is a visible, named render refusal instead of a FunctionClauseError. datetime is :utc_datetime_usec, never :utc_datetime -- Ash's :utc_datetime is constraints: [precision: :second] and truncates the microseconds every other leg carries verbatim on the wire (measured: 12:00:00.123456Z read back as 12:00:00Z, DateTime.compare :lt). gates/035_field_type_ash_expr.rq refuses a bpm:FieldType carrying anything but exactly one value." .
bpm:sampleMinErlang a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Minimal fixed Erlang sample literal used by beam4pm_types_tests.erl (constructor-only tests, not codec/roundtrip)." .
bpm:sampleMinElixir a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Minimal fixed Elixir sample literal used by beam4pm_types_test.exs (constructor-only tests, not codec/roundtrip)." .
bpm:sampleErlang a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Codec/roundtrip Erlang sample INPUT literal (beam4pm_codec_tests.erl, beam4pm_roundtrip.erl). May contain __FIELD__." .
bpm:sampleErlangEncoded a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "The sampleErlang value after round-tripping through beam4pm_codec:to_map/1 -- differs from sampleErlang only for atom (binary-ified). May contain __FIELD__." .
bpm:sampleElixir a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "Codec/roundtrip Elixir sample INPUT literal (beam4pm_codec_test.exs, beam4pm_roundtrip.ex). May contain __FIELD__." .
bpm:sampleElixirEncoded a rdf:Property ; rdfs:domain bpm:FieldType ; rdfs:range xsd:string ;
    rdfs:comment "The sampleElixir value after round-tripping through BeamPM.Codec.to_map/1 -- differs from sampleElixir only for atom (string-ified). May contain __FIELD__." .

bpm:FieldType_string a bpm:FieldType ;
    bpm:fieldTypeName "string" ;
    bpm:erlangTypeExpr "binary()" ;
    bpm:elixirTypeExpr "String.t()" ;
    bpm:gleamTypeExpr "String" ;
    bpm:jsonSchemaType "string" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":string" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "<<\"x\">>" ;
    bpm:sampleMinElixir "\"x\"" ;
    bpm:sampleErlang "<<\"sample___FIELD__\">>" ;
    bpm:sampleErlangEncoded "<<\"sample___FIELD__\">>" ;
    bpm:sampleElixir "\"sample___FIELD__\"" ;
    bpm:sampleElixirEncoded "\"sample___FIELD__\"" .

bpm:FieldType_integer a bpm:FieldType ;
    bpm:fieldTypeName "integer" ;
    bpm:erlangTypeExpr "integer()" ;
    bpm:elixirTypeExpr "integer()" ;
    bpm:gleamTypeExpr "Int" ;
    bpm:jsonSchemaType "integer" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":integer" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "1" ;
    bpm:sampleMinElixir "1" ;
    bpm:sampleErlang "42" ;
    bpm:sampleErlangEncoded "42" ;
    bpm:sampleElixir "42" ;
    bpm:sampleElixirEncoded "42" .

bpm:FieldType_float a bpm:FieldType ;
    bpm:fieldTypeName "float" ;
    bpm:erlangTypeExpr "float()" ;
    bpm:elixirTypeExpr "float()" ;
    bpm:gleamTypeExpr "Float" ;
    bpm:jsonSchemaType "number" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":float" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "1.0" ;
    bpm:sampleMinElixir "1.0" ;
    bpm:sampleErlang "3.5" ;
    bpm:sampleErlangEncoded "3.5" ;
    bpm:sampleElixir "3.5" ;
    bpm:sampleElixirEncoded "3.5" .

bpm:FieldType_boolean a bpm:FieldType ;
    bpm:fieldTypeName "boolean" ;
    bpm:erlangTypeExpr "boolean()" ;
    bpm:elixirTypeExpr "boolean()" ;
    bpm:gleamTypeExpr "Bool" ;
    bpm:jsonSchemaType "boolean" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":boolean" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "true" ;
    bpm:sampleMinElixir "true" ;
    bpm:sampleErlang "true" ;
    bpm:sampleErlangEncoded "true" ;
    bpm:sampleElixir "true" ;
    bpm:sampleElixirEncoded "true" .

bpm:FieldType_datetime a bpm:FieldType ;
    bpm:fieldTypeName "datetime" ;
    bpm:erlangTypeExpr "binary()" ;
    bpm:elixirTypeExpr "String.t()" ;
    bpm:gleamTypeExpr "String" ;
    bpm:jsonSchemaType "string" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":utc_datetime_usec" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "<<\"2026-01-01T00:00:00Z\">>" ;
    bpm:sampleMinElixir "\"2026-01-01T00:00:00Z\"" ;
    # The codec/roundtrip fixture carries all six microsecond digits on purpose:
    # datetime is an opaque binary()/String.t()/JSON string on the Erlang,
    # Elixir and JSON legs (it round-trips unchanged), while the Ash leg parses
    # it into a %DateTime{} -- so this is the one fixture that can catch an Ash
    # attribute type that silently truncates sub-second precision. A
    # no-fraction value here would make that truncation invisible to every
    # generated test (it was, until 2026-09-05).
    bpm:sampleErlang "<<\"2026-08-29T12:00:00.123456Z\">>" ;
    bpm:sampleErlangEncoded "<<\"2026-08-29T12:00:00.123456Z\">>" ;
    bpm:sampleElixir "\"2026-08-29T12:00:00.123456Z\"" ;
    bpm:sampleElixirEncoded "\"2026-08-29T12:00:00.123456Z\"" .

bpm:FieldType_atom a bpm:FieldType ;
    bpm:fieldTypeName "atom" ;
    bpm:erlangTypeExpr "atom()" ;
    bpm:elixirTypeExpr "atom()" ;
    bpm:gleamTypeExpr "String" ;
    bpm:jsonSchemaType "string" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":atom" ;
    bpm:isAtomCodec "true" ;
    bpm:sampleMinErlang "some_atom" ;
    bpm:sampleMinElixir ":some_atom" ;
    bpm:sampleErlang "sample_atom" ;
    bpm:sampleErlangEncoded "<<\"sample_atom\">>" ;
    bpm:sampleElixir ":sample_atom" ;
    bpm:sampleElixirEncoded "\"sample_atom\"" .

bpm:FieldType_list_string a bpm:FieldType ;
    bpm:fieldTypeName "list_string" ;
    bpm:erlangTypeExpr "[binary()]" ;
    bpm:elixirTypeExpr "[String.t()]" ;
    bpm:gleamTypeExpr "List(String)" ;
    bpm:jsonSchemaType "array" ;
    bpm:jsonSchemaItemsType "string" ;
    bpm:ashTypeExpr "{:array, :string}" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "[<<\"a\">>]" ;
    bpm:sampleMinElixir "[\"a\"]" ;
    bpm:sampleErlang "[<<\"alpha\">>, <<\"beta\">>]" ;
    bpm:sampleErlangEncoded "[<<\"alpha\">>, <<\"beta\">>]" ;
    bpm:sampleElixir "[\"alpha\", \"beta\"]" ;
    bpm:sampleElixirEncoded "[\"alpha\", \"beta\"]" .

bpm:FieldType_map a bpm:FieldType ;
    bpm:fieldTypeName "map" ;
    bpm:erlangTypeExpr "map()" ;
    bpm:elixirTypeExpr "map()" ;
    bpm:gleamTypeExpr "dict.Dict(String, String)" ;
    bpm:jsonSchemaType "object" ;
    bpm:jsonSchemaItemsType "" ;
    bpm:ashTypeExpr ":map" ;
    bpm:isAtomCodec "false" ;
    bpm:sampleMinErlang "#{}" ;
    bpm:sampleMinElixir "%{}" ;
    bpm:sampleErlang "#{<<\"k\">> => <<\"v\">>}" ;
    bpm:sampleErlangEncoded "#{<<\"k\">> => <<\"v\">>}" ;
    bpm:sampleElixir "%{\"k\" => \"v\"}" ;
    bpm:sampleElixirEncoded "%{\"k\" => \"v\"}" .

# NOTE (2026-08-30): an earlier revision of this file added a
# "post-LLM governed execution vocabulary" (bpm:ProcessContract,
# bpm:TransitionSpec, bpm:governed_kernel and 8 sibling classes) plus a
# hand-rolled BeamPM.Governor template pair. A 4-lens adversarial audit
# (CONFIRMED_CRITICAL on every lens) found it duplicated the real, tested
# BeamPM.Actuation Reactor pipeline with zero shared code, performed ZERO
# real I/O despite claiming to be a BRCE actuation boundary, used a receipt
# schema un-mineable by BeamPM.Discovery, crashed unhandled on malformed
# input, and — critically — accepted a forged authority_digest without
# verifying it was ever computed by the module itself. It was also never
# actually consumed by beam4pm (the submodule pin predated it). Removed
# entirely and replaced by BeamPM.ProcessGovernor
# (igniter/templates/beam4pm_process_governor.ex.eex), which adds the one
# legitimate capability the original had (named, ordered, exact-state-hash-
# fenced multi-step process governance) as a thin layer that DELEGATES
# every admit/execute/receipt decision to the real BeamPM.Actuation --
# never reimplementing it. See docs/first-principles-rewrite-rationale.md
# in the consuming project for the full audit-to-rewrite record.

# --- Hand-authored-source admission vocabulary (2026-09-05) --------------
#
# VISION-2030 section 2 requires that a direct (non-manufactured) source
# intervention be "visible, bounded, and counted as manufacturing debt", and
# section 24 names "ggen-only manufacture requires routine privileged
# handwritten source commits" as a falsifier of the whole thesis. Before
# this vocabulary existed, a consumer had no way to STATE that a file under
# a manufactured root (src/, lib/, test/, gleam/src, ...) is hand-authored
# on purpose: the only provenance signal was the per-file "GENERATED by
# ggen" marker, so an unmarked file was simply invisible to every gate
# (gate_m2_check.sh only ever looks for MARKED files) and the doctrine's
# privileged-exception path only covered edits to files that already carry
# the marker. beam4pm measured 33 such unmarked files (12 native-engine
# facades, 14 hand-authored ExUnit qualification files, 1 OTP app resource
# file, 6 hand-authored reference docs) with zero admission records.
#
# One bpm:HandAuthoredSource individual per unmarked file (declared in the
# CONSUMER's ontology.ttl, never here) turns that prose falsifier into a
# mechanical check: templates/beam4pm_hand_authored_source.tsv.tmpl renders
# the admitted set as a machine-readable manifest, the consumer's
# scripts/gate_authorship_check.sh diffs it against the real tree (refusing
# an unmarked file with no individual, an individual whose path is gone, an
# individual whose file now carries the marker, a content-sha256 drift, an
# expired admission), templates/beam4pm_hand_authored_source.md.tmpl
# renders the same set as a counted reference doc, and
# templates/beam4pm_authorship_gate_test.exs.tmpl renders the Chicago test
# that runs the real gate as a subprocess against the real tree AND against
# planted temp fixtures that must be refused.
#
# bpm:AuthorshipKind is a CLOSED vocabulary (gates/060 anti-joins against
# it, exactly like gates/020 does for bpm:FieldType), each kind carrying
# bpm:countsAsDebt and a bpm:debtCeiling that gates/070 enforces as a hard
# per-kind count ceiling -- so the class cannot quietly become the place
# where hand-authoring gets normalized. Raising a ceiling is a visible edit
# to THIS file, reviewed as a pack change, never an ambient grant.

bpm:AuthorshipKind a rdfs:Class ;
    rdfs:label "Authorship Kind" ;
    rdfs:comment "Closed vocabulary of reasons a file under a manufactured root may lawfully lack ggen provenance. Each kind states whether it is counted as manufacturing debt (VISION-2030 section 2) and the maximum number of admitted files it may hold." .

bpm:authorshipKindName a rdf:Property ; rdfs:domain bpm:AuthorshipKind ; rdfs:range xsd:string ;
    rdfs:comment "Stable snake_case key joined by bpm:HandAuthoredSource individuals (via bpm:authorshipKind) and printed into the manifest." .
bpm:authorshipKindDoc a rdf:Property ; rdfs:domain bpm:AuthorshipKind ; rdfs:range xsd:string .
bpm:countsAsDebt a rdf:Property ; rdfs:domain bpm:AuthorshipKind ; rdfs:range xsd:string ;
    rdfs:comment "Plain string literal true or false; templates and the shell gate compare it as a string (same convention as bpm:fieldRequired). true: every file of this kind is counted as manufacturing debt and must carry bpm:contentSha256 + bpm:admissionExpires + bpm:sunsetPlan." .
bpm:debtCeiling a rdf:Property ; rdfs:domain bpm:AuthorshipKind ; rdfs:range xsd:integer ;
    rdfs:comment "Hard maximum number of bpm:HandAuthoredSource individuals that may name this kind; gates/070_hand_authored_source_ceiling.rq refuses the whole sync when exceeded." .

bpm:AuthorshipKind_native_engine_facade a bpm:AuthorshipKind ;
    bpm:authorshipKindName "native_engine_facade" ;
    bpm:countsAsDebt "true" ;
    bpm:debtCeiling 12 ;
    bpm:authorshipKindDoc "A thin, delegation-only BEAM facade (Erlang / Elixir / Gleam) over ONE native engine hosted via wasm (rust4pm, petgraph, ferroplan, tract). Its function surface is the engine's, not a bpm:RecordType projection, so no template currently derives it -- counted as debt until the engine surface is admitted as ontology facts and the facades are rendered from them." .

bpm:AuthorshipKind_hand_authored_qualification a bpm:AuthorshipKind ;
    bpm:authorshipKindName "hand_authored_qualification" ;
    bpm:countsAsDebt "true" ;
    bpm:debtCeiling 16 ;
    bpm:authorshipKindDoc "A hand-authored ExUnit qualification file under test/ (VISION-2030 section 2 lists tests-as-specification among lawful inputs, but this pack's convention manufactures every test from a template, so an unmanufactured test is counted as debt). Sunset: migrate its fixture bindings into ontology facts and render it from a .tmpl/.eex like the beam4pm_types_test.exs family." .

bpm:AuthorshipKind_manufacturing_input a bpm:AuthorshipKind ;
    bpm:authorshipKindName "manufacturing_input" ;
    bpm:countsAsDebt "false" ;
    bpm:debtCeiling 4 ;
    bpm:authorshipKindDoc "Project scaffolding that happens to live under a manufactured root but is a lawful manufacturing input in the same class as ggen.toml / rebar.config / mix.exs (e.g. src/beam4pm.app.src). Not counted as debt; still admitted so the tree has zero unexplained unmarked files." .

bpm:AuthorshipKind_reference_evidence a bpm:AuthorshipKind ;
    bpm:authorshipKindName "reference_evidence" ;
    bpm:countsAsDebt "false" ;
    bpm:debtCeiling 8 ;
    bpm:authorshipKindDoc "A hand-authored reference document under docs/reference/ sitting beside the manufactured ones (VISION-2030 section 2: reference evidence is a lawful input). Not counted as debt; admitted so a doc that only LOOKS manufactured cannot hide there unexplained." .

bpm:HandAuthoredSource a rdfs:Class ;
    rdfs:label "Hand-Authored Source" ;
    rdfs:comment "One admitted, counted exception: a file under a manufactured root that carries no GENERATED marker on purpose. Declared by the consumer, one individual per file, with the capability-object fields the privileged-exception doctrine requires (subject/path, authorizing principal, reason, acceptance command, expiration). Rendered into schema/beam4pm_hand_authored_source.tsv and docs/reference/beam4pm_hand_authored_source.md; enforced by the consumer's scripts/gate_authorship_check.sh." .

bpm:sourcePath a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "Repo-root-relative path of the admitted file, exactly as `git ls-files` prints it." .
bpm:authorshipKind a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range bpm:AuthorshipKind .
bpm:authorizingPrincipal a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string .
bpm:admissionReason a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "Why manufacturing this exact file is currently disproportionate (or why it is a lawful input), stated for THIS file, not the kind." .
bpm:acceptanceCommand a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "A shell command, run from the repo root, that really exercises the admitted file. Executed by scripts/gate_authorship_check.sh --exercise, which refuses a failing command and a vacuous one (every ExUnit test skipped) unless bpm:acceptancePrerequisite names an absent artifact." .
bpm:acceptancePrerequisite a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "Optional repo-root-relative path of a build artifact the acceptance command needs (e.g. a wasm engine). When absent on disk the gate reports ACCEPTANCE_BLOCKED_PREREQUISITE instead of refusing as vacuous." .
bpm:contentSha256 a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "Lowercase hex sha256 of the file's bytes at admission. Required for debt kinds: any later edit surfaces as REFUSED_SHA_DRIFT until re-admitted with the new digest -- an edit to admitted hand-authored source is new debt, never a free ride." .
bpm:admittedAtCommit a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "Abbreviated commit SHA of the consumer tree the admission was measured against." .
bpm:admissionExpires a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "ISO-8601 date (plain string literal, YYYY-MM-DD) after which the gate refuses the admission as REFUSED_EXPIRED; the debt must then be eliminated or visibly renewed. Required for debt kinds." .
bpm:sunsetPlan a rdf:Property ; rdfs:domain bpm:HandAuthoredSource ; rdfs:range xsd:string ;
    rdfs:comment "How this particular debt is meant to be eliminated (which template family / which ontology facts would replace the hand-authored file). Required for debt kinds." .
