# beam4pm-process-model-pack vocabulary.
#
# This pack ships templates and vocabulary only: it renders Erlang and
# Elixir record/struct definitions from the consumer's own bpm:RecordType
# graph and declares no bpm:RecordType or bpm:Field individuals of its own.
# The actual process-mining record definitions (OCEL events and objects,
# Petri net places/transitions/arcs, directly-follows edges, and
# conformance-checking alignment moves) are admitted instance data supplied
# by the consuming project's own ontology.ttl (e.g. beam4pm).

@prefix bpm:  <https://ggen.dev/ontology/beam-process-model#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ── Classes ──────────────────────────────────────────────────────────────────

bpm:RecordType a rdfs:Class ;
    rdfs:label "Record Type" ;
    rdfs:comment "One admitted BEAM (Erlang/Elixir) record/struct type, projected into generated code by this pack's templates." .

bpm:Field a rdfs:Class ;
    rdfs:label "Field" ;
    rdfs:comment "One typed, ordered field belonging to a bpm:RecordType." .

# ── RecordType properties ────────────────────────────────────────────────────

bpm:recordName a rdf:Property ; rdfs:domain bpm:RecordType ; rdfs:range xsd:string ;
    rdfs:comment "snake_case record/module name, e.g. \"ocel_event\"." .

bpm:recordDoc a rdf:Property ; rdfs:domain bpm:RecordType ; rdfs:range xsd:string ;
    rdfs:comment "One-line doc comment for the generated record/struct." .

bpm:hasField a rdf:Property ; rdfs:domain bpm:RecordType ; rdfs:range bpm:Field ;
    rdfs:comment "One or more ordered fields belonging to this record type." .

# ── Field properties ─────────────────────────────────────────────────────────

bpm:fieldName a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string ;
    rdfs:comment "snake_case field name, e.g. \"event_id\"." .

bpm:fieldType a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string ;
    rdfs:comment "Closed set: string, integer, float, boolean, datetime, atom, list_string, map." .

bpm:fieldDoc a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string ;
    rdfs:comment "One-line doc comment for the generated field." .

bpm:fieldRequired a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:string ;
    rdfs:comment "Whether generated constructors refuse construction when this field is absent. MUST be the plain string literal \"true\" or \"false\" -- never an ^^xsd:boolean-typed literal, which is invalid combined with a plain string value and is compared as a string by every template in this pack." .

bpm:fieldOrder a rdf:Property ; rdfs:domain bpm:Field ; rdfs:range xsd:integer ;
    rdfs:comment "1-based stable ordering of this field within its record type." .
