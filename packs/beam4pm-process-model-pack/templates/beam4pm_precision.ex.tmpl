  @moduledoc """
  ETC (Escaping-edge Trace Conformance) precision for one trace against a
  directly-follows model, structurally adapted from the real Adriansyah/
  Dongen/Van der Aalst escaping-edges formula already implemented in
  ex4pm's `Ex4pmEngine.ETCPrecision`
  (apps/ex4pm_engine/lib/ex4pm_engine/etc_precision.ex in the ex4pm repo):

      Precision_ETC(L, N, alpha) =
        1.0 - (sum |EscapingEdges(s)| / (sum |Enabled(s)| + alpha * sum |EscapingEdges(s)|))

  ex4pm's original walks a Petri-net marking automaton: a "state" is a
  marking, and the transitions "enabled" in a state are those whose input
  places are all marked; at each replayed move it counts how many enabled
  transitions were NOT the one actually taken ("escaping edges") against how
  many were enabled in total, then aggregates across the whole log.

  beam4pm's admitted model is a directly-follows graph (a `dfg_edge` list),
  not a Petri net, so this module reduces the SAME automaton concept
  onto that representation instead of inventing a different metric: a
  "state" is the current activity, and the transitions "enabled" out of a
  state are the distinct model edges whose source is that activity. The
  per-step escaping-edge rule below is the same policy as ex4pm's
  `replay_moves_for_etc/3`, restated over directly-follows edges:

    * `enabled_count` = out-degree of the current activity in the model
      (the number of distinct edges the model admits leaving that
      activity).
    * `escaping_count` = `max(0, enabled_count - 1)` when the trace's
      actual next activity IS one of those model edges (a "synchronous
      move": the model offered several options, exactly one was taken, the
      rest went unobserved / "escaped"); `enabled_count` (every one of
      them) when the trace's next activity is NOT a model edge at all (a
      pure "log move": none of the model's predictions from this state
      matched, so everything the model offered here escaped observation).

  `total_enabled`/`total_escaping` accumulate these counts across every
  adjacent pair of exactly ONE trace, matching `BeamPM.Discovery.
  conformance/2`'s existing per-trace contract (ex4pm's version aggregates
  over an entire log to score one model; this is the same sum specialized
  to a log of one trace). `alpha` (default `0.0`, ex4pm's
  `:negative_event_weight` smoothing knob) is exposed as `etc_precision/3`'s
  third argument for the identical reason ex4pm exposes it.

  Admitted record types this module operates over:

  {% for r in records %}  * `{{ r.record_name }}` - {{ r.record_doc }}
  {% endfor %}"""

  alias BeamPM.Types.DfgEdge
  alias BeamPM.Types.LogTrace

  @doc """
  ETC precision of `trace`'s activity sequence against the directly-follows
  model `edges`. `alpha` (default `0.0`) is the escaping-edge smoothing
  weight described in the moduledoc. A trace with fewer than two activities
  has no state transition to evaluate: nothing was observed, so nothing
  could escape, and precision is honestly `1.0` - the same convention
  `BeamPM.Discovery.conformance/2` already uses for fitness on such traces.
  """
  @spec etc_precision([DfgEdge.t()], LogTrace.t(), number()) :: float()
  def etc_precision(edges, trace, alpha \\ 0.0)

  def etc_precision(edges, %LogTrace{} = trace, alpha) when is_list(edges) and is_number(alpha) do
    case adjacent_pairs(trace.activity_sequence) do
      [] ->
        1.0

      pairs ->
        outgoing = out_degrees(edges)
        known = MapSet.new(edges, fn %DfgEdge{} = edge -> {edge.source_activity, edge.target_activity} end)

        {total_enabled, total_escaping} =
          Enum.reduce(pairs, {0, 0}, fn {from, _to} = pair, {enabled_acc, escaping_acc} ->
            enabled = Map.get(outgoing, from, 0)

            escaping =
              if MapSet.member?(known, pair) do
                max(0, enabled - 1)
              else
                enabled
              end

            {enabled_acc + enabled, escaping_acc + escaping}
          end)

        denominator = total_enabled + alpha * total_escaping

        if denominator > 0 do
          max(0.0, 1.0 - total_escaping / denominator)
        else
          1.0
        end
    end
  end

  # Internal: number of distinct model edges leaving each source activity
  # (the automaton's "enabled transition count" per state).
  @spec out_degrees([DfgEdge.t()]) :: %{optional(String.t()) => non_neg_integer()}
  defp out_degrees(edges) do
    edges
    |> Enum.map(fn %DfgEdge{} = edge -> {edge.source_activity, edge.target_activity} end)
    |> Enum.uniq()
    |> Enum.frequencies_by(fn {source, _target} -> source end)
  end

  @spec adjacent_pairs([String.t()] | nil) :: [{String.t(), String.t()}]
  defp adjacent_pairs(sequence) when is_list(sequence) do
    Enum.zip(sequence, Enum.drop(sequence, 1))
  end

  defp adjacent_pairs(_sequence), do: []
end
