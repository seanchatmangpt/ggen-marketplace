---
to: "schema/pddl/{{ process_id }}.domain.pddl"
sparql:
  contracts: |
    PREFIX bpmg: <https://ggen.dev/ontology/beam4pm-process-governor#>
    SELECT ?process_id ?initial_state WHERE {
      ?c a bpmg:ProcessContract ;
         bpmg:processId ?process_id ;
         bpmg:initialState ?initial_state .
    } ORDER BY ?process_id
  actions: |
    PREFIX bpma: <https://ggen.dev/ontology/beam4pm-actuation#>
    SELECT ?action_name WHERE {
      ?a a bpma:AdmittedActuation ;
         bpma:actionName ?action_name .
    } ORDER BY ?action_name
  requires: |
    PREFIX bpma: <https://ggen.dev/ontology/beam4pm-actuation#>
    SELECT ?action_name ?fact WHERE {
      ?a a bpma:AdmittedActuation ;
         bpma:actionName ?action_name ;
         bpma:requiresFact ?fact .
    } ORDER BY ?action_name ?fact
  facts: |
    PREFIX bpma: <https://ggen.dev/ontology/beam4pm-actuation#>
    SELECT DISTINCT ?fact WHERE {
      ?a a bpma:AdmittedActuation ;
         bpma:requiresFact ?fact .
    } ORDER BY ?fact
for_each: contracts
---
; GENERATED by ggen from the admitted bpma:AdmittedActuation graph, projected as
; the PDDL domain for bpmg:ProcessContract "{{ process_id }}". Do not edit.
;
; Formal projection (VISION-2030 section 10, `canonical graph -> formal
; projection -> planner result`): every bpma:AdmittedActuation becomes exactly
; one :action whose name IS its bpma:actionName; every bpma:requiresFact becomes
; a 0-arity precondition atom the matching problem's :init must assert. Process
; states are typed objects supplied by {{ process_id }}.problem.pddl; an action
; is applicable only where that problem asserts (allows_<action> ?from ?to), so
; an admitted actuation the contract never names has no applicable grounding
; and can never appear in a plan -- the domain carries every lawful actuation,
; the problem selects the lawful transitions.
(define (domain {{ process_id }})
  (:requirements :strips :typing)
  (:types state)
  (:predicates
    (in_state ?s - state)
{%- for f in facts %}
    ({{ f.fact }})
{%- endfor %}
{%- for a in actions %}
    (allows_{{ a.action_name }} ?from - state ?to - state)
{%- endfor %}
  )
{%- for a in actions %}
{%- set areq = requires | filter(attribute="action_name", value=a.action_name) %}
  (:action {{ a.action_name }}
    :parameters (?from - state ?to - state)
    :precondition (and (in_state ?from) (allows_{{ a.action_name }} ?from ?to){% for r in areq %} ({{ r.fact }}){% endfor %})
    :effect (and (in_state ?to) (not (in_state ?from)))
  )
{%- endfor %}
)
