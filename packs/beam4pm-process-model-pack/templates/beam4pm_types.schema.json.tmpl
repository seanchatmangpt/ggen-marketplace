---
to: schema/beam4pm_types.schema.json
sparql:
  records: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:recordDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order ?json_schema_type ?json_schema_items_type WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:hasField ?f .
      ?f bpm:fieldName ?field_name ; bpm:fieldType ?field_type ; bpm:fieldDoc ?field_doc ;
         bpm:fieldRequired ?field_required ; bpm:fieldOrder ?field_order .
      ?ft a bpm:FieldType ; bpm:fieldTypeName ?field_type ;
          bpm:jsonSchemaType ?json_schema_type ; bpm:jsonSchemaItemsType ?json_schema_items_type .
    } ORDER BY ?record_name ?field_order
---
{
  "$comment": "GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
{%- for r in records %}
{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) %}
{%- set required_fields = rfields | filter(attribute="field_required", value="true") %}
    "{{ r.record_name }}": {
      "type": "object",
      "description": {{ r.record_doc | json_encode | safe }},
      "properties": {
{%- for f in rfields %}
        "{{ f.field_name }}": {
          "type": "{{ f.json_schema_type }}",
{%- if f.json_schema_items_type and f.json_schema_items_type != "" %}
          "items": { "type": "{{ f.json_schema_items_type }}" },
{%- endif %}
          "description": {{ f.field_doc | json_encode | safe }}
        }{% if not loop.last %},{% endif %}
{%- endfor %}
      }{% if required_fields | length > 0 %},
      "required": [
{%- for f in required_fields %}"{{ f.field_name }}"{% if not loop.last %}, {% endif %}{% endfor %}
      ]
{%- endif %}

    }{% if not loop.last %},{% endif %}
{%- endfor %}
  }
}
