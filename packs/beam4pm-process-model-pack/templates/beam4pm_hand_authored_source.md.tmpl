to: docs/reference/beam4pm_hand_authored_source.md
sparql:
  kinds: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?kind ?counts_as_debt ?ceiling ?doc WHERE {
      ?k a bpm:AuthorshipKind ;
         bpm:authorshipKindName ?kind ;
         bpm:countsAsDebt ?counts_as_debt ;
         bpm:debtCeiling ?ceiling ;
         bpm:authorshipKindDoc ?doc .
    } ORDER BY ?kind
  admitted: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?path ?kind ?counts_as_debt ?principal ?reason ?acceptance_command ?prerequisite ?sha256 ?admitted_at ?expires ?sunset WHERE {
      ?h a bpm:HandAuthoredSource ;
         bpm:sourcePath ?path ;
         bpm:authorshipKind ?k ;
         bpm:authorizingPrincipal ?principal ;
         bpm:admissionReason ?reason ;
         bpm:acceptanceCommand ?acceptance_command ;
         bpm:admittedAtCommit ?admitted_at .
      ?k a bpm:AuthorshipKind ;
         bpm:authorshipKindName ?kind ;
         bpm:countsAsDebt ?counts_as_debt .
      OPTIONAL { ?h bpm:contentSha256 ?sha256_opt }
      OPTIONAL { ?h bpm:admissionExpires ?expires_opt }
      OPTIONAL { ?h bpm:acceptancePrerequisite ?prerequisite_opt }
      OPTIONAL { ?h bpm:sunsetPlan ?sunset_opt }
      BIND(COALESCE(?sha256_opt, "-") AS ?sha256)
      BIND(COALESCE(?expires_opt, "-") AS ?expires)
      BIND(COALESCE(?prerequisite_opt, "-") AS ?prerequisite)
      BIND(COALESCE(?sunset_opt, "-") AS ?sunset)
    } ORDER BY ?kind ?path
  debt: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?path WHERE {
      ?h a bpm:HandAuthoredSource ;
         bpm:sourcePath ?path ;
         bpm:authorshipKind ?k .
      ?k bpm:countsAsDebt "true" .
    } ORDER BY ?path
