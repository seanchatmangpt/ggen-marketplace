%% traces_from_events(Events, CaseAttrKey) -> [LogTrace].
%%
%% The case id is read from each ocel_event's attributes map at the binary
%% key CaseAttrKey; events without that key (or with attributes undefined)
%% are skipped. Per case, events sort by event_time (lexicographic ISO8601),
%% ties broken by event_id. The result is sorted by case_id.
-spec traces_from_events([beam4pm_types:ocel_event()], binary()) ->
          [beam4pm_types:log_trace()].
traces_from_events(Events, CaseAttrKey) ->
    Keyed = lists:filtermap(
        fun(Ev) ->
            Attributes = ocel_event_attributes(Ev),
            case is_map(Attributes) andalso maps:is_key(CaseAttrKey, Attributes) of
                true ->
                    {true, {maps:get(CaseAttrKey, Attributes),
                            ocel_event_event_time(Ev),
                            ocel_event_event_id(Ev),
                            ocel_event_event_type(Ev)}};
                false ->
                    false
            end
        end,
        Events),
    ByCase = lists:foldl(
        fun({CaseId, Time, Id, Type}, Acc) ->
            Entry = {Time, Id, Type},
            maps:update_with(CaseId, fun(L) -> [Entry | L] end, [Entry], Acc)
        end,
        #{},
        Keyed),
    lists:map(
        fun(CaseId) ->
            Sorted = lists:sort(maps:get(CaseId, ByCase)),
            Seq = [Type || {_Time, _Id, Type} <- Sorted],
            {ok, Trace} = beam4pm_types:new_log_trace(
                #{case_id => CaseId, activity_sequence => Seq}),
            Trace
        end,
        lists:sort(maps:keys(ByCase))).

%% dfg_from_traces(Traces) -> [DfgEdge].
%%
%% Counts adjacent (Source, Target) activity pairs across all traces'
%% activity_sequence lists; edges are sorted by source then target.
-spec dfg_from_traces([beam4pm_types:log_trace()]) -> [beam4pm_types:dfg_edge()].
dfg_from_traces(Traces) ->
    Counts = lists:foldl(
        fun(Trace, Acc) ->
            count_adjacent(log_trace_activity_sequence(Trace), Acc)
        end,
        #{},
        Traces),
    lists:map(
        fun({ {Source, Target}, Frequency }) ->
            {ok, Edge} = beam4pm_types:new_dfg_edge(
                #{source_activity => Source,
                  target_activity => Target,
                  frequency => Frequency}),
            Edge
        end,
        lists:sort(maps:to_list(Counts))).

%% variants_from_traces(Traces) -> [ProcessVariant].
%%
%% Groups Traces by identical activity_sequence, emitting one process_variant
%% per distinct sequence with frequency = the count of traces observed with
%% exactly that sequence. Variants are sorted by activity_sequence, and
%% variant_id is the 1-based rank in that sorted order, stringified.
-spec variants_from_traces([beam4pm_types:log_trace()]) -> [beam4pm_types:process_variant()].
variants_from_traces(Traces) ->
    Counts = lists:foldl(
        fun(Trace, Acc) ->
            Seq = log_trace_activity_sequence(Trace),
            maps:update_with(Seq, fun(N) -> N + 1 end, 1, Acc)
        end,
        #{},
        Traces),
    Sorted = lists:sort(maps:to_list(Counts)),
    {Variants, _} = lists:foldl(
        fun({Seq, Frequency}, {Acc, Rank}) ->
            {ok, Variant} = beam4pm_types:new_process_variant(
                #{variant_id => integer_to_binary(Rank),
                  activity_sequence => Seq,
                  frequency => Frequency}),
            {[Variant | Acc], Rank + 1}
        end,
        {[], 1},
        Sorted),
    lists:reverse(Variants).

%% conformance(Edges, Trace) -> ConformanceResult.
%%
%% fitness is the fraction (always a float) of the trace's adjacent activity
%% pairs present in the edge set, and 1.0 for traces with fewer than two
%% activities. precision is beam4pm_precision's ETC (escaping-edge) score for
%% the same trace against the same edge set (see that module for the exact
%% formula and its provenance) -- it used to be left undefined; it is now
%% always a computed float.
-spec conformance([beam4pm_types:dfg_edge()], beam4pm_types:log_trace()) ->
          beam4pm_types:conformance_result().
conformance(Edges, Trace) ->
    Pairs = adjacent_pairs(log_trace_activity_sequence(Trace)),
    Fitness =
        case Pairs of
            [] ->
                1.0;
            _ ->
                EdgeSet = maps:from_list(
                    [ { {dfg_edge_source_activity(E), dfg_edge_target_activity(E)}, true }
                      || E <- Edges ]),
                Present = length([P || P <- Pairs, maps:is_key(P, EdgeSet)]),
                Present / length(Pairs)
        end,
    Precision = beam4pm_precision:etc_precision(Edges, Trace),
    {ok, Result} = beam4pm_types:new_conformance_result(
        #{trace_id => log_trace_case_id(Trace), fitness => Fitness, precision => Precision}),
    Result.
{% raw %}
%% traces_from_spans(Spans) -> [LogTrace].
%%
%% The temporal-adjacency arm's input, and deliberately nothing more than
%% today's discovery applied to spans: one log_trace per trace_id (case_id =
%% trace_id), activity_sequence = the spans' service_name values sorted by
%% {start_time, span_id} (lexicographic ISO8601, ties broken by span_id).
%% parent_span_id is NEVER read here -- this arm is what a miner that only
%% sees timestamps and a correlation id would conclude. Result sorted by
%% trace_id.
-spec traces_from_spans([beam4pm_types:service_span()]) -> [beam4pm_types:log_trace()].
traces_from_spans(Spans) ->
    ByTrace = lists:foldl(
        fun(Span, Acc) ->
            Entry = {service_span_start_time(Span),
                     service_span_span_id(Span),
                     service_span_service_name(Span)},
            maps:update_with(service_span_trace_id(Span),
                             fun(L) -> [Entry | L] end, [Entry], Acc)
        end,
        #{},
        Spans),
    lists:map(
        fun(TraceId) ->
            Sorted = lists:sort(maps:get(TraceId, ByTrace)),
            Seq = [Service || {_Start, _Id, Service} <- Sorted],
            {ok, Trace} = beam4pm_types:new_log_trace(
                #{case_id => TraceId, activity_sequence => Seq}),
            Trace
        end,
        lists:sort(maps:keys(ByTrace))).

%% causal_dfg_from_spans(Spans) ->
%%     {ok, #{observed             := [SpanEdge],   %% evidence = parent_child_link
%%            adjacent             := [SpanEdge],   %% evidence = temporal_adjacency
%%            inferred_only        := [SpanEdge],   %% adjacent pairs no link supports
%%            observed_not_adjacent := [SpanEdge],  %% linked pairs adjacency cannot see
%%            orphans              := [{SpanId, MissingParentId}]}}
%%   | {error, {duplicate_span_id, SpanId}}
%%   | {error, {parent_in_other_trace, SpanId}}.
%%
%% Observed arm: for every span whose parent_span_id names a span in the
%% input, one parent/child link parent.service_name -> span.service_name;
%% frequency = the number of such links with that (source, target). This is
%% OpenTelemetry parent/child (invocation) causality keyed by service_name --
%% NOT directly-follows, and NOT the OpenTelemetry `links` field. Root spans
%% (parent_span_id undefined) contribute no incoming edge. A span whose parent
%% is absent from the input (sampled out, uninstrumented) is an ORPHAN:
%% reported as {span_id, parent_span_id}, never turned into an edge and never
%% silently dropped -- it stays in the adjacency arm, so the caller can see
%% exactly which inferred_only edges lack causal evidence because evidence is
%% missing rather than because adjacency invented them.
%%
%% Adjacent arm: traces_from_spans/1 -> dfg_from_traces/1, re-tagged
%% temporal_adjacency. Same span set, so the two frequency scales are
%% comparable per (source, target).
%%
%% The two sets are NOT nested. For a root p with concurrent children s1, s2
%% (s1 starting first): adjacency yields p->s1, s1->s2; links yield p->s1,
%% p->s2. s1->s2 is inferred_only (adjacency invented it) and p->s2 is
%% observed_not_adjacent (adjacency cannot see it). Both differences are
%% returned; the caller must not compute only one.
%%
%% Typed refusals, never silent: a duplicate span_id (the index would
%% otherwise last-write-win) and a parent found in a DIFFERENT trace_id (a
%% malformed trace -- links never cross traces) each abort the whole call.
%% Every list is sorted by {source_service, target_service}; orphans by
%% {span_id, parent_span_id}.
-spec causal_dfg_from_spans([beam4pm_types:service_span()]) ->
          {ok, #{observed := [beam4pm_types:span_edge()],
                 adjacent := [beam4pm_types:span_edge()],
                 inferred_only := [beam4pm_types:span_edge()],
                 observed_not_adjacent := [beam4pm_types:span_edge()],
                 orphans := [{binary(), binary()}]}}
        | {error, {duplicate_span_id, binary()}}
        | {error, {parent_in_other_trace, binary()}}.
causal_dfg_from_spans(Spans) ->
    case index_spans(Spans, #{}) of
        {error, _} = IndexError ->
            IndexError;
        {ok, Index} ->
            case link_spans(Spans, Index, #{}, []) of
                {error, _} = LinkError ->
                    LinkError;
                {ok, LinkCounts, Orphans} ->
                    Observed = span_edges(LinkCounts, parent_child_link),
                    Adjacent = [adjacency_edge(E)
                                || E <- dfg_from_traces(traces_from_spans(Spans))],
                    ObservedPairs = pair_set(Observed),
                    AdjacentPairs = pair_set(Adjacent),
                    {ok, #{observed => Observed,
                           adjacent => Adjacent,
                           inferred_only =>
                               [E || E <- Adjacent,
                                     not maps:is_key(edge_pair(E), ObservedPairs)],
                           observed_not_adjacent =>
                               [E || E <- Observed,
                                     not maps:is_key(edge_pair(E), AdjacentPairs)],
                           orphans => lists:sort(Orphans)}}
            end
    end.

%% Internal: span_id -> span, refusing a duplicate id instead of overwriting.
index_spans([], Index) ->
    {ok, Index};
index_spans([Span | Rest], Index) ->
    Id = service_span_span_id(Span),
    case maps:is_key(Id, Index) of
        true -> {error, {duplicate_span_id, Id}};
        false -> index_spans(Rest, Index#{Id => Span})
    end.

%% Internal: fold parent/child links into a (source, target) -> count map,
%% collecting orphans and refusing a cross-trace parent.
link_spans([], _Index, Counts, Orphans) ->
    {ok, Counts, Orphans};
link_spans([Span | Rest], Index, Counts, Orphans) ->
    case service_span_parent_span_id(Span) of
        undefined ->
            link_spans(Rest, Index, Counts, Orphans);
        ParentId ->
            case maps:find(ParentId, Index) of
                error ->
                    link_spans(Rest, Index, Counts,
                               [{service_span_span_id(Span), ParentId} | Orphans]);
                {ok, Parent} ->
                    case service_span_trace_id(Parent) =:= service_span_trace_id(Span) of
                        false ->
                            {error, {parent_in_other_trace, service_span_span_id(Span)}};
                        true ->
                            Pair = {service_span_service_name(Parent),
                                    service_span_service_name(Span)},
                            link_spans(Rest, Index,
                                       maps:update_with(Pair, fun(N) -> N + 1 end, 1, Counts),
                                       Orphans)
                    end
            end
    end.

%% Internal: counting map -> sorted span_edge list carrying Evidence.
span_edges(Counts, Evidence) ->
    lists:map(
        fun({ {Source, Target}, Frequency }) ->
            {ok, Edge} = beam4pm_types:new_span_edge(
                #{source_service => Source,
                  target_service => Target,
                  frequency => Frequency,
                  evidence => Evidence}),
            Edge
        end,
        lists:sort(maps:to_list(Counts))).

%% Internal: a dfg_edge from the adjacency arm, re-tagged as what it is.
adjacency_edge(DfgEdge) ->
    {ok, Edge} = beam4pm_types:new_span_edge(
        #{source_service => dfg_edge_source_activity(DfgEdge),
          target_service => dfg_edge_target_activity(DfgEdge),
          frequency => dfg_edge_frequency(DfgEdge),
          evidence => temporal_adjacency}),
    Edge.

edge_pair(Edge) ->
    {span_edge_source_service(Edge), span_edge_target_service(Edge)}.

pair_set(Edges) ->
    maps:from_list([{edge_pair(E), true} || E <- Edges]).
{% endraw %}
%% Internal: multiset of adjacent pairs folded into a counting map.
count_adjacent([A, B | Rest], Acc) ->
    count_adjacent([B | Rest], maps:update_with({A, B}, fun(N) -> N + 1 end, 1, Acc));
count_adjacent(_, Acc) ->
    Acc.

%% Internal: ordered list of adjacent pairs (with multiplicity).
adjacent_pairs([A, B | Rest]) -> [{A, B} | adjacent_pairs([B | Rest])];
adjacent_pairs(_) -> [].
