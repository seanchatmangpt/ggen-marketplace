%% GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
%%
%% Process discovery and conformance checking over the generated beam4pm types.
%% Admitted bpm:RecordType graph size: {{ records | length }} record types.
%%
%% This module targets four of those admitted records — ocel_event, log_trace,
%% dfg_edge, conformance_result — and derives every positional tuple access
%% below from the same ORDER BY field_order rows that shaped beam4pm_types,
%% so the access stays schema-driven rather than hard-coded.
%%
