%% GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
%%
%% Process discovery and conformance checking over the generated beam4pm types.
%% Admitted bpm:RecordType graph size: {{ records | length }} record types.
%%
%% This module targets seven of those admitted records — ocel_event, log_trace,
%% dfg_edge, conformance_result, process_variant, service_span, span_edge — and
%% derives every positional tuple access below from the same ORDER BY
%% field_order rows that shaped beam4pm_types, so the access stays
%% schema-driven rather than hard-coded.
%%
%% Two evidence classes, kept apart on purpose (VISION-2030 section 7:
%% "observed" and "inferred" are distinct views of the twin):
%%   * traces_from_events/2 + dfg_from_traces/1 derive directly-follows edges
%%     from TEMPORAL ADJACENCY inside a case -- every consecutive pair is
%%     promoted to an edge. That is inference, and it is all today's event-log
%%     discovery can do.
%%   * causal_dfg_from_spans/1 derives service-to-service edges from the
%%     OpenTelemetry PARENT/CHILD LINK on service_span records (observed
%%     invocation causality -- the child ran inside the parent's interval) and
%%     returns them side by side with the temporal-adjacency edges the same
%%     spans would yield, so a caller can see exactly which adjacency edges no
%%     link supports and which causal edges adjacency cannot see. The edges are
%%     span_edge records, tagged with their evidence class, never dfg_edge --
%%     parent/child is not directly-follows.
%%
%% All outputs are constructed through the validating beam4pm_types:new_*/1
%% constructors, never as raw tuples.

-module(beam4pm_discovery).

-export([traces_from_events/2, dfg_from_traces/1, conformance/2, variants_from_traces/1,
         traces_from_spans/1, causal_dfg_from_spans/1]).

