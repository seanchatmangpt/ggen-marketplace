---
to: schema/beam4pm_hand_authored_source.tsv
sparql:
  admitted: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?path ?kind ?counts_as_debt ?sha256 ?expires ?acceptance_command ?prerequisite WHERE {
      ?h a bpm:HandAuthoredSource ;
         bpm:sourcePath ?path ;
         bpm:authorshipKind ?k ;
         bpm:acceptanceCommand ?acceptance_command .
      ?k a bpm:AuthorshipKind ;
         bpm:authorshipKindName ?kind ;
         bpm:countsAsDebt ?counts_as_debt .
      OPTIONAL { ?h bpm:contentSha256 ?sha256_opt }
      OPTIONAL { ?h bpm:admissionExpires ?expires_opt }
      OPTIONAL { ?h bpm:acceptancePrerequisite ?prerequisite_opt }
      BIND(COALESCE(?sha256_opt, "-") AS ?sha256)
      BIND(COALESCE(?expires_opt, "-") AS ?expires)
      BIND(COALESCE(?prerequisite_opt, "-") AS ?prerequisite)
    } ORDER BY ?path
---
# GENERATED by ggen from the admitted bpm:HandAuthoredSource graph. Do not edit.
# Machine-readable admission manifest consumed by scripts/gate_authorship_check.sh.
# Columns (tab-separated): path kind counts_as_debt sha256 expires acceptance_command prerequisite
# A "-" means the optional column is unbound for that row (non-debt kinds carry no sha256/expiry).
{% for h in admitted -%}
{{ h.path }}	{{ h.kind }}	{{ h.counts_as_debt }}	{{ h.sha256 }}	{{ h.expires }}	{{ h.acceptance_command }}	{{ h.prerequisite }}
{% endfor -%}
