---
to: schema/beam4pm_engine_ops.tsv
sparql:
  rows: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?op_name ?wire_name ?op_kind ?dispatch_source ?wasm_artifact WHERE {
      ?op a bpm:EngineOp ;
          bpm:opEngine ?e ;
          bpm:opName ?op_name ;
          bpm:opOrder ?op_order ;
          bpm:opKind ?k .
      ?e a bpm:Engine ;
         bpm:engineName ?engine_name ;
         bpm:engineOrdinal ?ordinal ;
         bpm:dispatchSource ?dispatch_source ;
         bpm:wasmArtifactPath ?wasm_artifact .
      ?k a bpm:EngineOpKind ; bpm:engineOpKindName ?op_kind .
      OPTIONAL { ?op bpm:opWireName ?wire_opt }
      BIND(COALESCE(?wire_opt, ?op_name) AS ?wire_name)
    } ORDER BY ?ordinal ?op_order
---
# GENERATED by ggen from the admitted bpm:Engine graph. Do not edit.
# Machine-readable engine-op manifest consumed by scripts/gate_engine_dispatch_check.sh:
# every row of kind `wire` must name a string-literal "<wire_name>" => match arm in its
# engine's dispatch_source, or the tree is refused (REFUSED_OP_NOT_DISPATCHED).
# Columns (tab-separated): engine op wire_name kind dispatch_source wasm_artifact
{% for r in rows -%}
{{ r.engine_name }}	{{ r.op_name }}	{{ r.wire_name }}	{{ r.op_kind }}	{{ r.dispatch_source }}	{{ r.wasm_artifact }}
{% endfor -%}
