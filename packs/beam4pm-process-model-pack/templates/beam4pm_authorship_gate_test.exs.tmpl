---
to: test/beam4pm_authorship_gate_test.exs
sparql:
  admitted: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?path ?kind ?counts_as_debt WHERE {
      ?h a bpm:HandAuthoredSource ;
         bpm:sourcePath ?path ;
         bpm:authorshipKind ?k .
      ?k a bpm:AuthorshipKind ;
         bpm:authorshipKindName ?kind ;
         bpm:countsAsDebt ?counts_as_debt .
    } ORDER BY ?path
  debt: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?path WHERE {
      ?h a bpm:HandAuthoredSource ;
         bpm:sourcePath ?path ;
         bpm:authorshipKind ?k .
      ?k bpm:countsAsDebt "true" .
    } ORDER BY ?path
---
# GENERATED by ggen from the admitted bpm:HandAuthoredSource graph. Do not edit.
defmodule BeamPM.AuthorshipGateTest do
  @moduledoc """
  Chicago-style qualification of GATE AUTHORSHIP
  (`scripts/gate_authorship_check.sh`): the mechanical form of VISION-2030
  section 24's falsifier "ggen-only manufacture requires routine privileged
  handwritten source commits" and section 2's "the exception is visible,
  bounded, and counted as manufacturing debt".

  Every test here runs the REAL gate script as a real subprocess
  (`System.cmd("bash", ...)`), never a re-implementation of its logic:

    * against the real repository tree -- must PASS with exactly the
      admitted count this file was rendered with ({{ admitted | length }}
      admitted, {{ debt | length }} counted as debt), and every admitted
      path must really exist and really lack the GENERATED marker;
    * against planted `git init` fixtures in a temp dir that MUST be
      refused, each naming the offending file and a typed REFUSED_* code:
      an unmarked, unadmitted file; a stale admission; an admitted file
      that now carries the marker; a sha256 drift; an expired admission;
      an admission outside the manufactured roots; a debt row with no
      sha/expiry; a hand-written (unmanufactured) manifest;
    * against fixtures that must NOT be refused, proving the file universe
      is `git ls-files --exclude-standard` and not a raw `find`: a
      gitignored unmarked file, and a tracked path deleted from disk.

  This file is itself manufactured (see the marker above): its admitted
  path list and counts are rendered from the same `bpm:HandAuthoredSource`
  graph the manifest is rendered from, so the two cannot drift apart
  without gate_m2_check.sh noticing.
  """

  use ExUnit.Case, async: false

  @gate Path.expand("scripts/gate_authorship_check.sh")
  @manifest Path.expand("schema/beam4pm_hand_authored_source.tsv")
  @marker "GENERATED by ggen"
  @admitted_count {{ admitted | length }}
  @debt_count {{ debt | length }}
  @admitted_paths [{% for h in admitted %}
    "{{ h.path }}"{% if not loop.last %},{% endif %}{% endfor %}
  ]
  @debt_paths [{% for h in debt %}
    "{{ h.path }}"{% if not loop.last %},{% endif %}{% endfor %}
  ]

  @manifest_header """
  # GENERATED by ggen from the admitted bpm:HandAuthoredSource graph. Do not edit.
  # fixture manifest written by BeamPM.AuthorshipGateTest
  # path kind counts_as_debt sha256 expires acceptance_command prerequisite
  """

  defp run_gate(args, cd) do
    System.cmd("bash", [@gate | args], cd: cd, stderr_to_stdout: true)
  end

  defp sha256(path) do
    path |> File.read!() |> then(&:crypto.hash(:sha256, &1)) |> Base.encode16(case: :lower)
  end

  defp marked?(path) do
    path
    |> File.read!()
    |> String.split("\n")
    |> Enum.take(3)
    |> Enum.any?(&String.contains?(String.downcase(&1), String.downcase(@marker)))
  end

  defp fixture!(ctx_name) do
    dir =
      Path.join(
        System.tmp_dir!(),
        "beam4pm_authorship_gate_#{ctx_name}_#{System.unique_integer([:positive])}"
      )

    File.rm_rf!(dir)
    File.mkdir_p!(dir)
    {_, 0} = System.cmd("git", ["init", "-q"], cd: dir, stderr_to_stdout: true)
    dir
  end

  defp write_manifest!(dir, rows) do
    body =
      Enum.map_join(rows, "", fn row -> Enum.join(row, "\t") <> "\n" end)

    path = Path.join(dir, "fixture_manifest.tsv")
    File.write!(path, @manifest_header <> body)
    path
  end

  defp plant!(dir, rel, content) do
    abs = Path.join(dir, rel)
    File.mkdir_p!(Path.dirname(abs))
    File.write!(abs, content)
    abs
  end

  @unmarked_erl "%% hand-authored fixture, deliberately without any provenance header\n-module(planted).\n"
  @marked_erl "%% GENERATED by ggen from a fixture graph. Do not edit.\n-module(planted).\n"

  describe "real repository tree" do
    test "the real gate PASSes with exactly the admitted count rendered from the ontology" do
      {out, status} = run_gate([], File.cwd!())
      assert status == 0, out
      assert out =~ "GATE AUTHORSHIP: PASS"

      assert out =~
               "#{@admitted_count} admitted (#{@debt_count} counted as manufacturing debt)"

      assert out =~ "#{@admitted_count} unmarked files under roots, 0 findings"
    end

    test "the manufactured manifest carries the marker and lists exactly the admitted paths" do
      assert File.exists?(@manifest)
      assert marked?(@manifest)

      rows =
        @manifest
        |> File.read!()
        |> String.split("\n", trim: true)
        |> Enum.reject(&String.starts_with?(&1, "#"))
        |> Enum.map(&String.split(&1, "\t"))

      assert Enum.all?(rows, &(length(&1) == 7))
      assert Enum.map(rows, &hd/1) |> Enum.sort() == Enum.sort(@admitted_paths)

      debt_rows = Enum.filter(rows, fn [_p, _k, debt | _] -> debt == "true" end)
      assert length(debt_rows) == @debt_count
      assert Enum.map(debt_rows, &hd/1) |> Enum.sort() == Enum.sort(@debt_paths)

      # Every debt row is bounded: a real sha256 and a real expiry, never "-".
      for [path, _kind, "true", sha, expires | _] <- rows do
        assert sha =~ ~r/^[0-9a-f]{64}$/, "#{path}: debt row without sha256"
        assert expires =~ ~r/^\d{4}-\d{2}-\d{2}$/, "#{path}: debt row without expiry"
        assert sha == sha256(path), "#{path}: admitted sha256 does not match disk"
      end
    end

    test "every admitted path exists, is unmarked, and is tracked or untracked-but-not-ignored" do
      for path <- @admitted_paths do
        assert File.regular?(path), "#{path}: admitted but not on disk"
        refute marked?(path), "#{path}: admitted as hand-authored but carries the marker"

        {_out, status} =
          System.cmd("git", ["check-ignore", "-q", path], stderr_to_stdout: true)

        assert status == 1, "#{path}: admitted path is gitignored"
      end
    end
  end

  describe "planted fixtures that must be refused" do
    test "an unmarked, unadmitted file under a manufactured root is refused by name" do
      dir = fixture!("unadmitted")
      plant!(dir, "src/planted.erl", @unmarked_erl)
      manifest = write_manifest!(dir, [])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_UNADMITTED: src/planted.erl"
      assert out =~ "GATE AUTHORSHIP: FAIL -- 1 finding(s)"

      # Same file, now carrying the marker: it is manufactured output, not debt.
      File.write!(Path.join(dir, "src/planted.erl"), @marked_erl)
      {out2, status2} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status2 == 0, out2
      assert out2 =~ "GATE AUTHORSHIP: PASS -- 0 admitted (0 counted as manufacturing debt), 0 unmarked files"
    end

    test "an admission whose path is gone is refused as stale" do
      dir = fixture!("stale")

      manifest =
        write_manifest!(dir, [
          ["src/gone.erl", "native_engine_facade", "true", String.duplicate("a", 64), "2999-12-31", "true", "-"]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_STALE_ADMISSION: src/gone.erl"
    end

    test "an admitted path that now carries the marker is refused as a contradiction" do
      dir = fixture!("contradiction")
      abs = plant!(dir, "lib/planted.ex", @marked_erl)

      manifest =
        write_manifest!(dir, [
          ["lib/planted.ex", "native_engine_facade", "true", sha256(abs), "2999-12-31", "true", "-"]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_CONTRADICTION: lib/planted.ex"
    end

    test "an edited debt file is refused as sha drift until re-admitted" do
      dir = fixture!("sha_drift")
      abs = plant!(dir, "test/planted_test.exs", @unmarked_erl)
      good = sha256(abs)

      manifest =
        write_manifest!(dir, [
          ["test/planted_test.exs", "hand_authored_qualification", "true", good, "2999-12-31", "true", "-"]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 0, out
      assert out =~ "GATE AUTHORSHIP: PASS -- 1 admitted (1 counted as manufacturing debt), 1 unmarked files"

      File.write!(abs, @unmarked_erl <> "%% one more hand-written line\n")
      {out2, status2} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status2 == 1, out2
      assert out2 =~ "REFUSED_SHA_DRIFT: test/planted_test.exs"
      assert out2 =~ good
      assert out2 =~ sha256(abs)
    end

    test "an expired admission is refused" do
      dir = fixture!("expired")
      abs = plant!(dir, "gleam/src/beam4pm/planted.gleam", @unmarked_erl)

      manifest =
        write_manifest!(dir, [
          ["gleam/src/beam4pm/planted.gleam", "native_engine_facade", "true", sha256(abs), "2000-01-01", "true", "-"]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_EXPIRED: gleam/src/beam4pm/planted.gleam"
      assert out =~ "expired 2000-01-01"
    end

    test "an admission outside every manufactured root is refused as misscoped" do
      dir = fixture!("misscoped")
      abs = plant!(dir, "README.md", "# fixture\n")

      manifest =
        write_manifest!(dir, [
          ["README.md", "reference_evidence", "false", "-", "-", "true", "-"]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_MISSCOPED: README.md"
      assert File.exists?(abs)
    end

    test "a debt row without sha256 or expiry is refused as an unbound standing grant" do
      dir = fixture!("unbound")
      plant!(dir, "src/planted.erl", @unmarked_erl)

      manifest =
        write_manifest!(dir, [
          ["src/planted.erl", "native_engine_facade", "true", "-", "-", "true", "-"]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_UNBOUND_DEBT: src/planted.erl"
    end

    test "a hand-written manifest (no GENERATED marker) is refused before anything is admitted" do
      dir = fixture!("hand_manifest")
      plant!(dir, "src/planted.erl", @unmarked_erl)
      manifest = Path.join(dir, "hand.tsv")
      File.write!(manifest, "src/planted.erl\tnative_engine_facade\ttrue\t-\t-\ttrue\t-\n")

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_MANIFEST_UNMANUFACTURED"
      refute out =~ "GATE AUTHORSHIP: PASS"
    end

    test "a missing manifest is refused" do
      dir = fixture!("no_manifest")
      {out, status} = run_gate(["--root", dir], dir)
      assert status == 1, out
      assert out =~ "REFUSED_MANIFEST_MISSING"
    end
  end

  describe "--exercise: acceptance commands are run, never just named" do
    # The fixture acceptance commands print a real ExUnit-shaped summary line
    # so the gate's parser is exercised on the exact text `mix test` emits.
    test "an all-skipped acceptance with no declared prerequisite is refused as vacuous" do
      dir = fixture!("vacuous")
      abs = plant!(dir, "src/planted.erl", @unmarked_erl)

      manifest =
        write_manifest!(dir, [
          ["src/planted.erl", "native_engine_facade", "true", sha256(abs), "2999-12-31",
           "echo '3 tests, 0 failures, 3 skipped'", "-"]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest, "--exercise"], dir)
      assert status == 1, out
      assert out =~ "REFUSED_VACUOUS_ACCEPTANCE: echo '3 tests, 0 failures, 3 skipped'"
    end

    test "the same all-skipped acceptance with an absent declared prerequisite is BLOCKED, not refused" do
      dir = fixture!("blocked")
      abs = plant!(dir, "src/planted.erl", @unmarked_erl)

      manifest =
        write_manifest!(dir, [
          ["src/planted.erl", "native_engine_facade", "true", sha256(abs), "2999-12-31",
           "echo '3 tests, 0 failures, 3 skipped'", "native/never-built/engine.wasm"]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest, "--exercise"], dir)
      assert status == 0, out
      assert out =~ "ACCEPTANCE_BLOCKED_PREREQUISITE: echo '3 tests, 0 failures, 3 skipped'"
      assert out =~ "prerequisite absent: native/never-built/engine.wasm"
      assert out =~ "acceptance: 0 alive, 1 blocked on absent prerequisites"

      # A cmd: prerequisite that really exits nonzero is "absent" the same way.
      manifest2 =
        write_manifest!(dir, [
          ["src/planted.erl", "native_engine_facade", "true", sha256(abs), "2999-12-31",
           "echo '3 tests, 0 failures, 3 skipped'", "cmd:exit 7"]
        ])

      {out2, status2} = run_gate(["--root", dir, "--manifest", manifest2, "--exercise"], dir)
      assert status2 == 0, out2
      assert out2 =~ "ACCEPTANCE_BLOCKED_PREREQUISITE"
    end

    test "a failing acceptance command is refused; a real passing one is ALIVE" do
      dir = fixture!("acceptance_failed")
      abs = plant!(dir, "src/planted.erl", @unmarked_erl)

      manifest =
        write_manifest!(dir, [
          ["src/planted.erl", "native_engine_facade", "true", sha256(abs), "2999-12-31",
           "echo '2 tests, 1 failure'; exit 2", "-"]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest, "--exercise"], dir)
      assert status == 1, out
      assert out =~ "REFUSED_ACCEPTANCE_FAILED: echo '2 tests, 1 failure'; exit 2 (exit 2; 2 tests, 1 failure)"

      manifest2 =
        write_manifest!(dir, [
          ["src/planted.erl", "native_engine_facade", "true", sha256(abs), "2999-12-31",
           "echo '2 tests, 0 failures'", "-"]
        ])

      {out2, status2} = run_gate(["--root", dir, "--manifest", manifest2, "--exercise"], dir)
      assert status2 == 0, out2
      assert out2 =~ "ACCEPTANCE_ALIVE: echo '2 tests, 0 failures' (2 tests, 0 failures)"
      assert out2 =~ "acceptance: 1 alive, 0 blocked on absent prerequisites"
    end
  end

  describe "file universe is git ls-files, not a raw find" do
    test "a gitignored unmarked file under a root is out of scope" do
      dir = fixture!("gitignored")
      File.write!(Path.join(dir, ".gitignore"), "src/.cache/\n")
      plant!(dir, "src/.cache/provider.erl", @unmarked_erl)
      manifest = write_manifest!(dir, [])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 0, out
      assert out =~ "0 unmarked files under roots, 0 findings"
    end

    test "a tracked path deleted from disk (regeneration window) is not a finding" do
      dir = fixture!("deleted_tracked")
      abs = plant!(dir, "lib/generated.ex", @marked_erl)
      {_, 0} = System.cmd("git", ["add", "lib/generated.ex"], cd: dir, stderr_to_stdout: true)
      File.rm!(abs)
      manifest = write_manifest!(dir, [])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 0, out
      assert out =~ "GATE AUTHORSHIP: PASS"
    end

    test "an ADMITTED path that is tracked but transiently absent is TRANSIENT_ABSENT, not stale" do
      # gate_m2_check.sh stashes its hand-authored dependent tests out of
      # test/ while the igniter leg runs `mix test` (and so this gate). Tracked
      # in the index + missing on disk is that window; never in the index is a
      # real stale admission (the "stale" test above).
      dir = fixture!("transient_absent")
      abs = plant!(dir, "test/stashed_test.exs", @unmarked_erl)
      {_, 0} = System.cmd("git", ["add", "test/stashed_test.exs"], cd: dir, stderr_to_stdout: true)

      manifest =
        write_manifest!(dir, [
          ["test/stashed_test.exs", "hand_authored_qualification", "true", sha256(abs), "2999-12-31", "true", "-"]
        ])

      File.rm!(abs)
      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 0, out
      assert out =~ "TRANSIENT_ABSENT: test/stashed_test.exs"
      refute out =~ "REFUSED_STALE_ADMISSION"

      # Once the deletion is staged (index == disk, as in any clean CI
      # checkout), the same admission IS stale.
      {_, 0} = System.cmd("git", ["rm", "-q", "--cached", "test/stashed_test.exs"], cd: dir, stderr_to_stdout: true)
      {out2, status2} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status2 == 1, out2
      assert out2 =~ "REFUSED_STALE_ADMISSION: test/stashed_test.exs"
    end

    test "a brand-new untracked unmarked file IS in scope" do
      dir = fixture!("untracked")
      plant!(dir, "docs/reference/new-notes.md", "# notes typed by hand\n")
      manifest = write_manifest!(dir, [])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_UNADMITTED: docs/reference/new-notes.md"
    end
  end
end
