---
to: "{{ test_path }}"
force: true
sparql:
  parity_checks: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?check_name ?check_doc ?check_ordinal ?test_path ?test_module
           ?left_command ?right_command ?left_command_kind ?right_command_kind
           ?left_domain ?left_solver ?consent_law
           ?tamper_falsifier ?tamper_find ?tamper_replace ?tamper_corpus_order WHERE {
      ?c a bpm:ParityCheck ;
         bpm:checkName ?check_name ;
         bpm:checkDoc ?check_doc ;
         bpm:checkOrdinal ?check_ordinal ;
         bpm:testPath ?test_path ;
         bpm:testModule ?test_module ;
         bpm:leftCommand ?left_command ;
         bpm:rightCommand ?right_command ;
         bpm:leftCommandKind ?lk ;
         bpm:rightCommandKind ?rk ;
         bpm:consentLaw ?consent_law ;
         bpm:tamperFalsifier ?tamper_falsifier ;
         bpm:tamperFind ?tamper_find ;
         bpm:tamperReplace ?tamper_replace ;
         bpm:tamperCorpusOrder ?tamper_corpus_order .
      ?lk bpm:commandKindName ?left_command_kind .
      ?rk bpm:commandKindName ?right_command_kind .
      OPTIONAL { ?c bpm:leftDomain ?left_domain }
      OPTIONAL { ?c bpm:leftSolver ?left_solver }
    } ORDER BY ?check_ordinal
  parity_corpus: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?check_name ?corpus_order ?corpus_path ?corpus_sha256 WHERE {
      ?c a bpm:ParityCheck ;
         bpm:checkName ?check_name ;
         bpm:hasCorpus ?e .
      ?e bpm:corpusPath ?corpus_path ;
         bpm:corpusSha256 ?corpus_sha256 ;
         bpm:corpusOrder ?corpus_order .
    } ORDER BY ?check_name ?corpus_order
  parity_pins: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?check_name ?pin_key ?pin_value WHERE {
      ?c a bpm:ParityCheck ;
         bpm:checkName ?check_name ;
         bpm:hasDigestPin ?p .
      ?p bpm:pinKey ?pin_key ; bpm:pinValue ?pin_value .
    } ORDER BY ?check_name ?pin_key
  parity_steps: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?check_name ?step_order ?step_action WHERE {
      ?c a bpm:ParityCheck ;
         bpm:checkName ?check_name ;
         bpm:hasExpectedStep ?s .
      ?s bpm:stepOrder ?step_order ; bpm:stepAction ?step_action .
    } ORDER BY ?check_name ?step_order
for_each: parity_checks
---
# GENERATED by ggen from the admitted bpm:ParityCheck "{{ check_name }}". Do not edit.
defmodule {{ test_module }} do
  @moduledoc """
  Cross-engine parity qualification `{{ check_name }}` -- rendered by ggen
  (beam4pm-process-model-pack templates/beam4pm_parity_check_test.exs.tmpl)
  from the admitted bpm:ParityCheck facts. Every corpus file, digest pin and
  expected verdict step below is an ontology fact, not a test-local constant.

  {{ check_doc }}

  Left leg (witnessed command):
    {{ left_command }}

  Right leg (witnessed call):
    {{ right_command }}

  Consent law: {{ consent_law }}

  A missing collaborator (autofde-lab venv, ferroplan wasm) is a named SKIP,
  never a silent pass and never a fake. Pins are the flip ledger: an engine or
  seam bump trips them and this file names the flip; re-derive or escalate.
  """

  use ExUnit.Case, async: false
{% set corpus_rows = parity_corpus | filter(attribute="check_name", value=check_name) %}
{% set pin_rows = parity_pins | filter(attribute="check_name", value=check_name) %}
{% set step_rows = parity_steps | filter(attribute="check_name", value=check_name) %}
{% if right_command_kind == "beam_hddl_solve" %}
  alias BeamPM.Ferroplan
{% endif %}

  @repo_root Path.expand("..", __DIR__)
  @lab_root Path.expand(System.get_env("AUTOFDE_LAB_ROOT") || "~/autofde-lab")
  @lab_python Path.join(@lab_root, ".venv/bin/python3")

  @lab_available File.regular?(@lab_python)
{% if right_command_kind == "beam_hddl_solve" %}
  @wasm_built Ferroplan.wasm_built?()
{% endif %}

  if not @lab_available do
    @moduletag skip: "autofde-lab venv python not found at #{@lab_python} -- set AUTOFDE_LAB_ROOT to a built checkout"
  end

{% if right_command_kind == "beam_hddl_solve" %}
  if not @wasm_built do
    @moduletag skip: Ferroplan.wasm_missing_reason()
  end
{% endif %}

  # --- corpus facts (bpm:hasCorpus, sha256-pinned, graph-admitted) ----------

  @corpus [
{% for e in corpus_rows %}
    {"{{ e.corpus_path }}", "{{ e.corpus_sha256 }}"}{% if not loop.last %},{% endif %}
{% endfor %}
  ]

  # The two legs share byte-identical inputs: order 1 is the domain document,
  # order 2 the problem document (lab_fabric_solve and beam_hddl_solve arms).
{% set domain_entry = corpus_rows | first %}
{% set problem_entry = corpus_rows | last %}
  @domain_rel_path "{{ domain_entry.corpus_path }}"
  @problem_rel_path "{{ problem_entry.corpus_path }}"

  # --- verdict pins (bpm:hasDigestPin -- the flip ledger) -------------------

  @pins %{
{% for p in pin_rows %}
    "{{ p.pin_key }}" => "{{ p.pin_value }}"{% if not loop.last %},{% endif %}
{% endfor %}
  }

  # --- the shared verdict ladder (bpm:hasExpectedStep) ----------------------
  # Parity contract: the LEFT leg executes these as exact step action names in
  # order; the RIGHT leg's own plan vocabulary must carry every one of them.

  @expected_steps [
{% for s in step_rows %}
    "{{ s.step_action }}"{% if not loop.last %},{% endif %}
{% endfor %}
  ]

{% if left_command_kind == "lab_fabric_solve" %}
  # --- left leg: lab fabric solve, real subprocess ---------------------------

  defp lab_fabric_solve(domain_path, problem_path) do
    domain_args =
      JSON.encode!(%{"domain_path" => domain_path, "problem_path" => problem_path})

    args = [
      "-m",
      "autofde_lab.cli",
      "fabric",
      "solve",
      "{{ left_domain }}",
      "--solver",
      "{{ left_solver }}",
      "--domain-arguments",
      domain_args
    ]

    {out, 0} = System.cmd(@lab_python, args, cd: @repo_root, stderr_to_stdout: false)

    # The lab precedes its JSON envelope with log lines (observed convention);
    # skip to the first '{' rather than parsing prose.
    case :binary.match(out, "{") do
      :nomatch -> flunk("lab fabric solve emitted no JSON envelope: #{inspect(out)}")
      {idx, _len} -> JSON.decode!(binary_part(out, idx, byte_size(out) - idx))
    end
  end
{% endif %}

{% if right_command_kind == "beam_hddl_solve" %}
  # --- right leg: ferroplan hddl_solve over the wasm engine ------------------

  defp ferro_hddl_solve do
    {:ok, _} = Ferroplan.start()

    domain = File.read!(Path.join(@repo_root, @domain_rel_path))
    problem = File.read!(Path.join(@repo_root, @problem_rel_path))

    assert {:ok, policy} = Ferroplan.hddl_solve(domain, problem)
    refute Map.has_key?(policy, "error"), "engine error envelope: #{inspect(policy["error"])}"
    policy
  end
{% endif %}

  test "corpus files exist on disk and match their sha256 pins" do
    for {rel_path, pin} <- @corpus do
      abs = Path.join(@repo_root, rel_path)
      assert File.regular?(abs), "corpus file missing: #{rel_path} (graph admits it, disk does not)"

      digest = Base.encode16(:crypto.hash(:sha256, File.read!(abs)), case: :lower)

      assert digest == pin,
             "FLIP: #{rel_path} sha256 moved #{pin} -> #{digest} (corpus edited; re-derive every pin below or revert)"
    end
  end

{% if left_command_kind == "lab_fabric_solve" %}
  test "left leg: lab fabric solve reaches SOLVED through the expected ladder with pinned receipt digests" do
    sol = lab_fabric_solve(@domain_rel_path, @problem_rel_path)

    assert sol["standing"] == "SOLVED",
           "FLIP: lab standing moved to #{inspect(sol["standing"])}"

    steps = Enum.map(sol["steps"], & &1["action"]["name"])

    assert steps == @expected_steps,
           "FLIP: lab rollout ladder moved: #{inspect(steps)}"

    for {key, pin} <- @pins do
      assert is_binary(sol[key]), "lab response missing pinned field #{key}"
      assert sol[key] == pin,
             "FLIP: lab #{key} moved #{pin} -> #{sol[key]} (engine/seam bump; re-derive or escalate)"
    end
  end
{% endif %}

{% if right_command_kind == "beam_hddl_solve" %}
  test "right leg: ferroplan hddl_solve solves and carries the same ladder in its own vocabulary" do
    policy = ferro_hddl_solve()

    assert policy["solved"] == true, "FLIP: ferroplan no longer solves the corpus"

    actions = Enum.map(policy["policy"], & &1["action"])

    # Same decomposition, two receipt vocabularies: ferroplan's UniversalPlan
    # carries one htn:decompose entry plus one htn:exec entry per ladder step.
    assert length(actions) == length(@expected_steps) + 1
    assert Enum.count(actions, &String.contains?(&1, "htn:decompose")) == 1

    for step <- @expected_steps do
      assert Enum.any?(actions, &String.contains?(&1, step)),
             "FLIP: ferroplan policy missing expected ladder step #{step}"
    end
  end
{% endif %}

  test "tamper falsifier: {{ check_name }}" do
    # Falsifier claim (bpm:tamperFalsifier): {{ tamper_falsifier }}
    #
    # The falsifier mutates a TEMP COPY of the corpus entry at order
    # {{ tamper_corpus_order }} ("{{ tamper_find }}" -> "{{ tamper_replace }}");
    # the admitted corpus files above are never touched, and their sha256
    # pins are re-asserted in the corpus test on every run.
    tmp = Path.join(System.tmp_dir!(), "ggen_parity_tamper_#{System.unique_integer([:positive])}")
    File.mkdir_p!(tmp)
    on_exit(fn -> File.rm_rf!(tmp) end)

{% for e in corpus_rows %}
    tampered_{{ loop.index }} = Path.join(tmp, "corpus_copy_{{ loop.index }}")
    text_{{ loop.index }} = File.read!(Path.join(@repo_root, "{{ e.corpus_path }}"))
{% endfor %}
{% set tamper_idx = tamper_corpus_order | int %}
{% for e in corpus_rows %}
{% if loop.index == tamper_idx %}
    File.write!(tampered_{{ loop.index }}, String.replace(text_{{ loop.index }}, "{{ tamper_find }}", "{{ tamper_replace }}"))
{% else %}
    File.write!(tampered_{{ loop.index }}, text_{{ loop.index }})
{% endif %}
{% endfor %}

{% if left_command_kind == "lab_fabric_solve" %}
    tampered_lab = lab_fabric_solve(tampered_1, tampered_2)

    assert tampered_lab["standing"] == "SOLVED",
           "tampered corpus must still solve -- the falsifier witnesses a NAME flip, not a refusal"

    tampered_lab_steps = Enum.map(tampered_lab["steps"], & &1["action"]["name"])

    assert "{{ tamper_replace }}" in tampered_lab_steps,
           "tampered token absent from lab rollout: #{inspect(tampered_lab_steps)}"

    refute "{{ tamper_find }}" in tampered_lab_steps,
           "lab rollout still carries the original token after corpus tampering"

    assert tampered_lab["trajectory_sha256"] != @pins["trajectory_sha256"],
           "tampered corpus left the lab trajectory digest on its pin -- the flip is not witnessed"
{% endif %}

{% if right_command_kind == "beam_hddl_solve" %}
    tampered_domain = File.read!(tampered_1)
    tampered_problem = File.read!(tampered_2)

    # Test order is random: this falsifier may run before the right-leg test,
    # so start the engine here too (start/0 is idempotent).
    {:ok, _} = Ferroplan.start()

    assert {:ok, tampered_policy} = Ferroplan.hddl_solve(tampered_domain, tampered_problem)
    refute Map.has_key?(tampered_policy, "error")

    tampered_actions = Enum.map(tampered_policy["policy"], & &1["action"])

    assert Enum.any?(tampered_actions, &String.contains?(&1, "{{ tamper_replace }}")),
           "tampered token absent from ferroplan policy: #{inspect(tampered_actions)}"

    refute Enum.any?(tampered_actions, &String.contains?(&1, "{{ tamper_find }}")),
           "ferroplan policy still carries the original token after corpus tampering"
{% endif %}
  end
end
