          observed: [SpanEdge.t()],
          adjacent: [SpanEdge.t()],
          inferred_only: [SpanEdge.t()],
          observed_not_adjacent: [SpanEdge.t()],
          orphans: [{String.t(), String.t()}]
        }

  @doc """
  OpenTelemetry parent/child (invocation) causality over `service_span`
  records, side by side with the temporal-adjacency edges the same spans
  yield -- see `t:span_evidence/0` for the five keys.

  This is NOT directly-follows and NOT the OpenTelemetry `links` field: a
  parent -> child link means the child ran inside the parent's interval, so
  the edges are `BeamPM.Types.SpanEdge` records carrying their evidence class,
  never `BeamPM.Types.DfgEdge`. Root spans (`parent_span_id: nil`) contribute
  no incoming edge.

  The two edge sets are NOT nested. For a root `p` with concurrent children
  `s1`, `s2` (`s1` starting first): adjacency yields `p->s1, s1->s2`; links
  yield `p->s1, p->s2`. `s1->s2` is `inferred_only` and `p->s2` is
  `observed_not_adjacent`. Both differences are returned; do not compute only
  one.

  Typed refusals, never silent: a duplicate `span_id` (the index would
  otherwise last-write-win) is `{:error, {:duplicate_span_id, id}}`; a parent
  found in a DIFFERENT `trace_id` (a malformed trace -- links never cross
  traces) is `{:error, {:parent_in_other_trace, child_span_id}}`.
  """
  @spec causal_dfg_from_spans([ServiceSpan.t()]) ::
          {:ok, span_evidence()}
          | {:error, {:duplicate_span_id, String.t()} | {:parent_in_other_trace, String.t()}}
  def causal_dfg_from_spans(spans) when is_list(spans) do
    with {:ok, index} <- index_spans(spans),
         {:ok, link_counts, orphans} <- link_spans(spans, index) do
      observed = span_edges(link_counts, :parent_child_link)

      adjacent =
        spans
        |> traces_from_spans()
        |> dfg_from_traces()
        |> Enum.map(&adjacency_edge/1)

      observed_pairs = MapSet.new(observed, &edge_pair/1)
      adjacent_pairs = MapSet.new(adjacent, &edge_pair/1)

      {:ok,
       %{
         observed: observed,
         adjacent: adjacent,
         inferred_only:
           Enum.reject(adjacent, fn edge -> MapSet.member?(observed_pairs, edge_pair(edge)) end),
         observed_not_adjacent:
           Enum.reject(observed, fn edge -> MapSet.member?(adjacent_pairs, edge_pair(edge)) end),
         orphans: Enum.sort(orphans)
       }}
    end
  end

  # span_id -> span, refusing a duplicate id instead of overwriting it.
  defp index_spans(spans) do
    Enum.reduce_while(spans, {:ok, %{}}, fn %ServiceSpan{} = span, {:ok, index} ->
      if Map.has_key?(index, span.span_id) do
        {:halt, {:error, {:duplicate_span_id, span.span_id}}}
      else
        {:cont, {:ok, Map.put(index, span.span_id, span)}}
      end
    end)
  end

  # Fold parent/child links into a (source, target) -> count map, collecting
  # orphans and refusing a cross-trace parent.
  defp link_spans(spans, index) do
    Enum.reduce_while(spans, {:ok, %{}, []}, fn
      %ServiceSpan{parent_span_id: nil}, acc ->
        {:cont, acc}

      %ServiceSpan{parent_span_id: parent_id} = span, {:ok, counts, orphans} ->
        case Map.fetch(index, parent_id) do
          :error ->
            {:cont, {:ok, counts, [{span.span_id, parent_id} | orphans]}}

          {:ok, %ServiceSpan{} = parent} ->
            if parent.trace_id == span.trace_id do
              pair = {parent.service_name, span.service_name}
              {:cont, {:ok, Map.update(counts, pair, 1, &(&1 + 1)), orphans}}
            else
              {:halt, {:error, {:parent_in_other_trace, span.span_id}}}
            end
        end
    end)
  end

  # Counting map -> sorted SpanEdge list carrying `evidence`.
  defp span_edges(counts, evidence) do
    counts
    |> Enum.sort_by(fn {pair, _count} -> pair end)
    |> Enum.map(fn {pair, count} ->
      {source, target} = pair

      {:ok, edge} =
        SpanEdge.new(%{
          source_service: source,
          target_service: target,
          frequency: count,
          evidence: evidence
        })

      edge
    end)
  end

  # A DfgEdge from the adjacency arm, re-tagged as what it is.
  defp adjacency_edge(%DfgEdge{} = dfg_edge) do
    {:ok, edge} =
      SpanEdge.new(%{
        source_service: dfg_edge.source_activity,
        target_service: dfg_edge.target_activity,
        frequency: dfg_edge.frequency,
        evidence: :temporal_adjacency
      })

    edge
  end

  defp edge_pair(%SpanEdge{} = edge), do: {edge.source_service, edge.target_service}
