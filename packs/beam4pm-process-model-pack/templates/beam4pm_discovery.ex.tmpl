  @doc """
  Fitness AND precision of one trace against a directly-follows edge set.

  `trace_id` is the trace's `case_id`. Fitness is the fraction (a float) of
  the trace's adjacent activity pairs present in the edge set, and `1.0` for
  traces with fewer than 2 activities. Precision is `BeamPM.Precision`'s ETC
  (escaping-edge) score for the same trace against the same edge set - see
  that module's `@moduledoc` for the exact formula and its provenance. This
  used to leave `precision` unset; it is now always a computed float.
  """
  @spec conformance([DfgEdge.t()], LogTrace.t()) :: ConformanceResult.t()
  def conformance(edges, %LogTrace{} = trace) when is_list(edges) do
    pairs = adjacent_pairs(trace.activity_sequence)

    fitness =
      case pairs do
        [] ->
          1.0

        _ ->
          known =
            MapSet.new(edges, fn %DfgEdge{} = edge ->
              {edge.source_activity, edge.target_activity}
            end)

          present = Enum.count(pairs, fn pair -> MapSet.member?(known, pair) end)
          present / length(pairs)
      end

    precision = Precision.etc_precision(edges, trace)

    {:ok, result} =
      ConformanceResult.new(%{trace_id: trace.case_id, fitness: fitness, precision: precision})

    result
  end
