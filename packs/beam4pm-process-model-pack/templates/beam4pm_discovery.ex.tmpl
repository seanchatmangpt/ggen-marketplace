    |> Enum.group_by(fn %ServiceSpan{} = span -> span.trace_id end)
    |> Enum.sort_by(fn {trace_id, _trace_spans} -> trace_id end)
    |> Enum.map(fn {trace_id, trace_spans} ->
      activity_sequence =
        trace_spans
        |> Enum.sort_by(fn span -> {span.start_time, span.span_id} end)
        |> Enum.map(fn span -> span.service_name end)

      {:ok, trace} = LogTrace.new(%{case_id: trace_id, activity_sequence: activity_sequence})
