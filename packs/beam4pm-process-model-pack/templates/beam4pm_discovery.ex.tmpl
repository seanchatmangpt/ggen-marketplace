  @doc """
  Groups OCEL events into case-centric traces.

  The case id is read from each event's `attributes` map at the string key
  `case_attr_key`; events without that key (including events with `nil`
  attributes) are skipped. Within a case, events are ordered by `event_time`
  (lexicographic ISO8601), ties broken by `event_id`. The resulting traces
  are sorted by `case_id`.
  """
  @spec traces_from_events([OcelEvent.t()], String.t()) :: [LogTrace.t()]
  def traces_from_events(events, case_attr_key)
      when is_list(events) and is_binary(case_attr_key) do
    events
    |> Enum.flat_map(fn %OcelEvent{} = event ->
      case event.attributes do
        %{^case_attr_key => case_id} -> [{case_id, event}]
        _ -> []
      end
    end)
    |> Enum.group_by(fn {case_id, _event} -> case_id end, fn {_case_id, event} -> event end)
    |> Enum.sort_by(fn {case_id, _case_events} -> case_id end)
    |> Enum.map(fn {case_id, case_events} ->
      activity_sequence =
        case_events
        |> Enum.sort_by(fn event -> {event.event_time, event.event_id} end)
        |> Enum.map(fn event -> event.event_type end)

      {:ok, trace} =
        LogTrace.new(%{case_id: case_id, activity_sequence: activity_sequence})

      trace
    end)
  end

  @doc """
