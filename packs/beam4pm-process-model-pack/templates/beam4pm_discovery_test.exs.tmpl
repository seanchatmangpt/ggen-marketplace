# GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
defmodule BeamPM.DiscoveryTest do
  use ExUnit.Case, async: true

  alias BeamPM.Discovery
  alias BeamPM.Types.ConformanceResult
  alias BeamPM.Types.DfgEdge
  alias BeamPM.Types.LogTrace
  alias BeamPM.Types.OcelEvent
  alias BeamPM.Types.ProcessVariant
  alias BeamPM.Types.ServiceSpan
  alias BeamPM.Types.SpanEdge

  @case_attr_key "case_id"

  defp event!(event_id, event_type, event_time, attributes) do
    {:ok, event} =
      OcelEvent.new(%{
        event_id: event_id,
        event_type: event_type,
        event_time: event_time,
        attributes: attributes
      })

    event
  end

  defp trace!(case_id, activity_sequence) do
    {:ok, trace} = LogTrace.new(%{case_id: case_id, activity_sequence: activity_sequence})
    trace
  end

  # Seeded known log (shared with the Erlang discovery tests): 3 cases plus
  # one event whose attributes lack the case attribute key. The input list is
  # deliberately shuffled, and c2's two events share the same timestamp so the
  # event_id tie-break is exercised.
  defp seeded_events do
    [
      event!("e5", "approve", "2026-08-29T12:02:00Z", %{"case_id" => "c1"}),
      event!("e1", "receive", "2026-08-29T12:00:00Z", %{"case_id" => "c1"}),
      event!("e4", "validate", "2026-08-29T12:00:00Z", %{"case_id" => "c2"}),
      event!("e2", "validate", "2026-08-29T12:01:00Z", %{"case_id" => "c1"}),
      event!("e3", "receive", "2026-08-29T12:00:00Z", %{"case_id" => "c2"}),
      event!("e6", "receive", "2026-08-29T12:00:00Z", %{"case_id" => "c3"}),
      event!("e7", "orphan", "2026-08-29T12:03:00Z", %{"other" => "x"})
    ]
  end

  defp seeded_edges do
    seeded_events()
    |> Discovery.traces_from_events(@case_attr_key)
    |> Discovery.dfg_from_traces()
  end

  test "traces_from_events/2 groups, sorts, tie-breaks, and skips events missing the case attribute" do
    traces = Discovery.traces_from_events(seeded_events(), @case_attr_key)

    assert [
             %LogTrace{case_id: "c1", activity_sequence: ["receive", "validate", "approve"]},
             %LogTrace{case_id: "c2", activity_sequence: ["receive", "validate"]},
             %LogTrace{case_id: "c3", activity_sequence: ["receive"]}
           ] = traces

    refute Enum.any?(traces, fn trace -> "orphan" in trace.activity_sequence end)
  end

  test "dfg_from_traces/1 counts exact directly-follows edge frequencies, sorted by source then target" do
    assert [
             %DfgEdge{source_activity: "receive", target_activity: "validate", frequency: 2},
             %DfgEdge{source_activity: "validate", target_activity: "approve", frequency: 1}
           ] = seeded_edges()
  end

  # Precision (BeamPM.Precision's ETC/escaping-edge score, adapted from
  # ex4pm's real Ex4pmEngine.ETCPrecision) was wired into conformance/2
  # alongside fitness; see beam4pm_precision.ex.tmpl's own moduledoc for the
  # formula. Every expected value below is a real, by-hand computation over
  # this test's own seeded model (out-degrees: receive=1, validate=1,
  # approve=0) -- not asserted blind.
  test "conformance/2 fitness is exactly 1.0 (a float) for a fully fitting trace" do
    result = Discovery.conformance(seeded_edges(), trace!("c1", ["receive", "validate", "approve"]))

    # By hand: (receive,validate) known, enabled=1, escaping=max(0,1-1)=0.
    # (validate,approve) known, enabled=1, escaping=0. total=2/0 -> precision=1.0.
    assert %ConformanceResult{trace_id: "c1", fitness: fitness, precision: 1.0} = result
    assert fitness === 1.0
  end

  test "conformance/2 fitness is exactly 0.5 when one of two adjacent pairs is unknown" do
    result = Discovery.conformance(seeded_edges(), trace!("c9", ["receive", "validate", "reject"]))

    # By hand: (receive,validate) known, enabled=1, escaping=0.
    # (validate,reject) NOT known, enabled=out_degree(validate)=1, escaping=1.
    # total_enabled=2, total_escaping=1 -> precision=1.0-1/2=0.5.
    assert %ConformanceResult{trace_id: "c9", fitness: fitness, precision: 0.5} = result
    assert fitness === 0.5
  end

  test "conformance/2 fitness is exactly 1.0 (a float) for a single-activity trace" do
    result = Discovery.conformance(seeded_edges(), trace!("c3", ["receive"]))

    # A single-activity trace has zero adjacent pairs -- honestly 1.0 (same
    # convention fitness already uses: nothing observed, nothing escaped).
    assert %ConformanceResult{trace_id: "c3", fitness: fitness, precision: 1.0} = result
    assert fitness === 1.0
    assert is_float(fitness)
  end

  test "conformance/2 fitness is exactly 1.0 (a float) for an empty edge set and a short trace" do
    result = Discovery.conformance([], trace!("c3", ["receive"]))

    assert %ConformanceResult{trace_id: "c3", fitness: fitness, precision: 1.0} = result
    assert fitness === 1.0
  end

  test "variants_from_traces/1 groups traces by identical activity_sequence, sorted, with a 1-based rank id" do
    # Seeded traces: c1=[receive,validate,approve], c2=[receive,validate],
    # c3=[receive] -- 3 distinct sequences, each frequency 1. Sorted by
    # activity_sequence: [receive] < [receive,validate] < [receive,validate,approve].
    traces = Discovery.traces_from_events(seeded_events(), @case_attr_key)

    assert [
             %ProcessVariant{variant_id: "1", activity_sequence: ["receive"], frequency: 1},
             %ProcessVariant{
               variant_id: "2",
               activity_sequence: ["receive", "validate"],
               frequency: 1
             },
             %ProcessVariant{
               variant_id: "3",
               activity_sequence: ["receive", "validate", "approve"],
               frequency: 1
             }
           ] = Discovery.variants_from_traces(traces)
  end

  test "variants_from_traces/1 collapses traces sharing the exact same activity_sequence into one variant" do
    t1 = trace!("t1", ["x", "y"])
    t2 = trace!("t2", ["x", "y"])
    t3 = trace!("t3", ["z"])

    assert [
             %ProcessVariant{activity_sequence: ["x", "y"], frequency: 2},
             %ProcessVariant{activity_sequence: ["z"], frequency: 1}
           ] = Discovery.variants_from_traces([t1, t2, t3])
  end

  test "variants_from_traces/1 returns an empty list for no traces" do
    assert Discovery.variants_from_traces([]) == []
  end
