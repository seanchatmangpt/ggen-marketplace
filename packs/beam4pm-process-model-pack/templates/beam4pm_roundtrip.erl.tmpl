---
to: src/beam4pm_roundtrip.erl
sparql:
  records: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:recordDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order ?sample_erlang WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:hasField ?f .
      ?f bpm:fieldName ?field_name ; bpm:fieldType ?field_type ; bpm:fieldDoc ?field_doc ;
         bpm:fieldRequired ?field_required ; bpm:fieldOrder ?field_order .
      ?ft a bpm:FieldType ; bpm:fieldTypeName ?field_type ; bpm:sampleErlang ?sample_erlang .
    } ORDER BY ?record_name ?field_order
---
%% GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
%%
%% Cross-language roundtrip sample fixtures: one deterministic sample per
%% admitted record type and variant (full | minimal), written and verified
%% through beam4pm_codec so any drift between the Erlang and Elixir codecs
%% surfaces as a real fixture mismatch, not an assumed equivalence.

-module(beam4pm_roundtrip).

-export([record_names/0, sample/2, write_samples/1, verify_samples/2]).

-type variant() :: full | minimal.

-spec record_names() -> [atom()].
record_names() ->
    [
{%- for r in records %}
        {{ r.record_name }}{% if not loop.last %},{% endif %}
{%- endfor %}
    ].

%% Deterministic sample values, keyed by bpm:fieldType -- each is the pack
%% vocabulary's bpm:sampleErlang literal for that bpm:FieldType:
%% string -> <<"sample_" field_name>>, datetime -> an ISO 8601 UTC binary
%% carrying six microsecond digits (the same fixture the Ash-leg tests use,
%% so a sub-second-truncating projection is caught), integer -> 42,
%% float -> 3.5, boolean -> true, atom -> sample_atom,
%% list_string -> [<<"alpha">>, <<"beta">>], map -> #{<<"k">> => <<"v">>}.
%% minimal = required fields only; full = every field.
-spec sample(atom(), variant()) -> {ok, tuple()}.
{% for r in records %}{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) -%}
{%- set reqfields = rfields | filter(attribute="field_required", value="true") -%}
sample({{ r.record_name }}, full) ->
    beam4pm_types:new_{{ r.record_name }}(#{
{%- for f in rfields %}
        {{ f.field_name }} => {{ f.sample_erlang | replace(from="__FIELD__", to=f.field_name) }}{% if not loop.last %},{% endif %}
{%- endfor %}
    });
sample({{ r.record_name }}, minimal) ->
    beam4pm_types:new_{{ r.record_name }}(#{
{%- for f in reqfields %}
        {{ f.field_name }} => {{ f.sample_erlang | replace(from="__FIELD__", to=f.field_name) }}{% if not loop.last %},{% endif %}
{%- endfor %}
    });
{% endfor -%}
sample(Name, Variant) ->
    erlang:error({unknown_sample, Name, Variant}).

%% Write every record x variant sample as Dir/<record>.<variant>.erl.json.
-spec write_samples(file:filename_all()) -> ok.
write_samples(Dir) ->
    ok = filelib:ensure_path(Dir),
    lists:foreach(
        fun({Name, Variant}) ->
            {ok, Rec} = sample(Name, Variant),
            Json = beam4pm_codec:encode(Rec),
            Path = filename:join(Dir, sample_basename(Name, Variant, "erl")),
            ok = file:write_file(Path, Json)
        end,
        pairs()),
    ok.

%% Read every record x variant fixture Dir/<record>.<variant>.<Suffix>.json,
%% decode it, and compare its canonical map against this module's own sample.
-spec verify_samples(file:filename_all(), string()) ->
    {non_neg_integer(), [string()]}.
verify_samples(Dir, Suffix) ->
    lists:foldl(
        fun({Name, Variant}, {Pass, Failures}) ->
            Label = atom_to_list(Name) ++ "." ++ atom_to_list(Variant),
            Path = filename:join(Dir, sample_basename(Name, Variant, Suffix)),
            {ok, Expected} = sample(Name, Variant),
            case file:read_file(Path) of
                {ok, Bin} ->
                    case beam4pm_codec:decode(Name, Bin) of
                        {ok, Decoded} ->
                            case beam4pm_codec:to_map(Decoded) =:= beam4pm_codec:to_map(Expected) of
                                true -> {Pass + 1, Failures};
                                false -> {Pass, Failures ++ [Label ++ ": map mismatch"]}
                            end;
                        {error, Reason} ->
                            {Pass, Failures ++ [Label ++ ": decode error " ++ format_term(Reason)]}
                    end;
                {error, Reason} ->
                    {Pass, Failures ++ [Label ++ ": read error " ++ format_term(Reason)]}
            end
        end,
        {0, []},
        pairs()).

%% internal

pairs() ->
    [{Name, Variant} || Name <- record_names(), Variant <- [full, minimal]].

sample_basename(Name, Variant, Suffix) ->
    atom_to_list(Name) ++ "." ++ atom_to_list(Variant) ++ "." ++ Suffix ++ ".json".

format_term(Term) ->
    lists:flatten(io_lib:format("~0p", [Term])).
