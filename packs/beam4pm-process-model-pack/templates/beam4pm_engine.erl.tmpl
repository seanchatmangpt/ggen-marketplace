---
to: "src/beam4pm_{{ engine_name }}.erl"
sparql:
  engines: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?engine_module ?engine_doc ?ordinal ?handle_noun ?wasm_artifact WHERE {
      ?e a bpm:Engine ;
         bpm:engineName ?engine_name ;
         bpm:engineModule ?engine_module ;
         bpm:engineDoc ?engine_doc ;
         bpm:engineOrdinal ?ordinal ;
         bpm:handleNoun ?handle_noun ;
         bpm:wasmArtifactPath ?wasm_artifact .
    } ORDER BY ?ordinal
  ops: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?op_key ?op_name ?elixir_name ?op_order ?op_doc ?op_kind ?delegates_to ?expose_erlang WHERE {
      ?op a bpm:EngineOp ;
          bpm:opEngine ?e ;
          bpm:opName ?op_name ;
          bpm:opOrder ?op_order ;
          bpm:opDoc ?op_doc ;
          bpm:opKind ?k .
      ?e a bpm:Engine ; bpm:engineName ?engine_name .
      ?k a bpm:EngineOpKind ; bpm:engineOpKindName ?op_kind .
      OPTIONAL { ?op bpm:opElixirPredicate ?pred_opt }
      OPTIONAL { ?op bpm:opDelegatesTo ?target . ?target bpm:opName ?target_name }
      OPTIONAL { ?op bpm:opExposeErlang ?erl_opt }
      BIND(CONCAT(?engine_name, "/", ?op_name) AS ?op_key)
      BIND(COALESCE(?pred_opt, "false") AS ?predicate)
      BIND(COALESCE(?target_name, "-") AS ?delegates_to)
      BIND(COALESCE(?erl_opt, "true") AS ?expose_erlang)
      BIND(IF(?predicate = "true", CONCAT("'", ?op_name, "?'"), ?op_name) AS ?elixir_name)
    } ORDER BY ?engine_name ?op_order
  args: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?op_key ?arg_name ?arg_order ?erlang_type ?mode ?extra WHERE {
      ?a a bpm:EngineArg ;
         bpm:argOp ?op ;
         bpm:argName ?arg_name ;
         bpm:argOrder ?arg_order ;
         bpm:argType ?t .
      ?op a bpm:EngineOp ; bpm:opEngine ?e ; bpm:opName ?op_name .
      ?e a bpm:Engine ; bpm:engineName ?engine_name .
      ?t a bpm:EngineArgType ; bpm:argErlangType ?erlang_type .
      OPTIONAL { ?a bpm:argMode ?m . ?m a bpm:ArgMode ; bpm:argModeName ?mode_name }
      BIND(CONCAT(?engine_name, "/", ?op_name) AS ?op_key)
      BIND(COALESCE(?mode_name, "required") AS ?mode)
      BIND(IF(?mode = "required", "false", "true") AS ?extra)
    } ORDER BY ?op_key ?arg_order
  type_decls: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT DISTINCT ?engine_name ?decl WHERE {
      ?a a bpm:EngineArg ; bpm:argOp ?op ; bpm:argType ?t .
      ?op a bpm:EngineOp ; bpm:opEngine ?e .
      ?e a bpm:Engine ; bpm:engineName ?engine_name .
      ?t bpm:argErlangTypeDecl ?decl .
      FILTER NOT EXISTS { ?op bpm:opExposeErlang "false" }
    } ORDER BY ?engine_name ?decl
for_each: engines
---
{%- set eops = ops | filter(attribute="engine_name", value=engine_name) | filter(attribute="expose_erlang", value="true") %}
{%- set eargs = args | filter(attribute="engine_name", value=engine_name) %}
{%- set decls = type_decls | filter(attribute="engine_name", value=engine_name) %}
{%- set elixir_module = "'Elixir.BeamPM." ~ engine_module ~ "'" -%}
%% GENERATED by ggen from the admitted bpm:Engine graph ({{ engine_name }}). Do not edit.
%%
%% beam4pm_{{ engine_name }}: thin Erlang facade over the {{ engine_name }} native engine --
%% {{ engine_doc }}
%%
%% The engine is compiled to wasm32-wasip1 and hosted inside BEAM by
%% Elixir/wasmex ('Elixir.BeamPM.{{ engine_module }}', lib/beam4pm_{{ engine_name }}.ex); this
%% module, that wrapper and the Gleam facade gleam/src/beam4pm/{{ engine_name }}.gleam
%% are all rendered from the same admitted bpm:Engine / bpm:EngineOp /
%% bpm:EngineArg facts.
%%
%% Wire contract: every function here delegates 1:1 to the same-named
%% function on {{ elixir_module }} and returns its result unchanged --
%% {ok, Map} | {error, Reason}, where Map is the JSON-decoded engine
%% response with binary keys. {{ handle_noun | capitalize }} handles are plain integers minted
%% by the wasm engine; they are process-lifetime and are ALL invalidated
%% when the Wasmex engine process restarts. No computation happens in
%% Erlang: this module is a facade over the single {{ engine_name }} wasm engine.
%%
%% Arity variants: an op whose Elixir head has an optional positional or a
%% keyword-list option (bpm:ArgMode_optional / bpm:ArgMode_keyword) is
%% exported at both its minimal arity (Elixir's default-argument head) and
%% one arity higher taking that value explicitly, since Erlang has no
%% default-argument or keyword-list sugar.
%%
%% Why there is no beam4pm_{{ engine_name }}_tests.erl: eunit runs under rebar3 (root
%% rebar.config), which compiles src/ WITHOUT Mix dependencies, so wasmex is
%% not on rebar3's code path. This facade is exercised for real from ExUnit
%% (test/beam4pm_{{ engine_name }}_facades_test.exs), in the Mix context.

-module(beam4pm_{{ engine_name }}).

-export([start/0{% for op in eops %}{% set oargs = eargs | filter(attribute="op_key", value=op.op_key) %}{% set req = oargs | filter(attribute="mode", value="required") %}{% set extra = oargs | filter(attribute="extra", value="true") %}{% set n = req | length %},
         {{ op.op_name }}/{{ n }}{% if extra | length > 0 %}, {{ op.op_name }}/{{ n + 1 }}{% endif %}{% endfor %}]).

-type result() :: {ok, map()} | {error, term()}.
-type handle() :: non_neg_integer().
{%- for d in decls %}
{{ d.decl }}
{%- endfor %}

%% Start (or find already-started) the named Wasmex engine process.
-spec start() -> {ok, pid()} | {error, term()}.
start() -> {{ elixir_module }}:start().
{%- for op in eops %}
{%- set oargs = eargs | filter(attribute="op_key", value=op.op_key) %}
{%- set req = oargs | filter(attribute="mode", value="required") %}
{%- set extra = oargs | filter(attribute="extra", value="true") %}

%% {{ op.op_doc }}
-spec {{ op.op_name }}({% for a in req %}{{ a.erlang_type }}{% if not loop.last %}, {% endif %}{% endfor %}) -> result().
{{ op.op_name }}({% for a in req %}{% for p in a.arg_name | split(pat="_") %}{{ p | capitalize }}{% endfor %}{% if not loop.last %}, {% endif %}{% endfor %}) ->
    {{ elixir_module }}:{{ op.elixir_name }}({% for a in req %}{% for p in a.arg_name | split(pat="_") %}{{ p | capitalize }}{% endfor %}{% if not loop.last %}, {% endif %}{% endfor %}).
{%- if extra | length > 0 %}
{%- set x = extra | first %}

{% if x.mode == "keyword" %}%% Explicit `{{ x.arg_name }}` (Elixir reads it from its opts keyword list).{% else %}%% Explicit `{{ x.arg_name }}` (Elixir's optional positional argument).{% endif %}
-spec {{ op.op_name }}({% for a in req %}{{ a.erlang_type }}, {% endfor %}{{ x.erlang_type }}) -> result().
{{ op.op_name }}({% for a in req %}{% for p in a.arg_name | split(pat="_") %}{{ p | capitalize }}{% endfor %}, {% endfor %}{% for p in x.arg_name | split(pat="_") %}{{ p | capitalize }}{% endfor %}) ->
    {{ elixir_module }}:{{ op.elixir_name }}({% for a in req %}{% for p in a.arg_name | split(pat="_") %}{{ p | capitalize }}{% endfor %}, {% endfor %}{% if x.mode == "keyword" %}[{{ "{" }}{{ x.arg_name }}, {% for p in x.arg_name | split(pat="_") %}{{ p | capitalize }}{% endfor %}}]{% else %}{% for p in x.arg_name | split(pat="_") %}{{ p | capitalize }}{% endfor %}{% endif %}).
{%- endif %}
{%- endfor %}
