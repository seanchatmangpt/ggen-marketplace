%% ---------------------------------------------------------------------------
%% causal_dfg_from_spans/1 -- observed (parent/child link) vs inferred
%% (start_time adjacency). VISION-2030 section 24 falsifier: "telemetry
%% adjacency cannot be distinguished from causality well enough for
%% trustworthy process inference". Every fixture below is a real
%% beam4pm_types:new_service_span/1 record; every expected edge set is a
%% by-hand derivation stated in the comment, asserted two-sided (nothing
%% missing, nothing extra, exact frequencies) -- not membership only.
%% ---------------------------------------------------------------------------

span(Id, Service, Parent, TraceId, Start) ->
    {ok, Span} = beam4pm_types:new_service_span(
        #{span_id => Id, service_name => Service, duration_ms => 10,
          parent_span_id => Parent, trace_id => TraceId, start_time => Start}),
    Span.

root_span(Id, Service, TraceId, Start) ->
    {ok, Span} = beam4pm_types:new_service_span(
        #{span_id => Id, service_name => Service, duration_ms => 50,
          trace_id => TraceId, start_time => Start}),
    Span.

%% The disagreement fixture: one root (gateway) fans out to two CONCURRENT
%% children (orders, inventory). Their start_time order is scheduling noise,
%% not causality. Variant A: orders starts first.
%%   adjacency (time order): gateway -> orders -> inventory
%%   links (parent/child):   gateway -> orders, gateway -> inventory
fan_out_orders_first() ->
    [root_span(<<"r1">>, <<"gateway">>, <<"t1">>, <<"2026-09-05T10:00:00.000Z">>),
     span(<<"s2">>, <<"inventory">>, <<"r1">>, <<"t1">>, <<"2026-09-05T10:00:00.020Z">>),
     span(<<"s1">>, <<"orders">>, <<"r1">>, <<"t1">>, <<"2026-09-05T10:00:00.010Z">>)].

%% Variant B: the SAME spans and the SAME links, inventory starts first.
fan_out_inventory_first() ->
    [span(<<"s1">>, <<"orders">>, <<"r1">>, <<"t1">>, <<"2026-09-05T10:00:00.020Z">>),
     root_span(<<"r1">>, <<"gateway">>, <<"t1">>, <<"2026-09-05T10:00:00.000Z">>),
     span(<<"s2">>, <<"inventory">>, <<"r1">>, <<"t1">>, <<"2026-09-05T10:00:00.010Z">>)].

edge_tuples(Edges) ->
    [{beam4pm_discovery:span_edge_source_service(E),
      beam4pm_discovery:span_edge_target_service(E),
      beam4pm_discovery:span_edge_frequency(E),
      beam4pm_discovery:span_edge_evidence(E)} || E <- Edges].

causal_fan_out_separates_observed_from_inferred_test() ->
    {ok, Ev} = beam4pm_discovery:causal_dfg_from_spans(fan_out_orders_first()),
    %% Observed: exactly the two parent/child links, sorted by target.
    ?assertEqual([{<<"gateway">>, <<"inventory">>, 1, parent_child_link},
                  {<<"gateway">>, <<"orders">>, 1, parent_child_link}],
                 edge_tuples(maps:get(observed, Ev))),
    %% Adjacent: exactly what time order says.
    ?assertEqual([{<<"gateway">>, <<"orders">>, 1, temporal_adjacency},
                  {<<"orders">>, <<"inventory">>, 1, temporal_adjacency}],
                 edge_tuples(maps:get(adjacent, Ev))),
    %% The sibling edge adjacency INVENTS -- no link supports it:
    ?assertEqual([{<<"orders">>, <<"inventory">>, 1, temporal_adjacency}],
                 edge_tuples(maps:get(inferred_only, Ev))),
    %% The real causal edge adjacency CANNOT SEE (the root's second child):
    ?assertEqual([{<<"gateway">>, <<"inventory">>, 1, parent_child_link}],
                 edge_tuples(maps:get(observed_not_adjacent, Ev))),
    ?assertEqual([], maps:get(orphans, Ev)).

causal_arm_invariant_under_sibling_reorder_adjacency_arm_is_not_test() ->
    {ok, A} = beam4pm_discovery:causal_dfg_from_spans(fan_out_orders_first()),
    {ok, B} = beam4pm_discovery:causal_dfg_from_spans(fan_out_inventory_first()),
    %% Same links -> identical observed arm, byte for byte.
    ?assertEqual(maps:get(observed, A), maps:get(observed, B)),
    %% Same spans, different clock order -> the adjacency arm flips.
    ?assertNotEqual(maps:get(adjacent, A), maps:get(adjacent, B)),
    ?assertEqual([{<<"gateway">>, <<"inventory">>, 1, temporal_adjacency},
                  {<<"inventory">>, <<"orders">>, 1, temporal_adjacency}],
                 edge_tuples(maps:get(adjacent, B))),
    %% ...and so do both differences: the invented sibling edge reverses,
    %% and the causal edge adjacency misses is now the OTHER child.
    ?assertEqual([{<<"inventory">>, <<"orders">>, 1, temporal_adjacency}],
                 edge_tuples(maps:get(inferred_only, B))),
    ?assertEqual([{<<"gateway">>, <<"orders">>, 1, parent_child_link}],
                 edge_tuples(maps:get(observed_not_adjacent, B))).

causal_adjacency_arm_is_todays_discovery_retagged_test() ->
    %% The adjacent arm is exactly traces_from_spans/1 -> dfg_from_traces/1
    %% (the same code path traces_from_events/2 feeds), re-tagged. Nothing
    %% new is inferred in it -- so whatever it invents, today's discovery
    %% invents too.
    Spans = fan_out_orders_first(),
    {ok, Ev} = beam4pm_discovery:causal_dfg_from_spans(Spans),
    Dfg = beam4pm_discovery:dfg_from_traces(beam4pm_discovery:traces_from_spans(Spans)),
    ?assertEqual(
        [{beam4pm_discovery:dfg_edge_source_activity(E),
          beam4pm_discovery:dfg_edge_target_activity(E),
          beam4pm_discovery:dfg_edge_frequency(E)} || E <- Dfg],
        [{S, T, F} || {S, T, F, temporal_adjacency} <- edge_tuples(maps:get(adjacent, Ev))]),
    ?assert(lists:all(fun(E) -> beam4pm_discovery:span_edge_evidence(E) =:= temporal_adjacency end,
                      maps:get(adjacent, Ev))),
    ?assert(lists:all(fun(E) -> beam4pm_discovery:span_edge_evidence(E) =:= parent_child_link end,
                      maps:get(observed, Ev))).

traces_from_spans_exact_test() ->
    %% One trace, case_id = trace_id, ordered by start_time regardless of
    %% input order; parent links are never consulted (an orphan is placed
    %% by its clock like any other span).
    Spans = fan_out_orders_first()
        ++ [span(<<"o1">>, <<"billing">>, <<"missing">>, <<"t1">>, <<"2026-09-05T10:00:00.030Z">>)],
    [Trace] = beam4pm_discovery:traces_from_spans(Spans),
    ?assertEqual(<<"t1">>, beam4pm_discovery:log_trace_case_id(Trace)),
    ?assertEqual([<<"gateway">>, <<"orders">>, <<"inventory">>, <<"billing">>],
                 beam4pm_discovery:log_trace_activity_sequence(Trace)).

traces_from_spans_tie_breaks_on_span_id_test() ->
    At = <<"2026-09-05T10:00:00.000Z">>,
    Spans = [root_span(<<"b">>, <<"second">>, <<"tx">>, At),
             root_span(<<"a">>, <<"first">>, <<"tx">>, At)],
    [Trace] = beam4pm_discovery:traces_from_spans(Spans),
    ?assertEqual([<<"first">>, <<"second">>],
                 beam4pm_discovery:log_trace_activity_sequence(Trace)).

causal_orphan_is_reported_never_invented_test() ->
    %% o1's parent "missing" was sampled out. No causal edge may be invented
    %% for it; it is named in orphans; adjacency still places it (by clock)
    %% after inventory, and THAT edge is classified inferred_only -- the
    %% caller can see the missing evidence rather than a fabricated edge.
    Spans = fan_out_orders_first()
        ++ [span(<<"o1">>, <<"billing">>, <<"missing">>, <<"t1">>, <<"2026-09-05T10:00:00.030Z">>)],
    {ok, Ev} = beam4pm_discovery:causal_dfg_from_spans(Spans),
    ?assertEqual([{<<"o1">>, <<"missing">>}], maps:get(orphans, Ev)),
    ?assertEqual([{<<"gateway">>, <<"inventory">>, 1, parent_child_link},
                  {<<"gateway">>, <<"orders">>, 1, parent_child_link}],
                 edge_tuples(maps:get(observed, Ev))),
    ?assertEqual([{<<"inventory">>, <<"billing">>, 1, temporal_adjacency},
                  {<<"orders">>, <<"inventory">>, 1, temporal_adjacency}],
                 edge_tuples(maps:get(inferred_only, Ev))).

causal_duplicate_span_id_is_a_typed_refusal_test() ->
    Spans = fan_out_orders_first()
        ++ [root_span(<<"r1">>, <<"gateway">>, <<"t9">>, <<"2026-09-05T11:00:00.000Z">>)],
    ?assertEqual({error, {duplicate_span_id, <<"r1">>}},
                 beam4pm_discovery:causal_dfg_from_spans(Spans)).

causal_parent_in_other_trace_is_a_typed_refusal_test() ->
    %% x1 claims r1 (trace t1) as parent but carries trace_id t2: a link
    %% that crosses traces is a malformed trace, refused by child span_id.
    Spans = fan_out_orders_first()
        ++ [span(<<"x1">>, <<"payments">>, <<"r1">>, <<"t2">>, <<"2026-09-05T10:00:00.040Z">>)],
    ?assertEqual({error, {parent_in_other_trace, <<"x1">>}},
                 beam4pm_discovery:causal_dfg_from_spans(Spans)).

causal_empty_and_root_only_inputs_yield_no_edges_test() ->
    Empty = #{observed => [], adjacent => [], inferred_only => [],
              observed_not_adjacent => [], orphans => []},
    ?assertEqual({ok, Empty}, beam4pm_discovery:causal_dfg_from_spans([])),
    ?assertEqual({ok, Empty},
                 beam4pm_discovery:causal_dfg_from_spans(
                     [root_span(<<"r1">>, <<"gateway">>, <<"t1">>, <<"2026-09-05T10:00:00.000Z">>)])).

causal_same_service_parent_child_is_a_real_self_edge_test() ->
    %% gateway calls gateway (a child span in the same service): a legitimate
    %% A -> A edge in both arms, agreed on by both -- no difference either way.
    Spans = [root_span(<<"r1">>, <<"gateway">>, <<"t1">>, <<"2026-09-05T10:00:00.000Z">>),
             span(<<"c1">>, <<"gateway">>, <<"r1">>, <<"t1">>, <<"2026-09-05T10:00:00.005Z">>)],
    {ok, Ev} = beam4pm_discovery:causal_dfg_from_spans(Spans),
    ?assertEqual([{<<"gateway">>, <<"gateway">>, 1, parent_child_link}],
                 edge_tuples(maps:get(observed, Ev))),
    ?assertEqual([{<<"gateway">>, <<"gateway">>, 1, temporal_adjacency}],
                 edge_tuples(maps:get(adjacent, Ev))),
    ?assertEqual([], maps:get(inferred_only, Ev)),
    ?assertEqual([], maps:get(observed_not_adjacent, Ev)).

causal_frequency_counts_links_per_service_pair_test() ->
    %% Two traces with the identical fan-out shape: every observed edge has
    %% frequency 2 (two links per pair), every adjacent edge frequency 2 (one
    %% consecutive pair per trace), and the differences carry 2 as well.
    T2 = [root_span(<<"r2">>, <<"gateway">>, <<"t2">>, <<"2026-09-05T10:01:00.000Z">>),
          span(<<"s3">>, <<"orders">>, <<"r2">>, <<"t2">>, <<"2026-09-05T10:01:00.010Z">>),
          span(<<"s4">>, <<"inventory">>, <<"r2">>, <<"t2">>, <<"2026-09-05T10:01:00.020Z">>)],
    {ok, Ev} = beam4pm_discovery:causal_dfg_from_spans(fan_out_orders_first() ++ T2),
    ?assertEqual([{<<"gateway">>, <<"inventory">>, 2, parent_child_link},
                  {<<"gateway">>, <<"orders">>, 2, parent_child_link}],
                 edge_tuples(maps:get(observed, Ev))),
    ?assertEqual([{<<"gateway">>, <<"orders">>, 2, temporal_adjacency},
                  {<<"orders">>, <<"inventory">>, 2, temporal_adjacency}],
                 edge_tuples(maps:get(adjacent, Ev))),
    ?assertEqual([{<<"orders">>, <<"inventory">>, 2, temporal_adjacency}],
                 edge_tuples(maps:get(inferred_only, Ev))),
    ?assertEqual([{<<"gateway">>, <<"inventory">>, 2, parent_child_link}],
                 edge_tuples(maps:get(observed_not_adjacent, Ev))).

causal_adjacency_never_crosses_trace_id_test() ->
    %% Two traces interleaved on the clock (the PI3 cross-case shape, now
    %% intra-span): consecutive RAW arrivals belong to different traces.
    %% Neither arm may emit auth -> orders or orders -> users.
    Spans = [root_span(<<"r1">>, <<"gateway">>, <<"t1">>, <<"2026-09-05T10:00:00.000Z">>),
             root_span(<<"r2">>, <<"auth">>, <<"t2">>, <<"2026-09-05T10:00:00.005Z">>),
             span(<<"s1">>, <<"orders">>, <<"r1">>, <<"t1">>, <<"2026-09-05T10:00:00.010Z">>),
             span(<<"s2">>, <<"users">>, <<"r2">>, <<"t2">>, <<"2026-09-05T10:00:00.015Z">>)],
    {ok, Ev} = beam4pm_discovery:causal_dfg_from_spans(Spans),
    ?assertEqual([{<<"auth">>, <<"users">>, 1, parent_child_link},
                  {<<"gateway">>, <<"orders">>, 1, parent_child_link}],
                 edge_tuples(maps:get(observed, Ev))),
    ?assertEqual([{<<"auth">>, <<"users">>, 1, temporal_adjacency},
                  {<<"gateway">>, <<"orders">>, 1, temporal_adjacency}],
                 edge_tuples(maps:get(adjacent, Ev))),
    ?assertEqual([], maps:get(inferred_only, Ev)),
    ?assertEqual([], maps:get(observed_not_adjacent, Ev)),
    ?assertEqual([], maps:get(orphans, Ev)).
