%% GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
%%
%% EUnit court for beam4pm_discovery, run against a seeded known log.
%% Admitted bpm:RecordType graph size: {{ records | length }} record types
%% (ocel_event carries {{ fields | filter(attribute="record_name", value="ocel_event") | length }} admitted fields).

-module(beam4pm_discovery_tests).

-include_lib("eunit/include/eunit.hrl").

%% No explicit -export: EUnit's parse transform auto-exports *_test/0.

%% Seeded known log: 8 ocel_events, 3 cases keyed by attribute <<"case_id">>,
%% deliberately unsorted input with interleaved timestamps:
%%   c1: e1 a @10:00:00, e3 b @10:01:00, e5 c @10:02:00      -> [a, b, c]
%%   c2: e2 a @10:01:30, e4 b @10:01:30 (id tie-break)       -> [a, b]
%%   c3: e6 a @10:03:00                                      -> [a]
%%   e7 x @10:04:00 has attributes but no case_id key        -> skipped
%%   e8 y @10:05:00 has attributes = undefined               -> skipped
seed_events() ->
    [ev(<<"e5">>, <<"c">>, <<"2026-08-29T10:02:00Z">>, #{<<"case_id">> => <<"c1">>}),
     ev(<<"e4">>, <<"b">>, <<"2026-08-29T10:01:30Z">>, #{<<"case_id">> => <<"c2">>}),
     ev(<<"e1">>, <<"a">>, <<"2026-08-29T10:00:00Z">>, #{<<"case_id">> => <<"c1">>}),
     ev(<<"e7">>, <<"x">>, <<"2026-08-29T10:04:00Z">>, #{<<"other">> => <<"v">>}),
     ev(<<"e2">>, <<"a">>, <<"2026-08-29T10:01:30Z">>, #{<<"case_id">> => <<"c2">>}),
     ev(<<"e6">>, <<"a">>, <<"2026-08-29T10:03:00Z">>, #{<<"case_id">> => <<"c3">>}),
     ev(<<"e3">>, <<"b">>, <<"2026-08-29T10:01:00Z">>, #{<<"case_id">> => <<"c1">>}),
     ev_no_attributes(<<"e8">>, <<"y">>, <<"2026-08-29T10:05:00Z">>)].

ev(Id, Type, Time, Attributes) ->
    {ok, Ev} = beam4pm_types:new_ocel_event(
        #{event_id => Id, event_type => Type, event_time => Time,
          attributes => Attributes}),
    Ev.

ev_no_attributes(Id, Type, Time) ->
    {ok, Ev} = beam4pm_types:new_ocel_event(
        #{event_id => Id, event_type => Type, event_time => Time}),
    Ev.

trace(CaseId, Seq) ->
    {ok, Trace} = beam4pm_types:new_log_trace(
        #{case_id => CaseId, activity_sequence => Seq}),
    Trace.

traces_exact_test() ->
    Traces = beam4pm_discovery:traces_from_events(seed_events(), <<"case_id">>),
    ?assertEqual(3, length(Traces)),
    [T1, T2, T3] = Traces,
    ?assertEqual(<<"c1">>, beam4pm_discovery:log_trace_case_id(T1)),
    ?assertEqual([<<"a">>, <<"b">>, <<"c">>],
                 beam4pm_discovery:log_trace_activity_sequence(T1)),
    ?assertEqual(<<"c2">>, beam4pm_discovery:log_trace_case_id(T2)),
    ?assertEqual([<<"a">>, <<"b">>],
                 beam4pm_discovery:log_trace_activity_sequence(T2)),
    ?assertEqual(<<"c3">>, beam4pm_discovery:log_trace_case_id(T3)),
    ?assertEqual([<<"a">>],
                 beam4pm_discovery:log_trace_activity_sequence(T3)).

missing_case_attribute_skipped_test() ->
    %% e7 (attributes map without the key) and e8 (attributes undefined) are
    %% skipped: only 3 traces exist for 8 events and no trace carries x or y.
    Traces = beam4pm_discovery:traces_from_events(seed_events(), <<"case_id">>),
    ?assertEqual(3, length(Traces)),
    AllActivities = lists:append(
        [beam4pm_discovery:log_trace_activity_sequence(T) || T <- Traces]),
    ?assertNot(lists:member(<<"x">>, AllActivities)),
    ?assertNot(lists:member(<<"y">>, AllActivities)).

dfg_exact_test() ->
    Traces = beam4pm_discovery:traces_from_events(seed_events(), <<"case_id">>),
    Edges = beam4pm_discovery:dfg_from_traces(Traces),
    ?assertEqual(
        [{<<"a">>, <<"b">>, 2},
         {<<"b">>, <<"c">>, 1}],
        [{beam4pm_discovery:dfg_edge_source_activity(E),
          beam4pm_discovery:dfg_edge_target_activity(E),
          beam4pm_discovery:dfg_edge_frequency(E)} || E <- Edges]).

conformance_fitting_trace_test() ->
    Traces = beam4pm_discovery:traces_from_events(seed_events(), <<"case_id">>),
    Edges = beam4pm_discovery:dfg_from_traces(Traces),
    [T1 | _] = Traces,
    Result = beam4pm_discovery:conformance(Edges, T1),
    ?assertEqual(<<"c1">>, beam4pm_discovery:conformance_result_trace_id(Result)),
    ?assertEqual(1.0, beam4pm_discovery:conformance_result_fitness(Result)),
    %% By hand: model out-degrees a=1 (only ->b), b=1 (only ->c). Trace
    %% ["a","b","c"] takes both known edges as the ONLY enabled option at
    %% each step -> zero escaping edges -> precision=1.0 (BeamPM.Precision's
    %% ETC score, adapted from ex4pm's real Ex4pmEngine.ETCPrecision).
    ?assertEqual(1.0,
                 beam4pm_discovery:conformance_result_precision(Result)).

conformance_half_fitting_trace_test() ->
    Traces = beam4pm_discovery:traces_from_events(seed_events(), <<"case_id">>),
    Edges = beam4pm_discovery:dfg_from_traces(Traces),
    %% Pairs (a,b) present and (b,z) absent from the model -> 1 of 2 -> 0.5.
    Half = trace(<<"t_half">>, [<<"a">>, <<"b">>, <<"z">>]),
    Result = beam4pm_discovery:conformance(Edges, Half),
    ?assertEqual(<<"t_half">>,
                 beam4pm_discovery:conformance_result_trace_id(Result)),
    ?assertEqual(0.5, beam4pm_discovery:conformance_result_fitness(Result)).

conformance_single_activity_trace_test() ->
    Traces = beam4pm_discovery:traces_from_events(seed_events(), <<"case_id">>),
    Edges = beam4pm_discovery:dfg_from_traces(Traces),
    Single = lists:last(Traces),
    ?assertEqual([<<"a">>],
                 beam4pm_discovery:log_trace_activity_sequence(Single)),
    Result = beam4pm_discovery:conformance(Edges, Single),
    ?assertEqual(<<"c3">>, beam4pm_discovery:conformance_result_trace_id(Result)),
    ?assertEqual(1.0, beam4pm_discovery:conformance_result_fitness(Result)).
