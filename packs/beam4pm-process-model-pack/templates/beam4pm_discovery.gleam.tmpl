// The fixed cross-language Discovery API ({{ records | length }} admitted record
// types in the graph; this module consumes OcelEvent and ServiceSpan and
// produces LogTrace, DfgEdge, ConformanceResult, ProcessVariant and SpanEdge).
// Same semantics as the Erlang beam4pm_discovery and Elixir BeamPM.Discovery
// projections:
//   - traces_from_events: case id read from the event attributes map at
//     case_attr_key; events without that key are skipped; per case, events
//     sorted by event_time (lexicographic ISO8601), ties broken by event_id;
//     result sorted by case_id.
//   - dfg_from_traces: count adjacent (a, b) pairs across all traces'
//     activity_sequence; result sorted by source_activity then
//     target_activity.
//   - conformance: trace_id = the trace's case_id; fitness = fraction of the
//     trace's adjacent pairs present in the edge set (1.0 for traces with
//     fewer than 2 activities); precision is beam4pm/precision's ETC
//     (escaping-edge) score for the same trace against the same edge set
//     (see that module for the exact formula and its provenance).
//   - traces_from_spans: one LogTrace per trace_id, activity_sequence = the
//     spans' service_name values sorted by start_time then span_id;
//     parent_span_id is never read (the temporal-adjacency reading).
//   - causal_dfg_from_spans: OpenTelemetry parent/child (invocation)
//     causality as SpanEdge records tagged "parent_child_link", side by side
//     with the temporal-adjacency SpanEdge records ("temporal_adjacency") the
//     same spans yield, plus both differences and the orphan list. The
//     evidence tag is the atom the Erlang/Elixir projections carry, rendered
//     here as the same String the JSON codec puts on the wire. Typed refusals
//     DuplicateSpanId / ParentInOtherTrace match the Erlang/Elixir
//     {error, {duplicate_span_id, Id}} / {error, {parent_in_other_trace, Id}}.
// All outputs are constructed through the generated types in beam4pm/types.

import beam4pm/precision
import beam4pm/types
import gleam/dict
import gleam/int
import gleam/list
import gleam/option
import gleam/order
import gleam/result
import gleam/set
import gleam/string

/// Group OCEL events into case-centric traces, reading the case id from each
/// event's attributes map at `case_attr_key`. Events without that key (or
/// with no attributes at all) are skipped.
pub fn traces_from_events(
  events: List(types.OcelEvent),
  case_attr_key: String,
) -> List(types.LogTrace) {
  let keyed =
    list.filter_map(events, fn(event) {
      case event.attributes {
        option.Some(attrs) ->
          case dict.get(attrs, case_attr_key) {
            Ok(case_id) -> Ok(#(case_id, event))
            Error(Nil) -> Error(Nil)
          }
        option.None -> Error(Nil)
      }
    })
  let by_case =
    list.fold(keyed, dict.new(), fn(acc, pair) {
      let #(case_id, event) = pair
      dict.upsert(acc, case_id, fn(existing) {
        case existing {
          option.Some(events_so_far) -> [event, ..events_so_far]
          option.None -> [event]
        }
      })
    })
  by_case
  |> dict.to_list
  |> list.sort(fn(a, b) { string.compare(a.0, b.0) })
  |> list.map(fn(entry) {
    let #(case_id, case_events) = entry
    let ordered =
      list.sort(case_events, fn(x, y) {
        order.break_tie(
          string.compare(x.event_time, y.event_time),
          string.compare(x.event_id, y.event_id),
        )
      })
    types.LogTrace(
      case_id: case_id,
      activity_sequence: list.map(ordered, fn(event) { event.event_type }),
    )
  })
}

/// Discover the frequency-annotated directly-follows graph from traces.
pub fn dfg_from_traces(traces: List(types.LogTrace)) -> List(types.DfgEdge) {
  traces
  |> list.flat_map(fn(trace) { list.window_by_2(trace.activity_sequence) })
  |> list.fold(dict.new(), fn(acc, pair) {
    dict.upsert(acc, pair, fn(existing) {
      case existing {
        option.Some(n) -> n + 1
        option.None -> 1
      }
    })
  })
  |> dict.to_list
  |> list.sort(fn(a, b) {
    let #(#(source_a, target_a), _) = a
    let #(#(source_b, target_b), _) = b
    order.break_tie(
      string.compare(source_a, source_b),
      string.compare(target_a, target_b),
    )
  })
  |> list.map(fn(entry) {
    let #(#(source, target), frequency) = entry
    types.DfgEdge(
      source_activity: source,
      target_activity: target,
      frequency: frequency,
    )
  })
}

/// Check one trace against a discovered edge set. Fitness is the fraction of
/// the trace's adjacent activity pairs present in the edge set; a trace with
/// fewer than 2 activities has fitness 1.0. Precision is `beam4pm/precision`'s
/// ETC (escaping-edge) score for the same trace against the same edge set.
pub fn conformance(
  edges: List(types.DfgEdge),
  trace: types.LogTrace,
) -> types.ConformanceResult {
  let edge_set =
    edges
    |> list.map(fn(edge) { #(edge.source_activity, edge.target_activity) })
    |> set.from_list
  let pairs = list.window_by_2(trace.activity_sequence)
  let fitness = case pairs {
    [] -> 1.0
    _ -> {
      let total = list.length(pairs)
      let matched =
        pairs
        |> list.filter(fn(pair) { set.contains(edge_set, pair) })
        |> list.length
      int.to_float(matched) /. int.to_float(total)
    }
  }
  types.ConformanceResult(
    trace_id: trace.case_id,
    fitness: fitness,
    precision: option.Some(precision.etc_precision(edges, trace)),
  )
}

/// Group traces into distinct activity-sequence variants, each annotated
/// with the number of traces observed with exactly that sequence. Mirrors
/// `dfg_from_traces`'s counting shape (fold into a dict keyed by the
/// distinguishing feature, then sort for a deterministic result), but keyed
/// by the whole activity_sequence rather than adjacent pairs. Sorted by
/// activity_sequence for a deterministic result; variant_id is the 1-based
/// rank in that sorted order, stringified.
pub fn variants_from_traces(
  traces: List(types.LogTrace),
) -> List(types.ProcessVariant) {
  traces
  |> list.map(fn(trace) { trace.activity_sequence })
  |> list.fold(dict.new(), fn(acc, sequence) {
    dict.upsert(acc, sequence, fn(existing) {
      case existing {
        option.Some(n) -> n + 1
        option.None -> 1
      }
    })
  })
  |> dict.to_list
  |> list.sort(fn(a, b) {
    string.compare(string.join(a.0, "\u{0}"), string.join(b.0, "\u{0}"))
  })
  |> list.index_map(fn(entry, index) {
    let #(sequence, frequency) = entry
    types.ProcessVariant(
      variant_id: int.to_string(index + 1),
      activity_sequence: sequence,
      frequency: frequency,
    )
  })
}
