// GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
//
// The fixed cross-language Discovery API ({{ records | length }} admitted record
// types in the graph; this module consumes OcelEvent and produces LogTrace,
// DfgEdge and ConformanceResult). Same semantics as the Erlang
// beam4pm_discovery and Elixir BeamPM.Discovery projections:
//   - traces_from_events: case id read from the event attributes map at
//     case_attr_key; events without that key are skipped; per case, events
//     sorted by event_time (lexicographic ISO8601), ties broken by event_id;
//     result sorted by case_id.
//   - dfg_from_traces: count adjacent (a, b) pairs across all traces'
//     activity_sequence; result sorted by source_activity then
//     target_activity.
//   - conformance: trace_id = the trace's case_id; fitness = fraction of the
//     trace's adjacent pairs present in the edge set (1.0 for traces with
//     fewer than 2 activities); precision honestly not computed in this
//     slice (option.None).
// All outputs are constructed through the generated types in beam4pm/types.

import beam4pm/types
import gleam/dict
import gleam/int
import gleam/list
import gleam/option
import gleam/order
import gleam/set
import gleam/string

/// Group OCEL events into case-centric traces, reading the case id from each
/// event's attributes map at `case_attr_key`. Events without that key (or
/// with no attributes at all) are skipped.
pub fn traces_from_events(
  events: List(types.OcelEvent),
  case_attr_key: String,
) -> List(types.LogTrace) {
  let keyed =
    list.filter_map(events, fn(event) {
      case event.attributes {
        option.Some(attrs) ->
          case dict.get(attrs, case_attr_key) {
            Ok(case_id) -> Ok(#(case_id, event))
            Error(Nil) -> Error(Nil)
          }
        option.None -> Error(Nil)
      }
    })
  let by_case =
    list.fold(keyed, dict.new(), fn(acc, pair) {
      let #(case_id, event) = pair
      dict.upsert(acc, case_id, fn(existing) {
        case existing {
          option.Some(events_so_far) -> [event, ..events_so_far]
          option.None -> [event]
        }
      })
    })
  by_case
  |> dict.to_list
  |> list.sort(fn(a, b) { string.compare(a.0, b.0) })
  |> list.map(fn(entry) {
    let #(case_id, case_events) = entry
    let ordered =
      list.sort(case_events, fn(x, y) {
        order.break_tie(
          string.compare(x.event_time, y.event_time),
          string.compare(x.event_id, y.event_id),
        )
      })
    types.LogTrace(
      case_id: case_id,
      activity_sequence: list.map(ordered, fn(event) { event.event_type }),
    )
  })
}

/// Discover the frequency-annotated directly-follows graph from traces.
pub fn dfg_from_traces(traces: List(types.LogTrace)) -> List(types.DfgEdge) {
  traces
  |> list.flat_map(fn(trace) { list.window_by_2(trace.activity_sequence) })
  |> list.fold(dict.new(), fn(acc, pair) {
    dict.upsert(acc, pair, fn(existing) {
      case existing {
        option.Some(n) -> n + 1
        option.None -> 1
      }
    })
  })
  |> dict.to_list
  |> list.sort(fn(a, b) {
    let #(#(source_a, target_a), _) = a
    let #(#(source_b, target_b), _) = b
    order.break_tie(
      string.compare(source_a, source_b),
      string.compare(target_a, target_b),
    )
  })
  |> list.map(fn(entry) {
    let #(#(source, target), frequency) = entry
    types.DfgEdge(
      source_activity: source,
      target_activity: target,
      frequency: frequency,
    )
  })
}

/// Check one trace against a discovered edge set. Fitness is the fraction of
/// the trace's adjacent activity pairs present in the edge set; a trace with
/// fewer than 2 activities has fitness 1.0. Precision is honestly not
/// computed in this slice (option.None).
pub fn conformance(
  edges: List(types.DfgEdge),
  trace: types.LogTrace,
) -> types.ConformanceResult {
  let edge_set =
    edges
    |> list.map(fn(edge) { #(edge.source_activity, edge.target_activity) })
    |> set.from_list
  let pairs = list.window_by_2(trace.activity_sequence)
  let fitness = case pairs {
    [] -> 1.0
    _ -> {
      let total = list.length(pairs)
      let matched =
        pairs
        |> list.filter(fn(pair) { set.contains(edge_set, pair) })
        |> list.length
      int.to_float(matched) /. int.to_float(total)
    }
  }
  types.ConformanceResult(
    trace_id: trace.case_id,
    fitness: fitness,
    precision: option.None,
  )
}
