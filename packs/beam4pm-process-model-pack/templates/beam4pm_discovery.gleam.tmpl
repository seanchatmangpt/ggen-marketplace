/// The two evidence classes over one span set, plus both of their
/// differences (see `causal_dfg_from_spans`). Every list is sorted by
/// (source_service, target_service); orphans by (span_id, parent_span_id).
pub type SpanEvidence {
  SpanEvidence(
    /// evidence "parent_child_link": one edge per distinct (parent
    /// service_name, child service_name); frequency = link count.
    observed: List(types.SpanEdge),
    /// evidence "temporal_adjacency": traces_from_spans -> dfg_from_traces,
    /// re-tagged; frequency = consecutive start_time pair count over traces.
    adjacent: List(types.SpanEdge),
    /// adjacent edges no parent/child link supports: what adjacency invented.
    inferred_only: List(types.SpanEdge),
    /// observed edges adjacency never produced: causality adjacency cannot see.
    observed_not_adjacent: List(types.SpanEdge),
    /// (span_id, parent_span_id) for every span whose parent is absent from
    /// the input. Never an edge, never dropped; the span stays in the
    /// adjacency arm so "no evidence" is distinguishable from "invented".
    orphans: List(#(String, String)),
  )
}

/// Typed refusals of `causal_dfg_from_spans`, never silent.
pub type SpanEvidenceError {
  /// The same span_id appears twice (an index would last-write-win).
  DuplicateSpanId(String)
  /// The named child's parent lives in a different trace_id (links never
  /// cross traces; the trace is malformed).
  ParentInOtherTrace(String)
}

/// The temporal-adjacency reading of tracing spans: one LogTrace per
/// trace_id (case_id = trace_id), activity_sequence = service_name values
/// ordered by start_time then span_id. parent_span_id is never read here.
pub fn traces_from_spans(
  spans: List(types.ServiceSpan),
) -> List(types.LogTrace) {
  let by_trace =
    list.fold(spans, dict.new(), fn(acc, span) {
      dict.upsert(acc, span.trace_id, fn(existing) {
        case existing {
          option.Some(spans_so_far) -> [span, ..spans_so_far]
          option.None -> [span]
        }
      })
    })
  by_trace
  |> dict.to_list
  |> list.sort(fn(a, b) { string.compare(a.0, b.0) })
  |> list.map(fn(entry) {
    let #(trace_id, trace_spans) = entry
    let ordered =
      list.sort(trace_spans, fn(x, y) {
        order.break_tie(
          string.compare(x.start_time, y.start_time),
          string.compare(x.span_id, y.span_id),
        )
      })
    types.LogTrace(
      case_id: trace_id,
      activity_sequence: list.map(ordered, fn(span) { span.service_name }),
    )
  })
}

/// OpenTelemetry parent/child (invocation) causality over ServiceSpan
/// records, side by side with the temporal-adjacency edges the same spans
/// yield. NOT directly-follows and NOT the OpenTelemetry `links` field: the
/// edges are SpanEdge records carrying their evidence tag, never DfgEdge.
/// Root spans (parent_span_id None) contribute no incoming edge. The two
/// edge sets are not nested: for a root p with concurrent children s1, s2
/// (s1 starting first) adjacency yields p->s1, s1->s2 while links yield
/// p->s1, p->s2 -- s1->s2 is inferred_only and p->s2 is
/// observed_not_adjacent, and both are returned.
pub fn causal_dfg_from_spans(
  spans: List(types.ServiceSpan),
) -> Result(SpanEvidence, SpanEvidenceError) {
  use index <- result.try(index_spans(spans))
  use linked <- result.try(link_spans(spans, index))
  let #(link_counts, orphans) = linked
  let observed = span_edges(link_counts, "parent_child_link")
  let adjacent =
    spans
    |> traces_from_spans
    |> dfg_from_traces
    |> list.map(adjacency_edge)
  let observed_pairs = set.from_list(list.map(observed, edge_pair))
  let adjacent_pairs = set.from_list(list.map(adjacent, edge_pair))
  Ok(SpanEvidence(
    observed: observed,
    adjacent: adjacent,
    inferred_only:
      list.filter(adjacent, fn(edge) {
        !set.contains(observed_pairs, edge_pair(edge))
      }),
    observed_not_adjacent:
      list.filter(observed, fn(edge) {
        !set.contains(adjacent_pairs, edge_pair(edge))
      }),
    orphans:
      list.sort(orphans, fn(a, b) {
        order.break_tie(string.compare(a.0, b.0), string.compare(a.1, b.1))
      }),
  ))
}

// span_id -> span, refusing a duplicate id instead of overwriting it.
fn index_spans(
  spans: List(types.ServiceSpan),
) -> Result(dict.Dict(String, types.ServiceSpan), SpanEvidenceError) {
  list.try_fold(spans, dict.new(), fn(index, span) {
    case dict.has_key(index, span.span_id) {
      True -> Error(DuplicateSpanId(span.span_id))
      False -> Ok(dict.insert(index, span.span_id, span))
    }
  })
}

// Fold parent/child links into a (source, target) -> count dict, collecting
// orphans and refusing a cross-trace parent.
fn link_spans(
  spans: List(types.ServiceSpan),
  index: dict.Dict(String, types.ServiceSpan),
) -> Result(
  #(dict.Dict(#(String, String), Int), List(#(String, String))),
  SpanEvidenceError,
) {
  list.try_fold(spans, #(dict.new(), []), fn(acc, span) {
    let #(counts, orphans) = acc
    case span.parent_span_id {
      option.None -> Ok(acc)
      option.Some(parent_id) ->
        case dict.get(index, parent_id) {
          Error(Nil) -> Ok(#(counts, [#(span.span_id, parent_id), ..orphans]))
          Ok(parent) ->
            case parent.trace_id == span.trace_id {
              False -> Error(ParentInOtherTrace(span.span_id))
              True -> {
                let pair = #(parent.service_name, span.service_name)
                let bumped =
                  dict.upsert(counts, pair, fn(existing) {
                    case existing {
                      option.Some(n) -> n + 1
                      option.None -> 1
                    }
                  })
                Ok(#(bumped, orphans))
              }
            }
        }
    }
  })
}

// Counting dict -> sorted SpanEdge list carrying `evidence`.
fn span_edges(
  counts: dict.Dict(#(String, String), Int),
  evidence: String,
) -> List(types.SpanEdge) {
  counts
  |> dict.to_list
  |> list.sort(fn(a, b) {
    let #(#(source_a, target_a), _) = a
    let #(#(source_b, target_b), _) = b
    order.break_tie(
      string.compare(source_a, source_b),
      string.compare(target_a, target_b),
    )
  })
  |> list.map(fn(entry) {
    let #(#(source, target), frequency) = entry
    types.SpanEdge(
      source_service: source,
      target_service: target,
      frequency: frequency,
      evidence: evidence,
    )
  })
}

// A DfgEdge from the adjacency arm, re-tagged as what it is.
fn adjacency_edge(edge: types.DfgEdge) -> types.SpanEdge {
  types.SpanEdge(
    source_service: edge.source_activity,
    target_service: edge.target_activity,
    frequency: edge.frequency,
    evidence: "temporal_adjacency",
  )
}

fn edge_pair(edge: types.SpanEdge) -> #(String, String) {
  #(edge.source_service, edge.target_service)
}
