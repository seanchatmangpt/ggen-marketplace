---
to: "lib/beam4pm_{{ engine_name }}.ex"
sparql:
  engines: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?engine_module ?engine_doc ?ordinal ?export_prefix ?wasm_artifact
           ?wasm_build_script ?wasm_build_hint ?dispatch_source ?health_id ?handle_noun
           ?cheap_timeout ?heavy_timeout ?error_collapse WHERE {
      ?e a bpm:Engine ;
         bpm:engineName ?engine_name ;
         bpm:engineModule ?engine_module ;
         bpm:engineDoc ?engine_doc ;
         bpm:engineOrdinal ?ordinal ;
         bpm:wasmExportPrefix ?export_prefix ;
         bpm:wasmArtifactPath ?wasm_artifact ;
         bpm:wasmBuildScript ?wasm_build_script ;
         bpm:dispatchSource ?dispatch_source ;
         bpm:healthId ?health_id ;
         bpm:handleNoun ?handle_noun ;
         bpm:cheapTimeoutMs ?cheap_timeout ;
         bpm:errorCollapse ?ec .
      ?ec a bpm:ErrorCollapse ; bpm:errorCollapseName ?error_collapse .
      OPTIONAL { ?e bpm:heavyTimeoutMs ?heavy_opt }
      OPTIONAL { ?e bpm:wasmBuildHint ?hint_opt }
      BIND(COALESCE(?heavy_opt, "-") AS ?heavy_timeout)
      BIND(COALESCE(?hint_opt, "-") AS ?wasm_build_hint)
    } ORDER BY ?ordinal
  ops: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?op_key ?op_name ?elixir_name ?op_order ?op_doc ?timeout_class ?op_kind
           ?wire_name ?predicate ?delegates_to ?expose_erlang ?expose_gleam WHERE {
      ?op a bpm:EngineOp ;
          bpm:opEngine ?e ;
          bpm:opName ?op_name ;
          bpm:opOrder ?op_order ;
          bpm:opDoc ?op_doc ;
          bpm:opTimeoutClass ?tc ;
          bpm:opKind ?k .
      ?e a bpm:Engine ; bpm:engineName ?engine_name .
      ?tc a bpm:TimeoutClass ; bpm:timeoutClassName ?timeout_class .
      ?k a bpm:EngineOpKind ; bpm:engineOpKindName ?op_kind .
      OPTIONAL { ?op bpm:opWireName ?wire_opt }
      OPTIONAL { ?op bpm:opElixirPredicate ?pred_opt }
      OPTIONAL { ?op bpm:opDelegatesTo ?target . ?target bpm:opName ?target_name }
      OPTIONAL { ?op bpm:opExposeErlang ?erl_opt }
      OPTIONAL { ?op bpm:opExposeGleam ?gleam_opt }
      BIND(CONCAT(?engine_name, "/", ?op_name) AS ?op_key)
      BIND(COALESCE(?wire_opt, ?op_name) AS ?wire_name)
      BIND(COALESCE(?pred_opt, "false") AS ?predicate)
      BIND(COALESCE(?target_name, "-") AS ?delegates_to)
      BIND(COALESCE(?erl_opt, "true") AS ?expose_erlang)
      BIND(COALESCE(?gleam_opt, "true") AS ?expose_gleam)
      BIND(IF(?predicate = "true", CONCAT(?op_name, "?"), ?op_name) AS ?elixir_name)
    } ORDER BY ?engine_name ?op_order
  args: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?op_key ?arg_name ?arg_order ?wire_key ?type_name ?elixir_type ?erlang_type
           ?gleam_type ?elixir_guard ?encoding ?mode ?arg_default ?positional ?extra ?guarded ?inline WHERE {
      ?a a bpm:EngineArg ;
         bpm:argOp ?op ;
         bpm:argName ?arg_name ;
         bpm:argOrder ?arg_order ;
         bpm:argType ?t .
      ?op a bpm:EngineOp ; bpm:opEngine ?e ; bpm:opName ?op_name .
      ?e a bpm:Engine ; bpm:engineName ?engine_name .
      ?t a bpm:EngineArgType ;
         bpm:argTypeName ?type_name ;
         bpm:argElixirType ?elixir_type ;
         bpm:argErlangType ?erlang_type ;
         bpm:argGleamType ?gleam_type .
      OPTIONAL { ?t bpm:argElixirGuard ?guard_opt }
      OPTIONAL { ?a bpm:argWireKey ?wk_opt }
      OPTIONAL { ?a bpm:argEncoding ?enc . ?enc a bpm:ArgEncoding ; bpm:argEncodingName ?enc_name }
      OPTIONAL { ?a bpm:argMode ?m . ?m a bpm:ArgMode ; bpm:argModeName ?mode_name }
      OPTIONAL { ?a bpm:argDefault ?def_opt }
      BIND(CONCAT(?engine_name, "/", ?op_name) AS ?op_key)
      BIND(COALESCE(?wk_opt, ?arg_name) AS ?wire_key)
      BIND(COALESCE(?guard_opt, "-") AS ?elixir_guard)
      BIND(COALESCE(?enc_name, "passthrough") AS ?encoding)
      BIND(COALESCE(?mode_name, "required") AS ?mode)
      BIND(COALESCE(?def_opt, "-") AS ?arg_default)
      BIND(IF(?mode = "keyword", "false", "true") AS ?positional)
      BIND(IF(?mode = "required", "false", "true") AS ?extra)
      BIND(IF(?positional = "true" && ?elixir_guard != "-", "true", "false") AS ?guarded)
      BIND(IF(?encoding = "omit_when_nil" || ?encoding = "merge_map", "false", "true") AS ?inline)
    } ORDER BY ?op_key ?arg_order
for_each: engines
---
{%- set eops = ops | filter(attribute="engine_name", value=engine_name) %}
{%- set eargs = args | filter(attribute="engine_name", value=engine_name) %}
{%- set heavy_ops = eops | filter(attribute="timeout_class", value="heavy") %}
{%- set omit_args = eargs | filter(attribute="encoding", value="omit_when_nil") %}
{%- set module = "BeamPM." ~ engine_module -%}
# GENERATED by ggen from the admitted bpm:Engine graph ({{ engine_name }}). Do not edit.
defmodule {{ module }} do
  @moduledoc ~S"""
  BEAM-side wrapper over the `{{ engine_name }}` native engine, compiled to
  `wasm32-wasip1` and hosted inside this VM by wasmex as ONE named engine
  instance. {{ engine_doc }}

  This module -- and the Erlang facade `beam4pm_{{ engine_name }}` and the Gleam
  facade `beam4pm/{{ engine_name }}` that delegate to it 1:1 -- only frames JSON
  requests and unpacks JSON responses; every algorithm runs INSIDE the wasm
  module. All three files are rendered by ggen from the admitted `bpm:Engine`
  / `bpm:EngineOp` / `bpm:EngineArg` facts: the engine's surface is ontology,
  the wasmex hosting below is template, identical for every engine.

  ## Wire contract (linear-memory JSON ABI)

  The wasm module exports `{{ export_prefix }}_alloc(len) -> ptr`,
  `{{ export_prefix }}_call(ptr, len) -> packed_u64` (the response buffer packed
  as `(out_ptr << 32) | out_len`) and `{{ export_prefix }}_dealloc(ptr, len)`.
  Per call (`call/2` below): JSON-encode the request map; `{{ export_prefix }}_alloc`
  through the same exit-guarded path as the op itself (its own execution is
  microseconds, but a concurrent long op holds the single store-executor
  queue); normalize the i32-as-signed pointer and refuse a null pointer
  rather than write at offset 0; write the bytes (freeing the request buffer
  best-effort if the write fails); `{{ export_prefix }}_call`; normalize the
  packed u64 (wasmex delivers it as a signed i64) and split ptr/len; read the
  response; `{{ export_prefix }}_dealloc` the RESPONSE buffer only --
  `{{ export_prefix }}_call` consumes and frees the request buffer itself, so a
  host-side dealloc of it would be a double free; JSON-decode.

  A call exit or timeout STOPS AND DISCARDS the engine and returns
  `{:error, {:wasmex, {:engine_restarted, _}}}`: the guest builds with
  `panic = "abort"`, so a trap mid-compute may abandon guest state that cannot
  be safely reused. Every {{ handle_noun }} handle is invalidated and the next
  `start/0` builds a fresh instance. Never pass `:infinity` as a timeout.

  ## Ops

  One public function per admitted `bpm:EngineOp`, each taking a trailing
  `opts` keyword list (`:timeout` overrides the op's default budget):
{% for op in eops %}
{%- set oargs = eargs | filter(attribute="op_key", value=op.op_key) %}
{%- set positional = oargs | filter(attribute="positional", value="true") %}
{%- set n = positional | length %}
  `{{ op.elixir_name }}/{{ n + 1 }}`{% if op.op_kind == "host_helper" %} (host-side `File.read!/1`, then `{{ op.delegates_to }}`){% endif %}{% if not loop.last %},{% endif %}
{%- endfor %}

  ## Process model and crash semantics

  ONE named Wasmex GenServer (`{{ module }}.Engine`) serves all callers; it
  never blocks during wasm execution and the underlying store executor
  serializes ops in submission order, so concurrent BEAM callers are safe.
  A restart yields a fresh store and invalidates every handle. WASI options
  are the defaults (content is passed by value, no preopens). Degradation
  when the wasm artifact is absent is a NAMED reason (`wasm_built?/0`,
  `wasm_missing_reason/0`), never a fake.
  """

  import Bitwise

  @engine_name {{ module }}.Engine
  @pt_key {__MODULE__, :engine_handles}

  @wasm_rel "{{ wasm_artifact }}"
{% if heavy_ops | length > 0 %}
  @heavy_timeout {{ heavy_timeout }}
{%- endif %}
  @cheap_timeout {{ cheap_timeout }}

  @typedoc "Decoded string-keyed JSON response from the engine."
  @type resp :: map()

  @typedoc """
  `{:engine, msg}` = the wasm engine returned an error response;
  `{:wasmex, term}` = a host-level failure (engine not started, wasmex
  call/alloc/write failure, or a call timeout/exit).
  """
  @type err :: {:engine, String.t()} | {:wasmex, term()}

  @type result :: {:ok, resp()} | {:error, err()}

  # ---------------------------------------------------------------------
  # Engine lifecycle
  # ---------------------------------------------------------------------

  @doc "Repo-root-relative wasm artifact path, expanded."
  @spec wasm_path() :: String.t()
  def wasm_path, do: Path.expand(@wasm_rel)

  @doc "Whether the wasm engine artifact has been built."
  @spec wasm_built?() :: boolean()
  def wasm_built?, do: File.exists?(wasm_path())

  @doc "Named reason used by the tests' skip tag when the wasm artifact is absent."
  @spec wasm_missing_reason() :: String.t()
  def wasm_missing_reason do
    "{{ wasm_artifact | split(pat="/") | last }} not built at #{wasm_path()} -- run " <>
      "{{ wasm_build_script }} first{% if wasm_build_hint != "-" %} {{ wasm_build_hint }}{% endif %}, and run mix test from the " <>
      "project root"
  end

  @doc """
  Starts (or reuses) the one named engine instance. Idempotent:
  `{:error, {:already_started, pid}}` is normalized to `{:ok, pid}`.
  Restarting after a crash yields a fresh store -- every handle previously
  returned by this engine is invalid afterwards.
  """
  @spec start() :: {:ok, pid()} | {:error, term()}
  def start do
    case start_link_raw() do
      {:ok, pid} ->
        _ = handles!(pid)
        {:ok, pid}

      {:error, {:already_started, pid}} ->
        {:ok, pid}

      other ->
        other
    end
  end

  @doc """
  Raw `Wasmex.start_link/1` under the engine name -- the `child_spec/1`
  start function for use in a supervision tree. Prefer `start/0` for
  direct/test use.
  """
  @spec start_link_raw() :: {:ok, pid()} | {:error, term()}
  def start_link_raw do
    Wasmex.start_link(%{
      bytes: File.read!(wasm_path()),
      wasi: %Wasmex.Wasi.WasiOptions{},
      name: @engine_name
    })
  end

  @doc "Supervision-tree shim (not auto-installed; beam4pm has no Application module)."
  @spec child_spec(term()) :: Supervisor.child_spec()
  def child_spec(_opts) do
    %{
      id: @engine_name,
      start: {__MODULE__, :start_link_raw, []},
      restart: :permanent,
      type: :worker
    }
  end

  # ---------------------------------------------------------------------
  # Ops -- one per admitted bpm:EngineOp, in bpm:opOrder
  # ---------------------------------------------------------------------
{%- for op in eops %}
{%- set oargs = eargs | filter(attribute="op_key", value=op.op_key) %}
{%- set positional = oargs | filter(attribute="positional", value="true") %}
{%- set guarded = oargs | filter(attribute="guarded", value="true") %}
{%- set inline_args = oargs | filter(attribute="inline", value="true") %}
{%- set pipe_args = oargs | filter(attribute="inline", value="false") %}

  @doc ~S"""
  {{ op.op_doc }}
  """
  @spec {{ op.elixir_name }}({% for a in positional %}{{ a.elixir_type }}, {% endfor %}keyword()) :: result()
  def {{ op.elixir_name }}({% for a in positional %}{{ a.arg_name }}{% if a.mode == "optional" %} \\ {{ a.arg_default }}{% endif %}, {% endfor %}opts \\ []){% if guarded | length > 0 %}
      when {% for g in guarded %}{% if not loop.first %} and {% endif %}{{ g.elixir_guard }}({{ g.arg_name }}){% endfor %}{% endif %} do
{%- if op.op_kind == "host_helper" %}
{%- set first_arg = positional | first %}
    {{ op.delegates_to }}(File.read!({{ first_arg.arg_name }}), opts)
{%- else %}
    %{"op" => "{{ op.wire_name }}"{% for a in inline_args %}, "{{ a.wire_key }}" => {% if a.mode == "keyword" %}Keyword.get(opts, :{{ a.arg_name }}, {{ a.arg_default }}){% elif a.encoding == "base64" %}Base.encode64({{ a.arg_name }}){% elif a.encoding == "tensor_list" %}Enum.map({{ a.arg_name }}, fn %{shape: shape, data: data} -> %{"shape" => shape, "data" => data} end){% elif a.encoding == "pair_list" %}Enum.map({{ a.arg_name }}, &Tuple.to_list/1){% else %}{{ a.arg_name }}{% endif %}{% endfor %}}
{%- for a in pipe_args %}
    |> {% if a.encoding == "omit_when_nil" %}put_optional("{{ a.wire_key }}", {{ a.arg_name }}){% else %}Map.merge({{ a.arg_name }}){% endif %}
{%- endfor %}
    |> call(timeout(opts, @{{ op.timeout_class }}_timeout))
{%- endif %}
  end
{%- endfor %}

  # ---------------------------------------------------------------------
  # Core private call -- the wire sequence documented in the moduledoc,
  # against the {{ export_prefix }}_* exports
  # ---------------------------------------------------------------------

  defp call(req, timeout) when is_map(req) do
    data = JSON.encode!(req)
    len = byte_size(data)

    with {:ok, {pid, store, memory}} <- engine(),
         {:ok, [raw_ptr]} <- call_export(pid, "{{ export_prefix }}_alloc", [len], timeout),
         ptr = band(raw_ptr, 0xFFFF_FFFF),
         :ok <- if(ptr == 0, do: {:error, :guest_alloc_failed}, else: :ok),
         :ok <- write_request(pid, store, memory, ptr, len, data),
         {:ok, [packed]} <- call_export(pid, "{{ export_prefix }}_call", [ptr, len], timeout) do
      read_response(pid, store, memory, packed, timeout)
    else
      {:error, {:call_exit, _} = reason} ->
        restart_engine()
        {:error, {:wasmex, {:engine_restarted, reason}}}

      {:error, reason} ->
        {:error, {:wasmex, reason}}
    end
  end

  defp call_export(pid, export, args, timeout) do
    Wasmex.call_function(pid, export, args, timeout)
  catch
    :exit, reason -> {:error, {:call_exit, reason}}
  end

  defp write_request(pid, store, memory, ptr, len, data) do
    case Wasmex.Memory.write_binary(store, memory, ptr, data) do
      :ok ->
        :ok

      {:error, _} = err ->
        _ = call_export(pid, "{{ export_prefix }}_dealloc", [ptr, len], @cheap_timeout)
        err
    end
  end

  defp read_response(pid, store, memory, packed, timeout) do
    packed = band(packed, 0xFFFF_FFFF_FFFF_FFFF)
    out_ptr = bsr(packed, 32)
    out_len = band(packed, 0xFFFF_FFFF)

    out = Wasmex.Memory.read_binary(store, memory, out_ptr, out_len)
    _ = call_export(pid, "{{ export_prefix }}_dealloc", [out_ptr, out_len], timeout)
{% if error_collapse == "any_key_raw" %}
    # bpm:ErrorCollapse_any_key_raw: any response carrying an "error" key is
    # an op failure, surfaced with the engine's raw message.
    case JSON.decode!(out) do
      %{"error" => msg} -> {:error, {:engine, msg}}
      decoded -> {:ok, decoded}
    end
{%- else %}
    # bpm:ErrorCollapse_single_key_inspect: only a response whose SOLE key is
    # "error" is an op failure. A response carrying "error" alongside other
    # top-level keys is a structured refusal envelope the caller needs whole,
    # so it passes through as {:ok, decoded} untouched.
    case JSON.decode!(out) do
      %{"error" => err} = decoded when map_size(decoded) == 1 ->
        {:error, {:engine, inspect(err)}}

      decoded ->
        {:ok, decoded}
    end
{%- endif %}
  end

  defp restart_engine do
    case Process.whereis(@engine_name) do
      nil -> :ok
      pid -> GenServer.stop(pid, :kill)
    end
  catch
    :exit, _ -> :ok
  end

  defp engine do
    case Process.whereis(@engine_name) do
      nil ->
        {:error, {:engine_not_started, "call {{ module }}.start/0 first"}}

      pid ->
        {:ok, handles!(pid)}
    end
  end

  defp handles!(pid) do
    case :persistent_term.get(@pt_key, nil) do
      {^pid, _store, _memory} = cached ->
        cached

      _stale_or_missing ->
        {:ok, store} = Wasmex.store(pid)
        {:ok, memory} = Wasmex.memory(pid)
        entry = {pid, store, memory}
        :persistent_term.put(@pt_key, entry)
        entry
    end
  end
{% if omit_args | length > 0 %}
  defp put_optional(req, _key, nil), do: req
  defp put_optional(req, key, value), do: Map.put(req, key, value)
{% endif %}
  defp timeout(opts, default), do: Keyword.get(opts, :timeout, default)
end

defmodule {{ module }}.Health do
  @moduledoc """
  A single-candidate engine-health status probe for the {{ engine_name }} engine:
  a typed, structured answer to "is the one engine we have actually alive
  right now", checked for real (artifact on disk AND the engine process can
  actually start), not discovered only at the first real call. One probe per
  engine, never a `select/2`-with-fallback ranking -- there is exactly one
  candidate per domain.
  """

  @type standing :: :alive | :blocked
  @type status :: %{
          id: :{{ health_id }},
          kind: :engine,
          standing: standing(),
          reason: String.t() | nil,
          evidence: %{wasm_path: String.t(), artifact_present: boolean(), engine_started: boolean() | nil}
        }

  @doc """
  Real health check: confirms the wasm artifact exists on disk AND that
  the engine can actually start (or is already started).
  """
  @spec status() :: status()
  def status do
    artifact_present = {{ module }}.wasm_built?()

    if artifact_present do
      case {{ module }}.start() do
        {:ok, _pid} ->
          %{
            id: :{{ health_id }},
            kind: :engine,
            standing: :alive,
            reason: nil,
            evidence: %{
              wasm_path: {{ module }}.wasm_path(),
              artifact_present: true,
              engine_started: true
            }
          }

        {:error, reason} ->
          %{
            id: :{{ health_id }},
            kind: :engine,
            standing: :blocked,
            reason: "artifact present but engine failed to start: #{inspect(reason)}",
            evidence: %{
              wasm_path: {{ module }}.wasm_path(),
              artifact_present: true,
              engine_started: false
            }
          }
      end
    else
      %{
        id: :{{ health_id }},
        kind: :engine,
        standing: :blocked,
        reason: {{ module }}.wasm_missing_reason(),
        evidence: %{
          wasm_path: {{ module }}.wasm_path(),
          artifact_present: false,
          engine_started: nil
        }
      }
    end
  end
end
