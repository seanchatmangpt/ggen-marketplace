---
to: "test/beam4pm_{{ bridge_name }}_bridge_test.exs"
force: true
sparql:
  bridges: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?bridge_name ?bridge_module ?bridge_doc ?ordinal ?command ?command_args ?framing
           ?restart_policy ?default_timeout ?probe_name ?script_probe WHERE {
      ?b a bpm:PortBridge ;
         bpm:bridgeName ?bridge_name ;
         bpm:bridgeModule ?bridge_module ;
         bpm:bridgeDoc ?bridge_doc ;
         bpm:bridgeOrdinal ?ordinal ;
         bpm:bridgeCommand ?command ;
         bpm:bridgeCommandArgs ?command_args ;
         bpm:bridgeFraming ?f ;
         bpm:bridgeRestartPolicy ?rpol ;
         bpm:bridgeDefaultTimeoutMs ?default_timeout ;
         bpm:bridgeScriptProbe ?script_probe ;
         bpm:bridgeProbeOp ?probe .
      ?probe a bpm:BridgeOp ; bpm:opName ?probe_name .
      ?f a bpm:BridgeFraming ; bpm:framingName ?framing .
      ?rpol a bpm:BridgeRestartPolicy ; bpm:restartPolicyName ?restart_policy .
    } ORDER BY ?ordinal
  ops: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?bridge_name ?op_key ?op_name ?op_order ?op_doc ?reply_shape ?wire_name ?timeout_ms ?sample_request WHERE {
      ?op a bpm:BridgeOp ;
          bpm:opBridge ?b ;
          bpm:opName ?op_name ;
          bpm:opOrder ?op_order ;
          bpm:opDoc ?op_doc ;
          bpm:opReplyShape ?reply_shape .
      ?b a bpm:PortBridge ; bpm:bridgeName ?bridge_name .
      OPTIONAL { ?op bpm:opWireName ?wire_o }
      OPTIONAL { ?op bpm:opTimeoutMs ?to_o }
      OPTIONAL { ?op bpm:opSampleRequest ?sr_o }
      BIND(CONCAT(?bridge_name, "/", ?op_name) AS ?op_key)
      BIND(COALESCE(?wire_o, ?op_name) AS ?wire_name)
      BIND(COALESCE(?to_o, "-") AS ?timeout_ms)
      BIND(COALESCE(?sr_o, "-") AS ?sample_request)
    } ORDER BY ?bridge_name ?op_order
  args: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?bridge_name ?op_key ?arg_name ?arg_order ?wire_key ?sample ?sampled WHERE {
      ?a a bpm:BridgeArg ;
         bpm:argOp ?op ;
         bpm:argName ?arg_name ;
         bpm:argOrder ?arg_order ;
         bpm:argType ?t .
      ?op a bpm:BridgeOp ; bpm:opBridge ?b ; bpm:opName ?op_name .
      ?b a bpm:PortBridge ; bpm:bridgeName ?bridge_name .
      OPTIONAL { ?a bpm:argSample ?sample_o }
      BIND(CONCAT(?bridge_name, "/", ?op_name) AS ?op_key)
      BIND(COALESCE(?sample_o, "-") AS ?sample)
      BIND(IF(?sample = "-", "false", "true") AS ?sampled)
    } ORDER BY ?op_key ?arg_order
for_each: bridges
---
{%- set bops = ops | filter(attribute="bridge_name", value=bridge_name) %}
{%- set bargs = args | filter(attribute="bridge_name", value=bridge_name) %}
{%- set module = "BeamPM." ~ bridge_module -%}
# GENERATED by ggen from the admitted bpm:PortBridge graph ({{ bridge_name }}). Do not edit.
defmodule {{ module }}Test do
  @moduledoc """
  Chicago-style qualification of the ggen-rendered persistent stdio
  JSON-lines port bridge (`{{ module }}`) against the REAL {{ bridge_name }}
  interpreter (`{{ command }} {{ command_args }}`, no mocks):

    * the probe op (`{{ probe_name }}`) round-trips through a real BEAM Port;
    * every op whose admitted bpm:BridgeArg facts all carry bpm:argSample
      gets a real happy-path round-trip;
    * an unknown op returns the bridge's error envelope without killing
      the bridge;
    * a request whose reply exceeds its timeout observes the strict-ordering
      poisoning law: {:error, :request_timeout}, port closed, and full
      recovery on the next request;
    * kill -9 the interpreter's OS process mid-session and the GenServer
      survives; the next request boots a fresh interpreter;
    * explicit `restart/1` restartability.

  Named skip when the interpreter entry script is not resolvable on this
  machine (same convention as the wasm-artifact qualifications).
  """

  use ExUnit.Case, async: false

  @moduletag skip: {{ module }}.missing_reason()

  describe "persistent bridge" do
    test "{{ probe_name }} round-trips through the real interpreter" do
      start_supervised!({{ module }})

      assert {:ok, %{"ok" => true}} = {{ module }}.{{ probe_name }}()
    end
{% for op in bops %}
{%- set oargs = bargs | filter(attribute="op_key", value=op.op_key) %}
{%- set n_args = oargs | length %}
{%- set n_sampled = oargs | filter(attribute="sampled", value="true") | length %}
{%- if n_args > 0 and n_args == n_sampled %}

    test "{{ op.op_name }} round-trips a real request" do
      start_supervised!({{ module }})

      assert {:ok, %{"ok" => true}} =
               {{ module }}.{{ op.op_name }}({% for a in oargs %}{{ a.sample }}{% if not loop.last %}, {% endif %}{% endfor %})
    end
{%- endif %}
{%- endfor %}

    test "unknown op returns the bridge's error envelope without killing the bridge" do
      start_supervised!({{ module }})

      # explicit 3-arity: request/3's leading default on `server` makes a
      # 2-arity raw call bind (server, req) and fail the is_map(req) guard
      assert {:error, {:bridge_error, %{"ok" => false}}} =
               {{ module }}.request({{ module }}, %{"op" => "no_such_op"}, {{ default_timeout }})

      # the interpreter survived the bad request
      assert {:ok, %{"ok" => true}} = {{ module }}.{{ probe_name }}()
    end
{% for op in bops %}
{%- if op.sample_request != "-" %}

    test "a reply past its timeout poisons ordering and the next request recovers" do
      start_supervised!({{ module }})

      assert {:ok, %{"ok" => true}} = {{ module }}.{{ probe_name }}()

      # the admitted sample request for `{{ op.op_name }}` does not reply within
      # a 100 ms budget: the waiter times out, and because replies are strictly
      # ordered the whole port is dropped and every remaining waiter fails.
      # Explicit 3-arity raw call, same guard trap as above.
      assert {:error, :request_timeout} =
               {{ module }}.request({{ module }}, JSON.decode!(~S({{ op.sample_request }})), 100)

      # the next request lazily boots a fresh interpreter: full recovery
      assert {:ok, %{"ok" => true}} = {{ module }}.{{ probe_name }}()
      assert {{ module }}.os_pid() != nil
    end
{% endif %}
{%- endfor %}
  end

  describe "kill-and-recover" do
    test "gen server survives kill -9 of the interpreter and the next request boots a fresh one" do
      start_supervised!({{ module }})

      assert {:ok, %{"ok" => true}} = {{ module }}.{{ probe_name }}()
      os_pid_1 = {{ module }}.os_pid()
      assert os_pid_1 != nil

      # kill the port process mid-session
      assert {_, 0} = System.cmd("kill", ["-9", to_string(os_pid_1)])

      # let the port's exit_status message reach the GenServer
      wait_until(fn -> {{ module }}.os_pid() == nil end)

      # the GenServer itself is still alive
      pid = GenServer.whereis({{ module }})
      assert Process.alive?(pid)

      # next request lazily boots a fresh interpreter: full recovery
      assert {:ok, %{"ok" => true}} = {{ module }}.{{ probe_name }}()
      os_pid_2 = {{ module }}.os_pid()
      assert os_pid_2 != nil and os_pid_2 != os_pid_1
    end

    test "restart/1 forces a fresh interpreter and the bridge stays usable" do
      start_supervised!({{ module }})

      assert {:ok, %{"ok" => true}} = {{ module }}.{{ probe_name }}()
      os_pid_1 = {{ module }}.os_pid()

      assert :ok = {{ module }}.restart()
      assert {{ module }}.os_pid() == nil

      assert {:ok, %{"ok" => true}} = {{ module }}.{{ probe_name }}()
      assert {{ module }}.os_pid() != os_pid_1
    end
  end

  defp wait_until(fun, tries \\ 100)

  defp wait_until(_fun, 0), do: flunk("condition never became true")

  defp wait_until(fun, tries) do
    if fun.() do
      :ok
    else
      Process.sleep(50)
      wait_until(fun, tries - 1)
    end
  end
end
