%% GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
%%
%% EUnit court for beam4pm_precision, run against the exact same 8-event/
%% 3-case order-to-ship seeded log as examples/erlang/dfg_discovery_demo.erl
%% (a real, executable M4-gate demo) plus a genuinely deviant trace. Every
%% expected value below is computed by hand in the comment above its
%% assertion from the same ETC escaping-edges formula beam4pm_precision
%% implements -- see that module for the full derivation.

-module(beam4pm_precision_tests).

-include_lib("eunit/include/eunit.hrl").

%% No explicit -export: EUnit's parse transform auto-exports *_test/0.

ev(Id, Type, Time, Attributes) ->
    {ok, Ev} = beam4pm_types:new_ocel_event(
        #{event_id => Id, event_type => Type, event_time => Time,
          attributes => Attributes}),
    Ev.

trace(CaseId, Seq) ->
    {ok, Trace} = beam4pm_types:new_log_trace(
        #{case_id => CaseId, activity_sequence => Seq}),
    Trace.

%% c1 and c2 both walk receive_order -> validate_order -> ship_order; c3
%% skips straight receive_order -> ship_order. Discovering the DFG from all
%% three gives receive_order out-degree 2 (branches to BOTH validate_order
%% and ship_order) -- exactly the shape that makes ETC precision diverge
%% from fitness.
seed_events() ->
    [ev(<<"e5">>, <<"validate_order">>, <<"2026-08-29T10:05:00Z">>, #{<<"case_id">> => <<"c2">>}),
     ev(<<"e1">>, <<"receive_order">>,  <<"2026-08-29T10:00:00Z">>, #{<<"case_id">> => <<"c1">>}),
     ev(<<"e6">>, <<"ship_order">>,     <<"2026-08-29T10:06:00Z">>, #{<<"case_id">> => <<"c2">>}),
     ev(<<"e2">>, <<"validate_order">>, <<"2026-08-29T10:01:00Z">>, #{<<"case_id">> => <<"c1">>}),
     ev(<<"e4">>, <<"receive_order">>,  <<"2026-08-29T10:04:00Z">>, #{<<"case_id">> => <<"c2">>}),
     ev(<<"e3">>, <<"ship_order">>,     <<"2026-08-29T10:02:00Z">>, #{<<"case_id">> => <<"c1">>}),
     ev(<<"e7">>, <<"receive_order">>,  <<"2026-08-29T10:07:00Z">>, #{<<"case_id">> => <<"c3">>}),
     ev(<<"e8">>, <<"ship_order">>,     <<"2026-08-29T10:08:00Z">>, #{<<"case_id">> => <<"c3">>})].

seeded_edges() ->
    Traces = beam4pm_discovery:traces_from_events(seed_events(), <<"case_id">>),
    beam4pm_discovery:dfg_from_traces(Traces).

%% Discovered DFG has the exact branching shape this suite's by-hand math
%% assumes: receive_order -> ship_order freq 1, receive_order ->
%% validate_order freq 2, validate_order -> ship_order freq 2. out-degree
%% (receive_order)=2, out-degree(validate_order)=1, out-degree(ship_order)=0.
dfg_shape_test() ->
    Edges = seeded_edges(),
    ?assertEqual(
        [{<<"receive_order">>, <<"ship_order">>, 1},
         {<<"receive_order">>, <<"validate_order">>, 2},
         {<<"validate_order">>, <<"ship_order">>, 2}],
        [{beam4pm_discovery:dfg_edge_source_activity(E),
          beam4pm_discovery:dfg_edge_target_activity(E),
          beam4pm_discovery:dfg_edge_frequency(E)} || E <- Edges]).

%% By hand: pair (receive_order,validate_order) -> enabled=out_degree
%% (receive_order)=2, taken pair is a known edge -> escaping=max(0,2-1)=1.
%% pair (validate_order,ship_order) -> enabled=out_degree(validate_order)=1,
%% taken pair is a known edge -> escaping=max(0,1-1)=0.
%% total_enabled=2+1=3, total_escaping=1+0=1, precision=1.0-1/3=0.6666666666666667.
%% Fitness for the SAME trace is a perfect 1.0 -- proof precision is a
%% genuinely different metric, not fitness under a new name.
c1_perfectly_fitting_but_imprecise_test() ->
    Edges = seeded_edges(),
    C1 = trace(<<"c1">>, [<<"receive_order">>, <<"validate_order">>, <<"ship_order">>]),
    ?assertEqual(0.6666666666666667, beam4pm_precision:etc_precision(Edges, C1)),
    Result = beam4pm_discovery:conformance(Edges, C1),
    ?assertEqual(1.0, beam4pm_discovery:conformance_result_fitness(Result)),
    ?assertEqual(0.6666666666666667,
                 beam4pm_discovery:conformance_result_precision(Result)).

c2_agrees_with_c1_test() ->
    Edges = seeded_edges(),
    C2 = trace(<<"c2">>, [<<"receive_order">>, <<"validate_order">>, <<"ship_order">>]),
    ?assertEqual(0.6666666666666667, beam4pm_precision:etc_precision(Edges, C2)).

%% By hand: one pair (receive_order,ship_order); enabled=out_degree
%% (receive_order)=2; it IS a known edge -> escaping=max(0,2-1)=1.
%% total_enabled=2, total_escaping=1, precision=1.0-1/2=0.5.
c3_shorter_trace_test() ->
    Edges = seeded_edges(),
    C3 = trace(<<"c3">>, [<<"receive_order">>, <<"ship_order">>]),
    ?assertEqual(0.5, beam4pm_precision:etc_precision(Edges, C3)).

%% The exact deviant trace from examples/erlang/dfg_discovery_demo.erl's
%% hard fitness < 1.0 assertion. By hand: pair (receive_order,cancel_order)
%% is NOT a known edge (a pure log move) -> escaping=enabled=out_degree
%% (receive_order)=2. total_enabled=2, total_escaping=2, precision=1.0-2/2=0.0.
deviant_trace_is_zero_precision_test() ->
    Edges = seeded_edges(),
    Deviant = trace(<<"d1">>, [<<"receive_order">>, <<"cancel_order">>]),
    ?assertEqual(0.0, beam4pm_precision:etc_precision(Edges, Deviant)),
    Result = beam4pm_discovery:conformance(Edges, Deviant),
    ?assertEqual(0.0, beam4pm_discovery:conformance_result_fitness(Result)),
    ?assertEqual(0.0, beam4pm_discovery:conformance_result_precision(Result)).

%% Fewer than two activities -> no state transition to evaluate -> honestly
%% 1.0, regardless of the model (even an empty one).
short_trace_is_one_precision_test() ->
    Edges = seeded_edges(),
    Short = trace(<<"c3">>, [<<"receive_order">>]),
    ?assertEqual(1.0, beam4pm_precision:etc_precision(Edges, Short)),
    ?assertEqual(1.0, beam4pm_precision:etc_precision([], Short)).

%% total_enabled=0 and total_escaping=0 when the model has no edges at all
%% leaving the trace's activities -> the same safe 1.0 fallback ex4pm's own
%% Ex4pmEngine.ETCPrecision.calculate_precision/3 uses for an empty
%% denominator.
empty_model_is_one_precision_test() ->
    NoEdgeTrace = trace(<<"x">>, [<<"a">>, <<"b">>]),
    ?assertEqual(1.0, beam4pm_precision:etc_precision([], NoEdgeTrace)).

%% alpha=0.0 (default): 0.5 (as above). With alpha=1.0: denominator becomes
%% total_enabled + 1.0*total_escaping = 2 + 1 = 3, precision = 1.0 - 1/3 =
%% 0.6666666666666667 -- proof alpha is real and wired through, not a
%% decorative unused parameter.
alpha_smoothing_test() ->
    Edges = seeded_edges(),
    C3 = trace(<<"c3">>, [<<"receive_order">>, <<"ship_order">>]),
    ?assertEqual(0.5, beam4pm_precision:etc_precision(Edges, C3, 0.0)),
    ?assertEqual(0.6666666666666667, beam4pm_precision:etc_precision(Edges, C3, 1.0)).
