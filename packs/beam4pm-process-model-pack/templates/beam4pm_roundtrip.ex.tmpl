---
to: lib/beam4pm_roundtrip.ex
sparql:
  records: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:recordDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:hasField ?f .
      ?f bpm:fieldName ?field_name ; bpm:fieldType ?field_type ; bpm:fieldDoc ?field_doc ;
         bpm:fieldRequired ?field_required ; bpm:fieldOrder ?field_order .
    } ORDER BY ?record_name ?field_order
---
# GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
#
# Cross-language roundtrip sample fixtures: one deterministic sample per
# admitted record type and variant (:full | :minimal), written and verified
# through BeamPM.Codec so any drift between the Elixir and Erlang codecs
# surfaces as a real fixture mismatch, not an assumed equivalence.

defmodule BeamPM.Roundtrip do
  @moduledoc "Cross-language roundtrip sample fixtures for every admitted record type."

  @record_names [
{%- for r in records %}
    :{{ r.record_name }}{% if not loop.last %},{% endif %}
{%- endfor %}
  ]

  @variants [:full, :minimal]

  @spec record_names() :: [atom()]
  def record_names, do: @record_names

  # Deterministic sample values, keyed by bpm:fieldType:
  # string -> "sample_" <> field_name, datetime -> "2026-08-29T12:00:00Z",
  # integer -> 42, float -> 3.5, boolean -> true, atom -> :sample_atom,
  # list_string -> ["alpha", "beta"], map -> a single-entry map "k" => "v".
  # :minimal = required fields only; :full = every field.
  @spec sample(atom(), :full | :minimal) :: {:ok, struct()}
{% for r in records %}{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) -%}
{%- set reqfields = rfields | filter(attribute="field_required", value="true") -%}
{%- set mod_name = r.record_name | replace(from="_", to=" ") | title | replace(from=" ", to="") %}
  def sample(:{{ r.record_name }}, :full) do
    BeamPM.Types.{{ mod_name }}.new(%{
{%- for f in rfields %}
      {{ f.field_name }}: {% if f.field_type == "string" %}"sample_{{ f.field_name }}"{% elif f.field_type == "datetime" %}"2026-08-29T12:00:00Z"{% elif f.field_type == "integer" %}42{% elif f.field_type == "float" %}3.5{% elif f.field_type == "boolean" %}true{% elif f.field_type == "atom" %}:sample_atom{% elif f.field_type == "list_string" %}["alpha", "beta"]{% elif f.field_type == "map" %}%{"k" => "v"}{% endif %}{% if not loop.last %},{% endif %}
{%- endfor %}
    })
  end

  def sample(:{{ r.record_name }}, :minimal) do
    BeamPM.Types.{{ mod_name }}.new(%{
{%- for f in reqfields %}
      {{ f.field_name }}: {% if f.field_type == "string" %}"sample_{{ f.field_name }}"{% elif f.field_type == "datetime" %}"2026-08-29T12:00:00Z"{% elif f.field_type == "integer" %}42{% elif f.field_type == "float" %}3.5{% elif f.field_type == "boolean" %}true{% elif f.field_type == "atom" %}:sample_atom{% elif f.field_type == "list_string" %}["alpha", "beta"]{% elif f.field_type == "map" %}%{"k" => "v"}{% endif %}{% if not loop.last %},{% endif %}
{%- endfor %}
    })
  end
{% endfor %}
  def sample(name, variant) do
    raise ArgumentError, "unknown sample #{inspect(name)}.#{inspect(variant)}"
  end

  @doc "Write every record x variant sample as dir/<record>.<variant>.ex.json."
  @spec write_samples(Path.t()) :: :ok
  def write_samples(dir) do
    File.mkdir_p!(dir)

    Enum.each(pairs(), fn {name, variant} ->
      {:ok, struct} = sample(name, variant)
      json = BeamPM.Codec.encode(struct)
      File.write!(Path.join(dir, sample_basename(name, variant, "ex")), json)
    end)

    :ok
  end

  @doc """
  Read every record x variant fixture dir/<record>.<variant>.<suffix>.json,
  decode it, and compare its canonical map against this module's own sample.
  """
  @spec verify_samples(Path.t(), String.t()) :: {non_neg_integer(), [String.t()]}
  def verify_samples(dir, suffix) do
    Enum.reduce(pairs(), {0, []}, fn {name, variant}, {pass, failures} ->
      label = "#{name}.#{variant}"
      path = Path.join(dir, sample_basename(name, variant, suffix))
      {:ok, expected} = sample(name, variant)

      case File.read(path) do
        {:ok, bin} ->
          case BeamPM.Codec.decode(name, bin) do
            {:ok, decoded} ->
              if BeamPM.Codec.to_map(decoded) == BeamPM.Codec.to_map(expected) do
                {pass + 1, failures}
              else
                {pass, failures ++ ["#{label}: map mismatch"]}
              end

            {:error, reason} ->
              {pass, failures ++ ["#{label}: decode error #{inspect(reason)}"]}
          end

        {:error, reason} ->
          {pass, failures ++ ["#{label}: read error #{inspect(reason)}"]}
      end
    end)
  end

  defp pairs do
    for name <- @record_names, variant <- @variants, do: {name, variant}
  end

  defp sample_basename(name, variant, suffix) do
    "#{name}.#{variant}.#{suffix}.json"
  end
end
