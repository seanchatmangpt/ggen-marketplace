// ---------------------------------------------------------------------------
// causal_dfg_from_spans -- observed (parent/child link) vs inferred
// (start_time adjacency). Same fixtures and by-hand expectations as the
// Erlang beam4pm_discovery_tests and Elixir BeamPM.DiscoveryTest suites.
// ---------------------------------------------------------------------------

fn span(
  span_id: String,
  service_name: String,
  parent_span_id: String,
  trace_id: String,
  start_time: String,
) -> types.ServiceSpan {
  types.ServiceSpan(
    span_id: span_id,
    service_name: service_name,
    duration_ms: 10,
    parent_span_id: option.Some(parent_span_id),
    trace_id: trace_id,
    start_time: start_time,
  )
}

fn root_span(
  span_id: String,
  service_name: String,
  trace_id: String,
  start_time: String,
) -> types.ServiceSpan {
  types.ServiceSpan(
    span_id: span_id,
    service_name: service_name,
    duration_ms: 50,
    parent_span_id: option.None,
    trace_id: trace_id,
    start_time: start_time,
  )
}

// One root (gateway) fans out to two CONCURRENT children; variant A has
// orders starting first, variant B inventory. Same spans, same links.
fn fan_out_orders_first() -> List(types.ServiceSpan) {
  [
    root_span("r1", "gateway", "t1", "2026-09-05T10:00:00.000Z"),
    span("s2", "inventory", "r1", "t1", "2026-09-05T10:00:00.020Z"),
    span("s1", "orders", "r1", "t1", "2026-09-05T10:00:00.010Z"),
  ]
}

fn fan_out_inventory_first() -> List(types.ServiceSpan) {
  [
    span("s1", "orders", "r1", "t1", "2026-09-05T10:00:00.020Z"),
    root_span("r1", "gateway", "t1", "2026-09-05T10:00:00.000Z"),
    span("s2", "inventory", "r1", "t1", "2026-09-05T10:00:00.010Z"),
  ]
}

fn edge(
  source: String,
  target: String,
  frequency: Int,
  evidence: String,
) -> types.SpanEdge {
  types.SpanEdge(
    source_service: source,
    target_service: target,
    frequency: frequency,
    evidence: evidence,
  )
}

pub fn causal_fan_out_separates_observed_from_inferred_test() {
  let assert Ok(ev) = discovery.causal_dfg_from_spans(fan_out_orders_first())
  assert ev.observed
    == [
      edge("gateway", "inventory", 1, "parent_child_link"),
      edge("gateway", "orders", 1, "parent_child_link"),
    ]
  assert ev.adjacent
    == [
      edge("gateway", "orders", 1, "temporal_adjacency"),
      edge("orders", "inventory", 1, "temporal_adjacency"),
    ]
  // The sibling edge adjacency invents -- no link supports it:
  assert ev.inferred_only == [edge("orders", "inventory", 1, "temporal_adjacency")]
  // The real causal edge adjacency cannot see (the root's second child):
  assert ev.observed_not_adjacent
    == [edge("gateway", "inventory", 1, "parent_child_link")]
  assert ev.orphans == []
}

pub fn causal_arm_invariant_under_sibling_reorder_test() {
  let assert Ok(a) = discovery.causal_dfg_from_spans(fan_out_orders_first())
  let assert Ok(b) =
    discovery.causal_dfg_from_spans(fan_out_inventory_first())
  assert a.observed == b.observed
  assert a.adjacent != b.adjacent
  assert b.inferred_only == [edge("inventory", "orders", 1, "temporal_adjacency")]
  assert b.observed_not_adjacent
    == [edge("gateway", "orders", 1, "parent_child_link")]
}

pub fn causal_adjacency_arm_is_todays_discovery_retagged_test() {
  let spans = fan_out_orders_first()
  let assert Ok(ev) = discovery.causal_dfg_from_spans(spans)
  let dfg =
    spans
    |> discovery.traces_from_spans
    |> discovery.dfg_from_traces
    |> list.map(fn(e) { #(e.source_activity, e.target_activity, e.frequency) })
  assert dfg
    == list.map(ev.adjacent, fn(e) {
      #(e.source_service, e.target_service, e.frequency)
    })
}

pub fn traces_from_spans_orders_by_start_time_then_span_id_test() {
  let spans =
    list.append(fan_out_orders_first(), [
      span("o1", "billing", "missing", "t1", "2026-09-05T10:00:00.030Z"),
    ])
  assert discovery.traces_from_spans(spans)
    == [
      types.LogTrace(case_id: "t1", activity_sequence: [
        "gateway",
        "orders",
        "inventory",
        "billing",
      ]),
    ]
  let at = "2026-09-05T10:00:00.000Z"
  assert discovery.traces_from_spans([
      root_span("b", "second", "tx", at),
      root_span("a", "first", "tx", at),
    ])
    == [types.LogTrace(case_id: "tx", activity_sequence: ["first", "second"])]
}

pub fn causal_orphan_is_reported_never_invented_test() {
  let spans =
    list.append(fan_out_orders_first(), [
      span("o1", "billing", "missing", "t1", "2026-09-05T10:00:00.030Z"),
    ])
  let assert Ok(ev) = discovery.causal_dfg_from_spans(spans)
  assert ev.orphans == [#("o1", "missing")]
  assert ev.observed
    == [
      edge("gateway", "inventory", 1, "parent_child_link"),
      edge("gateway", "orders", 1, "parent_child_link"),
    ]
  assert ev.inferred_only
    == [
      edge("inventory", "billing", 1, "temporal_adjacency"),
      edge("orders", "inventory", 1, "temporal_adjacency"),
    ]
}

pub fn causal_duplicate_span_id_is_refused_test() {
  let spans =
    list.append(fan_out_orders_first(), [
      root_span("r1", "gateway", "t9", "2026-09-05T11:00:00.000Z"),
    ])
  assert discovery.causal_dfg_from_spans(spans)
    == Error(discovery.DuplicateSpanId("r1"))
}

pub fn causal_parent_in_other_trace_is_refused_test() {
  let spans =
    list.append(fan_out_orders_first(), [
      span("x1", "payments", "r1", "t2", "2026-09-05T10:00:00.040Z"),
    ])
  assert discovery.causal_dfg_from_spans(spans)
    == Error(discovery.ParentInOtherTrace("x1"))
}

pub fn causal_empty_and_root_only_yield_no_edges_test() {
  let empty =
    discovery.SpanEvidence(
      observed: [],
      adjacent: [],
      inferred_only: [],
      observed_not_adjacent: [],
      orphans: [],
    )
  assert discovery.causal_dfg_from_spans([]) == Ok(empty)
  assert discovery.causal_dfg_from_spans([
      root_span("r1", "gateway", "t1", "2026-09-05T10:00:00.000Z"),
    ])
    == Ok(empty)
}

pub fn causal_frequency_counts_links_per_service_pair_test() {
  let t2 = [
    root_span("r2", "gateway", "t2", "2026-09-05T10:01:00.000Z"),
    span("s3", "orders", "r2", "t2", "2026-09-05T10:01:00.010Z"),
    span("s4", "inventory", "r2", "t2", "2026-09-05T10:01:00.020Z"),
  ]
  let assert Ok(ev) =
    discovery.causal_dfg_from_spans(list.append(fan_out_orders_first(), t2))
  assert ev.observed
    == [
      edge("gateway", "inventory", 2, "parent_child_link"),
      edge("gateway", "orders", 2, "parent_child_link"),
    ]
  assert ev.adjacent
    == [
      edge("gateway", "orders", 2, "temporal_adjacency"),
      edge("orders", "inventory", 2, "temporal_adjacency"),
    ]
  assert ev.inferred_only == [edge("orders", "inventory", 2, "temporal_adjacency")]
  assert ev.observed_not_adjacent
    == [edge("gateway", "inventory", 2, "parent_child_link")]
}

pub fn causal_adjacency_never_crosses_trace_id_test() {
  let spans = [
    root_span("r1", "gateway", "t1", "2026-09-05T10:00:00.000Z"),
    root_span("r2", "auth", "t2", "2026-09-05T10:00:00.005Z"),
    span("s1", "orders", "r1", "t1", "2026-09-05T10:00:00.010Z"),
    span("s2", "users", "r2", "t2", "2026-09-05T10:00:00.015Z"),
  ]
  let assert Ok(ev) = discovery.causal_dfg_from_spans(spans)
  assert ev.observed
    == [
      edge("auth", "users", 1, "parent_child_link"),
      edge("gateway", "orders", 1, "parent_child_link"),
    ]
  assert ev.adjacent
    == [
      edge("auth", "users", 1, "temporal_adjacency"),
      edge("gateway", "orders", 1, "temporal_adjacency"),
    ]
  assert ev.inferred_only == []
  assert ev.observed_not_adjacent == []
  assert ev.orphans == []
}
