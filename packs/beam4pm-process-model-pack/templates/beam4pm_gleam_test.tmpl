// GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
//
// Chicago-style tests over the real generated modules (35
// admitted record types): exact traces, exact edge frequencies, exact fitness
// for the deterministic seeded log defined in src/beam4pm.gleam. No mocks.

import beam4pm
import beam4pm/discovery
import beam4pm/types
import gleam/dict
import gleam/option
import gleeunit

pub fn main() {
  gleeunit.main()
}

fn seeded_traces() -> List(types.LogTrace) {
  discovery.traces_from_events(beam4pm.seeded_events(), "case_id")
}

pub fn traces_from_events_exact_test() {
  assert seeded_traces()
    == [
      types.LogTrace(case_id: "c1", activity_sequence: [
        "receive_order",
        "validate_order",
        "ship_order",
      ]),
      types.LogTrace(case_id: "c2", activity_sequence: [
        "receive_order",
        "validate_order",
        "ship_order",
      ]),
      types.LogTrace(case_id: "c3", activity_sequence: ["receive_order"]),
    ]
}

pub fn traces_skip_events_without_case_key_and_without_attributes_test() {
  // e8 carries attributes but no "case_id" key; e9 has no attributes at all.
  let events = [
    types.OcelEvent(
      event_id: "e8",
      event_type: "audit",
      event_time: "2026-08-29T12:04:00Z",
      attributes: option.Some(dict.from_list([#("channel", "web")])),
    ),
    types.OcelEvent(
      event_id: "e9",
      event_type: "audit",
      event_time: "2026-08-29T12:05:00Z",
      attributes: option.None,
    ),
  ]
  assert discovery.traces_from_events(events, "case_id") == []
}

pub fn traces_sort_by_time_then_event_id_test() {
  // Same timestamp: tie must break lexicographically by event_id.
  let at = "2026-08-29T12:00:00Z"
  let events = [
    types.OcelEvent(
      event_id: "e2",
      event_type: "b_activity",
      event_time: at,
      attributes: option.Some(dict.from_list([#("case_id", "cx")])),
    ),
    types.OcelEvent(
      event_id: "e1",
      event_type: "a_activity",
      event_time: at,
      attributes: option.Some(dict.from_list([#("case_id", "cx")])),
    ),
  ]
  assert discovery.traces_from_events(events, "case_id")
    == [
      types.LogTrace(case_id: "cx", activity_sequence: [
        "a_activity",
        "b_activity",
      ]),
    ]
}

pub fn dfg_from_traces_exact_frequencies_test() {
  assert discovery.dfg_from_traces(seeded_traces())
    == [
      types.DfgEdge(
        source_activity: "receive_order",
        target_activity: "validate_order",
        frequency: 2,
      ),
      types.DfgEdge(
        source_activity: "validate_order",
        target_activity: "ship_order",
        frequency: 2,
      ),
    ]
}

// Precision (beam4pm/precision's ETC/escaping-edge score, adapted from
// ex4pm's real Ex4pmEngine.ETCPrecision) is wired into conformance alongside
// fitness. Every expected value below is a real, by-hand computation over
// this test's own seeded model (out-degrees: receive_order=1,
// validate_order=1, ship_order=0) -- not asserted blind.
pub fn conformance_fitting_trace_is_1_0_test() {
  let traces = seeded_traces()
  let edges = discovery.dfg_from_traces(traces)
  let trace =
    types.LogTrace(case_id: "c1", activity_sequence: [
      "receive_order",
      "validate_order",
      "ship_order",
    ])
  // By hand: (receive_order,validate_order) known, enabled=1, escaping=0.
  // (validate_order,ship_order) known, enabled=1, escaping=0.
  // total=2/0 escaping -> precision=1.0.
  assert discovery.conformance(edges, trace)
    == types.ConformanceResult(
      trace_id: "c1",
      fitness: 1.0,
      precision: option.Some(1.0),
    )
}

pub fn conformance_short_trace_is_1_0_test() {
  let edges = discovery.dfg_from_traces(seeded_traces())
  let trace =
    types.LogTrace(case_id: "c3", activity_sequence: ["receive_order"])
  // A single-activity trace has zero adjacent pairs -- honestly 1.0.
  assert discovery.conformance(edges, trace)
    == types.ConformanceResult(
      trace_id: "c3",
      fitness: 1.0,
      precision: option.Some(1.0),
    )
}

pub fn conformance_deviant_trace_is_0_5_test() {
  let edges = discovery.dfg_from_traces(seeded_traces())
  let deviant =
    types.LogTrace(case_id: "d1", activity_sequence: [
      "receive_order",
      "validate_order",
      "cancel_order",
    ])
  // By hand: (receive_order,validate_order) known, enabled=1, escaping=0.
  // (validate_order,cancel_order) NOT known, enabled=out_degree
  // (validate_order)=1, escaping=1. total_enabled=2, total_escaping=1
  // -> precision=1.0-1/2=0.5 (same as fitness here, coincidentally).
  assert discovery.conformance(edges, deviant)
    == types.ConformanceResult(
      trace_id: "d1",
      fitness: 0.5,
      precision: option.Some(0.5),
    )
}

pub fn variants_from_traces_groups_by_activity_sequence_test() {
  // seeded_traces(): c1 and c2 share [receive_order, validate_order,
  // ship_order] (frequency 2); c3 is the lone [receive_order] variant
  // (frequency 1). Sorted by activity_sequence: ["receive_order"] < the
  // 3-activity sequence lexicographically (shorter joined string), so it
  // ranks first.
  let variants = discovery.variants_from_traces(seeded_traces())
  assert variants
    == [
      types.ProcessVariant(
        variant_id: "1",
        activity_sequence: ["receive_order"],
        frequency: 1,
      ),
      types.ProcessVariant(
        variant_id: "2",
        activity_sequence: [
          "receive_order",
          "validate_order",
          "ship_order",
        ],
        frequency: 2,
      ),
    ]
}
