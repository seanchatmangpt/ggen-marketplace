# GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
defmodule BeamPM.PrecisionTest do
  use ExUnit.Case, async: true

  alias BeamPM.Discovery
  alias BeamPM.Precision
  alias BeamPM.Types.LogTrace
  alias BeamPM.Types.OcelEvent

  @case_attr_key "case_id"

  defp event!(event_id, event_type, event_time, attributes) do
    {:ok, event} =
      OcelEvent.new(%{
        event_id: event_id,
        event_type: event_type,
        event_time: event_time,
        attributes: attributes
      })

    event
  end

  defp trace!(case_id, activity_sequence) do
    {:ok, trace} = LogTrace.new(%{case_id: case_id, activity_sequence: activity_sequence})
    trace
  end

  # The exact same 8-event/3-case order-to-ship seeded log as
  # examples/erlang/dfg_discovery_demo.erl (a real, executable M4-gate
  # demo), fed in deliberately shuffled timestamp order: c1 and c2 both walk
  # receive_order -> validate_order -> ship_order; c3 skips validate_order
  # entirely and goes straight receive_order -> ship_order. Discovering the
  # DFG from all three gives receive_order out-degree 2 (branches to BOTH
  # validate_order and ship_order), which is exactly the shape that makes
  # ETC precision diverge from fitness: c1/c2 fit perfectly (every pair they
  # take is a known edge) but are NOT perfectly precise, because the model
  # also admits a second option from receive_order that they never take.
  defp seeded_events do
    [
      event!("e5", "validate_order", "2026-08-29T10:05:00Z", %{"case_id" => "c2"}),
      event!("e1", "receive_order", "2026-08-29T10:00:00Z", %{"case_id" => "c1"}),
      event!("e6", "ship_order", "2026-08-29T10:06:00Z", %{"case_id" => "c2"}),
      event!("e2", "validate_order", "2026-08-29T10:01:00Z", %{"case_id" => "c1"}),
      event!("e4", "receive_order", "2026-08-29T10:04:00Z", %{"case_id" => "c2"}),
      event!("e3", "ship_order", "2026-08-29T10:02:00Z", %{"case_id" => "c1"}),
      event!("e7", "receive_order", "2026-08-29T10:07:00Z", %{"case_id" => "c3"}),
      event!("e8", "ship_order", "2026-08-29T10:08:00Z", %{"case_id" => "c3"})
    ]
  end

  # Discovered DFG (by hand, and asserted below to stay honest): counting
  # adjacent pairs across c1=[receive_order,validate_order,ship_order],
  # c2=[receive_order,validate_order,ship_order],
  # c3=[receive_order,ship_order] gives
  #   receive_order -> ship_order      freq 1
  #   receive_order -> validate_order  freq 2
  #   validate_order -> ship_order     freq 2
  # so out-degree(receive_order)=2, out-degree(validate_order)=1,
  # out-degree(ship_order)=0.
  defp seeded_edges do
    seeded_events()
    |> Discovery.traces_from_events(@case_attr_key)
    |> Discovery.dfg_from_traces()
  end

  test "the discovered model has the exact branching shape this test suite's by-hand math assumes" do
    assert [
             %{source_activity: "receive_order", target_activity: "ship_order", frequency: 1},
             %{source_activity: "receive_order", target_activity: "validate_order", frequency: 2},
             %{source_activity: "validate_order", target_activity: "ship_order", frequency: 2}
           ] = Enum.map(seeded_edges(), &Map.take(&1, [:source_activity, :target_activity, :frequency]))
  end

  test "etc_precision/2 is exactly 2/3 for a perfectly-fitting trace against a branching model (diverges from fitness)" do
    edges = seeded_edges()
    c1 = trace!("c1", ["receive_order", "validate_order", "ship_order"])

    # By hand: pair (receive_order,validate_order) -> enabled=out_degree(receive_order)=2,
    # taken pair is a known edge -> escaping=max(0,2-1)=1.
    # pair (validate_order,ship_order) -> enabled=out_degree(validate_order)=1,
    # taken pair is a known edge -> escaping=max(0,1-1)=0.
    # total_enabled=2+1=3, total_escaping=1+0=1, precision=1.0-1/3=0.6666666666666667.
    assert Precision.etc_precision(edges, c1) === 0.6666666666666667

    # Fitness is a perfect 1.0 for the same trace -- proof precision is a
    # genuinely different, non-redundant metric, not fitness under a new name.
    result = Discovery.conformance(edges, c1)
    assert result.fitness === 1.0
    assert result.precision === 0.6666666666666667
  end

  test "etc_precision/2 agrees for c2 (same activity sequence as c1)" do
    edges = seeded_edges()
    c2 = trace!("c2", ["receive_order", "validate_order", "ship_order"])
    assert Precision.etc_precision(edges, c2) === 0.6666666666666667
  end

  test "etc_precision/2 is exactly 0.5 for the shorter c3 trace (single pair, out-degree 2 at its source)" do
    edges = seeded_edges()
    c3 = trace!("c3", ["receive_order", "ship_order"])

    # By hand: one pair (receive_order,ship_order); enabled=out_degree(receive_order)=2;
    # it IS a known edge -> escaping=max(0,2-1)=1.
    # total_enabled=2, total_escaping=1, precision=1.0-1/2=0.5.
    assert Precision.etc_precision(edges, c3) === 0.5
  end

  test "etc_precision/2 is exactly 0.0 for a genuinely deviant trace the model never predicted" do
    edges = seeded_edges()
    # The exact deviant trace from examples/erlang/dfg_discovery_demo.erl's
    # hard assertion (fitness < 1.0 there); this test additionally proves
    # precision, not just fitness, correctly reports total imprecision.
    deviant = trace!("d1", ["receive_order", "cancel_order"])

    # By hand: pair (receive_order,cancel_order) is NOT a known edge (a pure
    # log move) -> escaping=enabled=out_degree(receive_order)=2.
    # total_enabled=2, total_escaping=2, precision=1.0-2/2=0.0.
    assert Precision.etc_precision(edges, deviant) === 0.0

    result = Discovery.conformance(edges, deviant)
    assert result.fitness === 0.0
    assert result.precision === 0.0
  end

  test "etc_precision/2 is honestly 1.0 for a trace with fewer than two activities, regardless of the model" do
    assert Precision.etc_precision(seeded_edges(), trace!("c3", ["receive_order"])) === 1.0
    assert Precision.etc_precision([], trace!("c3", ["receive_order"])) === 1.0
  end

  test "etc_precision/2 is honestly 1.0 when the model has no edges at all leaving the trace's activities" do
    # total_enabled=0 (no model edges exist from "a" at all) and
    # total_escaping=0 (an empty known-set means the pair can't match, but
    # escaping is defined as enabled when unmatched, and enabled is 0 here
    # too) -> denominator 0 -> the same safe 1.0 fallback ex4pm's own
    # ETCPrecision.calculate_precision/3 uses for an empty denominator.
    assert Precision.etc_precision([], trace!("x", ["a", "b"])) === 1.0
  end

  test "etc_precision/3 alpha smoothing lowers a partially-escaping trace's score below the alpha=0.0 value" do
    edges = seeded_edges()
    c3 = trace!("c3", ["receive_order", "ship_order"])

    # alpha=0.0 (default): 0.5, computed above. With alpha=1.0: denominator
    # becomes total_enabled + 1.0*total_escaping = 2 + 1 = 3, precision =
    # 1.0 - 1/3 = 0.6666666666666667 -- HIGHER than 0.5 here (this
    # particular escaping trace is smoothed toward more precision, exactly
    # as Ex4pmEngine.ETCPrecision's own alpha widens the effective
    # denominator against a sparse log), proving alpha is real and wired
    # through, not a decorative unused parameter.
    assert Precision.etc_precision(edges, c3, 0.0) === 0.5
    assert Precision.etc_precision(edges, c3, 1.0) === 0.6666666666666667
  end
