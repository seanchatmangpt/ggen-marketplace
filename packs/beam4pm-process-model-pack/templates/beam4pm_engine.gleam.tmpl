---
to: "gleam/src/beam4pm/{{ engine_name }}.gleam"
sparql:
  engines: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?engine_module ?engine_doc ?ordinal ?handle_noun ?wasm_artifact WHERE {
      ?e a bpm:Engine ;
         bpm:engineName ?engine_name ;
         bpm:engineModule ?engine_module ;
         bpm:engineDoc ?engine_doc ;
         bpm:engineOrdinal ?ordinal ;
         bpm:handleNoun ?handle_noun ;
         bpm:wasmArtifactPath ?wasm_artifact .
    } ORDER BY ?ordinal
  ops: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?op_key ?op_name ?elixir_name ?op_order ?op_doc ?op_kind ?delegates_to ?expose_gleam WHERE {
      ?op a bpm:EngineOp ;
          bpm:opEngine ?e ;
          bpm:opName ?op_name ;
          bpm:opOrder ?op_order ;
          bpm:opDoc ?op_doc ;
          bpm:opKind ?k .
      ?e a bpm:Engine ; bpm:engineName ?engine_name .
      ?k a bpm:EngineOpKind ; bpm:engineOpKindName ?op_kind .
      OPTIONAL { ?op bpm:opElixirPredicate ?pred_opt }
      OPTIONAL { ?op bpm:opDelegatesTo ?target . ?target bpm:opName ?target_name }
      OPTIONAL { ?op bpm:opExposeGleam ?gleam_opt }
      BIND(CONCAT(?engine_name, "/", ?op_name) AS ?op_key)
      BIND(COALESCE(?pred_opt, "false") AS ?predicate)
      BIND(COALESCE(?target_name, "-") AS ?delegates_to)
      BIND(COALESCE(?gleam_opt, "true") AS ?expose_gleam)
      BIND(IF(?predicate = "true", CONCAT(?op_name, "?"), ?op_name) AS ?elixir_name)
    } ORDER BY ?engine_name ?op_order
  args: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?op_key ?arg_name ?arg_order ?gleam_type ?mode WHERE {
      ?a a bpm:EngineArg ;
         bpm:argOp ?op ;
         bpm:argName ?arg_name ;
         bpm:argOrder ?arg_order ;
         bpm:argType ?t .
      ?op a bpm:EngineOp ; bpm:opEngine ?e ; bpm:opName ?op_name .
      ?e a bpm:Engine ; bpm:engineName ?engine_name .
      ?t a bpm:EngineArgType ; bpm:argGleamType ?gleam_type .
      OPTIONAL { ?a bpm:argMode ?m . ?m a bpm:ArgMode ; bpm:argModeName ?mode_name }
      BIND(CONCAT(?engine_name, "/", ?op_name) AS ?op_key)
      BIND(COALESCE(?mode_name, "required") AS ?mode)
    } ORDER BY ?op_key ?arg_order
for_each: engines
---
{%- set eops = ops | filter(attribute="engine_name", value=engine_name) | filter(attribute="expose_gleam", value="true") %}
{%- set eargs = args | filter(attribute="engine_name", value=engine_name) %}
{%- set elixir_module = "Elixir.BeamPM." ~ engine_module -%}
// GENERATED by ggen from the admitted bpm:Engine graph ({{ engine_name }}). Do not edit.
//// Facade over the {{ engine_name }} native wasm engine hosted by Elixir/wasmex --
//// {{ engine_doc }}
////
//// Every function here is an `@external` delegation to `{{ elixir_module }}`
//// (lib/beam4pm_{{ engine_name }}.ex), which drives the single wasm32-wasip1 engine
//// ({{ wasm_artifact }}). No computation happens in Gleam -- this module is a
//// typed facade over the one engine. This file, that wrapper and the Erlang
//// facade src/beam4pm_{{ engine_name }}.erl are all rendered from the same admitted
//// bpm:Engine / bpm:EngineOp / bpm:EngineArg facts.
////
//// Compile-checked by `gleam build` (externals are not resolved at compile
//// time); runtime-tested ONLY from the mix context
//// (test/beam4pm_{{ engine_name }}_facades_test.exs appends gleam/build/dev/erlang/
//// beam4pm/ebin to the code path), because `gleam test`/gleeunit runs
//// without wasmex on its path. Documented, not faked.
////
//// Runtime contract (inherited verbatim from BeamPM.{{ engine_module }}):
////   - Elixir's `{:ok, map} | {:error, reason}` tuples ARE Gleam's `Result`
////     runtime representation, so every call types as
////     `Result(Dynamic, Dynamic)`: Ok carries a binary-keyed map decoded
////     from the engine's JSON response; Error carries
////     `{:engine, msg}` / `{:wasmex, term}` tagged tuples.
////   - `start()` must have been called (or the engine supervised) in the
////     hosting BEAM before any other function; a restart produces a fresh
////     wasm store, so ALL previously returned {{ handle_noun }} handles are invalid.
////   - Ops with optional trailing args in Elixir (an optional positional, a
////     keyword-list option, the `opts` timeout list) are bound here at their
////     minimal-arity default-argument heads only; there is no clean Gleam
////     representation of an Elixir keyword list, so no extra-arity variant
////     is invented.
////   - Arguments typed `Dynamic` (maps, tensor lists) are shapes Gleam's type
////     system cannot express without a bespoke record mirrored on both sides
////     of the boundary; callers build the shape themselves, the same
////     honesty-over-invention convention as the rest of the facade family.

import gleam/dynamic.{type Dynamic}

/// Start (or find already started) the named singleton wasmex engine
/// hosting {{ wasm_artifact | split(pat="/") | last }}. Idempotent; `Ok` carries the engine pid.
@external(erlang, "{{ elixir_module }}", "start")
pub fn start() -> Result(Dynamic, Dynamic)
{%- for op in eops %}
{%- set oargs = eargs | filter(attribute="op_key", value=op.op_key) %}
{%- set req = oargs | filter(attribute="mode", value="required") %}

/// {{ op.op_doc }}
@external(erlang, "{{ elixir_module }}", "{{ op.elixir_name }}")
pub fn {{ op.op_name }}({% for a in req %}{{ a.arg_name }}: {{ a.gleam_type }}{% if not loop.last %}, {% endif %}{% endfor %}) -> Result(Dynamic, Dynamic)
{%- endfor %}
