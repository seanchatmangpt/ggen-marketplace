      @long_cases |> Enum.flat_map(fn {_id, seq} -> seq end) |> MapSet.new()

    assert MapSet.subset?(MapSet.new(@fragment_vocabulary), long_vocabulary)

    # No two long-trace events are ever raw-adjacent: consecutive arrivals
    # always cross a case boundary here too.
    case_ids = events |> arrival_order() |> Enum.map(fn e -> e.attributes[@case_attr_key] end)
    refute Enum.any?(Enum.zip(case_ids, Enum.drop(case_ids, 1)), fn {a, b} -> a == b end)
  end

  test "stress: the long traces' true edges are still recovered EXACTLY under 300 interleaved fragments" do
    assert edge_tuples(stress_events()) == @long_expected_edges
    assert edge_pairs(stress_events()) == true_pairs(@long_cases)

    # 3 long traces x 5 adjacent pairs = 15 pair observations, and not one more:
    # every single-event case contributed exactly zero adjacent pairs.
    assert Enum.sum(Enum.map(@long_expected_edges, fn {_s, _t, f} -> f end)) == 15
  end

  test "stress: the 300 fragments are provably inert - removing them changes nothing" do
    # Provenance-level proof, not a name-level one: the fragments share the
    # long traces' whole activity vocabulary, so "no edge mentions a fragment
    # activity" would be vacuous. Instead, discovery over long-traces-only
    # must equal discovery over long-traces-plus-300-fragments.
    with_fragments = edge_tuples(stress_events())
    without_fragments = edge_tuples(long_only_events())

    assert with_fragments == without_fragments
    assert with_fragments == @long_expected_edges
  end

  test "stress: discovery stays order-independent at 318 events across four permutations" do
    base = stress_events()

    permutations = [
      base,
      Enum.reverse(base),
      arrival_order(base),
      Enum.sort_by(base, fn e -> {e.event_type, e.event_id} end)
    ]

    orderings = Enum.map(permutations, fn p -> Enum.map(p, fn e -> e.event_id end) end)
    assert length(Enum.uniq(orderings)) == 4

    results =
      Enum.map(permutations, fn p ->
        p
        |> discover_edges()
        |> Enum.map(fn e -> {e.source_activity, e.target_activity, e.frequency} end)
      end)

    assert Enum.uniq(results) == [@long_expected_edges]
  end
