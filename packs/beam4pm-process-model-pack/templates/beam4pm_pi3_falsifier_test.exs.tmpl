    assert out_of_close == []
  end

  test "shared activity name pay: shared by two unrelated processes, with exact - not inflated - frequencies" do
    tuples = edge_tuples(concurrent_events())

    sharers =
      @concurrent_cases
      |> Enum.filter(fn {_case_id, seq} -> "pay" in seq end)
      |> Enum.map(fn {case_id, _seq} -> case_id end)

    assert sharers == ["chk_1", "sub_1"]

    into_pay = Enum.filter(tuples, fn {_s, t, _f} -> t == "pay" end)
    out_of_pay = Enum.filter(tuples, fn {s, _t, _f} -> s == "pay" end)

    # add_to_cart -> pay comes only from chk_1, verify_email -> pay only from
    # sub_1: exactly one each, never merged into a single inflated edge.
    assert into_pay == [{"add_to_cart", "pay", 1}, {"verify_email", "pay", 1}]

    # (pay, close) is frequency EXACTLY 2 (chk_1 and sub_1), not 3. This is
    # the frequency-side falsifier for the two raw-adjacent cross-case pairs
    # that set membership alone cannot separate: sub_1's pay is raw-adjacent
    # to chk_1's close in arrival order, and chk_1's verify_email neighbour
    # likewise - a leak would show up here as 3, not as a new edge.
    assert out_of_pay == [{"pay", "close", 2}]
  end

  # ==========================================================================
  # HALF 2(c) - FALSE ADJACENCY under a flood of single-event case fragments
  # ==========================================================================

  test "stress fixture shape: 300 single-event fragments woven between 18 long-trace events" do
    events = stress_events()

    assert length(events) == 318

    traces = discover_traces(events)
    assert length(traces) == 303

    by_length = Enum.frequencies_by(traces, fn t -> length(t.activity_sequence) end)
    assert by_length == %{1 => 300, 6 => 3}

    # Every single-event trace is a fragment; every 6-event trace is a long case.
    singles = Enum.filter(traces, fn t -> length(t.activity_sequence) == 1 end)
    assert Enum.all?(singles, fn t -> String.starts_with?(t.case_id, "frag_") end)

    longs = Enum.filter(traces, fn t -> length(t.activity_sequence) == 6 end)
    assert Enum.map(longs, fn t -> {t.case_id, t.activity_sequence} end) == @long_cases

    # The fragments draw their activity names ENTIRELY from the long traces'
    # own vocabulary - maximum name-collision pressure, no "safe" tokens.
    long_vocabulary =
      @long_cases |> Enum.flat_map(fn {_id, seq} -> seq end) |> MapSet.new()

    assert MapSet.subset?(MapSet.new(@fragment_vocabulary), long_vocabulary)

    # No two long-trace events are ever raw-adjacent: consecutive arrivals
    # always cross a case boundary here too.
    case_ids = events |> arrival_order() |> Enum.map(fn e -> e.attributes[@case_attr_key] end)
    refute Enum.any?(Enum.zip(case_ids, Enum.drop(case_ids, 1)), fn {a, b} -> a == b end)
  end

  test "stress: the long traces' true edges are still recovered EXACTLY under 300 interleaved fragments" do
    assert edge_tuples(stress_events()) == @long_expected_edges
    assert edge_pairs(stress_events()) == true_pairs(@long_cases)

    # 3 long traces x 5 adjacent pairs = 15 pair observations, and not one more:
    # every single-event case contributed exactly zero adjacent pairs.
    assert Enum.sum(Enum.map(@long_expected_edges, fn {_s, _t, f} -> f end)) == 15
  end

  test "stress: the 300 fragments are provably inert - removing them changes nothing" do
    # Provenance-level proof, not a name-level one: the fragments share the
    # long traces' whole activity vocabulary, so "no edge mentions a fragment
    # activity" would be vacuous. Instead, discovery over long-traces-only
    # must equal discovery over long-traces-plus-300-fragments.
    with_fragments = edge_tuples(stress_events())
    without_fragments = edge_tuples(long_only_events())

    assert with_fragments == without_fragments
    assert with_fragments == @long_expected_edges
  end

  test "stress: discovery stays order-independent at 318 events across four permutations" do
    base = stress_events()

    permutations = [
      base,
      Enum.reverse(base),
      arrival_order(base),
      Enum.sort_by(base, fn e -> {e.event_type, e.event_id} end)
    ]

    orderings = Enum.map(permutations, fn p -> Enum.map(p, fn e -> e.event_id end) end)
    assert length(Enum.uniq(orderings)) == 4

    results =
      Enum.map(permutations, fn p ->
        p
        |> discover_edges()
        |> Enum.map(fn e -> {e.source_activity, e.target_activity, e.frequency} end)
      end)

    assert Enum.uniq(results) == [@long_expected_edges]
  end

  # ==========================================================================
  # HALF 3 - ADVERSARIAL RE-VERIFICATION: fixtures targeting failure modes
  # the two halves above do not exercise, plus a permanent non-vacuousness
  # regression for the equality assertions used throughout this suite.
  # ==========================================================================

  @lockstep_cases [
    {"L1", ["x1", "x2", "x3", "x4"]},
    {"L2", ["x1", "x2", "x3", "x4"]}
  ]

  defp lockstep_events,
    do: @lockstep_cases |> interleave() |> events_from_arrivals("ls") |> scramble()

  test "lockstep identical-sequence cases: raw arrival order really does interleave one event apart" do
    by_arrival = arrival_order(lockstep_events())

    assert Enum.map(by_arrival, fn e -> e.attributes[@case_attr_key] end) ==
             ["L1", "L2", "L1", "L2", "L1", "L2", "L1", "L2"]

    assert Enum.map(by_arrival, fn e -> e.event_type end) ==
             ["x1", "x1", "x2", "x2", "x3", "x3", "x4", "x4"]
  end

  test "lockstep identical-sequence cases: traces_from_events partitions correctly despite identical activities" do
    traces = discover_traces(lockstep_events())

    assert Enum.map(traces, fn t -> {t.case_id, t.activity_sequence} end) == [
             {"L1", ["x1", "x2", "x3", "x4"]},
             {"L2", ["x1", "x2", "x3", "x4"]}
           ]
  end

  test "lockstep identical-sequence cases: NO self-loops are manufactured (the global-concatenation signature)" do
    discovered = edge_pairs(lockstep_events())

    # A global-concatenation bug over the raw arrival stream
    # x1,x1,x2,x2,x3,x3,x4,x4 would manufacture (x1,x1), (x2,x2), (x3,x3),
    # (x4,x4) as directly-follows edges. None of these are real within-case
    # adjacencies in either L1 or L2's own sequence.
    for self_loop <- [{"x1", "x1"}, {"x2", "x2"}, {"x3", "x3"}, {"x4", "x4"}] do
      refute MapSet.member?(discovered, self_loop),
             "false self-loop #{inspect(self_loop)} leaked from unpartitioned adjacency"
    end

    assert discovered == MapSet.new([{"x1", "x2"}, {"x2", "x3"}, {"x3", "x4"}])
  end

  test "lockstep identical-sequence cases: exact frequencies are 2 per edge (one per case), not inflated" do
    assert edge_tuples(lockstep_events()) == [
             {"x1", "x2", 2},
             {"x2", "x3", 2},
             {"x3", "x4", 2}
           ]
  end

  test "case_id equal to an activity name elsewhere in the log: no contamination between namespaces" do
    # Case "pay" (case_id == "pay", a string that also occurs as an activity
    # name in case "other") runs its own sequence a -> b -> c. Case "other"
    # runs pay -> ship, i.e. activity "pay" really occurs, under a DIFFERENT
    # case_id ("other").
    #
    # The expected trace order below, ["other", "pay"], is case_id-
    # lexicographic, NOT first-occurrence order (case "pay" is the one that
    # occurs first, at t=0): traces_from_events/2 sorts by case_id, matching
    # @known_cases' own comment ("listed in case_id order, which is also the
    # order traces_from_events/2 returns them in") -- this fixture is the
    # first one in the file where case_id order and first-occurrence order
    # actually diverge, so it is the real falsifier of that convention.
    events =
      [
        event!("e0", "a", ts(0), %{@case_attr_key => "pay"}),
        event!("e1", "pay", ts(1), %{@case_attr_key => "other"}),
        event!("e2", "b", ts(2), %{@case_attr_key => "pay"}),
        event!("e3", "ship", ts(3), %{@case_attr_key => "other"}),
        event!("e4", "c", ts(4), %{@case_attr_key => "pay"})
      ]
      |> scramble()

    traces = discover_traces(events)

    assert Enum.map(traces, fn t -> {t.case_id, t.activity_sequence} end) == [
             {"other", ["pay", "ship"]},
             {"pay", ["a", "b", "c"]}
           ]

    discovered = edge_pairs(events)

    # The case_id "pay" must never itself be treated as an activity, and the
    # activity "pay" (from case "other") must not bleed into case "pay"'s own
    # sequence (which contains no activity literally named "pay" at all).
    assert discovered == MapSet.new([{"a", "b"}, {"b", "c"}, {"pay", "ship"}])
    refute MapSet.member?(discovered, {"pay", "a"})
    refute MapSet.member?(discovered, {"c", "pay"})
  end

  @large_case_count 2000

  defp large_cases do
    Enum.map(1..@large_case_count, fn i ->
      {"case_#{pad(i, 5)}", ["start", "end"]}
    end)
  end

  test "2000 identical two-activity cases interleaved: exact edge set and frequency, zero self-loops" do
    events = large_cases() |> interleave() |> events_from_arrivals("lg") |> scramble()

    assert length(events) == @large_case_count * 2

    traces = discover_traces(events)
    assert length(traces) == @large_case_count
    assert Enum.all?(traces, fn t -> t.activity_sequence == ["start", "end"] end)

    tuples = edge_tuples(events)

    # Exactly one edge type, frequency exactly @large_case_count -- not more
    # (self-loops or interleave crossovers leaked in) and not fewer (cases
    # merged or dropped).
    assert tuples == [{"start", "end", @large_case_count}]

    pairs = edge_pairs(events)
    refute MapSet.member?(pairs, {"end", "start"})
    refute MapSet.member?(pairs, {"start", "start"})
    refute MapSet.member?(pairs, {"end", "end"})
  end

  test "2000-case discovery is order-independent across reverse/arrival/event-type orderings (4000 events total)" do
    base = large_cases() |> interleave() |> events_from_arrivals("lg2") |> scramble()

    assert length(base) == @large_case_count * 2

    permutations = [
      base,
      Enum.reverse(base),
      arrival_order(base),
      Enum.sort_by(base, fn e -> {e.event_type, e.event_id} end)
    ]

    # Same distinctness self-check the file's other order-independence tests
    # use: without it, this test would silently lose coverage of a
    # permutation that happened to coincide with another, while staying
    # green.
    orderings = Enum.map(permutations, fn p -> Enum.map(p, fn e -> e.event_id end) end)
    assert length(Enum.uniq(orderings)) == 4

    results =
      Enum.map(permutations, fn p ->
        p
        |> discover_edges()
        |> Enum.map(fn e -> {e.source_activity, e.target_activity, e.frequency} end)
      end)

    assert Enum.uniq(results) == [[{"start", "end", @large_case_count}]]
  end

  test "non-vacuousness: discovered edges do NOT match a deliberately edge-removed expected set" do
    # Real, permanent regression proof that ONE specific two-sided equality
    # assertion -- the KNOWN SEEDED PROCESS half's @true_process_edges check
    # -- is not vacuously true: if discovery ever regressed to drop
    # @true_process_edges' first edge, this comparison against the
    # (deliberately wrong) edge-removed truth set would then SUCCEED where
    # it must not -- so THIS test fails the moment that happens, rather than
    # relying on a one-time manual check that proved it once and was never
    # re-run. This does NOT, by itself, prove the other equality assertions
    # in this file (concurrent/stress/lockstep/large-scale) are equally
    # non-vacuous -- each of those already carries its own named-spurious-
    # edge or exact-frequency falsifier instead; see the moduledoc.
    [removed_edge | _] = @true_process_edges
    wrong_truth = @true_process_edges |> MapSet.new() |> MapSet.delete(removed_edge)

    discovered = edge_pairs(known_events())

    refute discovered == wrong_truth
    assert MapSet.member?(discovered, removed_edge)
  end
