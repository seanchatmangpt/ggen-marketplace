---
to: "schema/pddl/{{ process_id }}.problem.pddl"
sparql:
  contracts: |
    PREFIX bpmg: <https://ggen.dev/ontology/beam4pm-process-governor#>
    SELECT ?process_id ?initial_state WHERE {
      ?c a bpmg:ProcessContract ;
         bpmg:processId ?process_id ;
         bpmg:initialState ?initial_state .
    } ORDER BY ?process_id
  transitions: |
    PREFIX bpmg: <https://ggen.dev/ontology/beam4pm-process-governor#>
    SELECT ?process_id ?ordinal ?from_state ?to_state ?actuation_name WHERE {
      ?c a bpmg:ProcessContract ;
         bpmg:processId ?process_id ;
         bpmg:hasTransition ?t .
      ?t bpmg:ordinal ?ordinal ;
         bpmg:fromState ?from_state ;
         bpmg:toState ?to_state ;
         bpmg:actuationName ?actuation_name .
    } ORDER BY ?process_id ?ordinal
  states: |
    PREFIX bpmg: <https://ggen.dev/ontology/beam4pm-process-governor#>
    SELECT DISTINCT ?process_id ?state WHERE {
      ?c a bpmg:ProcessContract ;
         bpmg:processId ?process_id .
      { ?c bpmg:initialState ?state }
      UNION { ?c bpmg:hasTransition ?t1 . ?t1 bpmg:fromState ?state }
      UNION { ?c bpmg:hasTransition ?t2 . ?t2 bpmg:toState ?state }
    } ORDER BY ?process_id ?state
  contract_requires: |
    PREFIX bpmg: <https://ggen.dev/ontology/beam4pm-process-governor#>
    PREFIX bpma: <https://ggen.dev/ontology/beam4pm-actuation#>
    SELECT DISTINCT ?process_id ?fact WHERE {
      ?c a bpmg:ProcessContract ;
         bpmg:processId ?process_id ;
         bpmg:hasTransition ?t .
      ?t bpmg:actuationName ?action_name .
      ?a a bpma:AdmittedActuation ;
         bpma:actionName ?action_name ;
         bpma:requiresFact ?fact .
    } ORDER BY ?process_id ?fact
for_each: contracts
---
{%- set pstates = states | filter(attribute="process_id", value=process_id) %}
{%- set ptrans = transitions | filter(attribute="process_id", value=process_id) %}
{%- set preq = contract_requires | filter(attribute="process_id", value=process_id) %}
{%- set goal = ptrans | last -%}
; GENERATED by ggen from the admitted bpmg:ProcessContract graph, projected as
; the PDDL problem for "{{ process_id }}" over {{ process_id }}.domain.pddl. Do not edit.
;
; Formal projection (VISION-2030 section 10): every state named by the
; contract (bpmg:initialState, every bpmg:fromState / bpmg:toState) is a typed
; object; bpmg:initialState is the sole (in_state ...) fact in :init; each
; bpmg:ProcessTransition (in bpmg:ordinal order) becomes one static
; (allows_<bpmg:actuationName> <fromState> <toState>) fact; the highest-ordinal
; transition's bpmg:toState is the :goal. Every bpma:requiresFact of an
; actuation this contract names is asserted in :init as a fact assumed
; satisfied at process start -- delete one and the planner must refuse, not
; fabricate a path.
(define (problem {{ process_id }})
  (:domain {{ process_id }})
  (:objects{% for s in pstates %} {{ s.state }}{% endfor %} - state)
  (:init
    (in_state {{ initial_state }})
{%- for t in ptrans %}
    ; bpmg:ordinal {{ t.ordinal }}
    (allows_{{ t.actuation_name }} {{ t.from_state }} {{ t.to_state }})
{%- endfor %}
{%- for r in preq %}
    ; bpma:requiresFact assumed satisfied at process start
    ({{ r.fact }})
{%- endfor %}
  )
  (:goal (in_state {{ goal.to_state }}))
)
