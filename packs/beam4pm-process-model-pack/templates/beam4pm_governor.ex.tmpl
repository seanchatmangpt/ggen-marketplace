defmodule BeamPM.Runtime do
  @moduledoc "OTP runtime for an admitted process contract. Consequences are bounded state transitions."
  use GenServer

  def start_link(opts) do
    case Keyword.get(opts, :name) do
      nil -> GenServer.start_link(__MODULE__, opts)
      name -> GenServer.start_link(__MODULE__, opts, name: name)
    end
  end

  def execute(server, intent, policy, authority), do: GenServer.call(server, {:execute, intent, policy, authority})
  def snapshot(server), do: GenServer.call(server, :snapshot)
  def receipts(server), do: GenServer.call(server, :receipts)
  def crash(server), do: GenServer.cast(server, :crash)

  @impl true
  def init(opts) do
    process_id = Keyword.fetch!(opts, :process_id)
    subject = Keyword.fetch!(opts, :subject)
    {:ok, snapshot} = BeamPM.Governor.initial_snapshot(process_id, subject)
    {:ok, %{process_id: process_id, snapshot: snapshot, seen: %{}, receipts: []}}
  end

  @impl true
  def handle_call(:snapshot, _from, state), do: {:reply, state.snapshot, state}
  def handle_call(:receipts, _from, state), do: {:reply, Enum.reverse(state.receipts), state}

  def handle_call({:execute, intent, policy, authority}, _from, state) do
    case Map.fetch(state.seen, intent.idempotency_key) do
      {:ok, receipt} ->
        {:reply, {:ok, state.snapshot, receipt, :idempotent_replay}, state}

      :error ->
        case BeamPM.Governor.apply_transition(state.process_id, state.snapshot, intent, policy, authority) do
          {:ok, next, receipt} ->
            updated = %{state | snapshot: next, seen: Map.put(state.seen, intent.idempotency_key, receipt), receipts: [receipt | state.receipts]}
            {:reply, {:ok, next, receipt, :executed}, updated}

          {:refused, reason} = refusal ->
            _ = reason
            {:reply, refusal, state}
        end
    end
  end

  @impl true
  def handle_cast(:crash, _state), do: raise("beam4pm-runtime-crash-falsifier")
end

defmodule BeamPM.RuntimeSupervisor do
  @moduledoc "One-for-one OTP supervision boundary for governed runtimes."
  use Supervisor

  def start_link(opts), do: Supervisor.start_link(__MODULE__, opts)

  @impl true
  def init(opts) do
    runtime_opts = Keyword.fetch!(opts, :runtime)
    Supervisor.init([{BeamPM.Runtime, runtime_opts}], strategy: :one_for_one)
  end
end
