    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?transition_id ?from_state ?to_state ?capability ?timeout_ms ?max_retries WHERE {
      ?t a bpm:TransitionSpec ;
         bpm:transitionId ?transition_id ;
         bpm:fromState ?from_state ;
         bpm:toState ?to_state ;
         bpm:requiredCapability ?capability ;
         bpm:timeoutMs ?timeout_ms ;
         bpm:maxRetries ?max_retries .
