---
to: gleam/src/beam4pm/types.gleam
sparql:
  records: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:recordDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order ?gleam_type_expr WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:hasField ?f .
      ?f bpm:fieldName ?field_name ; bpm:fieldType ?field_type ; bpm:fieldDoc ?field_doc ;
         bpm:fieldRequired ?field_required ; bpm:fieldOrder ?field_order .
      ?ft a bpm:FieldType ; bpm:fieldTypeName ?field_type ; bpm:gleamTypeExpr ?gleam_type_expr .
    } ORDER BY ?record_name ?field_order
---
// GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
//
// DISCLOSED projection divergences (Gleam has no direct equivalent):
//   - bpm:fieldType "atom" projects to String (Gleam has no atom literal type).
//   - bpm:fieldType "map"  projects to dict.Dict(String, String) (a string-valued
//     attribute map), narrower than the Erlang map()/Elixir map() projections.
// Non-required fields project to option.Option(inner type).

import gleam/dict
import gleam/option

{% for r in records %}{% set rfields = fields | filter(attribute="record_name", value=r.record_name) %}{% set type_name = r.record_name | replace(from="_", to=" ") | title | replace(from=" ", to="") %}/// {{ r.record_doc }}
pub type {{ type_name }} {
  {{ type_name }}(
{% for f in rfields %}    /// {{ f.field_doc }}
    {{ f.field_name }}: {% if f.field_required == "false" %}option.Option({% endif %}{{ f.gleam_type_expr }}{% if f.field_required == "false" %}){% endif %},
{% endfor %}  )
}

{% endfor %}