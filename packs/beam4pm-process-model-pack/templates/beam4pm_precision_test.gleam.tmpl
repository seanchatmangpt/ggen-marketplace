// GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
//
// Chicago-style tests for beam4pm/precision, run against the exact same
// 8-event/3-case order-to-ship seeded log as
// test/beam4pm_precision_tests.erl and test/beam4pm_precision_test.exs plus
// a genuinely deviant trace. Every expected value below is computed by hand
// in the comment above its assertion from the same ETC escaping-edges
// formula beam4pm/precision implements -- see that module for the full
// derivation.

import beam4pm/discovery
import beam4pm/precision
import beam4pm/types
import gleam/dict
import gleam/option

fn ev(
  id: String,
  activity: String,
  time: String,
  case_id: String,
) -> types.OcelEvent {
  types.OcelEvent(
    event_id: id,
    event_type: activity,
    event_time: time,
    attributes: option.Some(dict.from_list([#("case_id", case_id)])),
  )
}

fn trace(case_id: String, sequence: List(String)) -> types.LogTrace {
  types.LogTrace(case_id: case_id, activity_sequence: sequence)
}

// c1 and c2 both walk receive_order -> validate_order -> ship_order; c3
// skips straight receive_order -> ship_order. Discovering the DFG from all
// three gives receive_order out-degree 2 (branches to BOTH validate_order
// and ship_order) -- exactly the shape that makes ETC precision diverge
// from fitness.
fn seed_events() -> List(types.OcelEvent) {
  [
    ev("e5", "validate_order", "2026-08-29T10:05:00Z", "c2"),
    ev("e1", "receive_order", "2026-08-29T10:00:00Z", "c1"),
    ev("e6", "ship_order", "2026-08-29T10:06:00Z", "c2"),
    ev("e2", "validate_order", "2026-08-29T10:01:00Z", "c1"),
    ev("e4", "receive_order", "2026-08-29T10:04:00Z", "c2"),
    ev("e3", "ship_order", "2026-08-29T10:02:00Z", "c1"),
    ev("e7", "receive_order", "2026-08-29T10:07:00Z", "c3"),
    ev("e8", "ship_order", "2026-08-29T10:08:00Z", "c3"),
  ]
}

fn seeded_edges() -> List(types.DfgEdge) {
  seed_events()
  |> discovery.traces_from_events("case_id")
  |> discovery.dfg_from_traces()
}

// Discovered DFG has the exact branching shape this suite's by-hand math
// assumes: receive_order -> ship_order freq 1, receive_order ->
// validate_order freq 2, validate_order -> ship_order freq 2. out-degree
// (receive_order)=2, out-degree(validate_order)=1, out-degree(ship_order)=0.
pub fn dfg_shape_test() {
  let edges = seeded_edges()
  assert edges
    == [
      types.DfgEdge(
        source_activity: "receive_order",
        target_activity: "ship_order",
        frequency: 1,
      ),
      types.DfgEdge(
        source_activity: "receive_order",
        target_activity: "validate_order",
        frequency: 2,
      ),
      types.DfgEdge(
        source_activity: "validate_order",
        target_activity: "ship_order",
        frequency: 2,
      ),
    ]
}

// By hand: pair (receive_order,validate_order) -> enabled=out_degree
// (receive_order)=2, taken pair is a known edge -> escaping=max(0,2-1)=1.
// pair (validate_order,ship_order) -> enabled=out_degree(validate_order)=1,
// taken pair is a known edge -> escaping=max(0,1-1)=0.
// total_enabled=2+1=3, total_escaping=1+0=1, precision=1.0-1/3=0.6666666666666667.
// Fitness for the SAME trace is a perfect 1.0 -- proof precision is a
// genuinely different metric, not fitness under a new name.
pub fn c1_perfectly_fitting_but_imprecise_test() {
  let edges = seeded_edges()
  let c1 = trace("c1", ["receive_order", "validate_order", "ship_order"])
  assert precision.etc_precision(edges, c1) == 0.6666666666666667
  let result = discovery.conformance(edges, c1)
  assert result.fitness == 1.0
  assert result.precision == option.Some(0.6666666666666667)
}

pub fn c2_agrees_with_c1_test() {
  let edges = seeded_edges()
  let c2 = trace("c2", ["receive_order", "validate_order", "ship_order"])
  assert precision.etc_precision(edges, c2) == 0.6666666666666667
}

// By hand: one pair (receive_order,ship_order); enabled=out_degree
// (receive_order)=2; it IS a known edge -> escaping=max(0,2-1)=1.
// total_enabled=2, total_escaping=1, precision=1.0-1/2=0.5.
pub fn c3_shorter_trace_test() {
  let edges = seeded_edges()
  let c3 = trace("c3", ["receive_order", "ship_order"])
  assert precision.etc_precision(edges, c3) == 0.5
}

// By hand: pair (receive_order,cancel_order) is NOT a known edge (a pure
// log move) -> escaping=enabled=out_degree(receive_order)=2.
// total_enabled=2, total_escaping=2, precision=1.0-2/2=0.0.
pub fn deviant_trace_is_zero_precision_test() {
  let edges = seeded_edges()
  let deviant = trace("d1", ["receive_order", "cancel_order"])
  assert precision.etc_precision(edges, deviant) == 0.0
  let result = discovery.conformance(edges, deviant)
  assert result.fitness == 0.0
  assert result.precision == option.Some(0.0)
}

// Fewer than two activities -> no state transition to evaluate -> honestly
// 1.0, regardless of the model (even an empty one).
pub fn short_trace_is_one_precision_test() {
  let edges = seeded_edges()
  let short = trace("c3", ["receive_order"])
  assert precision.etc_precision(edges, short) == 1.0
  assert precision.etc_precision([], short) == 1.0
}

// total_enabled=0 and total_escaping=0 when the model has no edges at all
// leaving the trace's activities -> the same safe 1.0 fallback ex4pm's own
// Ex4pmEngine.ETCPrecision.calculate_precision/3 uses for an empty
// denominator.
pub fn empty_model_is_one_precision_test() {
  let no_edge_trace = trace("x", ["a", "b"])
  assert precision.etc_precision([], no_edge_trace) == 1.0
}

// alpha=0.0 (default): 0.5 (as above). With alpha=1.0: denominator becomes
// total_enabled + 1.0*total_escaping = 2 + 1 = 3, precision = 1.0 - 1/3 =
// 0.6666666666666667 -- proof alpha is real and wired through, not a
// decorative unused parameter.
pub fn alpha_smoothing_test() {
  let edges = seeded_edges()
  let c3 = trace("c3", ["receive_order", "ship_order"])
  assert precision.etc_precision_with_alpha(edges, c3, 0.0) == 0.5
  assert precision.etc_precision_with_alpha(edges, c3, 1.0)
    == 0.6666666666666667
}
