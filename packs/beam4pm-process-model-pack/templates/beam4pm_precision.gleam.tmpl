// GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
//
// ETC (Escaping-edge Trace Conformance) precision for one trace against a
// directly-follows model, structurally adapted from the real Adriansyah/
// Dongen/Van der Aalst escaping-edges formula already implemented in
// ex4pm's Ex4pmEngine.ETCPrecision
// (apps/ex4pm_engine/lib/ex4pm_engine/etc_precision.ex in the ex4pm repo):
//
//   Precision_ETC(L, N, alpha) =
//     1.0 - (sum |EscapingEdges(s)| / (sum |Enabled(s)| + alpha * sum |EscapingEdges(s)|))
//
// ex4pm's original walks a Petri-net marking automaton: a "state" is a
// marking, and the transitions "enabled" in a state are those whose input
// places are all marked; at each replayed move it counts how many enabled
// transitions were NOT the one actually taken ("escaping edges") against how
// many were enabled in total, then aggregates across the whole log.
//
// beam4pm's admitted model is a directly-follows graph (a DfgEdge list),
// not a Petri net, so this module reduces the SAME automaton concept onto
// that representation instead of inventing a different metric: a "state" is
// the current activity, and the transitions "enabled" out of a state are the
// distinct model edges whose source is that activity. The per-step
// escaping-edge rule below is the same policy as ex4pm's
// replay_moves_for_etc/3, restated over directly-follows edges:
//
//   * enabled_count = out-degree of the current activity in the model (the
//     number of distinct edges the model admits leaving that activity).
//   * escaping_count = max(0, enabled_count - 1) when the trace's actual
//     next activity IS one of those model edges (a "synchronous move": the
//     model offered several options, exactly one was taken, the rest went
//     unobserved / "escaped"); enabled_count (every one of them) when the
//     trace's next activity is NOT a model edge at all (a pure "log move":
//     none of the model's predictions from this state matched, so
//     everything the model offered here escaped observation).
//
// total_enabled/total_escaping accumulate these counts across every adjacent
// pair of exactly ONE trace, matching beam4pm/discovery's conformance/2
// existing per-trace contract (ex4pm's version aggregates over an entire
// log to score one model; this is the same sum specialized to a log of one
// trace). alpha (default 0.0, ex4pm's negative_event_weight smoothing knob)
// is exposed as etc_precision_with_alpha's third argument for the identical
// reason ex4pm exposes it.
//
// Admitted record types this module operates over (2):
//   * dfg_edge - One frequency-annotated directly-follows edge between two activities.
//   * log_trace - One case-centric trace: an ordered activity sequence for a single case.

import beam4pm/types
import gleam/dict
import gleam/int
import gleam/list
import gleam/option
import gleam/set

/// ETC precision of `trace`'s activity sequence against the directly-follows
/// model `edges`, with alpha=0.0 (see `etc_precision_with_alpha` for the
/// smoothing weight). A trace with fewer than two activities has no state
/// transition to evaluate: nothing was observed, so nothing could escape,
/// and precision is honestly 1.0 -- the same convention
/// beam4pm/discovery.conformance uses for fitness on such traces.
pub fn etc_precision(
  edges: List(types.DfgEdge),
  trace: types.LogTrace,
) -> Float {
  etc_precision_with_alpha(edges, trace, 0.0)
}

/// ETC precision of `trace`'s activity sequence against the directly-follows
/// model `edges`. `alpha` is the escaping-edge smoothing weight described in
/// this module's header comment.
pub fn etc_precision_with_alpha(
  edges: List(types.DfgEdge),
  trace: types.LogTrace,
  alpha: Float,
) -> Float {
  case list.window_by_2(trace.activity_sequence) {
    [] -> 1.0
    pairs -> {
      let outgoing = out_degrees(edges)
      let known =
        edges
        |> list.map(fn(edge) { #(edge.source_activity, edge.target_activity) })
        |> set.from_list

      let #(total_enabled, total_escaping) =
        list.fold(pairs, #(0, 0), fn(acc, pair) {
          let #(enabled_acc, escaping_acc) = acc
          let #(from, _to) = pair
          let enabled = case dict.get(outgoing, from) {
            Ok(n) -> n
            Error(Nil) -> 0
          }
          let escaping = case set.contains(known, pair) {
            True ->
              case enabled - 1 {
                n if n > 0 -> n
                _ -> 0
              }
            False -> enabled
          }
          #(enabled_acc + enabled, escaping_acc + escaping)
        })

      let denominator =
        int.to_float(total_enabled) +. alpha *. int.to_float(total_escaping)

      case denominator >. 0.0 {
        True -> {
          let raw =
            1.0 -. int.to_float(total_escaping) /. denominator
          case raw >. 0.0 {
            True -> raw
            False -> 0.0
          }
        }
        False -> 1.0
      }
    }
  }
}

/// Internal: number of distinct model edges leaving each source activity
/// (the automaton's "enabled transition count" per state).
fn out_degrees(edges: List(types.DfgEdge)) -> dict.Dict(String, Int) {
  edges
  |> list.map(fn(edge) { #(edge.source_activity, edge.target_activity) })
  |> list.unique
  |> list.fold(dict.new(), fn(acc, pair) {
    let #(source, _target) = pair
    dict.upsert(acc, source, fn(existing) {
      case existing {
        option.Some(n) -> n + 1
        option.None -> 1
      }
    })
  })
}
