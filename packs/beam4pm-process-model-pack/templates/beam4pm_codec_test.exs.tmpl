---
to: test/beam4pm_codec_test.exs
sparql:
  records: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a bpm:RecordType ;
          bpm:recordName ?record_name ;
          bpm:recordDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order ?sample_elixir ?sample_elixir_encoded WHERE {
      ?rt a bpm:RecordType ;
          bpm:recordName ?record_name ;
          bpm:hasField ?f .
      ?f bpm:fieldName ?field_name ;
         bpm:fieldType ?field_type ;
         bpm:fieldDoc ?field_doc ;
         bpm:fieldRequired ?field_required ;
         bpm:fieldOrder ?field_order .
      ?ft a bpm:FieldType ; bpm:fieldTypeName ?field_type ;
          bpm:sampleElixir ?sample_elixir ; bpm:sampleElixirEncoded ?sample_elixir_encoded .
    } ORDER BY ?record_name ?field_order
---
# GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
defmodule BeamPM.Codec.GeneratedTest do
  use ExUnit.Case, async: true

  # Correct-by-construction: `BeamPM.Codec.to_map/from_map/encode/decode`
  # dispatch generically off the same admitted `bpm:RecordType`/field graph
  # this template reads -- so what needs proving is that the codec's
  # generic dispatch pattern holds for every admitted record, not that each
  # individual record projection works in isolation. Previously this file
  # emitted up to 5 separate ExUnit `test` blocks per record type (~1800
  # total test-process spawns for ~90 admitted types). The 5 runtime-
  # iterated tests below preserve exactly the same per-record, per-field
  # assertions (every admitted record is still individually checked, by
  # name, inside each loop) while cutting ExUnit's per-test scheduling
  # overhead ~90x. Run via `mix test` (default) -- no longer gated behind
  # :chicago; this is now fast.

  @records [
{% for r in records %}{% set rfields = fields | filter(attribute="record_name", value=r.record_name) %}{% set req_str = rfields | filter(attribute="field_required", value="true") %}{% set req_bool = rfields | filter(attribute="field_required", value=true) %}{% set req = req_str | concat(with=req_bool) %}{% set opt_str = rfields | filter(attribute="field_required", value="false") %}{% set opt_bool = rfields | filter(attribute="field_required", value=false) %}{% set opt = opt_str | concat(with=opt_bool) %}{% set mod_name = r.record_name | replace(from="_", to=" ") | title | replace(from=" ", to="") %}
    %{
      name: :{{ r.record_name }},
      mod: BeamPM.Types.{{ mod_name }},
      full_attrs: %{
{% for f in rfields %}        {{ f.field_name }}: {{ f.sample_elixir | replace(from="__FIELD__", to=f.field_name) }}{% if not loop.last %},{% endif %}
{% endfor %}      },
      expected_map: %{
{% for f in rfields %}        "{{ f.field_name }}" => {{ f.sample_elixir_encoded | replace(from="__FIELD__", to=f.field_name) }}{% if not loop.last %},{% endif %}
{% endfor %}      },
      req_attrs: %{
{% for f in req %}        {{ f.field_name }}: {{ f.sample_elixir | replace(from="__FIELD__", to=f.field_name) }}{% if not loop.last %},{% endif %}
{% endfor %}      },
      req_count: {{ req | length }},
      opt_field_names: [{% for f in opt %}"{{ f.field_name }}"{% if not loop.last %}, {% endif %}{% endfor %}],
      first_required: {% if req | length > 0 %}{% set fr = req | first %}:{{ fr.field_name }}{% else %}nil{% endif %}
    }{% if not loop.last %},{% endif %}
{% endfor %}  ]

  test "from_map returns unknown_record for an unadmitted record name" do
    assert {:error, {:unknown_record, :not_a_real_record}} =
             BeamPM.Codec.from_map(:not_a_real_record, %{})
  end

  test "decode returns unknown_record for an unadmitted record name" do
    assert {:error, {:unknown_record, :not_a_real_record}} =
             BeamPM.Codec.decode(:not_a_real_record, "{}")
  end

  test "decode wraps invalid JSON input in an error tuple" do
    assert {:error, _} = BeamPM.Codec.decode(:not_a_real_record, "this is not json")
  end

  test "decode rejects JSON that is not an object" do
    assert {:error, {:not_a_json_object, [1, 2, 3]}} =
             BeamPM.Codec.decode(:not_a_real_record, "[1,2,3]")
  end

  test "every admitted record type's to_map/from_map roundtrip (full variant) has exact map values" do
    for r <- @records do
      assert {:ok, rec} = r.mod.new(r.full_attrs), "#{r.name}: new/1 failed"
      m = BeamPM.Codec.to_map(rec)

      for {k, v} <- r.expected_map do
        assert m[k] == v, "#{r.name}: to_map/1 key #{k} expected #{inspect(v)}, got #{inspect(m[k])}"
      end

      assert map_size(m) == map_size(r.expected_map), "#{r.name}: to_map/1 size mismatch"
      assert {:ok, ^rec} = BeamPM.Codec.from_map(r.name, m), "#{r.name}: from_map/2 roundtrip failed"

      assert {:ok, ^rec} = BeamPM.Codec.from_map(r.name, Map.put(m, "definitely_unknown_key", "x")),
             "#{r.name}: from_map/2 did not ignore an unknown key"
    end
  end

  test "every admitted record type's encode/decode JSON roundtrip (full variant) succeeds" do
    for r <- @records do
      assert {:ok, rec} = r.mod.new(r.full_attrs), "#{r.name}: new/1 failed"
      json = BeamPM.Codec.encode(rec)
      assert is_binary(json), "#{r.name}: encode/1 did not return a binary"
      assert {:ok, ^rec} = BeamPM.Codec.decode(r.name, json), "#{r.name}: decode/2 JSON roundtrip failed"
    end
  end

  test "every admitted record type's from_map reports its real required/empty-map behavior" do
    for r <- @records do
      case r.first_required do
        nil ->
          assert {:ok, _} = BeamPM.Codec.from_map(r.name, %{}),
                 "#{r.name}: expected {:ok, _} for from_map(%{}) since no fields are required"

        field ->
          assert {:error, {:missing_field, ^field}} = BeamPM.Codec.from_map(r.name, %{}),
                 "#{r.name}: expected {:error, {:missing_field, #{inspect(field)}}} for from_map(%{})"
      end
    end
  end

  test "every admitted record type with optional fields omits nils in to_map (minimal variant roundtrip)" do
    for r <- @records, r.opt_field_names != [] do
      assert {:ok, rec} = r.mod.new(r.req_attrs), "#{r.name}: new/1 with only required fields failed"
      m = BeamPM.Codec.to_map(rec)

      for name <- r.opt_field_names do
        refute Map.has_key?(m, name), "#{r.name}: to_map/1 did not omit optional field #{name}"
      end

      assert map_size(m) == r.req_count, "#{r.name}: to_map/1 minimal-variant size mismatch"
      assert {:ok, ^rec} = BeamPM.Codec.from_map(r.name, m), "#{r.name}: from_map/2 minimal-variant roundtrip failed"
    end
  end
end
