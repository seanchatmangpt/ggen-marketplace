%% ===========================================================================
%% Real fixture construction (real constructors, no doubles).
%% ===========================================================================

ev(Id, Type, Time, Attributes) ->
    {ok, Ev} = beam4pm_types:new_ocel_event(
        #{event_id => Id, event_type => Type, event_time => Time,
          attributes => Attributes}),
    Ev.

trace(CaseId, Seq) ->
    {ok, Trace} = beam4pm_types:new_log_trace(
        #{case_id => CaseId, activity_sequence => Seq}),
    Trace.

%% Zero-padded microseconds keep lexicographic order identical to numeric
%% order, which is exactly what traces_from_events/2 sorts on.
ts(Index) ->
    list_to_binary(io_lib:format("2026-08-30T00:00:00.~6..0BZ", [Index])).

event_id(Prefix, Index) ->
    list_to_binary(io_lib:format("~s~6..0B", [Prefix, Index])).

frag_case_id(Index) ->
    list_to_binary(io_lib:format("frag_~4..0B", [Index])).

%% Round-robin weave: emit step 1 of every case, then step 2 of every case,
%% and so on. Consecutive arrivals therefore always belong to different cases
%% -- the adversarial premise, asserted below rather than assumed.
interleave(Cases) ->
    MaxLen = lists:max([length(Seq) || {_Id, Seq} <- Cases]),
    lists:append([step_arrivals(Cases, Step) || Step <- lists:seq(1, MaxLen)]).

step_arrivals(Cases, Step) ->
    [{CaseId, lists:nth(Step, Seq)} || {CaseId, Seq} <- Cases, length(Seq) >= Step].

%% Arrival index becomes both event_time and event_id, so "raw stream order"
%% and "timestamp order" are the same thing for these fixtures.
events_from_arrivals(Arrivals, Prefix) ->
    Indexed = lists:zip(lists:seq(0, length(Arrivals) - 1), Arrivals),
    [arrival_event(Prefix, Index, Arrival) || {Index, Arrival} <- Indexed].

arrival_event(Prefix, Index, Arrival) ->
    {CaseId, Activity} = Arrival,
    ev(event_id(Prefix, Index), Activity, ts(Index), #{<<"case_id">> => CaseId}).

%% Deterministic scramble (no rand -- these tests must be reproducible).
scramble(Events) ->
    Keyed = [{erlang:phash2(beam4pm_discovery:ocel_event_event_id(E), 1000003),
              beam4pm_discovery:ocel_event_event_id(E), E} || E <- Events],
    [E || {_Hash, _Id, E} <- lists:sort(Keyed)].

arrival_order(Events) ->
    Keyed = [{beam4pm_discovery:ocel_event_event_time(E),
              beam4pm_discovery:ocel_event_event_id(E), E} || E <- Events],
    [E || {_Time, _Id, E} <- lists:sort(Keyed)].

by_type_order(Events) ->
    Keyed = [{beam4pm_discovery:ocel_event_event_type(E),
              beam4pm_discovery:ocel_event_event_id(E), E} || E <- Events],
    [E || {_Type, _Id, E} <- lists:sort(Keyed)].

known_events() ->
    scramble(events_from_arrivals(interleave(known_cases()), "ke")).

concurrent_events() ->
    scramble(events_from_arrivals(interleave(concurrent_cases()), "ce")).

fragment_arrivals() ->
    Vocabulary = fragment_vocabulary(),
    Size = length(Vocabulary),
    [{frag_case_id(I), lists:nth((I rem Size) + 1, Vocabulary)}
     || I <- lists:seq(0, fragment_count() - 1)].

%% Sprinkle the fragments between the long-trace arrivals so no two
%% long-trace events are ever raw-adjacent: every long-trace
%% directly-follows edge must survive a gap of ~17 unrelated single-event
%% cases.
stress_arrivals() ->
    weave(interleave(long_cases()), fragment_arrivals()).

weave(Long, Frags) ->
    ChunkSize = (length(Frags) div length(Long)) + 1,
    weave(Long, Frags, ChunkSize, []).

weave([], Frags, _ChunkSize, Acc) ->
    lists:reverse(Acc) ++ Frags;
weave([L | Long], Frags, ChunkSize, Acc) ->
    {Chunk, Rest} = split_at_most(ChunkSize, Frags),
    weave(Long, Rest, ChunkSize, lists:reverse(Chunk) ++ [L | Acc]).

split_at_most(N, List) when length(List) >= N -> lists:split(N, List);
split_at_most(_N, List) -> {List, []}.

stress_events() ->
    scramble(events_from_arrivals(stress_arrivals(), "se")).

long_only_events() ->
    scramble(events_from_arrivals(interleave(long_cases()), "lo")).

%% ===========================================================================
%% Real discovery invocation (the code actually under test).
%% ===========================================================================

discover_traces(Events) ->
    beam4pm_discovery:traces_from_events(Events, <<"case_id">>).

discover_edges(Events) ->
    beam4pm_discovery:dfg_from_traces(discover_traces(Events)).

trace_tuples(Events) ->
    [{beam4pm_discovery:log_trace_case_id(T),
      beam4pm_discovery:log_trace_activity_sequence(T)} || T <- discover_traces(Events)].

edge_tuples(Events) ->
    [{beam4pm_discovery:dfg_edge_source_activity(E),
      beam4pm_discovery:dfg_edge_target_activity(E),
      beam4pm_discovery:dfg_edge_frequency(E)} || E <- discover_edges(Events)].

edge_pairs(Events) ->
    lists:sort([{S, T} || {S, T, _F} <- edge_tuples(Events)]).

case_id_of(Event) ->
    maps:get(<<"case_id">>, beam4pm_discovery:ocel_event_attributes(Event)).

%% Adjacent pairs of the LITERAL ground-truth sequences above -- computed
%% from the hand-written fixtures, never from discovery output, so the
%% comparison is not circular.
true_pairs(Cases) ->
    lists:usort(lists:append([adjacent(Seq) || {_Id, Seq} <- Cases])).

adjacent([A, B | Rest]) -> [{A, B} | adjacent([B | Rest])];
adjacent(_) -> [].

consecutive(List) ->
    lists:zip(lists:droplast(List), tl(List)).

any_repeat(List) ->
    lists:any(fun({A, B}) -> A =:= B end, consecutive(List)).

freq_sum(Edges) ->
    lists:sum([F || {_S, _T, F} <- Edges]).

%% ===========================================================================
%% HALF 1 -- KNOWN SEEDED PROCESS
%% ===========================================================================

seeded_fixture_is_adversarial_test() ->
    Events = known_events(),
    ByArrival = arrival_order(Events),
    ?assertEqual(19, length(ByArrival)),
    CaseIds = [case_id_of(E) || E <- ByArrival],
    %% Consecutive raw arrivals always belong to DIFFERENT cases.
    ?assertNot(any_repeat(CaseIds)),
    %% And the list handed to discovery is not merely arrival order.
    ?assertNotEqual([beam4pm_discovery:ocel_event_event_id(E) || E <- Events],
                    [beam4pm_discovery:ocel_event_event_id(E) || E <- ByArrival]).

known_process_traces_exact_test() ->
    ?assertEqual(known_cases(), trace_tuples(known_events())).

known_process_edge_set_exact_test() ->
    Discovered = edge_pairs(known_events()),
    Truth = lists:sort(true_process_edges()),
    %% Two-sided: equality, not containment.
    ?assertEqual(Truth, Discovered),
    ?assertEqual(5, length(Discovered)),
    ?assertEqual([], Discovered -- Truth),
    ?assertEqual([], Truth -- Discovered),
    %% Named spurious edges a leaking implementation would manufacture.
    Spurious =
        [{<<"close_order">>, <<"receive_order">>},   %% case concatenation
         {<<"receive_order">>, <<"ship_order">>},    %% skipping validation
         {<<"receive_order">>, <<"close_order">>},
         {<<"ship_order">>, <<"reject_order">>},     %% branches never adjacent
         {<<"reject_order">>, <<"ship_order">>},
         {<<"close_order">>, <<"close_order">>},     %% terminal self-loop
         {<<"validate_order">>, <<"close_order">>},  %% branch skipped
         {<<"validate_order">>, <<"receive_order">>},
         {<<"close_order">>, <<"ship_order">>}],
    [?assertNot(lists:member(P, Discovered)) || P <- Spurious],
    ok.

known_process_edge_frequencies_exact_test() ->
    ?assertEqual(known_expected_edges(), edge_tuples(known_events())),
    %% Frequency-sum identity: 19 events over 6 cases contribute exactly
    %% (len - 1) pairs each = 3+3+3+1+3+0 = 13.
    ?assertEqual(13, freq_sum(known_expected_edges())).

discovery_order_independent_test() ->
    Base = known_events(),
    Permutations =
        [Base,
         lists:reverse(Base),
         arrival_order(Base),
         lists:reverse(arrival_order(Base)),
         by_type_order(Base)],
    Orderings = [[beam4pm_discovery:ocel_event_event_id(E) || E <- P] || P <- Permutations],
    %% The permutations really are five DIFFERENT orderings of the same
    %% events -- otherwise this test would prove nothing.
    ?assertEqual(5, length(lists:usort(Orderings))),
    ?assertEqual(1, length(lists:usort([lists:sort(O) || O <- Orderings]))),
    Results = [{trace_tuples(P), edge_tuples(P)} || P <- Permutations],
    ?assertEqual(1, length(lists:usort(Results))),
    ?assertEqual([{known_cases(), known_expected_edges()}], lists:usort(Results)).

bounded_confidence_all_seeded_cases_fit_test() ->
    Edges = discover_edges(known_events()),
    [begin
         Result = beam4pm_discovery:conformance(Edges, trace(CaseId, Seq)),
         ?assertEqual(CaseId, beam4pm_discovery:conformance_result_trace_id(Result)),
         ?assertEqual(1.0, beam4pm_discovery:conformance_result_fitness(Result))
     end || {CaseId, Seq} <- known_cases()],
    ok.

branch_point_precision_test() ->
    Edges = discover_edges(known_events()),
    %% By hand over the DISCOVERED model's out-degrees (receive_order=1,
    %% validate_order=2, ship_order=1, reject_order=1, close_order=0):
    %%   (receive_order, validate_order) known: enabled=1, escaping=max(0,0)=0
    %%   (validate_order, ship_order)    known: enabled=2, escaping=max(0,1)=1
    %%   (ship_order, close_order)       known: enabled=1, escaping=0
    %% total_enabled=4, total_escaping=1, alpha=0 -> 1.0 - 1/4 = 0.75.
    %%
    %% A model that had NOT recovered the branch (validate_order out-degree 1)
    %% would score 1.0 here. The 0.75 IS the branch.
    Ship = beam4pm_discovery:conformance(
        Edges, trace(<<"k1">>, [<<"receive_order">>, <<"validate_order">>,
                                <<"ship_order">>, <<"close_order">>])),
    ?assertEqual(0.75, beam4pm_discovery:conformance_result_precision(Ship)),
    ?assertEqual(1.0, beam4pm_discovery:conformance_result_fitness(Ship)),
    Reject = beam4pm_discovery:conformance(
        Edges, trace(<<"k2">>, [<<"receive_order">>, <<"validate_order">>,
                                <<"reject_order">>, <<"close_order">>])),
    ?assertEqual(0.75, beam4pm_discovery:conformance_result_precision(Reject)),
    ?assertEqual(1.0, beam4pm_discovery:conformance_result_fitness(Reject)).

false_adjacency_not_promoted_test() ->
    Edges = discover_edges(known_events()),
    %% receive_order and close_order both occur, and close_order is
    %% temporally later in several cases -- but the pair was never a
    %% within-case adjacency, so it is not in the model.
    Shortcut = beam4pm_discovery:conformance(
        Edges, trace(<<"shortcut">>, [<<"receive_order">>, <<"close_order">>])),
    ?assertEqual(0.0, beam4pm_discovery:conformance_result_fitness(Shortcut)),
    %% enabled = out_degree(receive_order) = 1; the pair is unknown, so the
    %% whole enabled set escaped: 1.0 - 1/1 = 0.0.
    ?assertEqual(0.0, beam4pm_discovery:conformance_result_precision(Shortcut)),
    %% The two mutually exclusive branch activities are not causally linked.
    Both = beam4pm_discovery:conformance(
        Edges, trace(<<"both_branches">>, [<<"ship_order">>, <<"reject_order">>])),
    ?assertEqual(0.0, beam4pm_discovery:conformance_result_fitness(Both)).

%% ===========================================================================
%% HALF 2(a) -- FALSE ADJACENCY: concurrent unrelated case streams
%% ===========================================================================

concurrent_streams_interleave_test() ->
    ByArrival = arrival_order(concurrent_events()),
    ?assertEqual(15, length(ByArrival)),
    CaseIds = [case_id_of(E) || E <- ByArrival],
    ?assertNot(any_repeat(CaseIds)),
    %% The exact raw arrival sequence forbidden_cross_case_pairs/0 was
    %% derived from, asserted rather than assumed.
    ?assertEqual(
        [<<"browse">>, <<"request_return">>, <<"open_ticket">>, <<"signup">>,
         <<"add_to_cart">>, <<"inspect_item">>, <<"triage">>, <<"verify_email">>,
         <<"pay">>, <<"refund">>, <<"resolve">>, <<"pay">>,
         <<"close">>, <<"close">>, <<"close">>],
        [beam4pm_discovery:ocel_event_event_type(E) || E <- ByArrival]),
    %% Four distinct concurrent processes are actually present.
    ?assertEqual([<<"chk_1">>, <<"ret_1">>, <<"sub_1">>, <<"sup_1">>],
                 lists:usort(CaseIds)).

concurrent_streams_edges_exact_test() ->
    Events = concurrent_events(),
    ?assertEqual(concurrent_expected_edges(), edge_tuples(Events)),
    ?assertEqual(true_pairs(concurrent_cases()), edge_pairs(Events)),
    %% 15 events over 4 cases -> 3+3+2+3 = 11 pair observations.
    ?assertEqual(11, freq_sum(concurrent_expected_edges())).

concurrent_streams_zero_cross_case_edges_test() ->
    Discovered = edge_pairs(concurrent_events()),
    Forbidden = forbidden_cross_case_pairs(),
    [?assertNot(lists:member(P, Discovered)) || P <- Forbidden],
    ?assertEqual([], [P || P <- Forbidden, lists:member(P, Discovered)]),
    %% Structural version of the same claim: EVERY discovered edge is a
    %% within-case adjacency of one of the four literal ground-truth
    %% sequences. Nothing was invented from temporal proximity.
    ?assertEqual([], Discovered -- true_pairs(concurrent_cases())).

%% ===========================================================================
%% HALF 2(b) -- FALSE ADJACENCY under SHARED activity names
%% ===========================================================================

shared_activity_name_close_test() ->
    Events = concurrent_events(),
    Discovered = edge_pairs(Events),
    %% <<"close">> really is shared by three of the four unrelated processes.
    Sharers = [CaseId || {CaseId, Seq} <- concurrent_cases(),
                         lists:member(<<"close">>, Seq)],
    ?assertEqual([<<"chk_1">>, <<"ret_1">>, <<"sub_1">>], Sharers),
    %% ... and three <<"close">> events are raw-adjacent to each other at the
    %% tail of the arrival stream -- exactly what would manufacture a
    %% self-loop if partitioning leaked.
    ?assertNot(lists:member({<<"close">>, <<"close">>}, Discovered)),
    Tuples = edge_tuples(Events),
    IntoClose = [T || {_S, Target, _F} = T <- Tuples, Target =:= <<"close">>],
    OutOfClose = [T || {Source, _Target, _F} = T <- Tuples, Source =:= <<"close">>],
    %% in-degree 2 (from pay and from refund), out-degree 0 -- <<"close">> is
    %% terminal in every one of the three processes that use it.
    ?assertEqual([{<<"pay">>, <<"close">>, 2}, {<<"refund">>, <<"close">>, 1}], IntoClose),
    ?assertEqual([], OutOfClose).

shared_activity_name_pay_test() ->
    Tuples = edge_tuples(concurrent_events()),
    Sharers = [CaseId || {CaseId, Seq} <- concurrent_cases(),
                         lists:member(<<"pay">>, Seq)],
    ?assertEqual([<<"chk_1">>, <<"sub_1">>], Sharers),
    IntoPay = [T || {_S, Target, _F} = T <- Tuples, Target =:= <<"pay">>],
    OutOfPay = [T || {Source, _Target, _F} = T <- Tuples, Source =:= <<"pay">>],
    %% add_to_cart -> pay comes only from chk_1, verify_email -> pay only from
    %% sub_1: exactly one each, never merged into one inflated edge -- even
    %% though sub_1's verify_email is raw-adjacent to chk_1's pay.
    ?assertEqual([{<<"add_to_cart">>, <<"pay">>, 1},
                  {<<"verify_email">>, <<"pay">>, 1}], IntoPay),
    %% (pay, close) is frequency EXACTLY 2 (chk_1 and sub_1), not 3. This is
    %% the frequency-side falsifier for the cross-case raw adjacency that set
    %% membership alone cannot separate: sub_1's pay is raw-adjacent to
    %% chk_1's close, and a leak would show up here as 3.
    ?assertEqual([{<<"pay">>, <<"close">>, 2}], OutOfPay).

%% ===========================================================================
%% HALF 2(c) -- FALSE ADJACENCY under a flood of single-event case fragments
%% ===========================================================================

stress_fixture_shape_test() ->
    Events = stress_events(),
    ?assertEqual(318, length(Events)),
    Traces = discover_traces(Events),
    ?assertEqual(303, length(Traces)),
    Lengths = [length(beam4pm_discovery:log_trace_activity_sequence(T)) || T <- Traces],
    ?assertEqual(300, length([L || L <- Lengths, L =:= 1])),
    ?assertEqual(3, length([L || L <- Lengths, L =:= 6])),
    ?assertEqual([], [L || L <- Lengths, L =/= 1, L =/= 6]),
    %% Every single-event trace is a fragment; every 6-event trace is a long case.
    Singles = [beam4pm_discovery:log_trace_case_id(T) || T <- Traces,
               length(beam4pm_discovery:log_trace_activity_sequence(T)) =:= 1],
    ?assert(lists:all(fun(Id) -> binary:part(Id, 0, 5) =:= <<"frag_">> end, Singles)),
    Longs = [{beam4pm_discovery:log_trace_case_id(T),
              beam4pm_discovery:log_trace_activity_sequence(T)} || T <- Traces,
             length(beam4pm_discovery:log_trace_activity_sequence(T)) =:= 6],
    ?assertEqual(long_cases(), Longs),
    %% The fragments draw their activity names ENTIRELY from the long traces'
    %% own vocabulary -- maximum name-collision pressure, no "safe" tokens.
    LongVocabulary = lists:usort(lists:append([Seq || {_Id, Seq} <- long_cases()])),
    ?assertEqual([], fragment_vocabulary() -- LongVocabulary),
    %% No two long-trace events are ever raw-adjacent: consecutive arrivals
    %% always cross a case boundary here too.
    CaseIds = [case_id_of(E) || E <- arrival_order(Events)],
    ?assertNot(any_repeat(CaseIds)).

stress_long_traces_exact_test() ->
    ?assertEqual(long_expected_edges(), edge_tuples(stress_events())),
    ?assertEqual(true_pairs(long_cases()), edge_pairs(stress_events())),
    %% 3 long traces x 5 adjacent pairs = 15 pair observations, not one more:
    %% every single-event case contributed exactly zero adjacent pairs.
    ?assertEqual(15, freq_sum(long_expected_edges())).

stress_fragments_inert_test() ->
    %% Provenance-level proof, not a name-level one: the fragments share the
    %% long traces' whole activity vocabulary, so "no edge mentions a
    %% fragment activity" would be vacuous. Instead, discovery over
    %% long-traces-only must equal discovery over long-traces-plus-300-
    %% fragments.
    WithFragments = edge_tuples(stress_events()),
    WithoutFragments = edge_tuples(long_only_events()),
    ?assertEqual(WithoutFragments, WithFragments),
    ?assertEqual(long_expected_edges(), WithFragments).

stress_order_independent_test() ->
    Base = stress_events(),
    Permutations = [Base, lists:reverse(Base), arrival_order(Base), by_type_order(Base)],
    Orderings = [[beam4pm_discovery:ocel_event_event_id(E) || E <- P] || P <- Permutations],
    ?assertEqual(4, length(lists:usort(Orderings))),
    Results = [edge_tuples(P) || P <- Permutations],
    ?assertEqual([long_expected_edges()], lists:usort(Results)).

%% ===========================================================================
%% HALF 3 -- ADVERSARIAL RE-VERIFICATION: fixtures targeting failure modes
%% the two halves above do not exercise, plus a permanent non-vacuousness
%% regression for the equality assertions used throughout this suite.
%% ===========================================================================

lockstep_cases() ->
    [{<<"L1">>, [<<"x1">>, <<"x2">>, <<"x3">>, <<"x4">>]},
     {<<"L2">>, [<<"x1">>, <<"x2">>, <<"x3">>, <<"x4">>]}].

lockstep_events() ->
    scramble(events_from_arrivals(interleave(lockstep_cases()), "ls")).

lockstep_arrival_order_test() ->
    ByArrival = arrival_order(lockstep_events()),
    CaseIds = [case_id_of(E) || E <- ByArrival],
    ?assertEqual([<<"L1">>, <<"L2">>, <<"L1">>, <<"L2">>, <<"L1">>, <<"L2">>, <<"L1">>, <<"L2">>], CaseIds),
    Types = [beam4pm_discovery:ocel_event_event_type(E) || E <- ByArrival],
    ?assertEqual([<<"x1">>, <<"x1">>, <<"x2">>, <<"x2">>, <<"x3">>, <<"x3">>, <<"x4">>, <<"x4">>], Types).

lockstep_partitions_correctly_test() ->
    ?assertEqual(
        [{<<"L1">>, [<<"x1">>, <<"x2">>, <<"x3">>, <<"x4">>]},
         {<<"L2">>, [<<"x1">>, <<"x2">>, <<"x3">>, <<"x4">>]}],
        trace_tuples(lockstep_events())).

lockstep_no_self_loops_test() ->
    Discovered = edge_pairs(lockstep_events()),
    SelfLoops = [{<<"x1">>, <<"x1">>}, {<<"x2">>, <<"x2">>}, {<<"x3">>, <<"x3">>}, {<<"x4">>, <<"x4">>}],
    %% A global-concatenation bug over the raw arrival stream
    %% x1,x1,x2,x2,x3,x3,x4,x4 would manufacture these as directly-follows
    %% edges. None are real within-case adjacencies in either L1 or L2's own
    %% sequence.
    [?assertNot(lists:member(P, Discovered)) || P <- SelfLoops],
    ?assertEqual(
        lists:sort([{<<"x1">>, <<"x2">>}, {<<"x2">>, <<"x3">>}, {<<"x3">>, <<"x4">>}]),
        Discovered).

lockstep_exact_frequencies_test() ->
    ?assertEqual(
        [{<<"x1">>, <<"x2">>, 2}, {<<"x2">>, <<"x3">>, 2}, {<<"x3">>, <<"x4">>, 2}],
        edge_tuples(lockstep_events())).

case_id_activity_name_collision_test() ->
    %% Case <<"pay">> (case_id == <<"pay">>, a string that also occurs as an
    %% activity name in case <<"other">>) runs its own sequence a -> b -> c.
    %% Case <<"other">> runs pay -> ship, i.e. activity <<"pay">> really
    %% occurs, under a DIFFERENT case_id (<<"other">>).
    %%
    %% The expected order below, [<<"other">>, <<"pay">>], is case_id-
    %% lexicographic, NOT first-occurrence order (case <<"pay">> is the one
    %% that occurs first, at t=0): traces_from_events/2's own moduledoc
    %% states "The result is sorted by case_id" -- this fixture is the first
    %% one in the file where case_id order and first-occurrence order
    %% actually diverge, so it is the real falsifier of that convention.
    Events = scramble([
        ev(<<"e0">>, <<"a">>, ts(0), #{<<"case_id">> => <<"pay">>}),
        ev(<<"e1">>, <<"pay">>, ts(1), #{<<"case_id">> => <<"other">>}),
        ev(<<"e2">>, <<"b">>, ts(2), #{<<"case_id">> => <<"pay">>}),
        ev(<<"e3">>, <<"ship">>, ts(3), #{<<"case_id">> => <<"other">>}),
        ev(<<"e4">>, <<"c">>, ts(4), #{<<"case_id">> => <<"pay">>})
    ]),
    ?assertEqual(
        [{<<"other">>, [<<"pay">>, <<"ship">>]},
         {<<"pay">>, [<<"a">>, <<"b">>, <<"c">>]}],
        trace_tuples(Events)),
    Discovered = edge_pairs(Events),
    %% The case_id <<"pay">> must never itself be treated as an activity, and
    %% the activity <<"pay">> (from case <<"other">>) must not bleed into
    %% case <<"pay">>'s own sequence (which contains no activity literally
    %% named <<"pay">> at all).
    ?assertEqual(
        lists:sort([{<<"a">>, <<"b">>}, {<<"b">>, <<"c">>}, {<<"pay">>, <<"ship">>}]),
        Discovered),
    ?assertNot(lists:member({<<"pay">>, <<"a">>}, Discovered)),
    ?assertNot(lists:member({<<"c">>, <<"pay">>}, Discovered)).

large_case_count() -> 2000.

large_cases() ->
    [{list_to_binary(io_lib:format("case_~5..0B", [I])), [<<"start">>, <<"end">>]}
     || I <- lists:seq(1, large_case_count())].

large_events(Prefix) ->
    scramble(events_from_arrivals(interleave(large_cases()), Prefix)).

large_scale_exact_edge_test() ->
    Events = large_events("lg"),
    ?assertEqual(large_case_count() * 2, length(Events)),
    Traces = discover_traces(Events),
    ?assertEqual(large_case_count(), length(Traces)),
    ?assert(lists:all(
        fun(T) -> beam4pm_discovery:log_trace_activity_sequence(T) =:= [<<"start">>, <<"end">>] end,
        Traces)),
    %% Exactly one edge type, frequency exactly large_case_count/0 -- not
    %% more (self-loops or interleave crossovers leaked in) and not fewer
    %% (cases merged or dropped).
    ?assertEqual([{<<"start">>, <<"end">>, large_case_count()}], edge_tuples(Events)),
    Pairs = edge_pairs(Events),
    ?assertNot(lists:member({<<"end">>, <<"start">>}, Pairs)),
    ?assertNot(lists:member({<<"start">>, <<"start">>}, Pairs)),
    ?assertNot(lists:member({<<"end">>, <<"end">>}, Pairs)).

large_scale_order_independent_test() ->
    Base = large_events("lg2"),
    ?assertEqual(large_case_count() * 2, length(Base)),
    Permutations = [Base, lists:reverse(Base), arrival_order(Base), by_type_order(Base)],
    %% Same distinctness self-check the file's other order-independence
    %% tests use: without it, this test would silently lose coverage of a
    %% permutation that happened to coincide with another, while staying
    %% green.
    Orderings = [[beam4pm_discovery:ocel_event_event_id(E) || E <- P] || P <- Permutations],
    ?assertEqual(4, length(lists:usort(Orderings))),
    Results = [edge_tuples(P) || P <- Permutations],
    ?assertEqual([[{<<"start">>, <<"end">>, large_case_count()}]], lists:usort(Results)).

non_vacuousness_edge_removed_truth_test() ->
    %% Real, permanent regression proof that ONE specific two-sided equality
    %% -- known_process_edge_set_exact_test/0's -- is not vacuously true: if
    %% discovery ever regressed to drop true_process_edges/0's first edge,
    %% this comparison against the (deliberately wrong) edge-removed truth
    %% set would then SUCCEED where it must not -- so THIS test fails the
    %% moment that happens, rather than relying on a one-time manual check
    %% that proved it once and was never re-run. This does NOT, by itself,
    %% prove the other equality assertions in this file (concurrent/stress/
    %% lockstep/large-scale) are equally non-vacuous -- each of those
    %% already carries its own named-spurious-edge or exact-frequency
    %% falsifier instead; see the moduledoc.
    [RemovedEdge | _] = true_process_edges(),
    WrongTruth = lists:sort(true_process_edges()) -- [RemovedEdge],
    Discovered = edge_pairs(known_events()),
    ?assertNotEqual(WrongTruth, Discovered),
    ?assert(lists:member(RemovedEdge, Discovered)).
