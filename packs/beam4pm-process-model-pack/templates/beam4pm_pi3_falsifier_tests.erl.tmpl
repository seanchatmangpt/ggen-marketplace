%% ===========================================================================
%% Ground truth: the KNOWN seeded process.
%%
%%                        +--> ship_order ----+
%%                        |                   v
%%   receive_order --> validate_order      close_order
%%                        |                   ^
%%                        +--> reject_order --+
%%
%% 5 distinct activities, one real branch point (validate_order out-degree 2),
%% one real join (close_order in-degree 2).
%% ===========================================================================

true_process_edges() ->
    [{<<"receive_order">>, <<"validate_order">>},
     {<<"validate_order">>, <<"ship_order">>},
     {<<"validate_order">>, <<"reject_order">>},
     {<<"ship_order">>, <<"close_order">>},
     {<<"reject_order">>, <<"close_order">>}].

%% Six real cases exercising BOTH branches at differing trace lengths,
