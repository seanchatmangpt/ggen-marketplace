known_expected_edges() ->
    [{<<"receive_order">>, <<"validate_order">>, 5},
     {<<"reject_order">>, <<"close_order">>, 2},
     {<<"ship_order">>, <<"close_order">>, 2},
     {<<"validate_order">>, <<"reject_order">>, 2},
     {<<"validate_order">>, <<"ship_order">>, 2}].

