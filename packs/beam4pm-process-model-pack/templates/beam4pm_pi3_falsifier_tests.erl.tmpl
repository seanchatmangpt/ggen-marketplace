    [{<<"k1">>, [<<"receive_order">>, <<"validate_order">>, <<"ship_order">>, <<"close_order">>]},
     {<<"k2">>, [<<"receive_order">>, <<"validate_order">>, <<"reject_order">>, <<"close_order">>]},
     {<<"k3">>, [<<"receive_order">>, <<"validate_order">>, <<"ship_order">>, <<"close_order">>]},
     {<<"k4">>, [<<"receive_order">>, <<"validate_order">>]},
     {<<"k5">>, [<<"receive_order">>, <<"validate_order">>, <<"reject_order">>, <<"close_order">>]},
     {<<"k6">>, [<<"receive_order">>]}].

%% Hand-counted from known_cases/0, sorted by source then target:
