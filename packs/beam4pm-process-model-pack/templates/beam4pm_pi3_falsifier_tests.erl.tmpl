fragment_count() -> 300.

fragment_vocabulary() ->
    [<<"intake">>, <<"assess">>, <<"plan">>, <<"execute">>, <<"review">>,
     <<"archive">>, <<"escalate">>].

%% Hand-counted from long_cases/0, sorted by source then target.
%% 3 traces x 5 adjacent pairs = 15 total pair observations.
long_expected_edges() ->
    [{<<"assess">>, <<"escalate">>, 1},
     {<<"assess">>, <<"plan">>, 2},
     {<<"escalate">>, <<"execute">>, 1},
     {<<"execute">>, <<"review">>, 3},
