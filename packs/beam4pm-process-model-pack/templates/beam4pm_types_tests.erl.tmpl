---
to: test/beam4pm_types_tests.erl
sparql:
  records: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:recordDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:hasField ?f .
      ?f bpm:fieldName ?field_name ; bpm:fieldType ?field_type ; bpm:fieldDoc ?field_doc ;
         bpm:fieldRequired ?field_required ; bpm:fieldOrder ?field_order .
    } ORDER BY ?record_name ?field_order
---
%% GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.

-module(beam4pm_types_tests).

-include_lib("eunit/include/eunit.hrl").

%% No explicit -export here: EUnit's own parse transform auto-exports every
%% *_test/0 function in this module, and an explicit -export of the same
%% functions produces a real "already exported" compiler warning (which
%% would become a hard failure under warnings_as_errors).

{% for r in records -%}
{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) -%}
{%- set required_fields = rfields | filter(attribute="field_required", value="true") -%}
{%- set n_required = required_fields | length -%}
{{ r.record_name }}_ok_test() ->
    ?assertMatch({ok, _}, beam4pm_types:new_{{ r.record_name }}(#{
{%- for f in rfields %}
        {{ f.field_name }} => {% if f.field_type == "string" %}<<"x">>{% elif f.field_type == "integer" %}1{% elif f.field_type == "float" %}1.0{% elif f.field_type == "boolean" %}true{% elif f.field_type == "datetime" %}<<"2026-01-01T00:00:00Z">>{% elif f.field_type == "atom" %}some_atom{% elif f.field_type == "list_string" %}[<<"a">>]{% elif f.field_type == "map" %}#{}{% endif %}{% if not loop.last %},{% endif %}
{%- endfor %}
    })).

{% if n_required > 0 -%}
{{ r.record_name }}_missing_field_test() ->
    ?assertMatch({error, {missing_field, _}}, beam4pm_types:new_{{ r.record_name }}(#{})).
{% else -%}
{{ r.record_name }}_empty_ok_test() ->
    ?assertMatch({ok, _}, beam4pm_types:new_{{ r.record_name }}(#{})).
{% endif %}
{% endfor -%}
