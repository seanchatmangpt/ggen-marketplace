---
to: "lib/beam4pm_cli_{{ bridge_name }}.ex"
force: true
sparql:
  bridges: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?bridge_name ?bridge_module ?bridge_doc ?otp_app ?app_env_key ?env_var ?default_path ?default_timeout WHERE {
      ?b a bpm:CliBridge ;
         bpm:bridgeName ?bridge_name ;
         bpm:bridgeModule ?bridge_module ;
         bpm:bridgeDoc ?bridge_doc ;
         bpm:bridgeOrdinal ?ordinal ;
         bpm:cliOtpApp ?otp_app ;
         bpm:cliAppEnvKey ?app_env_key ;
         bpm:cliEnvVar ?env_var ;
         bpm:cliDefaultPath ?default_path ;
         bpm:cliDefaultTimeoutMs ?default_timeout .
    } ORDER BY ?ordinal
  commands: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?bridge_name ?cmd_key ?cmd_name ?cmd_group ?cmd_subcommand ?cmd_doc ?shape_name ?result_fields ?refusal_reason ?timeout_ms WHERE {
      ?c a bpm:CliCommand ;
         bpm:cmdBridge ?b ;
         bpm:cmdName ?cmd_name ;
         bpm:cmdGroup ?cmd_group ;
         bpm:cmdSubcommand ?cmd_subcommand ;
         bpm:cmdOrder ?cmd_order ;
         bpm:cmdDoc ?cmd_doc ;
         bpm:cmdResultShape ?rs ;
         bpm:cmdRefusalReason ?refusal_reason ;
         bpm:cmdTimeoutMs ?timeout_ms .
      ?b a bpm:CliBridge ; bpm:bridgeName ?bridge_name .
      ?rs a bpm:CliResultShape ; bpm:resultShapeName ?shape_name .
      OPTIONAL { ?c bpm:cmdResultFields ?rf_opt }
      BIND(CONCAT(?bridge_name, "/", ?cmd_name) AS ?cmd_key)
      BIND(COALESCE(?rf_opt, "-") AS ?result_fields)
    } ORDER BY ?bridge_name ?cmd_order
  args: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?bridge_name ?cmd_key ?arg_name ?arg_order ?type_name ?elixir_type ?elixir_guard ?mode_name ?flag ?encoding_name ?in_argv ?inline WHERE {
      ?a a bpm:CliArg ;
         bpm:argCommand ?c ;
         bpm:cliArgName ?arg_name ;
         bpm:cliArgOrder ?arg_order ;
         bpm:cliArgType ?t .
      ?c a bpm:CliCommand ; bpm:cmdBridge ?b ; bpm:cmdName ?cmd_name .
      ?b a bpm:CliBridge ; bpm:bridgeName ?bridge_name .
      ?t a bpm:CliArgType ;
         bpm:cliArgTypeName ?type_name ;
         bpm:cliArgElixirType ?elixir_type ;
         bpm:cliArgElixirGuard ?elixir_guard .
      OPTIONAL { ?a bpm:cliArgMode ?m . ?m a bpm:CliArgMode ; bpm:cliArgModeName ?mode_opt }
      OPTIONAL { ?a bpm:cliArgFlag ?flag_opt }
      OPTIONAL { ?a bpm:cliArgEncoding ?enc . ?enc a bpm:CliArgEncoding ; bpm:cliArgEncodingName ?enc_opt }
      BIND(CONCAT(?bridge_name, "/", ?cmd_name) AS ?cmd_key)
      BIND(COALESCE(?mode_opt, "positional") AS ?mode_name)
      BIND(COALESCE(?flag_opt, "-") AS ?flag)
      BIND(COALESCE(?enc_opt, "raw") AS ?encoding_name)
      BIND(IF(?mode_name = "positional" || ?mode_name = "flags", "true", "false") AS ?in_argv)
      # Every admitted mode takes a function parameter -- the modes differ
      # only in WIRE routing (argv value / flag value / stdin / temp-file
      # path), never in the rendered signature. inline=false is reserved for
      # a future mode that takes no parameter at all.
      BIND("true" AS ?inline)
    } ORDER BY ?cmd_key ?arg_order
for_each: bridges
---
{%- for bridge in bridges %}
{%- set bcmds = commands | filter(attribute="bridge_name", value=bridge.bridge_name) %}
{%- set bargs = args | filter(attribute="bridge_name", value=bridge.bridge_name) %}
{%- set module = "BeamPM." ~ bridge.bridge_module -%}
# GENERATED by ggen from the admitted bpm:CliBridge graph ({{ bridge.bridge_name }}). Do not edit.
defmodule {{ module }} do
  @moduledoc ~S"""
  Typed one-shot wrappers over the standalone `{{ bridge.bridge_name }}` CLI,
  resolved through `{{ bridge.default_path }}` (Application env
  `:{{ bridge.otp_app }}, :{{ bridge.app_env_key }}`, then the
  `{{ bridge.env_var }}` environment variable, then that repo-relative default).
  {{ bridge.bridge_doc }}

  This module is rendered by ggen from the admitted `bpm:CliBridge` /
  `bpm:CliCommand` / `bpm:CliArg` facts: the CLI's command surface (group,
  subcommand, arguments, result shape, refusal-reason atom, timeout budget,
  doc) is ontology; the binary resolution ladder, the single `System.cmd/3`
  run, the Task-based timeout with brutal-kill reaping, and the JSON-envelope
  collapse into typed refusals are template, identical across bridges by
  construction.

  ## Commands

  One public function per admitted `bpm:CliCommand`, each returning
  `{:ok, map()}` on the CLI's own success envelope or a TYPED
  `{:error, term()}` that carries the CLI's refusal verbatim (a lab refusal is
  a verdict, never a bridge failure and never a fabricated map):
{% for cmd in bcmds %}
{%- set cargs = bargs | filter(attribute="cmd_key", value=cmd.cmd_key) %}
{%- set inline_args = cargs | filter(attribute="inline", value="true") %}
{%- set n = inline_args | length %}
  `{{ cmd.cmd_name }}/{{ n }}` ({{ cmd.cmd_group }} {{ cmd.cmd_subcommand }}{% if cmd.shape_name == "ok_map" %}, ok-map projection{% elif cmd.shape_name == "typed_refusal" %}, typed-refusal relay{% else %}, batch passthrough{% endif %}){% if not loop.last %},{% endif %}
{%- endfor %}
  """
{% for cmd in bcmds %}
{%- set cargs = bargs | filter(attribute="cmd_key", value=cmd.cmd_key) %}
{%- set inline_args = cargs | filter(attribute="inline", value="true") %}
{%- set argv_args = cargs | filter(attribute="in_argv", value="true") %}
{%- set stdin_args = cargs | filter(attribute="mode_name", value="json_stdin") %}
{%- set tmpfile_args = cargs | filter(attribute="mode_name", value="temp_file") %}
{%- set fields = cmd.result_fields | split(pat=" ") %}
{%- set first_stdin = stdin_args | first %}
{%- set first_tmpfile = tmpfile_args | first %}

  @doc ~S"""
{{ cmd.cmd_doc }}
  """
  @spec {{ cmd.cmd_name }}({% for a in inline_args %}{{ a.elixir_type }}{% if not loop.last %}, {% endif %}{% endfor %}) :: {:ok, map()} | {:error, term()}
  def {{ cmd.cmd_name }}({% for a in inline_args %}{{ a.arg_name }}{% if not loop.last %}, {% endif %}{% endfor %}){% if inline_args | length > 0 %}
      when {% for a in inline_args %}{% if not loop.first %} and {% endif %}{{ a.elixir_guard }}({{ a.arg_name }}){% endfor %}{% endif %} do
{%- if stdin_args | length > 0 %}
    stdin_data = JSON.encode!({{ first_stdin.arg_name }})
{%- endif %}
    argv =
      ["{{ cmd.cmd_group }}", "{{ cmd.cmd_subcommand }}"{% for a in argv_args %}, {% if a.mode_name == "flags" %}"{{ a.flag }}", {% endif %}{% if a.encoding_name == "json" %}JSON.encode!({{ a.arg_name }}){% else %}{{ a.arg_name }}{% endif %}{% endfor %}]
{%- if tmpfile_args | length > 0 %}
    tmp_path =
      Path.join(
        System.tmp_dir!(),
        "{{ bridge.bridge_name }}_{{ cmd.cmd_name }}_#{System.unique_integer([:positive])}.json"
      )

    File.write!(tmp_path, JSON.encode!({{ first_tmpfile.arg_name }}))

    try do
      do_{{ cmd.cmd_name }}(argv ++ [tmp_path]{% if stdin_args | length > 0 %}, stdin_data{% endif %})
    after
      File.rm(tmp_path)
    end
  end

  # The temp file's after-clause above owns cleanup, so the envelope collapse
  # for this command lives here, argv already carrying the temp-file path.
  defp do_{{ cmd.cmd_name }}(argv{% if stdin_args | length > 0 %}, stdin_data{% endif %}) do
{%- endif %}
{%- if cmd.shape_name == "ok_map" %}
    case run_cli(argv, {{ cmd.timeout_ms }}{% if stdin_args | length > 0 %}, stdin_data{% endif %}) do
      {:ok, %{"ok" => ok} = resp} when is_boolean(ok) ->
        # bpm:CliResultShape_ok_map: the CLI's success envelope projected to
        # atom keys per bpm:cmdResultFields ("ok" binds the guarded boolean,
        # every other key via Map.fetch!/2 -- a missing key is a loud
        # KeyError, never a fabricated nil); an envelope carrying a top-level
        # "error" key is the command's typed refusal; runner failures and any
        # other decode pass through verbatim.
        {:ok, %{ok: ok{% for f in fields %}{% if f != "ok" %}, {{ f }}: Map.fetch!(resp, "{{ f }}"){% endif %}{% endfor %}}}

      {:ok, %{"error" => err} = resp} ->
        {:error, {:{{ cmd.refusal_reason }}, err, resp}}

      other ->
        other
    end
{%- elif cmd.shape_name == "typed_refusal" %}
    case run_cli(argv, {{ cmd.timeout_ms }}{% if stdin_args | length > 0 %}, stdin_data{% endif %}) do
      {:ok, %{"ok" => true} = resp} ->
        # bpm:CliResultShape_typed_refusal: the CLI's verified verdict.
        {:ok, resp}

      # The CLI emits its verdict JSON on stdout, THEN exits 1 on its own
      # refusal -- so the lab's verdict arrives inside {:cli_failed, ...}.
      # Decode it and surface it as the verdict it is, never a raw exit.
      {:error, {:cli_failed, 1, output}} ->
        case JSON.decode(output) do
          {:ok, %{"ok" => false} = resp} -> {:error, {:{{ cmd.refusal_reason }}, resp}}
          _ -> {:error, {:cli_failed, 1, output}}
        end

      other ->
        other
    end
{%- else %}
    # bpm:CliResultShape_batch: a bare payload (no "ok" envelope) returned
    # whole; runner failures verbatim.
    run_cli(argv, {{ cmd.timeout_ms }}{% if stdin_args | length > 0 %}, stdin_data{% endif %})
{%- endif %}
  end
{% endfor %}

  # ---------------------------------------------------------------------
  # Binary resolution and the shared one-shot runner
  # ---------------------------------------------------------------------

  @default_timeout_ms {{ bridge.default_timeout }}

  @doc "Locate the standalone {{ bridge.bridge_name }} CLI executable."
  @spec cli_path() :: String.t()
  def cli_path do
    Application.get_env(:{{ bridge.otp_app }}, :{{ bridge.app_env_key }}) ||
      System.get_env("{{ bridge.env_var }}") ||
      Path.expand("{{ bridge.default_path }}")
  end

  @doc "Check if the standalone {{ bridge.bridge_name }} CLI binary is available."
  @spec cli_available?() :: boolean()
  def cli_available? do
    path = cli_path()
    File.exists?(path)
  end

  @doc """
  Execute one command against the standalone {{ bridge.bridge_name }} CLI and
  JSON-decode its stdout.

  The binary is resolved through `cli_path/0`'s ladder (Application env, then
  `{{ bridge.env_var }}`, then the repo-relative default); a missing binary is
  the typed refusal `{:error, {:binary_missing, path}}`. Exactly ONE
  `System.cmd/3` runs (stderr NOT merged -- a refusal envelope on stdout must
  not be polluted by stderr noise), under `timeout_ms` (default
  `@default_timeout_ms`): `Task.yield/2` collects the result, and a budget
  overrun is reaped with `Task.shutdown/2` `:brutal_kill` -- the orphaned port
  dies with its owner process -- and returned as the typed refusal
  `{:error, {:cli_timeout, timeout_ms}}`, never a hang and never a silent nil.
  Exit 0 decodes to `{:ok, parsed}` (undecodable stdout is
  `{:error, {:invalid_json, err, output}}`); any other exit is
  `{:error, {:cli_failed, code, output}}` with the output intact for the
  caller's own decode. This runner computes nothing and decides nothing about
  the command's semantics -- that collapse is each command's
  `bpm:CliResultShape`.
  """
  @spec run_cli([String.t()], pos_integer(), String.t() | nil) :: {:ok, map()} | {:error, term()}
  def run_cli(args, timeout_ms \\ @default_timeout_ms, stdin_data \\ nil)
      when is_list(args) and is_integer(timeout_ms) do
    bin = cli_path()

    if File.exists?(bin) do
      cmd_opts =
        if stdin_data, do: [stderr_to_stdout: false, stdin: stdin_data], else: [stderr_to_stdout: false]

      task = Task.async(fn -> System.cmd(bin, args, cmd_opts) end)

      case Task.yield(task, timeout_ms) || Task.shutdown(task, :brutal_kill) do
        {:ok, {output, 0}} ->
          case JSON.decode(output) do
            {:ok, parsed} -> {:ok, parsed}
            {:error, err} -> {:error, {:invalid_json, err, output}}
          end

        {:ok, {err_output, code}} ->
          {:error, {:cli_failed, code, err_output}}

        {:exit, reason} ->
          {:error, {:cli_task_exit, reason}}

        nil ->
          {:error, {:cli_timeout, timeout_ms}}
      end
    else
      {:error, {:binary_missing, bin}}
    end
  end
end
{% endfor %}
