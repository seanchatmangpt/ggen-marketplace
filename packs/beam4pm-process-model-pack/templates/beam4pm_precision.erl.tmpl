%% GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.
%%
%% ETC (Escaping-edge Trace Conformance) precision for one trace against a
%% directly-follows model, structurally adapted from the real Adriansyah/
%% Dongen/Van der Aalst escaping-edges formula already implemented in
%% ex4pm's Ex4pmEngine.ETCPrecision
%% (apps/ex4pm_engine/lib/ex4pm_engine/etc_precision.ex in the ex4pm repo):
%%
%%   Precision_ETC(L, N, alpha) =
%%     1.0 - (sum |EscapingEdges(s)| / (sum |Enabled(s)| + alpha * sum |EscapingEdges(s)|))
%%
%% ex4pm's original walks a Petri-net marking automaton: a "state" is a
%% marking, and the transitions "enabled" in a state are those whose input
%% places are all marked; at each replayed move it counts how many enabled
%% transitions were NOT the one actually taken ("escaping edges") against how
%% many were enabled in total, then aggregates across the whole log.
%%
%% beam4pm's admitted model is a directly-follows graph (a dfg_edge list),
%% not a Petri net, so this module reduces the SAME automaton concept onto that
%% representation instead of inventing a different metric: a "state" is the
%% current activity, and the transitions "enabled" out of a state are the
%% distinct model edges whose source is that activity. The per-step
%% escaping-edge rule below is the same policy as ex4pm's
%% replay_moves_for_etc/3, restated over directly-follows edges:
%%
%%   * EnabledCount = out-degree of the current activity in the model (the
%%     number of distinct edges the model admits leaving that activity).
%%   * EscapingCount = max(0, EnabledCount - 1) when the trace's actual next
%%     activity IS one of those model edges (a "synchronous move": the model
%%     offered several options, exactly one was taken, the rest went
%%     unobserved / "escaped"); EnabledCount (every one of them) when the
%%     trace's next activity is NOT a model edge at all (a pure "log move":
%%     none of the model's predictions from this state matched, so
%%     everything the model offered here escaped observation).
%%
%% TotalEnabled/TotalEscaping accumulate these counts across every adjacent
%% pair of exactly ONE trace, matching beam4pm_discovery:conformance/2's
%% existing per-trace contract (ex4pm's version aggregates over an entire
%% log to score one model; this is the same sum specialized to a log of one
%% trace). Alpha (default 0.0, ex4pm's :negative_event_weight smoothing
%% knob) is exposed as etc_precision/3's third argument for the identical
%% reason ex4pm exposes it.
%%
%% Admitted record types this module operates over ({{ records | length }}):
{% for r in records -%}
%%   * {{ r.record_name }} - {{ r.record_doc }}
{% endfor -%}

-module(beam4pm_precision).

-export([etc_precision/2, etc_precision/3]).

%% etc_precision(Edges, Trace) -> float(). Same as etc_precision(Edges, Trace, 0.0).
-spec etc_precision([beam4pm_types:dfg_edge()], beam4pm_types:log_trace()) -> float().
etc_precision(Edges, Trace) ->
    etc_precision(Edges, Trace, 0.0).

%% etc_precision(Edges, Trace, Alpha) -> float().
%%
%% ETC precision of Trace's activity sequence against the directly-follows
%% model Edges. Alpha is the escaping-edge smoothing weight described above.
%% A trace with fewer than two activities has no state transition to
%% evaluate: nothing was observed, so nothing could escape, and precision is
%% honestly 1.0 -- the same convention beam4pm_discovery:conformance/2
%% already uses for fitness on such traces.
-spec etc_precision([beam4pm_types:dfg_edge()], beam4pm_types:log_trace(), number()) -> float().
etc_precision(Edges, Trace, Alpha) ->
    case adjacent_pairs(beam4pm_discovery:log_trace_activity_sequence(Trace)) of
        [] ->
            1.0;
        Pairs ->
            Outgoing = out_degrees(Edges),
            Known = maps:from_list(
                [ { {beam4pm_discovery:dfg_edge_source_activity(E),
                     beam4pm_discovery:dfg_edge_target_activity(E)}, true }
                  || E <- Edges ]),
            {TotalEnabled, TotalEscaping} = lists:foldl(
                fun({From, _To} = Pair, {EnabledAcc, EscapingAcc}) ->
                    Enabled = maps:get(From, Outgoing, 0),
                    Escaping = case maps:is_key(Pair, Known) of
                        true -> max(0, Enabled - 1);
                        false -> Enabled
                    end,
                    {EnabledAcc + Enabled, EscapingAcc + Escaping}
                end,
                {0, 0},
                Pairs),
            Denominator = TotalEnabled + Alpha * TotalEscaping,
            case Denominator > 0 of
                true -> erlang:max(0.0, 1.0 - TotalEscaping / Denominator);
                false -> 1.0
            end
    end.

%% Internal: number of distinct model edges leaving each source activity
%% (the automaton's "enabled transition count" per state).
out_degrees(Edges) ->
    Pairs = lists:usort(
        [ {beam4pm_discovery:dfg_edge_source_activity(E),
           beam4pm_discovery:dfg_edge_target_activity(E)}
          || E <- Edges ]),
    lists:foldl(
        fun({Source, _Target}, Acc) ->
            maps:update_with(Source, fun(N) -> N + 1 end, 1, Acc)
        end,
        #{},
        Pairs).

%% Internal: ordered list of adjacent pairs (with multiplicity).
adjacent_pairs([A, B | Rest]) -> [{A, B} | adjacent_pairs([B | Rest])];
adjacent_pairs(_) -> [].
