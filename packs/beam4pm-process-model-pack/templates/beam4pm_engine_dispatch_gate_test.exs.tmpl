---
to: test/beam4pm_engine_dispatch_gate_test.exs
sparql:
  engines: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?dispatch_source WHERE {
      ?e a bpm:Engine ;
         bpm:engineName ?engine_name ;
         bpm:engineOrdinal ?ordinal ;
         bpm:dispatchSource ?dispatch_source .
    } ORDER BY ?ordinal
  ops: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?op_name ?wire_name ?op_kind WHERE {
      ?op a bpm:EngineOp ;
          bpm:opEngine ?e ;
          bpm:opName ?op_name ;
          bpm:opOrder ?op_order ;
          bpm:opKind ?k .
      ?e a bpm:Engine ; bpm:engineName ?engine_name ; bpm:engineOrdinal ?ordinal .
      ?k a bpm:EngineOpKind ; bpm:engineOpKindName ?op_kind .
      OPTIONAL { ?op bpm:opWireName ?wire_opt }
      BIND(COALESCE(?wire_opt, ?op_name) AS ?wire_name)
    } ORDER BY ?ordinal ?op_order
  wire_ops: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?engine_name ?wire_name WHERE {
      ?op a bpm:EngineOp ;
          bpm:opEngine ?e ;
          bpm:opName ?op_name ;
          bpm:opOrder ?op_order ;
          bpm:opKind bpm:EngineOpKind_wire .
      ?e a bpm:Engine ; bpm:engineName ?engine_name ; bpm:engineOrdinal ?ordinal .
      OPTIONAL { ?op bpm:opWireName ?wire_opt }
      BIND(COALESCE(?wire_opt, ?op_name) AS ?wire_name)
    } ORDER BY ?ordinal ?op_order
---
# GENERATED by ggen from the admitted bpm:Engine graph. Do not edit.
defmodule BeamPM.EngineDispatchGateTest do
  @moduledoc """
  Chicago-style qualification of GATE ENGINE DISPATCH
  (`scripts/gate_engine_dispatch_check.sh`): the manufactured engine facades
  (`lib/beam4pm_<engine>.ex`, `src/beam4pm_<engine>.erl`,
  `gleam/src/beam4pm/<engine>.gleam`) are rendered from `bpm:Engine` /
  `bpm:EngineOp` facts, and a fact naming an op the engine's crate does not
  dispatch would render a compiling wrapper whose every call returns the
  engine's unknown-op error. The gate joins the manufactured manifest
  `schema/beam4pm_engine_ops.tsv` against each engine's `bpm:dispatchSource`
  string-literal `"<op>" =>` match arms.

  Every test here runs the REAL gate script as a real subprocess
  (`System.cmd("bash", ...)`), never a re-implementation of its logic:

    * against the real repository tree -- must PASS with exactly the op and
      engine counts this file was rendered with ({{ ops | length }} ops across
      {{ engines | length }} engines, {{ wire_ops | length }} of them wire ops), and
      every wire op must independently be found as a dispatch arm in its
      engine's crate source when that source is on disk;
    * against planted fixtures in a temp dir that MUST be refused, each
      naming the offending op and a typed REFUSED_* code: a wire op with no
      dispatch arm; a dispatch source with no arms at all; an unmanufactured
      manifest;
    * against fixtures that must NOT be refused: an alternation arm
      (`"a" | "b" =>`), a host_helper row (exempt by kind), an absent crate
      source (reported DISPATCH_SOURCE_ABSENT, BLOCKED not PASS-by-silence),
      and a crate arm no fact exposes (reported UNEXPOSED_DISPATCH_ARM --
      scope control stays visible, never a silently manufactured function).

  This file is itself manufactured (see the marker above): its op list and
  counts are rendered from the same `bpm:Engine` graph the manifest and the
  facades are rendered from, so the three cannot drift apart without
  gate_m2_check.sh noticing.
  """

  use ExUnit.Case, async: false

  @gate Path.expand("scripts/gate_engine_dispatch_check.sh")
  @manifest Path.expand("schema/beam4pm_engine_ops.tsv")
  @marker "GENERATED by ggen"
  @op_count {{ ops | length }}
  @engine_count {{ engines | length }}
  @wire_op_count {{ wire_ops | length }}
  @engines [{% for e in engines %}
    {"{{ e.engine_name }}", "{{ e.dispatch_source }}"}{% if not loop.last %},{% endif %}{% endfor %}
  ]
  @ops [{% for o in ops %}
    {"{{ o.engine_name }}", "{{ o.op_name }}", "{{ o.wire_name }}", "{{ o.op_kind }}"}{% if not loop.last %},{% endif %}{% endfor %}
  ]

  @manifest_header """
  # GENERATED by ggen from the admitted bpm:Engine graph. Do not edit.
  # fixture manifest written by BeamPM.EngineDispatchGateTest
  # engine op wire_name kind dispatch_source wasm_artifact
  """

  defp run_gate(args, cd) do
    System.cmd("bash", [@gate | args], cd: cd, stderr_to_stdout: true)
  end

  defp marked?(path) do
    path
    |> File.read!()
    |> String.split("\n")
    |> Enum.take(3)
    |> Enum.any?(&String.contains?(String.downcase(&1), String.downcase(@marker)))
  end

  # Independent re-derivation of the crate's dispatch set (the same shape the
  # gate greps, re-implemented here so a bug in the gate's sed pipeline and a
  # bug in this test cannot cancel out): every double-quoted snake_case
  # literal on a `"lit" => ...` or `"lit" | "lit2" => ...` line.
  defp dispatch_arms(source_path) do
    source_path
    |> File.read!()
    |> String.split("\n")
    |> Enum.flat_map(fn line ->
      case Regex.run(~r/^\s*("[a-z_0-9]+"(?:\s*\|\s*"[a-z_0-9]+")*)\s*=>/, line) do
        [_, arms] -> Regex.scan(~r/"([a-z_0-9]+)"/, arms) |> Enum.map(fn [_, a] -> a end)
        nil -> []
      end
    end)
    |> Enum.uniq()
  end

  defp fixture!(ctx_name) do
    dir =
      Path.join(
        System.tmp_dir!(),
        "beam4pm_engine_dispatch_gate_#{ctx_name}_#{System.unique_integer([:positive])}"
      )

    File.rm_rf!(dir)
    File.mkdir_p!(dir)
    dir
  end

  defp write_manifest!(dir, rows, opts \\ []) do
    header = Keyword.get(opts, :header, @manifest_header)
    body = Enum.map_join(rows, "", fn row -> Enum.join(row, "\t") <> "\n" end)
    path = Path.join(dir, "fixture_manifest.tsv")
    File.write!(path, header <> body)
    path
  end

  defp plant_source!(dir, rel, arms) do
    abs = Path.join(dir, rel)
    File.mkdir_p!(Path.dirname(abs))

    body =
      Enum.map_join(arms, "\n", fn arm -> "        #{arm} => op(&req)?," end)

    File.write!(abs, "fn dispatch(req: &Req) -> Result<Value, String> {\n    match req.op.as_str() {\n#{body}\n        other => return Err(format!(\"unknown op {other}\")),\n    }\n}\n")
    abs
  end

  @artifact "native/fx/target/wasm32-wasip1/release/fx.wasm"

  describe "real repository tree" do
    test "the real gate PASSes with exactly the op and engine counts rendered from the ontology" do
      {out, status} = run_gate([], File.cwd!())
      assert status == 0, out
      assert out =~ "GATE ENGINE DISPATCH: PASS"
      assert out =~ "manifest: #{@op_count} ops across #{@engine_count} engines"
      refute out =~ "REFUSED_"
    end

    test "the manufactured manifest carries the marker and lists exactly the admitted ops" do
      assert File.exists?(@manifest)
      assert marked?(@manifest)

      rows =
        @manifest
        |> File.read!()
        |> String.split("\n", trim: true)
        |> Enum.reject(&String.starts_with?(&1, "#"))
        |> Enum.map(&String.split(&1, "\t"))

      assert Enum.all?(rows, &(length(&1) == 6))

      assert Enum.map(rows, fn [e, o, w, k, _src, _art] -> {e, o, w, k} end) == @ops

      wire_rows = Enum.filter(rows, fn [_e, _o, _w, k | _] -> k == "wire" end)
      assert length(wire_rows) == @wire_op_count

      for [engine, _op, _wire, _kind, src, _art] <- rows do
        assert {engine, src} in @engines, "#{engine}: manifest dispatch source #{src} is not the ontology's"
      end
    end

    test "every wire op is a real dispatch arm of its engine's crate source (independent re-derivation)" do
      for {engine, src} <- @engines do
        if File.exists?(src) do
          arms = dispatch_arms(src)
          assert arms != [], "#{engine}: #{src} has no dispatch arms -- wrong bpm:dispatchSource?"

          for {^engine, op, wire, "wire"} <- @ops do
            assert wire in arms,
                   "#{engine}/#{op}: wire name #{inspect(wire)} is not a dispatch arm in #{src}"
          end
        else
          # A submodule not initialised on this host: the gate reports it
          # DISPATCH_SOURCE_ABSENT (BLOCKED), and this test says so too rather
          # than silently passing a join it could not perform.
          IO.puts("engine dispatch source absent on this host (BLOCKED, not verified): #{engine} #{src}")
        end
      end
    end
  end

  describe "planted fixtures that must be refused" do
    test "a wire op with no dispatch arm is REFUSED_OP_NOT_DISPATCHED by name" do
      dir = fixture!("not_dispatched")
      plant_source!(dir, "native/fx/src/lib.rs", [~s("real_op")])

      manifest =
        write_manifest!(dir, [
          ["fx", "real_op", "real_op", "wire", "native/fx/src/lib.rs", @artifact],
          ["fx", "bogus_op", "bogus_op", "wire", "native/fx/src/lib.rs", @artifact]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_OP_NOT_DISPATCHED: fx/bogus_op"
      refute out =~ "REFUSED_OP_NOT_DISPATCHED: fx/real_op"
      assert out =~ "GATE ENGINE DISPATCH: FAIL"
    end

    test "a dispatch source with no match arms is REFUSED_ENGINE_NOT_DISPATCHED" do
      dir = fixture!("no_arms")
      plant_source!(dir, "native/fx/src/lib.rs", [])

      manifest =
        write_manifest!(dir, [["fx", "real_op", "real_op", "wire", "native/fx/src/lib.rs", @artifact]])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_ENGINE_NOT_DISPATCHED: fx"
    end

    test "a hand-written (unmanufactured) manifest is REFUSED_MANIFEST_UNMANUFACTURED" do
      dir = fixture!("unmanufactured")
      plant_source!(dir, "native/fx/src/lib.rs", [~s("real_op")])

      manifest =
        write_manifest!(
          dir,
          [["fx", "real_op", "real_op", "wire", "native/fx/src/lib.rs", @artifact]],
          header: "# a hand-maintained op list with no provenance header\n"
        )

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_MANIFEST_UNMANUFACTURED"
    end

    test "a malformed manifest row is REFUSED_MANIFEST_MALFORMED" do
      dir = fixture!("malformed")
      plant_source!(dir, "native/fx/src/lib.rs", [~s("real_op")])

      manifest =
        write_manifest!(dir, [
          ["fx", "real_op", "real_op", "wire", "native/fx/src/lib.rs", @artifact],
          ["fx", "half_row", "half_row", "wire"]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 1, out
      assert out =~ "REFUSED_MANIFEST_MALFORMED: fx/half_row"
    end
  end

  describe "planted fixtures that must NOT be refused" do
    test "an alternation arm dispatches every literal it names" do
      dir = fixture!("alternation")
      plant_source!(dir, "native/fx/src/lib.rs", [~s("a" | "b"), ~s("c")])

      manifest =
        write_manifest!(dir, [
          ["fx", "a", "a", "wire", "native/fx/src/lib.rs", @artifact],
          ["fx", "b", "b", "wire", "native/fx/src/lib.rs", @artifact],
          ["fx", "c", "c", "wire", "native/fx/src/lib.rs", @artifact]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 0, out
      assert out =~ "GATE ENGINE DISPATCH: PASS -- 3 wire ops dispatched across 1 engines, 0 crate arms unexposed"
    end

    test "a host_helper row is exempt from the arm check by kind" do
      dir = fixture!("host_helper")
      plant_source!(dir, "native/fx/src/lib.rs", [~s("load")])

      manifest =
        write_manifest!(dir, [
          ["fx", "load", "load", "wire", "native/fx/src/lib.rs", @artifact],
          ["fx", "load_path", "load_path", "host_helper", "native/fx/src/lib.rs", @artifact]
        ])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 0, out
      assert out =~ "1 wire ops dispatched across 1 engines"
      refute out =~ "REFUSED_"
    end

    test "a crate arm no fact exposes is reported UNEXPOSED_DISPATCH_ARM, not silently exposed" do
      dir = fixture!("unexposed")
      plant_source!(dir, "native/fx/src/lib.rs", [~s("a"), ~s("hidden_power")])

      manifest =
        write_manifest!(dir, [["fx", "a", "a", "wire", "native/fx/src/lib.rs", @artifact]])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 0, out
      assert out =~ "UNEXPOSED_DISPATCH_ARM: fx/hidden_power"
      assert out =~ "1 crate arms unexposed (reported)"
    end

    test "an absent dispatch source is DISPATCH_SOURCE_ABSENT (BLOCKED), never a pass by silence" do
      dir = fixture!("absent_source")

      manifest =
        write_manifest!(dir, [["fx", "a", "a", "wire", "native/fx/src/lib.rs", @artifact]])

      {out, status} = run_gate(["--root", dir, "--manifest", manifest], dir)
      assert status == 0, out
      assert out =~ "DISPATCH_SOURCE_ABSENT: fx"
      assert out =~ "0 wire ops dispatched across 1 engines, 0 crate arms unexposed (reported), 1 engines blocked"
    end

    test "a missing manifest is REFUSED_MANIFEST_MISSING" do
      dir = fixture!("missing_manifest")
      {out, status} = run_gate(["--root", dir, "--manifest", Path.join(dir, "nope.tsv")], dir)
      assert status == 1, out
      assert out =~ "REFUSED_MANIFEST_MISSING"
    end
  end
end
