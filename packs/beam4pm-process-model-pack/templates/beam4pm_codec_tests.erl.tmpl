---
to: test/beam4pm_codec_tests.erl
sparql:
  records: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?record_doc WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:recordDoc ?record_doc .
    } ORDER BY ?record_name
  fields: |
    PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
    SELECT ?record_name ?field_name ?field_type ?field_doc ?field_required ?field_order ?sample_erlang ?sample_erlang_encoded WHERE {
      ?rt a bpm:RecordType ; bpm:recordName ?record_name ; bpm:hasField ?f .
      ?f bpm:fieldName ?field_name ; bpm:fieldType ?field_type ; bpm:fieldDoc ?field_doc ;
         bpm:fieldRequired ?field_required ; bpm:fieldOrder ?field_order .
      ?ft a bpm:FieldType ; bpm:fieldTypeName ?field_type ;
          bpm:sampleErlang ?sample_erlang ; bpm:sampleErlangEncoded ?sample_erlang_encoded .
    } ORDER BY ?record_name ?field_order
---
%% GENERATED by ggen from the admitted bpm:RecordType graph. Do not edit.

-module(beam4pm_codec_tests).

-include_lib("eunit/include/eunit.hrl").

%% No explicit -export here: EUnit's own parse transform auto-exports every
%% *_test/0 function in this module, and an explicit -export of the same
%% functions produces a real "already exported" compiler warning (which
%% would become a hard failure under warnings_as_errors).

%% Deterministic full-variant sample values, keyed by bpm:fieldType:
%% string -> <<"sample_" field_name>>, datetime -> <<"2026-08-29T12:00:00Z">>,
%% integer -> 42, float -> 3.5, boolean -> true, atom -> sample_atom,
%% list_string -> [<<"alpha">>, <<"beta">>], map -> #{<<"k">> => <<"v">>}.

{% for r in records -%}
{%- set rfields = fields | filter(attribute="record_name", value=r.record_name) -%}
{{ r.record_name }}_map_roundtrip_test() ->
    {ok, Rec} = beam4pm_types:new_{{ r.record_name }}(#{
{%- for f in rfields %}
        {{ f.field_name }} => {{ f.sample_erlang | replace(from="__FIELD__", to=f.field_name) }}{% if not loop.last %},{% endif %}
{%- endfor %}
    }),
    Map = beam4pm_codec:to_map(Rec),
{%- for f in rfields %}
    ?assertEqual({{ f.sample_erlang_encoded | replace(from="__FIELD__", to=f.field_name) }}, maps:get(<<"{{ f.field_name }}">>, Map)),
{%- endfor %}
    {ok, Rec2} = beam4pm_codec:from_map({{ r.record_name }},
        Map#{<<"totally_unknown_key_zz">> => <<"dropped">>}),
    ?assertEqual(Rec, Rec2).

{{ r.record_name }}_json_roundtrip_test() ->
    {ok, Rec} = beam4pm_types:new_{{ r.record_name }}(#{
{%- for f in rfields %}
        {{ f.field_name }} => {{ f.sample_erlang | replace(from="__FIELD__", to=f.field_name) }}{% if not loop.last %},{% endif %}
{%- endfor %}
    }),
    Json = beam4pm_codec:encode(Rec),
    ?assert(is_binary(Json)),
    {ok, Rec2} = beam4pm_codec:decode({{ r.record_name }}, Json),
    ?assertEqual(Rec, Rec2).

{% endfor -%}
{%- set req_fields = fields | filter(attribute="field_required", value="true") -%}
{%- set mf = req_fields | first -%}
unknown_record_test() ->
    ?assertEqual({error, {unknown_record, not_a_known_record}},
                 beam4pm_codec:from_map(not_a_known_record, #{})).

missing_field_test() ->
    %% {{ mf.record_name }} requires {{ mf.field_name }}; an empty map must
    %% surface the constructor's own missing-field validation unchanged.
    ?assertMatch({error, {missing_field, _}},
                 beam4pm_codec:from_map({{ mf.record_name }}, #{})).

invalid_json_test() ->
    ?assertMatch({error, _},
                 beam4pm_codec:decode({{ mf.record_name }}, <<"not json at all">>)).
