# Synthetic consumer fixture for isolated qualification of
# beam4pm-process-model-pack. Several templates hard-reference specific
# record names (VALUES-restricted SPARQL: discovery needs ocel_event /
# log_trace / dfg_edge / conformance_result / process_variant / service_span /
# span_edge; precision needs dfg_edge / log_trace), and
# beam4pm_codec_tests.erl.tmpl takes `req_fields | first` -- so an EMPTY
# consumer graph fails render outright (real FM-TPL-017 in the qualify
# harness: "Variable `mf.record_name` not found ... records (array, 0
# items)"), which is exactly the failure this fixture exists to admit
# against. The seven individuals below are the real
# record shapes from the pack's reference consumer (seanchatmangpt/beam4pm),
# copied verbatim so accessor arities and field orders are realistic, and
# every gates/010_required.rq-enforced predicate is present.
@prefix bpm: <https://ggen.dev/ontology/beam-process-model#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bpm:ocel_event_rt a bpm:RecordType ;
    bpm:recordName "ocel_event" ;
    bpm:recordDoc "An OCEL 2.0 event: one recorded occurrence in an object-centric log." ;
    bpm:hasField bpm:ocel_event_event_id_f ,
                 bpm:ocel_event_event_type_f ,
                 bpm:ocel_event_event_time_f ,
                 bpm:ocel_event_attributes_f .

bpm:ocel_event_event_id_f a bpm:Field ;
    bpm:fieldName "event_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique event identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:ocel_event_event_type_f a bpm:Field ;
    bpm:fieldName "event_type" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The event's type/activity name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:ocel_event_event_time_f a bpm:Field ;
    bpm:fieldName "event_time" ;
    bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 timestamp the event occurred." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:ocel_event_attributes_f a bpm:Field ;
    bpm:fieldName "attributes" ;
    bpm:fieldType "map" ;
    bpm:fieldDoc "Arbitrary named event attributes." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 4 .

bpm:dfg_edge_rt a bpm:RecordType ;
    bpm:recordName "dfg_edge" ;
    bpm:recordDoc "One frequency-annotated directly-follows edge between two activities." ;
    bpm:hasField bpm:dfg_edge_source_activity_f ,
                 bpm:dfg_edge_target_activity_f ,
                 bpm:dfg_edge_frequency_f .

bpm:dfg_edge_source_activity_f a bpm:Field ;
    bpm:fieldName "source_activity" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The preceding activity name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:dfg_edge_target_activity_f a bpm:Field ;
    bpm:fieldName "target_activity" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "The following activity name." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:dfg_edge_frequency_f a bpm:Field ;
    bpm:fieldName "frequency" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Observed occurrence count of this edge." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:process_variant_rt a bpm:RecordType ;
    bpm:recordName "process_variant" ;
    bpm:recordDoc "One distinct activity-sequence variant observed in a log, with its frequency." ;
    bpm:hasField bpm:process_variant_variant_id_f , bpm:process_variant_activity_sequence_f , bpm:process_variant_frequency_f .

bpm:process_variant_variant_id_f a bpm:Field ;
    bpm:fieldName "variant_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique variant identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:process_variant_activity_sequence_f a bpm:Field ;
    bpm:fieldName "activity_sequence" ;
    bpm:fieldType "list_string" ;
    bpm:fieldDoc "Ordered list of activity names making up this variant." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:process_variant_frequency_f a bpm:Field ;
    bpm:fieldName "frequency" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Number of traces observed with exactly this activity sequence." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:conformance_result_rt a bpm:RecordType ;
    bpm:recordName "conformance_result" ;
    bpm:recordDoc "Conformance-checking metrics computed for one trace against a model." ;
    bpm:hasField bpm:conformance_result_trace_id_f , bpm:conformance_result_fitness_f , bpm:conformance_result_precision_f .

bpm:conformance_result_trace_id_f a bpm:Field ;
    bpm:fieldName "trace_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the trace this result was computed for." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:conformance_result_fitness_f a bpm:Field ;
    bpm:fieldName "fitness" ;
    bpm:fieldType "float" ;
    bpm:fieldDoc "Fitness score in [0.0, 1.0]." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:conformance_result_precision_f a bpm:Field ;
    bpm:fieldName "precision" ;
    bpm:fieldType "float" ;
    bpm:fieldDoc "Optional precision score in [0.0, 1.0]." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 3 .

bpm:log_trace_rt a bpm:RecordType ;
    bpm:recordName "log_trace" ;
    bpm:recordDoc "One case-centric trace: an ordered activity sequence for a single case." ;
    bpm:hasField bpm:log_trace_case_id_f , bpm:log_trace_activity_sequence_f .

bpm:log_trace_case_id_f a bpm:Field ;
    bpm:fieldName "case_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the case this trace belongs to." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:log_trace_activity_sequence_f a bpm:Field ;
    bpm:fieldName "activity_sequence" ;
    bpm:fieldType "list_string" ;
    bpm:fieldDoc "Ordered list of activity names observed for this case." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

# service_span + span_edge (pack 0.1.16): the discovery templates' schema-driven
# accessor loop also names these two, and causal_dfg_from_spans reads exactly
# the six service_span fields below (span_id, service_name, duration_ms,
# parent_span_id, trace_id, start_time) and constructs span_edge (source_service,
# target_service, frequency, evidence). Copied from the reference consumer so a
# qualification render produces the same accessor arities the real one does.
bpm:service_span_rt a bpm:RecordType ;
    bpm:recordName "service_span" ;
    bpm:recordDoc "One OpenTelemetry-style tracing span observed for a service call." ;
    bpm:hasField bpm:service_span_span_id_f , bpm:service_span_service_name_f ,
                 bpm:service_span_duration_ms_f , bpm:service_span_parent_span_id_f ,
                 bpm:service_span_trace_id_f , bpm:service_span_start_time_f .

bpm:service_span_span_id_f a bpm:Field ;
    bpm:fieldName "span_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Unique span identifier." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:service_span_service_name_f a bpm:Field ;
    bpm:fieldName "service_name" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Name of the service that produced this span." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:service_span_duration_ms_f a bpm:Field ;
    bpm:fieldName "duration_ms" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Span duration in milliseconds." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:service_span_parent_span_id_f a bpm:Field ;
    bpm:fieldName "parent_span_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Optional identifier of the parent span (the OpenTelemetry parent/child link; absent on a trace's root span)." ;
    bpm:fieldRequired "false" ;
    bpm:fieldOrder 4 .

bpm:service_span_trace_id_f a bpm:Field ;
    bpm:fieldName "trace_id" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "Identifier of the trace this span belongs to." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 5 .

bpm:service_span_start_time_f a bpm:Field ;
    bpm:fieldName "start_time" ;
    bpm:fieldType "datetime" ;
    bpm:fieldDoc "ISO8601 timestamp the span started." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 6 .

bpm:span_edge_rt a bpm:RecordType ;
    bpm:recordName "span_edge" ;
    bpm:recordDoc "One frequency-annotated service-to-service edge derived from tracing spans, tagged with the evidence class that supports it." ;
    bpm:hasField bpm:span_edge_source_service_f , bpm:span_edge_target_service_f ,
                 bpm:span_edge_frequency_f , bpm:span_edge_evidence_f .

bpm:span_edge_source_service_f a bpm:Field ;
    bpm:fieldName "source_service" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "service_name of the source span." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 1 .

bpm:span_edge_target_service_f a bpm:Field ;
    bpm:fieldName "target_service" ;
    bpm:fieldType "string" ;
    bpm:fieldDoc "service_name of the target span." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 2 .

bpm:span_edge_frequency_f a bpm:Field ;
    bpm:fieldName "frequency" ;
    bpm:fieldType "integer" ;
    bpm:fieldDoc "Link count (parent_child_link) or consecutive-pair count (temporal_adjacency)." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 3 .

bpm:span_edge_evidence_f a bpm:Field ;
    bpm:fieldName "evidence" ;
    bpm:fieldType "atom" ;
    bpm:fieldDoc "Evidence class: parent_child_link (observed) or temporal_adjacency (inferred)." ;
    bpm:fieldRequired "true" ;
    bpm:fieldOrder 4 .

# bpm:Engine fixture (pack 0.1.17): templates/beam4pm_engine.{ex,erl,gleam}.tmpl
# fan out for_each engine, and zero rows is a lawful skip in ggen's sync --
# but a pack whose engine templates never render in qualification proves
# nothing about them, so one synthetic engine exercises every closed
# vocabulary member the reference consumer's four real engines use: a
# handle-only cheap op, a heavy op taking a base64 binary, a keyword-mode
# option with a default (the extra Erlang arity), an optional positional
# with omit_when_nil (put_optional), an optional positional with merge_map,
# a tensor_list and a pair_list encoding, a predicate-named op, an op hidden
# from one leg, and a host_helper delegating to a wire op. Rendered into
# lib/beam4pm_demo_engine.ex, src/beam4pm_demo_engine.erl,
# gleam/src/beam4pm/demo_engine.gleam and schema/beam4pm_engine_ops.tsv.
bpm:demo_engine a bpm:Engine ;
    bpm:engineName "demo_engine" ;
    bpm:engineModule "DemoEngine" ;
    bpm:engineDoc "A synthetic qualification engine exercising every closed engine-surface vocabulary member; it has no crate." ;
    bpm:engineOrdinal 1 ;
    bpm:wasmExportPrefix "dm" ;
    bpm:wasmArtifactPath "native/demo-wasm/target/wasm32-wasip1/release/demo_wasm.wasm" ;
    bpm:wasmBuildScript "scripts/demo_wasm_build.sh" ;
    bpm:wasmBuildHint "(after `git submodule update --init --recursive` if native/demo is empty)" ;
    bpm:dispatchSource "native/demo-wasm/src/lib.rs" ;
    bpm:healthId "demo_wasm" ;
    bpm:handleNoun "thing" ;
    bpm:cheapTimeoutMs 30000 ;
    bpm:heavyTimeoutMs 120000 ;
    bpm:errorCollapse bpm:ErrorCollapse_single_key_inspect .

bpm:demo_engine_op_thing_new a bpm:EngineOp ;
    bpm:opEngine bpm:demo_engine ; bpm:opName "thing_new" ; bpm:opOrder 1 ;
    bpm:opDoc "A new empty thing. `{:ok, %{\"handle\" => n}}`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .

bpm:demo_engine_op_load a bpm:EngineOp ;
    bpm:opEngine bpm:demo_engine ; bpm:opName "load" ; bpm:opOrder 2 ;
    bpm:opDoc "Load raw bytes (base64-encoded host-side) into a thing." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bpm:demo_engine_op_load_bytes a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_load ; bpm:argName "bytes" ; bpm:argOrder 1 ;
    bpm:argWireKey "bytes_b64" ; bpm:argType bpm:EngineArgType_binary ; bpm:argEncoding bpm:ArgEncoding_base64 .

bpm:demo_engine_op_load_path a bpm:EngineOp ;
    bpm:opEngine bpm:demo_engine ; bpm:opName "load_path" ; bpm:opOrder 3 ;
    bpm:opDoc "`File.read!/1` host-side, then `load/2`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_host_helper ;
    bpm:opDelegatesTo bpm:demo_engine_op_load .
bpm:demo_engine_op_load_path_handle a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_load_path ; bpm:argName "path" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_path .

bpm:demo_engine_op_link a bpm:EngineOp ;
    bpm:opEngine bpm:demo_engine ; bpm:opName "link" ; bpm:opOrder 4 ;
    bpm:opDoc "Link two named nodes; `weight` is a keyword option defaulting to 1.0." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bpm:demo_engine_op_link_handle a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_link ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bpm:demo_engine_op_link_from a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_link ; bpm:argName "from" ; bpm:argOrder 2 ; bpm:argType bpm:EngineArgType_string .
bpm:demo_engine_op_link_weight a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_link ; bpm:argName "weight" ; bpm:argOrder 3 ;
    bpm:argType bpm:EngineArgType_number ; bpm:argMode bpm:ArgMode_keyword ; bpm:argDefault "1.0" .

bpm:demo_engine_op_solve a bpm:EngineOp ;
    bpm:opEngine bpm:demo_engine ; bpm:opName "solve" ; bpm:opOrder 5 ;
    bpm:opDoc "Solve with an optional config map (omitted from the wire when nil)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bpm:demo_engine_op_solve_handle a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_solve ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bpm:demo_engine_op_solve_config a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_solve ; bpm:argName "config" ; bpm:argOrder 2 ;
    bpm:argType bpm:EngineArgType_optional_map ; bpm:argMode bpm:ArgMode_optional ; bpm:argDefault "nil" ;
    bpm:argEncoding bpm:ArgEncoding_omit_when_nil .

bpm:demo_engine_op_plan a bpm:EngineOp ;
    bpm:opEngine bpm:demo_engine ; bpm:opName "plan" ; bpm:opOrder 6 ;
    bpm:opDoc "Plan with extra top-level request fields merged from `extra`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bpm:demo_engine_op_plan_domain a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_plan ; bpm:argName "domain" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_string .
bpm:demo_engine_op_plan_extra a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_plan ; bpm:argName "extra" ; bpm:argOrder 2 ;
    bpm:argType bpm:EngineArgType_map ; bpm:argMode bpm:ArgMode_optional ; bpm:argDefault "%{}" ;
    bpm:argEncoding bpm:ArgEncoding_merge_map .

bpm:demo_engine_op_run a bpm:EngineOp ;
    bpm:opEngine bpm:demo_engine ; bpm:opName "run" ; bpm:opOrder 7 ;
    bpm:opDoc "Run one f32 tensor per input." ;
    bpm:opTimeoutClass bpm:TimeoutClass_heavy ; bpm:opKind bpm:EngineOpKind_wire .
bpm:demo_engine_op_run_handle a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_run ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bpm:demo_engine_op_run_inputs a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_run ; bpm:argName "inputs" ; bpm:argOrder 2 ;
    bpm:argType bpm:EngineArgType_tensor_list ; bpm:argEncoding bpm:ArgEncoding_tensor_list .

bpm:demo_engine_op_observe a bpm:EngineOp ;
    bpm:opEngine bpm:demo_engine ; bpm:opName "observe" ; bpm:opOrder 8 ;
    bpm:opDoc "Observe a batch of (fact, value) pairs." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire .
bpm:demo_engine_op_observe_handle a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_observe ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
bpm:demo_engine_op_observe_sight a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_observe ; bpm:argName "sight" ; bpm:argOrder 2 ;
    bpm:argType bpm:EngineArgType_fact_pairs ; bpm:argEncoding bpm:ArgEncoding_pair_list .

bpm:demo_engine_op_is_done a bpm:EngineOp ;
    bpm:opEngine bpm:demo_engine ; bpm:opName "is_done" ; bpm:opOrder 9 ;
    bpm:opDoc "`{:ok, %{\"done\" => bool}}`; Elixir names it `is_done?`." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire ;
    bpm:opElixirPredicate "true" .
bpm:demo_engine_op_is_done_handle a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_is_done ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .

bpm:demo_engine_op_free_thing a bpm:EngineOp ;
    bpm:opEngine bpm:demo_engine ; bpm:opName "free_thing" ; bpm:opOrder 10 ;
    bpm:opDoc "Release a thing handle (Elixir-only: hidden from the Erlang and Gleam legs)." ;
    bpm:opTimeoutClass bpm:TimeoutClass_cheap ; bpm:opKind bpm:EngineOpKind_wire ;
    bpm:opExposeErlang "false" ; bpm:opExposeGleam "false" .
bpm:demo_engine_op_free_thing_handle a bpm:EngineArg ;
    bpm:argOp bpm:demo_engine_op_free_thing ; bpm:argName "handle" ; bpm:argOrder 1 ; bpm:argType bpm:EngineArgType_handle .
