# MESSAGE: every bpm:Field must assert exactly one bpm:fieldType value; any row is a refusal.
PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
SELECT ?subject (COUNT(DISTINCT ?value) AS ?count) WHERE {
  ?subject a bpm:Field ; bpm:fieldType ?value .
}
GROUP BY ?subject
HAVING (COUNT(DISTINCT ?value) > 1)
ORDER BY ?subject
