# MESSAGE: the number of bpm:HandAuthoredSource individuals naming one bpm:AuthorshipKind must not exceed that kind's bpm:debtCeiling -- the admitted-exception class is bounded by construction (VISION-2030 section 2) and raising a ceiling is a reviewed edit to the pack's ontology.ttl, never an ambient grant; any row is a refusal.
PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
SELECT ?kind ?ceiling (COUNT(?subject) AS ?admitted) WHERE {
  ?subject a bpm:HandAuthoredSource ;
           bpm:authorshipKind ?kind .
  ?kind bpm:debtCeiling ?ceiling .
}
GROUP BY ?kind ?ceiling
HAVING (COUNT(?subject) > ?ceiling)
ORDER BY ?kind
