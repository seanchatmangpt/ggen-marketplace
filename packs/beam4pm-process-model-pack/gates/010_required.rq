# MESSAGE: every admitted bpm:RecordType and bpm:Field must contain the fields required by its class; any row is a refusal.
PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
SELECT ?subject ?missing WHERE {
  {
    ?subject a bpm:RecordType .
    VALUES ?missing { bpm:recordName bpm:recordDoc bpm:hasField }
  } UNION {
    ?subject a bpm:Field .
    VALUES ?missing { bpm:fieldName bpm:fieldType bpm:fieldDoc bpm:fieldRequired bpm:fieldOrder }
  }
  FILTER NOT EXISTS { ?subject ?missing ?value }
}
ORDER BY ?subject ?missing
