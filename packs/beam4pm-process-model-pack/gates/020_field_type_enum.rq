# MESSAGE: every bpm:Field's bpm:fieldType must be one of the 8 admitted enum values; any row is a refusal.
PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
SELECT ?subject ?value WHERE {
  ?subject a bpm:Field ; bpm:fieldType ?value .
  FILTER(STR(?value) NOT IN ("string", "integer", "float", "boolean", "datetime", "atom", "list_string", "map"))
}
ORDER BY ?subject
