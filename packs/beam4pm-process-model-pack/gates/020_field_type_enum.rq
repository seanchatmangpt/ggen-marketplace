# MESSAGE: every bpm:Field's bpm:fieldType must name an admitted bpm:FieldType
# individual (see ontology.ttl's shared field-type vocabulary); any row is a
# refusal. Was a hardcoded 8-value string enum duplicated verbatim across
# every consuming pack's own copy of this gate; now a real anti-join against
# the same bpm:FieldType vocabulary every template's `fields` query already
# JOINs against, so admitting a 9th field type touches only that one
# ontology.ttl block -- never this file.
PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
SELECT ?subject ?value WHERE {
  ?subject a bpm:Field ; bpm:fieldType ?value .
  FILTER NOT EXISTS { ?ft a bpm:FieldType ; bpm:fieldTypeName ?value . }
}
ORDER BY ?subject
