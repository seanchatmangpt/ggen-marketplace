# MESSAGE: every bpmg:ProcessTransition's bpmg:actuationName must equal the bpma:actionName of an admitted bpma:AdmittedActuation -- otherwise the PDDL projection (templates/beam4pm_pddl.problem.pddl.tmpl) would emit an (allows_<name> ...) :init fact whose predicate no generated domain declares; any row is a refusal.
PREFIX bpmg: <https://ggen.dev/ontology/beam4pm-process-governor#>
PREFIX bpma: <https://ggen.dev/ontology/beam4pm-actuation#>
SELECT ?subject ?actuation_name WHERE {
  ?subject a bpmg:ProcessTransition ;
     bpmg:actuationName ?actuation_name .
  FILTER NOT EXISTS {
    ?a a bpma:AdmittedActuation ;
       bpma:actionName ?actuation_name .
  }
}
ORDER BY ?subject ?actuation_name
