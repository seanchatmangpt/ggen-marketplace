# MESSAGE: every bpm:ParityCheck must carry the full capability-object the renderer consumes -- missing checkName/checkDoc/ordinal/testPath/testModule/left+rightCommand/left+rightCommandKind/consentLaw/tamperFalsifier/tamperFind/tamperReplace/tamperCorpusOrder, a corpus entry missing path+sha256+order, a digest pin missing key or value, or an expected step missing order or action, would render a test that cannot compile or cannot witness its own claims; any row is a refusal.
PREFIX bpm: <https://ggen.dev/ontology/beam-process-model#>
SELECT ?subject ?missing WHERE {
  {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:checkName ?x1 } BIND("checkName" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:checkDoc ?x2 } BIND("checkDoc" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:checkOrdinal ?x3 } BIND("checkOrdinal" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:testPath ?x4 } BIND("testPath" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:testModule ?x5 } BIND("testModule" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:leftCommand ?x6 } BIND("leftCommand" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:rightCommand ?x7 } BIND("rightCommand" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:leftCommandKind ?x8 } BIND("leftCommandKind" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:rightCommandKind ?x9 } BIND("rightCommandKind" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:consentLaw ?x10 } BIND("consentLaw" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:tamperFalsifier ?x11 } BIND("tamperFalsifier" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:tamperFind ?x12 } BIND("tamperFind" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:tamperReplace ?x13 } BIND("tamperReplace" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCheck .
    FILTER NOT EXISTS { ?subject bpm:tamperCorpusOrder ?x14 } BIND("tamperCorpusOrder" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCorpus .
    FILTER NOT EXISTS { ?subject bpm:corpusPath ?x15 } BIND("corpusPath" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCorpus .
    FILTER NOT EXISTS { ?subject bpm:corpusSha256 ?x16 } BIND("corpusSha256" AS ?missing)
  } UNION {
    ?subject a bpm:ParityCorpus .
    FILTER NOT EXISTS { ?subject bpm:corpusOrder ?x17 } BIND("corpusOrder" AS ?missing)
  } UNION {
    ?subject a bpm:ParityDigestPin .
    FILTER NOT EXISTS { ?subject bpm:pinKey ?x18 } BIND("pinKey" AS ?missing)
  } UNION {
    ?subject a bpm:ParityDigestPin .
    FILTER NOT EXISTS { ?subject bpm:pinValue ?x19 } BIND("pinValue" AS ?missing)
  } UNION {
    ?subject a bpm:ParityExpectedStep .
    FILTER NOT EXISTS { ?subject bpm:stepOrder ?x20 } BIND("stepOrder" AS ?missing)
  } UNION {
    ?subject a bpm:ParityExpectedStep .
    FILTER NOT EXISTS { ?subject bpm:stepAction ?x21 } BIND("stepAction" AS ?missing)
  } UNION {
    ?subject a bpm:QualificationFixture .
    FILTER NOT EXISTS { ?subject bpm:fixtureSha256 ?x22 } BIND("fixtureSha256" AS ?missing)
  }
}
ORDER BY ?subject ?missing
