@prefix ecpr: <https://chatman.ai/ontology/evidence-capital-policy-realization#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ecpr:PolicyRealizationPack a ecpr:MeasurementPack ;
  ecpr:authority "OBSERVE|VERIFY" ;
  ecpr:consequentialDo "BRCE_ONLY" ;
  ecpr:requiresExactSubject true .

ecpr:PolicySubject a ecpr:SubjectClass .
ecpr:PolicyDecision a ecpr:DecisionClass .
ecpr:PolicyOutcome a ecpr:EvidenceClass .
ecpr:PolicyModel a ecpr:ModelClass .
ecpr:PolicyReceipt a ecpr:ReceiptClass .

ecpr:subjectSha a ecpr:IdentityProperty .
ecpr:semanticDigest a ecpr:IdentityProperty .
ecpr:strategy a ecpr:DecisionProperty .
ecpr:predictedUtility a ecpr:DecisionProperty .
ecpr:realizedUtility a ecpr:EvidenceProperty .
ecpr:realizedFalseCapital a ecpr:EvidenceProperty .
ecpr:realizedRootConcentration a ecpr:EvidenceProperty .
ecpr:gamma a ecpr:SensitivityProperty .
ecpr:observedAt a ecpr:TemporalProperty .
ecpr:currentGeneration a ecpr:TemporalProperty .
ecpr:authority a ecpr:AuthorityProperty .
ecpr:actuationPerformed a ecpr:AuthorityProperty .
