# PROVENANCE: copied verbatim (body) from /Users/sac/fnox/ontology/boundary/payload-shapes.ttl
# (fnox repo, FNOX-PRD-08 boundary shapes). Copied 2026-11-17 by marketplace lane for pack
# fnox-boundary-payload-pack 0.1.0. The source file carries no licence header; the fnox LICENSE
# was not copied and its terms are an open edge (see README.md). Edit upstream, re-copy here.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix bnd: <https://fortnox.example/shapes/boundary#> .

# FNOX-PRD-08 boundary shapes: closed NodeShapes projected to Pydantic models by ggen.toml
# rule "boundary-pydantic-models". Terms are public (FIBO MonetaryAmount, PROV-O Activity,
# DCTerms). No private fnox: terms. Field name = local name of sh:path.

bnd:MonetaryAmountPayload a sh:NodeShape ;
  rdfs:label "MonetaryAmountPayload" ;
  sh:targetClass fibo-fnd-acc-cur:MonetaryAmount ;
  sh:closed true ;
  sh:property [ sh:path <http://www.w3.org/1999/02/22-rdf-syntax-ns#value> ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path dcterms:title ; sh:datatype xsd:string ; sh:maxCount 1 ] .

bnd:ActivityPayload a sh:NodeShape ;
  rdfs:label "ActivityPayload" ;
  sh:targetClass prov:Activity ;
  sh:closed true ;
  sh:property [ sh:path dcterms:identifier ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path prov:wasInformedBy ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
  sh:property [ sh:path dcterms:created ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .
