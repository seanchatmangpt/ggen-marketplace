# Minimal positive qualification fixture: a second, independent front door
# declaring the same fixed 11-pack canonical set under a distinct
# identifier, to exercise gates/01-front-door-completeness.rq against a
# consumer-side individual rather than only the pack's own gp:GgenPlatform.
@prefix gp: <https://ggen.dev/ontology/ggen-platform#> .
@prefix mq: <https://ggen.dev/marketplace/qualification#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mq:ExampleConsumerFrontDoor a gp:FrontDoor, gp:CanonicalPack ;
  gp:standing "CANDIDATE" ;
  gp:hasComponent mq:ExConsumerMarketplaceGovernance,
                   mq:ExConsumerSemanticProjection,
                   mq:ExConsumerEvidenceStanding,
                   mq:ExConsumerDecisionOptionality,
                   mq:ExConsumerPlanningPolicy,
                   mq:ExConsumerProcessIntelligence,
                   mq:ExConsumerStateTransition,
                   mq:ExConsumerProtocolIntegration,
                   mq:ExConsumerRepositoryLifecycle,
                   mq:ExConsumerEnterpriseGovernance,
                   mq:ExConsumerExperienceProjection .

mq:ExConsumerMarketplaceGovernance a gp:ComponentPack ; gp:packName "marketplace-governance-pack" .
mq:ExConsumerSemanticProjection a gp:ComponentPack ; gp:packName "semantic-projection-pack" .
mq:ExConsumerEvidenceStanding a gp:ComponentPack ; gp:packName "evidence-standing-pack" .
mq:ExConsumerDecisionOptionality a gp:ComponentPack ; gp:packName "decision-optionality-pack" .
mq:ExConsumerPlanningPolicy a gp:ComponentPack ; gp:packName "planning-policy-pack" .
mq:ExConsumerProcessIntelligence a gp:ComponentPack ; gp:packName "process-intelligence-pack" .
mq:ExConsumerStateTransition a gp:ComponentPack ; gp:packName "state-transition-pack" .
mq:ExConsumerProtocolIntegration a gp:ComponentPack ; gp:packName "protocol-integration-pack" .
mq:ExConsumerRepositoryLifecycle a gp:ComponentPack ; gp:packName "repository-lifecycle-pack" .
mq:ExConsumerEnterpriseGovernance a gp:ComponentPack ; gp:packName "enterprise-governance-pack" .
mq:ExConsumerExperienceProjection a gp:ComponentPack ; gp:packName "experience-projection-pack" .

mq:ExampleConsumerReceipt a gp:QualificationReceipt ;
  gp:forPack mq:ExampleConsumerFrontDoor ;
  gp:receiptStatus "ALIVE" ;
  gp:qualifiedOn "2026-09-12"^^xsd:date .
