# Minimal positive qualification fixture: a second, independent front door
# declaring the same fixed 11-pack canonical set under a distinct
# identifier, to exercise gates/01-front-door-completeness.rq against a
# consumer-side individual rather than only the pack's own gpl:GgenPlatform.
#
# This fixture also re-admits exactly the four sibling-pack individuals that
# source.ttl consumes as property values. The cross-pack reference court
# deliberately does not treat instance references as vocabulary reuse: a
# consumer must restate the exact owner-declared type facts it relies on.
@prefix gpl: <https://ggen.dev/ontology/ggen-platform#> .
@prefix mq: <https://ggen.dev/marketplace/qualification#> .
@prefix mg: <https://ggen.dev/ontology/marketplace-governance#> .
@prefix do: <https://ggen.dev/ontology/decision-optionality#> .
@prefix sp: <https://ggen.dev/ontology/semantic-projection#> .
@prefix xp: <https://ggen.dev/ontology/experience-projection#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Exact facts owned by the sibling canonical packs; these qualify the four
# property-value references in source.ttl without copying sibling ontologies.
mg:MinimumNoveltyAdmissionLaw a mg:AdmissionRule .
do:MinimumNoveltyLaw a do:OptionSet .
sp:MachineSemanticCompilation a sp:SemanticCompilation .
xp:MachineExperienceProfile a xp:Profile, xp:MachineExperience .

mq:ExampleConsumerFrontDoor a gpl:FrontDoor, mg:CanonicalPack ;
  mg:standing "CANDIDATE" ;
  gpl:hasComponent mq:ExConsumerMarketplaceGovernance,
                   mq:ExConsumerSemanticProjection,
                   mq:ExConsumerEvidenceStanding,
                   mq:ExConsumerDecisionOptionality,
                   mq:ExConsumerPlanningPolicy,
                   mq:ExConsumerProcessIntelligence,
                   mq:ExConsumerStateTransition,
                   mq:ExConsumerProtocolIntegration,
                   mq:ExConsumerRepositoryLifecycle,
                   mq:ExConsumerEnterpriseGovernance,
                   mq:ExConsumerExperienceProjection .

mq:ExConsumerMarketplaceGovernance a gpl:ComponentPack ; gpl:packName "marketplace-governance-pack" .
mq:ExConsumerSemanticProjection a gpl:ComponentPack ; gpl:packName "semantic-projection-pack" .
mq:ExConsumerEvidenceStanding a gpl:ComponentPack ; gpl:packName "evidence-standing-pack" .
mq:ExConsumerDecisionOptionality a gpl:ComponentPack ; gpl:packName "decision-optionality-pack" .
mq:ExConsumerPlanningPolicy a gpl:ComponentPack ; gpl:packName "planning-policy-pack" .
mq:ExConsumerProcessIntelligence a gpl:ComponentPack ; gpl:packName "process-intelligence-pack" .
mq:ExConsumerStateTransition a gpl:ComponentPack ; gpl:packName "state-transition-pack" .
mq:ExConsumerProtocolIntegration a gpl:ComponentPack ; gpl:packName "protocol-integration-pack" .
mq:ExConsumerRepositoryLifecycle a gpl:ComponentPack ; gpl:packName "repository-lifecycle-pack" .
mq:ExConsumerEnterpriseGovernance a gpl:ComponentPack ; gpl:packName "enterprise-governance-pack" .
mq:ExConsumerExperienceProjection a gpl:ComponentPack ; gpl:packName "experience-projection-pack" .

mq:ExampleConsumerReceipt a mg:QualificationReceipt ;
  mg:forPack mq:ExampleConsumerFrontDoor ;
  mg:receiptStatus "ALIVE" ;
  mg:qualifiedOn "2026-09-12"^^xsd:date .
