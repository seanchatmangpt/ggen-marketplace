@prefix gp: <https://ggen.dev/ontology/ggen-platform#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Classes
#################################################################

gp:CanonicalPack a rdfs:Class ;
  rdfs:comment "A top-level marketplace pack that carries durable semantic authority or an independently consumable capability, the same admission concept marketplace-governance-pack's mg:CanonicalPack names." .

gp:FrontDoor a rdfs:Class ;
  rdfs:comment "A pack whose sole role is to declare the fixed set of canonical packs composing one consolidated platform topology, without absorbing or re-implementing their content." .

gp:ComponentPack a rdfs:Class ;
  rdfs:comment "A named reference to one canonical sibling pack declared as a component of the platform's front door. Carries only the referenced pack's name -- never a copy of its ontology, gates, or templates." .

gp:QualificationReceipt a rdfs:Class ;
  rdfs:comment "A recorded real-ggen-runtime qualification outcome for exactly one pack." .

#################################################################
# Properties
#################################################################

gp:hasComponent a rdf:Property ;
  rdfs:domain gp:FrontDoor ;
  rdfs:range gp:ComponentPack ;
  rdfs:comment "Declares one canonical sibling pack as a component of the platform topology this front door names. Enforced by gates/01-front-door-completeness.rq: a gp:FrontDoor individual must declare exactly 11 distinct gp:hasComponent triples, each resolving to a gp:ComponentPack whose gp:packName is one of the 11 fixed recognized canonical pack names." .

gp:packName a rdf:Property ;
  rdfs:domain gp:ComponentPack ;
  rdfs:range xsd:string ;
  rdfs:comment "The exact marketplace pack directory/[pack].name of the referenced canonical sibling pack." .

gp:standing a rdf:Property ;
  rdfs:comment "The admission standing of a pack: CANDIDATE (unqualified) or QUALIFIED (real ggen qualification passed)." .

gp:forPack a rdf:Property ;
  rdfs:domain gp:QualificationReceipt ;
  rdfs:comment "The pack a QualificationReceipt records the outcome for." .

gp:receiptStatus a rdf:Property ;
  rdfs:domain gp:QualificationReceipt ;
  rdfs:comment "The real qualify_pack() status string this receipt records: ALIVE, WARN, or a REFUSED:* code." .

gp:qualifiedOn a rdf:Property ;
  rdfs:domain gp:QualificationReceipt ;
  rdfs:comment "The date this receipt's qualification run was recorded." .

#################################################################
# The front-door individual
#################################################################

gp:GgenPlatform a gp:FrontDoor, gp:CanonicalPack ;
  rdfs:comment "The single front-door individual for the consolidated ggen Marketplace platform topology. Declares all 11 canonical component packs built in the 2026-09-12 canonical-consolidation session; owns no ontology, gate, or template content belonging to any of them." ;
  gp:standing "CANDIDATE" ;
  gp:hasComponent gp:ComponentMarketplaceGovernance,
                   gp:ComponentSemanticProjection,
                   gp:ComponentEvidenceStanding,
                   gp:ComponentDecisionOptionality,
                   gp:ComponentPlanningPolicy,
                   gp:ComponentProcessIntelligence,
                   gp:ComponentStateTransition,
                   gp:ComponentProtocolIntegration,
                   gp:ComponentRepositoryLifecycle,
                   gp:ComponentEnterpriseGovernance,
                   gp:ComponentExperienceProjection .

#################################################################
# ComponentPack individuals -- the 11 canonical sibling packs
#################################################################

gp:ComponentMarketplaceGovernance a gp:ComponentPack ;
  gp:packName "marketplace-governance-pack" .

gp:ComponentSemanticProjection a gp:ComponentPack ;
  gp:packName "semantic-projection-pack" .

gp:ComponentEvidenceStanding a gp:ComponentPack ;
  gp:packName "evidence-standing-pack" .

gp:ComponentDecisionOptionality a gp:ComponentPack ;
  gp:packName "decision-optionality-pack" .

gp:ComponentPlanningPolicy a gp:ComponentPack ;
  gp:packName "planning-policy-pack" .

gp:ComponentProcessIntelligence a gp:ComponentPack ;
  gp:packName "process-intelligence-pack" .

gp:ComponentStateTransition a gp:ComponentPack ;
  gp:packName "state-transition-pack" .

gp:ComponentProtocolIntegration a gp:ComponentPack ;
  gp:packName "protocol-integration-pack" .

gp:ComponentRepositoryLifecycle a gp:ComponentPack ;
  gp:packName "repository-lifecycle-pack" .

gp:ComponentEnterpriseGovernance a gp:ComponentPack ;
  gp:packName "enterprise-governance-pack" .

gp:ComponentExperienceProjection a gp:ComponentPack ;
  gp:packName "experience-projection-pack" .

#################################################################
# QualificationReceipt for ggen-platform-pack itself
#################################################################

gp:ReceiptGgenPlatform26912 a gp:QualificationReceipt ;
  gp:forPack gp:GgenPlatform ;
  gp:receiptStatus "ALIVE" ;
  gp:qualifiedOn "2026-09-12"^^xsd:date .
