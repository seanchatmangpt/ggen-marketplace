@prefix gpl: <https://ggen.dev/ontology/ggen-platform#> .
@prefix mg: <https://ggen.dev/ontology/marketplace-governance#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Classes
#
# CanonicalPack, QualificationReceipt and the standing/forPack/
# receiptStatus/qualifiedOn properties are single-owner vocabulary of
# marketplace-governance-pack (mg:). This pack USES them (FM-PACK-003: RDF
# needs no imports to use a term) and no longer re-declares gp: twins. The
# local prefix is gpl: so `gp:` unambiguously means the canonical
# https://ggen.dev/ns/pack# owned by ggen-pack-spec-pack.
#################################################################

gpl:FrontDoor a rdfs:Class ;
  rdfs:comment "A pack whose sole role is to declare the fixed set of canonical packs composing one consolidated platform topology, without absorbing or re-implementing their content." .

gpl:ComponentPack a rdfs:Class ;
  rdfs:comment "A named reference to one canonical sibling pack declared as a component of the platform's front door. Carries only the referenced pack's name -- never a copy of its ontology, gates, or templates." .

#################################################################
# Properties
#################################################################

gpl:hasComponent a rdf:Property ;
  rdfs:domain gpl:FrontDoor ;
  rdfs:range gpl:ComponentPack ;
  rdfs:comment "Declares one canonical sibling pack as a component of the platform topology this front door names. Enforced by gates/01-front-door-completeness.rq: a gpl:FrontDoor individual must declare exactly 11 distinct gpl:hasComponent triples, each resolving to a gpl:ComponentPack whose gpl:packName is one of the 11 fixed recognized canonical pack names." .

gpl:packName a rdf:Property ;
  rdfs:domain gpl:ComponentPack ;
  rdfs:range xsd:string ;
  rdfs:comment "The exact marketplace pack directory/[pack].name of the referenced canonical sibling pack." .

#################################################################
# The front-door individual
#################################################################

gpl:GgenPlatform a gpl:FrontDoor, mg:CanonicalPack ;
  rdfs:comment "The single front-door individual for the consolidated ggen Marketplace platform topology. Declares all 11 canonical component packs built in the 2026-09-12 canonical-consolidation session; owns no ontology, gate, or template content belonging to any of them." ;
  mg:standing "QUALIFIED" ;
  gpl:hasComponent gpl:ComponentMarketplaceGovernance,
                   gpl:ComponentSemanticProjection,
                   gpl:ComponentEvidenceStanding,
                   gpl:ComponentDecisionOptionality,
                   gpl:ComponentPlanningPolicy,
                   gpl:ComponentProcessIntelligence,
                   gpl:ComponentStateTransition,
                   gpl:ComponentProtocolIntegration,
                   gpl:ComponentRepositoryLifecycle,
                   gpl:ComponentEnterpriseGovernance,
                   gpl:ComponentExperienceProjection .

#################################################################
# ComponentPack individuals -- the 11 canonical sibling packs
#################################################################

gpl:ComponentMarketplaceGovernance a gpl:ComponentPack ;
  gpl:packName "marketplace-governance-pack" .

gpl:ComponentSemanticProjection a gpl:ComponentPack ;
  gpl:packName "semantic-projection-pack" .

gpl:ComponentEvidenceStanding a gpl:ComponentPack ;
  gpl:packName "evidence-standing-pack" .

gpl:ComponentDecisionOptionality a gpl:ComponentPack ;
  gpl:packName "decision-optionality-pack" .

gpl:ComponentPlanningPolicy a gpl:ComponentPack ;
  gpl:packName "planning-policy-pack" .

gpl:ComponentProcessIntelligence a gpl:ComponentPack ;
  gpl:packName "process-intelligence-pack" .

gpl:ComponentStateTransition a gpl:ComponentPack ;
  gpl:packName "state-transition-pack" .

gpl:ComponentProtocolIntegration a gpl:ComponentPack ;
  gpl:packName "protocol-integration-pack" .

gpl:ComponentRepositoryLifecycle a gpl:ComponentPack ;
  gpl:packName "repository-lifecycle-pack" .

gpl:ComponentEnterpriseGovernance a gpl:ComponentPack ;
  gpl:packName "enterprise-governance-pack" .

gpl:ComponentExperienceProjection a gpl:ComponentPack ;
  gpl:packName "experience-projection-pack" .

#################################################################
# QualificationReceipt for ggen-platform-pack itself (vocabulary: mg:)
#################################################################

gpl:ReceiptGgenPlatform26912 a mg:QualificationReceipt ;
  mg:forPack gpl:GgenPlatform ;
  mg:receiptStatus "ALIVE" ;
  mg:qualifiedOn "2026-09-12"^^xsd:date .
