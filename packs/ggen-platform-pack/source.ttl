@prefix g: <https://ggen.dev/ontology/consolidated-marketplace#> .
@prefix do: <https://ggen.dev/ontology/decision-optionality#> .
@prefix mg: <https://ggen.dev/ontology/marketplace-governance#> .
@prefix sp: <https://ggen.dev/ontology/semantic-projection#> .
@prefix xp: <https://ggen.dev/ontology/experience-projection#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

g:MarketplaceFrontDoor a rdfs:Class .
g:appliesLaw a rdf:Property .
g:compilesWith a rdf:Property .
g:optimizesFor a rdf:Property .
g:admittedBy a rdf:Property .
g:grantsDoAuthority a rdf:Property .

g:MachineSemanticCompilationProfile a g:MarketplaceFrontDoor ;
  g:appliesLaw do:MinimumNoveltyLaw ;
  g:compilesWith sp:MachineSemanticCompilation ;
  g:optimizesFor xp:MachineExperienceProfile ;
  g:admittedBy mg:MinimumNoveltyAdmissionLaw ;
  g:grantsDoAuthority false ;
  rdfs:comment "Front-door composition for DfCM-governed Machine Semantic Compilation and Machine Experience. It composes existing canonical authorities and introduces no top-level pack or DO authority." .
