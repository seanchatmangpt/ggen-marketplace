# MESSAGE: any returned row refuses manufacture. Enforces that the vendored
# AIRo graph (ontology/airo.ttl) actually carries the class surface the
# airo-surface generation rule projects: at least one named AIRo-namespace
# owl:Class with both rdfs:label and rdfs:comment. An empty or gutted AIRo
# graph must refuse (nonzero exit, no empty artifact rendered).
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?problem WHERE {
  FILTER NOT EXISTS {
    ?c a owl:Class ;
       rdfs:label ?l ;
       rdfs:comment ?cm .
    FILTER(STRSTARTS(STR(?c), "https://w3id.org/airo#"))
  }
  BIND("airo-graph-empty-refused" AS ?problem)
}
