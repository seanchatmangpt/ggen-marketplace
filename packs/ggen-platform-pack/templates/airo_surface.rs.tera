//! AIRo risk-ontology class surface — GENERATED by `ggen sync run` from
//! packs/ggen-platform-pack/ontology/airo.ttl. Do not edit by hand.
//!
//! Ground truth: the vendored AIRo ontology (EU AI Act / ISO 31000 risk
//! vocabulary, Golpayegani et al. 2022, CC-BY-4.0), hash-pinned by
//! witness.ttl sw:syncedGraphHash. The RDF is the source of truth;
//! regenerate rather than patching here.

{% if results | length == 0 %}
// REFUSED: empty AIRo graph projection — ontology/airo.ttl yielded zero
// class rows; refusing to render an empty surface (pn64-style fail-closed).
pub const AIRO_CLASS_COUNT: usize = 0;
{% else %}
/// Number of named AIRo classes projected from the ontology.
pub const AIRO_CLASS_COUNT: usize = {{ results | length }};

/// One row per named AIRo class: (local name, rdfs:label, rdfs:comment).
pub const AIRO_CLASSES: [(&str, &str, &str); AIRO_CLASS_COUNT] = [
{% for row in results %}
    (
        "{{ row.class | split(pat="#") | last }}",
        "{{ row.label }}",
        "{{ row.comment }}",
    ),
{% endfor %}
];
{% endif %}
