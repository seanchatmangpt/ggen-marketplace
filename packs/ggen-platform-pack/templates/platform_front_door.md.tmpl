---
to: "platform_front_door.md"
sparql:
  frontdoor: >
    PREFIX gpl: <https://ggen.dev/ontology/ggen-platform#>
    PREFIX mg: <https://ggen.dev/ontology/marketplace-governance#>
    SELECT ?standing WHERE {
      ?fd a gpl:FrontDoor ; mg:standing ?standing .
    } ORDER BY ?fd LIMIT 1
  components: >
    PREFIX gpl: <https://ggen.dev/ontology/ggen-platform#>
    SELECT ?name WHERE {
      ?fd a gpl:FrontDoor ; gpl:hasComponent ?c .
      ?c a gpl:ComponentPack ; gpl:packName ?name .
    } ORDER BY ?name
  receipts: >
    PREFIX gpl: <https://ggen.dev/ontology/ggen-platform#>
    PREFIX mg: <https://ggen.dev/ontology/marketplace-governance#>
    SELECT ?status ?qualifiedOn WHERE {
      ?r a mg:QualificationReceipt ; mg:receiptStatus ?status ; mg:qualifiedOn ?qualifiedOn .
    } ORDER BY ?qualifiedOn
---
