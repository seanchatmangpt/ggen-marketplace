---
to: "platform_front_door.md"
sparql:
  frontdoor: >
    PREFIX gp: <https://ggen.dev/ontology/ggen-platform#>
    SELECT ?standing WHERE {
      ?fd a gp:FrontDoor ; gp:standing ?standing .
    } ORDER BY ?fd LIMIT 1
  components: >
    PREFIX gp: <https://ggen.dev/ontology/ggen-platform#>
    SELECT ?name WHERE {
      ?fd a gp:FrontDoor ; gp:hasComponent ?c .
      ?c a gp:ComponentPack ; gp:packName ?name .
    } ORDER BY ?name
  receipts: >
    PREFIX gp: <https://ggen.dev/ontology/ggen-platform#>
    SELECT ?status ?qualifiedOn WHERE {
      ?r a gp:QualificationReceipt ; gp:receiptStatus ?status ; gp:qualifiedOn ?qualifiedOn .
    } ORDER BY ?qualifiedOn
---
