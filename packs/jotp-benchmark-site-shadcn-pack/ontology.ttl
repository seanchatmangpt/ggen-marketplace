pack:DeckGlAbsence a pack:UnusedHintTechnology ;
    rdfs:label "deck.gl" ;
    pack:foundInDependencies false ;
    pack:foundInSource false ;
    rdfs:comment "deck.gl was explicitly checked and is NOT used in this project: no deck.gl or @deck.gl/* entry in package.json dependencies, and a recursive grep across .ts/.tsx/.jsx source for DeckGL, Layer, ScatterplotLayer, GeoJsonLayer, HexagonLayer, and ArcLayer returned zero matches." .
