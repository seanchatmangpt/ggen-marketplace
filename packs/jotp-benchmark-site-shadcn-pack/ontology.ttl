@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:Project a pack:AdmittedProject ;
    rdfs:label "jotp-benchmark-monitor" ;
    pack:sourcePath "/Users/sac/jotp/benchmark-site"^^xsd:string ;
    pack:framework "Next.js 16 (React 19, app router)" ;
    pack:packageManager "npm (package.json, no lockfile-specific evidence gathered)" ;
    rdfs:comment "Admitted from a real local project scan on 2026-08-17. package.json name field is jotp-benchmark-monitor; deps include next ^16.1.6, react ^19.2.4." .

pack:ShadcnConfig a pack:ShadcnEvidence ;
    rdfs:label "components.json" ;
    pack:relativePath "components.json" ;
    pack:style "base-nova" ;
    pack:baseColor "neutral" ;
    pack:uiAlias "@/components/ui" ;
    rdfs:comment "shadcn/ui registry config present on disk, confirming this project was scaffolded with the shadcn CLI, not just carrying an unused dependency." .

pack:CnHelper a pack:ShadcnEvidence ;
    rdfs:label "cn() utility" ;
    pack:relativePath "lib/utils.ts" ;
    rdfs:comment "Canonical shadcn cn() helper (clsx + tailwind-merge), referenced across 18 .tsx files in components/ui and app/." .

pack:ButtonComponent a pack:ShadcnComponent ;
    rdfs:label "button.tsx" ;
    pack:relativePath "components/ui/button.tsx" ;
    pack:usesCva true ;
    rdfs:comment "shadcn button primitive using class-variance-authority for variant styling." .

