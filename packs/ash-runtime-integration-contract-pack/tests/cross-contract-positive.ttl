@prefix rt: <https://ggen.dev/ontology/runtime-integration#> .
@prefix ex: <https://example.com/runtime/> .

ex:healthy a rt:Integration ;
  rt:hasSubject ex:subject ;
  rt:hasAuthorityPolicy ex:policy ;
  rt:hasReceipt ex:receipt ;
  rt:hasReplayKey "replay-1" ;
  rt:hasDependencyDigest "deps-sha256" ;
  rt:runtimeConfig ex:config ;
  rt:actionName "create" ;
  rt:inputSchema ex:input ;
  rt:outputSchema ex:output ;
  rt:errorModule "Example.Error" ;
  rt:policyModule "Example.Policy" ;
  rt:actorRequired true ;
  rt:actorSource "context.actor" ;
  rt:tenantRequired true ;
  rt:tenantSource "context.tenant" ;
  rt:policyContextSource "context" ;
  rt:correlationIdSource "context.correlation_id" ;
  rt:idempotencyKey "request.idempotency_key" ;
  rt:maxAttempts 3 ;
  rt:timeoutMs 5000 ;
  rt:circuitFailureThreshold 5 ;
  rt:telemetryEvent "runtime.action" ;
  rt:telemetryMetric "runtime.duration" ;
  rt:emitsEventType "runtime_action" ;
  rt:transactionBoundary "action" ;
  rt:compensationAction "compensate_create" ;
  rt:isolationLevel "read_committed" ;
  rt:positiveWitness ex:witness .
