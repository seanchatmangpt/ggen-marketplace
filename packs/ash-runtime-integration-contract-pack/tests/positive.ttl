@prefix rt: <https://ggen.dev/ontology/runtime-integration#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix ocel: <https://www.ocel-standard.org/ontology#> .

rt:example a rt:Integration ;
  rt:hasSubject rt:subject ;
  rt:hasRuntimeShape rt:shape ;
  rt:hasAuthorityPolicy rt:policy ;
  rt:idempotencyKey "example-001" ;
  rt:hasDependencyDigest "abcdef123456" ;
  rt:hasConfigDigest "123456abcdef" ;
  rt:runtimeConfig "runtime" ;
  rt:emitsEventType rt:eventType ;
  rt:emitsObjectType rt:objectType ;
  rt:domainErrorNormalizerModule "Example.DomainErrorNormalizer" ;
  rt:positiveWitness rt:witness ;

  # --- Added 2026-09-14: real facts for the 33 generation rules found,
  # by actually rendering every rule via ggen_igniter, to have no
  # corresponding property or fixture data at all. One value per
  # property already declared in ontology.ttl (existing + newly added
  # *Module properties), all on this same rt:example individual unless
  # a rule's query genuinely needs a distinct joined entity (step,
  # receipt -- see rt:step/rt:example-receipt below). ---
  rt:resourceModule "Example.Runtime.Resource" ;
  rt:domainModule "Example.Runtime.Domain" ;
  rt:dataLayer "Ash.DataLayer.Ets" ;
  rt:actionName "run" ;
  rt:actionModule "Example.Runtime.Action" ;
  rt:reactorModule "Example.Runtime.Reactor" ;
  rt:hasStep rt:step ;
  rt:hasReceipt rt:example-receipt ;
  rt:receiptModule "Example.Runtime.Receipt" ;
  rt:replayActivity rt:example-replay ;
  rt:hasReplayKey "example-replay-key" ;
  rt:replayModule "Example.Runtime.Replay" ;
  rt:refusalCode "REFUSED_EXAMPLE" ;
  rt:refusalReason "example refusal for fixture coverage" ;
  rt:refusalModule "Example.Runtime.Refusal" ;
  rt:repositoryModule "Example.Runtime.Repository" ;
  rt:apiModule "Example.Runtime.Api" ;
  rt:route "/example" ;
  rt:httpMethod "GET" ;
  rt:cliModule "Example.Runtime.Cli" ;
  rt:parserModule "Example.Runtime.Cli.Parser" ;
  rt:command "run" ;
  rt:ocelModule "Example.Runtime.Ocel" ;
  rt:idempotencyModule "Example.Runtime.Idempotency" ;
  rt:telemetryEvent "example.runtime.event" ;
  rt:telemetryMetric "example.runtime.metric" ;
  rt:telemetryModule "Example.Runtime.Telemetry" ;
  rt:transactionStrategy "ash" ;
  rt:transactionBoundary "resource" ;
  rt:transactionModule "Example.Runtime.Transaction" ;
  rt:compensationModule "Example.Runtime.Compensation" ;
  rt:retryModule "Example.Runtime.Retry" ;
  rt:maxAttempts 3 ;
  rt:inputSchema "{}" ;
  rt:outputSchema "{}" ;
  rt:errorModule "Example.Runtime.Error" ;
  rt:errorCode "example_error" ;
  rt:actorSource "actor" ;
  rt:actorRequired true ;
  rt:actorContextModule "Example.Runtime.ActorContext" ;
  rt:tenantSource "tenant" ;
  rt:tenantRequired true ;
  rt:tenantContextModule "Example.Runtime.TenantContext" ;
  rt:correlationIdSource "correlation_id" ;
  rt:correlationIdRequired false ;
  rt:correlationModule "Example.Runtime.CorrelationId" ;
  rt:causationIdSource "causation_id" ;
  rt:causationModule "Example.Runtime.CausationId" ;
  rt:traceIdSource "trace_id" ;
  rt:spanIdSource "span_id" ;
  rt:traceContextModule "Example.Runtime.TraceContext" ;
  rt:versionSource "version" ;
  rt:versionRequired true ;
  rt:versionModule "Example.Runtime.VersionPrecondition" ;
  rt:optimisticLockField "lock_version" ;
  rt:optimisticLockModule "Example.Runtime.OptimisticLock" ;
  rt:defaultLimit 20 ;
  rt:maxLimit 100 ;
  rt:paginationModule "Example.Runtime.Pagination" ;
  rt:cursorField "id" ;
  rt:cursorDirection "forward" ;
  rt:cursorModule "Example.Runtime.Cursor" ;
  rt:maxBatchSize 50 ;
  rt:batchModule "Example.Runtime.Batch" ;
  rt:streamChunkSize 100 ;
  rt:backpressureMode "buffer" ;
  rt:streamModule "Example.Runtime.Stream" ;
  rt:cancellationTokenSource "cancellation_token" ;
  rt:cancellationModule "Example.Runtime.Cancellation" ;
  rt:deadlineSource "deadline_ms" ;
  rt:deadlineModule "Example.Runtime.Deadline" ;
  rt:circuitFailureThreshold 5 ;
  rt:circuitResetMs 30000 ;
  rt:circuitBreakerModule "Example.Runtime.CircuitBreaker" ;
  rt:maxConcurrent 10 ;
  rt:queueLimit 100 ;
  rt:bulkheadModule "Example.Runtime.Bulkhead" ;
  rt:cacheTtlMs 60000 ;
  rt:cacheScope "resource" ;
  rt:cachePolicyModule "Example.Runtime.CachePolicy" ;
  rt:readConsistency "eventual" ;
  rt:writeConsistency "strong" ;
  rt:consistencyModule "Example.Runtime.Consistency" ;
  rt:isolationLevel "read_committed" ;
  rt:isolationModule "Example.Runtime.Isolation" ;
  rt:featureFlag "example_feature" ;
  rt:featureDefault false ;
  rt:featureFlagModule "Example.Runtime.FeatureFlag" ;
  rt:deprecatedSince "26.9.0" ;
  rt:replacement "Example.Runtime.V2" ;
  rt:deprecationModule "Example.Runtime.Deprecation" ;
  rt:rateLimitCapacity 100 ;
  rt:rateLimitWindowMs 60000 ;
  rt:rateLimitKeySource "actor_id" ;
  rt:rateLimitModule "Example.Runtime.RateLimit" ;
  rt:createdByField "created_by" ;
  rt:updatedByField "updated_by" ;
  rt:createdAtField "inserted_at" ;
  rt:updatedAtField "updated_at" ;
  rt:auditFieldsModule "Example.Runtime.AuditFields" ;
  rt:inputNormalizer "trim" ;
  rt:normalizationMode "strict" ;
  rt:inputNormalizationModule "Example.Runtime.InputNormalization" ;
  rt:outputSanitizer "escape_html" ;
  rt:sanitizationMode "strict" ;
  rt:outputSanitizationModule "Example.Runtime.OutputSanitization" ;
  rt:policyModule "Example.Runtime.Policy" ;
  rt:policyContextSource "policy_context" ;
  rt:policyContextModule "Example.Runtime.PolicyContext" ;
  rt:domainErrorCodeField "code" ;
  rt:domainErrorMessageField "message" ;
  rt:domainErrorDetailsField "details" ;
  rt:domainErrorModule "Example.Runtime.DomainError" ;
  rt:eventTypeField "type" ;
  rt:eventSubjectField "subject" ;
  rt:eventTimeField "time" ;
  rt:eventDataField "data" ;
  rt:eventEnvelopeModule "Example.Runtime.EventEnvelope" .

rt:step rt:stepModule "Example.Runtime.Reactor.Step" ;
  rt:compensationAction "Example.Runtime.Reactor.Compensate" .

rt:subject dct:identifier "abcdef123456" ; dct:isPartOf "seanchatmangpt/example" ; dct:source "main" .
rt:shape a rt:RuntimeShape ;
  rt:runtimeShapeModule "Example.RuntimeShapeContract" ;
  rt:shapeSubjectId "urn:example:subject" ;
  rt:sourceDigest "sha256:source" ;
  rt:graphDigest "sha256:graph" ;
  rt:admissionStatus "admitted" ;
  prov:wasDerivedFrom rt:subject .
rt:policy odrl:permission [ odrl:action odrl:use ] .
rt:eventType a ocel:EventType .
rt:objectType a ocel:ObjectType .
rt:witness a rt:PositiveWitness ; prov:wasGeneratedBy rt:execution .
rt:execution a prov:Activity .
rt:example-receipt a rt:Receipt ; prov:wasGeneratedBy rt:execution .
rt:example-replay a prov:Activity .
