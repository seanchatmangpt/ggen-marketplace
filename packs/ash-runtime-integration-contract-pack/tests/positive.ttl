@prefix rt: <https://ggen.dev/ontology/runtime-integration#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix ocel: <https://www.ocel-standard.org/ontology#> .

rt:example a rt:Integration ;
  rt:hasSubject rt:subject ;
  rt:hasAuthorityPolicy rt:policy ;
  rt:idempotencyKey "example-001" ;
  rt:hasDependencyDigest "abcdef123456" ;
  rt:hasConfigDigest "123456abcdef" ;
  rt:runtimeConfig "runtime" ;
  rt:emitsEventType rt:eventType ;
  rt:emitsObjectType rt:objectType ;
  rt:positiveWitness rt:witness .

rt:subject dct:identifier "abcdef123456" ; dct:isPartOf "seanchatmangpt/example" ; dct:source "main" .
rt:policy odrl:permission [ odrl:action odrl:use ] .
rt:eventType a ocel:EventType .
rt:objectType a ocel:ObjectType .
rt:witness a rt:PositiveWitness ; prov:wasGeneratedBy rt:execution .
rt:execution a prov:Activity .
