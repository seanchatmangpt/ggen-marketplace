@prefix rt: <https://ggen.dev/ontology/runtime-integration#> .
@prefix ex: <https://example.com/runtime/> .

# Deliberately unsafe: authority without exact subject.
ex:authorityLeak a rt:Integration ;
  rt:hasAuthorityPolicy ex:policy .

# Deliberately unsafe: retry without idempotency or timeout/circuit guard.
ex:retryLeak a rt:Integration ;
  rt:maxAttempts 3 .

# Deliberately unsafe: tenant-required global cache.
ex:tenantCacheLeak a rt:Integration ;
  rt:tenantRequired true ;
  rt:tenantSource "actor.tenant" ;
  rt:cacheScope "global" .

# Deliberately unsafe: API projection without authority, route, or schemas.
ex:apiLeak a rt:Integration ;
  rt:apiModule "Example.Api" .

# Deliberately unsafe: transactional Reactor without compensation or receipt.
ex:reactorLeak a rt:Integration ;
  rt:reactorModule "Example.Reactor" ;
  rt:transactionBoundary "workflow" .
