PREFIX rt: <https://ggen.dev/ontology/runtime-integration#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?integration ?witness ?activity WHERE {
  ?integration a rt:Integration ; rt:positiveWitness ?witness .
  ?witness a rt:PositiveWitness ; prov:wasGeneratedBy ?activity .
}

ORDER BY ?integration ?witness ?activity
