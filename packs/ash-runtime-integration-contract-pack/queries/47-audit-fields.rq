PREFIX rt: <https://ggen.dev/ontology/runtime-integration#>
SELECT ?integration ?createdBy ?updatedBy ?createdAt ?updatedAt WHERE {
  ?integration a rt:Integration ; rt:createdByField ?createdBy ; rt:updatedByField ?updatedBy ; rt:createdAtField ?createdAt ; rt:updatedAtField ?updatedAt .
}

ORDER BY ?integration ?createdBy ?updatedBy ?createdAt ?updatedAt
