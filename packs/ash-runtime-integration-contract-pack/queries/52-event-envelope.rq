PREFIX rt: <https://ggen.dev/ontology/runtime-integration#>
SELECT ?integration ?typeField ?subjectField ?timeField ?dataField WHERE {
  ?integration a rt:Integration ; rt:eventTypeField ?typeField ; rt:eventSubjectField ?subjectField ; rt:eventTimeField ?timeField ; rt:eventDataField ?dataField .
}

ORDER BY ?integration ?typeField ?subjectField ?timeField ?dataField
