PREFIX rt: <https://ggen.dev/ontology/runtime-integration#>
PREFIX ocel: <https://www.ocel-standard.org/ontology#>
SELECT ?integration ?eventType ?objectType WHERE {
  ?integration a rt:Integration ; rt:emitsEventType ?eventType ; rt:emitsObjectType ?objectType .
  ?eventType a ocel:EventType .
  ?objectType a ocel:ObjectType .
}
ORDER BY ?integration ?eventType ?objectType
