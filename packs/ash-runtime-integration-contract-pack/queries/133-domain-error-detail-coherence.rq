PREFIX rt: <https://ggen.dev/ontology/runtime-integration#>
SELECT ?integration ?codeField WHERE {
  ?integration a rt:Integration ; rt:domainErrorCodeField ?codeField .
  FILTER NOT EXISTS { ?integration rt:domainErrorMessageField ?messageField }
  FILTER NOT EXISTS { ?integration rt:domainErrorDetailsField ?detailsField }
}
ORDER BY ?integration
