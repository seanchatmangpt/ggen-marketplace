@prefix rt: <https://ggen.dev/ontology/runtime-integration#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix ocel: <https://www.ocel-standard.org/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rt:Integration a prov:Entity .
rt:ExactSubject a prov:Entity .
rt:RuntimeAction a prov:Activity .
rt:Receipt a prov:Entity .
rt:Refusal a prov:Entity .
rt:Replay a prov:Activity .
rt:RuntimeConfig a prov:Entity .
rt:DependencyDigest a prov:Entity .
rt:PositiveWitness a prov:Entity .
rt:NegativeFalsifier a prov:Entity .

rt:hasSubject a prov:qualifiedAssociation .
rt:hasAuthorityPolicy a odrl:Policy .
rt:hasReceipt a prov:wasGeneratedBy .
rt:hasReplayKey a prov:qualifiedDerivation .
rt:hasDependencyDigest a dct:identifier .
rt:hasConfigDigest a dct:identifier .
rt:emitsObjectType a ocel:ObjectType .
rt:emitsEventType a ocel:EventType .
rt:idempotencyKey a dct:identifier .
rt:timeoutMs a dct:extent .
rt:maxAttempts a dct:extent .
