#################################################################
# Generated-module-name properties, one per generation rule concern.
# Added 2026-09-14: every [[generation.rules]] template in this pack's
# ggen.toml names its own module via a *_module Tera variable, but ~33 of
# them had no corresponding rt:*Module property declared here at all --
# real, verified via actually rendering each rule through ggen_igniter
# (not the sandboxed native ggen binary) against this pack's own
# tests/positive.ttl fixture: 33 of 38 rules failed with undefined-Tera-
# variable errors because no property existed to bind them. Naming
# convention matches the properties already declared above
# (resourceModule/domainModule/reactorModule/stepModule/repositoryModule/
# errorModule/apiModule/cliModule/domainErrorNormalizerModule): one
# `rt:<Concern>Module` property per rule, always domain rt:Integration.
#################################################################
rt:actionModule a rdf:Property .
rt:refusalModule a rdf:Property .
rt:receiptModule a rdf:Property .
rt:replayModule a rdf:Property .
rt:idempotencyModule a rdf:Property .
rt:transactionModule a rdf:Property .
rt:compensationModule a rdf:Property .
rt:ocelModule a rdf:Property .
rt:retryModule a rdf:Property .
rt:telemetryModule a rdf:Property .
rt:parserModule a rdf:Property .
rt:actorContextModule a rdf:Property .
rt:tenantContextModule a rdf:Property .
rt:correlationModule a rdf:Property .
rt:causationModule a rdf:Property .
rt:traceContextModule a rdf:Property .
rt:versionModule a rdf:Property .
rt:optimisticLockModule a rdf:Property .
rt:paginationModule a rdf:Property .
rt:cursorModule a rdf:Property .
rt:batchModule a rdf:Property .
rt:streamModule a rdf:Property .
rt:cancellationModule a rdf:Property .
rt:deadlineModule a rdf:Property .
rt:circuitBreakerModule a rdf:Property .
rt:bulkheadModule a rdf:Property .
rt:cachePolicyModule a rdf:Property .
rt:consistencyModule a rdf:Property .
rt:isolationModule a rdf:Property .
