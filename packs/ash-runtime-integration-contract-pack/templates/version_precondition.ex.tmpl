defmodule {{ version_module }} do
  @source {{ version_source | json_encode }}

  def check(context, expected) do
    case Map.fetch(context, @source) do
      {:ok, ^expected} -> :ok
      {:ok, actual} -> {:error, {:REFUSED_VERSION_MISMATCH, actual, expected}}
      :error -> {:error, :REFUSED_VERSION_MISSING}
    end
  end
end
