defmodule {{ deadline_module }} do
  @source {{ deadline_source | json_encode }}

  def remaining_ms(context, now_ms) do
    with {:ok, deadline_ms} <- Map.fetch(context, @source),
         true <- is_integer(deadline_ms) and deadline_ms >= now_ms do
      {:ok, deadline_ms - now_ms}
    else
      :error -> {:error, :REFUSED_DEADLINE_MISSING}
      false -> {:error, :REFUSED_DEADLINE_EXPIRED}
    end
  end
end
