defmodule {{ optimistic_lock_module }} do
  @field {{ lock_field | json_encode }}

  def compare(record, expected) do
    case Map.fetch(record, @field) do
      {:ok, ^expected} -> :ok
      {:ok, actual} -> {:error, {:REFUSED_STALE_VERSION, actual, expected}}
      :error -> {:error, :REFUSED_LOCK_FIELD_MISSING}
    end
  end
end
