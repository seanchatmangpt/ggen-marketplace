defmodule {{ trace_context_module }} do
  @trace_source {{ trace_source | json_encode }}
  @span_source {{ span_source | json_encode }}

  def resolve(context) do
    with {:ok, trace_id} <- Map.fetch(context, @trace_source),
         {:ok, span_id} <- Map.fetch(context, @span_source) do
      {:ok, %{trace_id: trace_id, span_id: span_id}}
    end
  end
end
