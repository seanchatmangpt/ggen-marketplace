---
to: "src/shacl_zod_schemas.js"
sparql:
  schemas: "PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> SELECT ?schemaName WHERE { ?schema a sp:ZodSchema ; sp:derivedFromShape ?shape ; sp:schemaName ?schemaName . } ORDER BY ?schemaName"
  fields: "PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> PREFIX sh: <http://www.w3.org/ns/shacl#> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> SELECT ?schemaName ?fieldName ?zodType ?nullable ?collection (GROUP_CONCAT(CONCAT('\\\"', STR(?enumValue), '\\\"'); separator=', ') AS ?enumValues) WHERE { ?schema a sp:ZodSchema ; sp:derivedFromShape ?shape ; sp:schemaName ?schemaName . ?shape sh:property ?prop . ?prop sh:path ?path ; sh:datatype ?dt . BIND(REPLACE(STR(?path), \"^.*[/#:]\", \"\") AS ?fieldName) BIND(IF(?dt = <http://www.w3.org/2001/XMLSchema#string>, \"z.string()\", IF(?dt = <http://www.w3.org/2001/XMLSchema#boolean>, \"z.boolean()\", IF(?dt IN (<http://www.w3.org/2001/XMLSchema#integer>, <http://www.w3.org/2001/XMLSchema#long>), \"z.number().int()\", \"z.number()\"))) AS ?zodType) OPTIONAL { ?prop sp:nullable ?nullableRaw } OPTIONAL { ?prop sp:collection ?collectionRaw } OPTIONAL { ?prop sh:in ?enumList . ?enumList rdf:rest*/rdf:first ?enumValue } BIND(COALESCE(STR(?nullableRaw), \"false\") AS ?nullable) BIND(COALESCE(STR(?collectionRaw), \"false\") AS ?collection) } GROUP BY ?schemaName ?fieldName ?zodType ?nullable ?collection ORDER BY ?schemaName ?fieldName"
  nested_fields: "PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> PREFIX sh: <http://www.w3.org/ns/shacl#> SELECT ?schemaName ?fieldName ?nestedType ?nullable ?collection WHERE { ?schema a sp:ZodSchema ; sp:derivedFromShape ?shape ; sp:schemaName ?schemaName . ?shape sh:property ?prop . ?prop sh:path ?path ; sh:node ?nestedShape . ?nestedShape sp:projectionName ?nestedType . BIND(REPLACE(STR(?path), \"^.*[/#:]\", \"\") AS ?fieldName) OPTIONAL { ?prop sp:nullable ?nullableRaw } OPTIONAL { ?prop sp:collection ?collectionRaw } BIND(COALESCE(STR(?nullableRaw), \"false\") AS ?nullable) BIND(COALESCE(STR(?collectionRaw), \"false\") AS ?collection) } ORDER BY ?schemaName ?fieldName"
---
import { z } from "zod";

{% for s in schemas %}
export const {{ s.schemaName }} = z.object({
{% for f in fields %}{% if f.schemaName == s.schemaName %}  {{ f.fieldName }}: {% if f.collection == "true" %}z.array({% endif %}{% if f.enumValues %}z.enum([{{ f.enumValues }}]){% else %}{{ f.zodType }}{% endif %}{% if f.collection == "true" %}){% endif %}{% if f.nullable == "true" %}.nullable(){% endif %},
{% endif %}{% endfor %}{% for f in nested_fields %}{% if f.schemaName == s.schemaName %}  {{ f.fieldName }}: {% if f.collection == "true" %}z.array({% endif %}z.lazy(() => {{ f.nestedType }}){% if f.collection == "true" %}){% endif %}{% if f.nullable == "true" %}.nullable(){% endif %},
{% endif %}{% endfor %}});
{% endfor %}