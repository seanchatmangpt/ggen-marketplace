# Zod projection vocabulary. Pure law; consumers supply projection individuals.
@prefix sp:   <http://seanchatmangpt.github.io/packs/shacl-projection#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

sp:ZodSchema a rdfs:Class ;
    rdfs:label "ZodSchema" ;
    rdfs:comment "A Zod object schema whose fields are projected from a real SHACL NodeShape via sp:derivedFromShape." .

sp:schemaName a rdf:Property ;
    rdfs:label "schema name" ;
    rdfs:domain sp:ZodSchema ;
    rdfs:range xsd:string ;
    rdfs:comment "The JavaScript export identifier rendered verbatim; the source graph must already provide a legal identifier." .
