---
to: "components/states/AsyncStates.tsx"
---
{% raw %}
import { Alert, AlertTitle, AlertDescription } from "@/components/ui/alert";
import { Button } from "@/components/ui/button";

export function EmptyState({ message = "No entities to display yet." }: { message?: string }) {
  return (
    <Alert>
      <AlertTitle>No data</AlertTitle>
      <AlertDescription>{message}</AlertDescription>
    </Alert>
  );
}

export interface ErrorStateProps {
  error: Error | string;
  onRetry: () => void;
}

/** Real error message, real destructive variant, real retry action. */
export function ErrorState({ error, onRetry }: ErrorStateProps) {
  const message = typeof error === "string" ? error : error.message;
  return (
    <Alert variant="destructive">
      <AlertTitle>Failed to load dashboard data</AlertTitle>
      <AlertDescription className="space-y-3">
        <p className="font-mono text-xs">{message}</p>
        <Button variant="outline" size="sm" onClick={onRetry}>
          Retry
        </Button>
      </AlertDescription>
    </Alert>
  );
}
{% endraw %}
