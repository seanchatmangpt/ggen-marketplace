@prefix pack: <urn:ggen-marketplace:shadcn-async-states-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pack:DashboardSkeleton a pack:ReactComponent ;
    rdfs:label "DashboardSkeleton" ;
    pack:shape "canvas + legend + panel + table-row placeholders" ;
    pack:usesGenericSpinner false ;
    rdfs:comment "Content-shaped shadcn Skeleton blocks matching the eventual dashboard layout, not a generic spinner." .

pack:EmptyState a pack:ReactComponent ;
    rdfs:label "EmptyState" ;
    pack:alertVariant "default" ;
    rdfs:comment "Real shadcn Alert explaining there is no data yet." .

pack:ErrorState a pack:ReactComponent ;
    rdfs:label "ErrorState" ;
    pack:alertVariant "destructive" ;
    pack:showsRealErrorMessage true ;
    pack:hasRetryButton true ;
    rdfs:comment "Real shadcn Alert (destructive) surfacing the actual error message plus a retry Button wired to a caller-supplied callback." .
