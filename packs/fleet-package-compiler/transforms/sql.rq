PREFIX fp: <https://ggen.dev/ontology/fleet-package#>
SELECT ?subject ?consumer ?targetRepo ?targetPath ?templateKey WHERE { ?plan a fp:PackagePlan ; fp:subject ?subject ; fp:consumer ?consumer ; fp:family fp:family-sql ; fp:targetRepo ?targetRepo ; fp:targetPath ?targetPath ; fp:templateKey ?templateKey . } ORDER BY ?targetRepo ?targetPath
