@prefix fp: <https://ggen.dev/ontology/fleet-package#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
fp:PackagePlan a owl:Class . fp:Family a owl:Class . fp:Consumer a owl:Class . fp:subject a owl:ObjectProperty . fp:consumer a owl:ObjectProperty . fp:family a owl:ObjectProperty . fp:targetRepo a owl:DatatypeProperty . fp:targetPath a owl:DatatypeProperty . fp:templateKey a owl:DatatypeProperty . fp:authority a owl:DatatypeProperty . fp:sourceSha a owl:DatatypeProperty .

# Pack-level mode/authority fence (carried over from the retired ggen.toml [metadata] table).
@prefix dcterms: <http://purl.org/dc/terms/> .
<https://ggen.dev/ontology/fleet-package> a owl:Ontology ;
  dcterms:title "fleet-package-compiler" ;
  fp:authority "NONE" ;
  fp:mode "CONSTRUCT_ONLY" .
fp:mode a owl:DatatypeProperty .
