PREFIX qri: <https://ggen.dev/ns/qri#>
SELECT ?standing ?reason WHERE {
  ?standing a qri:StandingAssertion ;
            qri:standingState qri:QualifiedState ;
            qri:standingOf ?realization ;
            qri:underContract ?contract ;
            qri:inContext ?context .
  FILTER NOT EXISTS {
    ?standing qri:basedOnQualification ?qualification .
    ?qualification a qri:Qualification ;
                   qri:subjectRealization ?realization ;
                   qri:qualifiesFor ?contract ;
                   qri:inContext ?context ;
                   qri:qualificationVerdict qri:Pass .
  }
  BIND("QUALIFIED_STANDING_WITHOUT_MATCHING_PASS" AS ?reason)
}
