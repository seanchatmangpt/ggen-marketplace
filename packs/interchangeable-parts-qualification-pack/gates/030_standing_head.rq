PREFIX qri: <https://ggen.dev/ns/qri#>
SELECT ?standing ?other ?reason WHERE {
  ?standing a qri:StandingAssertion ; qri:standingOf ?realization ;
            qri:underContract ?contract ; qri:inContext ?context .
  FILTER NOT EXISTS { ?newer qri:supersedesStanding ?standing }
  ?other a qri:StandingAssertion ; qri:standingOf ?realization ;
         qri:underContract ?contract ; qri:inContext ?context .
  FILTER (?other != ?standing)
  FILTER NOT EXISTS { ?newerOther qri:supersedesStanding ?other }
  BIND("MULTIPLE_CURRENT_STANDING_HEADS" AS ?reason)
}
