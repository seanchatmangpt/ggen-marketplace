PREFIX qri: <https://ggen.dev/ns/qri#>
SELECT ?decision ?reason WHERE {
  ?decision a qri:AdmissionDecision ; qri:decision qri:Permit ; qri:forQualification ?qualification .
  { FILTER NOT EXISTS { ?decision qri:authorityEvidence ?authority } BIND("MISSING_AUTHORITY_EVIDENCE" AS ?reason) }
  UNION { FILTER NOT EXISTS { ?qualification qri:qualificationVerdict qri:Pass } BIND("PERMIT_WITHOUT_PASS" AS ?reason) }
}
