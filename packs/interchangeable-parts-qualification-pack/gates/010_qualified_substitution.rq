PREFIX qri: <https://ggen.dev/ns/qri#>
SELECT ?qualification ?reason WHERE {
  ?qualification a qri:Qualification ; qri:qualificationVerdict qri:Pass .
  { FILTER NOT EXISTS { ?qualification qri:subjectRealization ?r } BIND("MISSING_REALIZATION" AS ?reason) }
  UNION { FILTER NOT EXISTS { ?qualification qri:qualifiesFor ?c } BIND("MISSING_CONTRACT" AS ?reason) }
  UNION { FILTER NOT EXISTS { ?qualification qri:inContext ?x } BIND("MISSING_CONTEXT" AS ?reason) }
  UNION { FILTER NOT EXISTS { ?qualification qri:hasEvidence ?e } BIND("MISSING_EVIDENCE" AS ?reason) }
  UNION {
    ?qualification qri:qualifiesFor ?c . ?c qri:requiresInvariant ?required .
    FILTER NOT EXISTS { ?qualification qri:preservesInvariant ?required }
    BIND("MISSING_REQUIRED_INVARIANT" AS ?reason)
  }
}
