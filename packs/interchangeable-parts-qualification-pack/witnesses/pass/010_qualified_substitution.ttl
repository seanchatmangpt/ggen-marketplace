@prefix ipq: <https://ggen.dev/ontology/interchangeable-parts-qualification#> .

ipq:req1 a ipq:PartRequirement ;
  ipq:requirementDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" .

ipq:old a ipq:PartPassport ;
  ipq:partDigest "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ;
  ipq:subjectSha "1111111111111111111111111111111111111111" ;
  ipq:producerDigest "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" ;
  ipq:consequenceDigest "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" .

ipq:new a ipq:PartPassport ;
  ipq:partDigest "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee" ;
  ipq:subjectSha "2222222222222222222222222222222222222222" ;
  ipq:producerDigest "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff" ;
  ipq:consequenceDigest "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" ;
  ipq:grantsDoAuthority false .

ipq:receipt1 a ipq:QualificationReceipt ;
  ipq:verifierEvidence "sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" ;
  ipq:replayDigest "sha256:abcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcd" ;
  ipq:passed true .

ipq:claim1 a ipq:SubstitutionClaim ;
  ipq:originalPart ipq:old ;
  ipq:replacementPart ipq:new ;
  ipq:requirement ipq:req1 ;
  ipq:qualificationReceipt ipq:receipt1 ;
  ipq:grantsDoAuthority false .
