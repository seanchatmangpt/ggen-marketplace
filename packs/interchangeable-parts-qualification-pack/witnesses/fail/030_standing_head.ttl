@prefix qri: <https://ggen.dev/ns/qri#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix ex: <https://example.invalid/qri/> .

ex:cap a qri:Capability .
ex:c1 a qri:CapabilityContract ; qri:definesCapability ex:cap ; qri:governsProcedure ex:p ; qri:requiresInvariant ex:i1 .
ex:i1 a qri:Invariant .
ex:p a sosa:Procedure ; sosa:implementedBy ex:r1, ex:r2 .
ex:r1 a sosa:System . ex:r2 a sosa:System . ex:ctx a qri:ExecutionContext .
ex:e1 a prov:Entity . ex:e2 a prov:Entity . ex:auth1 a prov:Entity . ex:auth2 a prov:Entity .

ex:q1 a qri:Qualification ; qri:subjectRealization ex:r1 ; qri:qualifiesFor ex:c1 ; qri:inContext ex:ctx ;
  qri:qualificationVerdict qri:Pass ; qri:preservesInvariant ex:i1 ; qri:hasEvidence ex:e1 .
ex:q2 a qri:Qualification ; qri:subjectRealization ex:r2 ; qri:qualifiesFor ex:c1 ; qri:inContext ex:ctx ;
  qri:qualificationVerdict qri:Pass ; qri:preservesInvariant ex:i1 ; qri:hasEvidence ex:e2 .

ex:claim a qri:InterchangeabilityClaim ; qri:memberRealization ex:r1, ex:r2 ; qri:underContract ex:c1 ;
  qri:interchangeableUnder ex:ctx ; qri:basedOnQualification ex:q1, ex:q2 ; qri:preservesInvariant ex:i1 .

ex:d1 a qri:AdmissionDecision ; qri:decision qri:Permit ; qri:forQualification ex:q1 ; qri:authorityEvidence ex:auth1 .
ex:d2 a qri:AdmissionDecision ; qri:decision qri:Permit ; qri:forQualification ex:q2 ; qri:authorityEvidence ex:auth2 .

ex:s1 a qri:StandingAssertion ; qri:standingOf ex:r1 ; qri:underContract ex:c1 ; qri:inContext ex:ctx ;
  qri:standingState qri:AdmittedState ; qri:basedOnQualification ex:q1 .
ex:s2 a qri:StandingAssertion ; qri:standingOf ex:r2 ; qri:underContract ex:c1 ; qri:inContext ex:ctx ;
  qri:standingState qri:AdmittedState ; qri:basedOnQualification ex:q2 .

ex:s1b a qri:StandingAssertion ; qri:standingOf ex:r1 ; qri:underContract ex:c1 ; qri:inContext ex:ctx ;
  qri:standingState qri:QualifiedState ; qri:basedOnQualification ex:q1 .
