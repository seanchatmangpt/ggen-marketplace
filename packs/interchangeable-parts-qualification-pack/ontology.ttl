@prefix qri: <https://ggen.dev/ns/qri#> .
@prefix ipq: <https://ggen.dev/ontology/interchangeable-parts-qualification#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

qri: a owl:Ontology ;
  owl:versionInfo "26.9.30" ;
  rdfs:comment "Qualified Runtime Interchangeability profile. Qualification, admission, standing and bounded interchangeability remain distinct." .

qri:Capability a owl:Class .
qri:CapabilityContract a owl:Class ; rdfs:subClassOf prov:Entity .
qri:Invariant a owl:Class .
qri:ExecutionContext a owl:Class ; rdfs:subClassOf prov:Entity .
qri:Grounding a owl:Class ; rdfs:subClassOf prov:Entity .
qri:Qualification a owl:Class ; rdfs:subClassOf prov:Entity .
qri:QualificationVerdict a owl:Class .
qri:Pass a qri:QualificationVerdict .
qri:Fail a qri:QualificationVerdict .
qri:Indeterminate a qri:QualificationVerdict .
qri:Unsupported a qri:QualificationVerdict .
qri:AdmissionDecision a owl:Class ; rdfs:subClassOf prov:Entity .
qri:AdmissionDisposition a owl:Class .
qri:Permit a qri:AdmissionDisposition .
qri:Deny a qri:AdmissionDisposition .
qri:StandingAssertion a owl:Class ; rdfs:subClassOf prov:Entity .
qri:StandingState a owl:Class .
qri:CandidateState a qri:StandingState .
qri:QualifiedState a qri:StandingState .
qri:AdmittedState a qri:StandingState .
qri:AdmissionDeniedState a qri:StandingState .
qri:SuspendedState a qri:StandingState .
qri:RetiredState a qri:StandingState .
qri:InterchangeabilityClaim a owl:Class ; rdfs:subClassOf prov:Entity .
qri:Receipt a owl:Class ; rdfs:subClassOf prov:Entity .
qri:RuntimeExecution a owl:Class ; rdfs:subClassOf sosa:Execution, prov:Activity .

qri:definesCapability a owl:ObjectProperty .
qri:governsProcedure a owl:ObjectProperty .
qri:claimsCapability a owl:ObjectProperty .
qri:requiresInvariant a owl:ObjectProperty .
qri:subjectRealization a owl:ObjectProperty .
qri:qualifiesFor a owl:ObjectProperty .
qri:inContext a owl:ObjectProperty .
qri:qualificationVerdict a owl:ObjectProperty .
qri:preservesInvariant a owl:ObjectProperty .
qri:hasEvidence a owl:ObjectProperty .
qri:memberRealization a owl:ObjectProperty .
qri:underContract a owl:ObjectProperty .
qri:interchangeableUnder a owl:ObjectProperty .
qri:basedOnQualification a owl:ObjectProperty .
qri:decision a owl:ObjectProperty .
qri:forQualification a owl:ObjectProperty .
qri:authorityEvidence a owl:ObjectProperty .
qri:standingOf a owl:ObjectProperty .
qri:standingState a owl:ObjectProperty .
qri:supersedesStanding a owl:ObjectProperty .
qri:artifact a owl:ObjectProperty .
qri:grounding a owl:ObjectProperty .
qri:onHost a owl:ObjectProperty .
qri:contextManifest a owl:ObjectProperty .

# Compatibility seam for the pre-QRI pack vocabulary: specialization only,
# never global identity/equivalence.
ipq:PartRequirement rdfs:subClassOf qri:CapabilityContract .
ipq:SubstitutionClaim rdfs:subClassOf qri:InterchangeabilityClaim .
ipq:QualificationReceipt rdfs:subClassOf qri:Receipt .
ipq:requirement rdfs:subPropertyOf qri:underContract .
ipq:qualificationReceipt rdfs:subPropertyOf qri:hasEvidence .
