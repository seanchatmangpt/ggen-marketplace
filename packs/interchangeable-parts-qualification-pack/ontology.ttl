@prefix ipq: <https://ggen.dev/ontology/interchangeable-parts-qualification#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ipq:PartRequirement a rdfs:Class .
ipq:PartPassport a rdfs:Class .
ipq:SubstitutionClaim a rdfs:Class .
ipq:QualificationReceipt a rdfs:Class .

ipq:requirementDigest a rdf:Property .
ipq:partDigest a rdf:Property .
ipq:subjectSha a rdf:Property .
ipq:producerDigest a rdf:Property .
ipq:consequenceDigest a rdf:Property .
ipq:authorityCeiling a rdf:Property .
ipq:verifierEvidence a rdf:Property .
ipq:receipt a rdf:Property .
ipq:replayDigest a rdf:Property .
ipq:substitutesFor a rdf:Property .
ipq:satisfies a rdf:Property .
ipq:originalPart a rdf:Property .
ipq:replacementPart a rdf:Property .
ipq:requirement a rdf:Property .
ipq:qualificationReceipt a rdf:Property .
ipq:passed a rdf:Property .
ipq:grantsDoAuthority a rdf:Property .

ipq:policyV1 ipq:authorityCeiling "OBSERVE|SELECT|CONSTRUCT" ;
  ipq:grantsDoAuthority false .


ipq:canonicalCoreModule a rdf:Property .
ipq:canonicalReceiptsModule a rdf:Property .
ipq:partRequirementSchema a rdf:Property .
ipq:partPassportSchema a rdf:Property .
ipq:substitutionJudgementSchema a rdf:Property .
ipq:substitutionReceiptSchema a rdf:Property .
ipq:adapterSchema a rdf:Property .

ipq:policyV1
  ipq:canonicalCoreModule "@unrdf/core" ;
  ipq:canonicalReceiptsModule "@unrdf/receipts" ;
  ipq:partRequirementSchema "unrdf.part-requirement/1" ;
  ipq:partPassportSchema "unrdf.part-passport/1" ;
  ipq:substitutionJudgementSchema "unrdf.part-substitution-judgement/1" ;
  ipq:substitutionReceiptSchema "unrdf.part-substitution-receipt/1" ;
  ipq:adapterSchema "ggen.interchangeable-part-consumer-adapter/1" .
