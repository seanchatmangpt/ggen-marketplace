@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ipq: <https://ggen.dev/ontology/interchangeable-parts-qualification#> .

ipq:SubstitutionClaimShape a sh:NodeShape ;
  sh:targetClass ipq:SubstitutionClaim ;
  sh:property [ sh:path ipq:originalPart ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ipq:replacementPart ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ipq:requirement ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ipq:qualificationReceipt ; sh:minCount 1 ; sh:maxCount 1 ] .

ipq:PartPassportShape a sh:NodeShape ;
  sh:targetClass ipq:PartPassport ;
  sh:property [ sh:path ipq:partDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ipq:subjectSha ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{40}$" ] ;
  sh:property [ sh:path ipq:producerDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ipq:consequenceDigest ; sh:minCount 1 ; sh:maxCount 1 ] .

ipq:QualificationReceiptShape a sh:NodeShape ;
  sh:targetClass ipq:QualificationReceipt ;
  sh:property [ sh:path ipq:verifierEvidence ; sh:minCount 1 ] ;
  sh:property [ sh:path ipq:replayDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ipq:passed ; sh:hasValue true ] .
