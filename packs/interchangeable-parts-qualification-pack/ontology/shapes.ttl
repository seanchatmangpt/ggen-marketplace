@prefix qri: <https://ggen.dev/ns/qri#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

qri:QualificationShape a sh:NodeShape ;
  sh:targetClass qri:Qualification ;
  sh:property [ sh:path qri:subjectRealization ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sosa:System ] ;
  sh:property [ sh:path qri:qualifiesFor ; sh:minCount 1 ; sh:maxCount 1 ; sh:class qri:CapabilityContract ] ;
  sh:property [ sh:path qri:inContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:class qri:ExecutionContext ] ;
  sh:property [ sh:path qri:qualificationVerdict ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path qri:hasEvidence ; sh:minCount 1 ; sh:class prov:Entity ] .

qri:InterchangeabilityShape a sh:NodeShape ;
  sh:targetClass qri:InterchangeabilityClaim ;
  sh:property [ sh:path qri:memberRealization ; sh:minCount 2 ; sh:maxCount 2 ; sh:class sosa:System ] ;
  sh:property [ sh:path qri:underContract ; sh:minCount 1 ; sh:maxCount 1 ; sh:class qri:CapabilityContract ] ;
  sh:property [ sh:path qri:interchangeableUnder ; sh:minCount 1 ; sh:maxCount 1 ; sh:class qri:ExecutionContext ] ;
  sh:property [ sh:path qri:basedOnQualification ; sh:minCount 2 ] .

qri:AdmissionDecisionShape a sh:NodeShape ;
  sh:targetClass qri:AdmissionDecision ;
  sh:property [ sh:path qri:decision ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path qri:forQualification ; sh:minCount 1 ; sh:maxCount 1 ; sh:class qri:Qualification ] ;
  sh:property [ sh:path qri:authorityEvidence ; sh:minCount 1 ; sh:class prov:Entity ] .

qri:StandingAssertionShape a sh:NodeShape ;
  sh:targetClass qri:StandingAssertion ;
  sh:property [ sh:path qri:standingOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class sosa:System ] ;
  sh:property [ sh:path qri:underContract ; sh:minCount 1 ; sh:maxCount 1 ; sh:class qri:CapabilityContract ] ;
  sh:property [ sh:path qri:inContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:class qri:ExecutionContext ] ;
  sh:property [ sh:path qri:standingState ; sh:minCount 1 ; sh:maxCount 1 ] .
