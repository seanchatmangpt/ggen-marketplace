PREFIX ipq: <https://ggen.dev/ontology/interchangeable-parts-qualification#>

SELECT ?coreModule ?receiptsModule ?requirementSchema ?passportSchema
       ?judgementSchema ?receiptSchema ?adapterSchema
WHERE {
  ipq:policyV1
    ipq:canonicalCoreModule ?coreModule ;
    ipq:canonicalReceiptsModule ?receiptsModule ;
    ipq:partRequirementSchema ?requirementSchema ;
    ipq:partPassportSchema ?passportSchema ;
    ipq:substitutionJudgementSchema ?judgementSchema ;
    ipq:substitutionReceiptSchema ?receiptSchema ;
    ipq:adapterSchema ?adapterSchema ;
    ipq:grantsDoAuthority false .
}
