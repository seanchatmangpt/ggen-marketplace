@prefix aaift: <https://aaif.io/profile-tailoring#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <urn:aaift:witness:> .

ex:prod a aaift:DeploymentProfile ;
    aaift:namespace "aaif-prod" ;
    aaift:replicas 3 ;
    aaift:cmekProvider aaift:GCP_CMEK ;
    aaift:finopsTier aaift:HARDENED ;
    aaift:siemMode aaift:CHRONICLE ;
    aaift:spiffeTrustDomain "prod.aaif.io" ;
    aaift:pqcSuite aaift:HYBRID_ES256_ML_DSA_65 .

ex:dev a aaift:DeploymentProfile ;
    aaift:namespace "aaif-dev" ;
    aaift:replicas 1 ;
    aaift:cmekProvider aaift:NONE ;
    aaift:finopsTier aaift:BASIC ;
    aaift:siemMode aaift:SIEM_NONE ;
    aaift:spiffeTrustDomain "dev.aaif.io" ;
    aaift:pqcSuite aaift:PQC_NONE .
