# MESSAGE: DeploymentProfile enum property value is outside its closed enumeration; anything else projects UNSUPPORTED.
PREFIX aaift: <https://aaif.io/profile-tailoring#>
SELECT ?profile ?prop ?value WHERE {
  ?profile a aaift:DeploymentProfile .
  {
    ?profile aaift:cmekProvider ?value .
    BIND("cmekProvider" AS ?prop)
    FILTER (?value != aaift:GCP_CMEK && ?value != aaift:NONE)
  } UNION {
    ?profile aaift:finopsTier ?value .
    BIND("finopsTier" AS ?prop)
    FILTER (?value != aaift:BASIC && ?value != aaift:STANDARD && ?value != aaift:HARDENED)
  } UNION {
    ?profile aaift:siemMode ?value .
    BIND("siemMode" AS ?prop)
    FILTER (?value != aaift:SPLUNK_HEC && ?value != aaift:CHRONICLE && ?value != aaift:SIEM_NONE)
  } UNION {
    ?profile aaift:pqcSuite ?value .
    BIND("pqcSuite" AS ?prop)
    FILTER (?value != aaift:ML_DSA_65 && ?value != aaift:HYBRID_ES256_ML_DSA_65 && ?value != aaift:PQC_NONE)
  }
}
ORDER BY ?profile ?prop ?value
