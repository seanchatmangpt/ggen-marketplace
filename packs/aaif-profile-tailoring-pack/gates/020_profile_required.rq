# MESSAGE: DeploymentProfile is missing a required namespace or replicas parameter; defaults never render.
PREFIX aaift: <https://aaif.io/profile-tailoring#>
SELECT ?profile ?missing WHERE {
  ?profile a aaift:DeploymentProfile .
  OPTIONAL { ?profile aaift:namespace ?ns }
  OPTIONAL { ?profile aaift:replicas ?rep }
  BIND(IF(!BOUND(?ns), "namespace", IF(!BOUND(?rep), "replicas", "")) AS ?missing_raw)
  FILTER (?missing_raw != "")
  BIND(?missing_raw AS ?missing)
}
ORDER BY ?profile ?missing
