@prefix aaift: <https://aaif.io/profile-tailoring#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aaift:DeploymentProfile a owl:Class ;
    rdfs:label "DeploymentProfile" ;
    rdfs:comment "A tailored AAIF deployment profile binding every deployment parameter to a value." .

aaift:namespace a owl:DatatypeProperty ;
    rdfs:domain aaift:DeploymentProfile ;
    rdfs:range xsd:string ;
    rdfs:label "namespace" .

aaift:replicas a owl:DatatypeProperty ;
    rdfs:domain aaift:DeploymentProfile ;
    rdfs:range xsd:integer ;
    rdfs:label "replicas" .

aaift:cmekProvider a owl:ObjectProperty ;
    rdfs:domain aaift:DeploymentProfile ;
    rdfs:range aaift:CmekProvider ;
    rdfs:label "cmekProvider" .

aaift:finopsTier a owl:ObjectProperty ;
    rdfs:domain aaift:DeploymentProfile ;
    rdfs:range aaift:FinopsTier ;
    rdfs:label "finopsTier" .

aaift:siemMode a owl:ObjectProperty ;
    rdfs:domain aaift:DeploymentProfile ;
    rdfs:range aaift:SiemMode ;
    rdfs:label "siemMode" .

aaift:spiffeTrustDomain a owl:DatatypeProperty ;
    rdfs:domain aaift:DeploymentProfile ;
    rdfs:range xsd:string ;
    rdfs:label "spiffeTrustDomain" .

aaift:pqcSuite a owl:ObjectProperty ;
    rdfs:domain aaift:DeploymentProfile ;
    rdfs:range aaift:PqcSuite ;
    rdfs:label "pqcSuite" .

# --- Closed enums -----------------------------------------------------------
# Every value MUST be one of the enumerated individuals; anything else projects
# UNSUPPORTED (zero-value-must-declare-meaning law).

aaift:CmekProvider a owl:Class ;
    rdfs:label "CmekProvider" ;
    rdfs:comment "value MUST be one of the enumerated individuals; anything else projects UNSUPPORTED" .

aaift:GCP_CMEK a aaift:CmekProvider ;
    rdfs:label "GCP_CMEK" .

aaift:NONE a aaift:CmekProvider ;
    rdfs:label "NONE" ;
    rdfs:comment "no CMEK: plaintext storage at rest; the rendered profile must state this meaning explicitly" .

aaift:FinopsTier a owl:Class ;
    rdfs:label "FinopsTier" ;
    rdfs:comment "value MUST be one of the enumerated individuals; anything else projects UNSUPPORTED" .

aaift:BASIC a aaift:FinopsTier ;
    rdfs:label "BASIC" .

aaift:STANDARD a aaift:FinopsTier ;
    rdfs:label "STANDARD" .

aaift:HARDENED a aaift:FinopsTier ;
    rdfs:label "HARDENED" .

aaift:SiemMode a owl:Class ;
    rdfs:label "SiemMode" ;
    rdfs:comment "value MUST be one of the enumerated individuals; anything else projects UNSUPPORTED" .

aaift:SPLUNK_HEC a aaift:SiemMode ;
    rdfs:label "SPLUNK_HEC" .

aaift:CHRONICLE a aaift:SiemMode ;
    rdfs:label "CHRONICLE" .

aaift:SIEM_NONE a aaift:SiemMode ;
    rdfs:label "NONE" ;
    rdfs:comment "no SIEM egress: audit trail stays local; the rendered profile must state this meaning explicitly" .

aaift:PqcSuite a owl:Class ;
    rdfs:label "PqcSuite" ;
    rdfs:comment "value MUST be one of the enumerated individuals; anything else projects UNSUPPORTED" .

aaift:ML_DSA_65 a aaift:PqcSuite ;
    rdfs:label "ML-DSA-65" .

aaift:HYBRID_ES256_ML_DSA_65 a aaift:PqcSuite ;
    rdfs:label "HYBRID-ES256-ML-DSA-65" .

aaift:PQC_NONE a aaift:PqcSuite ;
    rdfs:label "NONE" ;
    rdfs:comment "no post-quantum signatures: classical-only affidavit sealing; the rendered profile must state this meaning explicitly" .
