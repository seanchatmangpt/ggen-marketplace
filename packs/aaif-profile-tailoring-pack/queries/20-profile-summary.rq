# Projected columns -> template variables (deployment-profile.json summary):
#   ?name -> summary.name, ?namespace -> summary.namespace, ?replicas -> summary.replicas,
#   ?cmek -> summary.cmek, ?finops -> summary.finops, ?siem -> summary.siem,
#   ?trust_domain -> summary.trust_domain, ?pqc -> summary.pqc
PREFIX aaift: <https://aaif.io/profile-tailoring#>
SELECT ?name ?namespace ?replicas ?cmek ?finops ?siem ?trust_domain ?pqc WHERE {
  ?profile a aaift:DeploymentProfile .
  OPTIONAL { ?profile aaift:namespace ?ns }
  OPTIONAL { ?profile aaift:replicas ?rep }
  OPTIONAL { ?profile aaift:cmekProvider ?cm }
  OPTIONAL { ?profile aaift:finopsTier ?ft }
  OPTIONAL { ?profile aaift:siemMode ?sm }
  OPTIONAL { ?profile aaift:spiffeTrustDomain ?std }
  OPTIONAL { ?profile aaift:pqcSuite ?pq }
  BIND(COALESCE(STR(?ns), "") AS ?name)
  BIND(COALESCE(STR(?ns), "") AS ?namespace)
  BIND(COALESCE(?rep, 0) AS ?replicas)
  BIND(COALESCE(STRAFTER(STR(?cm), "#"), "") AS ?cmek)
  BIND(COALESCE(STRAFTER(STR(?ft), "#"), "") AS ?finops)
  BIND(COALESCE(STRAFTER(STR(?sm), "#"), "") AS ?siem)
  BIND(COALESCE(STR(?std), "") AS ?trust_domain)
  BIND(COALESCE(STRAFTER(STR(?pq), "#"), "") AS ?pqc)
}
ORDER BY ?namespace
LIMIT 1
