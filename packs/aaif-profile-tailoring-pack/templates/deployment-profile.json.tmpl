{% for r in results %}{
  "schema": "aaif.profile-tailoring/deployment-profile/1",
  "name": "{{ r.name }}",
  "namespace": "{{ r.namespace }}",
  "replicas": {{ r.replicas | default(value=0) }},
  "cmekProvider": "{{ r.cmek | default(value="NONE") }}",
  "finopsTier": "{{ r.finops | default(value="UNSPECIFIED") }}",
  "siemMode": "{{ r.siem | default(value="UNSPECIFIED") }}",
  "spiffeTrustDomain": "{{ r.trust_domain }}",
  "pqcSuite": "{{ r.pqc | default(value="NONE") }}"
}
{% endfor %}
