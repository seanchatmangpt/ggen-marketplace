# Projection rows for the cas ↔ chain composition: one row per witnessed
# KAT fold entry, with the witness head/depth/digest-len repeated. The
# generated module folds these with its in-test single-chunk BLAKE3 core
# and asserts equality with the pinned head.
PREFIX st: <https://strata.chatman.ai/ontology#>

SELECT ?head ?depth ?digest_len ?pn ?ocel WHERE {
  ?w a st:CasChainWitness ;
     st:chainKatHead ?head ;
     st:chainKatDepth ?depth ;
     st:chainDigestLen ?digest_len .
  ?e a st:KatEntry ;
     st:katPn ?pn ;
     st:katOcel ?ocel .
}
ORDER BY ?pn
