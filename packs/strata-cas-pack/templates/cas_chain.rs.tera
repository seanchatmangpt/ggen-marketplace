{% for row in results %}{% if loop.first %}{% set_global kat_head = row.head %}{% set_global kat_depth = row.depth %}{% set_global digest_len = row.digest_len %}{% endif %}{% endfor %}
/// PINNED CROSS-REPO KAT HEAD — mirrored from strata-chain-pack
/// witness.ttl (sw:sharedKatHead); gated by
/// gates/030_cas_chain_composition.rq.
pub const CHAIN_KAT_HEAD: &str = "{{ kat_head }}";

/// Shared digest length in bytes (chain DIGEST_LEN; CAS 64-hex law).
pub const CHAIN_DIGEST_LEN: usize = {{ digest_len }};

/// Commit-chain depth of the KAT head (= witnessed entry count).
pub const CHAIN_KAT_DEPTH: usize = {{ kat_depth }};

/// Witnessed KAT fold entries (pn, ocel), mirrored from strata-chain-pack
/// witness.ttl sw:kat-entry-*.
pub const KAT_ENTRIES: [(u64, u64); {{ results | length }}] = [
    {% for row in results %}({{ row.pn }}, {{ row.ocel }}),
    {% endfor %}];

/// Digest-shape law: ^[0-9a-f]{64}$ — the CAS content-address shape,
/// identical to the chain pack's 32-byte digest domain.
pub fn digest_shape_ok(d: &str) -> bool {
    d.len() == 64 && d.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
}

/// CAS commit-chain admission: the pinned head is a valid commit-chain
/// head iff it is well-formed 32-byte hex, non-zero (not the all-zero
/// genesis), the shared digest length is 32, and the witnessed depth
/// equals the entry count.
pub fn cas_chain_closure() -> Result<(), String> {
    if !digest_shape_ok(CHAIN_KAT_HEAD) {
        return Err(format!(
            "malformed_head: CHAIN_KAT_HEAD violates the 64-char lowercase-hex digest-shape law",
        ));
    }
    if CHAIN_KAT_HEAD.bytes().all(|b| b == b'0') {
        return Err("genesis_head: CHAIN_KAT_HEAD is the all-zero genesis; a commit-chain witness must be a folded tip".to_string());
    }
    if CHAIN_DIGEST_LEN != 32 {
        return Err(format!(
            "wrong_digest_len: shared digest length {} != 32 (chain DIGEST_LEN)",
            CHAIN_DIGEST_LEN
        ));
    }
    if CHAIN_KAT_DEPTH != KAT_ENTRIES.len() {
        return Err(format!(
            "depth_law: pinned depth {} != witnessed entry count {}",
            CHAIN_KAT_DEPTH,
            KAT_ENTRIES.len()
        ));
    }
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    // ── Single-chunk BLAKE3 core ─────────────────────────────────────
    // PROVENANCE-COPIED PATTERN (same reuse discipline as
    // strata-chain-pack generated/chain_engine.rs, itself provenance-
    // copied from strata-hash-pack): BLAKE3 (O'Connor et al., 2020)
    // single-chunk core; every fold input here is 56 bytes.
    fn blake3_compress(
        cv: [u32; 8],
        block_words: [u32; 16],
        block_len: u32,
        flags: u32,
    ) -> [u32; 16] {
        const IV: [u32; 8] = [
            0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB,
            0x5BE0CD19,
        ];
        const MSG_PERMUTATION: [usize; 16] = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8];
        let mut state = [
            cv[0], cv[1], cv[2], cv[3], cv[4], cv[5], cv[6], cv[7], IV[0], IV[1], IV[2], IV[3],
            0, 0, block_len, flags,
        ];
        let mut m = block_words;
        fn g(s: &mut [u32; 16], a: usize, b: usize, c: usize, d: usize, mx: u32, my: u32) {
            s[a] = s[a].wrapping_add(s[b]).wrapping_add(mx);
            s[d] = (s[d] ^ s[a]).rotate_right(16);
            s[c] = s[c].wrapping_add(s[d]);
            s[b] = (s[b] ^ s[c]).rotate_right(12);
            s[a] = s[a].wrapping_add(s[b]).wrapping_add(my);
            s[d] = (s[d] ^ s[a]).rotate_right(8);
            s[c] = s[c].wrapping_add(s[d]);
            s[b] = (s[b] ^ s[c]).rotate_right(7);
        }
        fn round(s: &mut [u32; 16], m: &[u32; 16]) {
            g(s, 0, 4, 8, 12, m[0], m[1]);
            g(s, 1, 5, 9, 13, m[2], m[3]);
            g(s, 2, 6, 10, 14, m[4], m[5]);
            g(s, 3, 7, 11, 15, m[6], m[7]);
            g(s, 0, 5, 10, 15, m[8], m[9]);
            g(s, 1, 6, 11, 12, m[10], m[11]);
            g(s, 2, 7, 8, 13, m[12], m[13]);
            g(s, 3, 4, 9, 14, m[14], m[15]);
        }
        for _ in 0..7 {
            round(&mut state, &m);
            m = {
                let mut next = [0u32; 16];
                for i in 0..16 {
                    next[i] = m[MSG_PERMUTATION[i]];
                }
                next
            };
        }
        for i in 0..8 {
            state[i] ^= state[i + 8];
            state[i + 8] ^= cv[i];
        }
        state
    }

    fn to_words(block: &[u8; 64]) -> [u32; 16] {
        let mut m = [0u32; 16];
        for (i, w) in m.iter_mut().enumerate() {
            *w = u32::from_le_bytes([
                block[i * 4],
                block[i * 4 + 1],
                block[i * 4 + 2],
                block[i * 4 + 3],
            ]);
        }
        m
    }

    fn hex32(bytes: &[u8]) -> String {
        bytes.iter().map(|b| format!("{b:02x}")).collect()
    }

    /// BLAKE3 over a single-chunk (< 1024 byte) input; multi-chunk inputs
    /// are outside this court's domain and refuse loudly.
    fn blake3_single_chunk(input: &[u8]) -> [u8; 32] {
        const CHUNK_START: u32 = 1 << 0;
        const CHUNK_END: u32 = 1 << 1;
        const ROOT: u32 = 1 << 3;
        assert!(
            input.len() < 1024,
            "cas-chain KAT court domain: single-chunk BLAKE3 only (input < 1024 bytes, got {})",
            input.len()
        );
        let mut cv = [
            0x6A09E667u32, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB,
            0x5BE0CD19,
        ];
        let mut block = [0u8; 64];
        let mut block_len = 0usize;
        let mut flags = CHUNK_START;
        let mut pos = 0usize;
        while pos < input.len() {
            if block_len == 64 {
                let out = blake3_compress(cv, to_words(&block), block_len as u32, flags);
                cv = [out[0], out[1], out[2], out[3], out[4], out[5], out[6], out[7]];
                block = [0u8; 64];
                block_len = 0;
                flags = 0;
            }
            let take = (64 - block_len).min(input.len() - pos);
            block[block_len..block_len + take].copy_from_slice(&input[pos..pos + take]);
            block_len += take;
            pos += take;
            if pos == input.len() {
                flags |= CHUNK_END | ROOT;
            } else if block_len == 0 {
                flags |= CHUNK_START;
            }
        }
        if input.is_empty() {
            flags |= CHUNK_END | ROOT;
        }
        let out = blake3_compress(cv, to_words(&block), block_len as u32, flags);
        let mut digest = [0u8; 32];
        for (i, w) in out[..8].iter().enumerate() {
            digest[i * 4..i * 4 + 4].copy_from_slice(&w.to_le_bytes());
        }
        digest
    }

    /// One honest fold step: h' = BLAKE3(h || pn_be || ocel_be || tick_be64).
    fn chain_fold_step(h: [u8; 32], pn: u64, ocel: u64) -> [u8; 32] {
        let tick = ocel >> 56;
        let mut buf = Vec::with_capacity(56);
        buf.extend_from_slice(&h);
        buf.extend_from_slice(&pn.to_be_bytes());
        buf.extend_from_slice(&ocel.to_be_bytes());
        buf.extend_from_slice(&tick.to_be_bytes());
        blake3_single_chunk(&buf)
    }

    /// Honest chain fold over `entries` (prev-hash chaining): the CAS
    /// commit-chain discipline — genesis then child_of links — over the
    /// witnessed KAT entries.
    fn chain_fold(entries: &[(u64, u64)]) -> [u8; 32] {
        let mut h = [0u8; 32];
        for &(pn, ocel) in entries {
            h = chain_fold_step(h, pn, ocel);
        }
        h
    }

    /// CAS-side fold court: the honest fold over the witnessed entries
    /// reproduces the pinned head exactly, so the pinned head is a valid
    /// CAS commit-chain tip (genesis = 32 zero bytes, depth =
    /// KAT_ENTRIES.len()).
    #[test]
    fn pinned_head_is_valid_cas_commit_chain_tip() {
        cas_chain_closure().expect("pinned chain KAT head must admit as a CAS commit-chain witness");
        assert_eq!(CHAIN_DIGEST_LEN, 32);
        assert_eq!(CHAIN_KAT_DEPTH, KAT_ENTRIES.len());
        assert_eq!(KAT_ENTRIES.len(), 4);
        assert_eq!(hex32(&chain_fold(&KAT_ENTRIES)), CHAIN_KAT_HEAD);
    }

    /// Genesis law: the head is a folded tip, not the all-zero genesis.
    #[test]
    fn head_is_not_the_all_zero_genesis() {
        assert_ne!(hex32(&[0u8; 32]), CHAIN_KAT_HEAD);
        assert!(digest_shape_ok(CHAIN_KAT_HEAD));
    }

    /// SABOTAGE TWIN — a corrupted head literal keeps the digest SHAPE
    /// (still 64 lowercase hex) but no longer matches the recomputed fold:
    /// shape checks alone cannot admit a wrong head; the fold court can.
    #[test]
    fn sabotage_twin_corrupted_head_is_caught() {
        let mut corrupted = CHAIN_KAT_HEAD.to_string();
        let first = corrupted.as_bytes()[0];
        corrupted.replace_range(0..1, &char::from(first ^ 0x01).to_string());
        assert!(digest_shape_ok(&corrupted), "corrupted head must keep the digest shape");
        assert_ne!(
            hex32(&chain_fold(&KAT_ENTRIES)),
            corrupted,
            "fold reproduced a corrupted head — court cannot distinguish honest from sabotaged input"
        );
    }
}
