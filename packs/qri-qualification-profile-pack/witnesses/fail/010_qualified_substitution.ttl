@prefix qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix ex: <urn:qri:witness:> .

ex:c a qri:CapabilityContract ; qri:invariantSet ex:set .
ex:set a qri:InvariantSet ; qri:requiresInvariant ex:i1 , ex:i2 .
ex:i1 a qri:Invariant . ex:i2 a qri:Invariant .
ex:x a qri:RuntimeContext . ex:y a qri:RuntimeContext .
# Target qualified under context y; claim asserts context x.
ex:rs a qri:QualificationReceipt ; qri:qualificationResult qri:Passed ; qri:qualifiesFor ex:c ; qri:runtimeContext ex:x ; qri:preservesInvariant ex:i1 , ex:i2 .
ex:rt a qri:QualificationReceipt ; qri:qualificationResult qri:Passed ; qri:qualifiesFor ex:c ; qri:runtimeContext ex:y ; qri:preservesInvariant ex:i1 , ex:i2 .
ex:claim a qri:SubstitutionClaim ; qri:sourceQualification ex:rs ; qri:targetQualification ex:rt ; qri:interchangeableUnder ex:x .
