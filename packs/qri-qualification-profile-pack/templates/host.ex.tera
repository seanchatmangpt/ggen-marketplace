  end

  defp check_imports(imports) do
    offenders =
      for {module, functions} <- imports,
          {name, _type} <- functions,
          not MapSet.member?(@allowed_imports, module <> "::" <> name) do
        module <> "::" <> name
      end

    if offenders == [], do: :ok, else: {:refused, :wasm_import_surface_mismatch, %{unexpected: Enum.sort(offenders)}}
  end

  defp check_exports(exports) do
    missing = Enum.reject(@required_exports, &Map.has_key?(exports, &1))
    if missing == [], do: :ok, else: {:refused, :wasm_missing_export, %{missing: missing}}
  end
