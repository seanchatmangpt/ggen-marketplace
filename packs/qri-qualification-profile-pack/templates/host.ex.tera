  defp check_digest(digest, digest), do: :ok
  defp check_digest(actual, expected), do: {:refused, :wasm_digest_mismatch, %{expected: expected, actual: actual}}

  defp new_store do
    {:ok, _store} = Wasmex.Store.new_wasi(%Wasmex.Wasi.WasiOptions{})
