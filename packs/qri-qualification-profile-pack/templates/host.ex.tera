    :exit, reason -> {:error, {:exit, reason}}
  end

  defp read(path) do
    case File.read(path) do
      {:ok, bytes} -> {:ok, bytes}
      {:error, reason} -> {:refused, :wasm_unreadable, %{path: path, reason: reason}}
