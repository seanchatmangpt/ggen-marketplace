{%- endif %}{% endfor %}
  ]
  @max_response 64 * 1024 * 1024

  def admit(path, expected_sha256) do
    with {:ok, bytes} <- read(path),
         digest = Base.encode16(:crypto.hash(:sha256, bytes), case: :lower),
         :ok <- check_digest(digest, expected_sha256),
         {:ok, store} <- new_store(),
         {:ok, module} <- compile(store, bytes),
         :ok <- check_imports(Wasmex.Module.imports(module)),
         :ok <- check_exports(Wasmex.Module.exports(module)),
         {:ok, pid} <- Wasmex.start_link(%{store: store, module: module}),
         {:ok, store} <- Wasmex.store(pid),
         {:ok, memory} <- Wasmex.memory(pid) do
      _ = Wasmex.call_function(pid, "_initialize", [])
      {:ok, %{pid: pid, store: store, memory: memory, sha256: digest}}
    end
  end

  @doc "One request/response round trip. Returns the raw response bytes."
  def call(%{pid: pid, store: store, memory: memory}, request) when is_binary(request) do
    len = byte_size(request)

    with {:ok, [ptr]} when ptr > 0 <- fun(pid, @prefix <> "_alloc", [len]),
         :ok <- Wasmex.Memory.write_binary(store, memory, ptr, request),
         {:ok, [packed]} <- fun(pid, @prefix <> "_call", [ptr, len]) do
      packed = packed &&& 0xFFFF_FFFF_FFFF_FFFF
      out_ptr = packed >>> 32
      out_len = packed &&& 0xFFFF_FFFF

      cond do
        out_len == 0 or out_ptr == 0 ->
          {:trap, :empty_result_slot}

        out_len > @max_response ->
          {:refused, :resource_bound, %{bytes: out_len}}

        true ->
          bytes = Wasmex.Memory.read_binary(store, memory, out_ptr, out_len)
          _ = fun(pid, @prefix <> "_free", [out_ptr, out_len])
          {:ok, bytes}
      end
    else
      {:ok, [0]} -> {:refused, :resource_bound, %{step: :alloc, bytes: len}}
      {:error, reason} -> {:trap, reason}
      other -> {:trap, {:unexpected, other}}
    end
  end

  defp fun(pid, name, params) do
    Wasmex.call_function(pid, name, params)
