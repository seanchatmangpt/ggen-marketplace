---
to: generated/beam-host/vendor_task.ex
sparql:
  profile: |
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?app ?root ?task_root ?prefix ?abi_version ?free_symbol ?len_type ?alloc_zero_policy ?out_mode
           ?req_consumed ?pin_format ?path_env ?handle_noun ?taxonomy_ns ?refusal_module ?request_cap
           ?manifest_rel ?wasm_rel ?manifest_schema ?ok_key ?op_key ?probe_op ?probe_expect
           ?telemetry_root ?pool_strategy ?pool_size ?pool_size_source ?engine_id WHERE {
      ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix .
      OPTIONAL { ?c qri:abiVersion ?abiv }
      OPTIONAL { ?hp qri:otpApp ?a }
      OPTIONAL { ?hp qri:moduleRoot ?r }
      OPTIONAL { ?hp qri:taskModuleRoot ?tr }
      OPTIONAL { ?hp qri:freeSymbol ?fs }
      OPTIONAL { ?hp qri:lenType ?lt }
      OPTIONAL { ?hp qri:allocZeroPolicy ?azp }
      OPTIONAL { ?hp qri:outMode ?om }
      OPTIONAL { ?hp qri:reqConsumed ?rc }
      OPTIONAL { ?hp qri:pinFormat ?pf }
      OPTIONAL { ?hp qri:pathEnv ?pe }
      OPTIONAL { ?hp qri:handleNoun ?hn }
      OPTIONAL { ?hp qri:taxonomyNamespace ?tn }
      OPTIONAL { ?hp qri:refusalModule ?rm }
      OPTIONAL { ?hp qri:requestCap ?cap }
      OPTIONAL { ?hp qri:manifestRel ?mr }
      OPTIONAL { ?hp qri:wasmRel ?wr }
      OPTIONAL { ?hp qri:manifestSchema ?ms }
      OPTIONAL { ?hp qri:okKey ?ok }
      OPTIONAL { ?hp qri:opKey ?opk }
      OPTIONAL { ?hp qri:probeOp ?po }
      OPTIONAL { ?hp qri:probeExpectKey ?pek }
      OPTIONAL { ?hp qri:telemetryRoot ?tel }
      OPTIONAL { ?hp qri:poolStrategy ?ps }
      OPTIONAL { ?hp qri:poolSize ?psz }
      OPTIONAL { ?hp qri:poolSizeSource ?pss }
      OPTIONAL { ?hp qri:engineId ?eid }
      BIND(COALESCE(?a, "") AS ?app)
      BIND(COALESCE(?r, "") AS ?root)
      BIND(COALESCE(?tr, "") AS ?task_root)
      BIND(COALESCE(?abiv, "") AS ?abi_version)
      BIND(COALESCE(?fs, CONCAT(?prefix, "_free")) AS ?free_symbol)
      BIND(COALESCE(?lt, "u32") AS ?len_type)
      BIND(COALESCE(?azp, "refuse-resource_limit") AS ?alloc_zero_policy)
      BIND(COALESCE(?om, "packed_u64") AS ?out_mode)
      BIND(COALESCE(?rc, true) AS ?req_consumed)
      BIND(COALESCE(?pf, "") AS ?pin_format)
      BIND(COALESCE(?pe, "") AS ?path_env)
      BIND(COALESCE(?hn, "engine") AS ?handle_noun)
      BIND(COALESCE(?tn, "") AS ?taxonomy_ns)
      BIND(COALESCE(?rm, "") AS ?refusal_module)
      BIND(COALESCE(?cap, 0) AS ?request_cap)
      BIND(COALESCE(?mr, "") AS ?manifest_rel)
      BIND(COALESCE(?wr, "") AS ?wasm_rel)
      BIND(COALESCE(?ms, "") AS ?manifest_schema)
      BIND(COALESCE(?ok, "ok") AS ?ok_key)
      BIND(COALESCE(?opk, "op") AS ?op_key)
      BIND(COALESCE(?po, "") AS ?probe_op)
      BIND(COALESCE(?pek, "") AS ?probe_expect)
      BIND(COALESCE(?tel, "") AS ?telemetry_root)
      BIND(COALESCE(?ps, "single") AS ?pool_strategy)
      BIND(COALESCE(?psz, 1) AS ?pool_size)
      BIND(COALESCE(?pss, "") AS ?pool_size_source)
      BIND(COALESCE(?eid, "") AS ?engine_id)
    }
    ORDER BY ?prefix
  limits: |
    PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
    SELECT ?prefix ?name ?default ?order WHERE {
      ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix .
      ?hp qri:hostLimit ?l .
      ?l qri:limitName ?name ; qri:limitDefault ?default ; qri:limitOrder ?order .
    }
    ORDER BY ?prefix ?order ?name
force: true
---
{%- set p = profile[0] -%}
{%- set manifest_file = p.manifest_rel | split(pat="/") | last -%}
{%- set wasm_file = p.wasm_rel | split(pat="/") | last -%}
{%- set priv_dir = p.manifest_rel | trim_end_matches(pat=manifest_file) | trim_end_matches(pat="/") -%}
{%- for l in limits %}{% if l.name == "max_redirects" %}{% set_global lim_max_redirects = l.default %}{% endif %}{% endfor -%}
# GENERATED by qri-qualification-profile-pack (queries 50-54). Do not edit; edit the RDF contract.

defmodule Mix.Tasks.{{ p.task_root }}.Vendor do
  @shortdoc "Vendors the pinned {{ p.engine_id }} wasm into {{ priv_dir }}, verified against {{ manifest_file }}"

  @moduledoc """
  Vendors the pinned {{ p.engine_id }} engine (`{{ wasm_file }}`).

  The artifact URL and SHA-256 come from `{{ p.manifest_rel }}`. A candidate is kept only when its SHA-256
  equals the manifest pin; any mismatch leaves an already vendored engine untouched. The digest is an
  identity check, not authorization.
  """

  use Mix.Task

  @switches [from: :string, check: :boolean]
  @manifest_schema "{{ p.manifest_schema }}"
  @max_redirects {{ lim_max_redirects }}

  @doc """
  Runs the task with raw `argv`. Returns `:ok`; raises `Mix.Error` with a `[code]` prefix on
  refusal (see the module documentation for the exit codes).
  """
  @impl Mix.Task
  @spec run([String.t()]) :: :ok
  def run(argv) do
    {opts, _rest} = OptionParser.parse!(argv, strict: @switches)
    dir = priv_dir()
    manifest = read_manifest!(Path.join(dir, "{{ manifest_file }}"))
    artifact = manifest["artifact"]
    target = Path.join(dir, artifact["file"])
    pin = String.downcase(artifact["sha256"])

    cond do
      opts[:check] -> check!(target, pin)
      opts[:from] -> from_file!(opts[:from], target, pin)
      true -> download!(artifact["url"], target, pin)
    end
  end

  @doc false
  @spec sha256_hex(binary()) :: String.t()
  def sha256_hex(bytes), do: :crypto.hash(:sha256, bytes) |> Base.encode16(case: :lower)

  defp priv_dir do
    if Mix.Project.config()[:app] == :{{ p.app }} do
      Path.join(File.cwd!(), "{{ priv_dir }}")
    else
      Application.app_dir(:{{ p.app }}, "{{ priv_dir }}")
    end
  end

  defp read_manifest!(path) do
    with {:ok, raw} <- File.read(path),
         {:ok, %{"schema" => @manifest_schema, "artifact" => %{"file" => f, "sha256" => s, "url" => u}} = m}
         when is_binary(f) and is_binary(s) and is_binary(u) <- Jason.decode(raw) do
      m
    else
      {:error, reason} -> Mix.raise("[wasm_unreadable] cannot read manifest #{path}: #{inspect(reason)}")
      _ -> Mix.raise("[wasm_invalid] manifest #{path} does not match schema #{@manifest_schema}")
    end
  end

  defp check!(target, pin) do
    case File.read(target) do
      {:ok, bytes} ->
        case sha256_hex(bytes) do
          ^pin -> Mix.shell().info("{{ wasm_file }} OK sha256=#{pin}")
          actual -> Mix.raise("[wasm_digest_mismatch] #{target}\n  pinned=#{pin}\n  actual=#{actual}")
        end

      {:error, reason} ->
        Mix.raise("[wasm_not_vendored] #{target}: #{inspect(reason)}; run mix {{ p.app }}.vendor")
    end
  end

  defp from_file!(from, target, pin) do
    bytes =
      case File.read(from) do
        {:ok, bytes} -> bytes
        {:error, reason} -> Mix.raise("[wasm_unreadable] #{from}: #{inspect(reason)}")
      end

    keep!(bytes, target, pin, from)
  end

  defp download!(url, target, pin) do
    {:ok, _} = Application.ensure_all_started(:inets)
    {:ok, _} = Application.ensure_all_started(:ssl)
    Mix.shell().info("downloading #{url}")

    case fetch(url, @max_redirects) do
      {:ok, bytes} -> keep!(bytes, target, pin, url)
      {:error, reason} -> Mix.raise("[wasm_unreadable] download failed for #{url}: #{inspect(reason)}")
    end
  end

  defp fetch(_url, redirects) when redirects < 0, do: {:error, :too_many_redirects}

  defp fetch(url, redirects) do
    uri = URI.parse(url)

    ssl = [
      verify: :verify_peer,
      cacerts: :public_key.cacerts_get(),
      depth: 4,
      customize_hostname_check: [match_fun: :public_key.pkix_verify_hostname_match_fun(:https)]
    ]

    request = {String.to_charlist(url), [{~c"user-agent", ~c"{{ p.app }}-vendor"}]}
    http_opts = [ssl: ssl, timeout: 60_000, connect_timeout: 15_000, autoredirect: false]

    with %URI{scheme: "https"} <- uri,
         {:ok, {{ "{{" }}_, status, _}, headers, body}} <-
           :httpc.request(:get, request, http_opts, body_format: :binary) do
      handle_response(status, headers, body, uri, redirects)
    else
      %URI{} -> {:error, :https_required}
      {:error, _} = error -> error
    end
  end

  defp handle_response(200, _headers, body, _uri, _redirects), do: {:ok, body}

  defp handle_response(status, headers, _body, uri, redirects) when status in [301, 302, 303, 307, 308] do
    case List.keyfind(headers, ~c"location", 0) do
      {_, loc} -> fetch(URI.merge(uri, to_string(loc)) |> to_string(), redirects - 1)
      nil -> {:error, {:redirect_without_location, status}}
    end
  end

  defp handle_response(status, _headers, _body, _uri, _redirects), do: {:error, {:http_status, status}}

  defp keep!(bytes, target, pin, source) do
    case sha256_hex(bytes) do
      ^pin -> install!(bytes, target, pin, source)
      actual -> reject!(source, pin, actual)
    end
  end

  # Candidate -> temp file -> re-hash the bytes that reached disk -> atomic rename.
  defp install!(bytes, target, pin, source) do
    File.mkdir_p!(Path.dirname(target))
    partial = target <> ".partial-" <> Integer.to_string(System.unique_integer([:positive]))
    File.write!(partial, bytes)

    case partial |> File.read!() |> sha256_hex() do
      ^pin ->
        File.rename!(partial, target)
        Mix.shell().info("vendored #{target}\n  source=#{source}\n  bytes=#{byte_size(bytes)}\n  sha256=#{pin}")

      actual ->
        File.rm(partial)
        reject!(source, pin, actual)
    end
  end

  @spec reject!(String.t(), String.t(), String.t()) :: no_return()
  defp reject!(source, pin, actual) do
    Mix.raise(
      "[wasm_digest_mismatch] #{source} rejected, nothing kept, any vendored engine left untouched\n" <>
        "  pinned=#{pin}\n  actual=#{actual}"
    )
  end
end
