{
  "schema": "qri.abi-ledger/1",
  "generated": true,
  "authority": "none",
  "abi_kind": "{{ results[0].abiKind }}",
  "abi_version": "{{ results[0].abiVersion }}",
  "contract_version": "{{ results[0].version }}",
  "symbols": {
    "alloc": "{{ results[0].prefix }}_alloc",
    "free": "{{ results[0].prefix }}_free",
    "call": "{{ results[0].prefix }}_call"
  },
  "allowed_imports": [{% set first = true %}{% for row in results %}{% if row.kind == "import" %}{% if not first %},{% endif %}{% set_global first = false %}
    "{{ row.value }}"{% endif %}{% endfor %}
  ],
  "required_exports": [{% set first = true %}{% for row in results %}{% if row.kind == "export" %}{% if not first %},{% endif %}{% set_global first = false %}
    "{{ row.value }}"{% endif %}{% endfor %}
  ]
}
