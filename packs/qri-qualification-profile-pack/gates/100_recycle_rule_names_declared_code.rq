# MESSAGE: qri:recycleRule orders a code that the same host profile does not list in qri:recycleOn (orphan order row).
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
SELECT ?subject ?code WHERE {
  ?subject a qri:HostProfile ; qri:recycleRule ?r .
  ?r qri:recycleCode ?code .
  FILTER NOT EXISTS { ?subject qri:recycleOn ?on . FILTER(STR(?on) = STR(?code)) }
}
ORDER BY ?subject ?code
