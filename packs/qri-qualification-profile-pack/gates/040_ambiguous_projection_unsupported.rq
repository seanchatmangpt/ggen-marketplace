# MESSAGE: UNSUPPORTED(projection): field lacks an admitted wire type; the generator must not guess.
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
SELECT ?subject WHERE {
  ?subject a qri:Field .
  OPTIONAL { ?subject qri:fieldType ?t }
  FILTER ( !BOUND(?t) || !(STR(?t) IN ("bytes","string","bool","s32","s64","u32","u64")) )
}
ORDER BY ?subject
