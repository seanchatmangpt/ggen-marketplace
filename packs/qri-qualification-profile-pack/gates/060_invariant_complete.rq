# MESSAGE: passed qualification omits a required invariant.
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
SELECT ?subject ?invariant WHERE {
  ?subject a qri:QualificationReceipt ;
    qri:qualificationResult qri:Passed ;
    qri:qualifiesFor ?c .
  ?c qri:invariantSet ?set .
  ?set qri:requiresInvariant ?invariant .
  FILTER NOT EXISTS { ?subject qri:preservesInvariant ?invariant }
}
ORDER BY ?subject ?invariant
