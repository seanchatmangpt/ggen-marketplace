# MESSAGE: SubstitutionClaim not backed by two passed receipts for the same contract and the claimed context.
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
SELECT ?subject WHERE {
  ?subject a qri:SubstitutionClaim ;
    qri:sourceQualification ?s ;
    qri:targetQualification ?t ;
    qri:interchangeableUnder ?ctx .
  OPTIONAL { ?s qri:qualificationResult ?sr ; qri:qualifiesFor ?sc ; qri:runtimeContext ?sx }
  OPTIONAL { ?t qri:qualificationResult ?tr ; qri:qualifiesFor ?tc ; qri:runtimeContext ?tx }
  FILTER ( !BOUND(?sr) || !BOUND(?tr) || ?sr != qri:Passed || ?tr != qri:Passed
           || ?sc != ?tc || ?sx != ?ctx || ?tx != ?ctx )
}
ORDER BY ?subject
