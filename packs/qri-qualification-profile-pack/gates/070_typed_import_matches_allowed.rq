# MESSAGE: typed qri:wasiImport has no matching qri:allowedImport string (wasi_snapshot_preview1::<name>).
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
SELECT ?subject ?importName WHERE {
  ?subject qri:wasiImport ?imp .
  ?imp qri:importName ?importName .
  FILTER NOT EXISTS { ?subject qri:allowedImport ?allowed . FILTER(?allowed = CONCAT("wasi_snapshot_preview1::", STR(?importName))) }
}
ORDER BY ?subject ?importName
