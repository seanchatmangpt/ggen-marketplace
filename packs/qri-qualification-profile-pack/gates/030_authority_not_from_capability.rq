# MESSAGE: realization or receipt asserts authority; capability and qualification never imply DO authority.
PREFIX qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX odrl: <http://www.w3.org/ns/odrl/2/>
SELECT ?subject WHERE {
  { ?subject a qri:Realization } UNION { ?subject a qri:QualificationReceipt }
  UNION { ?subject a qri:ExecutionReceipt } UNION { ?subject a qri:AdmissionReceipt }
  ?subject ?p ?o .
  VALUES ?p { odrl:permission qri:grantsAuthority }
}
ORDER BY ?subject
