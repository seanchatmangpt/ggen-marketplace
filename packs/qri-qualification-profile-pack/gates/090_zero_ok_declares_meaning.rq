# MESSAGE: host limit marked qri:limitZeroOk (0 is a real bound) declares no qri:limitZeroMeaning, so the minimum semantics are undefined.
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
SELECT ?subject ?limitName WHERE {
  ?subject a qri:HostLimit ; qri:limitName ?limitName ; qri:limitZeroOk ?ok .
  FILTER(?ok = true)
  FILTER NOT EXISTS { ?subject qri:limitZeroMeaning ?m . FILTER(STRLEN(STR(?m)) > 0) }
}
ORDER BY ?subject ?limitName
