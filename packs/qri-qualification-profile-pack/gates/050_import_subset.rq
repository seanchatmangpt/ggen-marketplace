# MESSAGE: actual WASM import outside the contract's allowed imports.
PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
SELECT ?subject ?import WHERE {
  ?subject a qri:Realization ;
    qri:implementsContract ?c ;
    qri:actualImport ?import .
  FILTER NOT EXISTS { ?c qri:allowedImport ?import }
}
ORDER BY ?subject ?import
