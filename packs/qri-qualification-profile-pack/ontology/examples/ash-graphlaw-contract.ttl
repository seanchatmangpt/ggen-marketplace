@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix gl:    <urn:qri:example:ash-graphlaw:> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Host-profile contract carrying ash_graphlaw's real wasmex host values.
# Every value verified against /Users/sac/ash_graphlaw/lib/ash_graphlaw/{host,engine_load,pool,wasm_config,abi}.ex
# and lib/mix/tasks/ash_graphlaw.{vendor,verify}.ex (2026-09-30).
# Formerly ledgered UNSUPPORTED(ontology-gap), now carried by vocabulary and projected:
#   - zero-ok store limits: qri:limitZeroOk + qri:limitZeroMeaning on table_elements, instances, tables, memories
#     (gate 090); queries/51 -> wasm_config.ex.tmpl renders `&1 >= min_limit(key)` with @zero_ok.
#   - recycle code order: qri:recycleRule [ qri:recycleCode ; qri:recycleOrder ] rows (gate 100); queries/54 sorts by
#     order, then code.
#   - Host.request/3 @doc example op: qri:docExampleOp "law".
# NOT imported by ggen.toml: a qri:hostProfile contract is projected by queries/50-54 only.

gl:capability a qri:Capability .

gl:contract a qri:CapabilityContract ;
    qri:specifiesCapability gl:capability ;
    qri:contractVersion "1.0.0" ;
    qri:abiSymbolPrefix "gl" ;
    qri:abiKind "core-wasm-json" ;
    qri:abiVersion "1" ;
    qri:invariantSet gl:invariants ;
    qri:refusalScheme gl:refusals ;
    qri:hostProfile gl:host ;
    qri:allowedImport "wasi_snapshot_preview1::clock_time_get" ,
                      "wasi_snapshot_preview1::environ_get" ,
                      "wasi_snapshot_preview1::environ_sizes_get" ,
                      "wasi_snapshot_preview1::fd_write" ,
                      "wasi_snapshot_preview1::proc_exit" ,
                      "wasi_snapshot_preview1::random_get" ,
                      "wasi_snapshot_preview1::sched_yield" ;
    qri:requiredExport "gl_alloc" , "gl_call" , "gl_free" , "memory" ;
    qri:optionalExport "_initialize" ;
    qri:wasiImport gl:impClockTimeGet , gl:impEnvironGet , gl:impEnvironSizesGet , gl:impFdWrite , gl:impProcExit , gl:impRandomGet , gl:impSchedYield ;
    qri:operation gl:opCall .

gl:opCall a qri:Operation ; qri:opName "call" ; qri:input gl:inRequest ; qri:output gl:outResponse .
gl:inRequest a qri:Field ; qri:fieldName "request" ; qri:fieldType "bytes" ; qri:fieldOrder 1 .
gl:outResponse a qri:Field ; qri:fieldName "response" ; qri:fieldType "bytes" ; qri:fieldOrder 1 .

gl:invariants a qri:InvariantSet ; qri:requiresInvariant gl:semanticResult , gl:refusalBoundary , gl:determinism .
gl:semanticResult a qri:Invariant ; qri:invariantKind qri:Semantic .
gl:refusalBoundary a qri:Invariant ; qri:invariantKind qri:Refusal .
gl:determinism a qri:Invariant ; qri:invariantKind qri:Determinism .

gl:refusals a skos:ConceptScheme .
gl:rMalformed a qri:RefusalCode , skos:Concept ; skos:inScheme gl:refusals ; qri:refusalCode "malformed-input" .
gl:rResource a qri:RefusalCode , skos:Concept ; skos:inScheme gl:refusals ; qri:refusalCode "resource-bound" .

gl:host a qri:HostProfile ;
    qri:freeSymbol "gl_free" ; qri:freeArity 2 ; qri:lenType "u32" ;
    qri:allocZeroPolicy "refuse-resource_limit" ; qri:reqConsumed true ;
    qri:outMode "packed_u64" ; qri:errorCollapse "refusal_kind" ;
    qri:requestCap 16777216 ; qri:pathEnv "GRAPHLAW_WASM_PATH" ;
    qri:manifestRel "priv/graphlaw/MANIFEST.json" ; qri:wasmRel "priv/graphlaw/graphlaw.wasm" ;
    qri:manifestSchema "ash_graphlaw.graphlaw.manifest/v1" ; qri:pinFormat "sha256-hex" ;
    qri:moduleRoot "AshGraphLaw" ; qri:taskModuleRoot "AshGraphlaw" ; qri:otpApp "ash_graphlaw" ;
    qri:handleNoun "engine" ; qri:taxonomyNamespace "chatman" ; qri:refusalModule "AshGraphLaw.Refusal" ;
    qri:telemetryRoot "ash_graphlaw" ; qri:okKey "ok" ; qri:opKey "op" ;
    qri:poolStrategy "rest_for_one" ; qri:poolSizeSource "schedulers_online" ;
    qri:engineId "GraphLaw" ; qri:probeOp "capabilities" ; qri:probeExpectKey "abi" ;
    qri:recycleOn "abi_failure" , "call_exited" , "call_trapped" , "call_timeout" , "fuel_exhausted" ;
    qri:recycleRule gl:recycle1 , gl:recycle2 , gl:recycle3 , gl:recycle4 , gl:recycle5 ;
    qri:docExampleOp "law" ;
    qri:hostLimit gl:limFuelPerMs , gl:limInstantiateFuel , gl:limMemoryLimitBytes , gl:limRecycleBytes , gl:limMaxQueue , gl:limMaxResponseBytes , gl:limTableElements , gl:limInstances , gl:limTables , gl:limMemories , gl:limTimeoutMs , gl:limAbiTimeout , gl:limMargin , gl:limRetryBaseMs , gl:limRetryMaxMs , gl:limInitializeTimeoutMult , gl:limBackoffExpCap , gl:limMaxRedirects .

gl:recycle1 a qri:RecycleRule ; qri:recycleCode "abi_failure" ; qri:recycleOrder 1 .
gl:recycle2 a qri:RecycleRule ; qri:recycleCode "call_exited" ; qri:recycleOrder 2 .
gl:recycle3 a qri:RecycleRule ; qri:recycleCode "call_trapped" ; qri:recycleOrder 3 .
gl:recycle4 a qri:RecycleRule ; qri:recycleCode "call_timeout" ; qri:recycleOrder 4 .
gl:recycle5 a qri:RecycleRule ; qri:recycleCode "fuel_exhausted" ; qri:recycleOrder 5 .

# Limits and typed imports observed in /Users/sac/ash_graphlaw (ontology.ttl 'Engine import allowlist', engine_load.ex).
gl:limFuelPerMs a qri:HostLimit ; qri:limitName "fuel_per_ms" ; qri:limitDefault 1000000 ; qri:limitOrder 1 .
gl:limInstantiateFuel a qri:HostLimit ; qri:limitName "instantiate_fuel" ; qri:limitDefault 1000000000 ; qri:limitOrder 2 .
gl:limMemoryLimitBytes a qri:HostLimit ; qri:limitName "memory_limit_bytes" ; qri:limitDefault 268435456 ; qri:limitOrder 3 .
gl:limRecycleBytes a qri:HostLimit ; qri:limitName "recycle_bytes" ; qri:limitDefault 134217728 ; qri:limitOrder 4 .
gl:limMaxQueue a qri:HostLimit ; qri:limitName "max_queue" ; qri:limitDefault 64 ; qri:limitOrder 5 .
gl:limMaxResponseBytes a qri:HostLimit ; qri:limitName "max_response_bytes" ; qri:limitDefault 33554432 ; qri:limitOrder 6 .
gl:limTableElements a qri:HostLimit ; qri:limitName "table_elements" ; qri:limitDefault 100000 ; qri:limitOrder 7 ; qri:limitZeroOk true ; qri:limitZeroMeaning "\"none allowed\", refused at instantiation" .
gl:limInstances a qri:HostLimit ; qri:limitName "instances" ; qri:limitDefault 10 ; qri:limitOrder 8 ; qri:limitZeroOk true ; qri:limitZeroMeaning "\"none allowed\", refused at instantiation" .
gl:limTables a qri:HostLimit ; qri:limitName "tables" ; qri:limitDefault 10 ; qri:limitOrder 9 ; qri:limitZeroOk true ; qri:limitZeroMeaning "\"none allowed\", refused at instantiation" .
gl:limMemories a qri:HostLimit ; qri:limitName "memories" ; qri:limitDefault 4 ; qri:limitOrder 10 ; qri:limitZeroOk true ; qri:limitZeroMeaning "\"none allowed\", refused at instantiation" .
gl:limTimeoutMs a qri:HostLimit ; qri:limitName "timeout_ms" ; qri:limitDefault 5000 ; qri:limitOrder 11 .
gl:limAbiTimeout a qri:HostLimit ; qri:limitName "abi_timeout" ; qri:limitDefault 1000 ; qri:limitOrder 12 .
gl:limMargin a qri:HostLimit ; qri:limitName "margin" ; qri:limitDefault 1000 ; qri:limitOrder 13 .
gl:limRetryBaseMs a qri:HostLimit ; qri:limitName "retry_base_ms" ; qri:limitDefault 500 ; qri:limitOrder 14 .
gl:limRetryMaxMs a qri:HostLimit ; qri:limitName "retry_max_ms" ; qri:limitDefault 30000 ; qri:limitOrder 15 .
gl:limInitializeTimeoutMult a qri:HostLimit ; qri:limitName "initialize_timeout_mult" ; qri:limitDefault 10 ; qri:limitOrder 16 .
gl:limBackoffExpCap a qri:HostLimit ; qri:limitName "backoff_exp_cap" ; qri:limitDefault 16 ; qri:limitOrder 17 .
gl:limMaxRedirects a qri:HostLimit ; qri:limitName "max_redirects" ; qri:limitDefault 5 ; qri:limitOrder 18 .
gl:impClockTimeGet a qri:WasiImport ; qri:importName "clock_time_get" ; qri:importParams "i32,i64,i32" ; qri:importResults "i32" .
gl:impEnvironGet a qri:WasiImport ; qri:importName "environ_get" ; qri:importParams "i32,i32" ; qri:importResults "i32" .
gl:impEnvironSizesGet a qri:WasiImport ; qri:importName "environ_sizes_get" ; qri:importParams "i32,i32" ; qri:importResults "i32" .
gl:impFdWrite a qri:WasiImport ; qri:importName "fd_write" ; qri:importParams "i32,i32,i32,i32" ; qri:importResults "i32" .
gl:impProcExit a qri:WasiImport ; qri:importName "proc_exit" ; qri:importParams "i32" ; qri:importResults "" .
gl:impRandomGet a qri:WasiImport ; qri:importName "random_get" ; qri:importParams "i32,i32" ; qri:importResults "i32" .
gl:impSchedYield a qri:WasiImport ; qri:importName "sched_yield" ; qri:importParams "" ; qri:importResults "i32" .
