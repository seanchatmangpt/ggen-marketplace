@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix cmca:    <urn:qri:example:autofde-cmca:> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Family C: length-prefixed output (4 bytes), two-arg free, unconsumed request, masked pointers.
# NOT imported by ggen.toml: a qri:hostProfile contract is projected by queries/50-54 only.

cmca:capability a qri:Capability .

cmca:contract a qri:CapabilityContract ;
    qri:specifiesCapability cmca:capability ;
    qri:contractVersion "1.0.0" ;
    qri:abiSymbolPrefix "cmca" ;
    qri:abiKind "core-wasm-json" ;
    qri:abiVersion "1" ;
    qri:invariantSet cmca:invariants ;
    qri:refusalScheme cmca:refusals ;
    qri:hostProfile cmca:host ;
    qri:allowedImport "wasi_snapshot_preview1::fd_write" ;
    qri:requiredExport "cmca_alloc" , "cmca_call" , "cmca_free" , "memory" ;
    qri:operation cmca:opCall .

cmca:opCall a qri:Operation ; qri:opName "call" ; qri:input cmca:inRequest ; qri:output cmca:outResponse .
cmca:inRequest a qri:Field ; qri:fieldName "request" ; qri:fieldType "bytes" ; qri:fieldOrder 1 .
cmca:outResponse a qri:Field ; qri:fieldName "response" ; qri:fieldType "bytes" ; qri:fieldOrder 1 .

cmca:invariants a qri:InvariantSet ; qri:requiresInvariant cmca:semanticResult , cmca:refusalBoundary , cmca:determinism .
cmca:semanticResult a qri:Invariant ; qri:invariantKind qri:Semantic .
cmca:refusalBoundary a qri:Invariant ; qri:invariantKind qri:Refusal .
cmca:determinism a qri:Invariant ; qri:invariantKind qri:Determinism .

cmca:refusals a skos:ConceptScheme .
cmca:rMalformed a qri:RefusalCode , skos:Concept ; skos:inScheme cmca:refusals ; qri:refusalCode "malformed-input" .
cmca:rResource a qri:RefusalCode , skos:Concept ; skos:inScheme cmca:refusals ; qri:refusalCode "resource-bound" .

cmca:host a qri:HostProfile ;
    qri:freeSymbol "cmca_free" ; qri:freeArity 2 ; qri:lenType "u32" ;
    qri:outMode "len_prefix" ; qri:outLenWidth 4 ; qri:reqConsumed false ;
    qri:ptrMask "0xFFFFFFFF" ; qri:errorCollapse "ok_flag_refusal" ;
    qri:otpApp "autofde_cmca" ; qri:moduleRoot "Autofde.Cmca" ; qri:handleNoun "instance" ;
    qri:poolStrategy "single" ; qri:poolSize 1 .
