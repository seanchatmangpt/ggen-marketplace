@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix pg:    <urn:qri:example:beam4pm-pg:> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Family B: usize lengths, pg_dealloc, single_key_inspect error collapse.
# NOT imported by ggen.toml: a qri:hostProfile contract is projected by queries/50-54 only.

pg:capability a qri:Capability .

pg:contract a qri:CapabilityContract ;
    qri:specifiesCapability pg:capability ;
    qri:contractVersion "1.0.0" ;
    qri:abiSymbolPrefix "pg" ;
    qri:abiKind "core-wasm-json" ;
    qri:abiVersion "1" ;
    qri:invariantSet pg:invariants ;
    qri:refusalScheme pg:refusals ;
    qri:hostProfile pg:host ;
    qri:allowedImport "wasi_snapshot_preview1::fd_write" ;
    qri:requiredExport "memory" , "pg_alloc" , "pg_call" , "pg_dealloc" ;
    qri:operation pg:opCall .

pg:opCall a qri:Operation ; qri:opName "call" ; qri:input pg:inRequest ; qri:output pg:outResponse .
pg:inRequest a qri:Field ; qri:fieldName "request" ; qri:fieldType "bytes" ; qri:fieldOrder 1 .
pg:outResponse a qri:Field ; qri:fieldName "response" ; qri:fieldType "bytes" ; qri:fieldOrder 1 .

pg:invariants a qri:InvariantSet ; qri:requiresInvariant pg:semanticResult , pg:refusalBoundary , pg:determinism .
pg:semanticResult a qri:Invariant ; qri:invariantKind qri:Semantic .
pg:refusalBoundary a qri:Invariant ; qri:invariantKind qri:Refusal .
pg:determinism a qri:Invariant ; qri:invariantKind qri:Determinism .

pg:refusals a skos:ConceptScheme .
pg:rMalformed a qri:RefusalCode , skos:Concept ; skos:inScheme pg:refusals ; qri:refusalCode "malformed-input" .
pg:rResource a qri:RefusalCode , skos:Concept ; skos:inScheme pg:refusals ; qri:refusalCode "resource-bound" .

pg:host a qri:HostProfile ;
    qri:freeSymbol "pg_dealloc" ; qri:freeArity 1 ; qri:lenType "usize" ;
    qri:outMode "packed_u64" ; qri:errorCollapse "single_key_inspect" ;
    qri:otpApp "beam4pm" ; qri:moduleRoot "Beam4pm.Pg" ; qri:handleNoun "module" ;
    qri:poolStrategy "single" ; qri:poolSize 1 .
