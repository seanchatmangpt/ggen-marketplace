@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# Forward alignment to the SOSA/SSN 2023 Edition (W3C/OGC Working Draft). Separately versioned so
# Recommendation-track churn cannot change QRI capability identity. Not imported by ggen.toml.
qri:Realization skos:closeMatch sosa:System .
qri:Execution   skos:closeMatch sosa:Execution .
qri:Capability  skos:closeMatch sosa:Procedure .
