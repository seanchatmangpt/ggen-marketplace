@prefix qri:  <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn:  <http://www.w3.org/ns/ssn/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix qce:  <https://ggen.dev/ontology/qualified-capability-ecology#> .

# Stable baseline: 2017 W3C/OGC SOSA/SSN Recommendation. The 2023 edition is a Working Draft and
# is aligned in ontology/alignment-sosa-2023.ttl only, never here and never in core.
qri:Capability   skos:closeMatch sosa:Procedure .
qri:Realization  skos:closeMatch ssn:System .
qri:Execution    skos:closeMatch prov:Activity .

# Reuse of in-repo capital (qualified-capability-ecology-pack): related, NOT equivalent --
# qce:SubstitutionClaim has no context/invariant-set reification requirement.
qri:QualificationReceipt skos:relatedMatch qce:QualificationReceipt .
qri:SubstitutionClaim    skos:relatedMatch qce:SubstitutionClaim .
qri:ReplayReceipt        skos:relatedMatch qce:ReplayReceipt .

# Authority plane is ODRL; QRI asserts only that it is a separate plane.
qri:authorityPolicy rdfs:seeAlso odrl:Policy .
