PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
SELECT ?prefix ?version ?abiKind ?abiVersion ?kind ?value WHERE {
  ?c a qri:CapabilityContract ;
     qri:abiSymbolPrefix ?prefix ; qri:contractVersion ?version ;
     qri:abiKind ?abiKind ; qri:abiVersion ?abiVersion .
  { ?c qri:allowedImport ?value . BIND("import" AS ?kind) }
  UNION { ?c qri:requiredExport ?value . BIND("export" AS ?kind) }
  FILTER NOT EXISTS { ?c qri:hostProfile ?hpx }
}
ORDER BY ?kind ?value
