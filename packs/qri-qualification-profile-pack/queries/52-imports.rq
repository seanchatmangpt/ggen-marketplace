PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
SELECT ?prefix ?name ?params ?results WHERE {
  ?c a qri:CapabilityContract ; qri:hostProfile ?hp ; qri:abiSymbolPrefix ?prefix ;
     qri:wasiImport ?i .
  ?i qri:importName ?name .
  OPTIONAL { ?i qri:importParams ?p }
  OPTIONAL { ?i qri:importResults ?r }
  BIND(COALESCE(?p, "") AS ?params)
  BIND(COALESCE(?r, "") AS ?results)
}
ORDER BY ?prefix ?name
