PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?prefix ?version ?code WHERE {
  ?c a qri:CapabilityContract ; qri:abiSymbolPrefix ?prefix ; qri:contractVersion ?version ; qri:refusalScheme ?scheme .
  ?r skos:inScheme ?scheme ; qri:refusalCode ?code .
  FILTER NOT EXISTS { ?c qri:hostProfile ?hpx }
}
ORDER BY ?code
