PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?prefix ?invariant ?kind ?limit WHERE {
  ?c a qri:CapabilityContract ; qri:abiSymbolPrefix ?prefix ; qri:invariantSet ?set .
  ?set qri:requiresInvariant ?invariant .
  ?invariant qri:invariantKind ?k .
  ?k rdfs:label ?kind .
  OPTIONAL { ?invariant qri:limitValue ?limit }
  FILTER NOT EXISTS { ?c qri:hostProfile ?hpx }
}
ORDER BY ?kind ?invariant
