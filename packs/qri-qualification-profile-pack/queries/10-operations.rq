PREFIX qri: <https://seanchatmangpt.github.io/packs/qri-qualification-profile-pack#>
SELECT ?prefix ?version ?opName ?inName ?inType ?outName ?outType WHERE {
  ?c a qri:CapabilityContract ;
     qri:abiSymbolPrefix ?prefix ;
     qri:contractVersion ?version ;
     qri:operation ?op .
  ?op qri:opName ?opName ;
      qri:input ?in ; qri:output ?out .
  ?in qri:fieldName ?inName ; qri:fieldType ?inType .
  ?out qri:fieldName ?outName ; qri:fieldType ?outType .
  FILTER NOT EXISTS { ?c qri:hostProfile ?hpx }
}
ORDER BY ?prefix ?opName
