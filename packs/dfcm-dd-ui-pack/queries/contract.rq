PREFIX ddui: <https://chatman.ai/ontology/dd-ui#>
PREFIX dfcm: <https://chatman.ai/ontology/dfcm#>
PREFIX brce: <https://chatman.ai/ontology/brce#>
SELECT ?selectCeiling ?constructAdmission ?doReceipt WHERE {
  ddui:SELECT dfcm:authorityCeiling ?selectCeiling .
  ddui:CONSTRUCT dfcm:requiresExplicitAdmission ?constructAdmission .
  ddui:DO brce:requiresReceipt ?doReceipt .
}
ORDER BY ?selectCeiling ?constructAdmission ?doReceipt
