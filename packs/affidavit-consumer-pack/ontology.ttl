@prefix afc:  <https://ggen.dev/ontology/affidavit-consumer#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# What a project declares to adopt affidavit. Wire format source of truth: affidavit
# src/types.rs (ObjectRef id:type[:qualifier]; ProfileId core/v1) and CLAUDE.md naming
# (event types lowercase+dash). Authority ceiling NONE.

afc:Consumer a rdfs:Class ; rdfs:comment "A project that emits affidavit receipts. Exactly one per graph." .
afc:EventType a rdfs:Class ; rdfs:comment "An event_type string the project emits, e.g. build, audit-log." .
afc:ObjectType a rdfs:Class ; rdfs:comment "An ObjectRef obj_type the project uses, e.g. repo, suite, service." .

afc:projectName a rdf:Property ; rdfs:domain afc:Consumer .
afc:profile     a rdf:Property ; rdfs:comment "Receipt profile; only core/v1 exists." .
afc:emits       a rdf:Property ; rdfs:domain afc:Consumer ; rdfs:range afc:EventType .
afc:usesObject  a rdf:Property ; rdfs:domain afc:Consumer ; rdfs:range afc:ObjectType .
afc:name        a rdf:Property ; rdfs:comment "Wire string; lowercase letters, digits, dashes." .
afc:receiptPath a rdf:Property ; rdfs:comment "Repo path of the receipt the CI gate verifies." .
