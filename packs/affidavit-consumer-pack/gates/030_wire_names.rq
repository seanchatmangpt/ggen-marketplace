# MESSAGE: event and object type names are lowercase letters, digits and dashes (no colon: ':' is the ObjectRef separator).
PREFIX afc: <https://ggen.dev/ontology/affidavit-consumer#>
SELECT ?problem ?detail WHERE {
  { ?e a afc:EventType ; afc:name ?n . FILTER(!REGEX(?n, "^[a-z][a-z0-9-]*$"))
    BIND("event_type_not_lowercase_dash" AS ?problem) BIND(?n AS ?detail) }
  UNION
  { ?o a afc:ObjectType ; afc:name ?n . FILTER(!REGEX(?n, "^[a-z][a-z0-9-]*$"))
    BIND("object_type_not_lowercase_dash" AS ?problem) BIND(?n AS ?detail) }
  UNION
  { ?x a ?t ; afc:name ?n . FILTER(?t IN (afc:EventType, afc:ObjectType)) FILTER(STRLEN(?n) = 0)
    BIND("empty_name" AS ?problem) BIND(STR(?x) AS ?detail) }
}
ORDER BY ?problem ?detail
