# MESSAGE: event type names are unique; object type names are unique.
PREFIX afc: <https://ggen.dev/ontology/affidavit-consumer#>
SELECT ?problem ?detail WHERE {
  { ?a a afc:EventType ; afc:name ?n . ?b a afc:EventType ; afc:name ?n . FILTER(STR(?a) < STR(?b))
    BIND("duplicate_event_type" AS ?problem) BIND(?n AS ?detail) }
  UNION
  { ?a a afc:ObjectType ; afc:name ?n . ?b a afc:ObjectType ; afc:name ?n . FILTER(STR(?a) < STR(?b))
    BIND("duplicate_object_type" AS ?problem) BIND(?n AS ?detail) }
}
ORDER BY ?problem ?detail
