# MESSAGE: the only receipt profile affidavit defines is core/v1.
PREFIX afc: <https://ggen.dev/ontology/affidavit-consumer#>
SELECT ?problem ?detail WHERE {
  ?c a afc:Consumer ; afc:profile ?p . FILTER(?p != "core/v1")
  BIND("unknown_profile" AS ?problem) BIND(?p AS ?detail)
}
ORDER BY ?problem ?detail
