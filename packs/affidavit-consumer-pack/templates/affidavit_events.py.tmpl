"""GENERATED by affidavit-consumer-pack from the project's afc: vocabulary. Do not edit.

Wire format: ObjectRef = "id:type[:qualifier]"; receipt profile "{{ profile }}".
"""
{%- set ev = events | split(pat="@@") | sort %}
{%- set ob = objects | split(pat="@@") | sort %}
from __future__ import annotations

PROFILE = {{ profile | json_encode() | safe }}
EVENT_TYPES = ({% for e in ev %}{{ e | json_encode() | safe }},{% if not loop.last %} {% endif %}{% endfor %})
OBJECT_TYPES = ({% for o in ob %}{{ o | json_encode() | safe }},{% if not loop.last %} {% endif %}{% endfor %})


def object_ref(id: str, type: str, qualifier: str | None = None) -> str:
    """Build an affidavit ObjectRef string; refuses unknown types and ':' inside parts."""
    if type not in OBJECT_TYPES:
        raise ValueError(f"unknown object type: {type}")
    for part in (id, qualifier or ""):
        if ":" in part:
            raise ValueError(f"ObjectRef part contains ':' : {part}")
    return f"{id}:{type}" if qualifier is None else f"{id}:{type}:{qualifier}"


def is_event_type(s: str) -> bool:
    return s in EVENT_TYPES
