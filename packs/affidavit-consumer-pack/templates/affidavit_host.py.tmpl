from __future__ import annotations

import hashlib
import json
from typing import Any

from wasmtime import Engine, Linker, Module, Store, WasiConfig

ABI_VERSION = {{ abi_version }}
MAX_REQUEST_BYTES = {{ max_request_bytes }}
OPS = ({% for o in op_list %}{% set p = o | split(pat="##") %}{{ p[1] | json_encode() | safe }},{% if not loop.last %} {% endif %}{% endfor %})


class AffidavitRefusal(Exception):
    def __init__(self, code: str, message: str = ""):
        super().__init__(f"{code}: {message}")
        self.code = code


class AffidavitHost:
    def __init__(self, wasm_path: str, sha256: str | None = None):
        with open(wasm_path, "rb") as fh:
            data = fh.read()
        if sha256 is not None:
            actual = hashlib.sha256(data).hexdigest()
            if actual != sha256:
                raise AffidavitRefusal("wasm_digest_mismatch", f"expected {sha256}, got {actual}")
        engine = Engine()
        self._store = Store(engine)
        wasi = WasiConfig()
        self._store.set_wasi(wasi)
        linker = Linker(engine)
        linker.define_wasi()
        self._inst = linker.instantiate(self._store, Module(engine, data))
        ex = self._inst.exports(self._store)
        init = ex.get("_initialize")
        if init is not None:
            init(self._store)
        self._mem = ex["memory"]
        self._alloc, self._call, self._free = ex["{{ export_prefix }}_alloc"], ex["{{ export_prefix }}_call"], ex["{{ export_prefix }}_free"]
        version = ex["{{ export_prefix }}_abi_version"](self._store)
        if version != ABI_VERSION:
            raise AffidavitRefusal("abi_version_mismatch", f"module {version}, host {ABI_VERSION}")

    def call(self, op: str, **fields: Any) -> dict:
        """One request, one response. ok:false envelopes raise AffidavitRefusal."""
        body = json.dumps({"op": op, **fields}).encode()
        if len(body) > MAX_REQUEST_BYTES:
            raise AffidavitRefusal("too_large", f"{len(body)} bytes")
        ptr = self._alloc(self._store, len(body))
        self._mem.write(self._store, body, ptr)
        packed = self._call(self._store, ptr, len(body)) & 0xFFFFFFFFFFFFFFFF
        out_ptr, out_len = packed >> 32, packed & 0xFFFFFFFF
        out = bytes(self._mem.read(self._store, out_ptr, out_ptr + out_len))
        self._free(self._store, out_ptr, out_len)
        res = json.loads(out)
        if res.get("ok") is False:
            err = res.get("error", {})
            raise AffidavitRefusal(err.get("code", "internal"), err.get("message", ""))
        return res
