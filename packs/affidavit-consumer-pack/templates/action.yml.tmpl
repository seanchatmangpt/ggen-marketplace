name: "affidavit verify ({{ project_name }})"
description: "Fail the build unless the affidavit receipt verifies. Certifies format; does not decide whether the work was honest."
inputs:
  receipt:
    description: "Path to the sealed receipt"
    default: {{ receipt_path | json_encode() | safe }}
