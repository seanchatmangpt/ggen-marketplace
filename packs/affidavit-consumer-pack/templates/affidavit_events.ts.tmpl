{%- set ob = objects | split(pat="@@") | sort %}

export const PROFILE = {{ profile | json_encode() | safe }} as const;

export const EVENT_TYPES = [{% for e in ev %}{{ e | json_encode() | safe }}{% if not loop.last %}, {% endif %}{% endfor %}] as const;
