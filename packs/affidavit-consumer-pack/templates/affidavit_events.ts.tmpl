export const OBJECT_TYPES = [{% for o in ob %}{{ o | json_encode() | safe }}{% if not loop.last %}, {% endif %}{% endfor %}] as const;
export type ObjectType = (typeof OBJECT_TYPES)[number];

/** Build an affidavit ObjectRef string; refuses ids/qualifiers containing the ':' separator. */
export function objectRef(id: string, type: ObjectType, qualifier?: string): string {
  for (const part of [id, qualifier ?? ""]) {
    if (part.includes(":")) throw new Error(`ObjectRef part contains ':' : ${part}`);
  }
  return qualifier === undefined ? `${id}:${type}` : `${id}:${type}:${qualifier}`;
}

export function isEventType(s: string): s is EventType {
  return (EVENT_TYPES as readonly string[]).includes(s);
}
