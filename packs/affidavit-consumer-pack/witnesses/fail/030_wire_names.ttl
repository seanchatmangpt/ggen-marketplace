@prefix afc: <https://ggen.dev/ontology/affidavit-consumer#> .
@prefix ex:  <https://example.org/acme-shop#> .
# QUALIFICATION: minimal conforming consumer; every gate returns 0 rows.
ex:project a afc:Consumer ; afc:projectName "acme-shop" ; afc:profile "core/v1" ;
  afc:receiptPath "receipts/release.json" ;
  afc:emits ex:build , ex:test , ex:deploy , ex:audit-log ;
  afc:usesObject ex:repo , ex:suite , ex:service .
ex:build a afc:EventType ; afc:name "build" .
ex:test a afc:EventType ; afc:name "test" .
ex:deploy a afc:EventType ; afc:name "deploy" .
ex:audit-log a afc:EventType ; afc:name "Audit:Log" .
ex:repo a afc:ObjectType ; afc:name "repo" .
ex:suite a afc:ObjectType ; afc:name "suite" .
ex:service a afc:ObjectType ; afc:name "service" .
