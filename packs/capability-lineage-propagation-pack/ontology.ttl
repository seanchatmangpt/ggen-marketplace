@prefix clp: <https://ggen.dev/ontology/capability-lineage-propagation#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

clp:QualifiedCapability a prov:Entity .
clp:LineageEdge a prov:Entity .
clp:PropagationPlan a prov:Entity .
clp:ContainmentWitness a prov:Entity .

clp:factory clp:authority "SELECT|CONSTRUCT|VERIFY" ; clp:actuationPerformed false ; clp:requiresQualifiedSource true ; clp:requiresAncestorProof true ; clp:forcePushAllowed false .

clp:referenceCapability a clp:QualifiedCapability ; clp:sourceRepository "seanchatmangpt/chatman-ecosystem" ; clp:sourcePr 212 ; clp:semanticCommitCount 25 ; clp:standing "ALIVE" ; clp:actuationPerformed false .
clp:edge213 a clp:LineageEdge ; clp:fromPr 212 ; clp:toPr 213 ; clp:semanticDelta 0 ; clp:preservesCapability true .
clp:edge214 a clp:LineageEdge ; clp:fromPr 213 ; clp:toPr 214 ; clp:semanticDelta 0 ; clp:preservesCapability true .
clp:edge215 a clp:LineageEdge ; clp:fromPr 214 ; clp:toPr 215 ; clp:semanticDelta 0 ; clp:preservesCapability true .
clp:referencePlan a clp:PropagationPlan ; clp:capability clp:referenceCapability ; clp:edge clp:edge213, clp:edge214, clp:edge215 ; clp:authority "CONSTRUCT" ; clp:actuationPerformed false ; clp:forcePushAllowed false .
