PREFIX clp: <https://ggen.dev/ontology/capability-lineage-propagation#>
ASK {
  clp:factory clp:authority "SELECT|CONSTRUCT|VERIFY" ; clp:actuationPerformed false ; clp:forcePushAllowed false .
  FILTER NOT EXISTS { ?s clp:authority "DO" }
  FILTER NOT EXISTS { ?s clp:actuationPerformed true }
  FILTER NOT EXISTS { ?s clp:forcePushAllowed true }
}
