PREFIX clp: <https://ggen.dev/ontology/capability-lineage-propagation#>
SELECT ?plan ?cap (COUNT(DISTINCT ?edge) AS ?edges) WHERE {
  ?plan a clp:PropagationPlan ; clp:capability ?cap ; clp:edge ?edge ; clp:authority "CONSTRUCT" ; clp:actuationPerformed false ; clp:forcePushAllowed false .
  ?cap a clp:QualifiedCapability ; clp:standing "ALIVE" .
  ?edge a clp:LineageEdge ; clp:preservesCapability true ; clp:semanticDelta 0 .
}
GROUP BY ?plan ?cap
HAVING(COUNT(DISTINCT ?edge) >= 1)
