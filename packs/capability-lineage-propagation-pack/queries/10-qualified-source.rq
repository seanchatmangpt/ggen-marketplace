PREFIX clp: <https://ggen.dev/ontology/capability-lineage-propagation#>
SELECT ?cap ?repo ?pr ?semantic WHERE {
  ?cap a clp:QualifiedCapability ; clp:sourceRepository ?repo ; clp:sourcePr ?pr ; clp:semanticCommitCount ?semantic ; clp:standing "ALIVE" ; clp:actuationPerformed false .
}
ORDER BY ?repo ?pr
