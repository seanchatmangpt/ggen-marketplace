---
to: "{{ row.wrapper_path }}"
force: true
sparql:
  row: |
    PREFIX bwh: <urn:beam:wasmex:host:>
    SELECT ?algorithm_id ?call_export ?replay_export ?wrapper_module ?wrapper_path ?host_module WHERE {
      ?b a bwh:AlgorithmBinding ;
         bwh:algorithmId ?algorithm_id ;
         bwh:callExport ?call_export ;
         bwh:replayExport ?replay_export ;
         bwh:wrapperModule ?wrapper_module ;
         bwh:wrapperPath ?wrapper_path ;
         bwh:hostModule ?host_module .
    } ORDER BY ?algorithm_id
---
# GENERATED by beam-wasmex-host-pack. Do not edit; edit the RDF
# bwh:AlgorithmBinding row and re-run the generator.
defmodule {{ row.wrapper_module }} do
  @moduledoc """
  GENERATED per-algorithm wrapper for the `{{ row.call_export }}` /
  `{{ row.replay_export }}` export pair, delegating to the generated host
  module `{{ row.host_module }}`.

  The host computes the authoritative digests; this module adds nothing to
  identity except the pairing. `execute/3` performs the real call AND the
  real replay, so `replay_verified` reflects a genuinely recomputed second
  execution.
  """

  @algorithm_id :{{ row.algorithm_id }}
  @call_export "{{ row.call_export }}"
  @replay_export "{{ row.replay_export }}"
  @host {{ row.host_module }}

  def algorithm_id, do: @algorithm_id
  def call_export, do: @call_export
  def replay_export, do: @replay_export

  @doc "Real call of `#{@call_export}` with `request` over `instance`."
  @spec call(map(), {{ row.host_module }}.instance(), keyword()) ::
          {:ok, map()} | {:error, {{ row.host_module }}.Refusal.t()}
  def call(request, instance, opts \\ []), do: @host.call(instance, @call_export, request, opts)

  @doc "Real replay of `#{@replay_export}` with the SAME request bytes."
  @spec replay(map(), {{ row.host_module }}.instance(), keyword()) ::
          {:ok, boolean()} | {:error, {{ row.host_module }}.Refusal.t()}
  def replay(request, instance, opts \\ []),
    do: @host.replay(instance, @replay_export, request, opts)

  @doc """
  Call + replay + receipt in one pass:
  `{:ok, response, %{receipt: _, identity: %{observed: true, replay_verified: _}}}`.
  """
  @spec execute(map(), {{ row.host_module }}.instance(), keyword()) ::
          {:ok, map(), map()} | {:error, {{ row.host_module }}.Refusal.t()}
  def execute(request, instance, opts \\ []),
    do: @host.execute(instance, @call_export, @replay_export, request, opts)
end
