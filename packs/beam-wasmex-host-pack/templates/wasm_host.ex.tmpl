---
to: "{{ host[0].target_path }}"
force: true
sparql:
  memory_rows: |
    PREFIX bwh: <urn:beam:wasmex:host:>
    SELECT ?v WHERE { ?h a bwh:WasmexHostSurface ; bwh:memoryExport ?v . } ORDER BY ?v LIMIT 1
  init_rows: |
    PREFIX bwh: <urn:beam:wasmex:host:>
    SELECT ?v WHERE { ?h a bwh:WasmexHostSurface ; bwh:initializeExport ?v . } ORDER BY ?v LIMIT 1
  manifest_rows: |
    PREFIX bwh: <urn:beam:wasmex:host:>
    SELECT ?v WHERE { ?h a bwh:WasmexHostSurface ; bwh:manifestRel ?v . } ORDER BY ?v LIMIT 1
  manifest_expand_rows: |
    PREFIX bwh: <urn:beam:wasmex:host:>
    SELECT ?v WHERE { ?h a bwh:WasmexHostSurface ; bwh:manifestExpand ?v . } ORDER BY ?v LIMIT 1
  host: |
    PREFIX bwh: <urn:beam:wasmex:host:>
    SELECT ?otp_app ?root_module ?target_path ?artifact_path ?out_mode ?import_mode
           ?alloc_export ?free_export ?dealloc_export ?digest_prefix
           ?max_request_bytes ?max_response_bytes ?call_timeout_ms
           (COALESCE(GROUP_CONCAT(?pair; separator=";"), "") AS ?algo_csv)
    WHERE {
      ?h a bwh:WasmexHostSurface ;
         bwh:otpApp ?otp_app ;
         bwh:rootModule ?root_module ;
         bwh:targetPath ?target_path ;
         bwh:artifactPath ?artifact_path ;
         bwh:outMode ?out_mode ;
         bwh:importMode ?import_mode ;
         bwh:allocExport ?alloc_export ;
         bwh:freeExport ?free_export ;
         bwh:deallocExport ?dealloc_export ;
         bwh:digestPrefix ?digest_prefix ;
         bwh:maxRequestBytes ?max_request_bytes ;
         bwh:maxResponseBytes ?max_response_bytes ;
         bwh:callTimeoutMs ?call_timeout_ms .
      OPTIONAL {
        ?b a bwh:AlgorithmBinding ;
           bwh:algorithmId ?algorithm_id ;
           bwh:callExport ?call_export ;
           bwh:replayExport ?replay_export ;
           bwh:wrapperModule ?wrapper_module .
        BIND(CONCAT(COALESCE(?algorithm_id, ""), "|", COALESCE(?call_export, ""), "|", COALESCE(?replay_export, ""), "|", COALESCE(?wrapper_module, "")) AS ?pair)
      }
    } GROUP BY ?otp_app ?root_module ?target_path ?artifact_path ?out_mode ?import_mode
             ?alloc_export ?free_export ?dealloc_export ?digest_prefix
             ?max_request_bytes ?max_response_bytes ?call_timeout_ms
    ORDER BY ?root_module LIMIT 1
---
{%- set h = host[0] -%}
{%- set memory_export = "memory" -%}
{%- if memory_rows | length > 0 %}{% set memory_export = memory_rows[0].v %}{% endif -%}
{%- set initialize_export = "" -%}
{%- if init_rows | length > 0 %}{% set initialize_export = init_rows[0].v %}{% endif -%}
{%- set manifest_rel = "" -%}
{%- if manifest_rows | length > 0 %}{% set manifest_rel = manifest_rows[0].v %}{% endif -%}
{%- set manifest_expand = "" -%}
{%- if manifest_expand_rows | length > 0 %}{% set manifest_expand = manifest_expand_rows[0].v %}{% endif -%}
{%- set algo_pairs = h.algo_csv | split(pat=";") -%}
{%- if h.out_mode != "out_len_through_pointer" and h.out_mode != "packed_u64" -%}
{{ UNSUPPORTED_host_out_mode_not_packed_u64_nor_out_len_through_pointer }}
{%- endif -%}
{%- if h.import_mode != "zero" and h.import_mode != "wasi_only" -%}
{{ UNSUPPORTED_host_import_mode_not_zero_nor_wasi_only }}
{%- endif -%}
# GENERATED by beam-wasmex-host-pack. Do not edit; edit the RDF host surface
# (urn:beam:wasmex:host:) and re-run the generator.
#
# Host-side receipt discipline: the digest THIS module computes over the
# artifact bytes and over request/response terms is the authoritative
# identity. Any digest computed inside the guest (e.g. an FNV self-check) is
# advisory only and is never trusted by this module.
#
# Grants no execution authority: {:ok, response} from call/4 is transport
# success, not a receipt of consequence. Downstream DO stays behind the
# consumer's own admission discipline.

defmodule {{ h.root_module }} do
  @moduledoc """
  GENERATED Wasmex host transport (default artifact:
  `{{ h.artifact_path }}`).

  ## Guest ABI contract (this module is its mirror image)

  * Exports: `{{ h.alloc_export }}(len) -> ptr`, `{{ h.free_export }}(ptr, len)`
    (output buffer), `{{ h.dealloc_export }}(ptr, len)` (input + out_len
    buffers), plus the exported linear memory `{{ memory_export }}`{%- if initialize_export != "" %} and the reactor init export `{{ initialize_export }}` (invoked once after instantiation){% endif %}.
  * Payload: UTF-8 JSON over linear memory — the host writes the request
    bytes, the guest writes the response bytes.
  * Return mode: `{{ h.out_mode }}`.
    {%- if h.out_mode == "out_len_through_pointer" %}
    `call_export(in_ptr, in_len, out_len_ptr) -> out_ptr`, with the real
    output length written back as a little-endian u32 through `out_len_ptr`.
    {%- else %}
    `call_export(in_ptr, in_len) -> packed`, one u64 holding
    `(out_ptr <<< 32) | out_len`.
    {%- endif %}
  * Imports: {{ h.import_mode }}{%- if h.import_mode == "zero" %} — the module imports NOTHING and admission refuses any artifact that does.{% else %} — only `wasi_snapshot_preview1` imports, judged against an allowlist; instantiation stubs are derived from the SAME list so allowlist and stubs cannot drift.{% endif %}

  ## Receipt identity

  `digest/1` computes the host-authoritative digest
  (`{{ h.digest_prefix }}` <> lowercase hex sha256 over canonicalized
  `term_to_binary`) used for the artifact pin, the request digest and the
  result digest in receipt maps. `start/2` fails closed on an unpinned
  digest (`:digest_unpinned`).

  ## Typed refusals

  `{:error, %{{ h.root_module }}.Refusal{}}` with code one of
  `:digest_unpinned`, `:digest_mismatch`, `:invalid_wasm`,
  `:import_surface_mismatch`, `:missing_export`, `:file_unreadable`,
  `:invalid_encoding`, `:resource_limit`, `:abi_failure`, `:call_trapped`,
  `:call_timeout`, `:invalid_json`, `:malformed_response`.
  """

  alias {{ h.root_module }}.Refusal

  defmodule Refusal do
    @moduledoc "Typed refusal carried by every rejected host operation."
    @enforce_keys [:code, :message]
    defstruct [:code, :message, details: %{}]

    @type t :: %__MODULE__{code: atom(), message: String.t(), details: map()}

    @spec new(atom(), String.t(), map()) :: t()
    def new(code, message, details \\ %{}),
      do: %__MODULE__{code: code, message: message, details: details}
  end

  @alloc_export "{{ h.alloc_export }}"
  @free_export "{{ h.free_export }}"
  @dealloc_export "{{ h.dealloc_export }}"
  @memory_export "{{ memory_export }}"
  @initialize_export {% if initialize_export != "" %}"{{ initialize_export }}"{% else %}nil{% endif %}
  @digest_prefix "{{ h.digest_prefix }}"
  @max_request_bytes {{ h.max_request_bytes }}
  @max_response_bytes {{ h.max_response_bytes }}
  @call_timeout_ms {{ h.call_timeout_ms }}
{%- if manifest_rel != "" %}

  @manifest_path Path.expand("{{ manifest_expand }}", __DIR__)
  @external_resource @manifest_path
  @manifest @manifest_path |> File.read!() |> Jason.decode!()

  @doc "The decoded host manifest (`{{ manifest_rel }}`)."
  @spec manifest() :: map()
  def manifest, do: @manifest

  @doc "Manifest-pinned artifact SHA-256 (hex) or `nil` when the manifest pins nothing."
  @spec manifest_sha256() :: String.t() | nil
  def manifest_sha256, do: get_in(@manifest, ["artifact", "sha256"])
{%- endif %}
{%- if h.import_mode == "wasi_only" %}

  @doc """
  Import allowlist as `{module, name, params, results}` tuples.
  Without a manifest this is `[]` — admission then refuses EVERY import
  (never allow-all).
  """
  @spec import_allowlist() :: [{String.t(), String.t(), [atom()], [atom()]}]
  def import_allowlist do
{%- if manifest_rel != "" %}
    @manifest
    |> get_in(["host_abi", "imports"])
    |> List.wrap()
    |> Enum.map(fn spec ->
      {spec["module"] || "", spec["name"] || "",
       Enum.map(spec["params"] || [], &String.to_atom/1),
       Enum.map(spec["results"] || [], &String.to_atom/1)}
    end)
{%- else %}
    []
{%- endif %}
  end
{%- endif %}

  @typedoc "A started Wasmex instance plus the artifact digest it was started from."
  @type instance :: %{
          pid: pid(),
          artifact_digest: String.t(),
          artifact_path: String.t()
        }

  @doc "Boots an instance from the artifact at `path` under the default digest pin."
  @spec start(String.t()) :: {:ok, instance()} | {:error, Refusal.t()}
  def start(path) when is_binary(path), do: start(path, [])

  @doc """
  Admits (digest pin -> compile -> import surface -> required exports) and
  boots the artifact at `path`.

  Options:

    * `:expected_sha256` — hex (optionally `#{@digest_prefix}`-prefixed) or
      the explicit atom `:unpinned`. Default order: this option, then
      Application env `:{{ h.otp_app }}, :wasm_digest_sha256`{%- if manifest_rel != "" %}, then the manifest pin{% endif %}; a `nil` pin is refused `:digest_unpinned`.
    * `:required_exports` — override list of export names.
    * `:import_allowlist` — override list of `{module, name, params, results}`.
  """
  @spec start(String.t(), keyword()) :: {:ok, instance()} | {:error, Refusal.t()}
  def start(path, opts) when is_binary(path) and is_list(opts) do
    with {:ok, bytes} <- read_bytes(path),
         {:ok, engine, module} <- admit(bytes, opts),
         {:ok, imports} <- instantiation_imports(module, opts),
         {:ok, store} <- Wasmex.Store.new(nil, engine),
         {:ok, pid} <- Wasmex.start_link(%{store: store, module: module, imports: imports}) do
{%- if initialize_export != "" %}
      with {:ok, _} <- Wasmex.call_function(pid, @initialize_export, [], @call_timeout_ms) do
        {:ok, %{pid: pid, artifact_digest: digest(bytes), artifact_path: path}}
      end
{%- else %}
      {:ok, %{pid: pid, artifact_digest: digest(bytes), artifact_path: path}}
{%- endif %}
    end
  end

  @doc """
  Digest-verification hook (host side). Computes
  `#{@digest_prefix}` <> lower-hex sha256 over `bytes` and judges it against
  `pin` (`:unpinned` always passes; `nil` refuses). Returns `:ok` or
  `{:error, %Refusal{code: :digest_mismatch | :digest_unpinned}}`.
  """
  @spec verify_digest(binary(), String.t() | :unpinned | nil) :: :ok | {:error, Refusal.t()}
  def verify_digest(_bytes, :unpinned), do: :ok

  def verify_digest(bytes, pin) when is_binary(pin) do
    actual = digest(bytes)
    expected = strip_prefix(pin)

    if expected == actual do
      :ok
    else
      {:error,
       Refusal.new(:digest_mismatch, "artifact digest does not match the pin", %{
         expected: pin,
         actual: actual
       })}
    end
  end

  def verify_digest(_bytes, nil) do
    {:error,
     Refusal.new(:digest_unpinned, "no artifact digest pin (opts, Application env, or manifest)", %{})}
  end

  @doc """
  Real call of export `export_name` with `request` (a plain map, JSON-encoded
  here) through the guest's ptr/len ABI. Returns `{:ok, response_map}` on a
  decoded JSON object, otherwise `{:error, %Refusal{}}`.

  Options: `:max_request_bytes` (default #{@max_request_bytes}),
  `:max_response_bytes` (default #{@max_response_bytes}, checked before the
  output is read), `:timeout` (ms, default #{@call_timeout_ms}).
  """
  @spec call(instance(), String.t(), map(), keyword()) ::
          {:ok, map()} | {:error, Refusal.t()}
  def call(%{pid: pid}, export_name, request, opts \\ []) when is_map(request) do
    guard(fn ->
      with {:ok, json} <- encode(request, opts),
           {:ok, store, memory} <- store_and_memory(pid) do
        with_buffer(pid, byte_size(json), fn in_ptr ->
          with :ok <- write(store, memory, in_ptr, json) do
{%- if h.out_mode == "out_len_through_pointer" %}
            with_buffer(pid, 4, fn out_len_ptr ->
              invoke_out_len_ptr(pid, store, memory, export_name, in_ptr, byte_size(json), out_len_ptr, opts)
            end)
{%- else %}
            invoke_packed(pid, store, memory, export_name, in_ptr, byte_size(json), opts)
{%- endif %}
          end
        end)
      end
    end)
  end

  @doc """
  Real replay check: re-invokes the paired replay export against the SAME
  request bytes; returns `{:ok, true | false}` for an exact `1`/`0` result,
  else `{:error, %Refusal{}}` (`:malformed_response` for any other result,
  `:call_trapped` when the export traps).
  """
  @spec replay(instance(), String.t(), map(), keyword()) ::
          {:ok, boolean()} | {:error, Refusal.t()}
  def replay(%{pid: pid}, replay_export_name, request, opts \\ []) when is_map(request) do
    guard(fn ->
      with {:ok, json} <- encode(request, opts),
           {:ok, store, memory} <- store_and_memory(pid) do
        with_buffer(pid, byte_size(json), fn in_ptr ->
          with :ok <- write(store, memory, in_ptr, json) do
            case Wasmex.call_function(pid, replay_export_name, [in_ptr, byte_size(json)], timeout(opts)) do
              {:ok, [0]} ->
                {:ok, false}

              {:ok, [1]} ->
                {:ok, true}

              {:ok, other} ->
                {:error,
                 Refusal.new(:malformed_response, "replay result must be exactly 0 or 1", %{
                   result: inspect(other)
                 })}

              {:error, reason} ->
                {:error,
                 Refusal.new(:call_trapped, "wasm replay trapped", %{
                   export: replay_export_name,
                   reason: inspect(reason)
                 })}
            end
          end
        end)
      end
    end)
  end

  @doc "Host-authoritative digest: `#{@digest_prefix}` <> lower-hex sha256 (binary passthrough, map/list terms canonicalized first)."
  @spec digest(term()) :: String.t()
  def digest(term) do
    binary =
      case term do
        t when is_binary(t) -> t
        t -> :erlang.term_to_binary(canonicalize(t))
      end

    @digest_prefix <> (:crypto.hash(:sha256, binary) |> Base.encode16(case: :lower))
  end

  @doc """
  One-pass call + replay + receipt for export pair `call_export` /
  `replay_export`. `replay_verified` reflects a genuinely recomputed second
  execution, not an asserted `true`.
  """
  @spec execute(instance(), String.t(), String.t(), map(), keyword()) ::
          {:ok, map(), map()} | {:error, Refusal.t()}
  def execute(instance, call_export, replay_export, request, opts \\ []) do
    with {:ok, response} <- call(instance, call_export, request, opts),
         {:ok, replayed?} <- replay(instance, replay_export, request, opts) do
      receipt = %{
        "wasm_export" => call_export,
        "replay_export" => replay_export,
        "artifact_digest" => instance.artifact_digest,
        "request_digest" => digest(request),
        "result_digest" => digest(response)
      }

      identity = %{observed: true, artifact_digest: instance.artifact_digest, replay_verified: replayed?}
      {:ok, response, %{receipt: receipt, identity: identity}}
    end
  end

  @doc "The per-algorithm export pairs this host surface binds (GENERATED from the RDF bindings)."
  @spec algo_specs() :: [
          %{algorithm_id: String.t(), call_export: String.t(), replay_export: String.t(), wrapper_module: String.t()}
        ]
  def algo_specs do
    [
{%- for pair in algo_pairs %}
      {%- set f = pair | split(pat="|") -%}
      {%- if f[0] != "" %}
      %{algorithm_id: "{{ f[0] }}", call_export: "{{ f[1] }}", replay_export: "{{ f[2] }}", wrapper_module: "{{ f[3] }}"}{%- if not loop.last %},{% endif %}
      {%- endif -%}
{%- endfor %}
    ]
  end

  # -- admission ---------------------------------------------------------

  defp read_bytes(path) do
    case File.read(path) do
      {:ok, bytes} ->
        {:ok, bytes}

      {:error, reason} ->
        {:error, Refusal.new(:file_unreadable, "artifact unreadable", %{path: path, reason: inspect(reason)})}
    end
  end

  defp admit(bytes, opts) do
    pin = pin_for(opts)

    with :ok <- verify_digest(bytes, pin),
         {:ok, engine} <- engine_new(),
         {:ok, store} <- Wasmex.Store.new(nil, engine),
         {:ok, module} <- module_compile(store, bytes),
         imports = Wasmex.Module.imports(module),
         :ok <- judge_imports(imports, opts),
         :ok <- judge_exports(module, opts) do
      {:ok, engine, module}
    end
  end

  defp pin_for(opts) do
    case Keyword.fetch(opts, :expected_sha256) do
      {:ok, pin} ->
        pin

      :error ->
        Application.get_env(:{{ h.otp_app }}, :wasm_digest_sha256){% if manifest_rel != "" %} || manifest_sha256(){% endif %}
    end
  end

  defp engine_new do
    case Wasmex.Engine.new(%Wasmex.EngineConfig{}) do
      {:ok, engine} ->
        {:ok, engine}

      {:error, reason} ->
        {:error, Refusal.new(:invalid_wasm, "wasm engine unavailable", %{reason: inspect(reason, limit: 5)})}
    end
  end

  defp module_compile(store, bytes) do
    case Wasmex.Module.compile(store, bytes) do
      {:ok, module} ->
        {:ok, module}

      {:error, reason} ->
        {:error,
         Refusal.new(:invalid_wasm, "artifact bytes did not compile as a WebAssembly module", %{
           reason: inspect(reason, limit: 5)
         })}
    end
  rescue
    error ->
      {:error,
       Refusal.new(:invalid_wasm, "artifact bytes did not compile as a WebAssembly module", %{
         reason: inspect(error, limit: 5)
       })}
  end

  defp judge_imports(imports, {% if h.import_mode == "zero" %}_{% endif %}opts) do
{%- if h.import_mode == "zero" %}
    case imports do
      m when m == %{} ->
        :ok

      other ->
        {:error,
         Refusal.new(:import_surface_mismatch, "zero-import artifact must import nothing", %{
           imports: inspect(other, limit: 5)
         })}
    end
{%- else %}
    allow = MapSet.new(allowlist_names(opts))

    offenders =
      for {ns, functions} <- imports,
          {name, type} <- functions,
          not MapSet.member?(allow, {to_string(ns), to_string(name), params_of(type), results_of(type)}) do
        "#{ns}.#{name}"
      end

    case offenders do
      [] ->
        :ok

      _ ->
        {:error,
         Refusal.new(:import_surface_mismatch, "imports outside the allowlist", %{
           unexpected: Enum.sort(offenders)
         })}
    end
{%- endif %}
  end

  # Instantiation imports are derived from the SAME surface admission judged,
  # so the judge and the stubs cannot drift.
  defp instantiation_imports(module, {% if h.import_mode == "zero" %}_{% endif %}opts) do
    imports = Wasmex.Module.imports(module)
{%- if h.import_mode == "zero" %}
    case imports do
      m when m == %{} ->
        {:ok, %{}}

      other ->
        {:error,
         Refusal.new(:import_surface_mismatch, "zero-import artifact must import nothing", %{
           imports: inspect(other, limit: 5)
         })}
    end
{%- else %}
    allow = Map.new(allowlist_names(opts), fn {ns, name, params, results} -> { {ns, name}, {params, results} } end)

    stubs =
      Enum.reduce(imports, %{}, fn {ns, functions}, acc ->
        ns_stubs =
          for {name, type} <- functions,
              spec = Map.get(allow, {to_string(ns), to_string(name)}),
              into: %{} do
            {params, results} = spec
            {to_string(name), {:fn, params, results, stub_body(length(params), zero_results(results))}}
          end

        case ns_stubs do
          empty when empty == %{} ->
            acc

          _ ->
            Map.put(acc, to_string(ns), ns_stubs)
        end
      end)

    {:ok, stubs}
{%- endif %}
  end
{%- if h.import_mode == "wasi_only" %}

  defp allowlist_names(opts) do
    case Keyword.get(opts, :import_allowlist) do
      nil ->
        import_allowlist()

      list when is_list(list) ->
        Enum.map(list, fn {ns, name, params, results} ->
          {to_string(ns), to_string(name), Enum.map(params, &wasmex_type_atom/1), Enum.map(results, &wasmex_type_atom/1)}
        end)
    end
  end

  defp params_of(type) do
    case type do
      %{params: params} -> Enum.map(params, &wasmex_type_atom/1)
      _ -> []
    end
  end

  defp results_of(type) do
    case type do
      %{results: results} -> Enum.map(results, &wasmex_type_atom/1)
      _ -> []
    end
  end

  defp wasmex_type_atom(:i32), do: :i32
  defp wasmex_type_atom(:i64), do: :i64
  defp wasmex_type_atom(:f32), do: :f32
  defp wasmex_type_atom(:f64), do: :f64

  defp zero_results([]), do: []
  defp zero_results([:i32 | _]), do: [0]
  defp zero_results([:i64 | _]), do: [0]
  defp zero_results([:f32 | _]), do: [0.0]
  defp zero_results([:f64 | _]), do: [0.0]

  # Admitted imports are bounded at 0-3 params, 0-1 results; a wider
  # signature must be added to the allowlist AND here.
  defp stub_body(0, ret), do: fn _ctx -> ret end
  defp stub_body(1, ret), do: fn _ctx, _a -> ret end
  defp stub_body(2, ret), do: fn _ctx, _a, _b -> ret end
  defp stub_body(3, ret), do: fn _ctx, _a, _b, _c -> ret end
{%- endif %}

  defp judge_exports(module, opts) do
    exports = Wasmex.Module.exports(module)

    required =
      Keyword.get_lazy(opts, :required_exports, fn ->
        [@memory_export, @alloc_export, @free_export, @dealloc_export]
        |> Enum.reject(&is_nil/1)
        |> Kernel.++(List.wrap(@initialize_export))
      end)

    missing = Enum.reject(required, &Map.has_key?(exports, &1))

    case missing do
      [] ->
        :ok

      _ ->
        {:error,
         Refusal.new(:missing_export, "artifact lacks required exports", %{
           missing: missing,
           required: required
         })}
    end
  end

  # -- transport internals ------------------------------------------------

  # A dead/overloaded Wasmex GenServer exits the caller; surface a refusal.
  defp guard(fun) do
    fun.()
  catch
    :exit, {:timeout, _} = reason ->
      {:error, Refusal.new(:call_timeout, "wasm call timed out", %{exit: inspect(reason)})}

    :exit, reason ->
      {:error, Refusal.new(:call_trapped, "wasm instance unavailable", %{exit: inspect(reason)})}
  end

  defp timeout(opts), do: Keyword.get(opts, :timeout, @call_timeout_ms)

  defp encode(request, opts) do
    max = Keyword.get(opts, :max_request_bytes, @max_request_bytes)

    case Jason.encode(request) do
      {:ok, json} when byte_size(json) > max ->
        {:error,
         Refusal.new(:resource_limit, "request exceeds max_request_bytes", %{
           limit: max,
           actual: byte_size(json)
         })}

      {:ok, json} ->
        {:ok, json}

      {:error, error} ->
        {:error,
         Refusal.new(:invalid_encoding, "request is not encodable as UTF-8 JSON", %{
           error: inspect(error)
         })}
    end
  rescue
    error ->
      {:error,
       Refusal.new(:invalid_encoding, "request is not encodable as UTF-8 JSON", %{
         error: inspect(error)
       })}
  end

  defp store_and_memory(pid) do
    with {:ok, store} <- Wasmex.store(pid),
         {:ok, memory} <- Wasmex.memory(pid) do
      {:ok, store, memory}
    else
      other ->
        {:error, Refusal.new(:abi_failure, "wasm store/memory unavailable", %{result: inspect(other)})}
    end
  end

  defp write(store, memory, ptr, bytes) do
    case Wasmex.Memory.write_binary(store, memory, ptr, bytes) do
      :ok ->
        :ok

      other ->
        {:error,
         Refusal.new(:abi_failure, "writing request into wasm memory failed", %{result: inspect(other)})}
    end
  rescue
    error ->
      {:error,
       Refusal.new(:abi_failure, "writing request into wasm memory failed", %{error: inspect(error)})}
  end

  defp read(store, memory, ptr, len) do
    case Wasmex.Memory.read_binary(store, memory, ptr, len) do
      bytes when is_binary(bytes) ->
        {:ok, bytes}

      other ->
        {:error, Refusal.new(:abi_failure, "reading wasm memory failed", %{result: inspect(other)})}
    end
  rescue
    error ->
      {:error, Refusal.new(:abi_failure, "reading wasm memory failed", %{error: inspect(error)})}
  end

  # Allocates `len` bytes, runs `fun.(ptr)`, and ALWAYS deallocs (try/after) --
  # no leak when the export traps or the response is refused.
  defp with_buffer(pid, len, fun) do
    case alloc(pid, len) do
      {:ok, ptr} ->
        try do
          fun.(ptr)
        after
          safe_dealloc(pid, ptr, len)
        end

      {:error, _} = error ->
        error
    end
  end

  defp alloc(pid, len) do
    case Wasmex.call_function(pid, @alloc_export, [len]) do
      {:ok, [ptr]} when is_integer(ptr) and ptr >= 0 ->
        {:ok, ptr}

      other ->
        {:error,
         Refusal.new(:abi_failure, "{{ h.alloc_export }} failed", %{len: len, result: inspect(other)})}
    end
  end

  defp safe_dealloc(pid, ptr, len) do
    Wasmex.call_function(pid, @dealloc_export, [ptr, len])
    :ok
  catch
    :exit, _ -> :ok
  end

{%- if h.out_mode == "out_len_through_pointer" %}
  defp invoke_out_len_ptr(pid, store, memory, export_name, in_ptr, in_len, out_len_ptr, opts) do
    max_out = Keyword.get(opts, :max_response_bytes, @max_response_bytes)

    case Wasmex.call_function(pid, export_name, [in_ptr, in_len, out_len_ptr], timeout(opts)) do
      {:ok, [out_ptr]} when is_integer(out_ptr) ->
        with {:ok, <<out_len::little-unsigned-32>>} <- read(store, memory, out_len_ptr, 4) do
          result = read_response(store, memory, out_ptr, out_len, max_out)

          case {result, free_output(pid, out_ptr, out_len)} do
            {{ "{{" }}:ok, _} = ok, :ok} -> ok
            {{ "{{" }}:ok, _}, {:error, _} = free_error} -> free_error
            {error, _} -> error
          end
        else
          {:ok, other} ->
            {:error, Refusal.new(:abi_failure, "out_len buffer is not 4 bytes", %{result: inspect(other)})}

          {:error, _} = error ->
            error
        end

      {:ok, other} ->
        {:error,
         Refusal.new(:malformed_response, "export must return exactly one i32 pointer", %{
           result: inspect(other)
         })}

      {:error, reason} ->
        {:error,
         Refusal.new(:call_trapped, "wasm export trapped", %{
           export: export_name,
           reason: inspect(reason)
         })}
    end
  end
{%- else %}
  defp invoke_packed(pid, store, memory, export_name, in_ptr, in_len, opts) do
    max_out = Keyword.get(opts, :max_response_bytes, @max_response_bytes)

    case Wasmex.call_function(pid, export_name, [in_ptr, in_len], timeout(opts)) do
      {:ok, [packed]} when is_integer(packed) and packed >= 0 ->
        out_ptr = packed >>> 32
        out_len = packed &&& 0xFFFFFFFF
        result = read_response(store, memory, out_ptr, out_len, max_out)

        case {result, free_output(pid, out_ptr, out_len)} do
          {{ "{{" }}:ok, _} = ok, :ok} -> ok
          {{ "{{" }}:ok, _}, {:error, _} = free_error} -> free_error
          {error, _} -> error
        end

      {:ok, other} ->
        {:error,
         Refusal.new(:malformed_response, "export must return exactly one packed u64", %{
           result: inspect(other)
         })}

      {:error, reason} ->
        {:error,
         Refusal.new(:call_trapped, "wasm export trapped", %{
           export: export_name,
           reason: inspect(reason)
         })}
    end
  end
{%- endif %}

  defp free_output(_pid, _ptr, 0), do: :ok

  defp free_output(pid, ptr, len) do
    case Wasmex.call_function(pid, @free_export, [ptr, len]) do
      {:ok, _} ->
        :ok

      other ->
        {:error, Refusal.new(:abi_failure, "{{ h.free_export }} failed", %{result: inspect(other)})}
    end
  end

  defp read_response(_store, _memory, _ptr, len, max) when len > max do
    {:error,
     Refusal.new(:resource_limit, "response exceeds max_response_bytes", %{limit: max, actual: len})}
  end

  defp read_response(store, memory, ptr, len, _max) do
    with {:ok, bytes} <- read_output(store, memory, ptr, len) do
      decode_response(bytes)
    end
  end

  defp read_output(_store, _memory, _ptr, 0), do: {:ok, ""}
  defp read_output(store, memory, ptr, len), do: read(store, memory, ptr, len)

  defp decode_response(bytes) do
    if String.valid?(bytes) do
      case Jason.decode(bytes) do
        {:ok, map} when is_map(map) ->
          {:ok, map}

        {:ok, other} ->
          {:error, Refusal.new(:malformed_response, "response is not a JSON object", %{value: inspect(other)})}

        {:error, reason} ->
          {:error, Refusal.new(:invalid_json, "response is not valid JSON", %{reason: inspect(reason)})}
      end
    else
      {:error, Refusal.new(:invalid_encoding, "response is not valid UTF-8", %{})}
    end
  end

  defp strip_prefix(pin) do
    if String.starts_with?(pin, @digest_prefix) do
      String.slice(pin, String.length(@digest_prefix)..-1//1)
    else
      pin
    end
  end

  defp canonicalize(term) when is_struct(term), do: term |> Map.from_struct() |> canonicalize()

  defp canonicalize(map) when is_map(map) do
    map
    |> Enum.map(fn {k, v} -> {key_to_string(k), canonicalize(v)} end)
    |> Enum.sort_by(&elem(&1, 0))
  end

  defp canonicalize(list) when is_list(list), do: Enum.map(list, &canonicalize/1)
  defp canonicalize(other), do: other

  defp key_to_string(k) when is_atom(k) or is_binary(k) or is_number(k), do: to_string(k)
  defp key_to_string(k), do: inspect(k)
end
