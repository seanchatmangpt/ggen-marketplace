---
to: "{{ host[0].deps_target }}"
force: true
sparql:
  host: |
    PREFIX bwh: <urn:beam:wasmex:host:>
    SELECT ?otp_app ?wasmex_dep_spec ?deps_target WHERE {
      ?h a bwh:WasmexHostSurface ;
         bwh:otpApp ?otp_app ; bwh:depsTarget ?deps_target .
      OPTIONAL { ?h bwh:wasmexDepSpec ?wasmex_dep_spec }
    } ORDER BY ?otp_app LIMIT 1
---
{%- set h = host[0] -%}
# GENERATED by beam-wasmex-host-pack -- mix.exs `defp deps do [...]` snippet.
# Merge into the consumer's deps list; both deps are REQUIRED by the generated
# host module (Wasmex store/instance/memory/call_function; Jason encode/decode).
#
# Pin provenance: ex4pm pins {:wasmex, "~> 0.14"} (~/ex4pm/mix.exs l.109); its
# lock resolves wasmex 0.15.1 (~/ex4pm/mix.lock l.81). ash_a2a's GraphLaw
# WasmexHost records runtime "wasmtime via wasmex ~> 0.15.1"
# (~/ash_a2a/priv/graphlaw/WASMEX_HOST_MANIFEST.json host.runtime).
{:wasmex, "{{ h.wasmex_dep_spec | default(value="~> 0.14") }}"},
{:jason, "~> 1.4"}
