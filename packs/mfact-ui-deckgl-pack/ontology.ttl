@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:project a pack:AdmittedProject ;
    rdfs:label "mfact-ui" ;
    pack:sourcePath "/Users/sac/mfact/web/mfact-ui"^^xsd:string ;
    pack:framework "React 19 + Vite (TypeScript/JSX)" ;
    pack:packageManager "npm (package.json, no lockfile inspected)" ;
    rdfs:comment "React SPA scanned for real deck.gl and shadcn/ui usage; no template was generated, this is a semantic-only admission." .

# --- deck.gl: real usage confirmed ---

pack:deckglUsage a pack:TechnologyFinding ;
    rdfs:label "deck.gl" ;
    pack:status "real-usage-confirmed" ;
    rdfs:comment "deck.gl and @deck.gl/layers ^8.9.36 are declared dependencies AND are actually imported and instantiated in src/SemanticGraph.tsx: DeckGL react component, OrthographicView, and four layer classes are composed into a live layers array with an explicit viewState." .

pack:DeckGLComponent a pack:DeckGLArtifact ;
    rdfs:label "DeckGL" ;
    pack:artifactKind "react-component-import" ;
    pack:filePath "src/SemanticGraph.tsx" ;
    rdfs:comment "Imported as `import DeckGL from '@deck.gl/react'` and rendered with initialViewState." .

pack:OrthographicViewUsage a pack:DeckGLArtifact ;
    rdfs:label "OrthographicView" ;
    pack:artifactKind "view-class" ;
    pack:filePath "src/SemanticGraph.tsx" ;
    rdfs:comment "Imported from @deck.gl/core, used as the view type for the deck.gl canvas." .

pack:PolygonLayerUsage a pack:DeckGLArtifact ;
    rdfs:label "PolygonLayer" ;
    pack:artifactKind "layer-class" ;
    pack:filePath "src/SemanticGraph.tsx" ;
    rdfs:comment "Instantiated with `new PolygonLayer({...})` inside the component's layer-building logic." .

pack:PathLayerUsage a pack:DeckGLArtifact ;
    rdfs:label "PathLayer" ;
    pack:artifactKind "layer-class" ;
    pack:filePath "src/SemanticGraph.tsx" ;
    rdfs:comment "Instantiated with `new PathLayer({...})` alongside the other layers." .

pack:PointCloudLayerUsage a pack:DeckGLArtifact ;
    rdfs:label "PointCloudLayer" ;
    pack:artifactKind "layer-class" ;
    pack:filePath "src/SemanticGraph.tsx" ;
    rdfs:comment "Instantiated with `new PointCloudLayer({...})`." .

pack:ScatterplotLayerUsage a pack:DeckGLArtifact ;
    rdfs:label "ScatterplotLayer" ;
    pack:artifactKind "layer-class" ;
    pack:filePath "src/SemanticGraph.tsx" ;
    rdfs:comment "Instantiated with `new ScatterplotLayer({...})`, completing the four-layer composition rendered by <DeckGL>." .

pack:AutonomicPlatformStub a pack:DeckGLArtifact ;
    rdfs:label "AutonomicPlatform.jsx deck.gl reference" ;
    pack:artifactKind "comment-only-reference" ;
    pack:filePath "src/wargames/AutonomicPlatform.jsx" ;
    rdfs:comment "Mentions 'deck.gl' only in prose comments describing a not-yet-ported globe renderer (GlobeCanvas). No deck.gl import or layer instantiation exists in this file; recorded as a non-usage site for completeness, not counted as a real artifact." .

# --- shadcn/ui: absent ---

pack:shadcnFinding a pack:TechnologyFinding ;
    rdfs:label "shadcn/ui" ;
    pack:status "absent" ;
    rdfs:comment "No shadcn/ui evidence found: package.json lists no radix-ui, class-variance-authority, or tailwind-merge dependency; no components.json exists at the project root; no components/ui directory exists under src/; no cn() helper or class-variance-authority import appears anywhere in .ts/.tsx/.jsx sources under src/. This project does not use shadcn/ui." .
