@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix gcp:  <https://seanchatmangpt.dev/ontology/gcp-marketplace#> .

<https://seanchatmangpt.dev/ontology/gcp-marketplace>
    a owl:Ontology ;
    rdfs:label "Google Cloud Marketplace SaaS Lifecycle Ontology" ;
    rdfs:comment "Formal vocabulary for GCP Marketplace Integrated SaaS listing, procurement, and committed cloud spend." .

gcp:MarketplaceProduct a rdfs:Class ;
    rdfs:label "GCP Marketplace Product" ;
    rdfs:comment "A SaaS listing available for purchase on Google Cloud Marketplace." .

gcp:EntitlementPlan a rdfs:Class ;
    rdfs:label "Entitlement Plan" ;
    rdfs:comment "Pricing or subscription tier (e.g. flat rate, tier, or private offer)." .

gcp:UsageMetric a rdfs:Class ;
    rdfs:label "Usage Metric" ;
    rdfs:comment "Service Control metric reported for consumption-based billing against cloud spend." .

gcp:ProcurementWebhook a rdfs:Class ;
    rdfs:label "Procurement Webhook" ;
    rdfs:comment "Cloud Pub/Sub subscription binding for lifecycle event ingest." .

gcp:productId a rdf:Property ;
    rdfs:domain gcp:MarketplaceProduct ;
    rdfs:range xsd:string .

gcp:eligibleForCommittedSpend a rdf:Property ;
    rdfs:domain gcp:MarketplaceProduct ;
    rdfs:range xsd:boolean .

gcp:planId a rdf:Property ;
    rdfs:domain gcp:EntitlementPlan ;
    rdfs:range xsd:string .

gcp:metricName a rdf:Property ;
    rdfs:domain gcp:UsageMetric ;
    rdfs:range xsd:string .

gcp:metricKind a rdf:Property ;
    rdfs:domain gcp:UsageMetric ;
    rdfs:range xsd:string .
