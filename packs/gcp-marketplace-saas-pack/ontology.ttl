@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix gcp:  <https://seanchatmangpt.dev/ontology/gcp-marketplace#> .

<https://seanchatmangpt.dev/ontology/gcp-marketplace>
    a owl:Ontology ;
    rdfs:label "Google Cloud Marketplace SaaS Lifecycle Ontology" ;
    rdfs:comment "Formal vocabulary for GCP Marketplace Integrated SaaS listing, procurement, and committed cloud spend." .

gcp:MarketplaceProduct a rdfs:Class ;
    rdfs:label "GCP Marketplace Product" ;
    rdfs:comment "A SaaS listing available for purchase on Google Cloud Marketplace." .

gcp:EntitlementPlan a rdfs:Class ;
    rdfs:label "Entitlement Plan" ;
    rdfs:comment "Pricing or subscription tier (e.g. flat rate, tier, or private offer)." .

gcp:UsageMetric a rdfs:Class ;
    rdfs:label "Usage Metric" ;
    rdfs:comment "Service Control metric reported for consumption-based billing against cloud spend." .

gcp:ProcurementWebhook a rdfs:Class ;
    rdfs:label "Procurement Webhook" ;
    rdfs:comment "Cloud Pub/Sub subscription binding for lifecycle event ingest." .

# --- Real-API-aligned classes (verified 2026-10-03) ---

gcp:EntitlementState a rdfs:Class ;
    rdfs:label "Entitlement State" ;
    rdfs:comment "Entitlement.State enum, Partner Procurement API discovery doc (8 values)." .

gcp:AccountState a rdfs:Class ;
    rdfs:label "Account State" ;
    rdfs:comment "Account.State enum, Partner Procurement API discovery doc (3 values; ACCOUNT_ACTIVATION_REQUESTED is documented as deprecated)." .

gcp:Account a rdfs:Class ;
    rdfs:label "Procurement Account" ;
    rdfs:comment "Account resource: name (accounts/{id}), provider, state, approvals, createTime, updateTime." .

gcp:Entitlement a rdfs:Class ;
    rdfs:label "Procurement Entitlement" ;
    rdfs:comment "Entitlement resource: name (providers/{p}/entitlements/{id}), provider, account, product, plan, offer, state, usageReportingId, messageToUser, createTime, updateTime." .

gcp:ProcurementEvent a rdfs:Class ;
    rdfs:label "Procurement Lifecycle Event" ;
    rdfs:comment "Pub/Sub notification eventType. Individuals carry the eventType -> resulting state edge of the documented transition table." .

gcp:UsageReport a rdfs:Class ;
    rdfs:label "Service Control Usage Report" ;
    rdfs:comment "services.report Operation: operationId, operationName, consumerId, startTime, endTime, metricValueSets." .

gcp:SignupToken a rdfs:Class ;
    rdfs:label "Marketplace Signup JWT" ;
    rdfs:comment "x-gcp-marketplace-token JWT; claims iss/sub/exp/aud structurally checked." .

gcp:CodegenConfig a rdfs:Class ;
    rdfs:label "Codegen Configuration" ;
    rdfs:comment "Pack-level individual binding the consumer-namespaced generated module name." .

# --- Properties (original 5 kept, new ones carry domain/range) ---

gcp:productId a rdf:Property ;
    rdfs:domain gcp:MarketplaceProduct ;
    rdfs:range xsd:string .

gcp:eligibleForCommittedSpend a rdf:Property ;
    rdfs:domain gcp:MarketplaceProduct ;
    rdfs:range xsd:boolean .

gcp:planId a rdf:Property ;
    rdfs:domain gcp:EntitlementPlan ;
    rdfs:range xsd:string .

gcp:metricName a rdf:Property ;
    rdfs:domain gcp:UsageMetric ;
    rdfs:range xsd:string .

gcp:metricKind a rdf:Property ;
    rdfs:domain gcp:UsageMetric ;
    rdfs:range xsd:string .

gcp:stateValue a rdf:Property ;
    rdfs:domain gcp:EntitlementState ;
    rdfs:range xsd:string .

gcp:accountStateValue a rdf:Property ;
    rdfs:domain gcp:AccountState ;
    rdfs:range xsd:string .

gcp:accountName a rdf:Property ;
    rdfs:domain gcp:Account ;
    rdfs:range xsd:string .

gcp:accountState a rdf:Property ;
    rdfs:domain gcp:Account ;
    rdfs:range xsd:string .

gcp:entitlementName a rdf:Property ;
    rdfs:domain gcp:Entitlement ;
    rdfs:range xsd:string .

gcp:entitlementState a rdf:Property ;
    rdfs:domain gcp:Entitlement ;
    rdfs:range gcp:EntitlementState .

gcp:entitlementPlan a rdf:Property ;
    rdfs:domain gcp:Entitlement ;
    rdfs:range xsd:string .

gcp:entitlementProduct a rdf:Property ;
    rdfs:domain gcp:Entitlement ;
    rdfs:range xsd:string .

gcp:entitlementProvider a rdf:Property ;
    rdfs:domain gcp:Entitlement ;
    rdfs:range xsd:string .

gcp:eventType a rdf:Property ;
    rdfs:domain gcp:ProcurementEvent ;
    rdfs:range xsd:string .

gcp:eventId a rdf:Property ;
    rdfs:domain gcp:ProcurementEvent ;
    rdfs:range xsd:string .

gcp:effectiveAt a rdf:Property ;
    rdfs:domain gcp:ProcurementEvent ;
    rdfs:range xsd:string .

gcp:resultingState a rdf:Property ;
    rdfs:domain gcp:ProcurementEvent ;
    rdfs:range gcp:EntitlementState .

gcp:operationId a rdf:Property ;
    rdfs:domain gcp:UsageReport ;
    rdfs:range xsd:string .

gcp:consumerId a rdf:Property ;
    rdfs:domain gcp:UsageReport ;
    rdfs:range xsd:string .

gcp:metricValueSets a rdf:Property ;
    rdfs:domain gcp:UsageReport ;
    rdfs:range xsd:string .

gcp:tokenIss a rdf:Property ;
    rdfs:domain gcp:SignupToken ;
    rdfs:range xsd:string .

gcp:tokenSub a rdf:Property ;
    rdfs:domain gcp:SignupToken ;
    rdfs:range xsd:string .

gcp:tokenExp a rdf:Property ;
    rdfs:domain gcp:SignupToken ;
    rdfs:range xsd:integer .

gcp:tokenAud a rdf:Property ;
    rdfs:domain gcp:SignupToken ;
    rdfs:range xsd:string .

gcp:moduleName a rdf:Property ;
    rdfs:domain gcp:CodegenConfig ;
    rdfs:range xsd:string .

# --- Enum individuals (discovery doc Entitlement.State / Account.State, verified 2026-10-03) ---

gcp:st_unspecified a gcp:EntitlementState ; gcp:stateValue "ENTITLEMENT_STATE_UNSPECIFIED" .
gcp:st_activation_requested a gcp:EntitlementState ; gcp:stateValue "ENTITLEMENT_ACTIVATION_REQUESTED" .
gcp:st_active a gcp:EntitlementState ; gcp:stateValue "ENTITLEMENT_ACTIVE" .
gcp:st_pending_cancellation a gcp:EntitlementState ; gcp:stateValue "ENTITLEMENT_PENDING_CANCELLATION" .
gcp:st_cancelled a gcp:EntitlementState ; gcp:stateValue "ENTITLEMENT_CANCELLED" .
gcp:st_pending_plan_change a gcp:EntitlementState ; gcp:stateValue "ENTITLEMENT_PENDING_PLAN_CHANGE" .
gcp:st_pending_plan_change_approval a gcp:EntitlementState ; gcp:stateValue "ENTITLEMENT_PENDING_PLAN_CHANGE_APPROVAL" .
gcp:st_suspended a gcp:EntitlementState ; gcp:stateValue "ENTITLEMENT_SUSPENDED" .

gcp:ac_unspecified a gcp:AccountState ; gcp:accountStateValue "ACCOUNT_STATE_UNSPECIFIED" .
gcp:ac_activation_requested a gcp:AccountState ; gcp:accountStateValue "ACCOUNT_ACTIVATION_REQUESTED" .
gcp:ac_active a gcp:AccountState ; gcp:accountStateValue "ACCOUNT_ACTIVE" .

# --- Transition-table individuals (manage-entitlements doc, verified 2026-10-03).
# Empty resultingState = event leaves current status unchanged (the event still
# advances the watermark). OFFER_ENDED / DELETED have no distinct status in the
# 8-value enum; RENEWED returns the entitlement to ACTIVE.

gcp:ev_creation_requested a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_CREATION_REQUESTED" ; gcp:resultingState gcp:st_activation_requested .
gcp:ev_offer_accepted a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_OFFER_ACCEPTED" ; gcp:resultingState gcp:st_activation_requested .
gcp:ev_active a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_ACTIVE" ; gcp:resultingState gcp:st_active .
gcp:ev_plan_change_requested a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_PLAN_CHANGE_REQUESTED" ; gcp:resultingState gcp:st_pending_plan_change_approval .
gcp:ev_plan_changed a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_PLAN_CHANGED" ; gcp:resultingState gcp:st_active .
gcp:ev_plan_change_cancelled a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_PLAN_CHANGE_CANCELLED" ; gcp:resultingState gcp:st_active .
gcp:ev_pending_cancellation a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_PENDING_CANCELLATION" ; gcp:resultingState gcp:st_pending_cancellation .
gcp:ev_cancelling a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_CANCELLING" ; gcp:resultingState gcp:st_pending_cancellation .
gcp:ev_cancellation_reverted a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_CANCELLATION_REVERTED" ; gcp:resultingState gcp:st_active .
gcp:ev_cancelled a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_CANCELLED" ; gcp:resultingState gcp:st_cancelled .
gcp:ev_renewed a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_RENEWED" ; gcp:resultingState gcp:st_active .
gcp:ev_offer_ended a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_OFFER_ENDED" ; gcp:resultingState "" .
gcp:ev_deleted a gcp:ProcurementEvent ; gcp:eventType "ENTITLEMENT_DELETED" ; gcp:resultingState "" .

gcp:codegen a gcp:CodegenConfig ;
    gcp:moduleName "MarketplaceSim.GcpMarketplace" .
