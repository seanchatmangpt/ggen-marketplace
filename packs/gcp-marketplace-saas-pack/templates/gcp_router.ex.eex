---
to: gcp_web_router.ex
mode: file
sparql:
  webcfg: |
    PREFIX gcp: <https://seanchatmangpt.dev/ontology/gcp-marketplace#>
    SELECT ?moduleName WHERE {
      ?c a gcp:CodegenConfig ; gcp:moduleName ?moduleName .
    } LIMIT 1
  webroutes: |
    PREFIX gcp: <https://seanchatmangpt.dev/ontology/gcp-marketplace#>
    SELECT ?routePath ?routeLiveModule ?routeOrder WHERE {
      ?r a gcp:WebRoute ;
         gcp:routePath ?routePath ;
         gcp:routeLiveModule ?routeLiveModule ;
         gcp:routeOrder ?routeOrder .
    } ORDER BY ?routeOrder
---
<%
  scalar = fn value ->
    cond do
      is_binary(value) and Regex.match?(~r/^"(?:\\.|[^"])*"$/, value) ->
        [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)
        body |> String.replace("\\\"", "\"") |> String.replace("\\\\", "\\")
      is_binary(value) and String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
        value |> String.trim_leading("<") |> String.trim_trailing(">")
      true -> value
    end
  end
  module_name = webcfg |> hd() |> Map.fetch!("moduleName") |> scalar.()
  routes = webroutes |> Enum.map(&{scalar.(&1["routePath"]), scalar.(&1["routeLiveModule"])}) |> Enum.sort()
%>
# GENERATED by ggen from gcp-marketplace-saas-pack. DO NOT HAND EDIT.
# Router scaffold (audit safe-list: router only, NOT LiveViews themselves).
# The route table is GENERATED from gcp:WebRoute individuals; the LiveView
# modules they name are consumer-owned placeholders (config values), never
# generated by this pack.
defmodule <%= module_name %>.Web.Router do
  @moduledoc false

  use Phoenix.Router
  import Phoenix.LiveView.Router

  pipeline :browser do
    plug(:accepts, ["html"])
    plug(:fetch_session)
    plug(:fetch_live_flash)
  end

  scope "/", <%= module_name %>.Web do
    pipe_through(:browser)

<%= for {path, live} <- routes do %>    live("<%= path %>", <%= live %>)
<% end %>  end
end
