---
to: gcp_web_endpoint.ex
mode: file
sparql:
  webcfg: |
    PREFIX gcp: <https://seanchatmangpt.dev/ontology/gcp-marketplace#>
    SELECT ?moduleName ?webOtpApp ?webSessionKey ?webSigningSalt WHERE {
      ?c a gcp:CodegenConfig ;
         gcp:moduleName ?moduleName ;
         gcp:webOtpApp ?webOtpApp ;
         gcp:webSessionKey ?webSessionKey ;
         gcp:webSigningSalt ?webSigningSalt .
    } LIMIT 1
---
<%
  scalar = fn value ->
    cond do
      is_binary(value) and Regex.match?(~r/^"(?:\\.|[^"])*"$/, value) ->
        [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)
        body |> String.replace("\\\"", "\"") |> String.replace("\\\\", "\\")
      is_binary(value) and String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
        value |> String.trim_leading("<") |> String.trim_trailing(">")
      true -> value
    end
  end
  row = webcfg |> hd()
  module_name = row |> Map.fetch!("moduleName") |> scalar.()
  otp_app = row |> Map.fetch!("webOtpApp") |> scalar.()
  session_key = row |> Map.fetch!("webSessionKey") |> scalar.()
  signing_salt = row |> Map.fetch!("webSigningSalt") |> scalar.()
%>
# GENERATED by ggen from gcp-marketplace-saas-pack. DO NOT HAND EDIT.
# Endpoint scaffold (audit safe-list: endpoint only, NOT LiveViews). Shape
# mirrors the marketplace-sim court's real endpoint
# (ash_pplan test/support/marketplace_sim/web/endpoint.ex): Phoenix.Endpoint
# with server: false by default, cookie session, Bandit adapter, error view.
defmodule <%= module_name %>.Web.Endpoint do
  @moduledoc """
  Consumer-namespaced Phoenix endpoint scaffold generated from the pack
  ontology (gcp-marketplace-saas-pack) via the gcp:CodegenConfig individual.
  """

  use Phoenix.Endpoint,
    otp_app: :<%= otp_app %>,
    secret_key_base: String.duplicate("a", 64),
    pubsub_server: <%= module_name %>.Web.PubSub,
    adapter: Bandit.PhoenixAdapter,
    render_errors: [view: <%= module_name %>.Web.ErrorView, accepts: ~w(html json)],
    live_view: [signing_salt: "<%= signing_salt %>"]

  plug(Plug.Session,
    store: :cookie,
    key: "<%= session_key %>",
    signing_salt: "<%= signing_salt %>"
  )

  plug(<%= module_name %>.Web.Router)
end
