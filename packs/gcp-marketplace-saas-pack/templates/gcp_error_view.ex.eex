---
to: gcp_web_error_view.ex
mode: file
sparql:
  webcfg: |
    PREFIX gcp: <https://seanchatmangpt.dev/ontology/gcp-marketplace#>
    SELECT ?moduleName WHERE {
      ?c a gcp:CodegenConfig ; gcp:moduleName ?moduleName .
    } LIMIT 1
---
<%
  scalar = fn value ->
    cond do
      is_binary(value) and Regex.match?(~r/^"(?:\\.|[^"])*"$/, value) ->
        [_, body] = Regex.run(~r/^"((?:\\.|[^"])*)"/, value)
        body |> String.replace("\\\"", "\"") |> String.replace("\\\\", "\\")
      is_binary(value) and String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
        value |> String.trim_leading("<") |> String.trim_trailing(">")
      true -> value
    end
  end
  module_name = webcfg |> hd() |> Map.fetch!("moduleName") |> scalar.()
%>
# GENERATED by ggen from gcp-marketplace-saas-pack. DO NOT HAND EDIT.
# ErrorView scaffold (audit safe-list: error_view only). Plain render/2
# clauses, exactly the shape the marketplace-sim court's real ErrorView uses.
defmodule <%= module_name %>.Web.ErrorView do
  @moduledoc false

  def render("500.html", _assigns), do: "Internal Server Error"
  def render("404.html", _assigns), do: "gcp marketplace scaffold: Not Found"
  def render(_, _assigns), do: "Error"
end
