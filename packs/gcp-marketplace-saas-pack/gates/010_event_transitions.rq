PREFIX gcp: <https://seanchatmangpt.dev/ontology/gcp-marketplace#>
SELECT DISTINCT ?eventType ?resultingState WHERE {
  ?e a gcp:ProcurementEvent ;
     gcp:eventType ?eventType ;
     gcp:resultingState ?rs .
  OPTIONAL { ?rs gcp:stateValue ?sv }
  BIND(COALESCE(?sv, "") AS ?resultingState)
}
ORDER BY ?eventType
