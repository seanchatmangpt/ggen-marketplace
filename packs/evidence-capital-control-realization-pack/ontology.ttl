@prefix eccr: <https://chatman.ai/ontology/evidence-capital-control-realization#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
eccr:Pack a eccr:MeasurementPack ; eccr:authority "OBSERVE|VERIFY" ; eccr:consequentialDo "BRCE_ONLY" .
eccr:Subject a eccr:SubjectClass .
eccr:ControlDecision a eccr:DecisionClass .
eccr:RealizationObservation a eccr:EvidenceClass .
eccr:Receipt a eccr:ReceiptClass .
eccr:subjectSha a eccr:IdentityProperty .
eccr:semanticDigest a eccr:IdentityProperty .
eccr:decisionId a eccr:IdentityProperty .
eccr:strategy a eccr:DecisionProperty .
eccr:predictedGain a eccr:MeasurementProperty .
eccr:realizedGain a eccr:MeasurementProperty .
eccr:baselineLoss a eccr:MeasurementProperty .
eccr:realizedLoss a eccr:MeasurementProperty .
eccr:acquisitionCost a eccr:MeasurementProperty .
eccr:latencyMs a eccr:MeasurementProperty .
eccr:alternativeObserved a eccr:EvidenceProperty .
eccr:counterfactualLoss a eccr:MeasurementProperty .
eccr:evidenceRoot a eccr:ProvenanceProperty .
eccr:methodology a eccr:StratumProperty .
eccr:engine a eccr:StratumProperty .
eccr:region a eccr:StratumProperty .
eccr:observedAt a eccr:TemporalProperty .
eccr:actuationPerformed a eccr:AuthorityProperty .
