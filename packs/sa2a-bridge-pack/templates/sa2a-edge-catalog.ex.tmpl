---
to: "lib/xaas/generated/sa2a_bridge_edges.ex"
skip_empty: false
sparql:
  results: |
    PREFIX s2b: <https://ggen.dev/ontology/sa2a-bridge#>
    SELECT ?sequence ?edgeName ?portOp ?fromPlane ?toPlane ?authority ?doBoundary ?receiptBefore ?receiptAfter ?replayable WHERE {
      ?edge a s2b:EdgeSpec ; s2b:sequence ?sequence ; s2b:edgeName ?edgeName ; s2b:portOp ?portOp ;
        s2b:fromPlane ?fromPlane ; s2b:toPlane ?toPlane ; s2b:authority ?authority ; s2b:doBoundary ?doBoundary ;
        s2b:receiptBefore ?receiptBefore ; s2b:receiptAfter ?receiptAfter ; s2b:replayable ?replayable .
    } ORDER BY ?sequence
---
# GENERATED by ggen-marketplace/sa2a-bridge-pack. Do not hand-edit.
defmodule Xaas.Sa2a.Generated.EdgeCatalog do
  @edges [
{% for row in results %}    %{sequence: {{ row["sequence"] }}, name: "{{ row["edgeName"] }}", port_op: "{{ row["portOp"] }}", from: "{{ row["fromPlane"] }}", to: "{{ row["toPlane"] }}", authority: "{{ row["authority"] }}", do_boundary?: {{ row["doBoundary"] }}, receipt_before?: {{ row["receiptBefore"] }}, receipt_after?: {{ row["receiptAfter"] }}, replayable?: {{ row["replayable"] }}},
{% endfor %}  ]

  def all, do: @edges
  def do_edges, do: Enum.filter(@edges, & &1.do_boundary?)
  def by_port_op(op), do: Enum.find(@edges, &(&1.port_op == op))
end
