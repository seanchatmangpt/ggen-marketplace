---
to: "priv/semantic/generated/sa2a_bridge_shacl.ttl"
skip_empty: false
for_each: results
sparql:
  results: |
    PREFIX s2b: <https://ggen.dev/ontology/sa2a-bridge#>
    SELECT ?protocol WHERE { s2b:bridge s2b:protocol ?protocol . }
---
# GENERATED by ggen-marketplace/sa2a-bridge-pack. Do not hand-edit.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix s2b: <https://ggen.dev/ontology/sa2a-bridge#> .

s2b:BridgeShape a sh:NodeShape ;
  sh:targetClass prov:Plan ;
  sh:property [ sh:path s2b:protocol ; sh:hasValue "{{ protocol }}" ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path s2b:zeroUnreceiptedActuation ; sh:hasValue true ; sh:minCount 1 ] ;
  sh:property [ sh:path s2b:outerTransactionOwnsExternalDo ; sh:hasValue false ; sh:minCount 1 ] ;
  sh:property [ sh:path s2b:ambientCommandPolicy ; sh:hasValue false ; sh:minCount 1 ] .

s2b:DoEdgeShape a sh:NodeShape ;
  sh:targetSubjectsOf s2b:doBoundary ;
  sh:or (
    [ sh:property [ sh:path s2b:doBoundary ; sh:hasValue false ] ]
    [ sh:and (
        [ sh:property [ sh:path s2b:authority ; sh:hasValue "PORT_DO_ONLY" ] ]
        [ sh:property [ sh:path s2b:receiptBefore ; sh:hasValue true ] ]
        [ sh:property [ sh:path s2b:receiptAfter ; sh:hasValue true ] ]
      ) ]
  ) .
