# MESSAGE: the sole port DO edge requires an explicit durable recovery proof path
PREFIX s2b: <https://ggen.dev/ontology/sa2a-bridge#>
SELECT ?edge WHERE {
  s2b:bridge a s2b:BridgeContract ; s2b:outerTransactionOwnsExternalDo false .
  ?edge a s2b:EdgeSpec ; s2b:doBoundary true .
  FILTER NOT EXISTS { ?edge s2b:recoveryRequired true . }
}
