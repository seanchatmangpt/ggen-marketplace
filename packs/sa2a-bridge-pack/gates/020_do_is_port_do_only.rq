PREFIX s2b: <https://ggen.dev/ontology/sa2a-bridge#>
SELECT ?edge ?authority ?before ?after WHERE {
  ?edge a s2b:EdgeSpec ; s2b:doBoundary true ; s2b:authority ?authority ; s2b:receiptBefore ?before ; s2b:receiptAfter ?after .
  FILTER (?authority != "PORT_DO_ONLY" || ?before != true || ?after != true)
}
