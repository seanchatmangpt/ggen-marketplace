# MESSAGE: exposedVia must be one of the closed vocabulary values -- mirrors elixir-mcp-a2a-pack's discipline
PREFIX ema: <http://seanchatmangpt.github.io/packs/elixir-mcp-a2a#>
SELECT ?cap ?exposedVia WHERE {
  ?cap a ema:Capability ; ema:exposedVia ?exposedVia .
  FILTER (?exposedVia != "mcp" && ?exposedVia != "a2a" && ?exposedVia != "both")
}
