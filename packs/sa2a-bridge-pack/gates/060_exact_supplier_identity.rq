# MESSAGE: bridge supplier and consumer base must be exact lowercase Git SHA-1 identities
PREFIX s2b: <https://ggen.dev/ontology/sa2a-bridge#>
SELECT ?sourceSha ?consumerBaseSha WHERE {
  s2b:bridge a s2b:BridgeContract ;
    s2b:sourceSha ?sourceSha ;
    s2b:consumerBaseSha ?consumerBaseSha .
  FILTER (
    !REGEX(STR(?sourceSha), "^[0-9a-f]{40}$") ||
    !REGEX(STR(?consumerBaseSha), "^[0-9a-f]{40}$")
  )
}
