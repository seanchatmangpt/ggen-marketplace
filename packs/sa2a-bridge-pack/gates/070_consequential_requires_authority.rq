# MESSAGE: a consequential capability must require authority (fail-closed) -- mirrors elixir-mcp-a2a-pack's gates/010_capability_descriptor_contract.rq
PREFIX ema: <http://seanchatmangpt.github.io/packs/elixir-mcp-a2a#>
SELECT ?cap WHERE {
  ?cap a ema:Capability ; ema:mutationScope "consequential" ; ema:requiresAuthority ?req .
  FILTER (?req != true)
}
