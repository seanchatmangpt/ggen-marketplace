@prefix cskill: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/collective-skill-court#> .
@prefix sjira: <urn:seanchatmangpt:sjira:v1#> .
@prefix sa2a: <https://spec.autofde.org/sa2a#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

cskill:SkillSource a skos:Concept ; skos:prefLabel "procedural skill source" .
cskill:Workflow a skos:Concept ; skos:prefLabel "admitted skill workflow" .
cskill:CourtFamily a skos:Concept ; skos:prefLabel "bounded executable court family" .
cskill:OracleProbe a skos:Concept ; skos:prefLabel "oracle probe" .
cskill:NoOpProbe a skos:Concept ; skos:prefLabel "no-op negative control" .
cskill:MutationProbe a skos:Concept ; skos:prefLabel "known-wrong mutation probe" .

cskill:contractV1
  a cskill:CourtFamily, prov:Entity ;
  dcterms:title "Collective Skill Court Contract v1" ;
  cskill:schema "collective-skill-court.v1" ;
  cskill:authorityCeiling "OBSERVE|SELECT|CONSTRUCT" ;
  cskill:grantsDoAuthority false ;
  cskill:requiresProbe cskill:OracleProbe, cskill:NoOpProbe, cskill:MutationProbe ;
  cskill:projectsWorkAs sjira:WorkOrder ;
  cskill:projectsCandidateAs sa2a:Candidate ;
  cskill:requiresSourceProvenance true ;
  cskill:requiresExactMarketplacePin true ;
  cskill:requiresExactSubjectPin true ;
  cskill:requiresReplayIdentity true ;
  cskill:requiresOraclePass true ;
  cskill:requiresNoOpFail true ;
  cskill:requiresMutationRejection true .
