{% for row in results %}{
  "schema": "{{ row.schema }}",
  "authority_ceiling": "{{ row.authority }}",
  "grants_do_authority": {{ row.do }},
  "projections": {
    "sjira_work_order": "{{ row.workOrder }}",
    "sa2a_candidate": "{{ row.candidate }}"
  },
  "requires": {
    "source_provenance": {{ row.sourceProvenance }},
    "exact_marketplace_pin": {{ row.marketplacePin }},
    "exact_subject_pin": {{ row.subjectPin }},
    "replay_identity": {{ row.replay }},
    "oracle_pass": {{ row.oracle }},
    "noop_fail": {{ row.noop }},
    "mutation_rejection": {{ row.mutation }}
  },
  "admission": "oracle_pass && noop_fail && mutation_rejection && !grants_do_authority"
}{% endfor %}
