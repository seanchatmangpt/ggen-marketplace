PREFIX cskill: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/collective-skill-court#>
SELECT ?schema ?authority ?do ?workOrder ?candidate
       ?sourceProvenance ?marketplacePin ?subjectPin ?replay
       ?oracle ?noop ?mutation
WHERE {
  cskill:contractV1
    cskill:schema ?schema ;
    cskill:authorityCeiling ?authority ;
    cskill:grantsDoAuthority ?do ;
    cskill:projectsWorkAs ?workOrder ;
    cskill:projectsCandidateAs ?candidate ;
    cskill:requiresSourceProvenance ?sourceProvenance ;
    cskill:requiresExactMarketplacePin ?marketplacePin ;
    cskill:requiresExactSubjectPin ?subjectPin ;
    cskill:requiresReplayIdentity ?replay ;
    cskill:requiresOraclePass ?oracle ;
    cskill:requiresNoOpFail ?noop ;
    cskill:requiresMutationRejection ?mutation .
}
