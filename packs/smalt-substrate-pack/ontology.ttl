@prefix smalt: <https://ggen.io/ontology/smalt#> .
@prefix aztf:  <https://ggen.io/ontology/azure-terraform#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# smalt-substrate-pack ontology
# Grounded in SMALT-PRD-ARD-CORE-v26.10.14
# Emulated hyperscaler service surface (wire-parity strings only).
#################################################################

smalt:Substrate a rdfs:Class ;
    rdfs:label "Sovereign Cloud Substrate" .

smalt:ControlPlane a rdfs:Class ;
    rdfs:label "ARM-style Control Plane REST Mux (Port 9443)" .

smalt:DataPlane a rdfs:Class ;
    rdfs:label "Data Plane Router (Port 8443)" .

smalt:MessagingBroker a rdfs:Class ;
    rdfs:label "AMQP 1.0 Broker (Port 5672)" .

# Tier 1: Cryptographic Trust, Key Custody & Consensus
smalt:KeyVaultManagedHsm   a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:ConfidentialLedger   a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:ManagedCcf           a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:AzureAttestation     a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .

# Tier 2: Isolated Compute, Enclaves & Runtimes
smalt:ConfidentialVm       a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .
smalt:ConfidentialGpuVm    a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .
smalt:ContainerAppWasi     a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .
smalt:AksEnclavePool       a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .

# Tier 3: Data Custody, Storage & Transaction Graph
smalt:ImmutableBlobStorage a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:CosmosNoSqlGraph     a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:PurviewGovernance    a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .

# Tier 4: Networking, Messaging & Governance
smalt:VNetPrivateDns       a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .
smalt:ServiceBusMessaging  a rdfs:Class ; rdfs:subClassOf smalt:MessagingBroker .
smalt:EventGridEventHubs   a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:SentinelLogAnalytics a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .

# Properties
smalt:port a rdf:Property .
smalt:resourceType a rdf:Property .
smalt:apiVersion a rdf:Property .
smalt:shape a rdf:Property .
smalt:location a rdf:Property .
smalt:vmSize a rdf:Property .
smalt:value a rdf:Property .
smalt:skuName a rdf:Property .
smalt:attestationHeader a rdf:Property .
smalt:optimisticLockHeader a rdf:Property .
smalt:immutableRetentionDays a rdf:Property .

# KD-78 api-version admission lattice (monotonic <= latest).
# Each smalt:TypeBinding's smalt:apiVersion is the lattice TOP for its type.
# Admission is the derived predicate smalt:admitsVersion: version V is admitted
# for type T iff base(V) as xsd:date <= T's smalt:apiVersion as xsd:date
# (base strips an optional "-preview" suffix). The lattice is therefore the
# half-open interval (-inf, latest] — no per-version enumeration is needed and
# none may be fabricated. smalt:admittedVersion rows (multi-valued, ordered by
# xsd:date) are OPTIONAL grounded witness points for historical versions; the
# admission rule never reads them.
smalt:admittedVersion a rdf:Property ;
    rdfs:comment "Ordered historical api-version witness for a TypeBinding (informational; admission is monotonic <= apiVersion)." .

smalt:admitsVersion a rdfs:Datatype ;
    rdfs:comment "Derived predicate, projected to Registry.admitted_version?/2: admitsVersion(T, V) iff versionBase(V) as xsd:date <= apiVersion(T) as xsd:date. Refusal class: InvalidApiVersionParameter naming T's latest." .

# Provider-listing projection properties (SHIM-COURT-adjacent: provider
# matrix is ontology-projected, never hand-supplemented). SHIM-COURT
smalt:providerNamespace a rdf:Property .
smalt:inventoryType a rdf:Property .
smalt:registrationState a rdf:Property .

# Provider-listing carrier: locations + registration state as ontology data.
smalt:ProviderInventory a rdfs:Class ;
    rdfs:label "azurerm provider-listing inventory (NOT Registry-admitted surface)" .

smalt:providerListing a smalt:ProviderInventory ;
    smalt:location "eastus" ;
    smalt:location "local" ;
    smalt:location "westus2" ;
    smalt:registrationState "Registered" .

# Inventory-only types azurerm probes on an empty subscription. Deliberately
# NOT typed smalt:ControlPlane: control_plane.rq must never admit them into
# Smalt.Registry. SHIM-COURT
smalt:providerInventory a smalt:ProviderInventory ;
    smalt:resourceType "Microsoft.Resources/subscriptions" ;
    smalt:resourceType "Microsoft.Resources/tenants" ;
    smalt:resourceType "Microsoft.Resources/locations" ;
    smalt:resourceType "Microsoft.ManagedIdentity/userAssignedIdentities" .

smalt:inv-sub a smalt:TypeBinding ;
    smalt:providerNamespace "Microsoft.Resources" ;
    smalt:resourceType "Microsoft.Resources/subscriptions" ;
    smalt:apiVersion "2022-12-01" ;
    smalt:inventoryType true .
smalt:inv-ten a smalt:TypeBinding ;
    smalt:providerNamespace "Microsoft.Resources" ;
    smalt:resourceType "Microsoft.Resources/tenants" ;
    smalt:apiVersion "2022-12-01" ;
    smalt:inventoryType true .
smalt:inv-loc a smalt:TypeBinding ;
    smalt:providerNamespace "Microsoft.Resources" ;
    smalt:resourceType "Microsoft.Resources/locations" ;
    smalt:apiVersion "2022-12-01" ;
    smalt:inventoryType true .
smalt:inv-uai a smalt:TypeBinding ;
    smalt:providerNamespace "Microsoft.ManagedIdentity" ;
    smalt:resourceType "Microsoft.ManagedIdentity/userAssignedIdentities" ;
    smalt:apiVersion "2023-01-31" ;
    smalt:inventoryType true .

