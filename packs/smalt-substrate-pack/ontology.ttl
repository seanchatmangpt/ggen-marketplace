    smalt:resourceType "Microsoft.Network/subnets" ;
    smalt:apiVersion "2021-04-01" ;
    smalt:shape smalt:SubnetShape .
smalt:tb-nsg a smalt:TypeBinding ;
    smalt:resourceType "Microsoft.Network/networkSecurityGroups" ;
