@prefix smalt: <https://ggen.io/ontology/smalt#> .
@prefix aztf:  <https://ggen.io/ontology/azure-terraform#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# smalt-substrate-pack ontology
# Grounded in SMALT-PRD-ARD-CORE-v26.10.14
# Emulated hyperscaler service surface (wire-parity strings only).
#################################################################

smalt:Substrate a rdfs:Class ;
    rdfs:label "Sovereign Cloud Substrate" .

smalt:ControlPlane a rdfs:Class ;
    rdfs:label "ARM-style Control Plane REST Mux (Port 9443)" .

smalt:DataPlane a rdfs:Class ;
    rdfs:label "Data Plane Router (Port 8443)" .

smalt:MessagingBroker a rdfs:Class ;
    rdfs:label "AMQP 1.0 Broker (Port 5672)" .

# Tier 1: Cryptographic Trust, Key Custody & Consensus
smalt:KeyVaultManagedHsm   a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:ConfidentialLedger   a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:ManagedCcf           a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:AzureAttestation     a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .

# Tier 2: Isolated Compute, Enclaves & Runtimes
smalt:ConfidentialVm       a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .
smalt:ConfidentialGpuVm    a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .
smalt:ContainerAppWasi     a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .
smalt:AksEnclavePool       a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .

# Tier 3: Data Custody, Storage & Transaction Graph
smalt:ImmutableBlobStorage a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:CosmosNoSqlGraph     a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:PurviewGovernance    a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .

# Tier 4: Networking, Messaging & Governance
smalt:VNetPrivateDns       a rdfs:Class ; rdfs:subClassOf smalt:ControlPlane .
smalt:ServiceBusMessaging  a rdfs:Class ; rdfs:subClassOf smalt:MessagingBroker .
smalt:EventGridEventHubs   a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .
smalt:SentinelLogAnalytics a rdfs:Class ; rdfs:subClassOf smalt:DataPlane .

# Properties
smalt:port a rdf:Property .
smalt:resourceType a rdf:Property .
smalt:apiVersion a rdf:Property .
smalt:shape a rdf:Property .
smalt:location a rdf:Property .
smalt:vmSize a rdf:Property .
smalt:skuName a rdf:Property .
smalt:attestationHeader a rdf:Property .
smalt:optimisticLockHeader a rdf:Property .
smalt:immutableRetentionDays a rdf:Property .

# Admitted ARM Resource Types (18 emulated service types)
smalt:ArmControlPlane a smalt:ControlPlane ;
    smalt:port 9443 ;
    smalt:resourceType "Microsoft.KeyVault/managedHSMs" ;
    smalt:resourceType "Microsoft.KeyVault/vaults" ;
    smalt:resourceType "Microsoft.ConfidentialLedger/ledgers" ;
    smalt:resourceType "Microsoft.ConfidentialLedger/managedCCFs" ;
    smalt:resourceType "Microsoft.Attestation/attestationProviders" ;
    smalt:resourceType "Microsoft.Compute/virtualMachines" ;
    smalt:resourceType "Microsoft.App/containerApps" ;
    smalt:resourceType "Microsoft.ContainerService/managedClusters" ;
    smalt:resourceType "Microsoft.Storage/storageAccounts" ;
    smalt:resourceType "Microsoft.DocumentDB/databaseAccounts" ;
    smalt:resourceType "Microsoft.Purview/accounts" ;
    smalt:resourceType "Microsoft.Network/virtualNetworks" ;
    smalt:resourceType "Microsoft.Network/privateDnsZones" ;
    smalt:resourceType "Microsoft.ServiceBus/namespaces" ;
    smalt:resourceType "Microsoft.EventGrid/topics" ;
    smalt:resourceType "Microsoft.EventHub/namespaces" ;
    smalt:resourceType "Microsoft.OperationalInsights/workspaces" ;
    smalt:resourceType "Microsoft.SecurityInsights/onboardingStates" ;
    smalt:resourceType "Microsoft.Resources/resourceGroups" .

# Terraform-route child/action types (azurerm 4.54.0 / azapi 2.4.0 surface)
smalt:armChildControlPlane a smalt:ControlPlane ;
    smalt:port 9443 ;
    smalt:resourceType "Microsoft.Network/subnets" ;
    smalt:resourceType "Microsoft.Network/networkSecurityGroups" ;
    smalt:resourceType "Microsoft.Network/networkInterfaces" ;
    smalt:resourceType "Microsoft.Network/privateEndpoints" ;
    smalt:resourceType "Microsoft.Network/privateDnsZones/virtualNetworkLinks" ;
    smalt:resourceType "Microsoft.Compute/disks" ;
    smalt:resourceType "Microsoft.Compute/diskEncryptionSets" ;
    smalt:resourceType "Microsoft.KeyVault/vaults/keys" ;
    smalt:resourceType "Microsoft.Storage/storageAccounts/blobServices" ;
    smalt:resourceType "Microsoft.Storage/storageAccounts/blobServices/containers" ;
    smalt:resourceType "Microsoft.Storage/storageAccounts/blobServices/containers/immutabilityPolicies" ;
    smalt:resourceType "Microsoft.Authorization/roleAssignments" ;
    smalt:resourceType "Microsoft.Insights/diagnosticSettings" ;
    smalt:resourceType "Microsoft.DevTestLab/schedules" ;
    smalt:resourceType "Microsoft.ServiceBus/namespaces/queues" ;
    smalt:resourceType "Microsoft.ServiceBus/namespaces/topics" ;
    smalt:resourceType "Microsoft.ServiceBus/namespaces/topics/subscriptions" ;
    smalt:resourceType "Microsoft.EventHub/namespaces/eventhubs" ;
    smalt:resourceType "Microsoft.EventHub/namespaces/eventhubs/consumergroups" .

# Per-type bindings: api-version + shape (consumed by payload_rules.rq)
