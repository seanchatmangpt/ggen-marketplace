#################################################################
# Cascade teardown vocabulary (SMALT-PRD cascade-walk work order).
# Grounded census (FR-6 / D127 verification, smalt lib 2026-10-16):
#   - control plane: lowercased ARM id prefix in :smalt_resources /
#     :smalt_resource_groups ("arm-id-prefix")
#   - blob trio + blocks/snapshots: "acct/..." and "acct/container/..."
#     ("acct-container") — BlobStorage.drop_account_data/1
#   - cosmos: "db/coll/doc" docs, "db/coll" pk-meta, plus lsn/ru counters
#     ("db-coll-doc") — Smalt.Cosmos doc_key/3, container_key/2
#   - service bus: {queue, seq} / {queue, sid} TUPLES, queue row = binary
#     name, counter {queue, :seq} ("sb-queue-tuple") — QueueStore
#   - event hubs: "ns/hub/partition" and checkpoint rows under "ns/hub/"
#     ("ns-hub") — Smalt.Messaging.EventHubs
#   - ledger: "ledger/tx_id" transactions + {:latest|:seq|:dup, ledger}
#     tuple meta ("ledger-tx") — LedgerWriter
#   - vault: name binaries + {name, version} tuples + deleted-soft rows
#     ("vault-name-tuple") — KeyVaultActions
#   - everything else: control-plane row only ("arm-id-prefix")
# smalt:contains is the graph edge the sweep walks (recursive), replacing
# the hand-written per-service drop_* dispatch.
#################################################################

smalt:contains a rdf:Property ;
    rdfs:label "ARM containment (parent TypeBinding contains child)" ;
    rdfs:comment "Recursive walk edge: a teardown of the parent must sweep every transitive child's data-plane rows." .

smalt:dataPlaneTable a rdf:Property ;
    rdfs:label "ETS table holding this type's data-plane rows" ;
    rdfs:comment "Repeatable: a type may fan rows across several tables." .

smalt:dataPlaneKeyPrefix a rdf:Property ;
    rdfs:label "Binary key prefix scoping this type's rows" ;
    rdfs:comment "Only meaningful for binary-keyed tables; tuple-keyed tables declare keyStyle instead." .

smalt:keyStyle a rdf:Property ;
    rdfs:label "Key convention class" ;
    rdfs:comment "One of: arm-id-prefix | acct-container | db-coll-doc | sb-queue-tuple | ns-hub | ledger-tx | vault-name-tuple | topic-stream | singleton." .

# --- containment edges (ARM resource model, parent -> child) -------------
smalt:tb-rg       smalt:contains smalt:tb-vnet, smalt:tb-nsg, smalt:tb-nic,
    smalt:tb-pep, smalt:tb-pdz, smalt:tb-pdzl, smalt:tb-vm, smalt:tb-disk,
    smalt:tb-des, smalt:tb-kv, smalt:tb-mhsm, smalt:tb-sa, smalt:tb-cosmos,
    smalt:tb-sb, smalt:tb-eg, smalt:tb-eh, smalt:tb-oi, smalt:tb-si,
    smalt:tb-cl, smalt:tb-ccf, smalt:tb-att, smalt:tb-purview, smalt:tb-ca,
    smalt:tb-aks, smalt:tb-ra, smalt:tb-ds, smalt:tb-dtl .
smalt:tb-vnet     smalt:contains smalt:tb-subnet .
smalt:tb-kv       smalt:contains smalt:tb-kvk, smalt:tb-kvs .
smalt:tb-sa       smalt:contains smalt:tb-blobsvc .
smalt:tb-blobsvc  smalt:contains smalt:tb-container .
smalt:tb-container smalt:contains smalt:tb-immo .
smalt:tb-cosmos   smalt:contains smalt:tb-sqldb .
smalt:tb-sqldb    smalt:contains smalt:tb-sqlc .
smalt:tb-sb       smalt:contains smalt:tb-sbq, smalt:tb-sbt .
smalt:tb-sbt      smalt:contains smalt:tb-sbs .
smalt:tb-eh       smalt:contains smalt:tb-ehh .
smalt:tb-ehh      smalt:contains smalt:tb-ehc .


# --- per-type data-plane table + key annotations (sweep-group nodes; RDF
