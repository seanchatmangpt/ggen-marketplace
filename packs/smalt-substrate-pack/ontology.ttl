# -- OCEL closed event-type vocabulary (lane 431) --
# Projected to lib/smalt/ocel/event_registry.ex via queries/event_types.rq +
# templates/event_registry.ex.eex (`mix smalt.gen`). spc.drift covers the
# SPC 1-sigma drift emitter (scripts/spc_gate.py verdicts -> CloudEvents row
# in :smalt_event_messages via Smalt.Spc.Drift).
smalt:et-arm a smalt:OcelEventType ; smalt:name "arm.resource.transition" .
smalt:et-cosmos a smalt:OcelEventType ; smalt:name "cosmos.doc.crud" .
smalt:et-blob a smalt:OcelEventType ; smalt:name "blob.custody.transition" .
smalt:et-amqp a smalt:OcelEventType ; smalt:name "amqp.delivery.settled" .
smalt:et-skr a smalt:OcelEventType ; smalt:name "skr.release" .
smalt:et-ledger a smalt:OcelEventType ; smalt:name "ledger.append" .
smalt:et-spc a smalt:OcelEventType ; smalt:name "spc.drift" .

#################################################################
# OCEL 2.0 event vocabulary (closed) — the projection source for
# lib/smalt/ocel/event_registry.ex via `mix smalt.gen`. Adding a row
# here is the ONLY lawful way to add an event type; the registry gate
# (log-and-drop) refuses everything not projected from this graph.
#################################################################

smalt:OcelEventType a rdfs:Class ;
    rdfs:label "Closed OCEL 2.0 event type" .

smalt:OcelObjectType a rdfs:Class ;
    rdfs:label "Closed OCEL 2.0 object type" .

smalt:et-enclave-stage a smalt:OcelEventType ;
    smalt:name "enclave.lifecycle.stage" .
smalt:et-doctor-receipt a smalt:OcelEventType ;
    smalt:name "doctor.receipt" .
smalt:et-court-run a smalt:OcelEventType ;
    smalt:name "court.run" .
smalt:et-affidavit-seal a smalt:OcelEventType ;
    smalt:name "affidavit.seal" .

smalt:ocel-ot-resource a smalt:OcelObjectType ; smalt:name "resource" .
smalt:ocel-ot-partition a smalt:OcelObjectType ; smalt:name "partition" .
smalt:ocel-ot-document a smalt:OcelObjectType ; smalt:name "document" .
smalt:ocel-ot-blob a smalt:OcelObjectType ; smalt:name "blob" .
smalt:ocel-ot-queue a smalt:OcelObjectType ; smalt:name "queue" .
smalt:ocel-ot-session a smalt:OcelObjectType ; smalt:name "session" .
smalt:ocel-ot-message a smalt:OcelObjectType ; smalt:name "message" .
smalt:ocel-ot-skr a smalt:OcelObjectType ; smalt:name "skr" .
smalt:ocel-ot-spc a smalt:OcelObjectType ; smalt:name "spc-metric" .
smalt:ocel-ot-ledger a smalt:OcelObjectType ; smalt:name "ledger" .
smalt:ocel-ot-enclave a smalt:OcelObjectType ; smalt:name "enclave" .
smalt:ocel-ot-fixture a smalt:OcelObjectType ; smalt:name "fixture" .

#################################################################
# Store table registry (W1b, recipe step 1): every ETS table atom the
# substrate references, owned or shadow. OWNED rows = the 33 tables
# Smalt.Store creates in init/1 (mirrors the pre-projection @tables).
# SHADOW rows = :smalt_* atoms referenced in lib/ but created lazily by
# their owner modules (sweepStrategy=none); typing them here closes the
# swept-but-unowned bug class (:smalt_blob_blocks, E2 census).
# Projection: queries/store_tables.rq -> templates/store_tables.ex.eex
# -> lib/smalt/store_tables.ex. Fence: verify/store-shadow-tables.unbound.rq
# + test/store_tables_replay_identity_test.exs (lib/ grep coverage).
# W2a correction (2026-10-17): 10 rows classified sweepStrategy="cascade"
# had NO teardown sweep site in lib/ (grep census: smalt_cosmos_docs,
# smalt_vault_keys, smalt_ledger_transactions, smalt_event_messages,
# smalt_sb_queues, smalt_eh_partitions, smalt_eh_checkpoints,
# smalt_sentinel_streams, smalt_purview_entities, smalt_purview_edges).
# Reclassified to "retention" (owner/sweeper lifecycle) — the cascade
# class now means EXACTLY "a smalt:CascadeEdge teardown walk exists",
# enforced by verify/cascade-coverage.unbound.rq arm B. Owned/shadow/
# metadata/persisted lists unchanged (still 33 owned).
#################################################################

smalt:StoreTable a rdfs:Class ;
    rdfs:label "Store ETS table" ;
    rdfs:comment "One row per ETS table atom referenced anywhere in lib/. Owned rows are created by Smalt.Store init/1; shadow rows are lazily created by their ownerModule." .

smalt:tableName a rdf:Property .
smalt:keyShape a rdf:Property ;
    rdfs:comment "armId | binaryPrefix | tuple | atom | integer (doc-level key contract)." .
smalt:ownerModule a rdf:Property .
smalt:sweepStrategy a rdf:Property ;
    rdfs:comment "cascade (cascade teardown sweep) | retention (sweeper passes) | metadata (survives destroy residue check) | none (shadow, owner-managed)." .
smalt:metadataOnly a rdf:Property ;
    rdfs:comment "true = in Smalt.Enclave.State @metadata_tables (survives destroy residue check)." .
smalt:persisted a rdf:Property ;
    rdfs:comment "true = in Smalt.Store.DetsMirror @default_tables (survives restart)." .
smalt:orderedSet a rdf:Property .

# ---- OWNED: the 33 Smalt.Store tables --------------------------------------
smalt:st-smalt_subscriptions a smalt:StoreTable ; smalt:tableName "smalt_subscriptions" ; smalt:keyShape "armId" ; smalt:ownerModule "Smalt.Store" ; smalt:sweepStrategy "metadata" ; smalt:metadataOnly true ; smalt:persisted false ; smalt:orderedSet true .
