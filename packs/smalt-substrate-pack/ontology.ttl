#################################################################
# CascadeEdge census (W2a, 2026-10-17). Grounded by the E2 live-code
# census of every capture-then-sweep edge the substrate actually walks:
#   - RG DELETE (arm_gateway/router.ex delete_rg): lowercased ARM id
#     prefix over :smalt_resources + :smalt_resource_groups, then
#     capture-then-sweep of storageAccount names -> BlobStorage
#     .drop_account_data (containers/blobs/policy/blocks/snapshots),
#     vault secret names -> VaultData.drop_vault_secrets, cosmos db/coll
#     names -> Cosmos.drop_db/drop_container (pk_meta).
#   - storageAccount DELETE (router.ex ~4204): resources prefix sweep +
#     BlobStorage.drop_account_data + Metrics.drop.
#   - vault DELETE (router.ex ~4300): resources prefix sweep +
#     vault_secret_sweep + Metrics.drop.
#   - Cosmos drop_db/drop_container (data_plane/cosmos.ex ~413): tuple
#     sweep of :smalt_cosmos_pk_meta.
#   - Enclave.State.destroy: reverse-topological dispatch, then
#     Metrics.drop per deleted id.
# Properties: parentResource (ARM parent kind), childTable (MUST be a
# smalt:StoreTable individual — enforced by
# verify/cascade-coverage.unbound.rq), keyExtraction
# (regex-capture | prefix | tuple-exact | reverse-topological),
# sweepStrategy, ownerModule, captureRegex (required for
# keyExtraction=regex-capture edges).
# Projection: queries/cascade_edges.rq -> templates/cascade_edges.ex.eex
# -> lib/smalt/cascade_edges.ex. Fence: verify/cascade-coverage
# .unbound.rq + test/cascade_replay_identity_test.exs.
#################################################################

smalt:CascadeEdge a rdfs:Class ;
    rdfs:label "Capture-then-sweep teardown edge" ;
    rdfs:comment "One row per capture-then-sweep edge in the live teardown paths: deleting parentResource's row sweeps childTable under keyExtraction, owned by ownerModule." .

smalt:parentResource a rdf:Property ;
    rdfs:comment "ARM parent kind whose DELETE triggers the sweep: Microsoft.Network/resourceGroups | Microsoft.Storage/storageAccounts | Microsoft.KeyVault/vaults | Microsoft.DocumentDb databaseOrContainer | smalt:enclave-destroy." .

smalt:childTable a rdf:Property ;
    rdfs:comment "smalt:StoreTable individual swept by this edge (referential integrity enforced by verify/cascade-coverage.unbound.rq)." .

smalt:keyExtraction a rdf:Property ;
    rdfs:comment "regex-capture | prefix | tuple-exact | reverse-topological." .

smalt:captureRegex a rdf:Property ;
    rdfs:comment "Capture regex applied to the swept ARM key (required iff keyExtraction=regex-capture)." .

# ---- resourceGroup DELETE edges (Smalt.ArmGateway.Router) -------------------
smalt:ce-rg-resources a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Network/resourceGroups" ; smalt:childTable smalt:st-smalt_resources ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.ArmGateway.Router" .
smalt:ce-rg-resource-groups a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Network/resourceGroups" ; smalt:childTable smalt:st-smalt_resource_groups ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.ArmGateway.Router" .
smalt:ce-rg-blob-containers a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Network/resourceGroups" ; smalt:childTable smalt:st-smalt_blob_containers ; smalt:keyExtraction "regex-capture" ; smalt:captureRegex "storageaccounts/([^/]+)" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.BlobStorage" .
smalt:ce-rg-blobs a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Network/resourceGroups" ; smalt:childTable smalt:st-smalt_blobs ; smalt:keyExtraction "regex-capture" ; smalt:captureRegex "storageaccounts/([^/]+)" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.BlobStorage" .
smalt:ce-rg-blob-policy a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Network/resourceGroups" ; smalt:childTable smalt:st-smalt_blob_policy ; smalt:keyExtraction "regex-capture" ; smalt:captureRegex "storageaccounts/([^/]+)" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.BlobStorage" .
smalt:ce-rg-blob-blocks a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Network/resourceGroups" ; smalt:childTable smalt:st-smalt_blob_blocks ; smalt:keyExtraction "regex-capture" ; smalt:captureRegex "storageaccounts/([^/]+)" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.BlobStorage" .
smalt:ce-rg-blob-snapshots a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Network/resourceGroups" ; smalt:childTable smalt:st-smalt_blob_snapshots ; smalt:keyExtraction "regex-capture" ; smalt:captureRegex "storageaccounts/([^/]+)" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.BlobStorage" .
smalt:ce-rg-vault-secrets a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Network/resourceGroups" ; smalt:childTable smalt:st-smalt_vault_secrets ; smalt:keyExtraction "regex-capture" ; smalt:captureRegex "vaults/[^/]+/secrets/([^/]+)" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.VaultData" .
smalt:ce-rg-cosmos-pk-meta a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Network/resourceGroups" ; smalt:childTable smalt:st-smalt_cosmos_pk_meta ; smalt:keyExtraction "regex-capture" ; smalt:captureRegex "sqlDatabases/([^/]+)/sqlContainers/([^/]+)|sqlDatabases/([^/]+)" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.Cosmos" .
smalt:ce-rg-metrics a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Network/resourceGroups" ; smalt:childTable smalt:st-smalt_metrics ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.Metrics" .

# ---- storageAccount DELETE edges (router.ex ~4204) --------------------------
smalt:ce-sa-resources a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Storage/storageAccounts" ; smalt:childTable smalt:st-smalt_resources ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.ArmGateway.Router" .
smalt:ce-sa-blob-containers a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Storage/storageAccounts" ; smalt:childTable smalt:st-smalt_blob_containers ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.BlobStorage" .
smalt:ce-sa-blobs a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Storage/storageAccounts" ; smalt:childTable smalt:st-smalt_blobs ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.BlobStorage" .
smalt:ce-sa-blob-policy a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Storage/storageAccounts" ; smalt:childTable smalt:st-smalt_blob_policy ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.BlobStorage" .
smalt:ce-sa-blob-blocks a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Storage/storageAccounts" ; smalt:childTable smalt:st-smalt_blob_blocks ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.BlobStorage" .
smalt:ce-sa-blob-snapshots a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Storage/storageAccounts" ; smalt:childTable smalt:st-smalt_blob_snapshots ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.BlobStorage" .
smalt:ce-sa-metrics a smalt:CascadeEdge ; smalt:parentResource "Microsoft.Storage/storageAccounts" ; smalt:childTable smalt:st-smalt_metrics ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.Metrics" .

# ---- vault DELETE edges (router.ex ~4300) ----------------------------------
smalt:ce-vault-resources a smalt:CascadeEdge ; smalt:parentResource "Microsoft.KeyVault/vaults" ; smalt:childTable smalt:st-smalt_resources ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.ArmGateway.Router" .
smalt:ce-vault-vault-secrets a smalt:CascadeEdge ; smalt:parentResource "Microsoft.KeyVault/vaults" ; smalt:childTable smalt:st-smalt_vault_secrets ; smalt:keyExtraction "regex-capture" ; smalt:captureRegex "vaults/[^/]+/secrets/([^/]+)" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.VaultData" .
smalt:ce-vault-metrics a smalt:CascadeEdge ; smalt:parentResource "Microsoft.KeyVault/vaults" ; smalt:childTable smalt:st-smalt_metrics ; smalt:keyExtraction "prefix" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.Metrics" .

# ---- cosmos delete edges (data_plane/cosmos.ex drop_db/drop_container) -----
smalt:ce-cosmosdb-pk-meta a smalt:CascadeEdge ; smalt:parentResource "Microsoft.DocumentDb/sqlDatabases" ; smalt:childTable smalt:st-smalt_cosmos_pk_meta ; smalt:keyExtraction "tuple-exact" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.Cosmos" .
smalt:ce-cosmosc-pk-meta a smalt:CascadeEdge ; smalt:parentResource "Microsoft.DocumentDb/sqlContainers" ; smalt:childTable smalt:st-smalt_cosmos_pk_meta ; smalt:keyExtraction "tuple-exact" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.DataPlane.Cosmos" .

# ---- enclave destroy edge (Enclave.State.destroy reverse-topological) ------
smalt:ce-destroy-metrics a smalt:CascadeEdge ; smalt:parentResource "smalt:enclave-destroy" ; smalt:childTable smalt:st-smalt_metrics ; smalt:keyExtraction "reverse-topological" ; smalt:sweepStrategy "cascade" ; smalt:ownerModule "Smalt.Enclave.State" .

#################################################################
# ConfigKey census (W1a, 2026-10-17). Grounded by grep census of
# Application.get_env(:smalt, ...) across smalt lib/ (88 call sites,
# 46 distinct keys). Each smalt:ConfigKey row is the ONLY copy of a
# key's in-code default going forward: the template projects one
# zero-arity accessor per key into lib/smalt/config.ex (Smalt.Config)
# mirroring the call site's override semantics exactly via
# smalt:override (none | env-first | app-env-first). secret=true keys
# are read RAW by their accessors; call sites keep their existing
# case/wrap form (e.g. sas.ex account_key/0 returns {:ok, key}); the
# accessor mirrors the site, it does not re-wrap.
# Bijection gate: verify/config-bijection-full.unbound.rq (zero rows
# to pass). Coverage gate: gates/config_coverage.rq (>=1 row).
#################################################################

smalt:ConfigKey a rdfs:Class ;
    rdfs:label "Application env key (closed census)" .

smalt:name a rdf:Property .
smalt:secret a rdf:Property .
smalt:surface a rdf:Property .
smalt:envVarName a rdf:Property .
smalt:override a rdf:Property .
smalt:profileKey a rdf:Property ;
    rdfs:comment "Which named throttle profile dimension a profile-throttled ConfigKey resolves through (arm | cosmos). Consumed by templates/config.ex.eex profile-throttled bodies (KD-110 closure)." .
smalt:docsText a rdf:Property .
smalt:default a rdf:Property .
smalt:type a rdf:Property .

smalt:ck-affidavit-wasm-path a smalt:ConfigKey ;
    smalt:name "affidavit_wasm_path" ;
    smalt:type "path" ;
    smalt:default "priv/wasm/affidavit_wasm.wasm" ;
    smalt:secret false ;
    smalt:surface "affidavit" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Affidavit WASM module path served to enclave doctors." .
smalt:ck-affidavit-wasm-pin-path a smalt:ConfigKey ;
    smalt:name "affidavit_wasm_pin_path" ;
    smalt:type "path" ;
    smalt:default "priv/wasm/affidavit.sha256" ;
    smalt:secret false ;
    smalt:surface "affidavit" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "sha256 pin file for the affidavit WASM module." .
smalt:ck-amqp-port a smalt:ConfigKey ;
    smalt:name "amqp_port" ;
    smalt:type "integer" ;
    smalt:default "5672" ;
    smalt:secret false ;
    smalt:surface "messaging" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "AMQP Service Bus listener port (mode :sb)." .
smalt:ck-amqp-sweeper-lock-grace-ms a smalt:ConfigKey ;
    smalt:name "amqp_sweeper_lock_grace_ms" ;
    smalt:type "integer" ;
    smalt:default "30_000" ;
    smalt:secret false ;
    smalt:surface "messaging" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Grace window before a lock tombstone is dropped by the AMQP sweeper." .
smalt:ck-amqp-sweeper-tick-ms a smalt:ConfigKey ;
    smalt:name "amqp_sweeper_tick_ms" ;
    smalt:type "integer" ;
    smalt:default "250" ;
    smalt:secret false ;
    smalt:surface "messaging" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "AMQP sweeper tick period in milliseconds." .
smalt:ck-arm-port a smalt:ConfigKey ;
    smalt:name "arm_port" ;
    smalt:type "integer" ;
    smalt:default "9443" ;
    smalt:secret false ;
    smalt:surface "control_plane" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "ARM-style control plane REST port." .
smalt:ck-arm-rate-limit a smalt:ConfigKey ;
    smalt:name "arm_rate_limit" ;
    smalt:type "atom" ;
    smalt:default ":infinity" ;
    smalt:secret false ;
    smalt:surface "control_plane" ;
    smalt:envVarName "SMALT_ARM_RATE_LIMIT" ;
    smalt:override "profile-throttled" ;
    smalt:profileKey "arm" ;
    smalt:docsText "ARM gateway rate limit (:infinity disables the limiter). SMALT_ARM_RATE_LIMIT overrides BOTH the named throttle profile and the app env, parsed as an integer; otherwise profile defaults apply: :unbounded (default) :infinity, :azure_parity 20 req/s, :strict 5 req/s (SMALT_PROFILE)." .
smalt:ck-arm-tls-port a smalt:ConfigKey ;
    smalt:name "arm_tls_port" ;
    smalt:type "integer" ;
    smalt:default "9444" ;
    smalt:secret false ;
    smalt:surface "tls" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "TLS twin port for SDK legs that refuse Bearer over http." .
smalt:ck-auth-mode a smalt:ConfigKey ;
    smalt:name "auth_mode" ;
    smalt:type "atom" ;
    smalt:default ":enforce" ;
    smalt:secret false ;
    smalt:surface "auth" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Bearer auth mode: :enforce default, :anonymous test only." .
smalt:ck-bind-ip a smalt:ConfigKey ;
    smalt:name "bind_ip" ;
    smalt:type "string" ;
    smalt:default "nil" ;
    smalt:secret false ;
    smalt:surface "control_plane" ;
    smalt:envVarName "SMALT_BIND_IP" ;
    smalt:override "env-first" ;
    smalt:docsText "Listener bind IP; SMALT_BIND_IP overrides the app env." .
# ---- plane selection + plane profiles (AZB-04, lane planes) ----
# Port single-source law: the :arm_gateway/:cosmos/:amqp profiles carry NO
# port key; ports stay in the flat keys (:arm_port, :egress_port, and the
# :sb_endpoint URI) which the env profiles set directly.
smalt:ck-planes a smalt:ConfigKey ;
    smalt:name "planes" ;
    smalt:type "atom" ;
    smalt:default ":all" ;
    smalt:secret false ;
    smalt:surface "planes" ;
    smalt:envVarName "SMALT_PLANES" ;
    smalt:override "none" ;
    smalt:docsText "Plane selection: :all or list of :control/:data/:integration/:identity. SMALT_PLANES (comma list) is parsed + validated at runtime-config time (config/runtime.exs, Smalt.Planes); unknown name refuses boot with {:invalid_plane, name}. With :all no config/env profile is imported." .
smalt:ck-arm-gateway a smalt:ConfigKey ;
    smalt:name "arm_gateway" ;
    smalt:type "keyword-list" ;
    smalt:default "[]" ;
    smalt:secret false ;
    smalt:surface "planes" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Control-plane profile keyword list (e.g. strict_version_validation:). NO port key: the port is the flat key :arm_port." .
smalt:ck-cosmos a smalt:ConfigKey ;
    smalt:name "cosmos" ;
    smalt:type "keyword-list" ;
    smalt:default "[]" ;
    smalt:secret false ;
    smalt:surface "planes" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Data-plane Cosmos profile keyword list (endpoint:, max_ru_limit:). NO port key: the listener port is the flat key :egress_port." .
smalt:ck-blob-storage a smalt:ConfigKey ;
    smalt:name "blob_storage" ;
    smalt:type "keyword-list" ;
    smalt:default "[]" ;
    smalt:secret false ;
    smalt:surface "planes" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Data-plane Blob profile keyword list (persistence:, sync_interval_ms:). NO port key." .
smalt:ck-amqp a smalt:ConfigKey ;
    smalt:name "amqp" ;
    smalt:type "keyword-list" ;
    smalt:default "[]" ;
    smalt:secret false ;
    smalt:surface "planes" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Integration-plane AMQP profile keyword list (sasl_mechanisms:, max_frame_size:). NO port key: the endpoint+port is the flat key :sb_endpoint." .
smalt:ck-event-grid a smalt:ConfigKey ;
    smalt:name "event_grid" ;
    smalt:type "keyword-list" ;
    smalt:default "[]" ;
    smalt:secret false ;
    smalt:surface "planes" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Integration-plane Event Grid profile keyword list (delivery_mode:)." .
smalt:ck-keyvault a smalt:ConfigKey ;
    smalt:name "keyvault" ;
    smalt:type "keyword-list" ;
    smalt:default "[]" ;
    smalt:secret false ;
    smalt:surface "planes" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Identity-plane KeyVault profile keyword list (api_version:, challenge_mode:)." .
smalt:ck-sts a smalt:ConfigKey ;
    smalt:name "sts" ;
    smalt:type "keyword-list" ;
    smalt:default "[]" ;
    smalt:secret false ;
    smalt:surface "planes" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Identity-plane STS profile keyword list (token_ttl_seconds:, pki_envelope:)." .
smalt:ck-graph-law a smalt:ConfigKey ;
    smalt:name "graph_law" ;
    smalt:type "keyword-list" ;
    smalt:default "[]" ;
    smalt:secret false ;
    smalt:surface "planes" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Graphlaw enforcement profile keyword list (enforcement: :fail_closed). Distinct from the :graphlaw_engine handle." .
smalt:ck-blob-account-key a smalt:ConfigKey ;
    smalt:name "blob_account_key" ;
    smalt:type "string" ;
    smalt:default "nil" ;
    smalt:secret true ;
    smalt:surface "data_plane" ;
    smalt:envVarName "SMALT_BLOB_ACCOUNT_KEY" ;
    smalt:override "app-env-first" ;
    smalt:docsText "Blob SAS verification key; app env wins over SMALT_BLOB_ACCOUNT_KEY." .
smalt:ck-blob-catch-all-hosts a smalt:ConfigKey ;
    smalt:name "blob_catch_all_hosts" ;
    smalt:type "list" ;
    smalt:default "[]" ;
    smalt:secret false ;
    smalt:surface "data_plane" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Extra hosts routed to the blob catch-all egress rule." .
smalt:ck-cosmos-master-key a smalt:ConfigKey ;
    smalt:name "cosmos_master_key" ;
    smalt:type "string" ;
    smalt:default "nil" ;
    smalt:secret true ;
    smalt:surface "data_plane" ;
    smalt:envVarName "-" ;
    smalt:override "none" ;
    smalt:docsText "Cosmos emulator master key for enforce-mode authorization." .
smalt:ck-cosmos-ru-limit a smalt:ConfigKey ;
    smalt:name "cosmos_ru_limit" ;
    smalt:type "atom" ;
    smalt:default ":infinity" ;
    smalt:secret false ;
    smalt:surface "data_plane" ;
    smalt:envVarName "SMALT_COSMOS_RU_LIMIT" ;
    smalt:override "profile-throttled" ;
    smalt:profileKey "cosmos" ;
    smalt:docsText "Cosmos request-unit budget per query (:infinity disables budgeting). SMALT_COSMOS_RU_LIMIT overrides BOTH the named throttle profile and the app env, parsed as an integer; otherwise profile defaults apply: :unbounded (default) :infinity, :azure_parity 25 RU/s, :strict 5 RU/s (SMALT_PROFILE)." .
