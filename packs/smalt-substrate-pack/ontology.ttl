smalt:ck-profile a smalt:ConfigKey ;
    smalt:name "profile" ;
    smalt:type "atom" ;
    smalt:default ":unbounded" ;
    smalt:secret false ;
    smalt:surface "profile" ;
    smalt:envVarName "SMALT_PROFILE" ;
    smalt:override "profile-first" ;
    smalt:docsText "Named throttle profile: :unbounded (default; both limits :infinity, byte-identical to the pre-KD-110 default), :azure_parity (ARM 20 req/s, cosmos 25 RU/s - the witnessed Azure-comparable budgets), :strict (ARM 5, cosmos 5). Resolved env-first: SMALT_PROFILE overrides app env :profile; unknown names refuse with ArgumentError. Explicit SMALT_ARM_RATE_LIMIT / SMALT_COSMOS_RU_LIMIT beat profile defaults." .
smalt:ck-prod a smalt:ConfigKey ;
