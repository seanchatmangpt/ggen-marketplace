# Violation gate (FM-PACK-013): ZERO rows is the pass condition. Any row
# refuses the sync. Formerly positive-style ("MUST return >= 1 row"), which
# FM-PACK-013 scores inverted — healthy TypeBinding rows refused the sync
# (ZD-49 falsifier outcome; ZD-65 repair).
#
# Degenerate conditions asserted (coverage intent preserved, matching
# verify/shapes-coverage.unbound.rq's contract):
# 1. the TypeBinding census vanished from the graph entirely;
# 2. a TypeBinding missing resourceType OR apiVersion (cannot admit a
#    version or name a type);
# 3. a NON-inventory TypeBinding (no smalt:inventoryType true) missing a
#    smalt:shape — inventory-only bindings legitimately carry no shape.
# Healthy graph: 56 shaped + 4 inventory-only TypeBindings -> zero rows.
# Non-vacuity: fires on a mutated /tmp pack copy (witness in
# docs/jira/v26.11.3/receipts/zd-65-smalt-gates.md).
PREFIX smalt: <https://ggen.io/ontology/smalt#>

SELECT ?subject ?problem WHERE {
  {
    VALUES ?subject { smalt:type-binding-census }
    FILTER NOT EXISTS { ?b a smalt:TypeBinding }
    BIND("type-binding-census-empty" AS ?problem)
  }
  UNION
  {
    ?subject a smalt:TypeBinding .
    FILTER NOT EXISTS { ?subject smalt:resourceType ?rt }
    BIND("type-binding-missing-resourceType" AS ?problem)
  }
  UNION
  {
    ?subject a smalt:TypeBinding .
    FILTER NOT EXISTS { ?subject smalt:apiVersion ?av }
    BIND("type-binding-missing-apiVersion" AS ?problem)
  }
  UNION
  {
    ?subject a smalt:TypeBinding ;
             smalt:resourceType ?rt2 .
    FILTER NOT EXISTS { ?subject smalt:inventoryType true }
    FILTER NOT EXISTS { ?subject smalt:shape ?sh }
    BIND("shaped-binding-missing-shape" AS ?problem)
  }
}
ORDER BY ?subject ?problem
