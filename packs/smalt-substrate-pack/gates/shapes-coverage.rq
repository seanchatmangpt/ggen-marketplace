# Positive gate: MUST return >= 1 row. Every row is an admitted resourceType
# bound to a shape + apiVersion via a TypeBinding. Passes only when the
# ontology declares coverage; the inverted companion (verify/shapes-coverage.unbound.rq)
# proves the complement is empty.
PREFIX smalt: <https://ggen.io/ontology/smalt#>
SELECT ?resourceType WHERE {
  ?b a smalt:TypeBinding ;
     smalt:resourceType ?resourceType ;
     smalt:apiVersion ?av ;
     smalt:shape ?shape .
}
