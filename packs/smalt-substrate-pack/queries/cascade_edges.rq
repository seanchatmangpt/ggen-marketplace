# cascade_edges.rq — render-input projection for the cascade dispatch
# table (W2a). One row per smalt:CascadeEdge individual; childTable IRI
# resolved to its smalt:StoreTable tableName literal. The template
# re-sorts by (parentResource, tableName), so engine row order is not
# load-bearing for byte-identity (replay fence:
# test/cascade_replay_identity_test.exs).
PREFIX smalt: <https://ggen.io/ontology/smalt#>

SELECT ?parentResource ?tableName ?keyExtraction ?captureRegex ?sweepStrategy ?ownerModule
WHERE {
  ?ce a smalt:CascadeEdge ;
      smalt:parentResource ?parentResource ;
      smalt:childTable ?st ;
      smalt:keyExtraction ?keyExtraction ;
      smalt:sweepStrategy ?sweepStrategy ;
      smalt:ownerModule ?ownerModule .
  ?st smalt:tableName ?tableName .
  OPTIONAL { ?ce smalt:captureRegex ?captureRegex . }
}
ORDER BY ?parentResource ?tableName
