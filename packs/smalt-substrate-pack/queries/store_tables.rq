# store_tables.rq — render-input projection for the Store table registry.
# One row per smalt:StoreTable individual (owned + shadow). The template
# re-sorts by tableName, so engine row order is not load-bearing for
# byte-identity (replay fence: test/store_tables_replay_identity_test.exs).
PREFIX smalt: <https://ggen.io/ontology/smalt#>

SELECT ?tableName ?keyShape ?ownerModule ?sweepStrategy ?metadataOnly ?persisted ?orderedSet
WHERE {
  ?st a smalt:StoreTable ;
      smalt:tableName ?tableName ;
      smalt:keyShape ?keyShape ;
      smalt:ownerModule ?ownerModule ;
      smalt:sweepStrategy ?sweepStrategy ;
      smalt:metadataOnly ?metadataOnly ;
      smalt:persisted ?persisted ;
      smalt:orderedSet ?orderedSet .
}
ORDER BY ?tableName
