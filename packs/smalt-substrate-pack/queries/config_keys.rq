# ConfigKey projection: one row per application env key (closed census).
# Consumed by templates/config.ex.eex -> lib/smalt/config.ex.
PREFIX smalt: <https://ggen.io/ontology/smalt#>

SELECT ?name ?type ?default ?secret ?surface ?envVarName ?override ?docsText
WHERE {
  ?k a smalt:ConfigKey ;
     smalt:name ?name ;
     smalt:type ?type ;
     smalt:default ?default ;
     smalt:secret ?secret ;
     smalt:surface ?surface ;
     smalt:envVarName ?envVarName ;
     smalt:override ?override ;
     smalt:docsText ?docsText .
}
ORDER BY ?name
