# Defaults projection: resource type -> JSON path -> default value.
# Runs over ontology.ttl + shapes/smalt-shapes.ttl (merged graph — the
# shape-coverage TypeBindings live in ontology.ttl, the smalt:default
# annotations in shapes/smalt-shapes.ttl).
PREFIX smalt: <https://ggen.io/ontology/smalt#>

SELECT ?resourceType ?jsonPath ?value ?type
WHERE {
  ?tb a smalt:TypeBinding ;
      smalt:resourceType ?resourceType ;
      smalt:shape ?shape .
  ?shape smalt:default ?d .
  ?d smalt:jsonPath ?jsonPath ;
     smalt:value ?value ;
     smalt:type ?type .
}
ORDER BY ?resourceType ?jsonPath
