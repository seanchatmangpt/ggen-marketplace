# Inverted gate: MUST return zero rows. Any declared smalt:resourceType
# lacking a TypeBinding with apiVersion + shape fails admission coverage.
# (OPTIONAL/!BOUND form: the sparql-hex engine does not support FILTER NOT EXISTS.)
PREFIX smalt: <https://ggen.io/ontology/smalt#>
SELECT ?resourceType WHERE {
  ?cp smalt:resourceType ?resourceType .
  OPTIONAL {
    ?b a smalt:TypeBinding ;
       smalt:resourceType ?resourceType ;
       smalt:apiVersion ?av ;
       smalt:shape ?shape .
  }
  FILTER (!bound(?b))
}
