# store-shadow-tables.unbound.rq — inverted coverage gate: MUST return zero rows.
# A row = a table referenced by the substrate's sweep vocabulary
# (smalt:dataPlaneTable literal) that is NOT typed as a smalt:StoreTable —
# a swept-but-unowned table (the :smalt_blob_blocks bug class).
# The lib/-side complement (every :smalt_ atom referenced in lib/ has a
# StoreTable row) is fenced by test/store_tables_replay_identity_test.exs
# (grep coverage), since SPARQL cannot see lib/.
PREFIX smalt: <https://ggen.io/ontology/smalt#>

SELECT ?table WHERE {
  ?g smalt:dataPlaneTable ?table .
  OPTIONAL {
    ?st a smalt:StoreTable ;
        smalt:tableName ?table .
  }
  FILTER (!bound(?st))
}
