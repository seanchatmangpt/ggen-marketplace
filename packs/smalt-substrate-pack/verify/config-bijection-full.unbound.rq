# Inverted bijection gate (extended from defaults-bijection.unbound.rq):
# MUST return zero rows. A row = a smalt:ConfigKey carrying more than one
# smalt:default value — a key with two defaults has no single source of
# truth for the projected accessor. Left direction of the bijection:
# census side (lib/ grep) is closed by construction (46-key census).
PREFIX smalt: <https://ggen.io/ontology/smalt#>

SELECT ?name ?d1 ?d2 WHERE {
  ?k a smalt:ConfigKey ;
     smalt:name ?name ;
     smalt:default ?d1, ?d2 .
  FILTER (?d1 != ?d2)
}
