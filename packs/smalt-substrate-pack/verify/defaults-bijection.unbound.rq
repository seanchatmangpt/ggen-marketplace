# Inverted bijection gate: MUST return zero rows.
# A row = a smalt:default row whose smalt:shapePath is NOT declared as a
# sh:path in the shape's sh:property vocabulary — a default the shape
# refuses (defaults/validator dual-maintenance drift, left direction).
PREFIX smalt: <https://ggen.io/ontology/smalt#>
PREFIX sh:    <http://www.w3.org/ns/shacl#>

SELECT ?shape ?jsonPath WHERE {
  ?shape smalt:default ?d .
  ?d smalt:jsonPath ?jsonPath ;
     smalt:shapePath ?sp .
  OPTIONAL {
    ?shape sh:property ?p .
    ?p sh:path ?sp .
  }
  FILTER (!bound(?p))
}
