# 090_standing_evidence pass witness: ALIVE coverage with observed independent evidence at the current subject and a pack-bound SBB; a FALSIFIED outcome at a superseded subject is ignored; expect 0 rows.
# Synthetic data only (example.invalid IRIs). Loaded together with ontology.ttl by the gate court.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ex: <https://example.invalid/synthetic/> .

ex:closure a ic:IndustryClosure ;
    ic:industryScope "synthetic bounded scope for witnesses and fixtures" ;
    ic:baseIri "https://example.invalid/synthetic/" ;
    ic:boundPathPrefix "ontologies/public/synthetic/" ;
    ic:usesSource ex:srcA ;
    ic:hasSnapshot ex:snap0 , ex:snap1 .

ex:snap0 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:epoch 0 .

ex:snap1 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:supersedes ex:snap0 ;
    ic:epoch 1 .

ex:srcA a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://example.invalid/source/a> ;
    ic:sourceVersion "1.0.0" ;
    ic:sourceDigest "sha256:c2922945bce9302c46fb563eb14f55a7d5fa796bcb3a229c49e9013ccc4e04bc" ;
    ic:licenseBoundary "synthetic test source, no external licence" ;
    ic:sourceLocator "ontologies/public/synthetic/a.ttl" ;
    ic:providesConcept <https://example.invalid/concept/A> .

ex:agentBuilder a <http://www.w3.org/ns/prov#Agent> .
ex:agentVerifier a <http://www.w3.org/ns/prov#Agent> .

ex:reqA a ic:Requirement ;
    ic:requirementId "REQ-A" ;
    ic:statement "Synthetic requirement A stated in paraphrase." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability ex:capA ;
    ic:derivedFrom ex:srcA .

ex:capA a ea:Capability ;
    ic:capabilityKey "CAP-A" ;
    ic:groundedIn ex:srcA ;
    ic:concept <https://example.invalid/concept/A> .

ex:abbA a ea:ArchitectureBuildingBlock ;
    ea:realizesCapability ex:capA ;
    ea:governedByContract ex:kA .

ex:kA a ea:ArchitectureContract ;
    ea:hasAuthorityBoundary ex:boundaryA ;
    ic:approvalStatus ic:APPROVED ;
    ic:approvedBy ex:humanApprover ;
    ic:approvalReceipt "receipt:A-approval" ;
    ic:authorityClaim "NONE" .

ex:boundaryA a ea:AuthorityBoundary .

ex:humanApprover a <http://www.w3.org/ns/prov#Agent> .

ex:sbbA a ea:SolutionBuildingBlock ;
    ea:satisfiesABB ex:abbA ;
    ea:hasStanding ea:QUALIFIED ;
    ea:exactSubject "sha256:58fb837c25362a6184fa830bd12225cf3ac5f2b7274cdde66f66611962b892e2" ;
    ic:marketplacePack "synthetic-pack-a" ;
    ic:packDigest "sha256:f840652650d20a97cbe0864964e0514bc683838a5697174ff3b4098dcfa82503" .

ex:evAobs a ic:ExecutionEvidence ;
    ic:evidenceFor ex:sbbA ;
    ic:evidenceSubject "sha256:58fb837c25362a6184fa830bd12225cf3ac5f2b7274cdde66f66611962b892e2" ;
    ic:outcome ic:VERIFIED ;
    ic:receiptDigest "sha256:5570efbbe6bd709feb235657940e1e822c9169bd5e4fd8e92997927c3f954429" ;
    ic:producedBy ex:agentBuilder ;
    ic:verifiedBy ex:agentVerifier ;
    ic:evidenceKind ic:OBSERVED .

ex:evAold a ic:ExecutionEvidence ;
    ic:evidenceFor ex:sbbA ;
    ic:evidenceSubject "sha256:fb64427a7614bc06b7527b35dd8a8de682bea9b3742110a6c7339da2c54a898d" ;
    ic:outcome ic:FALSIFIED ;
    ic:receiptDigest "sha256:c884593d05c1d212085a54ec4b276c14f312213ef8191961ce61a424c172a977" ;
    ic:producedBy ex:agentBuilder ;
    ic:verifiedBy ex:agentVerifier ;
    ic:evidenceKind ic:OBSERVED .

ex:covAlive a ic:Coverage ;
    ic:inSnapshot ex:snap1 ;
    ic:coversCapability ex:capA ;
    ic:byABB ex:abbA ;
    ic:bySBB ex:sbbA ;
    ic:coverageState ic:LIVE ;
    ic:standing "ALIVE" ;
    ic:evidencedBy ex:evAobs .

ex:covUnknown a ic:Coverage ;
    ic:inSnapshot ex:snap1 ;
    ic:coversCapability ex:capA ;
    ic:byABB ex:abbA ;
    ic:bySBB ex:sbbA ;
    ic:coverageState ic:LIVE ;
    ic:standing "UNKNOWN" .

