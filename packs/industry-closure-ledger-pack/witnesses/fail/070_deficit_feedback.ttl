# 070_deficit_feedback fail witness: unclassified, multi-class, unrouted, misrouted, authority block not BLOCKED and authority block unreasoned residuals.
# Synthetic data only (example.invalid IRIs). Loaded together with ontology.ttl by the gate court.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ex: <https://example.invalid/synthetic/> .

ex:closure a ic:IndustryClosure ;
    ic:industryScope "synthetic bounded scope for witnesses and fixtures" ;
    ic:baseIri "https://example.invalid/synthetic/" ;
    ic:boundPathPrefix "ontologies/public/synthetic/" ;
    ic:usesSource ex:srcA ;
    ic:hasSnapshot ex:snap0 .

ex:snap0 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:epoch 0 .

ex:srcA a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://example.invalid/source/a> ;
    ic:sourceVersion "1.0.0" ;
    ic:sourceDigest "sha256:c2922945bce9302c46fb563eb14f55a7d5fa796bcb3a229c49e9013ccc4e04bc" ;
    ic:licenseBoundary "synthetic test source, no external licence" ;
    ic:sourceLocator "ontologies/public/synthetic/a.ttl" ;
    ic:providesConcept <https://example.invalid/concept/A> .

ex:reqA a ic:Requirement ;
    ic:requirementId "REQ-A" ;
    ic:statement "Synthetic requirement A stated in paraphrase." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability ex:capA ;
    ic:derivedFrom ex:srcA .

ex:reqB a ic:Requirement ;
    ic:requirementId "REQ-B" ;
    ic:statement "Synthetic requirement B stated in paraphrase." ;
    ic:inClosure ex:closure ;
    ic:disposition ic:IN_SCOPE ;
    ic:requiresCapability ex:capB ;
    ic:derivedFrom ex:srcA .

ex:capA a ea:Capability ;
    ic:capabilityKey "CAP-A" ;
    ic:groundedIn ex:srcA ;
    ic:concept <https://example.invalid/concept/A> .

ex:capB a ea:Capability ;
    ic:capabilityKey "CAP-B" ;
    ic:groundedIn ex:srcA ;
    ic:concept <https://example.invalid/concept/A> .

ex:resA a ic:Residual ;
    ic:residualKey "REQ-A--CAP-A" ;
    ic:residualOf ex:reqA ;
    ic:forCapabilityKey "CAP-A" ;
    ic:deficitClass ic:DEFICIT_ABB ;
    ic:feedbackTarget ic:UPSTREAM_ARCHITECTURE ;
    ic:status "OPEN" ;
    ic:standing "UNKNOWN" ;
    ic:authorityClaim "NONE" .

ex:resB a ic:Residual ;
    ic:residualKey "REQ-B--CAP-B" ;
    ic:residualOf ex:reqB ;
    ic:forCapabilityKey "CAP-B" ;
    ic:deficitClass ic:DEFICIT_AUTHORITY ;
    ic:feedbackTarget ic:UPSTREAM_AUTHORITY ;
    ic:status "OPEN" ;
    ic:standing "BLOCKED" ;
    ic:blockedReason "DO_AUTHORITY_REQUIRED" ;
    ic:authorityClaim "NONE" .

ex:resUnclassified a ic:Residual ;
    ic:residualKey "REQ-A--U1" ;
    ic:feedbackTarget ic:UPSTREAM_ARCHITECTURE .

ex:resMulti a ic:Residual ;
    ic:residualKey "REQ-A--U2" ;
    ic:deficitClass ic:DEFICIT_ABB , ic:DEFICIT_CONTRACT ;
    ic:feedbackTarget ic:UPSTREAM_ARCHITECTURE .

ex:resNoFeedback a ic:Residual ;
    ic:residualKey "REQ-A--U3" ;
    ic:deficitClass ic:DEFICIT_SBB .

ex:resMisrouted a ic:Residual ;
    ic:residualKey "REQ-A--U4" ;
    ic:deficitClass ic:DEFICIT_ABB ;
    ic:feedbackTarget ic:UPSTREAM_KNOWLEDGE .

ex:resNotBlocked a ic:Residual ;
    ic:residualKey "REQ-A--U5" ;
    ic:deficitClass ic:DEFICIT_AUTHORITY ;
    ic:feedbackTarget ic:UPSTREAM_AUTHORITY ;
    ic:standing "UNKNOWN" ;
    ic:blockedReason "DO_AUTHORITY_REQUIRED" .

ex:resUnreasoned a ic:Residual ;
    ic:residualKey "REQ-A--U6" ;
    ic:deficitClass ic:DEFICIT_AUTHORITY ;
    ic:feedbackTarget ic:UPSTREAM_AUTHORITY ;
    ic:standing "BLOCKED" .

# IC_RESIDUAL_STANDING_PROMOTED: a deficit record never claims a stronger standing than UNKNOWN or BLOCKED.
ex:resPromoted a ic:Residual ;
    ic:residualKey "REQ-A--CAP-PROMOTED" ;
    ic:residualOf ex:reqA ;
    ic:forCapabilityKey "CAP-PROMOTED" ;
    ic:deficitClass ic:DEFICIT_ABB ;
    ic:feedbackTarget ic:UPSTREAM_ARCHITECTURE ;
    ic:status "OPEN" ;
    ic:standing "ALIVE" ;
    ic:authorityClaim "NONE" .
