# 030_snapshot_identity fail witness: closure without snapshot, missing epoch, orphan snapshots, epoch skip, fork, closure mismatch.
# Synthetic data only (example.invalid IRIs). Loaded together with ontology.ttl by the gate court.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#> .
@prefix ea: <https://chatman.ai/ontology/enterprise-architecture#> .
@prefix ex: <https://example.invalid/synthetic/> .

ex:closure a ic:IndustryClosure ;
    ic:industryScope "synthetic bounded scope for witnesses and fixtures" ;
    ic:baseIri "https://example.invalid/synthetic/" ;
    ic:boundPathPrefix "ontologies/public/synthetic/" ;
    ic:usesSource ex:srcA ;
    ic:hasSnapshot ex:snap0 , ex:snap1 , ex:snap2 .

ex:snap0 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:epoch 0 .

ex:snap1 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:supersedes ex:snap0 ;
    ic:epoch 1 .

ex:snap2 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:supersedes ex:snap1 ;
    ic:epoch 2 .

ex:srcA a ic:KnowledgeSource ;
    ic:admission ic:ADMITTED ;
    ic:sourceIri <https://example.invalid/source/a> ;
    ic:sourceVersion "1.0.0" ;
    ic:sourceDigest "sha256:c2922945bce9302c46fb563eb14f55a7d5fa796bcb3a229c49e9013ccc4e04bc" ;
    ic:licenseBoundary "synthetic test source, no external licence" ;
    ic:sourceLocator "ontologies/public/synthetic/a.ttl" ;
    ic:providesConcept <https://example.invalid/concept/A> .

ex:closureNoSnap a ic:IndustryClosure ;
    ic:baseIri "https://example.invalid/synthetic/nosnap/" .

ex:closureB a ic:IndustryClosure ;
    ic:baseIri "https://example.invalid/synthetic/b/" ;
    ic:hasSnapshot ex:snapB0 .

ex:snapB0 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closureB ;
    ic:epoch 0 .

ex:snapNoEpoch a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure .

ex:snapOrphanEpoch a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:epoch 7 .

ex:snapNoClosure a ic:ClosureSnapshot ;
    ic:epoch 0 .

ex:snapSkip a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closure ;
    ic:epoch 5 ;
    ic:supersedes ex:snap2 .

ex:snapForkA a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closureB ;
    ic:epoch 1 ;
    ic:supersedes ex:snapB0 .

ex:snapForkB a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closureB ;
    ic:epoch 1 ;
    ic:supersedes ex:snapB0 .

ex:closureC a ic:IndustryClosure ;
    ic:baseIri "https://example.invalid/synthetic/c/" ;
    ic:hasSnapshot ex:snapC0 .

ex:snapC0 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closureC ;
    ic:epoch 0 .

ex:snapMismatch a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closureB ;
    ic:epoch 1 ;
    ic:supersedes ex:snapC0 .

# IC_SNAPSHOT_MULTIPLE_HEADS and IC_SNAPSHOT_EPOCH_DUPLICATE: two snapshots of one closure, both without a successor, both epoch 0.
ex:closureD a ic:IndustryClosure ;
    ic:baseIri "https://example.invalid/synthetic/d/" ;
    ic:hasSnapshot ex:snapD0a , ex:snapD0b .

ex:snapD0a a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closureD ;
    ic:epoch 0 .

ex:snapD0b a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closureD ;
    ic:epoch 0 .

# IC_CLOSURE_BASEIRI_INVALID: a base IRI that would be spliced into generated Turtle must be a clean https IRI ending in a slash.
ex:closureBadBase a ic:IndustryClosure ;
    ic:baseIri "https://example.invalid/bad base/" ;
    ic:hasSnapshot ex:snapBb0 .

ex:snapBb0 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closureBadBase ;
    ic:epoch 0 .

ex:closureNoBase a ic:IndustryClosure ;
    ic:hasSnapshot ex:snapNb0 .

ex:snapNb0 a ic:ClosureSnapshot ;
    ic:snapshotOf ex:closureNoBase ;
    ic:epoch 0 .
