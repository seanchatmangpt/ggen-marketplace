# Candidate residual ledger. CONSTRUCTED from queries/10-residual.rq; a human appends it to the
# industry input. It carries no DO authority: every residual claims NONE and stands UNKNOWN or BLOCKED.
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#> .

{% for row in results %}<{{ row.baseIri }}residual/{{ row.rkey }}> a ic:Residual ;
    ic:residualKey "{{ row.rkey }}" ;
    ic:residualOf <{{ row.reqIri }}> ;
    ic:forCapabilityKey "{{ row.capabilityKey }}" ;
    ic:deficitClass ic:{{ row.classCode }} ;
    ic:feedbackTarget ic:{{ row.targetCode }} ;
    ic:status "OPEN" ;
    ic:standing "{{ row.standing }}" ;
{% if row.standing == "BLOCKED" %}    ic:blockedReason "DO_AUTHORITY_REQUIRED" ;
{% endif %}    ic:authorityClaim "NONE" .

{% endfor %}
