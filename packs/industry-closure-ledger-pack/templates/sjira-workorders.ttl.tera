# Candidate sJira work orders. CONSTRUCTED from queries/10-residual.rq: one pure projection per residual.
# A work order is a candidate ontology, architecture, pack, court or authority delta record. It is not a
# file under packs/, it is not executed, and it claims NONE authority.
@prefix ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#> .

{% for row in results %}<{{ row.baseIri }}workorder/{{ row.rkey }}> a ic:WorkOrder ;
    ic:workOrderId "SJ-{{ row.rkey }}" ;
    ic:forResidual <{{ row.baseIri }}residual/{{ row.rkey }}> ;
    ic:deltaCode "{{ row.deltaCode }}" ;
    ic:acceptance "{{ row.acceptanceText }}" ;
    ic:falsifier "{{ row.falsifierText }}" ;
    ic:standing "{{ row.standing }}" ;
    ic:authorityClaim "NONE" .

{% endfor %}
