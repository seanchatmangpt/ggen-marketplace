PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#>
PREFIX ea: <https://chatman.ai/ontology/enterprise-architecture#>
PREFIX togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#>
# MESSAGE: DO authority is unrepresentable: no DO ceiling, claim or class; residuals and work orders claim NONE; an approved contract names its human approver and receipt.
SELECT ?subject ?reason WHERE {
  { ?subject ?p ic:DO BIND("REFUSED:IC_AUTHORITY_DO_FORBIDDEN" AS ?reason) }
  UNION { ?subject (ic:authorityCeiling|ic:authorityClaim|ic:authorityClass) ?a . FILTER(STR(?a) = STR(ic:DO) || UCASE(STR(?a)) = "DO")
    BIND("REFUSED:IC_AUTHORITY_DO_FORBIDDEN" AS ?reason) }
  UNION { ?subject ic:grantsDoAuthority ?g . FILTER(!(isLiteral(?g) && DATATYPE(?g) = xsd:boolean && STR(?g) IN ("false", "0")))
    BIND("REFUSED:IC_AUTHORITY_DO_FORBIDDEN" AS ?reason) }
  UNION { ?subject ic:authorityCeiling ?a . FILTER(!(STR(?a) IN ("NONE","OBSERVE","SELECT","CONSTRUCT"))) BIND("REFUSED:IC_AUTHORITY_CEILING_INVALID" AS ?reason) }
  UNION { { ?subject a ic:WorkOrder } UNION { ?subject a ic:Residual } OPTIONAL { ?subject ic:authorityClaim ?c }
          FILTER(!BOUND(?c)) BIND("REFUSED:IC_AUTHORITY_CLAIM_MISSING" AS ?reason) }
  UNION { { ?subject a ic:WorkOrder } UNION { ?subject a ic:Residual } ?subject ic:authorityClaim ?c
          FILTER(STR(?c) != "NONE") BIND("REFUSED:IC_AUTHORITY_CLAIM_NOT_NONE" AS ?reason) }
  UNION { ?subject a ea:ArchitectureContract ; ic:approvalStatus ic:APPROVED .
          OPTIONAL { ?subject ic:approvedBy ?who } OPTIONAL { ?subject ic:approvalReceipt ?rc }
          FILTER(!BOUND(?who) || !BOUND(?rc)) BIND("REFUSED:IC_CONTRACT_APPROVAL_UNATTRIBUTED" AS ?reason) }
} ORDER BY ?subject ?reason
