PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#>
PREFIX ea: <https://chatman.ai/ontology/enterprise-architecture#>
PREFIX togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#>
# MESSAGE: a recorded LIVE coverage in the head snapshot must satisfy the full chain at the SBB's current exact subject; STALE is legal but reasoned. Superseded snapshots keep their history and are not re-judged for currentness.
SELECT ?subject ?reason WHERE {
  { ?subject a ic:Coverage .
    OPTIONAL { ?subject ic:coversCapability ?q1 } OPTIONAL { ?subject ic:byABB ?q2 } OPTIONAL { ?subject ic:bySBB ?q3 }
    OPTIONAL { ?subject ic:inSnapshot ?q4 } OPTIONAL { ?subject ic:coverageState ?q5 }
    FILTER(!BOUND(?q1) || !BOUND(?q2) || !BOUND(?q3) || !BOUND(?q4) || !BOUND(?q5)) BIND("REFUSED:IC_COVERAGE_INCOMPLETE" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:coverageState ?s . FILTER(!(?s IN (ic:LIVE, ic:STALE))) BIND("REFUSED:IC_COVERAGE_STATE_INVALID" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:coversCapability ?cap ; ic:byABB ?abb . FILTER NOT EXISTS { ?abb ea:realizesCapability ?cap }
          BIND("REFUSED:IC_COVERAGE_ABB_NOT_REALIZING" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:coverageState ic:LIVE ; ic:inSnapshot ?sn ; ic:byABB ?abb .
          FILTER NOT EXISTS { ?nx ic:supersedes ?sn }
          FILTER NOT EXISTS { ?abb ea:governedByContract ?k . ?k a ea:ArchitectureContract ; ic:approvalStatus ic:APPROVED ; ea:hasAuthorityBoundary ?b }
          BIND("REFUSED:IC_COVERAGE_CONTRACT_NOT_APPROVED" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:byABB ?abb ; ic:bySBB ?sbb . FILTER NOT EXISTS { ?sbb ea:satisfiesABB ?abb }
          BIND("REFUSED:IC_COVERAGE_SBB_MISMATCH" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:coverageState ic:LIVE ; ic:inSnapshot ?sn ; ic:bySBB ?sbb .
          FILTER NOT EXISTS { ?nx ic:supersedes ?sn }
          FILTER NOT EXISTS { ?sbb ea:hasStanding ea:QUALIFIED }
          BIND("REFUSED:IC_COVERAGE_SBB_NOT_QUALIFIED" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:coverageState ic:LIVE ; ic:inSnapshot ?sn ; ic:bySBB ?sbb .
          FILTER NOT EXISTS { ?nx ic:supersedes ?sn }
          FILTER NOT EXISTS { ?sbb ea:exactSubject ?d }
          BIND("REFUSED:IC_COVERAGE_SBB_UNPINNED" AS ?reason) }
  UNION { ?cov a ic:Coverage ; ic:bySBB ?subject . ?subject ea:exactSubject ?d . FILTER(!REGEX(STR(?d), "^sha256:[0-9a-f]{64}$"))
          BIND("REFUSED:IC_SBB_SUBJECT_MALFORMED" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:coverageState ic:LIVE ; ic:inSnapshot ?sn ; ic:bySBB ?sbb .
          FILTER NOT EXISTS { ?nx ic:supersedes ?sn }
          FILTER NOT EXISTS { ?e a ic:ExecutionEvidence ; ic:evidenceFor ?sbb ; ic:evidenceSubject ?d ; ic:outcome ic:VERIFIED . ?sbb ea:exactSubject ?d }
          BIND("REFUSED:IC_COVERAGE_EVIDENCE_MISSING" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:coverageState ic:LIVE ; ic:inSnapshot ?sn ; ic:bySBB ?sbb .
          FILTER NOT EXISTS { ?nx ic:supersedes ?sn }
          ?e a ic:ExecutionEvidence ; ic:evidenceFor ?sbb ; ic:evidenceSubject ?d ; ic:outcome ic:FALSIFIED . ?sbb ea:exactSubject ?d
          BIND("REFUSED:IC_COVERAGE_EVIDENCE_FALSIFIED" AS ?reason) }
  UNION { ?subject a ic:Coverage ; ic:coverageState ic:STALE . OPTIONAL { ?subject ic:staleBecause ?w } FILTER(!BOUND(?w))
          BIND("REFUSED:IC_COVERAGE_STALE_UNREASONED" AS ?reason) }
  UNION { ?subject ea:satisfiesABB ?abb ; ea:exactSubject ?d1 , ?d2 . ?abb ea:realizesCapability ?cap . ?cap ic:capabilityKey ?ck .
          FILTER(STR(?d1) < STR(?d2)) BIND("REFUSED:IC_SBB_SUBJECT_AMBIGUOUS" AS ?reason) }
} ORDER BY ?subject ?reason
