PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ic: <https://seanchatmangpt.github.io/packs/industry-closure-ledger-pack#>
PREFIX ea: <https://chatman.ai/ontology/enterprise-architecture#>
PREFIX togaf: <http://www.semanticweb.org/ontologies/2020/4/OntologyTOGAFContentMetamodel.owl#>
# MESSAGE: each closure has a single snapshot chain: epoch = predecessor + 1, one successor per snapshot, exactly one head, no repeated epoch, same closure, and a well-formed base IRI.
SELECT ?subject ?reason WHERE {
  { ?subject a ic:IndustryClosure . FILTER NOT EXISTS { ?subject ic:hasSnapshot ?s } BIND("REFUSED:IC_CLOSURE_NO_SNAPSHOT" AS ?reason) }
  UNION { ?subject a ic:ClosureSnapshot . FILTER NOT EXISTS { ?subject ic:epoch ?e } BIND("REFUSED:IC_SNAPSHOT_EPOCH_MISSING" AS ?reason) }
  UNION { ?subject a ic:ClosureSnapshot ; ic:epoch ?e . FILTER(?e > 0) FILTER NOT EXISTS { ?subject ic:supersedes ?p }
          BIND("REFUSED:IC_SNAPSHOT_ORPHAN" AS ?reason) }
  UNION { ?subject a ic:ClosureSnapshot . FILTER NOT EXISTS { ?subject ic:snapshotOf ?c } BIND("REFUSED:IC_SNAPSHOT_ORPHAN" AS ?reason) }
  UNION { ?subject a ic:ClosureSnapshot ; ic:epoch ?e ; ic:supersedes ?p . ?p ic:epoch ?pe . FILTER(?e != ?pe + 1)
          BIND("REFUSED:IC_SNAPSHOT_EPOCH_SKIP" AS ?reason) }
  UNION { ?subject a ic:ClosureSnapshot . ?a ic:supersedes ?subject . ?b ic:supersedes ?subject . FILTER(STR(?a) < STR(?b))
          BIND("REFUSED:IC_SNAPSHOT_FORK" AS ?reason) }
  UNION { ?subject a ic:ClosureSnapshot ; ic:snapshotOf ?c1 ; ic:supersedes ?p . ?p ic:snapshotOf ?c2 . FILTER(?c1 != ?c2)
          BIND("REFUSED:IC_SNAPSHOT_CLOSURE_MISMATCH" AS ?reason) }
  UNION { ?subject a ic:IndustryClosure . ?h1 ic:snapshotOf ?subject . ?h2 ic:snapshotOf ?subject . FILTER(STR(?h1) < STR(?h2))
          FILTER NOT EXISTS { ?n1 ic:supersedes ?h1 } FILTER NOT EXISTS { ?n2 ic:supersedes ?h2 }
          BIND("REFUSED:IC_SNAPSHOT_MULTIPLE_HEADS" AS ?reason) }
  UNION { ?subject a ic:ClosureSnapshot ; ic:snapshotOf ?c ; ic:epoch ?e . ?other a ic:ClosureSnapshot ; ic:snapshotOf ?c ; ic:epoch ?e2 .
          FILTER(STR(?subject) < STR(?other)) FILTER(?e = ?e2) BIND("REFUSED:IC_SNAPSHOT_EPOCH_DUPLICATE" AS ?reason) }
  UNION { ?subject a ic:IndustryClosure . OPTIONAL { ?subject ic:baseIri ?b } FILTER(!BOUND(?b))
          BIND("REFUSED:IC_CLOSURE_BASEIRI_INVALID" AS ?reason) }
  UNION { ?subject a ic:IndustryClosure ; ic:baseIri ?b . FILTER(!REGEX(STR(?b), "^https://[^\\s<>\"{}|\\\\^`]+/$"))
          BIND("REFUSED:IC_CLOSURE_BASEIRI_INVALID" AS ?reason) }
} ORDER BY ?subject ?reason
