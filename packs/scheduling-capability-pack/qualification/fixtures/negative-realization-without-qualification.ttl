# FIRES gates/020_realization_requires_qualification.rq (only).
# A realization with provider metadata but NO qualificationCondition can
# never be refused, which makes qualification vacuous.
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

scap:f-neg-unqualified a scap:CapabilityRealization ;
    rdfs:label "Unqualified fixture realization" ;
    scap:realizes scap:cap-delay ;
    scap:providerRepo "https://example.test/fixture" ;
    scap:bindingModule "Fixture.Unqualified.*" ;
    scap:missedFirePolicy "drop" ;
    scap:timezoneAnchoring "none" ;
    scap:durability "in-memory" ;
    qce:admitted false .
# Deliberately missing: scap:qualificationCondition.
