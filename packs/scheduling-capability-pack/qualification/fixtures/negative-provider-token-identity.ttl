# FIRES gates/050_capability_identity_impl_free.rq (only).
# "Oban.Nightly" names the implementing package inside the capability
# identity: CAPABILITY != IMPLEMENTATION violated.
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

scap:f-neg-oban-nightly a scap:Capability ;
    dcterms:identifier "Oban.Nightly" ;
    rdfs:label "Oban.Nightly" ;
    skos:prefLabel "Implementation-named capability (fixture: must be refused)" ;
    scap:capabilityFamily "scheduling-calendar" ;
    scap:consequence "DO" ;
    scap:temporalKind "recurring" ;
    scap:timezoneAnchoring "utc" ;
    scap:missedFirePolicy "skip" ;
    scap:inputContract "target + nightly pattern" ;
    scap:outputContract "one firing per nightly occurrence" ;
    scap:precondition "anchor resolvable" ;
    scap:postcondition "occurrences fired nightly" ;
    scap:authorityRequirement "Requires an authority envelope binding the scheduled target's consequence scope." ;
    scap:evidenceRequirement "earl: assertion from observed execution on the exact subject" ;
    scap:outcome scap:f-neg-oban-nightly-ok .

scap:f-neg-oban-nightly-ok a scap:Outcome ;
    skos:prefLabel "success:nightly-fired" ;
    scap:outcomeKind "success" .

scap:real-oban scap:realizes scap:f-neg-oban-nightly .
