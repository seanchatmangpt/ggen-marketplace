# PASS witness for 040_consequential_requires_authority: DO capability WITH bound authority.
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

scap:w-do a scap:Capability ;
    dcterms:identifier "Schedule.WitnessDO" ;
    rdfs:label "Schedule.WitnessDO" ;
    scap:consequence "DO" ;
    scap:authorityRequirement "authority envelope bound" .
