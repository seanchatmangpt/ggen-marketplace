# PASS witness for 030_missed_fire_policy_required: capability and realization both declare a policy.
@prefix scap: <https://ggen.dev/ontology/scheduling-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

scap:w-cap a scap:Capability ;
    dcterms:identifier "Schedule.WitnessHourly" ;
    rdfs:label "Schedule.WitnessHourly" ;
    scap:missedFirePolicy "skip" .
scap:w-real a scap:CapabilityRealization ;
    scap:realizes scap:w-cap ;
    scap:missedFirePolicy "skip" .
