@prefix oro: <https://seanchatman.github.io/ggen-marketplace/owning-rail-observability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
oro:ExactSubject a rdfs:Class ; rdfs:subClassOf prov:Entity .
oro:Rail a rdfs:Class ; rdfs:subClassOf prov:Entity .
oro:RailObservation a rdfs:Class ; rdfs:subClassOf prov:Entity .
oro:StandingReceipt a rdfs:Class ; rdfs:subClassOf prov:Entity .
oro:aboutSubject a rdf:Property .
oro:ownsRail a rdf:Property .
oro:dependsOnRail a rdf:Property .
oro:observedRail a rdf:Property .
oro:repository a rdf:Property .
oro:headSha a rdf:Property .
oro:semanticDigest a rdf:Property .
oro:state a rdf:Property .
oro:observedAt a rdf:Property .
oro:evidenceRef a rdf:Property .
oro:failureDomain a rdf:Property .
oro:receiptDigest a rdf:Property .
oro:authority a rdf:Property .
oro:actuationPerformed a rdf:Property .
