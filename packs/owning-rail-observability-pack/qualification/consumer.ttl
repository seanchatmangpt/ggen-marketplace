@prefix oro: <https://seanchatman.github.io/ggen-marketplace/owning-rail-observability#> .
<urn:consumer> oro:ownsRail <urn:semantic>, <urn:repository> .
<urn:semantic> a oro:Rail ; oro:failureDomain "semantic" ; oro:dependsOnRail <urn:repository> .
<urn:repository> a oro:Rail ; oro:failureDomain "repository" .
