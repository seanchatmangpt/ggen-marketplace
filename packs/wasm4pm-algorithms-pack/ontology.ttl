@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pi:   <https://wasm4pm.dev/pi#> .

# wasm4pm-algorithms-pack ontology — CATALOG/CALLER surface for the wasm4pm
# process-intelligence algorithm layer.
#
# SINGLE-OWNER JOIN (v26.9.30 consolidation, 2026-10-01): this pack declares the
# pi: vocabulary ONLY. The 60 pi:ProcessIntelligenceAlgorithm individuals moved
# to the single owner, packs/wasm4pm-facts-pack/ontology.ttl (which also
# absorbed the one pi:verifiedAgainst fact — pi:Algo_ocel_dfg — that was unique
# to this pack's copies and is required by this pack's dispatch/fidelity
# templates). The join is the IRI literal `pi:ProcessIntelligenceAlgorithm` +
# property IRIs below — the capability-ecology dotted-ID pattern, NO cross-pack
# import. Templates here render against the consumer's union graph: wiring only
# this pack yields an empty catalog (declared, not a defect); wiring
# wasm4pm-facts-pack alongside yields the full 60-algorithm catalog.
# qualification/verify.py proves both the gates' non-vacuity (witnesses) and
# the join (union with the facts pack).
#
# DERIVED PROPERTIES (never asserted anywhere in this pack, by design):
#   pi:algorithmStatus / pi:standing / pi:measuredFitness / pi:piAdmitted /
#   pi:fitnessProvenance — CONSTRUCT-derived from evidence in wasm4pm.
# This pack generates catalog surfaces only; evidence/witness vocabulary
# belongs to the wasm4pm-compat family.
#
# TARGET-API FIDELITY (honest partial status, unchanged in substance):
# exactly 1 of the 60 individual rows (pi:Algo_ocel_dfg, now owned by
# wasm4pm-facts-pack) carries a pi:verifiedAgainst fact and only that one is
# exercised by a real compiled call in
# templates/algorithms_target_fidelity_proof.rs.tmpl -- the only wasmExport
# literal in this whole catalog that corresponds to an actually-reachable
# `pub fn` in a crate this workspace can compile against (`wasm4pm-compat`
# 26.6.29's `discover_ocel_dfg`). The other 59 wasmExport values are WASM
# exports of the `wasm4pm` crate itself, which is not (and per this
# project's own process-intelligence-boundary rule, cannot be) a dependency
# reachable from here to verify against. Do not read the presence of this
# note as "all 60 rows verified" -- it is not.
#
# DRIFT NOTE (2026-10-01): this pack formerly carried its own copies of
# pi:Algo_optimized_dfg / pi:Algo_streaming_log with pi:wasmExport values that
# had drifted stale against wasm4pm-facts-pack's DRIFT_LOG-corrected ones
# (a 3-times-recurred defect, see facts-pack DRIFT_LOG.md). Dropping the
# duplicated individuals removed the stale copies entirely; the corrected
# values in the facts pack are the only remaining assertions.

# ── Vocabulary (self-contained) ─────────────────────────────────────────────

pi:ProcessIntelligenceAlgorithm a rdfs:Class ;
  rdfs:label "ProcessIntelligenceAlgorithm" ;
  rdfs:comment "A registered process mining algorithm in the wasm4pm platform, with paper-grounded evidence and WASM export metadata." .

pi:algorithmId a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:string ;
  rdfs:comment "Canonical snake_case algorithm identifier — matches Rust enum id() and TypeScript AlgorithmId." .

pi:algorithmLabel a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:string ;
  rdfs:comment "PascalCase label used as Rust enum variant name (e.g. 'AlphaPlusPlus')." .

pi:algorithmDoc a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:string ;
  rdfs:comment "Human-readable description of what the algorithm computes and its primary use case." .

pi:citation a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:string ;
  rdfs:comment "Bibliographic reference to the primary paper introducing or canonically describing this algorithm." .

pi:outputType a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:string ;
  rdfs:comment "Primary artifact type produced: dfg | petrinet | declare | tree | analytics | ml_result | model." .

pi:category a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:string ;
  rdfs:comment "Functional category: discovery | discovery_analytics | object_centric | ml_analytics | conformance | simulation | prediction | import_export | agentic." .

pi:speedTier a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:integer ;
  rdfs:comment "Relative throughput rank 1-80 (lower = faster, 1 = fastest)." .

pi:qualityTier a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:integer ;
  rdfs:comment "Model quality rank 0-100 (higher = more faithful to the process). Orthogonal to speed." .

pi:wasmExport a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:string ;
  rdfs:comment "WASM-exported function name callable from TypeScript. Empty string if no direct WASM export." .

pi:cliAlias a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:string ;
  rdfs:comment "Optional CLI alias string for wpm run (e.g. 'dfg'). Omit entirely when no alias exists." .

pi:inputFormat a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:string ;
  rdfs:comment "Required input format: xes | ocel | bpmn | pnml | petri_net_handle | any." .

pi:verifiedAgainst a rdf:Property ;
  rdfs:domain pi:ProcessIntelligenceAlgorithm ;
  rdfs:range xsd:string ;
  rdfs:comment "Dated, one-time hand-verification note recording that this algorithm's pi:wasmExport literal was checked to actually resolve against a real, pinned target crate (crate name@version::fn_name, verification date). Absence means UNVERIFIED, not confirmed-absent -- see docs note in this file's header on how many of the 60 rows currently carry this fact." .

