# Fail witness for wasm4pm-algorithms-pack: one algorithm individual with TWO
# deliberate defects. Gates must FIRE (>= 1 row) against the pack vocabulary +
# this graph:
#   - missing pi:wasmExport                    -> 010_required fires
#   - pi:category "not_a_category"             -> 030_value_constraints fires
# If the gates are ever silently green here, they are vacuous (anti-vacuity
# mutation of the required-property and closed-enumeration branches).
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pi:   <https://wasm4pm.dev/pi#> .

pi:Algo_witness_fail a pi:ProcessIntelligenceAlgorithm ;
  pi:algorithmId    "witness_fail" ;
  pi:algorithmLabel "WitnessFail" ;
  pi:algorithmDoc   "Deliberately non-conforming witness individual." ;
  pi:citation       "Witness, 2026." ;
  pi:outputType     "dfg" ;
  pi:category       "not_a_category" ;
  pi:speedTier      3 ;
  pi:qualityTier    60 ;
  pi:inputFormat    "xes" .
