# Pass witness for wasm4pm-algorithms-pack: one minimal VALID algorithm
# individual. gates/010_required.rq, 020_single_valued.rq,
# 030_value_constraints.rq must all be SILENT against the pack vocabulary +
# this graph. Proves the gates can pass a conforming individual (not merely an
# empty graph).
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix pi:   <https://wasm4pm.dev/pi#> .

pi:Algo_witness_pass a pi:ProcessIntelligenceAlgorithm ;
  pi:algorithmId    "witness_pass" ;
  pi:algorithmLabel "WitnessPass" ;
  pi:algorithmDoc   "Minimal valid witness individual for the algorithms gates." ;
  pi:citation       "Witness, 2026." ;
  pi:outputType     "dfg" ;
  pi:category       "discovery" ;
  pi:speedTier      3 ;
  pi:qualityTier    60 ;
  pi:wasmExport     "witness_pass" ;
  pi:inputFormat    "xes" .
