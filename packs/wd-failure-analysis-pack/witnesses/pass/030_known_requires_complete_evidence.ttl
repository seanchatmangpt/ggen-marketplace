@prefix wdfa: <https://ggen.dev/ontology/wd-fa#> .
wdfa:D a wdfa:Drive .
wdfa:E a wdfa:EvidenceArtifact .
wdfa:M a wdfa:FailureMode .
wdfa:GoodKnown a wdfa:FailureCase ;
  wdfa:subjectDrive wdfa:D ;
  wdfa:standingState "KNOWN" ;
  wdfa:evidenceCompleteness 1.0 ;
  wdfa:admittedMode wdfa:M ;
  wdfa:hasEvidence wdfa:E .
