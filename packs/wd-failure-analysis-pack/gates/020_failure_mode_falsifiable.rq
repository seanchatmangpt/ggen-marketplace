# MESSAGE: every FailureMode must have both applicability conditions and an explicit falsifier.
PREFIX wdfa: <https://ggen.dev/ontology/wd-fa#>
SELECT ?mode ?missing WHERE {
  ?mode a wdfa:FailureMode .
  VALUES ?missing { wdfa:applicabilityCondition wdfa:falsifier }
  FILTER NOT EXISTS { ?mode ?missing ?value }
}
ORDER BY ?mode ?missing
