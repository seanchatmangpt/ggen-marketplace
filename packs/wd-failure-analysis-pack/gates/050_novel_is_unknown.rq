# MESSAGE: zero applicable known candidates must remain UNKNOWN rather than collapse to a known mode.
PREFIX wdfa: <https://ggen.dev/ontology/wd-fa#>
SELECT ?case ?standing WHERE {
  ?case a wdfa:FailureCase ;
        wdfa:knownCandidateCount 0 ;
        wdfa:standingState ?standing .
  FILTER (?standing != "UNKNOWN")
}
ORDER BY ?case
