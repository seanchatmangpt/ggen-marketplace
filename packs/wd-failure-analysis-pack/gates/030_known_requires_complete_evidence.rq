# MESSAGE: KNOWN requires complete evidence, at least one admitted mode, and at least one evidence artifact.
PREFIX wdfa: <https://ggen.dev/ontology/wd-fa#>
SELECT ?case ?problem WHERE {
  ?case a wdfa:FailureCase ; wdfa:standingState "KNOWN" .
  {
    FILTER NOT EXISTS { ?case wdfa:evidenceCompleteness ?ec . FILTER(?ec >= 1.0) }
    BIND("evidence incomplete" AS ?problem)
  } UNION {
    FILTER NOT EXISTS { ?case wdfa:admittedMode ?mode }
    BIND("no admitted mode" AS ?problem)
  } UNION {
    FILTER NOT EXISTS { ?case wdfa:hasEvidence ?evidence }
    BIND("no evidence" AS ?problem)
  }
}
ORDER BY ?case ?problem
