# MESSAGE: every FailureCase must bind exact subject, symptom, evidence completeness, standing, producer, and verifier.
PREFIX wdfa: <https://ggen.dev/ontology/wd-fa#>
SELECT ?case ?missing WHERE {
  ?case a wdfa:FailureCase .
  VALUES ?missing {
    wdfa:subjectDrive wdfa:reportedSymptom wdfa:evidenceCompleteness
    wdfa:standingState wdfa:producerId wdfa:verifierId
  }
  FILTER NOT EXISTS { ?case ?missing ?value }
}
ORDER BY ?case ?missing
