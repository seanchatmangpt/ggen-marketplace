@prefix wdfa: <https://ggen.dev/ontology/wd-fa#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wdfa:FailureCaseShape a sh:NodeShape ;
    sh:targetClass wdfa:FailureCase ;
    sh:property wdfa:FailureCaseSubjectDriveShape,
                wdfa:FailureCaseSymptomShape,
                wdfa:FailureCaseEvidenceCompletenessShape,
                wdfa:FailureCaseStandingShape,
                wdfa:FailureCaseProducerShape,
                wdfa:FailureCaseVerifierShape .

wdfa:FailureCaseSubjectDriveShape a sh:PropertyShape ;
    sh:path wdfa:subjectDrive ; sh:minCount 1 ; sh:maxCount 1 .
wdfa:FailureCaseSymptomShape a sh:PropertyShape ;
    sh:path wdfa:reportedSymptom ; sh:minCount 1 ; sh:datatype xsd:string .
wdfa:FailureCaseEvidenceCompletenessShape a sh:PropertyShape ;
    sh:path wdfa:evidenceCompleteness ; sh:minCount 1 ; sh:datatype xsd:decimal .
wdfa:FailureCaseStandingShape a sh:PropertyShape ;
    sh:path wdfa:standingState ; sh:minCount 1 ; sh:datatype xsd:string .
wdfa:FailureCaseProducerShape a sh:PropertyShape ;
    sh:path wdfa:producerId ; sh:minCount 1 ; sh:datatype xsd:string .
wdfa:FailureCaseVerifierShape a sh:PropertyShape ;
    sh:path wdfa:verifierId ; sh:minCount 1 ; sh:datatype xsd:string .

wdfa:FailureModeShape a sh:NodeShape ;
    sh:targetClass wdfa:FailureMode ;
    sh:property wdfa:FailureModeApplicabilityShape, wdfa:FailureModeFalsifierShape .
wdfa:FailureModeApplicabilityShape a sh:PropertyShape ;
    sh:path wdfa:applicabilityCondition ; sh:minCount 1 .
wdfa:FailureModeFalsifierShape a sh:PropertyShape ;
    sh:path wdfa:falsifier ; sh:minCount 1 .
