@prefix wdfa: <https://ggen.dev/ontology/wd-fa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix do: <https://ggen.dev/ontology/decision-optionality#> .
@prefix pi: <https://ggen.dev/ontology/process-intelligence#> .
@prefix es: <https://ggen.dev/ontology/evidence-standing#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wdfa:Drive a rdfs:Class .
wdfa:FailureCase a rdfs:Class .
wdfa:Lot a rdfs:Class .
wdfa:Component a rdfs:Class .
wdfa:Supplier a rdfs:Class .
wdfa:BOMRevision a rdfs:Class .
wdfa:FirmwareRevision a rdfs:Class .
wdfa:ProductionLine a rdfs:Class .
wdfa:TestStation a rdfs:Class .
wdfa:TestRun a rdfs:Class .
wdfa:Rework a rdfs:Class .
wdfa:EvidenceArtifact a rdfs:Class ; rdfs:subClassOf prov:Entity .
wdfa:FailureMode a rdfs:Class ; rdfs:subClassOf do:Candidate .
wdfa:KnownIssue a rdfs:Class .
wdfa:DiagnosticAction a rdfs:Class .
wdfa:Disposition a rdfs:Class .
wdfa:CorrectiveAction a rdfs:Class .
wdfa:ApplicabilityCondition a rdfs:Class .
wdfa:Exclusion a rdfs:Class .
wdfa:Falsifier a rdfs:Class ; rdfs:subClassOf do:Falsifier .
wdfa:WorkOrder a rdfs:Class .

wdfa:serial a rdf:Property ; rdfs:domain wdfa:Drive ; rdfs:range xsd:string .
wdfa:reportedSymptom a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range xsd:string .
wdfa:subjectDrive a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range wdfa:Drive .
wdfa:inLot a rdf:Property .
wdfa:hasComponent a rdf:Property .
wdfa:supplier a rdf:Property .
wdfa:bomRevision a rdf:Property .
wdfa:firmwareRevision a rdf:Property .
wdfa:productionLine a rdf:Property .
wdfa:testStation a rdf:Property .
wdfa:hasTestRun a rdf:Property .
wdfa:hasRework a rdf:Property .
wdfa:hasEvidence a rdf:Property ; rdfs:subPropertyOf es:provenance .
wdfa:candidateMode a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range wdfa:FailureMode .
wdfa:admittedMode a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range wdfa:FailureMode .
wdfa:requiresEvidence a rdf:Property ; rdfs:domain wdfa:FailureMode ; rdfs:range wdfa:EvidenceArtifact .
wdfa:applicabilityCondition a rdf:Property ; rdfs:domain wdfa:FailureMode ; rdfs:range wdfa:ApplicabilityCondition .
wdfa:exclusion a rdf:Property ; rdfs:domain wdfa:FailureMode ; rdfs:range wdfa:Exclusion .
wdfa:falsifier a rdf:Property ; rdfs:domain wdfa:FailureMode ; rdfs:range wdfa:Falsifier .
wdfa:nextAction a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range wdfa:DiagnosticAction .
wdfa:disposition a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range wdfa:Disposition .
wdfa:correctiveAction a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range wdfa:CorrectiveAction .
wdfa:evidenceCompleteness a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range xsd:decimal .
wdfa:confidence a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range xsd:decimal .
wdfa:standingState a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range xsd:string .
wdfa:knownCandidateCount a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range xsd:integer .
wdfa:producerId a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range xsd:string .
wdfa:verifierId a rdf:Property ; rdfs:domain wdfa:FailureCase ; rdfs:range xsd:string .
wdfa:evidenceDigest a rdf:Property ; rdfs:domain wdfa:EvidenceArtifact ; rdfs:range xsd:string .
wdfa:ocelObjectType a rdf:Property ; rdfs:range xsd:string .
wdfa:ocelEventType a rdf:Property ; rdfs:range xsd:string .
wdfa:semanticDefinition a rdf:Property ; rdfs:range xsd:string .

wdfa:Drive-A-001 a wdfa:Drive ;
    wdfa:serial "WD-A-001" ;
    wdfa:inLot wdfa:Lot-A ;
    wdfa:firmwareRevision wdfa:FW-1 ;
    wdfa:productionLine wdfa:Line-1 .
wdfa:Lot-A a wdfa:Lot .
wdfa:FW-1 a wdfa:FirmwareRevision .
wdfa:Line-1 a wdfa:ProductionLine .
wdfa:Evidence-A-001 a wdfa:EvidenceArtifact ;
    wdfa:evidenceDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" .
wdfa:Action-A-001 a wdfa:DiagnosticAction .
wdfa:Applicability-A a wdfa:ApplicabilityCondition .
wdfa:Falsifier-A a wdfa:Falsifier .
wdfa:Mode-A a wdfa:FailureMode ;
    wdfa:applicabilityCondition wdfa:Applicability-A ;
    wdfa:falsifier wdfa:Falsifier-A ;
    wdfa:requiresEvidence wdfa:Evidence-A-001 .
wdfa:Case-A-001 a wdfa:FailureCase ;
    wdfa:subjectDrive wdfa:Drive-A-001 ;
    wdfa:reportedSymptom "spin-up timeout" ;
    wdfa:hasEvidence wdfa:Evidence-A-001 ;
    wdfa:candidateMode wdfa:Mode-A ;
    wdfa:admittedMode wdfa:Mode-A ;
    wdfa:nextAction wdfa:Action-A-001 ;
    wdfa:evidenceCompleteness 1.0 ;
    wdfa:confidence 0.91 ;
    wdfa:standingState "KNOWN" ;
    wdfa:knownCandidateCount 1 ;
    wdfa:producerId "candidate-engine" ;
    wdfa:verifierId "independent-verifier" .

wdfa:Drive-X-001 a wdfa:Drive ; wdfa:serial "WD-X-001" .
wdfa:Evidence-X-001 a wdfa:EvidenceArtifact ;
    wdfa:evidenceDigest "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" .
wdfa:Action-X-001 a wdfa:DiagnosticAction .
wdfa:Case-X-001 a wdfa:FailureCase ;
    wdfa:subjectDrive wdfa:Drive-X-001 ;
    wdfa:reportedSymptom "unseen mixed waveform" ;
    wdfa:hasEvidence wdfa:Evidence-X-001 ;
    wdfa:nextAction wdfa:Action-X-001 ;
    wdfa:evidenceCompleteness 0.6 ;
    wdfa:confidence 0.31 ;
    wdfa:standingState "UNKNOWN" ;
    wdfa:knownCandidateCount 0 ;
    wdfa:producerId "candidate-engine" ;
    wdfa:verifierId "independent-verifier" .
