---
to: "environments/app-dev/kustomization.yaml"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}# =============================================================================
# environments/app-dev/kustomization.yaml — App-Dev Overlay
# =============================================================================
# Overlay for the app-dev environment. Deploy here only after platform-sandbox
# validation succeeds and a SEMVER tag has been pushed to platform-core.
# =============================================================================

apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../base/helm-repos.yaml
  - ../base/istio-helm.yaml

patches:
  - path: istio.yaml

labels:
  - pairs:
      env: app-dev
    includeSelectors: true
    includeTemplates: true
{% endraw %}