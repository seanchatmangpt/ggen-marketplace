---
to: "prometheus-gatekeeper-config.yaml"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}# Chapter 11: Prometheus Configuration for Gatekeeper Metrics
# Listing 11.9 - Scrape configuration for Gatekeeper audit metrics
# Configures Prometheus to collect policy violation data from Gatekeeper.

apiVersion: v1
kind: ConfigMap
metadata:
  name: prometheus-gatekeeper
  namespace: monitoring
data:
  gatekeeper.yml: |
    global:
      scrape_interval: 30s
    scrape_configs:
      - job_name: 'gatekeeper'
        static_configs:
          - targets:
              - ['gatekeeper-audit.gatekeeper-system:8888']
{% endraw %}