---
to: "secrets-setup/github_secrets.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "object": "item",
  "type": 1,
  "name": "GitHub Secrets",
  "notes": "Pulumi GitHub provider authentication token for infrastructure-as-code automation. Used to manage GitHub resources like repositories, teams, and deployment settings.",
  "fields": [
    {
      "type": 0,
      "name": "pulumi-github-token",
      "value": "ghp_your_github_personal_access_token_here",
      "linkedId": null
    }
  ],
  "login": {
    "username": "your_github_org_name",
    "password": "ghp_your_github_personal_access_token_here",
    "uris": [
      {
        "match": null,
        "uri": "https://github.com"
      }
    ]
  },
  "favorite": false
}
{% endraw %}