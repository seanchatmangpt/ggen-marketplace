---
to: "platform-gitops/environments/platform-sandbox/tenants/kustomization.yaml"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}# =============================================================================
# platform-gitops/environments/platform-sandbox/tenants/kustomization.yaml
# =============================================================================
# Lists every tenant the platform manages in the platform-sandbox environment.
# Add a new folder entry here when onboarding a new team.
# =============================================================================

apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - platform-services    # Core platform services (Istio, cert-manager, monitoring)
{% endraw %}