---
to: ".env_example"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}# Bitwarden API Credentials
# This file serves as a template for Bitwarden authentication
# Copy this to .env and fill in your actual credentials
# SECURITY: Keep .env out of version control (add to .gitignore)

# Client ID for Bitwarden API authentication
BW_CLIENTID=your_bitwarden_api_key_client_id

# Client secret for Bitwarden API authentication
BW_CLIENTSECRET=your_bitwarden_api_key_client_secret

# Master password for Bitwarden vault unlock
BW_PASSWORD=your_bitwarden_master_password
{% endraw %}