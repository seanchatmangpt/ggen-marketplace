---
to: "devex_results.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "overall_score": 50,
  "category_scores": {
    "Onboarding": 1.5,
    "Deployment": 2.5,
    "Documentation": 3.0,
    "Developer Tools": 2.67,
    "Feedback Loops": 3.0
  },
  "detailed_responses": {
    "onboarding_time": 1,
    "onboarding_clarity": 2,
    "deployment_ease": 3,
    "deployment_feedback": 2,
    "documentation_quality": 3,
    "documentation_clarity": 3,
    "tooling_satisfaction": 2,
    "api_design": 2,
    "error_messages": 4,
    "feedback_loop": 3
  }
}
{% endraw %}