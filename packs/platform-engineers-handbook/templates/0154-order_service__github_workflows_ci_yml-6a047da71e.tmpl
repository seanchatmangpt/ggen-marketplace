---
to: "order-service/.github/workflows/ci.yml"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}name: CI/CD Pipeline
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
jobs:
  pipeline:
    uses: platform-org/platform-actions/.github/workflows/backend-pipeline.yml@v1
    with:
      service-name: order-service
      node-version: "20"
      deploy-environment: ${{ github.ref == 'refs/heads/main' && 'staging' || 'preview' }}
    secrets:
      registry-token: ${{ secrets.GHCR_TOKEN }}
      kubeconfig: ${{ secrets.KUBECONFIG }}
{% endraw %}