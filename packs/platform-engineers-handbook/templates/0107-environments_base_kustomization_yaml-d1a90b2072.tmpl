---
to: "environments/base/kustomization.yaml"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}# =============================================================================
# environments/base/kustomization.yaml — Base Kustomize Root
# =============================================================================
# Lists all base resources that environment overlays can patch.
# Environment-specific directories (platform-sandbox/, app-dev/, etc.)
# inherit from this base via their own kustomization.yaml.
# =============================================================================

apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - helm-repos.yaml    # HelmRepository sources for all Flux HelmReleases
  - istio-helm.yaml    # Istio base, istiod, and ingress HelmReleases
{% endraw %}