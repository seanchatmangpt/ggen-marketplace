---
to: "pulumi-cluster/Pulumi.yaml"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}name: platform-cluster
runtime:
  name: python
  options:
    virtualenv: venv
description: >
  Chapter 2: Scalable Platform Runtime
  Deploys a local Kind cluster with Istio service mesh and Flux GitOps.

config:
  cluster:name:
    value: platform-dev
  cluster:kubernetesVersion:
    value: "1.28"
  cluster:numWorkerNodes:
    value: 2
  cluster:environment:
    value: dev
{% endraw %}