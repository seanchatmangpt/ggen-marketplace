---
to: "provider-kubernetes-rbac.yaml"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}# provider-kubernetes-rbac.yaml
# Grants provider-kubernetes's service account permission to manage the
# resource kinds Compositions in this pack compose (Namespace, PVC,
# Deployment, Service, Secret, ...). Binds by Group (all ServiceAccounts in
# crossplane-system), not by exact ServiceAccount name, because
# provider-kubernetes's SA name is revision-hashed at install time
# (provider-kubernetes-<hash>) and can't be pinned in a static manifest.
# This is the standard Kubernetes RBAC "all service accounts in a namespace"
# group subject, not a workaround specific to this pack.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: crossplane-provider-kubernetes-admin
subjects:
  - kind: Group
    name: system:serviceaccounts:crossplane-system
    apiGroup: rbac.authorization.k8s.io
roleRef:
  kind: ClusterRole
  name: cluster-admin
  apiGroup: rbac.authorization.k8s.io
{% endraw %}