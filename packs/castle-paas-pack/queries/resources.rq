PREFIX cp: <https://ggen.dev/ontology/castle-paas#>
SELECT ?sequence ?module ?table ?class ?tenantScoped ?authority WHERE {
  ?resource a cp:AshResourceSpec ;
    cp:sequence ?sequence ;
    cp:ashModule ?module ;
    cp:tableName ?table ;
    cp:publicClass ?class ;
    cp:tenantScoped ?tenantScoped ;
    cp:authority ?authority .
}
ORDER BY ?sequence ?module
