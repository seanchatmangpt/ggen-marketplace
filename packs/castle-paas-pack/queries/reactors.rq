PREFIX cp: <https://ggen.dev/ontology/castle-paas#>
SELECT ?sequence ?module ?purpose ?authority ?doBoundary WHERE {
  ?reactor a cp:ReactorSpec ;
    cp:sequence ?sequence ;
    cp:reactorModule ?module ;
    cp:purpose ?purpose ;
    cp:authority ?authority ;
    cp:doBoundary ?doBoundary .
}
ORDER BY ?sequence ?module
