@prefix cp: <https://ggen.dev/ontology/castle-paas#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# cp:* is generator metadata only. Runtime semantic identity is carried by
# public ontology IRIs in cp:publicClass/cp:predicateIri and by AshR2RML.
cp:AshResourceSpec a rdfs:Class .
cp:ReactorSpec a rdfs:Class .
cp:PublicOntology a rdfs:Class .
cp:ashModule a rdf:Property .
cp:tableName a rdf:Property .
cp:publicClass a rdf:Property .
cp:tenantScoped a rdf:Property .
cp:authority a rdf:Property .
cp:sequence a rdf:Property .
cp:reactorModule a rdf:Property .
cp:purpose a rdf:Property .
cp:doBoundary a rdf:Property .
cp:ontologyPrefix a rdf:Property .
cp:ontologyIri a rdf:Property .
cp:required a rdf:Property .
cp:sourceCommit a rdf:Property .
cp:kernelCommit a rdf:Property .

cp:castle-paas-profile a prov:Plan ;
  dcterms:title "CASTLE Ash PaaS Profile" ;
  dcterms:conformsTo <https://www.w3.org/TR/prov-o/> ,
    <https://www.w3.org/TR/odrl-model/> ,
    <https://www.w3.org/TR/vocab-dcat-3/> ,
    <https://www.w3.org/TR/shacl/> ,
    <https://www.w3.org/TR/vocab-ssn/> ;
  cp:sourceCommit "ash_r2rml@067954ad406fd637fd47646bdb10c4580809c79d" ;
  cp:kernelCommit "castle@5059c45a8ef007cd1e095213c729c8bfe6db9e79" .

# Public ontology manifest.
cp:ontology-prov a cp:PublicOntology ; cp:ontologyPrefix "prov" ; cp:ontologyIri "http://www.w3.org/ns/prov#" ; cp:required true .
cp:ontology-odrl a cp:PublicOntology ; cp:ontologyPrefix "odrl" ; cp:ontologyIri "http://www.w3.org/ns/odrl/2/" ; cp:required true .
cp:ontology-dcat a cp:PublicOntology ; cp:ontologyPrefix "dcat" ; cp:ontologyIri "http://www.w3.org/ns/dcat#" ; cp:required true .
cp:ontology-dcterms a cp:PublicOntology ; cp:ontologyPrefix "dcterms" ; cp:ontologyIri "http://purl.org/dc/terms/" ; cp:required true .
cp:ontology-skos a cp:PublicOntology ; cp:ontologyPrefix "skos" ; cp:ontologyIri "http://www.w3.org/2004/02/skos/core#" ; cp:required true .
cp:ontology-sosa a cp:PublicOntology ; cp:ontologyPrefix "sosa" ; cp:ontologyIri "http://www.w3.org/ns/sosa/" ; cp:required true .
cp:ontology-ssn a cp:PublicOntology ; cp:ontologyPrefix "ssn" ; cp:ontologyIri "http://www.w3.org/ns/ssn/" ; cp:required true .
cp:ontology-qudt a cp:PublicOntology ; cp:ontologyPrefix "qudt" ; cp:ontologyIri "http://qudt.org/schema/qudt/" ; cp:required true .
cp:ontology-shacl a cp:PublicOntology ; cp:ontologyPrefix "sh" ; cp:ontologyIri "http://www.w3.org/ns/shacl#" ; cp:required true .
cp:ontology-rdf a cp:PublicOntology ; cp:ontologyPrefix "rdf" ; cp:ontologyIri "http://www.w3.org/1999/02/22-rdf-syntax-ns#" ; cp:required true .
cp:ontology-rdfs a cp:PublicOntology ; cp:ontologyPrefix "rdfs" ; cp:ontologyIri "http://www.w3.org/2000/01/rdf-schema#" ; cp:required true .
cp:ontology-owl a cp:PublicOntology ; cp:ontologyPrefix "owl" ; cp:ontologyIri "http://www.w3.org/2002/07/owl#" ; cp:required true .
cp:ontology-schema a cp:PublicOntology ; cp:ontologyPrefix "schema" ; cp:ontologyIri "https://schema.org/" ; cp:required true .
cp:ontology-uco a cp:PublicOntology ; cp:ontologyPrefix "uco" ; cp:ontologyIri "https://ontology.unifiedcyberontology.org/uco/" ; cp:required false .
cp:ontology-case a cp:PublicOntology ; cp:ontologyPrefix "case" ; cp:ontologyIri "https://ontology.caseontology.org/case/" ; cp:required false .

# Ash resource topology. Public classes are semantic identities; cp metadata is
# only deterministic generation configuration.
cp:organization a cp:AshResourceSpec ; cp:sequence 10 ; cp:ashModule "CastlePaaS.Organization" ; cp:tableName "castle_organizations" ; cp:publicClass "https://schema.org/Organization" ; cp:tenantScoped false ; cp:authority "ADMIN" .
cp:platform-service a cp:AshResourceSpec ; cp:sequence 20 ; cp:ashModule "CastlePaaS.PlatformService" ; cp:tableName "castle_platform_services" ; cp:publicClass "http://www.w3.org/ns/dcat#DataService" ; cp:tenantScoped true ; cp:authority "CATALOG" .
cp:subject a cp:AshResourceSpec ; cp:sequence 30 ; cp:ashModule "CastlePaaS.Subject" ; cp:tableName "castle_subjects" ; cp:publicClass "http://www.w3.org/ns/prov#Entity" ; cp:tenantScoped true ; cp:authority "OBSERVE" .
cp:observation a cp:AshResourceSpec ; cp:sequence 40 ; cp:ashModule "CastlePaaS.Observation" ; cp:tableName "castle_observations" ; cp:publicClass "http://www.w3.org/ns/sosa/Observation" ; cp:tenantScoped true ; cp:authority "OBSERVE" .
cp:admission a cp:AshResourceSpec ; cp:sequence 50 ; cp:ashModule "CastlePaaS.Admission" ; cp:tableName "castle_admissions" ; cp:publicClass "http://www.w3.org/ns/prov#Activity" ; cp:tenantScoped true ; cp:authority "ADMIT_ONLY" .
cp:plan a cp:AshResourceSpec ; cp:sequence 60 ; cp:ashModule "CastlePaaS.Plan" ; cp:tableName "castle_plans" ; cp:publicClass "http://www.w3.org/ns/prov#Plan" ; cp:tenantScoped true ; cp:authority "CONSTRUCT_ONLY" .
cp:execution-intent a cp:AshResourceSpec ; cp:sequence 70 ; cp:ashModule "CastlePaaS.ExecutionIntent" ; cp:tableName "castle_execution_intents" ; cp:publicClass "http://www.w3.org/ns/odrl/2/Request" ; cp:tenantScoped true ; cp:authority "INTENT_ONLY" .
cp:evidence a cp:AshResourceSpec ; cp:sequence 80 ; cp:ashModule "CastlePaaS.Evidence" ; cp:tableName "castle_evidence" ; cp:publicClass "http://www.w3.org/ns/prov#Entity" ; cp:tenantScoped true ; cp:authority "EVIDENCE_ONLY" .
cp:receipt a cp:AshResourceSpec ; cp:sequence 90 ; cp:ashModule "CastlePaaS.Receipt" ; cp:tableName "castle_receipts" ; cp:publicClass "http://www.w3.org/ns/prov#Entity" ; cp:tenantScoped true ; cp:authority "RECEIPT_ONLY" .
cp:replay a cp:AshResourceSpec ; cp:sequence 100 ; cp:ashModule "CastlePaaS.Replay" ; cp:tableName "castle_replays" ; cp:publicClass "http://www.w3.org/ns/prov#Activity" ; cp:tenantScoped true ; cp:authority "VERIFY_ONLY" .
cp:capability a cp:AshResourceSpec ; cp:sequence 110 ; cp:ashModule "CastlePaaS.Capability" ; cp:tableName "castle_capabilities" ; cp:publicClass "http://www.w3.org/2004/02/skos/core#Concept" ; cp:tenantScoped false ; cp:authority "CATALOG" .

# Reactor topology. Only execute-intent reaches consequential DO, and then only
# through the CASTLE kernel's existing admitted BRCE boundary.
cp:reactor-register-subject a cp:ReactorSpec ; cp:sequence 10 ; cp:reactorModule "CastlePaaS.Reactors.RegisterSubject" ; cp:purpose "register subject and semantic identity" ; cp:authority "OBSERVE_ONLY" ; cp:doBoundary false .
cp:reactor-admit-subject a cp:ReactorSpec ; cp:sequence 20 ; cp:reactorModule "CastlePaaS.Reactors.AdmitSubject" ; cp:purpose "observe, compile semantic projection, validate, and request kernel admission" ; cp:authority "ADMIT_ONLY" ; cp:doBoundary false .
cp:reactor-construct-intent a cp:ReactorSpec ; cp:sequence 30 ; cp:reactorModule "CastlePaaS.Reactors.ConstructIntent" ; cp:purpose "manufacture inert execution intent from admitted subject" ; cp:authority "CONSTRUCT_ONLY" ; cp:doBoundary false .
cp:reactor-execute-intent a cp:ReactorSpec ; cp:sequence 40 ; cp:reactorModule "CastlePaaS.Reactors.ExecuteIntent" ; cp:purpose "obtain BRCE prepare receipt, execute approved adapter, obtain outcome receipt" ; cp:authority "BRCE_ONLY" ; cp:doBoundary true .
cp:reactor-qualify-evidence a cp:ReactorSpec ; cp:sequence 50 ; cp:reactorModule "CastlePaaS.Reactors.QualifyEvidence" ; cp:purpose "align evidence to public ontology graph and compute standing" ; cp:authority "EVIDENCE_ONLY" ; cp:doBoundary false .
cp:reactor-replay-receipt a cp:ReactorSpec ; cp:sequence 60 ; cp:reactorModule "CastlePaaS.Reactors.ReplayReceipt" ; cp:purpose "verify receipt identity and deterministic replay correspondence" ; cp:authority "VERIFY_ONLY" ; cp:doBoundary false .
cp:reactor-publish-projection a cp:ReactorSpec ; cp:sequence 70 ; cp:reactorModule "CastlePaaS.Reactors.PublishProjection" ; cp:purpose "manufacture API and semantic projections through ggen" ; cp:authority "CONSTRUCT_ONLY" ; cp:doBoundary false .
