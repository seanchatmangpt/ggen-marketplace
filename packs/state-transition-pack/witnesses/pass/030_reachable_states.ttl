# PASS witness for verify/030_reachable_states.unbound.rq -- expected 0 rows.
# Both states are reachable from the initial state via one transition.
@prefix st: <https://ggen.dev/ontology/state-transition#> .
@prefix w: <https://example.org/witness/> .

w:machine-c a st:Machine ; st:initial w:c-state-0 .
w:c-state-0 a st:State ; st:inMachine w:machine-c ; st:seq 0 .
w:c-state-1 a st:State ; st:inMachine w:machine-c ; st:seq 1 .
w:c-t-0-1 a st:Transition ; st:from w:c-state-0 ; st:to w:c-state-1 .
