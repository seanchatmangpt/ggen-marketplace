# PASS witness for verify/020_no_skipped_transitions.unbound.rq -- expected 0 rows.
# One machine, one "advance" transition from seq 0 to seq 1: lawful.
@prefix st: <https://ggen.dev/ontology/state-transition#> .
@prefix w: <https://example.org/witness/> .

w:machine-a a st:Machine ; st:initial w:state-0 .
w:state-0 a st:State ; st:inMachine w:machine-a ; st:seq 0 .
w:state-1 a st:State ; st:inMachine w:machine-a ; st:seq 1 .
w:advance-0-1 a st:Transition ; st:kind "advance" ;
    st:from w:state-0 ; st:to w:state-1 .
