# PASS witness for verify/010_no_skipping_executed.unbound.rq -- expected 0 rows.
# The VerifiedState is directly preceded by a real ExecutedState: no stage
# is skipped, the gate must stay silent.
@prefix st: <https://ggen.dev/ontology/state-transition#> .
@prefix w: <https://example.org/witness/> .

w:exec-001 a st:ExecutedState .
w:verified-001 a st:VerifiedState .
w:exec-001 st:precedes w:verified-001 .
