# PASS witness for verify/040_chain_policy_supported.unbound.rq -- expected 0 rows.
# The active (only) policy chooses sha256 for "py" and a real st:HashImpl
# exists for sha256/py.
@prefix st: <https://ggen.dev/ontology/state-transition#> .
@prefix w: <https://example.org/witness/> .

w:policy-ok a st:ChainPolicy ; st:chosenAlgo "sha256" ; st:policyPrecedence 0 ;
    st:policyLanguage "py" .
w:sha256-py a st:HashImpl ; st:implAlgo "sha256" ; st:implLanguage "py" .
