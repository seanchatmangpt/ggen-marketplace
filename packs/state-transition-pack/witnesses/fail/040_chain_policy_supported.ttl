# FAIL witness for verify/040_chain_policy_supported.unbound.rq -- expected >= 1 row.
# The active (only, hence highest-precedence) policy chooses sha256 for "ex"
# but no st:HashImpl exists for sha256/ex: unsupported pair, gate 040 fires.
@prefix st: <https://ggen.dev/ontology/state-transition#> .
@prefix w: <https://example.org/witness/> .

w:policy-bad a st:ChainPolicy ; st:chosenAlgo "sha256" ; st:policyPrecedence 0 ;
    st:policyLanguage "ex" .
w:sha256-ts a st:HashImpl ; st:implAlgo "sha256" ; st:implLanguage "ts" .
