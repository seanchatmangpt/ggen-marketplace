# FAIL witness for verify/030_reachable_states.unbound.rq -- expected >= 1 row.
# State c-orphan (seq 1) has no transition leading to it from the initial
# state: unreachable, gate 030 must fire.
@prefix st: <https://ggen.dev/ontology/state-transition#> .
@prefix w: <https://example.org/witness/> .

w:machine-d a st:Machine ; st:initial w:d-state-0 .
w:d-state-0 a st:State ; st:inMachine w:machine-d ; st:seq 0 .
w:d-orphan a st:State ; st:inMachine w:machine-d ; st:seq 1 .
