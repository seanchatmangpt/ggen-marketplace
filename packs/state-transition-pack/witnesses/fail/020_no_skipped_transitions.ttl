# FAIL witness for verify/020_no_skipped_transitions.unbound.rq -- expected >= 1 row.
# An "advance" transition from seq 0 to seq 2 (same machine): the seq-1
# state was skipped, gate 020 must fire.
@prefix st: <https://ggen.dev/ontology/state-transition#> .
@prefix w: <https://example.org/witness/> .

w:machine-b a st:Machine ; st:initial w:b-state-0 .
w:b-state-0 a st:State ; st:inMachine w:machine-b ; st:seq 0 .
w:b-state-2 a st:State ; st:inMachine w:machine-b ; st:seq 2 .
w:advance-0-2 a st:Transition ; st:kind "advance" ;
    st:from w:b-state-0 ; st:to w:b-state-2 .
