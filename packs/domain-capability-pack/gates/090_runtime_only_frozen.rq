# MESSAGE: Plan != Execution. A qce:RuntimeEpisode (observed execution) may execute
# only FROZEN realizations -- a dcp:Realization that is a qce:FrozenCapability
# (qce:frozen true), i.e. a version that passed qualification and was frozen into an
# execution closure. Any row = an episode claiming to have executed a realization
# that was never frozen: a Plan (candidate/qualified declaration) masquerading as an
# Execution. Inspection != execution; a declared capability never executed anything.
PREFIX dcp: <https://ggen.dev/ontology/domain-capability#>
PREFIX qce: <https://ggen.dev/ontology/qualified-capability-ecology#>
SELECT ?episode ?realization WHERE {
  ?episode a qce:RuntimeEpisode ;
      qce:executedCapability ?realization .
  ?realization a dcp:Realization .
  FILTER NOT EXISTS { ?realization qce:frozen true }
}
ORDER BY ?episode ?realization
