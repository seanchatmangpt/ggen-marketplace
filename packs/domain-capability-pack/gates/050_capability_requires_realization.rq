# MESSAGE: every dcp:DomainCapability must have at least one dcp:Realization bound
# through dcp:realizes. Any row = a declared capability with no qualified implementing
# binding -- a capability the resolver could never select a provider for. A capability
# declaration is a Plan: without a realization it is not even a selectable plan, and
# the pack refuses to admit it as a selectability claim.
PREFIX dcp: <https://ggen.dev/ontology/domain-capability#>
SELECT ?capability WHERE {
  ?capability a dcp:DomainCapability .
  FILTER NOT EXISTS {
    ?realization a dcp:Realization ; dcp:realizes ?capability .
  }
}
ORDER BY ?capability
