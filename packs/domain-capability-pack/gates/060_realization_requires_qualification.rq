# MESSAGE: every dcp:Realization must carry at least one dcp:qualificationCondition
# -- the condition under which it qualifies for selection (the resolver's qualify/2
# analogue, ~/ash_pplan/lib/ash_pplan/provider.ex: "Qualify for a requirement in a
# context; {:error, reason} removes the candidate"). Any row = a realization asserted
# as qualified with NO stated conditions -- an unconditioned qualification claim,
# which is how acceptance mocks enter a graph. Realization-without-qualification-
# conditions is refused.
PREFIX dcp: <https://ggen.dev/ontology/domain-capability#>
SELECT ?realization WHERE {
  ?realization a dcp:Realization .
  FILTER NOT EXISTS { ?realization dcp:qualificationCondition ?condition }
}
ORDER BY ?realization
