# --- Lab-projection: autofde-lab's real, current allowlist -------------
#
# Transcribed verbatim from ~/autofde-lab/src/autofde_lab/fabric/gymact_capabilities.toml
# (confirmed by direct read this session): 5 entries, a strict subset of the 14 above.
# NOTE the real, already-happened drift this pack's gates would have caught: that TOML
# file's own header comment currently asserts "5 entries; there is no jaeger/loki/
# prometheus capability in the real gymact source -- only these 5 exist" -- true when
# written, false now that the real source has grown to 14. This pack does not fix that
# file (different repo, named follow-up); admitting the real facts here is what proves
# gates/030_allowlist_subset.rq would catch a REGRESSION (an allowlist entry that isn't
# a real Capability), even though it cannot retroactively catch a manifest going STALE
# by omission (the toml's comment describing "only 5 exist" isn't itself a graph fact
# this pack can check) -- a real, honestly-stated limit of this pack's current gates,
# not glossed over.

dcp:autofde-lab-sregym-allowlist a dcp:LabAllowlist ;
    dcp:ownerRepo "autofde-lab" ;
    dcp:allows dcp:sregym-observe-cluster-state, dcp:sregym-run-kubectl,
        dcp:sregym-get-benchmark-status, dcp:sregym-submit-diagnosis,
        dcp:sregym-submit-mitigation .

#################################################################
# CONTRACT LAYER (v0.2.0, 2026-09-30) -- the DOMAIN family capability
# contract consumable by a capability-resolution engine (consumer:
# ash_pplan v26.9.30, built in parallel; provider contract read at
# ~/ash_pplan/lib/ash_pplan/provider.ex and
# ~/ash_pplan/lib/ash_pplan/providers/resolver.ex, 2026-09-30).
#
# Composition, not reinvention:
#   qce: (packs/qualified-capability-ecology-pack) supplies the lifecycle:
#   a realization IS a qce:QualifiedCapability (a qualified capability
#   VERSION), and execution is qce:RuntimeEpisode executing only frozen
#   versions. dcp: supplies exactly what qce lacks for the DOMAIN family:
#   stable semantic identity + family-scoped contract fields + the
#   semantic-identity -> realization edge. prov/dcterms/skos/xsd are the
#   public substrate (RESOLUTIONS.md: public vocabularies before custom).
#
# CAPABILITY != IMPLEMENTATION (pinned lane rule): a dcp:DomainCapability
# is semantic identity only (e.g. Domain.Action.Invoke). A dcp:Realization
# is one qualified implementing binding (package + module + pin policy +
# qualification conditions). Plans target capabilities; the resolver
# selects realizations; selection never grants authority (resolver.ex:
# "availability is not authority").
#
# Invariants encoded here and refused by gates:
#   Plan != Execution            -> gates/090_runtime_only_frozen.rq
#   Policy != Authority          -> gates/080_no_do_authority.rq
#   ProviderAvailable != Authorized -> gates/070_availability_requires_authority.rq
#   capability without realization / realization without qualification
#                                -> gates/050_..., gates/060_...
#   Projection != Source, Generated != Admitted: this graph is admitted
#   source-of-record for the DOMAIN family; projections rendered from it
#   (templates/) are consequences and never re-admitted as source.
#################################################################

dcp:DomainCapability a rdfs:Class ;
    rdfs:label "Stable semantic identity of one DOMAIN-family capability, carried as the pinned dotted ID (rdfs:label and dcterms:identifier, e.g. \"Domain.Action.Invoke\"). Deliberately a SIBLING of dcp:Capability (the transcription class), not a subclass: gate 010's required-fields contract is keyed to direct dcp:Capability transcription facts (order/slug/worldBinding/sourceRepo/sourceFile) which a semantic identity must not fabricate; the contract layer carries its own required-fields gate (gates/040_required_contract_fields.rq). A declaration is a Plan: it never executes and never grants authority." .

dcp:Realization a rdfs:Class ;
    rdfs:subClassOf qce:QualifiedCapability ;
    rdfs:label "One qualified implementing binding of a dcp:DomainCapability: a provider package + module (+ version-pin policy + qualification conditions + evidence kinds). Composition point with qce:: qce: has receipts qualifying capability versions (qce:qualifies) but no stable-semantic-identity-to-realization edge -- that missing edge is dcp:realizes (failed edge recorded). Selection of a realization never grants authority (ProviderAvailable != Authorized)." .

dcp:realizes a rdf:Property ;
    rdfs:domain dcp:Realization ;
    rdfs:range dcp:DomainCapability ;
    rdfs:comment "FAILED EDGE (public set): qce:qualifies binds a QualificationReceipt to a capability version; qce:replacesCapability/originalCapability bind substitutions; no public term (prov/dcterms/skos/qce) expresses 'this qualified capability version realizes this stable semantic identity'. Minted as the family's one missing edge; everything else about the lifecycle is reused from qce:." .

dcp:authorityRequirement a rdf:Property ;
    rdfs:domain dcp:DomainCapability ;
    rdfs:comment "FAILED EDGE (public set): ODRL expresses permissions/policies over assets, not the resolver's closed authority-rank requirement (none < observe < construct, never do) -- ~/ash_pplan/lib/ash_pplan/providers/resolver.ex @authority_rank. Closed enum: \"none\" | \"observe\" | \"construct\". The value \"do\" is REFUSED (gates/080_no_do_authority.rq), mirroring the resolver's own refusal of wanted==:do." .

dcp:precondition a rdf:Property ; rdfs:domain dcp:DomainCapability ;
    rdfs:comment "FAILED EDGE (public set): SHACL sh:condition validates node shapes, not capability preconditions; odrl constraints gate permissions. String form of the precondition the capability contract asserts." .
dcp:postcondition a rdf:Property ; rdfs:domain dcp:DomainCapability ;
    rdfs:comment "FAILED EDGE (public set): same reasoning as dcp:precondition. String form of the postcondition the capability contract asserts." .

dcp:outcome a rdf:Property ; rdfs:domain dcp:DomainCapability ;
    rdfs:comment "FAILED EDGE (public set): earl:TestResult asserts test outcomes, not the outcome SET a capability may produce. Values are prefixed strings: \"success: ...\", \"failure: <typed failure class>\", \"nondeterministic: ...\" -- success + typed failures + the nondeterministic set, per the pinned capability-contract shape." .

dcp:acceptsInput a rdf:Property ; rdfs:domain dcp:DomainCapability ;
    rdfs:comment "FAILED EDGE (public set): no prov/dcterms/skos/earl term expresses a capability's input signature. String form; the implementing step's real options are the ground truth (see realizations)." .
dcp:producesOutput a rdf:Property ; rdfs:domain dcp:DomainCapability ;
    rdfs:comment "FAILED EDGE (public set): no public term expresses a capability's output signature. String form." .

dcp:executionProperty a rdf:Property ;
    rdfs:comment "Execution property a capability or realization supports (e.g. \"transactional\", \"policy_checked\"). FAILED EDGE (public set): these are the resolver's own property atoms (AshPPlan.Provider.properties/0, observed [:transactional, :policy_checked] on the domain provider); public vocabularies do not name execution properties." .

dcp:evidenceKind a rdf:Property ;
    rdfs:comment "Evidence kind a realization can emit (e.g. \"ash_result\"). FAILED EDGE (public set): earl states assertions about tests, not the evidence kinds a provider emits; the kind atoms are the resolver's own (AshPPlan.Provider.evidence/0)." .

dcp:available a rdf:Property ;
    rdfs:comment "Provider-side operational availability marker on a realization. Available != Authorized: gates/070_availability_requires_authority.rq refuses any available realization whose authority is not bound through qce:authorityEnvelope with a ceiling that admits the capability's dcp:authorityRequirement." .

dcp:providerId a rdf:Property ;
    rdfs:comment "Stable provider id atom as string (AshPPlan.Provider.id/0), e.g. \"domain\"." .
dcp:providerPackage a rdf:Property ;
    rdfs:comment "Real package providing the realization (e.g. \"ash\", \"ash_pplan\"). Provider metadata per RESOLUTIONS.md; never claimed without a local-inspection source note or hex coordinate." .
dcp:providerModule a rdf:Property ;
    rdfs:comment "Real implementing module or function family (e.g. \"Ash.Reactor.ReadStep\", \"AshPPlan.Providers.Steps.DomainAction\", \"Ash.CodeInterface\")." .
dcp:providerVersion a rdf:Property ;
    rdfs:comment "Observed version of providerPackage (e.g. ash 3.33.11 read from ~/ash_pplan/deps/ash/mix.exs @version, 2026-09-30)." .
dcp:providerAlias a rdf:Property ; rdfs:domain dcp:DomainCapability ;
    rdfs:comment "ALIGNMENT FACT: a capability-ID spelling observed on a provider side that maps to this pinned capability (e.g. ash_pplan's current \"Domain.Action\" for Domain.Action.Invoke). Recorded so the consumer's rename to the pinned IDs is an explicit alignment, not a silent break; the pinned ID in dcterms:identifier/rdfs:label remains canonical." .
dcp:versionPinPolicy a rdf:Property ; rdfs:domain dcp:Realization ;
    rdfs:comment "How the provider package is pinned for this realization (RESOLUTIONS.md: realizations carry repo, module, version-pin policy)." .
dcp:qualificationCondition a rdf:Property ; rdfs:domain dcp:Realization ;
    rdfs:comment "Condition under which this realization qualifies for selection (checked by gates/060_realization_requires_qualification.rq: a realization with zero qualification conditions is refused). The implementing step's own policies decide authorization; a condition never bypasses them." .

#################################################################
# Worked instance: the pinned DOMAIN capabilities + realizations.
#
# Pinned IDs (docs/jira/v26.9.30/RESOLUTIONS.md): Domain.Action.Invoke,
# Domain.Query.Read, Domain.Change.Apply. Family siblings minted per the
# lane grant (RESOLUTIONS.md: "Lanes may mint family siblings freely
# inside their own namespace"), each grounded in the real Ash surface
# actually opened read-only on 2026-09-30:
#   ~/ash_pplan @de92fceb8a2567d803689aee69232469be17c2e7
#     lib/ash_pplan/providers/domain.ex            (AshPPlan.Providers.Domain)
#     lib/ash_pplan/providers/steps/domain_action.ex (AshPPlan.Providers.Steps.DomainAction)
#     lib/ash_pplan/provider.ex, lib/ash_pplan/capability.ex,
#     lib/ash_pplan/providers/resolver.ex          (contract + authority rank)
#     deps/ash 3.33.11 (hex constraint "~> 3.33 and >= 3.33.11", mix.exs:40)
#       lib/ash/reactor/reactor.ex (Ash.Reactor), steps/*.ex
#       (Ash.Reactor.{Read,ReadOne,Create,Update,Destroy,BulkCreate,BulkUpdate,
#        BulkDestroy,Action}Step), lib/ash/code_interface.ex (Ash.CodeInterface),
#       lib/ash.ex (Ash.bulk_create/4, Ash.bulk_update/4, Ash.bulk_destroy/4),
#       lib/ash/error/forbidden.ex (Ash.Error.Forbidden), lib/ash/error/invalid/
# qce:artifactDigest / qce:sourceDigest values are REAL sha256 of those files.
#################################################################

# --- Capabilities -----------------------------------------------------

dcp:domain-action-invoke a dcp:DomainCapability ;
    rdfs:label "Domain.Action.Invoke" ;
    dcterms:identifier "Domain.Action.Invoke" ;
    dcp:providerAlias "Domain.Action" ;
    dcp:authorityRequirement "construct" ;
    dcp:precondition "Target resource and action exist in the consumer's compiled Ash domain boundary; the action is a generic (non-CRUD) action; its policies are satisfiable for the given actor." ;
    dcp:postcondition "The action has run to completion and its effects are committed under the action's own transaction semantics; the actor is returned or an error is raised." ;
    dcp:outcome "success: the action's return value" ;
    dcp:outcome "failure: Ash.Error.Forbidden (the action's own policies denied authorization; the realizing step never bypasses them)" ;
    dcp:outcome "failure: Ash.Error.Invalid (invalid/ error classes: invalid input, missing argument)" ;
    dcp:outcome "failure: Ash.Error.Unknown (infrastructure/unexpected failure)" ;
    dcp:outcome "nondeterministic: generic actions may touch external state; re-execution is not guaranteed side-effect-free without the action's own idempotency" ;
    dcp:acceptsInput "resource, action name, input map, optional actor (the implementing step's real surface: Ash.ActionInput.for_action(action, input, opts) then Ash.run_action)" ;
    dcp:producesOutput "action-defined return value" ;
    dcp:executionProperty "policy_checked" .

dcp:domain-query-read a dcp:DomainCapability ;
    rdfs:label "Domain.Query.Read" ;
    dcterms:identifier "Domain.Query.Read" ;
    dcp:providerAlias "Domain.Read" ;
    dcp:authorityRequirement "observe" ;
    dcp:precondition "Target resource and read action exist in the compiled domain; read policies are satisfiable for the given actor." ;
    dcp:postcondition "A query result (list of records) is returned; no domain state is changed." ;
    dcp:outcome "success: list of records (possibly empty)" ;
    dcp:outcome "failure: Ash.Error.Forbidden (read policies denied)" ;
    dcp:outcome "failure: Ash.Error.Invalid (invalid query input)" ;
    dcp:outcome "nondeterministic: result contents follow live domain state; ordering is only what the action's own sort/limit declares" ;
    dcp:acceptsInput "resource, read action, query input map, optional actor (real surface: Ash.Query.for_read(action, input, opts) then Ash.read)" ;
    dcp:producesOutput "list of records" ;
    dcp:executionProperty "policy_checked" .

dcp:domain-change-apply a dcp:DomainCapability ;
    rdfs:label "Domain.Change.Apply" ;
    dcterms:identifier "Domain.Change.Apply" ;
    dcp:authorityRequirement "construct" ;
    dcp:precondition "Target resource and create/update/destroy action exist in the compiled domain; change policies are satisfiable for the given actor; a record is supplied for update/destroy." ;
    dcp:postcondition "The record change is committed under the action's transaction semantics; destroy returns the destroyed record (return_destroyed?: true on the real step)." ;
    dcp:outcome "success: created/updated/destroyed record" ;
    dcp:outcome "failure: Ash.Error.Forbidden (change policies denied)" ;
    dcp:outcome "failure: Ash.Error.Invalid (invalid changeset/input)" ;
    dcp:outcome "nondeterministic: changes may fire notifications/side effects; replay requires the action's own idempotency" ;
    dcp:acceptsInput "resource, action name, input map, record (required for update/destroy), optional actor (real surface: Ash.Changeset.for_create/for_update/for_destroy then Ash.create/update/destroy)" ;
    dcp:producesOutput "created/updated/destroyed record" ;
    dcp:executionProperty "policy_checked" ;
    dcp:executionProperty "transactional" .

dcp:domain-query-read-one a dcp:DomainCapability ;
    rdfs:label "Domain.Query.ReadOne" ;
    dcterms:identifier "Domain.Query.ReadOne" ;
    dcp:authorityRequirement "observe" ;
    dcp:precondition "Target resource and read action exist; the query resolves to at most one record." ;
    dcp:postcondition "Zero or one record returned; no state changed." ;
    dcp:outcome "success: one record or nil" ;
    dcp:outcome "failure: Ash.Error.Forbidden" ;
    dcp:outcome "nondeterministic: which record is 'one' follows live domain state when the query under-specifies" ;
    dcp:acceptsInput "resource, read action, query input (real surface: Ash.Reactor.ReadOneStep)" ;
    dcp:producesOutput "single record or nil" ;
    dcp:executionProperty "policy_checked" .

dcp:domain-record-create a dcp:DomainCapability ;
    rdfs:label "Domain.Record.Create" ;
    dcterms:identifier "Domain.Record.Create" ;
    dcp:providerAlias "Domain.Create" ;
    dcp:authorityRequirement "construct" ;
    dcp:precondition "Target resource and create action exist in the compiled domain." ;
    dcp:postcondition "One new record committed." ;
    dcp:outcome "success: created record" ;
    dcp:outcome "failure: Ash.Error.Forbidden" ;
    dcp:outcome "failure: Ash.Error.Invalid" ;
    dcp:outcome "nondeterministic: create may fire notifications; not replay-safe without action idempotency" ;
    dcp:acceptsInput "resource, create action, input map, optional actor" ;
    dcp:producesOutput "created record" ;
    dcp:executionProperty "policy_checked" ;
    dcp:executionProperty "transactional" .

dcp:domain-record-update a dcp:DomainCapability ;
    rdfs:label "Domain.Record.Update" ;
    dcterms:identifier "Domain.Record.Update" ;
    dcp:providerAlias "Domain.Update" ;
    dcp:authorityRequirement "construct" ;
    dcp:precondition "Target record exists and its update action's policies are satisfiable." ;
    dcp:postcondition "The record's changes are committed." ;
    dcp:outcome "success: updated record" ;
    dcp:outcome "failure: Ash.Error.Forbidden" ;
    dcp:outcome "failure: Ash.Error.Invalid" ;
    dcp:outcome "nondeterministic: update may fire notifications; not replay-safe without action idempotency" ;
    dcp:acceptsInput "record, update action, input map, optional actor" ;
    dcp:producesOutput "updated record" ;
    dcp:executionProperty "policy_checked" ;
    dcp:executionProperty "transactional" .

dcp:domain-record-destroy a dcp:DomainCapability ;
    rdfs:label "Domain.Record.Destroy" ;
    dcterms:identifier "Domain.Record.Destroy" ;
    dcp:providerAlias "Domain.Destroy" ;
    dcp:authorityRequirement "construct" ;
    dcp:precondition "Target record exists and its destroy action's policies are satisfiable." ;
    dcp:postcondition "The record is destroyed; the destroyed record is returned (return_destroyed?: true)." ;
    dcp:outcome "success: destroyed record" ;
    dcp:outcome "failure: Ash.Error.Forbidden" ;
    dcp:outcome "failure: Ash.Error.Invalid" ;
    dcp:outcome "nondeterministic: destroy may cascade; not replay-safe" ;
    dcp:acceptsInput "record, destroy action, optional actor" ;
    dcp:producesOutput "destroyed record" ;
    dcp:executionProperty "policy_checked" ;
    dcp:executionProperty "transactional" .

dcp:domain-bulk-apply a dcp:DomainCapability ;
    rdfs:label "Domain.Bulk.Apply" ;
    dcterms:identifier "Domain.Bulk.Apply" ;
    dcp:authorityRequirement "construct" ;
    dcp:precondition "Target resource and bulk action exist; the inputs collection is finite; bulk options (batch size, return mode) are admitted by the action." ;
    dcp:postcondition "The bulk operation has streamed its batches; per-record outcomes are reported per the requested return mode." ;
    dcp:outcome "success: Ash.BulkResult with per-record status" ;
    dcp:outcome "failure: Ash.Error.Forbidden (bulk policies denied per record or wholesale)" ;
    dcp:outcome "failure: Ash.Error.Invalid" ;
    dcp:outcome "nondeterministic: partial batch failure order; error ordering across batches is not stable" ;
    dcp:acceptsInput "resource, action, inputs collection, bulk options (real surface: Ash.bulk_create/4, Ash.bulk_update/4, Ash.bulk_destroy/4)" ;
    dcp:producesOutput "Ash.BulkResult" ;
    dcp:executionProperty "policy_checked" ;
    dcp:executionProperty "transactional" .

