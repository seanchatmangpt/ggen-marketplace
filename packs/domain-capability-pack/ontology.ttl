@prefix dcp:  <https://ggen.dev/ontology/domain-capability#> .
@prefix qce:  <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix errc: <http://seanchatmangpt.github.io/packs/gh-actions-errc#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# NAMESPACE ALIGNMENT (v0.2.0, 2026-09-30) -- explicit, not silent.
#
# v0.1.0 published this vocabulary at
#   http://seanchatmangpt.github.io/packs/domain-capability#
# The v26.9.30 capability-ecology wave pins dcp: to
#   https://ggen.dev/ontology/domain-capability#
# (docs/jira/v26.9.30/RESOLUTIONS.md namespace table; lane 1 owns the
# alignment). Every legacy term moved verbatim (definitions unchanged);
# each legacy IRI is recorded below with dcterms:isReplacedBy. Known
# consumers of the legacy IRIs (gym-upper-ontology-pack,
# standing-ladder-pack) carry their own self-contained copies of the
# legacy facts in their qualification fixtures, so this migration does
# not strand them; their references remain valid historical provenance.
#################################################################

dcp:NamespaceAlignment2026-09-30 a prov:Entity ;
    rdfs:label "Namespace alignment record: legacy seanchatmangpt.github.io/packs/domain-capability# terms republished at the pinned https://ggen.dev/ontology/domain-capability# namespace" ;
    dcterms:description "15 legacy terms moved verbatim; per-term mapping via dcterms:isReplacedBy below. No term was deleted or redefined; the SREGym worked instance, its manifest, the autofde-lab allowlist, and the ERRC grid are conserved unchanged." ;
    dcterms:created "2026-09-30"^^xsd:date ;
    prov:wasDerivedFrom <http://seanchatmangpt.github.io/packs/domain-capability#> .

<http://seanchatmangpt.github.io/packs/domain-capability#Capability> dcterms:isReplacedBy dcp:Capability .
<http://seanchatmangpt.github.io/packs/domain-capability#LabAllowlist> dcterms:isReplacedBy dcp:LabAllowlist .
<http://seanchatmangpt.github.io/packs/domain-capability#CapabilitySourceManifest> dcterms:isReplacedBy dcp:CapabilitySourceManifest .
<http://seanchatmangpt.github.io/packs/domain-capability#order> dcterms:isReplacedBy dcp:order .
<http://seanchatmangpt.github.io/packs/domain-capability#slug> dcterms:isReplacedBy dcp:slug .
<http://seanchatmangpt.github.io/packs/domain-capability#consequence> dcterms:isReplacedBy dcp:consequence .
<http://seanchatmangpt.github.io/packs/domain-capability#worldBinding> dcterms:isReplacedBy dcp:worldBinding .
<http://seanchatmangpt.github.io/packs/domain-capability#sourceRepo> dcterms:isReplacedBy dcp:sourceRepo .
<http://seanchatmangpt.github.io/packs/domain-capability#sourceFile> dcterms:isReplacedBy dcp:sourceFile .
<http://seanchatmangpt.github.io/packs/domain-capability#sourceIri> dcterms:isReplacedBy dcp:sourceIri .
<http://seanchatmangpt.github.io/packs/domain-capability#ownerRepo> dcterms:isReplacedBy dcp:ownerRepo .
<http://seanchatmangpt.github.io/packs/domain-capability#allows> dcterms:isReplacedBy dcp:allows .
<http://seanchatmangpt.github.io/packs/domain-capability#manifestSourceRepo> dcterms:isReplacedBy dcp:manifestSourceRepo .
<http://seanchatmangpt.github.io/packs/domain-capability#manifestSourceFile> dcterms:isReplacedBy dcp:manifestSourceFile .
<http://seanchatmangpt.github.io/packs/domain-capability#expectedCapabilityCount> dcterms:isReplacedBy dcp:expectedCapabilityCount .

#################################################################
# Vocabulary
#################################################################

dcp:Capability a rdfs:Class ;
    rdfs:label "One real capability exposed by an executable world (e.g. gymact), transcribed verbatim from its real source -- never a hand-summarized or invented capability." .

dcp:order a rdf:Property ; rdfs:domain dcp:Capability .
dcp:slug a rdf:Property ; rdfs:domain dcp:Capability .
# dcp:consequence: closed "READ" | "DO", mirroring gymact.models.Consequence.
dcp:consequence a rdf:Property ; rdfs:domain dcp:Capability .
dcp:worldBinding a rdf:Property ; rdfs:domain dcp:Capability ;
    rdfs:comment "The real callable/binding name in the owning world-projection repo (gymact.models.Capability.binding)." .
dcp:sourceRepo a rdf:Property ; rdfs:domain dcp:Capability ;
    rdfs:comment "The real repo this capability's facts were transcribed from." .
dcp:sourceFile a rdf:Property ; rdfs:domain dcp:Capability ;
    rdfs:comment "The real file path within sourceRepo this capability's facts were transcribed from." .
dcp:sourceIri a rdf:Property ; rdfs:domain dcp:Capability ;
    rdfs:comment "The real urn: IRI the source uses for this capability, when one exists (gymact.models.Capability.iri) -- provenance, not a new identifier scheme." .

dcp:LabAllowlist a rdfs:Class ;
    rdfs:label "A consuming repo's own admitted subset of a domain's full dcp:Capability set (the lab-projection). dcp:allows must be a strict subset of real dcp:Capability individuals -- enforced by gates/030_allowlist_subset.rq, not merely documented." .

dcp:ownerRepo a rdf:Property ; rdfs:domain dcp:LabAllowlist .
dcp:allows a rdf:Property ; rdfs:domain dcp:LabAllowlist ; rdfs:range dcp:Capability .

dcp:CapabilitySourceManifest a rdfs:Class ;
    rdfs:label "Declares how many real dcp:Capability individuals SHOULD exist for one (sourceRepo, sourceFile) pair -- the count gate (gates/020_exact_count_per_source.rq) checks the real count against this, per source, so a second domain's capability set is an additive fact, not a rewrite of a hardcoded global number (the constraint packs/automatic-autonomic-operations-pack accepted for its own single-domain scope, deliberately not repeated here)." .

dcp:manifestSourceRepo a rdf:Property ; rdfs:domain dcp:CapabilitySourceManifest .
dcp:manifestSourceFile a rdf:Property ; rdfs:domain dcp:CapabilitySourceManifest .
dcp:expectedCapabilityCount a rdf:Property ; rdfs:domain dcp:CapabilitySourceManifest .

