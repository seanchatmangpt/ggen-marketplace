@prefix dcp: <https://ggen.dev/ontology/domain-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <https://example.test/dcp/> .

# NEGATIVE fixture for gates/040_required_contract_fields.rq (FIRES it):
# a DomainCapability missing its required dcp:precondition (also missing
# dcp:outcome) -- a contract asserted without the fields the contract shape
# requires. Expected: 040 returns >= 1 row naming the missing properties.
# (050 also fires: the capability has no realization -- expected subset rule.)

ex:neg-fields-cap a dcp:DomainCapability ;
    rdfs:label "Domain.Change.Apply" ;
    dcterms:identifier "Domain.Change.Apply" ;
    dcp:authorityRequirement "construct" .
