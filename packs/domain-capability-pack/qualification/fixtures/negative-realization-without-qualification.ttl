@prefix dcp: <https://ggen.dev/ontology/domain-capability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <https://example.test/dcp/> .

# NEGATIVE fixture for gates/060_realization_requires_qualification.rq (FIRES it):
# a realization carrying all provider metadata required by gate 040 but asserting
# ZERO dcp:qualificationCondition -- an unconditioned qualification claim, the
# shape acceptance mocks take. Expected: 060 returns >= 1 row naming
# ex:neg-noqual-real.

ex:neg-noqual-cap a dcp:DomainCapability ;
    rdfs:label "Domain.Action.Invoke" ;
    dcterms:identifier "Domain.Action.Invoke" ;
    dcp:authorityRequirement "construct" ;
    dcp:precondition "Target resource and action exist." ;
    dcp:outcome "success: the action's return value" .

ex:neg-noqual-real a dcp:Realization ;
    dcp:realizes ex:neg-noqual-cap ;
    dcp:providerPackage "ash" ;
    dcp:providerModule "Ash.Reactor.ActionStep" ;
    dcp:versionPinPolicy "hex pin via consumer mix.exs constraint + mix.lock" ;
    dcp:evidenceKind "ash_result" .
