@prefix dcp: <https://ggen.dev/ontology/domain-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <https://example.test/dcp/> .

# NEGATIVE fixture for gates/080_no_do_authority.rq (FIRES it, both branches):
# Policy != Authority.
#   ex:neg-do-cap declares dcp:authorityRequirement "do" -> "do-authority-required"
#     (mirrors the resolver's own {:authority_refused, :do}).
#   ex:neg-do-real claims qce:grantsDoAuthority true -> "do-authority-granted"
#     (the CapabilityPack ceiling is capped at :construct).

ex:neg-do-cap a dcp:DomainCapability ;
    rdfs:label "Domain.Change.Apply" ;
    dcterms:identifier "Domain.Change.Apply" ;
    dcp:authorityRequirement "do" ;
    dcp:precondition "Target resource and change action exist." ;
    dcp:outcome "success: updated record" .

ex:neg-do-real a dcp:Realization ;
    dcp:realizes ex:neg-do-cap ;
    dcp:providerPackage "ash" ;
    dcp:providerModule "Ash.Reactor.UpdateStep" ;
    dcp:versionPinPolicy "hex pin via consumer mix.exs constraint + mix.lock" ;
    dcp:evidenceKind "ash_result" ;
    dcp:qualificationCondition "Compiled domain exposes the update action." ;
    qce:grantsDoAuthority true .
