@prefix dcp: <https://ggen.dev/ontology/domain-capability#> .
@prefix qce: <https://ggen.dev/ontology/qualified-capability-ecology#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.test/dcp/> .

# POSITIVE fixture: a minimal, fully-conformed DOMAIN contract instance proving all
# nine gates are JOINTLY satisfiable -- including the runtime shape: the episode
# executes a FROZEN realization (gate 090 clean), availability is bound to an
# authority envelope whose ceiling admits the requirement (gate 070 clean).

ex:pos-cap a dcp:DomainCapability ;
    rdfs:label "Domain.Query.Read" ;
    dcterms:identifier "Domain.Query.Read" ;
    dcp:authorityRequirement "observe" ;
    dcp:precondition "Target resource and read action exist in the compiled domain." ;
    dcp:outcome "success: list of records (possibly empty)" .

ex:pos-real a dcp:Realization, qce:QualifiedCapability, qce:FrozenCapability ;
    dcp:realizes ex:pos-cap ;
    dcp:providerPackage "ash" ;
    dcp:providerModule "Ash.Reactor.ReadStep" ;
    dcp:versionPinPolicy "hex pin via consumer mix.exs constraint + mix.lock" ;
    dcp:evidenceKind "ash_result" ;
    dcp:qualificationCondition "Compiled domain exposes the read action; policies decide authorization." ;
    dcp:available true ;
    qce:authorityEnvelope ex:pos-env ;
    qce:frozen true .

ex:pos-env a qce:AuthorityEnvelope ;
    qce:authorityDigest "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ;
    qce:authorityCeiling "construct" .

ex:pos-episode a qce:RuntimeEpisode ;
    qce:executedCapability ex:pos-real .
