# MESSAGE: Every nma:A2AAgent must have an agentId, agentName, personaPrompt, and defaultModel.
PREFIX nma: <https://ggen.dev/packs/nextjs-mcp-a2a#>

SELECT ?agent WHERE {
  ?agent a nma:A2AAgent .
  FILTER (
    !BOUND(?agent) ||
    NOT EXISTS { ?agent nma:agentId ?id } ||
    NOT EXISTS { ?agent nma:agentName ?name } ||
    NOT EXISTS { ?agent nma:personaPrompt ?prompt } ||
    NOT EXISTS { ?agent nma:defaultModel ?model }
  )
}
