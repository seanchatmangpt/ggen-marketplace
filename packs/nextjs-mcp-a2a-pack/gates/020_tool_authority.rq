# MESSAGE: Every nma:McpTool must have a toolName, toolDescription, inputSchemaJson, and authority in ('READ_ONLY', 'PROPOSAL').
PREFIX nma: <https://ggen.dev/packs/nextjs-mcp-a2a#>

SELECT ?tool WHERE {
  ?tool a nma:McpTool .
  OPTIONAL { ?tool nma:authority ?auth }
  FILTER (
    NOT EXISTS { ?tool nma:toolName ?name } ||
    NOT EXISTS { ?tool nma:toolDescription ?desc } ||
    NOT EXISTS { ?tool nma:inputSchemaJson ?schema } ||
    !BOUND(?auth) ||
    (?auth != "READ_ONLY" && ?auth != "PROPOSAL")
  )
}
