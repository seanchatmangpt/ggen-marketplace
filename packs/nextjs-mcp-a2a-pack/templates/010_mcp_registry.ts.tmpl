---
to: "src/lib/mcp/generated-mcp-registry.ts"
sparql:
  tools: >
      PREFIX nma: <https://ggen.dev/packs/nextjs-mcp-a2a#>
      SELECT ?toolName ?toolDescription ?authority ?inputSchemaJson WHERE {
        ?tool a nma:McpTool ;
              nma:toolName ?toolName ;
              nma:toolDescription ?toolDescription ;
              nma:authority ?authority ;
              nma:inputSchemaJson ?inputSchemaJson .
      } ORDER BY ?toolName
---
// Generated by ggen nextjs-mcp-a2a-pack. Do not hand-edit.

export interface GeneratedMcpTool {
  name: string;
  description: string;
  authority: "READ_ONLY" | "PROPOSAL";
  inputSchema: Record<string, unknown>;
}

export const GENERATED_MCP_TOOLS: GeneratedMcpTool[] = [
{% for t in tools %}  {
    name: "{{ t.toolName }}",
    description: "{{ t.toolDescription }}",
    authority: "{{ t.authority }}",
    inputSchema: {{ t.inputSchemaJson }},
  },
{% endfor %}];
