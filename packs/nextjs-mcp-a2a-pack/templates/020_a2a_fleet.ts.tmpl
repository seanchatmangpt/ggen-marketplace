---
to: "src/lib/a2a/generated-a2a-fleet.ts"
sparql:
  agents: >
      PREFIX nma: <https://ggen.dev/packs/nextjs-mcp-a2a#>
      SELECT ?agentId ?agentName ?role ?defaultModel ?personaPrompt WHERE {
        ?agent a nma:A2AAgent ;
               nma:agentId ?agentId ;
               nma:agentName ?agentName ;
               nma:role ?role ;
               nma:defaultModel ?defaultModel ;
               nma:personaPrompt ?personaPrompt .
      } ORDER BY ?agentId
---
// Generated by ggen nextjs-mcp-a2a-pack. Do not hand-edit.

export interface GeneratedA2AAgent {
  id: string;
  name: string;
  role: string;
  defaultModel: string;
  personaPrompt: string;
}

export const GENERATED_A2A_FLEET: GeneratedA2AAgent[] = [
{% for a in agents %}  {
    id: "{{ a.agentId }}",
    name: "{{ a.agentName }}",
    role: "{{ a.role }}",
    defaultModel: "{{ a.defaultModel }}",
    personaPrompt: {{ a.personaPrompt | json_encode | safe }},
  },
{% endfor %}];
