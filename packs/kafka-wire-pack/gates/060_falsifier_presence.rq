# MESSAGE: law without a named falsifier — every kafka:Law individual must
# carry at least one kafka:falsifier; a law with no falsifier carries no bits
# (vacuous-law class) and cannot be shim-court flipped.
# Anti-vacuity: witnesses/fail/060_falsifier_presence.ttl removes the
# KD-174 falsifier; >=1 row must result.
PREFIX kafka: <urn:kafka-wire:>
SELECT ?law WHERE {
  ?law a kafka:Law .
  FILTER NOT EXISTS { ?law kafka:falsifier ?f . }
}
ORDER BY ?law
