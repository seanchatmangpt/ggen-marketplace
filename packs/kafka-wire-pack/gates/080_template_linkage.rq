# MESSAGE: template linkage broken — every class a pack template's SPARQL
# selects must have at least one individual in the graph; an empty class
# silently renders an empty template output.
# Anti-vacuity: witnesses/fail/080_template_linkage.ttl removes all
# ZigzagCase individuals; >=1 row must result.
PREFIX kafka: <urn:kafka-wire:>
SELECT ?class WHERE {
  VALUES ?class { kafka:GroupApi kafka:ErrorCode kafka:BatchField kafka:VersionRow
                  kafka:CrcDomain kafka:ZigzagCase kafka:Law kafka:LanguageTarget kafka:RecordBatch }
  FILTER NOT EXISTS { ?individual a ?class . }
}
ORDER BY ?class
