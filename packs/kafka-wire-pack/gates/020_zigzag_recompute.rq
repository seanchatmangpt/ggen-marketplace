# MESSAGE: zigzag encoding case is not the canonical signed-varint encoding.
# Canonical law (record format v2): u = 2n for n >= 0, u = -2n - 1 for n < 0.
# The gate RECOMPUTES the encoding from n in SPARQL — a stored u that
# disagrees with the recomputation is a defect, never a trusted constant.
# Anti-vacuity: witnesses/fail/020_zigzag_recompute.ttl mutates zz-p2
# u 4 -> 5; this gate must return >=1 row on it.
PREFIX kafka: <urn:kafka-wire:>
SELECT ?case ?n ?u WHERE {
  ?case a kafka:ZigzagCase ; kafka:n ?n ; kafka:u ?u .
  FILTER(?u != IF(?n >= 0, 2 * ?n, -2 * ?n - 1))
}
ORDER BY ?n
