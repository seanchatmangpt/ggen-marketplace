# MESSAGE: served version matrix closure violated — every VersionRow must
# serve only versions strictly below its KIP-482 flexible threshold
# (servedMax < flexibleFrom); serving a flexible version would require
# compact types + tag sections this face does not implement.
# Anti-vacuity: witnesses/fail/050_version_matrix_closure.ttl bumps
# produce servedMax 3 -> 9 (== flexibleFrom); >=1 row must result.
PREFIX kafka: <urn:kafka-wire:>
SELECT ?row ?key WHERE {
  ?row a kafka:VersionRow ; kafka:key ?key ; kafka:servedMax ?sm ; kafka:flexibleFrom ?ff .
  FILTER(?sm >= ?ff)
}
ORDER BY ?key
