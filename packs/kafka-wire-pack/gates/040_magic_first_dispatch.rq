# MESSAGE: magic-first dispatch law absent — KD-180 (dispatch on the magic
# byte before ANY version- or offset-sensitive read) must exist as a Law
# individual; its absence un-grounds count/verify/parse dispatch.
# Anti-vacuity: witnesses/fail/040_magic_first_dispatch.ttl removes the
# KD-180 individual; >=1 row must result.
PREFIX kafka: <urn:kafka-wire:>
SELECT ?gap WHERE {
  FILTER NOT EXISTS { ?l a kafka:Law ; kafka:kdId "KD-180" . }
  BIND("KD-180 magic-first dispatch law missing" AS ?gap)
}
ORDER BY ?gap
