//! Projected served version matrix (gate 050 closure law: servedMax <
//! flexibleFrom) and the protocol-guide error-code names.

/// Served (min, max) per API key, projected from kafka:VersionRow.
pub const SERVED_VERSION_MATRIX: &[(i16, (i16, i16))] = &[
    {%- for r in rows %}
    ({{ r.key }}, (0, {{ r.servedMax }})),
