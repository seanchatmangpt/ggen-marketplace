---
to: crates/kafka-wire/src/status_version.rs
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/kafka-wire-pack
sparql:
  rows: >
    PREFIX kafka: <urn:kafka-wire:>
    SELECT ?key ?name ?servedMax WHERE {
      ?r a kafka:VersionRow ; kafka:key ?key ; kafka:name ?name ; kafka:servedMax ?servedMax .
    } ORDER BY ?key
  errs: >
    PREFIX kafka: <urn:kafka-wire:>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?code ?label WHERE {
      ?e a kafka:ErrorCode ; kafka:code ?code ; rdfs:label ?label .
    } ORDER BY ?code
