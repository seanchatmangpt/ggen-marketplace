---
to: lib/smalt/messaging/kafka/wire_projection.ex
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/kafka-wire-pack
sparql:
  rows: >
    PREFIX kafka: <urn:kafka-wire:>
    SELECT ?key ?name ?atom ?servedMax ?clientMax ?flexibleFrom WHERE {
      ?r a kafka:VersionRow ; kafka:key ?key ; kafka:name ?name ; kafka:atom ?atom ;
         kafka:servedMax ?servedMax ; kafka:clientMax ?clientMax ; kafka:flexibleFrom ?flexibleFrom .
    } ORDER BY ?key
  crc: >
    PREFIX kafka: <urn:kafka-wire:>
    SELECT ?algo ?poly ?fromByte WHERE {
      ?c a kafka:CrcDomain ; kafka:algorithm ?algo ; kafka:coversFromByte ?fromByte .
      OPTIONAL { ?c kafka:polyReflected ?poly }
    } ORDER BY ?algo
---
# Code generated by ggen from packs/kafka-wire-pack/ontology.ttl. DO NOT EDIT.
# KD-COVERS: KD-190, KD-HC-1, KD-HC-3 — served version matrix projected from
# the pack ontology (single source of truth); Wire.version_matrix/0 adapts it.

defmodule Smalt.Messaging.Kafka.WireProjection do
  @moduledoc "Projected served version matrix + CRC domains."

  @version_matrix [
    {%- for r in rows %}
    %{key: {{ r.key }}, name: "{{ r.name }}", min: 0, max: {{ r.servedMax }}, client_max: {{ r.clientMax }}, flexible_from: {{ r.flexibleFrom }}},
    {% endfor %}
  ]

  @crc_domains [
    {%- for c in crc %}
    %{algo: "{{ c.algo }}", poly: "{{ c.poly | default(value="-") }}", from_byte: {{ c.fromByte }}},
    {% endfor %}
  ]

  @doc "Projected VersionRow rows (pack ontology is the source of truth)."
  def version_matrix_rows, do: @version_matrix

  @doc "Projected CRC domains."
  def crc_domains, do: @crc_domains
end
