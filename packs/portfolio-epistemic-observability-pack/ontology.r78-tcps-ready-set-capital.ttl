@prefix peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

peo:WorkItem a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:DownstreamCustomer a rdfs:Class ; rdfs:subClassOf prov:Agent .
peo:DemandShape a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:AdmissibleSet a rdfs:Class ; rdfs:subClassOf prov:Collection .
peo:ReadySet a rdfs:Class ; rdfs:subClassOf prov:Collection .
peo:PartialOrderEdge a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:CapitalCandidate a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:SelectionDecision a rdfs:Class ; rdfs:subClassOf prov:Activity .
peo:AuthorityBroker a rdfs:Class ; rdfs:subClassOf prov:Agent .
peo:ExecutionReceipt a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:UpstreamReturn a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:StandardWorkPromotion a rdfs:Class ; rdfs:subClassOf prov:Activity .
peo:SerializationDefect a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .

peo:downstreamCustomer a rdf:Property .
peo:downstreamShape a rdf:Property .
peo:predecessor a rdf:Property .
peo:successor a rdf:Property .
peo:inAdmissibleSet a rdf:Property .
peo:inReadySet a rdf:Property .
peo:hardGateSatisfied a rdf:Property .
peo:authoritySatisfied a rdf:Property .
peo:receiptRequired a rdf:Property .
peo:reversible a rdf:Property .
peo:compatibleWith a rdf:Property .
peo:preservedAlternative a rdf:Property .
peo:selected a rdf:Property .
peo:selectionScore a rdf:Property .
peo:commitThroughputLeverage a rdf:Property .
peo:ggenLeverage a rdf:Property .
peo:structuralDisplacement a rdf:Property .
peo:consumerFanout a rdf:Property .
peo:upstreamLearning a rdf:Property .
peo:immediateValue a rdf:Property .
peo:revenuePotential a rdf:Property .
peo:customerRevenuePotential a rdf:Property .
peo:reuseValue a rdf:Property .
peo:dependencyUnlock a rdf:Property .
peo:compositionValue a rdf:Property .
peo:informationGain a rdf:Property .
peo:futureManufacturingCapacity a rdf:Property .
peo:reversibility a rdf:Property .
peo:authorityCost a rdf:Property .
peo:irreversibleCost a rdf:Property .
peo:brokeredBy a rdf:Property .
peo:receipt a rdf:Property .
peo:tcpsPattern a rdf:Property .
peo:returnTarget a rdf:Property .
peo:promotionTarget a rdf:Property .
peo:qualifiedNovelty a rdf:Property .
peo:linearizationRank a rdf:Property .
peo:parallelClass a rdf:Property .
peo:consequentialDo a rdf:Property .
peo:exactSubject a rdf:Property .
