PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?subject ?standing WHERE { ?subject peo:standing ?standing ; peo:observedHead ?head ; peo:currentHead ?head . FILTER(?standing IN ("ALIVE","PARTIAL_ALIVE")) FILTER NOT EXISTS { ?subject peo:actuationPerformed true . } }
ORDER BY ?standing ?subject
