PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?a ?b WHERE { ?a a peo:CapitalCandidate ; peo:parallelClass ?class ; peo:linearizationRank ?ra . ?b a peo:CapitalCandidate ; peo:parallelClass ?class ; peo:linearizationRank ?rb . FILTER(?ra != ?rb && STR(?a) < STR(?b)) }
