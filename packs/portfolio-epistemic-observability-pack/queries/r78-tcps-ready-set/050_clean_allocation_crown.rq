PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?candidate ?score WHERE { ?candidate a peo:CapitalCandidate ; peo:inAdmissibleSet true ; peo:inReadySet true ; peo:hardGateSatisfied true ; peo:authoritySatisfied true ; peo:selected true ; peo:reversible true ; peo:receiptRequired true ; peo:brokeredBy ?broker ; peo:receipt ?receipt ; peo:downstreamCustomer ?customer ; peo:downstreamShape ?shape ; peo:selectionScore ?score ; peo:consequentialDo false . ?broker a peo:AuthorityBroker . ?receipt a peo:ExecutionReceipt . }
ORDER BY DESC(?score) ?candidate
