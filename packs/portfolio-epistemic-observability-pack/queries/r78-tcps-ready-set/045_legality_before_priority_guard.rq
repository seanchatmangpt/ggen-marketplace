PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?illegal ?illegalScore ?ready ?readyScore WHERE { ?illegal a peo:CapitalCandidate ; peo:inAdmissibleSet false ; peo:selectionScore ?illegalScore . ?ready a peo:CapitalCandidate ; peo:inReadySet true ; peo:selectionScore ?readyScore . FILTER(?illegalScore > ?readyScore) }
