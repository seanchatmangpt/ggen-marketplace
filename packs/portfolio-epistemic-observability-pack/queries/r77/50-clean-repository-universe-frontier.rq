PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?repo ?sha ?path WHERE { ?repo a peo:RepositorySnapshot ; peo:defaultBranch ?branch ; peo:exactHead ?sha ; peo:headResolved true ; peo:standing "ALIVE" ; peo:packCandidate ?pack ; peo:ggenPath ?path ; peo:qualificationReceipt ?receipt }
ORDER BY ?repo ?sha ?path
