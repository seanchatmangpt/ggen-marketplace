PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?d WHERE { ?d a peo:OCELDensity . FILTER( NOT EXISTS { ?d peo:objectTypesPerEvent ?a } || NOT EXISTS { ?d peo:qualifiedRelationsPerEvent ?b } || NOT EXISTS { ?d peo:independentEvidenceRootsPerEvent ?c } || NOT EXISTS { ?d peo:actionableAdjacenciesPerRead ?e } ) }
