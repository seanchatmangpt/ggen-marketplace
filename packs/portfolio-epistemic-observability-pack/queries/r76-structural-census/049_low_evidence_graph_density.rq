PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?density ?roots ?crossRepo ?consumers ?causal ?economic WHERE { ?density a peo:OCELDensity ; peo:independentEvidenceRootsPerEvent ?roots ; peo:crossRepoEdges ?crossRepo ; peo:consumerEdges ?consumers ; peo:causalEdges ?causal ; peo:economicEdges ?economic . FILTER(?roots < 2 || ?crossRepo < 2 || ?consumers < 1 || ?causal < 1 || ?economic < 1) }
