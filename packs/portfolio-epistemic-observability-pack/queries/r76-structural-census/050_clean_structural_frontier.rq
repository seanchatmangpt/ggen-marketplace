PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?candidate ?existing ?desired ?ontology ?pack ?composition ?generator ?artifact ?consumer ?receipt ?standing WHERE { ?candidate a peo:DisplacementCandidate ; peo:existingStructure ?existing ; peo:desiredStructure ?desired ; peo:ontologySource ?ontology ; peo:pack ?pack ; peo:composition ?composition ; peo:generator ?generator ; peo:generatedArtifact ?artifact ; peo:consumer ?consumer ; peo:qualificationReceipt ?receipt ; peo:standing ?standing . }
ORDER BY ?candidate ?existing ?desired ?ontology ?pack ?composition ?generator ?artifact ?consumer ?receipt ?standing
