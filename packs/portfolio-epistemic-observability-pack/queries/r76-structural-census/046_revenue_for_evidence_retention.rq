PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?revenue WHERE { ?revenue a peo:RevenueForCustomer . FILTER( NOT EXISTS { ?revenue peo:evidenceRoot ?proof } || NOT EXISTS { ?revenue peo:attributionConfidence ?confidence } || NOT EXISTS { ?revenue peo:timeWindow ?window } || NOT EXISTS { ?revenue peo:retentionExpansion ?signal } ) }
