PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?density ?objectTypes ?relations ?roots ?temporal ?crossRepo ?consumers ?causal ?economic ?receipts ?adjacencies WHERE { ?density a peo:OCELDensity ; peo:objectTypesPerEvent ?objectTypes ; peo:qualifiedRelationsPerEvent ?relations ; peo:independentEvidenceRootsPerEvent ?roots ; peo:temporalAttributesPerObject ?temporal ; peo:crossRepoEdges ?crossRepo ; peo:consumerEdges ?consumers ; peo:causalEdges ?causal ; peo:economicEdges ?economic ; peo:replayReceipts ?receipts ; peo:actionableAdjacenciesPerRead ?adjacencies . }
