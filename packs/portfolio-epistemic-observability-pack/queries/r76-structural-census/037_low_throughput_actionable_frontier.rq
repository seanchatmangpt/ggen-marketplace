PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?run ?rate (COUNT(DISTINCT ?opportunity) AS ?opportunities) WHERE { ?run a peo:ScheduleRun ; peo:commitsPerHour ?rate ; peo:actionableAdjacency ?opportunity . } GROUP BY ?run ?rate HAVING(COUNT(DISTINCT ?opportunity) > 0)
