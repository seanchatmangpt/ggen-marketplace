PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?revenue WHERE { ?revenue a peo:RevenueFromCustomer . FILTER( NOT EXISTS { ?revenue peo:producer ?producer } || NOT EXISTS { ?revenue peo:valueMetric ?metric } || NOT EXISTS { ?revenue peo:timeWindow ?window } || NOT EXISTS { ?revenue peo:attributionConfidence ?confidence } ) }
