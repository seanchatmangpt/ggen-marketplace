PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?revenue WHERE { ?revenue a peo:RevenueForCustomer . FILTER( NOT EXISTS { ?revenue peo:beneficiary ?beneficiary } || NOT EXISTS { ?revenue peo:customerProcess ?process } || NOT EXISTS { ?revenue peo:valueOutcome ?value } || NOT EXISTS { ?revenue peo:customerRevenueOutcome ?outcome } ) }
