PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT (COUNT(?refinement) AS ?generalizable) (SUM(IF(?promoted = true && ?regenerated = true,1,0)) AS ?realizedUpstream) WHERE { ?learning peo:refinement ?refinement ; peo:generalizable true . OPTIONAL { ?learning peo:promotedUpstream ?promoted } OPTIONAL { ?learning peo:regenerated ?regenerated } }
