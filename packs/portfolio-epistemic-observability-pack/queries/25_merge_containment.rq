PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?qualified ?merge ?default WHERE { ?merge a prov:Activity ; prov:used ?qualified . ?default prov:wasGeneratedBy ?merge . ?qualified peo:standing "ALIVE" . ?default peo:standing "ALIVE" . }
