PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?run (COUNT(DISTINCT ?opportunity) AS ?opportunities) (COUNT(DISTINCT ?seed) AS ?seeds) WHERE { ?run a peo:SensorRun ; prov:used ?seed . ?opportunity a peo:Opportunity ; prov:wasGeneratedBy ?run . } GROUP BY ?run
