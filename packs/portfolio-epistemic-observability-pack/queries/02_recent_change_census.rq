PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?repo (COUNT(?change) AS ?changes) WHERE { ?change a prov:Entity ; peo:repository ?repo ; dct:modified ?at . } GROUP BY ?repo ORDER BY DESC(?changes)
