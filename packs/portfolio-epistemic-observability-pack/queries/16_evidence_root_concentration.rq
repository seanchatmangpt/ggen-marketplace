PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?root (COUNT(DISTINCT ?obs) AS ?dependents) WHERE { ?obs a peo:Observation ; prov:wasDerivedFrom ?root . } GROUP BY ?root HAVING(COUNT(DISTINCT ?obs) > 1) ORDER BY DESC(?dependents)
