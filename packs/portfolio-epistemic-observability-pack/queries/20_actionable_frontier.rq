PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#>
SELECT ?opportunity ?subject ?standing WHERE { ?opportunity a peo:Opportunity ; peo:actionable true ; peo:subject ?subject ; peo:standing ?standing . FILTER(?standing IN ("UNKNOWN","PARTIAL_ALIVE","BUILD_BROKEN","UNSUPPORTED")) }
ORDER BY ?standing ?opportunity ?subject
