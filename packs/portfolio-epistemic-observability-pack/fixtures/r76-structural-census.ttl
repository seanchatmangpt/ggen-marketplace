@prefix peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

peo:universe a peo:RepositoryUniverse ;
  peo:observedAt "2026-08-26T02:29:09Z"^^xsd:dateTime .

peo:marketplace a peo:RepositorySnapshot ;
  peo:repository "seanchatmangpt/ggen-marketplace" ; peo:defaultBranch "main" ;
  peo:exactHead "e11e19baf281701339e7fb6da46ccb10d0e790cf" ;
  peo:observedAt "2026-08-26T02:33:00Z"^^xsd:dateTime .
peo:ggen a peo:RepositorySnapshot ;
  peo:repository "seanchatmangpt/ggen" ; peo:defaultBranch "main" ;
  peo:exactHead "ddfa602bfbab57b7ed5150f61b0acac7a41e3020" ;
  peo:observedAt "2026-08-26T02:34:00Z"^^xsd:dateTime .
peo:memoryBus a peo:RepositorySnapshot ;
  peo:repository "seanchatmangpt/chatgpt-cloud-elixir" ; peo:defaultBranch "main" ;
  peo:exactHead "e6264c4e2c2c0aef8c546c966dafb90d52023666" ;
  peo:observedAt "2026-08-26T02:33:22Z"^^xsd:dateTime .

peo:throughputDisplacement a peo:DisplacementCandidate ;
  peo:existingStructure "bespoke schedule accounting" ;
  peo:desiredStructure "ggen-owned attributable portfolio throughput graph" ;
  peo:ontologySource <http://www.w3.org/ns/prov#> ;
  peo:pack "portfolio-epistemic-observability-pack" ;
  peo:composition "R75-throughput-learning + portfolio-observability" ;
  peo:generator "r76-portfolio-structural-census" ;
  peo:generatedArtifact "portfolio-structural-frontier.json" ;
  peo:consumer "MEASURE" ; peo:qualificationReceipt "fixture-r76-qualified" ;
  peo:standing "OBSERVED" .

peo:run a peo:ScheduleRun ;
  peo:runId "6a754fe0a72c819191520a0826a1398c+20260826T020200Z+MEASURE" ;
  peo:scheduleCell "MEASURE" ; peo:activeMinutes 8.0 ; peo:commitsPerHour 60.0 ;
  peo:previousHourRate 53.0 ; peo:previousSameCellRate 53.0 ; peo:mean24hRate 50.0 ;
  peo:actionableAdjacency peo:throughputDisplacement .

peo:semanticCommit a peo:SemanticCommit ; peo:commitSha "fixture-semantic" ;
  peo:attributedToRun peo:run ; peo:meaningful true ; peo:ggenInvolved true ;
  peo:mergeCommit false ; peo:controlCommit false .
peo:controlCommitFixture a peo:SemanticCommit ; peo:commitSha "fixture-control" ;
  peo:attributedToRun peo:run ; peo:meaningful false ; peo:ggenInvolved false ;
  peo:mergeCommit false ; peo:controlCommit true .

peo:learning peo:baseline peo:baselineV1 ; peo:experience peo:consumerExperience ;
  peo:refinement peo:upstreamRefinement ; peo:generalizable true ;
  peo:promotedUpstream true ; peo:regenerated true ; peo:requalified true .

peo:revenueFrom a peo:RevenueFromCustomer ; peo:payer "fixture-payer" ;
  peo:causalCapability peo:throughputDisplacement ; peo:producer "portfolio factory" ;
  peo:valueMetric "contracted-value" ; peo:evidenceRoot "fixture-contract-proof" ;
  peo:attributionConfidence 0.9 ; peo:timeWindow "fixture-window" .
peo:revenueFor a peo:RevenueForCustomer ; peo:beneficiary "fixture-beneficiary" ;
  peo:causalCapability peo:throughputDisplacement ; peo:producer "portfolio factory" ;
  peo:customerProcess "software manufacture" ; peo:valueOutcome "lower evidence latency" ;
  peo:customerRevenueOutcome "capacity for revenue expansion" ; peo:valueMetric "capacity" ;
  peo:evidenceRoot "fixture-process-proof" ; peo:attributionConfidence 0.7 ;
  peo:timeWindow "fixture-window" ; peo:retentionExpansion "hypothesis" .

peo:density a peo:OCELDensity ; peo:objectTypesPerEvent 4 ; peo:qualifiedRelationsPerEvent 6 ;
  peo:independentEvidenceRootsPerEvent 2 ; peo:temporalAttributesPerObject 2 ;
  peo:crossRepoEdges 3 ; peo:consumerEdges 1 ; peo:causalEdges 2 ; peo:economicEdges 2 ;
  peo:replayReceipts 1 ; peo:actionableAdjacenciesPerRead 3 .
