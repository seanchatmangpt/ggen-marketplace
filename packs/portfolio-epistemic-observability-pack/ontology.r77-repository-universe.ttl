@prefix peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

peo:ReachableRepositoryUniverse a rdfs:Class ; rdfs:subClassOf dcat:Dataset .
peo:HeadObservation a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:CensusPage a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:StructuralDisplacementObservation a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .
peo:FanoutObservation a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .
peo:ThroughputObservation a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .
peo:RevOpsObservation a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .
peo:owner a rdf:Property .
peo:repositoryCount a rdf:Property .
peo:pageCount a rdf:Property .
peo:pageSize a rdf:Property .
peo:archived a rdf:Property .
peo:fork a rdf:Property .
peo:visibility a rdf:Property .
peo:language a rdf:Property .
peo:headResolved a rdf:Property .
peo:headObservedAt a rdf:Property .
peo:sourceKind a rdf:Property .
peo:structureClass a rdf:Property .
peo:packCandidate a rdf:Property .
peo:ggenPath a rdf:Property .
peo:consumerCount a rdf:Property .
peo:qualifiedConsumerCount a rdf:Property .
peo:displacementCandidateCount a rdf:Property .
peo:qualifiedDisplacementCount a rdf:Property .
peo:revFromEvidence a rdf:Property .
peo:revForEvidence a rdf:Property .
peo:queryCoverage a rdf:Property .
peo:censusCompleteness a rdf:Property .
peo:r77ReadOnlyPolicy a odrl:Policy ; odrl:permission [ odrl:action odrl:read ] ; odrl:prohibition [ odrl:action odrl:execute ] .
