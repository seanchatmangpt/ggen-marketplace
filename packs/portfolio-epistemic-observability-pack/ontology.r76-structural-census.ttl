@prefix peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

peo:RepositoryUniverse a rdfs:Class ; rdfs:subClassOf dcat:Dataset .
peo:RepositorySnapshot a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:StructureObservation a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:DisplacementCandidate a rdfs:Class ; rdfs:subClassOf prov:Plan .
peo:PackCandidate a rdfs:Class ; rdfs:subClassOf prov:Plan .
peo:ConsumerFamily a rdfs:Class ; rdfs:subClassOf prov:Collection .
peo:ScheduleRun a rdfs:Class ; rdfs:subClassOf prov:Activity .
peo:SemanticCommit a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:Refinement a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:RevenueFromCustomer a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:RevenueForCustomer a rdfs:Class ; rdfs:subClassOf prov:Entity .
peo:OCELDensity a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .

peo:repository a rdf:Property .
peo:defaultBranch a rdf:Property .
peo:exactHead a rdf:Property .
peo:observedAt a rdf:Property .
peo:existingStructure a rdf:Property .
peo:desiredStructure a rdf:Property .
peo:ontologySource a rdf:Property .
peo:pack a rdf:Property .
peo:composition a rdf:Property .
peo:generator a rdf:Property .
peo:generatedArtifact a rdf:Property .
peo:consumer a rdf:Property .
peo:qualificationReceipt a rdf:Property .
peo:standing a rdf:Property .
peo:runId a rdf:Property .
peo:scheduleCell a rdf:Property .
peo:commitSha a rdf:Property .
peo:attributedToRun a rdf:Property .
peo:meaningful a rdf:Property .
peo:ggenInvolved a rdf:Property .
peo:mergeCommit a rdf:Property .
peo:controlCommit a rdf:Property .
peo:activeMinutes a rdf:Property .
peo:commitsPerHour a rdf:Property .
peo:previousHourRate a rdf:Property .
peo:previousSameCellRate a rdf:Property .
peo:mean24hRate a rdf:Property .
peo:baseline a rdf:Property .
peo:experience a rdf:Property .
peo:refinement a rdf:Property .
peo:generalizable a rdf:Property .
peo:promotedUpstream a rdf:Property .
peo:regenerated a rdf:Property .
peo:requalified a rdf:Property .
peo:payer a rdf:Property .
peo:beneficiary a rdf:Property .
peo:causalCapability a rdf:Property .
peo:producer a rdf:Property .
peo:valueMetric a rdf:Property .
peo:evidenceRoot a rdf:Property .
peo:attributionConfidence a rdf:Property .
peo:timeWindow a rdf:Property .
peo:customerProcess a rdf:Property .
peo:valueOutcome a rdf:Property .
peo:customerRevenueOutcome a rdf:Property .
peo:retentionExpansion a rdf:Property .
peo:objectTypesPerEvent a rdf:Property .
peo:qualifiedRelationsPerEvent a rdf:Property .
peo:independentEvidenceRootsPerEvent a rdf:Property .
peo:temporalAttributesPerObject a rdf:Property .
peo:crossRepoEdges a rdf:Property .
peo:consumerEdges a rdf:Property .
peo:causalEdges a rdf:Property .
peo:economicEdges a rdf:Property .
peo:replayReceipts a rdf:Property .
peo:actionableAdjacenciesPerRead a rdf:Property .
peo:replayReceipt a rdf:Property .
peo:actionableAdjacency a rdf:Property .
peo:authorityPolicy a odrl:Policy ; odrl:permission [ odrl:action odrl:read ] ; odrl:prohibition [ odrl:action odrl:execute ] .
