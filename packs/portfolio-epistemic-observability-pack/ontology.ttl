@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix peo: <https://ggen.dev/ontology/portfolio-epistemic-observability#> .

peo:Portfolio a dcat:Dataset ; dct:title "Reachable software-manufacturing portfolio" .
peo:Repository a skos:Concept .
peo:Capability a skos:Concept .
peo:Observation a prov:Entity .
peo:SensorRun a prov:Activity .
peo:Opportunity a prov:Entity .
peo:Receipt a prov:Entity .
peo:Freshness a dqv:Dimension .
peo:Coverage a dqv:Dimension .
peo:Concentration a dqv:Dimension .
peo:GeneratorDrift a dqv:Dimension .
peo:FalsifierCoverage a dqv:Dimension .
peo:ReceiptCoverage a dqv:Dimension .
peo:authorityPolicy a odrl:Policy .
peo:authorityPolicy odrl:permission [ odrl:action odrl:read ] ; odrl:prohibition [ odrl:action odrl:execute ] .
