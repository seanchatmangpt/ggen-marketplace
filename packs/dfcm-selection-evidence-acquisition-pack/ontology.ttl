@prefix dea: <https://chatman.ai/ontology/dfcm-selection-evidence-acquisition#> .
dea:SelectionEvidenceAcquisitionPack a dea:SelectionPack ; dea:authority "SELECT|CONSTRUCT|VERIFY" ; dea:consequentialDo "BRCE_ONLY" ; dea:requiresExactSubject true .
dea:Candidate a dea:CandidateClass .
dea:EvidenceGap a dea:GapClass .
dea:Experiment a dea:ExperimentClass .
dea:SelectionReceipt a dea:ReceiptClass .
dea:subjectSha a dea:IdentityProperty .
dea:evidenceScore a dea:MetricProperty .
dea:rollbackScore a dea:MetricProperty .
dea:noveltyScore a dea:MetricProperty .
dea:uncertaintyWidth a dea:MetricProperty .
dea:expectedInformationGain a dea:MetricProperty .
dea:experimentCost a dea:MetricProperty .
dea:actuationPerformed a dea:AuthorityProperty .
