PREFIX orr: <https://ggen.io/ontology/owning-rail-remediation-realization#>
SELECT ?realization ?subject_sha ?semantic_digest ?realization_state ?blocker_before ?blocker_after WHERE {
  ?realization a orr:Realization ; orr:realizationState ?realization_state ; orr:blockerBefore ?blocker_before ; orr:blockerAfter ?blocker_after .
  OPTIONAL { ?realization orr:subjectSha ?subject_sha }
  OPTIONAL { ?realization orr:semanticDigest ?semantic_digest }
} ORDER BY ?realization
