PREFIX rr: <https://seanchatmangpt.dev/ontology/remediation-realization#>
SELECT ?plan ?expected ?realized (?expected - ?realized AS ?regret) WHERE {
  ?plan a rr:RemediationPlan ; rr:expectedRelief ?expected ; rr:realizedRelief ?realized .
  FILTER(?expected >= ?realized)
}
ORDER BY DESC(?regret) ?plan
