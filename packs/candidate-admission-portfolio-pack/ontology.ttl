@prefix cap: <https://seanchatmangpt.github.io/cap#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cap:Policy a cap:PortfolioPolicy ; cap:maxUncertainty "0.25"^^xsd:decimal ; cap:maxRollbackCost "5.0"^^xsd:decimal ; cap:minEvidence "2"^^xsd:integer ; cap:authority "SELECT" ; cap:actuationPerformed false .
cap:Pareto a cap:SelectionStrategy ; cap:name "PARETO" .
cap:Maximin a cap:SelectionStrategy ; cap:name "MAXIMIN" .
cap:Experiment a cap:SelectionStrategy ; cap:name "DECISIVE_EXPERIMENT" .

# Pack manifest metadata (formerly pack.toml authority/consequential_do/[manufacture]).
cap:Pack a cap:PackManifest ;
  cap:authority "SELECT|CONSTRUCT|VERIFY" ;
  cap:consequentialDo "BRCE_ONLY" ;
  cap:source "ontology.ttl" ;
  cap:ggenSubject "seanchatmangpt/ggen@f4e1bce1efdcdc4f6c2531be9f66070950f7ec93" ;
  cap:predecessor "seanchatmangpt/ggen-marketplace@ca375cd0e6548c9fa1e3bd721ea120e61f379f67" .
