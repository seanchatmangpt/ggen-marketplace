@prefix sp: <https://chatmangpt.com/ontology/semantic-parts#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# CodeGraph gives us observed semantic axes. This ontology adds the missing
# interchangeable-parts boundary without turning observation into execution.

sp:SoftwarePart a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Software part" .

sp:SemanticObservation a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Observed semantic classification of a software part" .

sp:Algorithm a rdfs:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "Algorithm concept" .

sp:Domain a rdfs:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "Application domain concept" .

sp:ProgrammingParadigm a rdfs:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "Programming paradigm concept" .

sp:DesignPattern a rdfs:Class ;
  rdfs:subClassOf skos:Concept ;
  rdfs:label "Design pattern concept" .

sp:SubstitutionCandidate a rdfs:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Authority-free candidate substitution" .

sp:PartStanding a skos:ConceptScheme ;
  dcterms:title "Semantic parts standing" .
sp:Observed a skos:Concept ; skos:inScheme sp:PartStanding ; skos:prefLabel "OBSERVED" .
sp:Candidate a skos:Concept ; skos:inScheme sp:PartStanding ; skos:prefLabel "CANDIDATE" .
sp:Verified a skos:Concept ; skos:inScheme sp:PartStanding ; skos:prefLabel "VERIFIED" .
sp:Refused a skos:Concept ; skos:inScheme sp:PartStanding ; skos:prefLabel "REFUSED" .

sp:part a rdf:Property ;
  rdfs:domain sp:SemanticObservation ;
  rdfs:range sp:SoftwarePart .

sp:implementsAlgorithm a rdf:Property ;
  rdfs:domain sp:SoftwarePart ;
  rdfs:range sp:Algorithm .

sp:belongsToDomain a rdf:Property ;
  rdfs:domain sp:SoftwarePart ;
  rdfs:range sp:Domain .

sp:usesParadigm a rdf:Property ;
  rdfs:domain sp:SoftwarePart ;
  rdfs:range sp:ProgrammingParadigm .

sp:appliesPattern a rdf:Property ;
  rdfs:domain sp:SoftwarePart ;
  rdfs:range sp:DesignPattern .

sp:groundedIn a rdf:Property ;
  rdfs:subPropertyOf prov:wasDerivedFrom ;
  rdfs:comment "Canonical public concept identifier or evidence source, including Wikidata entities." .

sp:sourceRelease a rdf:Property ;
  rdfs:subPropertyOf dcterms:source .

sp:sourceFileId a rdf:Property ;
  rdfs:subPropertyOf dcterms:identifier .

sp:language a rdf:Property ;
  rdfs:domain sp:SoftwarePart .

sp:confidence a rdf:Property ;
  rdfs:domain sp:SemanticObservation ;
  rdfs:range xsd:decimal .

sp:subjectPart a rdf:Property ;
  rdfs:domain sp:SubstitutionCandidate ;
  rdfs:range sp:SoftwarePart .

sp:candidatePart a rdf:Property ;
  rdfs:domain sp:SubstitutionCandidate ;
  rdfs:range sp:SoftwarePart .

sp:requiredAxis a rdf:Property ;
  rdfs:domain sp:SubstitutionCandidate .

sp:sharedSemanticIdentity a rdf:Property ;
  rdfs:domain sp:SubstitutionCandidate .

sp:evidenceRef a rdf:Property ;
  rdfs:domain sp:SubstitutionCandidate ;
  rdfs:subPropertyOf prov:wasDerivedFrom .

sp:standing a rdf:Property ;
  rdfs:range skos:Concept .

sp:authorityBoundary a rdf:Property .

sp:CodeGraphReleaseV1 a prov:Entity ;
  dcterms:title "CodeGraph public release v1" ;
  dcterms:identifier "codegraph_release_v1" ;
  dcterms:source <https://github.com/halykoss/CodeGraph> .

sp:ObservationAuthorityLaw a prov:Entity ;
  dcterms:title "Semantic observation does not grant execution authority" ;
  dcterms:description "Every observed part and every substitution candidate carries authorityBoundary NONE. Grounding, similarity, and semantic overlap remain SELECT/CONSTRUCT evidence." .

sp:SubstitutionEvidenceLaw a prov:Entity ;
  dcterms:title "Candidate substitution requires an explicit shared semantic identity" ;
  dcterms:description "A candidate must cite at least one shared canonical semantic identity and its evidence. Semantic agreement is a discovery filter, not behavioral equivalence." .

sp:BehavioralFalsifierLaw a prov:Entity ;
  dcterms:title "Replacement standing requires independent behavioral verification" ;
  dcterms:description "A CodeGraph match may reach CANDIDATE only. VERIFIED standing requires an independent verifier for the required semantics and cannot be inferred from taxonomy membership alone." .
