@prefix ex: <https://example.org/semantic-parts/qualification/> .
@prefix sp: <https://chatmangpt.com/ontology/semantic-parts#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex:codegraph-observation a sp:SemanticObservation ;
  sp:part ex:python-part ;
  sp:sourceRelease sp:CodeGraphReleaseV1 ;
  prov:wasDerivedFrom sp:CodeGraphReleaseV1 .

ex:python-part a sp:SoftwarePart ;
  dcterms:identifier "codegraph:file:1" ;
  sp:sourceFileId "1" ;
  sp:language "Python" ;
  sp:implementsAlgorithm ex:dijkstra ;
  sp:belongsToDomain ex:graph-theory ;
  sp:usesParadigm ex:imperative ;
  sp:standing sp:Observed ;
  sp:authorityBoundary "NONE" .

ex:rust-part a sp:SoftwarePart ;
  dcterms:identifier "codegraph:file:2" ;
  sp:sourceFileId "2" ;
  sp:language "Rust" ;
  sp:implementsAlgorithm ex:dijkstra ;
  sp:belongsToDomain ex:graph-theory ;
  sp:usesParadigm ex:imperative ;
  sp:standing sp:Observed ;
  sp:authorityBoundary "NONE" .

ex:dijkstra a sp:Algorithm ;
  sp:groundedIn <http://www.wikidata.org/entity/Q12105> .

ex:graph-theory a sp:Domain ;
  sp:groundedIn <http://www.wikidata.org/entity/Q131476> .

ex:imperative a sp:ProgrammingParadigm ;
  sp:groundedIn <http://www.wikidata.org/entity/Q275596> .

ex:behavioral-proof a prov:Entity ;
  dcterms:description "Independent verifier evidence; not derived from CodeGraph taxonomy membership." .

ex:replacement a sp:SubstitutionCandidate ;
  sp:subjectPart ex:python-part ;
  sp:candidatePart ex:rust-part ;
  sp:requiredAxis "algorithm", "domain", "paradigm" ;
  sp:sharedSemanticIdentity
    <http://www.wikidata.org/entity/Q12105>,
    <http://www.wikidata.org/entity/Q131476>,
    <http://www.wikidata.org/entity/Q275596> ;
  sp:evidenceRef ex:behavioral-proof ;
  sp:standing sp:Candidate ;
  sp:authorityBoundary "NONE" .
