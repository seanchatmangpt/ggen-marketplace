@prefix ex: <https://example.org/semantic-parts/> .
@prefix sp: <https://chatmangpt.com/ontology/semantic-parts#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex:python a sp:SoftwarePart ;
  sp:authorityBoundary "NONE" ;
  sp:implementsAlgorithm ex:dijkstra ;
  sp:standing sp:Observed .

ex:rust a sp:SoftwarePart ;
  sp:authorityBoundary "NONE" ;
  sp:implementsAlgorithm ex:dijkstra ;
  sp:standing sp:Observed .

ex:dijkstra a sp:Algorithm ;
  sp:groundedIn <http://www.wikidata.org/entity/Q12105> .

ex:independent-behavioral-proof a prov:Entity .

ex:candidate a sp:SubstitutionCandidate ;
  sp:subjectPart ex:python ;
  sp:candidatePart ex:rust ;
  sp:requiredAxis "algorithm" ;
  sp:sharedSemanticIdentity <http://www.wikidata.org/entity/Q12105> ;
  sp:evidenceRef ex:independent-behavioral-proof ;
  sp:standing sp:Candidate ;
  sp:authorityBoundary "NONE" .
