@prefix ex: <https://example.org/semantic-parts/verified/> .
@prefix sp: <https://chatmangpt.com/ontology/semantic-parts#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex:verification a sp:BehavioralVerification .

ex:witness a sp:BehavioralWitness ;
  prov:wasGeneratedBy ex:verification .

ex:candidate a sp:SubstitutionCandidate ;
  sp:subjectPart ex:a ;
  sp:candidatePart ex:b ;
  sp:sharedSemanticIdentity <http://www.wikidata.org/entity/Q12105> ;
  sp:evidenceRef ex:witness ;
  sp:behavioralWitness ex:witness ;
  sp:standing sp:Verified ;
  sp:authorityBoundary "NONE" .
