@prefix sp: <https://chatmangpt.com/ontology/semantic-parts#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sp:SoftwarePartShape a sh:NodeShape ;
  sh:targetClass sp:SoftwarePart ;
  sh:property [
    sh:path sp:authorityBoundary ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue "NONE"
  ] ;
  sh:property [
    sh:path sp:standing ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] .

sp:SubstitutionCandidateShape a sh:NodeShape ;
  sh:targetClass sp:SubstitutionCandidate ;
  sh:property [
    sh:path sp:subjectPart ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class sp:SoftwarePart
  ] ;
  sh:property [
    sh:path sp:candidatePart ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class sp:SoftwarePart
  ] ;
  sh:property [
    sh:path sp:sharedSemanticIdentity ;
    sh:minCount 1
  ] ;
  sh:property [
    sh:path sp:authorityBoundary ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:hasValue "NONE"
  ] ;
  sh:property [
    sh:path sp:standing ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] .

sp:BehavioralWitnessShape a sh:NodeShape ;
  sh:targetClass sp:BehavioralWitness ;
  sh:property [
    sh:path <http://www.w3.org/ns/prov#wasGeneratedBy> ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class sp:BehavioralVerification
  ] .

sp:VerifiedCandidateShape a sh:NodeShape ;
  sh:target [
    a sh:SPARQLTarget ;
    sh:prefixes sp:VerifiedCandidatePrefixes ;
    sh:select """
      SELECT ?this WHERE {
        ?this a sp:SubstitutionCandidate ;
              sp:standing sp:Verified .
      }
    """
  ] ;
  sh:property [
    sh:path sp:behavioralWitness ;
    sh:minCount 1 ;
    sh:class sp:BehavioralWitness
  ] .

sp:VerifiedCandidatePrefixes
  sh:declare [
    sh:prefix "sp" ;
    sh:namespace "https://chatmangpt.com/ontology/semantic-parts#"^^xsd:anyURI
  ] .
