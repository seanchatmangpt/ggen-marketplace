# MESSAGE: VERIFIED substitution standing requires a behavioral witness
# generated by an explicit BehavioralVerification activity. Taxonomy,
# ontology, signature equality, or CodeGraph grounding alone can only support
# discovery/candidate standing.
PREFIX sp: <https://chatmangpt.com/ontology/semantic-parts#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?candidate ?reason WHERE {
  ?candidate a sp:SubstitutionCandidate ;
             sp:standing sp:Verified .

  FILTER NOT EXISTS {
    ?candidate sp:behavioralWitness ?witness .
    ?witness a sp:BehavioralWitness ;
             prov:wasGeneratedBy ?verification .
    ?verification a sp:BehavioralVerification .
  }

  BIND("VERIFIED_WITHOUT_BEHAVIORAL_WITNESS" AS ?reason)
}
ORDER BY ?candidate
