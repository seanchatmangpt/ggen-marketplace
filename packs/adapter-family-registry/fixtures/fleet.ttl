@prefix afr: <https://chatmangpt.com/ontology/adapter-family-registry#> .
@prefix ex: <https://chatmangpt.com/example/> .
ex:elixir a afr:AdapterFamily ; afr:templateKey "elixir"; afr:mediaType "application/x-elixir" .
ex:json a afr:AdapterFamily ; afr:templateKey "json"; afr:mediaType "application/json" .
ex:openapi a afr:AdapterFamily ; afr:templateKey "openapi"; afr:mediaType "application/vnd.oai.openapi" .
ex:protobuf a afr:AdapterFamily ; afr:templateKey "protobuf"; afr:mediaType "application/protobuf" .
ex:sql a afr:AdapterFamily ; afr:templateKey "sql"; afr:mediaType "application/sql" .
ex:cs2 a afr:Subject . ex:ptd a afr:Subject . ex:xaas a afr:Consumer . ex:gymact a afr:Consumer . ex:sjira a afr:Consumer .
ex:p1 a afr:Projection ; afr:subject ex:cs2 ; afr:consumer ex:xaas ; afr:adapterFamily ex:elixir ; afr:targetPath "generated/xaas/cs2"; afr:moduleName "Xaas.Generated.CS2"; afr:packageName "xaas-cs2" .
ex:p2 a afr:Projection ; afr:subject ex:ptd ; afr:consumer ex:gymact ; afr:adapterFamily ex:json ; afr:targetPath "generated/gymact/ptd"; afr:moduleName "Gymact.Generated.PTD"; afr:packageName "gymact-ptd" .
ex:p3 a afr:Projection ; afr:subject ex:cs2 ; afr:consumer ex:sjira ; afr:adapterFamily ex:openapi ; afr:targetPath "generated/sjira/cs2"; afr:moduleName "SemanticJira.Generated.CS2"; afr:packageName "sjira-cs2" .
