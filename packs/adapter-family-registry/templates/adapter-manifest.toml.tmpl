---
to: "generated/adapter-manifest.toml"
sparql:
  projections: |
    PREFIX afr: <https://chatmangpt.com/ontology/adapter-family-registry#>
    SELECT ?subject ?consumer ?family ?template_key ?media_type ?module_name ?package_name ?target_path
    WHERE {
      ?p a afr:Projection ;
        afr:subject ?subject ;
        afr:consumer ?consumer ;
        afr:adapterFamily ?family ;
        afr:targetPath ?target_path ;
        afr:moduleName ?module_name ;
        afr:packageName ?package_name .
      ?family afr:templateKey ?template_key ;
        afr:mediaType ?media_type .
    } ORDER BY ?package_name
---
# generated: do not edit
{% for row in projections %}
[[adapter]]
subject="{{ row.subject }}"
consumer="{{ row.consumer }}"
family="{{ row.family }}"
template_key="{{ row.template_key }}"
media_type="{{ row.media_type }}"
module="{{ row.module_name }}"
package="{{ row.package_name }}"
target_path="{{ row.target_path }}"
{% endfor %}
