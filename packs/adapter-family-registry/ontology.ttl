@prefix afr: <https://chatmangpt.com/ontology/adapter-family-registry#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
afr:Subject a rdfs:Class . afr:Consumer a rdfs:Class . afr:AdapterFamily a rdfs:Class . afr:Projection a rdfs:Class .
afr:subject a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range afr:Subject .
afr:consumer a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range afr:Consumer .
afr:adapterFamily a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range afr:AdapterFamily .
afr:targetPath a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range xsd:string .
afr:moduleName a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range xsd:string .
afr:packageName a rdf:Property ; rdfs:domain afr:Projection ; rdfs:range xsd:string .
afr:templateKey a rdf:Property ; rdfs:domain afr:AdapterFamily ; rdfs:range xsd:string .
afr:mediaType a rdf:Property ; rdfs:domain afr:AdapterFamily ; rdfs:range xsd:string .
