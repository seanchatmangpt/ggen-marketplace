PREFIX mfc: <https://ggen.dev/ontology/manufacturing-fanout#>
SELECT ?edge ?asset ?consumer ?actions ?investment (?actions / ?investment AS ?yield) WHERE {
  ?edge a mfc:FanoutEdge ; mfc:asset ?asset ; mfc:consumer ?consumer ; mfc:expectedQualifiedActions ?actions ; mfc:investmentUnits ?investment ; mfc:authority "SELECT" ; mfc:actuationPerformed false .
  FILTER(?investment > 0 && (?actions / ?investment) > 1)
}
ORDER BY DESC(?yield)
