@prefix mfc: <https://ggen.dev/ontology/manufacturing-fanout#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

mfc:ManufacturingAsset a prov:Entity .
mfc:ConsumerTarget a prov:Entity .
mfc:FanoutEdge a prov:Entity .
mfc:QualificationPlan a prov:Entity .

mfc:controller mfc:authority "SELECT|CONSTRUCT|VERIFY" ; mfc:actuationPerformed false ; mfc:requiresExactSubject true ; mfc:requiresQualifiedFactory true ; mfc:requiresIndependentConsumerQualification true .

mfc:multiCellFactory a mfc:ManufacturingAsset ; mfc:pack "multicell-consumer-factory-pack" ; mfc:standing "ALIVE" .
mfc:lineageFactory a mfc:ManufacturingAsset ; mfc:pack "capability-lineage-propagation-pack" ; mfc:standing "ALIVE" .
mfc:sensorFactory a mfc:ManufacturingAsset ; mfc:pack "ggen-project-boundary-pack" ; mfc:standing "ALIVE" .

mfc:aps a mfc:ConsumerTarget ; mfc:repository "seanchatmangpt/agile-protocol-specification" ; mfc:mode "DIRECT_GENERATION" .
mfc:chatmanTrain a mfc:ConsumerTarget ; mfc:repository "seanchatmangpt/chatman-ecosystem" ; mfc:mode "LINEAGE_PROPAGATION" .

mfc:edgeA a mfc:FanoutEdge ; mfc:asset mfc:multiCellFactory ; mfc:consumer mfc:aps ; mfc:expectedQualifiedActions 4 ; mfc:investmentUnits 1 ; mfc:authority "SELECT" ; mfc:actuationPerformed false .
mfc:edgeB a mfc:FanoutEdge ; mfc:asset mfc:lineageFactory ; mfc:consumer mfc:chatmanTrain ; mfc:expectedQualifiedActions 3 ; mfc:investmentUnits 1 ; mfc:authority "SELECT" ; mfc:actuationPerformed false .
