@prefix fin:   <https://ggen.io/ontology/financial-ledger#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# industry-financial-ledger ontology
#
# FINREC-style double-entry ledger vocabulary, authored locally
# (FIBO's full credit-index structure is not minimally expressible
# here without importing its finance-specific upper structure, so
# the pack authors a minimal double-entry vocabulary instead, in
# the FINREC bookkeeping spirit: entries, balanced legs, accounts).
#
# Grounded in the smalt emulator faces (docs/jira/v26.10.22/
# azure-industry-matrix.md, row 2):
#   - Cosmos = CAS ledgers: lib/smalt/data_plane/cosmos.ex:133
#     (ETag CAS); lib/smalt/egress/CosmosRoutes.ex:18
#     (POST /app/transactions batch)
#   - SB = settlement workflow queues: lib/smalt/messaging/amqp
#     (Service Bus 5672, SQL filter rules)
#   - EH = audit telemetry: lib/smalt/messaging/event_hubs/listener.ex:3
#     (5673), consumer groups event_hubs.ex:847-917
#   - KV = keys/sign: KvRoutes.ex:28, kv_pss.ex (PS256)
#
# Concurrency law: a JournalEntry commits ONLY via Cosmos ETag CAS
# (If-Match on the account document's _etag). The ontology models
# the etag as a required per-entry property; the gates refuse
# entries that violate double-entry or referential integrity.
#################################################################

### ---------- Core classes ----------

fin:Account a rdfs:Class ;
    rdfs:label "Ledger Account" ;
    dct:description "A double-entry ledger account (the Cosmos document holding the running balance; its _etag is the CAS token)." .

fin:JournalEntry a rdfs:Class ;
    rdfs:label "Journal Entry" ;
    dct:description "A double-entry transaction: a set of debit/credit Posting legs that must balance (sum debits == sum credits)." .

fin:Posting a rdfs:Class ;
    rdfs:label "Posting (leg)" ;
    dct:description "One debit or credit leg of a JournalEntry against one Account." .

fin:SettlementStage a rdfs:Class ;
    rdfs:label "Settlement Stage" ;
    dct:description "A stage of the settlement workflow, bound to one Service Bus queue." .

### ---------- Properties ----------

fin:entryId a rdf:Property ;
    rdfs:label "entry id" ;
    dct:description "Client-supplied idempotency key for the entry (unique across the ledger; duplicates refuse)." .

fin:hasPosting a rdf:Property ;
    rdfs:label "has posting" ;
    dct:description "Links a JournalEntry to its Posting legs. At least two legs per entry." .

fin:account a rdf:Property ;
    rdfs:label "account" ;
    dct:description "Links a Posting to its Account. Required; dangling refs refuse." .

fin:debitAmount a rdf:Property ;
    rdfs:label "debit amount" ;
    dct:description "Debit leg amount (xsd:decimal). Exactly one of debit/credit per posting." .

fin:creditAmount a rdf:Property ;
    rdfs:label "credit amount" ;
    dct:description "Credit leg amount (xsd:decimal). Exactly one of debit/credit per posting." .

fin:accountNumber a rdf:Property ;
    rdfs:label "account number" ;
    dct:description "Human-readable account number (unique per Account; the Cosmos document id)." .

fin:postedAt a rdf:Property ;
    rdfs:label "posted at" ;
    dct:description "Commit timestamp (xsd:dateTime)." .

fin:casEtag a rdf:Property ;
    rdfs:label "CAS etag" ;
    dct:description "The Cosmos document _etag the entry CAS'd on (If-Match). Required on every committed entry." .

fin:stageIndex a rdf:Property ;
    rdfs:label "stage index" ;
    dct:description "Ordering index of a SettlementStage in the workflow." .

fin:queueName a rdf:Property ;
    rdfs:label "queue name" ;
    dct:description "Service Bus queue bound to a SettlementStage (SB 5672)." .

fin:auditTopic a rdf:Property ;
    rdfs:label "audit topic" ;
    dct:description "Event Hubs topic carrying the stage's audit telemetry (EH 5673)." .

### ---------- Individuals: settlement workflow ----------

fin:Capture a fin:SettlementStage ;
    rdfs:label "Capture" ;
    fin:stageIndex 1 ;
    fin:queueName "settle-capture" ;
    fin:auditTopic "eh-audit-ledger" .

fin:Enrich a fin:SettlementStage ;
    rdfs:label "Enrich" ;
    fin:stageIndex 2 ;
    fin:queueName "settle-enrich" ;
    fin:auditTopic "eh-audit-ledger" .

fin:Enrich2 a fin:SettlementStage ;
    rdfs:label "Enrich2" ;
    fin:stageIndex 3 ;
    fin:queueName "settle-enrich2" ;
    fin:auditTopic "eh-audit-ledger" .

fin:Settle a fin:SettlementStage ;
    rdfs:label "Settle" ;
    fin:stageIndex 4 ;
    fin:queueName "settle-settle" ;
    fin:auditTopic "eh-audit-ledger" .

fin:Audit a fin:SettlementStage ;
    rdfs:label "Audit" ;
    fin:stageIndex 5 ;
    fin:queueName "settle-audit" ;
    fin:auditTopic "eh-audit-ledger" .

### ---------- Pillar vocabulary (IND-2, 5-pillar spec) ----------
#
# P1 isolation, P2 BYOK/SKR, P3 proposer-judge, P5 Merkle self-auth.
# Shapes follow the pack-family precedents: AZ-2 attestation shape
# (industry-legal-ediscovery gate 050, smalt lib/smalt/attestation/maa.ex
# secure_key_release/3: token measurement_digest == expected fingerprint)
# and the Merkle-seal shape (industry-pharma-21cfr gate 080).

fin:LedgerStore a rdfs:Class ;
    rdfs:label "Ledger Store" ;
    dct:description "An isolated ledger store holding one account's journal (per-account journal path law). Face: Cosmos per-account document containers, lib/smalt/data_plane/cosmos.ex." .

fin:SettlementCompletion a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Settlement Completion" ;
    dct:description "A prov:Activity completing one SettlementStage; settlement-stage completions must bind an attestation fingerprint (P2, AZ-2 shape)." .

fin:JudgeActivity a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Judge Activity" ;
    dct:description "A prov:Activity adjudicating an AI-proposed categorization before the entry commits (P3 proposer-judge)." .

fin:SettledBatch a rdfs:Class ;
    rdfs:label "Settled Batch" ;
    dct:description "A batch of settled entries; every settled batch must reference a sealed Merkle root (P5)." .

fin:MerkleSeal a rdfs:Class ;
    rdfs:label "Merkle Seal" ;
    dct:description "Sealed Merkle root + receipt digest over a SettledBatch (P5 Merkle self-auth)." .

fin:isolatedStore a rdf:Property ;
    rdfs:label "isolated store" ;
    dct:description "Links a JournalEntry to the isolated LedgerStore holding its per-account journal. Required on every committed entry (P1, gate 040)." .

fin:journalPath a rdf:Property ;
    rdfs:label "journal path" ;
    dct:description "Per-account journal path of a LedgerStore. Required on every LedgerStore (P1, gate 040)." .

fin:completesStage a rdf:Property ;
    rdfs:label "completes stage" ;
    dct:description "Links a SettlementCompletion to the SettlementStage it completes." .

fin:attestationFingerprint a rdf:Property ;
    rdfs:label "attestation fingerprint" ;
    dct:description "The MAA measurement fingerprint a settlement completion was attested under (AZ-2 shape: token measurement_digest == expected fingerprint). Required on every SettlementCompletion (P2, gate 050). Face: smalt lib/smalt/attestation/maa.ex." .

fin:aiCategory a rdf:Property ;
    rdfs:label "AI category" ;
    dct:description "An AI-proposed categorization on a JournalEntry; entries carrying one must be wasGeneratedBy a JudgeActivity before commit (P3, gate 060)." .

fin:hasMerkleSeal a rdf:Property ;
    rdfs:label "has Merkle seal" ;
    dct:description "Links a SettledBatch to its MerkleSeal (P5, gate 070)." .

fin:sealedRoot a rdf:Property ;
    rdfs:label "sealed root" ;
    dct:description "Sealed Merkle root (sha256:...) carried by a MerkleSeal (P5, gate 070)." .

fin:receiptDigest a rdf:Property ;
    rdfs:label "receipt digest" ;
    dct:description "320-byte receipt digest carried by a MerkleSeal (P5, gate 070)." .
