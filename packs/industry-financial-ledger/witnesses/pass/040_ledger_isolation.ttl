# PASS witness 040 (P1 ledger isolation): every entry bound to an isolated
# LedgerStore carrying a per-account journal path; all gates silent.
@prefix fin: <https://ggen.io/ontology/financial-ledger#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fin:acct-1001 a fin:Account ; fin:accountNumber "1001" .
fin:acct-2002 a fin:Account ; fin:accountNumber "2002" .

fin:store-1001 a fin:LedgerStore ;
    fin:journalPath "journals/1001/journal.ndjson" .

fin:store-2002 a fin:LedgerStore ;
    fin:journalPath "journals/2002/journal.ndjson" .

fin:je-040a a fin:JournalEntry ;
    fin:entryId "je-2026-0410" ;
    fin:casEtag "0000000d-0000-0100-0000-0000000000040" ;
    fin:isolatedStore fin:store-1001 ;
    fin:hasPosting fin:p-040a-1, fin:p-040a-2 .

fin:p-040a-1 a fin:Posting ; fin:account fin:acct-1001 ;
    fin:debitAmount "75.00"^^xsd:decimal .

fin:p-040a-2 a fin:Posting ; fin:account fin:acct-2002 ;
    fin:creditAmount "75.00"^^xsd:decimal .

fin:je-040b a fin:JournalEntry ;
    fin:entryId "je-2026-0411" ;
    fin:casEtag "0000000d-0000-0100-0000-0000000000041" ;
    fin:isolatedStore fin:store-2002 ;
    fin:hasPosting fin:p-040b-1, fin:p-040b-2 .

fin:p-040b-1 a fin:Posting ; fin:account fin:acct-2002 ;
    fin:debitAmount "25.00"^^xsd:decimal .

fin:p-040b-2 a fin:Posting ; fin:account fin:acct-1001 ;
    fin:creditAmount "25.00"^^xsd:decimal .
