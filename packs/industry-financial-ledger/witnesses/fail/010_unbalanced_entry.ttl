# FAIL witness 010: debits 250 != credits 240 — unbalanced entry (the ONLY law broken).
@prefix fin: <https://ggen.io/ontology/financial-ledger#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fin:acct-1001 a fin:Account ; fin:accountNumber "1001" .

fin:je-bad-bal a fin:JournalEntry ;
    fin:entryId "je-2026-0040" ;
    fin:casEtag "0000000d-0000-0100-0000-0000000000f0" ;
    fin:hasPosting fin:p-bb-a, fin:p-bb-b .

fin:p-bb-a a fin:Posting ; fin:account fin:acct-1001 ;
    fin:debitAmount "250.00"^^xsd:decimal .

fin:p-bb-b a fin:Posting ; fin:account fin:acct-1001 ;
    fin:creditAmount "240.00"^^xsd:decimal .
