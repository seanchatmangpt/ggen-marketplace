@prefix fin: <https://ggen.io/ontology/financial-ledger#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### NEGATIVE witness: each gate must fire at least one row.
###   je-bad-bal  -> 010 (debits 250 != credits 240)
###   je-dangling -> 020 (posting -> fin:acct-9999 which is not declared)
###   fin:p-miss  -> 020 (posting with no fin:account)
###   je-dup-a/b  -> 030 (duplicate entryId "je-2026-0042")

fin:acct-1001 a fin:Account ; fin:accountNumber "1001" .

fin:je-bad-bal a fin:JournalEntry ;
    fin:entryId "je-2026-0040" ;
    fin:casEtag "0000000d-0000-0100-0000-0000000000f0" ;
    fin:hasPosting fin:p-bb-a, fin:p-bb-b .

fin:p-bb-a a fin:Posting ; fin:account fin:acct-1001 ;
    fin:debitAmount "250.00"^^xsd:decimal .

fin:p-bb-b a fin:Posting ; fin:account fin:acct-1001 ;
    fin:creditAmount "240.00"^^xsd:decimal .

fin:je-dangling a fin:JournalEntry ;
    fin:entryId "je-2026-0041" ;
    fin:casEtag "0000000d-0000-0100-0000-0000000000f1" ;
    fin:hasPosting fin:p-dg-a, fin:p-dg-b .

fin:p-dg-a a fin:Posting ; fin:account fin:acct-9999 ;
    fin:debitAmount "10.00"^^xsd:decimal .

fin:p-dg-b a fin:Posting ; fin:account fin:acct-1001 ;
    fin:creditAmount "10.00"^^xsd:decimal .

fin:p-miss a fin:Posting ;
    fin:debitAmount "5.00"^^xsd:decimal .

fin:je-dup-a a fin:JournalEntry ;
    fin:entryId "je-2026-0042" ;
    fin:casEtag "0000000d-0000-0100-0000-0000000000f2" ;
    fin:hasPosting fin:p-dp-a, fin:p-dp-b .

fin:p-dp-a a fin:Posting ; fin:account fin:acct-1001 ;
    fin:debitAmount "1.00"^^xsd:decimal .

fin:p-dp-b a fin:Posting ; fin:account fin:acct-1001 ;
    fin:creditAmount "1.00"^^xsd:decimal .

fin:je-dup-b a fin:JournalEntry ;
    fin:entryId "je-2026-0042" ;
    fin:casEtag "0000000d-0000-0100-0000-0000000000f3" ;
    fin:hasPosting fin:p-dq-a, fin:p-dq-b .

fin:p-dq-a a fin:Posting ; fin:account fin:acct-1001 ;
    fin:debitAmount "2.00"^^xsd:decimal .

fin:p-dq-b a fin:Posting ; fin:account fin:acct-1001 ;
    fin:creditAmount "2.00"^^xsd:decimal .
