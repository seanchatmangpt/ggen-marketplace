@prefix ecr: <https://chatman.ai/ontology/evidence-capital-realization#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ecr:EvidenceCapitalRealizationPack a ecr:MeasurementPack ;
  ecr:authority "OBSERVE|VERIFY" ;
  ecr:consequentialDo "BRCE_ONLY" ;
  ecr:requiresExactSubject true .

ecr:CapitalModel a ecr:ModelClass .
ecr:RealizationTrial a ecr:EvidenceClass .
ecr:CapitalReceipt a ecr:ReceiptClass .
ecr:subjectSha a ecr:IdentityProperty .
ecr:semanticDigest a ecr:IdentityProperty .
ecr:modelDigest a ecr:IdentityProperty .
ecr:evidenceRoot a ecr:IdentityProperty .
ecr:claimedCapital a ecr:MeasureProperty .
ecr:realizedGain a ecr:MeasureProperty .
ecr:baselineLoss a ecr:MeasureProperty .
ecr:augmentedLoss a ecr:MeasureProperty .
ecr:informationGain a ecr:MeasureProperty .
ecr:observedTruth a ecr:MeasureProperty .
ecr:prediction a ecr:MeasureProperty .
ecr:observedAt a ecr:TemporalProperty .
ecr:currentGeneration a ecr:TemporalProperty .
ecr:actuationPerformed a ecr:AuthorityProperty .
