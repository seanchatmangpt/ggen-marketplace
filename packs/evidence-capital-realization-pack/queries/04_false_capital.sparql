PREFIX ecr: <https://chatman.ai/ontology/evidence-capital-realization#>
SELECT ?t ?capital ?baseline ?augmented WHERE {
  ?t a ecr:RealizationTrial ; ecr:claimedCapital ?capital ; ecr:baselineLoss ?baseline ; ecr:augmentedLoss ?augmented .
  FILTER(?capital > 1 && ?augmented >= ?baseline)
} ORDER BY DESC(?capital) ?t
