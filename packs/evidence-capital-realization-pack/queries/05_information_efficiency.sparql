PREFIX ecr: <https://chatman.ai/ontology/evidence-capital-realization#>
SELECT ?t ?capital ?information ((?information / ?capital) AS ?efficiency) WHERE {
  ?t a ecr:RealizationTrial ; ecr:claimedCapital ?capital ; ecr:informationGain ?information .
  FILTER(?capital > 0)
} ORDER BY DESC(?efficiency) ?t
