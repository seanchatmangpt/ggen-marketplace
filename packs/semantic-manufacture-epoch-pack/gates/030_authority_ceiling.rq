# MESSAGE: planner authority must be none and generator authority may not exceed CONSTRUCT
PREFIX sm: <http://seanchatmangpt.github.io/packs/semantic-manufacture-epoch#>
SELECT ?epoch WHERE {
  ?epoch a sm:Epoch .
  FILTER(
    NOT EXISTS { ?epoch sm:plannerAuthority "none" . } ||
    NOT EXISTS { ?epoch sm:generatorAuthorityCeiling "construct" . }
  )
}
ORDER BY ?epoch