# MESSAGE: semantic manufacture requires canonicalTruth=semantic_graph and generatedArtifactRole=projection
PREFIX sm: <http://seanchatmangpt.github.io/packs/semantic-manufacture-epoch#>
SELECT ?epoch WHERE {
  ?epoch a sm:Epoch .
  FILTER(
    NOT EXISTS { ?epoch sm:canonicalTruth "semantic_graph" . } ||
    NOT EXISTS { ?epoch sm:generatedArtifactRole "projection" . }
  )
}
ORDER BY ?epoch