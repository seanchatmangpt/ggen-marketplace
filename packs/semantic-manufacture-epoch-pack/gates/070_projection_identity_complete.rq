# MESSAGE: generated projection identity is incomplete
PREFIX sm: <http://seanchatmangpt.github.io/packs/semantic-manufacture-epoch#>
SELECT ?projection WHERE {
  ?projection a sm:Projection .
  FILTER(
    NOT EXISTS { ?projection sm:graphDigest ?graphDigest . } ||
    NOT EXISTS { ?projection sm:projectionDigest ?projectionDigest . } ||
    NOT EXISTS { ?projection sm:manufacturerDigest ?manufacturerDigest . }
  )
}
ORDER BY ?projection