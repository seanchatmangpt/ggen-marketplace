# MESSAGE: every admitted semantic manufacture epoch requires receipt and replay evidence
PREFIX sm: <http://seanchatmangpt.github.io/packs/semantic-manufacture-epoch#>
SELECT ?epoch WHERE {
  ?epoch a sm:Epoch .
  FILTER(
    NOT EXISTS { ?epoch sm:receiptRequired true . } ||
    NOT EXISTS { ?epoch sm:replayRequired true . }
  )
}
ORDER BY ?epoch