# MESSAGE: v26.9.15 ephemeral projection contract mismatch
PREFIX sm: <http://seanchatmangpt.github.io/packs/semantic-manufacture-epoch#>
SELECT ?epoch WHERE {
  ?epoch a sm:Epoch ; sm:version "26.9.15" .
  FILTER(
    NOT EXISTS { ?epoch sm:humanReadableProjectionRequired false . } ||
    NOT EXISTS { ?epoch sm:persistentProjectionRequired false . } ||
    NOT EXISTS { ?epoch sm:projectionDisposition "ephemeral" . }
  )
}
ORDER BY ?epoch