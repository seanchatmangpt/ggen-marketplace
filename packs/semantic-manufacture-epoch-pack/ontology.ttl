# Semantic Manufacture Epoch — v26.9.14 constitution + v26.9.15 ephemerals.
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sm:   <http://seanchatmangpt.github.io/packs/semantic-manufacture-epoch#> .

sm:Epoch a rdfs:Class ;
  rdfs:comment "One admitted semantic manufacture epoch. This class declares law; it grants no execution authority." .
sm:Projection a rdfs:Class ;
  rdfs:comment "One generated implementation projection. Projection identity is evidence, never ambient authority." .

sm:version a rdf:Property .
sm:canonicalTruth a rdf:Property .
sm:generatedArtifactRole a rdf:Property .
sm:handwrittenGeneratedEdits a rdf:Property .
sm:plannerAuthority a rdf:Property .
sm:generatorAuthorityCeiling a rdf:Property .
sm:consequenceDoAuthority a rdf:Property .
sm:receiptRequired a rdf:Property .
sm:replayRequired a rdf:Property .
sm:humanReadableProjectionRequired a rdf:Property .
sm:persistentProjectionRequired a rdf:Property .
sm:projectionDisposition a rdf:Property .
sm:graphDigest a rdf:Property .
sm:projectionDigest a rdf:Property .
sm:manufacturerDigest a rdf:Property .
sm:verificationReceiptDigest a rdf:Property .

sm:Epoch_v26_9_14 a sm:Epoch ;
  sm:version "26.9.14" ;
  sm:canonicalTruth "semantic_graph" ;
  sm:generatedArtifactRole "projection" ;
  sm:handwrittenGeneratedEdits "refused" ;
  sm:plannerAuthority "none" ;
  sm:generatorAuthorityCeiling "construct" ;
  sm:consequenceDoAuthority "external" ;
  sm:receiptRequired true ;
  sm:replayRequired true .

sm:Epoch_v26_9_15 a sm:Epoch ;
  sm:version "26.9.15" ;
  sm:canonicalTruth "semantic_graph" ;
  sm:generatedArtifactRole "projection" ;
  sm:handwrittenGeneratedEdits "refused" ;
  sm:plannerAuthority "none" ;
  sm:generatorAuthorityCeiling "construct" ;
  sm:consequenceDoAuthority "external" ;
  sm:receiptRequired true ;
  sm:replayRequired true ;
  sm:humanReadableProjectionRequired false ;
  sm:persistentProjectionRequired false ;
  sm:projectionDisposition "ephemeral" .
