  const signIn = useCallback((email, password) => sb.auth.signInWithPassword({ email, password }), [sb]);
  const signInWithOAuth = useCallback((provider) => sb.auth.signInWithOAuth({ provider }), [sb]);
  const signInWithOtp = useCallback((email) => sb.auth.signInWithOtp({ email }), [sb]);
  const signOut = useCallback(() => sb.auth.signOut(), [sb]);
