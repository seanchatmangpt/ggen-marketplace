@prefix pack: <urn:ggen-marketplace:phage-wars-3-react-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:Project a pack:AdmittedProject ;
    rdfs:label "phage-wars-3" ;
    pack:originZip "~/Downloads/phage wars 3-handoff.zip"^^xsd:string ;
    pack:extractedPath "/tmp/dl-extract/phage-wars-3/phage-wars-3/project"^^xsd:string ;
    pack:framework "Standalone/global-script React (UMD-style IIFE modules; no package.json, no npm build tooling) + three.js + deck.gl 8.x UMD game canvas, with a mock Supabase real-time hooks layer" ;
    pack:packageManager "none — raw source drop, no package.json found" ;
    rdfs:comment "React canvas game extracted from a Downloads zip handoff; no source code was copied into this pack's ontology beyond the representative files staged for template generation." .

pack:DeckGlUsage a pack:TechnologyFinding ;
    rdfs:label "deck.gl" ;
    pack:status "real" ;
    pack:literalMatchCount 10 ;
    rdfs:comment "deck.gl is genuinely referenced: the literal string \"deck.gl\" appears 5 times in PhageWars.jsx and 5 times in PhageOnlineBundle.jsx. PhageWars.jsx's header comment documents window.deck (deck.gl 8.x UMD) as a required global alongside window.THREE, and the Stage component mounts three.js / deck.gl / minimap canvases." .

pack:SupabaseUsage a pack:TechnologyFinding ;
    rdfs:label "supabase-react real-time hooks" ;
    pack:status "real (mock backend)" ;
    rdfs:comment "supabase-react.jsx implements a full hooks layer (useAuth, useProfile, useQuery, useRealtimeQuery, useRpc, useEdgeFunction, usePresence, useBroadcast, useStorage) over a single shared client from window.SupabaseMock.createClient, seeded via window.SupabaseConfig (SEED, RPC, FUNCTIONS). The module's own header states it is \"Drop-in shaped like community supabase-react helpers — swap the underlying createClient import for the real SDK and every hook keeps working\", i.e. a mock backend behind a real-shaped API, not a fabricated dependency." .

pack:ShadcnUsage a pack:TechnologyFinding ;
    rdfs:label "shadcn/ui, radix-ui, cva" ;
    pack:status "absent" ;
    rdfs:comment "No shadcn/ui, @radix-ui/*, or class-variance-authority (cva) usage found anywhere in the 15 files of the source drop; grep for these signatures returned zero matches." .

pack:FilePhageWars a pack:SourceArtifact ;
    rdfs:label "PhageWars.jsx" ;
    pack:filePath "PhageWars.jsx" ;
    pack:lineCount 1081 ;
    rdfs:comment "Standalone UMD React module: framework-agnostic PhageEngine (three.js + deck.gl + sim), PhageProvider/usePhage context, Stage (mounts three.js/deck.gl/minimap canvases), and screen components (TitleScreen, ChampionSelect, Hud, GameOver) composed into PhageWarsGame." .

pack:FilePhageOnlineBundle a pack:SourceArtifact ;
    rdfs:label "PhageOnlineBundle.jsx" ;
    pack:filePath "PhageOnlineBundle.jsx" ;
    pack:lineCount 2531 ;
    rdfs:comment "Largest file in the drop; bundles the online/multiplayer variant of the game with deck.gl and supabase references, combining engine, UI, and networking concerns in one module." .

pack:FileSupabaseReact a pack:SourceArtifact ;
    rdfs:label "supabase-react.jsx" ;
    pack:filePath "supabase-react.jsx" ;
    pack:lineCount 177 ;
    rdfs:comment "React abstraction layer over the mock Supabase client: SupabaseProvider plus useAuth/useProfile/useQuery/useRealtimeQuery/useRpc/useEdgeFunction/usePresence/useBroadcast/useStorage hooks." .

pack:FileSupabaseMock a pack:SourceArtifact ;
    rdfs:label "supabase-mock.js" ;
    pack:filePath "supabase-mock.js" ;
    pack:lineCount 357 ;
    rdfs:comment "Mock createClient implementation backing supabase-react.jsx's hooks — in-memory store plus a realtime bus." .

pack:FileSupabaseConfig a pack:SourceArtifact ;
    rdfs:label "supabase-config.js" ;
    pack:filePath "supabase-config.js" ;
    pack:lineCount 169 ;
    rdfs:comment "Seed data, RPC, and edge function config consumed by supabase-mock.js's createClient." .

pack:FilePhageBackend a pack:SourceArtifact ;
    rdfs:label "phage-backend.js" ;
    pack:filePath "phage-backend.js" ;
    pack:lineCount 725 ;
    rdfs:comment "React-using backend/simulation module supporting the online game variant." .

pack:FilePhageLadderScreen a pack:SourceArtifact ;
    rdfs:label "phage-ladder-screen.js" ;
    pack:filePath "phage-ladder-screen.js" ;
    pack:lineCount 214 ;
    rdfs:comment "React-using ladder/matchmaking screen component." .

@prefix gc: <https://ggen.io/ontology/ggen-create#> .

gc:gc_subject_phage_wars_3_react_pack a gc:GenerationSubject ;
    gc:name "PhageWars" ;
    gc:upper "PHAGEWARS" ;
    gc:lower "phagewars" ;
    gc:capitalized "PhageWars" ;
    gc:pascal "PhageWars" ;
    gc:camel "phageWars" ;
    gc:snake "phage_wars" ;
    gc:upper_snake "PHAGE_WARS" ;
    gc:kebab "phage-wars" ;
    gc:title "Phage Wars" .
