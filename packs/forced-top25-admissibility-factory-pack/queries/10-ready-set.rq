PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
SELECT ?rank ?repo ?head ?shape ?producer_head ?compatibility_state WHERE {
  ?target a fta:FanoutTarget ;
          fta:rank ?rank ;
          fta:repo ?repo ;
          fta:exactHead ?head ;
          fta:consumerShape ?shape ;
          fta:producerHead ?producer_head ;
          fta:compatibilityState ?compatibility_state .
  FILTER(?compatibility_state = "COMPATIBLE_READY")
  FILTER NOT EXISTS { ?target fta:blocker ?blocker }
}
ORDER BY ?rank ?repo
