PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
SELECT ?rank ?repo ?head ?shape WHERE {
  ?target a fta:FanoutTarget ; fta:rank ?rank ; fta:repo ?repo ; fta:exactHead ?head ; fta:consumerShape ?shape ; fta:compatibilityState "COMPATIBLE_READY" .
  FILTER NOT EXISTS { ?target fta:blocker ?blocker }
}
ORDER BY ?rank ?repo
