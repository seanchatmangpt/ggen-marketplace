---
to: "templates/backend-service/v1/skeleton/tests/health.test.ts"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}import { describe, it, expect } from "vitest";

describe("${{ values.serviceName }}", () => {
  it("should have a valid service name", () => {
    const name = "${{ values.serviceName }}";
    expect(name).toBeTruthy();
    expect(name).toMatch(/^[a-z][a-z0-9-]*$/);
  });

  it("should have a valid port", () => {
    const port = parseInt("${{ values.port }}", 10);
    expect(port).toBeGreaterThan(0);
    expect(port).toBeLessThan(65536);
  });
});
{% endraw %}