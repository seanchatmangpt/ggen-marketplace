---
to: "order-service/catalog-info.yaml"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: order-service
  description: order-service service
  annotations:
    github.com/project-slug: platform-org/order-service
    backstage.io/techdocs-ref: dir:.
  tags:
    - nodejs
    - backend
spec:
  type: service
  lifecycle: experimental
  owner: team-alpha
  system: platform
  providesApis: []
{% endraw %}