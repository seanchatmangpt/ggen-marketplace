@prefix gp: <https://ggen.dev/ontology/project-boundary#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

gp:OpportunityPortfolio a rdfs:Class ; rdfs:subClassOf prov:Entity .
gp:PortfolioMember a rdfs:Class .
gp:containsOpportunity a rdf:Property .
gp:compatibleWith a rdf:Property .
gp:expectedReuse a rdf:Property .
gp:expectedDependencyRelief a rdf:Property .
gp:expectedCompositionValue a rdf:Property .
gp:expectedInformationGain a rdf:Property .
gp:expectedFutureCapacity a rdf:Property .
gp:reversibilityScore a rdf:Property .
gp:authorityCost a rdf:Property .
gp:rollbackCost a rdf:Property .
gp:portfolioStanding a rdf:Property .
gp:selectionAuthority a rdf:Property .
gp:actuationPerformed a rdf:Property .
