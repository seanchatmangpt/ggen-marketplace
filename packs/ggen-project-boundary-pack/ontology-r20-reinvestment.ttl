@prefix gpb: <https://ggen.dev/ontology/project-boundary#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

gpb:ReinvestmentCandidate a rdfs:Class .
gpb:ReinvestmentPortfolio a rdfs:Class .
gpb:ReinvestmentDecision a rdfs:Class .
gpb:expectedQualifiedActions a rdf:Property .
gpb:expectedCapitalRecovery a rdf:Property .
gpb:depreciationRelief a rdf:Property .
gpb:productivityUplift a rdf:Property .
gpb:reuseValue a rdf:Property .
gpb:dependencyUnlock a rdf:Property .
gpb:compositionValue a rdf:Property .
gpb:informationGain a rdf:Property .
gpb:futureManufacturingCapacity a rdf:Property .
gpb:rollbackCost a rdf:Property .
gpb:authorityCost a rdf:Property .
gpb:reinvestmentBudget a rdf:Property .
gpb:selectedForPortfolio a rdf:Property .
gpb:standing a rdf:Property .
gpb:ReinvestmentYieldMetric a dqv:Metric ; rdfs:label "Qualified manufacturing actions unlocked per reinvestment unit" .
gpb:R20ReferenceReinvestment a gpb:ReinvestmentCandidate, prov:Entity ;
  gpb:investmentUnits 10.0 ; gpb:expectedQualifiedActions 80 ; gpb:expectedCapitalRecovery 24.0 ;
  gpb:depreciationRelief 12.0 ; gpb:productivityUplift 8.0 ; gpb:reuseValue 10.0 ;
  gpb:dependencyUnlock 6.0 ; gpb:compositionValue 5.0 ; gpb:informationGain 4.0 ;
  gpb:futureManufacturingCapacity 40.0 ; gpb:rollbackCost 1.0 ; gpb:authorityCost 0.0 ;
  gpb:authority "SELECT" ; gpb:actuationPerformed false ; gpb:current true ; gpb:standing "PARTIAL_ALIVE" .