@prefix gpb: <https://ggen.dev/ontology/project-boundary#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

gpb:CapitalCompoundingPeriod a rdfs:Class .
gpb:openingStock a rdf:Property .
gpb:closingStock a rdf:Property .
gpb:netCapitalGrowth a rdf:Property .
gpb:reinvestment a rdf:Property .
gpb:realizedOutput a rdf:Property .
gpb:drawdown a rdf:Property .
gpb:depreciationCovered a rdf:Property .
gpb:productivityIndex a rdf:Property .
gpb:capacityIndex a rdf:Property .
gpb:compositionPersistence a rdf:Property .
gpb:informationIndex a rdf:Property .
gpb:compoundingGeneration a rdf:Property .
gpb:CompoundingYieldMetric a dqv:Metric ; rdfs:label "Manufacturing capital compounding rate" .
gpb:R20CompoundingReference a gpb:CapitalCompoundingPeriod ;
  gpb:openingStock 1400.0 ; gpb:closingStock 1540.0 ; gpb:netCapitalGrowth 140.0 ;
  gpb:reinvestment 40.0 ; gpb:realizedOutput 3200.0 ; gpb:drawdown 20.0 ;
  gpb:depreciationCovered 40.0 ; gpb:productivityIndex 2.08 ; gpb:capacityIndex 1.10 ;
  gpb:compositionPersistence 0.95 ; gpb:informationIndex 1.15 ; gpb:compoundingGeneration 1 ;
  gpb:current true ; gpb:authority "SELECT" ; gpb:actuationPerformed false .