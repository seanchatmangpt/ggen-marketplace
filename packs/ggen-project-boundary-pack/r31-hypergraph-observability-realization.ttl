r31:actionableOpportunityCount a dqv:Metric .
r31:novelOpportunityCount a dqv:Metric .
r31:falsePositiveCount a dqv:Metric .
r31:falseNegativeCount a dqv:Metric .
r31:dependencyReliefCount a dqv:Metric .
r31:costMillis a dqv:Metric .
r31:latencyMillis a dqv:Metric .
r31:portfolioCoverage a dqv:Metric .
r31:marginalDiscovery a dqv:Metric .
r31:overlapRate a dqv:Metric .
r31:synergyGain a dqv:Metric .
