PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?generation (COUNT(DISTINCT ?digest) AS ?digests)
WHERE { ?decision a gpb:AdaptiveCapitalDecision ; gpb:policyGeneration ?generation ; gpb:policyDigest ?digest ; gpb:current true . }
GROUP BY ?generation
HAVING(COUNT(DISTINCT ?digest) > 1)