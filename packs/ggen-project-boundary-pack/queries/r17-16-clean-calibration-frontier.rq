PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?sensor ?precision ?recall ?f1 ?n WHERE { ?c a gp:SensorCalibration ; gp:sensorDigest ?sensor ; gp:precision ?precision ; gp:recall ?recall ; gp:f1 ?f1 ; gp:sampleSize ?n ; gp:currentGeneration true ; gp:calibrationState "CALIBRATED" ; gp:authority "OBSERVE|VERIFY|CONSTRUCT" ; gp:actuationPerformed false . } ORDER BY DESC(?f1)
