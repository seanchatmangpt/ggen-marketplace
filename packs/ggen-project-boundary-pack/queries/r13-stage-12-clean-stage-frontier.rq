PREFIX isc: <https://ggen.dev/ontology/isolated-staging-control#>
SELECT ?plan ?target WHERE { ?plan a isc:StagePlan ; isc:targetRepository ?target ; isc:contained true ; isc:isolated true ; isc:deterministic true ; isc:replayable true ; isc:collisionFree true ; isc:current true ; isc:standing "PARTIAL_ALIVE" ; isc:actuationPerformed false . } ORDER BY ?target ?plan
