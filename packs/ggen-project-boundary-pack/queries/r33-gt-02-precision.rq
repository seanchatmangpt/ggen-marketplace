PREFIX gt: <https://ggen.dev/ontology/ground-truth-r33#>
SELECT ((?tp / (?tp + ?fp)) AS ?precision) WHERE {
  { SELECT (SUM(IF(?pred = true && ?actual = true,1,0)) AS ?tp)
           (SUM(IF(?pred = true && ?actual = false,1,0)) AS ?fp)
    WHERE { ?obs a gt:CalibrationObservation ; gt:predictedPositive ?pred ; gt:actualPositive ?actual . } }
  FILTER((?tp + ?fp) > 0)
}
