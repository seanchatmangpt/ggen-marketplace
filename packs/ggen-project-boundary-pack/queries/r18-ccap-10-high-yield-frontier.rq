PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?d (?future/?investment AS ?yield) WHERE { ?d a gpb:CompositionCapitalDecision ; gpb:futureQualifiedActions ?future ; gpb:investmentUnits ?investment ; gpb:compatible true ; gpb:current true . FILTER(?investment > 0 && (?future/?investment) > 1) } ORDER BY DESC(?yield) ?d
