PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?t ?file ?source ?target WHERE { ?t a gpb:GenerationTarget ; gpb:outputFile ?file ; gpb:sourceRepository ?source ; gpb:targetRepository ?target ; gpb:contained true ; gpb:pathTraversal false ; gpb:absolutePath false ; gpb:current true ; gpb:sourceDigest ?s ; gpb:queryDigest ?q ; gpb:templateDigest ?tpl ; gpb:outputDigest ?o . FILTER(?source = ?target || EXISTS { ?t gpb:isolatedStage true }) }
ORDER BY ?t ?file ?source ?target
