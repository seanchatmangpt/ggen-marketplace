PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?sensor ((?observed * (1-?recall))/?recall AS ?estimatedMissed) WHERE { ?c a gp:SensorCalibration ; gp:sensorDigest ?sensor ; gp:recall ?recall . { SELECT ?sensor (COUNT(?x) AS ?observed) WHERE { ?x a gp:SensorObservation ; gp:sensorDigest ?sensor ; gp:observedPositive true ; gp:groundTruthPositive true . } GROUP BY ?sensor } FILTER(?recall > 0) }
