PREFIX loop: <https://ggen.dev/ontology/calibrated-capital-allocation-r33#>
SELECT ?decision ?yield ?risk ?relief WHERE {
  ?decision a loop:CalibratedAllocationDecision ; loop:calibratedYield ?yield ; loop:falseCapitalRisk ?risk ; loop:reliefAdjustedValue ?relief .
  FILTER(?yield <= 0 || ?relief < 0 || ?risk >= 0.5)
}
ORDER BY ?decision
