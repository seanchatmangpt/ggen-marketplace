PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
PREFIX dmc: <https://ggen.dev/ontology/dfcm-maximalist-court#>
SELECT ?candidate WHERE { ?candidate a dmc:RemediationCandidate . FILTER NOT EXISTS { ?c a gp:RemediationCapitalCorrespondence ; gp:remediationCandidate ?candidate . } } ORDER BY ?candidate
