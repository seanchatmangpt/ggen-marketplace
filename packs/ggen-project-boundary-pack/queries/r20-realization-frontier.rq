PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?obs ?class ?yield ?gap
WHERE {
  ?obs a gpb:CapitalRealizationObservation ; gpb:bookedCapitalClass ?class ; gpb:bookedInvestmentUnits ?investment ; gpb:expectedQualifiedActions ?expected ; gpb:realizedQualifiedActions ?realized ; gpb:realizedCurrent true ; gpb:authority "VERIFY" ; gpb:actuationPerformed false .
  BIND(?realized / ?investment AS ?yield)
  BIND(?expected - ?realized AS ?gap)
  FILTER(?investment > 0 && ?realized > 0)
}
ORDER BY DESC(?yield) ?gap ?obs