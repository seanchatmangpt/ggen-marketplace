PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?repo ?sha (COUNT(DISTINCT ?conclusion) AS ?conclusions) WHERE { ?r a gp:RailObservation ; gp:exactRepo ?repo ; gp:exactSha ?sha ; gp:railConclusion ?conclusion . } GROUP BY ?repo ?sha HAVING (COUNT(DISTINCT ?conclusion) > 1) ORDER BY ?repo
