PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?x WHERE { ?x a gp:Opportunity . { ?x gp:standing gp:UNKNOWN } UNION { ?x gp:exercised false } UNION { FILTER NOT EXISTS { ?x gp:hasFalsifier true } } UNION { ?x gp:shouldBeGenerated true ; gp:isGenerated false } UNION { ?x gp:dependencyRelieved false } } ORDER BY ?x
