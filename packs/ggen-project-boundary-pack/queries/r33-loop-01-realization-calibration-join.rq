PREFIX loop: <https://ggen.dev/ontology/calibrated-capital-allocation-r33#>
PREFIX live: <https://ggen.dev/ontology/live-candidate-realization-r33#>
PREFIX gt: <https://ggen.dev/ontology/ground-truth-r33#>
SELECT ?decision ?realization ?calibration WHERE {
  ?decision a loop:CalibratedAllocationDecision ; loop:realization ?realization ; loop:calibration ?calibration .
  ?realization a live:CandidateRealization .
  ?calibration a gt:CalibrationObservation .
}
ORDER BY ?decision
