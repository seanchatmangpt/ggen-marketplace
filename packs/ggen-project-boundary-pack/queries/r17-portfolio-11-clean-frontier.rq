PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?member ?reuse ?relief ?composition ?capacity WHERE {
  ?member a gp:PortfolioMember ; gp:expectedReuse ?reuse ; gp:expectedDependencyRelief ?relief ; gp:expectedCompositionValue ?composition ; gp:expectedFutureCapacity ?capacity ; gp:authorityCost ?authority ; gp:rollbackCost ?rollback .
  FILTER((?reuse + ?relief + ?composition + ?capacity) > 0 && ?authority <= 1 && ?rollback <= 1)
} ORDER BY DESC(?capacity) DESC(?reuse) ?member
