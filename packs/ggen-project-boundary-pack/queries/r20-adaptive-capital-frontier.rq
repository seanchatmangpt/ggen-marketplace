PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?decision ?realized ?regret ?depreciation ?productivity
WHERE { ?decision a gpb:AdaptiveCapitalDecision ; gpb:realizedYield ?realized ; gpb:capitalRegret ?regret ; gpb:depreciationRate ?depreciation ; gpb:productivityDelta ?productivity ; gpb:current true ; gpb:authority "SELECT" ; gpb:actuationPerformed false . FILTER(?realized > 0 && ?regret >= 0 && ?depreciation >= 0) }
ORDER BY DESC(?realized) ?regret ?depreciation DESC(?productivity) ?decision