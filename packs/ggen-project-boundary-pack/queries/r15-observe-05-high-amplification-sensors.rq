PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?sensor (COUNT(DISTINCT ?opp) AS ?opportunities) (COUNT(DISTINCT ?seed) AS ?seeds) WHERE { ?opp a gp:Opportunity ; gp:detectedBy ?sensor ; gp:seedObservation ?seed . } GROUP BY ?sensor HAVING (COUNT(DISTINCT ?opp) >= (2 * COUNT(DISTINCT ?seed))) ORDER BY DESC(?opportunities)
