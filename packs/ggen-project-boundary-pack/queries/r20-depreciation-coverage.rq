PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?period ?covered ?reinvestment (?covered / ?reinvestment AS ?coverageRatio)
WHERE { ?period a gpb:CapitalCompoundingPeriod ; gpb:depreciationCovered ?covered ; gpb:reinvestment ?reinvestment . FILTER(?reinvestment > 0) }
ORDER BY DESC(?coverageRatio) ?period