PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?root (COUNT(DISTINCT ?opp) AS ?opportunities) (COUNT(DISTINCT ?path) AS ?paths) WHERE { ?opp a gp:Opportunity ; gp:failureRoot ?root . OPTIONAL { ?opp gp:affectedPath ?path . } } GROUP BY ?root ORDER BY DESC(?opportunities) DESC(?paths)
