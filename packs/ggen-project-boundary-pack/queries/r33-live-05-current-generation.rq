PREFIX r33: <https://ggen.dev/ontology/live-candidate-realization-r33#>
SELECT ?realization ?generation WHERE {
  ?realization a r33:CandidateRealization ; r33:currentGeneration ?generation .
  FILTER NOT EXISTS {
    ?other a r33:CandidateRealization ; r33:currentGeneration ?newer .
    FILTER(?newer > ?generation)
  }
}
ORDER BY ?realization
