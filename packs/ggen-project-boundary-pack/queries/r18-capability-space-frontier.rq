PREFIX gp: <https://ggen.dev/ontology/project-boundary#>

SELECT DISTINCT ?candidate ?delta ?reuse
WHERE {
  ?candidate a gp:CompositionCandidate ;
    gp:expectedCapabilitySpaceDelta ?delta ;
    gp:expectedReuseDelta ?reuse ;
    gp:reversible true .
  FILTER NOT EXISTS { ?candidate gp:dominatedBy ?other . }
}
ORDER BY DESC(?delta) DESC(?reuse) ?candidate
