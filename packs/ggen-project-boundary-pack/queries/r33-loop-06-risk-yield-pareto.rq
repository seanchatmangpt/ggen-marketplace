PREFIX loop: <https://ggen.dev/ontology/calibrated-capital-allocation-r33#>
SELECT ?decision WHERE {
  ?decision a loop:CalibratedAllocationDecision ; loop:calibratedYield ?yield ; loop:falseCapitalRisk ?risk ; loop:reliefAdjustedValue ?relief .
  FILTER NOT EXISTS {
    ?other a loop:CalibratedAllocationDecision ; loop:calibratedYield ?oy ; loop:falseCapitalRisk ?orisk ; loop:reliefAdjustedValue ?orel .
    FILTER(?other != ?decision && ?oy >= ?yield && ?orisk <= ?risk && ?orel >= ?relief && (?oy > ?yield || ?orisk < ?risk || ?orel > ?relief))
  }
}
ORDER BY ?decision
