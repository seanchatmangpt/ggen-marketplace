PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?entry ?investment ?actions ?families ((xsd:decimal(?actions) / xsd:decimal(?investment)) AS ?yield)
WHERE {
  ?entry a gpb:CapitalEntry ;
    gpb:capitalClass gpb:CompositionalCAPEX ;
    gpb:investmentUnits ?investment ;
    gpb:futureQualifiedActions ?actions ;
    gpb:composedAssetFamilies ?families .
  FILTER(xsd:decimal(?investment) > 0 && xsd:integer(?families) >= 2)
}
ORDER BY DESC(?yield) ?entry
