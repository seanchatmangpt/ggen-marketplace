PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX r29m: <https://chatman.ai/ledger/r29/mutation/>
SELECT ?incident ?status WHERE { ?incident a prov:Activity ; prov:used ?intent, ?target ; dcterms:status ?status . FILTER(STRSTARTS(STR(?status), "REFUSED[TARGET_CORRESPONDENCE_FAILURE]")) } ORDER BY ?incident
