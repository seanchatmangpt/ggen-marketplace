PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX r29m: <https://chatman.ai/ledger/r29/mutation/>
SELECT ?target ?pr ?ref ?sha ?base WHERE { ?target a r29m:ObservedTarget ; dcterms:status "MATCH" ; r29m:repository "seanchatmangpt/ggen-marketplace" ; r29m:prNumber ?pr ; r29m:headRef ?ref ; r29m:headSha ?sha ; r29m:baseSha ?base . } ORDER BY ?pr ?sha
