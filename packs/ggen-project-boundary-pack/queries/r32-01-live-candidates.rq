PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX cap: <https://ggen.dev/ontology/option-capital#>
SELECT ?candidate ?id ?evidence WHERE {
  ?candidate a prov:Entity ; dcterms:type cap:Candidate ; dcterms:identifier ?id ; cap:evidence ?evidence .
} ORDER BY ?id
