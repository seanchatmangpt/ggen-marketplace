PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?entry ?class ?amount
WHERE {
  ?entry a gpb:DepreciationEntry ;
    gpb:depreciationClass ?class ;
    gpb:depreciationAmount ?amount .
  FILTER(xsd:decimal(?amount) >= 0)
}
ORDER BY ?class ?entry
