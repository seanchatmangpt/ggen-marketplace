PREFIX gt: <https://ggen.dev/ontology/ground-truth-r33#>
SELECT (COUNT(DISTINCT ?root) AS ?roots) (COUNT(DISTINCT ?impl) AS ?implementations) (COUNT(DISTINCT ?model) AS ?models) WHERE {
  ?obs a gt:CalibrationObservation ; gt:sourceRoot ?root ; gt:sourceImplementation ?impl ; gt:sourceModel ?model .
}
