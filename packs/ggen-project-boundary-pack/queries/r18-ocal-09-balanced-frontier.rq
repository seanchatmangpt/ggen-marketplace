PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?c ?precision ?recall ?width WHERE { ?c a gpb:ObservabilityCalibration ; gpb:precision ?precision ; gpb:recall ?recall ; gpb:intervalWidth ?width ; gpb:current true . FILTER(?precision >= 0.8 && ?recall >= 0.8 && ?width <= 0.2) } ORDER BY DESC(?precision) DESC(?recall) ?width ?c
