PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?opportunity (COUNT(?capability) AS ?realizations) WHERE {
  ?realization a prov:Activity ; dcterms:type "opportunity-realization" ; prov:used ?opportunity ; prov:generated ?capability .
}
GROUP BY ?opportunity
ORDER BY DESC(?realizations) ?opportunity
