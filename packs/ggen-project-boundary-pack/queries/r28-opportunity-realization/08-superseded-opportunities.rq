PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?older ?newer WHERE {
  ?older a prov:Entity ; dcterms:type "actionable-opportunity" ; dcterms:isReplacedBy ?newer .
  ?newer a prov:Entity ; dcterms:type "actionable-opportunity" .
}
ORDER BY ?older ?newer
