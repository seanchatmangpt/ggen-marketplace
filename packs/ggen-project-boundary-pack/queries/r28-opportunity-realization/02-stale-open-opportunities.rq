PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?opportunity ?capability WHERE {
  ?opportunity a prov:Entity ; dcterms:type "actionable-opportunity" ; dcterms:status "OPEN" .
  ?realization a prov:Activity ; dcterms:type "opportunity-realization" ; prov:used ?opportunity ; prov:generated ?capability .
}
ORDER BY ?opportunity ?capability
