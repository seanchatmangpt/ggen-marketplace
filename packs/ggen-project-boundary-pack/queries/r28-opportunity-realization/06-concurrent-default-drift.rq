PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?constructionBase ?mergeBase ?defaultHead WHERE {
  ?event a prov:Activity ; dcterms:type "concurrent-default-drift" ;
    prov:used ?constructionBase ; prov:generated ?defaultHead ; dcterms:relation ?mergeBase .
  FILTER(?constructionBase != ?defaultHead)
}
ORDER BY ?defaultHead
