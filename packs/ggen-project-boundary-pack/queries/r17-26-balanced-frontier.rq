PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?sensor ?precision ?recall ?f1 ?n WHERE { ?c a gp:SensorCalibration ; gp:sensorDigest ?sensor ; gp:precision ?precision ; gp:recall ?recall ; gp:f1 ?f1 ; gp:sampleSize ?n ; gp:currentGeneration true . FILTER(?precision >= 0.8 && ?recall >= 0.8 && ?n >= 20) } ORDER BY DESC(?f1) DESC(?n)
