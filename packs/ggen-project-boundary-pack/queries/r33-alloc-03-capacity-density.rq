PREFIX alloc: <https://ggen.dev/ontology/relief-allocation-r33#>
SELECT ?candidate ?capacity ?investment ((?capacity / ?investment) AS ?density) WHERE {
  ?candidate a alloc:AllocationCandidate ; alloc:futureCapacity ?capacity ; alloc:investmentUnits ?investment .
  FILTER(?investment > 0)
}
ORDER BY DESC(?density) ?candidate
