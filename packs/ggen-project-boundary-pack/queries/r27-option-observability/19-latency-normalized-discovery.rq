PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?option ((COUNT(DISTINCT ?opportunity) * 1.0) / ?latency AS ?yieldPerLatency) WHERE {
  ?option a prov:Entity ; dcterms:type "reversible-option" ; dcterms:extent ?latency .
  ?opportunity dcterms:type "actionable-opportunity" ; prov:wasDerivedFrom ?option .
  FILTER(?latency > 0)
}
GROUP BY ?option ?latency
ORDER BY DESC(?yieldPerLatency) ?option
