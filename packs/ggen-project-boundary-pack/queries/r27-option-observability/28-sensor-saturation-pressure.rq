PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?sensor (COUNT(?run) AS ?runs) WHERE {
  ?run a prov:Activity ; dcterms:type "observability-run" ; prov:wasAssociatedWith ?sensor .
  FILTER NOT EXISTS { ?opportunity dcterms:type "actionable-opportunity" ; prov:wasGeneratedBy ?run ; dcterms:status "NOVEL" }
}
GROUP BY ?sensor
HAVING(COUNT(?run) >= 3)
ORDER BY DESC(?runs) ?sensor
