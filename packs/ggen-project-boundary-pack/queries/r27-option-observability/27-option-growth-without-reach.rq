PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?run (COUNT(DISTINCT ?option) AS ?options) (COUNT(DISTINCT ?repo) AS ?repos) WHERE {
  ?option a prov:Entity ; dcterms:type "reversible-option" ; prov:wasGeneratedBy ?run .
  OPTIONAL { ?opportunity dcterms:type "actionable-opportunity" ; prov:wasDerivedFrom ?option ; dcterms:isPartOf ?repo }
}
GROUP BY ?run
HAVING(COUNT(DISTINCT ?option) > 1 && COUNT(DISTINCT ?repo) <= 1)
ORDER BY DESC(?options) ?run
