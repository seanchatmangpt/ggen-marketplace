PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ((COUNT(DISTINCT ?missed) * 1.0) / COUNT(DISTINCT ?truth) AS ?blindSpotRate) WHERE {
  ?truth a prov:Entity ; dcterms:type "grounded-actionable-opportunity" .
  OPTIONAL {
    ?missed a prov:Entity ; dcterms:type "grounded-actionable-opportunity" .
    FILTER NOT EXISTS { ?detected dcterms:type "actionable-opportunity" ; prov:wasDerivedFrom ?missed }
  }
}
