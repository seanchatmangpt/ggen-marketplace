PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?run WHERE {
  ?run a prov:Activity ; dcterms:type "observability-run" ; dcterms:status "AMPLIFIED" .
  FILTER NOT EXISTS { ?opportunity dcterms:type "actionable-opportunity" ; prov:wasGeneratedBy ?run }
}
ORDER BY ?run
