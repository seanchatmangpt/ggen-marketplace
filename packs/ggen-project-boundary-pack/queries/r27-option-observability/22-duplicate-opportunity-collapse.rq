PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?signature (COUNT(?opportunity) AS ?duplicates) WHERE {
  ?opportunity a prov:Entity ; dcterms:type "actionable-opportunity" ; dcterms:identifier ?signature .
}
GROUP BY ?signature
HAVING(COUNT(?opportunity) > 1)
ORDER BY DESC(?duplicates) ?signature
