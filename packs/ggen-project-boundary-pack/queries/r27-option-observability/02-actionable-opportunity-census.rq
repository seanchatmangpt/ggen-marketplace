PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?subject (COUNT(?opportunity) AS ?actionable) WHERE {
  ?opportunity a prov:Entity ; dcterms:type "actionable-opportunity" ; prov:specializationOf ?subject .
}
GROUP BY ?subject
ORDER BY DESC(?actionable) ?subject
