PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?opportunity (COUNT(DISTINCT ?dependent) AS ?unlockFanout) WHERE {
  ?relief a prov:Activity ; dcterms:type "dependency-relief" ; prov:used ?opportunity ; prov:generated ?dependent .
}
GROUP BY ?opportunity
ORDER BY DESC(?unlockFanout) ?opportunity
