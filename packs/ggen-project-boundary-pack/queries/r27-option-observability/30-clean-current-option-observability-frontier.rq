PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?subject ?option ?opportunity WHERE {
  ?option a prov:Entity ; dcterms:type "reversible-option" ; dcterms:status "CURRENT" ; prov:specializationOf ?subject .
  ?opportunity a prov:Entity ; dcterms:type "actionable-opportunity" ; dcterms:status "NOVEL" ; prov:wasDerivedFrom ?option ; prov:specializationOf ?subject .
  FILTER EXISTS { ?receipt dcterms:type "measurement-receipt" ; prov:specializationOf ?subject }
  FILTER NOT EXISTS { ?bad dcterms:type "grounded-actionable-opportunity" . FILTER NOT EXISTS { ?detected dcterms:type "actionable-opportunity" ; prov:wasDerivedFrom ?bad } }
}
ORDER BY ?subject ?option ?opportunity
