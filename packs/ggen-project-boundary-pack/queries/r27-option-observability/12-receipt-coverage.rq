PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ((COUNT(DISTINCT ?receipted) * 1.0) / COUNT(DISTINCT ?obs) AS ?receiptCoverage) WHERE {
  ?obs a prov:Entity ; dcterms:type "seed-observation" .
  OPTIONAL { ?receipted a prov:Entity ; dcterms:type "seed-observation" ; prov:wasGeneratedBy ?receipt . ?receipt dcterms:type "measurement-receipt" }
}
