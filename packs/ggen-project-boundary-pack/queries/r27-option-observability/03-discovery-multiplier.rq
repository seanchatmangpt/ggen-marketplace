PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ((COUNT(DISTINCT ?opportunity) * 1.0) / COUNT(DISTINCT ?seed) AS ?E) WHERE {
  ?seed a prov:Entity ; dcterms:type "seed-observation" .
  ?opportunity a prov:Entity ; dcterms:type "actionable-opportunity" ; prov:wasDerivedFrom ?seed .
}
