PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?obs ?pack (?budget-?latency AS ?headroom) WHERE { ?obs a gpb:PackQualificationObservation ; gpb:packName ?pack ; gpb:observedLatencySeconds ?latency . ?b a gpb:QualificationBudget ; gpb:qualificationTimeoutSeconds ?budget . FILTER(?latency <= ?budget) } ORDER BY ?headroom ?pack
