PREFIX r31: <https://w3id.org/chatman/measure/r31#>
SELECT ?run (?a/?s AS ?e) (?r/?a AS ?relief) WHERE { ?run a r31:HypergraphRealizationRun ; r31:actionableOpportunityCount ?a ; r31:seedObservationCount ?s ; r31:dependencyReliefCount ?r . FILTER(?s>0 && ?a>0 && (?a/?s)>2 && (?r/?a)<0.25) } ORDER BY DESC(?e)
