PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?entry ((xsd:decimal(?actions) / xsd:decimal(?investment)) AS ?yield) WHERE { ?entry a gp:CapitalLedgerEntry ; gp:qualifiedActionCount ?actions ; gp:investmentUnits ?investment . FILTER(xsd:decimal(?investment) > 0) } ORDER BY DESC(?yield) ?entry
