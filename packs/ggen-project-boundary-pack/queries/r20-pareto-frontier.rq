PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?candidate WHERE {
  ?candidate a gpb:ReinvestmentCandidate ; gpb:expectedQualifiedActions ?a ; gpb:futureManufacturingCapacity ?f ; gpb:rollbackCost ?r ; gpb:authorityCost ?u .
  FILTER NOT EXISTS {
    ?other a gpb:ReinvestmentCandidate ; gpb:expectedQualifiedActions ?oa ; gpb:futureManufacturingCapacity ?of ; gpb:rollbackCost ?or ; gpb:authorityCost ?ou .
    FILTER(?other != ?candidate && ?oa >= ?a && ?of >= ?f && ?or <= ?r && ?ou <= ?u && (?oa > ?a || ?of > ?f || ?or < ?r || ?ou < ?u))
  }
}
ORDER BY ?candidate