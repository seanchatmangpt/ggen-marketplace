PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?period ?opening ?closing (?closing - ?opening AS ?computedGrowth) ?declaredGrowth
WHERE { ?period a gpb:CapitalCompoundingPeriod ; gpb:openingStock ?opening ; gpb:closingStock ?closing ; gpb:netCapitalGrowth ?declaredGrowth . }
ORDER BY ?period