PREFIX loop: <https://ggen.dev/ontology/calibrated-capital-allocation-r33#>
SELECT ?decision ?yield ?risk ?relief WHERE {
  ?decision a loop:CalibratedAllocationDecision ; loop:realization ?r ; loop:calibration ?c ; loop:allocationCandidate ?a ; loop:calibratedYield ?yield ; loop:falseCapitalRisk ?risk ; loop:reliefAdjustedValue ?relief ; loop:decisionGeneration ?generation .
  FILTER(?yield > 0 && ?risk < 0.5 && ?relief >= 0)
}
ORDER BY DESC(?yield) ASC(?risk) DESC(?relief) ?decision
