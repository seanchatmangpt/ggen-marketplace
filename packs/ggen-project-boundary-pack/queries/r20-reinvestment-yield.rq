PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?candidate ?investment ?actions (?actions / ?investment AS ?yield)
WHERE {
  ?candidate a gpb:ReinvestmentCandidate ; gpb:investmentUnits ?investment ; gpb:expectedQualifiedActions ?actions .
  FILTER(?investment > 0)
}
ORDER BY DESC(?yield) ?candidate