PREFIX gp: <https://ggen.dev/ontology/project-boundary#>

SELECT DISTINCT ?left ?right ?primitive
WHERE {
  ?portfolio a gp:OpportunityPortfolio ; gp:containsOpportunity ?left, ?right .
  FILTER (?left != ?right)
  ?left gp:missingPrimitive ?primitive .
  ?right gp:sharedCapability ?primitive .
  ?left gp:reversibilityScore ?lr .
  ?right gp:reversibilityScore ?rr .
  FILTER (?lr > 0 && ?rr > 0)
}
ORDER BY ?primitive ?left ?right
