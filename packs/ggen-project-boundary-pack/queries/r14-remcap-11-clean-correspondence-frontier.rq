PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?c WHERE { ?c a gp:RemediationCapitalCorrespondence ; gp:currentCorrespondence true ; gp:selectionYield ?yield ; gp:correspondenceDigest ?digest ; gp:correspondenceStanding ?standing . FILTER(xsd:decimal(?yield) > 1 && STRLEN(STR(?digest)) = 64 && STR(?standing) != "BUILD_BROKEN" && STR(?standing) != "BLOCKED") } ORDER BY ?c
