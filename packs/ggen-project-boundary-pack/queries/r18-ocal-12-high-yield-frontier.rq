PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?d (?future/?investment AS ?yield) WHERE { ?d a gpb:ObservabilityCapitalDecision ; gpb:futureQualifiedActions ?future ; gpb:investmentUnits ?investment ; gpb:current true ; gpb:authority "SELECT" ; gpb:actuationPerformed false . FILTER(?investment > 0 && (?future/?investment) > 1) } ORDER BY DESC(?yield) ?d
