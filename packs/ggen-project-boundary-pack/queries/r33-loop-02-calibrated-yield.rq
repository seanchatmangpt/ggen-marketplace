PREFIX loop: <https://ggen.dev/ontology/calibrated-capital-allocation-r33#>
SELECT ?decision ?yield ?risk ((?yield * (1 - ?risk)) AS ?calibratedYield) WHERE {
  ?decision a loop:CalibratedAllocationDecision ; loop:calibratedYield ?yield ; loop:falseCapitalRisk ?risk .
  FILTER(?risk >= 0 && ?risk <= 1)
}
ORDER BY DESC(?calibratedYield) ?decision
