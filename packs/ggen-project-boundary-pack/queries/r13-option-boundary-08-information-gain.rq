PREFIX obc: <https://ggen.dev/ontology/option-boundary-capital#>
SELECT ?op ?informationGain ?investment (?informationGain / ?investment AS ?gainPerInvestment)
WHERE {
  ?op a obc:Opportunity ; obc:informationGain ?informationGain ; obc:investment ?investment .
  FILTER(?investment > 0)
}
ORDER BY DESC(?gainPerInvestment) ?op
