PREFIX alloc: <https://ggen.dev/ontology/relief-allocation-r33#>
SELECT ?candidate ?relief ?investment ((?relief / ?investment) AS ?density) WHERE {
  ?candidate a alloc:AllocationCandidate ; alloc:expectedRelief ?relief ; alloc:investmentUnits ?investment .
  FILTER(?investment > 0)
}
ORDER BY DESC(?density) ?candidate
