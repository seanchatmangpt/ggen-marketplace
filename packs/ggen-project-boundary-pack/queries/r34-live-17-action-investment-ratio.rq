PREFIX r33: <https://ggen.dev/ontology/live-candidate-realization-r33#>
SELECT ?realization ?actions ?investment (?actions / ?investment AS ?ratio) WHERE { ?realization a r33:CandidateRealization ; r33:qualifiedActionCount ?actions ; r33:investmentUnits ?investment . FILTER(?investment > 0) } ORDER BY DESC(?ratio) ?realization