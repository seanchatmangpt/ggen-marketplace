PREFIX loop: <https://ggen.dev/ontology/calibrated-capital-allocation-r33#>
SELECT ?decision WHERE {
  { ?decision a loop:CalibratedAllocationDecision . FILTER(!EXISTS { ?decision loop:realization ?r }) }
  UNION
  { ?decision a loop:CalibratedAllocationDecision . FILTER(!EXISTS { ?decision loop:calibration ?c }) }
  UNION
  { ?decision a loop:CalibratedAllocationDecision . FILTER(!EXISTS { ?decision loop:allocationCandidate ?a }) }
}
ORDER BY ?decision
