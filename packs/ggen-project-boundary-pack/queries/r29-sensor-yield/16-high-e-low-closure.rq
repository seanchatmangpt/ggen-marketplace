PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX r29: <https://chatman.ai/ledger/r29/>
SELECT ?run ((?actionable / ?seeds) AS ?E) ((?realized / ?actionable) AS ?closure) WHERE { ?run a prov:Activity ; r29:seedCount ?seeds ; r29:actionableCount ?actionable ; r29:realizedCount ?realized . FILTER(?seeds > 0 && ?actionable > 0 && (?actionable / ?seeds) >= 1 && (?realized / ?actionable) < 0.5) } ORDER BY DESC(?E) ?run
