PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX r29: <https://chatman.ai/ledger/r29/>
SELECT ?run ?opportunities ?actionable WHERE { ?run a prov:Activity ; r29:opportunityCount ?opportunities ; r29:actionableCount ?actionable . FILTER(?opportunities >= 4 && ?actionable * 2 < ?opportunities) } ORDER BY DESC(?opportunities) ?run
