PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX r29: <https://chatman.ai/ledger/r29/>
SELECT ?run (((?actionable - ?fp) / ?actionable) AS ?precision) WHERE { ?run a prov:Activity ; r29:actionableCount ?actionable ; r29:falsePositiveCount ?fp . FILTER(?actionable > 0 && ?fp <= ?actionable) } ORDER BY DESC(?precision) ?run
