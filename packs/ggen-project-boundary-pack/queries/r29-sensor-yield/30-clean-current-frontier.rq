PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX r29: <https://chatman.ai/ledger/r29/>
SELECT ?run ?actionable ?novel ?realized ?relief WHERE { ?run a prov:Activity ; dcterms:status "CURRENT" ; r29:actionableCount ?actionable ; r29:novelCount ?novel ; r29:realizedCount ?realized ; r29:dependencyReliefCount ?relief ; r29:authority "OBSERVE|VERIFY" ; r29:actuationPerformed false ; r29:receiptDigest ?receipt . FILTER(?actionable > 0 && ?novel > 0) } ORDER BY DESC(?relief) DESC(?realized) DESC(?novel) ?run
