PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX r29: <https://chatman.ai/ledger/r29/>
SELECT ?run ((?actionable / (?actionable + ?fn)) AS ?recall) WHERE { ?run a prov:Activity ; r29:actionableCount ?actionable ; r29:falseNegativeCount ?fn . FILTER((?actionable + ?fn) > 0) } ORDER BY DESC(?recall) ?run
