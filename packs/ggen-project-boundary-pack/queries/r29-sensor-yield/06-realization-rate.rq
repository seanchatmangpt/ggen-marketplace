PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX r29: <https://chatman.ai/ledger/r29/>
SELECT ?run ((?realized / ?actionable) AS ?realizationRate) WHERE { ?run a prov:Activity ; r29:realizedCount ?realized ; r29:actionableCount ?actionable . FILTER(?actionable > 0) } ORDER BY DESC(?realizationRate) ?run
