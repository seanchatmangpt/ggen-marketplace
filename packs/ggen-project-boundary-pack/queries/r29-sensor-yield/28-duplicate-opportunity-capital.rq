PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?id (COUNT(?opportunity) AS ?duplicates) WHERE { ?opportunity a prov:Entity ; dcterms:type "actionable-opportunity" ; dcterms:identifier ?id . } GROUP BY ?id HAVING(COUNT(?opportunity) > 1) ORDER BY DESC(?duplicates) ?id
