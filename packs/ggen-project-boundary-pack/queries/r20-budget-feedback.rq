PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?decision ?budgetDelta ?realized ?regret
WHERE { ?decision a gpb:AdaptiveCapitalDecision ; gpb:budgetDelta ?budgetDelta ; gpb:realizedYield ?realized ; gpb:capitalRegret ?regret . }
ORDER BY DESC(?realized) ?regret ?budgetDelta ?decision