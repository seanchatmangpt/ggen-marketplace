PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?run ?actionable ?opportunities (?actionable / ?opportunities AS ?actionabilityRate) WHERE {
  ?run a gpb:SensorRealizationRun ; gpb:actionableCount ?actionable ; gpb:opportunityCount ?opportunities .
  FILTER(?opportunities > 0)
} ORDER BY DESC(?actionabilityRate)
