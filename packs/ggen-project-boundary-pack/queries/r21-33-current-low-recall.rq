PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?run ?tp ?fn (?tp / (?tp + ?fn) AS ?recall) WHERE {
  ?run a gpb:SensorRealizationRun ; gpb:current true ; gpb:truePositiveCount ?tp ; gpb:falseNegativeCount ?fn .
  FILTER((?tp + ?fn) > 0)
  FILTER((?tp / (?tp + ?fn)) < 0.8)
} ORDER BY ?recall
