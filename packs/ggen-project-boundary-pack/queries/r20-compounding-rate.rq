PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?period ?opening ?growth (?growth / ?opening AS ?compoundingRate)
WHERE { ?period a gpb:CapitalCompoundingPeriod ; gpb:openingStock ?opening ; gpb:netCapitalGrowth ?growth . FILTER(?opening > 0) }
ORDER BY DESC(?compoundingRate) ?period