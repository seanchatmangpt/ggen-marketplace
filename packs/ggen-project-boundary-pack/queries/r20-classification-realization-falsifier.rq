PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?obs ?class ?actions
WHERE { ?obs a gpb:CapitalRealizationObservation ; gpb:bookedCapitalClass ?class ; gpb:realizedQualifiedActions ?actions . FILTER(?class IN (gpb:CAPEX, gpb:CapitalDeepening, gpb:CompositionalCAPEX) && ?actions <= 0) }