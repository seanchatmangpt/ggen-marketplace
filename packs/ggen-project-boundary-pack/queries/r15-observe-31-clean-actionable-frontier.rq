PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?x ?repo ?sha WHERE { ?x a gp:Opportunity ; gp:exactRepo ?repo ; gp:exactSha ?sha ; gp:standing ?standing ; gp:hasFalsifier true ; gp:exercised true ; gp:receiptDigest ?receipt ; gp:actuationPerformed false . FILTER(?standing IN (gp:PARTIAL_ALIVE,gp:ALIVE)) FILTER regex(str(?sha), "^[0-9a-f]{40}$") FILTER regex(str(?receipt), "^[0-9a-f]{64}$") } ORDER BY ?repo ?x
