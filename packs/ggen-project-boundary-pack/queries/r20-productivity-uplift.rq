PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?candidate ?uplift ?investment (?uplift / ?investment AS ?upliftPerUnit)
WHERE { ?candidate a gpb:ReinvestmentCandidate ; gpb:productivityUplift ?uplift ; gpb:investmentUnits ?investment . FILTER(?investment > 0) }
ORDER BY DESC(?upliftPerUnit) ?candidate