PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?obs ?depreciation ?investment (?depreciation / ?investment AS ?depreciationRate)
WHERE { ?obs a gpb:CapitalRealizationObservation ; gpb:realizedDepreciation ?depreciation ; gpb:bookedInvestmentUnits ?investment . FILTER(?investment > 0) }
ORDER BY DESC(?depreciationRate) ?obs