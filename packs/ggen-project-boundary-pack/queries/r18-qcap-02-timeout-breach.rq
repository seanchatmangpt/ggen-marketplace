PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?obs ?pack ?latency ?budget WHERE {
  ?obs a gpb:PackQualificationObservation ; gpb:packName ?pack ; gpb:observedLatencySeconds ?latency .
  ?b a gpb:QualificationBudget ; gpb:qualificationTimeoutSeconds ?budget .
  FILTER(?latency > ?budget)
}
ORDER BY DESC(?latency) ?pack
