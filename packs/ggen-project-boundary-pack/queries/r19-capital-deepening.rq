PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?entry ?investment ?actions ?affected ((xsd:decimal(?actions) / xsd:decimal(?investment)) AS ?yield)
WHERE {
  ?entry a gpb:CapitalEntry ;
    gpb:capitalClass gpb:CapitalDeepening ;
    gpb:investmentUnits ?investment ;
    gpb:futureQualifiedActions ?actions ;
    gpb:affectedInstalledAssets ?affected .
  FILTER(xsd:decimal(?investment) > 0 && xsd:integer(?affected) > 0)
}
ORDER BY DESC(?yield) ?entry
