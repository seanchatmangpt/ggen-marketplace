PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?period ?growth ?productivity ?capacity ?drawdown
WHERE { ?period a gpb:CapitalCompoundingPeriod ; gpb:netCapitalGrowth ?growth ; gpb:productivityIndex ?productivity ; gpb:capacityIndex ?capacity ; gpb:drawdown ?drawdown ; gpb:current true ; gpb:authority "SELECT" ; gpb:actuationPerformed false . FILTER(?growth > 0 && ?drawdown >= 0) }
ORDER BY DESC(?growth) DESC(?productivity) DESC(?capacity) ?drawdown ?period