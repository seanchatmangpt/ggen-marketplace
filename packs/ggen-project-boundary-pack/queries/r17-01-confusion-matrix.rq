PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT (SUM(IF(?o=true && ?t=true,1,0)) AS ?tp) (SUM(IF(?o=true && ?t=false,1,0)) AS ?fp) (SUM(IF(?o=false && ?t=true,1,0)) AS ?fn) (SUM(IF(?o=false && ?t=false,1,0)) AS ?tn) WHERE { ?x a gp:SensorObservation ; gp:observedPositive ?o ; gp:groundTruthPositive ?t . }
