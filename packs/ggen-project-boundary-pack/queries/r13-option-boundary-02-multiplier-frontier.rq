PREFIX obc: <https://ggen.dev/ontology/option-boundary-capital#>
SELECT ?op ?capacity ?reuse ?unlock
WHERE {
  ?op a obc:Opportunity ;
      obc:futureManufacturingCapacity ?capacity ;
      obc:reuseValue ?reuse ;
      obc:dependencyUnlock ?unlock .
  FILTER(?capacity > 0 && ?reuse > 0 && ?unlock > 0)
}
ORDER BY DESC(?capacity) DESC(?reuse) DESC(?unlock) ?op
