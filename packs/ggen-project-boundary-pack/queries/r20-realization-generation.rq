PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?class (COUNT(DISTINCT ?generation) AS ?generations)
WHERE { ?obs a gpb:CapitalRealizationObservation ; gpb:bookedCapitalClass ?class ; gpb:realizationGeneration ?generation ; gpb:realizedCurrent true . }
GROUP BY ?class
HAVING(COUNT(DISTINCT ?generation) > 1)