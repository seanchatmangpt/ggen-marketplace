PREFIX alloc: <https://ggen.dev/ontology/relief-allocation-r33#>
SELECT ?candidate ?gain ?investment ((?gain / ?investment) AS ?density) WHERE {
  ?candidate a alloc:AllocationCandidate ; alloc:informationGain ?gain ; alloc:investmentUnits ?investment .
  FILTER(?investment > 0)
}
ORDER BY DESC(?density) ?candidate
