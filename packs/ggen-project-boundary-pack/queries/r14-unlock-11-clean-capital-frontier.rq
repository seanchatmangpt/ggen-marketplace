PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?entry WHERE { ?entry a gp:CapitalLedgerEntry ; gp:capitalYield ?yield ; gp:futureCapacity ?capacity ; gp:reversible true ; gp:authorityCost ?authority ; gp:standing ?standing . FILTER(xsd:decimal(?yield) > 1 && xsd:decimal(?capacity) > 0 && xsd:decimal(?authority) <= 1 && STR(?standing) != "BUILD_BROKEN" && STR(?standing) != "BLOCKED") } ORDER BY ?entry
