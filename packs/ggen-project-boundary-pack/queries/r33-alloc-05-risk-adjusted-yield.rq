PREFIX alloc: <https://ggen.dev/ontology/relief-allocation-r33#>
SELECT ?candidate ?relief ?gain ?capacity ?rollback ?authority
       (((?relief + ?gain + ?capacity) / (1 + ?rollback + ?authority)) AS ?adjustedYield)
WHERE {
  ?candidate a alloc:AllocationCandidate ;
    alloc:expectedRelief ?relief ; alloc:informationGain ?gain ; alloc:futureCapacity ?capacity ;
    alloc:rollbackCost ?rollback ; alloc:authorityCost ?authority .
}
ORDER BY DESC(?adjustedYield) ?candidate
