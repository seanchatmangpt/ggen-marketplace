PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?period ?start ?end ?opening ?gross ?depreciation ?deepening ?composition ?output ?assets ?families ?commits ?opexCommits ?capexCommits ?deepeningCommits ?compositionCommits ?receipt
WHERE {
  ?period a gpb:ManufacturingCapitalPeriod ;
    gpb:periodStart ?start ;
    gpb:periodEnd ?end ;
    gpb:openingCapitalStock ?opening ;
    gpb:grossCapitalFormation ?gross ;
    gpb:capitalDepreciation ?depreciation ;
    gpb:capitalDeepening ?deepening ;
    gpb:compositionUplift ?composition ;
    gpb:qualifiedManufacturingOutput ?output ;
    gpb:installedAssetCount ?assets ;
    gpb:composedAssetFamilyCount ?families ;
    gpb:totalMeaningfulCommits ?commits ;
    gpb:opexCommitCount ?opexCommits ;
    gpb:capexCommitCount ?capexCommits ;
    gpb:deepeningCommitCount ?deepeningCommits ;
    gpb:compositionalCapexCommitCount ?compositionCommits ;
    gpb:receiptDigest ?receipt .
  FILTER(
    xsd:decimal(?opening) >= 0 &&
    xsd:decimal(?gross) >= 0 &&
    xsd:decimal(?depreciation) >= 0 &&
    xsd:decimal(?deepening) >= 0 &&
    xsd:decimal(?composition) >= 0 &&
    xsd:decimal(?output) >= 0
  )
}
ORDER BY ?start ?period
