PREFIX gt: <https://ggen.dev/ontology/ground-truth-r33#>
SELECT
  (SUM(IF(?pred = true && ?actual = true,1,0)) AS ?tp)
  (SUM(IF(?pred = true && ?actual = false,1,0)) AS ?fp)
  (SUM(IF(?pred = false && ?actual = true,1,0)) AS ?fn)
  (SUM(IF(?pred = false && ?actual = false,1,0)) AS ?tn)
WHERE {
  ?obs a gt:CalibrationObservation ; gt:predictedPositive ?pred ; gt:actualPositive ?actual .
}
