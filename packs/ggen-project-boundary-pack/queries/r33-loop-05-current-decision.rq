PREFIX loop: <https://ggen.dev/ontology/calibrated-capital-allocation-r33#>
SELECT ?decision ?generation WHERE {
  ?decision a loop:CalibratedAllocationDecision ; loop:decisionGeneration ?generation .
  FILTER NOT EXISTS {
    ?other a loop:CalibratedAllocationDecision ; loop:decisionGeneration ?newer .
    FILTER(?newer > ?generation)
  }
}
ORDER BY ?decision
