PREFIX alloc: <https://ggen.dev/ontology/relief-allocation-r33#>
SELECT ?candidate ?relief ?gain ?capacity ?investment WHERE {
  ?candidate a alloc:AllocationCandidate ; alloc:expectedRelief ?relief ; alloc:informationGain ?gain ; alloc:futureCapacity ?capacity ; alloc:investmentUnits ?investment .
  FILTER(?investment > 0 && ((?relief + ?gain + ?capacity) / ?investment) > 1)
}
ORDER BY DESC(?capacity) DESC(?relief) ?candidate
