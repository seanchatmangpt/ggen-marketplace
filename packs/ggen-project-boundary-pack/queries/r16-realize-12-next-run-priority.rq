PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?run ?novel ?actionable ?relief WHERE { ?run a gp:MeasurementRun ; gp:runNovelCount ?novel ; gp:runActionableCount ?actionable ; gp:runReliefCount ?relief . FILTER(?actionable > ?relief || ?novel = 0) } ORDER BY DESC(?actionable) ASC(?relief)
