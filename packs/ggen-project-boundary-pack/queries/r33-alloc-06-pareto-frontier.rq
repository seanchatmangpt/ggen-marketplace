PREFIX alloc: <https://ggen.dev/ontology/relief-allocation-r33#>
SELECT ?candidate WHERE {
  ?candidate a alloc:AllocationCandidate ; alloc:expectedRelief ?r ; alloc:informationGain ?i ; alloc:futureCapacity ?f ; alloc:rollbackCost ?b ; alloc:authorityCost ?a .
  FILTER NOT EXISTS {
    ?other a alloc:AllocationCandidate ; alloc:expectedRelief ?or ; alloc:informationGain ?oi ; alloc:futureCapacity ?of ; alloc:rollbackCost ?ob ; alloc:authorityCost ?oa .
    FILTER(?other != ?candidate && ?or >= ?r && ?oi >= ?i && ?of >= ?f && ?ob <= ?b && ?oa <= ?a && (?or > ?r || ?oi > ?i || ?of > ?f || ?ob < ?b || ?oa < ?a))
  }
}
ORDER BY ?candidate
