PREFIX mfc: <https://ggen.dev/ontology/manufacturing-fanout#>
SELECT ?run ?edge WHERE { ?run a mfc:FanoutRealization ; mfc:realizes ?edge ; mfc:current true ; mfc:standing "ALIVE" ; mfc:actuationPerformed false ; mfc:authority "OBSERVE|VERIFY" ; mfc:receiptDigest ?receipt ; mfc:replayDigest ?receipt . FILTER NOT EXISTS { ?other mfc:realizes ?edge ; mfc:current true ; mfc:standing ?bad . FILTER(?bad != "ALIVE") } } ORDER BY ?edge