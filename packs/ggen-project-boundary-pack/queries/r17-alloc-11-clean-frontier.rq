PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?allocation ?yield ?actions WHERE {
  ?allocation a gp:CapitalAllocation ; gp:capitalYield ?yield ; gp:futureQualifiedActions ?actions ; gp:allocationStanding ?standing ; gp:selectionAuthority "SELECT" ; gp:actuationPerformed false .
  FILTER(?yield > 1 && ?actions > 0 && ?standing != "BUILD_BROKEN" && ?standing != "BLOCKED")
} ORDER BY DESC(?yield) DESC(?actions) ?allocation
