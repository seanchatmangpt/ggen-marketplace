PREFIX gp: <https://ggen.dev/ontology/project-boundary#>
SELECT ?sensor ((2*?tp)/(2*?tp+?fp+?fn) AS ?f1) WHERE { SELECT ?sensor (SUM(IF(?o=true && ?t=true,1,0)) AS ?tp) (SUM(IF(?o=true && ?t=false,1,0)) AS ?fp) (SUM(IF(?o=false && ?t=true,1,0)) AS ?fn) WHERE { ?x a gp:SensorObservation ; gp:sensorDigest ?sensor ; gp:observedPositive ?o ; gp:groundTruthPositive ?t . } GROUP BY ?sensor }
