PREFIX obc: <https://ggen.dev/ontology/option-boundary-capital#>
SELECT ?op ?yield ?capacity ?reversibility
WHERE {
  ?op a obc:Opportunity ;
      obc:capitalYield ?yield ;
      obc:futureManufacturingCapacity ?capacity ;
      obc:reversibility ?reversibility ;
      obc:projectContained true ;
      obc:standing "PARTIAL_ALIVE" .
  FILTER(?yield > 1 && ?capacity > 0 && ?reversibility > 0)
}
ORDER BY DESC(?yield) DESC(?capacity) DESC(?reversibility) ?op
