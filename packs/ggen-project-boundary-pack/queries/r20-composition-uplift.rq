PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?candidate ?composition ?reuse ?capacity
WHERE { ?candidate a gpb:ReinvestmentCandidate ; gpb:compositionValue ?composition ; gpb:reuseValue ?reuse ; gpb:futureManufacturingCapacity ?capacity . }
ORDER BY DESC(?composition) DESC(?reuse) DESC(?capacity) ?candidate