PREFIX gp: <https://ggen.dev/ontology/project-boundary#>

SELECT DISTINCT ?a ?b ?c
WHERE {
  ?portfolio a gp:OpportunityPortfolio ; gp:containsOpportunity ?a, ?b, ?c .
  FILTER (?a != ?b && ?a != ?c && ?b != ?c)
  ?a gp:compatibleWith ?b .
  ?b gp:compatibleWith ?c .
  ?a gp:reversibilityScore ?ar .
  ?b gp:reversibilityScore ?br .
  ?c gp:reversibilityScore ?cr .
  FILTER (?ar > 0 && ?br > 0 && ?cr > 0)
}
ORDER BY ?a ?b ?c
