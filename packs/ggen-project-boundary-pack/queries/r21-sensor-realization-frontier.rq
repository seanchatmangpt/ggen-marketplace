PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?run ?sensor ?subject ?standing ?seeds ?opportunities ?actionable ?tp ?fp ?fn ?novel ?relief ?cost ?latency ?receipt
       (?actionable / ?seeds AS ?discoveryMultiplier)
       (?tp / (?tp + ?fp) AS ?precision)
       (?tp / (?tp + ?fn) AS ?recall)
WHERE {
  ?run a gpb:SensorRealizationRun ; gpb:sensor ?sensor ; gpb:exactSubject ?subject ; gpb:standing ?standing ;
    gpb:seedCount ?seeds ; gpb:opportunityCount ?opportunities ; gpb:actionableCount ?actionable ;
    gpb:truePositiveCount ?tp ; gpb:falsePositiveCount ?fp ; gpb:falseNegativeCount ?fn ;
    gpb:novelCount ?novel ; gpb:realizedReliefCount ?relief ; gpb:costMillis ?cost ; gpb:latencyMillis ?latency ;
    gpb:receiptDigest ?receipt ; gpb:current true ; gpb:authority "OBSERVE|VERIFY" ; gpb:actuationPerformed false .
  FILTER(?seeds > 0 && (?tp + ?fp) > 0 && (?tp + ?fn) > 0)
}
ORDER BY DESC(?discoveryMultiplier) DESC(?precision) DESC(?recall) ?sensor
