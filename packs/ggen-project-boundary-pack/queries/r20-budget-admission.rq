PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?portfolio ?budget (SUM(?investment) AS ?allocated)
WHERE {
  ?portfolio a gpb:ReinvestmentPortfolio ; gpb:reinvestmentBudget ?budget .
  ?candidate a gpb:ReinvestmentCandidate ; gpb:selectedForPortfolio true ; gpb:investmentUnits ?investment .
}
GROUP BY ?portfolio ?budget
HAVING(SUM(?investment) > ?budget)