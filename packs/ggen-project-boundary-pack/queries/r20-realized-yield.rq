PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?obs ?investment ?actions (?actions / ?investment AS ?realizedYield)
WHERE { ?obs a gpb:CapitalRealizationObservation ; gpb:bookedInvestmentUnits ?investment ; gpb:realizedQualifiedActions ?actions . FILTER(?investment > 0) }
ORDER BY DESC(?realizedYield) ?obs