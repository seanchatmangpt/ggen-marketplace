PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?obs ?information ?capacity (?information + ?capacity AS ?epistemicCapacity)
WHERE { ?obs a gpb:CapitalRealizationObservation ; gpb:realizedInformationGain ?information ; gpb:realizedFutureCapacity ?capacity . }
ORDER BY DESC(?epistemicCapacity) ?obs