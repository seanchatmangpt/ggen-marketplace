PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?period ?growth ?reinvestment (?growth / ?reinvestment AS ?reinvestmentEfficiency)
WHERE { ?period a gpb:CapitalCompoundingPeriod ; gpb:netCapitalGrowth ?growth ; gpb:reinvestment ?reinvestment . FILTER(?reinvestment > 0) }
ORDER BY DESC(?reinvestmentEfficiency) ?period