PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
SELECT ?run ?tp ?fp ?fn ((2 * ?tp) / ((2 * ?tp) + ?fp + ?fn) AS ?f1) WHERE {
  ?run a gpb:SensorRealizationRun ; gpb:truePositiveCount ?tp ; gpb:falsePositiveCount ?fp ; gpb:falseNegativeCount ?fn .
  FILTER(((2 * ?tp) + ?fp + ?fn) > 0)
} ORDER BY ?run
