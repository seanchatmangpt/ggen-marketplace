@prefix gp: <https://ggen.dev/ontology/project-boundary#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

gp:CapitalAllocation a rdfs:Class ; rdfs:subClassOf prov:Entity .
gp:CapitalYieldMetric a dqv:Metric .
gp:FutureQualifiedActionMetric a dqv:Metric .
gp:InvestmentCostMetric a dqv:Metric .
gp:allocatedRun a rdf:Property .
gp:futureQualifiedActions a rdf:Property .
gp:investmentUnits a rdf:Property .
gp:capitalYield a rdf:Property .
gp:dependencyUnlockCount a rdf:Property .
gp:compositionUnlockCount a rdf:Property .
gp:informationGain a rdf:Property .
gp:rollbackCost a rdf:Property .
gp:authorityCost a rdf:Property .
gp:allocationStanding a rdf:Property .
gp:selectionAuthority a rdf:Property .
gp:actuationPerformed a rdf:Property .
