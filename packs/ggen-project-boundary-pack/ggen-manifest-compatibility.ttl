@prefix gmc: <https://ggen.dev/ontology/manifest-compatibility#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

gmc:ManifestSubject a rdfs:Class .
gmc:GenerationRuleShape a rdfs:Class .
gmc:CompatibilityObservation a rdfs:Class .
gmc:schemaFamily a rdf:Property .
gmc:projectVersion a rdf:Property .
gmc:ontologySourcePresent a rdf:Property .
gmc:querySourceKind a rdf:Property .
gmc:templateSourceKind a rdf:Property .
gmc:outputFilePresent a rdf:Property .
gmc:classifierCode a rdf:Property .
gmc:parserCode a rdf:Property .
gmc:ggenSubject a rdf:Property .
gmc:exactSubject a rdf:Property .
gmc:current a rdf:Property .
gmc:compatible a rdf:Property .
gmc:standing a rdf:Property .
