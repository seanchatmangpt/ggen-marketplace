@prefix alloc: <https://ggen.dev/ontology/relief-allocation-r33#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

alloc:AllocationCandidate a prov:Entity ; dcterms:description "Reversible EXPLORE allocation candidate." .
alloc:AllocationFrontier a prov:Collection ; dcterms:description "Non-dominated relief-weighted investment frontier." .
alloc:expectedRelief rdfs:subPropertyOf dqv:value .
alloc:informationGain rdfs:subPropertyOf dqv:value .
alloc:reuseValue rdfs:subPropertyOf dqv:value .
alloc:compositionValue rdfs:subPropertyOf dqv:value .
alloc:futureCapacity rdfs:subPropertyOf dqv:value .
alloc:rollbackCost rdfs:subPropertyOf dqv:value .
alloc:authorityCost rdfs:subPropertyOf dqv:value .
alloc:investmentUnits rdfs:subPropertyOf dqv:value .
<urn:ggen:r33:allocation-policy> a odrl:Policy ; dcterms:description "SELECT-only capital allocation; no ambient DO." .
