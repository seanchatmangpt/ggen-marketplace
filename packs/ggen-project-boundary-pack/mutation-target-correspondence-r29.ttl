@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix r29m: <https://chatman.ai/ledger/r29/mutation/> .

r29m:MutationAdmission a prov:Activity ; dcterms:title "Exact mutation-target admission" .
r29m:TargetCorrespondence a dqv:Metric ; dcterms:description "Requires repository, PR number, head ref, head SHA, base ref/SHA, and intended capability to correspond before a GitHub mutation." .
r29m:PrNumber a prov:Entity .
r29m:HeadRef a prov:Entity .
r29m:HeadSha a prov:Entity .
r29m:BaseSha a prov:Entity .
r29m:CapabilityIdentity a prov:Entity .
r29m:MutationIntent a prov:Entity .
r29m:ObservedTarget a prov:Entity .
r29m:CorrespondenceFailure a prov:Entity .
