@prefix gp: <https://ggen.dev/ontology/project-boundary#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

gp:Observation a rdfs:Class ; rdfs:subClassOf prov:Entity .
gp:Sensor a rdfs:Class ; rdfs:subClassOf prov:SoftwareAgent .
gp:Opportunity a rdfs:Class ; rdfs:subClassOf prov:Entity .
gp:OpportunityStanding a skos:ConceptScheme .
gp:ALIVE a skos:Concept ; skos:inScheme gp:OpportunityStanding .
gp:PARTIAL_ALIVE a skos:Concept ; skos:inScheme gp:OpportunityStanding .
gp:UNKNOWN a skos:Concept ; skos:inScheme gp:OpportunityStanding .
gp:BUILD_BROKEN a skos:Concept ; skos:inScheme gp:OpportunityStanding .
gp:UNSUPPORTED a skos:Concept ; skos:inScheme gp:OpportunityStanding .
gp:DiscoveryAmplification a dqv:Metric .
gp:CoverageMetric a dqv:Metric .
gp:FreshnessMetric a dqv:Metric .
gp:DependencyReliefMetric a dqv:Metric .
gp:GeneratorDriftMetric a dqv:Metric .
gp:FalsifierCoverageMetric a dqv:Metric .

gp:observedSubject a rdf:Property .
gp:seedObservation a rdf:Property .
gp:detectedBy a rdf:Property .
gp:actionableOpportunity a rdf:Property .
gp:standing a rdf:Property .
gp:exactRepo a rdf:Property .
gp:exactSha a rdf:Property .
gp:semanticDigest a rdf:Property .
gp:observedAt a rdf:Property .
gp:validUntil a rdf:Property .
gp:dependency a rdf:Property .
gp:dependencyRelieved a rdf:Property .
gp:generatorSourceDigest a rdf:Property .
gp:generatedDigest a rdf:Property .
gp:regeneratedDigest a rdf:Property .
gp:hasFalsifier a rdf:Property .
gp:interfaceDigest a rdf:Property .
gp:expectedInterfaceDigest a rdf:Property .
gp:orphaned a rdf:Property .
gp:duplicateOf a rdf:Property .
gp:shouldBeGenerated a rdf:Property .
gp:isGenerated a rdf:Property .
gp:exercised a rdf:Property .
gp:receiptDigest a rdf:Property .
gp:authority a rdf:Property .
gp:actuationPerformed a rdf:Property .
gp:seedCount a rdf:Property .
gp:opportunityCount a rdf:Property .
gp:amplification a rdf:Property .
gp:coverageRatio a rdf:Property .
gp:fresh a rdf:Property .
gp:sourceKind a rdf:Property .
gp:capabilityKind a rdf:Property .
