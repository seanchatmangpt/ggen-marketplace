@prefix gp: <https://ggen.dev/ontology/project-boundary#> .
@prefix ex: <https://example.test/r18#> .

ex:p a gp:OpportunityPortfolio ; gp:containsOpportunity ex:a, ex:b, ex:c, ex:d .
ex:a gp:compatibleWith ex:b ; gp:reversibilityScore 1 ; gp:missingPrimitive ex:receiptReplay ; gp:expectedReuse 8 .
ex:b gp:compatibleWith ex:c ; gp:reversibilityScore 1 ; gp:sharedCapability ex:receiptReplay ; gp:expectedReuse 7 .
ex:c gp:reversibilityScore 1 ; gp:expectedReuse 6 .
ex:d gp:reversibilityScore 0 ; gp:expectedReuse 9 .

ex:pairAB a gp:PairCandidate ; gp:composesMember ex:a, ex:b ; gp:compositionArity 2 ; gp:expectedCapabilitySpaceDelta 5 ; gp:expectedReuseDelta 3 ; gp:reversible true ; gp:sourcePortfolio ex:p .
ex:triadABC a gp:TriadCandidate ; gp:composesMember ex:a, ex:b, ex:c ; gp:compositionArity 3 ; gp:expectedCapabilitySpaceDelta 9 ; gp:expectedReuseDelta 5 ; gp:reversible true ; gp:sourcePortfolio ex:p .
ex:dominatedPair a gp:PairCandidate ; gp:composesMember ex:b, ex:c ; gp:compositionArity 2 ; gp:expectedCapabilitySpaceDelta 2 ; gp:expectedReuseDelta 1 ; gp:reversible true ; gp:dominatedBy ex:pairAB ; gp:sourcePortfolio ex:p .
