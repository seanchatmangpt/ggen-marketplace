@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix r30: <https://chatman.ai/ledger/r30/> .

r30:capLiveEvidence a r30:Capability ; dcterms:identifier "r27-live-github-evidence" .
r30:capCurrentness a r30:Capability ; dcterms:identifier "r28-opportunity-currentness" .
r30:capSensorYield a r30:Capability ; dcterms:identifier "r29-sensor-yield" .
r30:capReceipts a r30:Capability ; dcterms:identifier "receipt-replay" .
r30:capMarketplace a r30:Capability ; dcterms:identifier "deterministic-marketplace-pack" .
r30:capPublicOntology a r30:Capability ; dcterms:identifier "public-ontology-contract" .

r30:composeEvidenceCurrentness a r30:Composition ; r30:hasInput r30:capLiveEvidence, r30:capCurrentness ; r30:induces r30:candidateStaleEdgeDetector .
r30:composeYieldCurrentness a r30:Composition ; r30:hasInput r30:capSensorYield, r30:capCurrentness ; r30:induces r30:candidateSaturationRetirement .
r30:composeYieldReceipts a r30:Composition ; r30:hasInput r30:capSensorYield, r30:capReceipts ; r30:induces r30:candidateYieldReplayCourt .
r30:composeEvidenceMarketplace a r30:Composition ; r30:hasInput r30:capLiveEvidence, r30:capMarketplace ; r30:induces r30:candidateEvidencePackProjection .
r30:composeOntologyMarketplace a r30:Composition ; r30:hasInput r30:capPublicOntology, r30:capMarketplace ; r30:induces r30:candidateOntologyPackGenerator .
r30:composeCurrentnessReceipts a r30:Composition ; r30:hasInput r30:capCurrentness, r30:capReceipts ; r30:induces r30:candidateCurrentnessReplay .
r30:composeEvidenceYieldCurrentness a r30:Composition ; r30:hasInput r30:capLiveEvidence, r30:capSensorYield, r30:capCurrentness ; r30:induces r30:candidateAdaptiveSensorPortfolio .
r30:composeYieldOntologyMarketplace a r30:Composition ; r30:hasInput r30:capSensorYield, r30:capPublicOntology, r30:capMarketplace ; r30:induces r30:candidateSensorPackFamily .
r30:composeEvidenceReceiptsMarketplace a r30:Composition ; r30:hasInput r30:capLiveEvidence, r30:capReceipts, r30:capMarketplace ; r30:induces r30:candidateReceiptedEvidenceIngestor .
r30:composeAllEpistemic a r30:Composition ; r30:hasInput r30:capLiveEvidence, r30:capCurrentness, r30:capSensorYield, r30:capReceipts ; r30:induces r30:candidateEpistemicControlLoop .
r30:composeAllManufacture a r30:Composition ; r30:hasInput r30:capMarketplace, r30:capPublicOntology, r30:capReceipts ; r30:induces r30:candidateDeterministicCandidateFactory .
r30:composeFullHypergraph a r30:Composition ; r30:hasInput r30:capLiveEvidence, r30:capCurrentness, r30:capSensorYield, r30:capReceipts, r30:capMarketplace, r30:capPublicOntology ; r30:induces r30:candidateOptionCapitalCell .

