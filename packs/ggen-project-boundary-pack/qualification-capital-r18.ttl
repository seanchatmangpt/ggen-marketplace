@prefix gpb: <https://ggen.dev/ontology/project-boundary#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gpb:QualificationBudget a rdfs:Class .
gpb:PackQualificationObservation a rdfs:Class .
gpb:WorkflowBound a rdfs:Class .
gpb:qualificationTimeoutSeconds a rdf:Property .
gpb:workflowTimeoutMinutes a rdf:Property .
gpb:observedLatencySeconds a rdf:Property .
gpb:qualificationResult a rdf:Property .
gpb:shardIndex a rdf:Property .
gpb:packName a rdf:Property .
gpb:futureQualifiedActions a rdf:Property .
gpb:investmentUnits a rdf:Property .
gpb:capitalYield a rdf:Property .

gpb:R18QualificationBudget a gpb:QualificationBudget ;
  gpb:qualificationTimeoutSeconds 15 ;
  gpb:workflowTimeoutMinutes 8 ;
  gpb:authority "VERIFY" ;
  gpb:actuationPerformed false ;
  gpb:current true .
