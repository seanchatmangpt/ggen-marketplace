@prefix loop: <https://ggen.dev/ontology/calibrated-capital-allocation-r33#> .
@prefix live: <https://ggen.dev/ontology/live-candidate-realization-r33#> .
@prefix gt: <https://ggen.dev/ontology/ground-truth-r33#> .
@prefix alloc: <https://ggen.dev/ontology/relief-allocation-r33#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

loop:CalibratedAllocationDecision a prov:Entity ; dcterms:description "Reversible allocation decision grounded in realization and independent calibration." .
loop:realization rdfs:subPropertyOf prov:wasDerivedFrom .
loop:calibration rdfs:subPropertyOf prov:wasDerivedFrom .
loop:allocationCandidate rdfs:subPropertyOf prov:wasDerivedFrom .
loop:calibratedYield rdfs:subPropertyOf dqv:value .
loop:falseCapitalRisk rdfs:subPropertyOf dqv:value .
loop:reliefAdjustedValue rdfs:subPropertyOf dqv:value .
loop:decisionGeneration rdfs:subPropertyOf dcterms:hasVersion .
<urn:ggen:r33:calibrated-allocation-policy> a odrl:Policy ; dcterms:description "SELECT-only reversible capital allocation; BRCE remains exclusive DO." .
