@prefix gp: <https://ggen.dev/ontology/project-boundary#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gp:Capability a rdfs:Class .
gp:Composition a rdfs:Class .
gp:ExecutableCandidate a rdfs:Class .
gp:QualificationSurface a rdfs:Class .
gp:MarketplaceSupport a rdfs:Class .
gp:MissingPrimitive a rdfs:Class .
gp:FrontierMember a rdfs:Class .
gp:Hyperedge a rdfs:Class .

gp:usesCapability a rdf:Property .
gp:usesOntology a rdf:Property .
gp:usesMarketplacePack a rdf:Property .
gp:targetsRepository a rdf:Property .
gp:qualificationSurface a rdf:Property .
gp:missingPrimitive a rdf:Property .
gp:reversible a rdf:Property .
gp:expectedReuse a rdf:Property .
gp:capabilitySpaceDelta a rdf:Property .
gp:authorityCost a rdf:Property .
gp:rollbackCost a rdf:Property .
gp:informationGain a rdf:Property .
gp:semanticCommitPotential a rdf:Property .
gp:dominates a rdf:Property .
gp:standing a rdf:Property .
gp:current a rdf:Property .
gp:receiptDigest a rdf:Property .
gp:actuationPerformed a rdf:Property .
gp:rank a rdf:Property .
gp:sourceObservation a rdf:Property .
gp:derivedCandidate a rdf:Property .
gp:compositionOrder a rdf:Property .
gp:frontierMember a rdf:Property .

gp:OptionHypergraphAmplifier a prov:Plan, dct:MethodOfInstruction ;
  skos:prefLabel "Option hypergraph amplifier" ;
  dct:description "Constructs reversible executable candidate hyperedges from observed capabilities without granting consequential DO authority." .

gp:ExplorationMultiplier a dqv:Metric ;
  skos:prefLabel "Executable candidate exploration multiplier" ;
  dct:description "Executable non-dominated candidates created divided by actionable opportunities consumed." .
