@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix r28: <https://chatman.ai/ledger/r28/> .

r28:OpportunityRealization a prov:Activity ;
  dcterms:title "Opportunity realization R28" ;
  dcterms:description "Binds discovered opportunities to later qualified and merged capabilities so open/novel ledger state cannot survive downstream realization." .
r28:OpportunityClosureRate a dqv:Metric ; skos:prefLabel "realized opportunities per actionable opportunity" .
r28:RealizationLatency a dqv:Metric ; skos:prefLabel "elapsed time from opportunity observation to qualified containment" .
r28:StaleOpportunityPressure a dqv:Metric ; skos:prefLabel "opportunities still marked open after a containing capability exists" .
r28:MergeContainment a dqv:Metric ; skos:prefLabel "qualified subject contained by current default branch" .
