@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix r30: <https://chatman.ai/ledger/r30/> .

r30:Capability a skos:Concept ; dcterms:description "An admitted reusable capability available to composition search." .
r30:Composition a prov:Plan ; dcterms:description "A reversible combination of two or more capabilities." .
r30:Candidate a prov:Entity ; dcterms:description "An executable realization candidate induced by a composition." .
r30:Qualification a dqv:QualityMeasurement ; dcterms:description "Evidence-bearing falsifier or court for a candidate." .
r30:MarketplaceSupport a prov:Entity ; dcterms:description "Reusable pack support for deterministic manufacture." .
r30:MissingPrimitive a skos:Concept ; dcterms:description "A dependency whose absence blocks a candidate edge without invalidating the graph." .
r30:FrontierMember a skos:Concept ; dcterms:description "A non-dominated reversible candidate preserved before irreversible selection." .
r30:hasInput a rdf:Property ; dcterms:description "Links a composition to an admitted input capability." .
r30:induces a rdf:Property ; dcterms:description "Links a composition to an executable candidate." .
r30:qualifiedBy a rdf:Property ; dcterms:description "Links a candidate to qualification evidence." .
r30:marketplaceSupport a rdf:Property ; dcterms:description "Links a candidate to reusable deterministic manufacture support." .
r30:missingPrimitive a rdf:Property ; dcterms:description "Links a candidate to a typed missing primitive." .
r30:expectedReuse a rdf:Property ; dcterms:description "Expected cross-repository reuse count." .
r30:capabilitySpaceDelta a rdf:Property ; dcterms:description "Expected count of newly reachable lawful combinations." .
r30:reversibility a rdf:Property ; dcterms:description "Reversibility class before consequential selection." .
r30:authority a rdf:Property ; dcterms:description "Admitted authority; R30 reference data is OBSERVE|VERIFY only." .
r30:actuationPerformed a rdf:Property ; dcterms:description "Whether consequential DO occurred." .
