import json
from pathlib import Path

manifest = json.loads(Path(__file__).with_name("observability-sensor-factory.json").read_text())

declared = int(manifest["declared_sensor_count"])
observed = int(manifest["observed_sensor_count"])
names = [name for name in manifest["sensor_names_csv"].split(",") if name]

assert declared == observed, (declared, observed)
assert len(set(names)) == declared, names
assert "OBSERVE" in manifest["authority"] and "VERIFY" in manifest["authority"]
assert manifest["actuation_performed"] is False
assert manifest["manufacturing_law"].startswith("ontology -> query ->")
print("ALIVE:OBSERVABILITY_SENSOR_FACTORY_CORRESPONDENCE")
