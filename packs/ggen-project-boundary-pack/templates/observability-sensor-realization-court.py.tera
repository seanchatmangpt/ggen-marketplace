import json
from pathlib import Path

receipt = json.loads(Path(__file__).with_name("observability-sensor-realization.json").read_text())

assert receipt["authority"] == "OBSERVE|VERIFY"
assert receipt["actuation_performed"] is False
assert float(receipt["discovery_multiplier"]) >= 0.0
assert 0.0 <= float(receipt["precision"]) <= 1.0
assert 0.0 <= float(receipt["recall"]) <= 1.0
assert int(receipt["actionable_count"]) <= int(receipt["opportunity_count"])
assert len(receipt["receipt_digest"]) == 64
print("ALIVE:OBSERVABILITY_SENSOR_REALIZATION_R21")
