import json
from decimal import Decimal

payload = {
    "period": "{{ period }}",
    "net_growth": Decimal("{{ netGrowth }}"),
    "closing_stock": Decimal("{{ closingStock }}"),
    "capital_productivity": Decimal("{{ productivity }}"),
    "composition_commit_share": Decimal("{{ compositionShare }}"),
    "capex_commit_share": Decimal("{{ capexShare }}"),
    "option_yield": Decimal("{{ optionYield }}"),
}
assert payload["net_growth"] > 0
assert payload["closing_stock"] > 0
assert Decimal("0") <= payload["composition_commit_share"] <= Decimal("1")
assert Decimal("0") <= payload["capex_commit_share"] <= Decimal("1")
assert payload["option_yield"] > payload["capital_productivity"]
print(json.dumps({**{k: str(v) for k, v in payload.items()}, "standing": "ALIVE", "authority": "QUALIFY", "actuation_performed": False}, sort_keys=True))
