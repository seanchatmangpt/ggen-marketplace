# Generated consequence. Do not hand-edit.
EXPECTED_SUBJECT = "{{ subject | default(value=\"UNKNOWN\") }}"
EXPECTED_OPTION = "{{ option | default(value=\"UNKNOWN\") }}"
EXPECTED_OPPORTUNITY = "{{ opportunity | default(value=\"UNKNOWN\") }}"
AUTHORITY = "OBSERVE|VERIFY"
ACTUATION_PERFORMED = False

def qualify(subject, option, opportunity):
    assert subject == EXPECTED_SUBJECT
    assert option == EXPECTED_OPTION
    assert opportunity == EXPECTED_OPPORTUNITY
    assert AUTHORITY == "OBSERVE|VERIFY"
    assert ACTUATION_PERFORMED is False
    return "PARTIAL_ALIVE"
