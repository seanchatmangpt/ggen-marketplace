{
  "schema": "ggen.manufacturing-capital/1",
  "period": "{{ period }}",
  "period_start": "{{ start }}",
  "period_end": "{{ end }}",
  "opening_capital_stock": "{{ opening }}",
  "gross_capital_formation": "{{ gross }}",
  "capital_depreciation": "{{ depreciation }}",
  "capital_deepening": "{{ deepening }}",
  "composition_uplift": "{{ composition }}",
  "qualified_manufacturing_output": "{{ output }}",
  "installed_asset_count": "{{ assets }}",
  "composed_asset_family_count": "{{ families }}",
  "total_meaningful_commits": "{{ commits }}",
  "opex_commit_count": "{{ opexCommits }}",
  "capex_commit_count": "{{ capexCommits }}",
  "deepening_commit_count": "{{ deepeningCommits }}",
  "compositional_capex_commit_count": "{{ compositionCommits }}",
  "receipt_digest": "{{ receipt }}",
  "net_growth_formula": "gross_capital_formation + capital_deepening + composition_uplift - capital_depreciation",
  "closing_stock_formula": "opening_capital_stock + net_growth",
  "capital_productivity_formula": "qualified_manufacturing_output / closing_stock",
  "actuation_performed": false
}
