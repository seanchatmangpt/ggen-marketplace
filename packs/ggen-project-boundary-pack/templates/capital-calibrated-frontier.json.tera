{
  "schema": "ggen.option-capital-frontier/1",
  "period": "{{ period }}",
  "opening_capital_stock": "{{ opening }}",
  "gross_capital_formation": "{{ gross }}",
  "capital_depreciation": "{{ depreciation }}",
  "capital_deepening": "{{ deepening }}",
  "composition_uplift": "{{ composition }}",
  "qualified_manufacturing_output": "{{ output }}",
  "total_meaningful_commits": "{{ commits }}",
  "capex_commit_count": "{{ capexCommits }}",
  "compositional_capex_commit_count": "{{ compositionCommits }}",
  "option_yield_formula": "(output / closing_stock) * (1 + composition_commits / commits) * (1 + capex_commits / commits)",
  "standing": "PARTIAL_ALIVE",
  "authority": "QUALIFY",
  "actuation_performed": false
}
