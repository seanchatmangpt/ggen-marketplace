@prefix gp: <https://ggen.dev/ontology/project-boundary#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# R18 extends R17 opportunity portfolios without granting actuation authority.
gp:CompositionCandidate a rdfs:Class ; rdfs:subClassOf prov:Entity .
gp:PairCandidate a rdfs:Class ; rdfs:subClassOf gp:CompositionCandidate .
gp:TriadCandidate a rdfs:Class ; rdfs:subClassOf gp:CompositionCandidate .
gp:BridgeCandidate a rdfs:Class ; rdfs:subClassOf gp:CompositionCandidate .
gp:composesMember a rdf:Property .
gp:compositionArity a rdf:Property .
gp:sharedCapability a rdf:Property .
gp:missingPrimitive a rdf:Property .
gp:qualificationSurface a rdf:Property .
gp:expectedCapabilitySpaceDelta a rdf:Property .
gp:expectedReuseDelta a rdf:Property .
gp:reversible a rdf:Property .
gp:dominatedBy a rdf:Property .
gp:expansionStanding a rdf:Property .
gp:sourcePortfolio a rdf:Property .
gp:manufactureAuthority a rdf:Property .
gp:actuationPerformed a rdf:Property .
