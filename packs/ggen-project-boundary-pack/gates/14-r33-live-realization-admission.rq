PREFIX r33: <https://ggen.dev/ontology/live-candidate-realization-r33#>
ASK WHERE {
  ?realization a r33:CandidateRealization ;
    r33:qualifiedActionCount ?actions ;
    r33:investmentUnits ?investment ;
    r33:evidenceRoot ?root ;
    r33:currentGeneration ?generation .
  FILTER(?actions >= 0 && ?investment > 0)
  FILTER NOT EXISTS { ?realization <https://ggen.dev/ontology/authority#actuationPerformed> true }
}
