PREFIX gt: <https://ggen.dev/ontology/ground-truth-r33#>
ASK WHERE {
  ?a a gt:CalibrationObservation ; gt:sourceRoot ?rootA ; gt:sourceImplementation ?implA ; gt:sourceModel ?modelA .
  ?b a gt:CalibrationObservation ; gt:sourceRoot ?rootB ; gt:sourceImplementation ?implB ; gt:sourceModel ?modelB .
  FILTER(?a != ?b && ?rootA != ?rootB && ?implA != ?implB && ?modelA != ?modelB)
}
