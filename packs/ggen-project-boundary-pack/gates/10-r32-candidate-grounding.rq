PREFIX cap: <https://ggen.dev/ontology/option-capital#>
PREFIX dcterms: <http://purl.org/dc/terms/>
ASK {
  FILTER NOT EXISTS {
    ?candidate dcterms:type cap:Candidate .
    FILTER NOT EXISTS { ?candidate dcterms:identifier ?id ; cap:evidence ?evidence ; cap:reversibility cap:Reversible . }
  }
}
