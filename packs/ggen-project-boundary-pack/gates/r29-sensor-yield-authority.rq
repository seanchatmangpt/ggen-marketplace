PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX r29: <https://chatman.ai/ledger/r29/>
ASK {
  FILTER NOT EXISTS {
    ?run a prov:Activity ; r29:seedCount ?seeds .
    { ?run r29:authority ?authority . FILTER(?authority != "OBSERVE|VERIFY") }
    UNION
    { ?run r29:actuationPerformed true }
  }
}
