PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
ASK {
  ?run a gpb:SensorRealizationRun ;
    gpb:sensor ?sensor ; gpb:exactSubject ?subject ;
    gpb:seedCount ?seeds ; gpb:opportunityCount ?opportunities ; gpb:actionableCount ?actionable ;
    gpb:truePositiveCount ?tp ; gpb:falsePositiveCount ?fp ; gpb:falseNegativeCount ?fn ;
    gpb:novelCount ?novel ; gpb:costMillis ?cost ; gpb:latencyMillis ?latency ;
    gpb:current true ; gpb:authority "OBSERVE|VERIFY" ; gpb:actuationPerformed false ; gpb:receiptDigest ?receipt .
  FILTER(?seeds > 0 && ?opportunities >= ?actionable && (?tp + ?fp) > 0 && (?tp + ?fn) > 0)
  FILTER(regex(str(?receipt), "^[0-9a-f]{64}$"))
}
