PREFIX loop: <https://ggen.dev/ontology/calibrated-capital-allocation-r33#>
ASK WHERE {
  ?decision a loop:CalibratedAllocationDecision ; loop:realization ?r ; loop:calibration ?c ; loop:allocationCandidate ?a ; loop:calibratedYield ?yield ; loop:falseCapitalRisk ?risk ; loop:decisionGeneration ?generation .
  FILTER(?yield > 0 && ?risk >= 0 && ?risk < 0.5)
  FILTER NOT EXISTS { ?decision <https://ggen.dev/ontology/authority#actuationPerformed> true }
}
