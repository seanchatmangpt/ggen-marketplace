PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
ASK {
  ?factory a gpb:ObservabilitySensorFactory ;
    gpb:sensorScheme ?scheme ;
    gpb:sensorCount ?declared ;
    gpb:authority "OBSERVE|VERIFY|CONSTRUCT" ;
    gpb:actuationPerformed false .
  {
    SELECT ?scheme (COUNT(DISTINCT ?sensor) AS ?observed)
    WHERE {
      ?sensor a skos:Concept ; skos:inScheme ?scheme ; skos:notation ?notation .
    }
    GROUP BY ?scheme
  }
  FILTER(?declared = ?observed)
}
