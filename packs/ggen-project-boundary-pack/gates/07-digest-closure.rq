PREFIX gpb: <https://ggen.dev/ontology/project-boundary#>
ASK { ?t a gpb:GenerationTarget ; gpb:sourceDigest ?s ; gpb:queryDigest ?q ; gpb:templateDigest ?tplt ; gpb:outputDigest ?o . FILTER(regex(str(?s),"^[0-9a-f]{64}$") && regex(str(?q),"^[0-9a-f]{64}$") && regex(str(?tplt),"^[0-9a-f]{64}$") && regex(str(?o),"^[0-9a-f]{64}$")) }
