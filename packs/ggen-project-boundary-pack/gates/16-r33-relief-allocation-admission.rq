PREFIX alloc: <https://ggen.dev/ontology/relief-allocation-r33#>
ASK WHERE {
  ?candidate a alloc:AllocationCandidate ; alloc:expectedRelief ?relief ; alloc:informationGain ?gain ; alloc:futureCapacity ?capacity ; alloc:investmentUnits ?investment ; alloc:rollbackCost ?rollback ; alloc:authorityCost ?authority .
  FILTER(?investment > 0 && ?rollback >= 0 && ?authority >= 0)
  FILTER NOT EXISTS { ?candidate <https://ggen.dev/ontology/authority#actuationPerformed> true }
}
