@prefix gt: <https://ggen.dev/ontology/ground-truth-r33#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

gt:CalibrationObservation a prov:Entity ; dcterms:description "Independent label paired to an observed option-capital prediction." .
gt:GroundTruthSource a prov:Agent ; dcterms:description "Implementation/model/domain-distinct calibration source." .
gt:predictedPositive rdfs:subPropertyOf dqv:value .
gt:actualPositive rdfs:subPropertyOf dqv:value .
gt:sourceRoot rdfs:subPropertyOf prov:wasDerivedFrom .
gt:sourceImplementation rdfs:subPropertyOf dcterms:creator .
gt:sourceModel rdfs:subPropertyOf dcterms:type .
gt:generation rdfs:subPropertyOf dcterms:hasVersion .
<urn:ggen:r33:ground-truth-policy> a odrl:Policy ; dcterms:description "Calibration sources have OBSERVE|VERIFY authority only." .
