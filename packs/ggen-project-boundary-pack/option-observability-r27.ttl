@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix r27: <https://chatman.ai/ledger/r27/> .

r27:OptionObservabilityRealization a prov:Activity ;
  dcterms:title "Option observability realization R27" ;
  dcterms:description "Measures whether reversible option-capital expansion increases cross-repository discovery, novelty, actionability, evidence quality, and realized dependency relief." ;
  prov:used r27:PriorInnovationCapitalLedger ;
  prov:generated r27:R27InnovationCapitalLedger .

r27:R27InnovationCapitalLedger a dcat:Dataset ;
  dcterms:conformsTo <https://www.w3.org/TR/prov-o/> , <https://www.w3.org/TR/vocab-dqv/> ;
  dcterms:accrualMethod "append-only exact-subject observations and receipts" .

r27:DiscoveryMultiplier a dqv:Metric ; skos:prefLabel "actionable opportunities per seed observation" .
r27:NoveltyRate a dqv:Metric ; skos:prefLabel "novel actionable opportunities per discovered opportunity" .
r27:ReliefRate a dqv:Metric ; skos:prefLabel "realized dependency relief per actionable opportunity" .
r27:OptionYield a dqv:Metric ; skos:prefLabel "novel actionable opportunities per realized reversible option" .
r27:CrossRepoReach a dqv:Metric ; skos:prefLabel "distinct repositories reached per seed repository" .
r27:BlindSpotRate a dqv:Metric ; skos:prefLabel "grounded actionable opportunities missed by current sensors" .
r27:EvidenceIndependence a dqv:Metric ; skos:prefLabel "independent evidence-root fraction" .
r27:ReceiptCoverage a dqv:Metric ; skos:prefLabel "receipt-bound observation fraction" .
r27:FreshnessRate a dqv:Metric ; skos:prefLabel "current-generation observation fraction" .
r27:CostNormalizedYield a dqv:Metric ; skos:prefLabel "novel actionable opportunities per observation-cost unit" .
r27:LatencyNormalizedYield a dqv:Metric ; skos:prefLabel "novel actionable opportunities per observation-latency unit" .
