@prefix cap: <https://ggen.dev/ontology/option-capital#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

cap:Candidate a skos:Concept ; skos:prefLabel "Executable option-capital candidate" .
cap:Composition a skos:Concept ; skos:prefLabel "Lawful capability composition" .
cap:Qualification a skos:Concept ; skos:prefLabel "Candidate qualification evidence" .
cap:Reversible a skos:Concept ; skos:prefLabel "Reversible before consequential actuation" .

cap:dependsOn rdfs:subPropertyOf dcterms:requires .
cap:composesWith rdfs:subPropertyOf dcterms:relation .
cap:evidence rdfs:subPropertyOf prov:wasDerivedFrom .
cap:marketplaceSupport rdfs:subPropertyOf dcterms:relation .
cap:repository rdfs:subPropertyOf dcterms:isPartOf .
cap:qualification rdfs:subPropertyOf prov:wasGeneratedBy .
cap:reversibility rdfs:subPropertyOf dcterms:type .

cap:liveCandidateRealization a prov:Entity ;
  dcterms:type cap:Candidate ;
  dcterms:identifier "live-candidate-realization-corpus" ;
  cap:repository <https://github.com/seanchatmangpt/ggen-marketplace> ;
  cap:marketplaceSupport <https://ggen.dev/marketplace/ggen-project-boundary-pack> ;
  cap:evidence <urn:ggen:measure:r31> ;
  cap:reversibility cap:Reversible .

cap:independentGroundTruthCalibration a prov:Entity ;
  dcterms:type cap:Candidate ;
  dcterms:identifier "independent-ground-truth-calibration" ;
  cap:repository <https://github.com/seanchatmangpt/ggen-marketplace> ;
  cap:marketplaceSupport <https://ggen.dev/marketplace/ggen-project-boundary-pack> ;
  cap:composesWith cap:liveCandidateRealization ;
  cap:evidence <urn:ggen:measure:r31> ;
  cap:reversibility cap:Reversible .

cap:reliefWeightedExploreAllocation a prov:Entity ;
  dcterms:type cap:Candidate ;
  dcterms:identifier "relief-weighted-explore-allocation" ;
  cap:repository <https://github.com/seanchatmangpt/ggen-marketplace> ;
  cap:marketplaceSupport <https://ggen.dev/marketplace/ggen-project-boundary-pack> ;
  cap:composesWith cap:liveCandidateRealization, cap:independentGroundTruthCalibration ;
  cap:evidence <urn:ggen:measure:r31> ;
  cap:reversibility cap:Reversible .

<urn:ggen:policy:r32-no-actuation> a odrl:Policy ;
  dcterms:description "R32 manufactures candidate evidence only; it conveys no DO authority." .

<urn:ggen:dataset:r32-option-capital> a dcat:Dataset ;
  dcterms:title "R32 option-capital opportunity hypergraph" ;
  prov:wasDerivedFrom <urn:ggen:measure:r31> .
