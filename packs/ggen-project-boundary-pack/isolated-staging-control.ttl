@prefix isc: <https://ggen.dev/ontology/isolated-staging-control#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

isc:StagePlan a rdfs:Class .
isc:StageArtifact a rdfs:Class .
isc:ConsumerImport a rdfs:Class .
isc:sourceSubject a rdf:Property .
isc:targetRepository a rdf:Property .
isc:stageRoot a rdf:Property .
isc:artifactPath a rdf:Property .
isc:artifactDigest a rdf:Property .
isc:consumerDigest a rdf:Property .
isc:importDigest a rdf:Property .
isc:contained a rdf:Property .
isc:isolated a rdf:Property .
isc:deterministic a rdf:Property .
isc:replayable a rdf:Property .
isc:collisionFree a rdf:Property .
isc:current a rdf:Property .
isc:authority a rdf:Property .
isc:actuationPerformed a rdf:Property .
isc:standing a rdf:Property .
