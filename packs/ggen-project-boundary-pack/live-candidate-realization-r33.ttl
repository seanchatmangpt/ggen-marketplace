@prefix cap: <https://ggen.dev/ontology/option-capital#> .
@prefix r33: <https://ggen.dev/ontology/live-candidate-realization-r33#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

r33:CandidateRealization a prov:Entity ; dcterms:description "Observed realization of an R32 executable candidate." .
r33:RealizationFrontier a prov:Collection ; dcterms:description "Current exact-subject realization frontier." .
r33:realizes rdfs:subPropertyOf prov:specializationOf .
r33:qualifiedActionCount rdfs:subPropertyOf dqv:value .
r33:investmentUnits rdfs:subPropertyOf dqv:value .
r33:dependencyRelief rdfs:subPropertyOf dqv:value .
r33:realizedYield rdfs:subPropertyOf dqv:value .
r33:evidenceRoot rdfs:subPropertyOf prov:wasDerivedFrom .
r33:currentGeneration rdfs:subPropertyOf dcterms:hasVersion .
<urn:ggen:r33:live-realization-policy> a odrl:Policy ; dcterms:description "OBSERVE|VERIFY|SELECT only; zero consequential DO." .
