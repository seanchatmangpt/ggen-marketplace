@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix r29: <https://chatman.ai/ledger/r29/> .

r29:SensorYieldCalibration a prov:Activity ;
  dcterms:title "Sensor yield calibration R29" ;
  dcterms:description "Measures whether reusable Better-Eyes sensors convert exact seed observations into novel actionable opportunities and realized dependency relief efficiently." .

r29:DiscoveryMultiplier a dqv:Metric ; skos:prefLabel "actionable opportunities per seed observation" .
r29:NoveltyRate a dqv:Metric ; skos:prefLabel "novel opportunities per actionable opportunity" .
r29:RealizationRate a dqv:Metric ; skos:prefLabel "realized opportunities per actionable opportunity" .
r29:Precision a dqv:Metric ; skos:prefLabel "true actionable findings per classified positive" .
r29:Recall a dqv:Metric ; skos:prefLabel "true actionable findings per grounded actionable opportunity" .
r29:F1 a dqv:Metric ; skos:prefLabel "harmonic mean of sensor precision and recall" .
r29:ClosureAdjustedDiscovery a dqv:Metric ; skos:prefLabel "realized opportunities per seed observation" .
r29:CostNormalizedYield a dqv:Metric ; skos:prefLabel "novel actionable opportunities per observation cost unit" .
r29:LatencyNormalizedYield a dqv:Metric ; skos:prefLabel "novel actionable opportunities per observation second" .
r29:DependencyReliefRate a dqv:Metric ; skos:prefLabel "dependency-relieving realizations per actionable opportunity" .
r29:BlindSpotPressure a dqv:Metric ; skos:prefLabel "grounded actionable opportunities missed by the sensor" .
r29:SaturationPressure a dqv:Metric ; skos:prefLabel "sensor runs producing no novel opportunity capital" .
