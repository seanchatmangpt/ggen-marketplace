@prefix gp: <https://ggen.dev/ontology/project-boundary#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

gp:MeasurementRun a rdfs:Class ; rdfs:subClassOf prov:Activity .
gp:SensorRealization a rdfs:Class ; rdfs:subClassOf prov:Entity .
gp:NoveltyMetric a dqv:Metric .
gp:ActionabilityMetric a dqv:Metric .
gp:RealizedReliefMetric a dqv:Metric .
gp:MarginalAmplificationMetric a dqv:Metric .
gp:runId a rdf:Property .
gp:runSubject a rdf:Property .
gp:previousRun a rdf:Property .
gp:novelOpportunity a rdf:Property .
gp:actionable a rdf:Property .
gp:realizedRelief a rdf:Property .
gp:measurementCost a rdf:Property .
gp:measurementLatency a rdf:Property .
gp:runSeedCount a rdf:Property .
gp:runOpportunityCount a rdf:Property .
gp:runNovelCount a rdf:Property .
gp:runActionableCount a rdf:Property .
gp:runReliefCount a rdf:Property .
gp:qualifiedHead a rdf:Property .
gp:mergeSha a rdf:Property .
gp:defaultHead a rdf:Property .
gp:contained a rdf:Property .
