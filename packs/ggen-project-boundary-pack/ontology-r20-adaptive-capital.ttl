@prefix gpb: <https://ggen.dev/ontology/project-boundary#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

gpb:AdaptiveCapitalDecision a rdfs:Class .
gpb:CapitalPolicyGeneration a rdfs:Class .
gpb:forecastYield a rdf:Property .
gpb:realizedYield a rdf:Property .
gpb:capitalRegret a rdf:Property .
gpb:depreciationRate a rdf:Property .
gpb:productivityDelta a rdf:Property .
gpb:budgetDelta a rdf:Property .
gpb:policyGeneration a rdf:Property .
gpb:policyDigest a rdf:Property .
gpb:selectedStrategy a rdf:Property .
gpb:AdaptiveCapitalRegretMetric a dqv:Metric ; rdfs:label "Realized manufacturing-capital regret" .
gpb:R20ReferenceAdaptiveDecision a gpb:AdaptiveCapitalDecision, prov:Entity ;
  gpb:forecastYield 8.0 ; gpb:realizedYield 7.2 ; gpb:capitalRegret 0.8 ;
  gpb:depreciationRate 0.1 ; gpb:productivityDelta 0.4 ; gpb:budgetDelta 2.0 ;
  gpb:policyGeneration 1 ; gpb:policyDigest "7777777777777777777777777777777777777777777777777777777777777777" ;
  gpb:selectedStrategy "MAX_REALIZED_Y" ; gpb:current true ; gpb:authority "SELECT" ; gpb:actuationPerformed false .