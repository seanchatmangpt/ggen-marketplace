@prefix gpb: <https://ggen.dev/ontology/project-boundary#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# R27 composes existing public provenance and data-quality semantics; only bounded
# manufacturing relations that have no public equivalent remain in gpb:.
gpb:PortfolioOption a rdf:Class ; skos:prefLabel "Reversible portfolio option" .
gpb:RemediationAttempt a rdf:Class ; skos:prefLabel "Observed remediation attempt" .
gpb:DependencyReliefObservation a rdf:Class ; skos:prefLabel "Observed dependency relief" .
gpb:OpportunityReliefRun a rdf:Class ; skos:prefLabel "Opportunity-to-relief measurement run" .

gpb:optionForOpportunity a rdf:Property .
gpb:selectedOption a rdf:Property .
gpb:attemptForOption a rdf:Property .
gpb:reliefFromAttempt a rdf:Property .
gpb:originatingSensor a rdf:Property .
gpb:failureDomain a rdf:Property .
gpb:stageLatencyMillis a rdf:Property .
gpb:conversionCurrent a rdf:Property .
gpb:lineageComplete a rdf:Property .
gpb:realizedReliefUnits a rdf:Property .
gpb:opportunityToOptionRate a dqv:Metric ; skos:prefLabel "Opportunity-to-option conversion rate" .
gpb:optionToAttemptRate a dqv:Metric ; skos:prefLabel "Option-to-attempt conversion rate" .
gpb:attemptToReliefRate a dqv:Metric ; skos:prefLabel "Attempt-to-relief conversion rate" .
gpb:ReliefYieldMetric a dqv:Metric ; skos:prefLabel "Realized relief per seed observation" .

# Provenance law: opportunity -> option -> attempt -> relief is represented with
# prov:wasDerivedFrom / prov:wasGeneratedBy; missing links remain observable gaps.
