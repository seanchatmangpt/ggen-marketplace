@prefix gpb: <https://ggen.dev/ontology/project-boundary#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

gpb:CapitalRealizationObservation a rdfs:Class .
gpb:CapitalRealizationAudit a rdfs:Class .
gpb:bookedCapitalClass a rdf:Property .
gpb:bookedInvestmentUnits a rdf:Property .
gpb:realizedQualifiedActions a rdf:Property .
gpb:realizedDependencyRelief a rdf:Property .
gpb:realizedCompositionValue a rdf:Property .
gpb:realizedInformationGain a rdf:Property .
gpb:realizedFutureCapacity a rdf:Property .
gpb:realizedDepreciation a rdf:Property .
gpb:expectedQualifiedActions a rdf:Property .
gpb:realizationGeneration a rdf:Property .
gpb:realizedCurrent a rdf:Property .
gpb:auditDigest a rdf:Property .
gpb:CapitalRealizationYieldMetric a dqv:Metric ; rdfs:label "Realized qualified actions per booked investment unit" .
gpb:R20ReferenceCapitalRealization a gpb:CapitalRealizationObservation, prov:Entity ;
  gpb:bookedCapitalClass gpb:CAPEX ; gpb:bookedInvestmentUnits 10.0 ;
  gpb:expectedQualifiedActions 80 ; gpb:realizedQualifiedActions 72 ;
  gpb:realizedDependencyRelief 5.0 ; gpb:realizedCompositionValue 4.0 ;
  gpb:realizedInformationGain 3.0 ; gpb:realizedFutureCapacity 32.0 ;
  gpb:realizedDepreciation 1.0 ; gpb:realizationGeneration 1 ; gpb:realizedCurrent true ;
  gpb:authority "VERIFY" ; gpb:actuationPerformed false ;
  gpb:auditDigest "6666666666666666666666666666666666666666666666666666666666666666" .