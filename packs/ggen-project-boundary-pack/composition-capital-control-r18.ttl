@prefix gpb: <https://ggen.dev/ontology/project-boundary#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

gpb:CompositionCapitalDecision a rdfs:Class .
gpb:CompositionRealization a rdfs:Class .
gpb:compositionId a rdf:Property .
gpb:futureQualifiedActions a rdf:Property .
gpb:investmentUnits a rdf:Property .
gpb:realizedQualifiedActions a rdf:Property .
gpb:rollbackCost a rdf:Property .
gpb:authorityCost a rdf:Property .
gpb:compositionValue a rdf:Property .
gpb:informationGain a rdf:Property .
gpb:compatible a rdf:Property .
gpb:current a rdf:Property .
