---
to: "generated/{{ row.name }}/ontology.ttl"
sparql:
  row: |
    PREFIX psg: <https://seanchatmangpt.github.io/packs/pack-scaffold-generator#>
    SELECT ?name ?iri WHERE {
      ?s a psg:PackScaffold ;
         psg:packName ?name ;
         psg:packIri ?iri .
    } ORDER BY ?name
---
@prefix p: <{{ row.iri }}> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Minimal capability surface for {{ row.name }} (born UNVERIFIED).
p:Capability a rdfs:Class ;
    rdfs:label "Capability" ;
    rdfs:comment "One capability admitted by {{ row.name }}; generated as a minimal conforming surface to be replaced by the pack author's real domain claim." .

p:capabilityId a rdf:Property ;
    rdfs:domain p:Capability ;
    rdfs:range xsd:string ;
    rdfs:comment "Exact identity of the capability (required; enforced by gates/010_capability_identity.rq)." .

p:example-capability a p:Capability ;
    p:capabilityId "urn:{{ row.name }}:example" .
