---
to: "generated/{{ row.name }}/gates/010_capability_identity.rq"
sparql:
  row: |
    PREFIX psg: <https://seanchatmangpt.github.io/packs/pack-scaffold-generator#>
    SELECT ?name ?iri WHERE {
      ?s a psg:PackScaffold ;
         psg:packName ?name ;
         psg:packIri ?iri .
    } ORDER BY ?name
---
# MESSAGE: capability without capabilityId.
# Every p:Capability must carry an exact capabilityId; a row is a refusal.
PREFIX p: <{{ row.iri }}>
SELECT ?capability WHERE {
  ?capability a p:Capability .
  FILTER NOT EXISTS { ?capability p:capabilityId ?id }
}
ORDER BY ?capability
