---
to: "generated/{{ row.name }}/gate-court.toml"
sparql:
  row: |
    PREFIX psg: <https://seanchatmangpt.github.io/packs/pack-scaffold-generator#>
    SELECT ?name WHERE {
      ?s a psg:PackScaffold ;
         psg:packName ?name .
    } ORDER BY ?name
---
[court]
schema = "ggen.semantic-gate-witness-court/1"
case_key = "exact-stem"
runner = "python3 scripts/check_gate_witness_courts.py"
gate_dir = "gates"
pass_dir = "witnesses/pass"
fail_dir = "witnesses/fail"
require_pass = true
require_fail = true
