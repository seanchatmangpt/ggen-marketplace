---
to: "generated/{{ row.name }}/pack.toml"
sparql:
  row: |
    PREFIX psg: <https://seanchatmangpt.github.io/packs/pack-scaffold-generator#>
    SELECT ?name ?iri ?profile ?description ?urn WHERE {
      ?s a psg:PackScaffold ;
         psg:packName ?name ;
         psg:packIri ?iri ;
         psg:packProfile ?profile ;
         psg:packDescription ?description ;
         psg:capabilityUrn ?urn .
    } ORDER BY ?name
---
[pack]
name = "{{ row.name }}"
version = "0.1.0"
description = """
{{ row.description }}
Scaffolded by pack-scaffold-generator from one psg:PackScaffold individual
(namespace {{ row.iri }}). Grants no execution authority; replace this
description with the generated pack's exact domain claim and bump the version
on any content change.
"""

[capabilities]
provides = ["{{ row.urn }}"]
requires = []
