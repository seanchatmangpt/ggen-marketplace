# MESSAGE: PackScaffold missing a required property.
# Every psg:PackScaffold must carry packName, packIri, packProfile,
# packDescription and capabilityUrn; a row is a refusal.
PREFIX psg: <https://seanchatmangpt.github.io/packs/pack-scaffold-generator#>
SELECT ?scaffold WHERE {
  ?scaffold a psg:PackScaffold .
  FILTER NOT EXISTS {
    ?scaffold psg:packName ?n ;
              psg:packIri ?i ;
              psg:packProfile ?pr ;
              psg:packDescription ?d ;
              psg:capabilityUrn ?u .
  }
}
ORDER BY ?scaffold
