# MESSAGE: packName violates the kebab-case naming law.
# Every psg:packName must match ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ; a row is a refusal.
PREFIX psg: <https://seanchatmangpt.github.io/packs/pack-scaffold-generator#>
SELECT ?scaffold ?name WHERE {
  ?scaffold a psg:PackScaffold ;
            psg:packName ?name .
  FILTER (!regex(?name, "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"))
}
ORDER BY ?scaffold
