@prefix psg: <https://seanchatmangpt.github.io/packs/pack-scaffold-generator#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Meta-capability: a scaffold order for a NEW marketplace pack.
psg:PackScaffold a rdfs:Class ;
    rdfs:label "PackScaffold" ;
    rdfs:comment "An admitted scaffold order for a NEW marketplace pack. Each individual renders one complete conforming pack via this pack's templates. The generated pack is born UNVERIFIED: its RECEIPT carries Standing: UNVERIFIED until the generated gates execute against real content." .

psg:packName a rdf:Property ;
    rdfs:domain psg:PackScaffold ;
    rdfs:range xsd:string ;
    rdfs:comment "Exact pack name; must be kebab-case ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ (enforced by gates/020_pack_name_kebab.rq)." .

psg:packIri a rdf:Property ;
    rdfs:domain psg:PackScaffold ;
    rdfs:range xsd:string ;
    rdfs:comment "Base IRI including trailing # for the generated pack's namespace." .

psg:packProfile a rdf:Property ;
    rdfs:domain psg:PackScaffold ;
    rdfs:range xsd:string ;
    rdfs:comment "Packaging profile recorded on the order (semantic | projection | project); informational at generation time." .

psg:packDescription a rdf:Property ;
    rdfs:domain psg:PackScaffold ;
    rdfs:range xsd:string ;
    rdfs:comment "Exact description block for the generated pack.toml; must state the generated pack's domain claim; grants no execution authority." .

psg:capabilityUrn a rdf:Property ;
    rdfs:domain psg:PackScaffold ;
    rdfs:range xsd:string ;
    rdfs:comment "URN placed in the generated pack.toml [capabilities].provides." .

# Demo individual (render input during projection qualification, which runs
# templates against the pack's own graph).
psg:demo-pack a psg:PackScaffold ;
    psg:packName "demo-pack" ;
    psg:packIri "https://seanchatmangpt.github.io/packs/demo-pack#" ;
    psg:packProfile "projection" ;
    psg:packDescription "Demo scaffold order proving the generator renders a conforming pack from one graph individual." ;
    psg:capabilityUrn "urn:ggen:pack:demo-pack" .
