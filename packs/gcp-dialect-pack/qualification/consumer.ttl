# Seed consumer binding: one gcp-dialect consumer bound to one wire pin and
# one envelope law from the canonical graph. Qualification uses this to verify
# that a consumer grounded in the pack sees exactly the pinned dialect surface
# (no more, no less).
@prefix arcus: <urn:arcus:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

arcus:consumer-gcp-dialect a arcus:Consumer ;
    dcterms:title "gcp-dialect seed consumer (pubsub wire + V4 signing surface)" ;
    arcus:bindsPin arcus:pin-data ;
    arcus:bindsLaw arcus:law-E2 ;
    prov:wasDerivedFrom arcus:src-ts-gcp-probes .
