    PREFIX arcus: <urn:arcus:>
    SELECT DISTINCT ?id ?statement WHERE {
      ?l a arcus:EnvelopeLaw ; arcus:lawId ?id ; arcus:lawStatement ?statement .
    } ORDER BY ?id
  dialectPins: >
    PREFIX arcus: <urn:arcus:>
    PREFIX prov: <http://www.w3.org/ns/prov#>
    SELECT DISTINCT ?symbol ?value WHERE {
      ?c a arcus:DialectPin ; arcus:symbol ?symbol ; arcus:version ?value ;
         prov:wasDerivedFrom arcus:src-gcp-dialect-go-consts .
    } ORDER BY ?symbol
