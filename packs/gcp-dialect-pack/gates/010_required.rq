# MESSAGE: every gcp WirePin must carry message, fieldName, fieldNumber, and
# wireType, and derive from the pinned source entity.
PREFIX arcus: <urn:arcus:>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?pin WHERE {
  ?pin a arcus:WirePin .
  FILTER (
    NOT EXISTS { ?pin arcus:message ?m } ||
    NOT EXISTS { ?pin arcus:fieldName ?f } ||
    NOT EXISTS { ?pin arcus:fieldNumber ?n } ||
    NOT EXISTS { ?pin arcus:wireType ?wt } ||
    NOT EXISTS { ?pin prov:wasDerivedFrom ?src }
  )
} ORDER BY ?pin
