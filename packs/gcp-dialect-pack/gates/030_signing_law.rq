# MESSAGE: signing-law closure - every SigningLaw carries lawId + statement
# and derives from the TS-probe source entity.
PREFIX arcus: <urn:arcus:>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?law WHERE {
  ?law a arcus:SigningLaw .
  FILTER (
    NOT EXISTS { ?law arcus:lawId ?id } ||
    NOT EXISTS { ?law arcus:lawStatement ?stmt } ||
    NOT EXISTS { ?law prov:wasDerivedFrom ?src }
  )
} ORDER BY ?law
