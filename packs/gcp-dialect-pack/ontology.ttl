@prefix arcus: <urn:arcus:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# gcp-dialect-pack: the GCP dialect pin lattice. Construction only: a pinned
# field admits exactly its pinned number and wire type; an unpinned field is
# a typed refusal, never nil. The Go binding of these pins is
# internal/dialect/gcp/wire.go / signing.go / errors.go / lro.go.

arcus:WirePin a rdfs:Class ;
    rdfs:label "Protobuf field pin" ;
    rdfs:comment "One pubsub.proto field: message, field name, number, wire type." .

arcus:SigningLaw a rdfs:Class ;
    rdfs:label "GCS V4 signing law" ;
    rdfs:comment "One law of the GCS V4 signed-URL pipeline (L1-L5)." .

arcus:EnvelopeLaw a rdfs:Class ;
    rdfs:label "Error-envelope law" ;
    rdfs:comment "One law of the GCP JSON error envelope / LRO surface (E1-E4)." .

arcus:fieldNumber a owl:DatatypeProperty ;
    rdfs:comment "Pinned protobuf field number." .

arcus:wireType a owl:DatatypeProperty ;
    rdfs:comment "Pinned protobuf wire type (0 varint, 2 length-delimited)." .

arcus:message a owl:DatatypeProperty ;
    rdfs:comment "Owning protobuf message name." .

arcus:fieldName a owl:DatatypeProperty ;
    rdfs:comment "Pinned field name (Go constant stem)." .

arcus:lawId a owl:DatatypeProperty ;
    rdfs:comment "Probe law id (L1-L5, E1-E4)." .

arcus:lawStatement a owl:DatatypeProperty ;
    rdfs:comment "The law statement." .

arcus:src-smalt-pubsub-wire a prov:Entity ;
    dcterms:title "smalt pubsub_grpc/wire.ex (lane K-GC v26.11.6)" ;
    dcterms:source <https://smalt.dev/pubsub-wire> .

arcus:src-ts-gcp-probes a prov:Entity ;
    dcterms:title "verification/ts/gcp probes (GCS V4 + error-envelope census)" ;
    dcterms:source <https://arcus.dev/verification/ts/gcp> .

# -- wire pins (Go binding: internal/dialect/gcp/wire.go constants) ------

arcus:pin-data a arcus:WirePin ;
    arcus:message "PubsubMessage" ; arcus:fieldName "FieldData" ; arcus:fieldNumber 1 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-attributes a arcus:WirePin ;
    arcus:message "PubsubMessage" ; arcus:fieldName "FieldAttributes" ; arcus:fieldNumber 2 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-message-id a arcus:WirePin ;
    arcus:message "PubsubMessage" ; arcus:fieldName "FieldMessageID" ; arcus:fieldNumber 3 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-publish-time a arcus:WirePin ;
    arcus:message "PubsubMessage" ; arcus:fieldName "FieldPublishTime" ; arcus:fieldNumber 4 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-ordering-key a arcus:WirePin ;
    arcus:message "PubsubMessage" ; arcus:fieldName "FieldOrderingKey" ; arcus:fieldNumber 5 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-topic a arcus:WirePin ;
    arcus:message "PublishRequest" ; arcus:fieldName "FieldTopic" ; arcus:fieldNumber 1 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-messages a arcus:WirePin ;
    arcus:message "PublishRequest" ; arcus:fieldName "FieldMessages" ; arcus:fieldNumber 2 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-subscription a arcus:WirePin ;
    arcus:message "PullRequest" ; arcus:fieldName "FieldSubscription" ; arcus:fieldNumber 1 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-max-messages a arcus:WirePin ;
    arcus:message "PullRequest" ; arcus:fieldName "FieldMaxMessages" ; arcus:fieldNumber 2 ; arcus:wireType 0 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-return-imm a arcus:WirePin ;
    arcus:message "PullRequest" ; arcus:fieldName "FieldReturnImm" ; arcus:fieldNumber 3 ; arcus:wireType 0 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-received a arcus:WirePin ;
    arcus:message "PullResponse" ; arcus:fieldName "FieldReceived" ; arcus:fieldNumber 1 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-ack-id a arcus:WirePin ;
    arcus:message "ReceivedMessage" ; arcus:fieldName "FieldAckID" ; arcus:fieldNumber 1 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-message a arcus:WirePin ;
    arcus:message "ReceivedMessage" ; arcus:fieldName "FieldMessage" ; arcus:fieldNumber 2 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-ack-ids a arcus:WirePin ;
    arcus:message "AcknowledgeRequest" ; arcus:fieldName "FieldAckIDs" ; arcus:fieldNumber 2 ; arcus:wireType 2 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-ack-deadline a arcus:WirePin ;
    arcus:message "ModifyAckDeadlineRequest" ; arcus:fieldName "FieldAckDeadline" ; arcus:fieldNumber 3 ; arcus:wireType 0 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-seconds a arcus:WirePin ;
    arcus:message "Timestamp" ; arcus:fieldName "FieldSeconds" ; arcus:fieldNumber 1 ; arcus:wireType 0 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

arcus:pin-nanos a arcus:WirePin ;
    arcus:message "Timestamp" ; arcus:fieldName "FieldNanos" ; arcus:fieldNumber 2 ; arcus:wireType 0 ;
    prov:wasDerivedFrom arcus:src-smalt-pubsub-wire .

# -- signing laws (Go binding: signing.go; probes L1-L5) -----------------

arcus:law-L1 a arcus:SigningLaw ;
    arcus:lawId "L1" ;
    arcus:lawStatement "x-goog-date / x-goog-date-time use the exact %Y%m%d / %Y%m%dT%H%M%SZ UTC forms; credential scope is <date>/<region>/storage/goog4_request" ;
    prov:wasDerivedFrom arcus:src-ts-gcp-probes .

arcus:law-L2 a arcus:SigningLaw ;
    arcus:lawId "L2" ;
    arcus:lawStatement "canonical querystring: parameters sorted by name then value; names+values RFC3986-percent-encoded; encoding-type excluded from canonical query" ;
    prov:wasDerivedFrom arcus:src-ts-gcp-probes .

arcus:law-L3 a arcus:SigningLaw ;
    arcus:lawId "L3" ;
    arcus:lawStatement "canonical request = METHOD/CANONICAL_URI/CANONICAL_QUERY/CANONICAL_HEADERS/HEADER_LIST/UNSIGNED-PAYLOAD; canonical URI is the RFC3986-encoded object path with / separators and ~ preserved, drops the query" ;
    prov:wasDerivedFrom arcus:src-ts-gcp-probes .

arcus:law-L4 a arcus:SigningLaw ;
    arcus:lawId "L4" ;
    arcus:lawStatement "string-to-sign = GOOG4-RSA-SHA256 newline date-time newline scope newline sha256(canonical request)" ;
    prov:wasDerivedFrom arcus:src-ts-gcp-probes .

arcus:law-L5 a arcus:SigningLaw ;
    arcus:lawId "L5" ;
    arcus:lawStatement "signature = RSA-SHA256(string-to-sign, service-account key), lowercase hex (X-Goog-Signature)" ;
    prov:wasDerivedFrom arcus:src-ts-gcp-probes .

# -- envelope laws (Go binding: errors.go + lro.go; probes E1-E4) --------

arcus:law-E1 a arcus:EnvelopeLaw ;
    arcus:lawId "E1" ;
    arcus:lawStatement "error envelope is top-level {error:{code,message,status[,details]}}; code is the HTTP status int, status the canonical string" ;
    prov:wasDerivedFrom arcus:src-ts-gcp-probes .

arcus:law-E2 a arcus:EnvelopeLaw ;
    arcus:lawId "E2" ;
    arcus:lawStatement "retryable by code OR status: 429/500/502/503/504 and UNAVAILABLE/DEADLINE_EXCEEDED retryable; 400/401/403/404/409/412/422 terminal" ;
    prov:wasDerivedFrom arcus:src-ts-gcp-probes .

arcus:law-E3 a arcus:EnvelopeLaw ;
    arcus:lawId "E3" ;
    arcus:lawStatement "google.rpc.RetryInfo retryDelay (Ns proto duration) forces backoff = retryDelay, overriding the default 1*2^attempt cap-32s table" ;
    prov:wasDerivedFrom arcus:src-ts-gcp-probes .

arcus:law-E4 a arcus:EnvelopeLaw ;
    arcus:lawId "E4" ;
    arcus:lawStatement "LRO {name,done,metadata?,response?}: response XOR error on done:true; op error carries the gRPC code int" ;
    prov:wasDerivedFrom arcus:src-ts-gcp-probes .

# -- enforced-but-unpinned wire laws (L100 registration) ----------------
# Each row is an enforced GCP-dialect constant OUTSIDE the wire-pin lattice:
# the Go const in internal/dialect/gcp/errors.go enforces the wire law on
# hot paths; this pin is the sync-visible registration whose drift the
# pinned-constants court catches
# (internal/dialect/gcp/pinned_constants_drift_test.go). Non-date pins
# (counts, status strings) reuse arcus:version as the pinned literal value.
arcus:pin-backoff-cap a arcus:DialectPin ;
        arcus:symbol "BackoffCapSeconds" ; arcus:version "32" ; prov:wasDerivedFrom arcus:src-gcp-dialect-go-consts .

arcus:pin-http-status-429 a arcus:DialectPin ;
    arcus:symbol "HTTPStatusTooManyRequests" ; arcus:version "429" ; prov:wasDerivedFrom arcus:src-gcp-dialect-go-consts .

arcus:pin-http-status-500 a arcus:DialectPin ;
    arcus:symbol "HTTPStatusInternalServerError" ; arcus:version "500" ; prov:wasDerivedFrom arcus:src-gcp-dialect-go-consts .

arcus:pin-http-status-502 a arcus:DialectPin ;
    arcus:symbol "HTTPStatusBadGateway" ; arcus:version "502" ; prov:wasDerivedFrom arcus:src-gcp-dialect-go-consts .

arcus:pin-http-status-503 a arcus:DialectPin ;
    arcus:symbol "HTTPStatusServiceUnavailable" ; arcus:version "503" ; prov:wasDerivedFrom arcus:src-gcp-dialect-go-consts .

arcus:pin-http-status-504 a arcus:DialectPin ;
    arcus:symbol "HTTPStatusGatewayTimeout" ; arcus:version "504" ; prov:wasDerivedFrom arcus:src-gcp-dialect-go-consts .

arcus:pin-status-unavailable a arcus:DialectPin ;
    arcus:symbol "StatusUnavailable" ; arcus:version "UNAVAILABLE" ; prov:wasDerivedFrom arcus:src-gcp-dialect-go-consts .

arcus:pin-status-deadline-exceeded a arcus:DialectPin ;
    arcus:symbol "StatusDeadlineExceeded" ; arcus:version "DEADLINE_EXCEEDED" ; prov:wasDerivedFrom arcus:src-gcp-dialect-go-consts .

# end ontology.ttl
