@prefix gco: <https://ggen.dev/ontology/github-controloutcome#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gco:GitHubRunObservation a prov:Entity .
gco:GitHubJobObservation a prov:Entity .
gco:GitHubPullRequestObservation a prov:Entity .
gco:ObservationBundle a prov:Collection .
gco:ControlOutcomeProjection a prov:Entity .
gco:EvidenceRoot a prov:Entity .
gco:ConfidenceVariant a prov:Entity .
gco:CalibrationFrontier a dqv:QualityMeasurement .
gco:GitHubControlOpportunity a prov:Entity .
gco:RepairRealization a prov:Activity .
gco:CurrentRiskFrontier a dqv:QualityMeasurement .

gco:DiscoveryMultiplierMetric a dqv:Metric ; dcterms:title "Live actionable discovery multiplier" .
gco:IndependentRootMetric a dqv:Metric ; dcterms:title "Independent GitHub evidence roots" .
gco:WilsonLowerMetric a dqv:Metric ; dcterms:title "Wilson lower confidence bound" .
gco:LaplacePosteriorMetric a dqv:Metric ; dcterms:title "Laplace-smoothed success posterior" .
gco:RunFailureRateMetric a dqv:Metric ; dcterms:title "Current exact-head workflow failure rate" .
gco:JobLatencyMetric a dqv:Metric ; dcterms:title "Observed GitHub job latency" .
gco:ReceiptCoverageMetric a dqv:Metric ; dcterms:title "Current GitHub evidence receipt coverage" .
gco:FailureRootFanoutMetric a dqv:Metric ; dcterms:title "Repeated failure-root affected-run fanout" .
gco:RepairRealizationMetric a dqv:Metric ; dcterms:title "Observed failed-to-successful run-attempt realization" .
gco:EvidenceRootDiversityMetric a dqv:Metric ; dcterms:title "Current distinct GitHub evidence-root diversity" .

gco:observer gco:authority "OBSERVE|VERIFY|CONSTRUCT" ; gco:actuationPerformed false ; gco:requiresExactSubject true ; gco:requiresCurrentEvidence true ; gco:requiresReceipt true ; gco:requiresObservedOutcomes true ; gco:preservesFailedEdges true .

