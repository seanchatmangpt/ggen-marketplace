gco:job1 a gco:GitHubJobObservation ; gco:run gco:run1 ; gco:jobId 2001 ; gco:name "marketplace-validate" ; gco:conclusion "success" ; gco:durationMs 42000 ; gco:evidenceRoot "run:1001/attempt:1/job:2001" ; gco:current true ; gco:receiptDigest "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ; gco:authority "OBSERVE|VERIFY" ; gco:actuationPerformed false .
gco:job2 a gco:GitHubJobObservation ; gco:run gco:run1 ; gco:jobId 2002 ; gco:name "permanent-courts" ; gco:conclusion "success" ; gco:durationMs 18000 ; gco:evidenceRoot "run:1001/attempt:1/job:2002" ; gco:current true ; gco:receiptDigest "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" ; gco:authority "OBSERVE|VERIFY" ; gco:actuationPerformed false .
gco:pr1 a gco:GitHubPullRequestObservation ; gco:repository "seanchatmangpt/ggen-marketplace" ; gco:pullRequest 999 ; gco:headSha "1111111111111111111111111111111111111111" ; gco:baseSha "0000000000000000000000000000000000000000" ; gco:mergeable true ; gco:current true ; gco:receiptDigest "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" ; gco:authority "OBSERVE|VERIFY" ; gco:actuationPerformed false .
gco:bundle1 a gco:ObservationBundle ; prov:hadMember gco:run1, gco:job1, gco:job2, gco:pr1 ; gco:exactSubject "seanchatmangpt/ggen-marketplace@1111111111111111111111111111111111111111" ; gco:seedObservations 1 ; gco:actionableOpportunities 3 ; gco:current true ; gco:authority "OBSERVE|VERIFY" ; gco:actuationPerformed false .
