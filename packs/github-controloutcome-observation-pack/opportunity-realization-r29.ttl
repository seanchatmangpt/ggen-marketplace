@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix r29: <https://chatman.ai/github-controloutcome/r29/> .

r29:GitHubOpportunityRealization a prov:Activity ;
  dcterms:title "GitHub opportunity realization adapter R29" ;
  dcterms:description "Transforms exact PR/run/job/merge observations into candidate opportunity-realization evidence without granting actuation authority." .
r29:MergeEvidence a prov:Entity ; skos:prefLabel "exact GitHub merge evidence" .
r29:QualificationEvidence a prov:Entity ; skos:prefLabel "exact-head qualification evidence" .
r29:OpportunityCandidate a prov:Entity ; skos:prefLabel "ledger opportunity candidate" .
r29:RealizationConfidence a dqv:Metric ; skos:prefLabel "confidence that exact GitHub evidence realizes a ledger opportunity" .
r29:ContainmentConfidence a dqv:Metric ; skos:prefLabel "confidence that qualified capability is contained on current default" .
r29:RealizationLatency a dqv:Metric ; skos:prefLabel "elapsed time from opportunity observation to merge containment" .
r29:AmbiguityPressure a dqv:Metric ; skos:prefLabel "multiple candidate opportunities matching one capability" .
