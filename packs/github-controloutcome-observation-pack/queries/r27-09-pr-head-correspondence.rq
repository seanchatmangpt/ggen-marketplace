PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?pr ?repository ?head WHERE { ?pr a gco:GitHubPullRequestObservation ; gco:repository ?repository ; gco:headSha ?head ; gco:current true . FILTER NOT EXISTS { ?run a gco:GitHubRunObservation ; gco:headSha ?head ; gco:repository ?repository . } } ORDER BY ?repository ?head ?pr
