PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?workflow ?head ?older ?newer WHERE { ?older a gco:GitHubRunObservation ; gco:workflow ?workflow ; gco:headSha ?head ; gco:runAttempt ?a . ?newer a gco:GitHubRunObservation ; gco:workflow ?workflow ; gco:headSha ?head ; gco:runAttempt ?b . FILTER(?b > ?a) } ORDER BY ?workflow ?head ?older ?newer
