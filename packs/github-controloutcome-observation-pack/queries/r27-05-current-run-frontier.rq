PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?run ?workflow ?head ?attempt ?conclusion WHERE { ?run a gco:GitHubRunObservation ; gco:workflow ?workflow ; gco:headSha ?head ; gco:runAttempt ?attempt ; gco:conclusion ?conclusion ; gco:current true . } ORDER BY ?workflow ?head DESC(?attempt)
