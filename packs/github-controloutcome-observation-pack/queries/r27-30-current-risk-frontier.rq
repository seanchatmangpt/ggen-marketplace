PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?e ?risk WHERE { { ?e a gco:GitHubRunObservation ; gco:current true ; gco:conclusion "failure" . BIND("RUN_FAILURE" AS ?risk) } UNION { ?e a gco:GitHubJobObservation ; gco:current true ; gco:conclusion "failure" . BIND("JOB_FAILURE" AS ?risk) } UNION { ?e a gco:GitHubPullRequestObservation ; gco:current true ; gco:mergeable false . BIND("PR_NON_MERGEABLE" AS ?risk) } UNION { ?e gco:current true ; gco:actuationPerformed true . BIND("AUTHORITY_VIOLATION" AS ?risk) } } ORDER BY ?risk ?e
