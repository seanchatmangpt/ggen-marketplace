PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?bundle ?subject ?seed ?opportunities (IF(?seed = 0, 0, ?opportunities / ?seed) AS ?multiplier) WHERE {
  ?bundle a gco:ObservationBundle ; gco:exactSubject ?subject ; gco:seedObservations ?seed ; gco:actionableOpportunities ?opportunities ; gco:current true .
}
ORDER BY DESC(?multiplier) ?subject ?bundle
