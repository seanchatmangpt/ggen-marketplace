PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?e WHERE { ?e gco:current true . FILTER NOT EXISTS { ?e gco:receiptDigest ?digest . } FILTER EXISTS { { ?e a gco:GitHubRunObservation } UNION { ?e a gco:GitHubJobObservation } UNION { ?e a gco:GitHubPullRequestObservation } } } ORDER BY ?e
