PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?opportunity WHERE {
  ?opportunity a prov:Entity ; dcterms:type "actionable-opportunity" ; dcterms:status "OPEN" .
  FILTER NOT EXISTS { ?realization dcterms:type "opportunity-realization" ; prov:used ?opportunity ; prov:generated ?capability }
}
ORDER BY ?opportunity
