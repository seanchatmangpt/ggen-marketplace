PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?opportunity ?capability ?merge WHERE {
  ?opportunity a prov:Entity ; dcterms:type "actionable-opportunity" .
  ?realization a prov:Activity ; dcterms:type "opportunity-realization" ; prov:used ?opportunity ; prov:generated ?capability ; dcterms:status "CURRENT" .
  ?merge a prov:Activity ; dcterms:type "merge-containment" ; prov:used ?capability ; dcterms:status "CONTAINED" .
  FILTER NOT EXISTS { ?run dcterms:type "workflow-run" ; dcterms:status "FAILURE" ; prov:used ?capability }
}
ORDER BY ?opportunity ?capability
