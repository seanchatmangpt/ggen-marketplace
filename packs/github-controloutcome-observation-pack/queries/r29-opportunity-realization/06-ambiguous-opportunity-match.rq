PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?capability (COUNT(DISTINCT ?opportunity) AS ?matches) WHERE {
  ?opportunity a prov:Entity ; dcterms:type "actionable-opportunity" ; dcterms:identifier ?signature .
  ?capability a prov:Entity ; dcterms:type "qualified-capability" ; dcterms:subject ?signature .
}
GROUP BY ?capability
HAVING(COUNT(DISTINCT ?opportunity) > 1)
ORDER BY DESC(?matches) ?capability
