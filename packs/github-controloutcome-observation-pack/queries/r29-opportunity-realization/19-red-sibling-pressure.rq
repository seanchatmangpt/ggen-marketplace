PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?capability (COUNT(?run) AS ?redSiblings) WHERE {
  ?run a prov:Activity ; dcterms:type "workflow-run" ; dcterms:status "FAILURE" ; prov:used ?capability .
  FILTER EXISTS { ?ok dcterms:type "workflow-run" ; dcterms:status "SUCCESS" ; prov:used ?capability }
}
GROUP BY ?capability
ORDER BY DESC(?redSiblings) ?capability
