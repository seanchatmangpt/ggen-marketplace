PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?bundle ?opportunities ?seeds ((1.0 * ?opportunities) / ?seeds AS ?E) WHERE {
  ?bundle a gco:ObservationBundle ; gco:actionableOpportunities ?opportunities ; gco:seedObservations ?seeds ; gco:current true .
  FILTER(?seeds > 0)
} ORDER BY DESC(?E) ?bundle
