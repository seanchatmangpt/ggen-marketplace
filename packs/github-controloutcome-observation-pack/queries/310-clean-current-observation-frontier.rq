PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?bundle ?subject WHERE {
  ?bundle a gco:ObservationBundle ; gco:exactSubject ?subject ; gco:current true ; gco:actuationPerformed false .
  FILTER(EXISTS { ?bundle gco:seedObservations ?seed } && EXISTS { ?bundle gco:actionableOpportunities ?opportunities })
  FILTER NOT EXISTS { ?entity gco:current true ; gco:actuationPerformed true }
}
ORDER BY ?subject ?bundle
