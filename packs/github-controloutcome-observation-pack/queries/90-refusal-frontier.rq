PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?observation ?reason WHERE {
  ?observation ?p ?o .
  { ?observation gco:current false . BIND("STALE_EVIDENCE" AS ?reason) }
  UNION { ?observation gco:actuationPerformed true . BIND("UNRECEIPTED_ACTUATION_RISK" AS ?reason) }
  UNION { FILTER NOT EXISTS { ?observation gco:receiptDigest ?digest } BIND("MISSING_RECEIPT" AS ?reason) }
} ORDER BY ?reason ?observation
