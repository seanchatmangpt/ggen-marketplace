PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?entity WHERE {
  ?entity gco:current true .
  FILTER((EXISTS { ?entity a gco:GitHubRunObservation } || EXISTS { ?entity a gco:GitHubJobObservation } || EXISTS { ?entity a gco:GitHubPullRequestObservation }) && NOT EXISTS { ?entity gco:receiptDigest ?digest })
}
ORDER BY ?entity
