PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?name (COUNT(DISTINCT ?run) AS ?affectedRuns) WHERE { ?job a gco:GitHubJobObservation ; gco:run ?run ; gco:name ?name ; gco:conclusion "failure" . } GROUP BY ?name HAVING(COUNT(DISTINCT ?run) > 1) ORDER BY DESC(?affectedRuns) ?name
