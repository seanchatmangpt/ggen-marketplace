PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?workflow ?head ?failedAttempt ?repairedAttempt WHERE { ?failed a gco:GitHubRunObservation ; gco:workflow ?workflow ; gco:headSha ?head ; gco:runAttempt ?failedAttempt ; gco:conclusion "failure" . ?repaired a gco:GitHubRunObservation ; gco:workflow ?workflow ; gco:headSha ?head ; gco:runAttempt ?repairedAttempt ; gco:conclusion "success" . FILTER(?repairedAttempt > ?failedAttempt) } ORDER BY ?workflow ?head ?failedAttempt ?repairedAttempt
