PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?bundle ?subject ?pr ?run WHERE {
  ?bundle a gco:ObservationBundle ; gco:exactSubject ?subject ; gco:current true .
  ?pr a gco:GitHubPullRequestObservation ; gco:headSha ?sha ; gco:current true .
  ?run a gco:GitHubRunObservation ; gco:headSha ?sha ; gco:current true .
  FILTER(STRENDS(?subject, CONCAT("@", ?sha)))
} ORDER BY ?subject ?pr ?run
