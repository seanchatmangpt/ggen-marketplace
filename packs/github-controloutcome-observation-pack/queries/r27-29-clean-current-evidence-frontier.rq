PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?e ?receipt WHERE { ?e gco:current true ; gco:receiptDigest ?receipt ; gco:authority "OBSERVE|VERIFY" ; gco:actuationPerformed false . FILTER EXISTS { { ?e a gco:GitHubRunObservation } UNION { ?e a gco:GitHubJobObservation } UNION { ?e a gco:GitHubPullRequestObservation } } } ORDER BY ?e
