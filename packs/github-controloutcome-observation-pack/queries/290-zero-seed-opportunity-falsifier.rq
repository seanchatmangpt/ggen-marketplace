PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?bundle ?subject ?opportunities WHERE {
  ?bundle a gco:ObservationBundle ; gco:exactSubject ?subject ; gco:seedObservations 0 ; gco:actionableOpportunities ?opportunities ; gco:current true .
  FILTER(?opportunities > 0)
}
ORDER BY DESC(?opportunities) ?subject ?bundle
