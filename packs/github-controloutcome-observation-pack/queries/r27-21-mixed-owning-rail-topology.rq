PREFIX gco: <https://ggen.dev/ontology/github-controloutcome#>
SELECT ?head (COUNT(?green) AS ?successJobs) (COUNT(?red) AS ?failedJobs) WHERE { ?run a gco:GitHubRunObservation ; gco:headSha ?head . OPTIONAL { ?green a gco:GitHubJobObservation ; gco:run ?run ; gco:conclusion "success" . } OPTIONAL { ?red a gco:GitHubJobObservation ; gco:run ?run ; gco:conclusion "failure" . } } GROUP BY ?head HAVING(COUNT(?green) > 0 && COUNT(?red) > 0) ORDER BY ?head
