import json, pathlib, sys
p = pathlib.Path('controloutcome-observation.jsonl')
rows = [json.loads(x) for x in p.read_text().splitlines() if x.strip()]
ok = bool(rows) and all(r.get('authority') in ('OBSERVE','VERIFY','OBSERVE|VERIFY') and r.get('actuation_performed') is False for r in rows)
raise SystemExit(0 if ok else 1)
