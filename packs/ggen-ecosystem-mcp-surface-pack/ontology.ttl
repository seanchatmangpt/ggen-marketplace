@prefix dct: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# DERIVED by scripts/derive_ggen.py from the real installed ggen CLI's own
# `ggen graph --introspect` JSON Schema array (ggen 26.8.28). Operation names,
# parameter names and JSON types are read from that live output, not invented.

<urn:ggen-ecosystem:mcp:server>
    a <urn:gymmcp:McpServer> ;
    dct:identifier "ggen" ;
    dct:title "ggen-ecosystem" ;
    dct:hasVersion "26.8.28" ;
    prov:wasDerivedFrom <urn:ggen:cli:introspect> .

<urn:ggen-ecosystem:mcp:op:agent-capabilities>
    a sosa:Procedure ;
    dct:title "agent-capabilities" ;
    dct:description "Describe the agent's operations and capability surfaces — the discovery entry" ;
    dct:type <urn:gymact:consequence:read> ;
    <urn:gymmcp:replaySafe> true .

<urn:ggen-ecosystem:mcp:op:agent-compatibility>
    a sosa:Procedure ;
    dct:title "agent-compatibility" ;
    dct:description "Check whether a comma-separated set of packs composes without conflicts" ;
    dct:type <urn:gymact:consequence:read> ;
    <urn:gymmcp:replaySafe> true ;
    <urn:gymmcp:hasParameter> <urn:ggen-ecosystem:mcp:op:agent-compatibility:param:packs> .

<urn:ggen-ecosystem:mcp:op:agent-compatibility:param:packs>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "packs" ;
    dct:type "string" ;
    <urn:gymmcp:required> true .

<urn:ggen-ecosystem:mcp:op:agent-install>
    a sosa:Procedure ;
    dct:title "agent-install" ;
    dct:description "Install a pack: write the lockfile with a non-empty digest and emit a signed" ;
    dct:type <urn:gymact:consequence:do> ;
    <urn:gymmcp:requiresAdmission> true ;
    <urn:gymmcp:hasParameter> <urn:ggen-ecosystem:mcp:op:agent-install:param:dry_run> ;
    <urn:gymmcp:hasParameter> <urn:ggen-ecosystem:mcp:op:agent-install:param:force> ;
    <urn:gymmcp:hasParameter> <urn:ggen-ecosystem:mcp:op:agent-install:param:pack_id> .

<urn:ggen-ecosystem:mcp:op:agent-install:param:dry_run>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "dry_run" ;
    dct:type "string" ;
    <urn:gymmcp:required> false .

<urn:ggen-ecosystem:mcp:op:agent-install:param:force>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "force" ;
    dct:type "string" ;
    <urn:gymmcp:required> false .

<urn:ggen-ecosystem:mcp:op:agent-install:param:pack_id>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "pack_id" ;
    dct:type "string" ;
    <urn:gymmcp:required> true .

<urn:ggen-ecosystem:mcp:op:agent-list>
    a sosa:Procedure ;
    dct:title "agent-list" ;
    dct:description "List all packs in the local registry, optionally filtered by category." ;
    dct:type <urn:gymact:consequence:read> ;
    <urn:gymmcp:replaySafe> true ;
    <urn:gymmcp:hasParameter> <urn:ggen-ecosystem:mcp:op:agent-list:param:category> .

<urn:ggen-ecosystem:mcp:op:agent-list:param:category>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "category" ;
    dct:type "string" ;
    <urn:gymmcp:required> false .

<urn:ggen-ecosystem:mcp:op:agent-remove>
    a sosa:Procedure ;
    dct:title "agent-remove" ;
    dct:description "Remove a pack from the project lockfile. Fail-closed: a missing lockfile or" ;
    dct:type <urn:gymact:consequence:do> ;
    <urn:gymmcp:requiresAdmission> true ;
    <urn:gymmcp:hasParameter> <urn:ggen-ecosystem:mcp:op:agent-remove:param:pack_id> .

<urn:ggen-ecosystem:mcp:op:agent-remove:param:pack_id>
