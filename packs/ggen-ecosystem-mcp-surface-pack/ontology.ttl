<urn:ggen-ecosystem:mcp:op:law-derive>
    a sosa:Procedure ;
    dct:title "law-derive" ;
    dct:description "Materialize [law].rules to fixpoint and report the derived-triple count plus the post-materialization graph hash." ;
    dct:type <urn:gymact:consequence:do> ;
    <urn:gymmcp:requiresAdmission> true .

<urn:ggen-ecosystem:mcp:op:law-explain>
    a sosa:Procedure ;
    dct:title "law-explain" ;
    dct:description "Materialize and report which facts the rules derived: rules-loaded count and the full derived-triple diff (canonical N-Triples lines)." ;
    dct:type <urn:gymact:consequence:read> ;
    <urn:gymmcp:replaySafe> true .

<urn:ggen-ecosystem:mcp:op:law-export>
    a sosa:Procedure ;
    dct:title "law-export" ;
    dct:description "Dump the fully materialized graph as canonical N-Triples (post-rule fixpoint), with its BLAKE3 state hash." ;
    dct:type <urn:gymact:consequence:do> ;
    <urn:gymmcp:requiresAdmission> true .

<urn:ggen-ecosystem:mcp:op:law-load>
    a sosa:Procedure ;
    dct:title "law-load" ;
    dct:description "Load every [law].rules file into the `GraphLaw` engine and report the rule count per file (refuses on the first unparseable rule document)." ;
    dct:type <urn:gymact:consequence:do> ;
    <urn:gymmcp:requiresAdmission> true .

<urn:ggen-ecosystem:mcp:op:law-validate>
    a sosa:Procedure ;
    dct:title "law-validate" ;
    dct:description "Materialize rules, then run every [law].shapes SHACL gate and the denial check; any violation is a typed FM-LAW refusal (non-zero exit)." ;
    dct:type <urn:gymact:consequence:read> ;
    <urn:gymmcp:replaySafe> true .

<urn:ggen-ecosystem:mcp:op:maximalism>
    a sosa:Procedure ;
    dct:title "maximalism" ;
    dct:description "Vision 2030 combinatorial capability closure, semantic product-space measurement, lawful outcomes, receipts, and replay." ;
