    dct:type "string" ;
    <urn:gymmcp:required> true .

<urn:ggen-ecosystem:mcp:op:agent-resolve>
    a sosa:Procedure ;
    dct:title "agent-resolve" ;
    dct:description "Resolve a capability surface (e.g. `mcp`, `web`) to concrete pack IDs," ;
    dct:type <urn:gymact:consequence:do> ;
    <urn:gymmcp:requiresAdmission> true ;
    <urn:gymmcp:hasParameter> <urn:ggen-ecosystem:mcp:op:agent-resolve:param:projection> ;
