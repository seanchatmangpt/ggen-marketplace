<urn:ggen-ecosystem:mcp:op:agent-resolve:param:surface>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "surface" ;
    dct:type "string" ;
    <urn:gymmcp:required> true .

<urn:ggen-ecosystem:mcp:op:agent-search>
    a sosa:Procedure ;
    dct:title "agent-search" ;
    dct:description "Relevance-rank packs in the local registry by a text query." ;
    dct:type <urn:gymact:consequence:read> ;
    <urn:gymmcp:replaySafe> true ;
    <urn:gymmcp:hasParameter> <urn:ggen-ecosystem:mcp:op:agent-search:param:limit> ;
    <urn:gymmcp:hasParameter> <urn:ggen-ecosystem:mcp:op:agent-search:param:query> .

