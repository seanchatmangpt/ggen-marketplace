<urn:ggen-ecosystem:mcp:op:agent-search:param:query>
    a <urn:gymmcp:Parameter> ;
    dct:identifier "query" ;
    dct:type "string" ;
    <urn:gymmcp:required> true .

<urn:ggen-ecosystem:mcp:op:agent-show>
