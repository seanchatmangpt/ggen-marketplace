# MESSAGE: unsafe item without a safetyProof.
# Every item with rust:isUnsafe true must carry a non-empty rust:safetyProof
# (documented justification of why the unsafe scope is sound). A row = refusal.
# Anti-vacuity: set isUnsafe true on any item without adding safetyProof —
# the gate must fire (see witnesses/fail).
PREFIX rust: <urn:ggen:rust:#>
SELECT ?item ?problem WHERE {
  ?item rust:isUnsafe true .
  OPTIONAL { ?item rust:safetyProof ?proof }
  FILTER(!BOUND(?proof) || STR(?proof) = "")
  BIND(IF(BOUND(?proof), "safetyProof-empty",
                         "safetyProof-missing") AS ?problem)
}
ORDER BY ?item
