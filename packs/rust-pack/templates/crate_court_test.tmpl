---
to: "crates/{{ row.crateName }}/tests/{{ row.crateName }}_court.rs"
force: true
for_each: results
sparql:
  results: |
    PREFIX rust: <urn:ggen:rust:#>
    PREFIX p: <https://seanchatmangpt.github.io/packs/rust-pack#>
    SELECT ?crateName ?subjects
           (GROUP_CONCAT(DISTINCT COALESCE(?fnName, ""); separator=" ") AS ?unsafeFns)
           (COUNT(DISTINCT ?item) AS ?itemCount)
    WHERE {
      ?c a rust:Crate ;
         rust:crateName ?crateName .
      OPTIONAL {
        ?c rust:defines ?f .
        ?f a rust:Function ;
           rust:isUnsafe true ;
           rust:itemName ?fnName .
      }
      OPTIONAL { ?c rust:defines ?item . }
      {
        SELECT (COUNT(?s) AS ?subjects) WHERE { ?s a p:Subject }
      }
    } GROUP BY ?crateName ?subjects ORDER BY ?crateName
---
//! GENERATED by ggen from the admitted rust-pack ontology.ttl. Do not edit.
//! Regenerate via `ggen sync run`.
//!
//! Crate court test for "{{ row.crateName }}" — praxis-core two-proof
//! pattern: one hand-transcribed literal assertion, one SPARQL-derived
//! assertion. The ontology is anchored via include_str! so the test fails
//! to compile if the ontology drifts out of the repository.

/// Proof 1 (literal): the ontology source ships with the crate and carries
/// the pack vocabulary root.
const ONTOLOGY: &str = include_str!("../../../ontology.ttl");

#[test]
fn court_ontology_is_admitted_source() {
    assert!(
        ONTOLOGY.contains("urn:ggen:rust:#"),
        "ontology.ttl must carry the rust: vocabulary root"
    );
}
{%- if row.itemCount > 0 %}

/// Proof 2 (SPARQL-derived): item count projected from the graph must be
/// positive — an empty graph is not an admitted subject.
#[test]
fn court_graph_has_modeled_items() {
    let items: usize = {{ row.itemCount }};
    assert!(
        items > 0,
        "crate has no modeled items; regenerate from graph"
    );
}
{%- endif %}

/// Pack provenance: {{ row.subjects }} admitted p:Subject individuals.
#[test]
fn court_subject_count() {
    let subjects: usize = {{ row.subjects }};
    assert!(subjects > 0);
}

{%- for fn in row.unsafeFns | split(pat=" ") %}
{%- if fn != "" %}

/// Court witness: `{{ fn }}` is modeled unsafe and must carry its Safety
/// documentation at the definition site (gate 020 mutation target).
#[test]
fn court_unsafe_fn_{{ fn }}_is_pinned() {
    // Compile-time pin: removing or de-unsafing `{{ fn }}` in the graph
    // changes the projected shell and breaks this test at compile time.
    let pin: unsafe fn() = {{ row.crateName | replace(from='-', to='_') }}::{{ fn }};
    assert!(std::hint::black_box(pin as *const ()) as usize != 0);
}
{%- endif %}
{%- endfor %}
