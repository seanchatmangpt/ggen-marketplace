---
to: "crates/{{ row.crateName }}/src/lib.rs"
force: true
for_each: results
sparql:
  results: |
    PREFIX rust: <urn:ggen:rust:#>
    SELECT DISTINCT ?crateName ?crateType ?isNoStd ?hasAlloc WHERE {
      ?c a rust:Crate ;
         rust:crateName ?crateName ;
         rust:crateType ?crateType ;
         rust:isNoStd ?isNoStd ;
         rust:hasAlloc ?hasAlloc .
    } ORDER BY ?crateName
  modules: |
    PREFIX rust: <urn:ggen:rust:#>
    SELECT DISTINCT ?crateName ?moduleName WHERE {
      ?c rust:defines ?m .
      ?m a rust:Module ; rust:itemName ?moduleName .
      ?c rust:crateName ?crateName .
    } ORDER BY ?crateName ?moduleName
  items: |
    PREFIX rust: <urn:ggen:rust:#>
    SELECT DISTINCT ?crateName ?itemName ?kind ?visibility ?unsafeStr ?proofStr ?reprStr WHERE {
      {
        SELECT ?c ?itemName ?kind ?visibility ?unsafeStr ?proofStr ?reprStr WHERE {
          ?c rust:defines ?item .
          {
            ?item a rust:Struct . BIND("struct" AS ?kind)
          } UNION {
            ?item a rust:Enum . BIND("enum" AS ?kind)
          } UNION {
            ?item a rust:Function . BIND("fn" AS ?kind)
          }
          ?item rust:itemName ?itemName .
          OPTIONAL { ?item rust:visibility ?vis }
          OPTIONAL { ?item rust:isUnsafe ?u }
          OPTIONAL { ?item rust:safetyProof ?p }
          OPTIONAL { ?item rust:repr ?r }
          BIND(COALESCE(STR(?vis), "pub") AS ?visibility)
          BIND(COALESCE(STR(?u), "false") AS ?unsafeStr)
          BIND(COALESCE(REPLACE(STR(?p), ":", " -"), "") AS ?proofStr)
          BIND(COALESCE(STR(?r), "") AS ?reprStr)
        }
      }
      ?c rust:crateName ?crateName .
    } ORDER BY ?crateName ?itemName
---
