---
to: "Cargo.toml"
force: true
sparql:
  row: |
    PREFIX rust: <urn:ggen:rust:#>
    SELECT ?resolverVersion
           (GROUP_CONCAT(DISTINCT ?member; separator=", ") AS ?members)
    WHERE {
      ?ws a rust:Workspace ;
          rust:resolverVersion ?resolverVersion ;
          rust:memberCrate ?c .
      ?c rust:crateName ?name .
      BIND(CONCAT('"crates/', STR(?name), '"') AS ?member)
    } GROUP BY ?resolverVersion
  deps: |
    PREFIX rust: <urn:ggen:rust:#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT DISTINCT ?depName ?versionLiteral ?inherit WHERE {
      ?ws a rust:Workspace ;
          rust:workspaceDependency ?d .
      ?d a rust:Dependency ;
         rdfs:label ?label .
      OPTIONAL { ?d rust:versionLiteral ?v }
      BIND(IF(BOUND(?v), "version", "workspace") AS ?inherit)
      BIND(COALESCE(STR(?v), "") AS ?versionLiteral)
      BIND(REPLACE(STR(?label), " \\(.*\\)$", "") AS ?depName)
    } ORDER BY ?depName
---

# GENERATED by ggen from the admitted rust-pack ontology.ttl. Do not edit.
# Regenerate via `ggen sync run`.
#
# Workspace root manifest. Resolver "2" pinned per PRD.md:47 (the resolver
# does not follow edition); dependencies declared once at the workspace level
# and inherited by member crates per PRD.md:58-60.

[workspace]
resolver = "{{ row[0].resolverVersion }}"
members = [{{ row[0].members }}]

[workspace.dependencies]
{% for dep in deps -%}
{% if dep.inherit == "version" %}
{{ dep.depName }} = "{{ dep.versionLiteral }}"
{% else %}
# MISSING rust:versionLiteral for {{ dep.depName }} (gate 050 violation
# class). Placeholder "0" keeps the workspace compilable; fix the graph.
{{ dep.depName }} = "0"
{% endif %}
{% endfor %}
