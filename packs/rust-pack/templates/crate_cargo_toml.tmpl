---
to: "crates/{{ row.crateName }}/Cargo.toml"
force: true
for_each: results
sparql:
  results: |
    PREFIX rust: <urn:ggen:rust:#>
    SELECT DISTINCT ?crateName ?edition ?msrv ?crateType ?isNoStd ?hasAlloc WHERE {
      ?c a rust:Crate ;
         rust:crateName ?crateName ;
         rust:crateType ?crateType ;
         rust:isNoStd ?isNoStd ;
         rust:hasAlloc ?hasAlloc ;
         rust:edition ?edition ;
         rust:msrv ?msrv .
    } ORDER BY ?crateName
  inherited: |
    PREFIX rust: <urn:ggen:rust:#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT DISTINCT ?crateName ?depName ?versionLiteral ?inherit WHERE {
      ?c a rust:Crate ;
         rust:crateName ?crateName ;
         rust:dependsOn ?d .
      ?d a rust:Dependency ;
         rdfs:label ?label .
      OPTIONAL { ?d rust:versionLiteral ?v }
      BIND(IF(BOUND(?v) && NOT EXISTS {
        ?ws a rust:Workspace ; rust:workspaceDependency ?d
      }, "version", "workspace") AS ?inherit)
      BIND(IF(BOUND(?v), STR(?v), "") AS ?versionLiteral)
      BIND(REPLACE(STR(?label), " \\(.*\\)$", "") AS ?depName)
    } ORDER BY ?crateName ?depName
---

# GENERATED by ggen from the admitted rust-pack ontology.ttl. Do not edit.
# Regenerate via `ggen sync run`.

[package]
name = "{{ row.crateName }}"
version = "0.1.0"
edition = "{{ row.edition }}"
rust-version = "{{ row.msrv }}"

{% if row.crateType == "lib" %}
[lib]
{% elif row.crateType == "proc-macro" %}
[lib]
proc-macro = true
{% endif %}

[dependencies]
{% for dep in inherited -%}
{% if dep.crateName == row.crateName -%}
{% if dep.inherit == "version" %}
{{ dep.depName }} = "{{ dep.versionLiteral }}"
{% else %}
{{ dep.depName }} = { workspace = true }
{% endif %}
{% endif -%}
{% endfor %}

[features]
default = []
{% if row.isNoStd and row.hasAlloc -%}
# no_std kernel with heap access via `extern crate alloc` (PRD.md:84-90).
alloc = []
{% endif -%}
