---
to: "inc/{{ row.crateName }}.h"
force: true
for_each: results
sparql:
  results: |
    PREFIX rust: <urn:ggen:rust:#>
    SELECT DISTINCT ?crateName WHERE {
      ?c a rust:Crate ; rust:crateName ?crateName .
    } ORDER BY ?crateName
  fns: |
    PREFIX rust: <urn:ggen:rust:#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT ?crateName ?symbolName ?retFinal ?paramSpec WHERE {
      {
        SELECT ?c ?symbolName (IF(BOUND(?rt), STR(?rt), "void") AS ?retFinal) WHERE {
          ?c rust:defines ?f .
          ?f a rust:FfiExport ;
             rust:symbolName ?symbolName .
          OPTIONAL { ?f rust:returnType ?rt }
        }
      }
      {
        SELECT ?f (GROUP_CONCAT(
            CONCAT(IF(BOUND(?ct), STR(?ct), "void*"), " ", STR(?pName));
            separator=", ") AS ?paramSpec)
        WHERE {
          ?f rust:hasParameter ?param .
          ?param rdfs:label ?pName .
          OPTIONAL { ?param rust:cType ?ct }
        }
        GROUP BY ?f
      }
      ?c rust:crateName ?crateName .
    } ORDER BY ?crateName ?symbolName
---

