# PASS witness: a member crate depending on a workspace-managed dependency
# with NO literal version on the edge — gate 050 must return 0 rows.
@prefix rust: <urn:ggen:rust:#> .

rust:witness_workspace a rust:Workspace ;
    rust:workspaceDependency rust:witness_dep_serde .

rust:witness_dep_serde a rust:Dependency .

rust:witness_crate a rust:Crate ;
    rust:crateName "witness_kernel" ;
    rust:dependsOn rust:witness_dep_serde .
