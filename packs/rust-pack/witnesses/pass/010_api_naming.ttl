# PASS witness: Struct in UpperCamelCase, Function and Module in snake_case —
# gate 010 must return 0 rows.
@prefix rust: <urn:ggen:rust:#> .

rust:witness_point a rust:Struct ;
    rust:itemName "Point" .

rust:witness_parse_chunk a rust:Function ;
    rust:itemName "parse_chunk" .

rust:witness_core a rust:Module ;
    rust:itemName "core" .
