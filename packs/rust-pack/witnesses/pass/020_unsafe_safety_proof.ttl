# PASS witness: an unsafe function carrying an explicit rust:safetyProof —
# gate 020 must return 0 rows.
@prefix rust: <urn:ggen:rust:#> .

rust:witness_unsafe_copy a rust:Function ;
    rust:itemName "copy_raw" ;
    rust:isUnsafe true ;
    rust:safetyProof "src and dst are valid for writes of len bytes; regions do not overlap (UCG pointer-provenance invariant)." .
