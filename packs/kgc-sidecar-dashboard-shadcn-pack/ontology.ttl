@prefix pack: <urn:ggen-marketplace:kgc-sidecar-dashboard-shadcn-pack:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:project a pack:SourceProject ;
    rdfs:label "kgc-sidecar dashboard" ;
    pack:sourcePath "/Users/sac/kgc-sidecar/apps/dashboard"^^xsd:string ;
    pack:packageName "@kgc-sidecar/dashboard" ;
    pack:packageVersion "0.0.1" ;
    pack:framework "Next.js ~15.2.4 / React 19.0.0" ;
    pack:packageManager "npm (package.json, no lockfile scanned)" ;
    rdfs:comment "Admitted project scanned at /Users/sac/kgc-sidecar/apps/dashboard on 2026-08-17; package.json read directly, no source code copied into this pack." .

# --- shadcn/ui: confirmed real, in-use ---

pack:shadcnUsage a pack:TechnologyFinding ;
    rdfs:label "shadcn/ui usage" ;
    pack:status "confirmed-in-use" ;
    rdfs:comment "components.json present at project root (style=new-york, baseColor=neutral, cssVariables=true, iconLibrary=lucide, aliases: components=@/components, ui=@/components/ui, lib=@/lib, hooks=@/hooks). Four shadcn primitive files exist on disk under src/components/ui/ and are all imported and rendered in src/app/chat/page.tsx, so usage is real code, not an unused dependency." .

pack:cnHelper a pack:CodeArtifact ;
    rdfs:label "cn() utility" ;
    pack:filePath "src/lib/utils.ts" ;
    rdfs:comment "Canonical shadcn class-name merge helper: cn(...inputs) built from clsx + tailwind-merge (twMerge). 6 lines." .

pack:uiButton a pack:ShadcnComponent ;
    rdfs:label "Button" ;
    pack:filePath "src/components/ui/button.tsx" ;
    pack:importedIn "src/app/chat/page.tsx" ;
    rdfs:comment "shadcn Button primitive (57 lines), built on class-variance-authority; imported as Button in src/app/chat/page.tsx." .

pack:uiCard a pack:ShadcnComponent ;
    rdfs:label "Card" ;
    pack:filePath "src/components/ui/card.tsx" ;
    pack:importedIn "src/app/chat/page.tsx" ;
    rdfs:comment "shadcn Card primitive (76 lines); imported as Card in src/app/chat/page.tsx." .

pack:uiInput a pack:ShadcnComponent ;
    rdfs:label "Input" ;
    pack:filePath "src/components/ui/input.tsx" ;
    pack:importedIn "src/app/chat/page.tsx" ;
    rdfs:comment "shadcn Input primitive (22 lines); imported as Input in src/app/chat/page.tsx." .

pack:uiScrollArea a pack:ShadcnComponent ;
    rdfs:label "ScrollArea" ;
    pack:filePath "src/components/ui/scroll-area.tsx" ;
    pack:importedIn "src/app/chat/page.tsx" ;
    rdfs:comment "shadcn ScrollArea primitive (48 lines), built on @radix-ui/react-scroll-area; imported as ScrollArea in src/app/chat/page.tsx." .

pack:radixSlotDep a pack:PackageDependency ;
    rdfs:label "@radix-ui/react-slot" ;
    pack:declaredVersion "^1.2.3" ;
    rdfs:comment "Radix primitive used by shadcn component composition (e.g. asChild patterns in button.tsx)." .

pack:radixScrollAreaDep a pack:PackageDependency ;
    rdfs:label "@radix-ui/react-scroll-area" ;
    pack:declaredVersion "^1.2.10" ;
    rdfs:comment "Radix primitive backing src/components/ui/scroll-area.tsx." .

pack:cvaDep a pack:PackageDependency ;
    rdfs:label "class-variance-authority" ;
    pack:declaredVersion "^0.7.1" ;
    rdfs:comment "Variant styling library used by the shadcn component set (e.g. button.tsx variants)." .

# --- deck.gl: confirmed absent ---

pack:deckglUsage a pack:TechnologyFinding ;
    rdfs:label "deck.gl usage" ;
    pack:status "absent" ;
    rdfs:comment "No deck.gl or @deck.gl/* dependency in package.json, and no occurrence of DeckGL, ScatterplotLayer, GeoJsonLayer, HexagonLayer, ArcLayer, or other layer/viewport/view-state identifiers found anywhere under src/ or specs/. This technology is not used in this project; do not admit any deck.gl facts for this pack." .
