---
to: Cargo.toml
sparql:
  rows: |
    PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
    SELECT ?crate_name ?binary_name ?version ?edition ?rust_version WHERE {
      ?cli a cnv:Cli ;
           cnv:crateName ?crate_name ;
           cnv:binaryName ?binary_name ;
           cnv:version ?version ;
           cnv:edition ?edition ;
           cnv:rustVersion ?rust_version .
    }
    ORDER BY ?crate_name
---
# GENERATED by ggen from the admitted cnv:Cli graph. Do not edit.
[workspace]

[package]
name = "{{ rows[0].crate_name }}"
version = "{{ rows[0].version }}"
edition = "{{ rows[0].edition }}"
rust-version = "{{ rows[0].rust_version }}"
publish = false

[dependencies]
blake3 = "1.8"
clap-noun-verb = "=26.8.21"
clap-noun-verb-macros = "=26.8.21"
linkme = "0.3"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
# Every generated CLI gets an OCEL 2.0 event log for free with zero setup
# (default path .clap-noun-verb/ocel.json, override with CLAP_NOUN_VERB_OCEL_PATH).
# Optional: also serve this CLI over MCP/HTTP (including its OCEL log at GET
# /ocel and the clap-noun-verb://ocel MCP resource), or project it to a
# Kubernetes manifest / OCI Dockerfile, without touching the generated
# routing/handler code above. Uncomment to opt in:
# clap-noun-verb-deploy = { version = "=26.8.21", features = ["mcp", "http", "kubernetes", "container"] }

[[bin]]
name = "{{ rows[0].binary_name }}"
path = "src/main.rs"
