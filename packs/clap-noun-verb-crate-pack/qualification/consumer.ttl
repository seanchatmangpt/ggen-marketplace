@prefix cnv: <https://clap-noun-verb.dev/ontology#> .

# Positive marketplace qualification specimen. This is consumer input, not
# pack authority and not evidence that any external CLI has executed.
cnv:QualificationCli
    a cnv:Cli ;
    cnv:binaryName "cnv-qualification" ;
    cnv:crateName "cnv-qualification" ;
    cnv:version "0.1.0" ;
    cnv:edition "2024" ;
    cnv:rustVersion "1.85" ;
    cnv:about "Bounded marketplace qualification specimen." ;
    cnv:hasNoun cnv:QualificationSystemNoun .

cnv:QualificationSystemNoun
    a cnv:Noun ;
    cnv:name "system" ;
    cnv:about "Exercise pack manufacture semantics." ;
    cnv:hasCommand cnv:QualificationPing .

cnv:QualificationPing
    a cnv:Command ;
    cnv:name "ping" ;
    cnv:about "Return a deterministic qualification value." ;
    cnv:belongsToNoun cnv:QualificationSystemNoun ;
    cnv:hasBehavior cnv:QualificationPingBehavior .

cnv:QualificationPingBehavior
    a cnv:StaticJsonBehavior ;
    cnv:jsonValue "{\"status\":\"alive\",\"source\":\"marketplace-qualification\"}" .
