PREFIX crc: <https://seanchatmangpt.dev/ontology/cross-repo-contract#>

# Fails if any GCPService lacks a *_custom_endpoint attribute or non-empty arcusEndpoint
SELECT ?svc ?name WHERE {
  ?svc a crc:GCPService ;
       crc:serviceName ?name .
  FILTER (
    NOT EXISTS { ?svc crc:tfAttribute ?attr . FILTER(REGEX(STR(?attr), "_custom_endpoint$")) } ||
    NOT EXISTS { ?svc crc:arcusEndpoint ?ep . FILTER(STRLEN(STR(?ep)) > 0) }
  )
}
