PREFIX crc: <https://seanchatmangpt.dev/ontology/cross-repo-contract#>

# Fails if two distinct ErrorCode individuals share the same jsonRpcCode
SELECT ?code ?name1 ?name2 WHERE {
  ?e1 a crc:ErrorCode ; crc:jsonRpcCode ?code ; crc:errorName ?name1 .
  ?e2 a crc:ErrorCode ; crc:jsonRpcCode ?code ; crc:errorName ?name2 .
  FILTER (?e1 != ?e2 && STR(?e1) < STR(?e2))
}
