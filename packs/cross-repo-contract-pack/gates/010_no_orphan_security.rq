PREFIX crc: <https://seanchatmangpt.dev/ontology/cross-repo-contract#>

# Fails if any SecurityControl is an orphan (missing attachedTo or enforcedByBinary)
SELECT ?ctrl ?name WHERE {
  ?ctrl a crc:SecurityControl ;
        crc:controlName ?name .
  FILTER (
    NOT EXISTS { ?ctrl crc:attachedTo ?t . FILTER(STRLEN(STR(?t)) > 0) } ||
    NOT EXISTS { ?ctrl crc:enforcedByBinary ?b . FILTER(STRLEN(STR(?b)) > 0) }
  )
}
