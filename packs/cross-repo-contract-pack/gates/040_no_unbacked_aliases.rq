PREFIX crc: <https://seanchatmangpt.dev/ontology/cross-repo-contract#>

# Fails if any ModelEntry is unbacked (crc:backed false) or lacks backendTarget
SELECT ?m ?name WHERE {
  ?m a crc:ModelEntry ;
     crc:modelName ?name .
  FILTER (
    NOT EXISTS { ?m crc:backed true } ||
    NOT EXISTS { ?m crc:backendTarget ?t . FILTER(STRLEN(STR(?t)) > 0) }
  )
}
