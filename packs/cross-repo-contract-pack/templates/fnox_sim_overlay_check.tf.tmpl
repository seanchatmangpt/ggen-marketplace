---
to: "dist/gcp-provider-simulation.tf"
force: true
determinism: true
sparql:
  gcp_services: |
    PREFIX crc: <https://seanchatmangpt.dev/ontology/cross-repo-contract#>
    SELECT ?tfAttribute ?arcusEndpoint WHERE {
      ?s a crc:GCPService ;
         crc:tfAttribute ?tfAttribute ;
         crc:arcusEndpoint ?arcusEndpoint ;
         crc:supported true .
    } ORDER BY ?tfAttribute
---
# GENERATED by cross-repo-contract-pack — do not edit by hand.
terraform {
  required_version = ">= 1.5"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 8.0.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = ">= 8.0.0"
    }
  }
}

provider "google" {
  project                        = "ai-cmd-ctr"
  region                         = "us-central1"
{% for g in gcp_services %}{% set len_attr = g.tfAttribute | length %}{% set pad = 30 - len_attr %}  {{ g.tfAttribute }}{% for i in range(end=pad) %} {% endfor %} = "{{ g.arcusEndpoint }}"
{% endfor %}}

provider "google-beta" {
  project                        = "ai-cmd-ctr"
  region                         = "us-central1"
{% for g in gcp_services %}{% set len_attr = g.tfAttribute | length %}{% set pad = 30 - len_attr %}  {{ g.tfAttribute }}{% for i in range(end=pad) %} {% endfor %} = "{{ g.arcusEndpoint }}"
{% endfor %}}
