@prefix ddx: <https://seanchatmangpt.github.io/ggen-marketplace/docs-diataxis#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Classes -------------------------------------------------------------

ddx:Book a rdfs:Class ;
    rdfs:label "Book" ;
    rdfs:comment "Singleton: one documented subject. dcterms:title is required. Projects into index.md and the SUMMARY.md root line." .

ddx:Page a rdfs:Class ;
    rdfs:label "Page" ;
    rdfs:comment "One markdown page of the corpus. Required: dcterms:title, rdx:position, ddx:quadrant (one of tutorial|how-to|reference|explanation), ddx:relPath (output path relative to the consumer's generation root, must end in .md), ddx:body (markdown text). Projects one file per Page plus SUMMARY.md navigation." .

# Properties ----------------------------------------------------------

ddx:quadrant a rdf:Property ;
    rdfs:label "quadrant" ;
    rdfs:comment "Diataxis quadrant enum: tutorial | how-to | reference | explanation. Gate-checked; values outside the enum are refused, not silently dropped." .

ddx:position a rdf:Property ;
    rdfs:label "position" ;
    rdfs:comment "Ordering key within a quadrant. Duplicates within one quadrant are refused (ORDER BY tie -> nondeterministic replay)." .

ddx:relPath a rdf:Property ;
    rdfs:label "relPath" ;
    rdfs:comment "Output path relative to the consumer generation root, e.g. tutorials/01-intro.md. Duplicates are refused (two pages writing one path is a real write collision)." .

ddx:body a rdf:Property ;
    rdfs:label "body" ;
    rdfs:comment "Markdown body text for the page (Turtle triple-quoted strings carry multi-line bodies). Projected verbatim into the page file." .
