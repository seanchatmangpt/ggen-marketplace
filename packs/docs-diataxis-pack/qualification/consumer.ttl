@prefix ddx: <https://seanchatmangpt.github.io/ggen-marketplace/docs-diataxis#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/ddx-qualification#> .

# Deterministic qualification fixture: one Book, six Pages covering all
# four quadrants (two tutorials to prove multi-page ordering).

ex:book a ddx:Book ; dcterms:title "Qualification Subject" .

ex:p1 a ddx:Page ; ddx:position 1 ; dcterms:title "Getting started" ;
    ddx:quadrant "tutorial" ; ddx:relPath "tutorials/getting-started.md" ;
    ddx:body """Run the project locally, in order.

```bash
make setup
```""" .

ex:p2 a ddx:Page ; ddx:position 2 ; dcterms:title "First query" ;
    ddx:quadrant "tutorial" ; ddx:relPath "tutorials/first-query.md" ;
    ddx:body """Write and run your first query.""" .

ex:p3 a ddx:Page ; ddx:position 1 ; dcterms:title "Deploy" ;
    ddx:quadrant "how-to" ; ddx:relPath "how-to/deploy.md" ;
    ddx:body """Deploy to a target environment.""" .

ex:p4 a ddx:Page ; ddx:position 1 ; dcterms:title "CLI reference" ;
    ddx:quadrant "reference" ; ddx:relPath "reference/cli.md" ;
    ddx:body """Every command, exact flags.""" .

ex:p5 a ddx:Page ; ddx:position 1 ; dcterms:title "Why quadrants" ;
    ddx:quadrant "explanation" ; ddx:relPath "explanation/quadrants.md" ;
    ddx:body """Rationale for the Diataxis split.""" .
