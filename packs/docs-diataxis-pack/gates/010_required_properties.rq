# MESSAGE: every ddx:Book / ddx:Page individual this pack's templates
# project must carry the properties its owning template's SELECT reads
# with no OPTIONAL/COALESCE fallback -- a missing one produces an opaque
# template-render failure rather than a clear admission refusal. Any row
# below = a subject missing a property its projection depends on.
PREFIX ddx: <https://seanchatmangpt.github.io/ggen-marketplace/docs-diataxis#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?s ?missing WHERE {
  { ?s a ddx:Book . BIND(dcterms:title AS ?missing) }
  UNION { ?s a ddx:Page . BIND(ddx:position AS ?missing) }
  UNION { ?s a ddx:Page . BIND(dcterms:title AS ?missing) }
  UNION { ?s a ddx:Page . BIND(ddx:quadrant AS ?missing) }
  UNION { ?s a ddx:Page . BIND(ddx:relPath AS ?missing) }
  UNION { ?s a ddx:Page . BIND(ddx:body AS ?missing) }
  FILTER NOT EXISTS { ?s ?missing ?any }
}
ORDER BY ?s ?missing
