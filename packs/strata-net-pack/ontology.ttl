# strata-net-pack ontology — Strata P2P wire + mempool (roadmap slice S7).
#
# Wire-format ground truth: packs/strata-protocol-pack/ontology.ttl
# (CLAP-PDU conventions: fixed-width big-endian fields, magic leading field,
# offset/len abutment, reserved-must-be-zero). Mempool admission policy
# conceptually rides packs/strata-valve-pack (valve-refusal semantics).
# These are documentation-only citations — no owl:imports — per FM-PACK-018
# house remediation (see pack.toml).

@prefix st:   <https://strata.chatman.ai/ontology#> .
@prefix net:  <https://strata.chatman.ai/ontology/net#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ── Model classes ─────────────────────────────────────────────────────

st:NetMessage a rdfs:Class ; rdfs:label "NetMessage" ;
    rdfs:comment "One framed P2P message: 8-byte header (magic+kind+len) + payload." .

st:MessageKind a rdfs:Class ; rdfs:label "MessageKind" ;
    rdfs:comment "The exact set of P2P message kinds; each carries a unique 1-byte kind code." .

st:PeerAdmission a rdfs:Class ; rdfs:label "PeerAdmission" ;
    rdfs:comment "Admission of a peer into the capped peer table (MAX_PEERS)." .

st:MempoolEntry a rdfs:Class ; rdfs:label "MempoolEntry" ;
    rdfs:comment "One mempool admission candidate, identified by its 32-byte digest." .

# ── S9 hardening: peer-admission refusal-path surface ─────────────────
# Adversarial ground truth (comment-level citation, no owl:imports):
# packs/strata-consensus-pack/ontology.ttl AdversarialCase individuals
# Eclipse / SpamFlood / InvalidBlockGossip and their st:refusalPath values.
# Eclipse: per-subnet peer cap 8 (ECLIPSE_MAX_PEERS_PER_SUBNET); SpamFlood:
# per-slot rate limit 32; InvalidBlockGossip: typed refusal, block dropped
# before mempool admission.

st:subnetClass a rdf:Property ; rdfs:label "subnetClass" ;
    rdfs:comment "Subnet class (deterministic string label) of a peer admission candidate; eclipse guard counts peers per subnetClass." ;
    rdfs:domain st:PeerAdmission ; rdfs:range xsd:string .

st:msgsThisSlot a rdf:Property ; rdfs:label "msgsThisSlot" ;
    rdfs:comment "Messages this peer contributed in the current slot (rate-limit input)." ;
    rdfs:domain st:PeerAdmission ; rdfs:range xsd:integer .

st:blacklisted a rdf:Property ; rdfs:label "blacklisted" ;
    rdfs:comment "Whether the peer is currently blacklisted (blacklist slots > 0)." ;
    rdfs:domain st:PeerAdmission ; rdfs:range xsd:boolean .

st:blacklistSlots a rdf:Property ; rdfs:label "blacklistSlots" ;
    rdfs:comment "Remaining blacklist slots for a blacklisted peer; must be > 0 whenever blacklisted is true (gate 030)." ;
    rdfs:domain st:PeerAdmission ; rdfs:range xsd:integer .

# ── Declared property surface (exact; see gate 020 closure) ──────────

st:msgKind a rdf:Property ; rdfs:label "msgKind" ;
    rdfs:comment "Message-kind discriminator of a NetMessage (1-byte kind code on the wire)." ;
    rdfs:domain st:NetMessage ; rdfs:range st:MessageKind .

st:payloadLen a rdf:Property ; rdfs:label "payloadLen" ;
    rdfs:comment "Payload length in bytes carried in the frame header (u16 big-endian)." ;
    rdfs:domain st:NetMessage ; rdfs:range xsd:integer .

st:peerId a rdf:Property ; rdfs:label "peerId" ;
    rdfs:comment "Stable peer identifier string admitted into the peer table." ;
    rdfs:domain st:PeerAdmission ; rdfs:range xsd:string .

st:admissionVerdict a rdf:Property ; rdfs:label "admissionVerdict" ;
    rdfs:comment "Typed admission verdict for a peer or mempool entry (admit / typed refusal)." ;
    rdfs:domain st:PeerAdmission ; rdfs:range xsd:string .

st:NetWireLaw a rdfs:Class ; rdfs:label "NetWireLaw" ;
    rdfs:comment "The single network law individual (NET_CONSTANTS): capacity + wire bounds." .

# ── NET_CONSTANTS individual (network wire + capacity law) ───────────

st:NET_CONSTANTS a st:NetWireLaw ; rdfs:label "NET_CONSTANTS" ;
    net:maxMsgLen "65536"^^xsd:integer ;
    net:headerLen "8"^^xsd:integer ;
    net:maxMempool "4096"^^xsd:integer ;
    net:maxPeers "64"^^xsd:integer ;
    rdfs:comment "Network law: MAX_MSG_LEN 65536, 8-byte header (magic+kind+len), MAX_MEMPOOL 4096, MAX_PEERS 64." .

# ── Wire constants (CLAP-PDU conventions; FrameConstant shape) ───────

net:NetWireConstant a rdfs:Class ;
    rdfs:label "NetWireConstant" ;
    rdfs:comment "One generated wire constant of the Strata P2P framed header." .

net:NET_MAGIC a net:NetWireConstant ;
    rdfs:label "NET_MAGIC" ; net:rustType "u32" ; net:value "0x5354_4E54" ;
    rdfs:comment "Magic bytes \"SNET\", big-endian; bytes 0..4 (CLAP-PDU magic convention)." .

net:MAGIC_OFFSET a net:NetWireConstant ;
    rdfs:label "MAGIC_OFFSET" ; net:rustType "usize" ; net:value "0"^^xsd:integer ;
    rdfs:comment "Magic field offset; length 4." .
net:MAGIC_LEN a net:NetWireConstant ;
    rdfs:label "MAGIC_LEN" ; net:rustType "usize" ; net:value "4"^^xsd:integer ;
    rdfs:comment "Magic field length." .
net:KIND_OFFSET a net:NetWireConstant ;
    rdfs:label "KIND_OFFSET" ; net:rustType "usize" ; net:value "4"^^xsd:integer ;
    rdfs:comment "Kind field offset; length 1." .
net:KIND_LEN a net:NetWireConstant ;
    rdfs:label "KIND_LEN" ; net:rustType "usize" ; net:value "1"^^xsd:integer ;
    rdfs:comment "Kind field length." .
net:LEN_OFFSET a net:NetWireConstant ;
    rdfs:label "LEN_OFFSET" ; net:rustType "usize" ; net:value "5"^^xsd:integer ;
    rdfs:comment "Payload-length field offset (3-byte big-endian, u24); length 3." .
net:LEN_LEN a net:NetWireConstant ;
    rdfs:label "LEN_LEN" ; net:rustType "usize" ; net:value "3"^^xsd:integer ;
    rdfs:comment "Payload-length field length (u24 big-endian; bounds MAX_MSG_LEN on the wire)." .
net:HEADER_LEN a net:NetWireConstant ;
    rdfs:label "HEADER_LEN" ; net:rustType "usize" ; net:value "8"^^xsd:integer ;
    rdfs:comment "Fixed header length in bytes: magic(4)+kind(1)+len(3, u24 big-endian)." .
net:MAX_MSG_LEN a net:NetWireConstant ;
    rdfs:label "MAX_MSG_LEN" ; net:rustType "usize" ; net:value "65536"^^xsd:integer ;
    rdfs:comment "Maximum payload length in bytes (u16 wire bound)." .
net:MAX_MEMPOOL a net:NetWireConstant ;
    rdfs:label "MAX_MEMPOOL" ; net:rustType "usize" ; net:value "4096"^^xsd:integer ;
    rdfs:comment "Mempool capacity in entries; eviction order is lowest digest first." .
net:MAX_PEERS a net:NetWireConstant ;
    rdfs:label "MAX_PEERS" ; net:rustType "usize" ; net:value "64"^^xsd:integer ;
    rdfs:comment "Peer-table capacity; admission beyond the cap is refused." .

# ── S9 hardening constants (generated into net_consts.rs/engine) ─────
# ECLIPSE_SUBNET_CAP mirrors st:eclipseMaxPeersPerSubnet "8" in
# packs/strata-consensus-pack/ontology.ttl (cross-pack law parity; see
# gate 030 value arm).

net:ECLIPSE_SUBNET_CAP a net:NetWireConstant ;
    rdfs:label "ECLIPSE_SUBNET_CAP" ; net:rustType "usize" ; net:value "8"^^xsd:integer ;
    rdfs:comment "Max concurrent peers per subnet (Eclipse guard); mirrors consensus-pack eclipseMaxPeersPerSubnet = 8." .
net:BLACKLIST_SLOTS a net:NetWireConstant ;
    rdfs:label "BLACKLIST_SLOTS" ; net:rustType "usize" ; net:value "16"^^xsd:integer ;
    rdfs:comment "Slots a blacklisted peer stays refused before re-admission is reconsidered." .
net:MAX_MSGS_PER_SLOT a net:NetWireConstant ;
    rdfs:label "MAX_MSGS_PER_SLOT" ; net:rustType "usize" ; net:value "32"^^xsd:integer ;
    rdfs:comment "Per-slot message budget (SpamFlood); the (budget+1)-th message in a slot is refused." .

# ── MessageKind individuals (1-byte kind codes; exact set of 5) ──────

net:INV a st:MessageKind ; rdfs:label "INV" ; net:kindCode "1"^^xsd:integer ;
    rdfs:comment "Inventory advertisement; empty payload." .
net:GET_DATA a st:MessageKind ; rdfs:label "GET_DATA" ; net:kindCode "2"^^xsd:integer ;
    rdfs:comment "Request for a payload by digest." .
net:TX a st:MessageKind ; rdfs:label "TX" ; net:kindCode "3"^^xsd:integer ;
    rdfs:comment "Gossiped transaction payload; non-empty." .
net:BLOCK a st:MessageKind ; rdfs:label "BLOCK" ; net:kindCode "4"^^xsd:integer ;
    rdfs:comment "Gossiped block payload; non-empty." .
net:PING a st:MessageKind ; rdfs:label "PING" ; net:kindCode "5"^^xsd:integer ;
    rdfs:comment "Liveness probe; empty payload." .

# ── Sample NetMessage individuals (gate 020 payload-length arms) ─────

net:msg-inv a st:NetMessage ; st:msgKind net:INV ; st:payloadLen "0"^^xsd:integer ;
    rdfs:comment "INV carries no payload." .
net:msg-getdata a st:NetMessage ; st:msgKind net:GET_DATA ; st:payloadLen "32"^^xsd:integer ;
    rdfs:comment "GET_DATA carries a 32-byte digest request." .
net:msg-tx a st:NetMessage ; st:msgKind net:TX ; st:payloadLen "1"^^xsd:integer ;
    rdfs:comment "TX carries a non-empty transaction payload." .
net:msg-block a st:NetMessage ; st:msgKind net:BLOCK ; st:payloadLen "1"^^xsd:integer ;
    rdfs:comment "BLOCK carries a non-empty block payload." .
net:msg-ping a st:NetMessage ; st:msgKind net:PING ; st:payloadLen "0"^^xsd:integer ;
    rdfs:comment "PING carries no payload." .

# ── S9 hardening: sample PeerAdmission individuals (gate 030 corpus) ──

net:peer-alpha a st:PeerAdmission ; rdfs:label "peer-alpha" ;
    st:peerId "peer-alpha" ; st:admissionVerdict "admit" ;
    st:subnetClass "10.0.0.0/16" ; st:msgsThisSlot "5"^^xsd:integer ;
    st:blacklisted false ;
    rdfs:comment "Admitted peer under the eclipse cap, under the slot budget." .
net:peer-beta a st:PeerAdmission ; rdfs:label "peer-beta" ;
    st:peerId "peer-beta" ; st:admissionVerdict "admit" ;
    st:subnetClass "10.0.0.0/16" ; st:msgsThisSlot "7"^^xsd:integer ;
    st:blacklisted false ;
    rdfs:comment "Second peer in the same subnet (cap 8 not yet reached)." .
# ── L150 composition law: mempool admission ⊂ ledger admission ────────
# The mempool shadow admits sum_out >= sum_in — inflation passes the
# shadow (the refusal is only `sum_in > sum_out`:
# packs/strata-net-pack/templates/net_engine.rs.tera:269) — while the
# ledger's Gate 3 requires strict equality (`sum_in != sum_out` →
# Conservation refusal: packs/strata-ledger-pack/templates/
# ledger_state.rs.tera:403). Mempool admission is therefore NECESSARY
# NOT SUFFICIENT for ledger admission; the ledger conservation valve
# completes the law.
# Provenance: mfact procint/ProcInt/Petri/NetLaws.lean:319
# inflation_passes_mempool_shadow.

st:CompositionLaw a rdfs:Class ; rdfs:label "CompositionLaw" ;
    rdfs:comment "A cross-pack composition law: a condition admitted by one pack's gate is necessary-not-sufficient for a downstream pack's stricter valve; the stricter valve completes the law." .

st:MEMPOOL_LEDGER_ADMISSION a st:CompositionLaw ;
    rdfs:label "MEMPOOL_LEDGER_ADMISSION" ;
    st:lawBody "Mempool admission (net shadow, sum_out >= sum_in) is a NECESSARY NOT SUFFICIENT condition for ledger admission; the ledger conservation gate (strict sum equality, Gate 3) is the completing valve that refuses inflation." ;
    st:necessaryGate "packs/strata-net-pack/templates/net_engine.rs.tera:269" ;
    st:completingGate "packs/strata-ledger-pack/templates/ledger_state.rs.tera:403" ;
    rdfs:comment "Provenance: mfact procint/ProcInt/Petri/NetLaws.lean inflation_passes_mempool_shadow (NetLaws.lean:319)." .

# ── net ↔ protocol composition law: PDU wire units ride the net envelope ──
# The strata-protocol-pack projects the CLAP/1.0 PDU surface; its fixed-size
# wire units must ride inside the net framed envelope without overflow:
#   pdu:PDU_HEADER_LEN (64) <= net MAX_MSG_LEN (65536)
#   pdu:REFUSAL_RECEIPT_LEN (32) <= net MAX_MSG_LEN (65536)
# Constants pinned by IRI literal + value literal (no owl:imports, house
# style); gated fail-closed by gates/050_pdu_envelope_law.rq; projected into
# generated/pdu_envelope.rs.

st:PduEnvelopeBinding a rdfs:Class ; rdfs:label "PduEnvelopeBinding" ;
    rdfs:comment "Pinned binding from the net framed envelope to the strata-protocol-pack CLAP-PDU wire constants that ride inside it: each pinned PDU constant must fit the net MAX_MSG_LEN envelope bound." .

st:pduConstantIri a rdf:Property ; rdfs:label "pduConstantIri" ;
    rdfs:comment "Pinned constant: IRI of a strata-protocol-pack pdu:FrameConstant riding the net envelope. Pinned by literal (no owl:imports); gated structurally." ;
    rdfs:domain st:PduEnvelopeBinding ; rdfs:range xsd:string .

st:pduConstantLen a rdf:Property ; rdfs:label "pduConstantLen" ;
    rdfs:comment "Pinned constant: byte length of the pinned PDU wire constant; must equal the protocol pack's pdu:value and satisfy <= net maxMsgLen." ;
    rdfs:domain st:PduEnvelopeBinding ; rdfs:range xsd:integer .

st:envelopesPduConstant a rdf:Property ; rdfs:label "envelopesPduConstant" ;
    rdfs:comment "Links the net wire-law individual to the pinned PDU constant IRI it envelopes (emission-edge analogue of the temprun composition)." ;
    rdfs:domain st:NetWireLaw ; rdfs:range xsd:string .

st:CLAP_PDU_ENVELOPE a st:PduEnvelopeBinding ;
    rdfs:label "CLAP_PDU_ENVELOPE" ;
    # PINNED PROTOCOL CONSTANTS (mirrored from strata-protocol-pack
    # ontology.ttl pdu:FrameConstant individuals).
    st:pduConstantIri "https://strata.chatman.ai/ontology/pdu#PDU_HEADER_LEN" ;
    st:pduConstantLen 64 ;
    rdfs:comment "The CLAP/1.0 PDU header rides the net envelope: 64 <= 65536." .

st:REFUSAL_RECEIPT_ENVELOPE a st:PduEnvelopeBinding ;
    rdfs:label "REFUSAL_RECEIPT_ENVELOPE" ;
    st:pduConstantIri "https://strata.chatman.ai/ontology/pdu#REFUSAL_RECEIPT_LEN" ;
    st:pduConstantLen 32 ;
    rdfs:comment "The opaque refusal receipt rides the net envelope: 32 <= 65536." .

st:NET_CONSTANTS
    st:envelopesPduConstant "https://strata.chatman.ai/ontology/pdu#PDU_HEADER_LEN" ,
                            "https://strata.chatman.ai/ontology/pdu#REFUSAL_RECEIPT_LEN" .

net:peer-gamma a st:PeerAdmission ; rdfs:label "peer-gamma" ;
    st:peerId "peer-gamma" ; st:admissionVerdict "refuse:blacklisted" ;
    st:subnetClass "10.9.9.0/24" ; st:msgsThisSlot "0"^^xsd:integer ;
    st:blacklisted true ; st:blacklistSlots "16"^^xsd:integer ;
    rdfs:comment "Blacklisted peer carrying a full 16-slot term; gate 030 requires slots > 0." .
