PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX st:   <https://strata.chatman.ai/ontology#>
PREFIX net:  <https://strata.chatman.ai/ontology/net#>

# Projection rows for the net ↔ protocol composition: one row per pinned
# PDU wire constant riding the net envelope, plus the envelope bound.
SELECT ?pdu_iri ?pdu_name ?pdu_len ?max_msg_len WHERE {
  ?binding a st:PduEnvelopeBinding ;
           st:pduConstantIri ?pdu_iri ;
           st:pduConstantLen ?pdu_len .
  ?law a st:NetWireLaw ;
       net:maxMsgLen ?max_msg_len .
  BIND(STRAFTER(STR(?pdu_iri), "#") AS ?pdu_name)
}
ORDER BY ?pdu_iri
