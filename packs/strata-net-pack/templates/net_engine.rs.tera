// ── Message kinds ─────────────────────────────────────────────────────

/// The five P2P message kinds (exact set, per the ontology closure gate).
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub enum MessageKind {
    Inv,
    GetData,
    Tx,
    Block,
    Ping,
}

impl MessageKind {
    /// Kind code → kind; `None` for unknown codes (decode refusal).
    pub fn from_code(code: u8) -> Option<MessageKind> {
        match code {
            KIND_INV => Some(MessageKind::Inv),
            KIND_GET_DATA => Some(MessageKind::GetData),
            KIND_TX => Some(MessageKind::Tx),
            KIND_BLOCK => Some(MessageKind::Block),
            KIND_PING => Some(MessageKind::Ping),
            _ => None,
        }
    }

    /// Stable 1-byte kind code (generated straight from the RDF).
    pub fn code(self) -> u8 {
        match self {
            MessageKind::Inv => KIND_INV,
            MessageKind::GetData => KIND_GET_DATA,
            MessageKind::Tx => KIND_TX,
            MessageKind::Block => KIND_BLOCK,
            MessageKind::Ping => KIND_PING,
        }
    }
}

// ── Framing errors ────────────────────────────────────────────────────

/// Encode-side refusal (typed; never a panic).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum EncodeError {
    /// Payload exceeds MAX_MSG_LEN (65536) — not representable within the law.
    PayloadTooLong,
}

/// Decode-side refusals, in the order they are checked.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum DecodeError {
    /// Leading magic does not match NET_MAGIC (also covers a nonzero
    /// framing-era byte field: the wire has no reserved slack).
    BadMagic,
    /// Kind byte outside the generated kind table.
    UnknownKind,
    /// Declared payload length exceeds MAX_MSG_LEN.
    LengthOverMax,
    /// Fewer bytes than HEADER_LEN, or fewer payload bytes than declared.
    Truncated,
}

impl std::fmt::Display for DecodeError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        let s = match self {
            DecodeError::BadMagic => "BadMagic",
            DecodeError::UnknownKind => "UnknownKind",
            DecodeError::LengthOverMax => "LengthOverMax",
            DecodeError::Truncated => "Truncated",
        };
        f.write_str(s)
    }
}

// ── Framing ───────────────────────────────────────────────────────────

/// Read a u24 big-endian length field.
fn read_len_u24(bytes: &[u8]) -> usize {
    ((bytes[LEN_OFFSET] as usize) << 16) | ((bytes[LEN_OFFSET + 1] as usize) << 8) | (bytes[LEN_OFFSET + 2] as usize)
}

/// Write a u24 big-endian length field.
fn write_len_u24(frame: &mut Vec<u8>, len: usize) {
    frame.push((len >> 16) as u8);
    frame.push((len >> 8) as u8);
    frame.push(len as u8);
}

/// Encode `kind` + `payload` into a framed message:
/// `[0..4) magic BE, [4] kind, [5..8) payload length u24 BE, payload…`.
pub fn encode(kind: MessageKind, payload: &[u8]) -> Result<Vec<u8>, EncodeError> {
    if payload.len() > MAX_MSG_LEN {
        return Err(EncodeError::PayloadTooLong);
    }
    let mut frame = Vec::with_capacity(HEADER_LEN + payload.len());
    frame.extend_from_slice(&NET_MAGIC.to_be_bytes());
    frame.push(kind.code());
    write_len_u24(&mut frame, payload.len());
    frame.extend_from_slice(payload);
    Ok(frame)
}

/// Decode a framed message; returns `(kind, payload-slice)`.
/// Refusals fire in order: Truncated (short header) → BadMagic →
/// UnknownKind → LengthOverMax → Truncated (short payload).
pub fn decode(bytes: &[u8]) -> Result<(MessageKind, &[u8]), DecodeError> {
    if bytes.len() < HEADER_LEN {
        return Err(DecodeError::Truncated);
    }
    let magic = u32::from_be_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]);
    if magic != NET_MAGIC {
        return Err(DecodeError::BadMagic);
    }
    let kind = MessageKind::from_code(bytes[KIND_OFFSET]).ok_or(DecodeError::UnknownKind)?;
    let declared = read_len_u24(bytes);
    if declared > MAX_MSG_LEN {
        return Err(DecodeError::LengthOverMax);
    }
    if bytes.len() < HEADER_LEN + declared {
        return Err(DecodeError::Truncated);
    }
    Ok((kind, &bytes[HEADER_LEN..HEADER_LEN + declared]))
}

// ── Mempool (valve-refusal semantics; deterministic eviction) ─────────

/// Mempool admission refusals (typed valve verdicts).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum MempoolRefusal {
    /// `try_admit` only: pool at MAX_MEMPOOL, no eviction performed.
    Full,
    /// Entry digest already present.
    Duplicate,
    /// Empty payload carries no admissible content.
    Empty,
    /// S9 InvalidBlockGossip: block payload failed validity re-check and
    /// was dropped before admission (never inserted into the pool).
    InvalidBlock,
}

fn entry_digest(payload: &[u8]) -> [u8; 32] {
    // FNV-1a 64 stream, doubled into a 32-byte placeholder digest.
    // (Real digest binding lands via strata-hash; this is deterministic
    // and std-only, which is all the mempool ordering law requires.)
    let mut dig = [0u8; 32];
    let mut chunk = [0u8; 8];
    let mut i = 0;
    for &b in payload {
        chunk[i % 8] = b;
        i += 1;
        if i % 8 == 0 {
            push_chunk(&mut dig, &chunk, (i / 8 - 1) % 4);
        }
    }
    if i % 8 != 0 {
        for c in chunk.iter_mut().skip(i % 8) {
            *c = 0;
        }
        push_chunk(&mut dig, &chunk, (i / 8) % 4);
    }
    if i == 0 {
        dig[0] = 0x4E; // distinct deterministic marker for the empty case
    }
    dig
}

fn push_chunk(dig: &mut [u8; 32], chunk: &[u8; 8], slot: usize) {
    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
    for &b in chunk {
        hash ^= b as u64;
        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
    }
    dig[slot * 8..slot * 8 + 8].copy_from_slice(&hash.to_be_bytes());
}

/// Deterministic mempool: `BTreeSet` over 32-byte entry digests, so
/// iteration order — and therefore eviction order — is the lexical digest
/// order: the LOWEST digest is evicted first when the pool is full.
pub struct Mempool {
    entries: std::collections::BTreeSet<[u8; 32]>,
    capacity: usize,
}

impl Mempool {
    pub fn new() -> Mempool {
        Mempool { entries: std::collections::BTreeSet::new(), capacity: MAX_MEMPOOL }
    }

    pub fn new_with_capacity(capacity: usize) -> Mempool {
        Mempool { entries: std::collections::BTreeSet::new(), capacity }
    }

    pub fn len(&self) -> usize {
        self.entries.len()
    }

    pub fn is_empty(&self) -> bool {
        self.entries.is_empty()
    }

    /// S9 InvalidBlockGossip refusal path: gossip-block admission that
    /// re-checks validity BEFORE any pool mutation. A block payload is
    /// valid iff it is non-empty and carries the 0x01 BLOCK_EXTENSION
    /// version tag in its leading byte (deterministic stand-in for the
    /// consensus-pack's height/parent-hash/PoW re-check); every failure
    /// is the typed `InvalidBlock` refusal and the pool is untouched.
    pub fn admit_block(&mut self, payload: &[u8]) -> Result<[u8; 32], MempoolRefusal> {
        if payload.is_empty() || payload[0] != 0x01 {
            return Err(MempoolRefusal::InvalidBlock);
        }
        self.admit(payload)
    }

    /// Admit with eviction: when at capacity, evict the lowest digest first,
    /// then insert. Returns the admitted entry digest.
    pub fn admit(&mut self, payload: &[u8]) -> Result<[u8; 32], MempoolRefusal> {
        if payload.is_empty() {
            return Err(MempoolRefusal::Empty);
        }
        let digest = entry_digest(payload);
        if self.entries.contains(&digest) {
            return Err(MempoolRefusal::Duplicate);
        }
        if self.entries.len() >= self.capacity {
            // Deterministic eviction: lowest digest first.
            let victim = *self.entries.iter().next().expect("capacity > 0 ⇒ non-empty here");
            self.entries.remove(&victim);
        }
        self.entries.insert(digest);
        Ok(digest)
    }

    /// Admit without eviction: refuse `Full` at capacity.
    pub fn try_admit(&mut self, payload: &[u8]) -> Result<[u8; 32], MempoolRefusal> {
        if payload.is_empty() {
            return Err(MempoolRefusal::Empty);
        }
        let digest = entry_digest(payload);
        if self.entries.contains(&digest) {
            return Err(MempoolRefusal::Duplicate);
        }
        if self.entries.len() >= self.capacity {
            return Err(MempoolRefusal::Full);
        }
        self.entries.insert(digest);
        Ok(digest)
    }

    /// Lowest digest currently in the pool (the next eviction victim).
    pub fn lowest_digest(&self) -> Option<[u8; 32]> {
        self.entries.iter().next().copied()
    }

    /// Free one slot explicitly (e.g. after a downstream consumer takes the entry).
    pub fn remove(&mut self, digest: &[u8; 32]) -> bool {
        self.entries.remove(digest)
    }
}

impl Default for Mempool {
    fn default() -> Mempool {
        Mempool::new()
    }
}

// ── Peer admission ────────────────────────────────────────────────────

/// Peer-table refusals (typed valve verdicts).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum PeerRefusal {
    /// Table at MAX_PEERS.
    TableFull,
    /// Peer already present.
    Duplicate,
    /// Peer not present (on remove).
    Unknown,
}

/// Capacity-capped peer-admission table (MAX_PEERS = 64).
pub struct PeerTable {
    peers: std::collections::HashSet<String>,
    capacity: usize,
}

impl PeerTable {
    pub fn new() -> PeerTable {
        PeerTable { peers: std::collections::HashSet::new(), capacity: MAX_PEERS }
    }

    pub fn new_with_capacity(capacity: usize) -> PeerTable {
        PeerTable { peers: std::collections::HashSet::new(), capacity }
    }

    pub fn len(&self) -> usize {
        self.peers.len()
    }

    pub fn is_empty(&self) -> bool {
        self.peers.is_empty()
    }

    pub fn contains(&self, peer_id: &str) -> bool {
        self.peers.contains(peer_id)
    }

    /// Admit a peer; refuses `TableFull` at capacity, `Duplicate` if present.
    pub fn add(&mut self, peer_id: &str) -> Result<(), PeerRefusal> {
        if self.peers.contains(peer_id) {
            return Err(PeerRefusal::Duplicate);
        }
        if self.peers.len() >= self.capacity {
            return Err(PeerRefusal::TableFull);
        }
        self.peers.insert(peer_id.to_string());
        Ok(())
    }

    /// Remove a peer; refuses `Unknown` if absent.
    pub fn remove(&mut self, peer_id: &str) -> Result<(), PeerRefusal> {
        if self.peers.remove(peer_id) {
            Ok(())
        } else {
            Err(PeerRefusal::Unknown)
        }
    }
}

impl Default for PeerTable {
    fn default() -> PeerTable {
        PeerTable::new()
    }
}

// ── S9 hardening: eclipse guard, blacklist, rate limiter ─────────────

/// S9 peer-admission refusals extending the capacity-capped table.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum HardeningRefusal {
    /// Eclipse guard: subnet already holds ECLIPSE_SUBNET_CAP (8) peers.
    SubnetCapped,
    /// Peer already present.
    Duplicate,
    /// Peer is blacklisted (blacklist slots > 0).
    Blacklisted,
    /// SpamFlood: slot message budget MAX_MSGS_PER_SLOT (32) exhausted.
    SpamFlood,
}

impl std::fmt::Display for HardeningRefusal {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        let s = match self {
            HardeningRefusal::SubnetCapped => "SubnetCapped",
            HardeningRefusal::Duplicate => "Duplicate",
            HardeningRefusal::Blacklisted => "Blacklisted",
            HardeningRefusal::SpamFlood => "SpamFlood",
        };
        f.write_str(s)
    }
}

/// Blacklist ledger: peer id → remaining blacklist slots. A blacklisted
/// peer is refused at admission until every slot has been ticked away.
pub struct Blacklist {
    slots: std::collections::HashMap<String, usize>,
}

impl Blacklist {
    pub fn new() -> Blacklist {
        Blacklist { slots: std::collections::HashMap::new() }
    }

    /// Blacklist a peer for BLACKLIST_SLOTS (16) slots.
    pub fn blacklist(&mut self, peer_id: &str) {
        self.slots.insert(peer_id.to_string(), BLACKLIST_SLOTS);
    }

    /// Remaining slots, or 0 for a non-blacklisted peer.
    pub fn slots_left(&self, peer_id: &str) -> usize {
        self.slots.get(peer_id).copied().unwrap_or(0)
    }

    pub fn is_blacklisted(&self, peer_id: &str) -> bool {
        self.slots_left(peer_id) > 0
    }

    /// Tick one slot: every term decrements; peers reaching 0 are lifted.
    pub fn tick(&mut self) {
        for s in self.slots.values_mut() {
            *s = s.saturating_sub(1);
        }
        self.slots.retain(|_, s| *s > 0);
    }
}

impl Default for Blacklist {
    fn default() -> Blacklist {
        Blacklist::new()
    }
}

/// Hardening admission valve: eclipse-guarded peer table + blacklist.
pub struct HardenedPeerTable {
    table: PeerTable,
    subnets: std::collections::HashMap<String, String>,
    blacklist: Blacklist,
}

impl HardenedPeerTable {
    pub fn new() -> HardenedPeerTable {
        HardenedPeerTable {
            table: PeerTable::new(),
            subnets: std::collections::HashMap::new(),
            blacklist: Blacklist::new(),
        }
    }

    pub fn len(&self) -> usize {
        self.table.len()
    }

    pub fn is_empty(&self) -> bool {
        self.table.is_empty()
    }

    pub fn contains(&self, peer_id: &str) -> bool {
        self.table.contains(peer_id)
    }

    /// Deterministic subnet label of an admitted peer (`None` if absent).
    pub fn subnet_of(&self, peer_id: &str) -> Option<&str> {
        self.subnets.get(peer_id).map(String::as_str)
    }

    /// Peers currently admitted from `peer_subnet` (the eclipse-guard count).
    pub fn subnet_count(&self, peer_subnet: &str) -> usize {
        self.subnets.values().filter(|s| s.as_str() == peer_subnet).count()
    }

    /// Admit a peer into `peer_subnet` through the full hardening ladder:
    /// Blacklisted → Duplicate → TableFull/SubnetCapped, then admit.
    pub fn admit(&mut self, peer_id: &str, peer_subnet: &str) -> Result<(), HardeningRefusal> {
        if self.blacklist.is_blacklisted(peer_id) {
            return Err(HardeningRefusal::Blacklisted);
        }
        if self.table.contains(peer_id) {
            return Err(HardeningRefusal::Duplicate);
        }
        if self.subnet_count(peer_subnet) >= ECLIPSE_SUBNET_CAP {
            return Err(HardeningRefusal::SubnetCapped);
        }
        self.table
            .add(peer_id)
            .map_err(|_| HardeningRefusal::SubnetCapped)?;
        self.subnets.insert(peer_id.to_string(), peer_subnet.to_string());
        Ok(())
    }

    /// Blacklist an admitted (or arbitrary) peer for BLACKLIST_SLOTS slots.
    pub fn blacklist(&mut self, peer_id: &str) {
        self.blacklist.blacklist(peer_id);
    }

    /// Tick one blacklist slot (all terms decrement; served peers lift).
    pub fn blacklist_tick(&mut self) {
        self.blacklist.tick();
    }

    /// Remaining blacklist slots for a peer (0 = not blacklisted).
    pub fn blacklist_slots_left(&self, peer_id: &str) -> usize {
        self.blacklist.slots_left(peer_id)
    }

    /// Remove a peer; its subnet count drops accordingly.
    pub fn remove(&mut self, peer_id: &str) -> Result<(), HardeningRefusal> {
        self.subnets.remove(peer_id);
        self.table.remove(peer_id).map_err(|_| HardeningRefusal::Blacklisted)
    }
}

impl Default for HardenedPeerTable {
    fn default() -> HardenedPeerTable {
        HardenedPeerTable::new()
    }
}

/// Per-slot message rate limiter (SpamFlood guard): admits at most
/// MAX_MSGS_PER_SLOT (32) messages per slot; the 33rd is refused.
pub struct SlotRateLimiter {
    budget: usize,
    seen: usize,
}

impl SlotRateLimiter {
    pub fn new() -> SlotRateLimiter {
        SlotRateLimiter { budget: MAX_MSGS_PER_SLOT, seen: 0 }
    }

    pub fn new_with_budget(budget: usize) -> SlotRateLimiter {
        SlotRateLimiter { budget, seen: 0 }
    }

    pub fn seen(&self) -> usize {
        self.seen
    }

    /// Record one message; refuses SpamFlood once the slot budget is spent.
    pub fn note_msg(&mut self) -> Result<(), HardeningRefusal> {
        if self.seen >= self.budget {
            return Err(HardeningRefusal::SpamFlood);
        }
        self.seen += 1;
        Ok(())
    }

    /// Advance to the next slot (budget restored).
    pub fn next_slot(&mut self) {
        self.seen = 0;
    }
}

impl Default for SlotRateLimiter {
    fn default() -> SlotRateLimiter {
        SlotRateLimiter::new()
    }
}

// ── Tests (Chicago: real bytes, real containers, final-state assertions) ──

#[cfg(test)]
mod tests {
    use super::*;

    fn all_kinds() -> [MessageKind; 5] {
        [MessageKind::Inv, MessageKind::GetData, MessageKind::Tx, MessageKind::Block, MessageKind::Ping]
    }

    #[test]
    fn frame_round_trip_all_five_kinds() {
        let payloads: [&[u8]; 5] = [b"", b"\x11\x22\x33", b"tx-payload", b"block-payload", b""];
        for &kind in all_kinds().iter() {
            let frame = encode(kind, payloads[kind.code() as usize - 1]).expect("encode");
            assert_eq!(frame.len(), HEADER_LEN + payloads[kind.code() as usize - 1].len());
            let (decoded_kind, payload) = decode(&frame).expect("decode");
            assert_eq!(decoded_kind, kind);
            assert_eq!(payload, payloads[kind.code() as usize - 1]);
        }
    }

    #[test]
    fn kind_code_stability_from_ontology() {
        assert_eq!(MessageKind::Inv.code(), KIND_INV);
        assert_eq!(MessageKind::GetData.code(), KIND_GET_DATA);
        assert_eq!(MessageKind::Tx.code(), KIND_TX);
        assert_eq!(MessageKind::Block.code(), KIND_BLOCK);
        assert_eq!(MessageKind::Ping.code(), KIND_PING);
        assert_eq!(MessageKind::Inv.code(), 1);
        assert_eq!(MessageKind::GetData.code(), 2);
        assert_eq!(MessageKind::Tx.code(), 3);
        assert_eq!(MessageKind::Block.code(), 4);
        assert_eq!(MessageKind::Ping.code(), 5);
        for &kind in all_kinds().iter() {
            assert_eq!(MessageKind::from_code(kind.code()), Some(kind));
        }
    }

    #[test]
    fn truncated_frames_are_refused() {
        let frame = encode(MessageKind::Tx, b"payload").expect("encode");
        // Short header.
        assert_eq!(decode(&frame[..HEADER_LEN - 1]), Err(DecodeError::Truncated));
        // Header claims more payload than present.
        assert_eq!(decode(&frame[..frame.len() - 1]), Err(DecodeError::Truncated));
        assert_eq!(decode(&[]), Err(DecodeError::Truncated));
    }

    #[test]
    fn garbage_magic_is_refused() {
        let mut frame = encode(MessageKind::Ping, b"").expect("encode");
        frame[0] ^= 0xFF;
        assert_eq!(decode(&frame), Err(DecodeError::BadMagic));
    }

    #[test]
    fn unknown_kind_byte_is_refused() {
        let mut frame = encode(MessageKind::Ping, b"").expect("encode");
        frame[KIND_OFFSET] = 0xFE;
        assert_eq!(decode(&frame), Err(DecodeError::UnknownKind));
    }

    #[test]
    fn length_over_max_is_refused() {
        // Craft a header declaring MAX_MSG_LEN + 1 payload bytes.
        let mut frame = encode(MessageKind::Block, b"x").expect("encode");
        let over = MAX_MSG_LEN + 1;
        frame[LEN_OFFSET] = (over >> 16) as u8;
        frame[LEN_OFFSET + 1] = (over >> 8) as u8;
        frame[LEN_OFFSET + 2] = over as u8;
        assert_eq!(decode(&frame), Err(DecodeError::LengthOverMax));
    }

    #[test]
    fn encode_refuses_payload_over_max() {
        let big = vec![0u8; MAX_MSG_LEN + 1];
        assert_eq!(encode(MessageKind::Tx, &big), Err(EncodeError::PayloadTooLong));
        // Exactly at the law bound is admissible.
        let at = vec![0u8; MAX_MSG_LEN];
        let frame = encode(MessageKind::Tx, &at).expect("at-bound encode");
        let (_, payload) = decode(&frame).expect("at-bound decode");
        assert_eq!(payload.len(), MAX_MSG_LEN);
    }

    #[test]
    fn mempool_admit_duplicate_empty() {
        let mut pool = Mempool::new_with_capacity(4);
        assert_eq!(pool.admit(b""), Err(MempoolRefusal::Empty));
        let d1 = pool.admit(b"tx-one").expect("admit one");
        assert_eq!(pool.admit(b"tx-one"), Err(MempoolRefusal::Duplicate));
        assert_eq!(pool.len(), 1);
        let _ = pool.remove(&d1);
        assert!(pool.is_empty());
    }

    #[test]
    fn mempool_full_refusal_via_try_admit() {
        let mut pool = Mempool::new_with_capacity(2);
        pool.try_admit(b"a").expect("a");
        pool.try_admit(b"b").expect("b");
        assert_eq!(pool.try_admit(b"c"), Err(MempoolRefusal::Full));
        assert_eq!(pool.len(), 2);
    }

    #[test]
    fn mempool_evicts_lowest_digest_first() {
        let mut pool = Mempool::new_with_capacity(3);
        let mut digests = Vec::new();
        for i in 0..4u8 {
            digests.push(pool.admit(format!("entry-{}", i).as_bytes()).expect("admit"));
        }
        // Capacity 3 ⇒ the lowest of the four digests was evicted.
        let lowest = *digests.iter().min().expect("non-empty");
        assert_eq!(pool.len(), 3);
        assert_ne!(pool.lowest_digest(), Some(lowest));
        // The victim is exactly the lexicographically lowest digest.
        let survivors: std::collections::BTreeSet<[u8; 32]> =
            digests.iter().filter(|d| **d != lowest).copied().collect();
        let mut it = survivors.iter();
        assert_eq!(pool.lowest_digest(), Some(*it.next().expect("survivor")));
    }

    #[test]
    fn mempool_frees_slot_after_eviction() {
        let mut pool = Mempool::new_with_capacity(2);
        let d1 = pool.admit(b"first").expect("first");
        let d2 = pool.admit(b"second").expect("second");
        let d3 = pool.admit(b"third").expect("third — evicts, never refuses");
        assert_eq!(pool.len(), 2);
        // Eviction victim was the lexicographically lowest of the three digests.
        let victim = *[d1, d2, d3].iter().min().expect("non-empty");
        assert_ne!(pool.lowest_digest(), Some(victim));
        // Explicit removal frees a slot for a fresh admission.
        let freed = pool.lowest_digest().expect("non-empty");
        assert!(pool.remove(&freed));
        let d4 = pool.try_admit(b"fourth").expect("freed slot admits");
        assert!(d4 != victim);
        assert_eq!(pool.len(), 2);
    }

    #[test]
    fn peer_table_cap_and_duplicate_refusals() {
        let mut table = PeerTable::new_with_capacity(2);
        table.add("peer-a").expect("a");
        assert_eq!(table.add("peer-a"), Err(PeerRefusal::Duplicate));
        table.add("peer-b").expect("b");
        assert_eq!(table.add("peer-c"), Err(PeerRefusal::TableFull));
        assert_eq!(table.len(), 2);
        table.remove("peer-a").expect("remove");
        assert_eq!(table.remove("peer-a"), Err(PeerRefusal::Unknown));
        table.add("peer-c").expect("slot freed by removal");
        assert_eq!(table.len(), 2);
    }

    #[test]
    fn defaults_use_ontology_law() {
        let pool = Mempool::new();
        let _ = pool;
        let table = PeerTable::new();
        // Cap constants come straight from NET_CONSTANTS via the projection.
        assert_eq!(MAX_MEMPOOL, 4096);
        assert_eq!(MAX_PEERS, 64);
        assert_eq!(MAX_MSG_LEN, 65536);
        assert_eq!(HEADER_LEN, 8);
        let _ = table;
    }

    // ── S9 hardening courts ──────────────────────────────────────────

    #[test]
    fn s9_eclipse_cap_fires_at_8_same_subnet_peers() {
        let mut t = HardenedPeerTable::new();
        for i in 0..8 {
            t.admit(&format!("p{}", i), "10.0.0.0/16")
                .unwrap_or_else(|e| panic!("peer {} must admit: {}", i, e));
        }
        assert_eq!(t.subnet_count("10.0.0.0/16"), 8);
        // 9th peer from the same subnet: refused, table unchanged.
        assert_eq!(t.admit("p8", "10.0.0.0/16"), Err(HardeningRefusal::SubnetCapped));
        assert_eq!(t.len(), 8);
        // A different subnet is not capped by the first subnet's fullness.
        t.admit("q0", "10.1.0.0/16").expect("other subnet admits");
        assert_eq!(t.subnet_count("10.1.0.0/16"), 1);
    }

    #[test]
    fn s9_blacklist_refusal_and_slot_expiry() {
        let mut t = HardenedPeerTable::new();
        t.admit("bad", "10.0.0.0/16").expect("initial admit");
        t.blacklist("bad");
        assert_eq!(t.admit("bad", "10.0.0.0/16"), Err(HardeningRefusal::Blacklisted));
        // Even the raw table path refuses a blacklisted peer.
        let mut plain = HardenedPeerTable::new();
        plain.blacklist("outsider");
        assert_eq!(plain.admit("outsider", "10.2.0.0/16"), Err(HardeningRefusal::Blacklisted));
        // Full 16-slot term: refused on every slot until the last tick lifts it.
        for _ in 0..BLACKLIST_SLOTS - 1 {
            plain.blacklist_tick();
            assert_eq!(plain.admit("outsider", "10.2.0.0/16"), Err(HardeningRefusal::Blacklisted));
        }
        plain.blacklist_tick();
        plain.admit("outsider", "10.2.0.0/16").expect("term served, re-admitted");
        // Constants come from the ontology projection.
        assert_eq!(BLACKLIST_SLOTS, 16);
    }

    #[test]
    fn s9_spam_limiter_fires_at_33() {
        let mut lim = SlotRateLimiter::new();
        for i in 0..32 {
            lim.note_msg()
                .unwrap_or_else(|e| panic!("msg {} within budget must admit: {}", i + 1, e));
        }
        assert_eq!(lim.note_msg(), Err(HardeningRefusal::SpamFlood));
        assert_eq!(lim.seen(), 32);
        // New slot restores the budget; the law constant is 32.
        lim.next_slot();
        lim.note_msg().expect("fresh slot admits");
        assert_eq!(MAX_MSGS_PER_SLOT, 32);
    }

    #[test]
    fn s9_invalid_block_gossip_refused_and_not_admitted() {
        let mut pool = Mempool::new_with_capacity(4);
        // Empty gossip block.
        assert_eq!(pool.admit_block(b""), Err(MempoolRefusal::InvalidBlock));
        // Non-empty but missing the BLOCK_EXTENSION tag byte.
        assert_eq!(pool.admit_block(b"\x02block-body"), Err(MempoolRefusal::InvalidBlock));
        assert_eq!(pool.len(), 0);
        // A valid gossip block admits (leading 0x01 tag).
        let d = pool.admit_block(b"\x01block-body").expect("valid block admits");
        assert_eq!(pool.len(), 1);
        assert!(pool.remove(&d));
        assert!(pool.is_empty());
    }
}
