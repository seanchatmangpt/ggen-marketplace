#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn header_len_is_8() {
        assert_eq!(HEADER_LEN, 8);
    }

    #[test]
    fn offset_abutment_chain() {
        assert_eq!(MAGIC_OFFSET, 0);
        assert_eq!(MAGIC_OFFSET + MAGIC_LEN, KIND_OFFSET);
        assert_eq!(KIND_OFFSET + KIND_LEN, LEN_OFFSET);
        assert_eq!(LEN_OFFSET + LEN_LEN, HEADER_LEN);
    }

    #[test]
    fn capacity_law() {
        assert_eq!(MAX_MSG_LEN, 65536);
        assert_eq!(MAX_MEMPOOL, 4096);
        assert_eq!(MAX_PEERS, 64);
    }

    #[test]
    fn kind_code_stability() {
        assert_eq!(KIND_INV, 1);
        assert_eq!(KIND_GET_DATA, 2);
        assert_eq!(KIND_TX, 3);
        assert_eq!(KIND_BLOCK, 4);
        assert_eq!(KIND_PING, 5);
    }
}
