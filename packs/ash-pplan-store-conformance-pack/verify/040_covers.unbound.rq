# INVERTED COMPANION to gates/040_covers.rq. ZERO ROWS IS THE PASS CONDITION.
# A covers edge pointing at a callback with no scb:callbackName joins to nothing,
# silently emptying the template's coverage census while gate 040 still scores :pass.
PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT ?subject ?missing_property
WHERE {
  ?subject a scb:Law ; scb:covers ?c .
  OPTIONAL { ?c scb:callbackName ?p1 }
  FILTER (!BOUND(?p1))
  BIND("scb:callbackName (on a covered callback)" AS ?missing_property)
}
