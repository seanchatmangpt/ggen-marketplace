# INVERTED COMPANION to gates/050_mutants.rq. ZERO ROWS IS THE PASS CONDITION.
PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a scb:Mutant .
    OPTIONAL { ?subject scb:mutantId ?p1 }
    FILTER (!BOUND(?p1))
    BIND("scb:mutantId" AS ?missing_property)
  }
  UNION
  {
    ?subject a scb:Mutant .
    OPTIONAL { ?subject scb:brokenCallback ?p2 }
    FILTER (!BOUND(?p2))
    BIND("scb:brokenCallback" AS ?missing_property)
  }
}
