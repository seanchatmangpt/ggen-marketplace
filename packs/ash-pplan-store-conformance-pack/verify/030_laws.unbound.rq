# INVERTED COMPANION to gates/030_laws.rq. ZERO ROWS IS THE PASS CONDITION.
PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a scb:Law .
    OPTIONAL { ?subject scb:lawId ?p1 }
    FILTER (!BOUND(?p1))
    BIND("scb:lawId" AS ?missing_property)
  }
  UNION
  {
    ?subject a scb:Law .
    OPTIONAL { ?subject scb:statement ?p2 }
    FILTER (!BOUND(?p2))
    BIND("scb:statement" AS ?missing_property)
  }
  UNION
  {
    ?subject a scb:Law .
    OPTIONAL { ?subject scb:body ?p3 }
    FILTER (!BOUND(?p3))
    BIND("scb:body" AS ?missing_property)
  }
  UNION
  {
    ?subject a scb:Law .
    OPTIONAL { ?subject scb:order ?p4 }
    FILTER (!BOUND(?p4))
    BIND("scb:order" AS ?missing_property)
  }
}
