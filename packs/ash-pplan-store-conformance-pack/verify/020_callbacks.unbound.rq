# INVERTED COMPANION to gates/020_callbacks.rq. ZERO ROWS IS THE PASS CONDITION.
PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a scb:Callback .
    OPTIONAL { ?subject scb:callbackName ?p1 }
    FILTER (!BOUND(?p1))
    BIND("scb:callbackName" AS ?missing_property)
  }
  UNION
  {
    ?subject a scb:Callback .
    OPTIONAL { ?subject scb:arity ?p2 }
    FILTER (!BOUND(?p2))
    BIND("scb:arity" AS ?missing_property)
  }
}
