# INVERTED COMPANION to gates/010_targets.rq. ZERO ROWS IS THE PASS CONDITION.
PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a scb:Target .
    OPTIONAL { ?subject scb:suiteModule ?p1 }
    FILTER (!BOUND(?p1))
    BIND("scb:suiteModule" AS ?missing_property)
  }
  UNION
  {
    ?subject a scb:Target .
    OPTIONAL { ?subject scb:behaviorModule ?p2 }
    FILTER (!BOUND(?p2))
    BIND("scb:behaviorModule" AS ?missing_property)
  }
  UNION
  {
    ?subject a scb:Target .
    OPTIONAL { ?subject scb:referenceStoreModule ?p3 }
    FILTER (!BOUND(?p3))
    BIND("scb:referenceStoreModule" AS ?missing_property)
  }
  UNION
  {
    ?subject a scb:Target .
    OPTIONAL { ?subject scb:outRoot ?p4 }
    FILTER (!BOUND(?p4))
    BIND("scb:outRoot" AS ?missing_property)
  }
  UNION
  {
    ?subject a scb:Target .
    OPTIONAL { ?subject scb:bootBody ?p5 }
    FILTER (!BOUND(?p5))
    BIND("scb:bootBody" AS ?missing_property)
  }
  UNION
  {
    ?subject a scb:Target .
    OPTIONAL { ?subject scb:startBody ?p6 }
    FILTER (!BOUND(?p6))
    BIND("scb:startBody" AS ?missing_property)
  }
}
