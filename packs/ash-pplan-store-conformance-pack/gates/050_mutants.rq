# Violation gate: a scb:Mutant row missing its id or pointing at a non-callback
# must refuse.
PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT DISTINCT ?m ?missing WHERE {
  ?m a scb:Mutant .
  FILTER NOT EXISTS {
    ?m scb:mutantId ?mid ; scb:brokenCallback ?c .
    ?c a scb:Callback ; scb:callbackName ?n .
  }
  BIND("mutant row missing mutantId/brokenCallback or brokenCallback is not a declared callback" AS ?missing)
}
