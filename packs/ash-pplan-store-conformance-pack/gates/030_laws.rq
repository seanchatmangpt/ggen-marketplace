# Violation gate: a scb:Law row missing ANY required fact must refuse.
PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT DISTINCT ?l ?missing WHERE {
  ?l a scb:Law .
  FILTER NOT EXISTS { ?l scb:lawId ?id ; scb:order ?o ; scb:statement ?st ; scb:body ?b . }
  BIND("law row missing lawId/order/statement/body" AS ?missing)
}
