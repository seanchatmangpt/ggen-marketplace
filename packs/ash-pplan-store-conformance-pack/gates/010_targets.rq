# Violation gate: a scb:Target row missing ANY required fact must refuse.
PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT DISTINCT ?t ?missing WHERE {
  ?t a scb:Target .
  FILTER NOT EXISTS {
    ?t scb:suiteModule ?sm ; scb:behaviorModule ?bm ; scb:referenceStoreModule ?rm ;
       scb:outRoot ?or ; scb:bootBody ?bb ; scb:startBody ?sb .
  }
  BIND("target row missing suiteModule/behaviorModule/referenceStoreModule/outRoot/bootBody/startBody" AS ?missing)
}
