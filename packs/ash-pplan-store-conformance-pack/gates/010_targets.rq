PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT DISTINCT ?suiteModule ?behaviorModule ?referenceStoreModule ?outRoot ?bootBody ?startBody WHERE {
  ?t a scb:Target ;
     scb:suiteModule ?suiteModule ;
     scb:behaviorModule ?behaviorModule ;
     scb:referenceStoreModule ?referenceStoreModule ;
     scb:outRoot ?outRoot ;
     scb:bootBody ?bootBody ;
     scb:startBody ?startBody .
}
ORDER BY ?suiteModule
