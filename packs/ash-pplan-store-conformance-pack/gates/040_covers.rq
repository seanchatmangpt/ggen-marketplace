# Violation gate: a scb:Law scb:covers edge whose object is not a declared
# scb:Callback must refuse (dangling coverage).
PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT DISTINCT ?l ?c ?missing WHERE {
  ?l a scb:Law ; scb:covers ?c .
  FILTER NOT EXISTS { ?c a scb:Callback ; scb:callbackName ?n . }
  BIND("law covers an object that is not a declared callback" AS ?missing)
}
