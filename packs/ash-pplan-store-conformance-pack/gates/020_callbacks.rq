# Violation gate: a scb:Callback row missing its name or arity must refuse.
PREFIX scb: <https://seanchatmangpt.github.io/packs/ash-pplan-store-conformance#>
SELECT DISTINCT ?c ?missing WHERE {
  ?c a scb:Callback .
  FILTER NOT EXISTS { ?c scb:callbackName ?n ; scb:arity ?a . }
  BIND("callback row missing callbackName/arity" AS ?missing)
}
