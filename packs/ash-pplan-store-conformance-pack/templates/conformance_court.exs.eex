---
to: "<%= outRoot %>/conformance_court.exs"
mode: file
---
<%
  unescape = fn body ->
    Regex.replace(~r/\\(u[0-9A-Fa-f]{4}|.)/s, body, fn _, c ->
      case c do
        "n" -> "\n"
        "t" -> "\t"
        "r" -> "\r"
        "\"" -> "\""
        "\\" -> "\\"
        "'" -> "'"
        <<"u", hex::binary-size(4)>> -> <<String.to_integer(hex, 16)::utf8>>
        other -> other
      end
    end)
  end

  scalar = fn
    nil -> nil
    value when is_binary(value) ->
      cond do
        Regex.match?(~r/^"(?:\\.|[^"\\])*"/s, value) ->
          [_, body] = Regex.run(~r/^"((?:\\.|[^"\\])*)"/s, value)
          unescape.(body)
        String.starts_with?(value, "<") and String.ends_with?(value, ">") ->
          value |> String.trim_leading("<") |> String.trim_trailing(">")
        true -> value
      end
  end

  normalize = fn rows ->
    Enum.map(List.wrap(rows), fn row ->
      Map.new(row, fn {key, value} -> {to_string(key), scalar.(value)} end)
    end)
  end

  to_int = fn v -> v |> to_string() |> String.replace(~r/\^\^.*$/, "") |>
    String.to_integer() end

  camelize = fn s ->
    s |> String.split("_") |> Enum.map(&String.capitalize/1) |> Enum.join("")
  end

  cbs =
    callbacks
    |> normalize.()
    |> Enum.map(&{&1["name"], to_int.(&1["arity"])})
    |> Enum.uniq()
    |> Enum.sort()

  mutants = normalize.(mutants)

  ref_alias = String.replace(referenceStoreModule, ".", "__")
  suite_path = outRoot <> "/" <> String.replace(suiteModule, ".", "/") <> ".ex"
%># GENERATED by ggen_igniter from packs/ash-pplan-store-conformance-pack/ontology.ttl.
# Do not edit. Re-render with mix ggen_igniter.sync --pack-dir.
#
# Conformance court: compiles the rendered conformance suite, defines a real
# in-memory REFERENCE store (compliant with every scb:Law), a SABOTAGE wrapper per
# scb:Mutant row (every callback delegates to the reference store except the broken
# callback, which raises), then requires:
#
#   1. the suite PASSES the reference store (every law :ok), and
#   2. the suite REFUSES every sabotaged store (>= 1 law errors, and the erroring
#      laws' scb:covers include the broken callback).
#
# Exit 1 on any violated invariant. Chicago-style: real store processes, real
# assertions, no mocks.

defmodule <%= ref_alias %>.Ref do
  @moduledoc "Reference lease-KV store: real Agent-backed process, no mocks."
  def start, do: Agent.start_link(fn -> %{entries: %{}, seq: 0} end)

  def put(s, k, v) do
    Agent.get_and_update(s, fn st ->
      seq = st.seq + 1
      entry = %{key: k, value: v, seq: seq, claimed_by: nil, last_claimer: nil}

      { {:ok, entry},
        %{st | entries: Map.put(st.entries, k, entry), seq: seq} }
    end)
  end

  def get(s, k), do: Agent.get(s, & &1.entries[k])

  def delete(s, k) do
    Agent.update(s, fn st -> %{st | entries: Map.delete(st.entries, k)} end)
    :ok
  end

  def list(s), do: s |> Agent.get(& &1.entries) |> Map.values() |> Enum.sort_by(& &1.seq)

  def claim(s, k, c) do
    Agent.get_and_update(s, fn st ->
      case st.entries[k] do
        %{claimed_by: nil} = e ->
          e2 = %{e | claimed_by: c, last_claimer: nil}
          { {:ok, e2}, %{st | entries: Map.put(st.entries, k, e2)} }

        %{claimed_by: ^c} = e ->
          { {:ok, e}, st }

        _ -> { :taken, st }
      end
    end)
  end

  def release(s, k, c) do
    Agent.get_and_update(s, fn st ->
      case st.entries[k] do
        %{claimed_by: ^c} = e ->
          e2 = %{e | claimed_by: nil, last_claimer: c}
          { :ok, %{st | entries: Map.put(st.entries, k, e2)} }

        %{claimed_by: nil, last_claimer: ^c} ->
          { :ok, st }

        _ -> { :taken, st }
      end
    end)
  end
end

# One sabotage wrapper per scb:Mutant row: every callback delegates to the
# reference store except the broken callback, which raises.
<%= for m <- mutants do %><% broken = m["callback"] %><% camel = camelize.(m["callback"]) %>defmodule <%= ref_alias %>.Sabotage<%= camel %> do
<%= for {n, a} <- cbs do %><% args = Enum.map_join(1..(a - 1), ", ", &("a" <> to_string(&1))) %><% arg_list = if a - 1 == 0, do: "s", else: "s, " <> args %><% call_args = if a - 1 == 0, do: "s", else: "s, " <> args %>
<%= if n == broken do %>  def <%= n %>(<%= arg_list %>), do: raise("negative control: <%= n %> sabotaged")
<% else %>  def <%= n %>(<%= arg_list %>), do: <%= ref_alias %>.Ref.<%= n %>(<%= call_args %>)
<% end %><% end %>end

<% end %>defmodule <%= ref_alias %>.Court do
  @moduledoc "Runs the real suite against the real reference store and every sabotage wrapper."
  def main do
    # 1. Compile the rendered suite.
    suite_path = <%= inspect(suite_path) %>
    [{mod, _bin}] = Code.compile_file(suite_path)

    # 2. The reference store must pass EVERY law.
    start = fn -> <%= ref_alias %>.Ref.start() end
    ref_outcomes = mod.run(<%= ref_alias %>.Ref, start)

    failures = Enum.filter(ref_outcomes, &match?({_, {:error, _}}, &1))

    if failures != [] do
      IO.puts("COURT FAIL: reference store violated laws:")
      Enum.each(failures, fn {id, {:error, e}} -> IO.puts("  #{id}: #{Exception.message(e)}") end)
      System.halt(1)
    end

    IO.puts("court: reference store passed #{length(ref_outcomes)}/#{length(ref_outcomes)} laws")

    # 3. Every sabotage wrapper must FAIL at least one law that covers the broken callback.
    covers = mod.laws() |> Enum.map(fn %{id: id, covers: cbs} -> {id, cbs} end) |> Map.new()

    Enum.each(<%= inspect(mutants |> Enum.map(& &1["callback"])) %>, fn broken ->
      sab =
        Module.concat(
          <%= ref_alias %>,
          "Sabotage" <> (broken |> String.split("_") |> Enum.map(&String.capitalize/1) |> Enum.join(""))
        )

      outcomes = mod.run(sab, start)
      failing = for {id, {:error, _}} <- outcomes, do: id

      if failing == [] do
        IO.puts("COURT FAIL: sabotaged store (#{broken} broken) passed the whole suite")
        System.halt(1)
      end

      covered_laws = for {id, cbs} <- covers, broken in cbs, do: id
      missed = failing -- covered_laws

      if missed != [] do
        IO.puts("COURT FAIL: laws #{inspect(missed)} failed but do not cover #{broken}")
        System.halt(1)
      else
        IO.puts("court: sabotaged #{inspect(broken)} refused by laws #{inspect(failing)}")
      end
    end)

    IO.puts("court: PASS -- suite refuses every broken-store mutant, passes the reference store")
  end
end

<%= ref_alias %>.Court.main()
