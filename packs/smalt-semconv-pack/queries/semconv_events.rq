# semconv_events.rq — one row per smaltv:SemConvEvent individual (spans +
# events). The template re-sorts by smaltv:order, so engine row order is not
# load-bearing for byte-identity (replay fence:
# test/semconv_replay_identity_test.exs).
PREFIX smaltv: <https://ggen.io/ontology/smalt-semconv#>

SELECT ?name ?kind ?stability ?brief ?order
WHERE {
  ?e a smaltv:SemConvEvent ;
     smaltv:name ?name ;
     smaltv:kind ?kind ;
     smaltv:stability ?stability ;
     smaltv:brief ?brief ;
     smaltv:order ?order .
}
