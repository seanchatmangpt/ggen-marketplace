# semconv_attributes.rq — attribute-allowlist rows with runtime-key bindings.
PREFIX smaltv: <https://ggen.io/ontology/smalt-semconv#>

SELECT ?forName ?key ?type ?runtime ?requirement ?order
WHERE {
  ?a a smaltv:SemConvAttribute ;
     smaltv:forName ?forName ;
     smaltv:key ?key ;
     smaltv:type ?type ;
     smaltv:runtime ?runtime ;
     smaltv:requirement ?requirement ;
     smaltv:order ?order .
}
