# semconv_mapping_rules.rq — the otel-weaver-ocel OTEL→OCEL mapping table.
PREFIX smaltv: <https://ggen.io/ontology/smalt-semconv#>

SELECT ?order ?identifier ?sourceField ?targetField ?derivation
WHERE {
  ?r a smaltv:OcelMappingRule ;
     smaltv:order ?order ;
     smaltv:identifier ?identifier ;
     smaltv:sourceField ?sourceField ;
     smaltv:targetField ?targetField ;
     smaltv:derivation ?derivation .
}
