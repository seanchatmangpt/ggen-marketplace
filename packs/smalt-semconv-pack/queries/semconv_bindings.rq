# semconv_bindings.rq — runtime telemetry-triple bindings. One row per
# smaltv:SemConvEvent individual carrying smaltv:telemetryTriple; the
# triple is rendered verbatim into the @event_name_map / @span_name_map
# source (it is Elixir source text, not a data value).
PREFIX smaltv: <https://ggen.io/ontology/smalt-semconv#>

SELECT ?name ?kind ?telemetryTriple
WHERE {
  ?e a smaltv:SemConvEvent ;
     smaltv:name ?name ;
     smaltv:kind ?kind ;
     smaltv:telemetryTriple ?telemetryTriple .
}
