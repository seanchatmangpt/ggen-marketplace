PREFIX rebloom: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/adjacency-rebloom#>
SELECT ?candidate ?reuse ?delta WHERE {
  ?candidate a rebloom:CompositionCandidate ; rebloom:reversible true ; rebloom:expectedReuse ?reuse ; rebloom:capabilitySpaceDelta ?delta ; rebloom:actuation "construct-only" .
  FILTER((?reuse + ?delta) <= 1)
}
ORDER BY DESC(?reuse) DESC(?delta) ?candidate
