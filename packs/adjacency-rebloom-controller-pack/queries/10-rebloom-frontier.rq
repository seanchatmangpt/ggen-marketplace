PREFIX rebloom: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/adjacency-rebloom#>
SELECT ?candidate ?reuse ?delta WHERE {
  ?candidate a rebloom:CompositionCandidate ;
    rebloom:reversible true ;
    rebloom:expectedReuse ?reuse ;
    rebloom:capabilitySpaceDelta ?delta .
  FILTER(?delta > 0)
}
ORDER BY DESC(?delta) DESC(?reuse) STR(?candidate)
