PREFIX rebloom: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/adjacency-rebloom#>
SELECT ?candidate ?wave ((?reuse + ?delta) / (?depth + ?order + 1.0) AS ?sensitivity) WHERE {
  ?candidate a rebloom:CompositionCandidate ; rebloom:expectedReuse ?reuse ; rebloom:capabilitySpaceDelta ?delta .
  ?wave a rebloom:RebloomWave ; rebloom:maxDepth ?depth ; rebloom:maxOrder ?order .
}
ORDER BY DESC(?sensitivity) ?candidate ?wave
