PREFIX rebloom: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/adjacency-rebloom#>
SELECT ?wave ?maxDepth ?maxOrder ?requiresReceipt ?grantsDoAuthority WHERE {
  ?wave a rebloom:RebloomWave ;
    rebloom:maxDepth ?maxDepth ;
    rebloom:maxOrder ?maxOrder ;
    rebloom:requiresReceipt ?requiresReceipt ;
    rebloom:grantsDoAuthority ?grantsDoAuthority .
  FILTER(?requiresReceipt = true)
  FILTER(?grantsDoAuthority = false)
}
ORDER BY STR(?wave)
