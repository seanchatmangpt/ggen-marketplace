PREFIX rebloom: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/adjacency-rebloom#>
SELECT ?cap ?reuse ?delta WHERE {
  ?cap a rebloom:QualifiedCapability ; rebloom:reversible true ; rebloom:expectedReuse ?reuse ; rebloom:capabilitySpaceDelta ?delta .
  FILTER(?reuse > 0 && ?delta > 0)
}
ORDER BY DESC(?delta) DESC(?reuse) ?cap
