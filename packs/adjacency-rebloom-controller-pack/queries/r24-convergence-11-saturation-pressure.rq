PREFIX rebloom: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/adjacency-rebloom#>
SELECT ?cap ?reuse ?delta (?delta / (?reuse + 1.0) AS ?saturationPressure) WHERE {
  ?cap a rebloom:QualifiedCapability ; rebloom:expectedReuse ?reuse ; rebloom:capabilitySpaceDelta ?delta .
}
ORDER BY ?saturationPressure ?cap
