PREFIX rebloom: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/adjacency-rebloom#>
SELECT ?candidate ((?reuse + ?delta) / COUNT(?cap) AS ?yieldPerBranch) WHERE {
  ?candidate a rebloom:CompositionCandidate ; rebloom:expectedReuse ?reuse ; rebloom:capabilitySpaceDelta ?delta ; rebloom:uses ?cap .
}
GROUP BY ?candidate ?reuse ?delta
ORDER BY DESC(?yieldPerBranch) ?candidate
