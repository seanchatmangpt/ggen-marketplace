PREFIX rebloom: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/adjacency-rebloom#>
SELECT ?candidate ?wave ?yield ?depth ?order WHERE {
  ?candidate a rebloom:CompositionCandidate ; rebloom:reversible true ; rebloom:expectedReuse ?reuse ; rebloom:capabilitySpaceDelta ?delta ; rebloom:qualification "required" ; rebloom:actuation "construct-only" .
  ?wave a rebloom:RebloomWave ; rebloom:maxDepth ?depth ; rebloom:maxOrder ?order ; rebloom:requiresReceipt true ; rebloom:grantsDoAuthority false .
  BIND((?reuse + ?delta) AS ?yield)
  FILTER(?yield > 1 && ?depth <= 3 && ?order <= 3)
}
ORDER BY DESC(?yield) ?depth ?order ?candidate ?wave
