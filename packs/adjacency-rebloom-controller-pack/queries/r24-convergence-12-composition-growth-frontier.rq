PREFIX rebloom: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/adjacency-rebloom#>
SELECT ?candidate ?reuse ?delta (COUNT(?cap) AS ?branchingFactor) WHERE {
  ?candidate a rebloom:CompositionCandidate ; rebloom:expectedReuse ?reuse ; rebloom:capabilitySpaceDelta ?delta ; rebloom:uses ?cap ; rebloom:reversible true .
}
GROUP BY ?candidate ?reuse ?delta
HAVING(?reuse > 0 && ?delta > 0)
ORDER BY DESC(?delta) DESC(?reuse) ?candidate
