@prefix rebloom: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/adjacency-rebloom#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rebloom:QualifiedCapability a skos:Concept ; skos:prefLabel "qualified capability" .
rebloom:CompositionCandidate a skos:Concept ; skos:prefLabel "composition candidate" .
rebloom:RebloomWave a skos:Concept ; skos:prefLabel "rebloom wave" .

rebloom:wave0 a rebloom:RebloomWave, prov:Activity ;
  dcterms:description "Seed wave composed from exact-head qualified option-capital, lineage, and fanout primitives." ;
  rebloom:maxDepth 3 ;
  rebloom:maxOrder 3 ;
  rebloom:requiresReceipt true ;
  rebloom:grantsDoAuthority false .

rebloom:optionCapitalHypergraph a rebloom:QualifiedCapability ;
  skos:prefLabel "option-capital hypergraph" ;
  rebloom:reversible true ;
  rebloom:expectedReuse 10 ;
  rebloom:capabilitySpaceDelta 8 .
rebloom:capabilityLineagePropagation a rebloom:QualifiedCapability ;
  skos:prefLabel "capability lineage propagation" ;
  rebloom:reversible true ;
  rebloom:expectedReuse 9 ;
  rebloom:capabilitySpaceDelta 7 .
rebloom:manufacturingFanout a rebloom:QualifiedCapability ;
  skos:prefLabel "manufacturing fanout" ;
  rebloom:reversible true ;
  rebloom:expectedReuse 9 ;
  rebloom:capabilitySpaceDelta 7 .

rebloom:recursiveRebloom a rebloom:CompositionCandidate ;
  rebloom:uses rebloom:optionCapitalHypergraph, rebloom:capabilityLineagePropagation, rebloom:manufacturingFanout ;
  rebloom:reversible true ;
  rebloom:expectedReuse 12 ;
  rebloom:capabilitySpaceDelta 18 ;
  rebloom:qualification "required" ;
  rebloom:actuation "construct-only" .
