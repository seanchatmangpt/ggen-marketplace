{
  "schema": "rebloom.plan.v1",
  "waves": [
  {% for row in results %}{"wave":"{{ row.wave }}","max_depth":{{ row.maxDepth }},"max_order":{{ row.maxOrder }},"requires_receipt":{{ row.requiresReceipt }},"grants_do_authority":{{ row.grantsDoAuthority }}}{% if not loop.last %},{% endif %}
  {% endfor %}],
  "mode": "construct_only"
}
