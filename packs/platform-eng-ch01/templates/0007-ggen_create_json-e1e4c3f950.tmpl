---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch01",
  "files_and_dirs": {
    ".circleci/config.yml": true,
    ".env_example": true,
    ".git-hooks/commit-msg": true,
    "README.md": true,
    "assessment_results.json": true,
    "config/platform_team_values.yaml": true,
    "design-principles-checklist.py": true,
    "ggen-create.json": true,
    "platform-config.yaml": true,
    "platform-maturity-assessment.py": true,
    "pulumi_repo_create.py": true,
    "release-workflow.yaml": true,
    "scripts/bw-helper.sh": true,
    "scripts/install-githooks.sh": true,
    "scripts/upload-secrets.sh": true,
    "secrets-setup/github_secrets.json": true,
    "secrets-setup/inject_secrets.sh": true,
    "team-topology-generator.py": true,
    "test-platform-config.py": true
  },
  "templatize_using_name": "{% endraw %}{{ row.capitalized }}{% raw %}",
  "gen_parent_dir": false
}
{% endraw %}