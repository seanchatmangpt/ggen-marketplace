@prefix tcpsp: <https://seanchatmangpt.github.io/packs/tcps-pack#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Pack identity for the consolidated TCPS crate family. The per-crate domain
# content lives verbatim in ontology/{core,cli,ffi,std,wasm}.ttl over the
# absorbed packs' namespaces; this root subject file records the consolidation
# itself (FM-PACK-004 root ontology.ttl; unioned with the modules by every
# loader — no module content is duplicated here).

tcpsp:ConsolidationModule a rdfs:Class ;
    rdfs:label "Consolidation module" ;
    rdfs:comment "One absorbed crate pack, now an ontology/<crate>.ttl module of tcps-pack." .

tcpsp:kernelModule a rdf:Property ;
    rdfs:domain tcpsp:ConsolidationModule ;
    rdfs:comment "True for the kernel crate module whose content anchors the consolidation (tcps-core per lifecycle)." .

tcpsp:module-namespace a rdf:Property ;
    rdfs:domain tcpsp:ConsolidationModule ;
    rdfs:comment "Verbatim namespace IRI carried over from the absorbed pack." .

tcpsp:mod-core a tcpsp:ConsolidationModule ;
    rdfs:label "tcps-core" ;
    tcpsp:module-namespace "http://seanchatmangpt.github.io/packs/tcps-core#"^^xsd:anyURI ;
    tcpsp:kernelModule true ;
    rdfs:seeAlso <ontology/core.ttl> ;
    rdfs:comment "24-module no_std kernel (superseded tcps-core-pack 0.1.0)." .

tcpsp:mod-cli a tcpsp:ConsolidationModule ;
    rdfs:label "tcps-cli" ;
    tcpsp:module-namespace "http://seanchatmangpt.github.io/packs/tcps-cli#"^^xsd:anyURI ;
    rdfs:seeAlso <ontology/cli.ttl> ;
    rdfs:comment "2-binary CLI crate (superseded tcps-cli-pack 0.1.0)." .

tcpsp:mod-ffi a tcpsp:ConsolidationModule ;
    rdfs:label "tcps-ffi" ;
    tcpsp:module-namespace "http://seanchatmangpt.github.io/packs/tcps-ffi#"^^xsd:anyURI ;
    rdfs:seeAlso <ontology/ffi.ttl> ;
    rdfs:comment "Stable C ABI over tcps-core (superseded tcps-ffi-pack 0.1.0)." .

tcpsp:mod-std a tcpsp:ConsolidationModule ;
    rdfs:label "tcps-std" ;
    tcpsp:module-namespace "http://seanchatmangpt.github.io/packs/tcps-std#"^^xsd:anyURI ;
    rdfs:seeAlso <ontology/std.ttl> ;
    rdfs:comment "std-dependent receipt persistence + environment observation (superseded tcps-std-pack 0.1.0)." .

tcpsp:mod-wasm a tcpsp:ConsolidationModule ;
    rdfs:label "tcps-wasm" ;
    tcpsp:module-namespace "http://seanchatmangpt.github.io/packs/tcps-wasm#"^^xsd:anyURI ;
    rdfs:seeAlso <ontology/wasm.ttl> ;
    rdfs:comment "WebAssembly capability boundary (superseded tcps-wasm-pack 0.1.0)." .
