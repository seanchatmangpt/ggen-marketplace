# POSITIVE witness for gates/ffi_040_depends_on_declared.rq: a tcps_ffi
# dependsOnModule target that carries tcps_ffi:name. Zero rows required.
# Namespace verbatim: tcps_ffi: = .../packs/tcps-ffi#.
@prefix tcps_ffi: <http://seanchatmangpt.github.io/packs/tcps-ffi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps_ffi:BenchManifestFile a tcps_ffi:CargoManifest ;
    tcps_ffi:name "benchi-cargo" ;
    tcps_ffi:sourceText "[package]\nname = \"tcps-bench\"\n" ;
    tcps_ffi:dependsOnModule tcps_ffi:LibRsModule ;
    rdfs:comment "Dependency target is declared and named: 040 stays silent." .
