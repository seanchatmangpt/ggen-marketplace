# POSITIVE witness for gates/core_020_referenced_module_name.rq: every
# tcps:dependsOnModule target carries a tcps:name. Zero rows required.
# Namespace verbatim: tcps: = .../packs/tcps-core#.
@prefix tcps: <http://seanchatmangpt.github.io/packs/tcps-core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps:検査Module a tcps:Module ;
    tcps:name "検査" ;
    tcps:order 98 ;
    tcps:dependsOnModule tcps:語彙Module ;
    rdfs:comment "Dependency target is declared AND named: 020 stays silent." .
