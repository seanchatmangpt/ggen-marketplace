# POSITIVE witness for gates/core_010_dangling_reference.rq: a tcps-core module
# whose tcps:dependsOnModule target is a declared tcps:Module individual.
# Zero rows required. Namespace verbatim: tcps: = .../packs/tcps-core#.
@prefix tcps: <http://seanchatmangpt.github.io/packs/tcps-core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps:整合Module a tcps:Module ;
    tcps:name "整合" ;
    tcps:order 99 ;
    tcps:dependsOnModule tcps:語彙Module ;
    rdfs:comment "Synthetic conforming kernel module: dependency resolves to a declared module." .
