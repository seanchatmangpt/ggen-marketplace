# POSITIVE witness for gates/ffi_010_required.rq: typed tcps_ffi individuals
# (LibModule / HeaderFile / CargoManifest) each carrying a non-empty
# tcps_ffi:sourceText. Zero rows required.
# Namespace verbatim: tcps_ffi: = .../packs/tcps-ffi#.
@prefix tcps_ffi: <http://seanchatmangpt.github.io/packs/tcps-ffi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps_ffi:BenchHeaderFile a tcps_ffi:HeaderFile ;
    tcps_ffi:name "benchi" ;
    tcps_ffi:sourceText "#ifndef TCPS_BENCH_H\n#define TCPS_BENCH_H\n/* conforming synthetic header */\n#endif\n" ;
    rdfs:comment "Typed HeaderFile with present, non-empty sourceText." .
