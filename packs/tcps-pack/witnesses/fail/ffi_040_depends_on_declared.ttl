# FIRES gates/ffi_040_depends_on_declared.rq: the dependsOnModule target is a
# declared LibModule WITH sourceText (010/030 stay silent) but has NO
# tcps_ffi:name — the "referenced but not actually declared" class.
@prefix tcps_ffi: <http://seanchatmangpt.github.io/packs/tcps-ffi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps_ffi:AnonymousLib a tcps_ffi:LibModule ;
    tcps_ffi:sourceText "pub fn anonymous() {}\n" ;
    rdfs:comment "Unnamed dependency target: 040 rows = (subject, ref)." .

tcps_ffi:BenchManifestFile a tcps_ffi:CargoManifest ;
    tcps_ffi:name "benchi-cargo" ;
    tcps_ffi:sourceText "[package]\nname = \"tcps-bench\"\n" ;
    tcps_ffi:dependsOnModule tcps_ffi:AnonymousLib .
