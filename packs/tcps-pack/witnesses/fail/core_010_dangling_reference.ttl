# FIRES gates/core_010_dangling_reference.rq: tcps:幽霊Module is referenced by
# tcps:dependsOnModule but never declared (not typed tcps:Module). It also has
# no tcps:name, so core_020 fires too — this witness's named gate is 010.
@prefix tcps: <http://seanchatmangpt.github.io/packs/tcps-core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps:壊RE整合Module a tcps:Module ;
    tcps:name "壊れた整合" ;
    tcps:dependsOnModule tcps:幽霊Module ;
    rdfs:comment "Dependency target is undeclared: 010 rows = the dangling pair." .
