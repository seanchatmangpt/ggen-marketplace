# FIRES gates/ffi_030_value_constraints.rq: a present tcps_ffi:sourceText whose
# value is the EMPTY string (minLength 1 violation). Presence (010) is satisfied.
@prefix tcps_ffi: <http://seanchatmangpt.github.io/packs/tcps-ffi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps_ffi:BenchEmptyModule a tcps_ffi:LibModule ;
    tcps_ffi:name "benchi-empty" ;
    tcps_ffi:sourceText "" ;
    rdfs:comment "Empty sourceText literal: 030 rows = (subject, class)." .
