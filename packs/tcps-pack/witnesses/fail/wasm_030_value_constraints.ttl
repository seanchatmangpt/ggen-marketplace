# FIRES gates/wasm_030_value_constraints.rq: a present tcps_wasm:sourceText
# whose value is the EMPTY string (second-branch minLength violation shape,
# realized on the Module branch property).
@prefix tcps_wasm: <http://seanchatmangpt.github.io/packs/tcps-wasm#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps_wasm:BenchModule a tcps_wasm:Module ;
    tcps_wasm:sourceText "" ;
    rdfs:comment "Empty sourceText literal: 030 rows = (subject, bound property)." .
