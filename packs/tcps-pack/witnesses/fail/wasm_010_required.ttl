# FIRES gates/wasm_010_required.rq: a typed tcps_wasm:Module with NO
# tcps_wasm:sourceText (first BIND branch rows = (subject, sourceText)).
@prefix tcps_wasm: <http://seanchatmangpt.github.io/packs/tcps-wasm#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps_wasm:BenchModule a tcps_wasm:Module ;
    rdfs:comment "Module missing sourceText: 010 rows = (subject, bound missing property)." .
