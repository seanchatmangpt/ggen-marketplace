# FIRES gates/std_010_required.rq: a tcps_std:Module individual with NO
# tcps_std:sourceText at all (presence violation).
@prefix tcps_std: <http://seanchatmangpt.github.io/packs/tcps-std#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps_std:BenchModule a tcps_std:Module ;
    rdfs:comment "Module missing sourceText: 010 rows = the bare subject." .
