# FIRES gates/ffi_010_required.rq: a typed tcps_ffi:HeaderFile with NO
# tcps_ffi:sourceText at all (presence violation).
@prefix tcps_ffi: <http://seanchatmangpt.github.io/packs/tcps-ffi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps_ffi:BenchHeaderFile a tcps_ffi:HeaderFile ;
    tcps_ffi:name "benchi" ;
    rdfs:comment "Typed HeaderFile missing sourceText: 010 rows = (subject, class)." .
