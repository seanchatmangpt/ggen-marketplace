# FIRES gates/core_020_referenced_module_name.rq: the dependency target IS a
# declared tcps:Module (so core_010 stays silent) but carries NO tcps:name —
# "referenced but not actually declared in the graph" class.
@prefix tcps: <http://seanchatmangpt.github.io/packs/tcps-core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps:無名Module a tcps:Module ;
    rdfs:comment "Typed module with no tcps:name: 020 rows = referencing pairs." .

tcps:検査失敗Module a tcps:Module ;
    tcps:name "検査失敗" ;
    tcps:dependsOnModule tcps:無名Module .
