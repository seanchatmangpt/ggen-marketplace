# FIRES gates/cli_010_depends_on_declared.rq: tcps:GhostModule is referenced by
# tcps:dependsOnModule but is neither typed tcps:Module nor named — BOTH union
# branches of the gate row (dangling type; missing name).
@prefix tcps: <http://seanchatmangpt.github.io/packs/tcps-cli#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps:BenchDanglingModule a tcps:Module ;
    tcps:name "dangling-benchi" ;
    tcps:dependsOnModule tcps:GhostModule ;
    rdfs:comment "Dependency target is undeclared: 010 fires on both branches." .
