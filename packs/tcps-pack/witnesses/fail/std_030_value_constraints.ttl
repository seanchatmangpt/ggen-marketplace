# FIRES gates/std_030_value_constraints.rq: a present tcps_std:sourceText whose
# value is the EMPTY string (minLength 1 violation). Presence (010) is satisfied.
@prefix tcps_std: <http://seanchatmangpt.github.io/packs/tcps-std#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

tcps_std:BenchModule a tcps_std:Module ;
    tcps_std:sourceText "" ;
    rdfs:comment "Empty sourceText literal: 030 rows = (subject, value)." .
