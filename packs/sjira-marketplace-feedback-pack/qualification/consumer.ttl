@prefix mf: <https://ggen.dev/ontology/sjira-marketplace-feedback#> .
@prefix ic: <https://ggen.dev/ontology/industry-closure#> .
@prefix req: <https://ggen.io/onto/requirements/> .

<urn:residual:payment-policy-term> a ic:ClosureResidual ;
  ic:residualDigest "sha256:payment-policy-term" ;
  ic:residualKind "ONTOLOGY_TERM" ;
  ic:missingSemanticCapability "Admitted public/profile mapping for the observed payment policy obligation." ;
  ic:unresolved true ;
  mf:residualWorkOrder <urn:wo:SJ-IC-001> .

<urn:wo:SJ-IC-001> a req:WorkOrder ;
  mf:semanticJiraKey "SJ-IC-001" ;
  mf:workOrderDigest "sha256:sj-ic-001" ;
  mf:authority "SELECT_CONSTRUCT_ONLY" ;
  req:hasCounterfactual <urn:cf:SJ-IC-001> ;
  mf:feedsDelta <urn:delta:payment-policy-term> .

<urn:cf:SJ-IC-001> a req:Counterfactual ;
  req:nakedCraftPath "Implement an application-specific payment policy interpretation in source code." ;
  req:manufacturingPath "Admit the missing semantic mapping once, package it, and requalify the closure frontier." ;
  req:counterfactualDelta "The one-off implementation would not expand marketplace closure for the next equivalent requirement." .

<urn:delta:payment-policy-term> a mf:MarketplaceCapabilityDelta ;
  mf:deltaDigest "sha256:delta-payment-policy-term" ;
  mf:forResidual <urn:residual:payment-policy-term> ;
  mf:targetCapabilityClass "ONTOLOGY_BINDING" ;
  mf:recurrenceCount 3 ;
  mf:impactScore 8.5 ;
  mf:deltaState mf:OPEN .
