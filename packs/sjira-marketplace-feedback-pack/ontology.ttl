@prefix mf: <https://ggen.dev/ontology/sjira-marketplace-feedback#> .
@prefix ic: <https://ggen.dev/ontology/industry-closure#> .
@prefix req: <https://ggen.io/onto/requirements/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mf:MarketplaceCapabilityDelta a rdfs:Class ;
  rdfs:label "Marketplace capability delta" ;
  rdfs:subClassOf prov:Entity .

mf:FeedbackReceipt a rdfs:Class ;
  rdfs:label "Feedback requalification receipt" ;
  rdfs:subClassOf prov:Entity .

mf:DeltaState a rdfs:Class .
mf:OPEN a mf:DeltaState .
mf:QUALIFIED a mf:DeltaState .
mf:REQUALIFIED a mf:DeltaState .

mf:residualWorkOrder a rdf:Property ;
  rdfs:domain ic:ClosureResidual ;
  rdfs:range req:WorkOrder .

mf:feedsDelta a rdf:Property ;
  rdfs:domain req:WorkOrder ;
  rdfs:range mf:MarketplaceCapabilityDelta .

mf:semanticJiraKey a rdf:Property ;
  rdfs:domain req:WorkOrder ;
  rdfs:range xsd:string .

mf:workOrderDigest a rdf:Property ;
  rdfs:domain req:WorkOrder ;
  rdfs:range xsd:string .

mf:authority a rdf:Property ;
  rdfs:domain req:WorkOrder ;
  rdfs:range xsd:string .

mf:deltaDigest a rdf:Property ;
  rdfs:domain mf:MarketplaceCapabilityDelta ;
  rdfs:range xsd:string .

mf:forResidual a rdf:Property ;
  rdfs:domain mf:MarketplaceCapabilityDelta ;
  rdfs:range ic:ClosureResidual .

mf:targetCapabilityClass a rdf:Property ;
  rdfs:domain mf:MarketplaceCapabilityDelta ;
  rdfs:range xsd:string .

mf:recurrenceCount a rdf:Property ;
  rdfs:domain mf:MarketplaceCapabilityDelta ;
  rdfs:range xsd:nonNegativeInteger .

mf:impactScore a rdf:Property ;
  rdfs:domain mf:MarketplaceCapabilityDelta ;
  rdfs:range xsd:decimal .

mf:deltaState a rdf:Property ;
  rdfs:domain mf:MarketplaceCapabilityDelta ;
  rdfs:range mf:DeltaState .

mf:implementedByPack a rdf:Property ;
  rdfs:domain mf:MarketplaceCapabilityDelta ;
  rdfs:range xsd:anyURI ;
  rdfs:subPropertyOf dcterms:references .

mf:requalificationEvidence a rdf:Property ;
  rdfs:domain mf:MarketplaceCapabilityDelta ;
  rdfs:range mf:FeedbackReceipt ;
  rdfs:subPropertyOf prov:wasDerivedFrom .

mf:closesResidual a rdf:Property ;
  rdfs:domain mf:FeedbackReceipt ;
  rdfs:range ic:ClosureResidual .

mf:receiptDigest a rdf:Property ;
  rdfs:domain mf:FeedbackReceipt ;
  rdfs:range xsd:string .
