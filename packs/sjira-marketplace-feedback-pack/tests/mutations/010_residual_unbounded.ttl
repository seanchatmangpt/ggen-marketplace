@prefix mf:  <https://ggen.dev/ontology/sjira-marketplace-feedback#> .
@prefix ic:  <https://ggen.dev/ontology/industry-closure#> .
@prefix ex:  <https://example.org/mf-mutation#> .

# Falsifier for gates/010 — unresolved residual with no bounded work order / delta.

ex:OrphanResidual a ic:ClosureResidual ;
    ic:residualDigest "sha256:orphan-residual" ;
    ic:residualKind "ONTOLOGY_TERM" ;
    ic:missingSemanticCapability "Mutation residual with no Semantic Jira admission." ;
    ic:unresolved true .
