@prefix mf:  <https://ggen.dev/ontology/sjira-marketplace-feedback#> .
@prefix ic:  <https://ggen.dev/ontology/industry-closure#> .
@prefix ex:  <https://example.org/mf-mutation#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Falsifier for gates/030 — residual marked resolved without pack + receipt;
# REQUALIFIED delta missing implementedByPack / requalificationEvidence.

mf:REQUALIFIED a mf:DeltaState .

ex:FalseClosed a ic:ClosureResidual ;
    ic:residualDigest "sha256:false-closed" ;
    ic:unresolved false .

ex:HollowDelta a mf:MarketplaceCapabilityDelta ;
    mf:deltaDigest "sha256:hollow-delta" ;
    mf:forResidual ex:FalseClosed ;
    mf:targetCapabilityClass "ONTOLOGY_BINDING" ;
    mf:recurrenceCount "1"^^xsd:integer ;
    mf:impactScore "1.0"^^xsd:decimal ;
    mf:deltaState mf:REQUALIFIED .
