@prefix mf:  <https://ggen.dev/ontology/sjira-marketplace-feedback#> .
@prefix ic:  <https://ggen.dev/ontology/industry-closure#> .
@prefix req: <https://ggen.io/onto/requirements/> .
@prefix ex:  <https://example.org/mf-mutation#> .

# Falsifier for gates/020 — work order missing counterfactual; delta missing rank.

mf:OPEN a mf:DeltaState .

ex:RankResidual a ic:ClosureResidual ;
    ic:residualDigest "sha256:rank-residual" ;
    ic:unresolved true ;
    mf:residualWorkOrder ex:WO-rank .

ex:WO-rank a req:WorkOrder ;
    mf:semanticJiraKey "SJ-MUT-020" ;
    mf:workOrderDigest "sha256:wo-rank" ;
    mf:authority "SELECT_CONSTRUCT_ONLY" ;
    mf:feedsDelta ex:Delta-rank .

ex:Delta-rank a mf:MarketplaceCapabilityDelta ;
    mf:deltaDigest "sha256:delta-rank" ;
    mf:forResidual ex:RankResidual ;
    mf:targetCapabilityClass "ONTOLOGY_BINDING" ;
    mf:deltaState mf:OPEN .
