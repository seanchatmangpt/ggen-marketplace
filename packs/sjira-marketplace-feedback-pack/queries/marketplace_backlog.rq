PREFIX mf: <https://ggen.dev/ontology/sjira-marketplace-feedback#>
PREFIX ic: <https://ggen.dev/ontology/industry-closure#>
PREFIX req: <https://ggen.io/onto/requirements/>
SELECT ?residual ?workOrder ?key ?delta ?class ?recurrence ?impact WHERE {
  ?residual a ic:ClosureResidual ;
            ic:unresolved true ;
            mf:residualWorkOrder ?workOrder .
  ?workOrder a req:WorkOrder ;
             mf:semanticJiraKey ?key ;
             mf:feedsDelta ?delta .
  ?delta a mf:MarketplaceCapabilityDelta ;
         mf:deltaState mf:OPEN ;
         mf:targetCapabilityClass ?class ;
         mf:recurrenceCount ?recurrence ;
         mf:impactScore ?impact .
}
ORDER BY DESC(?recurrence) DESC(?impact) ?key
