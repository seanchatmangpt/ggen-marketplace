# MESSAGE: Grammar paths must be normalized source-relative .lark paths under src/mmdio/engine/grammars/.
# File existence belongs to the independently observed mmdio source checkout;
# this RDF gate can lawfully validate only the admitted path contract.
PREFIX mer: <https://seanchatmangpt.github.io/ontology/mermaid#>
SELECT ?type ?grammarPath WHERE {
  ?type mer:grammarPath ?grammarPath .
  FILTER (
    !STRSTARTS(STR(?grammarPath), "src/mmdio/engine/grammars/") ||
    !STRENDS(STR(?grammarPath), ".lark") ||
    CONTAINS(STR(?grammarPath), "..")
  )
}
ORDER BY ?type ?grammarPath
