# MESSAGE: a ctrl:claimId carries verdict REFUTED but the ctrl:WorkQueueItem its PLAN claim points at (via ctrl:forItem) still has status ALIVE -- a refuted claim must invalidate the crown immediately; demote the item's status before it can be reported done
PREFIX ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#>
SELECT DISTINCT ?itemId ?claimId WHERE {
  ?v a ctrl:Claim ; ctrl:claimId ?claimId ; ctrl:verdict "REFUTED" .
  ?p a ctrl:Claim ; ctrl:claimId ?claimId ; ctrl:forItem ?w .
  ?w a ctrl:WorkQueueItem ; ctrl:itemId ?itemId ; ctrl:status "ALIVE" .
}
ORDER BY ?itemId ?claimId
