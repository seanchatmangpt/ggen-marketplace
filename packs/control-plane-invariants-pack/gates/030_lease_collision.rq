# MESSAGE: two ctrl:BuildLease individuals declare the same ctrl:resourceKey and both are unreleased -- two unexpired leases on one resource is a real defect (lock contention or a double-acquire bug); release or expire the stale lease before either holder proceeds
PREFIX ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#>
SELECT ?resourceKey ?holderA ?holderB WHERE {
  ?a a ctrl:BuildLease ; ctrl:resourceKey ?resourceKey ; ctrl:holderIdentity ?holderA ; ctrl:released false .
  ?b a ctrl:BuildLease ; ctrl:resourceKey ?resourceKey ; ctrl:holderIdentity ?holderB ; ctrl:released false .
  FILTER(?holderA < ?holderB)
}
ORDER BY ?resourceKey ?holderA ?holderB
