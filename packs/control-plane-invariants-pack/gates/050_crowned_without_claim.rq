# MESSAGE: a ctrl:WorkQueueItem has status ALIVE but no ctrl:Claim in the graph references it via ctrl:forItem -- a crown with no claims manifest behind it is unearned status; back it with at least one confirmed ctrl:Claim before reporting this item ALIVE
PREFIX ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#>
SELECT ?itemId WHERE {
  ?w a ctrl:WorkQueueItem ;
     ctrl:itemId ?itemId ;
     ctrl:status "ALIVE" .
  FILTER NOT EXISTS {
    ?c a ctrl:Claim ; ctrl:forItem ?w .
  }
}
ORDER BY ?itemId
