# MESSAGE: a ctrl:SubjectResolutionCheck carries finalVerdict ACTUALLY_UNRESOLVABLE but ctrl:remoteResult is missing or blank -- a local miss (LOCAL_OBJECT_ABSENT/SHALLOW_FETCH/UNFETCHED_REF) must never be promoted to ACTUALLY_UNRESOLVABLE without an actual remote check; run the real remote lookup (e.g. `git ls-remote`/`git fetch`) and record ctrl:remoteResult before this verdict may stand, or downgrade finalVerdict back to RESOLVED/pending
PREFIX ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#>
SELECT DISTINCT ?refValue ?localResult WHERE {
  ?c a ctrl:SubjectResolutionCheck ;
     ctrl:finalVerdict "ACTUALLY_UNRESOLVABLE" .
  OPTIONAL { ?c ctrl:refValue ?refValue }
  OPTIONAL { ?c ctrl:localResult ?localResult }
  FILTER NOT EXISTS { ?c ctrl:remoteResult ?rr . FILTER (?rr != "") }
}
ORDER BY ?refValue
