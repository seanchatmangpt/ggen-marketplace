# MESSAGE: a ctrl:SubjectReceipt recorded matchesClaimed false -- the agent's real observed subject (pwd/toplevel/remote/HEAD) did not match the subject it was told to work on; stop immediately, do not trust any findings this agent produced, and re-dispatch it into the correct subject before proceeding
PREFIX ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#>
SELECT ?claimedSubject ?absolutePath ?gitToplevel WHERE {
  ?r a ctrl:SubjectReceipt ;
     ctrl:matchesClaimed false .
  OPTIONAL { ?r ctrl:claimedSubject ?claimedSubject }
  OPTIONAL { ?r ctrl:absolutePath ?absolutePath }
  OPTIONAL { ?r ctrl:gitToplevel ?gitToplevel }
}
ORDER BY ?claimedSubject
