# MESSAGE: a ctrl:DependencyLockCheck has ctrl:staleEntryCount greater than 0 (locked entries with no corresponding materialized artifact on disk) but ctrl:reportedVerdict is PASS -- a nonzero stale-entry count must never be silently absorbed into a passing report; fail the check (ctrl:reportedVerdict FAIL) or actually materialize the missing entries (e.g. `mix deps.get`) before reporting PASS
PREFIX ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#>
SELECT DISTINCT ?lockedPackageCount ?materializedPackageCount ?staleEntryCount WHERE {
  ?c a ctrl:DependencyLockCheck ;
     ctrl:staleEntryCount ?staleEntryCount ;
     ctrl:reportedVerdict "PASS" .
  FILTER (?staleEntryCount > 0)
  OPTIONAL { ?c ctrl:lockedPackageCount ?lockedPackageCount }
  OPTIONAL { ?c ctrl:materializedPackageCount ?materializedPackageCount }
}
ORDER BY ?staleEntryCount
