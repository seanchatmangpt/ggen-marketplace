# MESSAGE: a ctrl:RetryAttempt with attemptNumber greater than 1 recorded changedFromPrevious false -- this is the UnchangedRetryGym defect: repeating the identical action against an unchanged subject and hoping for a different result; state what actually changed (approach, root cause, inputs) before attempting again
PREFIX ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#>
SELECT ?attemptNumber ?hypothesis WHERE {
  ?r a ctrl:RetryAttempt ;
     ctrl:attemptNumber ?attemptNumber ;
     ctrl:changedFromPrevious false .
  FILTER(?attemptNumber > 1)
  OPTIONAL { ?r ctrl:hypothesis ?hypothesis }
}
ORDER BY ?attemptNumber
