# MESSAGE: a ctrl:claimId has a PLAN ctrl:Claim (claimText/evidenceCommand authored) but no ctrl:Claim individual anywhere in the graph carries a ctrl:verdict for that same claimId -- an unverified claim has no standing and must never be treated as confirmed; run its evidenceCommand for real via scripts/claims-verify.sh and record CONFIRMED, REFUTED, or UNVERIFIABLE before this claim backs anything
PREFIX ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#>
SELECT DISTINCT ?claimId ?claimText WHERE {
  ?c a ctrl:Claim ;
     ctrl:claimId ?claimId ;
     ctrl:claimText ?claimText .
  FILTER NOT EXISTS {
    ?v a ctrl:Claim ; ctrl:claimId ?claimId ; ctrl:verdict ?verdict .
  }
}
ORDER BY ?claimId
