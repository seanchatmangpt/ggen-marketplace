---
to: scripts/subject-receipt.sh
---
{% raw %}#!/usr/bin/env bash
# GENERATED by `ggen sync` from packs/control-plane-invariants-pack
# (subject_receipt_sh.tmpl). MANDATORY first action for every agent
# asserting work against a subject: usage:
#   scripts/subject-receipt.sh <claimed-subject>
#
# <claimed-subject> is whatever the agent was told to work on (an absolute
# repo path, a git remote URL -- pick one convention per consumer and stay
# consistent). Captures the real pwd/toplevel/remote/HEAD/dirty-state,
# compares the real toplevel against <claimed-subject>, and appends a real
# ctrl:SubjectReceipt fact to evidence/ontology.ttl. This script judges
# nothing itself beyond printing a mismatch loudly and exiting nonzero --
# gates/010 is what refuses `ggen sync run` on a recorded mismatch, the
# same emit-facts / gate-facts split as ggen-verify-pack and
# agent-fleet-isolation-pack.
set -uo pipefail

claimed_subject="${1:?usage: subject-receipt.sh <claimed-subject>}"

actual_pwd="$(pwd)"
actual_toplevel="$(git rev-parse --show-toplevel 2>/dev/null || echo "NOT_A_GIT_REPO")"
actual_remote="$(git remote get-url origin 2>/dev/null || echo "NO_REMOTE")"
actual_head="$(git rev-parse HEAD 2>/dev/null || echo "NO_HEAD")"
porcelain="$(git status --porcelain 2>/dev/null || true)"
if [ -z "$porcelain" ]; then
  dirty_state="clean"
else
  dirty_state="$(printf '%s' "$porcelain" | tr '\n' ';')"
fi

matches="false"
if [ "$actual_toplevel" = "$claimed_subject" ] || [ "$actual_pwd" = "$claimed_subject" ]; then
  matches="true"
else
  echo "MISMATCH: claimed subject '$claimed_subject', actual toplevel '$actual_toplevel' (pwd '$actual_pwd')" >&2
fi

mkdir -p evidence
stamp="$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null || echo unknown)"
cat >> evidence/ontology.ttl <<EOF
@prefix ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#> .
ctrl:receipt-${stamp} a ctrl:SubjectReceipt ;
    ctrl:absolutePath "${actual_pwd}" ;
    ctrl:pwdObserved true ;
    ctrl:gitRemote "${actual_remote}" ;
    ctrl:gitToplevel "${actual_toplevel}" ;
    ctrl:headSha "${actual_head}" ;
    ctrl:dirtyState "${dirty_state}" ;
    ctrl:claimedSubject "${claimed_subject}" ;
    ctrl:matchesClaimed ${matches} .
EOF

echo "subject receipt recorded: matchesClaimed=${matches}"
if [ "$matches" != "true" ]; then
  exit 1
fi
{% endraw %}
