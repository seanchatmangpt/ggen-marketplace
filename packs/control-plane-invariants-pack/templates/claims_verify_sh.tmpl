---
to: scripts/claims-verify.sh
sparql:
  claims: |
    PREFIX ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#>
    SELECT ?claimId ?evidenceCommand WHERE {
      ?c a ctrl:Claim ;
         ctrl:claimId ?claimId ;
         ctrl:evidenceCommand ?evidenceCommand .
      FILTER NOT EXISTS {
        ?v a ctrl:Claim ; ctrl:claimId ?claimId ; ctrl:verdict ?verdict .
      }
    } ORDER BY ?claimId
---
{% raw %}#!/usr/bin/env bash
# GENERATED by `ggen sync` from packs/control-plane-invariants-pack
# (claims_verify_sh.tmpl). Runs every declared PLAN ctrl:Claim's
# evidenceCommand that has no verdict yet, FOR REAL -- no unverified claim
# may stand (gates/020) -- and appends a real EVIDENCE ctrl:Claim
# individual (same ctrl:claimId, plus ctrl:literalEvidence/ctrl:verdict) to
# evidence/ontology.ttl. Joined to the PLAN individual by the shared
# ctrl:claimId literal, the same join pattern
# agent-fleet-isolation-pack uses for fleet:name/fleet:agentName.
#
# CONFIRMED means the command exited 0; REFUTED means it exited nonzero.
# Neither is a semantic judgement of claimText's truth beyond "the stated
# evidence command actually succeeded" -- a claim whose evidenceCommand
# cannot mechanically decide it must be hand-recorded UNVERIFIABLE instead,
# this script never emits that verdict itself.
set -uo pipefail
mkdir -p evidence
{% endraw %}
declare -A CLAIM_CMD=(
{%- for row in claims %}
  ["{{ row.claimId }}"]="{{ row.evidenceCommand }}"
{%- endfor %}
)
{% raw %}
if [ "${#CLAIM_CMD[@]}" -eq 0 ]; then
  echo "no unverdicted ctrl:Claim individuals declared -- nothing to run"
  exit 0
fi

for claim_id in "${!CLAIM_CMD[@]}"; do
  cmd="${CLAIM_CMD[$claim_id]}"
  echo "=== claim: $claim_id ==="
  echo "+ $cmd"
  output="$(eval "$cmd" 2>&1)"
  exit_code=$?
  if [ "$exit_code" -eq 0 ]; then
    verdict="CONFIRMED"
  else
    verdict="REFUTED"
  fi
  echo "$output"
  echo "verdict: $verdict (exit $exit_code)"

  id_safe="$(echo "$claim_id" | tr -c 'a-zA-Z0-9_-' '_')"
  escaped_output="$(printf '%s' "$output" | awk '{gsub(/\\/,"\\\\"); gsub(/"/,"\\\""); printf "%s\\n", $0}')"
  cat >> evidence/ontology.ttl <<EOF
@prefix ctrl: <http://seanchatmangpt.github.io/packs/control-plane-invariants#> .
ctrl:evidence-${id_safe} a ctrl:Claim ;
    ctrl:claimId "${claim_id}" ;
    ctrl:literalEvidence "${escaped_output}" ;
    ctrl:verdict "${verdict}" .
EOF
done
{% endraw %}
