# Vocabulary for cnv-ocel:DriftReport -- the one admitted individual a
# regenerated "drift pack" (via clap_noun_verb::ocel::write_drift_pack)
# supplies. This pack ships no example individual of its own; the real
# DriftReport data comes from a real merged OCEL corpus.
@prefix cnv-ocel: <https://clap-noun-verb.dev/ontology/ocel#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cnv-ocel:DriftReport a rdfs:Class ;
    rdfs:comment "A project-wide admitted-vs-exercised coverage report, derived from a real merged OCEL corpus via clap_noun_verb::ocel::drift_report." .

cnv-ocel:coverageRatio a rdfs:Class ;
    rdfs:comment "The real, observed exercised/admitted ratio (0.0-1.0)." .

cnv-ocel:minCoverageRatio a rdfs:Class ;
    rdfs:comment "The minimum coverage ratio this project requires; gates/010_coverage_floor.rq refuses generation below it." .
