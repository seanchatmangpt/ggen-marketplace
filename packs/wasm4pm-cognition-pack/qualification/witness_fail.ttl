# Fail witness for wasm4pm-cognition-pack: one breed individual with TWO
# deliberate defects. gates must FIRE (>= 1 row) against the pack vocabulary +
# this graph:
#   - missing compat:citation            -> 010_required fires (required-row)
#   - compat:breedFamily "not_a_family"  -> 030_value_constraints fires (enum)
# If the gates are ever silently green here, they are vacuous (anti-vacuity
# mutation of the required-property and enum branches).
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix compat: <https://wasm4pm.dev/ns#> .

compat:Breed_witness_fail a compat:CognitionBreed ;
  compat:breedId     "witness_fail" ;
  compat:breedFamily "not_a_family" ;
  compat:breedLabel  "WitnessFail" ;
  compat:breedDoc    "Deliberately non-conforming witness individual." .
