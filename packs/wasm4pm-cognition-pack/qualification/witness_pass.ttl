# Pass witness for wasm4pm-cognition-pack: one minimal VALID breed individual.
# gates/010_required.rq, 020_single_valued.rq, 030_value_constraints.rq must
# all be SILENT against the pack vocabulary + this graph. Proves the gates can
# pass a conforming individual (not merely an empty graph).
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix compat: <https://wasm4pm.dev/ns#> .

compat:Breed_witness_pass a compat:CognitionBreed ;
  compat:breedId     "witness_pass" ;
  compat:breedFamily "planning" ;
  compat:breedLabel  "WitnessPass" ;
  compat:breedDoc    "Minimal valid witness individual for the cognition gates." ;
  compat:citation    "Witness, 2026." .
