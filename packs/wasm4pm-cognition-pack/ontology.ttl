@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix compat: <https://wasm4pm.dev/ns#> .

# Cognition breed catalog surface for the wasm4pm platform.
#
# SINGLE-OWNER JOIN (v26.9.30 consolidation, 2026-10-01): this pack declares the
# compat: vocabulary ONLY. The 55 compat:CognitionBreed individuals moved to the
# single owner, packs/wasm4pm-facts-pack/ontology.ttl (which also absorbed the
# 55 compat:breedFamily facts that were unique to this pack's copies). The join
# is the IRI literal `compat:CognitionBreed` + property IRIs below — the
# capability-ecology dotted-ID pattern, NO cross-pack import. Templates here
# render against the consumer's union graph: wiring only this pack yields an
# empty catalog (declared, not a defect); wiring wasm4pm-facts-pack alongside
# yields the full 55-breed catalog. qualification/verify.py proves both the
# gates' non-vacuity (witnesses) and the join (union with the facts pack).
#
# breedStatus is NEVER asserted anywhere in this pack — it is CONSTRUCT-derived
# from evidence via the alive-gate in wasm4pm. This pack generates catalog/caller
# surfaces only; evidence, witnesses, and receipts belong to the compat family.

compat:CognitionBreed a rdfs:Class ;
  rdfs:comment "A registered cognition algorithm breed in the wasm4pm platform." .

compat:breedId    a rdf:Property ; rdfs:domain compat:CognitionBreed ; rdfs:range xsd:string .
compat:breedLabel a rdf:Property ; rdfs:domain compat:CognitionBreed ; rdfs:range xsd:string .
compat:breedDoc   a rdf:Property ; rdfs:domain compat:CognitionBreed ; rdfs:range xsd:string .
compat:citation   a rdf:Property ; rdfs:domain compat:CognitionBreed ; rdfs:range xsd:string .
compat:modulePath a rdf:Property ; rdfs:domain compat:CognitionBreed ; rdfs:range xsd:string .
compat:breedFamily a rdf:Property ; rdfs:domain compat:CognitionBreed ; rdfs:range xsd:string .
# breedFamily makes the (previously comment-only) 13 section groupings a real,
# queryable RDF fact per breed -- added 2026-07-18 to close part of the
# Ontology-expressiveness gap in docs/packs/L5_VALIDATION_REPORT.md (a
# different template set can now regroup/filter the catalog by family without
# re-parsing `# ---- ... ----` comments, which were previously the only
# record of this structure).
