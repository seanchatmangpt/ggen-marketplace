//! GENERATED by pack-maturity-pack — l5p:cap03 (Deterministic regeneration)
//! and l5p:cap04 (Fixed-point convergence) proof.
//!
//! Runs the real `ggen` binary via subprocess against this consumer's own
//! project root TWICE and asserts every output file's raw bytes are
//! identical before and after the second run. This snapshots real
//! filesystem state rather than trusting `ggen sync run`'s own
//! "written"/"skipped" self-report: some frontmatter write modes report
//! "written" on every run even when content did not change (an empirically
//! confirmed quirk, not a hypothetical), so the only trustworthy signal is
//! the actual bytes on disk. No mocks, no extra crate dependencies (plain
//! byte comparison, not a hash) so this composes into any consumer's
//! Cargo.toml unchanged: a real binary, a real filesystem.

use std::{
    collections::BTreeMap,
    path::{Path, PathBuf},
    process::Command,
};

/// Directories `ggen` itself owns (its own state, not this subsystem's
/// generated output) — excluded from the convergence snapshot, mirroring
/// the marketplace's own qualification-court snapshot discipline
/// (`scripts/qualify_packs.py`'s `IGNORED_RUNTIME_ROOTS`).
const IGNORED_ROOTS: &[&str] = &[".git", ".ggen", ".ggen-v2", ".cache", "target"];

fn project_root() -> PathBuf {
    PathBuf::from(env!("CARGO_MANIFEST_DIR"))
}

fn snapshot(root: &Path) -> BTreeMap<String, Vec<u8>> {
    let mut out = BTreeMap::new();
    let mut stack = vec![root.to_path_buf()];
    while let Some(dir) = stack.pop() {
        let Ok(entries) = std::fs::read_dir(&dir) else { continue };
        for entry in entries.flatten() {
            let path = entry.path();
            let relative = path.strip_prefix(root).unwrap_or(&path);
            if let Some(first) = relative.components().next() {
                if IGNORED_ROOTS.contains(&first.as_os_str().to_string_lossy().as_ref()) {
                    continue;
                }
            }
            if path.is_dir() {
                stack.push(path);
                continue;
            }
            if let Ok(bytes) = std::fs::read(&path) {
                out.insert(relative.to_string_lossy().into_owned(), bytes);
            }
        }
    }
    out
}

fn run_sync(root: &Path) -> std::process::Output {
    Command::new("ggen")
        .args(["sync", "run"])
        .current_dir(root)
        .output()
        .expect("pack_maturity_regeneration: failed to spawn `ggen` -- is it on PATH?")
}

#[test]
fn pack_maturity_regeneration_converges_to_a_fixed_point() {
    let root = project_root();

    let first = run_sync(&root);
    assert!(
        first.status.success(),
        "pack_maturity_regeneration: first `ggen sync run` failed: {}",
        String::from_utf8_lossy(&first.stderr)
    );
    let before = snapshot(&root);

    let second = run_sync(&root);
    assert!(
        second.status.success(),
        "pack_maturity_regeneration: second `ggen sync run` failed: {}",
        String::from_utf8_lossy(&second.stderr)
    );
    let after = snapshot(&root);

    if before != after {
        let mut changed: Vec<String> = before
            .keys()
            .chain(after.keys())
            .filter(|k| before.get(*k) != after.get(*k))
            .cloned()
            .collect();
        changed.sort();
        changed.dedup();
        panic!(
            "pack_maturity_regeneration: regeneration is NOT a fixed point -- \
             changed files after a second, input-unchanged sync: {changed:?}"
        );
    }
}
