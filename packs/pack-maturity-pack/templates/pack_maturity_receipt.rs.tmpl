//! GENERATED by pack-maturity-pack — l5p:cap09 (Generated receipts) proof.
//!
//! Runs a real `ggen sync run` (so a receipt genuinely exists for this
//! test run, not a stale one from an earlier build), then `ggen receipt
//! verify`, and asserts the BLAKE3 chain is valid, signed, and its
//! signature verifies. No mocks: a real binary, a real receipt chain.

use std::process::Command;

fn project_root() -> std::path::PathBuf {
    std::path::PathBuf::from(env!("CARGO_MANIFEST_DIR"))
}

#[test]
fn pack_maturity_receipt_chain_is_valid_and_signed() {
    let root = project_root();

    let sync = Command::new("ggen")
        .args(["sync", "run"])
        .current_dir(&root)
        .output()
        .expect("pack_maturity_receipt: failed to spawn `ggen sync run` -- is `ggen` on PATH?");
    assert!(
        sync.status.success(),
        "pack_maturity_receipt: `ggen sync run` failed: {}",
        String::from_utf8_lossy(&sync.stderr)
    );

    let verify = Command::new("ggen")
        .args(["receipt", "verify", "--format", "plain"])
        .current_dir(&root)
        .output()
        .expect("pack_maturity_receipt: failed to spawn `ggen receipt verify` -- is `ggen` on PATH?");
    assert!(
        verify.status.success(),
        "pack_maturity_receipt: `ggen receipt verify` failed: {}",
        String::from_utf8_lossy(&verify.stderr)
    );

    let stdout = String::from_utf8_lossy(&verify.stdout);
    for needle in ["valid: true", "signed: true", "signature_valid: true"] {
        assert!(
            stdout.contains(needle),
            "pack_maturity_receipt: expected `ggen receipt verify` output to contain {needle:?}, got:\n{stdout}"
        );
    }
}
