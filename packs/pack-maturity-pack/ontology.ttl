@prefix mp:  <https://pack-maturity.dev/ontology#> .
@prefix l5p: <http://ggen.org/l5-promotion#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

mp:Pack a rdfs:Class .
mp:DiataxisQuadrant a rdfs:Class .
mp:DocumentationObligation a rdfs:Class .

mp:closesCapability a rdf:Property .
mp:providesQuadrant a rdf:Property .
mp:requiresObligation a rdf:Property .

mp:Tutorial a mp:DiataxisQuadrant ; rdfs:label "Tutorial" .
mp:HowTo a mp:DiataxisQuadrant ; rdfs:label "How-to" .
mp:Reference a mp:DiataxisQuadrant ; rdfs:label "Reference" .
mp:Explanation a mp:DiataxisQuadrant ; rdfs:label "Explanation" .

mp:SemanticAuthority a mp:DocumentationObligation ; rdfs:label "authoritative semantic source" .
mp:ExecutablePath a mp:DocumentationObligation ; rdfs:label "real executable path" .
mp:ReceiptReplay a mp:DocumentationObligation ; rdfs:label "receipt and replay" .
mp:Falsifier a mp:DocumentationObligation ; rdfs:label "falsifier" .
mp:Rollback a mp:DocumentationObligation ; rdfs:label "rollback" .
mp:AuthorityBoundary a mp:DocumentationObligation ; rdfs:label "SELECT/CONSTRUCT/DO authority boundary" .
mp:Exclusions a mp:DocumentationObligation ; rdfs:label "exclusions and Chesterton fences" .
mp:ExtensionPoints a mp:DocumentationObligation ; rdfs:label "extension points" .

mp:PackMaturityPack
    a mp:Pack ;
    rdfs:label "pack-maturity-pack" ;
    rdfs:comment "Generates cross-cutting regeneration, receipt, and Level-5 Diataxis proof infrastructure without manufacturing domain semantics." ;
    mp:closesCapability l5p:cap03, l5p:cap04, l5p:cap09 ;
    mp:providesQuadrant mp:Tutorial, mp:HowTo, mp:Reference, mp:Explanation ;
    mp:requiresObligation
        mp:SemanticAuthority,
        mp:ExecutablePath,
        mp:ReceiptReplay,
        mp:Falsifier,
        mp:Rollback,
        mp:AuthorityBoundary,
        mp:Exclusions,
        mp:ExtensionPoints .
