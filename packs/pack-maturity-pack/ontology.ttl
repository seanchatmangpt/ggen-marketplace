@prefix mp:  <https://pack-maturity.dev/ontology#> .
@prefix l5p: <http://ggen.org/l5-promotion#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# This pack's own identity and honest capability-coverage claim, expressed
# as real facts against the SAME l5p: vocabulary the ggen repository's own
# .specify/pack-l5-promotion.ttl already defines (l5p:cap03/cap04/cap09 are
# that vocabulary's terms, reused here, not redefined) -- so a consumer or
# tool that already understands l5p: can read this pack's coverage claim
# directly, rather than trusting pack.toml's prose alone.
#
# No sparql: extraction is needed by this pack's templates (both generated
# tests are fully generic across any consumer, needing no domain facts), so
# this ontology exists to satisfy the marketplace pack contract (every pack
# needs at least one real RDF source at its root -- see
# docs/reference/pack-contract.md) and to make this pack's own coverage
# claim itself a checkable fact, not just prose.

mp:PackMaturityPack
    a mp:Pack ;
    rdfs:label "pack-maturity-pack" ;
    rdfs:comment "Generates cross-cutting regeneration-convergence and receipt-validity proofs for any composing consumer." ;
    mp:closesCapability l5p:cap03, l5p:cap04, l5p:cap09 .
