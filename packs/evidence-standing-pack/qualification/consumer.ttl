@prefix es: <https://ggen.dev/ontology/evidence-standing#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Minimal positive qualification fixture: a second, independently-named
# consequential action worked example a consumer pack could query against
# -- exercises the full identity/authority/receipt/replay/standing chain
# with real individuals distinct from the pack's own worked example, so
# scripts/qualify_packs.py's qualify_pack() has real facts to render and
# gates/010_no_receipt_no_standing.rq has more than one row to evaluate.
# This fixture is lawful (fully receipted) and must NOT trigger the gate.

es:ConsumerAgentAvery a es:Identity ;
    rdfs:label "A downstream consumer's real committing identity" .

es:ConsumerReleaseAuthority a es:Authority ;
    rdfs:label "A downstream consumer's own release authority" .

es:ConsumerAgentAvery es:holdsAuthority es:ConsumerReleaseAuthority .

es:ConsumerDeployAction a es:ConsequentialAction ;
    rdfs:label "A downstream consumer's deploy action, evidenced end to end" ;
    es:performedBy es:ConsumerAgentAvery ;
    es:hasReceipt es:Receipt-ConsumerDeploy-001 .

es:Receipt-ConsumerDeploy-001 a es:Receipt ;
    es:receiptId "consumer/deploy/001" ;
    es:forAction es:ConsumerDeployAction ;
    es:authorizedBy es:ConsumerReleaseAuthority .

es:Replay-ConsumerDeploy-001 a es:Replay ;
    rdfs:label "Independent replay of the consumer deploy receipt" ;
    es:replays es:Receipt-ConsumerDeploy-001 .

es:Standing-ConsumerDeploy-001 a es:Standing ;
    es:standingFor es:ConsumerDeployAction ;
    es:standingState es:ALIVE ;
    es:groundedBy es:Receipt-ConsumerDeploy-001 .
