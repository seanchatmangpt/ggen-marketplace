# Golden vectors: pipe-separated ops. Every language driver must print the
# same result line for every op. `case` resets the chain.
case lifecycle
append|e1|pending|unknown|batch-7|sort
append|e2|outcome|alive|batch-7|sort
seal|e3|alive|batch-7
verify
case order-violations
append|e1|outcome|alive|batch-7|sort
append|e2|pending|unknown|batch-7|sort
append|e3|outcome|partial_alive|batch-7|sort
seal|e4|blocked|batch-7
seal|e5|alive|batch-7
append|e6|pending|unknown|x|y
verify
case bad-enums
append|e1|running|unknown|s|a
append|e2|pending|refused|s|a
append|e3|pending|build_broken|s|a
append|e4|outcome|unsupported|s|a
verify
case tamper
append|e1|pending|unknown|s|a
append|e2|outcome|alive|s|a
verify
tamper
verify
case utf8
append|e1|pending|unknown|café-✓|a=b
append|e2|outcome|partial_alive|café-✓|a=b
verify
