@prefix es: <https://ggen.dev/ontology/evidence-standing#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

es:ExactSubject a rdfs:Class .
es:Observation a rdfs:Class .
es:Receipt a rdfs:Class .
es:Standing a rdfs:Class .
es:Evidence a rdfs:Class .
es:Provenance a rdfs:Class .
es:subject a rdf:Property .
es:provenance a rdf:Property .
es:receipt a rdf:Property .
es:standing a rdf:Property .
es:replayOf a rdf:Property .
es:UNKNOWN a es:Standing .
es:PARTIAL_ALIVE a es:Standing .
es:ALIVE a es:Standing .
es:BLOCKED a es:Standing .
es:BUILD_BROKEN a es:Standing .
es:UNSUPPORTED a es:Standing .
es:REFUSED a es:Standing .
