# FAIL witness for verify/040_algorithm_supported_set.unbound.rq -- expected >= 1 row.
# blake2b256 supports py only but the policy targets rs too: unsupported
# pair, gate 040 must fire.
@prefix es: <https://ggen.dev/ontology/evidence-standing#> .
@prefix w: <https://example.org/witness/> .

w:algo-b2b-bad a es:HashAlgorithm ; es:algorithmName "blake2b256" ;
    es:supportedIn w:lang-py2 .
w:lang-py2 a es:Language .
w:lang-rs2 a es:Language .
w:policy-b2b-bad a es:ChainPolicy ; es:hashAlgorithm w:algo-b2b-bad ;
    es:targetLanguage w:lang-py2, w:lang-rs2 .
