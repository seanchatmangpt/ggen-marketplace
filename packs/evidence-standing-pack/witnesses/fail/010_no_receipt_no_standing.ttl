# FAIL witness for verify/010_no_receipt_no_standing.unbound.rq -- expected >= 1 row.
# A Standing claim of ALIVE whose action carries no es:hasReceipt link at
# all: no evidentiary backing, gate 010 must fire.
@prefix es: <https://ggen.dev/ontology/evidence-standing#> .
@prefix w: <https://example.org/witness/> .

w:action-bare a es:ConsequentialAction .
w:standing-bare a es:Standing ;
    es:standingFor w:action-bare ;
    es:standingState es:ALIVE .
