# PASS witness for verify/060_outcome_requires_pending.unbound.rq -- expected 0 rows.
# Outcome entry (phase requires pending ref) names a pending-phase entry,
# same chain, same action, pending phase does not itself require a ref.
@prefix es: <https://ggen.dev/ontology/evidence-standing#> .
@prefix w: <https://example.org/witness/> .

w:phase-pending a es:Phase .
w:phase-outcome a es:Phase ; es:requiresPendingRef true .
w:pending-ok a es:ChainEntry ; es:entryPhase w:phase-pending ;
    es:chainId "chain-060" ; es:entryAction "act-060" .
w:outcome-ok a es:ChainEntry ; es:entryPhase w:phase-outcome ;
    es:chainId "chain-060" ; es:entryAction "act-060" ;
    es:pendingEntry w:pending-ok .
