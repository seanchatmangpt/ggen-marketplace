# PASS witness for verify/010_no_receipt_no_standing.unbound.rq -- expected 0 rows.
# Full evidentiary chain: Standing(ALIVE) for an action whose receipt is a
# real es:Receipt authorized by a real es:Authority. Lawful, gate silent.
@prefix es: <https://ggen.dev/ontology/evidence-standing#> .
@prefix w: <https://example.org/witness/> .

w:action-ok a es:ConsequentialAction ; es:hasReceipt w:receipt-ok .
w:receipt-ok a es:Receipt ; es:authorizedBy w:authority-ok .
w:authority-ok a es:Authority .
w:standing-ok a es:Standing ;
    es:standingFor w:action-ok ;
    es:standingState es:ALIVE .
