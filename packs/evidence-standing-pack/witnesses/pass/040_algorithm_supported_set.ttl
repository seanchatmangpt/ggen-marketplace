# PASS witness for verify/040_algorithm_supported_set.unbound.rq -- expected 0 rows.
# blake2b256 is supported in py only, and the policy targets py only.
@prefix es: <https://ggen.dev/ontology/evidence-standing#> .
@prefix w: <https://example.org/witness/> .

w:algo-b2b a es:HashAlgorithm ; es:algorithmName "blake2b256" ;
    es:supportedIn w:lang-py .
w:lang-py a es:Language .
w:policy-b2b-ok a es:ChainPolicy ; es:hashAlgorithm w:algo-b2b ;
    es:targetLanguage w:lang-py .
