# PASS witness for verify/070_unpaired_pending.unbound.rq -- expected 0 rows.
# Sealed chain whose only pending-phase entry IS named via es:pendingEntry
# by an outcome entry: no unpaired pending, gate silent.
@prefix es: <https://ggen.dev/ontology/evidence-standing#> .
@prefix w: <https://example.org/witness/> .

w:phase-pending-p a es:Phase .
w:phase-outcome-p a es:Phase ; es:requiresPendingRef true .
w:p-paired a es:ChainEntry ; es:entryPhase w:phase-pending-p ;
    es:chainId "chain-070" ; es:entryAction "act-070" .
w:o-paired a es:ChainEntry ; es:entryPhase w:phase-outcome-p ;
    es:chainId "chain-070" ; es:entryAction "act-070" ;
    es:pendingEntry w:p-paired .
w:seal-p a es:ChainEntry ; es:chainId "chain-070" ; es:isSeal true .
