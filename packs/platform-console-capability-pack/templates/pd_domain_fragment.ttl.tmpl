---
to: "output/platform-console-pd-domain.ttl"
sparql:
  caps: |
    PREFIX ce: <https://seanchatmangpt.github.io/chatman-ecosystem/ontology/capabilities#>
    PREFIX dct: <http://purl.org/dc/terms/>
    SELECT ?id ?title ?do_or_select ?reversible
    WHERE {
      ?cap a ce:Capability ; dct:title ?title ; ce:capabilityClass ?class ; ce:reversible ?reversible .
      BIND(REPLACE(?title, "[.]", "-") AS ?id)
      BIND(IF(?class = ce:Do, "do", "select") AS ?do_or_select)
    }
    ORDER BY ?title
---
# GENERATED by ggen from platform-console-capability-pack's admitted ce:Capability graph.
# One pd:Action per capability, matching autofde-lab's rdf-planning-domain.ttl pd:Action
# shape (rdf_domain.py compiles this same shape to PDDL text unmodified). Do not edit.
@prefix pd: <urn:autofde-lab:planning-domain:> .
@prefix pcc: <urn:platform-console:capability:> .
@prefix pcpd: <urn:platform-console:pd-domain:> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pcpd:platform-console a pd:Domain ;
    pd:domainName "platform_console" ;
{% for row in caps -%}
    pd:hasAction pcpd:action-{{ row.id }} ;
{% endfor -%}
    .

{% for row in caps %}
pcpd:action-{{ row.id }} a pd:Action ;
    pd:actionName "{{ row.id }}" ;
    pd:precondition [ a pd:Atom ; pd:predicateName "authority-admitted" ] ;
{% if row.do_or_select == "do" -%}
    pd:effect [ a pd:Atom ; pd:predicateName "capability-executed" ] ;
{% if row.reversible == false or row.reversible == "false" -%}
    pd:effect [ a pd:NegatedAtom ; pd:predicateName "state-reversible" ] ;
{% endif -%}
{% else -%}
    pd:effect [ a pd:Atom ; pd:predicateName "capability-observed" ] ;
{% endif -%}
    .
{% endfor %}
