@prefix ce: <https://seanchatmangpt.github.io/chatman-ecosystem/ontology/capabilities#> .
@prefix pcc: <urn:platform-console:capability:> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:platform-console:ontology:capability-pack>
    a owl:Ontology ;
    dcterms:title "Platform Console capability catalog" ;
    dcterms:description "Real RDF individuals for the ~30 ground-truth platform-console capabilities enumerated across castle.ts (CASTLE inventory verbs), approval-workflow.ts (ACTIONS_REQUIRING_APPROVAL maker-checker set), and the capability-intrinsic-not-yet-authority-gated set in k8s.ts/orgs.ts/capacity-reservations.ts/partners.ts. Each individual is typed both ce:Capability (chatman-ecosystem capability vocabulary: capabilityClass/requiredAuthority/brokerRequired/reversible/standing) and sosa:Procedure with dct:type pointing at a real consequence class (matching chatgptgym-gymact-bridge-pack's urn:gymact:consequence:{read,do} pattern) so gymact's OntologyDrivenProvider can parse this pack directly." ;
    dcterms:created "2026-08-19"^^xsd:date .


pcc:castle-verb-inventory-components
    a ce:Capability, sosa:Procedure ;
    dct:title "castle.verb.inventory-components" ;
    dct:type <urn:gymact:consequence:read> ;
    ce:capabilityClass ce:Select ;
    ce:executionOwner "castle.ts" ;
    ce:sourceRepository "platform-console" ;
    ce:requiredAuthority "castle.authority.inventory" ;
    ce:brokerRequired true ;
    ce:reversible true ;
    ce:standing "active" .

