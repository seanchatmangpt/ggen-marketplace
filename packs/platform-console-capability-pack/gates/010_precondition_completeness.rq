# MESSAGE: every ce:Capability must carry requiredAuthority, brokerRequired, and reversible; any row is a refusal.
PREFIX ce: <https://seanchatmangpt.github.io/chatman-ecosystem/ontology/capabilities#>
SELECT ?cap ?missing WHERE {
  ?cap a ce:Capability .
  VALUES ?missing { ce:requiredAuthority ce:brokerRequired ce:reversible ce:capabilityClass ce:standing }
  FILTER NOT EXISTS { ?cap ?missing ?value }
}
ORDER BY ?cap ?missing
