# MESSAGE: every capability named in the task's real IRREVERSIBLE/DESTRUCTIVE/FINANCIAL set
# (org.delete, dr.failover, dsar.erasure, sla.credit.apply, patch-sla.credit.apply,
# createRestoreJob, deleteProject, deleteOrg -- cross-checked against castle.ts/
# approval-workflow.ts source) must carry ce:reversible false; any row is a refusal that
# reversible=true was admitted for a capability the source enumeration marks irreversible.
PREFIX ce: <https://seanchatmangpt.github.io/chatman-ecosystem/ontology/capabilities#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?cap ?title ?problem WHERE {
  ?cap a ce:Capability ; dct:title ?title ; ce:reversible ?reversible .
  FILTER (
    ?title = "org.delete" ||
    ?title = "dr.failover" ||
    ?title = "dsar.erasure" ||
    ?title = "sla.credit.apply" ||
    ?title = "patch-sla.credit.apply" ||
    STRENDS(?title, "createRestoreJob") ||
    STRENDS(?title, "deleteProject") ||
    STRENDS(?title, "deleteOrg")
  )
  FILTER (?reversible != false)
  BIND("IRREVERSIBLE_SOURCE_CAPABILITY_MUST_HAVE_REVERSIBLE_FALSE" AS ?problem)
}
ORDER BY ?cap
