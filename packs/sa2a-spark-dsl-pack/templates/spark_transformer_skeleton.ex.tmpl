---
to: lib/sa2a/generated/sa2a_transformers.ex
sparql:
  results: "PREFIX spark: <urn:spark:dsl:> SELECT DISTINCT ?name ?source_file ?persist_key_list WHERE { ?t a spark:Transformer ; spark:sourceFile ?source_file ; spark:persistKeyList ?persist_key_list . BIND(STRAFTER(STR(?t), 'urn:sa2a:spark:') AS ?name) } ORDER BY ?name"
---

# Generated by sa2a-spark-dsl-pack from the sa2a:Transformer individuals in
# ontology.ttl. Do not edit -- regenerate via ggen sync.
#
# One Spark.Dsl.Transformer skeleton per sa2a:Transformer individual, in the
# landed style of lib/ash_a2a/transformers/build_capability_index.ex:
# `use Spark.Dsl.Transformer`, `after?/1 -> false` (runs before verification),
# flat `ash_a2a_*` persist keys, and a fail-closed `Spark.Error.DslError`
# (module:/path:) on violation.
{% for t in results %}
defmodule SA2A.Generated.Transformer.{{ t.name }} do
  @moduledoc """
  Generated compile-time transformer skeleton for `{{ t.name }}`.

  Source of truth (read, not copied): `{{ t.source_file }}`.

  Flat persist keys (written via `Spark.Dsl.Transformer.persist/2`, exactly
  the landed `ash_a2a_*` convention):

  {% for k in t.persist_key_list | split(pat=" ") %}  * `:{{ k }}`
  {% endfor %}
  """

  use Spark.Dsl.Transformer

  alias Spark.Dsl.Transformer

  @persist_keys ~w({{ t.persist_key_list }})a

  @impl true
  def after?(_), do: false

  @impl true
  def transform(dsl_state) do
    module = Transformer.get_persisted(dsl_state, :module)

    case module do
      nil ->
        {:error,
         Spark.Error.DslError.exception(
           module: module,
           path: [:a2a],
           message:
             "refused_missing_subject_module: transformer {{ t.name }} requires the " <>
               "DSL subject's module to be persisted before it runs",
           location: Spark.Dsl.Transformer.get_section_anno(dsl_state, [:a2a])
         )}

      _module ->
        dsl_state =
          @persist_keys
          |> Enum.reduce(dsl_state, fn key, dsl ->
            Transformer.persist(dsl, key, %{
              key: key,
              source: "sa2a-spark-dsl-pack",
              entities: length(Transformer.get_entities(dsl, [:a2a]))
            })
          end)

        {:ok, dsl_state}
    end
  end

  @doc false
  def __sa2a_persist_keys__, do: @persist_keys
end

{% endfor %}