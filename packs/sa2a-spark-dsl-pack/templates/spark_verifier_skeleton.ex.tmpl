---
to: lib/sa2a/generated/sa2a_verifiers.ex
sparql:
  results: "PREFIX spark: <urn:spark:dsl:> SELECT DISTINCT ?name ?source_file ?refusal_code_list WHERE { ?v a spark:Verifier ; spark:sourceFile ?source_file ; spark:refusalCodeList ?refusal_code_list . BIND(STRAFTER(STR(?v), 'urn:sa2a:spark:') AS ?name) } ORDER BY ?name"
---

# Generated by sa2a-spark-dsl-pack from the sa2a:Verifier individuals in
# ontology.ttl. Do not edit -- regenerate via ggen sync.
#
# One Spark.Dsl.Verifier skeleton per sa2a:Verifier individual, in the landed
# style of lib/ash_a2a/verifiers/verify_skills.ex: `use Spark.Dsl.Verifier`,
# `Spark.Error.DslError` with module:/path:, and named refusal codes so a
# refusal is an automation key, not prose.
{% for v in results %}
defmodule SA2A.Generated.Verifier.{{ v.name }} do
  @moduledoc """
  Generated compile-time verifier skeleton for `{{ v.name }}`.

  Source of truth (read, not copied): `{{ v.source_file }}`.

  Declared refusal codes (named, from the ontology -- raise these instead of
  prose-only errors so courts and gates can key on them):

  {% for c in v.refusal_code_list | split(pat=" ") %}  * `{{ c }}`
  {% endfor %}
  """

  use Spark.Dsl.Verifier

  alias Spark.Dsl.Verifier

  @refusal_codes ~w({{ v.refusal_code_list }})a

  @impl true
  def verify(dsl_state) do
    module = Verifier.get_persisted(dsl_state, :module)

    with :ok <- check_persisted_input(dsl_state, module) do
      :ok
    end
  end

  # Skeleton check: the transformer must have run and persisted its flat keys
  # before this verifier reads them. Replace the body with this verifier's real
  # invariants; keep the fail-closed shape: return `:ok` or
  # `{:error, %Spark.Error.DslError{}}`, never raise.
  defp check_persisted_input(dsl_state, module) do
    case Verifier.get_persisted(dsl_state, :sa2a_transformer_ran, false) do
      false ->
        {:error,
         Spark.Error.DslError.exception(
           module: module,
           path: [:a2a],
           message:
             "refused_transformer_did_not_run: verifier {{ v.name }} requires the " <>
               "companion transformer to have persisted its flat keys first",
           location: Spark.Dsl.Transformer.get_section_anno(dsl_state, [:a2a])
         )}

      _ran ->
        :ok
    end
  end

  @doc false
  def __sa2a_refusal_codes__, do: @refusal_codes
end

{% endfor %}