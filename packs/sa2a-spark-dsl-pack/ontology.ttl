@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix cmd: <urn:cmd:> .
@prefix spark: <urn:spark:dsl:> .
@prefix sa2a: <urn:sa2a:spark:> .

<urn:sa2a:spark>
    a owl:Ontology ;
    rdfs:label "SA2A Spark DSL Extension Ontology" ;
    rdfs:comment "Declarative Spark DSL schema and entities for AshA2A extensions." .

# --- Spark DSL Core Classes ---
spark:Extension a rdfs:Class ;
    rdfs:label "Spark DSL Extension" ;
    rdfs:comment "A Spark.Dsl.Extension module exposing sections, transformers, and verifiers." .

spark:Section a rdfs:Class ;
    rdfs:label "DSL Section" ;
    rdfs:comment "A top-level block in a Spark DSL declaration." .

spark:Entity a rdfs:Class ;
    rdfs:label "DSL Entity" ;
    rdfs:comment "A structured declarative entry within a Spark DSL section." .

spark:Transformer a rdfs:Class ;
    rdfs:label "Compile-time Transformer" ;
    rdfs:comment "A module transforming and compiling the Spark DSL state." .

spark:Verifier a rdfs:Class ;
    rdfs:label "Compile-time Verifier" ;
    rdfs:comment "A module verifying DSL invariants and failing closed on violations." .

# --- SA2A Sections & Entities ---
sa2a:A2AExtension a spark:Extension ;
    rdfs:label "AshA2A Extension" ;
    spark:hasSection sa2a:A2ASection, sa2a:AuthoritySection, sa2a:HooksSection, sa2a:ReceiptSection ;
    spark:hasTransformer sa2a:BuildCapabilityIndex ;
    spark:hasVerifier sa2a:VerifyTopology .

sa2a:A2ASection a spark:Section ;
    rdfs:label "a2a Section" ;
    spark:entity sa2a:SkillEntity .

sa2a:SkillEntity a spark:Entity ;
    rdfs:label "skill Entity" ;
    rdfs:comment "Declares public action overrides, tags, and consequence classification." .

sa2a:HooksSection a spark:Section ;
    rdfs:label "hooks Section" ;
    spark:entity sa2a:HookEntity .

sa2a:HookEntity a spark:Entity ;
    rdfs:label "hook Entity" ;
    rdfs:comment "Binds action lifecycle points to GraphLaw knowledge derivations." .

sa2a:AuthoritySection a spark:Section ;
    rdfs:label "authority Section" ;
    spark:entity sa2a:GateEntity .

sa2a:GateEntity a spark:Entity ;
    rdfs:label "two_port_gate Entity" ;
    rdfs:comment "Declares cryptographic pre-flight admission and lease requirements." .

sa2a:ReceiptSection a spark:Section ;
    rdfs:label "receipt Section" ;
    spark:entity sa2a:EvidenceEntity .

sa2a:EvidenceEntity a spark:Entity ;
    rdfs:label "evidence Entity" ;
    rdfs:comment "Declares exact-SHA hashing and replay verification requirements." .
