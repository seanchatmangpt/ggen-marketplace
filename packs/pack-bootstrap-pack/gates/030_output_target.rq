# Gate 030 (witness-reporting: >= 1 row PASS, zero rows FAIL).
# Refuses a bootstrap target that resolves to the bootstrap pack's own
# directory, via lexical comparison: a targetDir containing
# "pack-bootstrap-pack" yields ZERO rows, so the gate fails and the run
# is refused. (ADR 0010: an offender-shaped query would score inverted
# under the gates/ >= 1-row convention, so the exclusion is expressed as
# a witness: every ACCEPTED target emits a row.)
PREFIX bp: <https://ggen.dev/ontology/pack-bootstrap#>

SELECT ?packName ?targetDir WHERE {
  ?target a bp:BootstrapTarget ;
          bp:packName ?packName ;
          bp:targetDir ?targetDir .
  FILTER(!CONTAINS(STR(?targetDir), "pack-bootstrap-pack"))
}
ORDER BY ?packName ?targetDir
