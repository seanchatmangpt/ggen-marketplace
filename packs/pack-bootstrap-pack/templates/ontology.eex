<%
# Emits the generated pack's ontology.ttl: a minimal sj: graph carrying
# one sj:capabilityId per source class, sorted by IRI (source_classes is
# already ORDER BY ?classIri; Enum.sort_by keeps the render independent
# of query row order). Bindings:
#   source_classes -- [{classIri, ...}]
#   meta (single row) -- flattened packName/nsBase atoms
%>@prefix sj:   <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<%= "# Generated by pack-bootstrap-pack for pack: " <> packName %>

<%= Enum.map(
  Enum.sort_by(source_classes, & &1["classIri"]),
  fn c ->
    iri = c["classIri"]
    id = String.replace(iri, ~r{^.*[#/]}, "")
    "<urn:ggen:capability:#{id}> a sj:Capability ;\n    sj:capabilityId \"#{id}\" ;\n    sj:sourceClass <#{iri}> .\n"
  end
) |> Enum.join("\n") %>
