<%
# Emits the generated pack's verify/010_source_census.unbound.rq:
# offender query over the GENERATED sj: graph (ZERO rows PASS). Names
# every capability individual missing its sj:capabilityId.
%># Verify 010 (offender-reporting: ZERO rows PASS, >= 1 row FAIL).
# Inverted companion for the generated pack's census gate.
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>

SELECT ?subject WHERE {
  ?subject a sj:Capability .
  FILTER NOT EXISTS { ?subject sj:capabilityId ?id . }
}
ORDER BY ?subject
