<%
# Emits the generated pack's pack.toml. Bindings:
#   meta (single row) -- also flattened to top-level atoms:
#     packName, packVersion, nsBase, targetDir
# No timestamps: bytes must be byte-identical across replays.
%>
[pack]
name = "<%= packName %>"
version = "<%= packVersion %>"
description = """
Generated by pack-bootstrap-pack from a census of the source ontology
(nsBase <%= nsBase %>). Legacy-profile pack: no gp:profile in the graph.
"""
