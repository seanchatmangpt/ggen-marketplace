<%
# METATEMPLATE: emits the text of a generated pack's templates/ontology.eex.
# Every EEx marker in the emitted bytes is produced from a [[OPEN]] /
# [[CLOSE]] placeholder replaced by concatenated marker pieces inside this
# script block -- a literal "%>" never appears inside the script marker, so
# the emitted markers are TEXT, never executed at bootstrap render time.
o = "<%" <> "="
c = "%" <> ">"
out =
  ~S"""[[OPEN]] "# Capability-census ontology (generated by pack-bootstrap-pack)" [[CLOSE]]
@prefix sj:   <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

[[OPEN]] Enum.map(
  Enum.sort_by(capabilities, & &1["capabilityId"]),
  fn c ->
    id = c["capabilityId"]
    "<urn:ggen:capability:#{id}> a sj:Capability ;\n    sj:capabilityId \"#{id}\" .\n"
  end
) |> Enum.join("\n") [[CLOSE]]"""
  |> String.replace("[[OPEN]]", o)
  |> String.replace("[[CLOSE]]", c)
%><%= out %>
