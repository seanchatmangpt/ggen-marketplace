<%
# Emits the generated pack's gates/010_source_census.rq: a witness query
# over the GENERATED sj: graph (>= 1 sj:Capability row = PASS). Static
# text only -- no EEx markers survive into the emitted bytes.
%># Gate 010 (witness-reporting: >= 1 row PASS, zero rows FAIL).
# Census gate over the generated capability graph: the pack must expose
# at least one capability.
PREFIX sj: <https://ggen-igniter.dev/ontology/semantic-jira#>

SELECT ?capabilityId WHERE {
  ?c a sj:Capability ;
     sj:capabilityId ?capabilityId .
}
ORDER BY ?capabilityId
