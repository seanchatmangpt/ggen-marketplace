# Verify 010 (offender-reporting: ZERO rows PASS, >= 1 row FAIL).
# Inverted companion for gates/010_source_census.rq: names every census
# marker that is NOT backed by an actual class declaration — a
# bp:SourceClass-typed subject with no rdfs:Class / owl:Class typing.
# A row = a census entry that would be manufactured from a phantom.
PREFIX bp:   <https://ggen.dev/ontology/pack-bootstrap#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?subject WHERE {
  ?subject a bp:SourceClass .
  FILTER NOT EXISTS {
    { ?subject a rdfs:Class } UNION { ?subject a owl:Class }
  }
}
ORDER BY ?subject
