# Single-row meta query: the bootstrap target under manufacture.
# Exactly one bp:BootstrapTarget individual is expected in the input graph;
# its columns are flattened to top-level atom-keyed EEx bindings
# (packName, packVersion, nsBase, targetDir) by ggen_igniter's
# single-row-query convention.
PREFIX bp: <https://ggen.dev/ontology/pack-bootstrap#>

SELECT ?packName ?packVersion ?nsBase ?targetDir WHERE {
  ?target a bp:BootstrapTarget ;
          bp:packName ?packName ;
          bp:packVersion ?packVersion ;
          bp:nsBase ?nsBase ;
          bp:targetDir ?targetDir .
}
ORDER BY ?packName
