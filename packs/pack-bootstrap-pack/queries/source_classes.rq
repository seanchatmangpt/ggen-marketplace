# Source-class census: every rdfs:Class / owl:Class in the input graph
# outside the system namespaces (rdf:, rdfs:, owl:, xsd:, sh:) and the
# bp: meta-vocabulary itself. One row per class, deterministically
# ordered by IRI.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?classIri WHERE {
  { ?c a rdfs:Class } UNION { ?c a owl:Class }
  FILTER(
    !STRSTARTS(STR(?c), "http://www.w3.org/1999/02/22-rdf-syntax-ns#") &&
    !STRSTARTS(STR(?c), "http://www.w3.org/2000/01/rdf-schema#") &&
    !STRSTARTS(STR(?c), "http://www.w3.org/2002/07/owl#") &&
    !STRSTARTS(STR(?c), "http://www.w3.org/2001/XMLSchema#") &&
    !STRSTARTS(STR(?c), "http://www.w3.org/ns/shacl#") &&
    !STRSTARTS(STR(?c), "https://ggen.dev/ontology/pack-bootstrap#")
  )
  BIND(STR(?c) AS ?classIri)
}
ORDER BY ?classIri
