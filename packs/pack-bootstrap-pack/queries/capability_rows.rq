# Capability surface: one capability row per source class. The
# capabilityId is the class's local name (text after the last '/' or
# '#', via REPLACE over the trailing path segment). Sorted by IRI.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

SELECT ?capabilityId ?classIri WHERE {
  { ?c a rdfs:Class } UNION { ?c a owl:Class }
  FILTER(
    !STRSTARTS(STR(?c), "http://www.w3.org/1999/02/22-rdf-syntax-ns#") &&
    !STRSTARTS(STR(?c), "http://www.w3.org/2000/01/rdf-schema#") &&
    !STRSTARTS(STR(?c), "http://www.w3.org/2002/07/owl#") &&
    !STRSTARTS(STR(?c), "http://www.w3.org/2001/XMLSchema#") &&
    !STRSTARTS(STR(?c), "http://www.w3.org/ns/shacl#") &&
    !STRSTARTS(STR(?c), "https://ggen.dev/ontology/pack-bootstrap#")
  )
  BIND(STR(?c) AS ?classIri)
  BIND(REPLACE(STR(?c), "^.*[#/]", "") AS ?capabilityId)
}
ORDER BY ?classIri
