# Violation gate: an ig:Task row missing ANY required fact must refuse.
PREFIX ig: <https://ggen-igniter.dev/ontology/igniter-task#>
SELECT DISTINCT ?task ?missing WHERE {
  ?task a ig:Task .
  FILTER NOT EXISTS {
    ?task ig:taskName ?n ; ig:module ?m ; ig:group ?g ;
          ig:shortdoc ?sd ; ig:example ?e ; ig:moduledocBody ?b .
  }
  BIND("task row missing taskName/module/group/shortdoc/example/moduledocBody" AS ?missing)
}
