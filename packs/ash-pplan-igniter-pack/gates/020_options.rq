# Violation gate: an ig:Option row missing ANY required fact must refuse.
PREFIX ig: <https://ggen-igniter.dev/ontology/igniter-task#>
SELECT DISTINCT ?opt ?missing WHERE {
  ?opt a ig:Option .
  FILTER NOT EXISTS {
    ?opt ig:optionOf ?task ; ig:optName ?n ; ig:optType ?t ;
         ig:optRequired ?r ; ig:optHelp ?h .
  }
  BIND("option row missing optionOf/optName/optType/optRequired/optHelp" AS ?missing)
}
