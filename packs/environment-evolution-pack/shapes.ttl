@prefix ee: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/environment-evolution#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ee:EvolutionContractShape
  a sh:NodeShape ;
  sh:targetNode ee:contractV1 ;
  sh:property [
    sh:path ee:schema ;
    sh:hasValue "environment-evolution.v1" ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ee:authorityCeiling ;
    sh:hasValue "OBSERVE|SELECT|CONSTRUCT" ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ee:grantsDoAuthority ;
    sh:hasValue false ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ee:requestInvariant ;
    sh:hasValue "BYTE_IDENTICAL" ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ee:minDecisionPoints ;
    sh:hasValue 3 ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] .

ee:EvolutionVariantShape
  a sh:NodeShape ;
  sh:targetClass ee:EvolutionVariant ;
  sh:property [ sh:path ee:parentEnvironmentDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ee:taskRequestDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ee:referenceOutcomeDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ee:evaluatorDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ee:eventHistoryDigest ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ee:direction ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ee:decisionPoint ; sh:minCount 3 ] .

ee:DecisionPointShape
  a sh:NodeShape ;
  sh:targetClass ee:DecisionPoint ;
  sh:property [
    sh:path ee:decisionKind ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "temporal" "exclusion" "exception_rule" "numerical" )
  ] ;
  sh:property [ sh:path ee:plausibleWrongChoice ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path ee:resolvingEvidence ; sh:minCount 1 ] ;
  sh:property [ sh:path ee:rejectingCheck ; sh:minCount 1 ; sh:maxCount 1 ] .

ee:EvolutionEventShape
  a sh:NodeShape ;
  sh:targetClass ee:EvolutionEvent ;
  sh:property [
    sh:path ee:sequence ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] .
