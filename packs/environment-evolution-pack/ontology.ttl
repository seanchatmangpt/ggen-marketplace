@prefix ee: <https://seanchatmangpt.github.io/ggen-marketplace/ontology/environment-evolution#> .
@prefix sa2a: <https://spec.autofde.org/sa2a#> .
@prefix sjira: <urn:seanchatmangpt:sjira:v1#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ee:EnvironmentEvolution a skos:Concept ;
  skos:prefLabel "environment evolution" .

ee:EvolutionVariant a skos:Concept ;
  skos:prefLabel "evolved environment variant" .

ee:DecisionPoint a skos:Concept ;
  skos:prefLabel "counter-default decision point" .

ee:EvolutionEvent a skos:Concept ;
  skos:prefLabel "causal environment evolution event" .

ee:TemporalDecision a skos:Concept ;
  skos:prefLabel "temporal applicability decision" .

ee:ExclusionDecision a skos:Concept ;
  skos:prefLabel "exclusion decision" .

ee:ExceptionRuleDecision a skos:Concept ;
  skos:prefLabel "exception-rule decision" .

ee:NumericalDecision a skos:Concept ;
  skos:prefLabel "numerical recomputation decision" .

ee:contractV1
  a ee:EnvironmentEvolution, prov:Entity ;
  dcterms:title "Chatman Environment Evolution Contract v1" ;
  ee:schema "environment-evolution.v1" ;
  ee:authorityCeiling "OBSERVE|SELECT|CONSTRUCT" ;
  ee:grantsDoAuthority false ;
  ee:requestInvariant "BYTE_IDENTICAL" ;
  ee:minDecisionPoints 3 ;
  ee:requiresReferencePass true ;
  ee:requiresPriorReferenceFail true ;
  ee:requiresCausalHistory true ;
  ee:requiresStructuralValidation true ;
  ee:requiresAnswerValidation true ;
  ee:requiresExactParentIdentity true ;
  ee:requiresReplayIdentity true ;
  ee:acceptsFailureFeedback true ;
  ee:projectsWorkAs sjira:WorkOrder ;
  ee:projectsCandidateAs sa2a:Candidate ;
  ee:projectsHistoryAs prov:Activity .

ee:schema a prov:Property .
ee:authorityCeiling a prov:Property .
ee:grantsDoAuthority a prov:Property .
ee:requestInvariant a prov:Property .
ee:minDecisionPoints a prov:Property .
ee:requiresReferencePass a prov:Property .
ee:requiresPriorReferenceFail a prov:Property .
ee:requiresCausalHistory a prov:Property .
ee:requiresStructuralValidation a prov:Property .
ee:requiresAnswerValidation a prov:Property .
ee:requiresExactParentIdentity a prov:Property .
ee:requiresReplayIdentity a prov:Property .
ee:acceptsFailureFeedback a prov:Property .
ee:projectsWorkAs a prov:Property .
ee:projectsCandidateAs a prov:Property .
ee:projectsHistoryAs a prov:Property .
ee:parentEnvironmentDigest a prov:Property .
ee:taskRequestDigest a prov:Property .
ee:referenceOutcomeDigest a prov:Property .
ee:evaluatorDigest a prov:Property .
ee:eventHistoryDigest a prov:Property .
ee:decisionPoint a prov:Property .
ee:decisionKind a prov:Property .
ee:plausibleWrongChoice a prov:Property .
ee:resolvingEvidence a prov:Property .
ee:rejectingCheck a prov:Property .
ee:failureFeedbackDigest a prov:Property .
ee:direction a prov:Property .
ee:sequence a prov:Property .
ee:dependsOnEvent a prov:Property .
