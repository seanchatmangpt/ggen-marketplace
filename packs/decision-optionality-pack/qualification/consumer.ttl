@prefix do: <https://ggen.dev/ontology/decision-optionality#> .

# Synthetic green fixture: a consumer Frontier where the reversible
# candidate is exhausted (falsified) before the irreversible candidate is
# selected -- must pass gates/010_irreversible_before_reversible_exhausted.rq.

do:q-portfolio a do:Portfolio ;
    do:name "qualification-portfolio" .

do:q-frontier a do:Frontier ;
    do:name "qualification-frontier" ;
    do:partOf do:q-portfolio ;
    do:member do:q-cand-reversible, do:q-cand-irreversible .

do:q-falsifier a do:Falsifier ;
    do:falsifierName "qualification-falsifier" .

do:q-cand-reversible a do:Candidate ;
    do:name "qualification-reversible-candidate" ;
    do:reversible true ;
    do:status "falsified" ;
    do:falsifiedBy do:q-falsifier .

do:q-cand-irreversible a do:Candidate ;
    do:name "qualification-irreversible-candidate" ;
    do:reversible false ;
    do:status "available" .

do:q-selection a do:Selection ;
    do:selects do:q-cand-irreversible ;
    do:reversible false .
