@prefix do: <https://ggen.dev/ontology/decision-optionality#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

do:Candidate a rdfs:Class .
do:OptionSet a rdfs:Class .
do:EvidenceRequirement a rdfs:Class .
do:Falsifier a rdfs:Class .
do:Selection a rdfs:Class .
do:Rollback a rdfs:Class .
do:Frontier a rdfs:Class .
do:PriorArtSearch a rdfs:Class .
do:PriorArtClosure a rdfs:Class .
do:ResolutionMode a rdfs:Class .
do:member a rdf:Property .
do:requiresEvidence a rdf:Property .
do:falsifiedBy a rdf:Property .
do:dominates a rdf:Property .
do:rollback a rdf:Property .
do:reversible a rdf:Property .
do:selectionOrder a rdf:Property .
do:requiresFalsifier a rdf:Property .
do:requiresPriorArtClosure a rdf:Property .

do:Reuse a do:ResolutionMode ;
  do:selectionOrder 1 ;
  do:requiresFalsifier false .

do:Compose a do:ResolutionMode ;
  do:selectionOrder 2 ;
  do:requiresFalsifier false .

do:Extend a do:ResolutionMode ;
  do:selectionOrder 3 ;
  do:requiresFalsifier false .

do:Invent a do:ResolutionMode ;
  do:selectionOrder 4 ;
  do:requiresFalsifier true ;
  do:requiresPriorArtClosure true ;
  rdfs:comment "Invention is admissible only after reuse, composition and extension fail against an exact requirement and falsifier." .

do:DfCMLaw a do:OptionSet ;
  do:reversible true .

do:MinimumNoveltyLaw a do:OptionSet ;
  do:member do:Reuse, do:Compose, do:Extend, do:Invent ;
  do:requiresPriorArtClosure true ;
  rdfs:comment "Search public standards, ontologies, formal notations, algorithms, framework-native primitives, generators and existing capabilities before invention. Resolution order is reuse, compose, extend, invent." .
