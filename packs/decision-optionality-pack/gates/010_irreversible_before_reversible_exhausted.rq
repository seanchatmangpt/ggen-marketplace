# MESSAGE: an irreversible Selection was recorded while a reversible Candidate in the same OptionSet/Frontier still has status "available" -- DfCM law forbids irreversible selection before the lawful reversible frontier is exhausted; either select the still-available reversible candidate first, or retire it (falsifiedBy/status "selected") before recording this irreversible Selection
PREFIX do: <https://ggen.dev/ontology/decision-optionality#>
SELECT ?selection ?irreversibleCandidate ?liveReversibleCandidate WHERE {
  ?selection a do:Selection ;
             do:selects ?irreversibleCandidate .
  ?irreversibleCandidate a do:Candidate ;
                          do:reversible false .
  ?optionSet a do:OptionSet ;
             do:member ?irreversibleCandidate ;
             do:member ?liveReversibleCandidate .
  ?liveReversibleCandidate a do:Candidate ;
                            do:reversible true ;
                            do:status "available" .
  FILTER(?liveReversibleCandidate != ?irreversibleCandidate)
}
ORDER BY ?selection ?liveReversibleCandidate
