{
{% for row in rows %}
  "{{ row.path }}": {
    "ownership": "{{ row.ownershipId }}"{% if row.generator %},
    "generator": "{{ row.generator }}"{% endif %}{% if row.generatorDigest %},
    "generatorDigest": "{{ row.generatorDigest }}"{% endif %}{% if row.sourceOwner %},
    "sourceOwner": "{{ row.sourceOwner }}"{% endif %}{% if row.sourceDigest %},
    "sourceDigest": "{{ row.sourceDigest }}"{% endif %}{% if row.materializationReceiptDigest %},
    "materializationReceipt": "{{ row.materializationReceiptDigest }}"{% endif %}
  }{% if not loop.last %},{% endif %}
{% endfor %}
}
