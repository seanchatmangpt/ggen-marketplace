PREFIX errc: <https://ggen.dev/ontology/errc-ownership#>

SELECT ?subject ?predicate ?digest WHERE {
  VALUES ?predicate { errc:generatorDigest errc:sourceDigest errc:receiptDigest }
  ?subject ?predicate ?digest .
  FILTER(
    !isLiteral(?digest) ||
    !REGEX(STR(?digest), "^sha256:[0-9a-f]{64}$")
  )
}
