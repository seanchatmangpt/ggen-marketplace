PREFIX errc: <https://ggen.dev/ontology/errc-ownership#>
SELECT ?fact WHERE {
  ?fact a errc:FileOwnership ; errc:ownership errc:materialized .
  FILTER (
    NOT EXISTS { ?fact errc:sourceOwner ?owner } ||
    NOT EXISTS {
      ?fact errc:sourceDigest ?sourceDigest .
      FILTER(REGEX(STR(?sourceDigest), "^sha256:[0-9a-f]{64}$"))
    } ||
    NOT EXISTS {
      ?fact errc:materializationReceipt ?receipt .
      ?receipt a errc:MaterializationReceipt ;
        errc:receiptDigest ?receiptDigest .
      FILTER(REGEX(STR(?receiptDigest), "^sha256:[0-9a-f]{64}$"))
    }
  )
}
