PREFIX errc: <https://ggen.dev/ontology/errc-ownership#>
SELECT ?subject WHERE {
  ?subject a errc:RepositorySubject .
  FILTER (
    NOT EXISTS { ?subject errc:repository ?repository } ||
    NOT EXISTS {
      ?subject errc:subjectCommit ?commit .
      FILTER(REGEX(STR(?commit), "^[0-9a-f]{40}$"))
    }
  )
}
