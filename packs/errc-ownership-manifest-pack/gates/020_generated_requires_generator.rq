PREFIX errc: <https://ggen.dev/ontology/errc-ownership#>
SELECT ?fact WHERE {
  ?fact a errc:FileOwnership ; errc:ownership errc:generated .
  FILTER (
    NOT EXISTS { ?fact errc:generator ?generator } ||
    NOT EXISTS {
      ?fact errc:generatorDigest ?digest .
      FILTER(REGEX(STR(?digest), "^sha256:[0-9a-f]{64}$"))
    }
  )
}
