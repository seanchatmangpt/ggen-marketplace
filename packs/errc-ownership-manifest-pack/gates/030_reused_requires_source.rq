PREFIX errc: <https://ggen.dev/ontology/errc-ownership#>
SELECT ?fact WHERE {
  ?fact a errc:FileOwnership ; errc:ownership errc:reused .
  FILTER (
    NOT EXISTS { ?fact errc:sourceOwner ?owner } ||
    NOT EXISTS {
      ?fact errc:sourceDigest ?digest .
      FILTER(REGEX(STR(?digest), "^sha256:[0-9a-f]{64}$"))
    }
  )
}
