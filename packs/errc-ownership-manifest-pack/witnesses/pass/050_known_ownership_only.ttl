@prefix errc: <https://ggen.dev/ontology/errc-ownership#> .
@prefix ex: <https://example.test/errc/> .

ex:subject a errc:RepositorySubject ;
  errc:repository "seanchatmangpt/example" ;
  errc:subjectCommit "0123456789abcdef0123456789abcdef01234567" .

ex:hand a errc:FileOwnership ;
  errc:forSubject ex:subject ;
  errc:path "src/hand.mjs" ;
  errc:ownership errc:handwritten .

ex:generated a errc:FileOwnership ;
  errc:forSubject ex:subject ;
  errc:path "generated/types.mjs" ;
  errc:ownership errc:generated ;
  errc:generator "ggen:pack/types" ;
  errc:generatorDigest "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" .

ex:reused a errc:FileOwnership ;
  errc:forSubject ex:subject ;
  errc:path "vendor/reused.mjs" ;
  errc:ownership errc:reused ;
  errc:sourceOwner "ietf:example" ;
  errc:sourceDigest "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" .

ex:receipt a errc:MaterializationReceipt ;
  errc:receiptDigest "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" .

ex:materialized a errc:FileOwnership ;
  errc:forSubject ex:subject ;
  errc:path "generated/materialized.mjs" ;
  errc:ownership errc:materialized ;
  errc:sourceOwner "w3c:example" ;
  errc:sourceDigest "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" ;
  errc:materializationReceipt ex:receipt .
