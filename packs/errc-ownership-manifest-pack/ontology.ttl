@prefix errc: <https://ggen.dev/ontology/errc-ownership#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

errc:RepositorySubject a rdfs:Class, prov:Entity .
errc:FileOwnership a rdfs:Class, prov:Entity .
errc:Generator a rdfs:Class, prov:SoftwareAgent .
errc:SourceArtifact a rdfs:Class, prov:Entity .
errc:MaterializationReceipt a rdfs:Class, prov:Entity .

errc:repository a rdf:Property .
errc:subjectCommit a rdf:Property .
errc:path a rdf:Property .
errc:ownership a rdf:Property .
errc:forSubject a rdf:Property .
errc:generator a rdf:Property .
errc:generatorDigest a rdf:Property .
errc:sourceOwner a rdf:Property .
errc:sourceDigest a rdf:Property .
errc:materializationReceipt a rdf:Property .
errc:receiptDigest a rdf:Property .

errc:handwritten a errc:OwnershipKind ; dcterms:identifier "handwritten" .
errc:generated a errc:OwnershipKind ; dcterms:identifier "generated" .
errc:reused a errc:OwnershipKind ; dcterms:identifier "reused" .
errc:materialized a errc:OwnershipKind ; dcterms:identifier "materialized" .
errc:OwnershipKind a rdfs:Class .
