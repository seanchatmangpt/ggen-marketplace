PREFIX errc: <https://ggen.dev/ontology/errc-ownership#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?path ?ownershipId ?generator ?generatorDigest ?sourceOwner ?sourceDigest ?materializationReceiptDigest WHERE {
  ?fact a errc:FileOwnership ;
    errc:path ?path ;
    errc:ownership ?ownership .
  ?ownership dcterms:identifier ?ownershipId .

  OPTIONAL { ?fact errc:generator ?generator }
  OPTIONAL { ?fact errc:generatorDigest ?generatorDigest }
  OPTIONAL { ?fact errc:sourceOwner ?sourceOwner }
  OPTIONAL { ?fact errc:sourceDigest ?sourceDigest }
  OPTIONAL {
    ?fact errc:materializationReceipt ?receipt .
    ?receipt errc:receiptDigest ?materializationReceiptDigest .
  }
}
ORDER BY ?path
