PREFIX errc: <https://ggen.dev/ontology/errc-ownership#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?path ?ownershipId ?evidenceKind ?evidenceRef ?evidenceDigest WHERE {
  ?fact a errc:FileOwnership ; errc:path ?path ; errc:ownership ?ownership .
  ?ownership dcterms:identifier ?ownershipId .
  {
    ?fact errc:generator ?evidenceRef ; errc:generatorDigest ?evidenceDigest .
    BIND("generator" AS ?evidenceKind)
  } UNION {
    ?fact errc:sourceOwner ?evidenceRef ; errc:sourceDigest ?evidenceDigest .
    BIND("source" AS ?evidenceKind)
  } UNION {
    ?fact errc:materializationReceipt ?receipt .
    ?receipt errc:receiptDigest ?evidenceDigest .
    BIND(STR(?receipt) AS ?evidenceRef)
    BIND("receipt" AS ?evidenceKind)
  }
}
ORDER BY ?path ?ownershipId ?evidenceKind
