PREFIX errc: <https://ggen.dev/ontology/errc-ownership#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?path ?ownershipId ?generator ?generatorDigest ?sourceOwner ?sourceDigest ?receiptDigest WHERE {
 ?fact a errc:FileOwnership ; errc:path ?path ; errc:ownership ?ownership .
 ?ownership dcterms:identifier ?ownershipId .
 OPTIONAL { ?fact errc:generator ?generator ; errc:generatorDigest ?generatorDigest . }
 OPTIONAL { ?fact errc:sourceOwner ?sourceOwner ; errc:sourceDigest ?sourceDigest . }
 OPTIONAL { ?fact errc:materializationReceipt ?receipt . ?receipt errc:receiptDigest ?receiptDigest . }
}
ORDER BY ?path ?ownershipId
