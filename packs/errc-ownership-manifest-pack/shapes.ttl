@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix errc: <https://ggen.dev/ontology/errc-ownership#> .

errc:RepositorySubjectShape a sh:NodeShape ;
  sh:targetClass errc:RepositorySubject ;
  sh:property [ sh:path errc:repository ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path errc:subjectCommit ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{40}$" ] .

errc:FileOwnershipShape a sh:NodeShape ;
  sh:targetClass errc:FileOwnership ;
  sh:property [ sh:path errc:forSubject ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path errc:path ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path errc:ownership ; sh:minCount 1 ; sh:maxCount 1 ] .
