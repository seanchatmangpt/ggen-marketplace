---
to: "output/{{ row.name }}/kind-config.yaml"
force: true
determinism: true
sparql:
  kc_cluster: |
    PREFIX pech2: <https://ggen.io/ontology/platform-eng-handbook-ch02#>
    SELECT ?g ?name ?image WHERE {
      ?g a pech2:PlatformCluster ;
         pech2:clusterName ?name ;
         pech2:nodeImage   ?image .
    } ORDER BY ?name
  kc_ports: |
    PREFIX pech2: <https://ggen.io/ontology/platform-eng-handbook-ch02#>
    SELECT ?g ?order ?containerPort ?hostPort ?protocol WHERE {
      ?g a pech2:PlatformCluster ;
         pech2:hasPortMapping ?m .
      ?m pech2:mappingOrder  ?order ;
         pech2:containerPort ?containerPort ;
         pech2:hostPort      ?hostPort ;
         pech2:portProtocol  ?protocol .
    } ORDER BY ?g ?order
---
# GENERATED by `ggen sync` from packs/platform-engineers-handbook-ch02-cluster-pack/ontology.ttl
# -- do not edit by hand. Structure adapted verbatim from Ch02's real, previously-validated
# /tmp/platform-engineers-handbook-src/Ch02/kind-config.yaml (single control-plane node,
# ingress-ready node label, extraPortMappings). Cluster name, node image, and port mappings
# below are bound from this pack's ontology -- never hand-edited here.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: {{ row.name }}
nodes:
- role: control-plane
  image: {{ row.image }}
  kubeadmConfigPatches:
  - |
    kind: InitConfiguration
    nodeRegistration:
      kubeletExtraArgs:
        node-labels: "ingress-ready=true"
  extraPortMappings:
{%- for p in kc_ports | filter(attribute="g", value=row.g) %}
  - containerPort: {{ p.containerPort }}
    hostPort: {{ p.hostPort }}
    protocol: {{ p.protocol }}
{%- endfor %}
