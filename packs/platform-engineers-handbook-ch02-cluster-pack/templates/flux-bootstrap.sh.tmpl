---
to: "output/{{ row.name }}/flux-bootstrap.sh"
force: true
determinism: true
sparql:
  fb_cluster: |
    PREFIX pech2: <https://ggen.io/ontology/platform-eng-handbook-ch02#>
    SELECT ?g ?name ?bootstrapped ?url ?branch ?path WHERE {
      ?g a pech2:PlatformCluster ;
         pech2:clusterName      ?name ;
         pech2:fluxBootstrapped ?bootstrapped .
      OPTIONAL {
        ?g pech2:fluxGitRepoUrl ?url ;
           pech2:fluxGitBranch  ?branch ;
           pech2:fluxPath       ?path .
      }
    } ORDER BY ?name
---
#!/usr/bin/env bash
# GENERATED by `ggen sync` from packs/platform-engineers-handbook-ch02-cluster-pack/ontology.ttl
# -- do not edit by hand. App-of-Apps GitOps bootstrap invocation, matching the source and
# path conventions of Ch02's real modules/flux.py (FluxSourceConfig / FluxAppOfAppsManager.
# create_root_application()). Whether this script performs a real bootstrap or a documented
# no-op is bound from pech2:fluxBootstrapped -- never hand-edited here.
set -euo pipefail

CLUSTER_NAME="{{ row.name }}"

{%- if row.bootstrapped == "true" or row.bootstrapped == true %}

echo "Bootstrapping Flux (App-of-Apps) on kind cluster ${CLUSTER_NAME}..."
flux bootstrap git \
  --context "kind-${CLUSTER_NAME}" \
  --url="{{ row.url }}" \
  --branch="{{ row.branch }}" \
  --path="{{ row.path }}"

echo "Flux bootstrapped on ${CLUSTER_NAME} (repo={{ row.url }}, branch={{ row.branch }}, path={{ row.path }})."
{%- else %}

echo "Flux bootstrap SKIPPED for ${CLUSTER_NAME} (pech2:fluxBootstrapped=false in ontology.ttl)."
echo "This environment's cluster-foundation render intentionally omits GitOps wiring --"
echo "see pech2:fluxBootstrapped's rdfs:comment in ontology.ttl for why."
{%- endif %}
