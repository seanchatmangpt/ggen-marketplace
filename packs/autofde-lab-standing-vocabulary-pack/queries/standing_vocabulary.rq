PREFIX afl: <urn:autofde-lab:>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?kind ?label ?class_name ?description ?parent ?lawful
WHERE {
  {
    ?s a skos:Concept ;
       skos:prefLabel ?label ;
       dct:title ?class_name ;
       dct:description ?description ;
       afl:parentClass ?parent .
    FILTER (?parent != "")
    BIND("standing" AS ?kind)
    BIND("" AS ?lawful)
  }
  UNION
  {
    ?v afl:lawfulStanding ?lawful ;
       dct:title ?class_name ;
       dct:description ?description .
    BIND("violation" AS ?kind)
    BIND("" AS ?label)
    BIND("" AS ?parent)
  }
}
ORDER BY ?kind ?parent ?class_name
