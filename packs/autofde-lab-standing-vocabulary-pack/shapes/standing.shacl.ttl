@prefix afl:  <urn:autofde-lab:> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<urn:autofde-lab:shape:standing-concept>
    a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "Every standing concept must carry exactly one class name (dct:title)."
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A standing without a description asserts nothing; standing-law requires the reason."
    ] .

<urn:autofde-lab:shape:transition-violation>
    a sh:NodeShape ;
    sh:targetSubjectsOf afl:lawfulStanding ;
    sh:property [
        sh:path afl:lawfulStanding ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:in ( "NOT_RUN" "ABSENT" "UNKNOWN" "BUILD_BROKEN" "UNSUPPORTED" "CONFIGURATION_VALIDATED" ) ;
        sh:message "A transition violation must name exactly one lawful standing drawn from the vocabulary."
    ] ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A transition violation must name the class it generates."
    ] .
