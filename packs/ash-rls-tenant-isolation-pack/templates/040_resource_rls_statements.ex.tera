---
to: "priv/generated/rls_custom_statements_catalog.exs"
force: true
sparql:
  tables: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?tableName ?schema ?tenantColumn ?nullableTenant ?platformBypass ?policyName
    WHERE {
      ?t a rls:TenantScopedTable ;
         rls:tableName ?tableName .
      OPTIONAL { ?t rls:schema ?schema }
      OPTIONAL { ?t rls:tenantColumn ?tenantColumn }
      OPTIONAL { ?t rls:nullableTenant ?nullableTenantOpt }
      OPTIONAL { ?t rls:platformBypass ?platformBypassOpt }
      BIND(COALESCE(?nullableTenantOpt, false) AS ?nullableTenant)
      BIND(COALESCE(?platformBypassOpt, true) AS ?platformBypass)
      OPTIONAL {
        ?t rls:hasPolicy ?pol .
        OPTIONAL { ?pol rls:policyName ?policyName }
      }
    }
    ORDER BY ?tableName
  gucs: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?gucName ?gucPurpose WHERE {
      ?g a rls:TenantGuc ; rls:gucName ?gucName ; rls:gucPurpose ?gucPurpose .
    }
    ORDER BY ?gucPurpose
---
{% set tenant_guc = "app.current_tenant_id" -%}
{% set platform_guc = "app.rls_platform" -%}
{% for g in gucs -%}
{% if g.gucPurpose == "tenant-binding" %}{% set_global tenant_guc = g.gucName %}{% endif -%}
{% if g.gucPurpose == "platform-bypass" %}{% set_global platform_guc = g.gucName %}{% endif -%}
{% endfor -%}
# GENERATED by ggen sync from ash-rls-tenant-isolation-pack.
# AshPostgres custom_statements catalog — one entry per rls:TenantScopedTable.
# Prefer the bulk migration (010) for fleet enablement; use these fragments when
# a resource must own ENABLE/FORCE/POLICY via postgres custom_statements.

%{
{% for t in tables -%}
{% set col = t.tenantColumn | default(value="tenant_id") -%}
{% set pol = t.policyName | default(value="tenant_isolation") -%}
{% set nullable_raw = t.nullableTenant | default(value=false) -%}
{% set bypass_raw = t.platformBypass | default(value=true) -%}
{% set nullable = nullable_raw == true or nullable_raw == "true" -%}
{% set bypass = bypass_raw != false and bypass_raw != "false" -%}
{% if nullable and bypass -%}
{% set using_body = col ~ " IS NULL OR " ~ col ~ " = nullif(current_setting('" ~ tenant_guc ~ "', true), '')::uuid OR current_setting('" ~ platform_guc ~ "', true) = 'on'" -%}
{% elif nullable -%}
{% set using_body = col ~ " IS NULL OR " ~ col ~ " = nullif(current_setting('" ~ tenant_guc ~ "', true), '')::uuid" -%}
{% elif bypass -%}
{% set using_body = col ~ " = nullif(current_setting('" ~ tenant_guc ~ "', true), '')::uuid OR current_setting('" ~ platform_guc ~ "', true) = 'on'" -%}
{% else -%}
{% set using_body = col ~ " = nullif(current_setting('" ~ tenant_guc ~ "', true), '')::uuid" -%}
{% endif -%}
  "{{ t.tableName }}": %{
    enable_up: "ALTER TABLE {{ t.tableName }} ENABLE ROW LEVEL SECURITY",
    enable_down: "ALTER TABLE {{ t.tableName }} DISABLE ROW LEVEL SECURITY",
    force_up: "ALTER TABLE {{ t.tableName }} FORCE ROW LEVEL SECURITY",
    force_down: "ALTER TABLE {{ t.tableName }} NO FORCE ROW LEVEL SECURITY",
    policy_up: """
    CREATE POLICY {{ pol }} ON {{ t.tableName }}
      USING ({{ using_body }})
      WITH CHECK ({{ using_body }});
    """,
    policy_down: "DROP POLICY IF EXISTS {{ pol }} ON {{ t.tableName }}"
  },
{% endfor -%}
}
