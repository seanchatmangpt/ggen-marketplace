---
to: "test/rls_court_test.exs"
force: true
sparql:
  court: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?courtModule ?probeTable ?courtRole ?outputPath ?repoModule WHERE {
      ?c a rls:RlsCourt ;
         rls:courtModule ?courtModule ;
         rls:probeTable ?probeTable ;
         rls:courtRole ?courtRole .
      OPTIONAL { ?c rls:outputPath ?outputPath }
      OPTIONAL {
        ?c rls:usesRepo ?repo .
        ?repo rls:repoModule ?repoModule .
      }
    }
    LIMIT 1
  exclusions: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?excludedTableName ?exclusionReason WHERE {
      ?e a rls:CatalogExclusion ;
         rls:excludedTableName ?excludedTableName .
      OPTIONAL { ?e rls:exclusionReason ?exclusionReason }
    }
    ORDER BY ?excludedTableName
  known_covered: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?tableName WHERE {
      ?t a rls:TenantScopedTable ;
         rls:tableName ?tableName .
    }
    ORDER BY ?tableName
  gucs: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?gucName ?gucPurpose ?gucOnValue WHERE {
      ?g a rls:TenantGuc ; rls:gucName ?gucName ; rls:gucPurpose ?gucPurpose .
      OPTIONAL { ?g rls:gucOnValue ?gucOnValue }
    }
    ORDER BY ?gucPurpose
---
{% set_global court_module = "RlsCourtTest" -%}
{% set_global probe_table = "work_orders" -%}
{% set_global court_role = "rls_court_app" -%}
{% set_global repo_module = "Repo" -%}
{% if court and court | length > 0 -%}
{% set c = court | first -%}
{% if c.courtModule %}{% set_global court_module = c.courtModule %}{% endif -%}
{% if c.probeTable %}{% set_global probe_table = c.probeTable %}{% endif -%}
{% if c.courtRole %}{% set_global court_role = c.courtRole %}{% endif -%}
{% if c.repoModule %}{% set_global repo_module = c.repoModule %}{% endif -%}
{% endif -%}
{% set tenant_guc = "app.current_tenant_id" -%}
{% set platform_guc = "app.rls_platform" -%}
{% set platform_on = "on" -%}
{% for g in gucs -%}
{% if g.gucPurpose == "tenant-binding" %}{% set_global tenant_guc = g.gucName %}{% endif -%}
{% if g.gucPurpose == "platform-bypass" %}{% set_global platform_guc = g.gucName %}{% set_global platform_on = g.gucOnValue | default(value="on") %}{% endif -%}
{% endfor -%}
# GENERATED by ggen sync from ash-rls-tenant-isolation-pack.
# Do not edit. Regenerate with `ggen sync run`.
#
# DB-enforced RLS court, real Postgres, no doubles.
# Catalog: every public tenant_id table outside exclusions has
#   relrowsecurity AND relforcerowsecurity and a tenant_isolation policy.
# Behavior: NOSUPERUSER NOBYPASSRLS role sees only current tenant, nothing
#   without the tenant GUC, everything under platform bypass, WITH CHECK
#   refuses cross-tenant inserts.

defmodule {{ court_module }} do
  use ExUnit.Case, async: false

  alias {{ repo_module }}, as: Repo

  @table "{{ probe_table }}"
  @role "{{ court_role }}"
  @tenant_guc "{{ tenant_guc }}"
  @platform_guc "{{ platform_guc }}"
  @platform_on "{{ platform_on }}"

  @catalog_exclusions ~w(
{% for e in exclusions %}    {{ e.excludedTableName }}
{% endfor %}  )

  @known_covered ~w(
{% for t in known_covered %}    {{ t.tableName }}
{% endfor %}  )

  setup do
    :ok = Ecto.Adapters.SQL.Sandbox.checkout(Repo)

    case Repo.query!("SELECT rolsuper FROM pg_roles WHERE rolname = current_user").rows do
      [[true]] ->
        :ok

      _ ->
        flunk(
          "SKIP-REASON: RLS court needs a superuser connection to create the test role; " <>
            "current_user is not a superuser."
        )
    end

    Repo.query!("""
    DO $$
    BEGIN
      IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '#{@role}') THEN
        CREATE ROLE #{@role} NOSUPERUSER NOBYPASSRLS;
      END IF;
    END
    $$;
    """)

    Repo.query!("GRANT USAGE ON SCHEMA public TO #{@role}")
    Repo.query!("GRANT SELECT, INSERT ON #{@table} TO #{@role}")
    :ok
  end

  describe "tenant isolation as a non-bypass role" do
    test "only the current tenant's rows are visible; none without it; all under platform" do
      a = Ecto.UUID.generate()
      b = Ecto.UUID.generate()
      id_a = Ecto.UUID.generate()
      id_b = Ecto.UUID.generate()

      Repo.query!("SET LOCAL session_replication_role = replica")
      insert_row!(id_a, a)
      insert_row!(id_b, b)
      Repo.query!("SET LOCAL session_replication_role = origin")

      ids = [id_a, id_b]

      Repo.query!("SET LOCAL ROLE #{@role}")

      assert visible(ids) == []

      set_tenant(a)
      assert visible(ids) == [{id_a, a}]

      set_tenant(b)
      assert visible(ids) == [{id_b, b}]

      set_tenant("")
      assert visible(ids) == []

      Repo.query!("SELECT set_config($1, $2, true)", [@platform_guc, @platform_on])
      assert Enum.sort(visible(ids)) == Enum.sort([{id_a, a}, {id_b, b}])

      Repo.query!("SELECT set_config($1, $2, true)", [@platform_guc, "off"])
      assert visible(ids) == []
    end

    test "WITH CHECK refuses an insert for a different tenant, accepts the own tenant" do
      a = Ecto.UUID.generate()
      b = Ecto.UUID.generate()
      own_id = Ecto.UUID.generate()
      foreign_id = Ecto.UUID.generate()

      Repo.query!("SET LOCAL session_replication_role = replica")
      Repo.query!("SET LOCAL ROLE #{@role}")
      set_tenant(a)

      assert {:error, %Postgrex.Error{postgres: %{code: :insufficient_privilege}}} =
               try_insert(foreign_id, b)

      assert {:ok, _} = try_insert(own_id, a)
      assert visible([own_id, foreign_id]) == [{own_id, a}]
    end
  end

  describe "catalog" do
    test "every tenant_id table outside the allowlist has ENABLE + FORCE row level security" do
      tables = tenant_tables()

      for t <- @known_covered do
        assert t in tables,
               "expected #{t} to carry a tenant_id column (known RLS-covered table); " <>
                 "catalog saw #{inspect(tables)}"
      end

      expected = tables -- @catalog_exclusions
      assert expected != [], "catalog court is vacuous: no tenant_id tables found"

      flags =
        Repo.query!(
          """
          SELECT c.relname, c.relrowsecurity, c.relforcerowsecurity
          FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
          WHERE n.nspname = 'public' AND c.relname = ANY($1)
          """,
          [expected]
        ).rows
        |> Map.new(fn [name, rls, force] -> {name, {rls, force}} end)

      missing_enable = for t <- expected, match?({false, _}, flags[t]), do: t
      missing_force = for t <- expected, match?({_, false}, flags[t]), do: t

      assert missing_enable == [],
             "tenant_id tables without ENABLE ROW LEVEL SECURITY: #{inspect(missing_enable)}"

      assert missing_force == [],
             "tenant_id tables without FORCE ROW LEVEL SECURITY: #{inspect(missing_force)}"
    end

    test "every RLS-enabled tenant_id table has a tenant_isolation policy" do
      expected = tenant_tables() -- @catalog_exclusions

      with_policy =
        Repo.query!(
          "SELECT DISTINCT tablename FROM pg_policies WHERE schemaname = 'public' AND policyname = 'tenant_isolation'"
        ).rows
        |> List.flatten()

      assert expected -- with_policy == []
    end
  end

  defp tenant_tables do
    Repo.query!("""
    SELECT c.relname
    FROM pg_class c
    JOIN pg_namespace n ON n.oid = c.relnamespace
    JOIN pg_attribute a ON a.attrelid = c.oid
    WHERE n.nspname = 'public'
      AND c.relkind IN ('r', 'p')
      AND a.attname = 'tenant_id'
      AND a.attnum > 0
      AND NOT a.attisdropped
    ORDER BY c.relname
    """).rows
    |> List.flatten()
  end

  defp set_tenant(value) do
    Repo.query!("SELECT set_config($1, $2, true)", [@tenant_guc, value])
  end

  defp visible(ids) do
    uuids = Enum.map(ids, &Ecto.UUID.dump!/1)

    Repo.query!("SELECT id, tenant_id FROM #{@table} WHERE id = ANY($1)", [uuids]).rows
    |> Enum.map(fn [id, t] -> {Ecto.UUID.load!(id), Ecto.UUID.load!(t)} end)
  end

  defp try_insert(id, tenant) do
    Repo.transaction(fn ->
      try do
        insert_row!(id, tenant)
      rescue
        e in Postgrex.Error -> Repo.rollback(e)
      end
    end)
  end

  defp insert_row!(id, tenant) do
    cols =
      Repo.query!(
        """
        SELECT a.attname, format_type(a.atttypid, a.atttypmod)
        FROM pg_attribute a
        WHERE a.attrelid = to_regclass('public.#{@table}')
          AND a.attnum > 0 AND NOT a.attisdropped
          AND a.attnotnull
          AND a.atthasdef = false
        ORDER BY a.attnum
        """
      ).rows

    {names, values} =
      Enum.map(cols, fn [name, typ] ->
        cond do
          name == "id" -> {name, Ecto.UUID.dump!(id)}
          name == "tenant_id" -> {name, Ecto.UUID.dump!(tenant)}
          String.contains?(typ, "uuid") -> {name, Ecto.UUID.dump!(Ecto.UUID.generate())}
          String.contains?(typ, "timestamp") -> {name, DateTime.utc_now()}
          String.contains?(typ, "boolean") -> {name, false}
          String.contains?(typ, "int") -> {name, 0}
          true -> {name, "rls-court"}
        end
      end)
      |> Enum.unzip()

    placeholders = Enum.map_join(1..length(names), ", ", &"$#{&1}")
    cols_sql = Enum.map_join(names, ", ", &"\"#{&1}\"")

    Repo.query!(
      "INSERT INTO #{@table} (#{cols_sql}) VALUES (#{placeholders}) RETURNING id",
      values
    )
  end
end
