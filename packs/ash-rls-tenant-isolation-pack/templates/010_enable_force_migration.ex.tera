---
to: "priv/repo/migrations/20260101000000_enable_tenant_rls_isolation_policy.exs"
force: true
sparql:
  migration: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?migrationModule ?migrationVersion WHERE {
      ?m a rls:IsolationMigration ;
         rls:migrationModule ?migrationModule .
      OPTIONAL { ?m rls:migrationVersion ?migrationVersion }
    }
    LIMIT 1
  tables: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?tableName ?schema ?tenantColumn ?nullableTenant ?platformBypass ?policyName
    WHERE {
      ?t a rls:TenantScopedTable ;
         rls:tableName ?tableName .
      OPTIONAL { ?t rls:schema ?schema }
      OPTIONAL { ?t rls:tenantColumn ?tenantColumn }
      OPTIONAL { ?t rls:nullableTenant ?nullableTenantOpt }
      OPTIONAL { ?t rls:platformBypass ?platformBypassOpt }
      BIND(COALESCE(?nullableTenantOpt, false) AS ?nullableTenant)
      BIND(COALESCE(?platformBypassOpt, true) AS ?platformBypass)
      OPTIONAL {
        ?t rls:hasPolicy ?pol .
        OPTIONAL { ?pol rls:policyName ?policyName }
      }
    }
    ORDER BY ?tableName
  gucs: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?gucName ?gucPurpose WHERE {
      ?g a rls:TenantGuc ; rls:gucName ?gucName ; rls:gucPurpose ?gucPurpose .
    }
    ORDER BY ?gucPurpose
---
{% set_global mig_module = "Repo.Migrations.EnableTenantRlsIsolationPolicy" -%}
{% if migration and migration | length > 0 -%}
{% set m0 = migration | first -%}
{% if m0.migrationModule %}{% set_global mig_module = m0.migrationModule %}{% endif -%}
{% endif -%}
{% set tenant_guc = "app.current_tenant_id" -%}
{% set platform_guc = "app.rls_platform" -%}
{% for g in gucs -%}
{% if g.gucPurpose == "tenant-binding" %}{% set_global tenant_guc = g.gucName %}{% endif -%}
{% if g.gucPurpose == "platform-bypass" %}{% set_global platform_guc = g.gucName %}{% endif -%}
{% endfor -%}
# GENERATED by ggen sync from ash-rls-tenant-isolation-pack.
# Do not edit. Regenerate with `ggen sync run`.
#
# Idempotent ENABLE + FORCE ROW LEVEL SECURITY and tenant_isolation policy
# for every admitted rls:TenantScopedTable. Missing tables are skipped.
# Policy shape: nullif(current_setting(tenant_guc), '')::uuid [+ IS NULL]
# OR platform GUC = 'on'.

defmodule {{ mig_module }} do
  use Ecto.Migration

  @tenant_tables ~w(
{% for t in tables %}    {{ t.tableName }}
{% endfor %}  )

  def up do
{% for t in tables -%}
{% set col = t.tenantColumn | default(value="tenant_id") -%}
{% set pol = t.policyName | default(value="tenant_isolation") -%}
{% set nullable_raw = t.nullableTenant | default(value=false) -%}
{% set bypass_raw = t.platformBypass | default(value=true) -%}
{% set nullable = nullable_raw == true or nullable_raw == "true" -%}
{% set bypass = bypass_raw != false and bypass_raw != "false" -%}
{% if nullable and bypass -%}
{% set using_body = col ~ " IS NULL OR " ~ col ~ " = nullif(current_setting('" ~ tenant_guc ~ "', true), '')::uuid OR current_setting('" ~ platform_guc ~ "', true) = 'on'" -%}
{% elif nullable -%}
{% set using_body = col ~ " IS NULL OR " ~ col ~ " = nullif(current_setting('" ~ tenant_guc ~ "', true), '')::uuid" -%}
{% elif bypass -%}
{% set using_body = col ~ " = nullif(current_setting('" ~ tenant_guc ~ "', true), '')::uuid OR current_setting('" ~ platform_guc ~ "', true) = 'on'" -%}
{% else -%}
{% set using_body = col ~ " = nullif(current_setting('" ~ tenant_guc ~ "', true), '')::uuid" -%}
{% endif -%}
    execute("""
    DO $rls$
    BEGIN
      IF to_regclass('{{ t.schema | default(value="public") }}.{{ t.tableName }}') IS NULL THEN
        RAISE NOTICE 'ash-rls-tenant-isolation skip missing table %', '{{ t.tableName }}';
        RETURN;
      END IF;

      ALTER TABLE {{ t.tableName }} ENABLE ROW LEVEL SECURITY;
      ALTER TABLE {{ t.tableName }} FORCE ROW LEVEL SECURITY;

      DROP POLICY IF EXISTS {{ pol }} ON {{ t.tableName }};
      CREATE POLICY {{ pol }} ON {{ t.tableName }}
        USING ({{ using_body }})
        WITH CHECK ({{ using_body }});

      DROP POLICY IF EXISTS tenant_isolation_policy ON {{ t.tableName }};
      CREATE POLICY tenant_isolation_policy ON {{ t.tableName }}
        USING ({{ using_body }})
        WITH CHECK ({{ using_body }});
    END
    $rls$;
    """)

{% endfor %}  end

  def down do
{% for t in tables %}    execute("""
    DO $rls$
    BEGIN
      IF to_regclass('{{ t.schema | default(value="public") }}.{{ t.tableName }}') IS NULL THEN
        RETURN;
      END IF;
      DROP POLICY IF EXISTS {{ t.policyName | default(value="tenant_isolation") }} ON {{ t.tableName }};
      DROP POLICY IF EXISTS tenant_isolation_policy ON {{ t.tableName }};
      ALTER TABLE {{ t.tableName }} NO FORCE ROW LEVEL SECURITY;
      ALTER TABLE {{ t.tableName }} DISABLE ROW LEVEL SECURITY;
    END
    $rls$;
    """)

{% endfor %}  end
end
