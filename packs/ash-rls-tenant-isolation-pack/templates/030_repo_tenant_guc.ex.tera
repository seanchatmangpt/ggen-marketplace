---
to: "lib/repo_tenant_guc.ex"
force: true
sparql:
  hook: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?repoModule ?outputPath ?failClosedNilTenant WHERE {
      ?h a rls:RepoTenantHook ;
         rls:repoModule ?repoModule .
      OPTIONAL { ?h rls:outputPath ?outputPath }
      OPTIONAL { ?h rls:failClosedNilTenant ?failClosedNilTenant }
    }
    LIMIT 1
  gucs: |
    PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
    SELECT ?gucName ?gucPurpose ?gucOnValue ?isLocal WHERE {
      ?g a rls:TenantGuc ; rls:gucName ?gucName ; rls:gucPurpose ?gucPurpose .
      OPTIONAL { ?g rls:gucOnValue ?gucOnValue }
      OPTIONAL { ?g rls:isLocal ?isLocal }
    }
    ORDER BY ?gucPurpose
---
{% set_global repo_module = "Repo" -%}
{% set_global fail_closed = true -%}
{% if hook and hook | length > 0 -%}
{% set h = hook | first -%}
{% if h.repoModule %}{% set_global repo_module = h.repoModule %}{% endif -%}
{% set fc = h.failClosedNilTenant | default(value=true) -%}
{% if fc == false or fc == "false" %}{% set_global fail_closed = false %}{% endif -%}
{% endif -%}
{% set tenant_guc = "app.current_tenant_id" -%}
{% set platform_guc = "app.rls_platform" -%}
{% set platform_on = "on" -%}
{% for g in gucs -%}
{% if g.gucPurpose == "tenant-binding" %}{% set_global tenant_guc = g.gucName %}{% endif -%}
{% if g.gucPurpose == "platform-bypass" %}{% set_global platform_guc = g.gucName %}{% set_global platform_on = g.gucOnValue | default(value="on") %}{% endif -%}
{% endfor -%}
# GENERATED by ggen sync from ash-rls-tenant-isolation-pack.
# Do not edit. Regenerate with `ggen sync run`.
#
# Mix this module into your AshPostgres.Repo (or call from on_transaction_begin/1).
# Binds transaction-local GUCs: {{ tenant_guc }} and {{ platform_guc }}.
# Fail-closed: nil tenant on multitenant resources raises TenantRequired;
# never invents a fallback UUID.

defmodule {{ repo_module }}.TenantGuc do
  @moduledoc false

  @tenant_setting "{{ tenant_guc }}"
  @platform_setting "{{ platform_guc }}"
  @platform_on "{{ platform_on }}"
  @platform_key {__MODULE__, :platform_scope}
  @actor_tenant_key {__MODULE__, :actor_tenant}

  @doc """
  AshPostgres.Repo callback body: resolve tenant from `reason[:tenant]` or
  process actor tenant, then `set_config(tenant_guc, value, true)` (SET LOCAL).
  Platform scope also sets platform GUC to on.
  """
  def on_transaction_begin(repo, reason) do
    case resolve_tenant(reason) do
      nil ->
        refuse_nil_tenant!(reason)

      tenant ->
        put_local(repo, @tenant_setting, tenant_to_string(tenant))
    end

    if platform_scope?(), do: put_local(repo, @platform_setting, @platform_on)
    :ok
  end

  def put_actor_tenant(nil) do
    Process.delete(@actor_tenant_key)
    :ok
  end

  def put_actor_tenant(actor_or_tenant) do
    case extract_tenant_id(actor_or_tenant) do
      nil -> Process.delete(@actor_tenant_key)
      id -> Process.put(@actor_tenant_key, id)
    end

    :ok
  end

  def clear_actor_tenant, do: put_actor_tenant(nil)

  def actor_tenant, do: Process.get(@actor_tenant_key)

  def platform(fun) when is_function(fun, 0), do: with_platform_scope(fun)

  def with_platform_scope(fun) when is_function(fun, 0) do
    previous = Process.put(@platform_key, true)

    try do
      fun.()
    after
      if previous, do: Process.put(@platform_key, previous), else: Process.delete(@platform_key)
    end
  end

  defp platform_scope?, do: Process.get(@platform_key) == true

  defp resolve_tenant(reason) when is_map(reason) do
    cond do
      match?(%{tenant: t} when not is_nil(t), reason) -> reason[:tenant]
      true -> Process.get(@actor_tenant_key)
    end
  end

  defp resolve_tenant(_), do: Process.get(@actor_tenant_key)

  defp extract_tenant_id(%{tenant_id: id}) when not is_nil(id), do: id
  defp extract_tenant_id(%{"tenant_id" => id}) when not is_nil(id), do: id
  defp extract_tenant_id(id) when is_binary(id), do: id
  defp extract_tenant_id(_), do: nil

  defp tenant_to_string(t) when is_binary(t), do: t
  defp tenant_to_string(t), do: to_string(t)

  defp put_local(repo, setting, value) do
    repo.query!("SELECT set_config($1, $2, true)", [setting, value])
    :ok
  end

{% if fail_closed %}
  defp refuse_nil_tenant!(reason) do
    # Multitenant Ash resources must not open a transaction without a tenant.
    # Non-multitenant / platform-scope callers leave the GUC unset (fail closed at RLS).
    if platform_scope?() do
      :ok
    else
      raise Ash.Error.Invalid.TenantRequired,
        message:
          "tenant required for RLS binding of #{@tenant_setting}; reason=#{inspect(reason)}"
    end
  end
{% else %}
  defp refuse_nil_tenant!(_reason), do: :ok
{% endif %}
end
