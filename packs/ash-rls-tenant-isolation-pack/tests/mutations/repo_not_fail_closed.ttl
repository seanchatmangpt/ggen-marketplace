# Falsifier for gates/070_repo_fail_closed.rq — RepoTenantHook with failClosedNilTenant false (>=1 row).
@prefix rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#> .
@prefix ex:  <https://example.org/ash-rls-mutation#> .

ex:RepoNotFailClosed a rls:RepoTenantHook ;
    rls:repoModule "Mutation.Repo" ;
    rls:failClosedNilTenant false .
