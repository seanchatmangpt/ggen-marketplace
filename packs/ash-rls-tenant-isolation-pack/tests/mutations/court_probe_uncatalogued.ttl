# Falsifier for gates/040_court_probe_in_catalog.rq — probeTable not a TenantScopedTable (>=1 row).
@prefix rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#> .
@prefix ex:  <https://example.org/ash-rls-mutation#> .

ex:OrphanProbeCourt a rls:RlsCourt ;
    rls:courtModule "Mutation.OrphanProbeCourt" ;
    rls:probeTable "not_in_catalog" ;
    rls:courtRole "rls_court_mutation" .
