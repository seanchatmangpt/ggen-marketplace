# Falsifier for gates/050_table_name_required.rq — TenantScopedTable without tableName (>=1 row).
@prefix rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#> .
@prefix ex:  <https://example.org/ash-rls-mutation#> .

ex:TableMissingName a rls:TenantScopedTable ;
    rls:enableRls true ;
    rls:forceRls true .
