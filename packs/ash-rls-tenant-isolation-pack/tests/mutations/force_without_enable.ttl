# Falsifier for gates/010_force_requires_enable.rq — forceRls=true with enableRls=false (>=1 row).
@prefix rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#> .
@prefix ex:  <https://example.org/ash-rls-mutation#> .

ex:ForceWithoutEnable a rls:TenantScopedTable ;
    rls:tableName "force_without_enable" ;
    rls:enableRls false ;
    rls:forceRls true .
