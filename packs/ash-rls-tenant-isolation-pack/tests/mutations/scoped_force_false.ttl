# Falsifier for gates/020_scoped_table_requires_policy_or_default.rq — TenantScopedTable with forceRls=false (>=1 row).
@prefix rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#> .
@prefix ex:  <https://example.org/ash-rls-mutation#> .

ex:ScopedForceFalse a rls:TenantScopedTable ;
    rls:tableName "scoped_force_false" ;
    rls:forceRls false .
