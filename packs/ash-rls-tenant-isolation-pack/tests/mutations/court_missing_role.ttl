# Falsifier for gates/060_court_required_fields.rq — RlsCourt without courtRole (>=1 row).
@prefix rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#> .
@prefix ex:  <https://example.org/ash-rls-mutation#> .

ex:CourtMissingRole a rls:RlsCourt ;
    rls:courtModule "Mutation.CourtMissingRole" ;
    rls:probeTable "work_orders" .
