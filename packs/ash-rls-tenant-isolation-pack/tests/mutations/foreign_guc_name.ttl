# Falsifier for gates/030_guc_names_closed.rq — TenantGuc outside closed names (>=1 row).
@prefix rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#> .
@prefix ex:  <https://example.org/ash-rls-mutation#> .

ex:ForeignGuc a rls:TenantGuc ;
    rls:gucName "fnox_cos.office_id" ;
    rls:gucPurpose "tenant-binding" ;
    rls:isLocal true .
