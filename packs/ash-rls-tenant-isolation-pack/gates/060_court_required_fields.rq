# MESSAGE: every rls:RlsCourt must declare courtModule, probeTable, and courtRole. Zero rows = pass.
PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
SELECT ?court WHERE {
  ?court a rls:RlsCourt .
  FILTER NOT EXISTS {
    ?court rls:courtModule ?cm ;
           rls:probeTable ?pt ;
           rls:courtRole ?cr .
    FILTER(STRLEN(STR(?cm)) > 0 && STRLEN(STR(?pt)) > 0 && STRLEN(STR(?cr)) > 0)
  }
}
ORDER BY ?court
