# MESSAGE: only the closed GUC names app.current_tenant_id and app.rls_platform are admitted. Any other rls:TenantGuc gucName is refused. Zero rows = pass.
PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
SELECT ?guc ?gucName WHERE {
  ?guc a rls:TenantGuc ;
       rls:gucName ?gucName .
  FILTER(?gucName != "app.current_tenant_id" && ?gucName != "app.rls_platform")
}
ORDER BY ?gucName
