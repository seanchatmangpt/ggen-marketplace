# MESSAGE: rls:TenantScopedTable must not set forceRls=true while enableRls=false. ENABLE is a precondition of FORCE. Omitting both accepts pack defaults (both true). Zero rows = pass.
PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
SELECT ?table ?tableName WHERE {
  ?table a rls:TenantScopedTable ;
         rls:tableName ?tableName ;
         rls:forceRls true ;
         rls:enableRls false .
}
ORDER BY ?tableName
