# MESSAGE: rls:RlsCourt probeTable must also be declared as an rls:TenantScopedTable (behavior court cannot probe a table outside the catalog). Zero rows = pass.
PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
SELECT ?court ?probeTable WHERE {
  ?court a rls:RlsCourt ;
         rls:probeTable ?probeTable .
  FILTER NOT EXISTS {
    ?t a rls:TenantScopedTable ;
       rls:tableName ?probeTable .
  }
}
ORDER BY ?probeTable
