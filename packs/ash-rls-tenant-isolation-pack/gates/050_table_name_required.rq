# MESSAGE: every rls:TenantScopedTable must declare a non-empty rls:tableName. Zero rows = pass.
PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
SELECT ?table WHERE {
  ?table a rls:TenantScopedTable .
  FILTER NOT EXISTS {
    ?table rls:tableName ?n .
    FILTER(STRLEN(STR(?n)) > 0)
  }
}
ORDER BY ?table
