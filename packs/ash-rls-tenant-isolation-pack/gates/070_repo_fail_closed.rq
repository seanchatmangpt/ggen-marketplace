# MESSAGE: every rls:RepoTenantHook must set failClosedNilTenant true (never invent a fallback tenant UUID). Zero rows = pass.
PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
SELECT ?hook ?repoModule WHERE {
  ?hook a rls:RepoTenantHook .
  OPTIONAL { ?hook rls:repoModule ?repoModule }
  FILTER NOT EXISTS { ?hook rls:failClosedNilTenant true }
}
ORDER BY ?hook
