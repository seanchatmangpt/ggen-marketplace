# MESSAGE: every rls:TenantScopedTable must either declare rls:hasPolicy or rely on the pack default shape (no explicit forceRls=false). Tables that set forceRls=false while remaining TenantScopedTable are refused — demote them to CatalogExclusion instead. Zero rows = pass.
PREFIX rls: <https://ggen.dev/packs/ash-rls-tenant-isolation#>
SELECT ?table ?tableName WHERE {
  ?table a rls:TenantScopedTable ;
         rls:tableName ?tableName ;
         rls:forceRls false .
}
ORDER BY ?tableName
