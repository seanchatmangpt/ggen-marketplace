PREFIX ec: <https://chatman.ai/evidence-capital#>
SELECT ?outcome ?sha ?generation ?gain ?falseRate ?concentration ?regret ?drift WHERE { ?outcome a ec:PolicyOutcome ; ec:subjectSha ?sha ; ec:generation ?generation ; ec:realizedGain ?gain ; ec:falseCapitalRate ?falseRate ; ec:rootConcentration ?concentration ; ec:regret ?regret ; ec:driftScore ?drift . }
ORDER BY ?sha DESC(?generation) DESC(?gain) ?falseRate ?concentration ?regret DESC(?drift) ?outcome
