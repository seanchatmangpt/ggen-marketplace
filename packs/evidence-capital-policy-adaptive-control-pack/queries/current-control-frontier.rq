PREFIX ec: <https://chatman.ai/evidence-capital#>
SELECT ?decision ?gain ?falseCapital ?concentration ?regret ?drift WHERE {
  ?decision a ec:PolicyDecision ; ec:realizedGain ?gain ; ec:falseCapitalRate ?falseCapital ; ec:rootConcentration ?concentration ; ec:regret ?regret ; ec:driftScore ?drift .
}
ORDER BY DESC(?gain) ?falseCapital ?concentration ?regret ?drift ?decision
