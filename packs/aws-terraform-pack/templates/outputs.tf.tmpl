---
to: "deploy/aws/{{ row.slug }}/outputs.tf"
force: true
determinism: true
sparql:
  a_group: |
    PREFIX awtf: <https://ggen.io/ontology/aws-terraform#>
    SELECT ?g ?slug WHERE {
      ?g a awtf:TaskGroup ; awtf:deploymentSlug ?slug .
    } ORDER BY ?slug
---
# GENERATED by `ggen sync` from packs/aws-terraform-pack -- do not edit by hand.
output "cluster_arn" {
  value = aws_ecs_cluster.this.arn
}

output "task_definition_arn" {
  value = aws_ecs_task_definition.this.arn
}

output "log_group_name" {
  value = aws_cloudwatch_log_group.this.name
}
