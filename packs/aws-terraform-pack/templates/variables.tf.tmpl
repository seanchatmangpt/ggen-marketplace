---
to: "deploy/aws/{{ row.slug }}/variables.tf"
force: true
determinism: true
sparql:
  a_group: |
    PREFIX awtf: <https://ggen.io/ontology/aws-terraform#>
    SELECT ?g ?slug ?label WHERE {
      ?g a awtf:TaskGroup ; awtf:deploymentSlug ?slug ; awtf:workloadLabel ?label .
    } ORDER BY ?slug
---
# GENERATED by `ggen sync` from packs/aws-terraform-pack -- do not edit by hand.
# Only genuine deployment-day inputs are variables; everything else is ontology-bound.
variable "region" {
  description = "AWS region for {{ row.label }}."
  type        = string
}

variable "name" {
  description = "Cluster/task family name for {{ row.label }}."
  type        = string
  default     = "{{ row.slug }}"
}

variable "container_image" {
  description = "Container image reference (registry/repo:tag)."
  type        = string
}
