---
to: "deploy/aws/{{ row.slug }}/providers.tf"
force: true
determinism: true
sparql:
  a_group: |
    PREFIX awtf: <https://ggen.io/ontology/aws-terraform#>
    SELECT ?g ?slug WHERE {
      ?g a awtf:TaskGroup ; awtf:deploymentSlug ?slug .
    } ORDER BY ?slug
---
# GENERATED by `ggen sync` from packs/aws-terraform-pack -- do not edit by hand.
terraform {
  required_version = ">= 1.7.1"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# Arcus AWS emulator note: for local simulation against ~/arcus, configure
# `endpoints { s3 = ... sqs = ... dynamodb = ... kinesis = ... }` or
# `AWS_ENDPOINT_URL_*` env vars. Note: awtf:TaskGroup models ECS Fargate,
# CloudWatch Logs, and IAM, which are outside arcus's current S3/SQS/DDB/Kinesis
# emulator surface.
provider "aws" {
  region = var.region
}
