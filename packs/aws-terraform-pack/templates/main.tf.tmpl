---
to: "deploy/aws/{{ row.slug }}/main.tf"
force: true
determinism: true
sparql:
  a_group: |
    PREFIX awtf: <https://ggen.io/ontology/aws-terraform#>
    SELECT ?g ?slug ?label ?networkMode ?osFamily ?cpu ?memory ?retention WHERE {
      ?g a awtf:TaskGroup ;
         awtf:deploymentSlug ?slug ;
         awtf:workloadLabel ?label ;
         awtf:networkMode ?networkMode ;
         awtf:operatingSystemFamily ?osFamily ;
         awtf:taskCpu ?cpu ;
         awtf:taskMemory ?memory ;
         awtf:logRetentionDays ?retention .
    } ORDER BY ?slug
  b_containers: |
    PREFIX awtf: <https://ggen.io/ontology/aws-terraform#>
    SELECT ?g ?order ?name ?command WHERE {
      ?g a awtf:TaskGroup ;
         awtf:hasContainer ?c .
      ?c awtf:containerOrder ?order ;
         awtf:containerName ?name ;
         awtf:command ?command .
    } ORDER BY ?g ?order ?name
---
# GENERATED by `ggen sync` from packs/aws-terraform-pack/ontology.ttl -- do not edit by hand.
# Workload: {{ row.label }}
{%- set group = row %}
locals {
  tags = {
    workload   = "{{ group.slug }}"
    managed_by = "ggen"
  }
}

resource "aws_cloudwatch_log_group" "this" {
  name              = "/ecs/{{ group.slug }}"
  retention_in_days = {{ group.retention }}
  tags              = local.tags
}

resource "aws_ecs_cluster" "this" {
  name = var.name
  tags = local.tags
}

resource "aws_iam_role" "execution" {
  name = "${var.name}-exec"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "ecs-tasks.amazonaws.com" }
    }]
  })
  tags = local.tags
}

resource "aws_iam_role_policy_attachment" "execution" {
  role       = aws_iam_role.execution.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}

resource "aws_ecs_task_definition" "this" {
  family                   = var.name
  requires_compatibilities = ["FARGATE"]
  network_mode             = "{{ group.networkMode }}"
  cpu                      = "{{ group.cpu }}"
  memory                   = "{{ group.memory }}"
  execution_role_arn       = aws_iam_role.execution.arn
  tags                     = local.tags

  runtime_platform {
    operating_system_family = "{{ group.osFamily }}"
    cpu_architecture        = "X86_64"
  }

  container_definitions = jsonencode([
{%- for c in b_containers | filter(attribute="g", value=group.g) %}
    {
      name      = "{{ c.name }}"
      image     = var.container_image
      essential = true
      command   = ["/bin/sh", "-c", "{{ c.command }}"]
      logConfiguration = {
        logDriver = "awslogs"
        options = {
          "awslogs-group"         = aws_cloudwatch_log_group.this.name
          "awslogs-region"        = var.region
          "awslogs-stream-prefix" = "{{ c.name }}"
        }
      }
    },
{%- endfor %}
  ])
}
