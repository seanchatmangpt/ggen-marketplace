PREFIX awtf: <https://ggen.io/ontology/aws-terraform#>
# A Container referenced by no TaskGroup would never render.
SELECT ?subject ?violation WHERE {
  ?subject a awtf:Container .
  FILTER NOT EXISTS { ?g awtf:hasContainer ?subject }
  BIND("AWTF_ORPHAN_CONTAINER: container not referenced by any TaskGroup" AS ?violation)
}
ORDER BY ?subject
