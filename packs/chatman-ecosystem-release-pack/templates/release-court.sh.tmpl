---
to: "out/scripts/crown_v{{ slug }}.sh"
for_each: courts
sparql:
  courts: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?release ?version ?slug ?root
    WHERE {
      ?release a er:Release ; er:version ?v .
      FILTER EXISTS { ?release er:gate ?g . }
      OPTIONAL { ?release er:courtRoot ?cr . }
      BIND(STR(?v) AS ?version)
      BIND(REPLACE(STR(?v), "[^A-Za-z0-9]", "_") AS ?slug)
      BIND(COALESCE(STR(?cr), ".") AS ?root)
    }
    ORDER BY ?release
  gates: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?owner ?gate ?order ?name ?command ?commandSha
    WHERE {
      ?owner a er:Release ; er:gate ?gate .
      ?gate er:gateOrder ?order ; er:gateName ?n ; er:command ?c .
      BIND(STR(?n) AS ?name)
      BIND(STR(?c) AS ?command)
      BIND(SHA256(STR(?c)) AS ?commandSha)
    }
    ORDER BY ?owner ?order ?gate
  probes: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?owner ?probe ?order ?name ?command ?commandSha
    WHERE {
      ?owner a er:Release ; er:probe ?probe .
      ?probe er:probeOrder ?order ; er:probeName ?n ; er:command ?c .
      BIND(STR(?n) AS ?name)
      BIND(STR(?c) AS ?command)
      BIND(SHA256(STR(?c)) AS ?commandSha)
    }
    ORDER BY ?owner ?order ?probe
  imports: |
    PREFIX er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#>
    SELECT ?name ?path ?hex
    WHERE {
      ?i a er:ImportedReceipt ; er:importName ?n ; er:importPath ?p ; er:importDigest ?d ; er:ordinal ?o .
      BIND(STR(?n) AS ?name)
      BIND(STR(?p) AS ?path)
      BIND(STRAFTER(STR(?d), "sha256:") AS ?hex)
    }
    ORDER BY ?o ?path
---
#!/usr/bin/env bash
# GENERATED by ggen sync from chatman-ecosystem-release-pack (templates/release-court.sh.tmpl)
# for release {{ release }} version {{ version }}. Do not hand-edit: a hand edit makes the
# next `ggen sync run` refuse (FM-WRITE-005); change the er:Gate / er:Probe /
# er:ImportedReceipt facts of the consumer graph and re-render instead.
#
# Release court: re-hash every imported file, run every probe, then every gate in
# er:gateOrder order, each gate under `set -euo pipefail`, from the court root
# ({{ root }} relative to the consumer root).
# Exit status: 0 = every import, probe and gate passed; 1..99 = the gate with that
# er:gateOrder failed (the court stops there); 100 = an imported file is missing or its
# sha256 differs from er:importDigest; 101 = a probe failed; 102 = the observation file
# could not be written.
# COURT_OBSERVED=<file> (relative to the caller's directory): also write what the court
# observed (er:observedOutput per probe, er:observedExit per gate run, each with
# er:observedCommandSha256 = sha256 of the command text it ran) as Turtle, for the consumer
# to feed back through extra_ontologies; gate 095 refuses an observation of another command.
# The file is replaced only when the court reaches a gate verdict (every gate passed, or one
# refused); an import or probe failure leaves any previous observation untouched.
set -euo pipefail
OBSERVED="${COURT_OBSERVED:-}"
case "$OBSERVED" in ''|/*) ;; *) OBSERVED="$PWD/$OBSERVED" ;; esac
cd "$(dirname "$0")/../.."
cd "{{ root }}"
PARTIAL=""
cleanup() { if [ -n "$PARTIAL" ]; then rm -f "$PARTIAL"; fi; }
trap cleanup EXIT
if [ -n "$OBSERVED" ]; then
  PARTIAL="$OBSERVED.partial.$$"
  printf '@prefix er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#> .\n' > "$PARTIAL" || exit 102
fi
obs() { if [ -n "$PARTIAL" ]; then printf '%s\n' "$1" >> "$PARTIAL" || exit 102; fi; }
lit() {
  local v=$1
  v=${v//\\/\\\\}
  v=${v//\"/\\\"}
  v=${v//$'\n'/\\n}
  v=${v//$'\r'/\\r}
  printf '"%s"' "$v"
}
finish() {
  if [ -n "$PARTIAL" ]; then
    mv -f "$PARTIAL" "$OBSERVED" || exit 102
    PARTIAL=""
    echo "COURT_OBSERVED $OBSERVED"
  fi
}
import_check() { # <name> <path> <sha256 hex>
  local got
  if [ ! -f "$2" ]; then
    echo "COURT_IMPORT_MISSING name=$1 path=$2" >&2
    exit 100
  fi
  got=$(shasum -a 256 "$2" | cut -c1-64) || { echo "COURT_IMPORT_UNREADABLE name=$1 path=$2" >&2; exit 100; }
  if [ "$got" != "$3" ]; then
    echo "COURT_IMPORT_DIGEST_MISMATCH name=$1 path=$2 want=sha256:$3 got=sha256:$got" >&2
    exit 100
  fi
  echo "COURT_IMPORT_OK name=$1 sha256:$got"
}
run_probe() { # <probe iri> <name> <function> <command sha256>
  local out rc
  set +e
  out=$(set -euo pipefail; "$3")
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    echo "COURT_PROBE_FAILED name=$2 exit=$rc" >&2
    exit 101
  fi
  echo "COURT_PROBE name=$2 output=$out"
  obs "<$1> er:observedOutput $(lit "$out") ; er:observedCommandSha256 \"$4\" ."
}
run_gate() { # <gate iri> <order> <name> <function> <command sha256>
  local rc
  echo "COURT_GATE_RUN order=$2 name=$3"
  set +e
  (set -euo pipefail; "$4")
  rc=$?
  set -e
  obs "<$1> er:observedExit $rc ; er:observedCommandSha256 \"$5\" ."
  if [ "$rc" -ne 0 ]; then
    echo "COURT_GATE_REFUSED order=$2 name=$3 exit=$rc" >&2
    finish
    exit "$2"
  fi
  echo "COURT_GATE_PASS order=$2 name=$3"
}
{% for p in probes %}{% if p.owner == release %}
probe_{{ p.order }}() {
{{ p.command }}
}
{% endif %}{% endfor %}{% for g in gates %}{% if g.owner == release %}
gate_{{ g.order }}() {
{{ g.command }}
}
{% endif %}{% endfor %}
# imports (er:ImportedReceipt, by er:ordinal)
{% for i in imports %}import_check '{{ i.name }}' '{{ i.path }}' '{{ i.hex }}'
{% endfor %}
# probes (er:probeOrder)
{% for p in probes %}{% if p.owner == release %}run_probe '{{ p.probe }}' '{{ p.name }}' probe_{{ p.order }} {{ p.commandSha }}
{% endif %}{% endfor %}
# gates (er:gateOrder)
{% for g in gates %}{% if g.owner == release %}run_gate '{{ g.gate }}' {{ g.order }} '{{ g.name }}' gate_{{ g.order }} {{ g.commandSha }}
{% endif %}{% endfor %}
finish
echo "COURT_ALIVE release={{ release }} version={{ version }}"
