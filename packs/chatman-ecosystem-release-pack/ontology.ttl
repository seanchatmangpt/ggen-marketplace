@prefix er: <http://seanchatmangpt.github.io/packs/chatman-ecosystem-release#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Reusable release-composition vocabulary. This pack deliberately contains no
# Chatman Ecosystem v26.9.1 component SHAs: exact release-instance identity is
# consumer observation and must not be duplicated into marketplace source.

er:Release a rdfs:Class ;
    rdfs:label "Dependency-closed release subject" ;
    dcterms:description "A release binds exact component identities and standing without granting execution authority." .

er:Component a rdfs:Class ;
    rdfs:label "Release component" ;
    dcterms:description "One repository/ref/exact-commit subject admitted into a release graph." .

er:RefObservation a rdfs:Class ;
    rdfs:label "External ref observation" ;
    dcterms:description "Authority-named evidence that a ref resolved to an exact commit when the local verifier cannot observe that ref directly." .

er:StandingState a rdfs:Class .
er:Disposition a rdfs:Class .
er:RefCheckMode a rdfs:Class .
er:AuthorityClass a rdfs:Class .

er:UNKNOWN a er:StandingState .
er:PARTIAL_ALIVE a er:StandingState .
er:ALIVE a er:StandingState .
er:BLOCKED a er:StandingState .
er:BUILD_BROKEN a er:StandingState .
er:UNSUPPORTED a er:StandingState .

er:CROWN a er:Disposition .
er:REQUIRED a er:Disposition .
er:ADAPTER a er:Disposition .
er:BENCH_GYM a er:Disposition .
er:SOURCE_ARCHAEOLOGY a er:Disposition .
er:OUT_OF_RELEASE a er:Disposition .

er:GITHUB_LIVE a er:RefCheckMode .
er:EXTERNAL_EXACT a er:RefCheckMode .

er:SELECT_CONSTRUCT a er:AuthorityClass .
er:DO a er:AuthorityClass .

er:version a rdf:Property ; rdfs:domain er:Release .
er:targetDate a rdf:Property ; rdfs:domain er:Release .
er:standing a rdf:Property ; rdfs:range er:StandingState .
er:authorityClass a rdf:Property ; rdfs:domain er:Release ; rdfs:range er:AuthorityClass .
er:hasComponent a rdf:Property ; rdfs:domain er:Release ; rdfs:range er:Component .
er:requiredRole a rdf:Property ; rdfs:domain er:Release .

er:repository a rdf:Property ; rdfs:domain er:Component .
er:branchRef a rdf:Property ; rdfs:domain er:Component .
er:commitSha a rdf:Property ; rdfs:domain er:Component .
er:role a rdf:Property ; rdfs:domain er:Component .
er:disposition a rdf:Property ; rdfs:domain er:Component ; rdfs:range er:Disposition .
er:required a rdf:Property ; rdfs:domain er:Component .
er:dependsOn a rdf:Property ; rdfs:domain er:Component ; rdfs:range er:Component .
er:refCheckMode a rdf:Property ; rdfs:domain er:Component ; rdfs:range er:RefCheckMode .
er:hasRefObservation a rdf:Property ; rdfs:domain er:Component ; rdfs:range er:RefObservation .

er:observationAuthority a rdf:Property ; rdfs:domain er:RefObservation .
er:observedRepository a rdf:Property ; rdfs:domain er:RefObservation .
er:observedRef a rdf:Property ; rdfs:domain er:RefObservation .
er:observedSha a rdf:Property ; rdfs:domain er:RefObservation .
er:observedAt a rdf:Property ; rdfs:domain er:RefObservation .
er:observedBy a rdf:Property ; rdfs:domain er:RefObservation ; rdfs:range prov:Agent .
