@prefix ecc: <https://ggen.dev/ontology/ecc-agent-harness-profile#> .
@prefix epr: <https://ggen.dev/ontology/external-paradigm-recompilation#> .
@prefix ahr: <https://ggen.dev/ontology/agent-harness-recompilation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ecc:PathBinding a rdfs:Class .
ecc:sourcePath a rdf:Property .
ecc:mapsToPart a rdf:Property .
ecc:skillCount a rdf:Property .
ecc:agentCount a rdf:Property .
ecc:commandCount a rdf:Property .
ecc:hookCount a rdf:Property .
ecc:workflowCount a rdf:Property .
ecc:totalCount a rdf:Property .

ecc:supplier a epr:SupplierSubject, prov:Entity ;
  dcterms:title "ECC external agent harness supplier" ;
  epr:sourceRepository "affaan-m/ECC" ;
  epr:sourceSha "e482e579415fde18357cafce70f177ae19fd7f03" ;
  epr:standing "CANDIDATE" ;
  ecc:skillCount 292 ;
  ecc:agentCount 68 ;
  ecc:commandCount 94 ;
  ecc:hookCount 5 ;
  ecc:workflowCount 2 ;
  ecc:totalCount 461 .

ecc:crossHarness a ecc:PathBinding ; ecc:sourcePath "docs/architecture/cross-harness.md|docs/architecture/harness-adapter-compliance.md" ; ecc:mapsToPart ahr:adapter .
ecc:agentShield a ecc:PathBinding ; ecc:sourcePath "skills/security-scan/SKILL.md|docs/architecture/agentshield-enterprise-research-roadmap.md" ; ecc:mapsToPart ahr:securityScanner .
ecc:surfaces a ecc:PathBinding ; ecc:sourcePath "skills/|agents/|commands/" ; ecc:mapsToPart ahr:capabilitySurface .
ecc:learning a ecc:PathBinding ; ecc:sourcePath "skills/continuous-learning-v2/SKILL.md" ; ecc:mapsToPart ahr:learning .
ecc:planning a ecc:PathBinding ; ecc:sourcePath "skills/autonomous-loops/SKILL.md" ; ecc:mapsToPart ahr:planning .
ecc:verification a ecc:PathBinding ; ecc:sourcePath "skills/verification-loop/SKILL.md" ; ecc:mapsToPart ahr:verification .
ecc:memory a ecc:PathBinding ; ecc:sourcePath "skills/unified-memory/SKILL.md" ; ecc:mapsToPart ahr:memory .
ecc:hooks a ecc:PathBinding ; ecc:sourcePath "hooks/|scripts/hooks/" ; ecc:mapsToPart ahr:hook .
ecc:workflows a ecc:PathBinding ; ecc:sourcePath "workflows/" ; ecc:mapsToPart ahr:workflow .
