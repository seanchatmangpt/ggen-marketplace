@prefix ahr: <https://ggen.dev/ontology/agent-harness-recompilation#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Qualification-only external fact identity. The nine harness parts are
# owned by agent-harness-recompilation-pack (SLP-QUAL-001 shape,
# standing-ladder-pack precedent); this fixture restates only the typed
# identity needed so ecc:mapsToPart objects are not dangling IRIs when
# ecc-agent-harness-profile-pack is qualified in isolation. Canonical
# facts remain owned by agent-harness-recompilation-pack/ontology.ttl.
ahr:adapter a ahr:HarnessPart ;
    dcterms:source "packs/agent-harness-recompilation-pack/ontology.ttl#ahr:adapter" .

ahr:capabilitySurface a ahr:HarnessPart ;
    dcterms:source "packs/agent-harness-recompilation-pack/ontology.ttl#ahr:capabilitySurface" .

ahr:hook a ahr:HarnessPart ;
    dcterms:source "packs/agent-harness-recompilation-pack/ontology.ttl#ahr:hook" .

ahr:learning a ahr:HarnessPart ;
    dcterms:source "packs/agent-harness-recompilation-pack/ontology.ttl#ahr:learning" .

ahr:memory a ahr:HarnessPart ;
    dcterms:source "packs/agent-harness-recompilation-pack/ontology.ttl#ahr:memory" .

ahr:planning a ahr:HarnessPart ;
    dcterms:source "packs/agent-harness-recompilation-pack/ontology.ttl#ahr:planning" .

ahr:securityScanner a ahr:HarnessPart ;
    dcterms:source "packs/agent-harness-recompilation-pack/ontology.ttl#ahr:securityScanner" .

ahr:verification a ahr:HarnessPart ;
    dcterms:source "packs/agent-harness-recompilation-pack/ontology.ttl#ahr:verification" .

ahr:workflow a ahr:HarnessPart ;
    dcterms:source "packs/agent-harness-recompilation-pack/ontology.ttl#ahr:workflow" .
