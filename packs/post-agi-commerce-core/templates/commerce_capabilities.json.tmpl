---
to: "generated/commerce-capabilities.json"
sparql:
  capabilities: |
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX c: <urn:ggen:pack:post-agi-commerce:>
    SELECT ?id ?operation ?external
    WHERE {
      ?cap a skos:Concept ;
        skos:inScheme c:capabilities ;
        dcterms:identifier ?id ;
        dcterms:type ?operation ;
        skos:note ?externalNote .
      FILTER(STRSTARTS(STR(?externalNote), "external-authority-required:"))
      BIND(STRAFTER(STR(?externalNote), "external-authority-required:") AS ?external)
    }
    ORDER BY ?id
---
