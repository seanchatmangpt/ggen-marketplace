---
to: "generated/commerce-design-frontier.json"
sparql:
  factors: |
    PREFIX dcterms: <http://purl.org/dc/terms/>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    PREFIX c: <urn:ggen:pack:post-agi-commerce:>
    SELECT ?factor ?alternative
    WHERE {
      ?factorNode skos:inScheme c:design-factors ;
        dcterms:identifier ?factor ;
        dcterms:hasPart ?alternativeNode .
      ?alternativeNode dcterms:identifier ?alternative .
    }
    ORDER BY ?factor ?alternative
---
{
  "generated": true,
  "authority": "NONE",
  "selection_required": true,
  "design_frontier_cardinality": 2592,
  "agent_frontier_cardinality": 216,
  "factor_count": 8,
  "alternative_count": 22,
  "factor_alternatives": [
{% for row in factors -%}
    {"factor":"{{ row.factor }}","alternative":"{{ row.alternative }}"}{% if not loop.last %},{% endif %}
{% endfor -%}
  ]
}
