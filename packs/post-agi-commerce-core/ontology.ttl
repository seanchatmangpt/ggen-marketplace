@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix c: <urn:ggen:pack:post-agi-commerce:> .

c:pack a prov:Entity ;
  dcterms:identifier "post-agi-commerce-core" ;
  dcterms:title "Post-AGI DfCM Commerce Core" ;
  dcterms:conformsTo <https://github.com/seanchatmangpt/gymact/commit/3d35d66f30d2524228dd3c7693a8f08f18fb249b> ;
  dcterms:hasVersion "gymact-3d35d66f30d2524228dd3c7693a8f08f18fb249b" ;
  dcterms:extent "32"^^xsd:integer ;
  dcterms:relation c:runtime-provider,
    c:design-frontier,
    c:agent-frontier,
    c:possibility-frontier ;
  skos:note "capability-digest:c9a429501b79b7f799b7b6e8fc12d065bb1452fdd8021761d34242f257cd9032" ;
  skos:note "authority-ceiling:CONSTRUCT_ONLY" ;
  skos:note "external-standing:BLOCKED_WITHOUT_LIVE_EXTERNAL_EVIDENCE" .

c:runtime-provider a prov:Entity ;
  dcterms:identifier "commerce-dfcm" ;
  dcterms:title "GymAct Post-AGI DfCM Commerce Provider" ;
  dcterms:conformsTo <https://github.com/seanchatmangpt/gymact/commit/3d35d66f30d2524228dd3c7693a8f08f18fb249b> ;
  dcterms:source <https://github.com/seanchatmangpt/gymact/blob/3d35d66f30d2524228dd3c7693a8f08f18fb249b/src/gymact/gyms/commerce_dfcm_gym.py> ;
  skos:note "registry-key:commerce-dfcm" ;
  skos:note "semantic-capability-count:32" ;
  skos:note "executable-capability-count:25" ;
  skos:note "external-frontier-count:7" ;
  skos:note "external-do-policy:NOT_EXPOSED" ;
  skos:note "runtime-authority:BRCE_BOUNDED_INTERNAL_ONLY" .

c:possibility-frontier a prov:Entity ;
  dcterms:identifier "commerce-possibility-frontier" ;
  dcterms:source <https://github.com/seanchatmangpt/gymact/blob/3d35d66f30d2524228dd3c7693a8f08f18fb249b/src/gymact/commerce_dfcm_graph.py> ;
  dcterms:extent "12"^^xsd:integer ;
  skos:note "semantic-capability-count:32" ;
  skos:note "reversible-capability-count:20" ;
  skos:note "do-frontier-count:12" ;
  skos:note "bounded-internal-do-count:5" ;
  skos:note "external-do-count:7" ;
  skos:note "exploration-policy:NEVER_TRAVERSE_DO" .

c:design-frontier a prov:Entity ;
  dcterms:identifier "commerce-design-frontier" ;
  dcterms:extent "2592"^^xsd:integer ;
  dcterms:hasPart c:billing-authority-factor,
    c:pricing-model-factor,
    c:entitlement-cardinality-factor,
    c:identity-binding-factor,
    c:usage-projection-factor,
    c:packaging-topology-factor,
    c:supply-chain-policy-factor,
    c:support-tier-factor ;
  skos:note "selection-authority:NONE" ;
  skos:note "selection-required-before-execution:true" .

c:agent-frontier a prov:Entity ;
  dcterms:identifier "commerce-logical-agent-frontier" ;
  dcterms:extent "216"^^xsd:integer ;
  skos:note "llm-calls:0" ;
  skos:note "roles:6" ;
  skos:note "planners:3" ;
  skos:note "objectives:3" ;
  skos:note "observation-projections:2" ;
  skos:note "action-projections:2" .

c:design-factors a skos:ConceptScheme ;
  skos:prefLabel "Post-AGI commerce DfCM design factors" .

c:billing-authority-factor a skos:Concept ;
  skos:inScheme c:design-factors ;
  dcterms:identifier "billing_authority" ;
  dcterms:hasPart c:billing-direct, c:billing-external-commerce .
c:billing-direct a skos:Concept ; dcterms:identifier "DIRECT" ; dcterms:isPartOf c:billing-authority-factor .
c:billing-external-commerce a skos:Concept ; dcterms:identifier "EXTERNAL_COMMERCE" ; dcterms:isPartOf c:billing-authority-factor .

c:pricing-model-factor a skos:Concept ;
  skos:inScheme c:design-factors ;
  dcterms:identifier "pricing_model" ;
  dcterms:hasPart c:pricing-usage, c:pricing-seat, c:pricing-subscription, c:pricing-hybrid .
c:pricing-usage a skos:Concept ; dcterms:identifier "usage" ; dcterms:isPartOf c:pricing-model-factor .
c:pricing-seat a skos:Concept ; dcterms:identifier "seat" ; dcterms:isPartOf c:pricing-model-factor .
c:pricing-subscription a skos:Concept ; dcterms:identifier "subscription" ; dcterms:isPartOf c:pricing-model-factor .
c:pricing-hybrid a skos:Concept ; dcterms:identifier "hybrid" ; dcterms:isPartOf c:pricing-model-factor .

c:entitlement-cardinality-factor a skos:Concept ;
  skos:inScheme c:design-factors ;
  dcterms:identifier "entitlement_cardinality" ;
  dcterms:hasPart c:entitlement-single, c:entitlement-concurrent .
c:entitlement-single a skos:Concept ; dcterms:identifier "single" ; dcterms:isPartOf c:entitlement-cardinality-factor .
c:entitlement-concurrent a skos:Concept ; dcterms:identifier "concurrent" ; dcterms:isPartOf c:entitlement-cardinality-factor .

c:identity-binding-factor a skos:Concept ;
  skos:inScheme c:design-factors ;
  dcterms:identifier "identity_binding" ;
  dcterms:hasPart c:identity-tenant, c:identity-account, c:identity-legal-entity .
c:identity-tenant a skos:Concept ; dcterms:identifier "tenant" ; dcterms:isPartOf c:identity-binding-factor .
c:identity-account a skos:Concept ; dcterms:identifier "account" ; dcterms:isPartOf c:identity-binding-factor .
c:identity-legal-entity a skos:Concept ; dcterms:identifier "legal-entity" ; dcterms:isPartOf c:identity-binding-factor .

c:usage-projection-factor a skos:Concept ;
  skos:inScheme c:design-factors ;
  dcterms:identifier "usage_projection" ;
  dcterms:hasPart c:usage-event, c:usage-aggregate, c:usage-hybrid .
c:usage-event a skos:Concept ; dcterms:identifier "event" ; dcterms:isPartOf c:usage-projection-factor .
c:usage-aggregate a skos:Concept ; dcterms:identifier "aggregate" ; dcterms:isPartOf c:usage-projection-factor .
c:usage-hybrid a skos:Concept ; dcterms:identifier "hybrid" ; dcterms:isPartOf c:usage-projection-factor .

c:packaging-topology-factor a skos:Concept ;
  skos:inScheme c:design-factors ;
  dcterms:identifier "packaging_topology" ;
  dcterms:hasPart c:packaging-helm-first, c:packaging-kubernetes-first, c:packaging-oci-first .
c:packaging-helm-first a skos:Concept ; dcterms:identifier "helm-first" ; dcterms:isPartOf c:packaging-topology-factor .
c:packaging-kubernetes-first a skos:Concept ; dcterms:identifier "kubernetes-first" ; dcterms:isPartOf c:packaging-topology-factor .
c:packaging-oci-first a skos:Concept ; dcterms:identifier "oci-first" ; dcterms:isPartOf c:packaging-topology-factor .

c:supply-chain-policy-factor a skos:Concept ;
  skos:inScheme c:design-factors ;
  dcterms:identifier "supply_chain_policy" ;
  dcterms:hasPart c:supply-standard, c:supply-strict .
c:supply-standard a skos:Concept ; dcterms:identifier "standard" ; dcterms:isPartOf c:supply-chain-policy-factor .
c:supply-strict a skos:Concept ; dcterms:identifier "strict" ; dcterms:isPartOf c:supply-chain-policy-factor .

c:support-tier-factor a skos:Concept ;
  skos:inScheme c:design-factors ;
  dcterms:identifier "support_tier" ;
  dcterms:hasPart c:support-standard, c:support-premium, c:support-enterprise-247 .
c:support-standard a skos:Concept ; dcterms:identifier "standard" ; dcterms:isPartOf c:support-tier-factor .
c:support-premium a skos:Concept ; dcterms:identifier "premium" ; dcterms:isPartOf c:support-tier-factor .
c:support-enterprise-247 a skos:Concept ; dcterms:identifier "enterprise-247" ; dcterms:isPartOf c:support-tier-factor .

c:capabilities a skos:ConceptScheme ; skos:prefLabel "Provider-neutral commerce capability closure" .

