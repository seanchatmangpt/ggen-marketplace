PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX c: <urn:ggen:pack:post-agi-commerce:>
SELECT ?count ?violation WHERE {
  {
    SELECT (COUNT(DISTINCT ?cap) AS ?count) WHERE {
      ?cap a skos:Concept ; skos:inScheme c:capabilities ; dcterms:identifier ?id .
    }
  }
  FILTER(?count != 32)
  BIND(CONCAT("capability count=", STR(?count), " expected=32") AS ?violation)
}
