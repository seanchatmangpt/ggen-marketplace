PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX c: <urn:ggen:pack:post-agi-commerce:>
SELECT ?violation WHERE {
  FILTER NOT EXISTS {
    c:pack dcterms:conformsTo <https://github.com/seanchatmangpt/gymact/commit/3d35d66f30d2524228dd3c7693a8f08f18fb249b> ;
      skos:note "capability-digest:c9a429501b79b7f799b7b6e8fc12d065bb1452fdd8021761d34242f257cd9032" .
  }
  BIND("exact final GymAct DfCM subject/digest missing" AS ?violation)
}
