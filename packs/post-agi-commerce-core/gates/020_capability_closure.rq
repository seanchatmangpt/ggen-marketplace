PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX c: <urn:ggen:pack:post-agi-commerce:>
SELECT ?required ?violation WHERE {
  VALUES ?required {
    "agreement.admit" "billing-authority.fence" "entitlement.apply-event" "entitlement.concurrent"
    "entitlement.lifecycle" "identity.bind" "usage.observe" "usage.admit" "meter.construct"
    "meter.submit" "provider.acceptance.admit" "settlement.reconcile" "agreement.amend"
    "agreement.renew" "agreement.cancel" "credit.construct" "refund.construct" "support.entitle"
    "pricing.validate" "replay.idempotent" "packaging.helm" "packaging.k8s-stable-api"
    "supply-chain.sbom" "supply-chain.vulnerability-scan" "supply-chain.provenance"
    "artifact.portable-registry" "external.seller-registration" "external.kyc" "external.tax"
    "external.banking" "external.eula" "external.provider-review"
  }
  FILTER NOT EXISTS {
    ?cap a skos:Concept ; skos:inScheme c:capabilities ; dcterms:identifier ?required .
  }
  BIND(CONCAT("missing capability ", ?required) AS ?violation)
}
