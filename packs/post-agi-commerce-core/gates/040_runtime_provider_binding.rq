PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX c: <urn:ggen:pack:post-agi-commerce:>
SELECT ?violation WHERE {
  {
    FILTER NOT EXISTS {
      c:runtime-provider dcterms:identifier "commerce-dfcm" ;
        dcterms:conformsTo <https://github.com/seanchatmangpt/gymact/commit/1f91056fd5d4f647b219e43ad883819796bdc782> ;
        skos:note "capability-count:32" ;
        skos:note "external-do-policy:REFUSE" .
    }
    BIND("runtime provider exact subject/refusal policy missing" AS ?violation)
  }
  UNION
  {
    c:pack dcterms:relation ?provider .
    FILTER(?provider != c:runtime-provider)
    BIND("pack related to unexpected runtime provider" AS ?violation)
  }
}
