PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX c: <urn:ggen:pack:post-agi-commerce:>
SELECT ?violation WHERE {
  {
    FILTER NOT EXISTS {
      c:runtime-provider dcterms:identifier "commerce-dfcm" ;
        dcterms:conformsTo <https://github.com/seanchatmangpt/gymact/commit/cb11b6f5d1855f5ea89138e11e2837b8340120ce> ;
        skos:note "semantic-capability-count:32" ;
        skos:note "executable-capability-count:25" ;
        skos:note "external-frontier-count:7" ;
        skos:note "external-do-policy:NOT_EXPOSED" .
    }
    BIND("runtime provider exact subject/authority partition missing" AS ?violation)
  }
  UNION
  {
    c:pack dcterms:relation ?related .
    FILTER(?related NOT IN (c:runtime-provider, c:design-frontier, c:agent-frontier))
    BIND("pack related to unexpected semantic subject" AS ?violation)
  }
}
