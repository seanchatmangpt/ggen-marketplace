// INLINE PROVENANCE COPY — strata-hash-pack (S1) pattern:
// packs/strata-hash-pack/generated/hash_merkle.rs @ S10 copy point.
// SHA-256 per FIPS 180-4; Merkle per the Bitcoin duplication rule, single
// SHA-256 per level (the Strata family convention). Minimal: root, proof,
// verify only.
// ══════════════════════════════════════════════════════════════════════

/// Digest width in bytes (strata family convention).
pub const DIGEST_LEN: usize = 32;

const K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

const H0: [u32; 8] = [
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
];

/// SHA-256 of `data` (FIPS 180-4 §6.2; hash-pack pattern copy).
pub fn sha256(data: &[u8]) -> [u8; DIGEST_LEN] {
    let mut h = H0;
    let bit_len = (data.len() as u64).wrapping_mul(8);
    let mut msg = data.to_vec();
    msg.push(0x80);
    while msg.len() % 64 != 56 {
        msg.push(0);
    }
    msg.extend_from_slice(&bit_len.to_be_bytes());
    for block in msg.chunks_exact(64) {
        let mut w = [0u32; 64];
        for (i, word) in block.chunks_exact(4).enumerate() {
            w[i] = u32::from_be_bytes([word[0], word[1], word[2], word[3]]);
        }
        for i in 16..64 {
            let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
            let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16]
                .wrapping_add(s0)
                .wrapping_add(w[i - 7])
                .wrapping_add(s1);
        }
        let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh) =
            (h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);
        for i in 0..64 {
            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
            let ch = (e & f) ^ ((!e) & g);
            let t1 = hh
                .wrapping_add(s1)
                .wrapping_add(ch)
                .wrapping_add(K[i])
                .wrapping_add(w[i]);
            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = s0.wrapping_add(maj);
            hh = g;
            g = f;
            f = e;
            e = d.wrapping_add(t1);
            d = c;
            c = b;
            b = a;
            a = t1.wrapping_add(t2);
        }
        h[0] = h[0].wrapping_add(a);
        h[1] = h[1].wrapping_add(b);
        h[2] = h[2].wrapping_add(c);
        h[3] = h[3].wrapping_add(d);
        h[4] = h[4].wrapping_add(e);
        h[5] = h[5].wrapping_add(f);
        h[6] = h[6].wrapping_add(g);
        h[7] = h[7].wrapping_add(hh);
    }
    let mut out = [0u8; DIGEST_LEN];
    for (i, word) in h.iter().enumerate() {
        out[i * 4..i * 4 + 4].copy_from_slice(&word.to_be_bytes());
    }
    out
}

/// Node hash H(left || right) over a fixed-width 64-byte buffer (the
/// fixed-width framing is what removes the second-preimage ambiguity).
fn node_hash(left: &[u8; DIGEST_LEN], right: &[u8; DIGEST_LEN]) -> [u8; DIGEST_LEN] {
    let mut buf = [0u8; DIGEST_LEN * 2];
    buf[..DIGEST_LEN].copy_from_slice(left);
    buf[DIGEST_LEN..].copy_from_slice(right);
    sha256(&buf)
}

/// Fold one Merkle level, duplicating a trailing odd node.
fn collapse(level: &[[u8; DIGEST_LEN]]) -> Vec<[u8; DIGEST_LEN]> {
    let mut next = Vec::with_capacity((level.len() + 1) / 2);
    let mut i = 0;
    while i < level.len() {
        let right = if i + 1 < level.len() { level[i + 1] } else { level[i] };
        next.push(node_hash(&level[i], &right));
        i += 2;
    }
    next
}

/// Merkle inclusion proof: sibling digests bottom-up.
pub type Proof = Vec<[u8; DIGEST_LEN]>;

/// Merkle root over ordered leaves; `None` for the empty tree.
pub fn merkle_root(leaves: &[[u8; DIGEST_LEN]]) -> Option<[u8; DIGEST_LEN]> {
    if leaves.is_empty() {
        return None;
    }
    let mut level: Vec<[u8; DIGEST_LEN]> = leaves.to_vec();
    while level.len() > 1 {
        level = collapse(&level);
    }
    Some(level[0])
}

/// Inclusion proof for leaf `index`; `None` on empty/out-of-range.
pub fn merkle_proof(leaves: &[[u8; DIGEST_LEN]], index: usize) -> Option<Proof> {
    if leaves.is_empty() || index >= leaves.len() {
        return None;
    }
    let mut level: Vec<[u8; DIGEST_LEN]> = leaves.to_vec();
    let mut idx = index;
    let mut proof = Proof::new();
    while level.len() > 1 {
        let sib = if idx % 2 == 0 {
            if idx + 1 < level.len() { level[idx + 1] } else { level[idx] }
        } else {
            level[idx - 1]
        };
        proof.push(sib);
        level = collapse(&level);
        idx /= 2;
    }
    Some(proof)
}

/// Verify an inclusion proof of `leaf` at `index` against `root`.
pub fn merkle_verify(
    root: &[u8; DIGEST_LEN],
    leaf: &[u8; DIGEST_LEN],
    index: usize,
    proof: &Proof,
) -> bool {
    let mut node = *leaf;
    let mut idx = index;
    for &sib in proof {
        node = if idx % 2 == 0 { node_hash(&node, &sib) } else { node_hash(&sib, &node) };
        idx /= 2;
    }
    &node == root
}

// ══════════════════════════════════════════════════════════════════════
// INLINE PROVENANCE COPY — strata-tx-pack (S2) pattern:
// packs/strata-tx-pack/generated/tx_model.rs @ S10 copy point.
// Framed fixed-width wire format, big-endian, strict fail-closed decode.
// Minimal: header framing + counts + digest check only.
// ══════════════════════════════════════════════════════════════════════

pub const TX_HEADER_LEN: usize = 56;
pub const TX_INPUT_LEN: usize = 36;
pub const TX_OUTPUT_LEN: usize = 9;
pub const TX_MAGIC: u32 = 0x5354_5831; // "STX1"
pub const TX_VERSION: u8 = 0x01;

/// Wire error: decode refuses malformed frames (fail-closed).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum TxError {
    Truncated,
    BadMagic,
    BadVersion,
    NonZeroReserved,
    DigestMismatch,
    CountMismatch,
}

/// Decoded frame summary: replay-guard nonce + (n, m) counts.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct TxFrame {
    pub nonce: u64,
    pub inputs: usize,
    pub outputs: usize,
}

/// PLACEHOLDER payload digest (documented FNV-1a stand-in over (n, m),
/// expanded to 32 bytes; tx-pack S2 convention; S3 binds the real signer).
fn placeholder_digest(n: u32, m: u32) -> [u8; DIGEST_LEN] {
    let mut hash: u64 = 0xcbf2_9ce4_8422_2325;
    for b in n.to_be_bytes().iter().chain(m.to_be_bytes().iter()) {
        hash ^= u64::from(*b);
        hash = hash.wrapping_mul(0x0000_0100_0000_01b3);
    }
    let mut out = [0u8; DIGEST_LEN];
    let mut state = hash;
    for chunk in out.chunks_mut(8) {
        let bytes = state.to_be_bytes();
        chunk.copy_from_slice(&bytes[..chunk.len()]);
        state = state.rotate_left(17).wrapping_add(0x9e37_79b9_7f4a_7c15);
    }
    out
}

fn be_u32(b: &[u8]) -> u32 {
    u32::from_be_bytes([b[0], b[1], b[2], b[3]])
}

fn be_u64(b: &[u8]) -> u64 {
    u64::from_be_bytes([b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]])
}

/// Encode a frame with `n` inputs and `m` outputs, filler bytes from `rng`
/// (the corpus generator; the wire layout matches tx-pack S2 exactly).
pub fn encode_frame(nonce: u64, n: u32, m: u32, rng: &mut Lcg) -> Vec<u8> {
    let mut out = vec![0u8; TX_HEADER_LEN + n as usize * TX_INPUT_LEN + m as usize * TX_OUTPUT_LEN];
    out[0..4].copy_from_slice(&TX_MAGIC.to_be_bytes());
    out[4] = TX_VERSION;
    // bytes 5..8 reserved zero
    out[8..16].copy_from_slice(&nonce.to_be_bytes());
    out[16..20].copy_from_slice(&n.to_be_bytes());
    out[20..24].copy_from_slice(&m.to_be_bytes());
    out[24..56].copy_from_slice(&placeholder_digest(n, m));
    let mut cur = TX_HEADER_LEN;
    for _ in 0..n {
        let input = rng.bytes(TX_INPUT_LEN);
        out[cur..cur + TX_INPUT_LEN].copy_from_slice(&input);
        cur += TX_INPUT_LEN;
    }
    for _ in 0..m {
        let output = rng.bytes(TX_OUTPUT_LEN);
        out[cur..cur + TX_OUTPUT_LEN].copy_from_slice(&output);
        cur += TX_OUTPUT_LEN;
    }
    out
}

/// Strict fail-closed decode of the framed wire format (tx-pack law).
pub fn decode_frame(bytes: &[u8]) -> Result<TxFrame, TxError> {
    if bytes.len() < TX_HEADER_LEN {
        return Err(TxError::Truncated);
    }
    if be_u32(&bytes[0..]) != TX_MAGIC {
        return Err(TxError::BadMagic);
    }
    if bytes[4] != TX_VERSION {
        return Err(TxError::BadVersion);
    }
    if bytes[5..8] != [0u8; 3] {
        return Err(TxError::NonZeroReserved);
    }
    let nonce = be_u64(&bytes[8..]);
    let n = be_u32(&bytes[16..]) as usize;
    let m = be_u32(&bytes[20..]) as usize;
    let expect = TX_HEADER_LEN + n * TX_INPUT_LEN + m * TX_OUTPUT_LEN;
    if bytes.len() != expect {
        return Err(TxError::CountMismatch);
    }
    let stored: [u8; DIGEST_LEN] = bytes[24..56].try_into().expect("digest slot is 32");
    if placeholder_digest(n as u32, m as u32) != stored {
        return Err(TxError::DigestMismatch);
    }
    Ok(TxFrame { nonce, inputs: n, outputs: m })
}

// ══════════════════════════════════════════════════════════════════════
// INLINE PROVENANCE COPY — strata-chain-pack (S5) pattern:
// packs/strata-chain-pack/generated/chain_engine.rs @ S10 copy point.
// Block header, PoW digest, and the full validate_block law (height,
// parent-hash, monotonic slot, PoW re-check). Minimal: no tx set.
// ══════════════════════════════════════════════════════════════════════

/// 32-byte digest (chain-pack Hash convention).
pub type Hash = [u8; DIGEST_LEN];

/// Chain-relevant block shape (chain-pack S5 pattern, tx-set minimal).
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Blk {
    pub height: u64,
    pub parent_hash: Hash,
    pub difficulty_target: u32,
    pub nonce: u64,
    pub timestamp_slot: u64,
}

impl Blk {
    /// Canonical header encoding: height(u64 BE) || parentHash ||
    /// difficulty(u32 BE) || slot(u64 BE).
    pub fn header_bytes(&self) -> Vec<u8> {
        let mut b = Vec::with_capacity(8 + DIGEST_LEN + 4 + 8);
        b.extend_from_slice(&self.height.to_be_bytes());
        b.extend_from_slice(&self.parent_hash);
        b.extend_from_slice(&self.difficulty_target.to_be_bytes());
        b.extend_from_slice(&self.timestamp_slot.to_be_bytes());
        b
    }
    /// PoW digest: SHA-256(header || nonce u64 BE).
    pub fn pow_hash(&self) -> Hash {
        let mut buf = self.header_bytes();
        buf.extend_from_slice(&self.nonce.to_be_bytes());
        sha256(&buf)
    }
}

/// Leading zero bit count of a digest (the PoW metric).
pub fn leading_zero_bits(h: &Hash) -> u32 {
    let mut n = 0u32;
    for byte in h {
        if *byte == 0 {
            n += 8;
        } else {
            n += byte.leading_zeros();
            break;
        }
    }
    n
}

/// Typed chain refusal — every rejection is a named variant.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ChainRefusal {
    HeightContinuity { expected: u64, got: u64 },
    ParentHashMismatch,
    SlotRegression { parent_slot: u64, got: u64 },
    PoWTargetNotMet { required_bits: u32, got_bits: u32 },
}

/// Validate `block` as a direct child of `parent` (chain-pack law:
/// height continuity, parent-hash binding, monotonic slot, PoW re-check).
pub fn validate_block(parent: &Blk, block: &Blk) -> Result<(), ChainRefusal> {
    if block.height != parent.height + 1 {
        return Err(ChainRefusal::HeightContinuity {
            expected: parent.height + 1,
            got: block.height,
        });
    }
    if block.parent_hash != sha256(&parent.header_bytes()) {
        return Err(ChainRefusal::ParentHashMismatch);
    }
    if block.timestamp_slot < parent.timestamp_slot {
        return Err(ChainRefusal::SlotRegression {
            parent_slot: parent.timestamp_slot,
            got: block.timestamp_slot,
        });
    }
    let bits = leading_zero_bits(&block.pow_hash());
    if bits < block.difficulty_target {
        return Err(ChainRefusal::PoWTargetNotMet {
            required_bits: block.difficulty_target,
            got_bits: bits,
        });
    }
    Ok(())
}

/// Deterministic PoW tick: at most `attempts` consecutive nonces from
/// `block.nonce`; on success sets the nonce and returns true.
pub fn mine_tick(block: &mut Blk, attempts: u64) -> bool {
    let start = block.nonce;
    for k in 0..attempts {
        block.nonce = start.wrapping_add(k);
        if leading_zero_bits(&block.pow_hash()) >= block.difficulty_target {
            return true;
        }
    }
    false
}

// ══════════════════════════════════════════════════════════════════════
// INLINE PROVENANCE COPY — strata-consensus-pack (S8) pattern:
// packs/strata-consensus-pack/generated/consensus_engine.rs @ S10 point.
// Work accounting, heaviest-tip selection with lower-nonce tie-break, and
// selfish-mining detection.
// ══════════════════════════════════════════════════════════════════════

/// Work of one block: 2^(difficulty target, saturating at 63).
pub fn block_work(b: &Blk) -> u64 {
    1u64 << b.difficulty_target.min(63)
}

/// Total accumulated chain work (saturating fold).
pub fn chain_work(chain: &[Blk]) -> u64 {
    chain.iter().map(block_work).fold(0u64, u64::saturating_add)
}

/// Deterministic tip selection: heaviest total work wins; exact equal-work
/// tie resolves to the chain whose tip has the LOWER nonce.
pub fn select_tip(candidates: &[Vec<Blk>]) -> Option<usize> {
    if candidates.is_empty() {
        return None;
    }
    let work: Vec<u64> = candidates.iter().map(|c| chain_work(c)).collect();
    let mut best = 0usize;
    for i in 1..candidates.len() {
        let a = work[i];
        let b = work[best];
        let wins = a > b
            || (a == b
                && match (candidates[i].last(), candidates[best].last()) {
                    (Some(x), Some(y)) => x.nonce < y.nonce,
                    (Some(_), None) => true,
                    _ => false,
                });
        if wins {
            best = i;
        }
    }
    Some(best)
}

/// Gossip observation fed to selfish-mining detection.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum GossipEvent {
    Withheld,
    Released,
}

/// A `Released` preceded by a run of >= 2 `Withheld` is the selfish-mining
/// report pattern (consensus-pack S8 law).
pub fn selfish_mining_detected(pattern: &[GossipEvent]) -> bool {
    let mut run = 0u32;
    for e in pattern {
        match e {
            GossipEvent::Withheld => run += 1,
            GossipEvent::Released => {
                if run >= 2 {
                    return true;
                }
                run = 0;
            }
        }
    }
    false
}

// ══════════════════════════════════════════════════════════════════════
// INLINE PROVENANCE COPY — strata-ledger-pack (S4) pattern:
// packs/strata-ledger-pack/generated/ledger_state.rs @ S10 copy point.
// Masked-commit conservation law: checked arithmetic, all checks BEFORE
// any balance mutates. Minimal: balances + apply_transition.
// ══════════════════════════════════════════════════════════════════════

/// 32-byte account identifier (S1 digest width).
pub type AccountId = [u8; DIGEST_LEN];

/// Ledger refusal valve (ledger-pack S4 subset).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum LedgerRefusal {
    Overflow,
    Conservation,
    InsufficientFunds,
}

/// Account balances (ledger-pack S4 minimal state).
#[derive(Debug, Clone, Default)]
pub struct Ledger {
    balances: BTreeMap<AccountId, u128>,
}

impl Ledger {
    pub fn new() -> Ledger {
        Ledger { balances: BTreeMap::new() }
    }
    pub fn fund(&mut self, id: AccountId, amount: u128) {
        *self.balances.entry(id).or_insert(0) += amount;
    }
    pub fn balance(&self, id: &AccountId) -> u128 {
        self.balances.get(id).copied().unwrap_or(0)
    }
    /// Total supply over all accounts.
    pub fn supply(&self) -> u128 {
        self.balances.values().fold(0u128, |acc, &v| acc.saturating_add(v))
    }

    /// Masked-commit transition: every check runs BEFORE any balance
    /// mutates; checked sums refuse `Overflow`, unequal sums refuse
    /// `Conservation`, a debit over balance refuses `InsufficientFunds`.
    pub fn apply_transition(
        &mut self,
        inputs: &[(AccountId, u128)],
        outputs: &[(AccountId, u128)],
    ) -> Result<(), LedgerRefusal> {
        // Check 1: checked input/output sums (overflow refused first).
        let mut sum_in: u128 = 0;
        for (_, amt) in inputs {
            sum_in = match sum_in.checked_add(*amt) {
                Some(s) => s,
                None => return Err(LedgerRefusal::Overflow),
            };
        }
        let mut sum_out: u128 = 0;
        for (_, amt) in outputs {
            sum_out = match sum_out.checked_add(*amt) {
                Some(s) => s,
                None => return Err(LedgerRefusal::Overflow),
            };
        }
        // Check 2: conservation.
        if sum_in != sum_out {
            return Err(LedgerRefusal::Conservation);
        }
        // Check 3: sufficient funds.
        for (id, amt) in inputs {
            if self.balance(id) < *amt {
                return Err(LedgerRefusal::InsufficientFunds);
            }
        }
        // Commit (masked: only reached when every check passed).
        for (id, amt) in inputs {
            let b = self.balances.get_mut(id).expect("funded account");
            *b -= *amt;
        }
        for (id, amt) in outputs {
            *self.balances.entry(*id).or_insert(0) += *amt;
        }
        Ok(())
    }
}

// ══════════════════════════════════════════════════════════════════════
// INLINE PROVENANCE COPY — strata-pn64-pack (T2) pattern:
// packs/strata-pn64-pack/generated/pn64_masks.rs @ 00e0b086b.
// Canonical six RONR transitions; fire law on the ENABLED DOMAIN only:
// apply_mask gates on (m & pre) == pre, then m' = (m & !pre) | post.
// Minimal: masks, enabled gate, gated fire. S10 refresh addition.
// ══════════════════════════════════════════════════════════════════════

/// Number of canonical RONR transitions (pn64-pack convention).
pub const PN64_VERB_COUNT: usize = 6;

/// Precondition place masks `W-` per canonical opcode (index = opcode - 1).
/// t04 (adopt amendment) carries the CORRECTED precondition 0x0010.
pub const PN64_PRE_MASKS: [u16; PN64_VERB_COUNT] =
    [0x0081, 0x0002, 0x0008, 0x0010, 0x0008, 0x0024];

/// Postcondition place masks `W+` per canonical opcode (index = opcode - 1).
pub const PN64_POST_MASKS: [u16; PN64_VERB_COUNT] =
    [0x0082, 0x000C, 0x0010, 0x0008, 0x0060, 0x0101];

/// Canonical six transitions as `(pre, post)` pairs.
pub const PN64_TRANSITIONS: [(u16, u16); PN64_VERB_COUNT] = [
    (0x0081, 0x0082),
    (0x0002, 0x000C),
    (0x0008, 0x0010),
    (0x0010, 0x0008),
    (0x0008, 0x0060),
    (0x0024, 0x0101),
];

/// The ungated XOR fire law `(m ^ pre) | post` — the ATTACKER's law. Kept
/// only as the divergence oracle: it matches the gated law on the enabled
/// domain and diverges off it.
pub fn fire_xor_unchecked(marking: u16, pre: u16, post: u16) -> u16 {
    ((marking ^ pre) | post) & 0xFFFF
}

/// Typed pn64 refusal (audit-pack subset).
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Pn64Refusal {
    NotEnabled { marking: u16, pre: u16 },
    UnknownOpcode(u16),
    TableDrift { opcode: usize, got: u16, want: u16 },
}

/// The audited law: a precondition-GATED fire. Refuses unless
/// `(m & pre) == pre` (the enabled domain), then applies clear-then-set.
/// This gate is what repels the fire-law XOR divergence off the enabled
/// domain (Pn64FireLawXorDivergence).
pub fn apply_mask(marking: u16, opcode: usize) -> Result<u16, Pn64Refusal> {
    if opcode == 0 || opcode > PN64_VERB_COUNT {
        return Err(Pn64Refusal::UnknownOpcode(opcode as u16));
    }
    let pre = PN64_PRE_MASKS[opcode - 1];
    let post = PN64_POST_MASKS[opcode - 1];
    if (marking & pre) != pre {
        return Err(Pn64Refusal::NotEnabled { marking, pre });
    }
    Ok(((marking & !pre) | post) & 0xFFFF)
}

// ── Audit runner ──────────────────────────────────────────────────────

/// One failing corpus case, named (target + case index + detail).
#[derive(Debug, Clone)]
pub struct Mismatch {
    pub target: &'static str,
    pub case_index: usize,
    pub detail: String,
}

/// Per-target run summary.
#[derive(Debug, Clone)]
pub struct TargetRun {
    pub name: &'static str,
    pub clean: usize,
    pub total: usize,
}

/// Full audit report: per-target counts plus every named mismatch.
#[derive(Debug, Clone, Default)]
pub struct AuditReport {
    pub per_target: Vec<TargetRun>,
    pub mismatches: Vec<Mismatch>,
}

impl AuditReport {
    /// True iff every target ran its full corpus with zero mismatches.
    pub fn is_clean(&self) -> bool {
        self.mismatches.is_empty()
            && self.per_target.iter().all(|t| t.clean == t.total && t.total > 0)
    }
    /// Human-readable one-line-per-target summary.
    pub fn summary(&self) -> String {
        self.per_target
            .iter()
            .map(|t| format!("{}: {}/{} clean", t.name, t.clean, t.total))
            .collect::<Vec<_>>()
            .join("; ")
    }
}

/// One deterministic corpus case for a target; `Some(detail)` on mismatch.
type Oracle = fn(usize, &mut Lcg) -> Option<String>;

/// The oracle registry — names MUST match st:oracleFn in the ontology
/// (gate 010 ties the manifest to these; an unknown oracle is a mismatch).
fn oracle_registry(name: &str) -> Option<Oracle> {
    match name {
        "oracle_merkle" => Some(oracle_merkle),
        "oracle_tx" => Some(oracle_tx),
        "oracle_chain" => Some(oracle_chain),
        "oracle_consensus" => Some(oracle_consensus),
        "oracle_ledger" => Some(oracle_ledger),
        "oracle_pn64" => Some(oracle_pn64),
        _ => None,
    }
}

/// Oracle: merkle_root_over_leaves — root stable, proof verifies,
/// empty tree refused, single-leaf root is the leaf.
fn oracle_merkle(case: usize, rng: &mut Lcg) -> Option<String> {
    let n = 1 + (case % 8) + (rng.next_u64() % 3) as usize;
    let leaves: Vec<[u8; DIGEST_LEN]> = (0..n).map(|_| rng.digest()).collect();
    let root = match merkle_root(&leaves) {
        Some(r) => r,
        None => return Some(format!("case {case}: empty root over {n} leaves")),
    };
    if merkle_root(&leaves) != Some(root) {
        return Some(format!("case {case}: root unstable over {n} leaves"));
    }
    let idx = (case % n) as usize;
    let proof = match merkle_proof(&leaves, idx) {
        Some(p) => p,
        None => return Some(format!("case {case}: no proof for leaf {idx}/{n}")),
    };
    if !merkle_verify(&root, &leaves[idx], idx, &proof) {
        return Some(format!("case {case}: proof for leaf {idx}/{n} failed to verify"));
    }
    None
}

/// Oracle: tx_decode_framed — encode/decode round-trip is exact.
fn oracle_tx(case: usize, rng: &mut Lcg) -> Option<String> {
    let nonce = rng.next_u64();
    let n = 1 + (case % 4) as u32;
    let m = 1 + ((case / 4) % 4) as u32;
    let frame = encode_frame(nonce, n, m, rng);
    match decode_frame(&frame) {
        Ok(f) => {
            if f.nonce != nonce || f.inputs != n as usize || f.outputs != m as usize {
                Some(format!(
                    "case {case}: round-trip mismatch (want nonce={nonce}, n={n}, m={m}; got {:?})",
                    f
                ))
            } else {
                None
            }
        }
        Err(e) => Some(format!("case {case}: honest frame refused: {e:?}")),
    }
}

/// Genesis-like parent for the chain oracle (fixed low difficulty).
fn chain_parent(rng: &mut Lcg) -> Blk {
    Blk {
        height: 0,
        parent_hash: [0u8; DIGEST_LEN],
        difficulty_target: 8,
        nonce: rng.next_u64(),
        timestamp_slot: 0,
    }
}

/// Oracle: chain_validate_block — a mined honest child always validates.
fn oracle_chain(case: usize, rng: &mut Lcg) -> Option<String> {
    let parent = chain_parent(rng);
    let mut child = Blk {
        height: parent.height + 1,
        parent_hash: sha256(&parent.header_bytes()),
        difficulty_target: 8,
        nonce: rng.next_u64(),
        timestamp_slot: parent.timestamp_slot + 1,
    };
    if !mine_tick(&mut child, 1 << 12) {
        return Some(format!("case {case}: mine_tick found no nonce at difficulty 8"));
    }
    match validate_block(&parent, &child) {
        Ok(()) => None,
        Err(e) => Some(format!("case {case}: honest child refused: {e:?}")),
    }
}

/// Independent expected-tip computation (heaviest work, lower-nonce tie).
fn expected_tip(candidates: &[Vec<Blk>]) -> usize {
    let work: Vec<u64> = candidates.iter().map(|c| chain_work(c)).collect();
    let mut best = 0usize;
    for i in 1..candidates.len() {
        let wins = work[i] > work[best]
            || (work[i] == work[best]
                && candidates[i].last().unwrap().nonce < candidates[best].last().unwrap().nonce);
        if wins {
            best = i;
        }
    }
    best
}

/// Oracle: consensus_select_tip — selection matches the independent
/// expected computation over random two-way forks.
fn oracle_consensus(case: usize, rng: &mut Lcg) -> Option<String> {
    let make_chain = |len: usize, difficulty: u32, r: &mut Lcg| -> Vec<Blk> {
        let mut chain = Vec::with_capacity(len);
        let mut parent_hash = [0u8; DIGEST_LEN];
        for h in 0..len {
            let mut b = Blk {
                height: h as u64,
                parent_hash,
                difficulty_target: difficulty,
                nonce: r.next_u64(),
                timestamp_slot: h as u64,
            };
            if !mine_tick(&mut b, 1 << 10) {
                b.nonce = 0; // unreachable at difficulty <= 10 in practice
            }
            parent_hash = sha256(&b.header_bytes());
            chain.push(b);
        }
        chain
    };
    let d = 1 + (case % 4) as u32;
    let len_a = 1 + (case % 3);
    let len_b = 1 + ((case / 3) % 3);
    let a = make_chain(len_a, d, rng);
    let b = make_chain(len_b, d, rng);
    let candidates = vec![a, b];
    let want = expected_tip(&candidates);
    match select_tip(&candidates) {
        Some(got) if got == want => None,
        Some(got) => Some(format!(
            "case {case}: tip mismatch (expected chain {want}, got {got})"
        )),
        None => Some(format!("case {case}: empty selection over 2 chains")),
    }
}

/// Oracle: ledger_apply_transition — conservation over funded accounts.
fn oracle_ledger(case: usize, rng: &mut Lcg) -> Option<String> {
    let mut ledger = Ledger::new();
    let a: AccountId = rng.digest();
    let b: AccountId = rng.digest();
    let amt = 1 + rng.next_u64() % 1_000_000;
    let amt = amt as u128;
    ledger.fund(a, amt);
    let before = ledger.supply();
    match ledger.apply_transition(&[(a, amt)], &[(b, amt)]) {
        Ok(()) => {
            if ledger.balance(&a) != 0 || ledger.balance(&b) != amt || ledger.supply() != before {
                Some(format!(
                    "case {case}: conservation violated (a={}, b={}, supply {} -> {})",
                    ledger.balance(&a),
                    ledger.balance(&b),
                    before,
                    ledger.supply()
                ))
            } else {
                None
            }
        }
        Err(e) => Some(format!("case {case}: honest transition refused: {e:?}")),
    }
}

/// Oracle: pn64_mask_apply — on the enabled domain the gated fire law must
/// agree with the ungated XOR law; off it, apply_mask must refuse. Tables
/// must equal the canonical six (t04 corrected pre 0x0010).
fn oracle_pn64(case: usize, rng: &mut Lcg) -> Option<String> {
    // Canonical-six exact-mask sub-check (t04 correction regression).
    for (idx, &(pre, post)) in PN64_TRANSITIONS.iter().enumerate() {
        if PN64_PRE_MASKS[idx] != pre || PN64_POST_MASKS[idx] != post {
            return Some(format!(
                "case {case}: mask-table drift at opcode {:#04x} (pre={:#06x}, post={:#06x})",
                idx + 1,
                PN64_PRE_MASKS[idx],
                PN64_POST_MASKS[idx]
            ));
        }
    }
    let marking = (rng.next_u64() & 0xFFFF) as u16;
    let opcode = 1 + (rng.next_u64() % PN64_VERB_COUNT as u64) as usize;
    let (pre, post) = PN64_TRANSITIONS[opcode - 1];
    match apply_mask(marking, opcode) {
        Ok(next) => {
            if (marking & pre) != pre {
                return Some(format!(
                    "case {case}: fired off the enabled domain (m={marking:#06x}, pre={pre:#06x})"
                ));
            }
            // On the enabled domain, gated law == ungated XOR law.
            if next != fire_xor_unchecked(marking, pre, post) {
                return Some(format!(
                    "case {case}: gated/XOR fire-law divergence on ENABLED domain \
                     (m={marking:#06x}, pre={pre:#06x}, post={post:#06x})"
                ));
            }
            None
        }
        Err(Pn64Refusal::NotEnabled { .. }) => {
            if (marking & pre) == pre {
                return Some(format!(
                    "case {case}: enabled transition refused (m={marking:#06x}, pre={pre:#06x})"
                ));
            }
            None
        }
        Err(e) => Some(format!("case {case}: unexpected refusal {e:?}")),
    }
}

/// Run one target's full corpus (seeded per target name); returns the run
/// summary, naming the first mismatch if any.
pub fn run_target(spec: &TargetSpec) -> TargetRun {
    let oracle = match oracle_registry(spec.oracle_fn) {
        Some(o) => o,
        None => {
            return TargetRun {
                name: spec.name,
                clean: 0,
                total: spec.corpus_size,
            }
        }
    };
    let mut clean = 0usize;
    for case in 0..spec.corpus_size {
        let mut rng = Lcg::new(
            0x5372_6174_61u64.wrapping_add(case as u64),
        );
        if let Some(_detail) = oracle(case, &mut rng) {
            // The caller (run_audit) re-runs the failing oracle case to
            // name the FIRST failing case for this target.
            return TargetRun { name: spec.name, clean, total: spec.corpus_size };
        }
        clean += 1;
    }
    TargetRun { name: spec.name, clean, total: spec.corpus_size }
}

/// Run the FULL audit: every manifest target × its full corpus. Mismatches
/// are named (target + case index + detail) — never a bare count.
pub fn run_audit() -> AuditReport {
    let mut report = AuditReport::default();
    for spec in AUDIT_TARGETS {
        // run_target stops at the first mismatch; to name it we re-run the
        // failing oracle case here.
        let run = run_target(spec);
        if run.clean < run.total {
            let oracle = oracle_registry(spec.oracle_fn).expect("registry checked above");
            for case in 0..spec.corpus_size {
                let mut rng = Lcg::new(0x5372_6174_61u64.wrapping_add(case as u64));
                if let Some(detail) = oracle(case, &mut rng) {
                    report.mismatches.push(Mismatch {
                        target: spec.name,
                        case_index: case,
                        detail,
                    });
                    break;
                }
            }
        }
        report.per_target.push(run);
    }
    // Every manifest attack must still resolve to a known target.
    for attack in KNOWN_ATTACKS {
        if !AUDIT_TARGETS.iter().any(|t| t.name == attack.target) {
            report.mismatches.push(Mismatch {
                target: attack.attack,
                case_index: 0,
                detail: format!(
                    "dangling attack: target '{}' not in the manifest",
                    attack.target
                ),
            });
        }
    }
    report
}

// ── Known-attack regressions + corpus court ───────────────────────────

#[cfg(test)]
mod tests {
    use super::*;

    /// Manifest closure: 6 targets, 10 attacks, every attack resolves,
    /// every corpus is 1000 cases, every oracle is registered.
    #[test]
    fn manifest_is_closed() {
        assert_eq!(AUDIT_TARGETS.len(), 6, "6 S10 fuzz targets projected");
        assert_eq!(KNOWN_ATTACKS.len(), 10, "10 known attacks projected (5 S10 + 5 refresh)");
        for t in AUDIT_TARGETS {
            assert_eq!(t.corpus_size, 1000, "target {} corpus", t.name);
            assert!(
                oracle_registry(t.oracle_fn).is_some(),
                "oracle {} unregistered",
                t.oracle_fn
            );
            assert!(t.module.contains("strata-"), "target {} provenance", t.name);
        }
        for a in KNOWN_ATTACKS {
            assert!(
                AUDIT_TARGETS.iter().any(|t| t.name == a.target),
                "attack {} targets unknown '{}'",
                a.attack,
                a.target
            );
            assert!(!a.expected_refusal.is_empty(), "attack {} refusal", a.attack);
        }
    }

    /// THE CORPUS COURT: every target runs 1000/1000 clean. Any failure
    /// names the target, the case index, and the mismatch detail.
    #[test]
    fn corpus_runs_1000_clean_per_target() {
        let report = run_audit();
        for t in &report.per_target {
            assert_eq!(
                t.clean, t.total,
                "target {} failed at case {}",
                t.name,
                t.total - t.clean
            );
            assert_eq!(t.total, 1000, "target {} corpus size", t.name);
        }
        assert!(
            report.mismatches.is_empty(),
            "audit mismatches: {:?}",
            report.mismatches
        );
        assert!(report.is_clean(), "report not clean: {}", report.summary());
    }

    /// MerkleSecondPreimage: substituting a different leaf into an honest
    /// proof fails for every corpus leaf set (the fixed-width leaf law
    /// removes the concatenation ambiguity the classic attack needs).
    #[test]
    fn attack_merkle_second_preimage_refused() {
        let mut rng = Lcg::new(0xBEEF);
        for _ in 0..500 {
            let n = 2 + (rng.next_u64() % 8) as usize;
            let leaves: Vec<[u8; DIGEST_LEN]> = (0..n).map(|_| rng.digest()).collect();
            let root = merkle_root(&leaves).unwrap();
            for idx in 0..n {
                let proof = merkle_proof(&leaves, idx).unwrap();
                let forged: [u8; DIGEST_LEN] = rng.digest();
                if forged != leaves[idx] {
                    assert!(
                        !merkle_verify(&root, &forged, idx, &proof),
                        "second-preimage: substituted leaf verified at {}/{}", idx, n
                    );
                }
                // A proof built under a different tree never verifies here.
                let other: Vec<[u8; DIGEST_LEN]> = (0..n).map(|_| rng.digest()).collect();
                let other_proof = merkle_proof(&other, idx).unwrap();
                assert!(
                    !merkle_verify(&root, &leaves[idx], idx, &other_proof),
                    "cross-tree proof verified at {}/{}", idx, n
                );
            }
        }
    }

    /// TxLengthConfusion: every truncated prefix and every overlong frame
    /// is refused with the typed length error — never a partial decode.
    #[test]
    fn attack_tx_length_confusion_refused() {
        let mut rng = Lcg::new(0xCAFE);
        for i in 0..200 {
            let frame = encode_frame(i as u64, 2, 1, &mut rng);
            // Every truncated prefix shorter than the header is Truncated;
            // every full-header-but-short frame is CountMismatch.
            for cut in 0..frame.len() {
                let e = decode_frame(&frame[..cut]).unwrap_err();
                if cut < TX_HEADER_LEN {
                    assert_eq!(e, TxError::Truncated, "prefix cut at {cut}");
                } else {
                    assert_eq!(e, TxError::CountMismatch, "prefix cut at {cut}");
                }
            }
            // Overlong frame (extra trailing bytes) is CountMismatch.
            let mut long = frame.clone();
            long.push(0x00);
            assert_eq!(decode_frame(&long).unwrap_err(), TxError::CountMismatch);
            long.extend_from_slice(&[0xAB; 9]);
            assert_eq!(decode_frame(&long).unwrap_err(), TxError::CountMismatch);
        }
    }

    /// ChainReorgWithheld: an attacker withholding one block while the
    /// honest chain grows cannot overtake — the released single-block fork
    /// is never selected over the heavier honest tip; a genuinely heavier
    /// fork IS (positive control).
    #[test]
    fn attack_chain_reorg_withheld_refused() {
        let mut rng = Lcg::new(0x5EED);
        let make_chain = |len: usize, r: &mut Lcg| -> Vec<Blk> {
            let mut chain = Vec::new();
            let mut parent_hash = [0u8; DIGEST_LEN];
            for h in 0..len {
                let mut b = Blk {
                    height: h as u64,
                    parent_hash,
                    difficulty_target: 8,
                    nonce: r.next_u64(),
                    timestamp_slot: h as u64,
                };
                assert!(mine_tick(&mut b, 1 << 12), "mining block {}", h);
                parent_hash = sha256(&b.header_bytes());
                chain.push(b);
            }
            chain
        };
        let honest = make_chain(3, &mut rng); // work 3 * 256 = 768
        assert_eq!(chain_work(&honest), 3 * 256);
        // The attacker's withheld fork: one block off the honest GENESIS
        // (released late, after the honest chain grew past it).
        let withheld = make_chain(1, &mut rng);
        assert_eq!(select_tip(&[honest.clone(), withheld]), Some(0),
            "withheld single-block fork must not overtake the honest tip");
        // Positive control: a genuinely heavier released fork wins.
        let heavier = make_chain(4, &mut rng);
        assert_eq!(select_tip(&[honest, heavier]), Some(1));
    }

    /// ConsensusSelfishMining: the withhold-then-release report pattern
    /// (>= 2 Withheld then Released) fires; short runs and benign traffic
    /// stay silent.
    #[test]
    fn attack_consensus_selfish_mining_detected() {
        let w = GossipEvent::Withheld;
        let r = GossipEvent::Released;
        assert!(selfish_mining_detected(&[w, w, r]), "pattern must fire");
        assert!(selfish_mining_detected(&[w, w, w, r]), "long run must fire");
        assert!(selfish_mining_detected(&[r, w, w, r, w, w, r]),
            "repeated pattern must fire");
        assert!(!selfish_mining_detected(&[w, r]), "short run is benign");
        assert!(!selfish_mining_detected(&[r, r, r]), "honest traffic silent");
        assert!(!selfish_mining_detected(&[]), "empty gossip silent");
    }

    /// LedgerOverflow: a transition whose output sum overflows u128 is
    /// refused with the typed Overflow refusal BEFORE any balance moves.
    #[test]
    fn attack_ledger_overflow_refused() {
        let mut ledger = Ledger::new();
        let a = [1u8; DIGEST_LEN];
        let b = [2u8; DIGEST_LEN];
        let c = [3u8; DIGEST_LEN];
        ledger.fund(a, 1);
        let before = ledger.supply();
        let e = ledger
            .apply_transition(&[(a, 1)], &[(b, 1), (c, u128::MAX)])
            .unwrap_err();
        assert_eq!(e, LedgerRefusal::Overflow);
        // Masked commit: NOTHING moved.
        assert_eq!(ledger.supply(), before, "refused transition mutated state");
        assert_eq!(ledger.balance(&b), 0);
        assert_eq!(ledger.balance(&c), 0);
        // Input-side overflow too.
        let e2 = ledger
            .apply_transition(&[(a, u128::MAX), (b, u128::MAX)], &[(c, 1)])
            .unwrap_err();
        assert_eq!(e2, LedgerRefusal::Overflow);
        // Conservation refusal (positive control of the other valve).
        let e3 = ledger.apply_transition(&[(a, 1)], &[(c, 2)]).unwrap_err();
        assert_eq!(e3, LedgerRefusal::Conservation);
    }

    /// Pn64FireLawXorDivergence: OFF the enabled domain the ungated XOR law
    /// sets pre-bits the marking never had (pinned divergence witness
    /// m=0x0000, pre=0x0002, post=0x000C: 0x000E vs 0x000C); the audited
    /// apply_mask refuses there instead of firing.
    #[test]
    fn attack_pn64_fire_law_xor_divergence_refused() {
        // The pinned graphlaw pn64_abi_conformance divergence witness.
        assert_eq!(fire_xor_unchecked(0x0000, 0x0002, 0x000C), 0x000E);
        assert_eq!((0x0000 & !0x0002) | 0x000C, 0x000C);
        assert_eq!(
            apply_mask(0x0000, 2),
            Err(Pn64Refusal::NotEnabled { marking: 0x0000, pre: 0x0002 }),
            "ungated fire off the enabled domain must be refused"
        );
        // Sweep: on the enabled domain both laws agree; off it the gated
        // law refuses and the XOR law is the one that moved the state.
        for m in 0u16..=255u16 {
            for opcode in 1..=PN64_VERB_COUNT {
                let (pre, post) = PN64_TRANSITIONS[opcode - 1];
                if (m & pre) == pre {
                    assert_eq!(
                        apply_mask(m, opcode).unwrap(),
                        fire_xor_unchecked(m, pre, post),
                        "enabled-domain divergence m={m:#04x} opcode {opcode}"
                    );
                } else {
                    assert_eq!(
                        apply_mask(m, opcode),
                        Err(Pn64Refusal::NotEnabled { marking: m, pre }),
                        "off-domain fire accepted m={m:#04x} opcode {opcode}"
                    );
                }
            }
        }
    }

    /// Pn64T04MaskCorrection: the t04 adopt-amendment precondition stays at
    /// the corrected 0x0010 (post 0x0008); any drift from the canonical six
    /// is a named table-drift refusal.
    #[test]
    fn attack_pn64_t04_mask_correction_pinned() {
        assert_eq!(PN64_PRE_MASKS[3], 0x0010, "t04 pre must be the corrected 0x0010");
        assert_eq!(PN64_POST_MASKS[3], 0x0008, "t04 post");
        // Positive control: pre-correction shape (pre 0x0008) is NOT present.
        assert_ne!(PN64_PRE_MASKS[3], 0x0008);
        // t04 must not fire without the amendment place 0x0010; it fires
        // exactly when that place holds.
        assert_eq!(
            apply_mask(0x0008, 4),
            Err(Pn64Refusal::NotEnabled { marking: 0x0008, pre: 0x0010 })
        );
        assert_eq!(apply_mask(0x0010, 4).unwrap(), 0x0008);
        assert_eq!(apply_mask(0x0018, 4).unwrap(), 0x0000 | 0x0008);
    }

    /// ValveZeroRefusalReceipt: refusal receipts are derived from the typed
    /// valve — a pn64 refusal names its fields; the all-zero receipt shape
    /// (fixed in strata-valve-pack @ 8210f1b24) is structurally impossible
    /// in the audit surface: every Debug/typed refusal here carries its
    /// marking/pre values, never zeros everywhere.
    #[test]
    fn attack_valve_zero_refusal_receipt_refused() {
        let e = apply_mask(0x0000, 2).unwrap_err();
        let rendered = format!("{e:?}");
        // A zero-receipt would render with no identifying fields at all.
        assert!(rendered.contains("NotEnabled"), "typed refusal identity present");
        assert!(rendered.contains("0"), "marking/pre values present in receipt");
        assert_ne!(rendered, "NotEnabled", "receipt must carry consequence fields");
    }

    /// LedgerTokenSumNonConservation: the naive token-sum (raw supply
    /// fold) is exactly what the conservation valve refuses to trust —
    /// unbalanced transitions are refused even when the naive sum would
    /// stay constant across mint-shaped outputs (Lean t02/t05 pattern).
    #[test]
    fn attack_ledger_token_sum_non_conservation_refused() {
        let mut ledger = Ledger::new();
        let a = [7u8; DIGEST_LEN];
        let b = [8u8; DIGEST_LEN];
        ledger.fund(a, 5);
        // Naive sum view: supply() is 5; a transition minting 3 into b with
        // a 3-input from a would pass a pure total-sum check only if the
        // input side is inflated; the valve refuses the deficit outright.
        let e = ledger.apply_transition(&[(a, 2)], &[(b, 5)]).unwrap_err();
        assert_eq!(e, LedgerRefusal::Conservation, "t02-shaped deficit refused");
        // Masked commit: nothing moved on refusal.
        assert_eq!(ledger.balance(&a), 5);
        assert_eq!(ledger.balance(&b), 0);
        // t05-shaped counterexample: equal naive totals via overflow-adjacent
        // split — conservation still enforced per-account.
        let e2 = ledger.apply_transition(&[(a, 5)], &[(b, 3)]).unwrap_err();
        assert_eq!(e2, LedgerRefusal::Conservation);
        assert_eq!(ledger.balance(&b), 0);
    }

    /// VacuousEunitHarness (cross-repo, erlmcp): the corpus court itself is
    /// the anti-vacuity gate — zero-case targets and unregistered oracles
    /// are refusals, and a harness that executes zero assertions cannot be
    /// clean (clean requires total > 0 per target).
    #[test]
    fn attack_vacuous_eunit_harness_refused() {
        // Zero-case corpus: is_clean refuses (total > 0 required).
        let vacuous = AuditReport {
            per_target: vec![TargetRun { name: "vacuous", clean: 0, total: 0 }],
            mismatches: vec![],
        };
        assert!(!vacuous.is_clean(), "zero-assertion harness must not read clean");
        // Unregistered oracle: run_target returns clean=0/total=1000.
        let ghost = TargetSpec {
            name: "ghost",
            module: "strata-ghost-pack::ghost",
            corpus_size: 1000,
            oracle_fn: "oracle_unregistered",
        };
        let run = run_target(&ghost);
        assert_eq!(run.clean, 0, "unregistered oracle must not read clean");
        // The real manifest stays non-vacuous: every oracle registered.
        for t in AUDIT_TARGETS {
            assert!(oracle_registry(t.oracle_fn).is_some());
            assert!(t.corpus_size > 0);
        }
    }
}
