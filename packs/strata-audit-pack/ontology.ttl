# strata-audit-pack ontology — Strata external audit surface (roadmap slice S10).
#
# LAW PROVENANCE (S10, per docs/sjira/v26.10.8/STRATA-BLOCKCHAIN-ROADMAP.md):
# this pack is the AUDIT MANIFEST, not an engine. It does not modify the
# landed S1-S8 packs; it names each engine's audit target and the known
# attacks the landed refusals must repel. The generated runner executes
# inline provenance COPIES of the target functions — so the audit's standing
# is exactly the standing of the copy: it audits the LAW AS CAPTURED at the
# copy point; re-run after any engine edit (README honest boundary).
#
# strata-net-pack (S9 hardening) is CORPUS-PENDING: no FuzzTarget cites it.
#
# S10 external-audit refresh (lane L28, 2026-10-13): the known-attack corpus
# was extended with this session's real findings — pn64 fire-law XOR
# divergence (graphlaw pn64_abi_conformance), pn64 t04 mask correction,
# valve all-zero refusal receipts (strata-valve-pack @ 8210f1b24), ledger
# naive token-sum non-conservation (Lean witness t02/t05), and the erlmcp
# vacuous-eunit cross-repo test-vacuity pattern. A new FuzzTarget
# (pn64_mask_apply) pins the pn64 mask law as an inline provenance copy.
#
# L127 refresh (2026-10-13): three more real findings — consensus chain-work
# u64 saturation tie (fixed u128 @ 0c7c9e594; u64 twin pinned as the sabotage
# oracle), the cross-repo ggen SPARQL UNION/OPTIONAL binding-leak (OPEN-
# UPSTREAM; rdflib row-shape differential court), and graphlaw wasm
# non-reproducible builds (OPEN; ABI-surface gate @ b473313).
#
# The FuzzTarget/KnownAttack individuals ARE the audit-corpus manifest:
# gate 010 fails closed on any FuzzTarget missing targetModule/corpusSize/
# oracleFn; gate 020 fails closed on any KnownAttack whose target does not
# resolve to a known FuzzTarget (dangling-attack refusal) or whose expected
# refusal path is empty.

@prefix st:  <https://strata.chatman.ai/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ── Audit classes ─────────────────────────────────────────────────────

st:FuzzTarget a rdfs:Class ; rdfs:label "FuzzTarget" ;
    rdfs:comment "A named fuzz surface over one landed strata engine function. Every FuzzTarget MUST carry st:targetModule (provenance pack + function), st:corpusSize (deterministic LCG cases per run), and st:oracleFn (the runner oracle dispatched by name) — gate 010 fails closed otherwise." .

st:KnownAttack a rdfs:Class ; rdfs:label "KnownAttack" ;
    rdfs:comment "A named known attack against the strata engine family, mapped (st:targets) to the FuzzTarget whose engine must repel it, carrying st:attackClass and the typed st:expectedRefusal. Gate 020 is the dangling-attack refusal: an attack naming a target absent from the manifest is a violation row." .

st:AuditCase a rdfs:Class ; rdfs:label "AuditCase" ;
    rdfs:comment "The audit run record carrier: AUDIT_PLAN carries the last-clean-corpus-run date (st:lastCleanRun) — the receipt hook the corpus court refreshes." .

# ── Audit properties ──────────────────────────────────────────────────

st:targetModule a rdf:Property ; rdfs:label "targetModule" ;
    rdfs:comment "Provenance of the audited function: the source pack and function path (e.g. strata-hash-pack::merkle_root). Documentation-only cross-pack citation — no owl:imports (FM-PACK-018)." ;
    rdfs:domain st:FuzzTarget ; rdfs:range xsd:string .

st:corpusSize a rdf:Property ; rdfs:label "corpusSize" ;
    rdfs:comment "Deterministic LCG cases per audit run for this target (1000)." ;
    rdfs:domain st:FuzzTarget ; rdfs:range xsd:integer .

st:oracleFn a rdf:Property ; rdfs:label "oracleFn" ;
    rdfs:comment "Name of the runner oracle dispatched for this target (must match the generated dispatcher's registry)." ;
    rdfs:domain st:FuzzTarget ; rdfs:range xsd:string .

st:attackClass a rdf:Property ; rdfs:label "attackClass" ;
    rdfs:comment "Attack taxonomy class of a KnownAttack (e.g. collision / framing-confusion / reorg / incentive / arithmetic)." ;
    rdfs:domain st:KnownAttack ; rdfs:range xsd:string .

st:lastCleanRun a rdf:Property ; rdfs:label "lastCleanRun" ;
    rdfs:comment "Date of the last fully-clean corpus run (1000/1000 per target, all attack regressions green) — refreshed by the corpus court." ;
    rdfs:domain st:AuditCase ; rdfs:range xsd:string .

st:targets a rdf:Property ; rdfs:label "targets" ;
    rdfs:comment "Attack-to-target mapping: the FuzzTarget whose engine must repel this KnownAttack. Dangling values are refused by gate 020." ;
    rdfs:domain st:KnownAttack ; rdfs:range st:FuzzTarget .

st:expectedRefusal a rdf:Property ; rdfs:label "expectedRefusal" ;
    rdfs:comment "The typed refusal the engine must produce when repelling this attack (e.g. TxError::CountMismatch). Gate 020 requires it non-empty." ;
    rdfs:domain st:KnownAttack ; rdfs:range xsd:string .

# ── AUDIT_PLAN individual (the AuditCase carrier) ─────────────────────

st:AUDIT_PLAN a st:AuditCase ;
    rdfs:label "AUDIT_PLAN" ;
    rdfs:comment "The S10 audit plan record: corpus manifest below; lastCleanRun refreshed on every clean court run." ;
    st:lastCleanRun "2026-10-13" .

# ── FuzzTargets (the corpus manifest; gate 010 fails closed) ──────────

st:merkle_root_over_leaves a st:FuzzTarget ;
    rdfs:label "merkle_root_over_leaves" ;
    rdfs:comment "Fuzz surface: Merkle root + inclusion proofs over random leaf sets. Provenance pack: strata-hash-pack (S1) — generated/audit_corpus.rs carries the inline provenance copy." ;
    st:targetModule "strata-hash-pack::merkle_root" ;
    st:corpusSize "1000"^^xsd:integer ;
    st:oracleFn "oracle_merkle" .

st:tx_decode_framed a st:FuzzTarget ;
    rdfs:label "tx_decode_framed" ;
    rdfs:comment "Fuzz surface: encode/decode round-trip over the framed fixed-width tx wire format. Provenance pack: strata-tx-pack (S2)." ;
    st:targetModule "strata-tx-pack::Tx::decode" ;
    st:corpusSize "1000"^^xsd:integer ;
    st:oracleFn "oracle_tx" .

st:chain_validate_block a st:FuzzTarget ;
    rdfs:label "chain_validate_block" ;
    rdfs:comment "Fuzz surface: parent/child block validation (height continuity, parent-hash binding, PoW target, monotonic slot). Provenance pack: strata-chain-pack (S5)." ;
    st:targetModule "strata-chain-pack::validate_block" ;
    st:corpusSize "1000"^^xsd:integer ;
    st:oracleFn "oracle_chain" .

st:consensus_select_tip a st:FuzzTarget ;
    rdfs:label "consensus_select_tip" ;
    rdfs:comment "Fuzz surface: heaviest-chain tip selection with the deterministic lower-nonce tie-break. Provenance pack: strata-consensus-pack (S8)." ;
    st:targetModule "strata-consensus-pack::select_tip" ;
    st:corpusSize "1000"^^xsd:integer ;
    st:oracleFn "oracle_consensus" .

st:ledger_apply_transition a st:FuzzTarget ;
    rdfs:label "ledger_apply_transition" ;
    rdfs:comment "Fuzz surface: conservation law over applied transitions (masked commit, checked arithmetic). Provenance pack: strata-ledger-pack (S4)." ;
    st:targetModule "strata-ledger-pack::apply_transition" ;
    st:corpusSize "1000"^^xsd:integer ;
    st:oracleFn "oracle_ledger" .

# ── KnownAttacks (attack→target→typed refusal; gate 020 fails closed) ─

st:MerkleSecondPreimage a st:KnownAttack ;
    rdfs:label "MerkleSecondPreimage" ;
    rdfs:comment "Second-preimage / proof-substitution attack: an attacker substitutes a different leaf into a valid inclusion proof (exploiting width ambiguity in unframed concatenation). The fixed-width leaf law (DIGEST_LEN leaves, fixed-width node buffers) removes the concatenation ambiguity the classic attack needs." ;
    st:attackClass "collision" ;
    st:targets st:merkle_root_over_leaves ;
    st:expectedRefusal "merkle_verify returns false for any substituted leaf under an honest proof" .

st:TxLengthConfusion a st:KnownAttack ;
    rdfs:label "TxLengthConfusion" ;
    rdfs:comment "Framing-confusion attack: truncated or overlong frames crafted so a lenient decoder reads attacker-chosen counts as payload. The exact-length law (bytes.len() != header + n*36 + m*9 refused) closes it." ;
    st:attackClass "framing" ;
    st:targets st:tx_decode_framed ;
    st:expectedRefusal "TxError::Truncated or TxError::CountMismatch on every truncated/overlong frame" .

st:ChainReorgWithheld a st:KnownAttack ;
    rdfs:label "ChainReorgWithheld" ;
    rdfs:comment "Withheld-block reorg attack: a miner privately extends a fork and releases only when favorable. The heaviest-work law with the deterministic lower-nonce tie-break admits a released fork only when it is genuinely heavier; a single released withheld block never overtakes an honest heavier tip." ;
    st:attackClass "reorg" ;
    st:targets st:consensus_select_tip ;
    st:expectedRefusal "select_tip keeps the honest heaviest tip; the withheld single-block fork is not selected" .

st:ConsensusSelfishMining a st:KnownAttack ;
    rdfs:label "ConsensusSelfishMining" ;
    rdfs:comment "Selfish-mining incentive attack (withhold-then-release report pattern): a Released gossip event preceded by a run of >= 2 Withheld events is flagged as the selfish-mining pattern; benign traffic is not flagged." ;
    st:attackClass "incentive" ;
    st:targets st:consensus_select_tip ;
    st:expectedRefusal "selfish_mining_detected fires on the withhold-then-release pattern and stays silent on benign sequences" .

st:LedgerOverflow a st:KnownAttack ;
    rdfs:label "LedgerOverflow" ;
    rdfs:comment "Arithmetic-overflow attack: a transition whose output-side amounts exceed u128 in sum (or any checked add overflows) must be refused before any balance mutates (masked commit)." ;
    st:attackClass "arithmetic" ;
    st:targets st:ledger_apply_transition ;
    st:expectedRefusal "LedgerRefusal::Overflow refused before any balance mutation" .

# ── S10 external-audit refresh: landed-work attack entries (2026-10-13) ─
#
# Subject pins (pack + commit) and detection courts live in the rdfs:comment
# of each entry: attack class, subject pin, detection court, status.

st:pn64_mask_apply a st:FuzzTarget ;
    rdfs:label "pn64_mask_apply" ;
    rdfs:comment "Fuzz surface: pn64 fire law (precondition-gated mask transition m' = (m & !pre) | post over canonical six RONR transitions). Provenance pack: strata-pn64-pack @ 00e0b086b (T2) — generated/pn64_masks.rs carries the law; the audit copy is inline." ;
    st:targetModule "strata-pn64-pack::apply_mask" ;
    st:corpusSize "1000"^^xsd:integer ;
    st:oracleFn "oracle_pn64" .

st:Pn64FireLawXorDivergence a st:KnownAttack ;
    rdfs:label "Pn64FireLawXorDivergence" ;
    rdfs:comment "STATUS: repelled (regression). Attack class: arithmetic-abi. Subject pin: strata-pn64-pack @ 00e0b086b; graphlaw pn64_abi_conformance witness. The ungated XOR fire law (m ^ W-) | W+ diverges from the clear-then-set law (m & !pre) | post OFF the enabled domain: divergence witness m=0x0000, pre=0x0002, post=0x000C — XOR yields 0x000E (sets an absent pre-bit), clear-then-set yields 0x000C. Callers must establish enabled(m, pre) = (m & pre) == pre before firing. DETECTION COURT: strata-pn64-pack fire_law_equivalence_on_enabled_domain court + graphlaw pn64_abi_conformance; the audit corpus court pins the divergence witness as a regression." ;
    st:attackClass "arithmetic-abi" ;
    st:targets st:pn64_mask_apply ;
    st:expectedRefusal "firing without enabled(m, pre) is refused: the audited apply_mask gates on (m & pre) == pre, and the divergence witness (m=0x0000, pre=0x0002, post=0x000C -> 0x000E vs 0x000C) stays pinned in the corpus" .

st:Pn64T04MaskCorrection a st:KnownAttack ;
    rdfs:label "Pn64T04MaskCorrection" ;
    rdfs:comment "STATUS: repelled (regression). Attack class: arithmetic. Subject pin: strata-pn64-pack @ 00e0b086b. Mask-correction attack: a stale or transposed precondition mask lets a transition fire without its required place — the t04 adopt-amendment precondition was corrected 0x0008 -> 0x0010 (adopt-amendment requires the amendment place, not the motion place). DETECTION COURT: strata-pn64-pack canonical_six_exact_masks court (generated tables vs canonical six in ronr.rs); the audit corpus court re-asserts the corrected table every run." ;
    st:attackClass "arithmetic" ;
    st:targets st:pn64_mask_apply ;
    st:expectedRefusal "PRE_MASKS[t04] == 0x0010 and POST_MASKS[t04] == 0x0008 (canonical six exact-mask court); any drift from the corrected table is a corpus mismatch naming the opcode" .

st:ValveZeroRefusalReceipt a st:KnownAttack ;
    rdfs:label "ValveZeroRefusalReceipt" ;
    rdfs:comment "STATUS: fixed in strata-valve-pack @ 8210f1b24 (L13, seam-29 closure); kept as regression. Attack class: telemetry-integrity. Subject pin: strata-valve-pack @ 8210f1b24. Telemetry attack: refusal receipts emitted with all-zero fields (no identity, no consequence) — a valve that reports a refusal nobody can replay. The fix derives every receipt field from the typed refusal valve. DETECTION COURT: strata-valve-pack refusal-receipt derivation court; the audit corpus keeps the entry so the zero-receipt pattern stays a named attack class." ;
    st:attackClass "telemetry-integrity" ;
    st:targets st:ledger_apply_transition ;
    st:expectedRefusal "every refusal receipt carries non-zero identity/consequence fields derived from the typed LedgerRefusal; the all-zero receipt shape is a named regression entry" .

st:LedgerTokenSumNonConservation a st:KnownAttack ;
    rdfs:label "LedgerTokenSumNonConservation" ;
    rdfs:comment "STATUS: repelled (regression). Attack class: conservation. Subject pin: strata-ledger-pack @ 00e0b086b (S4 law, T2 OCEL surface); Lean witness t02/t05 counterexamples. Naive token-sum attack: summing balances without the masked-commit conservation valve lets mint/burn slip through an unbalanced transition — the Lean witnesses t02/t05 exhibit concrete input/output multisets where the naive sum preserves the total but loses per-account conservation. DETECTION COURT: strata-ledger-pack conservation valve (LedgerRefusal::Conservation, checked before commit) + Lean witness court; the audit corpus court runs conservation over 1000 funded transitions per run." ;
    st:attackClass "conservation" ;
    st:targets st:ledger_apply_transition ;
    st:expectedRefusal "LedgerRefusal::Conservation on every unbalanced transition; supply invariant holds before/after every applied transition (Lean t02/t05 counterexamples stay refused)" .

st:DuplicateInputAccountValueCreation a st:KnownAttack ;
    rdfs:label "DuplicateInputAccountValueCreation" ;
    rdfs:comment "STATUS: repelled (regression, L107). Attack class: conservation. Subject pin: strata-ledger-pack (L107 fix; Lean witness mfact procint/ProcInt/Petri/LedgerConservation.lean @ main). Duplicate-input shadow-overwrite attack: two input rows for one account ((acct0,5),(acct0,5)) each read the ORIGINAL balance and overwrite the same shadow slot, so only the last deduction lands while sum_in counts both rows — 5 units minted from nothing through a fully gate-passing tx. DETECTION COURT: strata-ledger-pack duplicate-input debit-accumulation law (per-account debit deltas applied once; lean_counterexample_duplicate_input_refused + conservation_property_500_txs_with_duplicate_inputs courts in generated/ledger_state.rs); the audit corpus court keeps the counterexample shape pinned." ;
    st:attackClass "conservation" ;
    st:targets st:ledger_apply_transition ;
    st:expectedRefusal "the exact Lean counterexample (inputs [(acct0,5),(acct0,5)], outputs [(acct1,10)], balance 5) refuses LedgerRefusal::InsufficientFunds with the state bit-identical; same-account debit rows accumulate before the funds check" .

st:ChainWorkSaturationTie a st:KnownAttack ;
    rdfs:label "ChainWorkSaturationTie" ;
    rdfs:comment "STATUS: repelled (regression; reproduced pre-fix, fixed u128 @ strata-consensus-pack 0c7c9e594; the sabotage twin is the u64 saturating variant). Attack class: arithmetic. Subject pin: strata-consensus-pack @ 0c7c9e594 (L127). Chain-work saturation attack: a u64 saturating accumulator saturates long chains' total work (>= 64 single blocks or fewer heavy ones), collapsing genuinely-heavier forks into an apparent TIE — the lower-nonce tie-break then mispicks the LIGHTER chain and an attacker forces a reorg with less work. The fix accumulates in u128 (chain_work_u128), so real ordering survives saturation of any u64-representable total. DETECTION COURT: consensus tie court — the audit corpus court pins the u64 variant as the sabotage twin and refuses any selection that disagrees with the u128 law." ;
    st:attackClass "arithmetic" ;
    st:targets st:consensus_select_tip ;
    st:expectedRefusal "select_tip (u128 accumulated work) never selects a chain whose u128 total is smaller; the pinned saturation witness (two chains whose u64 sums saturate equal while u128 totals differ) resolves to the genuinely-heavier chain, and the u64 twin's mispick stays pinned as the regression" .

st:GgenUnionBindingLeak a st:KnownAttack ;
    rdfs:label "GgenUnionBindingLeak" ;
    rdfs:comment "STATUS: OPEN-UPSTREAM (engine lane in flight; cross-repo ggen engine hazard, not a marketplace pack defect). Attack class: engine-hazard. Subject pin: ggen SPARQL serializer (cross-repo, external; two independent reports: ggen-marketplace cas commits.rq COALESCE-sentinel workaround, refusal-crosswalk UNION sentinels). Binding-leak attack: the serializer leaks unbound OPTIONAL/UNION bindings ACROSS rows — a variable unbound in the current solution row carries the PREVIOUS row's value, so projected COALESCE/sentinel fields silently read stale data and a downstream gate can admit on the wrong row's binding. Workaround (both report sites): explicit COALESCE sentinels per row. DETECTION COURT: row-shape differential court vs rdflib — same query, same graph, per-row binding shapes must match; the audit-corpus manifest-closure court (verify.py re-runs every gate via rdflib) is the in-pack witness while the upstream fix lands." ;
    st:attackClass "engine-hazard" ;
    st:targets st:pn64_mask_apply ;
    st:expectedRefusal "any projected field that rdflib binds as unbound but ggen fills with a stale cross-row value is a row-shape differential violation; in-pack, every gate stays zero-rows under rdflib and every projected corpus field carries its own row's binding (or an explicit sentinel)" .

st:WasmNonReproducibleBuild a st:KnownAttack ;
    rdfs:label "WasmNonReproducibleBuild" ;
    rdfs:comment "STATUS: OPEN (build-integrity; witnessed on 3 platforms; detection landed). Attack class: build-integrity. Subject pin: graphlaw @ b473313 (praxis_graphlaw.wasm build; path leakage + LLVM pool ordering make byte-reproducible wasm builds unreachable). Non-reproducible-build attack: two builds of the same source SHA yield different wasm bytes, so a consumed artifact cannot be tied to its source by digest — a substituted or stale .wasm passes as current because no byte-level identity exists to check. DETECTION COURT: ABI-surface gate (graphlaw b473313): the exported function surface + observable semantics are pinned instead of bytes, so a build is admitted iff its ABI surface and behavior match the pinned law even while bytes differ; byte-reproducibility stays a named open attack until upstream eliminates path/pool nondeterminism." ;
    st:attackClass "build-integrity" ;
    st:targets st:pn64_mask_apply ;
    st:expectedRefusal "a wasm artifact whose ABI surface or observable semantics drift from the pinned graphlaw law is refused at the ABI-surface gate; absence of byte-identity is disclosed (OPEN) rather than read as verification" .

st:VacuousEunitHarness a st:KnownAttack ;
    rdfs:label "VacuousEunitHarness" ;
    rdfs:comment "STATUS: cross-repo entry (erlmcp); no landed marketplace gate — detection is the audit-corpus manifest-closure test itself (corpus > 0, registered oracle per target, non-empty expectedRefusal per attack). Attack class: test-vacuity. Subject pin: erlmcp eunit suite (cross-repo, external). Vacuous-harness attack: a test module whose fixtures execute zero assertions — the harness reports green while verifying nothing (zero-information pass). DETECTION COURT: audit-corpus manifest closure (manifest_is_closed + corpus_runs_1000_clean_per_target refuse an empty corpus or an unregistered oracle); cross-repo instances are refused at the erlmcp boundary, not here." ;
    st:attackClass "test-vacuity" ;
    st:targets st:pn64_mask_apply ;
    st:expectedRefusal "a corpus target with zero cases or an unregistered oracle is a manifest-closure violation; every attack row must carry a non-empty expectedRefusal (gate 020)" .
