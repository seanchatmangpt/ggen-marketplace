@prefix tai: <https://chatmangpt.com/ontology/tai-rebuild#> .

# Complete synthetic CMD checkpoint surface for marketplace manufacture.
# It proves the pack's combinatorial/gate contract only; no option is executed.

tai:cmd-program tai:requiredBroker "BRCE" ; tai:directActuation false .

# Ten Gall checkpoints, each with an explicit refusal and required artifact.
tai:q-cp-01 a tai:GallCheckpoint ; tai:refusalCode "REFUSED:CP01" ; tai:requiredArtifact "artifact-01" .
tai:q-cp-02 a tai:GallCheckpoint ; tai:refusalCode "REFUSED:CP02" ; tai:requiredArtifact "artifact-02" ; tai:dependsOn tai:q-cp-01 .
tai:q-cp-03 a tai:GallCheckpoint ; tai:refusalCode "REFUSED:CP03" ; tai:requiredArtifact "artifact-03" ; tai:dependsOn tai:q-cp-02 .
tai:q-cp-04 a tai:GallCheckpoint ; tai:refusalCode "REFUSED:CP04" ; tai:requiredArtifact "artifact-04" ; tai:dependsOn tai:q-cp-03 .
tai:q-cp-05 a tai:GallCheckpoint ; tai:refusalCode "REFUSED:CP05" ; tai:requiredArtifact "artifact-05" ; tai:dependsOn tai:q-cp-04 .
tai:q-cp-06 a tai:GallCheckpoint ; tai:refusalCode "REFUSED:CP06" ; tai:requiredArtifact "artifact-06" ; tai:dependsOn tai:q-cp-05 .
tai:q-cp-07 a tai:GallCheckpoint ; tai:refusalCode "REFUSED:CP07" ; tai:requiredArtifact "artifact-07" ; tai:dependsOn tai:q-cp-06 .
tai:q-cp-08 a tai:GallCheckpoint ; tai:refusalCode "REFUSED:CP08" ; tai:requiredArtifact "artifact-08" ; tai:dependsOn tai:q-cp-07 .
tai:q-cp-09 a tai:GallCheckpoint ; tai:refusalCode "REFUSED:CP09" ; tai:requiredArtifact "artifact-09" ; tai:dependsOn tai:q-cp-08 .
tai:q-cp-10 a tai:GallCheckpoint ; tai:refusalCode "REFUSED:CP10" ; tai:requiredArtifact "artifact-10" ; tai:dependsOn tai:q-cp-09 .

# Twelve internal and thirteen external decision dimensions.
tai:tai-rebuild-v26-7-31
