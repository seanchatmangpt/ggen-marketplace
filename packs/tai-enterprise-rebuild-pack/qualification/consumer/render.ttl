@prefix tai: <https://chatmangpt.com/ontology/tai-rebuild#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Rendering-complete synthetic consumer data. These labels/triggers make the
# pack's published projections total without asserting real enterprise work.

tai:q-program
    a tai:EnterpriseRebuildProgram ;
    dcterms:title "Marketplace Qualification Enterprise Rebuild" ;
    tai:identifier "marketplace-qualification-enterprise-rebuild" ;
    tai:version "0.0.0-qualification" ;
    tai:requiredBroker "BRCE" ;
    tai:directActuation false ;
    tai:llmCalls false .

tai:q-family-1 skos:prefLabel "Foundation" .
tai:q-family-2 skos:prefLabel "Identity" .
tai:q-family-3 skos:prefLabel "Data" .
tai:q-family-4 skos:prefLabel "Process" .
tai:q-family-5 skos:prefLabel "Integration" .
tai:q-family-6 skos:prefLabel "Security" .
tai:q-family-7 skos:prefLabel "Operations" .
tai:q-family-8 skos:prefLabel "Evidence" .
tai:q-family-9 skos:prefLabel "Value" .

tai:q-phase-0 skos:prefLabel "Admission" .
tai:q-phase-1 skos:prefLabel "Boundary" .
tai:q-phase-2 skos:prefLabel "Construction" .
tai:q-phase-3 skos:prefLabel "Integration" .
tai:q-phase-4 skos:prefLabel "Verification" .
tai:q-phase-5 skos:prefLabel "Replay" .
tai:q-phase-6 skos:prefLabel "Closure" .

tai:q-scenario-1 tai:order 1 ; tai:identifier "scenario-01" ; skos:prefLabel "Admission refusal" ; tai:trigger "missing admitted observation" .
tai:q-scenario-2 tai:order 2 ; tai:identifier "scenario-02" ; skos:prefLabel "Authority refusal" ; tai:trigger "missing authority envelope" .
tai:q-scenario-3 tai:order 3 ; tai:identifier "scenario-03" ; skos:prefLabel "Dependency refusal" ; tai:trigger "unsatisfied predecessor" .
tai:q-scenario-4 tai:order 4 ; tai:identifier "scenario-04" ; skos:prefLabel "Manufacture drift" ; tai:trigger "non-deterministic projection" .
tai:q-scenario-5 tai:order 5 ; tai:identifier "scenario-05" ; skos:prefLabel "Verification failure" ; tai:trigger "postcondition absent" .
tai:q-scenario-6 tai:order 6 ; tai:identifier "scenario-06" ; skos:prefLabel "Replay divergence" ; tai:trigger "receipt mismatch" .
tai:q-scenario-7 tai:order 7 ; tai:identifier "scenario-07" ; skos:prefLabel "Rollback failure" ; tai:trigger "orphan remains" .
