@prefix epr: <https://ggen.dev/ontology/external-paradigm-recompilation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

# epr:* is generator/admission metadata. Runtime provenance and policy identity
# project to PROV-O, DCTERMS, SKOS and ODRL; this vocabulary grants no DO authority.
epr:SupplierSubject a rdfs:Class .
epr:PatternClassification a rdfs:Class .
epr:TargetEdge a rdfs:Class .
epr:QualificationClaim a rdfs:Class .
epr:Policy a rdfs:Class .

epr:sourceRepository a rdf:Property .
epr:sourceSha a rdf:Property .
epr:standing a rdf:Property .
epr:disposition a rdf:Property .
epr:authorityCeiling a rdf:Property .
epr:sourcePath a rdf:Property .
epr:targetCapability a rdf:Property .
epr:relation a rdf:Property .
epr:semanticEquivalence a rdf:Property .
epr:falsifier a rdf:Property .
epr:qualificationReceipt a rdf:Property .
epr:passed a rdf:Property .
epr:mutableRefsForbidden a rdf:Property .
epr:grantsDoAuthority a rdf:Property .
epr:inventOnlyAfterPriorArtFalsified a rdf:Property .

epr:VENDOR a skos:Concept ; skos:prefLabel "VENDOR" .
epr:WRAP a skos:Concept ; skos:prefLabel "WRAP" .
epr:REPLACE a skos:Concept ; skos:prefLabel "REPLACE" .
epr:NOVEL_GAP a skos:Concept ; skos:prefLabel "NOVEL_GAP" .
epr:DECLARED_TARGET a skos:Concept ; skos:prefLabel "DECLARED_TARGET" .

epr:policyV1 a epr:Policy, prov:Plan ;
  dcterms:title "External Paradigm Recompilation v1" ;
  epr:mutableRefsForbidden true ;
  epr:grantsDoAuthority false ;
  epr:authorityCeiling "OBSERVE|SELECT|CONSTRUCT" ;
  epr:inventOnlyAfterPriorArtFalsified true ;
  epr:semanticEquivalence "UNCLAIMED" .

# Canonical law:
# U@sha -> observe -> extract -> normalize -> deduplicate
# -> VENDOR|WRAP|REPLACE|NOVEL_GAP -> falsify -> qualify -> manufacture -> admit.
# DECLARED_TARGET means adjacency only. It never means semantic equivalence.
