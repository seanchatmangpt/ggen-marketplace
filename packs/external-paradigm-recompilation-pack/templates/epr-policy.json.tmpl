---
to: "generated/epr/policy.json"
sparql:
  policies: |
    PREFIX epr: <https://ggen.dev/ontology/external-paradigm-recompilation#>
    SELECT ?mutable ?do ?authority ?invent ?equivalence
    WHERE {
      epr:policyV1
        epr:mutableRefsForbidden ?mutable ;
        epr:grantsDoAuthority ?do ;
        epr:authorityCeiling ?authority ;
        epr:inventOnlyAfterPriorArtFalsified ?invent ;
        epr:semanticEquivalence ?equivalence .
    }
---
{
  "schema": "ggen.epr.policy.v1",
  "mutable_refs_forbidden": {{ policies[0].mutable }},
  "grants_do_authority": {{ policies[0].do }},
  "authority_ceiling": "{{ policies[0].authority }}",
  "invent_only_after_prior_art_falsified": {{ policies[0].invent }},
  "declared_target_semantic_equivalence": "{{ policies[0].equivalence }}",
  "dispositions": ["VENDOR", "WRAP", "REPLACE", "NOVEL_GAP"]
}
