---
to: "infra/gcp/iam/preamble.tf"
force: true
determinism: true
sparql:
  apis: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    SELECT ?order ?name WHERE {
      ?a a gtf:ApiService ; gtf:order ?order ; gtf:apiName ?name .
    } ORDER BY ?order ?name
---
# GENERATED by `ggen sync` from packs/gcp-terraform-pack/ontology.ttl — do not edit by hand.
terraform {
  backend "gcs" {}

  required_version = ">= 1.3"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 5.0"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

locals {
  apis = [
{% for a in apis %}    "{{ a.name }}",
{% endfor %}  ]

  runtime_sas = merge(
    { cockpit = google_service_account.cockpit.email },
    var.enable_gpu_sa ? { gpu_vm = google_service_account.gpu_vm[0].email } : {}
  )
}
