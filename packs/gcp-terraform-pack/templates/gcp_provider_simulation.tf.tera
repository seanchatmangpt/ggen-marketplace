---
to: "infra/gcp/simulation/gcp_provider_simulation.tf"
force: true
determinism: true
sparql:
  apis: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    SELECT ?order ?name WHERE {
      ?a a gtf:ApiService ; gtf:order ?order ; gtf:apiName ?name .
    } ORDER BY ?order ?name
---
# GENERATED by `ggen sync` from packs/gcp-terraform-pack/ontology.ttl — do not edit by hand.
# Simulation provider overlay for google and google-beta, parameterized for arcus-fnox/arcus and smalt (:8443).
terraform {
  required_version = ">= 1.3"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 5.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = ">= 5.0"
    }
  }
}

variable "project_id" {
  description = "GCP project ID for simulation."
  type        = string
  default     = "ai-cmd-ctr"
}

variable "region" {
  description = "Default GCP region for simulation."
  type        = string
  default     = "us-west1"
}

variable "arcus_endpoint" {
  description = "Base URL for the arcus / arcus-fnox GCP emulator."
  type        = string
  default     = "http://127.0.0.1:18931"
}

variable "smalt_endpoint" {
  description = "Base URL for the smalt egress / data-plane emulator (:8443)."
  type        = string
  default     = "http://127.0.0.1:8443"
}

variable "endpoint_overrides" {
  description = "Optional per-service custom endpoint overrides keyed by service name."
  type        = map(string)
  default     = {}
}

locals {
  sim_endpoints = {
    storage                = lookup(var.endpoint_overrides, "storage", "${var.arcus_endpoint}/storage/storage/v1/")
    kms                    = lookup(var.endpoint_overrides, "kms", "${var.arcus_endpoint}/kms/v1/")
    secret_manager         = lookup(var.endpoint_overrides, "secret_manager", "${var.arcus_endpoint}/secrets/v1/")
    pubsub                 = lookup(var.endpoint_overrides, "pubsub", "${var.arcus_endpoint}/pubsub/v1/")
    vertex_ai              = lookup(var.endpoint_overrides, "vertex_ai", "${var.smalt_endpoint}/vertex_ai/v1/")
    iam                    = lookup(var.endpoint_overrides, "iam", "${var.arcus_endpoint}/iam/v1/")
    cloud_resource_manager = lookup(var.endpoint_overrides, "cloud_resource_manager", "${var.arcus_endpoint}/crm/v1/")
    service_usage          = lookup(var.endpoint_overrides, "service_usage", "${var.arcus_endpoint}/serviceusage/v1/")
    cloud_run_v2           = lookup(var.endpoint_overrides, "cloud_run_v2", "${var.smalt_endpoint}/v2/")
    cloudfunctions2        = lookup(var.endpoint_overrides, "cloudfunctions2", "${var.smalt_endpoint}/v2/")
    cloud_scheduler        = lookup(var.endpoint_overrides, "cloud_scheduler", "${var.arcus_endpoint}/scheduler/v1/")
    bigquery               = lookup(var.endpoint_overrides, "bigquery", "${var.arcus_endpoint}/bigquery/v2/")
    artifact_registry      = lookup(var.endpoint_overrides, "artifact_registry", "${var.arcus_endpoint}/artifactregistry/v1/")
    compute                = lookup(var.endpoint_overrides, "compute", "${var.arcus_endpoint}/compute/v1/")
    cloud_billing          = lookup(var.endpoint_overrides, "cloud_billing", "${var.arcus_endpoint}/billing/v1/")
    billing_budgets        = lookup(var.endpoint_overrides, "billing_budgets", "${var.arcus_endpoint}/billing/v1/")
  }
}

provider "google" {
  project = var.project_id
  region  = var.region

  storage_custom_endpoint                = local.sim_endpoints.storage
  kms_custom_endpoint                    = local.sim_endpoints.kms
  secret_manager_custom_endpoint         = local.sim_endpoints.secret_manager
  pubsub_custom_endpoint                 = local.sim_endpoints.pubsub
  vertex_ai_custom_endpoint              = local.sim_endpoints.vertex_ai
  iam_custom_endpoint                    = local.sim_endpoints.iam
  resource_manager_custom_endpoint       = local.sim_endpoints.cloud_resource_manager
  service_usage_custom_endpoint          = local.sim_endpoints.service_usage
  cloud_run_v2_custom_endpoint           = local.sim_endpoints.cloud_run_v2
  cloudfunctions2_custom_endpoint        = local.sim_endpoints.cloudfunctions2
  cloud_scheduler_custom_endpoint        = local.sim_endpoints.cloud_scheduler
  big_query_custom_endpoint              = local.sim_endpoints.bigquery
  artifact_registry_custom_endpoint      = local.sim_endpoints.artifact_registry
  compute_custom_endpoint                = local.sim_endpoints.compute
  cloud_billing_custom_endpoint          = local.sim_endpoints.cloud_billing
  billing_budgets_custom_endpoint        = local.sim_endpoints.billing_budgets
}

provider "google-beta" {
  project = var.project_id
  region  = var.region

  storage_custom_endpoint                = local.sim_endpoints.storage
  kms_custom_endpoint                    = local.sim_endpoints.kms
  secret_manager_custom_endpoint         = local.sim_endpoints.secret_manager
  pubsub_custom_endpoint                 = local.sim_endpoints.pubsub
  vertex_ai_custom_endpoint              = local.sim_endpoints.vertex_ai
  iam_custom_endpoint                    = local.sim_endpoints.iam
  resource_manager_custom_endpoint       = local.sim_endpoints.cloud_resource_manager
  service_usage_custom_endpoint          = local.sim_endpoints.service_usage
  cloud_run_v2_custom_endpoint           = local.sim_endpoints.cloud_run_v2
  cloudfunctions2_custom_endpoint        = local.sim_endpoints.cloudfunctions2
  cloud_scheduler_custom_endpoint        = local.sim_endpoints.cloud_scheduler
  big_query_custom_endpoint              = local.sim_endpoints.bigquery
  artifact_registry_custom_endpoint      = local.sim_endpoints.artifact_registry
  compute_custom_endpoint                = local.sim_endpoints.compute
  cloud_billing_custom_endpoint          = local.sim_endpoints.cloud_billing
  billing_budgets_custom_endpoint        = local.sim_endpoints.billing_budgets
}
