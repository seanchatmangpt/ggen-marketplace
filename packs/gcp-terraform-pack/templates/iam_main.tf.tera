---
to: "infra/gcp/iam/main.tf"
force: true
determinism: true
sparql:
  resources: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    SELECT ?r ?order ?type ?name WHERE {
      ?r a gtf:Resource ;
         gtf:inModule gtf:mod_iam ;
         gtf:order ?order ;
         gtf:resourceType ?type ;
         gtf:resourceName ?name .
    } ORDER BY ?order ?type ?name
  lines: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    SELECT ?r ?lineOrder ?text WHERE {
      ?r a gtf:Resource ;
         gtf:inModule gtf:mod_iam ;
         gtf:hclLine ?ln .
      ?ln gtf:lineOrder ?lineOrder ;
          gtf:text ?text .
    } ORDER BY ?r ?lineOrder
---
# GENERATED by `ggen sync` from packs/gcp-terraform-pack/ontology.ttl — do not edit by hand.
{% for r in resources %}resource "{{ r.type }}" "{{ r.name }}" {
{% for l in lines | filter(attribute="r", value=r.r) %}{% if l.text == "" %}
{% else %}  {{ l.text }}
{% endif %}{% endfor %}}

{% endfor %}