{# Renders fnox infra/gcp/iam resource blocks from gtf: facts. Header (terraform/provider/locals)
   is the module preamble, emitted verbatim by iam_preamble.tf.tera. Rows: ?type ?name ?lines ordered by ?order. #}
{% for r in rows %}
resource "{{ r.type }}" "{{ r.name }}" {
{% for l in r.lines %}{% if l == "" %}
{% else %}  {{ l }}
{% endif %}{% endfor %}}

{% endfor %}
