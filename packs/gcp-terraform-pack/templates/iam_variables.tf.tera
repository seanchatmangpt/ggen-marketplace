---
to: "infra/gcp/iam/variables.tf"
force: true
determinism: true
sparql:
  mod: |
    PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
    SELECT ?m WHERE {
      BIND(gtf:mod_iam AS ?m)
    }
---
# GENERATED by `ggen sync` from packs/gcp-terraform-pack/ontology.ttl — do not edit by hand.
variable "project_id" {
  description = "GCP project ID that hosts the fnox cockpit."
  type        = string
  default     = "ai-cmd-ctr"
}

variable "region" {
  description = "Default region (Artifact Registry, KMS, Secret Manager replication)."
  type        = string
  default     = "us-west1"
}

variable "ar_repo" {
  description = "Artifact Registry repository ID the images live in."
  type        = string
  default     = "fnox"
}

variable "secret_ids" {
  description = "Secret Manager secret shells to create (no values; add versions out-of-band)."
  type        = set(string)
  default     = ["fnox-api-key", "fnox-session-secret"]
}

variable "enable_kms" {
  description = "Create the Cloud KMS keyring + signing key shell."
  type        = bool
  default     = false
}

variable "kms_keyring_name" {
  description = "KMS keyring name (only used when enable_kms = true)."
  type        = string
  default     = "fnox"
}

variable "kms_key_name" {
  description = "KMS signing key name (only used when enable_kms = true)."
  type        = string
  default     = "fnox-receipt-sign"
}

variable "deployer_members" {
  description = "IAM members allowed to impersonate the deployer SA."
  type        = list(string)
  default     = ["user:info@chatmangpt.com"]
}

variable "enable_gpu_sa" {
  description = "Create the GPU VM service account and permissions."
  type        = bool
  default     = false
}
