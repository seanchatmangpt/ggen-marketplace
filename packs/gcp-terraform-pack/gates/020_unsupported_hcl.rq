# MESSAGE: any row = an UnsupportedConstruct with no registered divergence row status.
# Every construct the pack may emit that arcus could reject (HCL_UNSUPPORTED) must carry
# gtf:arcusStatus (UNVERIFIED | REJECTED | ACCEPTED) and a row in docs/DIVERGENCES.md.
PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
SELECT DISTINCT ?c ?problem WHERE {
  ?c a gtf:UnsupportedConstruct .
  FILTER NOT EXISTS { ?c gtf:arcusStatus ?s }
  BIND("missing-arcus-status" AS ?problem)
}
