# MESSAGE: any row = an iam Resource missing type, name, order or hcl body lines.
PREFIX gtf: <https://seanchatmangpt.dev/ontology/gcp-terraform#>
SELECT DISTINCT ?r ?problem WHERE {
  ?r a gtf:Resource ; gtf:inModule gtf:mod_iam .
  { FILTER NOT EXISTS { ?r gtf:hcl ?h } BIND("missing-hcl" AS ?problem) }
  UNION { FILTER NOT EXISTS { ?r gtf:order ?o } BIND("missing-order" AS ?problem) }
}
