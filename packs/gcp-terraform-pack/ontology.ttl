@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix gtf:  <https://seanchatmangpt.dev/ontology/gcp-terraform#> .

<https://seanchatmangpt.dev/ontology/gcp-terraform> a owl:Ontology ;
    rdfs:label "GCP Terraform dialect ontology" ;
    rdfs:comment "Modules and resources of the fnox infra/gcp tree. Reuses PROV-O for derivation (prov:wasDerivedFrom the hand-written module path)." .

gtf:Module a rdfs:Class .
gtf:Resource a rdfs:Class .
gtf:DataSource a rdfs:Class .
gtf:ApiService a rdfs:Class .
gtf:HclLine a rdfs:Class .
gtf:UnsupportedConstruct a rdfs:Class ;
    rdfs:comment "An HCL construct evaluated against arcus gcp_emulator sdlc.ParseLenient." .
gtf:inModule a rdf:Property .
gtf:resourceType a rdf:Property .
gtf:resourceName a rdf:Property .
gtf:order a rdf:Property .
gtf:hclLine a rdf:Property ; rdfs:comment "Ordered HCL body line node (gtf:lineOrder + gtf:text)." .
gtf:lineOrder a rdf:Property .
gtf:text a rdf:Property .
gtf:apiName a rdf:Property .
gtf:apiHost a rdf:Property .
gtf:endpointClassification a rdf:Property .
gtf:constructName a rdf:Property .
gtf:arcusStatus a rdf:Property ; rdfs:comment "ACCEPTED | REJECTED, observed against arcus sdlc.ParseLenient." .

gtf:mod_iam a gtf:Module ; rdfs:label "iam" ; prov:wasDerivedFrom <file:///Users/sac/fnox/infra/gcp/iam/main.tf> .
gtf:mod_iap a gtf:Module ; rdfs:label "iap" ; prov:wasDerivedFrom <file:///Users/sac/fnox/infra/gcp/iap/main.tf> .
gtf:mod_edge a gtf:Module ; rdfs:label "edge" ; prov:wasDerivedFrom <file:///Users/sac/fnox/infra/gcp/edge/main.tf> .
gtf:mod_budget a gtf:Module ; rdfs:label "budget" ; prov:wasDerivedFrom <file:///Users/sac/fnox/infra/gcp/budget/main.tf> .
gtf:mod_cloudrun a gtf:Module ; rdfs:label "cloudrun" ; prov:wasDerivedFrom <file:///Users/sac/fnox/infra/gcp/cloudrun/main.tf> .
gtf:mod_gpu a gtf:Module ; rdfs:label "gpu" ; prov:wasDerivedFrom <file:///Users/sac/fnox/infra/gcp/gpu/main.tf> .

# --- Enabled GCP APIs for mod_iam ---
gtf:api_01 a gtf:ApiService ; gtf:order 1 ; gtf:apiName "iam.googleapis.com" .
gtf:api_02 a gtf:ApiService ; gtf:order 2 ; gtf:apiName "iamcredentials.googleapis.com" .
gtf:api_03 a gtf:ApiService ; gtf:order 3 ; gtf:apiName "cloudresourcemanager.googleapis.com" .
gtf:api_04 a gtf:ApiService ; gtf:order 4 ; gtf:apiName "serviceusage.googleapis.com" .
gtf:api_05 a gtf:ApiService ; gtf:order 5 ; gtf:apiName "artifactregistry.googleapis.com" .
gtf:api_06 a gtf:ApiService ; gtf:order 6 ; gtf:apiName "secretmanager.googleapis.com" .
gtf:api_07 a gtf:ApiService ; gtf:order 7 ; gtf:apiName "logging.googleapis.com" .
gtf:api_08 a gtf:ApiService ; gtf:order 8 ; gtf:apiName "monitoring.googleapis.com" .
gtf:api_09 a gtf:ApiService ; gtf:order 9 ; gtf:apiName "run.googleapis.com" .
gtf:api_10 a gtf:ApiService ; gtf:order 10 ; gtf:apiName "compute.googleapis.com" .
gtf:api_11 a gtf:ApiService ; gtf:order 11 ; gtf:apiName "iap.googleapis.com" .
gtf:api_12 a gtf:ApiService ; gtf:order 12 ; gtf:apiName "dns.googleapis.com" .
gtf:api_13 a gtf:ApiService ; gtf:order 13 ; gtf:apiName "cloudkms.googleapis.com" .

# --- Additional validate_only GCP APIs (outside mod_iam preamble) ---
gtf:api_accessapproval a gtf:ApiService ; gtf:inModule gtf:mod_integrations ; gtf:apiName "accessapproval.googleapis.com" ; gtf:endpointClassification "validate_only" .
gtf:api_sqladmin a gtf:ApiService ; gtf:inModule gtf:mod_cos ; gtf:apiName "sqladmin.googleapis.com" ; gtf:endpointClassification "validate_only" .
gtf:api_cloudbilling a gtf:ApiService ; gtf:inModule gtf:mod_budget ; gtf:apiName "cloudbilling.googleapis.com" ; gtf:endpointClassification "arcus" .
gtf:api_billingbudgets a gtf:ApiService ; gtf:inModule gtf:mod_budget ; gtf:apiName "billingbudgets.googleapis.com" ; gtf:endpointClassification "arcus" .
gtf:api_container a gtf:ApiService ; gtf:inModule gtf:mod_a2a_cluster ; gtf:apiName "container.googleapis.com" ; gtf:endpointClassification "validate_only" .

# --- Resource inventory per module (types observed in fnox infra/gcp/*/main.tf) ---
gtf:r_iap_1 a gtf:Resource ; gtf:inModule gtf:mod_iap ; gtf:resourceType "google_iap_web_backend_service_iam_binding" ; gtf:resourceName "accessors" .
gtf:r_edge_2 a gtf:Resource ; gtf:inModule gtf:mod_iap ; gtf:resourceType "google_compute_security_policy" ; gtf:resourceName "armor" .
gtf:r_edge_1 a gtf:Resource ; gtf:inModule gtf:mod_edge ; gtf:resourceType "google_compute_backend_service" ; gtf:resourceName "backend" .
gtf:r_edge_3 a gtf:Resource ; gtf:inModule gtf:mod_edge ; gtf:resourceType "google_compute_managed_ssl_certificate" ; gtf:resourceName "cert" .
gtf:r_edge_4 a gtf:Resource ; gtf:inModule gtf:mod_edge ; gtf:resourceType "google_compute_url_map" ; gtf:resourceName "https" .
gtf:r_edge_5 a gtf:Resource ; gtf:inModule gtf:mod_edge ; gtf:resourceType "google_compute_global_forwarding_rule" ; gtf:resourceName "https" .
gtf:r_budget_1 a gtf:Resource ; gtf:inModule gtf:mod_budget ; gtf:resourceType "google_billing_budget" ; gtf:resourceName "monthly" .
gtf:r_budget_2 a gtf:Resource ; gtf:inModule gtf:mod_budget ; gtf:resourceType "google_monitoring_notification_channel" ; gtf:resourceName "email" .
gtf:r_run_1 a gtf:Resource ; gtf:inModule gtf:mod_cloudrun ; gtf:resourceType "google_cloud_run_v2_service" ; gtf:resourceName "cockpit" .
gtf:r_run_2 a gtf:Resource ; gtf:inModule gtf:mod_cloudrun ; gtf:resourceType "google_cloud_run_v2_service_iam_member" ; gtf:resourceName "invoker" .
gtf:r_gpu_1 a gtf:Resource ; gtf:inModule gtf:mod_gpu ; gtf:resourceType "google_compute_instance" ; gtf:resourceName "ollama" .
gtf:r_gpu_2 a gtf:Resource ; gtf:inModule gtf:mod_gpu ; gtf:resourceType "google_compute_firewall" ; gtf:resourceName "ollama_in" .
gtf:r_gpu_3 a gtf:Resource ; gtf:inModule gtf:mod_gpu ; gtf:resourceType "google_compute_router_nat" ; gtf:resourceName "nat" .

# --- iam module: fully modelled (name, type, ordered attribute lines) ---
gtf:i01 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 1 ; gtf:resourceType "google_project_service" ; gtf:resourceName "api" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "for_each           = toset(local.apis)" ],
    [ gtf:lineOrder 2 ; gtf:text "project            = var.project_id" ],
    [ gtf:lineOrder 3 ; gtf:text "service            = each.value" ],
    [ gtf:lineOrder 4 ; gtf:text "disable_on_destroy = false" ] .

gtf:i02 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 2 ; gtf:resourceType "google_service_account" ; gtf:resourceName "cockpit" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "project      = var.project_id" ],
    [ gtf:lineOrder 2 ; gtf:text "account_id   = \"fnox-cockpit\"" ],
    [ gtf:lineOrder 3 ; gtf:text "display_name = \"fnox cockpit runtime\"" ],
    [ gtf:lineOrder 4 ; gtf:text "depends_on   = [google_project_service.api]" ] .

gtf:i03 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 3 ; gtf:resourceType "google_service_account" ; gtf:resourceName "gpu_vm" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "count        = var.enable_gpu_sa ? 1 : 0" ],
    [ gtf:lineOrder 2 ; gtf:text "project      = var.project_id" ],
    [ gtf:lineOrder 3 ; gtf:text "account_id   = \"fnox-gpu-vm\"" ],
    [ gtf:lineOrder 4 ; gtf:text "display_name = \"fnox GPU VM\"" ],
    [ gtf:lineOrder 5 ; gtf:text "depends_on   = [google_project_service.api]" ] .

gtf:i04 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 4 ; gtf:resourceType "google_service_account" ; gtf:resourceName "deployer" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "project      = var.project_id" ],
    [ gtf:lineOrder 2 ; gtf:text "account_id   = \"fnox-deployer\"" ],
    [ gtf:lineOrder 3 ; gtf:text "display_name = \"fnox deployer (build/push/deploy)\"" ],
    [ gtf:lineOrder 4 ; gtf:text "depends_on   = [google_project_service.api]" ] .

gtf:i05 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 5 ; gtf:resourceType "google_project_iam_member" ; gtf:resourceName "log_writer" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "for_each = local.runtime_sas" ],
    [ gtf:lineOrder 2 ; gtf:text "project  = var.project_id" ],
    [ gtf:lineOrder 3 ; gtf:text "role     = \"roles/logging.logWriter\"" ],
    [ gtf:lineOrder 4 ; gtf:text "member   = \"serviceAccount:${each.value}\"" ] .

gtf:i06 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 6 ; gtf:resourceType "google_project_iam_member" ; gtf:resourceName "metric_writer" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "for_each = local.runtime_sas" ],
    [ gtf:lineOrder 2 ; gtf:text "project  = var.project_id" ],
    [ gtf:lineOrder 3 ; gtf:text "role     = \"roles/monitoring.metricWriter\"" ],
    [ gtf:lineOrder 4 ; gtf:text "member   = \"serviceAccount:${each.value}\"" ] .

gtf:i07 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 7 ; gtf:resourceType "google_project_iam_member" ; gtf:resourceName "deployer_run_admin" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "project = var.project_id" ],
    [ gtf:lineOrder 2 ; gtf:text "role    = \"roles/run.developer\"" ],
    [ gtf:lineOrder 3 ; gtf:text "member  = \"serviceAccount:${google_service_account.deployer.email}\"" ] .

gtf:i08 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 8 ; gtf:resourceType "google_artifact_registry_repository_iam_member" ; gtf:resourceName "runtime_reader" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "for_each   = local.runtime_sas" ],
    [ gtf:lineOrder 2 ; gtf:text "project    = var.project_id" ],
    [ gtf:lineOrder 3 ; gtf:text "location   = var.region" ],
    [ gtf:lineOrder 4 ; gtf:text "repository = var.ar_repo" ],
    [ gtf:lineOrder 5 ; gtf:text "role       = \"roles/artifactregistry.reader\"" ],
    [ gtf:lineOrder 6 ; gtf:text "member     = \"serviceAccount:${each.value}\"" ],
    [ gtf:lineOrder 7 ; gtf:text "depends_on = [google_project_service.api]" ] .

gtf:i09 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 9 ; gtf:resourceType "google_artifact_registry_repository_iam_member" ; gtf:resourceName "deployer_writer" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "project    = var.project_id" ],
    [ gtf:lineOrder 2 ; gtf:text "location   = var.region" ],
    [ gtf:lineOrder 3 ; gtf:text "repository = var.ar_repo" ],
    [ gtf:lineOrder 4 ; gtf:text "role       = \"roles/artifactregistry.writer\"" ],
    [ gtf:lineOrder 5 ; gtf:text "member     = \"serviceAccount:${google_service_account.deployer.email}\"" ],
    [ gtf:lineOrder 6 ; gtf:text "depends_on = [google_project_service.api]" ] .

gtf:i10 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 10 ; gtf:resourceType "google_secret_manager_secret" ; gtf:resourceName "shell" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "for_each  = var.secret_ids" ],
    [ gtf:lineOrder 2 ; gtf:text "project   = var.project_id" ],
    [ gtf:lineOrder 3 ; gtf:text "secret_id = each.value" ],
    [ gtf:lineOrder 4 ; gtf:text "replication {" ],
    [ gtf:lineOrder 5 ; gtf:text "  auto {}" ],
    [ gtf:lineOrder 6 ; gtf:text "}" ],
    [ gtf:lineOrder 7 ; gtf:text "depends_on = [google_project_service.api]" ] .

gtf:i11 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 11 ; gtf:resourceType "google_secret_manager_secret_iam_member" ; gtf:resourceName "cockpit_accessor" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "for_each  = var.secret_ids" ],
    [ gtf:lineOrder 2 ; gtf:text "project   = var.project_id" ],
    [ gtf:lineOrder 3 ; gtf:text "secret_id = google_secret_manager_secret.shell[each.value].secret_id" ],
    [ gtf:lineOrder 4 ; gtf:text "role      = \"roles/secretmanager.secretAccessor\"" ],
    [ gtf:lineOrder 5 ; gtf:text "member    = \"serviceAccount:${google_service_account.cockpit.email}\"" ] .

gtf:i12 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 12 ; gtf:resourceType "google_service_account_iam_member" ; gtf:resourceName "deployer_acts_as_cockpit" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "service_account_id = google_service_account.cockpit.name" ],
    [ gtf:lineOrder 2 ; gtf:text "role               = \"roles/iam.serviceAccountUser\"" ],
    [ gtf:lineOrder 3 ; gtf:text "member             = \"serviceAccount:${google_service_account.deployer.email}\"" ] .

gtf:i13 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 13 ; gtf:resourceType "google_service_account_iam_member" ; gtf:resourceName "deployer_impersonators" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "for_each           = toset(var.deployer_members)" ],
    [ gtf:lineOrder 2 ; gtf:text "service_account_id = google_service_account.deployer.name" ],
    [ gtf:lineOrder 3 ; gtf:text "role               = \"roles/iam.serviceAccountTokenCreator\"" ],
    [ gtf:lineOrder 4 ; gtf:text "member             = each.value" ] .

gtf:i14 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 14 ; gtf:resourceType "google_kms_key_ring" ; gtf:resourceName "fnox" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "count      = var.enable_kms ? 1 : 0" ],
    [ gtf:lineOrder 2 ; gtf:text "project    = var.project_id" ],
    [ gtf:lineOrder 3 ; gtf:text "name       = var.kms_keyring_name" ],
    [ gtf:lineOrder 4 ; gtf:text "location   = var.region" ],
    [ gtf:lineOrder 5 ; gtf:text "depends_on = [google_project_service.api]" ] .

gtf:i15 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 15 ; gtf:resourceType "google_kms_crypto_key" ; gtf:resourceName "sign" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "count    = var.enable_kms ? 1 : 0" ],
    [ gtf:lineOrder 2 ; gtf:text "name     = var.kms_key_name" ],
    [ gtf:lineOrder 3 ; gtf:text "key_ring = google_kms_key_ring.fnox[0].id" ],
    [ gtf:lineOrder 4 ; gtf:text "purpose  = \"ASYMMETRIC_SIGN\"" ],
    [ gtf:lineOrder 5 ; gtf:text "" ],
    [ gtf:lineOrder 6 ; gtf:text "version_template {" ],
    [ gtf:lineOrder 7 ; gtf:text "  algorithm        = \"EC_SIGN_P384_SHA384\"" ],
    [ gtf:lineOrder 8 ; gtf:text "  protection_level = \"SOFTWARE\"" ],
    [ gtf:lineOrder 9 ; gtf:text "}" ],
    [ gtf:lineOrder 10 ; gtf:text "" ],
    [ gtf:lineOrder 11 ; gtf:text "lifecycle {" ],
    [ gtf:lineOrder 12 ; gtf:text "  prevent_destroy = true" ],
    [ gtf:lineOrder 13 ; gtf:text "}" ] .

gtf:i16 a gtf:Resource ; gtf:inModule gtf:mod_iam ; gtf:order 16 ; gtf:resourceType "google_kms_crypto_key_iam_member" ; gtf:resourceName "cockpit_signer" ;
  gtf:hclLine
    [ gtf:lineOrder 1 ; gtf:text "count         = var.enable_kms ? 1 : 0" ],
    [ gtf:lineOrder 2 ; gtf:text "crypto_key_id = google_kms_crypto_key.sign[0].id" ],
    [ gtf:lineOrder 3 ; gtf:text "role          = \"roles/cloudkms.signerVerifier\"" ],
    [ gtf:lineOrder 4 ; gtf:text "member        = \"serviceAccount:${google_service_account.cockpit.email}\"" ] .

# --- Unsupported-construct register (verified against arcus sdlc.ParseLenient) ---
gtf:u_backend a gtf:UnsupportedConstruct ; gtf:constructName "backend \"gcs\" {}" ; gtf:arcusStatus "ACCEPTED" .
gtf:u_foreach a gtf:UnsupportedConstruct ; gtf:constructName "for_each = toset(...)" ; gtf:arcusStatus "ACCEPTED" .
gtf:u_count a gtf:UnsupportedConstruct ; gtf:constructName "count = cond ? 1 : 0" ; gtf:arcusStatus "ACCEPTED" .
gtf:u_lifecycle a gtf:UnsupportedConstruct ; gtf:constructName "lifecycle { prevent_destroy }" ; gtf:arcusStatus "ACCEPTED" .
gtf:u_data a gtf:UnsupportedConstruct ; gtf:constructName "data source (google_project, google_compute_*)" ; gtf:arcusStatus "ACCEPTED" .
gtf:u_dynamic a gtf:UnsupportedConstruct ; gtf:constructName "dynamic block" ; gtf:arcusStatus "ACCEPTED" .
gtf:u_moved a gtf:UnsupportedConstruct ; gtf:constructName "moved { from = ... to = ... }" ; gtf:arcusStatus "REJECTED" .

