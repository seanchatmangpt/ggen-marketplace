---
to: "docs/GYM_CI_PIN_DRIFT.md"
force: true
sparql:
  pins: |
    PREFIX gymci: <http://seanchatmangpt.github.io/packs/gym-ci-toolchain-bblock#>
    SELECT ?pinId ?actionRef ?versionComment ?observedVariants ?floatingUses
    WHERE { ?p a gymci:ToolchainPin ; gymci:pinId ?pinId ; gymci:actionRef ?actionRef ;
              gymci:versionComment ?versionComment ; gymci:observedVariants ?observedVariants ;
              gymci:floatingUses ?floatingUses . }
    ORDER BY ?pinId
  observations: |
    PREFIX gymci: <http://seanchatmangpt.github.io/packs/gym-ci-toolchain-bblock#>
    SELECT ?pinId ?pinString ?occurrences ?isFloatingTag
    WHERE { ?o a gymci:PinObservation ; gymci:observationOf ?p ;
              gymci:pinString ?pinString ; gymci:occurrences ?occurrences ;
              gymci:isFloatingTag ?isFloatingTag .
            ?p gymci:pinId ?pinId . }
    ORDER BY ?pinId DESC(?occurrences)
  consumers: |
    PREFIX gymci: <http://seanchatmangpt.github.io/packs/gym-ci-toolchain-bblock#>
    SELECT ?repoName ?workflowCount ?floatingRefCount
    WHERE { ?r a gymci:ConsumerRepo ; gymci:repoName ?repoName ;
              gymci:workflowCount ?workflowCount ; gymci:floatingRefCount ?floatingRefCount . }
    ORDER BY DESC(?workflowCount)
  uninitialized: |
    PREFIX gymci: <http://seanchatmangpt.github.io/packs/gym-ci-toolchain-bblock#>
    SELECT ?repoName WHERE { ?r a gymci:UninitializedSubmodule ; gymci:repoName ?repoName . }
    ORDER BY ?repoName
