---
to: ".github/actions/gym-toolchain/action.yml"
force: true
sparql:
  steps: |
    PREFIX gymci: <http://seanchatmangpt.github.io/packs/gym-ci-toolchain-bblock#>
    SELECT ?stepOrder ?stepName ?actionRef ?versionComment ?runCommand
           (GROUP_CONCAT(DISTINCT ?w; separator="%%SEP%%") AS ?withParams)
    WHERE {
      ?s a gymci:PreambleStep ; gymci:stepOrder ?stepOrder ; gymci:stepName ?stepName ;
         gymci:actuating false .
      OPTIONAL { ?s gymci:usesPin ?p . ?p gymci:actionRef ?actionRef ; gymci:versionComment ?versionComment }
      OPTIONAL { ?s gymci:runCommand ?runCommand }
      OPTIONAL { ?s gymci:withParam ?w }
    }
    GROUP BY ?stepOrder ?stepName ?actionRef ?versionComment ?runCommand
    ORDER BY ?stepOrder
---
{%- macro reindent(text, spaces) -%}
{%- for line in text | split(pat="\n") -%}
{{ spaces }}{{ line }}
{% endfor -%}
{%- endmacro reindent -%}
# GENERATED by ggen (gym-ci-toolchain-bblock-pack/templates/toolchain_action.yml.tmpl). Do not edit.
# Source of truth: gymci:PreambleStep / gymci:ToolchainPin facts measured from the real trees.
# This composite action carries NO runtime actuation authority: every step it
# renders is asserted gymci:actuating false, and gate 020 refuses the pack if
# any step's command deploys, publishes, pushes, or applies.
name: gym-toolchain
description: Standard SHA-pinned CI preamble for gym-ecosystem submodules.

inputs:
  python-version:
    description: Python version to install.
    required: false
    default: "3.12"
  fetch-depth:
    description: Checkout depth.
    required: false
    default: "1"
  submodules:
    description: Submodule checkout mode.
    required: false
    default: "false"

runs:
  using: composite
  steps:
{%- for s in steps %}
    - name: {{ s.stepName }}
{%- if s.actionRef %}
      uses: {{ s.actionRef }} # {{ s.versionComment }}
{%- endif %}
{%- if s.withParams %}
      with:
{%- for kv in s.withParams | split(pat="%%SEP%%") %}
        {{ kv }}
{%- endfor %}
{%- endif %}
{%- if s.runCommand %}
      shell: bash
      run: |
{{ self::reindent(text=s.runCommand, spaces="        ") }}
{%- endif %}
{%- endfor %}
