---
to: ".env.example"
sparql:
  apps: >
      PREFIX nai: <https://ggen.dev/packs/nextjs-ai#>
      SELECT ?authStrategy ?keycloakIssuer WHERE {
        ?app a nai:Application ; nai:authStrategy ?authStrategy .
        OPTIONAL { ?app nai:keycloakIssuer ?keycloakIssuer }
      }
---
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
{% for app in apps %}{% if app.authStrategy == "keycloak" -%}
KEYCLOAK_CLIENT_ID=replace-with-keycloak-client-id
KEYCLOAK_CLIENT_SECRET=replace-with-keycloak-client-secret
# Realm issuer from nai:keycloakIssuer -- do not point this at a different realm
# than the one your platform's Keycloak instance actually provisions.
KEYCLOAK_ISSUER={{ app.keycloakIssuer }}
{% endif %}{% endfor -%}
AI_GATEWAY_API_KEY=replace-with-vercel-ai-gateway-key
AI_MODEL=openai/gpt-5.4
OTEL_SERVICE_NAME=nextjs-ai-sdk
