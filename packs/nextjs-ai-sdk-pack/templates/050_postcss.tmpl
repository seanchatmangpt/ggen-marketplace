---
to: "postcss.config.mjs"
sparql:
  apps: >
      PREFIX nai: <https://ggen.dev/packs/nextjs-ai#>
      SELECT ?tailwindVersion WHERE {
        ?app a nai:Application ; nai:tailwindVersion ?tailwindVersion .
      }
---
{% for app in apps %}{% if app.tailwindVersion is starting_with("4") %}export default {
  plugins: {
    "@tailwindcss/postcss": {},
  },
};
{% else %}export default {
  plugins: {
    tailwindcss: {},
    autoprefixer: {},
  },
};
{% endif %}{% endfor %}
