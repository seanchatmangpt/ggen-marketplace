# MESSAGE: nai:authStrategy "keycloak" requires nai:keycloakIssuer on the same Application; any returned row is refused.
PREFIX nai: <https://ggen.dev/packs/nextjs-ai#>
SELECT ?subject WHERE {
  ?subject a nai:Application ; nai:authStrategy "keycloak" .
  FILTER NOT EXISTS { ?subject nai:keycloakIssuer ?issuer }
}
ORDER BY ?subject
