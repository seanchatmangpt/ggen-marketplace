a2ac:echo_sut_pinned a a2ac:PinnedNonViolation ;
    a2ac:findingIds "DM-ART-001, DM-MSG-001" ;
    a2ac:failureCount 5 ;
    a2ac:pinReason "TCK echo-SUT behavioral contract: prefix-keyed canned responses the reference Python SUT hand-implements. fetch_input/1 (lib/ash_a2a/dispatcher.ex) extracts data-part payloads only, so the prefix-keyed echo behavior lives in the SUT harness, not the protocol implementation; reproducing it would mean faking the contract." ;
    a2ac:runOf a2ac:v1TckRun20261005 .

#################################################################
# Individuals — ProtoFidelityCourt (Z16, all-MATCH)
#################################################################

a2ac:protoFidelityCourt a a2ac:ProtoFidelityCourt ;
    a2ac:courtTestPath "test/ash_a2a_v1_proto_fidelity_test.exs" ;
    a2ac:courtVerdict "all-MATCH" ;
    a2ac:courtFalsifier "Green (all matched) or green-with-pinned-findings. Any NEW drift -- an emitted key or enum value not in the vendored proto and not pinned -- kills the codec-fidelity claim." ;
    rdfs:comment "A lightweight regex IDL parser (no protoc) parses the vendored a2a.proto at test time and compares every emitted protojson key and enum value against the REAL official mapping; divergences are pinned, never normalized away." .

