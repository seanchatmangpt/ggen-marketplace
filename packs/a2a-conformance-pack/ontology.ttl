# a2a-conformance-pack ontology.
#
# Namespace convention (M15 ontology harmonization — identical header in all
# five a2a/sa2a ggen-marketplace pack ontologies):
#   1. Canonical SA2A/A2A vocabulary prefixes are bound byte-identically to
#      the canonical sources (ash_a2a lib/ash_a2a/semantic/vocabulary.ex,
#      priv/sa2a/canonical/A2AProtocol_v2_1_0.ttl, priv/sa2a/AllSA2A.ttl):
#      a2a: <https://a2a-protocol.org/ontology#>,
#      sa2a-fnd:/sa2a-cap:/sa2a-bp:/sa2a-evi:
#      <https://spec.seanchatmangpt.dev/sa2a/ontology/...>,
#      a2a-urn: <urn:ash-a2a:vocab:>.
#   2. Canonical prefix names are RESERVED: a pack never rebinds a canonical
#      prefix name to a non-canonical IRI, and never mints terms under a
#      canonical namespace. Pack-scoped vocabulary lives under exactly one
#      pack-scoped namespace per pack (this pack's own, bound below);
#      cross-pack references always reuse the OWNING pack's IRIs — same
#      concept, same IRI — never a re-mint.
#   3. This pack's namespace IRIs are gate-bound (gates/*.rq hardcode them),
#      so they are grandfathered byte-stable; this file changes bindings and
#      alignment links only, never shipped IRIs.
#
# Cross-pack alignment (M15): each a2ac:CourtFile that is the same ExUnit
# file as a sibling pack's court/surface individual carries rdfs:seeAlso to
# that OWNING pack IRI — same concept, same IRI.

@prefix a2ac:  <http://seanchatmangpt.github.io/packs/a2a-conformance#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sec: <https://ggen.dev/ontology/a2a-security#> .
@prefix dur: <https://seanchatmangpt.github.io/packs/a2a-durability#> .
@prefix pk: <http://seanchatmangpt.github.io/packs/a2a-v1-protocol#> .

<http://seanchatmangpt.github.io/packs/a2a-conformance> a owl:Ontology ;
    rdfs:label "a2a-conformance-pack ontology" ;
    rdfs:comment "A2A v1.0 conformance statement pack. Pack-scoped namespace: http://seanchatmangpt.github.io/packs/a2a-conformance# (gate-bound, byte-stable; M15 harmonization convention)." ;
    owl:versionInfo "0.1.0" .

#################################################################
# Vocabulary
#################################################################

a2ac:ConformanceSurface a rdfs:Class ;
    rdfs:label "The A2A v1.0 conformance statement surface: the claimed/not-claimed table plus verification and TCK sections." ;
    rdfs:comment "Truth source: /Users/sac/ash_a2a/docs/reference/a2a-v1-conformance.md. 29 rows: 27 CONFORMANT, 2 PARTIAL (rows 21, 22), 0 GAP." .

a2ac:CourtRunner a rdfs:Class ;
    rdfs:label "One Mix task that runs every v1.0 conformance court and reduces them to one JSON verdict report." ;
    rdfs:comment "Truth source: /Users/sac/ash_a2a/lib/mix/tasks/ash_a2a.v1_conformance_report.ex" .

a2ac:CourtFile a rdfs:Class ;
    rdfs:label "ExUnit court family member: one test/ash_a2a_v1_*.exs file on the runner's @v1_courts list." ;
    rdfs:comment "Truth source: the runner's @v1_courts attribute (25 entries) and test/ash_a2a_v1_*.exs on disk." .

a2ac:ExcludedCourtFile a rdfs:Class ;
    rdfs:label "A v1 court file deliberately NOT on the runner's list; the exclusion carries a stated reason, never a silent omission." ;
    rdfs:comment "Truth source: the runner's 'Deliberately NOT in @v1_courts' block (self-test recursion guard, extension courts out of protocol scope)." .

a2ac:SpecCorpus a rdfs:Class ;
    rdfs:label "The frozen corpus of REAL A2A v1.0 wire examples extracted byte-faithful from the official specification." ;
    rdfs:comment "Truth source: /Users/sac/ash_a2a/priv/a2a_v1_spec_corpus/v1_spec_examples.json" .

a2ac:SpecIdl a rdfs:Class ;
    rdfs:label "The pristine vendored A2A v1.0 protobuf IDL the protojson-fidelity court judges the codec against." ;
    rdfs:comment "Truth source: /Users/sac/ash_a2a/priv/a2a_v1_spec_corpus/a2a.proto" .

a2ac:TCKRun a rdfs:Class ;
    rdfs:label "One run of the official a2aproject/a2a-tck compatibility suite; point-in-time verdict, never a certification." ;
    rdfs:comment "Truth source: docs/reference/a2a-v1-conformance.md 'A2A TCK compatibility run' section (2026-10-05, lane Z19)." .

a2ac:TCKTransportRun a rdfs:Class ;
    rdfs:label "One per-transport row of the TCK compatibility matrix." ;
    rdfs:comment "Quoted verbatim from the suite's compatibility.json via the conformance statement." .

a2ac:FixedMust a rdfs:Class ;
    rdfs:label "One MUST-category infrastructure failure observed by the TCK and fixed in-session before the final run." ;
    rdfs:comment "Truth source: docs/reference/a2a-v1-conformance.md: three fixes in lib/ash_a2a/transport/plug.ex." .

a2ac:PinnedNonViolation a rdfs:Class ;
    rdfs:label "One TCK failure pinned as NOT a spec violation." ;
    rdfs:comment "Truth source: the 5 remaining jsonrpc failures are the TCK echo-SUT behavioral contract (DM-ART-001, DM-MSG-001); the dispatcher cannot reproduce them without faking the echo contract." .

a2ac:ProtoFidelityCourt a rdfs:Class ;
    rdfs:label "The protojson schema-fidelity court judged against the vendored IDL." ;
    rdfs:comment "Truth source: /Users/sac/ash_a2a/test/ash_a2a_v1_proto_fidelity_test.exs (Z16). Verdict: all-MATCH." .

a2ac:CorpusFamily a rdfs:Class ;
    rdfs:label "One closed family vocabulary member of the spec corpus." ;
    rdfs:comment "Pinned by the corpus court's own integrity test (test/ash_a2a_v1_spec_corpus_test.exs)." .

a2ac:statusRowCount a rdf:Property ; rdfs:domain a2ac:ConformanceSurface .
a2ac:surfaceConformantCount a rdf:Property ; rdfs:domain a2ac:ConformanceSurface ;
    rdfs:comment "Conformant row count of the statement this surface projects. Distinct from a2ac:conformantCount (domain SpecCorpus): two rdfs:domain triples on one property intersect, so the surface keeps its own count property." .
a2ac:partialCount a rdf:Property ; rdfs:domain a2ac:ConformanceSurface .
a2ac:gapCount a rdf:Property ; rdfs:domain a2ac:ConformanceSurface .
a2ac:statementPath a rdf:Property ; rdfs:domain a2ac:ConformanceSurface ;
    rdfs:comment "Repo-relative path of the conformance statement this surface projects." .

a2ac:taskName a rdf:Property ; rdfs:domain a2ac:CourtRunner ;
    rdfs:comment "Exact Mix task name, admitted as fact, never synthesized." .
a2ac:runnerModule a rdf:Property ; rdfs:domain a2ac:CourtRunner .
a2ac:runnerSourcePath a rdf:Property ; rdfs:domain a2ac:CourtRunner .
a2ac:runnerListSize a rdf:Property ; rdfs:domain a2ac:CourtRunner .
a2ac:runnerCommand a rdf:Property ; rdfs:domain a2ac:CourtRunner .
a2ac:reportShape a rdf:Property ; rdfs:domain a2ac:CourtRunner .

a2ac:courtFile a rdf:Property ; rdfs:domain a2ac:CourtFile ;
    rdfs:comment "Repo-root-relative test file path, e.g. test/ash_a2a_v1_pagination_test.exs." .
a2ac:runnerListIndex a rdf:Property ; rdfs:domain a2ac:CourtFile ;
    rdfs:comment "1-based order on the runner's @v1_courts list; SPARQL result order is not guaranteed without it." .
a2ac:courtFamily a rdf:Property ; rdfs:domain a2ac:CourtFile ;
    rdfs:comment "Human-readable family label from the court file's moduledoc / statement row." .
a2ac:inRunnerList a rdf:Property ; rdfs:domain a2ac:CourtFile, a2ac:ExcludedCourtFile .

a2ac:corpusPath a rdf:Property ; rdfs:domain a2ac:SpecCorpus .
a2ac:exampleCount a rdf:Property ; rdfs:domain a2ac:SpecCorpus .
a2ac:conformantCount a rdf:Property ; rdfs:domain a2ac:SpecCorpus .
a2ac:codecGapCount a rdf:Property ; rdfs:domain a2ac:SpecCorpus ;
    rdfs:comment "Members the codec rejects are pinned as codec_gap findings, never edited away in lib/." .
a2ac:familyCount a rdf:Property ; rdfs:domain a2ac:SpecCorpus .
a2ac:specSourceUrl a rdf:Property ; rdfs:domain a2ac:SpecCorpus .
a2ac:fetchedAt a rdf:Property ; rdfs:domain a2ac:SpecCorpus .

a2ac:protoPath a rdf:Property ; rdfs:domain a2ac:SpecIdl .
a2ac:protoSha256 a rdf:Property ; rdfs:domain a2ac:SpecIdl ;
    rdfs:comment "sha256 of the pristine vendored IDL, byte-for-byte from a2aproject/A2A (specification/a2a.proto). Any byte change moves this sha and kills the pristine claim." .
a2ac:protoBytes a rdf:Property ; rdfs:domain a2ac:SpecIdl .
a2ac:protoUpstreamUrl a rdf:Property ; rdfs:domain a2ac:SpecIdl .

a2ac:tckRepo a rdf:Property ; rdfs:domain a2ac:TCKRun .
a2ac:tckTransport a rdf:Property ; rdfs:domain a2ac:TCKRun .
a2ac:tckPython a rdf:Property ; rdfs:domain a2ac:TCKRun .
a2ac:tckSut a rdf:Property ; rdfs:domain a2ac:TCKRun .
a2ac:tckRunDate a rdf:Property ; rdfs:domain a2ac:TCKRun .
a2ac:overallPassRate a rdf:Property ; rdfs:domain a2ac:TCKRun .
a2ac:mustPassRate a rdf:Property ; rdfs:domain a2ac:TCKRun .
a2ac:shouldPassRate a rdf:Property ; rdfs:domain a2ac:TCKRun .
a2ac:mayPassRate a rdf:Property ; rdfs:domain a2ac:TCKRun .
a2ac:isCertification a rdf:Property ; rdfs:domain a2ac:TCKRun ;
    rdfs:comment "Always false. 69.2% is a point-in-time verdict on the JSONRPC binding, not a standing certification." .

a2ac:transport a rdf:Property ; rdfs:domain a2ac:TCKTransportRun .
a2ac:total a rdf:Property ; rdfs:domain a2ac:TCKTransportRun .
a2ac:passed a rdf:Property ; rdfs:domain a2ac:TCKTransportRun .
a2ac:failed a rdf:Property ; rdfs:domain a2ac:TCKTransportRun .
a2ac:skipped a rdf:Property ; rdfs:domain a2ac:TCKTransportRun .

a2ac:fixSummary a rdf:Property ; rdfs:domain a2ac:FixedMust .
a2ac:fixSite a rdf:Property ; rdfs:domain a2ac:FixedMust .
a2ac:fixSpecCite a rdf:Property ; rdfs:domain a2ac:FixedMust .

a2ac:findingIds a rdf:Property ; rdfs:domain a2ac:PinnedNonViolation .
a2ac:failureCount a rdf:Property ; rdfs:domain a2ac:PinnedNonViolation .
a2ac:pinReason a rdf:Property ; rdfs:domain a2ac:PinnedNonViolation .

a2ac:courtVerdict a rdf:Property ; rdfs:domain a2ac:ProtoFidelityCourt .
a2ac:courtTestPath a rdf:Property ; rdfs:domain a2ac:ProtoFidelityCourt .
a2ac:courtFalsifier a rdf:Property ; rdfs:domain a2ac:ProtoFidelityCourt ;
    rdfs:comment "Green (all matched) or green-with-pinned-findings. Any NEW drift kills the claim." .

a2ac:familyName a rdf:Property ; rdfs:domain a2ac:CorpusFamily .
a2ac:familyExampleCount a rdf:Property ; rdfs:domain a2ac:CorpusFamily .

a2ac:runOf a rdf:Property ;
    rdfs:comment "Links a transport row, fixed MUST, or pinned non-violation to its a2ac:TCKRun." .
a2ac:PackTemplate a rdfs:Class ;
    rdfs:label "One generator template shipped by this pack." .
a2ac:templatePath a rdf:Property ; rdfs:domain a2ac:PackTemplate .
a2ac:falsifier a rdf:Property .

a2ac:packFalsifier a a2ac:falsifier ;
    rdfs:label "the runner task exists and its court list matches the pack's inventory" ;
    rdfs:comment "Executed by gates/verify_runner_completeness.sh against the real runner source and the real filesystem; the SPARQL half is gates/020_runner_completeness.rq over this pack's own graph." .

#################################################################
# Individuals — ConformanceSurface
#################################################################

a2ac:v1ConformanceSurface a a2ac:ConformanceSurface ;
    a2ac:statementPath "docs/reference/a2a-v1-conformance.md" ;
    rdfs:label "A2A v1.0 conformance statement" ;
    a2ac:statusRowCount 29 ;
    a2ac:surfaceConformantCount 27 ;
    a2ac:partialCount 2 ;
    a2ac:gapCount 0 ;
    rdfs:comment "Out of scope for the statement: push-notification delivery, tasks/resubscribe replay (owned-transport features with their own transport tests), and the gRPC binding (landed after the courts ran; no TCK run over gRPC)." .

#################################################################
# Individuals — CourtRunner
#################################################################

a2ac:v1ConformanceReportTask a a2ac:CourtRunner ;
    a2ac:taskName "ash_a2a.v1_conformance_report" ;
    a2ac:runnerModule "Mix.Tasks.AshA2a.V1ConformanceReport" ;
    a2ac:runnerSourcePath "lib/mix/tasks/ash_a2a.v1_conformance_report.ex" ;
    a2ac:runnerListSize 25 ;
    a2ac:runnerCommand "mix ash_a2a.v1_conformance_report --out receipts/v1-conformance.json" ;
    a2ac:reportShape "%{generated_at, elixir_version, courts: [%{file, exit_code, summary_line, verdict: PASS|FAIL}], totals: %{pass, fail, total}}" ;
    rdfs:comment "Report task, always exits 0; the gate is totals.fail == 0. --only SUBSTRING iterates on a subset; a zero-match substring is a well-formed empty report, not an error. Runtime filesystem check: a listed court missing on disk is a FAIL court-status entry, never a silent pass." .

