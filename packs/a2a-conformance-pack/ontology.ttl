#################################################################
# Individuals — deliberately excluded court files (with reasons)
#################################################################

a2ac:conformance_report_self_test a a2ac:ExcludedCourtFile ;
    a2ac:courtFile "test/ash_a2a_v1_conformance_report_test.exs" ;
    a2ac:inRunnerList false ;
    rdfs:comment "The runner's own self-test (invokes the task as a subprocess); not a v1.0 protocol conformance court, and listing it would make the report recurse." .

a2ac:zach_courts a a2ac:ExcludedCourtFile ;
    a2ac:courtFile "test/ash_a2a_zach_courts_test.exs" ;
    a2ac:inRunnerList false ;
    rdfs:comment "Adversarial extension courts over the DSL/executor surface; exercise v1.0 APIs but are extension courts, not v1.0 protocol conformance." .

#################################################################
# Individuals — SpecCorpus + SpecIdl
#################################################################

a2ac:v1SpecCorpus a a2ac:SpecCorpus ;
    a2ac:corpusPath "priv/a2a_v1_spec_corpus/v1_spec_examples.json" ;
    a2ac:exampleCount 36 ;
    a2ac:conformantCount 30 ;
    a2ac:codecGapCount 6 ;
    a2ac:familyCount 9 ;
    a2ac:specSourceUrl "https://a2a-protocol.org/latest/specification/" ;
    a2ac:fetchedAt "2026-10-04" ;
    rdfs:comment "Frozen, byte-faithful extraction. Members the codec rejects are pinned as codec_gap findings with the exact decode error; no lib/ code was edited to make them pass. Header contract: corpus == a2a_v1_spec_corpus, spec_source.url pinned, findings_summary non-empty, unique ids, >= 30 examples." .

a2ac:v1SpecIdl a a2ac:SpecIdl ;
    a2ac:protoPath "priv/a2a_v1_spec_corpus/a2a.proto" ;
    a2ac:protoSha256 "945df6e34001b2bfd0fd62d9484b63094dfad9d78705e41e2873441c419ae2d1" ;
    a2ac:protoBytes 35942 ;
    a2ac:protoUpstreamUrl "https://raw.githubusercontent.com/a2aproject/A2A/main/specification/a2a.proto" ;
    rdfs:comment "Vendored verbatim, byte-for-byte, no edits; syntax proto3, package lf.a2a.v1. Provenance and the last touching commit are recorded in the proto-fidelity court's moduledoc. The corpus-integrity gate re-hashes the file and refuses any drift from the pinned sha." .

#################################################################
# Individuals — 9 corpus families (counts from the frozen corpus)
#################################################################

a2ac:family_agent_card     a a2ac:CorpusFamily ; a2ac:familyName "agent_card" ;      a2ac:familyExampleCount 2 .
a2ac:family_message        a a2ac:CorpusFamily ; a2ac:familyName "message" ;         a2ac:familyExampleCount 5 .
a2ac:family_task           a a2ac:CorpusFamily ; a2ac:familyName "task" ;            a2ac:familyExampleCount 7 .
a2ac:family_status         a a2ac:CorpusFamily ; a2ac:familyName "status" ;          a2ac:familyExampleCount 3 .
a2ac:family_artifact       a a2ac:CorpusFamily ; a2ac:familyName "artifact" ;        a2ac:familyExampleCount 3 .
a2ac:family_part           a a2ac:CorpusFamily ; a2ac:familyName "part" ;            a2ac:familyExampleCount 4 .
a2ac:family_event          a a2ac:CorpusFamily ; a2ac:familyName "event" ;           a2ac:familyExampleCount 4 .
a2ac:family_jsonrpc_request a a2ac:CorpusFamily ; a2ac:familyName "jsonrpc_request" ; a2ac:familyExampleCount 6 .
a2ac:family_jsonrpc_error  a a2ac:CorpusFamily ; a2ac:familyName "jsonrpc_error" ;   a2ac:familyExampleCount 2 .

#################################################################
# Individuals — TCKRun 2026-10-05 (lane Z19) with per-transport matrix
#################################################################

a2ac:v1TckRun20261005 a a2ac:TCKRun ;
    a2ac:tckRepo "a2aproject/a2a-tck @ main" ;
    a2ac:tckTransport "jsonrpc" ;
    a2ac:tckPython "Python 3.12 venv" ;
    a2ac:tckSut "tck_sut.exs (in-repo SUT)" ;
    a2ac:tckRunDate "2026-10-05" ;
    a2ac:overallPassRate "69.2%" ;
    a2ac:mustPassRate "70.4%" ;
    a2ac:shouldPassRate "42.9%" ;
    a2ac:mayPassRate "100%" ;
    a2ac:isCertification false ;
    rdfs:comment "Compatibility run via python run_tck.py --transport jsonrpc. grpc and http_json skipped because the served agent card declared the JSONRPC interface only at run time. Point-in-time verdict on the JSONRPC binding; not TCK certification, not a verdict on any other binding or release." .

