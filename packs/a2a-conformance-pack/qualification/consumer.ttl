@prefix a2ac: <http://seanchatmangpt.github.io/packs/a2a-conformance#> .
@prefix dur: <https://seanchatmangpt.github.io/packs/a2a-durability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Qualification-only external fact identity. The canonical capability facts
# are owned by a2a-durability-pack (packs/a2a-durability-pack/ontology.ttl);
# this fixture supplies only the minimum typed identity needed so that this
# pack's three rdfs:seeAlso alignment links (same concept, same IRI per the
# M15 cross-pack convention) do not dangle when a2a-conformance-pack is
# qualified in isolation. Mirrors the standing-ladder-pack precedent.

dur:court-ekv-taskstore-durability a dur:Court ;
    dcterms:source "packs/a2a-durability-pack/ontology.ttl#dur:court-ekv-taskstore-durability" .

dur:court-multinode-continuity a dur:Court ;
    dcterms:source "packs/a2a-durability-pack/ontology.ttl#dur:court-multinode-continuity" .

dur:EkvTaskStore a dur:DurabilitySurface ;
    dcterms:source "packs/a2a-durability-pack/ontology.ttl#dur:EkvTaskStore" .
