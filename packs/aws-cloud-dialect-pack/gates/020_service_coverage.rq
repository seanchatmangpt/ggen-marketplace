# MESSAGE: every parity service has an arcus cell and a smalt cell.
PREFIX awsd: <http://seanchatmangpt.github.io/packs/aws-cloud-dialect#>

SELECT ?s ?violation WHERE {
  ?s a awsd:ParityService .
  VALUES ?emu { "arcus" "smalt" }
  FILTER NOT EXISTS { ?c awsd:forService ?s ; awsd:emulator ?emu }
  BIND(CONCAT("no cell for emulator ", ?emu) AS ?violation)
}
