@prefix otelw: <https://chatmangpt.com/ontology/otel-weaver#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

otelw:CoverageDimension a rdfs:Class .
otelw:CoverageItem a rdfs:Class .
otelw:dimension a rdf:Property .
otelw:status a rdf:Property ; rdfs:range xsd:string .
otelw:surface a rdf:Property ; rdfs:range xsd:string .
otelw:reversible a rdf:Property ; rdfs:range xsd:boolean .

# CLI topology: preserve every surface in Weaver v0.25.1, including deprecated and experimental edges.
otelw:CliDimension a otelw:CoverageDimension ; dcterms:title "CLI surfaces" .
otelw:cCheck a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry check" ; otelw:status "covered" ; otelw:reversible true .
otelw:cGenerate a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry generate" ; otelw:status "covered" ; otelw:reversible true .
otelw:cResolve a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry resolve" ; otelw:status "deprecated-covered" ; otelw:reversible true .
otelw:cSearch a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry search" ; otelw:status "deprecated-covered-v1-only" ; otelw:reversible true .
otelw:cStats a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry stats" ; otelw:status "covered" ; otelw:reversible true .
otelw:cMarkdown a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry update-markdown" ; otelw:status "covered" ; otelw:reversible false .
otelw:cJsonSchema a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry json-schema" ; otelw:status "covered" ; otelw:reversible true .
otelw:cDiff a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry diff" ; otelw:status "covered" ; otelw:reversible true .
otelw:cEmit a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry emit" ; otelw:status "bounded-test-do" ; otelw:reversible false .
otelw:cLive a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry live-check" ; otelw:status "covered" ; otelw:reversible true .
otelw:cMcp a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry mcp" ; otelw:status "covered-read-only" ; otelw:reversible true .
otelw:cInfer a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry infer" ; otelw:status "candidate-only" ; otelw:reversible true .
otelw:cPackage a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "registry package" ; otelw:status "covered" ; otelw:reversible true .
otelw:cDiagnostic a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "diagnostic init" ; otelw:status "covered" ; otelw:reversible true .
otelw:cCompletion a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "completion" ; otelw:status "covered" ; otelw:reversible true .
otelw:cServe a otelw:CoverageItem ; otelw:dimension otelw:CliDimension ; otelw:surface "serve" ; otelw:status "experimental-covered" ; otelw:reversible true .

# Registry source/transport topology.
otelw:TransportDimension a otelw:CoverageDimension ; dcterms:title "Registry transports" .
otelw:tLocal a otelw:CoverageItem ; otelw:dimension otelw:TransportDimension ; otelw:surface "local-directory" ; otelw:status "covered" ; otelw:reversible true .
otelw:tGit a otelw:CoverageItem ; otelw:dimension otelw:TransportDimension ; otelw:surface "git-url@ref[subdir]" ; otelw:status "covered" ; otelw:reversible true .
otelw:tArchive a otelw:CoverageItem ; otelw:dimension otelw:TransportDimension ; otelw:surface "git-archive" ; otelw:status "covered" ; otelw:reversible true .
otelw:tRemote a otelw:CoverageItem ; otelw:dimension otelw:TransportDimension ; otelw:surface "remote-manifest-or-file-url" ; otelw:status "covered" ; otelw:reversible true .
otelw:tRelease a otelw:CoverageItem ; otelw:dimension otelw:TransportDimension ; otelw:surface "github-release-asset" ; otelw:status "covered" ; otelw:reversible true .
otelw:tPrivate a otelw:CoverageItem ; otelw:dimension otelw:TransportDimension ; otelw:surface "private-http-auth-token-env-command" ; otelw:status "covered-no-secret-materialization" ; otelw:reversible true .
otelw:tGitCredentials a otelw:CoverageItem ; otelw:dimension otelw:TransportDimension ; otelw:surface "allow-git-credentials" ; otelw:status "explicit-opt-in" ; otelw:reversible true .

# V2 semantic-definition topology.
otelw:SignalDimension a otelw:CoverageDimension ; dcterms:title "V2 semantic signals" .
otelw:sAttribute a otelw:CoverageItem ; otelw:dimension otelw:SignalDimension ; otelw:surface "attributes" ; otelw:status "covered" ; otelw:reversible true .
otelw:sSpan a otelw:CoverageItem ; otelw:dimension otelw:SignalDimension ; otelw:surface "spans" ; otelw:status "covered" ; otelw:reversible true .
otelw:sMetric a otelw:CoverageItem ; otelw:dimension otelw:SignalDimension ; otelw:surface "metrics" ; otelw:status "covered" ; otelw:reversible true .
otelw:sEvent a otelw:CoverageItem ; otelw:dimension otelw:SignalDimension ; otelw:surface "events" ; otelw:status "covered" ; otelw:reversible true .
otelw:sEntity a otelw:CoverageItem ; otelw:dimension otelw:SignalDimension ; otelw:surface "entities/resources" ; otelw:status "covered-by-registry-model" ; otelw:reversible true .
otelw:sImport a otelw:CoverageItem ; otelw:dimension otelw:SignalDimension ; otelw:surface "imports/ref/ref_group/refinement" ; otelw:status "covered-by-dependency-model" ; otelw:reversible true .

# Policy and template extension topology.
otelw:ExtensionDimension a otelw:CoverageDimension ; dcterms:title "Extension points" .
otelw:eRego a otelw:CoverageItem ; otelw:dimension otelw:ExtensionDimension ; otelw:surface "rego validation/advice" ; otelw:status "covered" ; otelw:reversible true .
otelw:ePreprocessor a otelw:CoverageItem ; otelw:dimension otelw:ExtensionDimension ; otelw:surface "jq advice preprocessor" ; otelw:status "covered-configurable" ; otelw:reversible true .
otelw:eAdviceData a otelw:CoverageItem ; otelw:dimension otelw:ExtensionDimension ; otelw:surface "OPA advice data" ; otelw:status "covered-configurable" ; otelw:reversible true .
otelw:eJinja a otelw:CoverageItem ; otelw:dimension otelw:ExtensionDimension ; otelw:surface "jinja generation targets/config overlays" ; otelw:status "covered" ; otelw:reversible true .
otelw:eMarkdown a otelw:CoverageItem ; otelw:dimension otelw:ExtensionDimension ; otelw:surface "markdown snippet targets" ; otelw:status "covered" ; otelw:reversible true .
otelw:eDiagnostics a otelw:CoverageItem ; otelw:dimension otelw:ExtensionDimension ; otelw:surface "diagnostic templates/formats" ; otelw:status "covered" ; otelw:reversible true .

# Machine-readable contracts and output topology.
otelw:SchemaDimension a otelw:CoverageDimension ; dcterms:title "JSON schema contracts" .
otelw:jResolved a otelw:CoverageItem ; otelw:dimension otelw:SchemaDimension ; otelw:surface "resolved-registry" ; otelw:status "covered" ; otelw:reversible true .
otelw:jGroup a otelw:CoverageItem ; otelw:dimension otelw:SchemaDimension ; otelw:surface "semconv-group" ; otelw:status "covered" ; otelw:reversible true .
otelw:jDefinitionV2 a otelw:CoverageItem ; otelw:dimension otelw:SchemaDimension ; otelw:surface "semconv-definition-v2" ; otelw:status "covered" ; otelw:reversible true .
otelw:jResolvedV2 a otelw:CoverageItem ; otelw:dimension otelw:SchemaDimension ; otelw:surface "resolved-registry-v2" ; otelw:status "covered" ; otelw:reversible true .
otelw:jMaterializedV2 a otelw:CoverageItem ; otelw:dimension otelw:SchemaDimension ; otelw:surface "materialized-registry-v2" ; otelw:status "covered" ; otelw:reversible true .
otelw:jDiff a otelw:CoverageItem ; otelw:dimension otelw:SchemaDimension ; otelw:surface "diff/diff-v2" ; otelw:status "covered" ; otelw:reversible true .
otelw:jPublication a otelw:CoverageItem ; otelw:dimension otelw:SchemaDimension ; otelw:surface "publication-manifest-v2" ; otelw:status "covered" ; otelw:reversible true .
otelw:jDefinitionManifest a otelw:CoverageItem ; otelw:dimension otelw:SchemaDimension ; otelw:surface "definition-manifest-v2" ; otelw:status "covered" ; otelw:reversible true .
otelw:jFinding a otelw:CoverageItem ; otelw:dimension otelw:SchemaDimension ; otelw:surface "policy-finding" ; otelw:status "covered" ; otelw:reversible true .
otelw:jConfig a otelw:CoverageItem ; otelw:dimension otelw:SchemaDimension ; otelw:surface "weaver-config" ; otelw:status "covered" ; otelw:reversible true .

# Runtime proof topology.
otelw:ProofDimension a otelw:CoverageDimension ; dcterms:title "Proof and replay" .
otelw:pStatic a otelw:CoverageItem ; otelw:dimension otelw:ProofDimension ; otelw:surface "static check exit=0" ; otelw:status "PARTIAL_ALIVE" ; otelw:reversible true .
otelw:pPackage a otelw:CoverageItem ; otelw:dimension otelw:ProofDimension ; otelw:surface "package publication manifest" ; otelw:status "CONSTRUCT" ; otelw:reversible true .
otelw:pDiff a otelw:CoverageItem ; otelw:dimension otelw:ProofDimension ; otelw:surface "baseline diff receipt" ; otelw:status "SELECT" ; otelw:reversible true .
otelw:pLive a otelw:CoverageItem ; otelw:dimension otelw:ProofDimension ; otelw:surface "exact-subject OTLP live-check" ; otelw:status "ALIVE-after-observed-execution" ; otelw:reversible true .
otelw:pEmit a otelw:CoverageItem ; otelw:dimension otelw:ProofDimension ; otelw:surface "example OTLP emit" ; otelw:status "bounded-test-DO" ; otelw:reversible false .
otelw:pInference a otelw:CoverageItem ; otelw:dimension otelw:ProofDimension ; otelw:surface "inferred registry" ; otelw:status "UNKNOWN-until-admitted" ; otelw:reversible true .
