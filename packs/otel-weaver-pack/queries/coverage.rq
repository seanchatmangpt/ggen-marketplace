PREFIX otelw: <https://chatmangpt.com/ontology/otel-weaver#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?dimension ?surface ?status ?reversible
WHERE {
  ?item a otelw:CoverageItem ;
        otelw:dimension ?dim ;
        otelw:surface ?surface ;
        otelw:status ?status ;
        otelw:reversible ?reversible .
  ?dim dcterms:title ?dimension .
}
ORDER BY ?dimension ?surface
