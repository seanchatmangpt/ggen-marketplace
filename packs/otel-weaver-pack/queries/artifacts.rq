PREFIX otelw: <https://chatmangpt.com/ontology/otel-weaver#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?registryTitle ?registryDescription ?weaverVersion ?schemaUrl ?namespace ?path ?kind ?artifactDescription ?order
WHERE {
  otelw:defaultRegistry dcterms:title ?registryTitle ; dcterms:description ?registryDescription ; otelw:weaverVersion ?weaverVersion ; otelw:schemaUrl ?schemaUrl ; otelw:namespace ?namespace .
  ?artifact a otelw:Artifact ; otelw:path ?path ; otelw:kind ?kind ; dcterms:description ?artifactDescription ; otelw:order ?order .
}
ORDER BY ?order
