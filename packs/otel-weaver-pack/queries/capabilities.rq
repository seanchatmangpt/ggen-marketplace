PREFIX otelw: <https://chatmangpt.com/ontology/otel-weaver#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?name ?command ?standing ?description ?order ?namespace ?schemaUrl
WHERE {
  otelw:defaultRegistry otelw:namespace ?namespace ; otelw:schemaUrl ?schemaUrl .
  ?cap a otelw:Capability ; dcterms:title ?name ; otelw:command ?command ; otelw:standing ?standing ; dcterms:description ?description ; otelw:order ?order .
}
ORDER BY ?order
