@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix otelw: <https://chatmangpt.com/ontology/otel-weaver#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

otelw:RegistryShape a sh:NodeShape ;
  sh:targetClass otelw:Registry ;
  sh:property [ sh:path otelw:weaverVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path otelw:schemaUrl ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path otelw:authority ; sh:minCount 1 ; sh:hasValue "no-ambient-DO" ] .

otelw:ArtifactShape a sh:NodeShape ;
  sh:targetClass otelw:Artifact ;
  sh:property [ sh:path otelw:path ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path otelw:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

otelw:CapabilityShape a sh:NodeShape ;
  sh:targetClass otelw:Capability ;
  sh:property [ sh:path dcterms:title ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path otelw:command ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path otelw:standing ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
