# Generated OpenTelemetry Semantic Convention Definition Language v2.
file_format: definition/2

attributes:
  - key: {{ results[0]["namespace"] }}.service.name
    type: string
    brief: Logical service name.
    stability: development
    examples: ["checkout"]
  - key: {{ results[0]["namespace"] }}.request.operation
    type: string
    brief: Stable application operation name.
    stability: development
    examples: ["checkout.submit"]
  - key: {{ results[0]["namespace"] }}.request.result
    type: string
    brief: Bounded request outcome classification.
    stability: development
    examples: ["ok", "error"]

spans:
  - type: {{ results[0]["namespace"] }}.request
    name:
      note: "{{ results[0]["namespace"] }} request"
    kind: server
    brief: Inbound request handled by the service.
    stability: development
    attributes:
      - ref: {{ results[0]["namespace"] }}.service.name
        requirement_level: required
      - ref: {{ results[0]["namespace"] }}.request.operation
        requirement_level: required
      - ref: {{ results[0]["namespace"] }}.request.result
        requirement_level: required

metrics:
  - name: {{ results[0]["namespace"] }}.request.duration
    brief: Request latency distribution.
    unit: s
    instrument: histogram
    stability: development
    attributes:
      - ref: {{ results[0]["namespace"] }}.request.operation
        requirement_level: required
      - ref: {{ results[0]["namespace"] }}.request.result
        requirement_level: recommended

events:
  - name: {{ results[0]["namespace"] }}.request.completed
    brief: A service request completed.
    stability: development
    attributes:
      - ref: {{ results[0]["namespace"] }}.request.operation
        requirement_level: required
      - ref: {{ results[0]["namespace"] }}.request.result
        requirement_level: required
