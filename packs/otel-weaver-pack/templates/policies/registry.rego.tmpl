# Generated policy: admission rules, not actuation authority.
package otel_weaver.registry

import rego.v1

deny contains msg if {
  some group in input.groups
  startswith(group.id, "experimental.")
  msg := sprintf("experimental namespace forbidden in admitted registry: %s", [group.id])
}

deny contains msg if {
  some group in input.groups
  group.type == "metric"
  not group.unit
  msg := sprintf("metric must declare unit: %s", [group.id])
}

deny contains msg if {
  some group in input.groups
  group.type == "span"
  not group.brief
  msg := sprintf("span must declare brief: %s", [group.id])
}
