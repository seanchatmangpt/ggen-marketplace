---
to: "{{ consumerProjectName }}/ggen.toml"
sparql:
  rows: |
    PREFIX pat: <http://seanchatmangpt.github.io/packs/pack-authoring#>
    SELECT ?consumerProjectName ?referencedPackName ?referencedPackPath ?consumerTemplatesDir WHERE {
      ?spec a pat:ConsumerManifestSpec ;
            pat:consumerProjectName ?consumerProjectName ;
            pat:referencedPackName ?referencedPackName ;
            pat:referencedPackPath ?referencedPackPath ;
            pat:consumerTemplatesDir ?consumerTemplatesDir .
    } ORDER BY ?consumerProjectName
---
# GENERATED by pack-authoring-pack's scaffold_consumer_ggen_toml.tmpl from a
# pat:ConsumerManifestSpec individual. This is the root manifest for a
# CONSUMER project that syncs against one or more ggen packs — it is not a
# pack.toml (see packs/{{ referencedPackName }}/pack.toml for that).
#
# Schema note (the real, current schema has exactly five valid top-level
# tables): [project], [ontology], [packs], [templates], [law]. Any other
# top-level key or array-table (e.g. a stray [[gates]]) is rejected by the
# ggen binary's own parser at sync time — gates/*.rq belong inside a PACK's
# own directory (packs/<name>/gates/*.rq), never in this consumer manifest.
#
# [project] deliberately carries ONLY `name` here, never `version`: this
# scaffold was verified live against the real ggen 26.8.8 binary, and adding
# `version` under [project] alongside a [packs] table trips the binary's own
# FM-CONFIG-101 ambiguity check ("ggen.toml is ambiguous between the
# declarative-rules and frontmatter schemas") — [project].version is a
# marker of the declarative-rules ([[generation.rules]]) schema, [packs] is
# a marker of the frontmatter (pack-composition) schema, and the two
# together in one file refuse the sync. This is the same FM-CONFIG-101
# failure mode the root-cause analysis this scaffold fixes was written for.

[project]
name = "{{ consumerProjectName }}"

[ontology]
source = "ontology.ttl"

[packs]
{{ referencedPackName }} = { path = "{{ referencedPackPath }}" }

# [templates].dir is THIS consumer project's own template directory — never
# the referenced pack's own templates/ dir. Setting it to "templates" (or
# any path nesting inside a referenced pack's own packs/<name>/templates/)
# collides with that pack's auto-discovered templates and double-renders
# every one of them in one sync (FM-WRITE-008). This scaffold defaults to
# "{{ consumerTemplatesDir }}" precisely so a consumer who only ever edits
# this generated value never reintroduces that bug; gates/
# 020_consumer_manifest_required.rq additionally refuses this spec entirely
# if consumerTemplatesDir is ever set back to the literal string
# "templates".
[templates]
dir = "{{ consumerTemplatesDir }}"
