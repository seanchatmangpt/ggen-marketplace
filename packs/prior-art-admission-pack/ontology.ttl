@prefix pa: <https://seanchatmangpt.github.io/ggen-marketplace/prior-art#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pa:Reference a rdfs:Class .
pa:Search a rdfs:Class .
pa:CandidateFailure a rdfs:Class .
pa:Disposition a rdfs:Class .

pa:REUSE a pa:Disposition .
pa:COMPOSE a pa:Disposition .
pa:EXTEND a pa:Disposition .
pa:NOVEL_GAP a pa:Disposition .

pa:referenceId a rdf:Property ; rdfs:domain pa:Reference .
pa:name a rdf:Property ; rdfs:domain pa:Reference .
pa:retrievalUri a rdf:Property ; rdfs:domain pa:Reference .
pa:semanticCapability a rdf:Property ; rdfs:domain pa:Reference .
pa:exactVersionRequiredBeforeProjection a rdf:Property ; rdfs:domain pa:Reference .

pa:requiredSemantics a rdf:Property ; rdfs:domain pa:Search .
pa:searched a rdf:Property ; rdfs:domain pa:Search ; rdfs:range pa:Reference .
pa:selected a rdf:Property ; rdfs:domain pa:Search ; rdfs:range pa:Reference .
pa:disposition a rdf:Property ; rdfs:domain pa:Search ; rdfs:range pa:Disposition .
pa:falsifier a rdf:Property ; rdfs:domain pa:Search .
pa:candidateFailure a rdf:Property ; rdfs:domain pa:Search ; rdfs:range pa:CandidateFailure .

pa:failedReference a rdf:Property ; rdfs:domain pa:CandidateFailure ; rdfs:range pa:Reference .
pa:missingSemantics a rdf:Property ; rdfs:domain pa:CandidateFailure .
pa:boundary a rdf:Property ; rdfs:domain pa:CandidateFailure .
pa:conditions a rdf:Property ; rdfs:domain pa:CandidateFailure .
