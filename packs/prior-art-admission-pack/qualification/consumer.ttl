@prefix pa: <https://seanchatmangpt.github.io/ggen-marketplace/prior-art#> .

pa:ocel a pa:Reference ;
  pa:referenceId "prior:ocel2" ;
  pa:name "OCEL 2.0" ;
  pa:retrievalUri "https://www.ocel-standard.org/2.0/" ;
  pa:semanticCapability "object-centric-events", "execution-observation" ;
  pa:exactVersionRequiredBeforeProjection true ;
  pa:exactSubject "ocel-standard/ocel2@0123456789abcdef0123456789abcdef01234567" ;
  pa:sourceDigest "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" ;
  pa:qualificationReceipt "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789" .

_:search a pa:Search ;
  pa:requiredSemantics "object-centric-events" ;
  pa:searched pa:ocel ;
  pa:selected pa:ocel ;
  pa:disposition pa:REUSE ;
  pa:falsifier "OCEL 2.0 cannot preserve the required event/object identity" .
