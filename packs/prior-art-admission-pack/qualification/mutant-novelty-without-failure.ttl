@prefix pa: <https://seanchatmangpt.github.io/ggen-marketplace/prior-art#> .

pa:known a pa:Reference ;
  pa:referenceId "prior:known" ;
  pa:name "Known prior art" ;
  pa:retrievalUri "https://example.invalid/prior" ;
  pa:semanticCapability "required-semantics" ;
  pa:exactVersionRequiredBeforeProjection false .

_:bad a pa:Search ;
  pa:requiredSemantics "required-semantics" ;
  pa:searched pa:known ;
  pa:disposition pa:NOVEL_GAP ;
  pa:falsifier "claimed novelty" .
