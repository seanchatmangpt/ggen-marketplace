@prefix eg: <https://ggen.dev/ontology/enterprise-governance#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Minimal positive qualification fixture: a second, independently-named
# governance/control/assurance/certification chain a consumer pack could
# query against -- exercises the full requirement/control/check/certification
# chain with real individuals distinct from the pack's own worked example, so
# scripts/qualify_packs.py's qualify_pack() has real facts to render and
# gates/010_no_certification_without_passing_assurance.rq has more than one
# row to evaluate. This fixture is lawful (backed by a real passing
# AssuranceCheck) and must NOT trigger the gate.

eg:ConsumerVendorRiskRequirement a eg:GovernanceRequirement ;
    rdfs:label "A downstream consumer's third-party vendor-risk governance requirement" ;
    eg:requirementId "GOV-REQ-CONSUMER-VENDOR-RISK-001" ;
    eg:satisfiedBy eg:ConsumerVendorRiskControl .

eg:ConsumerVendorRiskControl a eg:Control ;
    rdfs:label "A downstream consumer's vendor due-diligence control" ;
    eg:satisfies eg:ConsumerVendorRiskRequirement ;
    eg:evaluatedBy eg:ConsumerVendorRiskAssuranceCheck-001 .

eg:ConsumerVendorRiskAssuranceCheck-001 a eg:AssuranceCheck ;
    rdfs:label "A downstream consumer's real, completed assurance evaluation" ;
    eg:checkedOn "2026-09-12"^^xsd:string ;
    eg:evaluates eg:ConsumerVendorRiskControl ;
    eg:checkResult eg:Pass .

eg:ConsumerVendorRiskCertification-001 a eg:Certification ;
    rdfs:label "A downstream consumer's lawfully backed certification" ;
    eg:certifies eg:ConsumerVendorRiskRequirement ;
    eg:backedBy eg:ConsumerVendorRiskAssuranceCheck-001 .
