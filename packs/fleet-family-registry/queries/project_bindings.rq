PREFIX fr: <https://ggen.dev/fleet-family-registry#>
SELECT ?subject ?consumer ?family ?template ?repo ?path WHERE { ?b a fr:Binding ; fr:consumer ?consumer ; fr:family ?family ; fr:targetRepo ?repo ; fr:targetPath ?path ; fr:authority "NONE" . OPTIONAL { ?b fr:subject ?subject } ?family fr:templateKey ?template . } ORDER BY ?consumer ?family ?repo ?path
