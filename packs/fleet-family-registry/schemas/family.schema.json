{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "templateKey",
    "extension",
    "authority"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "templateKey": {
      "type": "string",
      "minLength": 1
    },
    "extension": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "NONE"
    }
  },
  "additionalProperties": false
}