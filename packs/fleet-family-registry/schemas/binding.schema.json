{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "subject",
    "consumer",
    "family",
    "targetRepo",
    "targetPath",
    "authority"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "consumer": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "targetRepo": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "targetPath": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "NONE"
    }
  },
  "additionalProperties": false
}