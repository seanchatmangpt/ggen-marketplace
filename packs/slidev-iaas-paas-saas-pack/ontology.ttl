@prefix pack: <urn:ggen-marketplace:slidev-iaas-paas-saas-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pack:SlidesDeck a pack:PresentationArtifact ;
    rdfs:label "slides.md" ;
    pack:tool "Slidev (sli.dev)" ;
    pack:sections "Overview, IaaS (Manufacturing Capsule Layer), PaaS (managed pipeline), SaaS (receipt-as-product), BRCE cross-cutting invariant" ;
    rdfs:comment "Mirrors chatman-ecosystem docs/jira/v26.8.18's real section headers and terminology (zero unreceipted actuation, BRCE, CANDIDATE/PARTIAL_ALIVE/ALIVE rail maturity, derivation vs actuation receipts) rather than inventing new framing." .

pack:UseLiveData a pack:VueComposable ;
    rdfs:label "useLiveData" ;
    pack:transport "polling via fetch + setInterval, upgradeable to WebSocket" ;
    pack:contract "{ entities, edges, isLoading, error, refresh }" ;
    pack:mutatesLayout false ;
    rdfs:comment "Vue composable mirroring live-data-polling-pack's React useLiveData hook: same return contract, same rule that only entity/edge data changes on each poll, never layout." .

pack:LiveMetricsSlide a pack:VueComponent ;
    rdfs:label "LiveMetrics.vue" ;
    pack:usage "referenced by tag name directly inside slides.md, e.g. <LiveMetrics endpoint=\"/api/rails\" />" ;
    rdfs:comment "Auto-registered Slidev custom component (components/ dir convention); polls a real endpoint live during a presentation via useLiveData, rendering loading/error/empty states, never fabricated numbers." .

pack:PackageJson a pack:ManifestArtifact ;
    rdfs:label "package.json" ;
    pack:deps "@slidev/cli, @slidev/theme-default, vue" ;
    rdfs:comment "Minimal real Slidev project manifest: dev/build/export scripts over the slidev CLI." .
