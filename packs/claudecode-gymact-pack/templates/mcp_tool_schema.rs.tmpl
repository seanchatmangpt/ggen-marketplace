---
to: "generated/claudecode_mcp_tools.rs"
sparql:
  ops: |
    PREFIX dct: <http://purl.org/dc/terms/>
    PREFIX sosa: <http://www.w3.org/ns/sosa/>
    SELECT ?id ?class WHERE { ?cap a sosa:Procedure ; dct:title ?id ; dct:type ?iri . BIND(IF(CONTAINS(STR(?iri), "consequence:do"), "Do", "Read") AS ?class) } ORDER BY ?id
---
//! GENERATED intent schemas. Tool presence grants no authority.
pub const MCP_TOOLS: &[(&str,&str)] = &[
{% for row in ops -%}
    ("claudecode.{{ row.id }}", "{{ row.class }}"),
{% endfor -%}
];
