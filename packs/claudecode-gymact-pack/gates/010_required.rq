# MESSAGE: every sosa:Procedure capability must have dct:title and dct:type
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?s ?missing WHERE { { ?s a sosa:Procedure . BIND(dct:title AS ?missing) } UNION { ?s a sosa:Procedure . BIND(dct:type AS ?missing) } FILTER NOT EXISTS { ?s ?missing ?any } } ORDER BY ?s ?missing
