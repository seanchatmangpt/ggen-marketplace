---
to: "lib/ash_pplan/catalog/plan_catalog.ex"
force: true
sparql:
  plans: |
    PREFIX p-plan: <http://purl.org/net/p-plan#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT DISTINCT ?plan ?plan_label WHERE {
      ?s p-plan:isStepOfPlan ?planNode .
      OPTIONAL { ?planNode rdfs:label ?lbl }
      BIND(STR(?planNode) AS ?plan)
      BIND(COALESCE(STR(?lbl), REPLACE(STR(?planNode), "^.*[#/]", "")) AS ?plan_label)
    }
    ORDER BY ?plan
  steps: |
    PREFIX p-plan: <http://purl.org/net/p-plan#>
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    SELECT DISTINCT ?plan ?step ?step_label WHERE {
      ?stepNode p-plan:isStepOfPlan ?planNode .
      OPTIONAL { ?stepNode rdfs:label ?lbl }
      BIND(STR(?planNode) AS ?plan)
      BIND(STR(?stepNode) AS ?step)
      BIND(COALESCE(STR(?lbl), REPLACE(STR(?stepNode), "^.*[#/]", "")) AS ?step_label)
    }
    ORDER BY ?plan ?step
  predecessors: |
    PREFIX p-plan: <http://purl.org/net/p-plan#>
    SELECT DISTINCT ?plan ?step ?predecessor WHERE {
      ?stepNode p-plan:isStepOfPlan ?planNode ;
                p-plan:isPrecededBy ?predNode .
      BIND(STR(?planNode) AS ?plan)
      BIND(STR(?stepNode) AS ?step)
      BIND(STR(?predNode) AS ?predecessor)
    }
    ORDER BY ?plan ?step ?predecessor
  variables: |
    PREFIX p-plan: <http://purl.org/net/p-plan#>
    SELECT DISTINCT ?plan ?step ?direction ?variable WHERE {
      ?stepNode a p-plan:Step ;
            p-plan:isStepOfPlan ?planNode .
      {
        ?stepNode p-plan:hasInputVar ?varNode .
        BIND("input" AS ?direction)
      }
      UNION
      {
        ?stepNode p-plan:hasOutputVar ?varNode .
        BIND("output" AS ?direction)
      }
      BIND(STR(?planNode) AS ?plan)
      BIND(STR(?stepNode) AS ?step)
      BIND(STR(?varNode) AS ?variable)
    }
    ORDER BY ?plan ?step ?direction ?variable
---
# GENERATED by ggen sync from ontology.ttl (lib/ash_pplan/catalog/plan_catalog.ex).
# Do not edit. Regenerate with ggen sync.
defmodule AshPPlan.Catalog.Plan do
  @moduledoc false

  @plans [
{% for p in plans %}    %{
      iri: "{{ p.plan | addslashes }}",
      label: "{{ p.plan_label | addslashes }}",
      steps: [
{% for s in steps %}{% if s.plan == p.plan %}        %{
          iri: "{{ s.step | addslashes }}",
          label: "{{ s.step_label | addslashes }}",
          predecessors: [{% for r in predecessors %}{% if r.plan == p.plan and r.step == s.step %}"{{ r.predecessor | addslashes }}", {% endif %}{% endfor %}],
          inputs: [{% for v in variables %}{% if v.plan == p.plan and v.step == s.step and v.direction == "input" %}"{{ v.variable | addslashes }}", {% endif %}{% endfor %}],
          outputs: [{% for v in variables %}{% if v.plan == p.plan and v.step == s.step and v.direction == "output" %}"{{ v.variable | addslashes }}", {% endif %}{% endfor %}]
        },
{% endif %}{% endfor %}      ]
    },
{% endfor %}  ]

  def all, do: @plans

  def fetch(plan_iri) do
    Enum.find(@plans, &(&1.iri == plan_iri))
  end
end
