---
to: "lib/ash_pplan/catalog/projection_catalog.ex"
force: true
sparql:
  projections: |
    PREFIX ap: <https://w3id.org/ash-pplan#>
    SELECT DISTINCT ?order ?source ?target ?primitive ?owner ?role ?status WHERE {
      ?projection a ap:Projection ;
          ap:order ?order ;
          ap:sourceTerm ?sourceTerm ;
          ap:targetRuntime ?targetRt ;
          ap:targetPrimitive ?primitiveRaw ;
          ap:owner ?ownerRaw ;
          ap:role ?roleRaw ;
          ap:status ?statusRaw .
      BIND(STR(?sourceTerm) AS ?source)
      BIND(STR(?targetRt) AS ?target)
      BIND(STR(?primitiveRaw) AS ?primitive)
      BIND(STR(?ownerRaw) AS ?owner)
      BIND(STR(?roleRaw) AS ?role)
      BIND(STR(?statusRaw) AS ?status)
    }
    ORDER BY ?order ?source
---
# GENERATED by ggen sync from ontology.ttl (lib/ash_pplan/catalog/projection_catalog.ex).
# Do not edit. Regenerate with ggen sync.
defmodule AshPPlan.Catalog.Projection do
  @moduledoc false

  @projections [
{% for row in projections %}    %{
      source: "{{ row.source | addslashes }}",
      target: "{{ row.target | addslashes }}",
      primitive: "{{ row.primitive | addslashes }}",
      owner: "{{ row.owner | addslashes }}",
      role: "{{ row.role | addslashes }}",
      status: "{{ row.status | addslashes }}"
    },
{% endfor %}  ]

  def all, do: @projections

  def fetch(source_iri) do
    Enum.find(@projections, &(&1.source == source_iri))
  end

  def by_role(role) do
    Enum.filter(@projections, &(&1.role == role))
  end
end
