---
force: true
to: "supabase/migrations/00000000000000_supabase_pack_rls.sql"
sparql:
  tables: >
      PREFIX sb: <https://ggen.dev/packs/supabase#>
      SELECT ?tableName ?schema ?hasRLS WHERE {
        ?table a sb:Table ; sb:tableName ?tableName ; sb:hasRLS ?hasRLS .
        OPTIONAL { ?table sb:schema ?schema }
      }
      ORDER BY ?tableName
  policies: >
      PREFIX sb: <https://ggen.dev/packs/supabase#>
      SELECT ?tableName ?policyName ?policyCommand ?policyUsing ?policyWithCheck WHERE {
        ?table a sb:Table ; sb:tableName ?tableName ; sb:hasPolicy ?policy .
        ?policy a sb:Policy ; sb:policyName ?policyName ; sb:policyCommand ?policyCommand .
        OPTIONAL { ?policy sb:policyUsing ?policyUsing }
        OPTIONAL { ?policy sb:policyWithCheck ?policyWithCheck }
      }
      ORDER BY ?tableName ?policyName
---
-- Generated by supabase-pack (template 050_migration_sql.tmpl).
--
-- Output path note: the frontmatter `to:` is FIXED to
--   supabase/migrations/00000000000000_supabase_pack_rls.sql
-- by default. The `to:` field IS rendered through Tera with the SPARQL row
-- context before writing (ggen sync.rs renders frontmatter `to` per row), so a
-- consumer CAN parametrize it by binding a variable and referencing it, e.g.
--   {% raw %}to: "supabase/migrations/{{ sbVersion }}_supabase_pack_rls.sql"{% endraw %}
-- Consumers following the timestamped named-migration convention
-- (e.g. 20261105000000_cmms_v26_11_5.sql) should author their own migration
-- file with that name alongside this generated one -- this template always
-- writes the fixed zero-padded name so re-sync stays idempotent and the
-- generated RLS block has one stable identity for freeze/drift checks.
--
-- RLS + policy shape mirrors real migrations mined from local
-- projects: ALTER TABLE ... ENABLE ROW LEVEL SECURITY followed by CREATE POLICY statements
-- keyed on auth.uid() / auth.role() = 'service_role'.
{% for t in tables %}{% if t.hasRLS == true or t.hasRLS == "true" -%}
ALTER TABLE {{ t.schema | default(value="public") }}.{{ t.tableName }} ENABLE ROW LEVEL SECURITY;

{% for pol in policies %}{% if pol.tableName == t.tableName -%}
CREATE POLICY "{{ pol.policyName }}"
ON {{ t.schema | default(value="public") }}.{{ t.tableName }}
FOR {{ pol.policyCommand }}
{% if pol.policyUsing -%}
USING ({{ pol.policyUsing }})
{% endif -%}
{% if pol.policyWithCheck -%}
WITH CHECK ({{ pol.policyWithCheck }})
{% endif -%}
;

{% endif %}{% endfor -%}
{% endif %}{% endfor -%}
