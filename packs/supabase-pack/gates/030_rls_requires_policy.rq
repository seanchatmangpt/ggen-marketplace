# MESSAGE: any sb:Table with hasRLS = true must declare at least one sb:Policy via sb:hasPolicy; any returned row is refused. Mirrors the real ENABLE ROW LEVEL SECURITY + CREATE POLICY discipline every sampled migration follows -- RLS without a policy locks a table out entirely and is never the intent.
PREFIX sb: <https://ggen.dev/packs/supabase#>
SELECT ?subject WHERE {
  ?subject a sb:Table ; sb:hasRLS true .
  FILTER NOT EXISTS { ?subject sb:hasPolicy ?policy }
}
ORDER BY ?subject
