# MESSAGE: sb:Client.runtime must be one of browser|server|edge, and sb:Client.package must be one of @supabase/supabase-js|@supabase/ssr; any returned row is refused.
PREFIX sb: <https://ggen.dev/packs/supabase#>
SELECT ?subject ?runtime ?package WHERE {
  ?subject a sb:Client ; sb:runtime ?runtime ; sb:package ?package .
  FILTER (?runtime NOT IN ("browser", "server", "edge") || ?package NOT IN ("@supabase/supabase-js", "@supabase/ssr"))
}
ORDER BY ?subject
