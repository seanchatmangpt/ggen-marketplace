# MESSAGE: sb:Project.projectRef must look like a real Supabase project ref (20-char lowercase alphanumeric); any returned row is refused.
PREFIX sb: <https://ggen.dev/packs/supabase#>
SELECT ?subject ?projectRef WHERE {
  ?subject a sb:Project ; sb:projectRef ?projectRef .
  FILTER (!REGEX(?projectRef, "^[a-z0-9]{20}$"))
}
ORDER BY ?subject
