# MESSAGE: every project, client, table, and auth provider must carry the fields required by the projections; any returned row is refused.
PREFIX sb: <https://ggen.dev/packs/supabase#>
SELECT ?subject ?missing WHERE {
  {
    ?subject a sb:Project .
    VALUES ?missing { sb:projectRef sb:projectId sb:envPrefix }
  } UNION {
    ?subject a sb:Client .
    VALUES ?missing { sb:runtime sb:package }
  } UNION {
    ?subject a sb:Table .
    VALUES ?missing { sb:tableName sb:hasRLS }
  } UNION {
    ?subject a sb:AuthProvider .
    VALUES ?missing { sb:providerKind sb:providerEnabled }
  }
  FILTER NOT EXISTS { ?subject ?missing ?value }
}
ORDER BY ?subject ?missing
