---
to: "ggen-create.json"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:subject a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}{
  "about": "This is a hygen-create definitions file. The hygen-create utility creates generators that can be executed using hygen.",
  "hygen_create_version": "0.4.0",
  "name": "platform-eng-ch05",
  "files_and_dirs": {
    ".github/workflows/deploy.yml": true,
    "Dockerfile": true,
    "README.md": true,
    "app.js": true,
    "argocd-app.yaml": true,
    "demo-app/Dockerfile": true,
    "demo-app/app.py": true,
    "demo-app/k8s-manifests.yaml": true,
    "devex-survey.py": true,
    "devex_results.json": true,
    "friction-analyzer.py": true,
    "friction_report.json": true,
    "ggen-create.json": true,
    "helm/values.yaml": true,
    "instrumentation.js": true,
    "kpis.json": true,
    "logger.js": true,
    "otel-deployment.yaml": true,
    "platform-deploy.sh": true,
    "platform-kpi-collector.py": true,
    "secure-deployment.yaml": true,
    "test-demo-app.py": true,
    "workflow.yaml": true
  },
  "templatize_using_name": "{% endraw %}{{ row.capitalized }}{% raw %}",
  "gen_parent_dir": false
}
{% endraw %}