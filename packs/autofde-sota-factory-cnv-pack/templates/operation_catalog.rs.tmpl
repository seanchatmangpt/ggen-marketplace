---
to: src/operation_catalog.rs
force: true
sparql:
  commands: |
    PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
    PREFIX prov: <http://www.w3.org/ns/prov#>
    PREFIX dcterms: <http://purl.org/dc/terms/>
    SELECT ?noun ?verb ?about ?source WHERE {
      ?noun_node a cnv:Noun ; cnv:name ?noun ; cnv:hasCommand ?command .
      ?command a cnv:Command ; cnv:name ?verb ; cnv:about ?about ;
               cnv:belongsToNoun ?noun_node ;
               prov:wasDerivedFrom ?source_node .
      ?source_node dcterms:identifier ?source .
    }
    ORDER BY ?noun ?verb
  arguments: |
    PREFIX cnv: <https://clap-noun-verb.dev/ontology#>
    SELECT ?verb ?field ?value_kind (STR(?required_value) AS ?required)
           (STR(?position_value) AS ?position)
           (COALESCE(STR(?default), "") AS ?default_value)
    WHERE {
      ?command a cnv:Command ; cnv:name ?verb ; cnv:hasArgument ?argument .
      ?argument cnv:fieldName ?field ; cnv:valueKind ?value_kind ;
                cnv:required ?required_value ; cnv:position ?position_value .
      OPTIONAL { ?argument cnv:defaultValue ?default }
    }
    ORDER BY ?verb ?field
---
//! GENERATED by ggen from an admitted cnv: individual graph. Do not edit.
//!
//! Machine-checkable catalog of the command surface transcribed from the
//! hand-rolled argparse CLI. Declarative only: no actuation, no boundary.

/// One admitted command argument.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ArgumentSpec {
    pub verb: &'static str,
    pub field: &'static str,
    pub value_kind: &'static str,
    pub required: bool,
    /// Positive positional index; 0 means option/flag.
    pub position: u32,
    pub default_value: &'static str,
}

/// One admitted noun-verb command.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct CommandSpec {
    pub noun: &'static str,
    pub verb: &'static str,
    pub about: &'static str,
    /// Provenance: the hand-rolled source this command was transcribed from.
    pub source: &'static str,
}

pub const COMMANDS: &[CommandSpec] = &[
{% for row in commands %}    CommandSpec {
        noun: "{{ row.noun }}",
        verb: "{{ row.verb }}",
        about: "{{ row.about }}",
        source: "{{ row.source }}",
    },
{% endfor %}];

pub const ARGUMENTS: &[ArgumentSpec] = &[
{% for row in arguments %}    ArgumentSpec {
        verb: "{{ row.verb }}",
        field: "{{ row.field }}",
        value_kind: "{{ row.value_kind }}",
        required: {{ row.required }},
        position: {{ row.position }},
        default_value: "{{ row.default_value }}",
    },
{% endfor %}];

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn every_command_carries_provenance() {
        assert!(!COMMANDS.is_empty());
        for command in COMMANDS {
            assert!(command.source.ends_with(".py"), "{command:?}");
        }
    }

    #[test]
    fn every_argument_belongs_to_an_admitted_verb() {
        for argument in ARGUMENTS {
            assert!(
                COMMANDS.iter().any(|c| c.verb == argument.verb),
                "orphan argument {argument:?}"
            );
        }
    }
}
