# Individual graph for the hand-rolled argparse CLI at
# vendor/autofde-lab/src/autofde_lab/sota_factory/cli.py (83 lines, argparse,
# `sub = parser.add_subparsers(dest="command", required=True)`, three
# sub_parsers: compile / status / next).
#
# Every noun, verb, argument, default and type below is transcribed from that
# real file, not invented. Provenance is first-class (prov:wasDerivedFrom +
# source line) so the graph is auditable against the source it replaces.
#
# AUTHORITY BOUNDARY: this pack declares a command surface only. Every command
# carries cnv:CustomBehavior, meaning the real SELECT/LEARN domain logic stays
# hand-written in Python/Rust behind the generated dispatch. No cnv:Boundary is
# admitted here, so nothing in this graph can actuate anything; consequential DO
# remains behind GymAct/BRCE admission exactly as clap-noun-verb-boundary-pack
# requires.

@prefix cnv:     <https://clap-noun-verb.dev/ontology#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix urn:     <urn:autofde:sota-factory:> .

urn:SourceCli
    a prov:Entity ;
    dcterms:identifier "vendor/autofde-lab/src/autofde_lab/sota_factory/cli.py" ;
    dcterms:description "Hand-rolled argparse control plane, build_parser() at line 29." .

urn:Cli
    a cnv:Cli ;
    prov:wasDerivedFrom urn:SourceCli ;
    cnv:binaryName "sota-factory" ;
    cnv:crateName "sota-factory" ;
    cnv:version "0.1.0" ;
    cnv:edition "2024" ;
    cnv:rustVersion "1.85" ;
    cnv:about "SELECT/LEARN SOTA factory control plane. No actuation path." ;
    cnv:hasNoun urn:ExperimentNoun .

urn:ExperimentNoun
    a cnv:Noun ;
    cnv:name "experiment" ;
    cnv:about "Compile, score and select lawful experiment plans." ;
    cnv:hasCommand urn:Compile , urn:Status , urn:Next .

# ── compile: sub.add_parser("compile", help="compile lawful experiment plans as JSONL")
urn:Compile
    a cnv:Command ;
    prov:wasDerivedFrom urn:SourceCli ;
    cnv:name "compile" ;
    cnv:about "compile lawful experiment plans as JSONL" ;
    cnv:belongsToNoun urn:ExperimentNoun ;
    cnv:hasArgument urn:CompileSpec , urn:CompileOut ;
    cnv:hasBehavior urn:CompileBehavior .

urn:CompileBehavior a cnv:CustomBehavior .

# ── status: sub.add_parser("status", help="derive scoreboard and learning signals")
urn:Status
    a cnv:Command ;
    prov:wasDerivedFrom urn:SourceCli ;
    cnv:name "status" ;
    cnv:about "derive scoreboard and learning signals" ;
    cnv:belongsToNoun urn:ExperimentNoun ;
    cnv:hasArgument urn:StatusSpec , urn:StatusResults , urn:StatusOut ;
    cnv:hasBehavior urn:StatusBehavior .

urn:StatusBehavior a cnv:CustomBehavior .

# ── next: sub.add_parser("next", help="select next unexecuted experiment batch")
urn:Next
    a cnv:Command ;
    prov:wasDerivedFrom urn:SourceCli ;
    cnv:name "next" ;
    cnv:about "select next unexecuted experiment batch" ;
    cnv:belongsToNoun urn:ExperimentNoun ;
    cnv:hasArgument urn:NextSpec , urn:NextResults , urn:NextBatchSize , urn:NextOut ;
    cnv:hasBehavior urn:NextBehavior .

urn:NextBehavior a cnv:CustomBehavior .

# ── Arguments (one per real add_argument call) ───────────────────────────────

urn:CompileSpec a cnv:Argument ;
    cnv:fieldName "spec" ; cnv:valueKind "path" ; cnv:required true ;
    cnv:position 1 ; cnv:testValue "spec.json" ;
    cnv:about "compile_p.add_argument(\"spec\")" .

urn:CompileOut a cnv:Argument ;
    cnv:fieldName "out" ; cnv:valueKind "path" ; cnv:required false ;
    cnv:position 0 ; cnv:longFlag "out" ; cnv:testValue "plans.jsonl" ;
    cnv:about "compile_p.add_argument(\"--out\")" .

urn:StatusSpec a cnv:Argument ;
    cnv:fieldName "spec" ; cnv:valueKind "path" ; cnv:required true ;
    cnv:position 1 ; cnv:testValue "spec.json" ;
    cnv:about "status_p.add_argument(\"spec\")" .

urn:StatusResults a cnv:Argument ;
    cnv:fieldName "results" ; cnv:valueKind "path" ; cnv:required false ;
    cnv:position 0 ; cnv:longFlag "results" ; cnv:testValue "results.jsonl" ;
    cnv:about "status_p.add_argument(\"--results\")" .

urn:StatusOut a cnv:Argument ;
    cnv:fieldName "out" ; cnv:valueKind "path" ; cnv:required false ;
    cnv:position 0 ; cnv:longFlag "out" ; cnv:testValue "status.json" ;
    cnv:about "status_p.add_argument(\"--out\")" .

urn:NextSpec a cnv:Argument ;
    cnv:fieldName "spec" ; cnv:valueKind "path" ; cnv:required true ;
    cnv:position 1 ; cnv:testValue "spec.json" ;
    cnv:about "next_p.add_argument(\"spec\")" .

urn:NextResults a cnv:Argument ;
    cnv:fieldName "results" ; cnv:valueKind "path" ; cnv:required false ;
    cnv:position 0 ; cnv:longFlag "results" ; cnv:testValue "results.jsonl" ;
    cnv:about "next_p.add_argument(\"--results\")" .

urn:NextBatchSize a cnv:Argument ;
    cnv:fieldName "batch_size" ; cnv:valueKind "i64" ; cnv:required false ;
    cnv:position 0 ; cnv:longFlag "batch-size" ; cnv:defaultValue "8" ;
    cnv:testValue "8" ;
    cnv:about "next_p.add_argument(\"--batch-size\", type=int, default=8)" .

urn:NextOut a cnv:Argument ;
    cnv:fieldName "out" ; cnv:valueKind "path" ; cnv:required false ;
    cnv:position 0 ; cnv:longFlag "out" ; cnv:testValue "batch.jsonl" ;
    cnv:about "next_p.add_argument(\"--out\")" .
