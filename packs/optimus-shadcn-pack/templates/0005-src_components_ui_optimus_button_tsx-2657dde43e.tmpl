---
to: "src/components/ui/{{ row.lower }}-button.tsx"
sparql:
  entities: |
    PREFIX gc: <https://ggen.io/ontology/ggen-create#>
    SELECT ?name ?upper ?lower ?capitalized ?pascal ?camel ?snake ?upper_snake ?kebab ?title
    WHERE {
      gc:gc_subject_optimus_shadcn_pack a gc:GenerationSubject ;
          gc:name ?name ;
          gc:upper ?upper ;
          gc:lower ?lower ;
          gc:capitalized ?capitalized ;
          gc:pascal ?pascal ;
          gc:camel ?camel ;
          gc:snake ?snake ;
          gc:upper_snake ?upper_snake ;
          gc:kebab ?kebab ;
          gc:title ?title .
    }
for_each: entities
---
{% raw %}import * as React from "react";
import { Slot } from "@radix-ui/react-slot";
import { cva, type VariantProps } from "class-variance-authority";

import { cn } from "@/lib/utils";

const {% endraw %}{{ row.lower }}{% raw %}ButtonVariants = cva(
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px]",
  {
    variants: {
      variant: {
        default: "bg-primary text-primary-foreground hover:bg-primary/90",
        destructive:
          "bg-destructive text-destructive-foreground hover:bg-destructive/90 focus-visible:ring-destructive/20 dark:focus-visible:ring-destructive/40 dark:bg-destructive/60",
        outline:
          "border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50",
        secondary:
          "bg-secondary text-secondary-foreground hover:bg-secondary/80",
        ghost:
          "hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50",
        link: "text-primary underline-offset-4 hover:underline",
        // {% endraw %}{{ row.capitalized }}{% raw %} Prime themed variants
        autobot:
          "bg-autobot-red text-autobot-red-foreground hover:bg-autobot-red/90 focus-visible:ring-autobot-red/20",
        cyber:
          "bg-cyber-blue text-cyber-blue-foreground hover:bg-cyber-blue/90 focus-visible:ring-cyber-blue/20",
        energon:
          "bg-energon text-energon-foreground hover:bg-energon/90 focus-visible:ring-energon/20",
        gunmetal:
          "bg-gunmetal text-gunmetal-foreground hover:bg-gunmetal/90 focus-visible:ring-gunmetal/20",
        steel:
          "bg-steel text-steel-foreground hover:bg-steel/90 focus-visible:ring-steel/20",
      },
      size: {
        default: "h-9 px-4 py-2 has-[>svg]:px-3",
        sm: "h-8 rounded-md gap-1.5 px-3 has-[>svg]:px-2.5",
        lg: "h-10 rounded-md px-6 has-[>svg]:px-4",
        icon: "size-9",
        "icon-sm": "size-8",
        "icon-lg": "size-10",
      },
    },
    defaultVariants: {
      variant: "default",
      size: "default",
    },
  }
);

function {% endraw %}{{ row.capitalized }}{% raw %}Button({
  className,
  variant,
  size,
  asChild = false,
  ...props
}: React.ComponentProps<"button"> &
  VariantProps<typeof {% endraw %}{{ row.lower }}{% raw %}ButtonVariants> & {
    asChild?: boolean;
  }) {
  const Comp = asChild ? Slot : "button";

  return (
    <Comp
      data-slot="{% endraw %}{{ row.lower }}{% raw %}-button"
      className={cn({% endraw %}{{ row.lower }}{% raw %}ButtonVariants({ variant, size, className }))}
      {...props}
    />
  );
}

export { {% endraw %}{{ row.capitalized }}{% raw %}Button, {% endraw %}{{ row.lower }}{% raw %}ButtonVariants };
{% endraw %}