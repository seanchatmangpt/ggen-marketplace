@prefix pack: <urn:ggen-marketplace:optimus-shadcn-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pack:Project a pack:Project ;
    rdfs:label "optimus-prime-platform" ;
    pack:sourcePath "/Users/sac/optimus"^^xsd:string ;
    pack:framework "Next.js" ;
    pack:packageManager "pnpm" ;
    pack:shadcnStyle "new-york" ;
    pack:shadcnBaseColor "neutral" ;
    rdfs:comment "Local React/Next.js project admitted into the marketplace as a semantic-profile pack; package.json name is optimus-prime-platform, lockfile is pnpm-lock.yaml, and components.json declares shadcn style=new-york, baseColor=neutral, rsc=true." .

pack:ShadcnUsage a pack:TechnologyFinding ;
    rdfs:label "shadcn/ui" ;
    pack:status "confirmed-in-use" ;
    pack:artifactCount "19"^^xsd:integer ;
    pack:cnUsageFileCount "58"^^xsd:integer ;
    pack:cvaUsageFileCount "6"^^xsd:integer ;
    pack:radixImportFileCount "16"^^xsd:integer ;
    rdfs:comment "shadcn/ui is genuinely used, not merely listed as a dependency: 19 component files exist under src/components/ui/, the cn() utility from @/lib/utils is imported in 58 source files, class-variance-authority (cva) appears in 6 files, and @radix-ui/* packages are imported in 16 files." .

pack:DeckGlUsage a pack:TechnologyFinding ;
    rdfs:label "deck.gl" ;
    pack:status "absent" ;
    pack:artifactCount "0"^^xsd:integer ;
    rdfs:comment "deck.gl is NOT used in this project: no deck.gl or @deck.gl/* package appears in package.json, and no grep hit for deck.gl, DeckGL, ScatterplotLayer, GeoJsonLayer, HexagonLayer, or ArcLayer was found anywhere under src/. This is stated plainly rather than fabricated." .

