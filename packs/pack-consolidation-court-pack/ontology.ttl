@prefix pcc: <https://ggen.dev/ontology/pack-consolidation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pcc:Pack a rdfs:Class .
pcc:ConsolidationRelation a rdfs:Class .
pcc:Disposition a skos:ConceptScheme ; skos:prefLabel "Pack consolidation disposition" .

pcc:HARD_MERGE a skos:Concept ; skos:inScheme pcc:Disposition ; skos:prefLabel "HARD_MERGE" .
pcc:EXTRACT_SHARED_ONTOLOGY a skos:Concept ; skos:inScheme pcc:Disposition ; skos:prefLabel "EXTRACT_SHARED_ONTOLOGY" .
pcc:META_COMPOSE a skos:Concept ; skos:inScheme pcc:Disposition ; skos:prefLabel "META_COMPOSE" .
pcc:DEPRECATE_INSTANCE a skos:Concept ; skos:inScheme pcc:Disposition ; skos:prefLabel "DEPRECATE_INSTANCE" .
pcc:KEEP_DISTINCT a skos:Concept ; skos:inScheme pcc:Disposition ; skos:prefLabel "KEEP_DISTINCT" .
pcc:UNKNOWN_WITH_REASON a skos:Concept ; skos:inScheme pcc:Disposition ; skos:prefLabel "UNKNOWN_WITH_REASON" .

pcc:member a rdf:Property .
pcc:canonical a rdf:Property .
pcc:disposition a rdf:Property .
pcc:reason a rdf:Property .
pcc:status a rdf:Property .
pcc:priority a rdf:Property .
pcc:requiresMigration a rdf:Property .

# ELIMINATE: one canonical constructor for pack structure.
pcc:pack-authoring-constructor a pcc:ConsolidationRelation ;
  pcc:member "ggen-self-pack" ; pcc:member "pack-authoring-pack" ;
  pcc:canonical "ggen-self-pack" ; pcc:disposition pcc:HARD_MERGE ;
  pcc:priority 1 ; pcc:status "MIGRATION_STARTED" ; pcc:requiresMigration true ;
  pcc:reason "ggen-self-pack already declares itself the canonical constructor for pack structure; pack-authoring remains compatibility-only until its authoring surfaces are absorbed." .

# ELIMINATE: measurement and admission/control are phases over one exact-subject authenticity model.
pcc:runtime-evidence-authenticity a pcc:ConsolidationRelation ;
  pcc:member "runtime-evidence-authenticity-pack" ; pcc:member "runtime-evidence-authenticity-control-pack" ;
  pcc:canonical "runtime-evidence-authenticity-pack" ; pcc:disposition pcc:HARD_MERGE ;
  pcc:priority 1 ; pcc:status "MIGRATION_STARTED" ; pcc:requiresMigration true ;
  pcc:reason "Both packs carry the same exact-subject identity and authority envelope; control is a projection over authenticity measurement, not a second semantic authority." .

# REDUCE: DfCM candidate/CTQ/falsifier/rollback vocabularies are repeated under sibling namespaces.
pcc:dfcm-decision-law a pcc:ConsolidationRelation ;
  pcc:member "dfcm-pack" ; pcc:member "dfcm-selection-capital-pack" ;
  pcc:member "dfcm-maximalist-court-pack" ; pcc:member "dfcm-explore-court-pack" ;
  pcc:member "dfcm-maximalist-selection-control-pack" ; pcc:member "dfcm-explore-candidate-factory-pack" ;
  pcc:canonical "dfcm-pack" ; pcc:disposition pcc:EXTRACT_SHARED_ONTOLOGY ;
  pcc:priority 1 ; pcc:status "OPEN" ; pcc:requiresMigration true ;
  pcc:reason "Candidate, CTQ, evidence, falsifier, dependency, rollback, standing and authority are duplicated across sel:, dmc: and dms: namespaces." .

# REDUCE: one source of truth for wasm4pm analysis facts.
pcc:wasm4pm-analysis-facts a pcc:ConsolidationRelation ;
  pcc:member "wasm4pm-facts-pack" ; pcc:member "wasm4pm-algorithms-pack" ; pcc:member "wasm4pm-cognition-pack" ;
  pcc:canonical "wasm4pm-facts-pack" ; pcc:disposition pcc:EXTRACT_SHARED_ONTOLOGY ;
  pcc:priority 1 ; pcc:status "OPEN" ; pcc:requiresMigration true ;
  pcc:reason "wasm4pm-facts-pack records repeated drift of identical algorithm IRIs carried by wasm4pm-algorithms-pack; facts must become single-source while dispatch packs remain projections." .

# REDUCE: shared observation/memory identity law, separate projections.
pcc:observation-memory-law a pcc:ConsolidationRelation ;
  pcc:member "run-protocol-observability-pack" ; pcc:member "control-plane-causality-observability-pack" ;
  pcc:member "temporal-truth-observability-pack" ; pcc:member "portfolio-epistemic-observability-pack" ;
  pcc:member "replication-epistemic-observability-pack" ;
  pcc:canonical "temporal-truth-observability-pack" ; pcc:disposition pcc:EXTRACT_SHARED_ONTOLOGY ;
  pcc:priority 1 ; pcc:status "OPEN" ; pcc:requiresMigration true ;
  pcc:reason "Request, Receipt, MemoryRecord, ExactSubject, standing and currentness are independently reminted; keep projections but share identity law." .

# REDUCE: realization measurement and adaptive control share one policy lifecycle.
pcc:evidence-capital-policy a pcc:ConsolidationRelation ;
  pcc:member "evidence-capital-policy-realization-pack" ; pcc:member "evidence-capital-policy-adaptive-control-pack" ;
  pcc:canonical "evidence-capital-policy-realization-pack" ; pcc:disposition pcc:HARD_MERGE ;
  pcc:priority 2 ; pcc:status "OPEN" ; pcc:requiresMigration true ;
  pcc:reason "Adaptive control consumes the realization measurement surface; keep phase separation but remove independent install-time semantic ownership." .

# CREATE: one discovery/composition surface for manufacturing stages.
pcc:autonomic-manufacturing-factory a pcc:ConsolidationRelation ;
  pcc:member "forced-top25-admissibility-factory-pack" ; pcc:member "multicell-consumer-factory-pack" ;
  pcc:member "manufacturing-fanout-controller-pack" ; pcc:member "capability-lineage-propagation-pack" ;
  pcc:member "consumer-realization-frontier-pack" ; pcc:member "fanout-realization-controller-pack" ;
  pcc:canonical "manufacturing-fanout-controller-pack" ; pcc:disposition pcc:META_COMPOSE ;
  pcc:priority 2 ; pcc:status "OPEN" ; pcc:requiresMigration false ;
  pcc:reason "These are valid manufacturing stages but should present one canonical bundle and shared Consumer/Factory/Lineage/Qualification vocabulary." .

# CREATE: repo lifecycle already has healthy modular boundaries; add only a root composition surface.
pcc:repo-lifecycle a pcc:ConsolidationRelation ;
  pcc:member "repo-as-found-pack" ; pcc:member "repo-load-path-pack" ; pcc:member "repo-intervention-pack" ;
  pcc:member "temporary-works-pack" ; pcc:member "repo-reconciliation-pack" ;
  pcc:canonical "repo-reconciliation-pack" ; pcc:disposition pcc:META_COMPOSE ;
  pcc:priority 3 ; pcc:status "KEEP_MODULES" ; pcc:requiresMigration false ;
  pcc:reason "The family is an explicit dependency DAG; consolidation should add a root meta-pack without flattening reusable stages." .

# KEEP: clap-noun-verb is the reference decomposition.
pcc:clap-noun-verb-compiler a pcc:ConsolidationRelation ;
  pcc:member "clap-noun-verb-schema-pack" ; pcc:member "clap-noun-verb-crate-pack" ;
  pcc:member "clap-noun-verb-routing-pack" ; pcc:member "clap-noun-verb-behavior-pack" ;
  pcc:member "clap-noun-verb-boundary-pack" ; pcc:member "clap-noun-verb-verification-pack" ;
  pcc:canonical "clap-noun-verb-schema-pack" ; pcc:disposition pcc:KEEP_DISTINCT ;
  pcc:priority 4 ; pcc:status "HEALTHY" ; pcc:requiresMigration false ;
  pcc:reason "Distinct compiler phases with a zero-config starter already composing them; do not flatten." .

# DEPRECATE INSTANCE: release versions are facts under generic release law.
pcc:ecosystem-release-instance a pcc:ConsolidationRelation ;
  pcc:member "chatman-ecosystem-release-pack" ; pcc:member "chatman-ecosystem-v26-9-1-release-gate" ;
  pcc:canonical "chatman-ecosystem-release-pack" ; pcc:disposition pcc:DEPRECATE_INSTANCE ;
  pcc:priority 1 ; pcc:status "MIGRATION_STARTED" ; pcc:requiresMigration true ;
  pcc:reason "The generic pack owns reusable exact-SHA release law; v26.9.1 is a release instance/profile, not a new semantic authority." .
