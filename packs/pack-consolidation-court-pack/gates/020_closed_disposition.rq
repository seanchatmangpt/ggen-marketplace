# MESSAGE: consolidation disposition is a closed vocabulary; unknown action words cannot silently enter the ERRC court.
PREFIX pcc: <https://ggen.dev/ontology/pack-consolidation#>
SELECT ?relation ?disposition WHERE {
  ?relation a pcc:ConsolidationRelation ; pcc:disposition ?disposition .
  FILTER(?disposition NOT IN (
    pcc:HARD_MERGE,
    pcc:EXTRACT_SHARED_ONTOLOGY,
    pcc:META_COMPOSE,
    pcc:DEPRECATE_INSTANCE,
    pcc:KEEP_DISTINCT,
    pcc:UNKNOWN_WITH_REASON
  ))
}
