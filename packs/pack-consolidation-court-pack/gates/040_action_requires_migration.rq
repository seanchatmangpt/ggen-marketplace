# MESSAGE: HARD_MERGE, EXTRACT_SHARED_ONTOLOGY and DEPRECATE_INSTANCE are migration obligations, not advisory labels.
PREFIX pcc: <https://ggen.dev/ontology/pack-consolidation#>
SELECT ?relation ?disposition ?requiresMigration WHERE {
  ?relation a pcc:ConsolidationRelation ;
    pcc:disposition ?disposition ;
    pcc:requiresMigration ?requiresMigration .
  FILTER(?disposition IN (pcc:HARD_MERGE, pcc:EXTRACT_SHARED_ONTOLOGY, pcc:DEPRECATE_INSTANCE))
  FILTER(?requiresMigration != true)
}
