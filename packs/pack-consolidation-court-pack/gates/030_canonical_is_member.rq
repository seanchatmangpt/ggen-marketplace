# MESSAGE: each consolidation relation has exactly one canonical pack and that canonical pack must also be a member of the classified family.
PREFIX pcc: <https://ggen.dev/ontology/pack-consolidation#>
SELECT ?relation ?canonical ?problem WHERE {
  {
    ?relation a pcc:ConsolidationRelation ; pcc:canonical ?canonical .
    FILTER NOT EXISTS { ?relation pcc:member ?canonical }
    BIND("canonical_not_member" AS ?problem)
  }
  UNION
  {
    ?relation a pcc:ConsolidationRelation ; pcc:canonical ?canonical ; pcc:canonical ?other .
    FILTER(?canonical != ?other)
    BIND("multiple_canonicals" AS ?problem)
  }
}
