to: "generated/ERRC_CONSOLIDATION_PLAN.md"
sparql:
  rows: |
    PREFIX pcc: <https://ggen.dev/ontology/pack-consolidation#>
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT ?relation ?priority ?disposition ?canonical ?status ?requiresMigration ?reason (GROUP_CONCAT(DISTINCT ?member; separator=", ") AS ?members) WHERE {
      ?relation a pcc:ConsolidationRelation ;
        pcc:priority ?priority ;
        pcc:disposition ?d ;
        pcc:canonical ?canonical ;
        pcc:status ?status ;
        pcc:requiresMigration ?requiresMigration ;
        pcc:reason ?reason ;
        pcc:member ?member .
      ?d skos:prefLabel ?disposition .
    }
    GROUP BY ?relation ?priority ?disposition ?canonical ?status ?requiresMigration ?reason
    ORDER BY ?priority ?relation
---
