PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reversibility ?reuse ?fanout (?reversibility * ?reuse * ?fanout AS ?score) WHERE { ?candidate a clm:Candidate ; clm:reversibility ?reversibility ; clm:reusability ?reuse ; clm:consumerFanout ?fanout ; clm:actuationPerformed false . }
ORDER BY DESC(?score) ?candidate
