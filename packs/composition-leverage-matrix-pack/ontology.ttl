@prefix clm: <https://ggen.dev/ontology/composition-leverage-matrix#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

clm:Candidate a prov:Entity .
clm:Composition a prov:Entity .
clm:Surface a skos:Concept .
clm:LeverageDimension a dqv:Dimension .
clm:seedA a clm:Candidate ; clm:capability "frontier-replay" ; clm:reusability 0.95 ; clm:consumerFanout 4 ; clm:qualificationFanout 4 ; clm:reversibility 1.0 ; clm:authority "SELECT" ; clm:actuationPerformed false .
clm:seedB a clm:Candidate ; clm:capability "portfolio-observability" ; clm:reusability 0.9 ; clm:consumerFanout 5 ; clm:qualificationFanout 3 ; clm:reversibility 1.0 ; clm:authority "VERIFY" ; clm:actuationPerformed false .
clm:pairAB a clm:Composition ; clm:member clm:seedA, clm:seedB ; clm:order 2 ; clm:expectedLeverage 12 ; clm:qualified true .
clm:controller clm:authority "SELECT|CONSTRUCT|VERIFY" ; clm:zeroUnreceiptedActuation true ; clm:actuationPerformed false .
