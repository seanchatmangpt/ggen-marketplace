PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?qualificationFanout (?qualificationFanout AS ?qualificationReuseProxy) WHERE { ?candidate a clm:Candidate ; clm:qualificationFanout ?qualificationFanout ; clm:actuationPerformed false . }
ORDER BY DESC(?qualificationReuseProxy) ?candidate
