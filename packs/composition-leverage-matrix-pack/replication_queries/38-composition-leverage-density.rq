PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition ?order ?leverage (?leverage / ?order AS ?leveragePerMember) WHERE { ?composition a clm:Composition ; clm:order ?order ; clm:expectedLeverage ?leverage ; clm:qualified true . FILTER(?order > 0) }
ORDER BY DESC(?leveragePerMember) ?composition
