PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate (COUNT(?composition) AS ?compositionCount) WHERE { ?candidate a clm:Candidate ; clm:actuationPerformed false . OPTIONAL { ?composition a clm:Composition ; clm:member ?candidate ; clm:qualified true . } }
GROUP BY ?candidate
ORDER BY DESC(?compositionCount) ?candidate
