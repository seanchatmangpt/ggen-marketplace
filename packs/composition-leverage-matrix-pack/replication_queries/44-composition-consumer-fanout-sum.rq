PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition (SUM(?consumer) AS ?consumerFanoutSum) WHERE { ?composition a clm:Composition ; clm:member ?member ; clm:qualified true . ?member a clm:Candidate ; clm:consumerFanout ?consumer ; clm:actuationPerformed false . }
GROUP BY ?composition
ORDER BY DESC(?consumerFanoutSum) ?composition
