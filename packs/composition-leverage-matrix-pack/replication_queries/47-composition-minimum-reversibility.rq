PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition (MIN(?reversibility) AS ?minimumReversibility) WHERE { ?composition a clm:Composition ; clm:member ?member ; clm:qualified true . ?member a clm:Candidate ; clm:reversibility ?reversibility ; clm:actuationPerformed false . }
GROUP BY ?composition
ORDER BY DESC(?minimumReversibility) ?composition
