PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition (SUM(?qualification) AS ?qualificationFanoutSum) WHERE { ?composition a clm:Composition ; clm:member ?member ; clm:qualified true . ?member a clm:Candidate ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . }
GROUP BY ?composition
ORDER BY DESC(?qualificationFanoutSum) ?composition
