PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reversibility ?consumer (?reversibility * ?consumer AS ?reversibleFanout) WHERE { ?candidate a clm:Candidate ; clm:reversibility ?reversibility ; clm:consumerFanout ?consumer ; clm:actuationPerformed false . }
ORDER BY DESC(?reversibleFanout) ?candidate
