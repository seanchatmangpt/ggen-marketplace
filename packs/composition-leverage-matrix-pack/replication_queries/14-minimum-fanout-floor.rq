PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?consumer ?qualification (IF(?consumer < ?qualification, ?consumer, ?qualification) AS ?fanoutFloor) WHERE { ?candidate a clm:Candidate ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . }
ORDER BY DESC(?fanoutFloor) ?candidate
