PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reuse ?consumer ?qualification ?reversibility (?reuse * ?consumer * ?qualification * ?reversibility AS ?reversibleLeverage) WHERE { ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:reversibility ?reversibility ; clm:actuationPerformed false . }
ORDER BY DESC(?reversibleLeverage) ?candidate
