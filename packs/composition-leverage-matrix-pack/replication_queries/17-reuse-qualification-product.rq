PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reuse ?qualification (?reuse * ?qualification AS ?reuseQualification) WHERE { ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . }
ORDER BY DESC(?reuseQualification) ?candidate
