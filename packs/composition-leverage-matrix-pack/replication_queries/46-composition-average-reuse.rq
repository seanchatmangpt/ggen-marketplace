PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition (AVG(?reuse) AS ?averageReuse) WHERE { ?composition a clm:Composition ; clm:member ?member ; clm:qualified true . ?member a clm:Candidate ; clm:reusability ?reuse ; clm:actuationPerformed false . }
GROUP BY ?composition
ORDER BY DESC(?averageReuse) ?composition
