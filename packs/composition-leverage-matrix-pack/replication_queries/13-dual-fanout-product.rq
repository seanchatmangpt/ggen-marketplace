PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?consumer ?qualification (?consumer * ?qualification AS ?dualFanout) WHERE { ?candidate a clm:Candidate ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . }
ORDER BY DESC(?dualFanout) ?candidate
