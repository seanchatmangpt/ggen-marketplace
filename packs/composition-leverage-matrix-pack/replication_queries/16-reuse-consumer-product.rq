PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reuse ?consumer (?reuse * ?consumer AS ?reuseConsumer) WHERE { ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:actuationPerformed false . }
ORDER BY DESC(?reuseConsumer) ?candidate
