PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?consumer ?qualification (ABS(?consumer - ?qualification) AS ?imbalance) WHERE {
  ?candidate a clm:Candidate ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false .
}
ORDER BY ?imbalance DESC(?consumer) DESC(?qualification) ?candidate
