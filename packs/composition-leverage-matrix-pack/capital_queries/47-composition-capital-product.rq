PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition (SUM(?reuse * ?consumer * ?qualification * ?reversibility) AS ?capitalProduct) WHERE { ?composition a clm:Composition ; clm:member ?candidate ; clm:qualified true . ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:reversibility ?reversibility ; clm:actuationPerformed false . }
GROUP BY ?composition
ORDER BY DESC(?capitalProduct) ?composition
