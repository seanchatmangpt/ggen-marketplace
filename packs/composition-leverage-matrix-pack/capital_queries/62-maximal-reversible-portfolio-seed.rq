PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reuse ?consumer ?qualification ?reversibility (?reuse * ?consumer * ?qualification * ?reversibility AS ?capital) WHERE { ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:reversibility ?reversibility ; clm:actuationPerformed false . FILTER(?reversibility = 1.0) }
ORDER BY DESC(?capital) DESC(?consumer) DESC(?qualification) ?candidate
