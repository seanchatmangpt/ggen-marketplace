PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reuse ?consumer ?qualification WHERE { ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . FILTER(?reuse >= 0.8 && ?consumer >= 4 && ?qualification >= 3) }
ORDER BY DESC(?reuse) DESC(?consumer) DESC(?qualification) ?candidate
