PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reuse ?reversibility WHERE { ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:reversibility ?reversibility ; clm:actuationPerformed false . FILTER(?reversibility = 1.0 && ?reuse >= 0.8) }
ORDER BY DESC(?reuse) ?candidate
