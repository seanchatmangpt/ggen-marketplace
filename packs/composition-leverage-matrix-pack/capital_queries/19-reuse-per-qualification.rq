PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reuse ?qualification (?reuse / ?qualification AS ?reusePerQualification) WHERE { ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . FILTER(?qualification > 0) }
ORDER BY DESC(?reusePerQualification) ?candidate
