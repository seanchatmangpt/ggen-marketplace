PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reuse ?consumer ?qualification ?reversibility WHERE { ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:reversibility ?reversibility ; clm:actuationPerformed false . FILTER(?reuse >= 0.8 && ?consumer >= 3 && ?qualification >= 3 && ?reversibility >= 0.8) }
ORDER BY DESC(?reuse) DESC(?consumer) DESC(?qualification) DESC(?reversibility) ?candidate
