PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition ?order (SUM(?reuse * ?consumer * ?qualification * ?reversibility) / ?order AS ?capitalPerOrder) WHERE { ?composition a clm:Composition ; clm:order ?order ; clm:member ?candidate ; clm:qualified true . ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:reversibility ?reversibility ; clm:actuationPerformed false . FILTER(?order > 0) }
GROUP BY ?composition ?order
ORDER BY DESC(?capitalPerOrder) ?composition
