PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reuse ?consumer ?qualification WHERE { ?candidate a clm:Candidate ; clm:authority "SELECT" ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . }
ORDER BY DESC(?reuse) DESC(?consumer) DESC(?qualification) ?candidate
