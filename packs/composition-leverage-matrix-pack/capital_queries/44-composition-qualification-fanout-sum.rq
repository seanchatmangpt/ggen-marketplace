PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition (SUM(?fanout) AS ?qualificationFanoutSum) WHERE { ?composition a clm:Composition ; clm:member ?candidate ; clm:qualified true . ?candidate a clm:Candidate ; clm:qualificationFanout ?fanout ; clm:actuationPerformed false . }
GROUP BY ?composition
ORDER BY DESC(?qualificationFanoutSum) ?composition
