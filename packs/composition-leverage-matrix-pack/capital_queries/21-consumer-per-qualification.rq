PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?consumer ?qualification (?consumer / ?qualification AS ?consumerPerQualification) WHERE { ?candidate a clm:Candidate ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . FILTER(?qualification > 0) }
ORDER BY DESC(?consumerPerQualification) ?candidate
