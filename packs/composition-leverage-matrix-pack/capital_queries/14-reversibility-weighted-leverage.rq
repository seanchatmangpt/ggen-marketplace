PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reversibility ?reuse ?consumer ?qualification (?reversibility * ?reuse * ?consumer * ?qualification AS ?score) WHERE {
  ?candidate a clm:Candidate ; clm:reversibility ?reversibility ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false .
}
ORDER BY DESC(?score) ?candidate
