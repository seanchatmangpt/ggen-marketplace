PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition ?candidate ?leverage ?reuse ?consumer ?qualification WHERE { ?composition a clm:Composition ; clm:member ?candidate ; clm:expectedLeverage ?leverage ; clm:qualified true . ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . }
ORDER BY DESC(?leverage) DESC(?reuse) ?composition ?candidate
