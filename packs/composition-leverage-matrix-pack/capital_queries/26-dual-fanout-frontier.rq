PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?consumer ?qualification WHERE { ?candidate a clm:Candidate ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . FILTER(?consumer >= 4 && ?qualification >= 3) }
ORDER BY DESC(?consumer) DESC(?qualification) ?candidate
