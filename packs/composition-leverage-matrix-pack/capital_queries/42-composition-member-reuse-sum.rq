PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition (SUM(?reuse) AS ?reuseSum) WHERE { ?composition a clm:Composition ; clm:member ?candidate ; clm:qualified true . ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:actuationPerformed false . }
GROUP BY ?composition
ORDER BY DESC(?reuseSum) ?composition
