PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition (SUM(?fanout) AS ?consumerFanoutSum) WHERE { ?composition a clm:Composition ; clm:member ?candidate ; clm:qualified true . ?candidate a clm:Candidate ; clm:consumerFanout ?fanout ; clm:actuationPerformed false . }
GROUP BY ?composition
ORDER BY DESC(?consumerFanoutSum) ?composition
