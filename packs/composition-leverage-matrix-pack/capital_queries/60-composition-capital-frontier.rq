PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition ?leverage (SUM(?reuse * ?consumer * ?qualification * ?reversibility) AS ?memberCapital) WHERE { ?composition a clm:Composition ; clm:member ?candidate ; clm:expectedLeverage ?leverage ; clm:qualified true . ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:reversibility ?reversibility ; clm:actuationPerformed false . }
GROUP BY ?composition ?leverage
ORDER BY DESC(?leverage) DESC(?memberCapital) ?composition
