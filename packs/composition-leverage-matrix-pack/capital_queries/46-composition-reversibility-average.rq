PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?composition (AVG(?reversibility) AS ?avgReversibility) WHERE { ?composition a clm:Composition ; clm:member ?candidate ; clm:qualified true . ?candidate a clm:Candidate ; clm:reversibility ?reversibility ; clm:actuationPerformed false . }
GROUP BY ?composition
ORDER BY DESC(?avgReversibility) ?composition
