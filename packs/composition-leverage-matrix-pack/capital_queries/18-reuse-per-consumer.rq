PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?reuse ?consumer (?reuse / ?consumer AS ?reusePerConsumer) WHERE { ?candidate a clm:Candidate ; clm:reusability ?reuse ; clm:consumerFanout ?consumer ; clm:actuationPerformed false . FILTER(?consumer > 0) }
ORDER BY DESC(?reusePerConsumer) ?candidate
