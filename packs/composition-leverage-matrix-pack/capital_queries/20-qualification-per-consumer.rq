PREFIX clm: <https://ggen.dev/ontology/composition-leverage-matrix#>
SELECT ?candidate ?consumer ?qualification (?qualification / ?consumer AS ?qualificationPerConsumer) WHERE { ?candidate a clm:Candidate ; clm:consumerFanout ?consumer ; clm:qualificationFanout ?qualification ; clm:actuationPerformed false . FILTER(?consumer > 0) }
ORDER BY DESC(?qualificationPerConsumer) ?candidate
