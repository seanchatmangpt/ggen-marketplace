@prefix r84: <https://ggen.dev/ontology/ash-reactor-domain-error-contract#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

r84:DomainRefusal a skos:Concept ; skos:prefLabel "Typed domain refusal" .
r84:ReactorEnvelope a skos:Concept ; skos:prefLabel "Reactor execution envelope" .
r84:BoundaryNormalization a skos:Concept ; skos:prefLabel "Boundary normalization" .
r84:ConsumerContract a skos:Concept ; skos:prefLabel "Consumer error contract" .

r84:xaas-idempotency-conflict a r84:DomainRefusal ;
  prov:wasDerivedFrom <https://github.com/seanchatmangpt/xaas/pull/32> ;
  r84:domainShape "{:idempotency_conflict, key}" ;
  r84:observedEnvelope "Reactor.Error.Invalid.RunStepError" .

r84:preservesDomainRefusal a rdf:Property .
r84:domainShape a rdf:Property .
r84:observedEnvelope a rdf:Property .
r84:consumer a rdf:Property .
