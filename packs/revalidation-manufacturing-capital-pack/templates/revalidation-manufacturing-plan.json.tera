{
  "schema": "ggen.revalidation-manufacturing-capital/1",
  "authority": "SELECT|CONSTRUCT|VERIFY",
  "consequential_do": false,
  "targets": [
  {% for row in results %}{"repository":"{{ row.repo }}","exact_subject":"{{ row.subject }}","standing":"{{ row.standing }}","requires_revalidation":{{ row.revalidate }},"priority":{{ row.priority }},"expected_yield":{{ row.yield }},"dependency_unlocks":{{ row.dep }},"composition_unlocks":{{ row.comp }},"consumer_fanout":{{ row.fanout }},"future_capacity":{{ row.capacity }}}{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
