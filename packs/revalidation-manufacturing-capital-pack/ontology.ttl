@prefix rmc: <https://w3id.org/dfcm/revalidation-manufacturing#> .
@prefix mem: <https://w3id.org/dfcm/memory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

rmc:RevalidationCandidate a prov:Entity .
rmc:RevalidationDecision a prov:Activity .
rmc:ManufacturingPlan a prov:Plan .
rmc:QualificationRequirement a dqv:QualityMeasurement .
rmc:ConsumerTarget a prov:Entity .
rmc:CapitalEstimate a dqv:QualityMeasurement .
rmc:sourceMemory a rdf:Property .
rmc:exactSubject a rdf:Property .
rmc:observedHead a rdf:Property .
rmc:liveHead a rdf:Property .
rmc:standing a rdf:Property .
rmc:requiresRevalidation a rdf:Property .
rmc:revalidationReason a rdf:Property .
rmc:priority a rdf:Property .
rmc:reversible a rdf:Property .
rmc:authorityCost a rdf:Property .
rmc:dependencyUnlockCount a rdf:Property .
rmc:compositionUnlockCount a rdf:Property .
rmc:consumerFanout a rdf:Property .
rmc:expectedYield a rdf:Property .
rmc:informationGain a rdf:Property .
rmc:futureManufacturingCapacity a rdf:Property .
rmc:selected a rdf:Property .
rmc:targetRepo a rdf:Property .
rmc:receiptRequired a rdf:Property .
rmc:replayRequired a rdf:Property .
rmc:falsifierRequired a rdf:Property .
rmc:deterministicManufacture a rdf:Property .
rmc:qualificationRequired a rdf:Property .
rmc:consequentialDo a rdf:Property .
rmc:planFor a rdf:Property .
rmc:nextAction a rdf:Property .
rmc:preserveOption a rdf:Property .
rmc:correlationRisk a rdf:Property .
rmc:memoryMultiplier a rdf:Property .
rmc:yieldMultiplier a rdf:Property .

rmc:authorityPolicy a odrl:Policy ;
  odrl:permission [ odrl:action odrl:read, odrl:derive ] ;
  odrl:prohibition [ odrl:action odrl:execute ] ;
  rmc:consequentialDo false .
