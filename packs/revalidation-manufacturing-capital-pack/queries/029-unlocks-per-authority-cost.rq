PREFIX rmc: <https://w3id.org/dfcm/revalidation-manufacturing#>
SELECT ?candidate ((?dep + ?comp) / ?cost AS ?ratio) WHERE {
  ?candidate a rmc:RevalidationCandidate ; rmc:dependencyUnlockCount ?dep ; rmc:compositionUnlockCount ?comp ; rmc:authorityCost ?cost . FILTER(?cost > 0)
}
ORDER BY DESC(?ratio) ?candidate
