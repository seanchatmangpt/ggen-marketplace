PREFIX rmc: <https://w3id.org/dfcm/revalidation-manufacturing#>
SELECT ?candidate ?repo ?priority ?yield WHERE {
  ?candidate a rmc:RevalidationCandidate ; rmc:targetRepo ?repo ; rmc:priority ?priority ; rmc:expectedYield ?yield ;
    rmc:reversible true ; rmc:receiptRequired true ; rmc:replayRequired true ; rmc:falsifierRequired true ;
    rmc:deterministicManufacture true ; rmc:qualificationRequired true ; rmc:consequentialDo false .
}
ORDER BY DESC(?priority) DESC(?yield) ?repo
