PREFIX rmc: <https://w3id.org/dfcm/revalidation-manufacturing#>
SELECT ?candidate ?repo ?yield ?dep ?comp ?capacity WHERE {
  ?candidate a rmc:RevalidationCandidate ; rmc:selected true ; rmc:targetRepo ?repo ; rmc:expectedYield ?yield ;
    rmc:dependencyUnlockCount ?dep ; rmc:compositionUnlockCount ?comp ; rmc:futureManufacturingCapacity ?capacity ;
    rmc:reversible true ; rmc:correlationRisk 1 ; rmc:receiptRequired true ; rmc:replayRequired true ;
    rmc:falsifierRequired true ; rmc:deterministicManufacture true ; rmc:qualificationRequired true ; rmc:consequentialDo false .
}
ORDER BY DESC(?yield) DESC(?capacity) DESC(?dep) DESC(?comp) ?repo
