PREFIX rmc: <https://w3id.org/dfcm/revalidation-manufacturing#>
SELECT ?candidate (?yield + ?dep + ?comp + ?info + ?capacity - ?cost AS ?score) WHERE {
  ?candidate a rmc:RevalidationCandidate ; rmc:expectedYield ?yield ; rmc:dependencyUnlockCount ?dep ; rmc:compositionUnlockCount ?comp ; rmc:informationGain ?info ; rmc:futureManufacturingCapacity ?capacity ; rmc:authorityCost ?cost .
}
ORDER BY DESC(?score) ?candidate
