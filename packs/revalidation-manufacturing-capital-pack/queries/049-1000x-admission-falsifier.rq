PREFIX rmc: <https://w3id.org/dfcm/revalidation-manufacturing#>
SELECT (COUNT(?candidate) AS ?independentConsumers) (MAX(?fanout) AS ?reuseFactor) (MAX(?composition) AS ?compositionFactor) WHERE {
  ?candidate a rmc:RevalidationCandidate ; rmc:selected true ; rmc:correlationRisk 1 ; rmc:consumerFanout ?fanout ; rmc:compositionUnlockCount ?composition ; rmc:consequentialDo false .
}
HAVING(COUNT(?candidate) < 10 || MAX(?fanout) < 10 || MAX(?composition) < 10)
