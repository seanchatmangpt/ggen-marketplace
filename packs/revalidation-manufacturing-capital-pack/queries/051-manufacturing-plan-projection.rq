PREFIX rmc: <https://w3id.org/dfcm/revalidation-manufacturing#>
SELECT ?repo ?subject ?standing ?revalidate ?priority ?yield ?dep ?comp ?fanout ?capacity WHERE {
  ?candidate a rmc:RevalidationCandidate ; rmc:selected true ; rmc:targetRepo ?repo ; rmc:exactSubject ?subject ;
    rmc:standing ?standing ; rmc:requiresRevalidation ?revalidate ; rmc:priority ?priority ; rmc:expectedYield ?yield ;
    rmc:dependencyUnlockCount ?dep ; rmc:compositionUnlockCount ?comp ; rmc:consumerFanout ?fanout ;
    rmc:futureManufacturingCapacity ?capacity ; rmc:reversible true ; rmc:receiptRequired true ; rmc:replayRequired true ;
    rmc:falsifierRequired true ; rmc:deterministicManufacture true ; rmc:qualificationRequired true ; rmc:consequentialDo false .
}
ORDER BY DESC(?priority) DESC(?yield) ?repo
