@prefix cs: <urn:xaas:case-study:> .
@prefix glc: <https://ggen.dev/ontology/greene-licensing-case#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix min: <urn:example:greene-licensing-case:minimal:> .

# FAIL witness for 050_no_endorsement_language -- violates EXACTLY this
# gate: the letter section claims the software is endorsed by the author.
# The quoted-text and letter-author gates return zero rows.

min:user a glc:User ;
  glc:displayName "Example User" ;
  glc:signatureRole "Sender and author of this proposal draft" .

min:letter a glc:Letter ;
  glc:sender min:user ;
  glc:addressee "Example rights holder" ;
  glc:letterSubject "Proposal draft for a minimal witness" ;
  glc:letterStatus "PROPOSAL_DRAFT" ;
  glc:letterDate "2026-09-26"^^xsd:date ;
  glc:maxPages 2 .

min:s1 a glc:LetterSection ; glc:sectionOf min:letter ; glc:order 1 ;
  glc:heading "Purpose" ;
  glc:body "I propose a licensing conversation about software that is endorsed by the author of the book." .

min:digest a glc:ReceiptDigest ; glc:order 1 ; glc:digestOf min:evidence ;
  glc:digestKind "report.json file sha256" ;
  glc:sha256 "9f1d3a03188430dde6c8fad00c63714daff73aa3600229d9f521ec41e2edc6d4" .

min:rights a glc:RightsItem ; glc:rightsId "R01" ; glc:order 1 ;
  glc:item "Title as a public name" ; glc:heldNow "None" ;
  glc:requested "Non-exclusive use" ; glc:fallbackIfDeclined "Use a generic name" .

min:nc a cs:NonClaim ; cs:nonClaimId "NC02" ;
  cs:nonClaimLabel "No affiliation implied with any author, publisher or rights holder." .
