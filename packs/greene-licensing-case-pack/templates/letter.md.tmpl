---
to: greene-licensing/letter.md
sparql:
  letter: |
    PREFIX glc: <https://ggen.dev/ontology/greene-licensing-case#>
    SELECT ?addressee ?subject ?status ?date ?maxPages ?senderName ?senderRole WHERE {
      ?letter a glc:Letter ; glc:addressee ?addressee ; glc:letterSubject ?subject ;
              glc:letterStatus ?status ; glc:letterDate ?date ; glc:maxPages ?maxPages ;
              glc:sender ?sender .
      ?sender a glc:User ; glc:displayName ?senderName ; glc:signatureRole ?senderRole .
    } ORDER BY ?subject
  sections: |
    PREFIX glc: <https://ggen.dev/ontology/greene-licensing-case#>
    SELECT ?order ?heading ?body WHERE {
      ?section a glc:LetterSection ; glc:order ?order ; glc:heading ?heading ; glc:body ?body .
    } ORDER BY ?order
---
{% for l in letter %}# {{ l.subject }}

Status: {{ l.status }} (not sent). Date: {{ l.date }}. Length limit: {{ l.maxPages }} pages.

To: {{ l.addressee }}

From: {{ l.senderName }}

{% for s in sections %}## {{ s.heading }}

{{ s.body }}

{% endfor %}Sincerely,

{{ l.senderName }}

{{ l.senderRole }}

Enclosures: rights table, evidence appendix, demo spec, deck.
{% endfor %}
