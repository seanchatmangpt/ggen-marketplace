---
to: greene-licensing/rights-table.md
sparql:
  rights: |
    PREFIX glc: <https://ggen.dev/ontology/greene-licensing-case#>
    SELECT ?order ?rightsId ?item ?heldNow ?requested ?fallback WHERE {
      ?r a glc:RightsItem ; glc:order ?order ; glc:rightsId ?rightsId ; glc:item ?item ;
         glc:heldNow ?heldNow ; glc:requested ?requested ; glc:fallbackIfDeclined ?fallback .
    } ORDER BY ?order
  nonclaims: |
    PREFIX cs: <urn:xaas:case-study:>
    PREFIX glc: <https://ggen.dev/ontology/greene-licensing-case#>
    SELECT ?nonClaimId ?nonClaimLabel WHERE {
      ?letter a glc:Letter ; glc:letterOf ?case .
      ?nc a cs:NonClaim ; cs:nonClaimOf ?case ; cs:nonClaimId ?nonClaimId ; cs:nonClaimLabel ?nonClaimLabel .
    } ORDER BY ?nonClaimId
---
