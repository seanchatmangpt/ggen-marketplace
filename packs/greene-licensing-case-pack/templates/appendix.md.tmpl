---
to: greene-licensing/appendix.md
sparql:
  cases: |
    PREFIX cs: <urn:xaas:case-study:>
    PREFIX glc: <https://ggen.dev/ontology/greene-licensing-case#>
    SELECT ?caseId ?boundSubject ?authorityCeiling ?evidenceCeiling ?humanGate WHERE {
      ?case a cs:CaseStudy ; cs:caseId ?caseId ; cs:boundSubject ?boundSubject ;
            cs:authorityCeiling ?authorityCeiling ; cs:evidenceCeiling ?evidenceCeiling ;
            cs:humanGate ?humanGate .
      ?letter a glc:Letter ; glc:letterOf ?case .
    } ORDER BY ?caseId
  claims: |
    PREFIX cs: <urn:xaas:case-study:>
    PREFIX glc: <https://ggen.dev/ontology/greene-licensing-case#>
    SELECT ?claimId ?claimText ?standing ?evidenceCeiling ?authorityCeiling ?evidenceId ?evidencePath ?exactSubject ?result ?falsifierId WHERE {
      ?letter a glc:Letter ; glc:letterOf ?case .
      ?claim a cs:Claim ; cs:claimOf ?case ; cs:claimId ?claimId ; cs:claimText ?claimText ; cs:standing ?standing ;
             cs:evidenceCeiling ?evidenceCeiling ; cs:authorityCeiling ?authorityCeiling ;
             cs:supportedBy ?evidence ; cs:falsifiedBy ?falsifier .
      ?evidence cs:evidenceId ?evidenceId ; cs:evidencePath ?evidencePath ;
                cs:exactSubject ?exactSubject ; cs:result ?result .
      ?falsifier cs:falsifierId ?falsifierId .
    } ORDER BY ?claimId
  digests: |
    PREFIX cs: <urn:xaas:case-study:>
    PREFIX glc: <https://ggen.dev/ontology/greene-licensing-case#>
    SELECT ?order ?digestKind ?sha256 ?evidenceId WHERE {
      ?d a glc:ReceiptDigest ; glc:order ?order ; glc:digestKind ?digestKind ; glc:sha256 ?sha256 ;
         glc:digestOf ?evidence .
      ?evidence cs:evidenceId ?evidenceId .
    } ORDER BY ?order
  replays: |
    PREFIX glc: <https://ggen.dev/ontology/greene-licensing-case#>
    SELECT ?order ?command ?expectedObservation WHERE {
      ?r a glc:ReplayCommand ; glc:order ?order ; glc:command ?command ;
         glc:expectedObservation ?expectedObservation .
    } ORDER BY ?order
  falsifiers: |
    PREFIX cs: <urn:xaas:case-study:>
    PREFIX glc: <https://ggen.dev/ontology/greene-licensing-case#>
    SELECT DISTINCT ?falsifierId ?falsifierCommand ?falsifierObservation WHERE {
      ?letter a glc:Letter ; glc:letterOf ?case .
      ?claim a cs:Claim ; cs:claimOf ?case ; cs:falsifiedBy ?f .
      ?f a cs:Falsifier ; cs:falsifierId ?falsifierId ; cs:falsifierCommand ?falsifierCommand ;
         cs:falsifierObservation ?falsifierObservation .
    } ORDER BY ?falsifierId
---
