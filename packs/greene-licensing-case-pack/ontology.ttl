@prefix glc: <https://ggen.dev/ontology/greene-licensing-case#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Vocabulary for the licensing proposal packet (glc:). The case itself is a
# canonical Semantic Case Study: claims, evidence, falsifiers and non-claims
# are cs: nodes (semantic-case-study-pack, urn:xaas:case-study:) and the deck
# is pres: nodes (pptx-presentation-pack). This file adds only the packet
# artifacts the cs: layer does not model: the letter, its sections, the
# rights table, the receipt digests, the replay commands and the demo steps.
#
# Instances: ontology/greene-case.ttl (case, letter, rights, appendix, demo)
# and ontology/greene-deck.ttl (the 10-slide deck). The cs -> pres bridge is
# ontology/cs-pres-bridge.ttl. Shapes: ontology/shapes.ttl.
#
# Boundary (enforced by gates/050, 060, 070 rather than by prose): the
# packet is a PROPOSAL_DRAFT authored and signed by the user as sender; it is
# never sent by any tool; it carries no source text; it asserts no
# affiliation or support by any author, publisher or rights holder.

glc:User a rdfs:Class ;
  rdfs:label "User" ;
  rdfs:comment "The human author of the packet. The only admissible letter sender." .

glc:Letter a rdfs:Class ;
  rdfs:label "Proposal letter" ;
  rdfs:comment "A proposal letter draft of at most two pages, signed by its sender." .

glc:LetterSection a rdfs:Class ;
  rdfs:label "Letter section" ;
  rdfs:comment "One ordered section of a proposal letter, own composition only." .

glc:RightsItem a rdfs:Class ;
  rdfs:label "Rights item" ;
  rdfs:comment "One row of the rights table: what is requested, what is held now, and the fallback if declined." .

glc:ReceiptDigest a rdfs:Class ;
  rdfs:label "Receipt digest" ;
  rdfs:comment "A sha256 digest recomputed from a run output, bound to the evidence node it supports." .

glc:ReplayCommand a rdfs:Class ;
  rdfs:label "Replay command" ;
  rdfs:comment "A command that recomputes a receipt digest from the exact subject." .

glc:DemoStep a rdfs:Class ;
  rdfs:label "Demo step" ;
  rdfs:comment "One ordered step of the live demonstration with its expected observation." .

glc:sender a rdf:Property ; rdfs:domain glc:Letter ; rdfs:range glc:User .
glc:addressee a rdf:Property ; rdfs:domain glc:Letter ; rdfs:range xsd:string .
glc:letterStatus a rdf:Property ; rdfs:domain glc:Letter ; rdfs:range xsd:string .
glc:letterSubject a rdf:Property ; rdfs:domain glc:Letter ; rdfs:range xsd:string .
glc:letterDate a rdf:Property ; rdfs:domain glc:Letter ; rdfs:range xsd:date .
glc:maxPages a rdf:Property ; rdfs:domain glc:Letter ; rdfs:range xsd:integer .
glc:letterOf a rdf:Property ; rdfs:domain glc:Letter .
glc:sentOn a rdf:Property ;
  rdfs:comment "Declared only so gate 070 can refuse it: a packet letter is never sent." .

glc:sectionOf a rdf:Property ; rdfs:domain glc:LetterSection ; rdfs:range glc:Letter .
glc:order a rdf:Property ; rdfs:range xsd:integer .
glc:heading a rdf:Property ; rdfs:range xsd:string .
glc:body a rdf:Property ; rdfs:range xsd:string .

glc:displayName a rdf:Property ; rdfs:domain glc:User ; rdfs:range xsd:string .
glc:signatureRole a rdf:Property ; rdfs:domain glc:User ; rdfs:range xsd:string .

glc:rightsItemOf a rdf:Property ; rdfs:domain glc:RightsItem .
glc:rightsId a rdf:Property ; rdfs:domain glc:RightsItem ; rdfs:range xsd:string .
glc:item a rdf:Property ; rdfs:domain glc:RightsItem ; rdfs:range xsd:string .
glc:heldNow a rdf:Property ; rdfs:domain glc:RightsItem ; rdfs:range xsd:string .
glc:requested a rdf:Property ; rdfs:domain glc:RightsItem ; rdfs:range xsd:string .
glc:fallbackIfDeclined a rdf:Property ; rdfs:domain glc:RightsItem ; rdfs:range xsd:string .

glc:digestOf a rdf:Property ; rdfs:domain glc:ReceiptDigest .
glc:digestKind a rdf:Property ; rdfs:domain glc:ReceiptDigest ; rdfs:range xsd:string .
glc:sha256 a rdf:Property ; rdfs:domain glc:ReceiptDigest ; rdfs:range xsd:string .

glc:replayOf a rdf:Property ; rdfs:domain glc:ReplayCommand .
glc:command a rdf:Property ; rdfs:range xsd:string .
glc:expectedObservation a rdf:Property ; rdfs:range xsd:string .

glc:demoStepOf a rdf:Property ; rdfs:domain glc:DemoStep .
glc:quotedText a rdf:Property ;
  rdfs:comment "Declared only so gate 060 can refuse it: no source text is carried." .
