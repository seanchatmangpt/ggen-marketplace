@prefix cs: <urn:xaas:case-study:> .
@prefix glc: <https://ggen.dev/ontology/greene-licensing-case#> .
@prefix gdeck: <https://ggen.dev/ontology/greene-licensing-case/deck#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Licensing proposal packet as a canonical Semantic Case Study.
#
# Exact subjects:
#   seanchatmangpt/autofde-lab@d6becb595aedac4f18cab84f80bf5aa90e1a45e4
#     (branch feat/doctrine-lab; the doctrine lab)
#   seanchatmangpt/ggen-marketplace@c0f27e5bed97b164ac267f86d8d9d989982319e8
#     (branch feat/strategic-doctrine-pack; the sd: catalog projection)
#
# Every digest below was recomputed from a run of the lab at the exact
# autofde-lab commit (defaults: seeds 2030 2031, first 9 worlds, 3 rounds,
# --replay), and the report.json / ledger.jsonl sha256 values were
# reproduced byte for byte by a second, separate process. Evidence ceiling
# REPO_LOCAL_FIXTURE; authority ceiling NONE on the case and every claim.
#
# All prose literals are the user's own composition. No text of the source
# work appears in this file; the work is named by its title only.

# ---------------------------------------------------------------- case

glc:case a cs:CaseStudy ;
  cs:caseId "greene-licensing-case" ;
  cs:title "Licensing proposal draft: executable strategic-doctrine lab" ;
  cs:boundSubject "seanchatmangpt/autofde-lab@d6becb595aedac4f18cab84f80bf5aa90e1a45e4" ;
  cs:authorityCeiling "NONE" ;
  cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ;
  cs:humanGate "USER_REVIEW_REQUIRED_NOTHING_SENT" ;
  cs:currentConformance "REPO_LOCAL_FIXTURE" .

# ---------------------------------------------------------------- claims

glc:c01 a cs:Claim ; cs:claimId "C01" ; cs:claimOf glc:case ;
  cs:claimText "At the bound commit the doctrine lab ran 252 episodes over 9 worlds and 2 seeds and sealed a 252-record ledger." ;
  cs:standing "ALIVE_FIXTURE" ;
  cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "NONE" ;
  cs:supportedBy glc:e01 ; cs:falsifiedBy glc:f01 ;
  cs:renderedBy gdeck:deck , gdeck:slide-04 .

glc:c02 a cs:Claim ; cs:claimId "C02" ; cs:claimOf glc:case ;
  cs:claimText "A second, separate process reproduces report.json and ledger.jsonl byte for byte." ;
  cs:standing "ALIVE_FIXTURE" ;
  cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "NONE" ;
  cs:supportedBy glc:e02 ; cs:falsifiedBy glc:f02 ;
  cs:renderedBy gdeck:deck , gdeck:slide-05 .

glc:c03 a cs:Claim ; cs:claimId "C03" ; cs:claimOf glc:case ;
  cs:claimText "verify_run with replay re-executes the run and reports it valid with zero failures." ;
  cs:standing "ALIVE_FIXTURE" ;
  cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "NONE" ;
  cs:supportedBy glc:e03 ; cs:falsifiedBy glc:f03 ;
  cs:renderedBy gdeck:deck , gdeck:slide-04 .

glc:c04 a cs:Claim ; cs:claimId "C04" ; cs:claimOf glc:case ;
  cs:claimText "In this model, two pairs of distinct doctrine compositions produced behaviourally identical policies." ;
  cs:standing "ALIVE_FIXTURE" ;
  cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "NONE" ;
  cs:supportedBy glc:e04 ; cs:falsifiedBy glc:f04 ;
  cs:renderedBy gdeck:deck , gdeck:slide-06 .

glc:c05 a cs:Claim ; cs:claimId "C05" ; cs:claimOf glc:case ;
  cs:claimText "The strategic-doctrine catalog projection carries a licensing non-claim and is gated against excerpts." ;
  cs:standing "ALIVE_FIXTURE" ;
  cs:evidenceCeiling "REPO_LOCAL_FIXTURE" ; cs:authorityCeiling "NONE" ;
  cs:supportedBy glc:e05 ; cs:falsifiedBy glc:f05 ;
  cs:renderedBy gdeck:deck , gdeck:slide-02 .

# ---------------------------------------------------------------- evidence

glc:e01 a cs:Evidence ; cs:evidenceId "E01" ;
  cs:evidencePath "src/autofde_lab/simulation/doctrine_lab/seal.py" ;
  cs:exactSubject "seanchatmangpt/autofde-lab@d6becb595aedac4f18cab84f80bf5aa90e1a45e4" ;
  cs:validator "python -m autofde_lab.simulation.doctrine_lab --out run --replay" ;
  cs:result "ledger valid true; records 252; episode_count 252; world_count 9; key_kind fixture" .

glc:e02 a cs:Evidence ; cs:evidenceId "E02" ;
  cs:evidencePath "src/autofde_lab/simulation/doctrine_lab/report.py" ;
  cs:exactSubject "seanchatmangpt/autofde-lab@d6becb595aedac4f18cab84f80bf5aa90e1a45e4" ;
  cs:validator "shasum -a 256 run/report.json run/ledger.jsonl (two processes)" ;
  cs:result "report.json and ledger.jsonl sha256 identical across two processes" .

glc:e03 a cs:Evidence ; cs:evidenceId "E03" ;
  cs:evidencePath "src/autofde_lab/simulation/doctrine_lab/verify.py" ;
  cs:exactSubject "seanchatmangpt/autofde-lab@d6becb595aedac4f18cab84f80bf5aa90e1a45e4" ;
  cs:validator "python -m autofde_lab.simulation.doctrine_lab --out run --replay" ;
  cs:result "verify_run valid true; replayed true; failures empty; authority NONE" .

glc:e04 a cs:Evidence ; cs:evidenceId "E04" ;
  cs:evidencePath "src/autofde_lab/simulation/doctrine_lab/relations.py" ;
  cs:exactSubject "seanchatmangpt/autofde-lab@d6becb595aedac4f18cab84f80bf5aa90e1a45e4" ;
  cs:validator "python -m autofde_lab.simulation.doctrine_lab --out run --replay" ;
  cs:result "primitive_equivalence_clusters 2 (sd-13 with sd-14; sd-01 with sd-12)" .

glc:e05 a cs:Evidence ; cs:evidenceId "E05" ;
  cs:evidencePath "packs/strategic-doctrine-pack/generated/catalog.json" ;
  cs:exactSubject "seanchatmangpt/ggen-marketplace@c0f27e5bed97b164ac267f86d8d9d989982319e8" ;
  cs:validator "git show COMMIT:packs/strategic-doctrine-pack/generated/catalog.json | shasum -a 256" ;
  cs:result "catalog projection sha256 recomputed at the bound commit" .

# ---------------------------------------------------------------- digests

glc:d-ledger-tail a glc:ReceiptDigest ; glc:order 1 ;
  glc:digestOf glc:e01 ; glc:digestKind "ledger tail digest" ;
  glc:sha256 "f10e2294dbd5c6d7ee1c8b97b3af36fcb706326e6a6dc7ed88f5c8db441c8665" .

glc:d-report-json a glc:ReceiptDigest ; glc:order 2 ;
  glc:digestOf glc:e02 ; glc:digestKind "report.json file sha256" ;
  glc:sha256 "9f1d03a3188430dde6c8fad00c63714daff73aa3600229d9f521ec41e2edc6d4" .

glc:d-ledger-jsonl a glc:ReceiptDigest ; glc:order 3 ;
  glc:digestOf glc:e02 ; glc:digestKind "ledger.jsonl file sha256" ;
  glc:sha256 "e5d42b8af2f25fe71f8f9bd18df245a5e2f1992b7e45c54ffdc60af5640e030b" .

glc:d-matrix a glc:ReceiptDigest ; glc:order 4 ;
  glc:digestOf glc:e03 ; glc:digestKind "matrix digest" ;
  glc:sha256 "762fab0feebe2109c4d1e1aef1618119a9e4f29ee5c425ad1931cb21af123ef7" .

glc:d-report a glc:ReceiptDigest ; glc:order 5 ;
  glc:digestOf glc:e03 ; glc:digestKind "report digest" ;
  glc:sha256 "5e4c530b1ef265d16401605972405399f6e0c9949ae11aaa4b7ee4a3c2371cf3" .

glc:d-catalog a glc:ReceiptDigest ; glc:order 6 ;
  glc:digestOf glc:e05 ; glc:digestKind "strategic-doctrine catalog.json sha256" ;
  glc:sha256 "d279700226af68fd41fa6223359000333c351bec8bf75ca8625ffebf3991af44" .

# ---------------------------------------------------------------- replay

glc:r1 a glc:ReplayCommand ; glc:order 1 ; glc:replayOf glc:case ;
  glc:command "git -C autofde-lab fetch origin feat/doctrine-lab && mkdir lab && git -C autofde-lab archive d6becb595aedac4f18cab84f80bf5aa90e1a45e4 -- src pyproject.toml | tar -x -C lab" ;
  glc:expectedObservation "lab/src holds the exact doctrine-lab tree" .

glc:r2 a glc:ReplayCommand ; glc:order 2 ; glc:replayOf glc:case ;
  glc:command "PYTHONPATH=lab/src python -m autofde_lab.simulation.doctrine_lab --out run --replay" ;
  glc:expectedObservation "exit 0; ledger valid true; verify_run valid true with no failures; digests as listed above" .

glc:r3 a glc:ReplayCommand ; glc:order 3 ; glc:replayOf glc:case ;
  glc:command "PYTHONPATH=lab/src python -m autofde_lab.simulation.doctrine_lab --out run2 && shasum -a 256 run/report.json run2/report.json run/ledger.jsonl run2/ledger.jsonl" ;
  glc:expectedObservation "report.json and ledger.jsonl hashes match between run and run2" .

glc:r4 a glc:ReplayCommand ; glc:order 4 ; glc:replayOf glc:case ;
  glc:command "git -C ggen-marketplace show c0f27e5bed97b164ac267f86d8d9d989982319e8:packs/strategic-doctrine-pack/generated/catalog.json | shasum -a 256" ;
  glc:expectedObservation "d279700226af68fd41fa6223359000333c351bec8bf75ca8625ffebf3991af44" .

# ---------------------------------------------------------------- falsifiers

glc:f01 a cs:Falsifier ; cs:falsifierId "F01" ;
  cs:falsifierCommand "PYTHONPATH=lab/src python -m autofde_lab.simulation.doctrine_lab --out run --replay" ;
  cs:falsifierObservation "The ledger tail digest differs from the listed value, the record count is not 252, or ledger valid is false." .

glc:f02 a cs:Falsifier ; cs:falsifierId "F02" ;
  cs:falsifierCommand "shasum -a 256 run/report.json run2/report.json run/ledger.jsonl run2/ledger.jsonl" ;
  cs:falsifierObservation "A second process yields a different sha256 for report.json or ledger.jsonl." .

glc:f03 a cs:Falsifier ; cs:falsifierId "F03" ;
  cs:falsifierCommand "PYTHONPATH=lab/src python -m autofde_lab.simulation.doctrine_lab --out run --replay" ;
  cs:falsifierObservation "verify_run reports valid false or lists any failure." .

glc:f04 a cs:Falsifier ; cs:falsifierId "F04" ;
  cs:falsifierCommand "python -m json.tool run/report.json | grep -c behaviourally_identical" ;
  cs:falsifierObservation "For the same seeds, worlds and rounds the report lists a cluster count other than 2." .

glc:f05 a cs:Falsifier ; cs:falsifierId "F05" ;
  cs:falsifierCommand "git -C ggen-marketplace show c0f27e5bed97b164ac267f86d8d9d989982319e8:packs/strategic-doctrine-pack/generated/catalog.json | shasum -a 256" ;
  cs:falsifierObservation "The catalog projection hashes to a different value, or its licensing non-claim is absent." .

# ---------------------------------------------------------------- non-claims

glc:nc01 a cs:NonClaim ; cs:nonClaimOf glc:case ; cs:nonClaimId "NC01" ;
  cs:nonClaimLabel "Not licensed: no license, permission or rights grant for the book or its title exists today." .

glc:nc02 a cs:NonClaim ; cs:nonClaimOf glc:case ; cs:nonClaimId "NC02" ;
  cs:nonClaimLabel "No affiliation implied: no author, publisher or rights holder has reviewed, supported or joined this work." .

glc:nc03 a cs:NonClaim ; cs:nonClaimOf glc:case ; cs:nonClaimId "NC03" ;
  cs:nonClaimLabel "No book excerpts: no text of the book appears; entries are ordinals with own short titles and own compositions." .

glc:nc04 a cs:NonClaim ; cs:nonClaimOf glc:case ; cs:nonClaimId "NC04" ;
  cs:nonClaimLabel "No real-world performance claims: all results are model-relative outputs of a repository-local fixture lab." .

glc:nc05 a cs:NonClaim ; cs:nonClaimOf glc:case ; cs:nonClaimId "NC05" ;
  cs:nonClaimLabel "Draft authored by the user: this packet is a proposal draft and has not been sent to anyone." .

# ---------------------------------------------------------------- letter

glc:user a glc:User ;
  glc:displayName "Sean Chatman" ;
  glc:signatureRole "Sender and author of this proposal draft" .

glc:letter a glc:Letter ;
  glc:letterOf glc:case ;
  glc:sender glc:user ;
  glc:addressee "The rights holder of The 33 Strategies of War (the author and his literary representatives)" ;
  glc:letterSubject "Proposal draft: licensing the title and ordinal structure of The 33 Strategies of War for an executable doctrine lab" ;
  glc:letterStatus "PROPOSAL_DRAFT" ;
  glc:letterDate "2026-09-26"^^xsd:date ;
  glc:maxPages 2 .

glc:s1 a glc:LetterSection ; glc:sectionOf glc:letter ; glc:order 1 ;
  glc:heading "Purpose" ;
  glc:body "I am writing to propose a licensing conversation about a software lab I built around the structure of The 33 Strategies of War. The lab is working software today, and I would like to name and index it after the book only if you agree to terms." .

glc:s2 a glc:LetterSection ; glc:sectionOf glc:letter ; glc:order 2 ;
  glc:heading "What exists" ;
  glc:body "The lab indexes 33 strategies by ordinal only. Each entry carries my own short paraphrased title (60 characters or fewer) and my own composition of 14 primitive operators: shape, probe, conceal, reveal, concentrate, disperse, delay, accelerate, commit, withdraw, divide, combine, substitute and transform. Six entries are operationalized as ordered steps with explicit falsifiers; the other 27 are stubs. No sentence of the book appears in the software, the deck or this letter." .

glc:s3 a glc:LetterSection ; glc:sectionOf glc:letter ; glc:order 3 ;
  glc:heading "What it does" ;
  glc:body "The lab runs each operationalized entry as a policy in simulated competitive worlds and records every episode in a hash-chained ledger. The run cited in the appendix covers 252 episodes over 9 worlds and 2 seeds, and a second process reproduces its report and ledger byte for byte. These are model-relative results from a repository-local fixture. They say nothing about outcomes in any real organization, market or conflict." .

glc:s4 a glc:LetterSection ; glc:sectionOf glc:letter ; glc:order 4 ;
  glc:heading "What I am asking for" ;
  glc:body "I am asking for permission to use the book title and its ordinal structure as the public name and index of the lab, on terms you set. The enclosed rights table lists each item, what I hold today (nothing), and what I will do if you decline it. I am not asking to quote the book, and I am not asking you to review, support or be associated with the software." .

glc:s5 a glc:LetterSection ; glc:sectionOf glc:letter ; glc:order 5 ;
  glc:heading "If you decline" ;
  glc:body "If you decline, I will rename the lab to a generic strategic-doctrine name, remove every ordinal mapping to the book, and keep only the primitive operator algebra, which is my own work. No further contact will follow unless you invite it." .

glc:s6 a glc:LetterSection ; glc:sectionOf glc:letter ; glc:order 6 ;
  glc:heading "Evidence" ;
  glc:body "The appendix lists the receipt digests and the commands that recompute them from an exact commit. All of it is repository-local evidence. The software reads data and constructs reports; it takes no action in the world." .

glc:s7 a glc:LetterSection ; glc:sectionOf glc:letter ; glc:order 7 ;
  glc:heading "Next step" ;
  glc:body "Thank you for considering this proposal. If it is of interest, I would welcome a short call to discuss scope and terms, and I can run the demonstration described in the enclosed demo spec." .

# ---------------------------------------------------------------- rights table

glc:rt01 a glc:RightsItem ; glc:rightsItemOf glc:case ; glc:rightsId "R01" ; glc:order 1 ;
  glc:item "Book title as the public name of the lab" ;
  glc:heldNow "None" ;
  glc:requested "Non-exclusive use of the title in the lab name and its documentation" ;
  glc:fallbackIfDeclined "Rename the lab to a generic strategic-doctrine name" .

glc:rt02 a glc:RightsItem ; glc:rightsItemOf glc:case ; glc:rightsId "R02" ; glc:order 2 ;
  glc:item "Ordinal structure (entries indexed 1 to 33)" ;
  glc:heldNow "None" ;
  glc:requested "Non-exclusive use of the ordinal index as the catalog key" ;
  glc:fallbackIfDeclined "Re-key the catalog by own identifiers and drop the ordinal mapping" .

glc:rt03 a glc:RightsItem ; glc:rightsItemOf glc:case ; glc:rightsId "R03" ; glc:order 3 ;
  glc:item "Author name in documentation and the deck" ;
  glc:heldNow "None" ;
  glc:requested "Factual attribution only, with a stated absence of affiliation" ;
  glc:fallbackIfDeclined "Remove the author name everywhere" .

glc:rt04 a glc:RightsItem ; glc:rightsItemOf glc:case ; glc:rightsId "R04" ; glc:order 4 ;
  glc:item "Commercial distribution under the licensed name" ;
  glc:heldNow "None" ;
  glc:requested "Terms set by the rights holder (fee, royalty or term limit)" ;
  glc:fallbackIfDeclined "Distribute only under the generic name" .

glc:rt05 a glc:RightsItem ; glc:rightsItemOf glc:case ; glc:rightsId "R05" ; glc:order 5 ;
  glc:item "Quotation of book text" ;
  glc:heldNow "None" ;
  glc:requested "Not requested" ;
  glc:fallbackIfDeclined "Not applicable: no book text is used in any case" .

# ---------------------------------------------------------------- demo

glc:demo1 a glc:DemoStep ; glc:demoStepOf glc:case ; glc:order 1 ;
  glc:heading "Materialize the exact lab commit" ;
  glc:command "git -C autofde-lab archive d6becb595aedac4f18cab84f80bf5aa90e1a45e4 -- src pyproject.toml | tar -x -C lab" ;
  glc:expectedObservation "The doctrine lab source tree at the bound commit, with no other checkout." .

glc:demo2 a glc:DemoStep ; glc:demoStepOf glc:case ; glc:order 2 ;
  glc:heading "Run the lab with replay" ;
  glc:command "PYTHONPATH=lab/src python -m autofde_lab.simulation.doctrine_lab --out run --replay" ;
  glc:expectedObservation "Exit 0; 252 episodes over 9 worlds; ledger valid; verify_run valid with no failures; authority NONE." .

glc:demo3 a glc:DemoStep ; glc:demoStepOf glc:case ; glc:order 3 ;
  glc:heading "Reproduce in a second process" ;
  glc:command "PYTHONPATH=lab/src python -m autofde_lab.simulation.doctrine_lab --out run2 && shasum -a 256 run/report.json run2/report.json" ;
  glc:expectedObservation "Both report.json files hash to 9f1d03a3188430dde6c8fad00c63714daff73aa3600229d9f521ec41e2edc6d4." .

glc:demo4 a glc:DemoStep ; glc:demoStepOf glc:case ; glc:order 4 ;
  glc:heading "Show the equivalence clusters" ;
  glc:command "python -m json.tool run/report.json" ;
  glc:expectedObservation "Two primitive-equivalence clusters: sd-13 with sd-14, and sd-01 with sd-12." .

glc:demo5 a glc:DemoStep ; glc:demoStepOf glc:case ; glc:order 5 ;
  glc:heading "Show the catalog boundary" ;
  glc:command "python3 -m pytest tests/test_strategic_doctrine_pack.py -q -k 'not_vacuous or every_gate_returns_zero_rows'" ;
  glc:expectedObservation "The no-excerpt and licensing non-claim gates pass on the catalog and fire on their mutants." .
