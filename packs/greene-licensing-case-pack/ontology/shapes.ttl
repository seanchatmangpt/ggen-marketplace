@prefix glc: <https://ggen.dev/ontology/greene-licensing-case#> .
@prefix glcsh: <https://ggen.dev/ontology/greene-licensing-case/shape#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SHACL shapes for the packet artifacts (glc:). The cs: case-study shapes
# stay owned by semantic-case-study-pack and are applied by consumers that
# import it; these shapes cover only what that layer does not model. The
# SPARQL gates 050/060/070 are the fail-closed twins of the boundary rules.

glcsh:UserShape a sh:NodeShape ;
  sh:targetClass glc:User ;
  sh:property [ sh:path glc:displayName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path glc:signatureRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

glcsh:LetterShape a sh:NodeShape ;
  sh:targetClass glc:Letter ;
  sh:property [ sh:path glc:sender ; sh:minCount 1 ; sh:maxCount 1 ; sh:class glc:User ] ;
  sh:property [ sh:path glc:addressee ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path glc:letterSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path glc:letterStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "PROPOSAL_DRAFT" ) ] ;
  sh:property [ sh:path glc:letterDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
  sh:property [ sh:path glc:maxPages ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
                sh:minInclusive 1 ; sh:maxInclusive 2 ] ;
  sh:property [ sh:path glc:sentOn ; sh:maxCount 0 ] ;
  sh:property [ sh:path [ sh:inversePath glc:sectionOf ] ; sh:minCount 1 ; sh:class glc:LetterSection ] .

glcsh:LetterSectionShape a sh:NodeShape ;
  sh:targetClass glc:LetterSection ;
  sh:property [ sh:path glc:sectionOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class glc:Letter ] ;
  sh:property [ sh:path glc:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path glc:heading ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path glc:body ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                sh:maxLength 700 ] .

glcsh:RightsItemShape a sh:NodeShape ;
  sh:targetClass glc:RightsItem ;
  sh:property [ sh:path glc:rightsId ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^R[0-9]{2}$" ] ;
  sh:property [ sh:path glc:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path glc:item ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path glc:heldNow ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path glc:requested ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path glc:fallbackIfDeclined ; sh:minCount 1 ; sh:maxCount 1 ] .

glcsh:ReceiptDigestShape a sh:NodeShape ;
  sh:targetClass glc:ReceiptDigest ;
  sh:property [ sh:path glc:digestOf ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path glc:digestKind ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path glc:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path glc:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] .

glcsh:ReplayCommandShape a sh:NodeShape ;
  sh:targetClass glc:ReplayCommand ;
  sh:property [ sh:path glc:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path glc:command ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path glc:expectedObservation ; sh:minCount 1 ; sh:maxCount 1 ] .

glcsh:DemoStepShape a sh:NodeShape ;
  sh:targetClass glc:DemoStep ;
  sh:property [ sh:path glc:order ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
  sh:property [ sh:path glc:heading ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path glc:command ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path glc:expectedObservation ; sh:minCount 1 ; sh:maxCount 1 ] .
