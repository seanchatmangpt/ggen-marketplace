@prefix dx: <https://ggen.dev/marketplace/diataxis-documentation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Minimal admitted documentation ontology for the Diataxis structure of this
# marketplace. Documents mirror REQUIRED_DOCS in scripts/marketplace.py.
# Facts only: this pack ships no templates or gates.

dx:Quadrant a rdfs:Class ; rdfs:label "Diataxis quadrant" .
dx:Document a rdfs:Class ; rdfs:label "Documentation page" .
dx:inQuadrant a rdf:Property ; rdfs:domain dx:Document ; rdfs:range dx:Quadrant ; rdfs:label "in quadrant" .
dx:path a rdf:Property ; rdfs:domain dx:Document ; rdfs:range xsd:string ; rdfs:label "repository-relative path" .

dx:Tutorial a dx:Quadrant ; rdfs:label "Tutorial" ; rdfs:comment "Learning journey." .
dx:HowTo a dx:Quadrant ; rdfs:label "How-to" ; rdfs:comment "Task recipe." .
dx:Reference a dx:Quadrant ; rdfs:label "Reference" ; rdfs:comment "Exact contract." .
dx:Explanation a dx:Quadrant ; rdfs:label "Explanation" ; rdfs:comment "Architecture and rationale." .

dx:doc-index a dx:Document ; dx:path "docs/index.md" .

dx:doc-tutorials-first-pack a dx:Document ; dx:inQuadrant dx:Tutorial ; dx:path "docs/tutorials/first-pack.md" .
dx:doc-tutorials-consume-a-pack a dx:Document ; dx:inQuadrant dx:Tutorial ; dx:path "docs/tutorials/consume-a-pack.md" .

dx:doc-how-to-publish-a-pack a dx:Document ; dx:inQuadrant dx:HowTo ; dx:path "docs/how-to/publish-a-pack.md" .
dx:doc-how-to-update-a-pack a dx:Document ; dx:inQuadrant dx:HowTo ; dx:path "docs/how-to/update-a-pack.md" .
dx:doc-how-to-validate-locally a dx:Document ; dx:inQuadrant dx:HowTo ; dx:path "docs/how-to/validate-locally.md" .
dx:doc-how-to-qualify-all-packs a dx:Document ; dx:inQuadrant dx:HowTo ; dx:path "docs/how-to/qualify-all-packs.md" .
dx:doc-how-to-consume-a-pack a dx:Document ; dx:inQuadrant dx:HowTo ; dx:path "docs/how-to/consume-a-pack.md" .
dx:doc-how-to-migrate-a-pack a dx:Document ; dx:inQuadrant dx:HowTo ; dx:path "docs/how-to/migrate-a-pack.md" .

dx:doc-reference-repository-layout a dx:Document ; dx:inQuadrant dx:Reference ; dx:path "docs/reference/repository-layout.md" .
dx:doc-reference-pack-contract a dx:Document ; dx:inQuadrant dx:Reference ; dx:path "docs/reference/pack-contract.md" .
dx:doc-reference-catalog-command a dx:Document ; dx:inQuadrant dx:Reference ; dx:path "docs/reference/catalog-command.md" .
dx:doc-reference-validation-contract a dx:Document ; dx:inQuadrant dx:Reference ; dx:path "docs/reference/validation-contract.md" .
dx:doc-reference-ggen-qualification-contract a dx:Document ; dx:inQuadrant dx:Reference ; dx:path "docs/reference/ggen-qualification-contract.md" .
dx:doc-reference-provenance a dx:Document ; dx:inQuadrant dx:Reference ; dx:path "docs/reference/provenance.md" .
dx:doc-reference-standing a dx:Document ; dx:inQuadrant dx:Reference ; dx:path "docs/reference/standing.md" .

dx:doc-explanation-why-a-separate-marketplace a dx:Document ; dx:inQuadrant dx:Explanation ; dx:path "docs/explanation/why-a-separate-marketplace.md" .
dx:doc-explanation-source-of-truth a dx:Document ; dx:inQuadrant dx:Explanation ; dx:path "docs/explanation/source-of-truth.md" .
dx:doc-explanation-pack-lifecycle a dx:Document ; dx:inQuadrant dx:Explanation ; dx:path "docs/explanation/pack-lifecycle.md" .
dx:doc-explanation-security-and-authority a dx:Document ; dx:inQuadrant dx:Explanation ; dx:path "docs/explanation/security-and-authority.md" .
