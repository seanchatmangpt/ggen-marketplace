---
to: "generated/presentation/render.part0.mjs"
---
import fs from 'node:fs';
import path from 'node:path';
import { createRequire } from 'node:module';
import { parseArgs } from 'node:util';

const require = createRequire(import.meta.url);
const pptxgen = require('pptxgenjs');

const { values } = parseArgs({
  options: {
    spec: { type: 'string' },
    out: { type: 'string' },
    audience: { type: 'string', default: 'all' },
  },
});
if (!values.spec || !values.out) {
  console.error('usage: node render.mjs --spec deck.json --out deck.pptx [--audience all|interview]');
  process.exit(2);
}

const spec = JSON.parse(fs.readFileSync(values.spec, 'utf8'));
const slides = spec.slides.filter(s => values.audience === 'all' || s.audience !== 'internal');

const pptx = new pptxgen();
pptx.layout = 'LAYOUT_WIDE';
pptx.author = spec.deck.author || 'Generated by ggen_igniter';
pptx.company = spec.deck.company || 'XaaS';
pptx.subject = spec.deck.subject || spec.deck.title || 'Presentation';
pptx.title = spec.deck.title || 'Presentation';
pptx.lang = 'en-US';
pptx.theme = {
  headFontFace: 'Aptos Display',
  bodyFontFace: 'Aptos',
  lang: 'en-US',
};
pptx.defineLayout({ name: 'CUSTOM_WIDE', width: 13.333, height: 7.5 });
pptx.layout = 'CUSTOM_WIDE';

const C = {
  bg: 'F7F4EF', navy: '184E77', text: '1A1F2B', muted: '5D6675', gold: 'B7791F',
  green: '2F6F3E', red: '9B2C2C', blueFill: 'E6F0F7', greenFill: 'E9F4EC',
  goldFill: 'FFF4D6', redFill: 'F7E8E8', stoneFill: 'EDE7DD', white: 'FFFFFF', line: 'D7D4CE',
};
const TONE = {
  blue: { fill: C.blueFill, color: C.navy }, green: { fill: C.greenFill, color: C.green },
  gold: { fill: C.goldFill, color: C.gold }, red: { fill: C.redFill, color: C.red },
  stone: { fill: C.stoneFill, color: C.text }, white: { fill: C.white, color: C.text },
};

function tone(name='stone') { return TONE[name] || TONE.stone; }
function blocks(s, role) { return (s.blocks || []).filter(b => !role || b.role === role).sort((a,b)=>Number(a.order)-Number(b.order)); }
function box(slide, x,y,w,h, fill, line='none', radius=0.08) {
  slide.addShape(pptx.ShapeType.roundRect, {x,y,w,h,rectRadius:radius,fill:{color:fill},line: line==='none'?{color:fill,transparency:100}:{color:line,width:1}});
}
function text(slide, value, x,y,w,h, opts={}) {
  slide.addText(value || '', {x,y,w,h,fontFace:opts.fontFace||'Aptos',fontSize:opts.fontSize||14,color:opts.color||C.text,bold:opts.bold||false,align:opts.align||'left',valign:opts.valign||'mid',margin:opts.margin??0,breakLine:false,fit:'shrink',...opts});
}
function arrow(slide,x,y,w,h,color=C.muted) {
  slide.addShape(pptx.ShapeType.line,{x,y,w,h,line:{color,width:1.5,beginArrowType:'none',endArrowType:'triangle'}});
}
function dot(slide,x,y,color=C.gold,size=0.08){slide.addShape(pptx.ShapeType.ellipse,{x,y,w:size,h:size,fill:{color},line:{color,transparency:100}});}
function common(slide,s,index) {
  slide.background = {color:C.bg};
  slide.addShape(pptx.ShapeType.rect,{x:0,y:0,w:0.16,h:7.5,fill:{color:C.navy},line:{color:C.navy,transparency:100}});
  text(slide,s.kicker||'WD CASE STUDY 2',0.55,0.32,3.8,0.25,{fontFace:'Aptos',fontSize:8.5,bold:true,color:C.gold});
  text(slide,s.title,0.55,0.63,11.2,0.52,{fontFace:'Aptos Display',fontSize:24,bold:true,color:C.text});
  slide.addShape(pptx.ShapeType.line,{x:0.55,y:1.22,w:11.9,h:0,line:{color:C.line,width:1}});
  text(slide,s.footer||spec.deck.footer||'',0.55,7.08,5.3,0.18,{fontSize:7.5,color:C.muted});
  text(slide,String(index).padStart(2,'0'),12.25,7.05,0.55,0.2,{fontSize:8,color:C.muted,align:'right'});
  if (s.notes) slide.addNotes(s.notes);
}
function labelBlock(slide,b,x,y,w,h,{fontSize=14}={}){
  const t=tone(b.tone); box(slide,x,y,w,h,t.fill); text(slide,b.title||b.body,x+0.13,y+0.1,w-0.26,h-0.2,{fontSize,bold:true,color:t.color,align:b.align||'left'});
}
function callout(slide,b,x,y,w,h,color=C.text){
  slide.addShape(pptx.ShapeType.rect,{x,y,w:0.06,h,fill:{color:C.gold},line:{color:C.gold,transparency:100}});
  text(slide,b?.body||b?.title||'',x+0.18,y,w-0.18,h,{fontSize:17,color});
}

function hero(slide,s){
  slide.background={color:C.bg};
  slide.addShape(pptx.ShapeType.rect,{x:0,y:0,w:0.16,h:7.5,fill:{color:C.navy},line:{color:C.navy,transparency:100}});
  text(slide,s.kicker||'',0.7,0.65,6.6,0.28,{fontSize:13,bold:true,color:C.gold});
  text(slide,s.title,0.7,1.1