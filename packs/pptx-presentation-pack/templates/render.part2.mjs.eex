function split(slide,s){
  const heads=blocks(s,'section'); if(heads[0]) labelBlock(slide,heads[0],1.08,1.67,2.29,0.41,{fontSize:16}); if(heads[1]) labelBlock(slide,heads[1],7.93,1.67,1.74,0.41,{fontSize:16});
  const ls=blocks(s,'left'); ls.forEach((b,i)=>{dot(slide,1.12,2.58+i*0.5,C.navy,0.06);text(slide,b.body||b.title,1.28,2.45+i*0.5,4.6,0.35,{fontSize:13,color:C.text});});
  const rs=blocks(s,'right'); rs.forEach((b,i)=>{dot(slide,7.97,2.58+i*0.5,C.green,0.06);text(slide,b.body||b.title,8.13,2.45+i*0.5,4.6,0.35,{fontSize:13,color:C.text});});
  const mid=blocks(s,'center')[0]; if(mid) labelBlock(slide,mid,4.68,5.17,4.04,0.54,{fontSize:14});
  const c=blocks(s,'callout')[0]; if(c) text(slide,c.body||c.title,2.58,6.22,8.22,0.5,{fontSize:16,bold:true,color:C.navy,align:'center'});
}
function chain(slide,s){
  const stage=blocks(s,'stage'); const xs=[1.03,3.98,7.13,10.18], ws=[1.74,1.94,1.89,2.09];
  stage.forEach((b,i)=>labelBlock(slide,b,xs[i],1.67,ws[i],0.41,{fontSize:14}));
  for(let i=0;i<3;i++) arrow(slide,xs[i]+ws[i],1.88,xs[i+1]-(xs[i]+ws[i]),0,C.muted);
  const lines=blocks(s,'line'); const ys=[3.0,3.65,4.3]; lines.forEach((b,i)=>{dot(slide,1.05,ys[i]+0.11,[C.navy,C.green"ăold][i]||C.gold,0.06);text(slide,b.body||b.title,1.23,ys[i],10.0,0.35,{fontSize:13.5,color:C.text});});
  const c=blocks(s,'callout')[0]; if(c) callout(slide,c,1.05,5.65,10.8,0.55,C.text);
}
function stages(slide,s){
  const st=blocks(s,'stage'); const xs=[0.95,5.45,9.95], ws=[2.35,2.6,2.2];
  st.forEach((b,i)=>{labelBlock(slide,b,xs[i],1.65,ws[i],0.8,{fontSize:17}); text(slide,b.body||'',xs[i]-0.2,2.75,ws[i]+0.85,0.72,{fontSize:13,color:C.muted,align:'center'});});
  arrow(slide,3.3,2.05,2.15,0,C.muted); arrow(slide,8.05,2.05,1.9,0,C.muted);
  const g=blocks(s,'guardrail')[0]; if(g) labelBlock(slide,g,3.15,4.35,3.15,0.65,{fontSize:17});
  const m=blocks(s,'metrics')[0]; if(m) labelBlock(slide,m,6.75,4.35,4.65,0.65,{fontSize:13});
  const c=blocks(s,'callout')[0]; if(c) callout(slide,c,1.15,5.82,10.8,0.65,C.text);
}
function timeline(slide,s){
  const st=blocks(s,'stage'); const xs=[0.9,5.25,9.6], ws=[2.8,2.8,2.55];
  st.forEach((b,i)=>{labelBlock(slide,b,xs[i],1.72,ws[i],0.61,{fontSize:14.5});text(slide,b.body||'',xs[i]+0.2,3.05,ws[i]+0.6,0.7,{fontSize:13,color:C.muted});});
  arrow(slide,3.7,2.02,1.55,0,C.muted);arrow(slide,8.05,2.02,1.55,0,C.muted);
  const c=blocks(s,'callout')[0]; if(c) callout(slide,c,1.15,5.35,11.0,0.75,C.text);
}
function flow(slide,s){
  const st=blocks(s,'stage'); const xs=[0.85,2.95,5.45,7.9,10.35], ws=[1.55,2.0,1.85,1.85,2.0];
  st.forEach((b,i)=>labelBlock(slide,b,xs[i],2.02,ws[i],0.68,{fontSize:13}));
  for(let i=0;i<4;i++) arrow(slide,xs[i]+ws[i],2.36,xs[i+1]-(xs[i]+ws[i]),0,C.muted);
  const c=blocks(s,'callout')[0]; if(c) text(slide,c.body||c.title,1.63,4.1,10.42,0.75,{fontSize:17,bold:true,color:C.navy,align:'center'});
  const d=blocks(s,'decision')[0]; if(d){dot(slide,1.45,5.68,C.gold);text(slide,d.body||d.title,1.63,5.55,10,0.35,{fontSize:13.5,color:C.muted});}
}
function bullets(slide,s){
  const bs=blocks(s,'bullet'); bs.forEach((b,i)=>{dot(slide,0.95,1.64+i*0.6,C.gold);text(slide,b.body||b.title,1.13,1.55+i*0.6,11.4,0.35,{fontSize:15});});
  const c=blocks(s,'conclusion')[0]; if(c) callout(slide,c,1.1,5.45,10.9,0.72,C.navy);
}
function threePart(slide,s){
  const ps=blocks(s,'part'); const ys=[1.6,3.05,4.5]; ps.forEach((b,i)=>{labelBlock(slide,{...b,title:b.title,tone:['blue','gold','red'][i]},0.95,ys[i],2.1,0.55,{fontSize:15});text(slide,b.body||'',3.35,ys[i]-0.03,8.7,0.62,{fontSize:14,color:C.muted});});
  const c=blocks(s,'conclusion')[0]; if(c) callout(slide,c,1.1,6.1,10.9,0.55,C.navy);
}

const renderers={hero_flow:hero,agenda,source_chain:sourceChain,triad,pipeline,pairs,graph,split,chain,stages,timeline,flow,bullets,three_part:threePart};
slides.forEach((s,idx)=>{
  const slide=pptx.addSlide();
  if(s.layout!=='hero_flow') common(slide,s,idx+1);
  const fn=renderers[s.layout];
  if(!fn) throw new Error(`unsupported layout: ${s.layout}`);
  fn(slide,s,idx+1);
});

fs.mkdirSync(path.dirname(values.out),{recursive:true});
