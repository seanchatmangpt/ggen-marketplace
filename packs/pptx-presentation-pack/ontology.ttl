@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix pres: <https://ggen.dev/ns/presentation#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pres:Presentation a rdfs:Class ;
  rdfs:label "Presentation" ;
  rdfs:comment "Canonical semantic subject for a generated slide deck." .

pres:Slide a rdfs:Class ;
  rdfs:label "Slide" ;
  rdfs:comment "Ordered projection unit with a reusable layout name, evidence-bounded audience, and optional speaker notes." .

pres:Block a rdfs:Class ;
  rdfs:label "Block" ;
  rdfs:comment "Ordered semantic content block owned by a slide; role and tone are renderer inputs, not independent standing." .

pres:slideOf a rdf:Property ; rdfs:domain pres:Slide ; rdfs:range pres:Presentation .
pres:blockOf a rdf:Property ; rdfs:domain pres:Block ; rdfs:range pres:Slide .
pres:id a rdf:Property .
pres:order a rdf:Property .
pres:layout a rdf:Property .
pres:audience a rdf:Property .
pres:kicker a rdf:Property .
pres:title a rdf:Property .
pres:subtitle a rdf:Property .
pres:footer a rdf:Property .
pres:notes a rdf:Property .
pres:role a rdf:Property .
pres:body a rdf:Property .
pres:tone a rdf:Property .
pres:author a rdf:Property .
pres:company a rdf:Property .
pres:subject a rdf:Property .

pres:PptxPresentationPack a gp:Pack ;
  gp:name "pptx-presentation-pack" ;
  rdfs:label "PPTX Presentation Pack" ;
  rdfs:comment "Reusable CONSTRUCT-only presentation manufacture vocabulary and templates. The PPTX renderer uses PptxGenJS; ggen_igniter owns RDF query + textual projection. Binary PowerPoint output is produced only by an explicit consumer CLI/runtime step." .
