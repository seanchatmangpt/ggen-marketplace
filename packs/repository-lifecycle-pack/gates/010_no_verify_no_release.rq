# MESSAGE: "NoVerify implies NoRelease" -- any rl:Release individual is
# refused unless it links via rl:verifiedBy to a real individual actually
# typed rl:Verify AND that Verify individual carries rl:result rl:PASS. A
# Release with no verifiedBy link, a verifiedBy link to something not
# actually typed rl:Verify, or a Verify stage that exists but did not pass
# (rl:FAIL or no result at all) are all refused the same way -- a forged or
# failing verification cannot manufacture a lawful release any more than a
# missing one can.
#
# Each row names the offending Release individual.
PREFIX rl: <https://ggen.dev/ontology/repository-lifecycle#>
SELECT ?release WHERE {
  ?release a rl:Release .
  FILTER NOT EXISTS {
    ?release rl:verifiedBy ?verify .
    ?verify a rl:Verify ;
            rl:result rl:PASS .
  }
}
ORDER BY ?release
