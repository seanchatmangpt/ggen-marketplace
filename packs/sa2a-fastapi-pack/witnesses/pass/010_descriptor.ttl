@prefix s2a: <https://ggen.dev/packs/sa2a-fastapi#> .
@prefix pi: <https://ggen.dev/ontology/protocol-integration#> .
@prefix wd: <https://ggen.dev/wd-fa/example#> .
wd:Cap a pi:Capability ; pi:semanticDefinition "read-only candidate capability" .
s2a:Good a s2a:CapabilityProjection ;
  s2a:projectsCapability wd:Cap ;
  s2a:capabilityId "observe" ;
  s2a:observationScope "read_only" ;
  s2a:mutationScope "none" ;
  s2a:requiresAuthority false ;
  s2a:receiptSemantics "logged" .
