@prefix s2a: <https://ggen.dev/packs/sa2a-fastapi#> .
@prefix pi: <https://ggen.dev/ontology/protocol-integration#> .
@prefix wd: <https://ggen.dev/wd-fa/example#> .

wd:AnalyzeFailureCapability a pi:Capability ;
    pi:semanticDefinition "Given an admitted failure-case subject and bounded evidence horizon, return candidate hypotheses and a discriminating next action without granting DO authority." .

s2a:WDFAAgent a s2a:FastAPISA2ASurface ;
    s2a:surfaceName "wd-fa" ;
    s2a:mountPath "/a2a" ;
    s2a:containsProjection s2a:AnalyzeFailureProjection .

s2a:AnalyzeFailureProjection a s2a:CapabilityProjection ;
    s2a:projectsCapability wd:AnalyzeFailureCapability ;
    s2a:capabilityId "analyze_failure" ;
    s2a:observationScope "read_only" ;
    s2a:mutationScope "none" ;
    s2a:requiresAuthority false ;
    s2a:receiptSemantics "logged" .
