# SHACL shapes for the latency-hazard-radar ontology. Constraint surface for
# admission: a graph violating any of these shapes is refused before codegen.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix lhr: <urn:latency-hazard-radar:> .

lhr:ObservationWindowShape a sh:NodeShape ;
    sh:targetClass lhr:ObservationWindow ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "each observation window carries exactly one label" ;
    ] ;
    sh:property [
        sh:path lhr:elapsedMillis ;
        sh:minCount 3 ;
        sh:datatype xsd:integer ;
        sh:message "an observation window needs >= 3 latency observations (>= 3 for a meaningful median)" ;
    ] .

lhr:HazardPolicyShape a sh:NodeShape ;
    sh:targetClass lhr:HazardPolicy ;
    sh:property [
        sh:path lhr:hazardThreshold ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:exclusiveMin 0 ;
        sh:message "exactly one positive hazard threshold is required" ;
    ] ;
    sh:property [
        sh:path lhr:refusalAtom ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^insufficient_dispersion$" ;
        sh:message "the MAD=0 outcome must be the single typed atom insufficient_dispersion" ;
    ] ;
    sh:property [
        sh:path lhr:triagePrompt ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 10 ;
        sh:message "a non-empty triage-prompt event is required" ;
    ] .

lhr:EstimatorShape a sh:NodeShape ;
    sh:targetClass lhr:Estimator ;
    sh:property [
        sh:path lhr:medianMillis ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "a median estimator carries at most one median witness" ;
    ] ;
    sh:property [
        sh:path lhr:madMillis ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:message "an MAD estimator carries at most one MAD witness" ;
    ] .
