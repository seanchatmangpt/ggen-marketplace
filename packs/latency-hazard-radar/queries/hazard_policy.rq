# Projection query: hazard policy + estimator rows driving the HazardRadar
# template. One row (single policy individual); its fields carry the hazard
# threshold, typed MAD=0 refusal atom, triage-prompt text, and the
# demonstration window's median/MAD witness values used in the module's
# doc examples and doctest-grade spot checks.
PREFIX lhr: <urn:latency-hazard-radar:>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?threshold ?refusalAtom ?triagePrompt ?medianWitness ?madWitness
WHERE {
  ?policy a lhr:HazardPolicy ;
          lhr:hazardThreshold ?threshold ;
          lhr:refusalAtom ?refusalAtom ;
          lhr:triagePrompt ?triagePrompt .
  OPTIONAL { ?m a lhr:Estimator ; lhr:medianMillis ?medianWitness . }
  OPTIONAL { ?d a lhr:Estimator ; lhr:madMillis ?madWitness . }
}
ORDER BY ?threshold ?refusalAtom ?medianWitness ?madWitness
