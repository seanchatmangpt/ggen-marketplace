# Qualification consumer seed: reuses pack specimen individuals as the
# positive graph. Coordinator unions this with ontology.ttl for gate courts.
@prefix scim:    <https://ggen.dev/ontology/scim-lifecycle#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

scim:qualification-note a dcterms:ProvenanceStatement ;
    dcterms:description "Positive consumer is the pack ontology itself (specimen User/Group/SPC). Mutation falsifiers live under tests/mutations/." .
