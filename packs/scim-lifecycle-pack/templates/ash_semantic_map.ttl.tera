---
to: "generated/scim/ash_semantic_map.ttl"
force: true
sparql:
  resources: |
    PREFIX scim: <https://ggen.dev/ontology/scim-lifecycle#>
    PREFIX apg:  <https://ggen.dev/ash-projection#>
    SELECT DISTINCT ?moduleName ?resourceName ?domainIri ?sourceDigest ?schemaUrn ?pkAttr
    WHERE {
      ?target a scim:AshProjectionTarget ;
              scim:ashModuleName ?moduleName ;
              scim:ashResourceName ?resourceName ;
              scim:sourceSchemaUrn ?schemaUrn ;
              scim:primaryKeyAttribute ?pkAttr ;
              apg:domainIri ?domainIriRaw ;
              apg:sourceDigest ?sourceDigest .
      BIND(STR(?domainIriRaw) AS ?domainIri)
    }
    ORDER BY ?moduleName
  attributes: |
    PREFIX scim: <https://ggen.dev/ontology/scim-lifecycle#>
    PREFIX apg:  <https://ggen.dev/ash-projection#>
    SELECT ?moduleName ?attrName ?ashType ?isPk ?pred
    WHERE {
      ?target a scim:AshProjectionTarget ;
              scim:ashModuleName ?moduleName ;
              apg:attribute ?attr .
      ?attr apg:attributeName ?attrName ;
            apg:ashType ?ashType ;
            apg:primaryKey ?isPk ;
            apg:semanticPredicate ?predRaw .
      BIND(STR(?predRaw) AS ?pred)
    }
    ORDER BY ?moduleName ?attrName
---
# GENERATED by ggen sync from scim-lifecycle-pack (ash_semantic_map.ttl).
# Ash semantic map projection — Turtle only; no Elixir runtime in this pack.
# Do not hand-edit. Regenerate with `ggen sync run`.
@prefix map:     <https://ggen.dev/ash-projection/map#> .
@prefix apg:     <https://ggen.dev/ash-projection#> .
@prefix scim:    <https://ggen.dev/ontology/scim-lifecycle#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

{% for row in resources %}
map:{{ row.moduleName }} a apg:SemanticBinding ;
  apg:exactSubject "scim-lifecycle:{{ row.moduleName }}" ;
  apg:domainIri <{{ row.domainIri }}> ;
  apg:sourceDigest "{{ row.sourceDigest }}" ;
  dcterms:source <{{ row.schemaUrn }}> .
{% endfor %}

{% for row in attributes %}
map:{{ row.moduleName }}_{{ row.attrName }} a apg:Attribute ;
  apg:attributeName "{{ row.attrName }}" ;
  apg:ashType "{{ row.ashType }}" ;
  apg:primaryKey {{ row.isPk }} ;
  apg:semanticPredicate <{{ row.pred }}> .

map:{{ row.moduleName }} apg:attribute map:{{ row.moduleName }}_{{ row.attrName }} .
{% endfor %}
