# Falsifier for gates/050_no_password_literal.rq — password triple (>=1 row).
@prefix scim: <https://ggen.dev/ontology/scim-lifecycle#> .

scim:user-mutation-password a scim:User ;
    scim:schemaUrn "urn:ietf:params:scim:schemas:core:2.0:User" ;
    scim:resourceId "mutation-user-password" ;
    scim:userName "mutation.password" ;
    scim:password "never-store-me" .
