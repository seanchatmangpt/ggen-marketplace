# Pass witness: complete User → gate 010 returns 0 rows.
@prefix scim: <https://ggen.dev/ontology/scim-lifecycle#> .

scim:witness-pass-user a scim:User ;
    scim:schemaUrn "urn:ietf:params:scim:schemas:core:2.0:User" ;
    scim:resourceId "witness-pass-user" ;
    scim:userName "witness.pass" ;
    scim:active true .
