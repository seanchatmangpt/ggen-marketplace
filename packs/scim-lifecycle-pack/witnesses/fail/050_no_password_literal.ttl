# Fail witness: password triple → gate 050 returns >=1 row.
@prefix scim: <https://ggen.dev/ontology/scim-lifecycle#> .

scim:witness-fail-password a scim:User ;
    scim:schemaUrn "urn:ietf:params:scim:schemas:core:2.0:User" ;
    scim:resourceId "witness-fail-password" ;
    scim:userName "witness.password" ;
    scim:password "never-store-me" .
