# Fail witness: foreign schema URN → gate 040 returns >=1 row.
@prefix scim: <https://ggen.dev/ontology/scim-lifecycle#> .

scim:witness-fail-foreign-urn a scim:User ;
    scim:schemaUrn "urn:example:not-scim:User" ;
    scim:resourceId "witness-fail-foreign-urn" ;
    scim:userName "witness.foreign" .
