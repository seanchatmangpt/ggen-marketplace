# MESSAGE: every scim:ResourceType must carry resourceTypeName, endpoint,
# schemaUrn, and resourceId (RFC 7643 §6). Any row = refusal.
PREFIX scim: <https://ggen.dev/ontology/scim-lifecycle#>

SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a scim:ResourceType .
    OPTIONAL { ?subject scim:resourceTypeName ?p }
    FILTER (!BOUND(?p))
    BIND("scim:resourceTypeName" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:ResourceType .
    OPTIONAL { ?subject scim:endpoint ?p }
    FILTER (!BOUND(?p))
    BIND("scim:endpoint" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:ResourceType .
    OPTIONAL { ?subject scim:schemaUrn ?p }
    FILTER (!BOUND(?p))
    BIND("scim:schemaUrn" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:ResourceType .
    OPTIONAL { ?subject scim:resourceId ?p }
    FILTER (!BOUND(?p))
    BIND("scim:resourceId" AS ?missing_property)
  }
}
ORDER BY ?subject ?missing_property
