# MESSAGE: every scim:AshProjectionTarget must declare ashModuleName,
# ashResourceName, primaryKeyAttribute, and sourceSchemaUrn. Any row = refusal.
PREFIX scim: <https://ggen.dev/ontology/scim-lifecycle#>

SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a scim:AshProjectionTarget .
    OPTIONAL { ?subject scim:ashModuleName ?p }
    FILTER (!BOUND(?p))
    BIND("scim:ashModuleName" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:AshProjectionTarget .
    OPTIONAL { ?subject scim:ashResourceName ?p }
    FILTER (!BOUND(?p))
    BIND("scim:ashResourceName" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:AshProjectionTarget .
    OPTIONAL { ?subject scim:primaryKeyAttribute ?p }
    FILTER (!BOUND(?p))
    BIND("scim:primaryKeyAttribute" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:AshProjectionTarget .
    OPTIONAL { ?subject scim:sourceSchemaUrn ?p }
    FILTER (!BOUND(?p))
    BIND("scim:sourceSchemaUrn" AS ?missing_property)
  }
}
ORDER BY ?subject ?missing_property
