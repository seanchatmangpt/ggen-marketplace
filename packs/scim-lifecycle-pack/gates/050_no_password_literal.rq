# MESSAGE: scim:password MUST NOT appear as a triple in this pack's graph
# (write-only at protocol runtime; RDF persistence of credentials is a refusal).
# Any row = refusal.
PREFIX scim: <https://ggen.dev/ontology/scim-lifecycle#>

SELECT ?subject ?problem
WHERE {
  ?subject scim:password ?literal .
  BIND("password-literal-forbidden-in-rdf" AS ?problem)
}
ORDER BY ?subject
