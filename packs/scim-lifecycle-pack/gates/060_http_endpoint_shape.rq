# MESSAGE: every scim:HttpEndpoint must carry httpMethod, httpPath, and
# endpointResourceClass. Any row = refusal.
PREFIX scim: <https://ggen.dev/ontology/scim-lifecycle#>

SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a scim:HttpEndpoint .
    OPTIONAL { ?subject scim:httpMethod ?p }
    FILTER (!BOUND(?p))
    BIND("scim:httpMethod" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:HttpEndpoint .
    OPTIONAL { ?subject scim:httpPath ?p }
    FILTER (!BOUND(?p))
    BIND("scim:httpPath" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:HttpEndpoint .
    OPTIONAL { ?subject scim:endpointResourceClass ?p }
    FILTER (!BOUND(?p))
    BIND("scim:endpointResourceClass" AS ?missing_property)
  }
}
ORDER BY ?subject ?missing_property
