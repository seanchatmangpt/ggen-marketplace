# MESSAGE: every scim:ServiceProviderConfig must declare schemaUrn plus the
# six RFC 7643 §5 capability booleans. Any row = refusal.
PREFIX scim: <https://ggen.dev/ontology/scim-lifecycle#>

SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a scim:ServiceProviderConfig .
    OPTIONAL { ?subject scim:schemaUrn ?p_schema }
    FILTER (!BOUND(?p_schema))
    BIND("scim:schemaUrn" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:ServiceProviderConfig .
    OPTIONAL { ?subject scim:patchSupported ?p }
    FILTER (!BOUND(?p))
    BIND("scim:patchSupported" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:ServiceProviderConfig .
    OPTIONAL { ?subject scim:bulkSupported ?p }
    FILTER (!BOUND(?p))
    BIND("scim:bulkSupported" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:ServiceProviderConfig .
    OPTIONAL { ?subject scim:filterSupported ?p }
    FILTER (!BOUND(?p))
    BIND("scim:filterSupported" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:ServiceProviderConfig .
    OPTIONAL { ?subject scim:changePasswordSupported ?p }
    FILTER (!BOUND(?p))
    BIND("scim:changePasswordSupported" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:ServiceProviderConfig .
    OPTIONAL { ?subject scim:sortSupported ?p }
    FILTER (!BOUND(?p))
    BIND("scim:sortSupported" AS ?missing_property)
  }
  UNION
  {
    ?subject a scim:ServiceProviderConfig .
    OPTIONAL { ?subject scim:etagSupported ?p }
    FILTER (!BOUND(?p))
    BIND("scim:etagSupported" AS ?missing_property)
  }
}
ORDER BY ?subject ?missing_property
