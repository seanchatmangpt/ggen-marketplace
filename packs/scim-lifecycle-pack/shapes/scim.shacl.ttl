# SHACL shapes for scim-lifecycle-pack (ontology.ttl).
# Mirrors gates/010..070 as NodeShapes for `ggen graph validate --shapes`.
# Not named shapes.ttl at pack root (FM legacy-SHACL-gate guard).
# Construction only — shapes admit facts; they grant no provisioning authority.

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix apg:     <https://ggen.dev/ash-projection#> .
@prefix scim:    <https://ggen.dev/ontology/scim-lifecycle#> .

# ---------------------------------------------------------------------------
# User (RFC 7643 §4.1) — required identity; password forbidden in RDF
# ---------------------------------------------------------------------------

scim:UserShape a sh:NodeShape ;
    sh:targetClass scim:User ;
    sh:property [
        sh:path scim:schemaUrn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue "urn:ietf:params:scim:schemas:core:2.0:User" ;
        sh:message "scim:User requires schemaUrn = urn:ietf:params:scim:schemas:core:2.0:User." ;
    ] ;
    sh:property [
        sh:path scim:resourceId ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "scim:User requires exactly one scim:resourceId." ;
    ] ;
    sh:property [
        sh:path scim:userName ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "scim:User requires exactly one non-empty scim:userName (RFC 7643 §4.1)." ;
    ] ;
    sh:property [
        sh:path scim:active ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path scim:displayName ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path scim:email ;
        sh:class scim:Email ;
    ] ;
    sh:property [
        sh:path scim:hasMeta ;
        sh:class scim:Meta ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path scim:password ;
        sh:maxCount 0 ;
        sh:message "scim:password MUST NOT appear in the RDF graph (gate 050 / write-only at protocol runtime)." ;
    ] .

# ---------------------------------------------------------------------------
# Group (RFC 7643 §4.2)
# ---------------------------------------------------------------------------

scim:GroupShape a sh:NodeShape ;
    sh:targetClass scim:Group ;
    sh:property [
        sh:path scim:schemaUrn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue "urn:ietf:params:scim:schemas:core:2.0:Group" ;
        sh:message "scim:Group requires schemaUrn = urn:ietf:params:scim:schemas:core:2.0:Group." ;
    ] ;
    sh:property [
        sh:path scim:resourceId ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "scim:Group requires exactly one scim:resourceId." ;
    ] ;
    sh:property [
        sh:path scim:displayName ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "scim:Group requires exactly one non-empty scim:displayName." ;
    ] ;
    sh:property [
        sh:path scim:member ;
        sh:class scim:Member ;
    ] ;
    sh:property [
        sh:path scim:hasMeta ;
        sh:class scim:Meta ;
        sh:maxCount 1 ;
    ] .

# ---------------------------------------------------------------------------
# ServiceProviderConfig (RFC 7643 §5)
# ---------------------------------------------------------------------------

scim:ServiceProviderConfigShape a sh:NodeShape ;
    sh:targetClass scim:ServiceProviderConfig ;
    sh:property [
        sh:path scim:schemaUrn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:hasValue "urn:ietf:params:scim:schemas:core:2.0:ServiceProviderConfig" ;
        sh:message "SPC requires schemaUrn = urn:ietf:params:scim:schemas:core:2.0:ServiceProviderConfig." ;
    ] ;
    sh:property [
        sh:path scim:resourceId ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path scim:patchSupported ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "SPC requires scim:patchSupported." ;
    ] ;
    sh:property [
        sh:path scim:bulkSupported ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "SPC requires scim:bulkSupported." ;
    ] ;
    sh:property [
        sh:path scim:filterSupported ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "SPC requires scim:filterSupported." ;
    ] ;
    sh:property [
        sh:path scim:changePasswordSupported ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "SPC requires scim:changePasswordSupported." ;
    ] ;
    sh:property [
        sh:path scim:sortSupported ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "SPC requires scim:sortSupported." ;
    ] ;
    sh:property [
        sh:path scim:etagSupported ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:message "SPC requires scim:etagSupported." ;
    ] ;
    sh:property [
        sh:path scim:documentationUri ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path scim:maxResults ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
    ] .

# ---------------------------------------------------------------------------
# Complex attributes
# ---------------------------------------------------------------------------

scim:EmailShape a sh:NodeShape ;
    sh:targetClass scim:Email ;
    sh:property [
        sh:path scim:emailValue ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "scim:Email requires scim:emailValue." ;
    ] ;
    sh:property [
        sh:path scim:emailType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "work" "home" "other" ) ;
        sh:message "scim:emailType when present must be work|home|other (RFC 7643 §4.1.2)." ;
    ] ;
    sh:property [
        sh:path scim:emailPrimary ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] .

scim:MemberShape a sh:NodeShape ;
    sh:targetClass scim:Member ;
    sh:property [
        sh:path scim:memberValue ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "scim:Member requires scim:memberValue (id)." ;
    ] ;
    sh:property [
        sh:path scim:memberType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "User" "Group" ) ;
        sh:message "scim:memberType when present must be User|Group." ;
    ] ;
    sh:property [
        sh:path scim:memberDisplay ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

scim:MetaShape a sh:NodeShape ;
    sh:targetClass scim:Meta ;
    sh:property [
        sh:path scim:resourceType ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:in ( "User" "Group" "ServiceProviderConfig" "ResourceType" "Schema" ) ;
    ] ;
    sh:property [
        sh:path scim:created ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path scim:lastModified ;
        sh:datatype xsd:dateTime ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path scim:location ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path scim:version ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# ---------------------------------------------------------------------------
# HTTP endpoint cards (RFC 7644) + Ash projection targets
# ---------------------------------------------------------------------------

scim:HttpEndpointShape a sh:NodeShape ;
    sh:targetClass scim:HttpEndpoint ;
    sh:property [
        sh:path scim:httpMethod ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "GET" "POST" "PUT" "PATCH" "DELETE" ) ;
        sh:message "scim:HttpEndpoint requires httpMethod in {GET,POST,PUT,PATCH,DELETE}." ;
    ] ;
    sh:property [
        sh:path scim:httpPath ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:message "scim:HttpEndpoint requires scim:httpPath." ;
    ] ;
    sh:property [
        sh:path scim:endpointResourceClass ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "scim:HttpEndpoint requires scim:endpointResourceClass." ;
    ] .

scim:AshProjectionTargetShape a sh:NodeShape ;
    sh:targetClass scim:AshProjectionTarget ;
    sh:property [
        sh:path scim:ashModuleName ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "AshProjectionTarget requires scim:ashModuleName." ;
    ] ;
    sh:property [
        sh:path scim:ashResourceName ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "AshProjectionTarget requires scim:ashResourceName." ;
    ] ;
    sh:property [
        sh:path scim:primaryKeyAttribute ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "AshProjectionTarget requires scim:primaryKeyAttribute." ;
    ] ;
    sh:property [
        sh:path scim:sourceSchemaUrn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "AshProjectionTarget requires scim:sourceSchemaUrn." ;
    ] ;
    sh:property [
        sh:path scim:ashDomainModule ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path apg:attribute ;
        sh:class apg:Attribute ;
    ] .

scim:LifecycleOperationShape a sh:NodeShape ;
    sh:targetClass scim:LifecycleOperation ;
    sh:property [
        sh:path scim:operationKind ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "LifecycleOperation requires scim:operationKind." ;
    ] ;
    sh:property [
        sh:path scim:targetsResourceClass ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "LifecycleOperation requires scim:targetsResourceClass." ;
    ] .

scim:ResourceTypeShape a sh:NodeShape ;
    sh:targetClass scim:ResourceType ;
    sh:property [
        sh:path scim:resourceTypeName ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "ResourceType requires scim:resourceTypeName." ;
    ] ;
    sh:property [
        sh:path scim:endpoint ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "ResourceType requires scim:endpoint (e.g. /Users)." ;
    ] ;
    sh:property [
        sh:path scim:schemaUrn ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "ResourceType requires scim:schemaUrn." ;
    ] .
