# T03 invalid corpus — dependency-cycle pack-a
# Declares the attacking half of the cycle: gp:requiresPack B (§26/§27,
# scope SEMANTICS). B declares gp:requiresPack A in ../pack-b/ontology.ttl,
# closing the cycle that §34 refuses.
@prefix gp: <https://ggen.dev/ns/pack#> .

<urn:ggen:pack:mkt03-cycle-a-pack>
    a gp:Pack ;
    gp:name "mkt03-cycle-a-pack" ;
    gp:version "1.0.0" ;
    gp:profile gp:Portable1 ;
    gp:authorityCeiling gp:Construct ;
    gp:requiresPack <urn:ggen:pack:mkt03-cycle-b-pack> ;
    gp:dependencyScope gp:Semantics .
