# T03 invalid corpus — dependency-cycle pack-b
# The closing edge: gp:requiresPack A. With pack-a's edge this forms the
# A -> B -> A cycle that §34 refuses (REFUSED:DEPENDENCY_CYCLE).
@prefix gp: <https://ggen.dev/ns/pack#> .

<urn:ggen:pack:mkt03-cycle-b-pack>
    a gp:Pack ;
    gp:name "mkt03-cycle-b-pack" ;
    gp:version "1.0.0" ;
    gp:profile gp:Portable1 ;
    gp:authorityCeiling gp:Construct ;
    gp:requiresPack <urn:ggen:pack:mkt03-cycle-a-pack> ;
    gp:dependencyScope gp:Semantics .
