# T03 invalid corpus — gate-positive-select
# Valid, identity-consistent, and NON-EMPTY on purpose: the planted gate
# matches every triple, so a non-empty admitted graph guarantees rows>0 and
# the gate violation actually fires instead of passing on an empty graph.
@prefix gp: <https://ggen.dev/ns/pack#> .

<urn:ggen:pack:mkt03-gate-positive-select>
    a gp:Pack ;
    gp:name "mkt03-gate-positive-select" ;
    gp:version "1.0.0" ;
    gp:profile gp:Portable1 ;
    gp:authorityCeiling gp:Construct .
