# T03 invalid corpus — target-collision pack-one
# The gp:requiresPack edge with gp:dependencyScope gp:Projection (§29: the
# strongest dependency surface, MUST be explicit) pulls pack-two's
# projection into the same composition, creating the §43 collision.
@prefix gp: <https://ggen.dev/ns/pack#> .

<urn:ggen:pack:mkt03-target-pack-one>
    a gp:Pack ;
    gp:name "mkt03-target-pack-one" ;
    gp:version "1.0.0" ;
    gp:profile gp:Portable1 ;
    gp:renderer gp:Tera1 ;
    gp:authorityCeiling gp:Construct ;
    gp:requiresPack <urn:ggen:pack:mkt03-target-pack-two> ;
    gp:dependencyScope gp:Projection .
