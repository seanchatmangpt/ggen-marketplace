# RFC-GPACK-001 v26.9.17 §96 rows 1-2 — the D1 falsifier pair (T03).
# This exact file ships BYTE-IDENTICAL on two surfaces:
#   gates/010_positive_select.rq  in ../gate-positive-select/ — a gate whose
#     Violation = RowCount > 0 (§14): sync MUST refuse with
#     REFUSED:GATE_VIOLATION on any non-empty graph;
#   queries/d1_select.rq in ../query-positive-select/ — a named query (§13):
#     rows MUST render and the engine MUST NOT refuse (§96 row 1).
# Only the surface differs — that is precisely what this pair falsifies
# (§4.4 divergence D1; §5.6 Query is not Gate). Byte-identity is asserted by
# tests/test_gpack_negative_corpus.py; do not edit one half alone.
SELECT ?s
WHERE {
  ?s ?p ?o .
}
