# T03 invalid corpus — renderer-mismatch
# The pack lawfully ADVERTISES its EEx requirement (§19: gp:renderer
# gp:EEx1). The attack is the mismatch itself: a Tera-only profile has no
# gp:EEx1 renderer, so it must answer REFUSED:RENDERER_PROFILE_MISMATCH or
# UNSUPPORTED:RENDERER:EEx1 — never a silent Tera fallback attempt, and
# never a crash.
@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix ex: <https://example.org/mkt03/renderer-mismatch#> .

<urn:ggen:pack:mkt03-renderer-mismatch>
    a gp:Pack ;
    gp:name "mkt03-renderer-mismatch" ;
    gp:version "1.0.0" ;
    gp:profile gp:Igniter1 ;
    gp:renderer gp:EEx1 ;
    gp:authorityCeiling gp:Construct .

ex:Hello
    ex:message "Hello from an EEx-only pack." .
