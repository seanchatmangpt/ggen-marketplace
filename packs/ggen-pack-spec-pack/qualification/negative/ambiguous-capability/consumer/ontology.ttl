# T03 invalid corpus — ambiguous-capability consumer
# gp:requiresCapability names the capability; §31 refuses with
# REFUSED:AMBIGUOUS_CAPABILITY_PROVIDER when neither provider is selectable
# by any declared rule. No selection rule exists anywhere in this fixture —
# that absence IS the attack.
@prefix gp: <https://ggen.dev/ns/pack#> .

<urn:ggen:pack:mkt03-capability-consumer>
    a gp:Pack ;
    gp:name "mkt03-capability-consumer" ;
    gp:version "1.0.0" ;
    gp:profile gp:Portable1 ;
    gp:authorityCeiling gp:Construct ;
    gp:requiresCapability <urn:capability:mkt03-rdf-canonicalization> .
