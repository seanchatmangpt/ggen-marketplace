# T03 invalid corpus — ambiguous-capability provider-alpha
# gp:providesCapability claims the same capability as provider-beta; with no
# selection rule (§31), the pair makes resolution ambiguous.
@prefix gp: <https://ggen.dev/ns/pack#> .

<urn:ggen:pack:mkt03-capability-provider-alpha>
    a gp:Pack ;
    gp:name "mkt03-capability-provider-alpha" ;
    gp:version "1.0.0" ;
    gp:profile gp:Portable1 ;
    gp:authorityCeiling gp:Construct ;
    gp:providesCapability <urn:capability:mkt03-rdf-canonicalization> .
