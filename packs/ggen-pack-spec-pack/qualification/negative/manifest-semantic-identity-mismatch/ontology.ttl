# T03 invalid corpus — manifest-semantic-identity-mismatch
# The gp:name below deliberately disagrees with pack.toml's
# name = "mkt03-identity-mismatch-bootstrap" (§8: Project(I_S) = I_B is
# violated; expected REFUSED:PACK_IDENTITY_MISMATCH). Everything else stays
# lawful so the identity law is the only one under attack.
@prefix gp: <https://ggen.dev/ns/pack#> .

<urn:ggen:pack:mkt03-identity-mismatch-semantic>
    a gp:Pack ;
    gp:name "mkt03-identity-mismatch-semantic" ;
    gp:version "1.0.0" ;
    gp:profile gp:Portable1 ;
    gp:authorityCeiling gp:Construct .
