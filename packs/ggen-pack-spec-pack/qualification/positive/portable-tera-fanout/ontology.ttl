# RFC-GPACK-001 §25 — valid-corpus fixture: deterministic Tera fanout.
#
# Three module individuals, each with a UNIQUE ex:rank. The projection query
# (queries/modules.rq) selects ?name ?rank with ORDER BY ?rank — a total
# order over unique keys, so the fanout target set and its order are
# deterministic without appeal to engine row internals (§25: row order is
# meaningful only when the query establishes it).
#
# The template (templates/module.txt.tera) carries the §22 normalized
# frontmatter contract (renderer/query/for_each/to/write) and renders one
# target per binding row. Expected targets, in ORDER BY-derived order, are
# pinned in expected/targets.txt and stated in the positive-corpus README.

@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix ex: <https://example.org/fanout#> .

<urn:ggen:pack:portable-tera-fanout>
    a gp:Pack ;
    gp:name "portable-tera-fanout" ;
    gp:version "1.0.0" ;
    gp:profile gp:Portable1 ;
    gp:renderer gp:Tera1 ;
    gp:authorityCeiling gp:Construct .

ex:module-alpha
    ex:name "alpha" ;
    ex:rank 1 .

ex:module-beta
    ex:name "beta" ;
    ex:rank 2 .

ex:module-gamma
    ex:name "gamma" ;
    ex:rank 3 .
