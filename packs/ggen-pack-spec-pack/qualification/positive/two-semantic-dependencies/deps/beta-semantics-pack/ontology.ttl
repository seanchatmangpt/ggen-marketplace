# Dependee pack for the two-semantic-dependencies fixture (RFC-GPACK-001
# §26/§27). Semantic-only Core pack: pack.toml + ontology.ttl, NO templates/
# directory — lawful per §73 ("A Core ... pack MAY contain no projections").
# Engines that cannot execute semantic-only packs report UNSUPPORTED (§73,
# §83); they do not get to redefine Pack.

@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix beta: <https://example.org/beta-semantics#> .

<urn:ggen:pack:beta-semantics-pack>
    a gp:Pack ;
    gp:name "beta-semantics-pack" ;
    gp:version "1.0.0" ;
    gp:profile gp:Core1 ;
    gp:authorityCeiling gp:Construct .

beta:Rule
    beta:kind "semantic-only" .
