@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix ex: <https://example.org/hello#> .

<urn:ggen:pack:hello-pack>
    a gp:Pack ;
    gp:name "hello-pack" ;
    gp:version "1.0.0" ;
    gp:profile gp:Portable1 ;
    gp:renderer gp:Tera1 ;
    gp:authorityCeiling gp:Construct .

ex:Hello
    ex:message "Hello from admitted RDF." .
