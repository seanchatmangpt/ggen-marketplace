# RFC-GPACK-001 §9 — valid-corpus fixture: consumer alias vs canonical name.
#
# This fixture pack's canonical identity is "acme-payments-pack" (pack.toml
# [pack].name and the graph below agree — §8 identity correspondence). The
# consumer configuration beside it (consumer.toml) assigns the LOCAL alias
# "payments". §9: the engine MUST preserve BOTH —
#
#     consumer_alias = payments
#     canonical_name = acme-payments-pack
#
# — and the alias MUST NOT overwrite canonical identity in receipts or
# dependency resolution. The receipt fields that must carry both forms are
# pinned in expected/receipt.json.
#
# Note: this fixture's directory name ("consumer-alias") deliberately
# differs from the canonical pack name ("acme-payments-pack"). §9 makes
# directory_name == canonical_name a MAY for strict marketplace publication
# only; local composition need not match. Corpus fixtures compose locally,
# so this is lawful, and it doubles as the witness that no engine may infer
# canonical identity from the directory name.

@prefix gp: <https://ggen.dev/ns/pack#> .
@prefix pay: <https://example.org/acme-payments#> .

<urn:ggen:pack:acme-payments-pack>
    a gp:Pack ;
    gp:name "acme-payments-pack" ;
    gp:version "1.0.0" ;
    gp:profile gp:Portable1 ;
    gp:authorityCeiling gp:Construct .

pay:Payment
    pay:ledger "acme-payments-ledger" .
