# ggen-pack-spec-pack gate 010 — pack identity completeness
# (RFC-GPACK-001 §16 gate messages; §10 vocabulary; §14 gate semantics)
#
# Stable refusal identities (the id, not the prose, is the automation key — §16):
#   GPACK-ONTOLOGY-MISSING-NAME      every gp:Pack requires exactly one gp:name
#   GPACK-ONTOLOGY-AMBIGUOUS-NAME    a gp:Pack carries more than one distinct gp:name
#   GPACK-ONTOLOGY-MISSING-VERSION   every gp:Pack requires exactly one gp:version
#   GPACK-ONTOLOGY-AMBIGUOUS-VERSION a gp:Pack carries more than one distinct gp:version
#
# SELECT gate semantics (§14): Violation = RowCount > 0.
# Zero rows on the admitted graph = gate pass.
# Each UNION branch is self-contained (binds its own ?subject) so the query
# is order-independent and engine-portable (§3.8, §51).
PREFIX gp: <https://ggen.dev/ns/pack#>

SELECT ?subject ?violation WHERE {
  {
    ?subject a gp:Pack .
    FILTER NOT EXISTS { ?subject gp:name ?anyName }
    BIND("GPACK-ONTOLOGY-MISSING-NAME" AS ?violation)
  }
  UNION
  {
    ?subject a gp:Pack ;
             gp:name ?nameA , ?nameB .
    FILTER(STR(?nameA) < STR(?nameB))
    BIND("GPACK-ONTOLOGY-AMBIGUOUS-NAME" AS ?violation)
  }
  UNION
  {
    ?subject a gp:Pack .
    FILTER NOT EXISTS { ?subject gp:version ?anyVersion }
    BIND("GPACK-ONTOLOGY-MISSING-VERSION" AS ?violation)
  }
  UNION
  {
    ?subject a gp:Pack ;
             gp:version ?versionA , ?versionB .
    FILTER(STR(?versionA) < STR(?versionB))
    BIND("GPACK-ONTOLOGY-AMBIGUOUS-VERSION" AS ?violation)
  }
}
