# ggen-pack-spec-pack gate 020 — manifest/graph identity correspondence
# (RFC-GPACK-001 §8; §78 Court 2; App. C refusal code)
#
# Admission requires Project(I_S) = I_B: the semantic graph's gp:name for a
# gp:Pack MUST equal the bootstrap identity the pack ships under — the
# pack.toml [pack].name, which this marketplace also requires to equal the
# pack directory name (.agents/rules/pack-contract.md).
#
# A SPARQL gate sees only the admitted graph, so the bootstrap identity is
# pinned below as the literal constant "ggen-pack-spec-pack". This is the
# self-hosted form (§93): for THIS pack the constant is exactly the
# [pack].name in pack.toml. The gate fires on BOTH disagreement modes:
# the graph name missing, or the graph name disagreeing with the manifest.
#
# Stable refusal identity (§16, App. C): REFUSED:PACK_IDENTITY_MISMATCH
# SELECT gate semantics (§14): Violation = RowCount > 0.
PREFIX gp: <https://ggen.dev/ns/pack#>

SELECT ?subject ?violation WHERE {
  ?subject a gp:Pack .
  FILTER NOT EXISTS {
    ?subject gp:name ?name .
    FILTER(STR(?name) = "ggen-pack-spec-pack")
  }
  BIND("REFUSED:PACK_IDENTITY_MISMATCH" AS ?violation)
}
