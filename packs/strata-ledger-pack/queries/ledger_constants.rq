PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX lg:   <https://strata.chatman.ai/ontology/ledger#>

SELECT ?name ?rustType ?value ?comment
WHERE {
  ?c a lg:LedgerConstant ; rdfs:label "LEDGER_CONSTANTS" ; lg:rustType ?rustType .
  {
    ?c lg:maxAccounts ?value .
    BIND("MAX_ACCOUNTS" AS ?name)
    BIND("hard cap on account count in one LedgerState" AS ?comment)
  } UNION {
    ?c lg:transitionGas ?value .
    BIND("TRANSITION_GAS" AS ?name)
    BIND("per-transition gas placeholder (0 = counted, never charged)" AS ?comment)
  } UNION {
    ?c lg:stateRootLen ?value .
    BIND("STATE_ROOT_LEN" AS ?name)
    BIND("state root width in bytes" AS ?comment)
  }
}
ORDER BY ?name
