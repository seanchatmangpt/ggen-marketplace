---
to: packs/strata-ledger-pack/generated/ledger_consts.rs
force: true
freeze_policy: checksum
freeze_slots_dir: .ggen/freeze/strata-ledger-pack
sparql:
  results: >
    PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
    PREFIX lg:   <https://strata.chatman.ai/ontology/ledger#>

    SELECT ?name ?rustType ?value ?comment
    WHERE {
      ?c a lg:LedgerConstant ; rdfs:label "LEDGER_CONSTANTS" ; lg:rustType ?rustType .
      {
        ?c lg:maxAccounts ?value .
        BIND("MAX_ACCOUNTS" AS ?name)
        BIND("hard cap on account count in one LedgerState" AS ?comment)
      } UNION {
        ?c lg:transitionGas ?value .
        BIND("TRANSITION_GAS" AS ?name)
        BIND("per-transition gas placeholder (0 = counted, never charged)" AS ?comment)
      } UNION {
        ?c lg:stateRootLen ?value .
        BIND("STATE_ROOT_LEN" AS ?name)
        BIND("state root width in bytes" AS ?comment)
      }
    } ORDER BY ?name
---
//! Strata ledger constants — GENERATED by `ggen sync run` from the
//! `strata-ledger-pack` ontology (lg:LEDGER_CONSTANTS). Do not edit by hand.
//!
//! Roadmap slice S4: docs/sjira/v26.10.8/STRATA-BLOCKCHAIN-ROADMAP.md

{% if results | length == 0 %}
// REFUSED: empty ontology projection (gate 010 would already have fired).
{% endif %}
{% for row in results %}
/// {{ row.comment }}
pub const {{ row.name }}: {{ row.rustType }} = {{ row.value }};
{% endfor %}
