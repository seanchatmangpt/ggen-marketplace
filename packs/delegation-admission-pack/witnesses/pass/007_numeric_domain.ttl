@prefix da: <https://seanchatmangpt.github.io/packs/delegation-admission#> .
@prefix ex: <https://example.org/delegation-admission/numeric-pass/> .
ex:case a da:DelegationArtifact ;
  da:delegationUnits 0 ;
  da:hasExplain ex:e ;
  da:hasVerify ex:v ;
  da:hasModify ex:m ;
  da:hasAccount ex:a .
ex:e da:scopeUnits 0 .
ex:v da:scopeUnits 1 .
ex:m da:scopeUnits 2 .
ex:a da:scopeUnits 3 .
