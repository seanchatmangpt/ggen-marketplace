@prefix da: <https://seanchatmangpt.github.io/packs/delegation-admission#> .
@prefix ex: <https://example.org/delegation-admission/verifier-id-pass/> .

ex:case a da:DelegationArtifact ;
  da:producerId "urn:producer:a" ;
  da:hasVerify ex:verify .

ex:verify a da:VerifyEvidence ;
  da:verifierId "urn:verifier:b" .
