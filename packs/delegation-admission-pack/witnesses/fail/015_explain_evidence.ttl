@prefix da: <https://seanchatmangpt.github.io/packs/delegation-admission#> .
@prefix ex: <https://example.org/delegation-admission/> .

ex:fail015 a da:DelegationArtifact ;
    da:subjectId "git:fixture/repo@aaaaaaaa" ;
    da:delegationUnits 5 ;
    da:boundaryId "sha256:boundary" ;
    da:authorityScopeId "sha256:authority-scope" ;
    da:hasExplain ex:fail015-explain ;
    da:hasVerify ex:fail015-verify ;
    da:hasModify ex:fail015-modify ;
    da:hasAccount ex:fail015-account .

ex:fail015-explain a da:ExplainEvidence ;
    da:subjectId "git:fixture/repo@aaaaaaaa" ;
    da:scopeUnits 5 ;
    da:verdict "PASS" ;
    da:ontologyId "sha256:ontology" ;
    da:rationaleId "sha256:rationale" .

ex:fail015-verify a da:VerifyEvidence ;
    da:subjectId "git:fixture/repo@aaaaaaaa" ;
    da:scopeUnits 5 ;
    da:verdict "PASS" ;
    da:independent true ;
    da:verifierSetId "sha256:verifiers" ;
    da:receiptId "sha256:verify-receipt" .

ex:fail015-modify a da:ModifyEvidence ;
    da:subjectId "git:fixture/repo@aaaaaaaa" ;
    da:scopeUnits 5 ;
    da:verdict "PASS" ;
    da:changeId "sha256:change" ;
    da:resultId "sha256:result" ;
    da:replayId "sha256:modify-replay" .

ex:fail015-account a da:AccountEvidence ;
    da:subjectId "git:fixture/repo@aaaaaaaa" ;
    da:scopeUnits 5 ;
    da:verdict "PASS" ;
    da:authorityId "sha256:authority" ;
    da:consequenceId "sha256:consequence" ;
    da:receiptId "sha256:account-receipt" ;
    da:replayId "sha256:account-replay" ;
    da:standing "PARTIAL_ALIVE" .
