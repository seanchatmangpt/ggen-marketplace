# MESSAGE: delegation artifact header violation.
# Projection and admission both require exact subject, delegated scope, boundary,
# and authority-scope identity. Missing any header field is a refusal row.
PREFIX da: <https://seanchatmangpt.github.io/packs/delegation-admission#>
SELECT ?artifact ?field WHERE {
  {
    ?artifact a da:DelegationArtifact .
    OPTIONAL { ?artifact da:subjectId ?x . BIND(?x AS ?w) }
    FILTER(!BOUND(?w))
    BIND("subjectId" AS ?field)
  } UNION {
    ?artifact a da:DelegationArtifact .
    OPTIONAL { ?artifact da:delegationUnits ?x . BIND(?x AS ?w) }
    FILTER(!BOUND(?w))
    BIND("delegationUnits" AS ?field)
  } UNION {
    ?artifact a da:DelegationArtifact .
    OPTIONAL { ?artifact da:boundaryId ?x . BIND(?x AS ?w) }
    FILTER(!BOUND(?w))
    BIND("boundaryId" AS ?field)
  } UNION {
    ?artifact a da:DelegationArtifact .
    OPTIONAL { ?artifact da:authorityScopeId ?x . BIND(?x AS ?w) }
    FILTER(!BOUND(?w))
    BIND("authorityScopeId" AS ?field)
  }
}
ORDER BY ?artifact ?field
