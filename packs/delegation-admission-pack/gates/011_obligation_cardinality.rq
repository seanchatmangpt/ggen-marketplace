# MESSAGE: evidence-obligation cardinality violation.
# Each artifact has exactly one node for each of the four conjunctive evidence
# obligations. Multiple distinct nodes would fork the projection and make
# AdmissionCapacity ambiguous.
PREFIX da: <https://seanchatmangpt.github.io/packs/delegation-admission#>
SELECT DISTINCT ?artifact ?edge ?left ?right WHERE {
  VALUES ?edge { da:hasExplain da:hasVerify da:hasModify da:hasAccount }
  ?artifact a da:DelegationArtifact ;
            ?edge ?left, ?right .
  FILTER(?left != ?right)
}
ORDER BY ?artifact ?edge ?left ?right
