# MESSAGE: account-evidence violation.
# Account is the receipt boundary: PASS plus authority, consequence, receipt,
# replay, and standing. Missing any edge means the artifact has no accountable
# standing regardless of whether it functions.
PREFIX da: <https://seanchatmangpt.github.io/packs/delegation-admission#>
SELECT ?artifact ?field WHERE {
  {
    ?artifact a da:DelegationArtifact ; da:hasAccount ?e .
    OPTIONAL { ?e da:verdict ?v . BIND(?v AS ?w) }
    FILTER(!BOUND(?w))
    BIND("verdict" AS ?field)
  } UNION {
    ?artifact a da:DelegationArtifact ; da:hasAccount ?e .
    ?e da:verdict ?v .
    FILTER(?v != "PASS")
    BIND("verdict:not-pass" AS ?field)
  } UNION {
    ?artifact a da:DelegationArtifact ; da:hasAccount ?e .
    OPTIONAL { ?e da:authorityId ?x . BIND(?x AS ?w) }
    FILTER(!BOUND(?w))
    BIND("authorityId" AS ?field)
  } UNION {
    ?artifact a da:DelegationArtifact ; da:hasAccount ?e .
    OPTIONAL { ?e da:consequenceId ?x . BIND(?x AS ?w) }
    FILTER(!BOUND(?w))
    BIND("consequenceId" AS ?field)
  } UNION {
    ?artifact a da:DelegationArtifact ; da:hasAccount ?e .
    OPTIONAL { ?e da:receiptId ?x . BIND(?x AS ?w) }
    FILTER(!BOUND(?w))
    BIND("receiptId" AS ?field)
  } UNION {
    ?artifact a da:DelegationArtifact ; da:hasAccount ?e .
    OPTIONAL { ?e da:replayId ?x . BIND(?x AS ?w) }
    FILTER(!BOUND(?w))
    BIND("replayId" AS ?field)
  } UNION {
    ?artifact a da:DelegationArtifact ; da:hasAccount ?e .
    OPTIONAL { ?e da:standing ?x . BIND(?x AS ?w) }
    FILTER(!BOUND(?w))
    BIND("standing" AS ?field)
  }
}
ORDER BY ?artifact ?field
