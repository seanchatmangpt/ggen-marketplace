# MESSAGE: delegation artifact header cardinality violation.
# Every projected header predicate is functional for one artifact. Multiple
# distinct values would create ambiguous/cross-product JSON projection rows.
PREFIX da: <https://seanchatmangpt.github.io/packs/delegation-admission#>
SELECT DISTINCT ?artifact ?predicate ?left ?right WHERE {
  VALUES ?predicate {
    da:subjectId
    da:delegationUnits
    da:boundaryId
    da:authorityScopeId
  }
  ?artifact a da:DelegationArtifact ;
            ?predicate ?left, ?right .
  FILTER(?left != ?right)
}
ORDER BY ?artifact ?predicate ?left ?right
