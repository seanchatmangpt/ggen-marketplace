@prefix da: <https://seanchatmangpt.github.io/packs/delegation-admission#> .

<urn:fixture:neg>
    a da:DelegationArtifact ;
    da:subjectId "git:fixture/repo@bbbbbbbb" ;
    da:delegationUnits 8 ;
    da:boundaryId "sha256:boundary-neg" ;
    da:authorityScopeId "sha256:authority-neg" ;
    da:hasExplain <urn:fixture:neg:explain> ;
    da:hasVerify <urn:fixture:neg:verify> ;
    da:hasModify <urn:fixture:neg:modify> ;
    da:hasAccount <urn:fixture:neg:account> .

<urn:fixture:neg:explain>
    a da:ExplainEvidence ;
    da:subjectId "git:fixture/repo@bbbbbbbb" ;
    da:scopeUnits 8 ; da:verdict "PASS" ;
    da:provenanceId "sha256:p" ; da:ontologyId "sha256:o" ; da:rationaleId "sha256:r" .

<urn:fixture:neg:verify>
    a da:VerifyEvidence ;
    da:subjectId "git:fixture/repo@bbbbbbbb" ;
    da:scopeUnits 6 ; da:verdict "PASS" ;
    da:independent false ; da:verifierSetId "sha256:v" ; da:receiptId "sha256:vr" .

<urn:fixture:neg:modify>
    a da:ModifyEvidence ;
    da:subjectId "git:fixture/repo@bbbbbbbb" ;
    da:scopeUnits 7 ; da:verdict "PASS" ;
    da:changeId "sha256:c" ; da:resultId "sha256:rr" ; da:replayId "sha256:rp" .

<urn:fixture:neg:account>
    a da:AccountEvidence ;
    da:subjectId "git:fixture/repo@bbbbbbbb" ;
    da:scopeUnits 8 ; da:verdict "PASS" ;
    da:authorityId "sha256:a" ; da:consequenceId "sha256:k" ;
    da:receiptId "sha256:r" ; da:replayId "sha256:rp2" ; da:standing "ALIVE" .
