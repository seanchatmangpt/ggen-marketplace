@prefix da: <https://seanchatmangpt.github.io/packs/delegation-admission#> .

<urn:fixture:pos>
    a da:DelegationArtifact ;
    da:subjectId "git:fixture/repo@aaaaaaaa" ;
    da:delegationUnits 5 ;
    da:boundaryId "sha256:boundary-pos" ;
    da:authorityScopeId "sha256:authority-pos" ;
    da:hasExplain <urn:fixture:pos:explain> ;
    da:hasVerify <urn:fixture:pos:verify> ;
    da:hasModify <urn:fixture:pos:modify> ;
    da:hasAccount <urn:fixture:pos:account> .

<urn:fixture:pos:explain>
    a da:ExplainEvidence ;
    da:subjectId "git:fixture/repo@aaaaaaaa" ;
    da:scopeUnits 5 ; da:verdict "PASS" ;
    da:provenanceId "sha256:p" ; da:ontologyId "sha256:o" ; da:rationaleId "sha256:r" .

<urn:fixture:pos:verify>
    a da:VerifyEvidence ;
    da:subjectId "git:fixture/repo@aaaaaaaa" ;
    da:scopeUnits 5 ; da:verdict "PASS" ;
    da:independent true ; da:verifierSetId "sha256:v" ; da:receiptId "sha256:vr" .

<urn:fixture:pos:modify>
    a da:ModifyEvidence ;
    da:subjectId "git:fixture/repo@aaaaaaaa" ;
    da:scopeUnits 5 ; da:verdict "PASS" ;
    da:changeId "sha256:c" ; da:resultId "sha256:rr" ; da:replayId "sha256:rp" .

<urn:fixture:pos:account>
    a da:AccountEvidence ;
    da:subjectId "git:fixture/repo@aaaaaaaa" ;
    da:scopeUnits 5 ; da:verdict "PASS" ;
    da:authorityId "sha256:a" ; da:consequenceId "sha256:k" ;
    da:receiptId "sha256:r" ; da:replayId "sha256:rp2" ; da:standing "ALIVE" .
