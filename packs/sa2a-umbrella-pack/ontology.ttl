# sa2a-umbrella-pack: composition-only membership list (UmbrellaPack).
# No domain semantics. Member identities are the members' own provides URNs.

@prefix um:   <http://seanchatmangpt.github.io/packs/sa2a-umbrella#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

<http://seanchatmangpt.github.io/packs/sa2a-umbrella> a owl:Ontology ;
    rdfs:label "sa2a-umbrella-pack ontology" ;
    rdfs:comment "Composition-only. Standing UNKNOWN. Grants no authority beyond each member's own ceiling." ;
    owl:versionInfo "0.1.0" .

um:Member a rdfs:Class ;
    rdfs:label "A pack composed by the umbrella, identified by its provides URN." .

um:memberUrn a rdfs:Resource ;
    rdfs:domain um:Member .

um:m_bridge a um:Member ; um:memberUrn "urn:ggen:pack:sa2a-bridge-pack" .
um:m_chicago_court a um:Member ; um:memberUrn "urn:ggen:pack:sa2a-chicago-court-pack" .
um:m_semantic_diataxis a um:Member ; um:memberUrn "urn:ggen:pack:sa2a-semantic-diataxis-pack" .
um:m_semantic_evidence a um:Member ; um:memberUrn "urn:ggen:pack:sa2a-semantic-evidence-pack" .
um:m_spark_dsl a um:Member ; um:memberUrn "urn:ggen:pack:sa2a-spark-dsl-pack" .
um:m_fastapi a um:Member ; um:memberUrn "urn:ggen:pack:sa2a-fastapi-pack" .
um:m_governed_process a um:Member ; um:memberUrn "urn:ggen:pack:sa2a-governed-process-pack" .
um:m_a2a_conformance a um:Member ; um:memberUrn "urn:ggen:pack:a2a-conformance-pack" .
