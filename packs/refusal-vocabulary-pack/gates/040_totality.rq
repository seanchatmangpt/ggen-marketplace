# MESSAGE: any returned row refuses manufacture. G4: totality — exactly 51
# erlmcp code mappings and exactly 18 declared ash_a2a classes. Any drift
# (an added, removed, or mistyped individual) is a violation row.
PREFIX rv:  <urn:refusal-vocabulary:>
SELECT ?kind ?count (COALESCE(?pm, ?pc) AS ?problem) WHERE {
  { SELECT (COUNT(DISTINCT ?m) AS ?mc) WHERE { ?m a rv:RefusalMapping } }
  { SELECT (COUNT(DISTINCT ?c) AS ?cc) WHERE { ?c a rv:RefusalClass } }
  {
    BIND("mappings" AS ?kind)
    BIND(?mc AS ?count)
    FILTER (?mc != 51)
    BIND("mapping-count-drift" AS ?pm)
  }
  UNION
  {
    BIND("classes" AS ?kind)
    BIND(?cc AS ?count)
    FILTER (?cc != 18)
    BIND("class-count-drift" AS ?pc)
  }
}
ORDER BY ?kind
