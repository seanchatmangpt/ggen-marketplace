# MESSAGE: any returned row refuses manufacture. G7 (closure-style totality
# for the fifth column, ash_graphlaw): every rv:GraphlawMapping is complete
# (code atom + graphlawClass + brokenTerm present), targets a declared
# rv:RefusalClass, targets EXACTLY ONE class, declares its code atom exactly
# once (no duplicate atoms), and honors the fail-closed disposition law:
# rv:ashA2aClass and rv:unmappedDisposition are mutually exclusive, and a
# mapping with neither refuses (no silent gaps).
PREFIX rv:  <urn:refusal-vocabulary:>
SELECT ?s (COALESCE(?p1, ?p2, ?p3, ?p4, ?p5, ?p6, ?p7) AS ?problem) WHERE {
  {
    ?m a rv:GraphlawMapping .
    FILTER NOT EXISTS { ?m rv:ashGraphlawCode ?code }
    BIND(?m AS ?s) BIND("graphlaw-mapping-without-code" AS ?p1)
  }
  UNION
  {
    ?m a rv:GraphlawMapping .
    FILTER NOT EXISTS { ?m rv:graphlawClass ?gc }
    BIND(?m AS ?s) BIND("graphlaw-mapping-without-graphlawClass" AS ?p2)
  }
  UNION
  {
    ?m a rv:GraphlawMapping .
    FILTER NOT EXISTS { ?m rv:brokenTerm ?bt }
    BIND(?m AS ?s) BIND("graphlaw-mapping-without-brokenTerm" AS ?p3)
  }
  UNION
  {
    ?m a rv:GraphlawMapping .
    FILTER NOT EXISTS { ?m rv:unmappedDisposition ?ud }
    OPTIONAL { ?m rv:ashA2aClass ?c }
    FILTER (!BOUND(?c))
    BIND(?m AS ?s) BIND("graphlaw-mapping-without-class-or-disposition" AS ?p4)
  }
  UNION
  {
    ?m a rv:GraphlawMapping ; rv:ashA2aClass ?c .
    FILTER NOT EXISTS { ?c a rv:RefusalClass }
    BIND(?m AS ?s) BIND("graphlaw-mapping-to-undeclared-class" AS ?p5)
  }
  UNION
  {
    ?m a rv:GraphlawMapping ; rv:ashA2aClass ?c1 ; rv:ashA2aClass ?c2 .
    FILTER (?c1 != ?c2)
    BIND(?m AS ?s) BIND("graphlaw-mapping-to-more-than-one-class" AS ?p6)
  }
  UNION
  {
    ?m a rv:GraphlawMapping ; rv:ashGraphlawCode ?code .
    {
      SELECT ?code (COUNT(DISTINCT ?m2) AS ?k) WHERE {
        ?m2 a rv:GraphlawMapping ; rv:ashGraphlawCode ?code .
      } GROUP BY ?code
    }
    FILTER (?k > 1)
    BIND(?m AS ?s) BIND("graphlaw-code-declared-more-than-once" AS ?p7)
  }
}
ORDER BY ?s ?problem
