PREFIX rv:  <urn:refusal-vocabulary:>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?code ?macro ?className ?classKind ?jsonrpc ?http ?severity ?desc
WHERE {
  ?m a rv:RefusalMapping ;
     rv:erlmcpCode ?code ;
     rv:macro ?macro ;
     rv:ashA2aClass ?cls ;
     rv:httpStatus ?http ;
     rv:severity ?severity ;
     dct:description ?desc .
  ?cls rv:className ?className ; rv:classKind ?classKind .
  OPTIONAL { ?m rv:jsonRpcCode ?jsonrpc }
}
ORDER BY ?code
