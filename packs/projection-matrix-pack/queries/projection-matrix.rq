PREFIX pm: <https://chatmangpt.com/ggen/projection-matrix#>
SELECT ?projection ?subject ?consumer ?adapter ?targetPath ?templatePath ?packageName ?moduleName ?sourceIdentity ?sourceDigest
WHERE {
  ?projection a pm:Projection ;
    pm:subject ?subject ;
    pm:consumer ?consumer ;
    pm:adapter ?adapter ;
    pm:targetPath ?targetPath .
  ?adapter pm:templatePath ?templatePath .
  ?subject pm:sourceIdentity ?sourceIdentity .
  OPTIONAL { ?subject pm:sourceDigest ?sourceDigest }
  OPTIONAL { ?projection pm:packageName ?packageName }
  OPTIONAL { ?projection pm:moduleName ?moduleName }
}
ORDER BY ?subject ?consumer ?adapter ?targetPath
