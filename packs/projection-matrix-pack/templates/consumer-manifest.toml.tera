# Generated from canonical projection semantics. Do not hand edit.
[projection]
subject = "{{ sourceIdentity }}"
consumer = "{{ consumer }}"
adapter = "{{ adapter }}"
target = "{{ targetPath }}"
{% if sourceDigest %}source_digest = "{{ sourceDigest }}"{% endif %}
{% if packageName %}package = "{{ packageName }}"{% endif %}
{% if moduleName %}module = "{{ moduleName }}"{% endif %}
