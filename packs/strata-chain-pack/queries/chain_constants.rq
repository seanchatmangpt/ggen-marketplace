PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX st:   <https://strata.chatman.ai/ontology#>

SELECT ?name ?rustType ?value ?comment
WHERE {
  ?c a st:ChainConstant ; rdfs:label "GENESIS_CONSTANTS" ; st:rustType ?rustType .
  {
    ?c st:genesisHeight ?value .
    BIND("GENESIS_HEIGHT" AS ?name)
    BIND("height of the genesis block" AS ?comment)
  } UNION {
    ?c st:maxBlockTxs ?value .
    BIND("MAX_BLOCK_TXS" AS ?name)
    BIND("hard cap on tx digests per block" AS ?comment)
  } UNION {
    ?c st:initialDifficultyTarget ?value .
    BIND("INITIAL_DIFFICULTY_TARGET" AS ?name)
    BIND("required leading zero bits in the PoW digest" AS ?comment)
  }
}
ORDER BY ?name
