# Shared-head KAT fixture (lane L9): the same four entries folded by
# insa-proof's sync replay law and strata-protocol's logchain law
# (cross-repo pin `05ea1aa0...`). verify.py recomputes the head from these
# witnesses and asserts equality with the pinned literal.
sw:kat-entry-1 sw:pn "0x0001000000000001" ; sw:ocel "0x0A00000000000001" .
sw:kat-entry-2 sw:pn "0x0002000000000002" ; sw:ocel "0x0B00000000000002" .
sw:kat-entry-3 sw:pn "0x0003000000000003" ; sw:ocel "0x0C00000000000003" .
sw:kat-entry-4 sw:pn "0x0004000000000004" ; sw:ocel "0x0D00000000000004" .

sw:shared-kat a sw:GateRun ;
    sw:gate "shared-head-kat" ;
    sw:sharedKatHead "05ea1aa096f45968aacb2c996d2b541e4b9fdef24f006e0204e1fa88d33f68a5" ;
    sw:date "2026-10-13" ;
    sw:andon "Green" ;
    sw:zeroRows true .

sw:gate-020_chain_law a sw:GateRun ;
