# MESSAGE: any afl:FaultCatalogEntry whose afl:catalogComponentRef does not point at a
# real afl:Component individual in afl:ComponentScheme, or whose afl:catalogFailureModeRef
# does not point at a real afl:FailureMode individual in afl:FailureModeScheme, is an
# unknown or misspelled fault code that must be refused before admission -- a customer
# fault catalog is only meaningful if every entry resolves to a term this taxonomy actually
# enumerates.
PREFIX afl: <urn:autofde-lab:>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?s ?p ?value WHERE {
  {
    ?s a afl:FaultCatalogEntry ; afl:catalogComponentRef ?value . BIND(afl:catalogComponentRef AS ?p)
    FILTER NOT EXISTS { ?value a afl:Component ; skos:inScheme afl:ComponentScheme }
  } UNION {
    ?s a afl:FaultCatalogEntry ; afl:catalogFailureModeRef ?value . BIND(afl:catalogFailureModeRef AS ?p)
    FILTER NOT EXISTS { ?value a afl:FailureMode ; skos:inScheme afl:FailureModeScheme }
  }
}
ORDER BY ?s ?p
