@prefix afl: <urn:autofde-lab:> .
@prefix cust: <urn:example-customer:fault-catalog:> .

#: A valid customer fault catalog: every entry resolves to a real Component and
#: FailureMode individual enumerated in ontology.ttl.

cust:entry-pod-crashloop
    a afl:FaultCatalogEntry ;
    afl:catalogComponentRef afl:Pod ;
    afl:catalogFailureModeRef afl:CrashLoopBackOff .

cust:entry-node-oomkilled
    a afl:FaultCatalogEntry ;
    afl:catalogComponentRef afl:Node ;
    afl:catalogFailureModeRef afl:OOMKilled .

cust:entry-service-notready
    a afl:FaultCatalogEntry ;
    afl:catalogComponentRef afl:Service ;
    afl:catalogFailureModeRef afl:NotReady .

cust:entry-rbac-forbidden
    a afl:FaultCatalogEntry ;
    afl:catalogComponentRef afl:RBAC ;
    afl:catalogFailureModeRef afl:Forbidden .
