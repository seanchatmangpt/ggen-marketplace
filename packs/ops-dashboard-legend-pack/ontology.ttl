@prefix pack: <urn:ggen-marketplace:ops-dashboard-legend-pack:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pack:Legend a pack:ReactComponent ;
    rdfs:label "Legend" ;
    pack:persistent true ;
    pack:showsNumericRange true ;
    rdfs:comment "Card mapping each STATUS_COLOR entry to its label and each size class to its real min-max metric range." .

pack:DashboardTabs a pack:ReactComponent ;
    rdfs:label "DashboardTabs" ;
    pack:tabOne "spatial (OpsDeckCanvas)" ;
    pack:tabTwo "table (shadcn Table) — same entity data" ;
    rdfs:comment "shadcn Tabs switching between the spatial deck.gl view and a plain shadcn Table of the identical entity list." .

pack:OpsDashboardPage a pack:ReactComponent ;
    rdfs:label "OpsDashboardPage" ;
    pack:composesPacks "deterministic-layout-pack, deckgl-orthographic-layers-pack, deckgl-entity-picking-panel-pack, shadcn-command-palette-pack, shadcn-async-states-pack, shadcn-dark-theme-tokens-pack, live-data-polling-pack, ops-dashboard-legend-pack" ;
    pack:handEditsRequired false ;
    rdfs:comment "Top-level App Router page wiring useLiveData -> loading/empty/error states -> OpsDeckCanvas + EntityDetailPanel + CommandPalette + Legend + DashboardTabs. Zero hand edits required after ggen sync run." .
