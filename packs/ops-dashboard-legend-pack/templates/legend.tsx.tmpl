---
to: "components/deck/Legend.tsx"
---
{% raw %}
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { STATUS_COLOR, type DeckEntity } from "./OpsDeckCanvas";

function rgba([r, g, b, a]: [number, number, number, number]) {
  return `rgba(${r}, ${g}, ${b}, ${a / 255})`;
}

export function Legend({ entities }: { entities: DeckEntity[] }) {
  const metrics = entities.map((e) => e.metric);
  const min = metrics.length ? Math.min(...metrics) : 0;
  const max = metrics.length ? Math.max(...metrics) : 0;

  return (
    <Card className="w-64">
      <CardHeader>
        <CardTitle className="text-sm">Legend</CardTitle>
      </CardHeader>
      <CardContent className="space-y-3 text-sm">
        <div>
          <div className="mb-1 text-xs text-muted-foreground">Status (color)</div>
          {(Object.keys(STATUS_COLOR) as Array<keyof typeof STATUS_COLOR>).map((status) => (
            <div key={status} className="flex items-center gap-2">
              <span
                className="inline-block h-3 w-3 rounded-full"
                style={{ backgroundColor: rgba(STATUS_COLOR[status]) }}
              />
              <span className="capitalize">{status}</span>
            </div>
          ))}
        </div>
        <div>
          <div className="mb-1 text-xs text-muted-foreground">Marker size (metric)</div>
          <div>
            range: {min} – {max}
          </div>
        </div>
      </CardContent>
    </Card>
  );
}
{% endraw %}
