to: "app/ops-dashboard/page.tsx"
---
{% raw %}
"use client";

import "@/styles/ops-dashboard-theme.css";
import { useState } from "react";
import { useLiveData } from "@/lib/data/useLiveData";
import { DashboardSkeleton } from "@/components/states/DashboardSkeleton";
import { EmptyState, ErrorState } from "@/components/states/AsyncStates";
import { DashboardTabs } from "@/components/deck/DashboardTabs";
import { EntityDetailPanel } from "@/components/deck/EntityDetailPanel";
import { Legend } from "@/components/deck/Legend";
import { CommandPalette } from "@/components/command-palette";
import { ThemeProvider } from "@/components/theme/ThemeProvider";
import { ThemeToggle } from "@/components/theme/ThemeToggle";
import type { DeckEntity, DeckEdge } from "@/components/deck/OpsDeckCanvas";

/**
 * Zero-touch ops dashboard: every component below is generated by a
 * ggen-marketplace pack — this file is the only hand-composed wiring point,
 * and it is itself a ggen-generated template.
 */
export default function OpsDashboardPage() {
  const { entities, edges, isLoading, error, refresh } = useLiveData<DeckEntity, DeckEdge>(
    "/api/ops-dashboard/entities",
  );
  const [selected, setSelected] = useState<DeckEntity | null>(null);

  return (
    <ThemeProvider>
      <div className="min-h-screen bg-background text-foreground p-6">
        <header className="mb-4 flex items-center justify-between">
          <h1 className="text-lg font-semibold">Operations Dashboard</h1>
          <ThemeToggle />
        </header>

        {isLoading && entities.length === 0 ? (
          <DashboardSkeleton />
        ) : error ? (
          <ErrorState error={error} onRetry={refresh} />
        ) : entities.length === 0 ? (
          <EmptyState />
        ) : (
          <div className="grid grid-cols-[1fr_320px] gap-4">
            <div className="space-y-4">
              <DashboardTabs entities={entities} edges={edges} onPick={setSelected} />
              <Legend entities={entities} />
            </div>
            <EntityDetailPanel entity={selected} />
          </div>
        )}

        <CommandPalette
          entities={entities.map((e) => ({ id: e.id, label: e.label }))}
          onSelect={(picked) => {
            const full = entities.find((e) => e.id === picked.id) ?? null;
            setSelected(full);
          }}
        />
      </div>
    </ThemeProvider>
  );
}
{% endraw %}
