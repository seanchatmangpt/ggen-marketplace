castle:f5-self-004 a castle:BoardRequirement ; castle:order 690 ; dcterms:identifier "F5-SELF-004" ; castle:category "self-governance" ; dcterms:description "Independent verification agrees with CASTLE self-verification." ; castle:metric "independent_castle_verifier_agreement_bps" ; castle:comparator "GTE" ; castle:target "10000" ; castle:authority "REQUIRED" ; prov:wasDerivedFrom castle:board-castle-self-exemption .
castle:f5-self-005 a castle:BoardRequirement ; castle:order 700 ; dcterms:identifier "F5-SELF-005" ; castle:category "self-governance" ; dcterms:description "CASTLE has no self-exemption path around its own admission boundary." ; castle:metric "castle_self_exemption_path_count" ; castle:comparator "EQ" ; castle:target "0" ; castle:authority "REQUIRED" ; prov:wasDerivedFrom castle:board-castle-self-exemption .

castle:f5-key-001 a castle:BoardRequirement ; castle:order 710 ; dcterms:identifier "F5-KEY-001" ; castle:category "cryptographic-trust" ; dcterms:description "All active receipt keys are present in the admitted key inventory." ; castle:metric "admitted_key_inventory_coverage_bps" ; castle:comparator "GTE" ; castle:target "10000" ; castle:authority "REQUIRED" ; prov:wasDerivedFrom castle:board-root-of-trust-compromise .
