castle:f5-evid-004 a castle:BoardRequirement ; castle:order 610 ; dcterms:identifier "F5-EVID-004" ; castle:category "evidence" ; dcterms:description "Evidence payloads are cryptographically bound to their receipts." ; castle:metric "evidence_receipt_payload_binding_bps" ; castle:comparator "GTE" ; castle:target "10000" ; castle:authority "REQUIRED" ; prov:wasDerivedFrom castle:board-evidence-forgery .
castle:f5-evid-005 a castle:BoardRequirement ; castle:order 620 ; dcterms:identifier "F5-EVID-005" ; castle:category "evidence" ; dcterms:description "Receipt parent DAGs verify without missing parents or cycles." ; castle:metric "receipt_parent_dag_verification_bps" ; castle:comparator "GTE" ; castle:target "10000" ; castle:authority "REQUIRED" ; prov:wasDerivedFrom castle:board-evidence-forgery .
castle:f5-evid-006 a castle:BoardRequirement ; castle:order 630 ; dcterms:identifier "F5-EVID-006" ; castle:category "evidence" ; dcterms:description "Receipt trust roots are verified for every admitted evidence item." ; castle:metric "trusted_root_verification_bps" ; castle:comparator "GTE" ; castle:target "10000" ; castle:authority "REQUIRED" ; prov:wasDerivedFrom castle:board-evidence-forgery .
castle:f5-evid-007 a castle:BoardRequirement ; castle:order 640 ; dcterms:identifier "F5-EVID-007" ; castle:category "evidence" ; dcterms:description "Evidence signed by revoked keys is rejected." ; castle:metric "revoked_key_rejection_bps" ; castle:comparator "GTE" ; castle:target "10000" ; castle:authority "REQUIRED" ; prov:wasDerivedFrom castle:board-evidence-forgery .
castle:f5-evid-008 a castle:BoardRequirement ; castle:order 650 ; dcterms:identifier "F5-EVID-008" ; castle:category "evidence" ; dcterms:description "Admitted receipt DAGs contain no orphan receipts." ; castle:metric "orphan_receipt_count" ; castle:comparator "EQ" ; castle:target "0" ; castle:authority "REQUIRED" ; prov:wasDerivedFrom castle:board-evidence-forgery .

castle:f5-self-001 a castle:BoardRequirement ; castle:order 660 ; dcterms:identifier "F5-SELF-001" ; castle:category "self-governance" ; dcterms:description "CASTLE consequential changes are fully receipted." ; castle:metric "castle_change_receipt_coverage_bps" ; castle:comparator "GTE" ; castle:target "10000" ; castle:authority "REQUIRED" ; prov:wasDerivedFrom castle:board-castle-self-exemption .
castle:f5-self-002 a castle:BoardRequirement ; castle:order 670 ; dcterms:identifier "F5-SELF-002" ; castle:category "self-governance" ; dcterms:description "CASTLE builds have verified provenance." ; castle:metric "castle_build_provenance_coverage_bps" ; castle:comparator "GTE" ; castle:target "10000" ; castle:authority "REQUIRED" ; prov:wasDerivedFrom castle:board-castle-self-exemption .
