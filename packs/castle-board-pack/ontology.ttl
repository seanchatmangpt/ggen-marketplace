@prefix castle: <https://chatmangpt.com/ontology/castle#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

castle:BoardAdversarialGoal a rdfs:Class ;
  rdfs:subClassOf castle:AdversarialGoal .
castle:BoardRequirement a rdfs:Class ;
  rdfs:subClassOf castle:Fortune5Requirement, odrl:Constraint, prov:Entity .

castle:fortune5-board-admission-profile a odrl:Policy, prov:Entity ;
  dcterms:title "CASTLE Fortune-5 Board Admission Profile" ;
  dcterms:description "DfCM extension derived from Fortune-5 board vetoes. Board standing requires the base CASTLE readiness profile and every board requirement." ;
  castle:authority "BOARD_ADMISSION_GATE" .

castle:board-evidence-forgery a castle:BoardAdversarialGoal ;
  castle:order 160 ; castle:identifier "BoardEvidenceForgery" ; castle:slug "board-evidence-forgery" ;
  dcterms:description "An attacker manufactures evidence that appears admissible without cryptographic standing." ;
  castle:authority "PROHIBITED" ; castle:predicate "goal:board-evidence-forgery" ; castle:consequence 100 .

castle:board-castle-self-exemption a castle:BoardAdversarialGoal ;
  castle:order 161 ; castle:identifier "BoardCastleSelfExemption" ; castle:slug "board-castle-self-exemption" ;
  dcterms:description "CASTLE bypasses or weakens the controls it imposes on enterprise subjects." ;
  castle:authority "PROHIBITED" ; castle:predicate "goal:board-castle-self-exemption" ; castle:consequence 100 .

castle:board-root-of-trust-compromise a castle:BoardAdversarialGoal ;
  castle:order 162 ; castle:identifier "BoardRootOfTrustCompromise" ; castle:slug "board-root-of-trust-compromise" ;
  dcterms:description "Compromised trust material preserves false standing or prevents recovery." ;
  castle:authority "PROHIBITED" ; castle:predicate "goal:board-root-of-trust-compromise" ; castle:consequence 100 .

castle:board-castle-availability-failure a castle:BoardAdversarialGoal ;
  castle:order 163 ; castle:identifier "BoardCastleAvailabilityFailure" ; castle:slug "board-castle-availability-failure" ;
  dcterms:description "CASTLE unavailability creates uncontrolled, unreceipted, or ambiguous actuation." ;
  castle:authority "PROHIBITED" ; castle:predicate "goal:board-castle-availability-failure" ; castle:consequence 100 .

castle:board-risk-policy-drift a castle:BoardAdversarialGoal ;
  castle:order 164 ; castle:identifier "BoardRiskPolicyDrift" ; castle:slug "board-risk-policy-drift" ;
  dcterms:description "Operational controls diverge from admitted board risk appetite or accountable policy." ;
  castle:authority "PROHIBITED" ; castle:predicate "goal:board-risk-policy-drift" ; castle:consequence 100 .

castle:board-materiality-miss a castle:BoardAdversarialGoal ;
  castle:order 165 ; castle:identifier "BoardMaterialityMiss" ; castle:slug "board-materiality-miss" ;
  dcterms:description "A material event is not deterministically classified, escalated, and receipted." ;
  castle:authority "PROHIBITED" ; castle:predicate "goal:board-materiality-miss" ; castle:consequence 100 .

castle:board-assurance-capture a castle:BoardAdversarialGoal ;
  castle:order 166 ; castle:identifier "BoardAssuranceCapture" ; castle:slug "board-assurance-capture" ;
  dcterms:description "CASTLE self-attestation substitutes for independent assurance." ;
  castle:authority "PROHIBITED" ; castle:predicate "goal:board-assurance-capture" ; castle:consequence 100 .

castle:board-vendor-lock-in a castle:BoardAdversarialGoal ;
  castle:order 167 ; castle:identifier "BoardVendorLockIn" ; castle:slug "board-vendor-lock-in" ;
  dcterms:description "Historical verification or evidence standing depends on a CASTLE-operated service." ;
  castle:authority "PROHIBITED" ; castle:predicate "goal:board-vendor-lock-in" ; castle:consequence 100 .

castle:board-financial-control-bypass a castle:BoardAdversarialGoal ;
  castle:order 168 ; castle:identifier "BoardFinancialControlBypass" ; castle:slug "board-financial-control-bypass" ;
  dcterms:description "A financial-reporting subject or management override bypasses ICFR evidence and segregation controls." ;
  castle:authority "PROHIBITED" ; castle:predicate "goal:board-financial-control-bypass" ; castle:consequence 100 .

castle:board-evidence-blindness a castle:BoardAdversarialGoal ;
  castle:order 169 ; castle:identifier "BoardEvidenceBlindness" ; castle:slug "board-evidence-blindness" ;
  dcterms:description "Board reporting cannot trace risk claims back to controls, receipts, and source events." ;
  castle:authority "PROHIBITED" ; castle:predicate "goal:board-evidence-blindness" ; castle:consequence 100 .

