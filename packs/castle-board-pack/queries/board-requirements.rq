PREFIX castle: <https://chatmangpt.com/ontology/castle#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?order ?controlId ?category ?description ?metric ?comparator ?target ?authority
WHERE {
  ?requirement a castle:BoardRequirement ;
    castle:order ?order ;
    dcterms:identifier ?controlId ;
    castle:category ?category ;
    dcterms:description ?description ;
    castle:metric ?metric ;
    castle:comparator ?comparator ;
    castle:target ?target ;
    castle:authority ?authority .
}
ORDER BY ?order