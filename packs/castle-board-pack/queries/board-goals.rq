PREFIX castle: <https://chatmangpt.com/ontology/castle#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?order ?identifier ?slug ?description ?predicate ?consequence ?authority
WHERE {
  ?goal a castle:BoardAdversarialGoal ;
    castle:order ?order ;
    castle:identifier ?identifier ;
    castle:slug ?slug ;
    dcterms:description ?description ;
    castle:predicate ?predicate ;
    castle:consequence ?consequence ;
    castle:authority ?authority .
}
ORDER BY ?order