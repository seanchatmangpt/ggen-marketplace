# MESSAGE: FastMCP servers and tools must be dependency-closed, documented, and renderable as valid Python identifiers. Any row is a refusal.
#
# COMPOSABILITY (2026-08-16): branches 1-2 formerly required the SUBJECT's own IRI to start
# with this pack's namespace. templates/fastmcp_server.py.tmpl projects `?server a fmcp:Server`
# and `?tool a fmcp:Tool` with no such filter, so a consumer-minted server/tool under the
# consumer's own namespace was rendered into generated Python while being structurally
# unreachable by these two checks. Union-graph safety is already total without it: the class
# IRIs fmcp:Server / fmcp:Tool and every VALUES ?property are namespace-exact on their own.
PREFIX fmcp: <http://seanchatmangpt.github.io/packs/fastmcp#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?subject ?violation WHERE {
  {
    ?subject a fmcp:Server .
    VALUES ?property { fmcp:name fmcp:hasTool dcterms:title dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a fmcp:Tool .
    VALUES ?property { fmcp:name fmcp:function fmcp:argument fmcp:argumentDescription fmcp:returnTemplate dcterms:description }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(CONCAT("missing ", STR(?property)) AS ?violation)
  } UNION {
    ?subject a fmcp:Server ; fmcp:hasTool ?tool .
    FILTER NOT EXISTS { ?tool a fmcp:Tool }
    BIND("hasTool target is not an fmcp:Tool" AS ?violation)
  } UNION {
    ?subject a fmcp:Tool ; fmcp:function ?value .
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("function is not a Python identifier" AS ?violation)
  } UNION {
    ?subject a fmcp:Tool ; fmcp:argument ?value .
    FILTER(!REGEX(STR(?value), "^[A-Za-z_][A-Za-z0-9_]*$"))
    BIND("argument is not a Python identifier" AS ?violation)
  }
}
ORDER BY ?subject ?violation
