# Analytical control surface: list the PragProg TPS standard work and its TPS mechanism(s).
PREFIX pp: <https://ggen.dev/pragprog/>

SELECT ?tip ?number ?court ?mechanism WHERE {
  pp:PragProgTPS pp:includesTip ?tip .
  ?tip pp:number ?number ;
       pp:court ?court ;
       pp:tpsMechanism ?mechanism .
}
ORDER BY ?number ?mechanism
