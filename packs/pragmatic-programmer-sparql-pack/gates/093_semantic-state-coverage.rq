# MESSAGE: PP-093 known reachable semantic state requires test coverage
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip093 .
  FILTER NOT EXISTS { ?subject pp:stateCoverageReceipt ?value . }
}
ORDER BY ?subject
