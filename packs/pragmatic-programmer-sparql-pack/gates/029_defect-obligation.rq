# MESSAGE: PP-029 known defect requires active repair obligation
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip029 .
  FILTER NOT EXISTS { ?subject pp:repairObligation ?value . }
}
ORDER BY ?subject
