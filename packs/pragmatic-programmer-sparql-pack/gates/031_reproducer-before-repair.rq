# MESSAGE: PP-031 repair requires reproducing test
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip031 .
  FILTER NOT EXISTS { ?subject pp:reproducer ?value . }
}
ORDER BY ?subject
