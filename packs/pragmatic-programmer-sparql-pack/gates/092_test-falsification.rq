# MESSAGE: PP-092 test suite requires mutation or sabotage evidence
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip092 .
  FILTER NOT EXISTS { ?subject pp:testSuiteFalsificationReceipt ?value . }
}
ORDER BY ?subject
