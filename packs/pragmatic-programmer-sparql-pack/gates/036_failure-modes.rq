# MESSAGE: PP-036 fallible capability requires explicit failure mode
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip036 .
  FILTER NOT EXISTS { ?subject pp:failureMode ?value . }
}
ORDER BY ?subject
