# MESSAGE: PP-043 forecast beyond evidence horizon requires uncertainty bound
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip043 .
  FILTER NOT EXISTS { ?subject pp:uncertaintyBound ?value . }
}
ORDER BY ?subject
