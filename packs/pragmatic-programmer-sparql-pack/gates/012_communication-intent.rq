# MESSAGE: PP-012 communication requires audience and purpose
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip012 .
  FILTER (NOT EXISTS { ?subject pp:audience ?a . } || NOT EXISTS { ?subject pp:purpose ?b . })
}
ORDER BY ?subject
