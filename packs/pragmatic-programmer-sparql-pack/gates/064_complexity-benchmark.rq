# MESSAGE: PP-064 complexity claim requires target-environment benchmark
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip064 .
  FILTER NOT EXISTS { ?subject pp:benchmarkReceipt ?value . }
}
ORDER BY ?subject
