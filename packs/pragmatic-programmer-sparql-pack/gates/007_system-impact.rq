# MESSAGE: PP-007 local change requires system-impact observation
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip007 .
  FILTER NOT EXISTS { ?subject pp:systemImpact ?value . }
}
ORDER BY ?subject
