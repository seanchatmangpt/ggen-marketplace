# MESSAGE: PP-095 repeated manual operating procedure requires manufacturer
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject ?value WHERE {
  ?subject pp:governedBy pp:tip095 ;
           pp:manualOccurrenceCount ?value .
  FILTER (?value >= 3)
}
ORDER BY ?subject
