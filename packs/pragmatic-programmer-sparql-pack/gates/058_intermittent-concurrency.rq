# MESSAGE: PP-058 intermittent failure requires concurrency investigation
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip058 .
  FILTER NOT EXISTS { ?subject pp:concurrencyInvestigation ?value . }
}
ORDER BY ?subject
