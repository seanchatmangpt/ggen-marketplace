# MESSAGE: PP-001 quality evidence is required
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip001 .
  FILTER NOT EXISTS { ?subject pp:qualityEvidence ?value . }
}
ORDER BY ?subject
