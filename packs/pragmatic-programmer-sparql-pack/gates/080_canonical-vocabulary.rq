# MESSAGE: PP-080 term must not have conflicting definitions
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?subject (COUNT(DISTINCT ?value) AS ?count) WHERE {
  ?subject pp:governedBy pp:tip080 ;
           pp:definition ?value .
}
GROUP BY ?subject
HAVING (COUNT(DISTINCT ?value) > 1)
ORDER BY ?subject
