# MESSAGE: PP-015 knowledge facts must have one independent authority
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?subject (COUNT(DISTINCT ?value) AS ?count) WHERE {
  ?subject pp:governedBy pp:tip015 ;
           pp:independentAuthority ?value .
}
GROUP BY ?subject
HAVING (COUNT(DISTINCT ?value) > 1)
ORDER BY ?subject
