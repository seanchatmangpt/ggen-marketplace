# MESSAGE: PP-014 change propagation must remain within policy
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject ?value WHERE {
  ?subject pp:governedBy pp:tip014 ;
           pp:affectedArtifactCount ?value .
  FILTER (?value > 20)
}
ORDER BY ?subject
