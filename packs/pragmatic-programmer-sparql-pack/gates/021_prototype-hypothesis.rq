# MESSAGE: PP-021 prototype requires explicit hypothesis
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip021 .
  FILTER NOT EXISTS { ?subject pp:testsHypothesis ?value . }
}
ORDER BY ?subject
