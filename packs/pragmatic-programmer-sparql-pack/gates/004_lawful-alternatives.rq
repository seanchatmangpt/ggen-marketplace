# MESSAGE: PP-004 refusal or blockage requires a lawful alternative
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip004 .
  FILTER NOT EXISTS { ?subject pp:lawfulAlternative ?value . }
}
ORDER BY ?subject
