# MESSAGE: PP-084 excessive delivery-team churn must be visible
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip084 ;
           pp:excessiveTeamChurn true .
}
ORDER BY ?subject
