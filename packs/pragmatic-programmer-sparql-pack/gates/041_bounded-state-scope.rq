# MESSAGE: PP-041 mutable state requires declared scope
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip041 .
  FILTER NOT EXISTS { ?subject pp:scope ?value . }
}
ORDER BY ?subject
