# MESSAGE: PP-088 ready user value must not wait behind unnecessary boundary
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip088 ;
           pp:unnecessaryDeliveryWait true .
}
ORDER BY ?subject
