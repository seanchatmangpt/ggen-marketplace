# MESSAGE: PP-082 high-risk work requires collaborative review evidence
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip082 .
  FILTER NOT EXISTS { ?subject pp:collaborativeReview ?value . }
}
ORDER BY ?subject
