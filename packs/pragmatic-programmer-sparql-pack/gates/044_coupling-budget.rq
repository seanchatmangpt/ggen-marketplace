# MESSAGE: PP-044 dependency fan-out must remain within policy
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject ?value WHERE {
  ?subject pp:governedBy pp:tip044 ;
           pp:dependencyFanOut ?value .
  FILTER (?value > 10)
}
ORDER BY ?subject
