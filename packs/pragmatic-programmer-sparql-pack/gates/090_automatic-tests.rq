# MESSAGE: PP-090 tests must be connected to automated change/build trigger
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip090 .
  FILTER NOT EXISTS { ?subject pp:automaticTestTrigger ?value . }
}
ORDER BY ?subject
