# MESSAGE: PP-049 capability requires input-transformation-output model
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip049 .
  FILTER (NOT EXISTS { ?subject pp:inputModel ?a . } || NOT EXISTS { ?subject pp:outputModel ?b . })
}
ORDER BY ?subject
