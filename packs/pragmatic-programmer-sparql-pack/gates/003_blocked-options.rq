# MESSAGE: PP-003 blocked work requires visible admissible options
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip003 .
  FILTER NOT EXISTS { ?subject pp:admissibleOption ?value . }
}
ORDER BY ?subject
