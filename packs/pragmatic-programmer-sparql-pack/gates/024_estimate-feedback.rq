# MESSAGE: PP-024 estimate requires observed-versus-estimated feedback
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip024 .
  FILTER NOT EXISTS { ?subject pp:forecastErrorObservation ?value . }
}
ORDER BY ?subject
