# MESSAGE: PP-047 uncontrolled global mutable state is forbidden
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip047 ;
           pp:uncontrolledGlobalMutableState true .
}
ORDER BY ?subject
