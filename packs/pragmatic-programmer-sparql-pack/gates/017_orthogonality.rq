# MESSAGE: PP-017 forbidden dependency paths must not exist
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip017 ;
           pp:forbiddenDependencyObserved true .
}
ORDER BY ?subject
