# MESSAGE: PP-040 acquired resource requires closure evidence
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip040 .
  FILTER NOT EXISTS { ?subject pp:releaseEvidence ?value . }
}
ORDER BY ?subject
