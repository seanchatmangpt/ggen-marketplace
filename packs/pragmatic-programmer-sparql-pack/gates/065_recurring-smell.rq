# MESSAGE: PP-065 recurring structural smell requires repair
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject ?value WHERE {
  ?subject pp:governedBy pp:tip065 ;
           pp:unrepairedOccurrenceCount ?value .
  FILTER (?value >= 3)
}
ORDER BY ?subject
