# MESSAGE: PP-081 hard decision requires explicit constraint frontier
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip081 .
  FILTER NOT EXISTS { ?subject pp:frontierReceipt ?value . }
}
ORDER BY ?subject
