# MESSAGE: PP-052 implementation requires explicit contract
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip052 .
  FILTER NOT EXISTS { ?subject pp:implementsContract ?value . }
}
ORDER BY ?subject
