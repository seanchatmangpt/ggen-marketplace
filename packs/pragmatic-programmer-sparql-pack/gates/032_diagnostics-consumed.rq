# MESSAGE: PP-032 failed execution requires diagnostic observation
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip032 .
  FILTER NOT EXISTS { ?subject pp:diagnosticObservation ?value . }
}
ORDER BY ?subject
