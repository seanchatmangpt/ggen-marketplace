# MESSAGE: PP-085 production system requires scheduled improvement cadence
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip085 .
  FILTER NOT EXISTS { ?subject pp:improvementCadence ?value . }
}
ORDER BY ?subject
