# MESSAGE: PP-023 uncertain planned work requires an estimate
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip023 .
  FILTER NOT EXISTS { ?subject pp:estimate ?value . }
}
ORDER BY ?subject
