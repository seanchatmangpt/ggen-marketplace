# MESSAGE: PP-059 concurrent mutable state requires isolated owner
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip059 .
  FILTER NOT EXISTS { ?subject pp:stateOwner ?value . }
}
ORDER BY ?subject
