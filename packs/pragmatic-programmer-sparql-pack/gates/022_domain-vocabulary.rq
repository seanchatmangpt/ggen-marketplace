# MESSAGE: PP-022 domain element requires canonical vocabulary term
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip022 .
  FILTER NOT EXISTS { ?subject pp:canonicalTerm ?value . }
}
ORDER BY ?subject
