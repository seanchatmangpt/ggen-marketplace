# MESSAGE: PP-089 revision requires bound deterministic qualification
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip089 .
  FILTER NOT EXISTS { ?subject pp:qualificationReceipt ?value . }
}
ORDER BY ?subject
