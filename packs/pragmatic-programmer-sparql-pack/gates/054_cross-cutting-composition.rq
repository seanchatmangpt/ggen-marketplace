# MESSAGE: PP-054 cross-cutting behavior requires composition mechanism
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip054 .
  FILTER NOT EXISTS { ?subject pp:compositionMechanism ?value . }
}
ORDER BY ?subject
