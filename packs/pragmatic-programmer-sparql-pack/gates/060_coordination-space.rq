# MESSAGE: PP-060 independent participants require declared coordination space
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip060 .
  FILTER NOT EXISTS { ?subject pp:coordinationSpace ?value . }
}
ORDER BY ?subject
