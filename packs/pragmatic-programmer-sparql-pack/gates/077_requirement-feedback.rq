# MESSAGE: PP-077 observed user consequence requires requirement feedback
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip077 .
  FILTER NOT EXISTS { ?subject pp:feedbackApplied ?value . }
}
ORDER BY ?subject
