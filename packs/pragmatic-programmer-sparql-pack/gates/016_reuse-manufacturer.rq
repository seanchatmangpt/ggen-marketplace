# MESSAGE: PP-016 repeated implementation requires reusable manufacturer
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip016 .
  FILTER NOT EXISTS { ?subject pp:manufacturer ?value . }
}
ORDER BY ?subject
