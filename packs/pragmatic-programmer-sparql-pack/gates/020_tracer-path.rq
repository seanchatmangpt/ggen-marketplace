# MESSAGE: PP-020 capability requires end-to-end tracer receipt
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip020 .
  FILTER NOT EXISTS { ?subject pp:endToEndReceipt ?value . }
}
ORDER BY ?subject
