# MESSAGE: PP-018 irreversible decisions require rollback or frontier receipt
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip018 .
  FILTER NOT EXISTS { { ?subject pp:rollback ?a . } UNION { ?subject pp:frontierReceipt ?b . } }
}
ORDER BY ?subject
