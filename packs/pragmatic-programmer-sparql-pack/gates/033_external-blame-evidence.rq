# MESSAGE: PP-033 external defect attribution requires isolated reproducer
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip033 .
  FILTER NOT EXISTS { ?subject pp:isolatedReproducer ?value . }
}
ORDER BY ?subject
