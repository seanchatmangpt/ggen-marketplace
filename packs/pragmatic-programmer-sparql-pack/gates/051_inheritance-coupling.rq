# MESSAGE: PP-051 forbidden inheritance coupling must not exist
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip051 ;
           pp:forbiddenInheritance true .
}
ORDER BY ?subject
