# MESSAGE: PP-048 global facility requires explicit interface and authority owner
PREFIX pp: <https://ggen.dev/pragprog/>
PREFIX ggen: <https://ggen.dev/ontology/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?subject WHERE {
  ?subject pp:governedBy pp:tip048 .
  FILTER (NOT EXISTS { ?subject pp:interface ?a . } || NOT EXISTS { ?subject pp:authorityOwner ?b . })
}
ORDER BY ?subject
