# MESSAGE: two cc:Capability nodes must not share a cc:id.
PREFIX cc: <https://ggen.dev/ontology/capability-closure#>
SELECT ?problem ?detail WHERE {
  ?a a cc:Capability ; cc:id ?id . ?b a cc:Capability ; cc:id ?id .
  FILTER(STR(?a) < STR(?b))
  BIND("duplicate_capability_id" AS ?problem) BIND(?id AS ?detail)
}
ORDER BY ?problem ?detail
