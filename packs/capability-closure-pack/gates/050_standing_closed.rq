# MESSAGE: declared standing is a closed vocabulary.
PREFIX cc: <https://ggen.dev/ontology/capability-closure#>
SELECT ?problem ?detail WHERE {
  ?c a cc:Capability ; cc:standing ?s . FILTER(?s NOT IN ("ALIVE","PARTIAL_ALIVE","STALE","UNKNOWN"))
  BIND("standing_not_in_vocabulary" AS ?problem) BIND(CONCAT(STR(?c),"=",?s) AS ?detail)
}
ORDER BY ?problem ?detail
