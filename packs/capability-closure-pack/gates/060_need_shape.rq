# MESSAGE: every cc:need carries id, family and variant.
PREFIX cc: <https://ggen.dev/ontology/capability-closure#>
SELECT ?problem ?detail WHERE {
  ?r a cc:Requirement ; cc:need ?n .
  VALUES ?p { cc:id cc:family cc:variant }
  FILTER NOT EXISTS { ?n ?p ?v }
  BIND("need_property_missing" AS ?problem) BIND(CONCAT(STR(?n)," lacks ",STR(?p)) AS ?detail)
}
ORDER BY ?problem ?detail
