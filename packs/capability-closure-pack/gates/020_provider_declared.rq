# MESSAGE: every capability carries family, variant, standing, evidence and a cc:Pack provider.
PREFIX cc: <https://ggen.dev/ontology/capability-closure#>
SELECT ?problem ?detail WHERE {
  ?c a cc:Capability .
  { VALUES ?p { cc:id cc:family cc:variant cc:standing cc:evidence cc:providedBy }
    FILTER NOT EXISTS { ?c ?p ?v }
    BIND("capability_property_missing" AS ?problem) BIND(CONCAT(STR(?c)," lacks ",STR(?p)) AS ?detail) }
  UNION
  { ?c cc:providedBy ?pk . FILTER NOT EXISTS { ?pk a cc:Pack }
    BIND("provider_not_a_pack" AS ?problem) BIND(STR(?pk) AS ?detail) }
}
ORDER BY ?problem ?detail
