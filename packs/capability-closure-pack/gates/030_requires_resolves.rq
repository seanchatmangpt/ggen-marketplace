# MESSAGE: every cc:requires target on a capability must itself be a declared cc:Capability.
PREFIX cc: <https://ggen.dev/ontology/capability-closure#>
SELECT ?problem ?detail WHERE {
  ?c a cc:Capability ; cc:requires ?t . FILTER NOT EXISTS { ?t a cc:Capability }
  BIND("dangling_requires" AS ?problem) BIND(CONCAT(STR(?c)," -> ",STR(?t)) AS ?detail)
}
ORDER BY ?problem ?detail
