@prefix cc: <https://ggen.dev/ontology/capability-closure#> .
@prefix r: <urn:cc:req:> .
# A third-party project adopting affidavit: typed events, receipts verified in CI, host bindings
# for its own language, SHACL->type projection, and the pinned wasm engine.
r:affidavit-consumer a cc:Requirement ; cc:need r:n1 , r:n2 , r:n3 , r:n4 , r:n5 , r:n6 , r:n7.
r:n1 cc:id "wasm-abi:capability-registry" ; cc:family "wasm-abi" ; cc:variant "registry" .
r:n2 cc:id "wasm-abi:artifact-pin" ; cc:family "wasm-abi" ; cc:variant "pin" .
r:n3 cc:id "wasm-host:elixir-wasmex" ; cc:family "wasm-host" ; cc:variant "elixir" .
r:n4 cc:id "wasm-host:typescript" ; cc:family "wasm-host" ; cc:variant "typescript" .
r:n5 cc:id "wasm-host:python" ; cc:family "wasm-host" ; cc:variant "python" .
r:n6 cc:id "ci:github-composite-action" ; cc:family "ci" ; cc:variant "github-actions" .
r:n7 cc:id "affidavit:consumer-vocabulary" ; cc:family "affidavit-model" ; cc:variant "consumer-vocabulary" .
