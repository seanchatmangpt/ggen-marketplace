@prefix cc: <https://ggen.dev/ontology/capability-closure#> .
@prefix cp: <urn:cc:pack:> .
@prefix c:  <urn:cc:cap:> .

# DECLARED index: hand-authored provides claims, one per capability, each with an evidence
# path under packs/ that scripts/verify_evidence.py checks exists. Coverage = the packs named
# here, not the marketplace. standing is declared, never derived.

cp:affidavit-pack a cc:Pack .
cp:affidavit-trust-plane-pack a cc:Pack .
cp:authzen-spiffe-absorption-pack a cc:Pack .
cp:evidence-standing-pack a cc:Pack .
cp:github-actions-pack a cc:Pack .
cp:qri-qualification-profile-pack a cc:Pack .
cp:shacl-to-zod-pack a cc:Pack .
cp:wasi-json-abi-pack a cc:Pack .

c:wasm-abi_rust-shell a cc:Capability ;
  cc:id "wasm-abi:rust-shell" ; cc:family "wasm-abi" ; cc:variant "rust-ffi" ; cc:providedBy cp:wasi-json-abi-pack ;
  cc:standing "ALIVE" ; cc:evidence "wasi-json-abi-pack/templates/wasm_ffi.rs.tmpl" .

c:wasm-abi_capability-registry a cc:Capability ;
  cc:id "wasm-abi:capability-registry" ; cc:family "wasm-abi" ; cc:variant "registry" ; cc:providedBy cp:wasi-json-abi-pack ;
  cc:standing "ALIVE" ; cc:evidence "wasi-json-abi-pack/templates/wasm_capability_registry.json.tmpl" .

c:wasm-abi_op-examples a cc:Capability ;
  cc:id "wasm-abi:op-examples" ; cc:family "wasm-abi" ; cc:variant "examples" ; cc:providedBy cp:wasi-json-abi-pack ;
  cc:standing "ALIVE" ; cc:evidence "wasi-json-abi-pack/templates/wasm_op_examples.json.tmpl" .

c:wasm-abi_artifact-pin a cc:Capability ;
  cc:id "wasm-abi:artifact-pin" ; cc:family "wasm-abi" ; cc:variant "pin" ; cc:providedBy cp:wasi-json-abi-pack ;
  cc:standing "ALIVE" ; cc:evidence "wasi-json-abi-pack/templates/wasm_artifacts.sha256.tmpl" .

c:wasm-host_elixir-wasmex a cc:Capability ;
  cc:id "wasm-host:elixir-wasmex" ; cc:family "wasm-host" ; cc:variant "elixir" ; cc:providedBy cp:qri-qualification-profile-pack ;
  cc:standing "ALIVE" ; cc:evidence "qri-qualification-profile-pack/templates/beam-host/host.ex.tmpl" ;
  cc:requires c:wasm-abi_capability-registry .

c:crypto_envelope-verification a cc:Capability ;
  cc:id "crypto:envelope-verification" ; cc:family "crypto" ; cc:variant "envelope" ; cc:providedBy cp:affidavit-trust-plane-pack ;
  cc:standing "PARTIAL_ALIVE" ; cc:evidence "affidavit-trust-plane-pack/ontology.ttl" .

c:evidence_hash-chain-ts a cc:Capability ;
  cc:id "evidence:hash-chain-ts" ; cc:family "evidence-chain" ; cc:variant "typescript" ; cc:providedBy cp:evidence-standing-pack ;
  cc:standing "ALIVE" ; cc:evidence "evidence-standing-pack/templates/chain.ts.tmpl" .

c:evidence_hash-chain-py a cc:Capability ;
  cc:id "evidence:hash-chain-py" ; cc:family "evidence-chain" ; cc:variant "python" ; cc:providedBy cp:evidence-standing-pack ;
  cc:standing "ALIVE" ; cc:evidence "evidence-standing-pack/templates/chain.py.tmpl" .

c:evidence_hash-chain-rs a cc:Capability ;
  cc:id "evidence:hash-chain-rs" ; cc:family "evidence-chain" ; cc:variant "rust" ; cc:providedBy cp:evidence-standing-pack ;
  cc:standing "ALIVE" ; cc:evidence "evidence-standing-pack/templates/chain.rs.tmpl" .

c:evidence_authzen-spiffe-adapter a cc:Capability ;
  cc:id "evidence:authzen-spiffe-adapter" ; cc:family "evidence-adapter" ; cc:variant "elixir" ; cc:providedBy cp:authzen-spiffe-absorption-pack ;
  cc:standing "PARTIAL_ALIVE" ; cc:evidence "authzen-spiffe-absorption-pack/templates/policy_evidence.ex.tera" .

c:ci_github-composite-action a cc:Capability ;
  cc:id "ci:github-composite-action" ; cc:family "ci" ; cc:variant "github-actions" ; cc:providedBy cp:github-actions-pack ;
  cc:standing "ALIVE" ; cc:evidence "github-actions-pack/templates/composite_action.yml.tmpl" .

c:types_shacl-to-zod a cc:Capability ;
  cc:id "types:shacl-to-zod" ; cc:family "schema-projection" ; cc:variant "zod" ; cc:providedBy cp:shacl-to-zod-pack ;
  cc:standing "ALIVE" ; cc:evidence "shacl-to-zod-pack/templates/shacl_to_zod.js.tmpl" .

c:affidavit_rust-catalog-fork a cc:Capability ;
  cc:id "affidavit:rust-catalog-fork" ; cc:family "affidavit-model" ; cc:variant "rust-fork" ; cc:providedBy cp:affidavit-pack ;
  cc:standing "STALE" ; cc:evidence "affidavit-pack/templates/affidavit_types.rs.tmpl" .

cp:affidavit-consumer-pack a cc:Pack .
c:affidavit_consumer-vocabulary a cc:Capability ;
  cc:id "affidavit:consumer-vocabulary" ; cc:family "affidavit-model" ; cc:variant "consumer-vocabulary" ;
  cc:providedBy cp:affidavit-consumer-pack ; cc:standing "ALIVE" ;
  cc:evidence "affidavit-consumer-pack/ontology.ttl" .
c:ci_affidavit-verify-action a cc:Capability ;
  cc:id "ci:affidavit-verify-action" ; cc:family "ci" ; cc:variant "affidavit-verify" ;
  cc:providedBy cp:affidavit-consumer-pack ; cc:standing "ALIVE" ;
  cc:evidence "affidavit-consumer-pack/templates/action.yml.tmpl" .
c:bindings_affidavit-events-ts a cc:Capability ;
  cc:id "bindings:affidavit-events-ts" ; cc:family "affidavit-bindings" ; cc:variant "typescript" ;
  cc:providedBy cp:affidavit-consumer-pack ; cc:standing "ALIVE" ;
  cc:evidence "affidavit-consumer-pack/templates/affidavit_events.ts.tmpl" .
c:bindings_affidavit-events-py a cc:Capability ;
  cc:id "bindings:affidavit-events-py" ; cc:family "affidavit-bindings" ; cc:variant "python" ;
  cc:providedBy cp:affidavit-consumer-pack ; cc:standing "ALIVE" ;
  cc:evidence "affidavit-consumer-pack/templates/affidavit_events.py.tmpl" .
