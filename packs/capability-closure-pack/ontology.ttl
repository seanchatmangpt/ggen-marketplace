@prefix cc:   <https://ggen.dev/ontology/capability-closure#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sj:   <https://ggen-igniter.dev/ontology/semantic-jira#> .

# Vocabulary for the capability index and requirement graphs. Capability ids use the
# sj:capabilityId shape "provider:id". Authority ceiling NONE.

cc:Capability a rdfs:Class ;
  rdfs:comment "A semantic capability atom. id = provider:name; provided by packs, required by requirements." .
cc:Requirement a rdfs:Class ;
  rdfs:comment "A required end capability; each cc:requires target must be satisfied or reported as residual." .
cc:Pack a rdfs:Class .

cc:id        a rdf:Property ; rdfs:domain cc:Capability ; rdfs:range xsd:string .
cc:family    a rdf:Property ; rdfs:comment "Coarse kind; same-family providers make a missing member EXTEND, not BUILD." .
cc:variant   a rdf:Property ; rdfs:comment "Distinguishing value inside a family (e.g. a host language)." .
cc:providedBy a rdf:Property ; rdfs:domain cc:Capability ; rdfs:range cc:Pack .
cc:requires  a rdf:Property ; rdfs:comment "Requirement or capability -> required capability." .
cc:evidence  a rdf:Property ; rdfs:comment "Repo-relative path (under packs/) that witnesses the provides claim." .
cc:standing  a rdf:Property ; rdfs:comment "ALIVE | PARTIAL_ALIVE | STALE | UNKNOWN. Declared, not derived." .
cc:disposition a rdf:Property ; rdfs:comment "Solver output vocabulary: REUSE | EXTEND | BUILD." .
