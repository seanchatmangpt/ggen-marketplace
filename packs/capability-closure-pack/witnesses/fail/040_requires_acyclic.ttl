@prefix cc: <https://ggen.dev/ontology/capability-closure#> .
@prefix x: <urn:w:> .
x:p a cc:Pack .
x:a a cc:Capability ; cc:id "t:a" ; cc:family "f" ; cc:variant "v1" ; cc:providedBy x:p ; cc:standing "ALIVE" ; cc:evidence "p/a" .
x:b a cc:Capability ; cc:id "t:b" ; cc:family "f" ; cc:variant "v2" ; cc:providedBy x:p ; cc:standing "ALIVE" ; cc:evidence "p/b" ; cc:requires x:a .
x:r a cc:Requirement ; cc:need x:n .
x:n cc:id "t:b" ; cc:family "f" ; cc:variant "v2" .
x:a cc:requires x:b .
