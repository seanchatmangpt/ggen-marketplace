# Needs satisfied outright (REUSE): a non-STALE provider carries the id.
PREFIX cc: <https://ggen.dev/ontology/capability-closure#>
SELECT DISTINCT ?req ?id ?pack ?evidence WHERE {
  ?req a cc:Requirement ; cc:need ?n .
  ?n cc:id ?id .
  ?c a cc:Capability ; cc:id ?id ; cc:standing ?s ; cc:providedBy ?pack ; cc:evidence ?evidence .
  FILTER(?s != "STALE")
}
ORDER BY ?req ?id
