# Capabilities (and their transitive cc:requires dependencies) that each need's provider drags in.
PREFIX cc: <https://ggen.dev/ontology/capability-closure#>
SELECT DISTINCT ?req ?id ?depId WHERE {
  ?req a cc:Requirement ; cc:need ?n .
  ?n cc:id ?id .
  ?cap a cc:Capability ; cc:id ?id .
  ?cap cc:requires* ?d .
  ?d a cc:Capability ; cc:id ?depId .
}
ORDER BY ?req ?id ?depId
