@prefix asa: <https://chatmangpt.com/ontology/authzen-spiffe#> .
@prefix sa2a: <https://chatmangpt.com/ontology/sa2a#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

asa:PolicyEvidence a rdf:Class .
asa:AttestedWorkloadIdentity a rdf:Class .
asa:PDPBinding a rdf:Class .
asa:LocalCertificateMediation a rdf:Class .
asa:NegativeFixture a rdf:Class .

asa:authzenDecision a rdf:Property .
asa:policyDecisionPoint a rdf:Property .
asa:spiffeId a rdf:Property .
asa:trustDomain a rdf:Property .
asa:effectDigest a rdf:Property .
asa:principal a rdf:Property .
asa:authorityCeiling a rdf:Property .
asa:consequence a rdf:Property .

asa:absorbedPolicyEvidence
  a asa:PolicyEvidence ;
  asa:authorityCeiling "NONE" ;
  asa:consequence "EVIDENCE_ONLY" .

asa:chain
  sa2a:preserves "PreparedEffect.digest" ;
  sa2a:preserves "PreparedEffect.principal" ;
  sa2a:requires "ActuationCertificate" ;
  sa2a:requires "actuator-local-claim" .
