@prefix scb: <https://seanchatmangpt.github.io/ggen-marketplace/supply-chain-evidence#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

scb:CourtCase a rdfs:Class ;
  rdfs:comment "A declarative falsification case projected by ggen into executable consumer evidence." .
scb:caseId a rdf:Property ; rdfs:domain scb:CourtCase ; rdfs:range xsd:string .
scb:ordinal a rdf:Property ; rdfs:domain scb:CourtCase ; rdfs:range xsd:integer .
scb:title a rdf:Property ; rdfs:domain scb:CourtCase ; rdfs:range xsd:string .
scb:expectedStanding a rdf:Property ; rdfs:domain scb:CourtCase ; rdfs:range xsd:string .
scb:mutationJson a rdf:Property ; rdfs:domain scb:CourtCase ; rdfs:range xsd:string ;
  rdfs:comment "JSON mutation intent. It is data only and carries no ambient DO authority." .
scb:assertionJson a rdf:Property ; rdfs:domain scb:CourtCase ; rdfs:range xsd:string ;
  rdfs:comment "Declarative assertion DSL interpreted by the consumer court runtime; contains no executable code." .
scb:lawFamily a rdf:Property ; rdfs:domain scb:CourtCase ; rdfs:range xsd:string .
scb:semanticFingerprint a rdf:Property ; rdfs:domain scb:CourtCase ; rdfs:range xsd:string .

scb:Court a rdfs:Class .
scb:outputPath a rdf:Property ; rdfs:domain scb:Court ; rdfs:range xsd:string .
scb:caseCount a rdf:Property ; rdfs:domain scb:Court ; rdfs:range xsd:integer .
