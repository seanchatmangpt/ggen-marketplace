PREFIX scb: <https://seanchatmangpt.github.io/ggen-marketplace/supply-chain-evidence#>
SELECT ?subject ?reason WHERE {
  ?subject a scb:CourtCase .
  {
    FILTER NOT EXISTS { ?subject scb:caseId ?v }
    BIND("missing scb:caseId" AS ?reason)
  } UNION {
    FILTER NOT EXISTS { ?subject scb:ordinal ?v }
    BIND("missing scb:ordinal" AS ?reason)
  } UNION {
    FILTER NOT EXISTS { ?subject scb:expectedStanding ?v }
    BIND("missing scb:expectedStanding" AS ?reason)
  } UNION {
    FILTER NOT EXISTS { ?subject scb:mutationJson ?v }
    BIND("missing scb:mutationJson" AS ?reason)
  } UNION {
    FILTER NOT EXISTS { ?subject scb:lawFamily ?v }
    BIND("missing scb:lawFamily" AS ?reason)
  } UNION {
    FILTER NOT EXISTS { ?subject scb:semanticFingerprint ?v }
    BIND("missing scb:semanticFingerprint" AS ?reason)
  }
}
