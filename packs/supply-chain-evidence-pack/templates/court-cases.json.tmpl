---
to: "generated/supply-chain-evidence-cases.json"
sparql:
  cases: |
    PREFIX scb: <https://seanchatmangpt.github.io/ggen-marketplace/supply-chain-evidence#>
    SELECT ?caseId ?ordinal ?title ?expectedStanding ?mutationJson ?assertionJson ?lawFamily ?semanticFingerprint
    WHERE {
      ?case a scb:CourtCase ;
        scb:caseId ?caseId ;
        scb:ordinal ?ordinal ;
        scb:title ?title ;
        scb:expectedStanding ?expectedStanding ;
        scb:mutationJson ?mutationJson ;
        scb:assertionJson ?assertionJson ;
        scb:lawFamily ?lawFamily ;
        scb:semanticFingerprint ?semanticFingerprint .
    }
    ORDER BY ?ordinal
---
{
  "schema": "ggen.supply-chain-evidence.court/v1",
  "cases": [
{%- for c in cases %}
    {
      "case_id": "{{ c.caseId }}",
      "ordinal": {{ c.ordinal }},
      "title": "{{ c.title }}",
      "expected": "{{ c.expectedStanding }}",
      "law_family": "{{ c.lawFamily }}",
      "semantic_fingerprint": "{{ c.semanticFingerprint }}",
      "mutation": {{ c.mutationJson | safe }},
      "assertion": {{ c.assertionJson | safe }}
    }{% if not loop.last %},{% endif %}
{%- endfor %}
  ]
}
