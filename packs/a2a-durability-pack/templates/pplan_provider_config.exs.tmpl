---
to: "tmp/a2a-durability/config/a2a_pplan.exs"
sparql:
  surface: |
    PREFIX dur: <https://seanchatmangpt.github.io/packs/a2a-durability#>
    SELECT ?truth_module ?config_entry ?store_opt ?gap_note ?truth_path
    WHERE {
      ?s dur:kind "provider" ;
         dur:truthModule ?truth_module ;
         dur:truthPath ?truth_path .
      OPTIONAL { ?s dur:configEntry ?config_entry }
      OPTIONAL { ?s dur:storeOpt ?store_opt }
      OPTIONAL { ?s dur:gapNote ?gap_note }
    }
  capabilities: |
    PREFIX dur: <https://seanchatmangpt.github.io/packs/a2a-durability#>
    SELECT ?capability_name ?produces_states ?capability_detail
    WHERE {
      ?s dur:kind "provider" ;
         dur:hasCapability ?cap .
      ?cap dur:capabilityName ?capability_name ;
           dur:producesStates ?produces_states ;
           dur:capabilityDetail ?capability_detail .
    } ORDER BY ?capability_name
---

