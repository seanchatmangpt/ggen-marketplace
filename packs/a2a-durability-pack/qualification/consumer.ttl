@prefix a2ac: <http://seanchatmangpt.github.io/packs/a2a-conformance#> .
@prefix dur: <https://seanchatmangpt.github.io/packs/a2a-durability#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Qualification-only external fact identity. The canonical court-file facts
# are owned by a2a-conformance-pack (packs/a2a-conformance-pack/ontology.ttl);
# this fixture supplies only the minimum typed identity needed so that this
# pack's two rdfs:seeAlso alignment links (same concept, same IRI per the M15
# cross-pack convention) do not dangle when a2a-durability-pack is qualified
# in isolation. Mirrors the standing-ladder-pack precedent.

a2ac:court_12 a a2ac:CourtFile ;
    dcterms:source "packs/a2a-conformance-pack/ontology.ttl#a2ac:court_12" .

a2ac:court_23 a a2ac:CourtFile ;
    dcterms:source "packs/a2a-conformance-pack/ontology.ttl#a2ac:court_23" .
