# INVERTED COMPANION to gates/010_surfaces.rq. ZERO ROWS IS THE PASS CONDITION.
# Surface completeness: every DurabilitySurface carries kind, truthModule and
# truthPath; every store-kind surface additionally carries wiringModule (the
# durable-task-store wiring template refuses to render without it).
PREFIX dur: <https://seanchatmangpt.github.io/packs/a2a-durability#>
SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a dur:DurabilitySurface .
    OPTIONAL { ?subject dur:kind ?p1 }
    FILTER (!BOUND(?p1))
    BIND("dur:kind" AS ?missing_property)
  }
  UNION
  {
    ?subject a dur:DurabilitySurface .
    OPTIONAL { ?subject dur:truthModule ?p2 }
    FILTER (!BOUND(?p2))
    BIND("dur:truthModule" AS ?missing_property)
  }
  UNION
  {
    ?subject a dur:DurabilitySurface .
    OPTIONAL { ?subject dur:truthPath ?p3 }
    FILTER (!BOUND(?p3))
    BIND("dur:truthPath" AS ?missing_property)
  }
  UNION
  {
    ?subject dur:kind "store" .
    OPTIONAL { ?subject dur:wiringModule ?p4 }
    FILTER (!BOUND(?p4))
    BIND("dur:wiringModule" AS ?missing_property)
  }
}
