# INVERTED COMPANION to gates/020_capabilities.rq. ZERO ROWS IS THE PASS CONDITION.
PREFIX dur: <https://seanchatmangpt.github.io/packs/a2a-durability#>
SELECT ?subject ?missing_property
WHERE {
  {
    ?subject a dur:Capability .
    OPTIONAL { ?subject dur:capabilityName ?p1 }
    FILTER (!BOUND(?p1))
    BIND("dur:capabilityName" AS ?missing_property)
  }
  UNION
  {
    ?subject a dur:Capability .
    OPTIONAL { ?subject dur:producesStates ?p2 }
    FILTER (!BOUND(?p2))
    BIND("dur:producesStates" AS ?missing_property)
  }
  UNION
  {
    ?subject a dur:Capability .
    OPTIONAL { ?subject dur:capabilityDetail ?p3 }
    FILTER (!BOUND(?p3))
    BIND("dur:capabilityDetail" AS ?missing_property)
  }
  UNION
  {
    ?subject a dur:DurabilitySurface ;
             dur:hasCapability ?cap .
    FILTER NOT EXISTS { ?cap a dur:Capability . }
    BIND("hasCapability edge to a non-Capability" AS ?missing_property)
  }
}
