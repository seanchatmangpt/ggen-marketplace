@prefix fgc: <https://ggen.dev/ontology/forced-top25-generated-closure#> .
@prefix fts: <https://ggen.dev/ontology/forced-top25-standard-consumer#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

fgc:GeneratedArtifact a skos:Concept .
fgc:GeneratedClosure a skos:Concept .
fgc:ArtifactValidator a skos:Concept .
fgc:belongsToConsumer a rdf:Property .
fgc:artifactPath a rdf:Property .
fgc:artifactLanguage a rdf:Property .
fgc:validatorCommand a rdf:Property .
fgc:generatedFrom a rdf:Property .
fgc:closureMember a rdf:Property .
fgc:qualificationStanding a rdf:Property .
fgc:authority a rdf:Property .
fgc:consequentialDo a rdf:Property .

fgc:closure-contract a fgc:GeneratedClosure ;
  fgc:authority "VERIFY|CONSTRUCT" ;
  fgc:consequentialDo false ;
  prov:wasDerivedFrom fts:StandardConsumerPlan .
