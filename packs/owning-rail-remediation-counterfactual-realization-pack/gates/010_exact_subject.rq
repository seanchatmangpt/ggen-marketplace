PREFIX rr: <https://chatman.ai/measure/remediation-realization#>
SELECT ?s WHERE {
  ?s a rr:Subject .
  OPTIONAL { ?s rr:hasSha ?sha }
  OPTIONAL { ?s rr:semanticDigest ?digest }
  FILTER(!BOUND(?sha) || !REGEX(STR(?sha), "^[0-9a-f]{40}$") || !BOUND(?digest) || !REGEX(STR(?digest), "^[0-9a-f]{64}$"))
}
