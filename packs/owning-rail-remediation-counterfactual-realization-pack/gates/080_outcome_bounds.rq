PREFIX rr: <https://chatman.ai/measure/remediation-realization#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?o ?predicted ?realized WHERE {
  ?o a rr:OutcomeObservation ; rr:predictedRelief ?predicted ; rr:realizedRelief ?realized .
  FILTER(xsd:decimal(?predicted) < 0 || xsd:decimal(?realized) < 0)
}
