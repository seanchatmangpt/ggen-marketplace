PREFIX rr: <https://chatman.ai/measure/remediation-realization#>
SELECT ?plan WHERE {
  ?plan a rr:RemediationPlan .
  {
    FILTER NOT EXISTS { ?pre a rr:OutcomeObservation ; rr:planId ?plan ; rr:generation 0 }
  }
  UNION
  {
    FILTER NOT EXISTS { ?post a rr:OutcomeObservation ; rr:planId ?plan ; rr:generation 1 }
  }
}
