@prefix rr: <https://chatman.ai/measure/remediation-realization#> .
@prefix ex: <https://example.test/owning-rail-realization#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:observation-1 a rr:OutcomeObservation ;
    rr:hasSha "0123456789abcdef0123456789abcdef01234567" ;
    rr:planId "plan-qualification-1" ;
    rr:predictedRelief "0.40"^^xsd:decimal ;
    rr:realizedRelief "0.35"^^xsd:decimal ;
    rr:propensity "0.60"^^xsd:decimal .
