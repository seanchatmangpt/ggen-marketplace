---
to: "generated/owning-rail-remediation-counterfactual-realization/consumer-observation.json"
sparql:
  obs: |
    PREFIX rr: <https://chatman.ai/measure/remediation-realization#>
    SELECT ?subjectSha ?planId ?predictedRelief ?realizedRelief ?propensity
    WHERE {
      ?o a rr:OutcomeObservation ;
         rr:hasSha ?subjectSha ;
         rr:planId ?planId ;
         rr:predictedRelief ?predictedRelief ;
         rr:realizedRelief ?realizedRelief ;
         rr:propensity ?propensity .
    }
    ORDER BY ?planId ?subjectSha
---
{
  "schema": "chatman.remediation-realization-observation/1",
  "subject_sha": "{{ obs[0].subjectSha }}",
  "plan_id": "{{ obs[0].planId }}",
  "predicted_relief": {{ obs[0].predictedRelief }},
  "realized_relief": {{ obs[0].realizedRelief }},
  "propensity": {{ obs[0].propensity }},
  "authority": "OBSERVE|VERIFY",
  "actuation_performed": false
}
