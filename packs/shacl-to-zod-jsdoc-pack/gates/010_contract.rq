# MESSAGE: every JavaScriptContract must bind a real SHACL shape and explicit schema/typedef names.
PREFIX szj: <https://ggen.dev/packs/shacl-to-zod-jsdoc#>
PREFIX sp: <http://seanchatmangpt.github.io/packs/shacl-projection#>
SELECT ?contract ?missing WHERE {
  ?contract a szj:JavaScriptContract .
  VALUES ?missing { sp:derivedFromShape szj:schemaName szj:typedefName }
  FILTER NOT EXISTS { ?contract ?missing ?value }
}
ORDER BY ?contract ?missing
