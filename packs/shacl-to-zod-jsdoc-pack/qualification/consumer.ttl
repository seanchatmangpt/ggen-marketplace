@prefix szj: <https://ggen.dev/packs/shacl-to-zod-jsdoc#> .
@prefix sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> .
@prefix wd: <https://ggen.dev/wd-fa/example#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wd:FailureCaseRequestShape a sh:NodeShape ;
    sh:targetClass wd:FailureCaseRequest ;
    sh:property wd:FailureCaseRequestSerialShape, wd:FailureCaseRequestSymptomShape .

wd:FailureCaseRequestSerialShape a sh:PropertyShape ;
    sh:path wd:serial ;
    sh:datatype xsd:string ;
    sh:description "Exact drive serial identity." .

wd:FailureCaseRequestSymptomShape a sh:PropertyShape ;
    sh:path wd:symptom ;
    sh:datatype xsd:string ;
    sh:description "Reported failure symptom." .

szj:FailureCaseRequestContract a szj:JavaScriptContract ;
    sp:derivedFromShape wd:FailureCaseRequestShape ;
    szj:schemaName "FailureCaseRequestSchema" ;
    szj:typedefName "FailureCaseRequest" .
