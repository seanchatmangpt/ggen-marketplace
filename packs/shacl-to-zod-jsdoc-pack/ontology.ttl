@prefix szj: <https://ggen.dev/packs/shacl-to-zod-jsdoc#> .
@prefix sp: <http://seanchatmangpt.github.io/packs/shacl-projection#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

szj:JavaScriptContract a rdfs:Class ;
    rdfs:comment "A Zod/JSDoc projection derived from a SHACL shape; generated JavaScript is non-sovereign." .

szj:schemaName a rdf:Property ; rdfs:domain szj:JavaScriptContract ; rdfs:range xsd:string .
szj:typedefName a rdf:Property ; rdfs:domain szj:JavaScriptContract ; rdfs:range xsd:string .
