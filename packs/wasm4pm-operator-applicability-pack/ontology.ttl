@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix op: <https://ggen.dev/ontology/wasm4pm/operator-applicability#> .

op:catalog a dcat:Dataset ;
  dcterms:title "wasm4pm operator applicability contracts" ;
  dcterms:description "Canonical structural preconditions for admitting wasm4pm operators into a candidate computation portfolio. These facts do not confer execution authority." ;
  prov:wasDerivedFrom <https://github.com/seanchatmangpt/wasm4pm> .

op:requiresFeature a skos:Concept ; skos:prefLabel "requires all structural features" .
op:requiresAnyFeature a skos:Concept ; skos:prefLabel "requires at least one structural feature" .

op:sat_cdcl a skos:Concept ; skos:prefLabel "sat_cdcl" ; op:requiresAnyFeature op:constraints, op:boolean_constraints .
op:version_space a skos:Concept ; skos:prefLabel "version_space" ; op:requiresAnyFeature op:labeled_examples, op:candidate_hypotheses .
op:dendral a skos:Concept ; skos:prefLabel "dendral" ; op:requiresFeature op:candidate_hypotheses, op:observations .
op:mycin a skos:Concept ; skos:prefLabel "mycin" ; op:requiresFeature op:rules, op:observations .
op:strips a skos:Concept ; skos:prefLabel "strips" ; op:requiresFeature op:initial_state, op:goal_state, op:actions .
op:cbr a skos:Concept ; skos:prefLabel "cbr" ; op:requiresFeature op:cases, op:observations .
op:allen_temporal a skos:Concept ; skos:prefLabel "allen_temporal" ; op:requiresFeature op:temporal_intervals .
op:event_calculus a skos:Concept ; skos:prefLabel "event_calculus" ; op:requiresFeature op:events, op:fluents, op:temporal_order .
op:mdp a skos:Concept ; skos:prefLabel "mdp" ; op:requiresFeature op:states, op:actions, op:transition_probabilities, op:rewards .
op:pomdp a skos:Concept ; skos:prefLabel "pomdp" ; op:requiresFeature op:states, op:actions, op:transition_probabilities, op:observations, op:observation_probabilities, op:rewards .
op:htn a skos:Concept ; skos:prefLabel "htn" ; op:requiresFeature op:tasks, op:methods, op:initial_state .

op:constraints a skos:Concept ; skos:prefLabel "constraints" .
op:boolean_constraints a skos:Concept ; skos:prefLabel "boolean_constraints" .
op:labeled_examples a skos:Concept ; skos:prefLabel "labeled_examples" .
op:candidate_hypotheses a skos:Concept ; skos:prefLabel "candidate_hypotheses" .
op:observations a skos:Concept ; skos:prefLabel "observations" .
op:rules a skos:Concept ; skos:prefLabel "rules" .
op:initial_state a skos:Concept ; skos:prefLabel "initial_state" .
op:goal_state a skos:Concept ; skos:prefLabel "goal_state" .
op:actions a skos:Concept ; skos:prefLabel "actions" .
op:cases a skos:Concept ; skos:prefLabel "cases" .
op:temporal_intervals a skos:Concept ; skos:prefLabel "temporal_intervals" .
op:events a skos:Concept ; skos:prefLabel "events" .
op:fluents a skos:Concept ; skos:prefLabel "fluents" .
op:temporal_order a skos:Concept ; skos:prefLabel "temporal_order" .
op:states a skos:Concept ; skos:prefLabel "states" .
op:transition_probabilities a skos:Concept ; skos:prefLabel "transition_probabilities" .
op:rewards a skos:Concept ; skos:prefLabel "rewards" .
op:observation_probabilities a skos:Concept ; skos:prefLabel "observation_probabilities" .
op:tasks a skos:Concept ; skos:prefLabel "tasks" .
op:methods a skos:Concept ; skos:prefLabel "methods" .
