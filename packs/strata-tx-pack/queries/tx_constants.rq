PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tx:   <https://strata.chatman.ai/ontology/tx#>

SELECT ?label ?rustType ?value ?comment
WHERE {
  ?c a tx:TxFrameConstant ;
     rdfs:label ?label ;
     tx:rustType ?rustType ;
     tx:value ?value ;
     rdfs:comment ?comment .
}
ORDER BY ?label
