#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn header_len_is_56() {
        assert_eq!(TX_HEADER_LEN, 56);
    }

    #[test]
    fn offset_abutment_chain() {
        assert_eq!(MAGIC_OFFSET, 0);
        assert_eq!(MAGIC_OFFSET + MAGIC_LEN, VERSION_OFFSET);
        assert_eq!(VERSION_OFFSET + VERSION_LEN, RESERVED_OFFSET);
        assert_eq!(RESERVED_OFFSET + TX_RESERVED_LEN, NONCE_OFFSET);
        assert_eq!(NONCE_OFFSET + NONCE_LEN, INPUT_COUNT_OFFSET);
        assert_eq!(INPUT_COUNT_OFFSET + INPUT_COUNT_LEN, OUTPUT_COUNT_OFFSET);
        assert_eq!(OUTPUT_COUNT_OFFSET + OUTPUT_COUNT_LEN, PAYLOAD_DIGEST_OFFSET);
        assert_eq!(PAYLOAD_DIGEST_OFFSET + PAYLOAD_DIGEST_LEN, TX_HEADER_LEN);
    }

    #[test]
    fn body_element_widths() {
        assert_eq!(TX_INPUT_LEN, 36); // 32B prev TxId + u32 index
        assert_eq!(TX_OUTPUT_LEN, 9); // u64 value + u8 unit tag
    }
}
