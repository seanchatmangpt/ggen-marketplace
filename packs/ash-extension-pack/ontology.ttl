# --- :authority section (dsl.ex:187-202) ---

aex:AshA2aAuthoritySection a aex:DslSection ;
    aex:sectionOf aex:AshA2aSpec ;
    aex:sectionName "authority" ;
    aex:sectionOrder 2 ;
    aex:sectionDescribe "Declarative two-port gate policies and lease constraints for A2A actions." ;
    aex:dslCitation "lib/ash_a2a/dsl.ex:187-202" .

aex:AshA2aAuthorityGate a aex:SectionSchemaField ;
    aex:sectionFieldOf aex:AshA2aAuthoritySection ;
    aex:sectionFieldOrder 1 ; aex:sectionFieldName "gate" ; aex:sectionFieldType "one_of" ;
    aex:sectionFieldDefault ":two_port" ;
    aex:sectionFieldDoc "Default admission gate applied to consequence-bearing actions. Closed values: :two_port | :open | :disabled (dsl.ex:192); aex:FieldOneOfValue binds to entity fields only, so the section-level enum is stated here. Compile-time coupling: an :external_do/:change consequence under gate :open/:disabled is a DslError (verify.ex:42-58)." ;
    aex:dslCitation "lib/ash_a2a/dsl.ex:191-194" .

# Section-level enum values for the authority gate (closed set per dsl.ex:192;
# the field's doc states the coupling -- these rows carry the values the
# section-field renderer expands into {:one_of, [...]}).
aex:AshA2aAuthorityGateTwoPort a aex:FieldOneOfValue ;
    aex:oneOfValueOf aex:AshA2aAuthorityGate ; aex:oneOfValueOrder 1 ; aex:oneOfValueName "two_port" .
aex:AshA2aAuthorityGateOpen a aex:FieldOneOfValue ;
    aex:oneOfValueOf aex:AshA2aAuthorityGate ; aex:oneOfValueOrder 2 ; aex:oneOfValueName "open" .
aex:AshA2aAuthorityGateDisabled a aex:FieldOneOfValue ;
    aex:oneOfValueOf aex:AshA2aAuthorityGate ; aex:oneOfValueOrder 3 ; aex:oneOfValueName "disabled" .

aex:AshA2aAuthorityLeaseDuration a aex:SectionSchemaField ;
    aex:sectionFieldOf aex:AshA2aAuthoritySection ;
    aex:sectionFieldOrder 2 ; aex:sectionFieldName "lease_duration_ms" ; aex:sectionFieldType "integer" ;
    aex:sectionFieldDefault "60_000" ;
    aex:sectionFieldDoc "Default lease lifetime in milliseconds. Real Spark type :pos_integer (dsl.ex:197)." ;
    aex:dslCitation "lib/ash_a2a/dsl.ex:195-200" .

# --- :hooks section (dsl.ex:204-219) ---

