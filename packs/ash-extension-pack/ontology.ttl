#################################################################
# ash_a2a a2a-section projection surface (M2 lane, 2026-10-04) --
# the canonical pack absorbs the real, already-shipped ash_a2a A2A-projection
# DSL shape, transcribed from /Users/sac/ash_a2a/lib/ash_a2a/dsl.ex and
# /Users/sac/ash_a2a/lib/ash_a2a/verifiers/verify_skills.ex
# (main@5a84d886e0696cd43115799bbdc4bc8ec481376c, dsl.ex/verify_skills.ex
# unchanged since 19a03c8 "publish ash_a2a 26.10.2"; confirmed by direct read,
# not memory) -- the same acceptance-fixture discipline as the AshR2RMLSpec
# block above. Only the DSL SHAPE is modeled; ash_a2a's real transformer/
# verifier BODIES (BuildCapabilityIndex, VerifySkills' four checks) are
# hand-written domain logic and are deliberately NOT modeled or regenerated
# here.
#
# Reuses the existing aex: vocabulary (aex:DslSection / aex:DslEntity /
# aex:EntitySchemaField / aex:SectionSchemaField / aex:NestedEntity /
# aex:EntityArg / aex:FieldOneOfValue / aex:SemanticFact / aex:SurfaceFact).
# ONE new property: aex:dslCitation, carrying the verbatim lib/ash_a2a/dsl.ex
# line range each fact was transcribed from (echo, don't synthesize).
# aex:dslCitation is attested consumed by templates/a2a_skill.ex.tmpl and
# gates/140_a2a_skill_fields_contract.rq; see gates/150_a2a_dead_surface.rq.
#
# Two transcription notes, stated rather than silently degraded:
#  - the skill entity's real positional args are
#    [:name, {:optional, :resource}, :action] (dsl.ex:153); aex:EntityArg
#    models plain names only, so the {:optional, :resource} wrapper is stated
#    in the aex:AshA2aSkillArgResource comment, not fabricated as new syntax.
#  - aex:fieldType's closed vocabulary has no :map or tuple form; fields whose
#    real Spark type is {:map, :string, :atom} / {:list, {:tuple, ...}} /
#    {:or, [:module, :mfa]} carry fieldType "any" and state the exact Spark
#    type in fieldDoc -- same echo discipline as aex:fieldType's own comment.
#################################################################

aex:dslCitation a rdf:Property ;
    rdfs:comment "verbatim source citation for a transcribed DSL fact, e.g. \"lib/ash_a2a/dsl.ex:69-77\" -- the line range the fact was read from on the cited SHA, stated at transcription time so drift between this pack and its ground truth is greppable. Domain: any aex:DslSection / aex:DslEntity / aex:EntitySchemaField / aex:SectionSchemaField individual. Consumed by templates/a2a_skill.ex.tmpl (renders the citation into the generated example's moduledoc) and gates/140_a2a_skill_fields_contract.rq (refuses the three v26.10 skill fields without their dsl.ex citation); dead-surface checked by gates/150_a2a_dead_surface.rq." .

# --- Worked instance: the real ash_a2a extension (the a2a-section fixture) ---

aex:AshA2aSpec a aex:AshExtensionSpec ;
    aex:fixtureOnly true ;
    aex:packageName "ash_a2a" ;
    aex:moduleName "AshA2A.Dsl" ;
    aex:extensionTarget "domain" ;
    aex:dslCitation "lib/ash_a2a/ash_a2a.ex:25 (sections: AshA2A.Dsl.sections()) + lib/ash_a2a/dsl.ex:221 (sections/0 -> [@a2a, @authority, @hooks])" ;
    rdfs:comment "The real AshA2A extension module (lib/ash_a2a.ex:24-29) attaches one extension to BOTH resources and domains (use Ash.Resource, extensions: [AshA2A] / use Ash.Domain, extensions: [AshA2A], e.g. test/support/auth_plug_fixture.ex:21,47); aex:extensionTarget is single-valued and closed, so the spec carries \"domain\" and this comment carries the dual-attachment fact." .

# --- :a2a section (dsl.ex:158-185) ---

aex:AshA2aSection a aex:DslSection ;
    aex:sectionOf aex:AshA2aSpec ;
    aex:sectionName "a2a" ;
    aex:sectionOrder 1 ;
    aex:sectionDescribe "Optional residual A2A overrides. Public Ash actions are exposed without declarations." ;
    aex:dslCitation "lib/ash_a2a/dsl.ex:158-185" .

# --- skill entity (dsl.ex:147-156), target AshA2A.Skill (lib/ash_a2a/skill.ex) ---

aex:AshA2aSkillEntity a aex:DslEntity ;
    aex:entityOf aex:AshA2aSection ;
    aex:entityOrder 1 ; aex:entityName "skill" ;
    aex:entityStruct "AshA2A.Skill" ; aex:entityIdentifier "name" ;
    aex:entityDescribe "Overrides A2A projection metadata for an existing public Ash action." ;
    aex:dslCitation "lib/ash_a2a/dsl.ex:147-156" .

# Positional args: args: [:name, {:optional, :resource}, :action] (dsl.ex:153).
aex:AshA2aSkillArgName a aex:EntityArg ;
    aex:argOf aex:AshA2aSkillEntity ; aex:argOrder 1 ; aex:argName "name" .
aex:AshA2aSkillArgResource a aex:EntityArg ;
    rdfs:comment "rendered positionally as :resource; the real Spark args list wraps this entry as {:optional, :resource} (dsl.ex:153), which aex:EntityArg's plain-name vocabulary does not model -- see the block comment." ;
    aex:argOf aex:AshA2aSkillEntity ; aex:argOrder 2 ; aex:argName "resource" .
aex:AshA2aSkillArgAction a aex:EntityArg ;
    aex:argOf aex:AshA2aSkillEntity ; aex:argOrder 3 ; aex:argName "action" .

