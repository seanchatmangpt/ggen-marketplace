@prefix aex:  <http://seanchatmangpt.github.io/packs/ash-extension-core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

#################################################################
# Vocabulary
#################################################################

aex:AshExtensionSpec a rdfs:Class ;
    rdfs:label "One Ash extension to manufacture: a Spark.Dsl.Extension plus its transformer, verifier, Info module, and Igniter installer -- generalized from the real ash_r2rml/lib/ash_r2rml/resource.ex shape." .

aex:packageName    a rdf:Property ; rdfs:domain aex:AshExtensionSpec ; rdfs:comment "hex package name, snake_case, e.g. audit_trail" .
aex:moduleName     a rdf:Property ; rdfs:domain aex:AshExtensionSpec ; rdfs:comment "top Elixir module, e.g. AuditTrail.Resource" .
aex:extensionTarget a rdf:Property ; rdfs:domain aex:AshExtensionSpec ; rdfs:comment "closed: \"resource\" | \"domain\" -- what Ash.Resource/Ash.Domain `extensions:` this attaches to." .
aex:singleExtensionKind a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional -- the `use Spark.Dsl.Extension, single_extension_kinds: [...]` atom (ash_r2rml's resource.ex sets single_extension_kinds: [:ash_r2rml]), refusing more than one extension of this kind on the same resource. Absent means the option is omitted entirely (not rendered as an empty list)." .

aex:taskModuleName a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "explicit, admitted `Mix.Tasks.<X>.Install` module name segment (e.g. \"AshR2rml\" for ash_r2rml -- Elixir's Macro.camelize(\"ash_r2rml\") == \"AshR2rml\", NOT a naive dot-strip of moduleName, which would wrongly produce \"AshR2RMLResource\" from moduleName \"AshR2RML.Resource\"). Stated as fact, not derived by string manipulation from packageName/moduleName, per this pack's \"echo, don't synthesize\" discipline -- a real parity check against ash_r2rml caught exactly this derivation bug." .
aex:formatterModule a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "explicit, admitted formatter plugin module (e.g. \"AshR2RML.Formatter\" -- a TOP-LEVEL sibling of AshR2RML.Resource, not moduleName <> \".Formatter\", which would wrongly produce \"AshR2RML.Resource.Formatter\"). Same reasoning as aex:taskModuleName." .
aex:codegenTask a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional exact Mix task name delegated to by the generated Ash.Extension codegen/1 callback, e.g. \"ash_expo.codegen\". The renderer re-enables and runs this task with the argv supplied by mix ash.codegen; the task name is admitted as fact and is never synthesized from packageName." .
aex:codegenName a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional human/display name returned by name/0 when aex:codegenTask is present, e.g. \"ash_expo\". Ash's mix ash.codegen uses this only for display; it does not grant authority or alter callback dispatch." .
aex:supportSubdir a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional safe relative subdirectory under lib/<package>/ for generated support modules (Persist, Verify, Info, and Reactor). Absent preserves the historical paths directly under lib/<package>/. Used when a consumer already owns a handwritten file such as lib/ash_expo/info.ex and generated support must remain separately owned." .
aex:fixtureOnly a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "boolean marker for pack-owned worked examples. fixtureOnly=true individuals remain available to gates/audits but MUST NOT fan out consumer artifacts." .

# Ported from ash-extension-core-pack ontology.ttl (v26.9.30 consolidation, lane 6):
# the CODEGEN_CALLBACK and support_subdir capabilities, verbatim.

aex:codegenTask a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional exact Mix task name delegated to by the generated Ash.Extension codegen/1 callback, e.g. \"ash_expo.codegen\". The renderer re-enables and runs this task with the argv supplied by mix ash.codegen; the task name is admitted as fact and is never synthesized from packageName." .
aex:codegenName a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional human/display name returned by name/0 when aex:codegenTask is present, e.g. \"ash_expo\". Ash's mix ash.codegen uses this only for display; it does not grant authority or alter callback dispatch." .
aex:supportSubdir a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional safe relative subdirectory under lib/<package>/ for generated support modules (Persist, Verify, Info, and Reactor). Absent preserves the historical paths directly under lib/<package>/. Used when a consumer already owns a handwritten file such as lib/ash_expo/info.ex and generated support must remain separately owned." .

aex:DslSection a rdfs:Class ;
    rdfs:label "One Spark.Dsl.Section this extension contributes (ash_r2rml has two: :r2rml, :sparql)." .
aex:sectionOf   a rdf:Property ; rdfs:domain aex:DslSection ; rdfs:range aex:AshExtensionSpec .
aex:sectionName a rdf:Property ; rdfs:domain aex:DslSection ; rdfs:comment "atom name, e.g. :audit" .
aex:sectionOrder a rdf:Property ; rdfs:domain aex:DslSection .
aex:sectionDescribe a rdf:Property ; rdfs:domain aex:DslSection ; rdfs:comment "optional Spark.Dsl.Section :describe string, e.g. ash_r2rml's :r2rml.describe." .

aex:singletonEntityKey a rdf:Property ; rdfs:domain aex:DslSection ;
    rdfs:comment "0+ rows -- an entity name (atom) listed in this section's singleton_entity_keys:, mirroring ash_r2rml's :r2rml section (singleton_entity_keys: [:subject]). Replaces a per-entity boolean: singleton-ness is a SECTION-level list in real Spark, not an entity flag." .

aex:SchemaField a rdfs:Class ;
    rdfs:label "Common superclass of entity-level and section-level Spark schema fields." .
aex:EntitySchemaField a rdfs:Class ;
    rdfs:subClassOf aex:SchemaField .
aex:SectionSchemaField a rdfs:Class ;
    rdfs:subClassOf aex:SchemaField ;
    rdfs:label "One field of a DslSection's own top-level Spark schema (ash_r2rml's :r2rml section schema: table_name/sql_query/schema), distinct from a DslEntity's schema." .
aex:sectionFieldOf   a rdf:Property ; rdfs:domain aex:SectionSchemaField ; rdfs:range aex:DslSection .
aex:sectionFieldOrder a rdf:Property ; rdfs:domain aex:SectionSchemaField .
aex:sectionFieldName a rdf:Property ; rdfs:domain aex:SectionSchemaField .
aex:sectionFieldType a rdf:Property ; rdfs:domain aex:SectionSchemaField ; rdfs:comment "same closed Spark-type vocabulary as aex:fieldType." .
aex:sectionFieldDefault a rdf:Property ; rdfs:domain aex:SectionSchemaField ;
    rdfs:comment "optional literal Elixir default value source rendered verbatim after `default:`; extracted from real Spark section schemas such as AshExpo's enabled?: true." .
aex:sectionFieldDoc a rdf:Property ; rdfs:domain aex:SectionSchemaField ;
    rdfs:comment "optional Spark schema documentation string for a section-level option." .

aex:DslEntity a rdfs:Class ;
    rdfs:label "One Spark.Dsl.Entity inside a section (ash_r2rml: Class/Subject/Property/Reference/Graph/SparqlQuery)." .
aex:entityOf       a rdf:Property ; rdfs:domain aex:DslEntity ; rdfs:range aex:DslSection .
aex:entityName     a rdf:Property ; rdfs:domain aex:DslEntity ; rdfs:comment "atom name, e.g. :event. NOTE: the Spark entity name can differ from its struct's local name -- ash_r2rml's SparqlQuery entity is named :query, not :sparql_query." .
aex:entityOrder    a rdf:Property ; rdfs:domain aex:DslEntity ; rdfs:comment "position within its section's entities: [...] list -- SPARQL result order is not guaranteed to match source-declaration order without this, and a real parity check against ash_r2rml/resource.ex caught exactly this (entities rendered reversed) before this property existed." .
aex:entityStruct   a rdf:Property ; rdfs:domain aex:DslEntity ; rdfs:comment "backing struct module, e.g. AuditTrail.Dsl.Event" .
aex:entityDescribe a rdf:Property ; rdfs:domain aex:DslEntity ;
    rdfs:comment "optional Spark.Dsl.Entity :describe string, preserved from real extension DSLs such as AshExpo.Resource.Action." .
aex:entityIdentifier a rdf:Property ; rdfs:domain aex:DslEntity ;
    rdfs:comment "optional -- this entity's Spark :identifier field name (must be one of its own schema field names), e.g. ash_r2rml's Property entity has identifier: :attribute. Absent means Spark defaults identifier from the first positional arg." .

aex:EntityArg a rdfs:Class ;
    rdfs:label "One positional Spark.Dsl.Entity :args entry (ash_r2rml's Property entity: args: [:attribute, :predicate_iri]) -- ordered, distinct from the full schema field list." .
aex:argOf    a rdf:Property ; rdfs:domain aex:EntityArg ; rdfs:range aex:DslEntity .
aex:argOrder a rdf:Property ; rdfs:domain aex:EntityArg .
aex:argName  a rdf:Property ; rdfs:domain aex:EntityArg ; rdfs:comment "must match one of this entity's own schema field names." .

aex:EntitySchemaField a rdfs:Class ;
    rdfs:label "One field of a DslEntity's Spark schema (name/type/required/doc)." .
aex:fieldOf      a rdf:Property ; rdfs:domain aex:EntitySchemaField ; rdfs:range aex:DslEntity .
aex:fieldOrder   a rdf:Property ; rdfs:domain aex:EntitySchemaField .
aex:fieldName    a rdf:Property ; rdfs:domain aex:EntitySchemaField .
aex:fieldType    a rdf:Property ; rdfs:domain aex:EntitySchemaField ;
    rdfs:comment "closed set: atom | string | boolean | integer | module | list_atom | list_string | or_string_list_string | one_of | any. \"one_of\" and \"or_string_list_string\" are shape markers -- one_of's actual enum values come from aex:fieldOneOfValue rows; or_string_list_string renders the exact {:or, [:string, {:list, :string}]} union ash_r2rml's Class.iri uses." .
aex:fieldRequired a rdf:Property ; rdfs:domain aex:EntitySchemaField .
aex:fieldDoc     a rdf:Property ; rdfs:domain aex:EntitySchemaField .
aex:fieldDefault a rdf:Property ; rdfs:domain aex:EntitySchemaField ;
    rdfs:comment "optional literal Elixir default value source, e.g. \":iri\" or \":literal\" or \"[]\" -- rendered verbatim after `default:`." .

aex:FieldOneOfValue a rdfs:Class ;
    rdfs:label "One allowed atom value for a fieldType=\"one_of\" field, ordered (ash_r2rml's Subject.term_type: {:one_of, [:iri, :blank_node]})." .
aex:oneOfValueOf   a rdf:Property ; rdfs:domain aex:FieldOneOfValue ; rdfs:range aex:SchemaField .
aex:oneOfValueOrder a rdf:Property ; rdfs:domain aex:FieldOneOfValue .
aex:oneOfValueName a rdf:Property ; rdfs:domain aex:FieldOneOfValue ; rdfs:comment "atom text without the leading colon, e.g. \"iri\"." .

aex:Verifier a rdfs:Class ;
    rdfs:label "One legality constraint the generated verifier module checks, mirroring ash_r2rml's AshR2RML.Resource.Verify (which asserts persisted mapping exists and calls AshR2RML.Mapping.validate/1)." .
aex:verifierOf    a rdf:Property ; rdfs:domain aex:Verifier ; rdfs:range aex:AshExtensionSpec .
aex:verifierName  a rdf:Property ; rdfs:domain aex:Verifier ; rdfs:comment "slug, e.g. unique_event_name" .
aex:verifierDoc   a rdf:Property ; rdfs:domain aex:Verifier .

#################################################################
# aex:workflowReactor vs aex:generatesReceiptedAction -- these are INDEPENDENT,
# COMPOSABLE capabilities, not a hierarchy or mutual exclusion. A single
# aex:AshExtensionSpec may set either one, both, or neither:
#   - neither: no Reactor pipeline, no receipted-action wrapper.
#   - workflowReactor only: a plain opt-in Ash.Reactor pipeline (steps declared via
#     aex:ReactorStep, optional compensate/undo via aex:workflowReversible /
#     aex:stepHasCompensate).
#   - generatesReceiptedAction only: the idempotency-key/receipt/replay wrapper can
#     wrap a plain action call with no Reactor pipeline underneath it at all.
#   - both: the receipted-action wrapper's DO step runs the aex:ReactorStep-declared
#     Reactor pipeline, so the pipeline's own outcome becomes the sealed receipt's
#     payload. This is the ash_ex4pm brce_gate shape (admit -> pending-receipt ->
#     Reactor run -> outcome-receipt -> deterministic replay).
# This comment resolves a real, previously-underspecified boundary between
# ash-extension-core-pack (which only had workflowReactor) and
# ash-extension-starter-pack (which added generatesReceiptedAction without stating
# the relationship explicitly).
#################################################################

aex:workflowReactor a rdf:Property ; rdfs:domain aex:AshExtensionSpec ; rdfs:comment "boolean -- opt in to a generated Ash.Reactor pipeline (ash_r2rml/lib/ash_r2rml/reactor_pipeline.ex shape). Default false: Reactor is a capability, not mandatory for every extension. Independent of and composable with aex:generatesReceiptedAction -- see comment block above." .
aex:workflowReversible a rdf:Property ; rdfs:domain aex:AshExtensionSpec ; rdfs:comment "boolean -- generated Reactor steps include compensate/undo." .

aex:CompositionTarget a rdfs:Class ;
    rdfs:label "One :test-only compatibility target the generated composition test introspects against (mirrors ash_r2rml/test/ggen_api_bundle_test.exs: ash_graphql/ash_json_api are test-only deps, never runtime)." .
aex:compositionOf     a rdf:Property ; rdfs:domain aex:CompositionTarget ; rdfs:range aex:AshExtensionSpec .
aex:compositionTarget a rdf:Property ; rdfs:domain aex:CompositionTarget ; rdfs:comment "closed: \"ash_graphql\" | \"ash_json_api\"" .

#################################################################
# v26.9.9 additions -- sourced from real, currently-read source, not invented shape.
# Research citations: /Users/sac/xaas/deps/ash_ai (lib/ash_ai/transformers/resource_tools.ex,
# lib/ash_ai/dsl.ex), /Users/sac/ash_r2rml (lib/ash_r2rml/resource.ex:188-194 after?/1),
# /Users/sac/xaas (lib/xaas/library.ex:8, lib/xaas/library/book.ex:36 dual-level stacking).
# Deliberately NOT added here: a "Spark.Igniter.add_extension + AST-aware idempotent
# insertion" installer capability -- confirmed by direct read that ash_r2rml's own
# installer (lib/mix/tasks/ash_r2rml.install.ex) does not use Spark.Igniter at all and
# has no AST/zipper detection; no real exemplar of that pattern was found in either
# source repo, so it is not modeled rather than fabricated. See errc-tracker.md Cycle 3.
#################################################################

aex:contextNormalize a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "boolean, default false -- opt in to a generated resource/domain context-normalization transformer step, the ash_ai AshAi.Transformers.ResourceTools pattern (lib/ash_ai/transformers/resource_tools.ex:13-55,125-127): detect resource-vs-domain via `Module.get_attribute(module, :spark_is) == Ash.Resource`, fill in the target-context field on resource-local (implicit) declarations, raise Spark.Error.DslError if that field is explicitly supplied at the resource level, raise Spark.Error.DslError if it is missing at the domain level. Requires aex:contextTargetEntity and aex:contextTargetField." .
aex:contextTargetEntity a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "entity name (atom, no leading colon) whose instances carry the context-resolved field -- ash_ai's is \"tool\" (AshAi.Tool). Only meaningful when aex:contextNormalize is true." .
aex:contextTargetField a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "field name (atom, no leading colon) on aex:contextTargetEntity that is positionally optional (Spark `{:optional, :field}` in that entity's :args) and gets filled in / validated by the normalization transformer -- ash_ai's is \"resource\" (AshAi.Tool.resource, dsl.ex:264 `args: [:name, {:optional, :resource}, :action]`). Only meaningful when aex:contextNormalize is true." .

aex:afterTransformer a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "0+ rows -- a real Ash core transformer module name (e.g. \"Ash.Resource.Transformers.CachePrimaryKey\") this extension's Persist transformer must declare `after?/1 do: true` for, verbatim ash_r2rml/lib/ash_r2rml/resource.ex:188-194's five after?/1 clauses (CachePrimaryKey, DefaultPrimaryKey, SetRelationshipInformation, BelongsToAttribute, BelongsToSourceAttribute). Row order carries no meaning (each becomes its own independent after?/1 clause, `def after?(_), do: false` is the catch-all). Absence means Persist emits no after?/1 override at all (relies on Spark.Dsl.Transformer's own default of false for every module, same as ash_r2rml's implicit lack of a before?/1 override -- that repo has none, so this pack does not model before?/1 either)." .

aex:normalizeModule a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional -- module whose function (aex:normalizeFunction) the Persist transformer pipes the compiled map through before persisting, mirroring ash_r2rml's `AshR2RML.Mapping.normalize()` pipe (resource.ex:241) before `Transformer.persist(dsl, :ash_r2rml_public_mapping, mapping)` (resource.ex:243). Absent means no normalize pipe (current pack behavior, unchanged)." .
aex:normalizeFunction a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "function name (atom, no colon) on aex:normalizeModule, arity 1. Only meaningful when aex:normalizeModule is set." .
aex:provenanceSource a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional atom text (no colon), e.g. \"ash_first\" -- when set, the compiled map gets a `metadata: %{source: :<value>}` field, mirroring ash_r2rml's metadata sub-map (resource.ex:197-249, `source: :ash_first`)." .

aex:validateDelegateModule a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional -- when set (with aex:validateDelegateFunction), the generated Verify module's compiled-present branch delegates business validation to `Module.function(compiled)` instead of the per-aex:Verifier `with`-chain, mirroring ash_r2rml's exact 2-branch shape (resource.ex:492-511): nil-check stays inline, a separate module's `validate/1` does the real check, `:ok -> :ok`, `{:error, refusals} -> Spark.Error.DslError.exception(message: Enum.map_join(refusals, \"; \", &\"#{&1.code}: #{&1.detail}\"))`. Absent means the existing per-aex:Verifier default chain is used (unchanged)." .
aex:validateDelegateFunction a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "function name (atom, no colon) on aex:validateDelegateModule, arity 1, returning :ok | {:error, [%{code: _, detail: _}]}. Only meaningful when aex:validateDelegateModule is set." .

aex:legacyAdapterModule a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional -- when set (with aex:legacyAdapterFunction), the generated Info module's result-tuple getter rescues to `Module.function(resource)` on any error, mirroring ash_r2rml's Info.mapping_result/1 (resource.ex:527-534, `rescue _ -> AshR2RML.Resource.LegacyAdapter.convert(resource)`). Absent means no rescue clause (a plain {:error, ...} on absence, unchanged)." .
aex:legacyAdapterFunction a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "function name (atom, no colon) on aex:legacyAdapterModule, arity 1. Only meaningful when aex:legacyAdapterModule is set." .

aex:NestedEntity a rdfs:Class ;
    rdfs:label "One Spark.Dsl.Entity nested inside another entity's `entities:` field (ash_ai: @tool_argument nested under @tool via `entities: [arguments: [@tool_argument]]`, dsl.ex:228-268, target AshAi.Tool.Argument). Reuses aex:entityName/aex:entityStruct/aex:entityIdentifier and the existing aex:EntityArg (via aex:argOf)/aex:EntitySchemaField (via aex:fieldOf) vocabulary exactly like a top-level aex:DslEntity -- only the parent linkage differs." .
aex:nestedOf       a rdf:Property ; rdfs:domain aex:NestedEntity ; rdfs:range aex:DslEntity ; rdfs:comment "the parent entity this is declared under." .
aex:nestedFieldName a rdf:Property ; rdfs:domain aex:NestedEntity ; rdfs:comment "field name (atom, no colon) on the parent's `entities: [...]` keyword list AND the field on the parent struct holding the nested list, e.g. \"arguments\" for ash_ai's `entities: [arguments: [@tool_argument]]` / AshAi.Tool.arguments." .

aex:dualLevelFixture a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "boolean, default false -- generate composition_test fixtures at BOTH a resource-level and a domain-level module, each stacking this extension alongside the spec's aex:CompositionTarget extensions, instead of a single bare-fixture compile check. Real exemplar: xaas's Xaas.Library domain (lib/xaas/library.ex:8: extensions: [AshJsonApi.Domain, AshGraphql.Domain, AshAdmin.Domain, AshAi]) and Xaas.Library.Book resource (lib/xaas/library/book.ex:36: extensions: [AshJsonApi.Resource, AshGraphql.Resource, AshAdmin.Resource, AshAi]) -- same extension family co-resident with 2-3 other extensions at both levels in one real package, proving actual multi-extension compatibility rather than isolated single-extension compilation." .

#################################################################
# From ash-extension-starter-pack -- Receipted-action generation (xaas review
# finding #5). xaas's real Xaas.Actuation.run/4 (lib/xaas/actuation.ex:427-531) is
# architecturally distinct from aex:workflowReactor above (a plain opt-in Reactor
# pipeline with compensate/undo): it adds an idempotency-key-gated admission step, a
# sealed-receipt entity, transaction-wrapped DO so a committed mutation can never
# outrun its receipt, and a normalize_transaction_result step recognizing a distinct
# :replayed status. This is exactly the shape the ash_ex4pm PR/FAQ's `brce_gate`
# capability (/tmp/ash_ex4pm_prfaq.md) needs -- BRCE's own admit -> pending-receipt ->
# run -> outcome-receipt sandwich is the same pattern, not a coincidence. See the
# comment block above workflowReactor/generatesReceiptedAction for the explicit
# independent-composable-capabilities clarification.
#################################################################

aex:generatesReceiptedAction a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "boolean -- opt in to a generated receipted-action wrapper (idempotency-key admission -> pending receipt -> Ash.Reactor run -> sealed outcome receipt -> deterministic replay on a repeat idempotency key), modeled on xaas's real Xaas.Actuation.run/4 (lib/xaas/actuation.ex:427-531). Independent of and composable with aex:workflowReactor -- see comment block above workflowReactor. Default false." .

aex:receiptIdempotencyKeySource a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "0-1 rows if generatesReceiptedAction=true -- where the idempotency key comes from, e.g. \"caller_supplied\" | \"derived:<field>\". xaas's own stripe_webhook_controller need (an external event id as the key) is the motivating real case." .

#################################################################
# From ash-extension-starter-pack -- Reactor step-graph declaration (ash_r2rml
# review finding #1, ranked highest leverage of 5 confirmed gaps).
#
# ash_r2rml/lib/ash_r2rml/reactor_pipeline.ex:35-65 declares five ordered,
# dependency-wired steps with per-step argument/result() wiring, max_retries, and
# per-step compensate/4 behavior -- not expressible as aex:workflowReactor's single
# boolean. This class generalizes it into a spec-declared, arbitrary-length step
# graph. This pack's templates use the DYNAMIC step-graph shape exclusively -- see
# pack.toml's "competing reactor_pipeline templates" conflict-resolution note.
#################################################################

aex:ReactorStep a rdfs:Class ;
    rdfs:label "One step of a generated Reactor pipeline, generalizing ash_r2rml/lib/ash_r2rml/reactor_pipeline.ex's five hardcoded steps (compile_resources -> verify_alignment/evaluate_differential -> attach_provenance -> apply_policy -> render_r2rml_turtle) into a spec-declared, arbitrary-length step graph." .

aex:stepOf       a rdf:Property ; rdfs:domain aex:ReactorStep ; rdfs:range aex:AshExtensionSpec .
aex:stepName     a rdf:Property ; rdfs:domain aex:ReactorStep ; rdfs:comment "atom step name, e.g. :compile_resources." .
aex:stepOrder    a rdf:Property ; rdfs:domain aex:ReactorStep .
aex:stepModule   a rdf:Property ; rdfs:domain aex:ReactorStep ; rdfs:comment "the Reactor step module's own suffix, e.g. \"CompileResources\" for lib/ash_r2rml/reactor/steps/compile_resources.ex." .
aex:stepWaitFor  a rdf:Property ; rdfs:domain aex:ReactorStep ; rdfs:comment "0+ rows -- names of other aex:ReactorStep rows this step's `wait_for` depends on, e.g. attach_provenance waits_for verify_alignment (ash_r2rml/lib/ash_r2rml/reactor_pipeline.ex, wait_for :verify_alignment)." .
aex:stepMaxRetries a rdf:Property ; rdfs:domain aex:ReactorStep ; rdfs:comment "integer, mirrors this step's own Reactor `max_retries`." .
aex:stepHasCompensate a rdf:Property ; rdfs:domain aex:ReactorStep ; rdfs:comment "boolean -- whether this step defines its own compensate/4 (ash_r2rml/lib/ash_r2rml/reactor/steps/render_turtle.ex:27-31 is the worked real example)." .
aex:stepIsReturn a rdf:Property ; rdfs:domain aex:ReactorStep ; rdfs:comment "boolean -- whether this is the pipeline's own `return :step_name` step. Exactly one row per spec should be true when generatesReceiptedAction or workflowReactor is set; a spec with zero or >1 true rows is a real, verifiable defect -- see gates/040_reactor_step_graph_contract.rq, which now implements this check." .

#################################################################
# NEW in this consolidation (ash-extension-pack) -- real, cited MUST items.
#################################################################

# (a) Installer runtime-dependency injection.
# Real precedent: /Users/sac/ash_a2a/lib/mix/tasks/ash_a2a.install.ex:58's
# Igniter.Project.Deps.add_dep({:a2a, "~> 0.2"}) -- an installer needs to declare a
# package+version-req pair for Igniter to inject into mix.exs deps via
# Igniter.Project.Deps.add_dep, not just patch the extensions: list.
aex:installerRuntimeDep a rdf:Property ; rdfs:domain aex:AshExtensionSpec ;
    rdfs:comment "optional -- a package+version-req pair (e.g. \"a2a ~> 0.2\") the generated Igniter installer injects via Igniter.Project.Deps.add_dep/2,3, verbatim the real ash_a2a shape (/Users/sac/ash_a2a/lib/mix/tasks/ash_a2a.install.ex:58, Igniter.Project.Deps.add_dep({:a2a, \"~> 0.2\"})). Absent means the installer injects no runtime dependency (current pack behavior, unchanged)." .

# (b) 4-form Info-module getter.
# Real precedent: /Users/sac/ash_a2a/lib/ash_a2a/info.ex:39-45,64-71,88-99,117-120's
# capability_index/1, capability_index_result/1, capability_index!/1,
# capability_index?/1 pattern, all delegating to one shared _result/1.
aex:InfoGetter a rdfs:Class ;
    rdfs:label "One Info-module getter to generate as a 4-form surface (plain nil-returning wrapper, _result/1 tagged-tuple, !/1 bang, ?/1 predicate), all delegating to the shared _result/1 form -- verbatim the real ash_a2a Info-module shape (/Users/sac/ash_a2a/lib/ash_a2a/info.ex:39-45,64-71,88-99,117-120, capability_index/1 / capability_index_result/1 / capability_index!/1 / capability_index?/1)." .
aex:getterOf a rdf:Property ; rdfs:domain aex:InfoGetter ; rdfs:range aex:AshExtensionSpec ; rdfs:comment "the parent AshExtensionSpec this Info-module getter belongs to." .
aex:getterName a rdf:Property ; rdfs:domain aex:InfoGetter ; rdfs:comment "the getter's base name (atom text, no colon), e.g. \"capability_index\" -- the 4 generated function names are this value bare, plus _result, plus ! (bang), plus ? (predicate)." .
aex:getterSourceSection a rdf:Property ; rdfs:domain aex:InfoGetter ; rdfs:range aex:DslSection ;
    rdfs:comment "the aex:DslSection this getter reads its introspected value from -- MUST reference a real aex:DslSection whose aex:sectionOf equals this same InfoGetter's aex:getterOf (checked by gates/050_info_getter_quadruple_contract.rq)." .

