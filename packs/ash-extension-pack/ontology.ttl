# aex:installerRuntimeDep, aex:InfoGetter, and aex:generatesReceiptedAction +
# aex:ReactorStep together, added by this consolidation.
#################################################################

aex:NotificationExtensionSpec a aex:AshExtensionSpec ;
    aex:fixtureOnly true ;
    aex:packageName "notification_extension" ;
    aex:moduleName "NotificationExtension.Resource" ;
    aex:extensionTarget "resource" ;
    aex:taskModuleName "NotificationExtension" ;
    aex:formatterModule "NotificationExtension.Formatter" ;
    aex:workflowReactor false ;
    aex:workflowReversible false ;
    aex:installerRuntimeDep "a2a ~> 0.2" ;
    aex:generatesReceiptedAction true ;
    aex:receiptIdempotencyKeySource "caller_supplied" .

aex:NotificationExtensionSection a aex:DslSection ;
    aex:sectionOf aex:NotificationExtensionSpec ;
    aex:sectionName "notification" ;
    aex:sectionOrder 1 ;
    aex:sectionDescribe "Notification channel and delivery-rule metadata." .

aex:NotificationExtensionChannelEntity a aex:DslEntity ;
    aex:entityOf aex:NotificationExtensionSection ;
    aex:entityOrder 1 ; aex:entityName "channel" ;
    aex:entityStruct "NotificationExtension.Dsl.Channel" .

aex:NotificationExtensionChannelName a aex:EntitySchemaField ;
    aex:fieldOf aex:NotificationExtensionChannelEntity ;
    aex:fieldOrder 1 ; aex:fieldName "name" ; aex:fieldType "atom" ;
    aex:fieldRequired true ; aex:fieldDoc "The notification channel's slug." .

aex:NotificationExtensionGetter a aex:InfoGetter ;
    aex:getterOf aex:NotificationExtensionSpec ;
    aex:getterName "channel_index" ;
    aex:getterSourceSection aex:NotificationExtensionSection .

aex:NotificationExtensionAdmitStep a aex:ReactorStep ;
    aex:stepOf aex:NotificationExtensionSpec ;
    aex:stepName "admit" ; aex:stepOrder 1 ; aex:stepModule "Admit" ;
    aex:stepMaxRetries 0 ; aex:stepHasCompensate false ; aex:stepIsReturn false .

aex:NotificationExtensionDeliverStep a aex:ReactorStep ;
    aex:stepOf aex:NotificationExtensionSpec ;
    aex:stepName "deliver" ; aex:stepOrder 2 ; aex:stepModule "Deliver" ;
    aex:stepWaitFor aex:NotificationExtensionAdmitStep ;
    aex:stepMaxRetries 3 ; aex:stepHasCompensate true ; aex:stepIsReturn false .

aex:NotificationExtensionSealReceiptStep a aex:ReactorStep ;
    aex:stepOf aex:NotificationExtensionSpec ;
    aex:stepName "seal_receipt" ; aex:stepOrder 3 ; aex:stepModule "SealReceipt" ;
    aex:stepWaitFor aex:NotificationExtensionDeliverStep ;
    aex:stepMaxRetries 0 ; aex:stepHasCompensate false ; aex:stepIsReturn true .

#################################################################
# Package license file family (finish-paydown-026 -- first ledger-paydown
# capability: the consumer repo ash_surface carries a hand-written LICENSE with
# a matching open ledger row; this family is the pack-side capability that
# retires that pair once admitted).
#################################################################

aex:PackageLicenseFile a rdfs:Class ;
    rdfs:label "One package LICENSE file a generated repo ships: an SPDX-identifiable license text with an explicit copyright line. The body text lives in templates/LICENSE.tmpl (rendered verbatim); the ontology carries only the stated facts, per this pack's echo-don't-synthesize discipline." .

aex:licensePackage a rdf:Property ; rdfs:domain aex:PackageLicenseFile ;
    rdfs:comment "hex package name the LICENSE belongs to, snake_case, e.g. \"ash_surface\" -- stated, not derived from any spec row (a repo can ship a LICENSE without being an aex:AshExtensionSpec)." .
aex:licenseSpdx a rdf:Property ; rdfs:domain aex:PackageLicenseFile ;
    rdfs:comment "SPDX license identifier, closed set: \"MIT\" (the only body templates/LICENSE.tmpl can render truthfully today). Anything else is refused by gates/070_license_file_contract.rq rather than silently emitting a wrong license body." .
aex:licenseCopyrightLine a rdf:Property ; rdfs:domain aex:PackageLicenseFile ;
    rdfs:comment "the exact copyright line rendered verbatim on line 3 of the emitted file, e.g. \"Copyright (c) 2026 Sean Chatman\" -- stated as fact, never synthesized from owner name + year." .

#################################################################
# Worked instance: ash_surface package license (the ledger-paydown round trip
# for this pack). Facts echo the consumer's real file byte-for-byte:
# /Users/sac/ash-surface-wt/g26 LICENSE, 1069 bytes, md5
# 1a18525b755dba67b8e1bbfa8348a642, SPDX-wrapped body byte-identical to
# deps/ash_a2a/LICENSE (the author's own MIT file); the copyright line is the
# one the consumer's gapfix-license-014 derived from its sole identity anchors
# (mix.exs:5 @source_url owner seanchatmangpt = git author Sean Chatman, 100%
# of commits; mix.exs:84 licenses: [\"MIT\"]).
#################################################################

aex:AshSurfaceLicense a aex:PackageLicenseFile ;
    aex:licensePackage "ash_surface" ;
    aex:licenseSpdx "MIT" ;
    aex:licenseCopyrightLine "Copyright (c) 2026 Sean Chatman" .

#################################################################
# Scripts index doc family (chicago-ledger-shrink2-050 -- second
# ledger-paydown capability: the consumer repo ash_surface carries a
# hand-written scripts/README.md with a matching open ledger row
# (HANDWRITTEN.md + surf:UnsupportedLedgerRow20); this family is the
# pack-side capability that retires that pair once admitted.
#################################################################

aex:ScriptsIndexDoc a rdfs:Class ;
    rdfs:label "One repo's scripts-directory index doc (e.g. scripts/README.md): a heading naming the directory plus one ordered section per indexed script. The structural law lives in templates/SCRIPTS_README.tmpl ('# <dir>/' heading; '## <file> — <role>' section headers; sections ordered by file name); the ontology carries only the stated facts, per this pack's echo-don't-synthesize discipline." .

aex:ScriptsIndexEntry a rdfs:Class ;
    rdfs:label "One script indexed by a aex:ScriptsIndexDoc: its file name, its one-line role as rendered in the section header, and its section body stated verbatim." .

aex:scriptsIndexRepo a rdf:Property ; rdfs:domain aex:ScriptsIndexDoc ;
    rdfs:comment "repo the index belongs to, e.g. \"ash_surface\" -- stated, not derived; names the owning consumer, never rendered into the doc bytes." .
aex:scriptsIndexDir a rdf:Property ; rdfs:domain aex:ScriptsIndexDoc ;
    rdfs:comment "directory the index documents, e.g. \"scripts\" -- rendered verbatim as the '# <dir>/' heading. Stated, not derived from any path scan (a repo can ship an index for a directory the pack never enumerates). Refused fail-closed by gates/080_scripts_index_contract.rq when blank, containing '/' or a newline -- any of those would render a WRONG heading while claiming pack provenance." .
aex:scriptsIndexEntryFile a rdf:Property ; rdfs:domain aex:ScriptsIndexEntry ;
    rdfs:comment "the indexed script's file name, e.g. \"bump_version.sh\" -- rendered verbatim in the section header. Blank or path-containing values refuse fail-closed (gate 080); duplicate values across entries refuse (two sections, one script, split provenance)." .
aex:scriptsIndexEntryRole a rdf:Property ; rdfs:domain aex:ScriptsIndexEntry ;
    rdfs:comment "the one-line role rendered after the em-dash in the section header, stated verbatim -- echo, don't synthesize. Blank or multi-line values refuse fail-closed (the heading law is one line)." .
aex:scriptsIndexEntryBody a rdf:Property ; rdfs:domain aex:ScriptsIndexEntry ;
    rdfs:comment "the section body under the header, stated verbatim (echo, don't synthesize). Blank, or containing a nested '## ' section header, refuses fail-closed -- a nested header would emit a foreign section under the wrong owner's provenance." .

#################################################################
# Worked instance: ash_surface scripts index (the second ledger-paydown
# round trip for this pack). Facts echo the consumer's real file
# byte-for-byte: /Users/sac/ash-surface-wt/g50 scripts/README.md, 6769
# bytes, md5 1ee5cc8cbc923bc478d28031e8b6d6ce; doc heading '# scripts/';
# three sections ordered by file name (the template's ORDER BY ?entry_file
# law reproduces the consumer's existing order); bodies are the exact
# line ranges between each section header and the next, verified by
# splitting the real file and reconstructing it byte-identically.
#################################################################

aex:AshSurfaceScriptsIndex a aex:ScriptsIndexDoc ;
    aex:scriptsIndexRepo "ash_surface" ;
    aex:scriptsIndexDir "scripts" .

aex:AshSurfaceScriptsIndexBumpVersion a aex:ScriptsIndexEntry ;
    aex:scriptsIndexEntryFile "bump_version.sh" ;
    aex:scriptsIndexEntryRole "the version bump mechanism" ;
    aex:scriptsIndexEntryBody """`bash scripts/bump_version.sh --check <new-version>` prints the complete bump
plan; `bash scripts/bump_version.sh <new-version>` applies it and runs the full
gate set (`mix format --check-formatted`, `mix test`, `npm test`). It is the
one lawful way to move the CalVer: hand-editing a version constant or a frozen
golden instead of running (or extending) this script is a contract violation.

### The version law it enforces (t09/t35 canon)

`mix.exs @version`, `lib/ash_surface.ex` (`@surface_schema_version`,
`@generator_identity`, `marketplaceIdentity`), the JS runtime's
`SURFACE_RUNTIME_VERSION`, and the projector `CalVer` headers must all agree,
and every golden that freezes a *consequence* of the version must be
regenerated in the same change:

| Golden family | File | What the bump changes |
|---|---|---|
| `@golden_version` / `GOLDEN_VERSION` | `test/ash_surface/version_sync_test.exs`, `test/js/version_sync.test.mjs` | pinned literal (text rewrite) |
| contract identity pins | `manifest_serializer`, `mx_closed_loop_episode/deep`, `expo_schemas/events`, `e2e_hermetic`, `zoela_mx_consumer_fixture`, `receipts_primitives`, `digest_cross_language` `contractJson` fixtures | pinned literals (text rewrite) |
| `@golden_runtime_sha256` | `test/ash_surface/runtime_source_test.exs` (t09) | SHA-256 over the whole runtime file — recomputed |
| `@golden` (5 digests) | `test/ash_surface/digest_test.exs` | `surfaceSchemaVersion` / `generatorIdentity` / `marketplaceIdentity` participate in the contract digest — recomputed |
| `elixirDigest` (3 digests) | `test/js/digest_cross_language.test.mjs` | same fields inside the embedded contract JSONs — recomputed |

### Fail-closed behavior

- **Unhandled drift** — the old version string appearing in any file outside
  the declared handled set (or a handled file losing its pin) refuses the bump
  with exit 1 and the offending paths.
- **Golden self-proof** — before trusting any regenerated value, the embedded
  generator re-derives *every current golden at the old version* through the
  real pipelines (`AshSurface.from_manifest/2`, the frozen
  `canonical_term` digest law, SHA-256 over the shipped runtime). Any mismatch
  (e.g. `digest_test.exs` fixtures changed shape) aborts with
  `BUMPGEN_SELFPROOF_FAIL` — the mirror in the generator must be updated in
  the same change.
- **Post-apply invariants** — zero occurrences of the old version anywhere,
  new constants present in every handled file, old golden hexes gone.

Scratch output goes to `_build/bump_version_generator.exs` (gitignored), never
the source tree. Exit codes: `0` verified, `1` drift/self-proof/gate failure,
`2` usage.""" .

aex:AshSurfaceScriptsIndexZeroConfigCheck a aex:ScriptsIndexEntry ;
    aex:scriptsIndexEntryFile "zero_config_check.sh" ;
    aex:scriptsIndexEntryRole "the fresh-clone proof" ;
    aex:scriptsIndexEntryBody """`bash scripts/zero_config_check.sh` proves the **zero-config** property of this
repository: a brand-new clone of the worktree's current HEAD, given nothing but
`PATH` and `HOME`, installs its own dependencies and passes its full gate.

### What it does

1. **Hermetic guard** — re-execs itself through
   `env -i PATH="$PATH" HOME="$HOME" ZERO_CONFIG_SANITIZED=1`, so no caller
   configuration (`MIX_ENV`, `HEX_*`, `NPM_CONFIG_*`, `ASDF_*`, ...) can leak
   into the proof. The only extra variable is the recursion sentinel itself.
2. **Local clone** — `git clone <worktree-path>` into a `mktemp -d` temp dir.
   Git never touches the network; the cloned HEAD is asserted equal to the
   worktree HEAD (the clone must be *this* tree, not the default branch).
3. **Gate, in order** — inside the clone:
   - `mix deps.get`
   - `npm install --no-audit` — **must precede `mix test`**: two mix e2e
     tests (`consumer_fixture_test.exs`, `mx_closed_loop_episode_test.exs`)
     shell out to node and import `zod` from `node_modules`; on a fresh
     clone without it, `mix test` fails. This dependency was discovered by
     this script's first hermetic run and is the documented bootstrap order.
   - `mix test`
   - `npm test`
4. **Verdict** — on the sole condition that every step exited 0, it prints a
   final line `ZERO_CONFIG_OK` and exits 0. Any failing command trips
   `set -Eeuo pipefail` + an ERR trap, prints `ZERO_CONFIG_FAIL: ...` with the
   command and exit code, and exits non-zero **before** the OK line can be
   printed — the line is unfalsifiable by construction.
5. **Cleanup** — an EXIT trap removes the temp dir.

### Offline policy

Zero-config ≠ offline. The git clone is local. `mix deps.get` and
`npm install` consult Hex/npm, which may use the network unless the user-level
caches under `$HOME` (`~/.hex`, `~/.npm`) are warm. In a genuinely offline
environment those two steps may fail with network errors; that is a *network
blocker*, not a zero-config failure. The script intentionally does **not**
auto-skip on network errors — it cannot print a false `ZERO_CONFIG_OK`. Record
the exact blocker in the session receipt and rerun with network access or warm
caches.

### Exit codes

| Exit | Meaning                                              |
|------|------------------------------------------------------|
| 0    | Proof holds; `ZERO_CONFIG_OK` printed                |
| other| A gate step failed (or the clone-HEAD assertion failed); `ZERO_CONFIG_FAIL: command failed (exit N): <cmd>` printed |""" .

aex:AshSurfaceScriptsIndexZeroConfigV2 a aex:ScriptsIndexEntry ;
    aex:scriptsIndexEntryFile "zero_config_v2.sh" ;
    aex:scriptsIndexEntryRole "the v2 full battery (ticket zero-config-battery-002)" ;
    aex:scriptsIndexEntryBody """`bash scripts/zero_config_v2.sh` is the v1 proof plus two additions, same
hermetic re-exec (`env -i PATH HOME`), same local-clone subject, same
no-false-OK failure semantics:

1. **env-read guard** (runs first, inside the clone) — fails if any file
   under `test/` reads an environment variable outside the documented
   allowlist. The allowlist is parsed from the clone's `mix.exs`
   (`@zero_env_allowlist`, currently `HOME PATH`) so the guard and the
   `mix test.zero` scrubber share one source of truth. Reads are
   `System.get_env` / `System.fetch_env!` with a **literal** variable
   name; a read whose variable name is not a literal (opaque read) fails
   closed. An unparsable allowlist also fails closed.
2. **`mix test.zero` if present** — detected by the `"test.zero":` alias
   definition in the clone's `mix.exs`; re-runs `mix test.all` (`mix test`
   then `npm test`) under literal `env -i` with only the allowlist
   surviving. If the alias is absent the step is skipped with exit 0.

Battery order: env-read guard, `mix deps.get`, `npm install --no-audit`
(before `mix test`, per v1's bootstrap-order discovery), `mix test`,
`npm test`, `mix test.zero`. Every step prints `EXIT[<label>]=<code>`
before the next one starts, so a run log records **every exit code**;
the final line is `ZERO_CONFIG_OK` only when all of them were 0.""" .
#################################################################
# Spark closure vocabulary (lane C1, spark-closure-courts) -- APPEND-ONLY.
#
# Law: implemented - sparkDeclared = the empty set. Every behavior the pack's
# templates implement is stated as a aex:SemanticFact; each carries aex:SurfaceFact
# rows: one "implemented" (the pack's templates render it), one "sparkDeclared"
# (it lands in the generated Spark.Dsl surface: section/entity/schema/args/
# identifier/one_of/single_extension_kinds), and optionally "consumed" (it
# consumes an external ecosystem contract rather than declaring Spark surface).
# gates/110_spark_completeness.rq returns ZERO rows iff every implemented
# SurfaceFact has a matching sparkDeclared SurfaceFact (hidden surface = 0).
# templates/spark_parity_court.exs.tmpl re-asserts the closure at runtime against
# the COMPILED extension (Spark.Dsl.Extension.sections/0) and FAILS naming the
# orphan's aex:factName otherwise.
#
# Per the pack's echo-don't-synthesize discipline, existing surface individuals
# are RETYPED below (append-only `a aex:SemanticFact` + `aex:factName` rows);
# their declared names/links are never restated, only referenced.
#################################################################

aex:SemanticFact a rdfs:Class ;
    rdfs:label "One behaviorally meaningful element of an AshExtensionSpec's surface (a section, entity, schema field, positional arg, one_of value, or extension option) that the pack's templates implement -- the unit the spark-parity closure is stated over." .

aex:factName a rdf:Property ; rdfs:domain aex:SemanticFact ;
    rdfs:comment "dotted fact key scoped by the owning package, e.g. \"ash_r2rml.entity.r2rml.subject\" -- the stable name gate 110 and the parity court report on failure." .

aex:SurfaceFact a rdfs:Class ;
    rdfs:label "One visibility of a aex:SemanticFact on a named surface." .

aex:surfaceKind a rdf:Property ; rdfs:domain aex:SurfaceFact ;
    rdfs:comment "closed: \"implemented\" | \"sparkDeclared\" | \"consumed\"." .
aex:surfaceOf a rdf:Property ; rdfs:domain aex:SurfaceFact ; rdfs:range aex:SemanticFact ;
    rdfs:comment "the SemanticFact this visibility belongs to." .
aex:surfacePackage a rdf:Property ; rdfs:domain aex:SurfaceFact ;
    rdfs:comment "owning hex package, e.g. \"ash_r2rml\"." .

aex:ParityCourt a rdfs:Class ;
    rdfs:label "The generated ExUnit court (templates/spark_parity_court.exs.tmpl): asserts every aex:SemanticFact carrying an implemented SurfaceFact also carries a sparkDeclared SurfaceFact, and that the compiled extension's real Spark surface (sections/0) carries each declared fact -- failing with the orphan's factName otherwise." .

aex:MutationSpec a rdfs:Class ;
    rdfs:label "One anti-vacuity mutation: which individual to delete (or add) and which court must then fail." .
aex:mutates a rdf:Property ; rdfs:domain aex:MutationSpec ;
    rdfs:comment "the individual the mutation removes (or adds)." .
aex:expectedCourt a rdf:Property ; rdfs:domain aex:MutationSpec ;
    rdfs:comment "which court must fail under the mutation: the SPARQL gate or the generated ExUnit court." .

aex:BurnEpoch a rdfs:Class ;
    rdfs:label "One burn epoch: a dated cycle in which the parity courts were actually run against this pack, pass AND fail, as evidence the closure vocabulary stays exercised rather than ceremonial." .
aex:burnVerdict a rdf:Property ; rdfs:domain aex:BurnEpoch ;
    rdfs:comment "verdict summary for the epoch." .
aex:burnDigest a rdf:Property ; rdfs:domain aex:BurnEpoch ;
    rdfs:comment "sha256 of the gate/court evidence bundle for that epoch." .

