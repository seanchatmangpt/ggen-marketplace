# --- :a2a section's own schema option (dsl.ex:163-184) ---

aex:AshA2aSemanticRequests a aex:SectionSchemaField ;
    aex:sectionFieldOf aex:AshA2aSection ;
    aex:sectionFieldOrder 1 ; aex:sectionFieldName "semantic_requests" ; aex:sectionFieldType "boolean" ;
    aex:sectionFieldDefault "false" ;
    aex:sectionFieldDoc "Explicit opt-in to the semantic-compilation A2A surface (AshA2A.Semantic.Compiler). Two gates must both be true before a dispatch reaches Compiler.compile/3: this option AND the inbound message metadata :semantic_request flag (dsl.ex:174-181) -- never a surprise LLM invocation." ;
    aex:dslCitation "lib/ash_a2a/dsl.ex:164-183" .

