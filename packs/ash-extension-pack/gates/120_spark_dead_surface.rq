# MESSAGE: no decorative Spark surface. Every aex:* property declared `a rdf:Property` in
# ontology.ttl must be consumed by at least one template or gate/query in this pack.
# SPARQL cannot read template text, so the consumer-attested surface is carried here as a
# closed VALUES allowlist: each entry is attested by a literal grep of templates/ + gates/ +
# queries/ + verify/ for the property's local name (92/92 declared properties attested;
# 87/87 measured 2026-10-01 on spark-closure-courts, refreshed after the lane C1
# closure-vocabulary append added factName/surfaceKind/surfaceOf/surfacePackage/mutates/
# expectedCourt/burnVerdict/burnDigest; refreshed again 2026-10-04 when the M2
# ash_a2a absorption added dslCitation -- consumed by templates/a2a_skill.ex.tmpl and
# gates/140_a2a_skill_fields_contract.rq; the a2a surface's own scoped court is
# gates/150_a2a_dead_surface.rq -- and when this gate was first actually wired into
# verify/render_check.exs, which surfaced 4 previously-unattested consumed properties:
# entityDescribe/fixtureOnly/sectionFieldDefault/sectionFieldDoc, all consumed by
# templates/extension.ex.tmpl et al., grep-attested 2026-10-04). The generated court
# templates/dead_surface_court.exs.tmpl re-derives the dead set from the real files on disk
# at court runtime, so any drift between this allowlist and the actual corpus FAILS there.
# Any row = a declared Spark property with zero consumers = dead DSL surface.
PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?s ?dead WHERE {
  ?s a rdf:Property .
  # Scope to this pack's own vocabulary (aex:*). The union graph also carries
  # consumer-side rdf:Property declarations (e.g. surf:* in ash_surface's
  # ontology.ttl) that this pack's allowlist cannot and must not judge.
  FILTER (STRSTARTS(STR(?s), "http://seanchatmangpt.github.io/packs/ash-extension-core#"))
  FILTER (?s NOT IN (
    aex:afterTransformer, aex:argName, aex:argOf, aex:argOrder, aex:burnDigest,
    aex:burnVerdict, aex:codegenName,
    aex:codegenTask, aex:compositionOf, aex:compositionTarget, aex:contextNormalize,
    aex:dslCitation, aex:entityDescribe, aex:fixtureOnly,
    aex:contextTargetEntity, aex:contextTargetField, aex:dualLevelFixture,
    aex:entityIdentifier, aex:entityName, aex:entityOf, aex:entityOrder,
    aex:entityStruct, aex:expectedCourt, aex:extensionTarget, aex:factName,
    aex:fieldDefault, aex:fieldDoc,
    aex:fieldName, aex:fieldOf, aex:fieldOrder, aex:fieldRequired, aex:fieldType,
    aex:formatterModule, aex:generatesReceiptedAction, aex:getterName, aex:getterOf,
    aex:getterSourceSection, aex:installerRuntimeDep, aex:legacyAdapterFunction,
    aex:legacyAdapterModule, aex:licenseCopyrightLine, aex:licensePackage,
    aex:licenseSpdx, aex:moduleName, aex:mutates, aex:nestedFieldName, aex:nestedOf,
    aex:normalizeFunction, aex:normalizeModule, aex:oneOfValueName, aex:oneOfValueOf,
    aex:oneOfValueOrder, aex:packageName, aex:provenanceSource,
    aex:receiptIdempotencyKeySource, aex:scriptsIndexDir,
    aex:scriptsIndexEntryBody, aex:scriptsIndexEntryFile, aex:scriptsIndexEntryRole,
    aex:scriptsIndexRepo, aex:sectionDescribe, aex:sectionFieldDefault, aex:sectionFieldDoc,
    aex:sectionFieldName, aex:sectionFieldOf,
    aex:sectionFieldOrder, aex:sectionFieldType, aex:sectionName, aex:sectionOf, aex:sectionOrder,
    aex:singleExtensionKind, aex:singletonEntityKey,
    aex:surfaceKind, aex:surfaceOf, aex:surfacePackage,
    aex:stepHasCompensate,
    aex:stepIsReturn, aex:stepMaxRetries, aex:stepModule, aex:stepName, aex:stepOf,
    aex:stepOrder, aex:stepWaitFor, aex:supportSubdir, aex:taskModuleName,
    aex:validateDelegateFunction, aex:validateDelegateModule, aex:verifierDoc,
    aex:verifierName, aex:verifierOf, aex:workflowReactor, aex:workflowReversible
  ))
}
ORDER BY ?s ?dead
