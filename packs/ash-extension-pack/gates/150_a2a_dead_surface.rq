# GATE 150 -- a2a dead-surface court (M2, 2026-10-04), scoped sibling of gate
# 120_spark_dead_surface.rq.
#
# MESSAGE: no decorative ash_a2a surface. Every aex:SemanticFact carrying an
# aex:SurfaceFact with aex:surfacePackage "ash_a2a" -- the projection surface
# this pack absorbed from lib/ash_a2a/dsl.ex -- must appear in the closed
# VALUES allowlist below of a2a-surface facts attested consumed by the pack's
# render/gate corpus (templates/a2a_skill.ex.tmpl renders the skill fields,
# defaults and citations; gates/140_a2a_skill_fields_contract.rq asserts the
# three v26.10 fields; this gate asserts the closure). Attestation is by
# literal grep of templates/ + gates/ + queries/ for each fact's local name,
# exactly gate 120's discipline. Any row = a declared ash_a2a surface fact
# with zero consumers = dead DSL surface.
#
# Anti-vacuity: remove any entry from the allowlist (or add a new
# surfacePackage="ash_a2a" SemanticFact without consuming it) and this gate
# returns that fact's aex:factName.
PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>

SELECT ?fact_name WHERE {
  ?fact a aex:SemanticFact ;
        aex:factName ?fact_name .
  ?decl a aex:SurfaceFact ;
        aex:surfaceOf ?fact ;
        aex:surfacePackage "ash_a2a" .
  FILTER (?fact NOT IN (
    aex:AshA2aSection,
    aex:AshA2aSkillEntity,
    aex:AshA2aSkillArgumentMapping,
    aex:AshA2aSkillGet,
    aex:AshA2aSkillLeaseRequired,
    aex:AshA2aHddlOperatorEntity,
    aex:AshA2aSemanticRequests,
    aex:AshA2aAuthoritySection,
    aex:AshA2aAuthorityGate,
    aex:AshA2aAuthorityLeaseDuration,
    aex:AshA2aHooksSection,
    aex:AshA2aHooksPreDispatch,
    aex:AshA2aHooksPostDispatch
  ))
}
ORDER BY ?fact_name
