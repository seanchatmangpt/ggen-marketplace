# GATE 140 -- a2a skill-fields contract (M2, 2026-10-04).
#
# MESSAGE: the ash_a2a skill entity absorbed by this pack exposes the three
# v26.10 projection fields -- argument_mapping, get?, lease_required? -- each
# as an aex:EntitySchemaField on the :a2a section's `skill` aex:DslEntity with
# its real Spark default and a verbatim aex:dslCitation naming the
# lib/ash_a2a/dsl.ex line range it was transcribed from (main@
# 5a84d886e0696cd43115799bbdc4bc8ec481376c). Any row = the field is missing,
# mis-typed, mis-defaulted, or uncited on the extension surface -- the surface
# no longer matches the shipped ash_a2a DSL. Zero rows on a conforming pack.
#
# Anti-vacuity: delete any of aex:AshA2aSkillArgumentMapping /
# aex:AshA2aSkillGet / aex:AshA2aSkillLeaseRequired (or any single row of
# them -- fieldType, fieldDefault, or the dslCitation line) and this gate
# returns that field's row.
PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>

SELECT ?field ?defect WHERE {
  ?entity a aex:DslEntity ; aex:entityName "skill" .
  {
    BIND("argument_mapping" AS ?field)
    BIND("missing/mis-declared: want aex:EntitySchemaField fieldName=argument_mapping, fieldType=any (Spark {:map, :string, :atom}), fieldDefault=%{}, cited dsl.ex:69-77" AS ?defect)
    FILTER NOT EXISTS {
      ?f_am a aex:EntitySchemaField ; aex:fieldOf ?entity ;
            aex:fieldName "argument_mapping" ; aex:fieldType "any" ;
            aex:fieldDefault "%{}" ; aex:dslCitation ?c_am .
      FILTER(CONTAINS(STR(?c_am), "dsl.ex:69-77"))
    }
  }
  UNION
  {
    BIND("get?" AS ?field)
    BIND("missing/mis-declared: want aex:EntitySchemaField fieldName=get?, fieldType=boolean, fieldDefault=false, cited dsl.ex:78-85" AS ?defect)
    FILTER NOT EXISTS {
      ?f_get a aex:EntitySchemaField ; aex:fieldOf ?entity ;
             aex:fieldName "get?" ; aex:fieldType "boolean" ;
             aex:fieldDefault "false" ; aex:dslCitation ?c_get .
      FILTER(CONTAINS(STR(?c_get), "dsl.ex:78-85"))
    }
  }
  UNION
  {
    BIND("lease_required?" AS ?field)
    BIND("missing/mis-declared: want aex:EntitySchemaField fieldName=lease_required?, fieldType=boolean, fieldDefault=false, cited dsl.ex:86-94" AS ?defect)
    FILTER NOT EXISTS {
      ?f_lease a aex:EntitySchemaField ; aex:fieldOf ?entity ;
               aex:fieldName "lease_required?" ; aex:fieldType "boolean" ;
               aex:fieldDefault "false" ; aex:dslCitation ?c_lease .
      FILTER(CONTAINS(STR(?c_lease), "dsl.ex:86-94"))
    }
  }
}
ORDER BY ?field
