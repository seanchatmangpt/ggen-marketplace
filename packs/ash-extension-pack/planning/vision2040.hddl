(define (domain ash-extension-vision2040)
  (:requirements :hierarchy :typing :negative-preconditions :universal-preconditions :method-preconditions)

  (:types
    extension capability gap - object
  )

  (:predicates
    ;; Subject lifecycle
    (observed ?e - extension)
    (semantics-admitted ?e - extension)
    (capability-surface-closed ?e - extension)
    (spark-surface-closed ?e - extension)
    (implementation-surface-closed ?e - extension)
    (projected ?e - extension)
    (resource-domain-composed ?e - extension)
    (runtime-realizations-composed ?e - extension)
    (composed ?e - extension)
    (qualified ?e - extension)
    (standing ?e - extension)

    ;; Per-capability inventory. The extension-specific problem supplies one
    ;; capability-required fact per admitted capability.
    (capability-required ?e - extension ?c - capability)
    ;; Generated problem instances set capability-unresolved for every
    ;; capability-required fact. Each phase carries its own explicit
    ;; unresolved token, so quantified closure needs no disjunction.
    (capability-unresolved ?e - extension ?c - capability)
    (capability-represented ?e - extension ?c - capability)
    (spark-unresolved ?e - extension ?c - capability)
    (spark-represented ?e - extension ?c - capability)
    (implementation-unresolved ?e - extension ?c - capability)
    (implementation-consumes ?e - extension ?c - capability)

    ;; Exactly one resolution strategy is admitted for each required capability
    ;; by the upstream semantic/classification court.
    (reuse-admissible ?c - capability)
    (composition-admissible ?c - capability)
    (extension-required ?c - capability)
    (invention-required ?c - capability)
    (irreducible-concept ?c - capability)

    ;; Qualification evidence
    (static-courts-pass ?e - extension)
    (no-hidden-semantics ?e - extension)
    (no-dead-spark-semantics ?e - extension)
    (info-parity-pass ?e - extension)
    (transformer-determinism-pass ?e - extension)
    (verifier-falsifiers-pass ?e - extension)
    (igniter-idempotence-pass ?e - extension)
    (reactor-fidelity-pass ?e - extension)
    (composition-courts-pass ?e - extension)
    (regeneration-pass ?e - extension)
    (mutation-league-pass ?e - extension)

    ;; Burn-in dimensions
    (burn-real-work ?e - extension)
    (burn-concurrency ?e - extension)
    (burn-failure ?e - extension)
    (burn-recovery ?e - extension)
    (burn-replay ?e - extension)
    (burn-restart ?e - extension)
    (burn-regeneration ?e - extension)
    (burn-reinstall ?e - extension)
    (burn-resource-pressure ?e - extension)
    (burn-semantic-digest-parity ?e - extension)
    (burn-evidence-complete ?e - extension)
    (burned-in ?e - extension)

    ;; Standing / recursive learning
    (evidence-collected ?e - extension)
    (ocel-emitted ?e - extension)
    (provenance-emitted ?e - extension)
    (receipted ?e - extension)
    (reusable-gap ?e - extension ?g - gap)
    (gap-preserved ?g - gap)
    (gap-generalized ?g - gap)
    (canonical-manufacturer-extended ?g - gap)
    (no-reusable-gaps ?e - extension)
  )

  ;; ------------------------------------------------------------------
  ;; Root: one exact Ash-extension subject.
  ;; ------------------------------------------------------------------

  (:task manufacture_ash_extension
    :parameters (?e - extension)
  )

  (:method m_manufacture_ash_extension
    :task (manufacture_ash_extension ?e)
    :subtasks (and
      (observe_extension ?e)
      (admit_semantics ?e)
      (resolve_required_capabilities ?e)
      (construct_spark_surface ?e)
      (project_implementation ?e)
      (compose_extension ?e)
      (qualify_extension ?e)
      (stand_extension ?e)
      (learn_reusable_gaps ?e)
    )
  )

  ;; ------------------------------------------------------------------
  ;; OBSERVE / ADMIT
  ;; ------------------------------------------------------------------

  (:task admit_semantics
    :parameters (?e - extension)
  )

  (:method m_admit_semantics
    :task (admit_semantics ?e)
    :precondition (observed ?e)
    :subtasks (and
      (admit_extension_semantics ?e)
    )
  )

  (:action observe_extension
    :parameters (?e - extension)
    :precondition ()
    :effect (observed ?e)
  )

  (:action admit_extension_semantics
    :parameters (?e - extension)
    :precondition (observed ?e)
    :effect (semantics-admitted ?e)
  )

  ;; ------------------------------------------------------------------
  ;; PLAN: close EVERY required capability.
  ;;
  ;; The recursive method selects one still-unrepresented required
  ;; capability. The base method is legal only when the quantified closure
  ;; condition holds, so a planner cannot skip a requirement.
  ;; ------------------------------------------------------------------

  (:task resolve_required_capabilities
    :parameters (?e - extension)
  )

  (:method m_resolve_next_capability
    :parameters (?e - extension ?c - capability)
    :task (resolve_required_capabilities ?e)
    :precondition (and
      (semantics-admitted ?e)
      (capability-required ?e ?c)
      (capability-unresolved ?e ?c)
    )
    :subtasks (and
      (resolve_capability ?e ?c)
      (resolve_required_capabilities ?e)
    )
  )

  (:method m_required_capabilities_closed
    :task (resolve_required_capabilities ?e)
    :precondition (forall (?c - capability)
      (not (capability-unresolved ?e ?c))
    )
    :subtasks (and
      (seal_capability_surface ?e)
    )
  )

  (:task resolve_capability
    :parameters (?e - extension ?c - capability)
  )

  ;; REUSE -> COMPOSE -> EXTEND -> INVENT is represented by mutually
  ;; admitted strategy predicates. EXTEND/INVENT both enlarge the SAME
  ;; canonical ash-extension-pack; no sibling-pack action exists.
  (:method m_reuse_capability
    :task (resolve_capability ?e ?c)
    :precondition (and
      (capability-required ?e ?c)
      (reuse-admissible ?c)
    )
    :subtasks (and
      (reuse_capability ?e ?c)
    )
  )

  (:method m_compose_capability
    :task (resolve_capability ?e ?c)
    :precondition (and
      (capability-required ?e ?c)
      (not (reuse-admissible ?c))
      (composition-admissible ?c)
    )
    :subtasks (and
      (compose_capability ?e ?c)
    )
  )

  (:method m_extend_capability
    :task (resolve_capability ?e ?c)
    :precondition (and
      (capability-required ?e ?c)
      (not (reuse-admissible ?c))
      (not (composition-admissible ?c))
      (extension-required ?c)
    )
    :subtasks (and
      (extend_canonical_capability ?e ?c)
    )
  )

  (:method m_invent_irreducible_capability
    :task (resolve_capability ?e ?c)
    :precondition (and
      (capability-required ?e ?c)
      (not (reuse-admissible ?c))
      (not (composition-admissible ?c))
      (not (extension-required ?c))
      (invention-required ?c)
      (irreducible-concept ?c)
    )
    :subtasks (and
      (invent_in_canonical_manufacturer ?e ?c)
    )
  )

  (:action reuse_capability
    :parameters (?e - extension ?c - capability)
    :precondition (and
      (capability-required ?e ?c)
      (reuse-admissible ?c)
    )
    :effect (and
      (capability-represented ?e ?c)
      (not (capability-unresolved ?e ?c))
      (spark-unresolved ?e ?c)
    )
  )

  (:action compose_capability
    :parameters (?e - extension ?c - capability)
    :precondition (and
      (capability-required ?e ?c)
      (not (reuse-admissible ?c))
      (composition-admissible ?c)
    )
    :effect (and
      (capability-represented ?e ?c)
      (not (capability-unresolved ?e ?c))
      (spark-unresolved ?e ?c)
    )
  )

  (:action extend_canonical_capability
    :parameters (?e - extension ?c - capability)
    :precondition (and
      (capability-required ?e ?c)
      (not (reuse-admissible ?c))
      (not (composition-admissible ?c))
      (extension-required ?c)
    )
    :effect (and
      (capability-represented ?e ?c)
      (not (capability-unresolved ?e ?c))
      (spark-unresolved ?e ?c)
    )
  )

  (:action invent_in_canonical_manufacturer
    :parameters (?e - extension ?c - capability)
    :precondition (and
      (capability-required ?e ?c)
      (not (reuse-admissible ?c))
      (not (composition-admissible ?c))
      (not (extension-required ?c))
      (invention-required ?c)
      (irreducible-concept ?c)
    )
    :effect (and
      (capability-represented ?e ?c)
      (not (capability-unresolved ?e ?c))
      (spark-unresolved ?e ?c)
    )
  )

  (:action seal_capability_surface
    :parameters (?e - extension)
    :precondition (and
      (semantics-admitted ?e)
      (forall (?c - capability)
        (not (capability-unresolved ?e ?c))
      )
    )
    :effect (capability-surface-closed ?e)
  )

  ;; ------------------------------------------------------------------
  ;; CONSTRUCT: every admitted capability must acquire a Spark
  ;; representation before the Spark surface can close.
  ;; ------------------------------------------------------------------

  (:task construct_spark_surface
    :parameters (?e - extension)
  )

  (:method m_project_next_capability_to_spark
    :parameters (?e - extension ?c - capability)
    :task (construct_spark_surface ?e)
    :precondition (and
      (capability-surface-closed ?e)
      (capability-required ?e ?c)
      (capability-represented ?e ?c)
      (spark-unresolved ?e ?c)
    )
    :subtasks (and
      (project_capability_to_spark ?e ?c)
      (construct_spark_surface ?e)
    )
  )

  (:method m_spark_surface_closed
    :task (construct_spark_surface ?e)
    :precondition (and
      (capability-surface-closed ?e)
      (forall (?c - capability)
        (not (spark-unresolved ?e ?c))
      )
    )
    :subtasks (and
      (seal_spark_surface ?e)
    )
  )

  (:action project_capability_to_spark
    :parameters (?e - extension ?c - capability)
    :precondition (and
      (capability-represented ?e ?c)
      (capability-required ?e ?c)
    )
    :effect (and
      (spark-represented ?e ?c)
      (not (spark-unresolved ?e ?c))
      (implementation-unresolved ?e ?c)
    )
  )

  (:action seal_spark_surface
    :parameters (?e - extension)
    :precondition (forall (?c - capability)
      (not (spark-unresolved ?e ?c))
    )
    :effect (spark-surface-closed ?e)
  )

  ;; ------------------------------------------------------------------
  ;; PROJECT: implementation is generated only from Spark-represented
  ;; capabilities. The second quantified closure prevents dead Spark rows
  ;; from being skipped during projection.
  ;; ------------------------------------------------------------------

  (:task project_implementation
    :parameters (?e - extension)
  )

  (:method m_project_next_capability_implementation
    :parameters (?e - extension ?c - capability)
    :task (project_implementation ?e)
    :precondition (and
      (spark-surface-closed ?e)
      (capability-required ?e ?c)
      (spark-represented ?e ?c)
      (implementation-unresolved ?e ?c)
    )
    :subtasks (and
      (project_capability_implementation ?e ?c)
      (project_implementation ?e)
    )
  )

  (:method m_implementation_surface_closed
    :task (project_implementation ?e)
    :precondition (and
      (spark-surface-closed ?e)
      (forall (?c - capability)
        (not (implementation-unresolved ?e ?c))
      )
    )
    :subtasks (and
      (seal_implementation_surface ?e)
    )
  )

  (:action project_capability_implementation
    :parameters (?e - extension ?c - capability)
    :precondition (and
      (capability-required ?e ?c)
      (spark-represented ?e ?c)
    )
    :effect (and
      (implementation-consumes ?e ?c)
      (not (implementation-unresolved ?e ?c))
    )
  )

  (:action seal_implementation_surface
    :parameters (?e - extension)
    :precondition (forall (?c - capability)
      (not (implementation-unresolved ?e ?c))
    )
    :effect (and
      (implementation-surface-closed ?e)
      (projected ?e)
    )
  )

  ;; ------------------------------------------------------------------
  ;; COMPOSE
  ;; ------------------------------------------------------------------

  (:task compose_extension
    :parameters (?e - extension)
  )

  (:method m_compose_extension
    :task (compose_extension ?e)
    :precondition (projected ?e)
    :subtasks (and
      (compose_resource_and_domain_extensions ?e)
      (compose_runtime_realizations ?e)
      (seal_composition ?e)
    )
  )

  (:action compose_resource_and_domain_extensions
    :parameters (?e - extension)
    :precondition (projected ?e)
    :effect (resource-domain-composed ?e)
  )

  (:action compose_runtime_realizations
    :parameters (?e - extension)
    :precondition (resource-domain-composed ?e)
    :effect (runtime-realizations-composed ?e)
  )

  (:action seal_composition
    :parameters (?e - extension)
    :precondition (and
      (projected ?e)
      (resource-domain-composed ?e)
      (runtime-realizations-composed ?e)
    )
    :effect (composed ?e)
  )

  ;; ------------------------------------------------------------------
  ;; QUALIFY. Closure is established by explicit courts. No action may
  ;; simply assert hidden_semantics=empty or dead_spark=empty.
  ;; ------------------------------------------------------------------

  (:task qualify_extension
    :parameters (?e - extension)
  )

  (:method m_qualify_extension
    :task (qualify_extension ?e)
    :precondition (composed ?e)
    :subtasks (and
      (run_static_courts ?e)
      (run_hidden_semantics_parity_court ?e)
      (run_dead_spark_parity_court ?e)
      (run_info_parity_court ?e)
      (run_transformer_determinism_court ?e)
      (run_verifier_falsifier_court ?e)
      (run_igniter_idempotence_court ?e)
      (run_reactor_fidelity_court ?e)
      (run_composition_courts ?e)
      (run_regeneration_court ?e)
      (run_mutation_league ?e)
      (run_temporal_burn_in ?e)
      (seal_qualification ?e)
    )
  )

  (:action run_static_courts
    :parameters (?e - extension)
    :precondition (composed ?e)
    :effect (static-courts-pass ?e)
  )

  (:action run_hidden_semantics_parity_court
    :parameters (?e - extension)
    :precondition (and
      (static-courts-pass ?e)
      (spark-surface-closed ?e)
      (implementation-surface-closed ?e)
    )
    :effect (no-hidden-semantics ?e)
  )

  (:action run_dead_spark_parity_court
    :parameters (?e - extension)
    :precondition (and
      (no-hidden-semantics ?e)
      (spark-surface-closed ?e)
      (implementation-surface-closed ?e)
    )
    :effect (no-dead-spark-semantics ?e)
  )

  (:action run_info_parity_court
    :parameters (?e - extension)
    :precondition (no-dead-spark-semantics ?e)
    :effect (info-parity-pass ?e)
  )

  (:action run_transformer_determinism_court
    :parameters (?e - extension)
    :precondition (info-parity-pass ?e)
    :effect (transformer-determinism-pass ?e)
  )

  (:action run_verifier_falsifier_court
    :parameters (?e - extension)
    :precondition (transformer-determinism-pass ?e)
    :effect (verifier-falsifiers-pass ?e)
  )

  (:action run_igniter_idempotence_court
    :parameters (?e - extension)
    :precondition (verifier-falsifiers-pass ?e)
    :effect (igniter-idempotence-pass ?e)
  )

  (:action run_reactor_fidelity_court
    :parameters (?e - extension)
    :precondition (igniter-idempotence-pass ?e)
    :effect (reactor-fidelity-pass ?e)
  )

  (:action run_composition_courts
    :parameters (?e - extension)
    :precondition (reactor-fidelity-pass ?e)
    :effect (composition-courts-pass ?e)
  )

  (:action run_regeneration_court
    :parameters (?e - extension)
    :precondition (composition-courts-pass ?e)
    :effect (regeneration-pass ?e)
  )

  (:action run_mutation_league
    :parameters (?e - extension)
    :precondition (regeneration-pass ?e)
    :effect (mutation-league-pass ?e)
  )

  ;; ------------------------------------------------------------------
  ;; BURN-IN: Chicago vertical x history x concurrency x failure x
  ;; recovery x replay x restart x regeneration/reinstall x pressure.
  ;; ------------------------------------------------------------------

  (:task run_temporal_burn_in
    :parameters (?e - extension)
  )

  (:method m_temporal_burn_in
    :task (run_temporal_burn_in ?e)
    :precondition (mutation-league-pass ?e)
    :subtasks (and
      (burn_real_work ?e)
      (burn_concurrency ?e)
      (burn_failure_injection ?e)
      (burn_lawful_recovery ?e)
      (burn_replay ?e)
      (burn_restart ?e)
      (burn_regeneration ?e)
      (burn_reinstall ?e)
      (burn_resource_pressure ?e)
      (burn_semantic_digest_parity ?e)
      (burn_evidence ?e)
      (seal_burn_in ?e)
    )
  )

  (:action burn_real_work
    :parameters (?e - extension)
    :precondition (mutation-league-pass ?e)
    :effect (burn-real-work ?e)
  )

  (:action burn_concurrency
    :parameters (?e - extension)
    :precondition (burn-real-work ?e)
    :effect (burn-concurrency ?e)
  )

  (:action burn_failure_injection
    :parameters (?e - extension)
    :precondition (burn-concurrency ?e)
    :effect (burn-failure ?e)
  )

  (:action burn_lawful_recovery
    :parameters (?e - extension)
    :precondition (burn-failure ?e)
    :effect (burn-recovery ?e)
  )

  (:action burn_replay
    :parameters (?e - extension)
    :precondition (burn-recovery ?e)
    :effect (burn-replay ?e)
  )

  (:action burn_restart
    :parameters (?e - extension)
    :precondition (burn-replay ?e)
    :effect (burn-restart ?e)
  )

  (:action burn_regeneration
    :parameters (?e - extension)
    :precondition (burn-restart ?e)
    :effect (burn-regeneration ?e)
  )

  (:action burn_reinstall
    :parameters (?e - extension)
    :precondition (burn-regeneration ?e)
    :effect (burn-reinstall ?e)
  )

  (:action burn_resource_pressure
    :parameters (?e - extension)
    :precondition (burn-reinstall ?e)
    :effect (burn-resource-pressure ?e)
  )

  (:action burn_semantic_digest_parity
    :parameters (?e - extension)
    :precondition (burn-resource-pressure ?e)
    :effect (burn-semantic-digest-parity ?e)
  )

  (:action burn_evidence
    :parameters (?e - extension)
    :precondition (burn-semantic-digest-parity ?e)
    :effect (burn-evidence-complete ?e)
  )

  (:action seal_burn_in
    :parameters (?e - extension)
    :precondition (and
      (burn-real-work ?e)
      (burn-concurrency ?e)
      (burn-failure ?e)
      (burn-recovery ?e)
      (burn-replay ?e)
      (burn-restart ?e)
      (burn-regeneration ?e)
      (burn-reinstall ?e)
      (burn-resource-pressure ?e)
      (burn-semantic-digest-parity ?e)
      (burn-evidence-complete ?e)
    )
    :effect (burned-in ?e)
  )

  (:action seal_qualification
    :parameters (?e - extension)
    :precondition (and
      (static-courts-pass ?e)
      (no-hidden-semantics ?e)
      (no-dead-spark-semantics ?e)
      (info-parity-pass ?e)
      (transformer-determinism-pass ?e)
      (verifier-falsifiers-pass ?e)
      (igniter-idempotence-pass ?e)
      (reactor-fidelity-pass ?e)
      (composition-courts-pass ?e)
      (regeneration-pass ?e)
      (mutation-league-pass ?e)
      (burned-in ?e)
    )
    :effect (qualified ?e)
  )

  ;; ------------------------------------------------------------------
  ;; STAND
  ;; ------------------------------------------------------------------

  (:task stand_extension
    :parameters (?e - extension)
  )

  (:method m_stand_extension
    :task (stand_extension ?e)
    :precondition (qualified ?e)
    :subtasks (and
      (collect_evidence ?e)
      (emit_ocel ?e)
      (emit_provenance ?e)
      (emit_qualification_receipt ?e)
      (seal_standing ?e)
    )
  )

  (:action collect_evidence
    :parameters (?e - extension)
    :precondition (qualified ?e)
    :effect (evidence-collected ?e)
  )

  (:action emit_ocel
    :parameters (?e - extension)
    :precondition (evidence-collected ?e)
    :effect (ocel-emitted ?e)
  )

  (:action emit_provenance
    :parameters (?e - extension)
    :precondition (ocel-emitted ?e)
    :effect (provenance-emitted ?e)
  )

  (:action emit_qualification_receipt
    :parameters (?e - extension)
    :precondition (provenance-emitted ?e)
    :effect (receipted ?e)
  )

  (:action seal_standing
    :parameters (?e - extension)
    :precondition (and
      (qualified ?e)
      (receipted ?e)
      (no-hidden-semantics ?e)
      (no-dead-spark-semantics ?e)
    )
    :effect (standing ?e)
  )

  ;; ------------------------------------------------------------------
  ;; LEARN: surviving reusable gaps recurse into THIS canonical
  ;; manufacturer. There is deliberately no create_sibling_pack action.
  ;; ------------------------------------------------------------------

  (:task learn_reusable_gaps
    :parameters (?e - extension)
  )

  (:method m_no_reusable_gap
    :task (learn_reusable_gaps ?e)
    :precondition (and
      (standing ?e)
      (no-reusable-gaps ?e)
    )
    :subtasks (and)
  )

  (:method m_generalize_reusable_gap
    :parameters (?e - extension ?g - gap)
    :task (learn_reusable_gaps ?e)
    :precondition (and
      (standing ?e)
      (reusable-gap ?e ?g)
    )
    :subtasks (and
      (preserve_gap_witness ?e ?g)
      (generalize_gap ?g)
      (extend_canonical_manufacturer ?g)
      (manufacture_ash_extension ?e)
    )
  )

  (:action preserve_gap_witness
    :parameters (?e - extension ?g - gap)
    :precondition (reusable-gap ?e ?g)
    :effect (gap-preserved ?g)
  )

  (:action generalize_gap
    :parameters (?g - gap)
    :precondition (gap-preserved ?g)
    :effect (gap-generalized ?g)
  )

  (:action extend_canonical_manufacturer
    :parameters (?g - gap)
    :precondition (gap-generalized ?g)
    :effect (canonical-manufacturer-extended ?g)
  )
)
