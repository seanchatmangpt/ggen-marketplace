(define (domain ash-extension-vision2040)
  (:requirements :hierarchy :typing)
  (:types
    extension capability realization evidence gap - object
  )

  (:predicates
    (observed ?e - extension)
    (semantics-admitted ?e - extension)
    (capability-required ?e - extension ?c - capability)
    (capability-reusable ?c - capability)
    (capability-composable ?c - capability)
    (capability-represented ?e - extension ?c - capability)
    (spark-represented ?e - extension ?c - capability)
    (implementation-consumes ?e - extension ?c - capability)
    (projected ?e - extension)
    (composed ?e - extension)
    (qualified ?e - extension)
    (no-hidden-semantics ?e - extension)
    (no-dead-spark-semantics ?e - extension)
    (burned-in ?e - extension)
    (receipted ?e - extension)
    (reusable-gap ?e - extension ?g - gap)
    (gap-generalized ?g - gap)
    (canonical-manufacturer-extended ?g - gap)
  )

  ;; Root lifecycle. There is intentionally no task/action for creating a sibling
  ;; generic Ash-extension pack. Reusable gaps feed back into the canonical manufacturer.
  (:task manufacture_ash_extension
    :parameters (?e - extension)
  )

  (:method m_manufacture_ash_extension
    :task (manufacture_ash_extension ?e)
    :subtasks (and
      (observe_extension ?e)
      (admit_semantics ?e)
      (plan_extension ?e)
      (construct_spark_surface ?e)
      (project_implementation ?e)
      (compose_extension ?e)
      (qualify_extension ?e)
      (stand_extension ?e)
      (learn_reusable_gaps ?e)
    )
  )

  (:task admit_semantics
    :parameters (?e - extension)
  )

  (:method m_admit_semantics
    :task (admit_semantics ?e)
    :precondition (observed ?e)
    :subtasks (and
      (admit_extension_semantics ?e)
    )
  )

  (:task plan_extension
    :parameters (?e - extension)
  )

  (:method m_plan_extension
    :task (plan_extension ?e)
    :precondition (semantics-admitted ?e)
    :subtasks (and
      (resolve_required_capabilities ?e)
    )
  )

  ;; Capability resolution follows REUSE -> COMPOSE -> EXTEND -> INVENT.
  ;; EXTEND and INVENT both enlarge the same canonical manufacturer.
  (:task resolve_capability
    :parameters (?e - extension ?c - capability)
  )

  (:method m_reuse_capability
    :task (resolve_capability ?e ?c)
    :precondition (and
      (capability-required ?e ?c)
      (capability-reusable ?c)
    )
    :subtasks (and
      (represent_capability ?e ?c)
    )
  )

  (:method m_compose_capability
    :task (resolve_capability ?e ?c)
    :precondition (and
      (capability-required ?e ?c)
      (capability-composable ?c)
    )
    :subtasks (and
      (compose_capability ?e ?c)
      (represent_capability ?e ?c)
    )
  )

  (:method m_extend_canonical_manufacturer
    :task (resolve_capability ?e ?c)
    :precondition (capability-required ?e ?c)
    :subtasks (and
      (extend_canonical_capability_family ?c)
      (represent_capability ?e ?c)
    )
  )

  (:task construct_spark_surface
    :parameters (?e - extension)
  )

  (:method m_construct_spark_surface
    :task (construct_spark_surface ?e)
    :subtasks (and
      (project_capabilities_to_spark ?e)
      (prove_spark_surface_complete ?e)
    )
  )

  (:task project_implementation
    :parameters (?e - extension)
  )

  (:method m_project_implementation
    :task (project_implementation ?e)
    :subtasks (and
      (generate_extension ?e)
      (generate_transformers ?e)
      (generate_verifiers ?e)
      (generate_info ?e)
      (generate_errors ?e)
      (generate_igniter ?e)
      (generate_runtime_realizations ?e)
      (generate_observation_projections ?e)
      (generate_knowledge_projections ?e)
    )
  )

  (:task compose_extension
    :parameters (?e - extension)
  )

  (:method m_compose_extension
    :task (compose_extension ?e)
    :precondition (projected ?e)
    :subtasks (and
      (compose_resource_and_domain_extensions ?e)
      (compose_runtime_realizations ?e)
    )
  )

  (:task qualify_extension
    :parameters (?e - extension)
  )

  (:method m_qualify_extension
    :task (qualify_extension ?e)
    :precondition (composed ?e)
    :subtasks (and
      (run_static_courts ?e)
      (run_spark_implementation_parity ?e)
      (run_info_parity ?e)
      (run_transformer_determinism ?e)
      (run_verifier_negative_witnesses ?e)
      (run_igniter_idempotence ?e)
      (run_reactor_fidelity ?e)
      (run_composition_courts ?e)
      (run_regeneration_court ?e)
      (run_mutation_league ?e)
      (run_temporal_burn_in ?e)
      (establish_semantic_closure ?e)
    )
  )

  (:task stand_extension
    :parameters (?e - extension)
  )

  (:method m_stand_extension
    :task (stand_extension ?e)
    :precondition (and
      (qualified ?e)
      (no-hidden-semantics ?e)
      (no-dead-spark-semantics ?e)
      (burned-in ?e)
    )
    :subtasks (and
      (collect_evidence ?e)
      (emit_ocel ?e)
      (emit_provenance ?e)
      (emit_qualification_receipt ?e)
    )
  )

  (:task learn_reusable_gaps
    :parameters (?e - extension)
  )

  (:method m_learn_reusable_gaps
    :task (learn_reusable_gaps ?e)
    :subtasks (and
      (detect_surviving_gaps ?e)
      (generalize_reusable_gaps ?e)
    )
  )

  (:action observe_extension
    :parameters (?e - extension)
    :precondition ()
    :effect (observed ?e)
  )

  (:action admit_extension_semantics
    :parameters (?e - extension)
    :precondition (observed ?e)
    :effect (semantics-admitted ?e)
  )

  (:action resolve_required_capabilities
    :parameters (?e - extension)
    :precondition (semantics-admitted ?e)
    :effect ()
  )

  (:action represent_capability
    :parameters (?e - extension ?c - capability)
    :precondition (capability-required ?e ?c)
    :effect (capability-represented ?e ?c)
  )

  (:action compose_capability
    :parameters (?e - extension ?c - capability)
    :precondition (capability-required ?e ?c)
    :effect (capability-represented ?e ?c)
  )

  (:action extend_canonical_capability_family
    :parameters (?c - capability)
    :precondition ()
    :effect (capability-reusable ?c)
  )

  (:action project_capabilities_to_spark
    :parameters (?e - extension)
    :precondition (semantics-admitted ?e)
    :effect ()
  )

  (:action prove_spark_surface_complete
    :parameters (?e - extension)
    :precondition (semantics-admitted ?e)
    :effect (no-hidden-semantics ?e)
  )

  (:action generate_extension
    :parameters (?e - extension)
    :precondition (semantics-admitted ?e)
    :effect (projected ?e)
  )

  (:action generate_transformers :parameters (?e - extension) :precondition (projected ?e) :effect ())
  (:action generate_verifiers :parameters (?e - extension) :precondition (projected ?e) :effect ())
  (:action generate_info :parameters (?e - extension) :precondition (projected ?e) :effect ())
  (:action generate_errors :parameters (?e - extension) :precondition (projected ?e) :effect ())
  (:action generate_igniter :parameters (?e - extension) :precondition (projected ?e) :effect ())
  (:action generate_runtime_realizations :parameters (?e - extension) :precondition (projected ?e) :effect ())
  (:action generate_observation_projections :parameters (?e - extension) :precondition (projected ?e) :effect ())
  (:action generate_knowledge_projections :parameters (?e - extension) :precondition (projected ?e) :effect ())

  (:action compose_resource_and_domain_extensions
    :parameters (?e - extension)
    :precondition (projected ?e)
    :effect (composed ?e)
  )

  (:action compose_runtime_realizations :parameters (?e - extension) :precondition (projected ?e) :effect (composed ?e))

  (:action run_static_courts :parameters (?e - extension) :precondition (composed ?e) :effect ())
  (:action run_spark_implementation_parity :parameters (?e - extension) :precondition (composed ?e) :effect (no-hidden-semantics ?e))
  (:action run_info_parity :parameters (?e - extension) :precondition (composed ?e) :effect ())
  (:action run_transformer_determinism :parameters (?e - extension) :precondition (composed ?e) :effect ())
  (:action run_verifier_negative_witnesses :parameters (?e - extension) :precondition (composed ?e) :effect ())
  (:action run_igniter_idempotence :parameters (?e - extension) :precondition (composed ?e) :effect ())
  (:action run_reactor_fidelity :parameters (?e - extension) :precondition (composed ?e) :effect ())
  (:action run_composition_courts :parameters (?e - extension) :precondition (composed ?e) :effect ())
  (:action run_regeneration_court :parameters (?e - extension) :precondition (composed ?e) :effect ())
  (:action run_mutation_league :parameters (?e - extension) :precondition (composed ?e) :effect ())
  (:action run_temporal_burn_in :parameters (?e - extension) :precondition (composed ?e) :effect (burned-in ?e))

  (:action establish_semantic_closure
    :parameters (?e - extension)
    :precondition (and (no-hidden-semantics ?e) (burned-in ?e))
    :effect (and
      (no-dead-spark-semantics ?e)
      (qualified ?e)
    )
  )

  (:action collect_evidence :parameters (?e - extension) :precondition (qualified ?e) :effect ())
  (:action emit_ocel :parameters (?e - extension) :precondition (qualified ?e) :effect ())
  (:action emit_provenance :parameters (?e - extension) :precondition (qualified ?e) :effect ())
  (:action emit_qualification_receipt :parameters (?e - extension) :precondition (qualified ?e) :effect (receipted ?e))

  (:action detect_surviving_gaps :parameters (?e - extension) :precondition (receipted ?e) :effect ())
  (:action generalize_reusable_gaps :parameters (?e - extension) :precondition (receipted ?e) :effect ())
)
