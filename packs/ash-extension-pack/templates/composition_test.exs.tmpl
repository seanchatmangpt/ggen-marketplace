---
to: "test/{{ package_name }}_composition_test.exs"
for_each: "spec"
sparql:
  spec: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT DISTINCT ?package_name ?module_name (SAMPLE(?dual_level_fixture) AS ?dual_level_fixture) WHERE {
      ?s a aex:AshExtensionSpec ; aex:packageName ?package_name ; aex:moduleName ?module_name .
      OPTIONAL { ?s aex:dualLevelFixture ?dual_level_fixture }
      FILTER NOT EXISTS { ?s aex:fixtureOnly true }
    } GROUP BY ?package_name ?module_name
  targets: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT ?package_name ?composition_target ?composition_module WHERE {
      ?c a aex:CompositionTarget ; aex:compositionOf ?spec ; aex:compositionTarget ?composition_target .
      ?spec aex:packageName ?package_name .
      # aex:compositionTarget is the closed OTP-app vocabulary; the Elixir namespace is
      # not derivable by `capitalize` ("ash_graphql" -> "Ash_graphql" is not a module).
      VALUES (?composition_target ?composition_module) { ("ash_graphql" "AshGraphql") ("ash_json_api" "AshJsonApi") }
    } ORDER BY ?package_name ?composition_target
---
{# Composition test -- mirrors ash_r2rml/test/ggen_api_bundle_test.exs: compile a real
   fixture resource with the generated extension attached via Code.compile_string/1,
   then introspect it with the REAL Spark.Dsl.Extension Info-module functions (no
   mocking of the extension's own behavior). ash_graphql/ash_json_api are :test-only
   deps here -- never a runtime dependency of {{ package_name }} itself.

   v26.9.9: when aex:dualLevelFixture is true, also compiles a DOMAIN-level fixture
   stacked with the same aex:CompositionTarget extensions, mirroring the real,
   currently-shipped xaas exemplar (lib/xaas/library.ex:8 Xaas.Library domain +
   lib/xaas/library/book.ex:36 Xaas.Library.Book resource both stacking AshAi
   alongside 2-3 other extensions) -- proving co-residence with multiple extensions
   at both levels, not just isolated single-extension compilation. #}
{# Per-spec scoping: ggen evaluates each named `sparql:` result once against the whole
   union graph, not per `for_each` row, so every non-spec query selects ?package_name
   and is narrowed to the current spec here (the reactor_pipeline.ex.tmpl fix, applied
   to every DSL family). Without it a multi-spec graph rendered every spec's sections,
   entities, getters, verifiers and targets into every other spec's modules. #}
{% set targets = targets | filter(attribute="package_name", value=package_name) %}
defmodule {{ module_name }}CompositionTest do
  use ExUnit.Case, async: true

  @fixture_source """
  defmodule {{ module_name }}.CompositionFixture do
    use Ash.Resource,
      domain: nil,
      extensions: [{{ module_name }}{% for t in targets %}, {{ t.composition_module }}.Resource{% endfor %}]

    attributes do
      uuid_primary_key :id
    end
  end
  """

{% if dual_level_fixture | default(value="false") == "true" %}
  @domain_fixture_source """
  defmodule {{ module_name }}.CompositionDomainFixture do
    use Ash.Domain,
      extensions: [{{ module_name }}{% for t in targets %}, {{ t.composition_module }}.Domain{% endfor %}]

    resources do
    end
  end
  """

{% endif %}
  # setup_all: the fixture module is compiled once per test module, not redefined per
  # test. Code.compile_string/1 returns every module the source defines -- an Ash
  # resource also defines protocol impls (Inspect.<Fixture>, ...) -- so the fixture is
  # looked up by its declared name, not by destructuring a one-element list.
  setup_all do
    fixture_module = {{ module_name }}.CompositionFixture
    true = Enum.any?(Code.compile_string(@fixture_source), &match?({^fixture_module, _}, &1))
{% if dual_level_fixture | default(value="false") == "true" %}
    domain_module = {{ module_name }}.CompositionDomainFixture
    true = Enum.any?(Code.compile_string(@domain_fixture_source), &match?({^domain_module, _}, &1))
    %{fixture: fixture_module, domain_fixture: domain_module}
{% else %}
    %{fixture: fixture_module}
{% endif %}
  end

  test "the compiled fixture actually carries the {{ module_name }} extension", %{fixture: fixture} do
    assert {{ module_name }} in Spark.extensions(fixture)
  end

  test "{{ module_name }}.Info returns real, non-nil compiled state for the fixture", %{fixture: fixture} do
    refute is_nil({{ module_name }}.Info.compiled(fixture))
  end

{% if dual_level_fixture | default(value="false") == "true" %}
  test "the compiled DOMAIN fixture also carries the {{ module_name }} extension, co-resident with {{ targets | length }} other extension(s)", %{domain_fixture: domain_fixture} do
    assert {{ module_name }} in Spark.extensions(domain_fixture)
{% for t in targets %}
    assert {{ t.composition_module }}.Domain in Spark.extensions(domain_fixture)
{% endfor %}
  end

{% endif %}
{% for t in targets %}
  @tag :{{ t.composition_target }}
  test "composes with real {{ t.composition_target }} introspection", %{fixture: fixture} do
    # The generated extension and {{ t.composition_module }}.Resource co-reside on the
    # compiled fixture, and the library's real Info module is present.
    assert {{ t.composition_module }}.Resource in Spark.extensions(fixture)
    assert {{ module_name }} in Spark.extensions(fixture)
    assert function_exported?({{ t.composition_module }}.Resource.Info, :type, 1)
  end
{% endfor %}
end
