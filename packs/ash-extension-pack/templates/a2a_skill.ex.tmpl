---
to: "lib/{{ package_name }}/a2a_skill_example.ex"
for_each: "spec"
sparql:
  spec: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>

    # One row per spec whose declared DSL carries the CURRENT ash_a2a `a2a`
    # section with a `skill` entity exposing the three v26.10 projection fields
    # (argument_mapping / get? / lease_required?). OPTIONAL joins: a spec whose
    # ontology rows omit one of the three fields simply yields no row here (the
    # template then renders nothing for it) -- gates/
    # 140_a2a_skill_fields_contract.rq is the court that REFUSES the omission,
    # so template silence and gate refusal stay disjoint failure modes.
    # Ground truth for every cited line range: lib/ash_a2a/dsl.ex at
    # main@5a84d886e0696cd43115799bbdc4bc8ec481376c (aex:dslCitation rows).
    SELECT ?package_name ?module_name
           ?arg_mapping_default ?arg_mapping_cite ?arg_mapping_doc
           ?get_default ?get_cite ?get_doc
           ?lease_default ?lease_cite ?lease_doc WHERE {
      ?spec a aex:AshExtensionSpec ; aex:packageName ?package_name ;
            aex:moduleName ?module_name .
      ?section a aex:DslSection ; aex:sectionOf ?spec ; aex:sectionName "a2a" .
      ?entity a aex:DslEntity ; aex:entityOf ?section ; aex:entityName "skill" .
      OPTIONAL {
        ?f_am a aex:EntitySchemaField ; aex:fieldOf ?entity ;
              aex:fieldName "argument_mapping" ; aex:fieldDefault ?arg_mapping_default ;
              aex:dslCitation ?arg_mapping_cite ; aex:fieldDoc ?arg_mapping_doc .
      }
      OPTIONAL {
        ?f_get a aex:EntitySchemaField ; aex:fieldOf ?entity ;
               aex:fieldName "get?" ; aex:fieldDefault ?get_default ;
               aex:dslCitation ?get_cite ; aex:fieldDoc ?get_doc .
      }
      OPTIONAL {
        ?f_lease a aex:EntitySchemaField ; aex:fieldOf ?entity ;
                 aex:fieldName "lease_required?" ; aex:fieldDefault ?lease_default ;
                 aex:dslCitation ?lease_cite ; aex:fieldDoc ?lease_doc .
      }
      FILTER NOT EXISTS { ?spec aex:fixtureOnly true }
    }
    ORDER BY ?package_name
---
{# Worked `a2a do skill ... end` example -- the CURRENT ash_a2a grammar, with the
   three v26.10 skill fields (argument_mapping / get? / lease_required?)
   demonstrated with their real defaults and verbatim dsl.ex citations pulled
   from the ontology's aex:dslCitation rows. Every field, default and citation
   in this file is data from the graph (echo, don't synthesize); if the graph
   omits a field, the OPTIONAL join drops it and the citation line, and
   gates/140_a2a_skill_fields_contract.rq refuses the omission independently.
   The hddl_operator line demonstrates the nested-entity half of the surface
   (dsl.ex:137-145); its :read consequence example follows the SEC-04 rule that
   consequence: :observe is the :read default and may not be lifted onto a
   mutating action (dsl.ex:46-56). #}
defmodule {{ module_name }}.A2aSkillExample do
  @moduledoc """
  Worked `a2a do skill ... end` example for `{{ package_name }}`, generated by
  ash-extension-pack's `a2a_skill.ex.tmpl` from its `aex:AshA2aSpec` ontology
  rows -- regenerate, do not hand-edit.

  Current `a2a` grammar, demonstrating the three v26.10 projection fields:

  ```
  defmodule MyApp.Catalog do
    use Ash.Domain, extensions: [AshA2A]

    a2a do
      skill :search, :read,
        argument_mapping: {{ arg_mapping_default }},
        get?: {{ get_default }},
        lease_required?: {{ lease_default }} do
        hddl_operator parameters: [:query],
                      preconditions: [{:catalog_loaded, []}],
                      add_effects: [{:searched, [:query]}],
                      delete_effects: []
      end

      authority do
        gate :two_port
        lease_duration_ms 60_000
      end

      hooks do
        pre_dispatch [:my_app.validate_query]
        post_dispatch [:my_app.audit_search]
      end
    end
  end
  ```

  Field contracts (verbatim from the ground truth, not paraphrase):

  - `argument_mapping`{% if arg_mapping_cite %} -- {{ arg_mapping_cite }}:
    {{ arg_mapping_doc }}{% endif %} Verified at compile time by
    `AshA2A.Verifiers.VerifySkills` (`refused_argument_mapping_target`,
    verify_skills.ex:184-199) -- every map value atom must be a real argument
    on the referenced action.
  - `get?`{% if get_cite %} -- {{ get_cite }}: {{ get_doc }}{% endif %}
  - `lease_required?`{% if lease_cite %} -- {{ lease_cite }}: {{ lease_doc }}{% endif %}
    Verified at compile time by `AshA2A.Verifiers.VerifySkills`
    (`refused_lease_required_no_authorizer`, verify_skills.ex:299-311).

  `authority`/`hooks` section options and `semantic_requests` are transcribed
  with their own `aex:dslCitation` rows in ontology.ttl (dsl.ex:187-202,
  204-219, 164-183).
  """

  @doc false
  def field_citations do
    %{
      argument_mapping: "{{ arg_mapping_cite }}",
      get?: "{{ get_cite }}",
      lease_required?: "{{ lease_cite }}"
    }
  end

  @doc false
  def field_defaults do
    %{
      argument_mapping: "{{ arg_mapping_default }}",
      get?: {{ get_default }},
      lease_required?: {{ lease_default }}
    }
  end
end
