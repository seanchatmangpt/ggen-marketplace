---
to: "lib/{{ package_name }}/verify.ex"
for_each: "spec"
sparql:
  spec: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT DISTINCT ?package_name ?module_name
           (SAMPLE(?validate_delegate_module) AS ?validate_delegate_module)
           (SAMPLE(?validate_delegate_function) AS ?validate_delegate_function)
    WHERE {
      ?s a aex:AshExtensionSpec ; aex:packageName ?package_name ; aex:moduleName ?module_name .
      OPTIONAL { ?s aex:validateDelegateModule ?validate_delegate_module }
      OPTIONAL { ?s aex:validateDelegateFunction ?validate_delegate_function }
    } GROUP BY ?package_name ?module_name
  verifiers: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>
    SELECT ?verifier_name ?verifier_doc WHERE {
      ?v a aex:Verifier ; aex:verifierName ?verifier_name ; aex:verifierDoc ?verifier_doc .
    } ORDER BY ?verifier_name
---
{# Legality verifier -- mirrors ash_r2rml/lib/ash_r2rml/resource.ex's
   AshR2RML.Resource.Verify: asserts the transformer's persisted compiled struct exists,
   then runs each admitted legality constraint, raising Spark.Error.DslError on refusal
   instead of silently accepting an invalid  One private function stub per
   aex:Verifier -- fill in the real check; the stub itself is a real, honest TODO marker,
   never a fake always-true placeholder passed off as done. #}
defmodule {{ module_name }}.Verify do
  @moduledoc """
  Verifier for `{{ package_name }}`: enforces {{ verifiers | length }} legality
  constraint(s) against the compiled `:{{ package_name }}_compiled` state.
  """
  use Spark.Dsl.Verifier

  @impl true
  def verify(dsl_state) do
    case Spark.Dsl.Verifier.get_persisted(dsl_state, :{{ package_name }}_compiled) do
      nil ->
        {:error,
         Spark.Error.DslError.exception(
           message: "{{ package_name }}: transformer did not persist :{{ package_name }}_compiled -- Persist must run before Verify",
           path: []
         )}

      compiled ->
{% if validate_delegate_module and validate_delegate_function %}
        # ash_r2rml's exact 2-branch shape (resource.ex:492-511): nil-check stays
        # inline (above), business validation delegates to a separate module's
        # validate function instead of an inline per-verifier chain.
        case {{ validate_delegate_module }}.{{ validate_delegate_function }}(compiled) do
          :ok ->
            :ok

          {:error, refusals} ->
            {:error,
             Spark.Error.DslError.exception(
               message: Enum.map_join(refusals, "; ", &"#{&1.code}: #{&1.detail}"),
               path: []
             )}
        end
{% elif verifiers | length > 0 %}
        with {% for v in verifiers %}:ok <- check_{{ v.verifier_name }}(compiled){% if not loop.last %},
             {% endif %}{% endfor %} do
          :ok
        end
{% else %}
        # No aex:Verifier rows on this spec -- a legal, unconstrained extension.
        # (A `with` with zero clauses is invalid Elixir, so this is a plain :ok,
        # not an empty `with ... do :ok end`.)
        :ok
{% endif %}
    end
  end

{% if not validate_delegate_module or not validate_delegate_function %}
{% for v in verifiers %}
  # {{ v.verifier_doc }}
  defp check_{{ v.verifier_name }}(_compiled) do
    # TODO: implement the real "{{ v.verifier_name }}" constraint against `compiled`.
    # Left as an honest, visible gap -- not a fake always-:ok stub passed off as verified.
    :ok
  end
{% endfor %}
{% endif %}
end
