---
to: "scripts/README.md"
for_each: "scripts_index"
sparql:
  scripts_index: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>

    SELECT ?index_repo ?index_dir WHERE {
      ?doc a aex:ScriptsIndexDoc ;
           aex:scriptsIndexRepo ?index_repo ;
           aex:scriptsIndexDir ?index_dir .
    }
    ORDER BY ?index_repo
  scripts_entries: |
    PREFIX aex: <http://seanchatmangpt.github.io/packs/ash-extension-core#>

    SELECT ?entry_file ?entry_role ?entry_body WHERE {
      ?entry a aex:ScriptsIndexEntry ;
             aex:scriptsIndexEntryFile ?entry_file ;
             aex:scriptsIndexEntryRole ?entry_role ;
             aex:scriptsIndexEntryBody ?entry_body .
    }
    ORDER BY ?entry_file
---
# {{ index_dir }}/
{% for s in scripts_entries %}
## {{ s.entry_file }} — {{ s.entry_role }}

{{ s.entry_body }}
{% endfor %}