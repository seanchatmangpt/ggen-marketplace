to: src/pn64_masks.rs
sparql:
  transitions: "PREFIX st: <https://strata.chatman.ai/ontology#> SELECT ?opcode ?pre ?post ?label WHERE { ?t a st:RonrTransition ; st:transitionOpcode ?opcode ; st:transitionPre ?pre ; st:transitionPost ?post ; st:transitionLabel ?label } ORDER BY ?opcode"
skip_if: "ggen:local-override"
---
//! PN64 PRE/POST mask tables — GENERATED by `ggen sync` from the
//! `strata-pn64-pack` ontology. Do not edit by hand.
//!
//! Ground truth: ~/strata/strata_protocol/src/pn64.rs (bit layout) and
//! ronr.rs (place masks + canonical transitions). The source of truth is
//! the RDF ontology; regenerate rather than patching here.
//! The ggen.toml-driven .tera rule emits the same tables plus the FR-02.3
//! deadlock/siphon gate (reachable_bitset, has_deadlock_excluding,
//! TERMINALS) into generated/pn64_masks.rs.

/// PN64 bit layout (little-endian bit fields, one transition per u64):
///   - bits [15:0]  : marking `m`
///   - bits [31:16] : precondition mask `W-`
///   - bits [47:32] : postcondition mask `W+`
///   - bits [55:48] : transition id
///   - bits [63:56] : flags / invariant byte
pub const MASK16: u64 = 0xFFFF;

/// Number of canonical RONR transitions projected from the ontology.
pub const VERB_COUNT: usize = 6;

/// Precondition place masks `W-` per canonical opcode (index = opcode - 1).
pub const PRE_MASKS: [u16; VERB_COUNT] = [
{% for t in transitions %}
    {{ t.pre }}, // opcode {{ t.opcode }} {{ t.label }}
{% endfor %}
];

/// Postcondition place masks `W+` per canonical opcode (index = opcode - 1).
pub const POST_MASKS: [u16; VERB_COUNT] = [
{% for t in transitions %}
    {{ t.post }}, // opcode {{ t.opcode }} {{ t.label }}
{% endfor %}
];

/// A transition is enabled iff every precondition place holds a token.
#[inline]
pub const fn enabled(marking: u16, pre: u16) -> bool {
    (marking & pre) == pre
}

/// Fire: `m' = (m ^ W-) | W+`, matching pn64::fire on the marking field.
#[inline]
pub const fn fire(marking: u16, pre: u16, post: u16) -> u16 {
    ((marking ^ pre) | post) & 0xFFFF
}
