//! PN64 PRE/POST mask tables — GENERATED by `ggen sync run` from the
//! `strata-pn64-pack` ontology. Do not edit by hand.
//!
//! Ground truth: ~/strata/strata_protocol/src/pn64.rs (bit layout) and
//! ronr.rs (place masks + canonical transitions). The source of truth is
//! the RDF ontology; regenerate rather than patching here.

/// PN64 bit layout (little-endian bit fields, one transition per u64):
///   - bits [15:0]  : marking `m`
///   - bits [31:16] : precondition mask `W-`
///   - bits [47:32] : postcondition mask `W+`
///   - bits [55:48] : transition id
///   - bits [63:56] : flags / invariant byte
pub const MASK16: u64 = 0xFFFF;

/// Number of canonical RONR transitions projected from the ontology.
pub const VERB_COUNT: usize = {{ results | length }};

/// Precondition place masks `W-` per canonical opcode (index = opcode - 1).
pub const PRE_MASKS: [u16; VERB_COUNT] = [
{% if results | length == 0 %}
// REFUSED: empty ontology projection
{% else %}
{% for row in results %}
    {{ row.pre }}, // opcode {{ row.opcode }} {{ row.label }}
{% endfor %}{% endif %}
];

/// Postcondition place masks `W+` per canonical opcode (index = opcode - 1).
pub const POST_MASKS: [u16; VERB_COUNT] = [
{% if results | length == 0 %}
// REFUSED: empty ontology projection
{% else %}
{% for row in results %}
    {{ row.post }}, // opcode {{ row.opcode }} {{ row.label }}
{% endfor %}{% endif %}
];

/// A transition is enabled iff every precondition place holds a token.
#[inline]
pub const fn enabled(marking: u16, pre: u16) -> bool {
    (marking & pre) == pre
}

/// Fire: `m' = (m ^ W-) | W+`, matching pn64::fire on the marking field.
#[inline]
pub const fn fire(marking: u16, pre: u16, post: u16) -> u16 {
    ((marking ^ pre) | post) & 0xFFFF
}

/// Terminal markings exempt from the deadlock gate (clean termination by
/// design): ADOPTED = N_MAIN_MOTION | N_ADOPTED (post of opcode 0x06) and
/// REJECTED = N_MAIN_MOTION | N_POSTPONED_INDEF (ronr.rs noun space,
/// 0x0001 | 0x0400). Exemption is exact membership, per invariants.rs.
pub const TERMINALS: &[u16] = &[0x0101, 0x0401];

/// Canonical six transitions as `(pre, post)` pairs (mirror of PRE_MASKS /
/// POST_MASKS for the structural invariants).
pub const TRANSITIONS: [(u16, u16); 6] = [
{% for row in results %}
    ({{ row.pre }}, {{ row.post }}),
{% endfor %}];

/// BFS over the marking graph (≤65536 markings) from `m0`; 1-safe boolean
/// place semantics. Port of strata_protocol/src/invariants.rs::reachable_bitset.
/// Firing law: `m' = (m & !pre) | post`.
pub fn reachable_bitset(m0: u16, transitions: &[(u16, u16)]) -> Vec<u64> {
    let mut set = vec![0u64; 1024];
    let mut queue = vec![0u16; 65536];
    let (mut head, mut tail) = (0usize, 0usize);
    queue[tail] = m0;
    tail += 1;
    set[(m0 as usize) >> 6] |= 1u64 << (m0 & 63);
    while head < tail {
        let m = queue[head];
        head += 1;
        for &(pre, post) in transitions {
            if (m & pre) == pre {
                let m2 = (m & !pre) | post;
                let word = (m2 as usize) >> 6;
                if set[word] & (1u64 << (m2 & 63)) == 0 {
                    set[word] |= 1u64 << (m2 & 63);
                    queue[tail] = m2;
                    tail += 1;
                }
            }
        }
    }
    set
}

/// Deadlock (siphon-trap witness) check: `Some(m)` for the first reachable
/// marking at which no transition is enabled, except markings in `terminals`
/// (clean termination is not a liveness defect). Port of
/// strata_protocol/src/invariants.rs::has_deadlock_excluding.
pub fn has_deadlock_excluding(set: &[u64], transitions: &[(u16, u16)], terminals: &[u16]) -> Option<u16> {
    for word in 0..set.len() {
        let mut bits = set[word];
        while bits != 0 {
            let low = bits.trailing_zeros();
            let m = ((word as u16) << 6) | (low as u16);
            if !terminals.contains(&m) && transitions.iter().all(|&(pre, _)| (m & pre) != pre) {
                return Some(m);
            }
            bits &= bits - 1;
        }
    }
    None
}

#[cfg(test)]
mod tests {
    use super::*;

    /// Court: generated tables match the canonical six masks in ronr.rs
    /// (test canonical_six_exact_masks ground truth).
    #[test]
    fn canonical_six_exact_masks() {
        let want: [(u16, u16, usize); 6] = [
            (0x0081, 0x0082, 0x0001),
            (0x0002, 0x000C, 0x0002),
            (0x0008, 0x0010, 0x0003),
            (0x0010, 0x0008, 0x0004),
            (0x0008, 0x0060, 0x0005),
            (0x0024, 0x0101, 0x0006),
        ];
        assert_eq!(VERB_COUNT, 6);
        for (pre, post, idx) in want {
            assert_eq!(PRE_MASKS[idx - 1], pre, "pre mismatch at opcode {idx:#04x}");
            assert_eq!(POST_MASKS[idx - 1], post, "post mismatch at opcode {idx:#04x}");
        }
    }

    #[test]
    fn fire_math_matches_pn64_law() {
        // m=0b0110, W-=0b0010, W+=0b1000 -> (m ^ W-) | W+ = 0b1100
        assert_eq!(fire(0b0110, 0b0010, 0b1000), 0b1100);
        assert_eq!(fire(0xFFFF, 0xFFFF, 0xFFFF), 0xFFFF);
    }

    /// Court (FR-02.3): the canonical six-net is live from the quorate start
    /// marking MAIN_MOTION|STATED|FLOOR = 0x0083 — no non-terminal reachable
    /// marking enables nothing.
    #[test]
    fn canonical_six_net_is_live() {
        let set = reachable_bitset(0x0083, &TRANSITIONS);
        assert_eq!(has_deadlock_excluding(&set, &TRANSITIONS, TERMINALS), None);
        // Even with zero exemptions the reachable set has no trap: every
        // reachable marking enables some canonical transition.
        assert_eq!(has_deadlock_excluding(&set, &TRANSITIONS, &[]), None);
    }

    /// The adopted terminal (post of opcode 0x06) enables nothing by design:
    /// reported as a deadlock without the exemption, clean under TERMINALS.
    #[test]
    fn adopted_terminal_is_exempt() {
        let set = reachable_bitset(0x0101, &TRANSITIONS);
        assert_eq!(has_deadlock_excluding(&set, &TRANSITIONS, &[]), Some(0x0101));
        assert_eq!(has_deadlock_excluding(&set, &TRANSITIONS, TERMINALS), None);
    }

    /// Deliberately starved start (STATED only): the net dead-ends at
    /// 0x0141; the exemption is exact membership, so only exempting that
    /// marking clears the gate.
    #[test]
    fn deadlocked_net_reported_and_exempt() {
        let set = reachable_bitset(0x0002, &TRANSITIONS);
        assert_eq!(has_deadlock_excluding(&set, &TRANSITIONS, &[]), Some(0x0141));
        assert_eq!(has_deadlock_excluding(&set, &TRANSITIONS, &[0x0141]), None);
    }
}
