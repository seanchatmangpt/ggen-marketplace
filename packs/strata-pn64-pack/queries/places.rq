# places.rq — all place individuals with their bit offsets, LSB-first.
# Complement of transitions.rq: that query lowers the transition table,
# this one lowers the place (marking-bit) vocabulary.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX pn:   <https://strata.chatman.ai/ontology/pn64#>

# Ground truth: ~/strata/ontology.ttl. Labels are OPTIONAL: the pn:slot*
# and pn:Committed individuals carry pn:bitOffset only, no rdfs:label.

SELECT ?place ?label ?bitOffset
WHERE {
  ?place a pn:Place ;
         pn:bitOffset ?bitOffset .
  OPTIONAL { ?place rdfs:label ?label }
}
ORDER BY ?bitOffset
