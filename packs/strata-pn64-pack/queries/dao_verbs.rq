# dao_verbs.rq — DaoVerb individuals with their canonical wire values.
PREFIX pn: <https://strata.chatman.ai/ontology/pn64#>

# Ground truth: ~/strata/ontology.ttl (pn64 namespace). DaoVerb individuals
# carry exactly one wire-value predicate, pn:value; no verbOpcode predicate
# exists in the ontology, so the former st:verbOpcode binding is dropped.
# NOTE (DELIBERATE-PENDING-DECISION, do not resolve here): pn:Second's wire
# value 2 collides with pn:SecondMotion's RONR transition opcode 2; this
# query reads the DaoVerb namespace only and cannot see the collision.

SELECT ?verb ?value
WHERE {
  ?verb a pn:DaoVerb ;
        pn:value ?value .
}
ORDER BY ?value
