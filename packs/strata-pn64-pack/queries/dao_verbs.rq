# dao_verbs.rq — DaoVerb individuals with their canonical wire values.
PREFIX pn:   <https://strata.chatman.ai/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# pn: is bound to the strata ontology namespace: pn:value is the same IRI
# as st:value declared in ontology.ttl.

SELECT ?verb ?value ?opcode
WHERE {
  ?verb a pn:DaoVerb ;
        pn:value ?value ;
        pn:transitionOpcode ?opcode .
}
ORDER BY ?value
