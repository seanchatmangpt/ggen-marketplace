# dao_verbs.rq — DaoVerb individuals with their canonical wire values.
PREFIX st:   <https://strata.chatman.ai/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# st: is bound to the strata ontology namespace: st:value is the same IRI
# as st:value declared in ontology.ttl.

SELECT ?verb ?value ?opcode
WHERE {
  ?verb a st:DaoVerb ;
        st:value ?value ;
        st:verbOpcode ?opcode .
}
ORDER BY ?value
