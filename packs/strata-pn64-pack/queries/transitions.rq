# transitions.rq — canonical RONR transitions (opcodes 1-25) with pre/post
# masks, ordered by opcode for the template's array-index lowering.
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX pn:   <https://strata.chatman.ai/ontology/pn64#>

# Ground truth: ~/strata/ontology.ttl. pn:Transition also carries the DAO
# transitions (opcodes 112-151); the former st:RonrTransition scope is the
# RONR table only, hence the opcode bound. Labels are OPTIONAL because
# ground-truth transition individuals carry rdfs:comment, not rdfs:label.

SELECT ?opcode ?pre ?post ?label
WHERE {
  ?t a pn:Transition ;
     pn:opcode ?opcode ;
     pn:preMask ?pre ;
     pn:postMask ?post .
  FILTER (?opcode <= 25)
  OPTIONAL { ?t rdfs:label ?label }
}
ORDER BY ?opcode
