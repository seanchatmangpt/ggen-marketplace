@prefix f5os: <http://seanchatmangpt.github.io/packs/fortune5-object-storage-law#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Falsifier for gates/020 + SHACL directActuation=false.
# Union with ontology.ttl must produce >=1 gate row / SHACL non-conformance.

f5os:bad-actuation-law a f5os:BucketLaw ;
    f5os:lawId "BUCKET-BAD-ACTUATION" ;
    f5os:title "Illicit direct actuation bucket law" ;
    f5os:appliesToStorageClass f5os:ObjectEvidence ;
    f5os:versioningEnabled true ;
    f5os:encryptionAtRest true ;
    f5os:immutableCapable true ;
    f5os:hasLifecycleRule f5os:EvidenceLifecycle ;
    f5os:evidenceRequired true ;
    f5os:directActuation true .
