@prefix f5os: <http://seanchatmangpt.github.io/packs/fortune5-object-storage-law#> .

# Falsifier for gates/020 versioningEnabled=true + SHACL hasValue true.

f5os:bad-versioning-law a f5os:BucketLaw ;
    f5os:lawId "BUCKET-BAD-VERSIONING" ;
    f5os:title "Bucket law without versioning" ;
    f5os:appliesToStorageClass f5os:ObjectEvidence ;
    f5os:versioningEnabled false ;
    f5os:encryptionAtRest true ;
    f5os:immutableCapable true ;
    f5os:hasLifecycleRule f5os:EvidenceLifecycle ;
    f5os:evidenceRequired true ;
    f5os:directActuation false .
