@prefix f5os: <http://seanchatmangpt.github.io/packs/fortune5-object-storage-law#> .

# Gate 010 anti-vacuity: incomplete BucketLaw (missing versioningEnabled).
# Union with ontology.ttl must produce >=1 gate 010 row / SHACL non-conformance.

f5os:incomplete-010-law a f5os:BucketLaw ;
    f5os:lawId "BUCKET-INCOMPLETE-010" ;
    f5os:title "Incomplete bucket law missing versioningEnabled" ;
    f5os:appliesToStorageClass f5os:ObjectEvidence ;
    f5os:encryptionAtRest true ;
    f5os:immutableCapable true ;
    f5os:hasLifecycleRule f5os:EvidenceLifecycle ;
    f5os:evidenceRequired true ;
    f5os:directActuation false .
