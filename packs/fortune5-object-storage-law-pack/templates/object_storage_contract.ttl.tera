---
to: "infrastructure/data/object-storage/object_storage_contract.ttl"
force: true
sparql:
  programs: |
    PREFIX f5os: <http://seanchatmangpt.github.io/packs/fortune5-object-storage-law#>
    SELECT ?programId ?catalogGroup ?catalogVersion ?catalogPackId ?directActuation
    WHERE {
      ?p a f5os:ObjectStorageProgram ;
         f5os:programId ?programId ;
         f5os:catalogGroup ?catalogGroup ;
         f5os:catalogVersion ?catalogVersion ;
         f5os:catalogPackId ?catalogPackId ;
         f5os:directActuation ?directActuation .
    }
    ORDER BY ?programId
  laws: |
    PREFIX f5os: <http://seanchatmangpt.github.io/packs/fortune5-object-storage-law#>
    SELECT ?lawId ?title ?storageClassId ?versioning ?encryption ?immutable
           ?ruleId ?ruleTitle ?transitionDays ?expireDays
           ?evidence ?directActuation ?lcDirect
    WHERE {
      ?law a f5os:BucketLaw ;
           f5os:lawId ?lawId ;
           f5os:title ?title ;
           f5os:appliesToStorageClass ?sc ;
           f5os:versioningEnabled ?versioning ;
           f5os:encryptionAtRest ?encryption ;
           f5os:immutableCapable ?immutable ;
           f5os:hasLifecycleRule ?lc ;
           f5os:evidenceRequired ?evidence ;
           f5os:directActuation ?directActuation .
      ?sc f5os:storageClassId ?storageClassId .
      ?lc f5os:ruleId ?ruleId ;
          f5os:title ?ruleTitle ;
          f5os:transitionDays ?transitionDays ;
          f5os:expireDays ?expireDays ;
          f5os:directActuation ?lcDirect .
    }
    ORDER BY ?lawId
---
# GENERATED by ggen sync from fortune5-object-storage-law-pack — do not edit by hand.
# Flattened projection of admitted object-storage facts (broker-only; no secrets).
@prefix f5os: <http://seanchatmangpt.github.io/packs/fortune5-object-storage-law#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

{% for row in laws -%}
f5os:proj-sc-{{ row.storageClassId }} a f5os:StorageClass ;
    f5os:storageClassId "{{ row.storageClassId }}" .

f5os:proj-lc-{{ row.ruleId }} a f5os:LifecycleRule ;
    f5os:ruleId "{{ row.ruleId }}" ;
    f5os:title "{{ row.ruleTitle }}" ;
    f5os:transitionDays "{{ row.transitionDays }}"^^xsd:integer ;
    f5os:expireDays "{{ row.expireDays }}"^^xsd:integer ;
    f5os:directActuation {{ row.lcDirect }} .

f5os:proj-law-{{ row.lawId }} a f5os:BucketLaw ;
    f5os:lawId "{{ row.lawId }}" ;
    f5os:title "{{ row.title }}" ;
    f5os:appliesToStorageClass f5os:proj-sc-{{ row.storageClassId }} ;
    f5os:versioningEnabled {{ row.versioning }} ;
    f5os:encryptionAtRest {{ row.encryption }} ;
    f5os:immutableCapable {{ row.immutable }} ;
    f5os:hasLifecycleRule f5os:proj-lc-{{ row.ruleId }} ;
    f5os:evidenceRequired {{ row.evidence }} ;
    f5os:directActuation {{ row.directActuation }} .
{% endfor %}

{% for row in programs -%}
f5os:proj-program-{{ row.programId }} a f5os:ObjectStorageProgram ;
    f5os:programId "{{ row.programId }}" ;
    f5os:catalogGroup "{{ row.catalogGroup }}" ;
    f5os:catalogVersion "{{ row.catalogVersion }}" ;
    f5os:catalogPackId "{{ row.catalogPackId }}" ;
    f5os:directActuation {{ row.directActuation }} .
{% endfor %}
