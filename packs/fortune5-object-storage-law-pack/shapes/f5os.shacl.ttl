@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix f5os: <http://seanchatmangpt.github.io/packs/fortune5-object-storage-law#> .

# SHACL twin of gates/010_storage_contract.rq and
# gates/020_broker_only_no_actuation.rq.
# Path is shapes/f5os.shacl.ttl (not root shapes.ttl — pack contract refuses that name).
# Manual: ggen graph validate --files ontology.ttl --shapes shapes/f5os.shacl.ttl

f5os:ObjectStorageProgramShape a sh:NodeShape ;
    sh:targetClass f5os:ObjectStorageProgram ;
    sh:closed false ;
    sh:property [
        sh:path f5os:programId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
        sh:message "ObjectStorageProgram missing programId" ;
    ] ;
    sh:property [
        sh:path f5os:catalogGroup ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:hasValue "object-storage" ;
        sh:message "ObjectStorageProgram catalogGroup must be object-storage" ;
    ] ;
    sh:property [
        sh:path f5os:catalogVersion ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
        sh:message "ObjectStorageProgram missing catalogVersion" ;
    ] ;
    sh:property [
        sh:path f5os:catalogPackId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:hasValue "fortune5-object-storage-law-pack" ;
        sh:message "catalogPackId must equal fortune5-object-storage-law-pack" ;
    ] ;
    sh:property [
        sh:path f5os:hasBucketLaw ;
        sh:minCount 1 ; sh:class f5os:BucketLaw ;
        sh:message "ObjectStorageProgram must declare at least one BucketLaw" ;
    ] ;
    sh:property [
        sh:path f5os:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:message "ObjectStorageProgram directActuation must be false (broker-only)" ;
    ] ;
    sh:severity sh:Violation .

f5os:BucketLawShape a sh:NodeShape ;
    sh:targetClass f5os:BucketLaw ;
    sh:closed false ;
    sh:property [
        sh:path f5os:lawId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5os:title ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5os:appliesToStorageClass ;
        sh:minCount 1 ; sh:class f5os:StorageClass ;
    ] ;
    sh:property [
        sh:path f5os:versioningEnabled ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "versioningEnabled must be true" ;
    ] ;
    sh:property [
        sh:path f5os:encryptionAtRest ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "encryptionAtRest must be true" ;
    ] ;
    sh:property [
        sh:path f5os:immutableCapable ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "immutableCapable must be true" ;
    ] ;
    sh:property [
        sh:path f5os:hasLifecycleRule ;
        sh:minCount 1 ; sh:class f5os:LifecycleRule ;
    ] ;
    sh:property [
        sh:path f5os:evidenceRequired ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue true ;
        sh:message "evidenceRequired must be true" ;
    ] ;
    sh:property [
        sh:path f5os:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
        sh:message "BucketLaw directActuation must be false (broker-only)" ;
    ] ;
    sh:severity sh:Violation .

f5os:LifecycleRuleShape a sh:NodeShape ;
    sh:targetClass f5os:LifecycleRule ;
    sh:property [
        sh:path f5os:ruleId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5os:title ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:property [
        sh:path f5os:transitionDays ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "transitionDays must be a positive xsd:integer" ;
    ] ;
    sh:property [
        sh:path f5os:expireDays ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "expireDays must be a positive xsd:integer" ;
    ] ;
    sh:property [
        sh:path f5os:directActuation ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ;
        sh:hasValue false ;
    ] ;
    sh:severity sh:Violation .

f5os:StorageClassShape a sh:NodeShape ;
    sh:targetClass f5os:StorageClass ;
    sh:property [
        sh:path f5os:storageClassId ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ;
    ] ;
    sh:severity sh:Violation .
