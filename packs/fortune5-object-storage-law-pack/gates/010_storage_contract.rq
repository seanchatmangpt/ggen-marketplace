# MESSAGE: Fortune 5 object-storage contract incomplete -- every program, bucket law, and lifecycle rule requires identity, versioning, encryption, immutability, and evidence
PREFIX f5os: <http://seanchatmangpt.github.io/packs/fortune5-object-storage-law#>
SELECT ?subject ?kind ?missing WHERE {
  {
    ?subject a f5os:ObjectStorageProgram .
    BIND("program" AS ?kind)
    VALUES ?property {
      f5os:programId f5os:catalogGroup f5os:catalogVersion
      f5os:catalogPackId f5os:hasBucketLaw f5os:directActuation
    }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(STR(?property) AS ?missing)
  }
  UNION
  {
    ?subject a f5os:BucketLaw .
    BIND("bucket-law" AS ?kind)
    VALUES ?property {
      f5os:lawId f5os:title f5os:appliesToStorageClass
      f5os:versioningEnabled f5os:encryptionAtRest f5os:immutableCapable
      f5os:hasLifecycleRule f5os:evidenceRequired f5os:directActuation
    }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(STR(?property) AS ?missing)
  }
  UNION
  {
    ?subject a f5os:LifecycleRule .
    BIND("lifecycle" AS ?kind)
    VALUES ?property {
      f5os:ruleId f5os:title f5os:transitionDays f5os:expireDays
      f5os:directActuation
    }
    FILTER NOT EXISTS { ?subject ?property ?value }
    BIND(STR(?property) AS ?missing)
  }
}
ORDER BY ?kind ?subject ?missing
