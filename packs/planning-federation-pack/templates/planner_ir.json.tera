{
  "schema": "urn:ggen:planning-federation:ir:v1",
  "domain": "admitted-demo",
  "initial": "observed",
  "goal": "verified",
  "actions": [
{% for a in results %}    {"id": {{ a.action | json_encode }}, "precondition": {{ a.pre | json_encode }}, "effect": {{ a.effect | json_encode }}, "cost": {{ a.cost }}, "duration": {{ a.duration }}, "probability": {{ a.probability }}, "authority_ref": {{ a.authority | json_encode }}}{% if not loop.last %},{% endif %}
{% endfor %}  ],
  "no_plan_statuses": ["NO_PLAN","UNREACHABLE","TIMEOUT","UNSUPPORTED","ACTION_DISCOVERY_GAP","INSUFFICIENT_OBSERVATION","AUTHORITY_BLOCKED"]
}
