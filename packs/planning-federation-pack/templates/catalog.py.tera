"""Generated planner action catalog for domain '{{ results.0.domain | default(value="admitted-demo") }}'.

Source: ggen-marketplace planning-federation-pack (queries/model.rq).
Do not edit by hand -- regenerate via `ggen sync run`.
"""

ACTIONS = [
{% for a in results %}    {
        "id": {{ a.action | json_encode }},
        "precondition": {{ a.pre | json_encode }},
        "effect": {{ a.effect | json_encode }},
        "cost": {{ a.cost }},
        "duration": {{ a.duration }},
        "probability": {{ a.probability }},
        "authority_ref": {{ a.authority | json_encode }},
    },
{% endfor %}]


def by_id(action_id: str):
    for action in ACTIONS:
        if action["id"] == action_id:
            return action
    return None
