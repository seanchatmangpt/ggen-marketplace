@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pf: <https://ggen.io/marketplace/planning-federation#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pf:ActionShape a sh:NodeShape ;
  sh:targetClass pf:PlannableAction ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path pf:precondition ; sh:minCount 1 ] ;
  sh:property [ sh:path pf:effect ; sh:minCount 1 ] ;
  sh:property [ sh:path pf:authorityRef ; sh:minCount 1 ] ;
  sh:property [ sh:path pf:cost ; sh:minCount 1 ] ;
  sh:property [ sh:path pf:duration ; sh:minCount 1 ] .

pf:DomainShape a sh:NodeShape ;
  sh:targetClass pf:PlanningDomain ;
  sh:property [ sh:path pf:initialPredicate ; sh:minCount 1 ] ;
  sh:property [ sh:path pf:goalPredicate ; sh:minCount 1 ] .
