@prefix cloc: <https://ggen.dev/ontology/closed-loop-option-capital#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

cloc:Capability a rdfs:Class .
cloc:CompositionEdge a rdfs:Class .
cloc:Realization a rdfs:Class .
cloc:Policy a rdfs:Class .
cloc:ExpansionIntent a rdfs:Class .
cloc:Frontier a rdfs:Class .
cloc:Receipt a rdfs:Class .
cloc:sourceCapability a rdf:Property .
cloc:targetCapability a rdf:Property .
cloc:posterior a rdf:Property .
cloc:expectedDelta a rdf:Property .
cloc:observedDelta a rdf:Property .
cloc:expectedReuse a rdf:Property .
cloc:reversible a rdf:Property .
cloc:cost a rdf:Property .
cloc:latency a rdf:Property .
cloc:uncertainty a rdf:Property .
cloc:missingPrimitive a rdf:Property .
cloc:policyKind a rdf:Property .
cloc:score a rdf:Property .
cloc:budgetShare a rdf:Property .
cloc:authority a rdf:Property .
cloc:actuationPerformed a rdf:Property .
cloc:exactSubject a rdf:Property .
cloc:receiptDigest a rdf:Property .
cloc:standing a rdf:Property .
cloc:current a rdf:Property .
cloc:marketplaceSupport a rdf:Property .

cloc:SELECT a skos:Concept ; skos:prefLabel "SELECT" .
cloc:ExpansionIntent dcterms:type "reversible-exploration-intent" ; odrl:permission [ odrl:action cloc:SELECT ] .
cloc:Policy prov:wasDerivedFrom cloc:Realization .
