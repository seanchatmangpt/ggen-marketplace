import json
from pathlib import Path

p = json.loads(Path('generated/closed-loop-option-capital/portfolio.json').read_text())
assert p['authority'] == 'SELECT'
assert p['actuation_performed'] is False
assert p['policy'] == 'pareto-reversible'
assert isinstance(p['candidates'], list) and p['candidates']
for candidate in p['candidates']:
    assert candidate['edge']
    assert float(candidate['score']) >= 0.0
print('ALIVE closed-loop option-capital qualification')
