{
  "authority": "SELECT",
  "actuation_performed": false,
  "policy": "pareto-reversible",
  "candidates": [
  {% for row in results %}{"edge": "{{ row.edge }}", "score": "{{ row.yield }}", "expected_reuse": "{{ row.reuse }}", "uncertainty": "{{ row.uncertainty }}"}{% if not loop.last %},{% endif %}
  {% endfor %}]
}
