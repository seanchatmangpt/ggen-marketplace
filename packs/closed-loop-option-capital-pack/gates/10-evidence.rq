PREFIX cloc: <https://ggen.dev/ontology/closed-loop-option-capital#>
ASK WHERE {
  FILTER NOT EXISTS {
    ?r a cloc:Realization ; cloc:current true .
    FILTER NOT EXISTS {
      ?r cloc:exactSubject ?subject ; cloc:receiptDigest ?digest ; cloc:standing ?standing .
      FILTER(STRLEN(STR(?subject)) > 0 && STRLEN(STR(?digest)) = 64 && ?standing IN ("ALIVE", "PARTIAL_ALIVE"))
    }
  }
}
