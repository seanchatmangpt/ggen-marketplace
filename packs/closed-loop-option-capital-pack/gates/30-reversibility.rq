PREFIX cloc: <https://ggen.dev/ontology/closed-loop-option-capital#>
ASK WHERE {
  FILTER NOT EXISTS {
    ?edge a cloc:CompositionEdge .
    FILTER NOT EXISTS {
      ?edge cloc:reversible true ; cloc:sourceCapability ?s ; cloc:targetCapability ?t ;
            cloc:posterior ?p ; cloc:expectedDelta ?d ; cloc:expectedReuse ?r ;
            cloc:cost ?c ; cloc:latency ?l ; cloc:uncertainty ?u .
    }
  }
}
