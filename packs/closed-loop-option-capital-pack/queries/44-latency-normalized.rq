PREFIX cloc: <https://ggen.dev/ontology/closed-loop-option-capital#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?edge ?score WHERE {
 ?edge a cloc:CompositionEdge ; cloc:reversible true ; cloc:posterior ?p ; cloc:expectedDelta ?d ; cloc:latency ?l .
 FILTER(xsd:decimal(?l) > 0.0)
 BIND((xsd:decimal(?d) * xsd:decimal(?p)) / xsd:decimal(?l) AS ?score)
}
ORDER BY DESC(?score) ?edge
