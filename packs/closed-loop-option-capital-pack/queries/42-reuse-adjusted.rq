PREFIX cloc: <https://ggen.dev/ontology/closed-loop-option-capital#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?edge ?score WHERE {
 ?edge a cloc:CompositionEdge ; cloc:reversible true ; cloc:posterior ?p ; cloc:expectedDelta ?d ; cloc:expectedReuse ?r .
 BIND(xsd:decimal(?d) * xsd:decimal(?p) * (1.0 + xsd:decimal(?r)) AS ?score)
}
ORDER BY DESC(?score) ?edge
