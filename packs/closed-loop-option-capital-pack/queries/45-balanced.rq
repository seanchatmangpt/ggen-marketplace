PREFIX cloc: <https://ggen.dev/ontology/closed-loop-option-capital#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?edge ?score WHERE {
 ?edge a cloc:CompositionEdge ; cloc:reversible true ; cloc:posterior ?p ; cloc:expectedDelta ?d ; cloc:expectedReuse ?r ; cloc:cost ?c ; cloc:latency ?l ; cloc:uncertainty ?u .
 BIND((xsd:decimal(?d) * (xsd:decimal(?p)+xsd:decimal(?u)) * (1.0+xsd:decimal(?r))) / (1.0+xsd:decimal(?c)+xsd:decimal(?l)) AS ?score)
}
ORDER BY DESC(?score) ?edge
