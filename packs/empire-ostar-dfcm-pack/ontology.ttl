@prefix dfcmostar: <https://chatmangpt.com/ontology/empire-ostar-dfcm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# DfCM extension vocabulary. The original EMPIRE authority-vacuum pack remains
# unchanged; this pack owns only the reversible option-space construction law.
dfcmostar:OptionSpace a rdfs:Class .
dfcmostar:CapabilitySlot a rdfs:Class .
dfcmostar:Disposition a rdfs:Class .

dfcmostar:order a rdf:Property .
dfcmostar:identifier a rdf:Property .
dfcmostar:sourcePack a rdf:Property .
dfcmostar:studyId a rdf:Property .
dfcmostar:capabilityCount a rdf:Property .
dfcmostar:dispositionCount a rdf:Property .
dfcmostar:expectedClosureCount a rdf:Property .
dfcmostar:selectionState a rdf:Property .
dfcmostar:claimCeiling a rdf:Property .
dfcmostar:selectionAuthority a rdf:Property .
dfcmostar:actuationAuthority a rdf:Property .
dfcmostar:constraintAuthority a rdf:Property .
dfcmostar:requiredDisposition a rdf:Property .

dfcmostar:Preserved a dfcmostar:Disposition ; dfcmostar:order 1 ; dfcmostar:identifier "PRESERVED" .
dfcmostar:Subsumed a dfcmostar:Disposition ; dfcmostar:order 2 ; dfcmostar:identifier "SUBSUMED" .
dfcmostar:Replaced a dfcmostar:Disposition ; dfcmostar:order 3 ; dfcmostar:identifier "REPLACED" .
dfcmostar:Archived a dfcmostar:Disposition ; dfcmostar:order 4 ; dfcmostar:identifier "ARCHIVED" .
dfcmostar:Refused a dfcmostar:Disposition ; dfcmostar:order 5 ; dfcmostar:identifier "REFUSED" .

dfcmostar:ostar-empire-001-options a dfcmostar:OptionSpace ;
  dcterms:conformsTo <https://ggen.dev/ontology/dfcm#> ;
  dfcmostar:sourcePack "empire-ostar-reconstitution-pack" ;
  dfcmostar:studyId "OSTAR-EMPIRE-001" ;
  dfcmostar:capabilityCount 6 ;
  dfcmostar:dispositionCount 5 ;
  dfcmostar:expectedClosureCount 1800 ;
  dfcmostar:selectionState "UNSELECTED" ;
  dfcmostar:claimCeiling "SYNTACTIC_CLOSURE_ONLY" ;
  dfcmostar:selectionAuthority false ;
  dfcmostar:actuationAuthority false ;
  dfcmostar:constraintAuthority "PRUNE_ONLY" ;
  dfcmostar:requiredDisposition dfcmostar:Preserved, dfcmostar:Subsumed,
    dfcmostar:Replaced, dfcmostar:Archived, dfcmostar:Refused .

dfcmostar:capability-01 a dfcmostar:CapabilitySlot ; dfcmostar:order 1 ; dfcmostar:identifier "ostar-cli-load" .
dfcmostar:capability-02 a dfcmostar:CapabilitySlot ; dfcmostar:order 2 ; dfcmostar:identifier "ostar-codemanufactory-manufacture" .
dfcmostar:capability-03 a dfcmostar:CapabilitySlot ; dfcmostar:order 3 ; dfcmostar:identifier "ostar-governance-pipeline" .
dfcmostar:capability-04 a dfcmostar:CapabilitySlot ; dfcmostar:order 4 ; dfcmostar:identifier "ostar-dteam-process-intelligence" .
dfcmostar:capability-05 a dfcmostar:CapabilitySlot ; dfcmostar:order 5 ; dfcmostar:identifier "ostar-ggen-projection-contract" .
dfcmostar:capability-06 a dfcmostar:CapabilitySlot ; dfcmostar:order 6 ; dfcmostar:identifier "ontostar-admission-manufacture" .
