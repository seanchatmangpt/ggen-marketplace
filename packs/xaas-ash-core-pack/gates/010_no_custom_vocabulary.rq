PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

# Any row is a violation. Local instances (profile IDs, SHACL shape IDs) are
# allowed; local semantic classes/properties are not.
SELECT ?term ?kind
WHERE {
  VALUES ?kind {
    owl:Class
    rdf:Property
    owl:ObjectProperty
    owl:DatatypeProperty
  }
  ?term a ?kind .
  FILTER(
    STRSTARTS(STR(?term), "urn:xaas:") ||
    STRSTARTS(STR(?term), "https://seanchatmangpt.github.io/xaas") ||
    STRSTARTS(STR(?term), "http://seanchatmangpt.github.io/xaas")
  )
}
ORDER BY STR(?term) STR(?kind)
