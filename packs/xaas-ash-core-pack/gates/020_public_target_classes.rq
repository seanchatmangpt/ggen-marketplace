PREFIX sh: <http://www.w3.org/ns/shacl#>

# Every generated resource must target a non-local public ontology class.
SELECT ?shape ?targetClass
WHERE {
  ?shape a sh:NodeShape ;
         sh:targetClass ?targetClass .
  FILTER(
    !isIRI(?targetClass) ||
    STRSTARTS(STR(?targetClass), "urn:xaas:") ||
    STRSTARTS(STR(?targetClass), "https://seanchatmangpt.github.io/xaas") ||
    STRSTARTS(STR(?targetClass), "http://seanchatmangpt.github.io/xaas")
  )
}
ORDER BY STR(?shape)
