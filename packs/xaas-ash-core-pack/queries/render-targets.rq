PREFIX xar: <https://ggen.io/ontology/xaas-ash-render#>
SELECT ?moduleName ?domainModule ?actionName ?requiredAuthority ?reversible ?standing ?capabilityClass
WHERE {
  ?target a xar:RenderTarget ;
    xar:moduleName ?moduleName ;
    xar:domainModule ?domainModule ;
    xar:actionName ?actionName ;
    xar:requiredAuthority ?requiredAuthority ;
    xar:reversible ?reversible ;
    xar:standing ?standing ;
    xar:capabilityClass ?capabilityClass .
}
ORDER BY ?domainModule ?moduleName
