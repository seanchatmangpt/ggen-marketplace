# xaas-ash-core-pack/ontology.ttl
#
# Bridges ONE real ce:Capability individual (pcc:ApprovalLegalHoldRelease,
# defined in chatman-ecosystem's ontology/platform-console-capabilities.ttl,
# not redefined or copied here -- referenced by its real IRI) to the
# rendering-hint facts templates/resource.ex.tera needs to emit one Ash
# resource module. This is deliberately NOT an owl:equivalentClass
# assertion between ce:Capability and any Ash/fno concept -- per gate 020,
# that equivalence is unproven. xar: (xaas-ash-render) is a narrow bridge
# vocabulary, same discipline azure-terraform-pack's aztf: and
# platform-engineers-handbook-ch02-cluster-pack's pech2: already use for
# tool-specific rendering facts a public ontology doesn't cover.

@prefix xar:  <https://ggen.io/ontology/xaas-ash-render#> .
@prefix pcc:  <https://seanchatmangpt.github.io/chatman-ecosystem/ontology/platform-console-capabilities#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://ggen.io/ontology/xaas-ash-render#> a owl:Ontology ;
  rdfs:label "XaaS Ash render-hint bridge vocabulary" ;
  rdfs:comment "Real rendering facts for one capability -> one Ash.Resource proof. Not an ontology of Ash itself, not an assertion that ce:Capability equals any Ash/fno concept." .

xar:RenderTarget a owl:Class ;
  rdfs:label "A capability individual paired with the module/action-name facts needed to render it as an Ash.Resource" .

xar:renderOf a owl:ObjectProperty ; rdfs:domain xar:RenderTarget ; rdfs:range owl:Thing .
xar:moduleName a owl:DatatypeProperty ; rdfs:domain xar:RenderTarget ; rdfs:range xsd:string .
xar:domainModule a owl:DatatypeProperty ; rdfs:domain xar:RenderTarget ; rdfs:range xsd:string .
xar:actionName a owl:DatatypeProperty ; rdfs:domain xar:RenderTarget ; rdfs:range xsd:string .

xar:LegalHoldReleaseRender a xar:RenderTarget ;
  xar:renderOf pcc:ApprovalLegalHoldRelease ;
  xar:moduleName "LegalHoldRelease" ;
  xar:domainModule "Xaas.Governance" ;
  xar:actionName "release" .
