@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<urn:xaas:profile:ash-togaf>
    a prof:Profile ;
    dcterms:title "XaaS Ash / TOGAF public ontology application profile" ;
    dcterms:description
        "Application-profile identity only. This graph deliberately declares no XaaS classes or properties. TOGAF scopes the architecture work; admitted public RDF/SHACL profiles supply the semantics; ggen projects those semantics into canonical Ash/Igniter generator commands." ;
    dcterms:conformsTo <https://publications.opengroup.org/standards/togaf> ;
    dcterms:source <https://ash.hexdocs.pm/generators.html> ;
    prov:wasDerivedFrom <https://github.com/ash-project/ash/tree/v3.32.0/lib/mix/tasks/gen> .
