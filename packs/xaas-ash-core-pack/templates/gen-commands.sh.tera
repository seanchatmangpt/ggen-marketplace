#!/usr/bin/env bash
set -euo pipefail

# GENERATED BY ggen. DO NOT EDIT.
# Semantic authority: admitted public RDF + SHACL profile.
# Constructor authority: Ash/Igniter generators.
# This script is a disposable construction projection, not ontology truth.

{% if results | length == 0 %}
printf '%s\n' 'REFUSED:NO_ADMITTED_PUBLIC_ASH_RESOURCES' >&2
exit 66
{% else %}
# Base resource is implementation policy, not ontology vocabulary. Generate it
# before any resource because ash.gen.base_resource rewrites existing resources.
mix ash.gen.base_resource Xaas.Resource

{% for row in results %}
{% if row["kind"] == "resource" %}
# {{ row["source"] }}
mix ash.gen.resource "{{ row["module"] }}" --domain "{{ row["domain"] }}" --base Xaas.Resource --uuid-v7-primary-key id --default-actions read --timestamps --ignore-if-exists --conflicts ignore
{% elif row["kind"] == "attribute" %}
# {{ row["source"] }}
mix ash.gen.resource "{{ row["module"] }}" --domain "{{ row["domain"] }}" --base Xaas.Resource --attribute "{{ row["arg"] }}" --conflicts ignore
{% endif %}
{% endfor %}

mix format
mix compile --warnings-as-errors
mix ash.manifest.dump
mix test
{% endif %}
