#!/usr/bin/env bash
# GENERATED by ggen sync from ontology.ttl + queries/render-targets.rq --
# do not hand-edit, regenerate instead. Real mix ash.gen.resource lines,
# one per real ce:Capability individual (see ontology.ttl's xar:RenderTarget
# individuals and their real xar:renderOf pcc: IRI).
#
# v0.3.0 change (source-grounded against ash-project/ash@main:lib/mix/tasks/gen/
# ash.gen.resource.ex, all 804 lines read directly):
#
# 1. --default-actions now includes create,update (not just read) -- per
#    source this generates a REAL accept-list from `public`-flagged
#    attributes (default_accept, ash.gen.resource.ex:167-182,605-622), not a
#    stub. requested_by/approved_by are marked `public` so they're actually
#    acceptable on create/update.
#
# 2. Structural differentiation, not cosmetic: the CLI has no flag to set an
#    attribute's *value* (no --default), only its name/type/modifiers -- so
#    per-capability differentiation has to be structural. The real
#    xar:reversible fact (copied from ce:reversible in
#    platform-console-capabilities.ttl) drives a genuine schema difference:
#    the 9 real irreversible capabilities get an extra
#    verification_required:boolean:required attribute the other 35 don't,
#    matching what the ontology itself asserts about them (e.g.
#    data-destruction.certificate.issue's real fail-closed,
#    verification-gated semantics) instead of producing 44 byte-identical
#    shells regardless of what each capability claims to do.
#
# STILL A SCAFFOLD, NOT A GAP HIDDEN: mix ash.gen.resource has no code path
# for custom action bodies or `policies do` blocks (confirmed absent from its
# entire source) -- authorization and the actual verification/business logic
# remain a separate, explicitly-labeled hand-authoring pass, not something
# this template can or should synthesize from an ontology description string.
set -euo pipefail

echo "=== XaaS Ash resources (ggen-generated): $(date) ==="

{% for row in results %}
mix ash.gen.resource {{ row["domainModule"] }}.{{ row["moduleName"] }} --domain {{ row["domainModule"] }} --default-actions read,create,update --uuid-primary-key id --attribute requested_by:string:required:public --attribute approved_by:string:public{% if row["reversible"] == false %} --attribute verification_required:boolean:required:public{% endif %} --extend ets --yes
{% endfor %}

mix compile
echo "=== Done: $(date) ==="
