#!/usr/bin/env bash
# GENERATED by ggen sync from packages.ttl + queries/package-selection.rq.
#
# Real catalog rendering, not a hand-maintained fixed list -- per the session's
# "80/20 ggen wrapper" architecture: this file is ONE real instantiation of
# whatever a deployment's ontology selects from the full 131-package real
# catalog (packages.ttl). A different deployment's own ggen.toml would render
# a different subset from the same underlying catalog + query, driven by that
# deployment's own real ce:Capability domain facts (a real, disclosed
# follow-up -- domain-affinity facts per package aren't encoded yet, so today
# every catalogStatus="include" package renders here unconditionally).
#
# Packages already reflected in the hand-assembled xaas-ash-build-ecosystem.sh
# are marked as such (xar:alreadyInstalled) and sorted first -- this script is
# NOT yet a drop-in replacement for that file (their install ordering/flags/
# --auth-strategy selections/HAND-EDIT notes encode real judgment this
# catalog-only rendering doesn't have) -- it demonstrates the real catalog
# mechanism and is meant to be diffed against xaas-ash-build-ecosystem.sh,
# not silently substituted for it.
set -euo pipefail

echo "=== XaaS real package catalog (ggen-generated): $(date) ==="
echo "=== {{ results | length }} real packages selected from the 131-entry catalog ==="

{% for row in results %}
{% if row["alreadyInstalled"] == true %}# already in xaas-ash-build-ecosystem.sh -- shown for catalog completeness, not re-installed here{% endif %}
{% if row["alreadyInstalled"] == false %}# real org: {{ row["realOrg"] }}{% if row["orgVerified"] == false %} (not independently re-verified this session){% endif %}{% if row["description"] %} -- {{ row["description"] }}{% endif %}
mix igniter.install {{ row["hexPackage"] }} --yes
{% endif %}
{% endfor %}

echo "=== Done: $(date) ==="
