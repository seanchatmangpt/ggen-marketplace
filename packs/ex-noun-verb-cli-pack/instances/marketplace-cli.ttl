# instances/marketplace-cli.ttl -- the REAL production instance this pack's
# generation layer was built to close the gap for (see errc-tracker.md and
# pack.toml's "Extension 2" section): packages/marketplace-cli's own
# MarketplaceCli.Registry module was hand-written, not generated, per its
# own moduledoc ("hand-written rather than ggen-generated... this
# milestone's job is proving the library against a real consumer, not
# generating this specific registry"). This instance describes that exact
# registry as real ontology facts, so it CAN now be generated.
#
# Facts here are transcribed from the real, hand-written
# packages/marketplace-cli/lib/marketplace_cli/registry.ex (both verb
# entries, verbatim schema/required/doc strings) and from
# lib/mix/tasks/marketplace_cli.{validate,catalog}.ex's real Igniter task
# docstrings (handlerBodyExpr below documents the real delegation each task
# performs via ExNounVerbCli.Dispatcher.dispatch/2 -- not itself rendered
# by any template run against this instance, since only registry.ex.tmpl is
# used here; included for gate 081 compliance and so this instance stays a
# complete, honest description of the real app, not a partial one scoped
# to only what one template consumes).
#
# Generate with (from ~/ggen_igniter):
#   mix run <this pack>/verify/generate.exs -- \
#     <this pack>/instances/marketplace-cli.ttl \
#     <scratch-or-target-dir> \
#     registry.ex.tmpl
#
# Only registry.ex.tmpl is requested -- marketplace-cli already owns a real,
# richer mix.exs (path: deps on ex_noun_verb_cli/ggen_igniter via env-var
# overrides) and a real Inspector.ex implementing validate/catalog, so
# mix.exs.tmpl/config.exs.tmpl/handler_stub.ex.tmpl would either conflict
# with or duplicate real hand-tuned content that is not itself boilerplate.

@prefix nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#> .

nvc:MarketplaceCliProject a nvc:GeneratedCliProject ;
    nvc:appName "marketplace_cli" ;
    nvc:moduleName "MarketplaceCli" ;
    nvc:hasVerb nvc:MarketplaceValidateGeneratedVerb, nvc:MarketplaceCatalogGeneratedVerb .

nvc:MarketplaceValidateGeneratedVerb a nvc:GeneratedVerb ;
    nvc:noun "marketplace" ;
    nvc:verb "validate" ;
    nvc:handlerModule "MarketplaceCli.Inspector" ;
    nvc:handlerFunction "validate" ;
    nvc:verbDescription "Validates every pack under <root>/packs, mirroring scripts/marketplace.py validate." ;
    nvc:handlerBodyExpr "MarketplaceCli.Inspector.validate(root)" ;
    nvc:hasArgument nvc:MarketplaceValidateRootArg .

nvc:MarketplaceValidateRootArg a nvc:GeneratedArgument ;
    nvc:argName "root" ;
    nvc:argType "string" ;
    nvc:argRequired true ;
    nvc:argOrder 0 .

nvc:MarketplaceCatalogGeneratedVerb a nvc:GeneratedVerb ;
    nvc:noun "marketplace" ;
    nvc:verb "catalog" ;
    nvc:handlerModule "MarketplaceCli.Inspector" ;
    nvc:handlerFunction "catalog" ;
    nvc:verbDescription "Emits the marketplace catalog JSON, mirroring scripts/marketplace.py catalog." ;
    nvc:handlerBodyExpr "MarketplaceCli.Inspector.catalog(root)" ;
    nvc:hasArgument nvc:MarketplaceCatalogRootArg .

nvc:MarketplaceCatalogRootArg a nvc:GeneratedArgument ;
    nvc:argName "root" ;
    nvc:argType "string" ;
    nvc:argRequired true ;
    nvc:argOrder 0 .
