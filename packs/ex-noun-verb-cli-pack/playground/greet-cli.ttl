# playground/greet-cli.ttl -- one real, complete `nvc:GeneratedCliProject`
# instance: a tiny two-noun/four-verb Elixir CLI (`greet_cli`), consumed by
# this pack's own templates/*.tmpl and verify/render_check.exs.
#
# Reuses this pack's existing `nvc:` prefix (ontology.ttl's "EXTENSION 2"
# section declares the classes/properties this instance uses). Not merged
# into ontology.ttl itself: per this pack's design, ontology.ttl carries the
# generation SHAPE (classes/properties), and each generatable project is its
# own separate instance file under playground/ -- so a second playground
# instance (a different CLI) can exist side-by-side without editing this one.
#
# Verb bodies (nvc:handlerBodyExpr) are real, honest, playground-authored
# Elixir expressions -- not `todo!()`-style stubs -- so the generated project
# is a genuinely working CLI end-to-end (see README.md's "Real generation
# capability" section for the real render_check.exs proof).
@prefix nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nvc:GreetCliProject a nvc:GeneratedCliProject ;
    nvc:appName "greet_cli" ;
    nvc:moduleName "GreetCli" ;
    nvc:version "0.1.0" ;
    nvc:elixirVersion "~> 1.17" ;
    nvc:exNounVerbCliVersion "~> 26.9" ;
    nvc:description "A tiny greet/math noun-verb CLI, generated by ggen (ex-noun-verb-cli-pack) from this Turtle ontology instance rather than hand-authored." ;
    nvc:hasVerb nvc:GreetHelloVerb, nvc:GreetShoutVerb, nvc:MathAddVerb, nvc:MathMultiplyVerb .

################################################################################
# noun "greet" -- handlerModule "GreetCli.Greet"
################################################################################

nvc:GreetHelloVerb a nvc:GeneratedVerb ;
    nvc:noun "greet" ; nvc:verb "hello" ;
    nvc:handlerModule "GreetCli.Greet" ;
    nvc:handlerFunction "hello" ;
    nvc:verbDescription "Prints a friendly greeting for --name." ;
    nvc:handlerBodyExpr "\"Hello, #{name}!\"" ;
    nvc:hasArgument nvc:GreetHelloNameArg .

nvc:GreetHelloNameArg a nvc:GeneratedArgument ;
    nvc:argName "name" ; nvc:argType "string" ;
    nvc:argRequired true ; nvc:argOrder 0 .

nvc:GreetShoutVerb a nvc:GeneratedVerb ;
    nvc:noun "greet" ; nvc:verb "shout" ;
    nvc:handlerModule "GreetCli.Greet" ;
    nvc:handlerFunction "shout" ;
    nvc:verbDescription "Prints an uppercase, shouted greeting for --name." ;
    nvc:handlerBodyExpr "String.upcase(\"HELLO, #{name}!\")" ;
    nvc:hasArgument nvc:GreetShoutNameArg .

nvc:GreetShoutNameArg a nvc:GeneratedArgument ;
    nvc:argName "name" ; nvc:argType "string" ;
    nvc:argRequired true ; nvc:argOrder 0 .

################################################################################
# noun "math" -- handlerModule "GreetCli.Math"
################################################################################

nvc:MathAddVerb a nvc:GeneratedVerb ;
    nvc:noun "math" ; nvc:verb "add" ;
    nvc:handlerModule "GreetCli.Math" ;
    nvc:handlerFunction "add" ;
    nvc:verbDescription "Adds --x and --y." ;
    nvc:handlerBodyExpr "x + y" ;
    nvc:hasArgument nvc:MathAddXArg, nvc:MathAddYArg .

nvc:MathAddXArg a nvc:GeneratedArgument ;
    nvc:argName "x" ; nvc:argType "integer" ;
    nvc:argRequired true ; nvc:argOrder 0 .

nvc:MathAddYArg a nvc:GeneratedArgument ;
    nvc:argName "y" ; nvc:argType "integer" ;
    nvc:argRequired true ; nvc:argOrder 1 .

nvc:MathMultiplyVerb a nvc:GeneratedVerb ;
    nvc:noun "math" ; nvc:verb "multiply" ;
    nvc:handlerModule "GreetCli.Math" ;
    nvc:handlerFunction "multiply" ;
    nvc:verbDescription "Multiplies --x and --y." ;
    nvc:handlerBodyExpr "x * y" ;
    nvc:hasArgument nvc:MathMultiplyXArg, nvc:MathMultiplyYArg .

nvc:MathMultiplyXArg a nvc:GeneratedArgument ;
    nvc:argName "x" ; nvc:argType "integer" ;
    nvc:argRequired true ; nvc:argOrder 0 .

nvc:MathMultiplyYArg a nvc:GeneratedArgument ;
    nvc:argName "y" ; nvc:argType "integer" ;
    nvc:argRequired true ; nvc:argOrder 1 .
