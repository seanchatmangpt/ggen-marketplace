nvc:GgenTemplateCommandsExample a nvc:ExampleProgram ;
    rdfs:label "ggen/template_commands.rs" ;
    nvc:filePath "examples/ggen/template_commands.rs" ;
    nvc:demonstratesVerb nvc:TemplateGenerateVerb ;
    rdfs:comment "~/clap-noun-verb/examples/ggen/template_commands.rs: a real ggen-CLI-shaped example. Registers #[verb(\"generate\", \"template\")] (also \"render\"/\"validate\"/\"list\") -- the same Vec<String>-argument shape probed independently by vec_multi_value_probe.rs (verified real, line 276)." .

nvc:GeneratedFromTurtleCalculatorExample a nvc:ExampleProgram ;
    rdfs:label "generated-from-turtle/calculator-cli.rs" ;
    nvc:filePath "examples/generated-from-turtle/calculator-cli.rs" ;
    nvc:demonstratesVerb nvc:CalcAddVerb ;
