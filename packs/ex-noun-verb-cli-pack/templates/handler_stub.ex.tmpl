---
to: lib/{{ project[0].app_name }}/{% if noun_mod is defined %}{{ noun_mod.noun_snake }}{% else %}{{ row.noun | replace(from="-", to="_") | lower }}{% endif %}.ex
unless_exists: true
for_each: nouns
sparql:
  nouns: |
    PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>
    SELECT DISTINCT ?noun WHERE {
      ?p a nvc:GeneratedCliProject ; nvc:hasVerb ?v .
      ?v a nvc:GeneratedVerb ; nvc:noun ?noun .
    }
    ORDER BY ?noun
  project: |
    PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>
    SELECT ?app_name ?module_name WHERE {
      ?p a nvc:GeneratedCliProject ; nvc:appName ?app_name ; nvc:moduleName ?module_name .
    }
  verbs: |
    PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>
    SELECT ?noun ?verb ?handler_function ?verb_description ?body_expr WHERE {
      ?p a nvc:GeneratedCliProject ; nvc:hasVerb ?v .
      ?v a nvc:GeneratedVerb ; nvc:noun ?noun ; nvc:verb ?verb ;
         nvc:handlerFunction ?handler_function ; nvc:verbDescription ?verb_description ;
         nvc:handlerBodyExpr ?body_expr .
    }
    ORDER BY ?noun ?verb
  args: |
    PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>
    SELECT ?noun ?verb ?arg_name ?arg_order WHERE {
      ?p a nvc:GeneratedCliProject ; nvc:hasVerb ?v .
      ?v a nvc:GeneratedVerb ; nvc:noun ?noun ; nvc:verb ?verb ; nvc:hasArgument ?a .
      ?a nvc:argName ?arg_name ; nvc:argOrder ?arg_order .
    }
    ORDER BY ?noun ?verb ?arg_order
---
defmodule {% if noun_mod is defined %}{% set_global noun = noun_mod.noun %}{% set_global noun_pascal = noun_mod.noun_pascal %}{% else %}{% set_global noun = row.noun %}{% set_global noun_pascal = row.noun | capitalize %}{% endif %}{{ project[0].module_name }}.{{ noun_pascal }} do
  @moduledoc """
  Real handler functions for the `{{ noun }}` noun, generated once by
  ggen (ex-noun-verb-cli-pack) from `nvc:handlerBodyExpr` playground facts.
  `unless_exists: true` in this template's frontmatter -- like
  clap-noun-verb-crate-pack's `custom_handlers.rs.tmpl` -- means this file is
  scaffolding: a later `ggen sync` re-run never overwrites hand-edits made
  here.
  """

{% for v in verbs %}{% if v.noun == noun %}{% if v.params_str is defined %}{% set_global params = v.params_str %}{% set_global body_expr = v.body_str %}{% else %}{% set_global params = "" %}{% set_global sep = "" %}{% for a in args %}{% if a.noun == v.noun and a.verb == v.verb %}{% set_global params = params ~ sep ~ a.arg_name %}{% set_global sep = ", " %}{% endif %}{% endfor %}{% set_global body_expr = v.body_expr %}{% endif %}  @doc "{{ v.verb_description }}"
  def {{ v.handler_function }}({{ params }}), do: {{ body_expr }}

{% endif %}{% endfor %}end
