---
to: lib/{{ project[0].app_name }}/registry.ex
sparql:
  project: |
    PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>
    SELECT ?app_name ?module_name WHERE {
      ?p a nvc:GeneratedCliProject ; nvc:appName ?app_name ; nvc:moduleName ?module_name .
    }
  verbs: |
    PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>
    SELECT ?noun ?verb ?handler_module ?handler_function ?verb_description WHERE {
      ?p a nvc:GeneratedCliProject ; nvc:hasVerb ?v .
      ?v a nvc:GeneratedVerb ;
         nvc:noun ?noun ; nvc:verb ?verb ;
         nvc:handlerModule ?handler_module ;
         nvc:handlerFunction ?handler_function ;
         nvc:verbDescription ?verb_description .
    }
    ORDER BY ?noun ?verb
  args: |
    PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>
    SELECT ?noun ?verb ?arg_name ?arg_type ?arg_required ?arg_order WHERE {
      ?p a nvc:GeneratedCliProject ; nvc:hasVerb ?v .
      ?v a nvc:GeneratedVerb ; nvc:noun ?noun ; nvc:verb ?verb ; nvc:hasArgument ?a .
      ?a nvc:argName ?arg_name ; nvc:argType ?arg_type ;
         nvc:argRequired ?arg_required ; nvc:argOrder ?arg_order .
    }
    ORDER BY ?noun ?verb ?arg_order
---
defmodule {{ project[0].module_name }}.Registry do
  @moduledoc """
  Generated by ggen (ex-noun-verb-cli-pack) from a `nvc:GeneratedCliProject`
  Turtle instance -- every entry below is `ExNounVerbCli.Registry.Generated`'s
  real `verbs:` shape (noun/verb/module/function/info/doc), so this module
  satisfies the `ExNounVerbCli.Registry` behaviour with zero hand-written
  dispatch code.
  """

  use ExNounVerbCli.Registry.Generated,
    verbs: [
{% for v in verbs %}      [
        noun: "{{ v.noun }}",
        verb: "{{ v.verb }}",
        module: {{ v.handler_module }},
        function: :{{ v.handler_function }},
        info: %{schema: [{{ v.schema_str }}], required: [{{ v.required_str }}]},
        doc: "{{ v.verb_description }}"
      ]{% if not loop.last %},
{% endif %}
{% endfor %}    ]
end
