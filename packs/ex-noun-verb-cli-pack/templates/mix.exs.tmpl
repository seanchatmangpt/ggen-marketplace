---
to: mix.exs
sparql:
  project: |
    PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>
    SELECT ?app_name ?module_name ?version ?elixir_version ?cli_version WHERE {
      ?p a nvc:GeneratedCliProject ;
         nvc:appName ?app_name ;
         nvc:moduleName ?module_name ;
         nvc:version ?version ;
         nvc:elixirVersion ?elixir_version ;
         nvc:exNounVerbCliVersion ?cli_version .
    }
---
defmodule {{ project[0].module_name }}.MixProject do
  use Mix.Project

  def project do
    [
      app: :{{ project[0].app_name }},
      version: "{{ project[0].version }}",
      elixir: "{{ project[0].elixir_version }}",
      start_permanent: Mix.env() == :prod,
      deps: deps(),
      escript: escript()
    ]
  end

  def application do
    [
      extra_applications: [:logger]
    ]
  end

  defp deps do
    [
      {:ex_noun_verb_cli, "{{ project[0].cli_version }}"}
    ]
  end

  defp escript do
    [main_module: ExNounVerbCli.Escript]
  end
end
