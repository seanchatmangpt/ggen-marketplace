PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

# Real consumer of nvc:CliVerb / nvc:noun / nvc:verb / nvc:belongsTo.
#
# This pack has no Tera templates (its deliverable is the hand-built Elixir
# consumer at packages/marketplace-cli/, not generated code -- see pack.toml),
# so a SPARQL query is this pack's real generation-adjacent consumer for
# these facts, the same role a .tmpl file plays for a templated pack: it is
# executed for real by packages/marketplace-cli's own test suite
# (test/marketplace_cli/cli_verbs_query_test.exs) against this ontology.ttl,
# asserting the noun/verb pairs it returns match the app's real dispatch
# table (mix marketplace_cli.validate / mix marketplace_cli.catalog).
SELECT ?noun ?verb ?app WHERE {
    ?verbNode a nvc:CliVerb ;
        nvc:noun ?noun ;
        nvc:verb ?verb ;
        nvc:belongsTo ?app .
}
ORDER BY ?verb
