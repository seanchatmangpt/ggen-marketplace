PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

# Real consumer of nvc:demonstratesVerb.
#
# Reports every real ExampleProgram -> CliVerb link. Designed to back a real
# ExUnit test asserting the row (nvc:CoreApiExample, nvc:ServicesStatusVerb)
# is present (examples/core_api.rs really does register noun "services"
# verb "status" -- verified at extension time).
SELECT ?example ?verb WHERE {
    ?example nvc:demonstratesVerb ?verb .
}
ORDER BY ?example ?verb
