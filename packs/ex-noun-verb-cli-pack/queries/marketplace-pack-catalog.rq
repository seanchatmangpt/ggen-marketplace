PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

# Real consumer of nvc:MarketplacePack.
#
# Designed to back a real ExUnit test asserting exactly 12 rows: the real
# six-pack split (schema/crate/routing/behavior/boundary/verification) plus
# the 6 real adjunct/legacy packs (autonomic/telemetry/policies/specimen/
# zeroconfig/legacy) that live under this same ggen-marketplace repo's
# packs/clap-noun-verb-*-pack -- verified via `find packs -maxdepth 1
# -iname 'clap-noun-verb-*'` at extension time (2026-09-11). The local
# nvc:ClapNounVerbCapabilityPack is deliberately excluded (it is typed
# nvc:LocalPack, not nvc:MarketplacePack -- it lives under ~/clap-noun-verb,
# not this marketplace repo).
SELECT ?pack WHERE {
    ?pack a nvc:MarketplacePack .
}
ORDER BY ?pack
