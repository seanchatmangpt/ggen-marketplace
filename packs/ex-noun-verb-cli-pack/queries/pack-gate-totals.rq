PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

# Real consumer of nvc:packHasGateCount, across both nvc:LocalPack and
# nvc:MarketplacePack individuals.
#
# Designed to back a real ExUnit test asserting ?total == 26: 16 (schema) +
# 2 (autonomic) + 2 (telemetry) + 2 (policies) + 3 (legacy clap-noun-verb-pack)
# + 1 (the local clap-noun-verb-capability-pack) = 26; every other pack
# (crate/routing/behavior/boundary/verification/specimen/zeroconfig)
# contributes 0 -- all counts verified via `find gates -iname '*.rq' | wc -l`
# at extension time (2026-09-11).
SELECT (SUM(?g) AS ?total) WHERE {
    { ?pack a nvc:LocalPack } UNION { ?pack a nvc:MarketplacePack }
    ?pack nvc:packHasGateCount ?g .
}
