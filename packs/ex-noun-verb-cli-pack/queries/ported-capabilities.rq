PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

# Real consumer of nvc:PortedCapability / nvc:hasCitation / nvc:filePath /
# nvc:lineRange.
#
# Every nvc:PortedCapability carries exactly one nvc:hasCitation (see
# ontology.ttl's nvc:Citation class comment), so this query returns exactly
# one row per PortedCapability -- 10 rows total. Designed to back a real
# ExUnit test asserting the exact row count and that
# (nvc:DispatchCapability, "lib/ex_noun_verb_cli/dispatcher.ex", "44-155")
# is among them.
SELECT ?cap ?file ?lines WHERE {
    ?cap a nvc:PortedCapability ;
        nvc:hasCitation ?citation .
    ?citation nvc:filePath ?file ;
        nvc:lineRange ?lines .
}
ORDER BY ?cap
