PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

# Real consumer of nvc:DeferredCapability / nvc:hasCitation / nvc:specSection.
#
# Every nvc:DeferredCapability carries exactly one nvc:hasCitation, so this
# query returns exactly one row per DeferredCapability -- 8 rows total.
# Designed to back a real ExUnit test asserting the exact row count and that
# nvc:StepRefCapability's ?section contains the substring "chaining.ex:22-34"
# (e.g. FILTER(CONTAINS(?section, "chaining.ex:22-34")) over the row where
# ?cap = nvc:StepRefCapability).
SELECT ?cap ?section WHERE {
    ?cap a nvc:DeferredCapability ;
        nvc:hasCitation ?citation .
    ?citation nvc:specSection ?section .
}
ORDER BY ?cap
