PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

# Real consumer of the closed nvc:PortedCapability / nvc:DeferredCapability
# dichotomy this pack's gates/060_no_orphan_capability.rq enforces.
#
# Designed to back a real ExUnit test asserting ?ported == 10 and
# ?deferred == 8 -- the real 10 PortedCapability and 8 DeferredCapability
# individuals enumerated in ontology.ttl.
SELECT (COUNT(?p) AS ?ported) (COUNT(?d) AS ?deferred) WHERE {
    { ?p a nvc:PortedCapability } UNION { ?d a nvc:DeferredCapability }
}
