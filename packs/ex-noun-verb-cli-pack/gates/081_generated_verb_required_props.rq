# MESSAGE: every nvc:GeneratedVerb must carry nvc:noun, nvc:verb,
# nvc:handlerModule, nvc:handlerFunction, and nvc:handlerBodyExpr -- these are
# exactly the facts templates/registry.ex.tmpl and templates/handler_stub.ex.tmpl
# need to emit a real ExNounVerbCli.Registry.Generated entry and a real,
# non-stub handler function (mirrors ExNounVerbCli.Verb.new/1's own
# @enforce_keys [:noun, :verb, :module, :function], lib/ex_noun_verb_cli/verb.ex:26,
# plus this pack's own handlerBodyExpr requirement). ASK true means violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK WHERE {
  ?v a nvc:GeneratedVerb .
  {
    FILTER NOT EXISTS { ?v nvc:noun ?x1 }
  } UNION {
    FILTER NOT EXISTS { ?v nvc:verb ?x2 }
  } UNION {
    FILTER NOT EXISTS { ?v nvc:handlerModule ?x3 }
  } UNION {
    FILTER NOT EXISTS { ?v nvc:handlerFunction ?x4 }
  } UNION {
    FILTER NOT EXISTS { ?v nvc:handlerBodyExpr ?x5 }
  }
}
