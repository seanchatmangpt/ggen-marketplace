# MESSAGE: every nvc:LocalPack/nvc:MarketplacePack must carry a present,
# non-negative nvc:packHasGateCount -- structural completeness of pack
# metadata (a pack whose real gate count was never actually counted is not
# distinguishable from one whose count is simply wrong). ASK true means
# violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK WHERE {
  { ?pack a nvc:LocalPack } UNION { ?pack a nvc:MarketplacePack }
  {
    FILTER NOT EXISTS { ?pack nvc:packHasGateCount ?count }
  } UNION {
    ?pack nvc:packHasGateCount ?count .
    FILTER (?count < 0)
  }
}
