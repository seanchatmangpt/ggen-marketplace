# MESSAGE: no two nvc:GeneratedVerb individuals may share the same
# (nvc:noun, nvc:verb) pair -- ExNounVerbCli.Dispatcher.find_verb/3
# (lib/ex_noun_verb_cli/dispatcher.ex:69-71) does `Enum.find/2`, which
# silently returns only the FIRST matching verb, so a duplicate pair is a
# silently-shadowed command, not a compile error. ASK true means violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK WHERE {
  ?v1 a nvc:GeneratedVerb ; nvc:noun ?n ; nvc:verb ?vb .
  ?v2 a nvc:GeneratedVerb ; nvc:noun ?n ; nvc:verb ?vb .
  FILTER (?v1 != ?v2)
}
