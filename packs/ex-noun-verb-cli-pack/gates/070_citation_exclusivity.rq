# MESSAGE: a nvc:Citation must carry exactly one evidence shape -- either
# nvc:filePath (+ nvc:lineRange, for a PortedCapability) or nvc:specSection
# (for a DeferredCapability), never both. Blurring the two evidence types
# would let a "deferred" claim quietly borrow a "ported" claim's file
# citation (or vice versa). ASK true means violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK WHERE {
  ?citation a nvc:Citation ;
    nvc:filePath ?file ;
    nvc:specSection ?section .
}
