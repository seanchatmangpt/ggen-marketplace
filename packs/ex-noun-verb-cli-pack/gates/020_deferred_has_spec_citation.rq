# MESSAGE: every nvc:DeferredCapability must carry a Citation with
# nvc:specSection -- a "deferred" claim with no real spec-section or
# in-code-TODO evidence (or explicitly verified absence note) is refused.
# ASK true means violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK WHERE {
  ?cap a nvc:DeferredCapability .
  FILTER NOT EXISTS {
    ?cap nvc:hasCitation ?citation .
    ?citation nvc:specSection ?section .
  }
}
