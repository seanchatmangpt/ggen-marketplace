# MESSAGE: every nvc:CliVerb must carry a real nvc:filePath -- a verb with no
# traceable source file is an invented capability, not an observed one.
# ASK true means violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK WHERE {
  ?verb a nvc:CliVerb .
  FILTER NOT EXISTS { ?verb nvc:filePath ?file }
}
