# MESSAGE: every nvc:ExampleProgram must demonstrate at least one nvc:CliVerb
# OR cite the nvc:Capability it exercises (the library-API-only allowance,
# e.g. examples/capability_registry.rs, which registers no noun/verb macro
# at all). An example doing neither is decoration, not evidence, and is
# refused. ASK true means violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK WHERE {
  ?example a nvc:ExampleProgram .
  FILTER NOT EXISTS { ?example nvc:demonstratesVerb ?verb }
  FILTER NOT EXISTS { ?example nvc:relatedCapability ?cap }
}
