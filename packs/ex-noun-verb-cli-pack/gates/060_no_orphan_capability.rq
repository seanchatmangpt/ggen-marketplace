# MESSAGE: every nvc:Capability individual must be typed as exactly one of
# its two leaf subclasses (nvc:PortedCapability, nvc:DeferredCapability) --
# a bare nvc:Capability with neither is an unclassified orphan (the closed
# PORTED/DEFERRED dichotomy this pack's whole graph depends on). ASK true
# means violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK WHERE {
  ?cap a nvc:Capability .
  FILTER NOT EXISTS { ?cap a nvc:PortedCapability }
  FILTER NOT EXISTS { ?cap a nvc:DeferredCapability }
}
