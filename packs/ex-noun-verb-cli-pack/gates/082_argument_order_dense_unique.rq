# MESSAGE: within one nvc:GeneratedVerb, no two nvc:GeneratedArgument
# individuals may share the same nvc:argOrder -- a duplicate order value would
# make the generated handler function's parameter order and the
# schema/required keyword-list order silently disagree (Tera has no
# arithmetic sort-guard of its own; this gate is the real check).
# ASK true means violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK WHERE {
  ?v a nvc:GeneratedVerb ; nvc:hasArgument ?a1, ?a2 .
  ?a1 nvc:argOrder ?order .
  ?a2 nvc:argOrder ?order .
  FILTER (?a1 != ?a2)
}
