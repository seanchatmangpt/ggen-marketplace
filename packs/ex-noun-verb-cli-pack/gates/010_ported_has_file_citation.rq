# MESSAGE: every nvc:PortedCapability must carry a Citation with both
# nvc:filePath and nvc:lineRange -- a "ported" claim with no real file:line
# evidence is refused. ASK true means violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK WHERE {
  ?cap a nvc:PortedCapability .
  FILTER NOT EXISTS {
    ?cap nvc:hasCitation ?citation .
    ?citation nvc:filePath ?file .
    ?citation nvc:lineRange ?lines .
  }
}
