# MESSAGE: exactly one nvc:GeneratedCliProject per graph -- this pack's
# generation templates all assume a single root project (project[0].* dot
# access, no per-project disambiguation). Renumbered from the design's
# suggested "070_..." to 080 to avoid colliding with this pack's own
# pre-existing gates/070_citation_exclusivity.rq. ASK true means violation.
PREFIX nvc: <https://ggen.dev/marketplace/ex-noun-verb-cli-pack#>

ASK {
  { SELECT (COUNT(DISTINCT ?p) AS ?n) WHERE { ?p a nvc:GeneratedCliProject } }
  FILTER (?n != 1)
}
