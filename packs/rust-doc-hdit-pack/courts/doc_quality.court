# doc_quality.court — documented gate thresholds for the doc-quality court.
#
# STATUS: DOCUMENTED THRESHOLDS ONLY. Executable enforcement lands with the
# rust-doc-hdit binary (doc-hdit:audit / doc-hdit:certify); until then these
# values are the admission contract every implementation must satisfy. Do not
# relax a threshold here without a court receipt showing the old value failing.
#
# Gates (evaluated by doc-hdit:audit over the rendered doc surface vs the
# code surface loaded from ontology.ttl):
#
#   S_coverage  >= 0.90   fraction of the PUBLIC code surface covered by
#                         documentation (P2 scope fix landed: extractor marks
#                         items public vs internal — exported/pub/@doc'd/
#                         delegated — and doc-hdit computes coverage over the
#                         public surface only; the full-surface value is kept
#                         as S_coverage_raw, report-only. DOC-HDIT-PILOT P2).
#   Phi_halluc  <= 0.001  fraction of doc:Claim rows whose value mentions no
#                         matching code-surface symbol (exact-match over the
#                         code-surface token set). References to documented
#                         external dependencies (known_external prefixes from
#                         mix.exs deps + Cargo.toml [dependencies], e.g. `Ash.`,
#                         `serde_json::`) are classified external_documented,
#                         excluded from Phi, and reported as a count — the
#                         documented-deps allowance made explicit and
#                         enforceable, not a threshold relaxation.
#   Q_density   >= 0.65   grounded-claim fraction: (grounded +
#                         external_documented) / total claims.
[gates]
S_coverage_min = 0.90
Phi_halluc_max = 0.001
Q_density_min = 0.65

# On pass of all three gates, doc-hdit:certify seals the document set with a
# BLAKE3 receipt (via affidavit): digest of the rendered docs plus the exact
# code-surface store fingerprint. On any gate failure, certification is
# REFUSED and no receipt is minted.
[certify]
receipt = "BLAKE3"
via = "affidavit"
on_fail = "REFUSED"
