PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?term ?type ?comment WHERE {
  ?term a ?type .
  FILTER(?type IN (rdfs:Class, rdf:Property))
  FILTER(STRSTARTS(STR(?term), "https://ggen.dev/ontology/doc-hdit/"))
  OPTIONAL { ?term rdfs:comment ?comment }
} ORDER BY ?term
