# ast_extract.rq — join modules -> items -> signatures, with errors and invariants.
# Run against the oxigraph store loaded with ontology.ttl plus the extracted
# code-surface facts. Every rendered reference row comes from one solution here.
PREFIX dhs: <https://ggen.dev/ontology/doc-hdit/code-surface#>

SELECT ?module ?item ?itemType ?signature ?params ?defaults ?errors ?invariants
WHERE {
  ?module a dhs:Module .
  ?item a dhs:Verb ;
        dhs:signature ?signature ;
        dhs:params ?params .
  ?module dhs:contains ?item .
  OPTIONAL { ?item a ?itemType . FILTER(?itemType IN (dhs:Function, dhs:Struct, dhs:Enum, dhs:Resource, dhs:Action)) }
  OPTIONAL { ?item dhs:defaults ?defaults . }
  OPTIONAL { ?item dhs:errors ?errors . }
  OPTIONAL { ?item dhs:invariants ?invariants . }
}
ORDER BY ?module ?item
