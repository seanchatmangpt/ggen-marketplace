PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX valve: <https://strata.chatman.ai/ontology/valve#>

SELECT ?label ?module ?comment ?receiptLen
WHERE {
  ?c a valve:RefusalClass ;
     rdfs:label ?label ;
     valve:module ?module ;
     rdfs:comment ?comment .
  ?f a valve:WireFact ;
     rdfs:label "refusal_receipt_len" ;
     valve:length ?receiptLen .
}
ORDER BY ?label
