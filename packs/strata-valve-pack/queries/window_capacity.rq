# Projection query: window-capacity refusal const table rows (L86).
# One row per WindowCapacityRefusal individual, ordered for byte-identical
# regeneration. Rows carry (class IRI, refusal atom, capacity, source module);
# the Chatman constant k is projected as the shared CAPACITY constant.
PREFIX valve: <https://strata.chatman.ai/ontology/valve#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?class ?label ?atom ?capacity ?module ?chatmanK
WHERE {
  ?c a valve:WindowCapacityRefusal ;
     rdfs:label ?label ;
     valve:atom ?atom ;
     valve:capacityConstant ?capacity ;
     valve:sourceModule ?module .
  ?k a valve:CapacityConstant ;
     valve:capacityConstant ?chatmanK .
}
ORDER BY ?label
