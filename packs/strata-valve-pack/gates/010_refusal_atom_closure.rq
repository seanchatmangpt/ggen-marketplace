# MESSAGE: valve refusal atoms are exactly {malformed_frame, fuel_exhausted, parent_discontinuity, arena_failure}.
# Any row returned indicates a valve:RefusalClass whose valve:atom is off-enum
# or missing — fail closed on the refusal taxonomy closure.
PREFIX valve: <https://strata.chatman.ai/ontology/valve#>

SELECT ?class ?atom ?violation WHERE {
  {
    ?class a valve:RefusalClass .
    BIND("missing_atom" AS ?violation)
    FILTER NOT EXISTS { ?class valve:atom ?a }
  } UNION {
    ?class a valve:RefusalClass ;
           valve:atom ?atom .
    BIND("off_enum_atom" AS ?violation)
    FILTER (?atom NOT IN ("malformed_frame", "fuel_exhausted", "parent_discontinuity", "arena_failure"))
  }
}
ORDER BY ?class ?violation
