  Strata valve refusal taxonomy. Ground truth: strata_protocol/src/refusal.rs —
  constant-time refusal, fixed opaque 32-byte receipt, no cause channel on the wire.
  """

{% for row in results %}{% if loop.first %}{% set_global receipt_len = row.receiptLen %}{% endif %}{% endfor %}
  @receipt_len {{ receipt_len }}

  @doc "Fixed wire length of the opaque refusal receipt (bytes)."
  @spec receipt_len :: pos_integer()
  def receipt_len, do: @receipt_len

