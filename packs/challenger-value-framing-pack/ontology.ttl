@prefix cv: <https://chatmangpt.com/ontology/challenger-value#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

cv:Phase a rdfs:Class .
cv:BuyerProjection a rdfs:Class .
cv:EvidenceKind a rdfs:Class .
cv:AuthorityCeiling a rdfs:Class .
cv:ERRCAction a rdfs:Class .
cv:InnovationFactor a rdfs:Class .
cv:InnovationExperiment a rdfs:Class .
cv:order a rdf:Property .
cv:allowedKind a rdf:Property .
cv:tension a rdf:Property .
cv:diagnostic a rdf:Property .
cv:authorityCeiling a rdf:Property .
cv:requiresExactSubject a rdf:Property .
cv:requiresSource a rdf:Property .
cv:requiresExperiment a rdf:Property .
cv:requiresFalsifier a rdf:Property .
cv:actuation a rdf:Property .
cv:irreversibleSelections a rdf:Property .
cv:action a rdf:Property .
cv:rationale a rdf:Property .
cv:falsifier a rdf:Property .
cv:evidenceKind a rdf:Property .
cv:source a rdf:Property .
cv:score a rdf:Property .
cv:experiment a rdf:Property .

cv:OBSERVED a cv:EvidenceKind ; skos:prefLabel "OBSERVED" .
cv:VERIFIED a cv:EvidenceKind ; skos:prefLabel "VERIFIED" .
cv:INFERRED a cv:EvidenceKind ; skos:prefLabel "INFERRED" .
cv:HYPOTHESIS a cv:EvidenceKind ; skos:prefLabel "HYPOTHESIS" .

cv:TEACH a cv:Phase ; cv:order 1 ; dcterms:identifier "TEACH" ; dcterms:description "Lead with admitted evidence that changes the buyer's view of the problem." ; cv:allowedKind "OBSERVED|VERIFIED" .
cv:REFRAME a cv:Phase ; cv:order 2 ; dcterms:identifier "REFRAME" ; dcterms:description "Project a buyer-relevant interpretation without presenting inference as observation." ; cv:allowedKind "INFERRED|HYPOTHESIS|VERIFIED" .
cv:RATIONAL_IMPACT a cv:Phase ; cv:order 3 ; dcterms:identifier "RATIONAL_IMPACT" ; dcterms:description "State economic or organizational consequence as evidence when verified, otherwise explicitly as hypothesis." ; cv:allowedKind "HYPOTHESIS|VERIFIED" .
cv:NEW_WAY a cv:Phase ; cv:order 4 ; dcterms:identifier "NEW_WAY" ; dcterms:description "Describe the alternative operating model without claiming adoption or outcome." ; cv:allowedKind "OBSERVED|VERIFIED|INFERRED" .
cv:PROOF a cv:Phase ; cv:order 5 ; dcterms:identifier "PROOF" ; dcterms:description "Use only verified evidence bound to an exact subject and source." ; cv:allowedKind "VERIFIED" ; cv:requiresExactSubject true ; cv:requiresSource true .
cv:TAKE_CONTROL a cv:Phase ; cv:order 6 ; dcterms:identifier "TAKE_CONTROL" ; dcterms:description "End with a diagnostic question or bounded next-step intent; never direct consequential actuation." ; cv:allowedKind "INFERRED" ; cv:actuation false .

cv:ELIMINATE a cv:ERRCAction ; cv:order 1 ; skos:prefLabel "Eliminate" ; dcterms:description "Remove factors whose cost, coordination, risk, or semantic duplication should disappear." ; cv:actuation false .
cv:REDUCE a cv:ERRCAction ; cv:order 2 ; skos:prefLabel "Reduce" ; dcterms:description "Lower factors below inherited industry or architecture norms while preserving lawful alternatives." ; cv:actuation false .
cv:RAISE a cv:ERRCAction ; cv:order 3 ; skos:prefLabel "Raise" ; dcterms:description "Increase factors where evidence, assurance, interoperability, or customer value should exceed the baseline." ; cv:actuation false .
cv:CREATE a cv:ERRCAction ; cv:order 4 ; skos:prefLabel "Create" ; dcterms:description "Introduce a new value factor as an experimentable hypothesis with a falsifier before irreversible adoption." ; cv:requiresExperiment true ; cv:requiresFalsifier true ; cv:actuation false .

cv:CIO_CTO a cv:BuyerProjection ; dcterms:identifier "cio-cto" ; cv:tension "AI production capacity can outrun governance and integration capacity." ; cv:diagnostic "Can you trace one AI-generated production change from exact input through independent acceptance evidence and replay?" .
cv:CISO a cv:BuyerProjection ; dcterms:identifier "ciso" ; cv:tension "An agent that can alter both implementation and acceptance conditions can manufacture apparent compliance." ; cv:diagnostic "Which controls are mechanically outside your agents' authority to change?" .
cv:CFO a cv:BuyerProjection ; dcterms:identifier "cfo" ; cv:tension "Generation savings can be displaced into downstream verification, coordination, and remediation work." ; cv:diagnostic "Can you separate AI construction savings from the human verification cost created downstream?" .
cv:PLATFORM a cv:BuyerProjection ; dcterms:identifier "platform" ; cv:tension "More templates do not solve semantic drift when invariants are not executable." ; cv:diagnostic "Which platform invariants are generated from canonical semantics rather than synchronized by hand?" .
cv:FORTUNE5_BUYER a cv:BuyerProjection ; dcterms:identifier "fortune5-buyer" ; cv:tension "The larger opportunity is eliminating categories of coordination work while retaining evidence and authority boundaries." ; cv:diagnostic "Which coordination steps could disappear if constraints, evidence, and handoffs were executable?" .
cv:HIRING_MANAGER a cv:BuyerProjection ; dcterms:identifier "hiring-manager" ; cv:tension "Machine-speed construction shifts value from typing throughput toward governing verified production." ; cv:diagnostic "How do you evaluate engineers who operate software factories rather than manually author every artifact?" .

cv:PresentationOnly a cv:AuthorityCeiling ; skos:prefLabel "SELECT/CONSTRUCT only" ; cv:actuation false ; cv:irreversibleSelections 0 .
cv:ChallengerProjectionPolicy cv:authorityCeiling cv:PresentationOnly ; odrl:prohibition cv:UnsupportedClaim, cv:ProofWithoutExactSubject, cv:MetricWithoutSource, cv:AliveWithoutStanding, cv:OutcomePresentedAsFact, cv:DirectActuation, cv:ERRCActuation, cv:CreateWithoutExperiment, cv:CreateWithoutFalsifier .

cv:ERRCActionShape a sh:NodeShape ; sh:targetClass cv:ERRCAction ; sh:property [ sh:path cv:actuation ; sh:hasValue false ] .
cv:CreateShape a sh:NodeShape ; sh:targetNode cv:CREATE ; sh:property [ sh:path cv:requiresExperiment ; sh:hasValue true ] ; sh:property [ sh:path cv:requiresFalsifier ; sh:hasValue true ] .
