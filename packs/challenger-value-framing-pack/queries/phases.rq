PREFIX cv: <https://chatmangpt.com/ontology/challenger-value#>
PREFIX dcterms: <http://purl.org/dc/terms/>
SELECT ?order ?phase ?description ?allowedKind
WHERE {
  ?p a cv:Phase ;
     cv:order ?order ;
     dcterms:identifier ?phase ;
     dcterms:description ?description ;
     cv:allowedKind ?allowedKind .
}
ORDER BY ?order
