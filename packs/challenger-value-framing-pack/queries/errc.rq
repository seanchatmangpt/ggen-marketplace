PREFIX cv: <https://chatmangpt.com/ontology/challenger-value#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?order ?action ?label ?description ?requiresExperiment ?requiresFalsifier
WHERE {
  ?a a cv:ERRCAction ; cv:order ?order ; skos:prefLabel ?label ; dcterms:description ?description .
  BIND(REPLACE(STR(?a), "^.*#", "") AS ?action)
  OPTIONAL { ?a cv:requiresExperiment ?requiresExperiment }
  OPTIONAL { ?a cv:requiresFalsifier ?requiresFalsifier }
}
ORDER BY ?order
