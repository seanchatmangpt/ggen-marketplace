@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

esf:StructuralGap a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .
esf:CapitalCandidate a rdfs:Class ; rdfs:subClassOf prov:Entity .
esf:CanonicalPrimitive a rdfs:Class ; rdfs:subClassOf prov:Entity .
esf:PackPlan a rdfs:Class ; rdfs:subClassOf prov:Plan .
esf:GeneratorPlan a rdfs:Class ; rdfs:subClassOf prov:Plan .
esf:ConsumerPopulation a rdfs:Class ; rdfs:subClassOf prov:Collection .
esf:QualificationPlan a rdfs:Class ; rdfs:subClassOf prov:Plan .
esf:RegenerationPlan a rdfs:Class ; rdfs:subClassOf prov:Plan .
esf:DisplacementDecision a rdfs:Class ; rdfs:subClassOf prov:Activity .
esf:FactoryForFactories a rdfs:Class ; rdfs:subClassOf prov:Entity .

esf:gapKind a rdf:Property .
esf:sourceObservation a rdf:Property .
esf:canonicalPrimitive a rdf:Property .
esf:packPlan a rdf:Property .
esf:generatorPlan a rdf:Property .
esf:consumerPopulation a rdf:Property .
esf:qualificationPlan a rdf:Property .
esf:regenerationPlan a rdf:Property .
esf:expectedCommitUnlock a rdf:Property .
esf:expectedConsumerFanout a rdf:Property .
esf:expectedReuseLeverage a rdf:Property .
esf:expectedCompositionLeverage a rdf:Property .
esf:authorityCost a rdf:Property .
esf:irreversibleCost a rdf:Property .
esf:reversibility a rdf:Property .
esf:futureManufacturingCapacity a rdf:Property .
esf:structuralDisplacementScore a rdf:Property .
esf:informationGain a rdf:Property .
esf:upstreamLearningPotential a rdf:Property .
esf:requiresPublicOntology a rdf:Property .
esf:requiresGgen a rdf:Property .
esf:handwrittenIrreducibleReason a rdf:Property .
esf:admitted a rdf:Property .
esf:preservedAlternative a rdf:Property .
esf:qualifiedConsumerCount a rdf:Property .
esf:qualifiedDisplacementCount a rdf:Property .
esf:yieldNumerator a rdf:Property .
esf:yieldDenominator a rdf:Property .
esf:memoryUnlockCount a rdf:Property .
esf:memoryConsumedCount a rdf:Property .
