{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggen.dev/schema/epistemic-consumer-contract.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","consumer_repo","admitted_target_base","producer_repo","producer_sha","producer_fixture","producer_target_token","authority","consequential_do"],
  "properties": {
    "schema_version": {"const": 1},
    "consumer_repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "admitted_target_base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "producer_repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "producer_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "producer_fixture": {"type": "string", "minLength": 1},
    "producer_target_token": {"type": "string", "minLength": 1},
    "authority": {"const": "VERIFY_ONLY"},
    "consequential_do": {"const": false}
  }
}
