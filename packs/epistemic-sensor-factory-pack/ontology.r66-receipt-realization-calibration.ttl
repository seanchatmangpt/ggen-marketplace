@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

esf:ReceiptRealizationCalibration a prov:Activity .
esf:ConsumerEvidenceReturn a prov:Entity .
esf:RealizationCalibrationMeasurement a dqv:QualityMeasurement .
esf:ReceiptAssimilationGap a dqv:QualityMeasurement .
esf:IndependentConsumerRoot a prov:Entity .
esf:PortfolioEvidenceProjection a dcat:Dataset .
esf:ReceiptRealizationFamily a esf:SensorFamilySpec ;
  dcterms:title "Cross-repository receipt realization calibration" ;
  esf:requiresExactSubject true ;
  esf:requiresEvidenceRoot true .

esf:predictedConsumerFanout a dqv:Metric .
esf:realizedConsumerFanout a dqv:Metric .
esf:returnedReceiptCount a dqv:Metric .
esf:assimilatedReceiptCount a dqv:Metric .
esf:receiptReturnLatencyMs a dqv:Metric .
esf:receiptAssimilationLatencyMs a dqv:Metric .
esf:independentConsumerRootCount a dqv:Metric .
esf:predictedOpportunityYield a dqv:Metric .
esf:realizedOpportunityYieldR66 a dqv:Metric .
esf:predictedDependencyRelief a dqv:Metric .
esf:realizedDependencyReliefR66 a dqv:Metric .
esf:predictedEpistemicScore a dqv:Metric .
esf:realizedEpistemicScore a dqv:Metric .
esf:consumerReceiptCoverage a dqv:Metric .
esf:receiptAssimilationCoverage a dqv:Metric .
esf:standingFreshness a dqv:Metric .
esf:subjectContainmentVerified a dqv:Metric .
esf:evidenceRootIndependent a dqv:Metric .
esf:consumerQualificationVerified a dqv:Metric .
esf:receiptReplayVerifiedR66 a dqv:Metric .
esf:consumerRepositoryR66 a dcterms:identifier .
esf:consumerShaR66 a dcterms:identifier .
esf:receiptDigestR66 a dcterms:identifier .
esf:producerHeadR66 a dcterms:identifier .
esf:assimilatedAt a dcterms:date .
esf:executedAt a dcterms:date .
esf:returnedAt a dcterms:date .

esf:r66AuthorityPolicy a odrl:Policy ;
  odrl:permission [ odrl:action odrl:read ] ;
  odrl:permission [ odrl:action odrl:derive ] ;
  odrl:prohibition [ odrl:action odrl:execute ] .

esf:r66ReceiptRealizationCompiler a prov:Plan ;
  dcterms:title "Exact-subject cross-repository receipt assimilation and realization calibration" ;
  esf:requiresExactSubject true ;
  esf:requiresEvidenceRoot true ;
  esf:noAmbientDo true .
