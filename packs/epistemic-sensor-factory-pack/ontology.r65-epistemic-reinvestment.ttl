@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

esf:EpistemicInvestmentCandidate a prov:Plan .
esf:RealizedFeedback a dqv:QualityMeasurement .
esf:SensorPortfolioPlan a prov:Plan .
esf:EpistemicReinvestmentCompiler a prov:Plan .
esf:ReinvestmentReceipt a prov:Entity .
esf:ReinvestmentFamily a esf:SensorFamilySpec ; dcterms:title "Outcome-calibrated epistemic reinvestment" ; esf:requiresExactSubject true ; esf:requiresEvidenceRoot true .

esf:predictedYield a dqv:Metric .
esf:realizedYield a dqv:Metric .
esf:realizedRelief a dqv:Metric .
esf:investmentCost a dqv:Metric .
esf:observationLatencyMs a dqv:Metric .
esf:novelOpportunityCount a dqv:Metric .
esf:falsePositiveCount a dqv:Metric .
esf:falseNegativeCount a dqv:Metric .
esf:redundancyScore a dqv:Metric .
esf:complementarityScore a dqv:Metric .
esf:replayCoverage a dqv:Metric .
esf:falsifierCoverage a dqv:Metric .
esf:receiptCoverage a dqv:Metric .
esf:ontologyAlignment a dqv:Metric .
esf:generatorCorrespondence a dqv:Metric .
esf:interfaceCompatibility a dqv:Metric .
esf:consumerFanout a dqv:Metric .
esf:repositoryFanout a dqv:Metric .
esf:memoryReuseCount a dqv:Metric .
esf:current a dqv:Metric .
esf:exactSubjectBound a dqv:Metric .
esf:authorityBoundedObservation a dqv:Metric .
esf:evidenceRootCountR65 a dqv:Metric .
esf:standingValueR65 a dqv:Metric .
esf:portfolioRank a dqv:Metric .
esf:expectedInformationGain a dqv:Metric .
esf:realizedInformationGain a dqv:Metric .
esf:dependencyUnlockCount a dqv:Metric .
esf:downstreamOpportunityYield a dqv:Metric .
esf:reinvestmentScore a dqv:Metric .

esf:epistemicReinvestmentCompiler a esf:EpistemicReinvestmentCompiler ;
  dcterms:title "Exact-subject realized-feedback epistemic reinvestment compiler" ;
  esf:requiresExactSubject true ;
  esf:requiresEvidenceRoot true ;
  esf:noAmbientDo true .

esf:r65AuthorityPolicy a odrl:Policy ;
  odrl:permission [ odrl:action odrl:read ] ;
  odrl:permission [ odrl:action odrl:derive ] ;
  odrl:prohibition [ odrl:action odrl:execute ] .
