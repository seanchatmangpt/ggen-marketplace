@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .

esf:ConsumerIndependenceObservation a dqv:QualityMeasurement .
esf:ConsumerIndependenceProfile a prov:Entity .
esf:IndependenceSelectionPlan a prov:Plan .
esf:runtimeFamily a dcterms:type .
esf:languageFamily a dcterms:language .
esf:executionKernel a dcterms:type .
esf:failureDomain a dcterms:type .
esf:authorityDomain a odrl:Policy .
esf:receiptProtocol a dcterms:conformsTo .
esf:qualificationFamily a dcterms:type .
esf:ontologyProfile a dcterms:conformsTo .
esf:hostingPlane a dcterms:type .

esf:consumerIndependenceFamily a esf:SensorFamilySpec ;
  dcterms:title "Independent consumer evidence-root observability" ;
  esf:requiresExactSubject true ;
  esf:requiresEvidenceRoot true .

esf:consumerIndependenceSpec a esf:SensorSpec ;
  esf:family esf:consumerIndependenceFamily ;
  esf:metric "consumer-independence-gain" ;
  esf:queryPattern "candidate -> orthogonal execution/evidence dimensions -> qualified frontier" ;
  esf:opportunityKind "correlated-consumer-fanout" .
