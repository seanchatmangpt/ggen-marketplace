@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

esf:DfCMRun a prov:Activity .
esf:CellExecution a prov:Activity .
esf:Handoff a prov:Activity .
esf:ProcessReceipt a prov:Entity .
esf:ProcessOpportunity a prov:Entity .
esf:ProcessMeasurement a dqv:QualityMeasurement .
esf:ProcessFamily a prov:Plan ; dcterms:title "DfCM cross-cell process intelligence" .
esf:cell a dcterms:type .
esf:stageIndex a dqv:value .
esf:startedAt a prov:startedAtTime .
esf:endedAt a prov:endedAtTime .
esf:durationMs a dqv:value .
esf:queueMs a dqv:value .
esf:activeMs a dqv:value .
esf:inputCount a dqv:value .
esf:outputCount a dqv:value .
esf:failureCount a dqv:value .
esf:repairCount a dqv:value .
esf:pollCount a dqv:value .
esf:headMoveCount a dqv:value .
esf:memoryReadCount a dqv:value .
esf:memoryReuseCount a dqv:value .
esf:branchingFactor a dqv:value .
esf:generationDepth a dqv:value .
esf:opportunityCount a dqv:value .
esf:qualifiedCount a dqv:value .
esf:mergedCount a dqv:value .
esf:evidenceRootCountR71 a dqv:value .
esf:receiptCountR71 a dqv:value .
esf:falsifierCountR71 a dqv:value .
esf:authorityRefusalCount a dqv:value .
esf:consequentialActuation a dqv:value .
esf:exactHead a prov:qualifiedGeneration .
esf:baseHead a prov:wasDerivedFrom .
esf:nextCell a prov:wasInformedBy .
esf:processStanding a dqv:value .
esf:causedProcessOpportunity a prov:generated .

esf:r71AuthorityPolicy a odrl:Policy ;
  odrl:permission [ odrl:action odrl:read ] ;
  odrl:permission [ odrl:action odrl:derive ] ;
  odrl:prohibition [ odrl:action odrl:execute ] .