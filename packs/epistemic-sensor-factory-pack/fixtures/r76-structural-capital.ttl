@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix ex: <https://ggen.dev/fixtures/r76#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:observation-r75 a esf:ScheduleRun .
ex:gap-ash-factory a esf:StructuralGap ;
  esf:gapKind "ash-product-factory" ;
  esf:sourceObservation ex:observation-r75 .

ex:canonical-ash-product a esf:CanonicalPrimitive .
ex:pack-ash-product a esf:PackPlan .
ex:generator-ash-product a esf:GeneratorPlan .
ex:population-ash-product a esf:ConsumerPopulation .
ex:qualification-ash-product a esf:QualificationPlan .
ex:regeneration-ash-product a esf:RegenerationPlan ; esf:requalified true .

ex:factory-candidate a esf:CapitalCandidate ;
  esf:sourceObservation ex:observation-r75 ;
  esf:canonicalPrimitive ex:canonical-ash-product ;
  esf:packPlan ex:pack-ash-product ;
  esf:generatorPlan ex:generator-ash-product ;
  esf:consumerPopulation ex:population-ash-product ;
  esf:qualificationPlan ex:qualification-ash-product ;
  esf:regenerationPlan ex:regeneration-ash-product ;
  esf:expectedCommitUnlock 250 ;
  esf:expectedConsumerFanout 12 ;
  esf:expectedReuseLeverage 10 ;
  esf:expectedCompositionLeverage 10 ;
  esf:authorityCost 1 ;
  esf:irreversibleCost 1 ;
  esf:reversibility 10 ;
  esf:futureManufacturingCapacity 1000 ;
  esf:structuralDisplacementScore 9 ;
  esf:informationGain 8 ;
  esf:upstreamLearningPotential 9 ;
  esf:requiresPublicOntology true ;
  esf:requiresGgen true ;
  esf:admitted true ;
  esf:preservedAlternative ex:adapter-candidate ;
  esf:qualifiedConsumerCount 3 ;
  esf:qualifiedDisplacementCount 1 ;
  esf:yieldNumerator 20 ;
  esf:yieldDenominator 5 ;
  esf:memoryUnlockCount 4 ;
  esf:memoryConsumedCount 2 .

ex:adapter-candidate a esf:CapitalCandidate ;
  esf:sourceObservation ex:observation-r75 ;
  esf:expectedCommitUnlock 8 ;
  esf:expectedConsumerFanout 1 ;
  esf:expectedReuseLeverage 1 ;
  esf:expectedCompositionLeverage 1 ;
  esf:authorityCost 1 ;
  esf:irreversibleCost 1 ;
  esf:reversibility 9 ;
  esf:futureManufacturingCapacity 8 ;
  esf:structuralDisplacementScore 2 ;
  esf:informationGain 3 ;
  esf:upstreamLearningPotential 2 ;
  esf:requiresPublicOntology true ;
  esf:requiresGgen true ;
  esf:handwrittenIrreducibleReason "target-local bootstrap only" ;
  esf:admitted false ;
  esf:yieldNumerator 1 ;
  esf:yieldDenominator 8 ;
  esf:memoryUnlockCount 0 ;
  esf:memoryConsumedCount 2 .

ex:local-refinement a esf:Refinement ; esf:generalizable true .
ex:upstream-learning a esf:UpstreamLearning .
