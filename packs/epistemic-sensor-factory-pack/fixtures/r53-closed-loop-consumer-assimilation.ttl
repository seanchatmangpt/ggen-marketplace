esf:r53R48Check a dqv:QualityMeasurement ; esf:checkName "R48 Independent Consumer Court" ; esf:checkConclusion "success" ; prov:wasGeneratedBy esf:r53GgenReceipt .
esf:r53R52Check a dqv:QualityMeasurement ; esf:checkName "MEASURE R52 Epistemic Consumer Receipt" ; esf:checkConclusion "success" ; prov:wasGeneratedBy esf:r53GgenReceipt .
esf:r53GeneralCiCheck a dqv:QualityMeasurement ; esf:checkName "CI" ; esf:checkConclusion "success" ; prov:wasGeneratedBy esf:r53GgenReceipt .

esf:r53Assimilation a esf:ProducerAssimilation ;
