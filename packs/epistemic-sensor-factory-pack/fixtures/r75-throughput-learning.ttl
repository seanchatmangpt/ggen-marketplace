@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

esf:r75run a esf:ScheduleRun ;
  esf:runId "6a754fe0a72c819191520a0826a1398c+20260826T020200Z+MEASURE" ;
  esf:scheduleCell "MEASURE" ;
  esf:commitsPerHour 60 ;
  esf:previousHourRate 53 ;
  esf:previousSameCellRate 53 ;
  esf:mean24hRate 50 ;
  esf:activeMinutes 58 ;
  esf:actionableAdjacency esf:fanoutOpportunity, esf:revopsOpportunity .

esf:displacement a esf:StructuralDisplacement ;
  esf:existingStructure "bespoke schedule accounting" ;
  esf:desiredStructure "ggen-owned attributable throughput graph" ;
  esf:ontologySource <http://www.w3.org/ns/prov#> ;
  esf:pack "epistemic-sensor-factory-pack" ;
  esf:generator "r75-throughput-learning-projection" ;
  esf:generatedArtifact "throughput-learning-plan.json" ;
  esf:consumer "MEASURE" ;
  esf:qualificationReceipt "r75-qualified" .

esf:baseline a esf:GeneratedBaseline .
esf:learning esf:baseline esf:baseline ; esf:experience esf:experience ; esf:refinement esf:refinement ; esf:generalizable true ; esf:promotedUpstream true ; esf:regenerated true ; esf:requalified true .

esf:from a esf:RevenueFromCustomer ; esf:payer "payer" ; esf:causalCapability esf:displacement ; esf:evidenceRoot "contract-proof" ; esf:attributionConfidence 0.9 ; esf:timeWindow "2026-Q3" .
esf:for a esf:RevenueForCustomer ; esf:beneficiary "customer" ; esf:customerProcess "software manufacture" ; esf:valueOutcome "shorter evidence-to-manufacture latency" ; esf:customerRevenueOutcome "measurable expansion capacity" ; esf:evidenceRoot "process-proof" ; esf:attributionConfidence 0.7 ; esf:timeWindow "2026-Q3" ; esf:retentionExpansion "hypothesis" .
