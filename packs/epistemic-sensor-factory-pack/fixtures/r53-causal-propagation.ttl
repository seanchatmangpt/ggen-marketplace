@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Grounded exact subjects; causal edges below are reference observations for falsifier execution,
# not claims that GitHub timing alone proves real-world causality.
esf:marketplaceSubjectR53 a esf:ExactSubject ;
  esf:observedInRepo "seanchatmangpt/ggen-marketplace" ;
  esf:subjectSha "0f3349afe3fe12a26932974b8e6a47399b1e94ab" .

esf:ggenSubjectR53 a esf:ExactSubject ;
  esf:observedInRepo "seanchatmangpt/ggen" ;
  esf:subjectSha "ddfa602bfbab57b7ed5150f61b0acac7a41e3020" .

esf:cloudSubjectR53 a esf:ExactSubject ;
  esf:observedInRepo "seanchatmangpt/chatgpt-cloud-elixir" ;
  esf:subjectSha "a5172d335de9a126d7bd7c91139b626112abf995" .

esf:ggenReturnedReceipt a esf:ConsumerReceiptAssertion ;
  esf:consumerHead "e7bc695976bba37d1abf73a266da1b2267ca2a1d" ;
  esf:returnSource "ggen-pr-670" ;
  esf:returnedAt "2026-08-25T13:15:31Z"^^xsd:dateTime ;
  esf:replayVerified true ;
  esf:independentEvidenceRoot "ggen-actions" .

esf:seedGgen a esf:PropagationSeed ;
  esf:sourceConsumer esf:ggenSubjectR53 ;
  esf:sourceReceipt esf:ggenReturnedReceipt .

esf:opportunityCloudReplication a esf:DownstreamOpportunity ;
  esf:targetRepo "seanchatmangpt/chatgpt-cloud-elixir" ;
  esf:dependencyRelief true .

esf:opportunityReturnedReceiptAssimilation a esf:DownstreamOpportunity ;
  esf:targetRepo "seanchatmangpt/ggen-marketplace" ;
  esf:dependencyRelief true .

esf:witnessGgenToCloud a esf:CausalWitness ;
  esf:independentTargetRoot "cloud-default-head" ;
  esf:causalConfidence "0.80"^^xsd:decimal .

esf:edgeGgenToCloud a esf:PropagationEdge ;
  esf:sourceReceipt esf:ggenReturnedReceipt ;
  esf:sourceConsumer esf:ggenSubjectR53 ;
  esf:causedOpportunity esf:opportunityCloudReplication ;
  esf:causalWitness esf:witnessGgenToCloud ;
  esf:observedAfterReceipt true ;
  esf:propagationLatencyMs 540000 ;
  esf:marginalOpportunityCount 1 ;
  esf:fanoutCount 2 ;
  esf:reliefRealized false ;
  esf:standingTransferred false ;
  esf:authorityTransferred false .

esf:edgeGgenAssimilation a esf:PropagationEdge ;
  esf:sourceReceipt esf:ggenReturnedReceipt ;
  esf:sourceConsumer esf:ggenSubjectR53 ;
  esf:causedOpportunity esf:opportunityReturnedReceiptAssimilation ;
  esf:observedAfterReceipt true ;
  esf:propagationLatencyMs 600000 ;
  esf:marginalOpportunityCount 1 ;
  esf:fanoutCount 2 ;
  esf:reliefRealized true ;
  esf:standingTransferred false ;
  esf:authorityTransferred false .

# Counterexample surface: an observed-after edge with no causal witness.
esf:edgeCloudWeak a esf:PropagationEdge ;
  esf:sourceConsumer esf:cloudSubjectR53 ;
  esf:causedOpportunity esf:opportunityReturnedReceiptAssimilation ;
  esf:observedAfterReceipt true ;
  esf:marginalOpportunityCount 0 ;
  esf:standingTransferred false ;
  esf:authorityTransferred false .
