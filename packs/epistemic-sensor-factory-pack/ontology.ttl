@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

esf:SensorFamilySpec a prov:Plan .
esf:SensorSpec a dqv:QualityMeasurementDataset .
esf:OpportunityProjection a prov:Plan .
esf:QualificationCourtSpec a prov:Plan .
esf:ManufactureRun a prov:Activity .
esf:ManufacturedSensor a dqv:QualityMeasurementDataset .
esf:FactoryReceipt a prov:Entity .
esf:ExactSubject a prov:Entity .
esf:ReplicationTarget a dcat:Resource .
esf:ConsumerSuitability a dqv:QualityMeasurement .
esf:ReplicationReceipt a prov:Entity .
esf:ReplicationCompiler a prov:Plan .
esf:ConsumerReceiptAssertion a prov:Entity .
esf:EvidenceReturn a prov:Activity .
esf:ProducerAssimilation a prov:Activity .
esf:ReturnedConsumerStanding a dqv:QualityMeasurement .
esf:ConsumerAdmissionCandidate a dcat:Resource .
esf:ConsumerAdmissionDecision a dqv:QualityMeasurement .
esf:ConsumerAdapterPlan a prov:Plan .
esf:ConsumerAdmissionCompiler a prov:Plan .
esf:CausalPropagationObservation a dqv:QualityMeasurement .
esf:PropagationSeed a prov:Entity .
esf:PropagationEdge a prov:Activity .
esf:DownstreamOpportunity a prov:Entity .
esf:CausalWitness a prov:Entity .
esf:PropagationReceipt a prov:Entity .
esf:CounterfactualWitness a prov:Entity .
esf:ProductionFunctionObservation a dqv:QualityMeasurement .
esf:MultiplicativeFactor a dqv:Dimension .
esf:MultiplierReceipt a prov:Entity .
esf:FrontierExpansion a prov:Activity .
esf:PortfolioReuseObservation a dqv:QualityMeasurement .
esf:ConsumerRealizationPlan a prov:Plan .
esf:AdapterArtifactSpec a prov:Plan .
esf:QualificationBinding a prov:Plan .
esf:ReceiptReturnBinding a prov:Plan .
esf:ReplayBinding a prov:Plan .
esf:ConsumerRealizationCompiler a prov:Plan .

esf:family a dcterms:type .
esf:metric a dqv:inDimension .
esf:queryPattern a prov:value .
esf:opportunityKind a dcterms:type .
esf:requiresEvidenceRoot a prov:used .
esf:requiresExactSubject a prov:used .
esf:manufactures a prov:generated .
esf:derivedFromSpec a prov:wasDerivedFrom .
esf:subjectSha a prov:qualifiedGeneration .
esf:observedInRepo a prov:atLocation .
esf:receipt a prov:wasGeneratedBy .
esf:standing a dqv:hasQualityMeasurement .
esf:actuationPerformed a prov:value .
esf:targetRepo a dcat:accessURL .
esf:defaultHead a prov:qualifiedGeneration .
esf:eligible a dqv:value .
esf:sourceFactoryHead a prov:wasDerivedFrom .
esf:independentEvidenceRoot a prov:used .
esf:qualificationState a dqv:value .
esf:dependencyRelief a dqv:value .
esf:consumerHead a prov:qualifiedGeneration .
esf:producerCourtHead a prov:wasDerivedFrom .
esf:receiptDigest a dcterms:identifier .
esf:returnSource a prov:wasAttributedTo .
esf:returnedAt a prov:generatedAtTime .
esf:assimilatedBy a prov:wasGeneratedBy .
esf:consumerStandingValue a dqv:value .
esf:producerStandingValue a dqv:value .
esf:evidenceRootCount a dqv:value .
esf:crossRepository a dqv:value .
esf:replayVerified a dqv:value .
esf:candidateRepo a dcat:accessURL .
esf:candidateHead a prov:qualifiedGeneration .
esf:producerTargetToken a dcterms:identifier .
esf:identityVerified a dqv:value .
esf:authorityBounded a dqv:value .
esf:courtReusable a dqv:value .
esf:receiptReturnCapable a dqv:value .
esf:adapterRequired a dqv:value .
esf:admissionStanding a dqv:value .
esf:generatedProjectionCapable a dqv:value .
esf:currentDefaultHead a prov:qualifiedGeneration .
esf:replayCapable a dqv:value .
esf:consumerFamily a dcterms:type .
esf:dependencyClosed a dqv:value .
esf:securityBoundary a dcterms:description .
esf:noAmbientDo a dqv:value .
esf:publicOntologyAligned a dqv:value .
esf:ggenManufacturable a dqv:value .
esf:qualificationPath a dcat:accessURL .
esf:admittedTarget a prov:used .
esf:sourceReceipt a prov:used .
esf:sourceConsumer a prov:wasAttributedTo .
esf:causedOpportunity a prov:generated .
esf:causalWitness a prov:qualifiedAssociation .
esf:counterfactualWitness a prov:qualifiedInfluence .
esf:propagationLatencyMs a dqv:value .
esf:marginalOpportunityCount a dqv:value .
esf:causalConfidence a dqv:value .
esf:fanoutCount a dqv:value .
esf:standingTransferred a dqv:value .
esf:authorityTransferred a dqv:value .
esf:causalClass a dcterms:type .
esf:observedAfterReceipt a dqv:value .
esf:independentTargetRoot a prov:used .
esf:reliefRealized a dqv:value .
esf:observationFactor a dqv:value .
esf:reuseFactor a dqv:value .
esf:opportunityFactor a dqv:value .
esf:multiplicativeProduct a dqv:value .
esf:factorEvidenceCount a dqv:value .
esf:factorIndependentRoots a dqv:value .
esf:frontierBefore a dqv:value .
esf:frontierAfter a dqv:value .
esf:frontierDelta a dqv:value .
