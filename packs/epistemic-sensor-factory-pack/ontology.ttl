esf:standingInherited a dqv:value .
esf:authorityInherited a dqv:value .
esf:manufacturingStanding a dqv:value .

esf:consumerReplicationFamily a esf:SensorFamilySpec ; dcterms:title "Consumer replication observability" ; esf:requiresExactSubject true ; esf:requiresEvidenceRoot true .
esf:consumerEvidenceReturnFamily a esf:SensorFamilySpec ; dcterms:title "Independent consumer evidence-return observability" ; esf:requiresExactSubject true ; esf:requiresEvidenceRoot true .
esf:consumerAdmissionFamily a esf:SensorFamilySpec ; dcterms:title "Independent consumer admission and adapter readiness" ; esf:requiresExactSubject true ; esf:requiresEvidenceRoot true .
esf:causalPropagationFamily a esf:SensorFamilySpec ; dcterms:title "Causal returned-evidence propagation observability" ; esf:requiresExactSubject true ; esf:requiresEvidenceRoot true .
esf:productionFunctionFamily a esf:SensorFamilySpec ; dcterms:title "Multiplicative production-function observability" ; esf:requiresExactSubject true ; esf:requiresEvidenceRoot true .
esf:consumerRealizationFamily a esf:SensorFamilySpec ; dcterms:title "Deterministic target-bound consumer realization" ; esf:requiresExactSubject true ; esf:requiresEvidenceRoot true .

esf:replicationCompiler a esf:ReplicationCompiler ; dcterms:title "Exact-subject consumer replication compiler" ; esf:requiresExactSubject true ; esf:requiresEvidenceRoot true .
esf:consumerAdmissionCompiler a esf:ConsumerAdmissionCompiler ; dcterms:title "Exact-subject consumer admission compiler" ; esf:requiresExactSubject true ; esf:requiresEvidenceRoot true .
esf:consumerRealizationCompiler a esf:ConsumerRealizationCompiler ; dcterms:title "Target-bound consumer realization compiler" ; esf:requiresExactSubject true ; esf:requiresEvidenceRoot true ; esf:noAmbientDo true .

esf:replicationCoverageSpec a esf:SensorSpec ; esf:family esf:consumerReplicationFamily ; esf:metric "replication-coverage" ; esf:queryPattern "candidate -> target -> receipt" ; esf:opportunityKind "missing-replication" .
esf:evidenceIndependenceSpec a esf:SensorSpec ; esf:family esf:consumerReplicationFamily ; esf:metric "evidence-root-independence" ; esf:queryPattern "candidate -> evidenceRoot" ; esf:opportunityKind "single-root-risk" .
esf:dependencyReliefSpec a esf:SensorSpec ; esf:family esf:consumerReplicationFamily ; esf:metric "dependency-relief-conversion" ; esf:queryPattern "opportunity -> relieves" ; esf:opportunityKind "unrealized-relief" .
esf:evidenceReturnSpec a esf:SensorSpec ; esf:family esf:consumerEvidenceReturnFamily ; esf:metric "consumer-receipt-return" ; esf:queryPattern "consumer receipt -> exact subject -> producer assimilation" ; esf:opportunityKind "missing-evidence-return" .
esf:consumerAdmissionSpec a esf:SensorSpec ; esf:family esf:consumerAdmissionFamily ; esf:metric "consumer-admission-readiness" ; esf:queryPattern "candidate -> exact subject -> reusable court -> bounded adapter -> returned receipt" ; esf:opportunityKind "unadmitted-consumer" .
esf:causalPropagationSpec a esf:SensorSpec ; esf:family esf:causalPropagationFamily ; esf:metric "returned-evidence-causal-fanout" ; esf:queryPattern "returned receipt -> causal witness -> downstream opportunity -> relief" ; esf:opportunityKind "uncertain-propagation" .
esf:productionFunctionSpec a esf:SensorSpec ; esf:family esf:productionFunctionFamily ; esf:metric "observation-x-reuse-x-opportunity" ; esf:queryPattern "exact evidence -> independently receipted factors -> multiplicative product -> frontier delta" ; esf:opportunityKind "multiplier-shortfall" .
esf:consumerRealizationSpec a esf:SensorSpec ; esf:family esf:consumerRealizationFamily ; esf:metric "plan-to-target-bound-consumer" ; esf:queryPattern "admitted candidate -> exact target -> adapter artifact -> qualification -> receipt return -> replay" ; esf:opportunityKind "unrealized-consumer" .

esf:authorityPolicy a odrl:Policy ;
  odrl:permission [ odrl:action odrl:read ] ;
  odrl:permission [ odrl:action odrl:derive ] ;
  odrl:prohibition [ odrl:action odrl:execute ] .