esf:reusedCapabilityCount a dqv:value .
esf:downstreamOpportunityCount a dqv:value .
esf:multiplierAdmitted a dqv:value .
esf:realizedFor a prov:used .
esf:sourceAdapterPlan a prov:wasDerivedFrom .
esf:artifactFamily a dcterms:type .
esf:exactTargetHead a prov:qualifiedGeneration .
