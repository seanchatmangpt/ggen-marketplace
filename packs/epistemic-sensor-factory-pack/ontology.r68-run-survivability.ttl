@prefix rs: <https://chatman.ai/ontology/run-survivability#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

rs:Run a prov:Activity .
rs:Checkpoint a prov:Entity .
rs:Failure a prov:Entity .
rs:Repair a prov:Activity .
rs:Opportunity a prov:Entity .
rs:Receipt a prov:Entity .
rs:ConsumerReturn a prov:Entity .
rs:hasCheckpoint a rdf:Property .
rs:hasFailure a rdf:Property .
rs:hasRepair a rdf:Property .
rs:hasOpportunity a rdf:Property .
rs:hasReceipt a rdf:Property .
rs:hasConsumerReturn a rdf:Property .
rs:stage a rdf:Property .
rs:standing a rdf:Property .
rs:exactSubject a rdf:Property .
rs:observedAt a rdf:Property .
rs:elapsedSeconds a dqv:Metric .
rs:queueSeconds a dqv:Metric .
rs:executionSeconds a dqv:Metric .
rs:headMoveCount a dqv:Metric .
rs:retryCount a dqv:Metric .
rs:semanticCommitCount a dqv:Metric .
rs:opportunityCount a dqv:Metric .
rs:memoryRecordsConsumed a dqv:Metric .
rs:returnedConsumerReceipts a dqv:Metric .
rs:authority "OBSERVE|VERIFY" ; odrl:permission odrl:read ; rs:standing "ALIVE" .
