@prefix r68: <https://chatman.ai/ontology/r68-run-closure#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

r68:Run a r68:RunClass .
r68:Checkpoint a r68:CheckpointClass .
r68:FailureObservation a dqv:QualityMeasurement .
r68:RunReceipt a prov:Entity .
r68:Opportunity a prov:Entity .
r68:runId a r68:IdentityProperty .
r68:subjectSha a r68:IdentityProperty .
r68:cell a r68:IdentityProperty .
r68:state a r68:StandingProperty .
r68:startedAt a r68:TemporalProperty .
r68:endedAt a r68:TemporalProperty .
r68:observedAt a r68:TemporalProperty .
r68:checkpointKind a r68:CheckpointProperty .
r68:sequence a r68:CheckpointProperty .
r68:latencySeconds a dqv:Metric .
r68:pollCount a dqv:Metric .
r68:headMoveCount a dqv:Metric .
r68:apiFailureCount a dqv:Metric .
r68:meaningfulCommitCount a dqv:Metric .
r68:opportunityCount a dqv:Metric .
r68:mergeCount a dqv:Metric .
r68:receiptCount a dqv:Metric .
r68:queueSeconds a dqv:Metric .
r68:authority a odrl:Permission .
r68:actuationPerformed a r68:AuthorityProperty .
r68:hasCheckpoint a r68:RelationProperty .
r68:hasReceipt a r68:RelationProperty .
r68:causedOpportunity a r68:RelationProperty .
r68:qualifiedSubject a r68:RelationProperty .
r68:mergedSubject a r68:RelationProperty .

r68:RunClosureObservability a r68:MeasurementPack ;
  dct:title "Autonomic run-closure observability" ;
  r68:authority "OBSERVE|VERIFY" ;
  r68:actuationPerformed false .
