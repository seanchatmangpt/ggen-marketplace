{
  "schema": "ggen.epistemic-sensor-factory.causal-propagation-plan/1",
  "authority": "OBSERVE|SELECT|CONSTRUCT|VERIFY",
  "consequential_do": false,
  "rule": "standing-and-authority-do-not-propagate",
  "edges": [
  {%- for row in rows %}
    {"edge":"{{ row.edge }}","consumer":"{{ row.consumer }}","consumer_sha":"{{ row.consumerSha }}","opportunity":"{{ row.opportunity }}","target_repo":"{{ row.targetRepo }}","causal_confidence":"{{ row.confidence }}"}{% if not loop.last %},{% endif %}
  {%- endfor %}
  ]
}
