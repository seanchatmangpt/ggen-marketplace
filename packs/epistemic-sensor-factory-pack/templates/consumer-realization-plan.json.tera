{
  "schema": "ggen.epistemic.consumer-realization/1",
  "authority": "SELECT|CONSTRUCT|VERIFY",
  "consequential_do": false,
  "standing_inherited": false,
  "authority_inherited": false,
  "plans": [
  {% for row in rows %}{
    "plan": "{{ row.plan }}",
    "candidate": "{{ row.candidate }}",
    "artifact_family": "{{ row.family }}",
    "exact_target_head": "{{ row.head }}",
    "projection_path": "{{ row.projection }}",
    "qualification_command": "{{ row.qualification }}",
    "receipt_path": "{{ row.receipt }}",
    "replay_path": "{{ row.replay }}",
    "rollback_command": "{{ row.rollback }}"
  }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
