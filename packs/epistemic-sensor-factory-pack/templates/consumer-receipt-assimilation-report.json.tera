{"schema":"ggen.consumer-receipt-assimilation/1","authority":"OBSERVE|VERIFY","consequential_do":false,"consumers":[{% for row in rows %}{"repository":"{{ row.repo }}","ref":"{{ row.ref }}","sha":"{{ row.sha }}","standing":"{{ row.standing }}","receipt_digest":"{{ row.receipt }}","replay_verified":{{ row.replay }}}{% if not loop.last %},{% endif %}{% endfor %}]}
