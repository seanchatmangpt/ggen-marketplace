{
  "schema": "ggen.epistemic-sensor-factory.transitive-propagation/1",
  "authority": "OBSERVE|VERIFY|SELECT|CONSTRUCT",
  "consequential_do": false,
  "targets": [
  {% for row in rows %}{"repo":"{{ row.repo }}","head":"{{ row.head }}","standing":"{{ row.standing | default(value=\"UNKNOWN\") }}","replay_verified":{{ row.replay | default(value=false) }},"dependency_relief":{{ row.relief | default(value=false) }}}{% if not loop.last %},{% endif %}
  {% endfor %}]
}
