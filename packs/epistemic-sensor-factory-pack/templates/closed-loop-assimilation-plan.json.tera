{
  "schema": "ggen.closed-loop-consumer-assimilation/1",
  "authority": "SELECT|CONSTRUCT|VERIFY",
  "consequential_do": false,
  "assimilations": [
  {% for row in results %}{"receipt":"{{ row.receipt }}","consumer_head":"{{ row.consumerHead }}","merge":"{{ row.merge }}","default_head":"{{ row.defaultHead }}","standing":"{{ row.standing }}","dependency_relief":{{ row.relief }}}{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
