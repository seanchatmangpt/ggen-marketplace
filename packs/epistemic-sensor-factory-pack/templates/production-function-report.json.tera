{
  "schema": "ggen.epistemic.production-function/1",
  "authority": "OBSERVE|SELECT|CONSTRUCT|VERIFY",
  "consequential_do": false,
  "observations": [
  {% for row in rows %}{
    "subject": "{{ row.observation }}",
    "observation_factor": {{ row.observationFactor }},
    "reuse_factor": {{ row.reuseFactor }},
    "opportunity_factor": {{ row.opportunityFactor }},
    "multiplicative_product": {{ row.product }},
    "frontier_delta": {{ row.delta }},
    "independent_roots": {{ row.roots }},
    "admitted": {{ row.admitted }}
  }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
