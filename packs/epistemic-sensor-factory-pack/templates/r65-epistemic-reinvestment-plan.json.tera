{
  "schema": "ggen.epistemic-reinvestment-plan/1",
  "authority": "OBSERVE|VERIFY|CONSTRUCT",
  "consequential_do": false,
  "compiler": "epistemicReinvestmentCompiler",
  "candidates": [
  {% for row in rows %}
    {"subject":"{{ row.sha }}","score":{{ row.score }},"realized_yield":{{ row.yield }},"realized_relief":{{ row.relief }},"consumer_fanout":{{ row.fanout }},"dependency_unlocks":{{ row.unlocks }}}{% if not loop.last %},{% endif %}
  {% endfor %}
  ]
}
