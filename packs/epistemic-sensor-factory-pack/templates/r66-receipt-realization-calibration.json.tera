{
  "schema": "ggen.epistemic-sensor-factory.r66-receipt-realization-calibration/v1",
  "authority": "OBSERVE|VERIFY",
  "consequential_do": false,
  "measurements": [
  {% for row in rows %}
    {"measurement":"{{ row.measurement }}","consumer_fanout":{{ row.fanout }},"independent_roots":{{ row.roots }},"returned_receipts":{{ row.returned }},"assimilated_receipts":{{ row.assimilated }},"opportunity_yield":{{ row.yield }},"dependency_relief":{{ row.relief }},"epistemic_score":{{ row.score }},"receipt_coverage":{{ row.receiptCoverage }},"assimilation_coverage":{{ row.assimilationCoverage }}}{% if not loop.last %},{% endif %}
  {% endfor %}
  ]
}
