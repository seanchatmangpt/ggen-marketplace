{
  "schema": "ggen.epistemic.consumer-factor/1",
  "authority": "OBSERVE|SELECT|CONSTRUCT|VERIFY",
  "consequential_do": false,
  "target_factor": 10,
  "consumers": [
  {% for row in rows %}{
    "candidate": "{{ row.candidate }}",
    "target": "{{ row.target }}",
    "standing": "{{ row.standing }}",
    "adapter_required": {{ row.adapter }},
    "receipt_return_capable": {{ row.returnCapable }}
  }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
