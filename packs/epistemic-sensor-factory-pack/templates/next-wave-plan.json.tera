{
  "schema": "ggen.consumer-replication-wave/1",
  "authority": "SELECT|CONSTRUCT|VERIFY",
  "consequential_do": false,
  "targets": [
  {% for row in results %}{"repo":"{{ row.repo }}","head":"{{ row.head }}","standing":"{{ row.standing }}","priority":{{ row.priority }}}{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
