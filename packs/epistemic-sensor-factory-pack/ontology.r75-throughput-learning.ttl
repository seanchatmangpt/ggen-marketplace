@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

esf:ScheduleRun a rdfs:Class ; rdfs:subClassOf prov:Activity .
esf:SemanticCommit a rdfs:Class ; rdfs:subClassOf prov:Entity .
esf:StructuralDisplacement a rdfs:Class ; rdfs:subClassOf prov:Activity .
esf:GeneratedBaseline a rdfs:Class ; rdfs:subClassOf prov:Entity .
esf:AgentExperience a rdfs:Class ; rdfs:subClassOf prov:Entity .
esf:Refinement a rdfs:Class ; rdfs:subClassOf prov:Entity .
esf:UpstreamLearning a rdfs:Class ; rdfs:subClassOf prov:Activity .
esf:Regeneration a rdfs:Class ; rdfs:subClassOf prov:Activity .
esf:RevenueFromCustomer a rdfs:Class ; rdfs:subClassOf prov:Entity .
esf:RevenueForCustomer a rdfs:Class ; rdfs:subClassOf prov:Entity .
esf:ThroughputConstraint a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .
esf:runId a rdf:Property .
esf:scheduleCell a rdf:Property .
esf:commitSha a rdf:Property .
esf:attributedToRun a rdf:Property .
