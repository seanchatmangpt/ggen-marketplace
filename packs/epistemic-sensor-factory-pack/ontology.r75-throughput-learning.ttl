esf:previousSameCellRate a rdf:Property .
esf:mean24hRate a rdf:Property .
esf:constraintKind a rdf:Property .
esf:existingStructure a rdf:Property .
esf:desiredStructure a rdf:Property .
esf:ontologySource a rdf:Property .
esf:pack a rdf:Property .
esf:generator a rdf:Property .
esf:generatedArtifact a rdf:Property .
esf:consumer a rdf:Property .
esf:qualificationReceipt a rdf:Property .
esf:baseline a rdf:Property .
esf:experience a rdf:Property .
esf:refinement a rdf:Property .
esf:generalizable a rdf:Property .
esf:promotedUpstream a rdf:Property .
esf:regenerated a rdf:Property .
esf:requalified a rdf:Property .
esf:payer a rdf:Property .
esf:beneficiary a rdf:Property .
esf:causalCapability a rdf:Property .
esf:valueMetric a rdf:Property .
esf:evidenceRoot a rdf:Property .
