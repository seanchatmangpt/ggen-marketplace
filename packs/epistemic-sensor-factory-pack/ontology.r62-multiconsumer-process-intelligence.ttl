@prefix esf: <https://ggen.dev/ontology/epistemic-sensor-factory#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

esf:ConsumerProcessTrace a prov:Activity .
esf:ConsumerEvidenceRoot a prov:Entity .
esf:CommonCauseGroup a prov:Entity .
esf:ConsumerReliefTransition a prov:Activity .
esf:NegativeConsumerCase a prov:Entity .
esf:consumerKind a dcterms:type .
esf:workflowRunId a dcterms:identifier .
esf:producerSha a dcterms:identifier .
esf:receiptReturned a dqv:value .
esf:assimilated a dqv:value .
esf:assimilationObservedAt a dcterms:date .
esf:aliveObservedAt a dcterms:date .
esf:reliefVerified a dqv:value .
esf:evidenceRootProvider a dcterms:publisher .
esf:evidenceRootFamily a dcterms:type .
esf:commonCauseKey a dcterms:identifier .
esf:negativeCase a dqv:value .
esf:refusalType a dcterms:type .
esf:failureDomain a dcterms:type .
esf:dependencyReliefMagnitude a dqv:value .
esf:opportunityCount a dqv:value .
esf:stage a dcterms:type .
esf:stageStanding a dqv:value .
esf:authority "OBSERVE|VERIFY" ; esf:consequentialDo "PROHIBITED" .
