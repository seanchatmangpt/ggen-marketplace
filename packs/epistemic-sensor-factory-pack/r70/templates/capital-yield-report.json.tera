{
  "schema": "ggen.epistemic.autocatalytic-capital-yield/1",
  "authority": "OBSERVE|SELECT|CONSTRUCT|VERIFY",
  "consequential_do": false,
  "runs": [
  {% for row in rows %}{
    "subject": "{{ row.run }}",
    "seed_opportunities": {{ row.seeds }},
    "caused_opportunities": {{ row.caused }},
    "generation_depth": {{ row.depth }},
    "branching_factor": {{ row.branching }},
    "independent_consumers": {{ row.independentConsumers }},
    "qualified_consumers": {{ row.qualifiedConsumers }},
    "E": {{ row.exploration }},
    "E2": {{ row.executableExploration }},
    "Y": {{ row.yield }},
    "R": {{ row.replication }},
    "C": {{ row.autocatalytic }},
    "M": {{ row.memory }},
    "H6_proxy": {{ row.h6 }},
    "thousand_x_admitted": {{ row.thousandX }}
  }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
