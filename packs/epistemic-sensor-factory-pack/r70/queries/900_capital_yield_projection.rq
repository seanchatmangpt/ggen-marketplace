PREFIX acy: <https://chatman.ai/ontology/autocatalytic-capital-yield#>
SELECT ?run ?seeds ?caused ?depth ?branching ?independentConsumers ?qualifiedConsumers ?memory ?replication ?autocatalytic ?exploration ?executableExploration ?yield ?h6 ?thousandX WHERE {
  ?run a acy:ManufacturingRun ;
    acy:seedOpportunityCount ?seeds ;
    acy:causedOpportunityCount ?caused ;
    acy:generationDepth ?depth ;
    acy:branchingFactor ?branching ;
    acy:independentConsumerCount ?independentConsumers ;
    acy:qualifiedConsumerCount ?qualifiedConsumers ;
    acy:memoryMultiplier ?memory ;
    acy:replicationMultiplier ?replication ;
    acy:autocatalyticGain ?autocatalytic ;
    acy:explorationMultiplier ?exploration ;
    acy:executableExplorationMultiplier ?executableExploration ;
    acy:capitalYield ?yield ;
    acy:h6Proxy ?h6 ;
    acy:thousandXAdmitted ?thousandX .
}
ORDER BY ?run
