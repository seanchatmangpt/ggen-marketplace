@prefix acy: <https://chatman.ai/ontology/autocatalytic-capital-yield#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

acy:ManufacturingRun a rdfs:Class .
acy:CapitalObservation a rdfs:Class ; rdfs:subClassOf dqv:QualityMeasurement .

# R70 measures causal manufacturing capital rather than raw activity. Each
# metric is observational; none grants ambient DO authority.
acy:seedOpportunityCount a rdf:Property .
acy:causedOpportunityCount a rdf:Property .
acy:generationDepth a rdf:Property .
acy:branchingFactor a rdf:Property .
acy:independentConsumerCount a rdf:Property .
acy:qualifiedConsumerCount a rdf:Property .
acy:consumerTargetCount a rdf:Property .
acy:mergeCount a rdf:Property .
acy:semanticCommitCount a rdf:Property .
acy:factoryCount a rdf:Property .
acy:reusableFactoryCount a rdf:Property .
acy:memoryRecordsConsumed a rdf:Property .
acy:memoryEdgesUnlocked a rdf:Property .
acy:avoidedRediscoveryCount a rdf:Property .
acy:receiptCount a rdf:Property .
acy:replaySuccessCount a rdf:Property .
acy:falsifierCount a rdf:Property .
acy:qualificationCourtCount a rdf:Property .
acy:exactHeadQualifiedCount a rdf:Property .
acy:containmentProofCount a rdf:Property .
acy:publicOntologyCount a rdf:Property .
acy:packReuseCount a rdf:Property .
acy:consumerAdoptionCount a rdf:Property .
acy:causallyAttributedActionCount a rdf:Property .
acy:downstreamQualifiedActionCount a rdf:Property .
acy:dependencyReliefCount a rdf:Property .
acy:currentFrontierCount a rdf:Property .
acy:staleMemoryCount a rdf:Property .
acy:repairedFailureCount a rdf:Property .
acy:generatedConsequenceCount a rdf:Property .
acy:handEditedGeneratedCount a rdf:Property .
acy:authorityViolationCount a rdf:Property .
acy:refusedEdgeCount a rdf:Property .
acy:parkedAuthorityCount a rdf:Property .
acy:unknownEdgeCount a rdf:Property .
acy:partialAliveEdgeCount a rdf:Property .
acy:aliveEdgeCount a rdf:Property .
acy:buildBrokenEdgeCount a rdf:Property .
acy:qualificationLatencySeconds a rdf:Property .
acy:mergeLatencySeconds a rdf:Property .
acy:yieldPerSeed a rdf:Property .
acy:yieldPerMerge a rdf:Property .
acy:independentYield a rdf:Property .
acy:memoryMultiplier a rdf:Property .
acy:replicationMultiplier a rdf:Property .
acy:autocatalyticGain a rdf:Property .
acy:explorationMultiplier a rdf:Property .
acy:executableExplorationMultiplier a rdf:Property .
acy:capitalYield a rdf:Property .
acy:h6Proxy a rdf:Property .
acy:thousandXAdmitted a rdf:Property .
acy:actuationPerformed a rdf:Property .
