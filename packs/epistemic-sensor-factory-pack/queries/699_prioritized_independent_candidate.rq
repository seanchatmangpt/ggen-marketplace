PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo ?head ?runtime ?failure ?authority ?receipt ?qualification ?standing WHERE {
  ?p a esf:ConsumerIndependenceProfile ; esf:candidateRepo ?repo ; esf:candidateHead ?head ; esf:runtimeFamily ?runtime ; esf:failureDomain ?failure ; esf:authorityDomain ?authority ; esf:receiptProtocol ?receipt ; esf:qualificationFamily ?qualification ; esf:admissionStanding ?standing .
  FILTER(?standing != "ADMITTED")
}
ORDER BY DESC(?standing) ?runtime ?failure ?authority ?receipt ?qualification ?repo
LIMIT 1
