PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?p ?repo ?runtime ?failure ?authority WHERE {
  ?p a esf:ConsumerIndependenceProfile ; esf:candidateRepo ?repo ; esf:runtimeFamily ?runtime ; esf:failureDomain ?failure ; esf:authorityDomain ?authority ; esf:identityVerified true ; esf:authorityBounded true ; esf:replayCapable true ; esf:noAmbientDo true ; esf:admissionStanding ?standing .
  FILTER(?standing != "ADMITTED")
} ORDER BY ?runtime ?failure ?authority STR(?repo) LIMIT 1
