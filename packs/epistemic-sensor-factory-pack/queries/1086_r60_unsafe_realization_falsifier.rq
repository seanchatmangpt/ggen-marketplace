PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?plan ?candidate WHERE { ?plan a esf:ConsumerRealizationPlan ; esf:realizedFor ?candidate . FILTER(!EXISTS { ?plan esf:noAmbientDo true } || !EXISTS { ?candidate esf:authorityBounded true } || !EXISTS { ?candidate esf:noAmbientDo true }) }
