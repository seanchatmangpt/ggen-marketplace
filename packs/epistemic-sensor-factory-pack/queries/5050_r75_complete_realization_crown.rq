PREFIX r75: <https://ggen.dev/implement/r75#>
SELECT (COUNT(?r) AS ?complete) WHERE { ?r a r75:StructuralRealization ; r75:sourceStructure ?source ; r75:desiredStructure ?desired ; r75:usesPack ?pack ; r75:usesGenerator ?generator ; r75:generatedArtifact ?artifact ; r75:generatedIdentity ?identity ; r75:consumer ?consumer ; r75:qualification ?qualification ; r75:receipt ?receipt ; r75:standing "ALIVE" ; r75:exactHead ?head ; r75:deterministic true ; r75:displaced true ; r75:supersededBy ?replacement ; r75:revenueFromEvidence ?from ; r75:revenueForEvidence ?for ; r75:throughputReceipt ?throughput ; r75:memoryReceipt ?memory ; r75:causalValueEdge ?value ; r75:consequentialDo false . }
