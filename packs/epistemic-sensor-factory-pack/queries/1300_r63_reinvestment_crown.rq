PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(DISTINCT ?e) AS ?subjects) (COUNT(DISTINCT ?repo) AS ?consumers) (COUNT(DISTINCT ?root) AS ?roots) (SUM(?delta) AS ?totalRelief) (SUM(?n) AS ?totalUnlocks) WHERE { ?e a esf:DependencyReliefEvidence ; esf:consumerRepository ?repo ; esf:evidenceRoot ?root ; esf:reliefDelta ?delta ; esf:actionableOpportunities ?n ; esf:currentSubject true ; esf:replayVerified true ; esf:qualificationReceiptPresent true ; esf:falsifierPresent true ; esf:generatedProjection true . FILTER(?delta > 0 && ?n > 0) }
