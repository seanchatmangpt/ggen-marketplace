PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?positive ?repositories WHERE { { SELECT (COUNT(?e) AS ?positive) WHERE { ?e a esf:DependencyReliefEvidence ; esf:reliefDelta ?d . FILTER(?d > 0) } } { SELECT (COUNT(DISTINCT ?repo) AS ?repositories) WHERE { ?e a esf:DependencyReliefEvidence ; esf:consumerRepository ?repo ; esf:reliefDelta ?d . FILTER(?d > 0) } } FILTER(?positive > 1 && ?repositories <= 1) }
