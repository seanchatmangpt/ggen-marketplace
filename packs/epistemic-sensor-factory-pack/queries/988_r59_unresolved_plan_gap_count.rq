PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?plan) AS ?count) WHERE { ?plan a esf:ConsumerRealizationPlan . FILTER(!EXISTS { ?plan esf:projectionPath ?p } || !EXISTS { ?plan esf:qualificationCommand ?q } || !EXISTS { ?plan esf:receiptPath ?r } || !EXISTS { ?plan esf:replayPath ?x } || !EXISTS { ?plan esf:rollbackCommand ?b }) }
