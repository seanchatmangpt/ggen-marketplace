PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e ?repo ?d ?opportunities WHERE { ?e a esf:DependencyReliefEvidence ; esf:consumerRepository ?repo ; esf:reliefDelta ?d ; esf:actionableOpportunities ?opportunities . FILTER(?d > 0 && ?opportunities > 0) } ORDER BY DESC(?d) DESC(?opportunities)
