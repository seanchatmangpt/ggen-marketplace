PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e ?d ?opportunities WHERE { ?e a esf:DependencyReliefEvidence ; esf:currentSubject true ; esf:replayVerified true ; esf:qualificationReceiptPresent true ; esf:falsifierPresent true ; esf:generatedProjection true ; esf:reliefDelta ?d ; esf:actionableOpportunities ?opportunities . FILTER(?d > 0 && ?opportunities > 0) }
