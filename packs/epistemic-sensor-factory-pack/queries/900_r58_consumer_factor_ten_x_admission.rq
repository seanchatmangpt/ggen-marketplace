PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(DISTINCT ?c) AS ?consumerFactor) WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:admissionStanding "ALIVE" ; esf:admittedTarget ?t ; esf:authorityBounded true ; esf:noAmbientDo true ; esf:publicOntologyAligned true . ?t esf:crossRepository true . } HAVING(COUNT(DISTINCT ?c) >= 10)
