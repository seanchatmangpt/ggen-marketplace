PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?family (COUNT(?c) AS ?candidates) (COUNT(?ready) AS ?strong_ready) WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:consumerFamily ?family . OPTIONAL { ?ready a esf:ConsumerAdmissionCandidate ; esf:consumerFamily ?family ; esf:receiptReturnCapable true ; esf:ggenManufacturable true ; esf:dependencyClosed true . } } GROUP BY ?family ORDER BY ?family
