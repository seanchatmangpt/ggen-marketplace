PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?plan) AS ?count) WHERE { ?plan a esf:ConsumerRealizationPlan ; esf:targetBound true ; esf:exactTargetHead ?h ; esf:projectionPath ?p ; esf:qualificationCommand ?q ; esf:receiptPath ?r ; esf:replayPath ?x ; esf:rollbackCommand ?b ; esf:standingInherited false ; esf:authorityInherited false ; esf:noAmbientDo true . }
