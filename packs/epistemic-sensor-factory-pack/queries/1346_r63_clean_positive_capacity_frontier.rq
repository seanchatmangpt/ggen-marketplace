PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e ?repo ?ref ?d ?n WHERE { ?e a esf:DependencyReliefEvidence ; esf:consumerRepository ?repo ; esf:consumerRef ?ref ; esf:reliefDelta ?d ; esf:actionableOpportunities ?n ; esf:requestObservedAt ?request ; esf:executionObservedAt ?execution . FILTER(?d > 0 && ?n > 0 && ?execution >= ?request) } ORDER BY DESC(?n) DESC(?d)
