PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?candidate ?sha ?score ?yield ?relief ?fanout ?unlocks WHERE {
  ?candidate a esf:EpistemicInvestmentCandidate ; esf:subjectSha ?sha ; esf:current true ; esf:exactSubjectBound true ; esf:authorityBoundedObservation true ; esf:evidenceRootCountR65 ?roots ; esf:reinvestmentScore ?score ; esf:realizedYield ?yield ; esf:realizedRelief ?relief ; esf:consumerFanout ?fanout ; esf:dependencyUnlockCount ?unlocks .
  FILTER(?roots >= 2 && ?score >= 0.6)
} ORDER BY DESC(?score) STR(?candidate)
