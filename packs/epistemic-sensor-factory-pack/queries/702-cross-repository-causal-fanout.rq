PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?consumer (COUNT(DISTINCT ?target) AS ?fanout) WHERE {
  ?edge a esf:PropagationEdge ; esf:sourceConsumer ?consumer ; esf:causedOpportunity ?opportunity .
  ?opportunity esf:targetRepo ?target .
  ?consumer esf:crossRepository true .
}
GROUP BY ?consumer
ORDER BY DESC(?fanout) ?consumer
