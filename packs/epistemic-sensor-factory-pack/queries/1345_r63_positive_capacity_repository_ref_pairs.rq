PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(DISTINCT CONCAT(STR(?repo), "@", STR(?ref))) AS ?pairs) WHERE { ?e a esf:DependencyReliefEvidence ; esf:consumerRepository ?repo ; esf:consumerRef ?ref ; esf:reliefDelta ?d ; esf:actionableOpportunities ?n . FILTER(?d > 0 && ?n > 0) }
