PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?o ?product ?delta WHERE { ?o a esf:ProductionFunctionObservation ; esf:observationFactor ?a ; esf:reuseFactor ?b ; esf:opportunityFactor ?c ; esf:multiplicativeProduct ?product ; esf:frontierDelta ?delta ; esf:factorIndependentRoots ?roots ; esf:multiplierAdmitted true . FILTER(?a >= 10 && ?b >= 10 && ?c >= 10 && ?product >= 1000 && ?delta > 0 && ?roots >= 2) }
