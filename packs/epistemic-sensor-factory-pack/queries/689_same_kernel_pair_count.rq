PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?count) WHERE { ?a a esf:ConsumerIndependenceProfile ; esf:candidateRepo ?ra ; esf:executionKernel ?v . ?b a esf:ConsumerIndependenceProfile ; esf:candidateRepo ?rb ; esf:executionKernel ?v . FILTER(STR(?ra) < STR(?rb)) }
