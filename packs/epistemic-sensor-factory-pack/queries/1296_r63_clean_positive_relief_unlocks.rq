PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e ?delta ?n WHERE { ?e a esf:DependencyReliefEvidence ; esf:reliefDelta ?delta ; esf:actionableOpportunities ?n ; esf:currentSubject true ; esf:replayVerified true ; esf:qualificationReceiptPresent true ; esf:falsifierPresent true ; esf:generatedProjection true . FILTER(?delta > 0 && ?n > 0) }
