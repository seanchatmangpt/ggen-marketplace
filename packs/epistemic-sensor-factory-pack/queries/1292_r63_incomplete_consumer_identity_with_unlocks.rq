PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e ?n WHERE { ?e a esf:DependencyReliefEvidence ; esf:actionableOpportunities ?n . FILTER(?n > 0) FILTER(!EXISTS { ?e esf:consumerRepository ?repo } || !EXISTS { ?e esf:consumerRef ?ref } || !EXISTS { ?e esf:consumerSha ?sha }) }
