PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?m ((1-(?realized/?predicted)) + (1-?receipt) AS ?priority) WHERE { ?m a esf:RealizationCalibrationMeasurement ; esf:predictedConsumerFanout ?predicted ; esf:realizedConsumerFanout ?realized ; esf:consumerReceiptCoverage ?receipt . FILTER(?predicted>0) } ORDER BY DESC(?priority)
