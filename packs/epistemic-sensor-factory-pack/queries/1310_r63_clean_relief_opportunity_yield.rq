PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (SUM(?opportunities) AS ?cleanYield) WHERE { ?e a esf:DependencyReliefEvidence ; esf:currentSubject true ; esf:replayVerified true ; esf:qualificationReceiptPresent true ; esf:falsifierPresent true ; esf:generatedProjection true ; esf:reliefDelta ?d ; esf:actionableOpportunities ?opportunities . FILTER(?d > 0) }
