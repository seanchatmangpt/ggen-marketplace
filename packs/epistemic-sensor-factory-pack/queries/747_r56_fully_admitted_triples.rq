PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?admittedTriples) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:admissionStanding "ADMITTED" .
  ?b a esf:ConsumerAdmissionCandidate ; esf:admissionStanding "ADMITTED" .
  ?c a esf:ConsumerAdmissionCandidate ; esf:admissionStanding "ADMITTED" .
  FILTER(STR(?a) < STR(?b) && STR(?b) < STR(?c))
}
