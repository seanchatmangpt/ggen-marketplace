PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e (?reuse * ?observation * ?opportunity AS ?factorProduct) WHERE { ?e a esf:DependencyReliefEvidence ; esf:observedReuseFactor ?reuse ; esf:observedObservationFactor ?observation ; esf:observedOpportunityFactor ?opportunity . }
