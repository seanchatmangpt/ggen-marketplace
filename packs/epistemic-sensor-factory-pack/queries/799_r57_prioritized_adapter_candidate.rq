PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?c ?repo WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:candidateRepo ?repo ; esf:adapterRequired true ; esf:identityVerified true ; esf:authorityBounded true ; esf:publicOntologyAligned true ; esf:noAmbientDo true ; esf:receiptReturnCapable ?rr ; esf:ggenManufacturable ?gm ; esf:dependencyClosed ?dc ; esf:generatedProjectionCapable ?gp . FILTER(!?rr || !?gm || !?dc || !?gp) } ORDER BY ?repo LIMIT 1