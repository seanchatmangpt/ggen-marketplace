PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo (COUNT(?receipt) AS ?receipts) WHERE { ?consumer a esf:ExactSubject ; esf:observedInRepo ?repo ; esf:consumerHead ?head . ?receipt a esf:ConsumerReceiptAssertion ; esf:consumerHead ?head . } GROUP BY ?repo ORDER BY DESC(?receipts)
