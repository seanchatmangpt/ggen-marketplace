PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?candidate (?consumers * ?unlocks * ?memory AS ?observedProduct) WHERE { ?candidate a esf:EpistemicInvestmentCandidate ; esf:consumerFanout ?consumers ; esf:dependencyUnlockCount ?unlocks ; esf:memoryReuseCount ?memory . FILTER((?consumers * ?unlocks * ?memory) < 1000) }
