PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?receipt ?check ?conclusion WHERE { ?check a dqv:QualityMeasurement ; prov:wasGeneratedBy ?receipt ; esf:checkConclusion ?conclusion . ?receipt a esf:QualifiedConsumerReceipt . FILTER(LCASE(STR(?conclusion)) != "success") }
