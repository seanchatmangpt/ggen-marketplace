PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?plan) AS ?count) WHERE { ?plan a esf:ConsumerRealizationPlan ; esf:realizedFor ?candidate ; esf:artifactFamily ?family ; esf:exactTargetHead ?head ; esf:projectionPath ?projection ; esf:qualificationCommand ?qualify ; esf:receiptPath ?receipt ; esf:replayPath ?replay ; esf:rollbackCommand ?rollback ; esf:targetBound true ; esf:manufacturingStanding "READY" ; esf:standingInherited false ; esf:authorityInherited false ; esf:noAmbientDo true . ?candidate a esf:ConsumerAdmissionCandidate ; esf:receiptReturnCapable true ; esf:replayCapable true ; esf:ggenManufacturable true ; esf:dependencyClosed true ; esf:publicOntologyAligned true ; esf:authorityBounded true ; esf:noAmbientDo true ; esf:admittedTarget ?target . ?target a esf:ReplicationTarget ; esf:crossRepository true . FILTER(STRLEN(STR(?head)) = 40) }
