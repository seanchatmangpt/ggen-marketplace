PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e ?n WHERE { ?e a esf:DependencyReliefEvidence ; esf:actionableOpportunities ?n . FILTER(?n > 0) FILTER(!EXISTS { ?e esf:requestObservedAt ?r } || !EXISTS { ?e esf:executionObservedAt ?x } || !EXISTS { ?e esf:receiptObservedAt ?p } || !EXISTS { ?e esf:reliefObservedAt ?l }) }
