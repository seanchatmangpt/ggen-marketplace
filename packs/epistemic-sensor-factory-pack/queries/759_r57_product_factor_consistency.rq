PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?o ?product ?expected WHERE { ?o a esf:ProductionFunctionObservation ; esf:observationFactor ?a ; esf:reuseFactor ?b ; esf:opportunityFactor ?c ; esf:multiplicativeProduct ?product . BIND((?a * ?b * ?c) AS ?expected) FILTER(?product != ?expected) }
