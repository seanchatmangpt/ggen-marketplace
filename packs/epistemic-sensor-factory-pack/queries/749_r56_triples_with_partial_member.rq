PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?triplesWithPartial) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:admissionStanding ?as .
  ?b a esf:ConsumerAdmissionCandidate ; esf:admissionStanding ?bs .
  ?c a esf:ConsumerAdmissionCandidate ; esf:admissionStanding ?cs .
  FILTER(STR(?a) < STR(?b) && STR(?b) < STR(?c))
  FILTER(?as = "PARTIAL_ALIVE" || ?bs = "PARTIAL_ALIVE" || ?cs = "PARTIAL_ALIVE")
}
