PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?receiptBridgePairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:receiptReturnCapable ?aCapable .
  ?b a esf:ConsumerAdmissionCandidate ; esf:receiptReturnCapable ?bCapable .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aCapable != ?bCapable)
}
