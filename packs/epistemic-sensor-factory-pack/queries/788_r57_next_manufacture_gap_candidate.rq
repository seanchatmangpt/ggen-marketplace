PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?c ?repo WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:candidateRepo ?repo ; esf:adapterRequired true ; esf:ggenManufacturable false ; esf:identityVerified true ; esf:authorityBounded true ; esf:publicOntologyAligned true . } ORDER BY ?repo LIMIT 1