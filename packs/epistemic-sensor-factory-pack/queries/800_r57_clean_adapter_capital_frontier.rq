PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?c ?repo ?rr ?gm ?dc ?gp WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:candidateRepo ?repo ; esf:adapterRequired true ; esf:candidateHead ?head ; esf:currentDefaultHead ?head ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:publicOntologyAligned true ; esf:replayCapable true ; esf:noAmbientDo true ; esf:receiptReturnCapable ?rr ; esf:ggenManufacturable ?gm ; esf:dependencyClosed ?dc ; esf:generatedProjectionCapable ?gp . } ORDER BY ?rr ?gm ?dc ?gp ?repo