PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?e) AS ?count) WHERE { ?e a esf:DependencyReliefEvidence ; esf:reliefDelta ?d ; esf:actionableOpportunities ?n ; esf:consumerRepository ?repo ; esf:consumerRef ?ref ; esf:requestObservedAt ?request ; esf:executionObservedAt ?execution }
