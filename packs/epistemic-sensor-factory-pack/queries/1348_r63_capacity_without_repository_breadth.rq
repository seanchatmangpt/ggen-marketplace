PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?capacity ?repositories WHERE { { SELECT (SUM(?n) AS ?capacity) WHERE { ?e a esf:DependencyReliefEvidence ; esf:actionableOpportunities ?n } } { SELECT (COUNT(DISTINCT ?repo) AS ?repositories) WHERE { ?e a esf:DependencyReliefEvidence ; esf:consumerRepository ?repo ; esf:actionableOpportunities ?n . FILTER(?n > 0) } } FILTER(?capacity > 0 && ?repositories <= 1) }
