PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?sensor ?family ?metric ?pattern ?opportunity WHERE {
  ?sensor a esf:SensorSpec ;
    esf:family ?family ;
    esf:metric ?metric ;
    esf:queryPattern ?pattern ;
    esf:opportunityKind ?opportunity .
}
ORDER BY ?family ?sensor
