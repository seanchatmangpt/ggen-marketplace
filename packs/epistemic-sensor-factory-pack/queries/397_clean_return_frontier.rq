PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?consumer ?head WHERE { ?consumer a esf:ExactSubject ; esf:consumerHead ?head ; esf:standing ?standing . ?standing a esf:ReturnedConsumerStanding ; esf:consumerStandingValue "ALIVE" ; esf:replayVerified true ; esf:evidenceRootCount ?roots . FILTER(?roots >= 2) }
