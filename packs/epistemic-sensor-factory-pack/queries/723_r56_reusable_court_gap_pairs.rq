PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?courtReuseGapPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:courtReusable ?aReusable .
  ?b a esf:ConsumerAdmissionCandidate ; esf:courtReusable ?bReusable .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aReusable != ?bReusable)
}
