PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (SUM(?opportunities) AS ?yield) WHERE { ?e a esf:DependencyReliefEvidence ; esf:currentSubject true ; esf:replayVerified true ; esf:qualificationReceiptPresent true ; esf:falsifierPresent true ; esf:requestAt ?request ; esf:executionAt ?execution ; esf:receiptAt ?receipt ; esf:reliefObservedAt ?relief ; esf:actionableOpportunities ?opportunities . FILTER(?request <= ?execution && ?execution <= ?receipt && ?receipt <= ?relief) }
