PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?c ?repo ?family WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:candidateRepo ?repo ; esf:consumerFamily ?family ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:receiptReturnCapable true ; esf:publicOntologyAligned true ; esf:ggenManufacturable true ; esf:replayCapable true ; esf:dependencyClosed true ; esf:noAmbientDo true ; esf:generatedProjectionCapable true . } ORDER BY ?family ?repo ?c