PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (SUM(?currentOpp) AS ?currentYield) (SUM(?allOpp) AS ?totalYield) WHERE { { SELECT (SUM(?o) AS ?allOpp) WHERE { ?a a esf:DependencyReliefEvidence ; esf:actionableOpportunities ?o . } } { SELECT (SUM(?o2) AS ?currentOpp) WHERE { ?b a esf:DependencyReliefEvidence ; esf:currentSubject true ; esf:actionableOpportunities ?o2 . } } }
