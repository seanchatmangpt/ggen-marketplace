PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?c) AS ?weak_ready) WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:publicOntologyAligned true ; esf:replayCapable true ; esf:noAmbientDo true . FILTER NOT EXISTS { ?c esf:receiptReturnCapable true ; esf:ggenManufacturable true ; esf:dependencyClosed true . } }
