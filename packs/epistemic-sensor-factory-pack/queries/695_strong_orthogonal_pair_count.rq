PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?count) WHERE {
  ?a a esf:ConsumerIndependenceProfile ; esf:identityVerified true ; esf:authorityBounded true ; esf:replayCapable true ; esf:noAmbientDo true ; esf:runtimeFamily ?ar ; esf:failureDomain ?af ; esf:authorityDomain ?aa ; esf:receiptProtocol ?ap .
  ?b a esf:ConsumerIndependenceProfile ; esf:identityVerified true ; esf:authorityBounded true ; esf:replayCapable true ; esf:noAmbientDo true ; esf:runtimeFamily ?br ; esf:failureDomain ?bf ; esf:authorityDomain ?ba ; esf:receiptProtocol ?bp .
  FILTER(STR(?a) < STR(?b) && ?ar != ?br && ?af != ?bf && ?aa != ?ba && ?ap != ?bp)
}
