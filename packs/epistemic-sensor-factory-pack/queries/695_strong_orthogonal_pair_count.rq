PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?count) WHERE {
  ?a a esf:ConsumerIndependenceProfile ; esf:candidateRepo ?ra ; esf:runtimeFamily ?ar ; esf:failureDomain ?af ; esf:authorityDomain ?aa ; esf:receiptProtocol ?ap ; esf:qualificationFamily ?aq ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:receiptReturnCapable true ; esf:publicOntologyAligned true ; esf:ggenManufacturable true ; esf:replayCapable true ; esf:dependencyClosed true ; esf:noAmbientDo true .
  ?b a esf:ConsumerIndependenceProfile ; esf:candidateRepo ?rb ; esf:runtimeFamily ?br ; esf:failureDomain ?bf ; esf:authorityDomain ?ba ; esf:receiptProtocol ?bp ; esf:qualificationFamily ?bq ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:receiptReturnCapable true ; esf:publicOntologyAligned true ; esf:ggenManufacturable true ; esf:replayCapable true ; esf:dependencyClosed true ; esf:noAmbientDo true .
  FILTER(STR(?ra) < STR(?rb) && ?ar != ?br && ?af != ?bf && ?aa != ?ba && ?ap != ?bp && ?aq != ?bq)
}
