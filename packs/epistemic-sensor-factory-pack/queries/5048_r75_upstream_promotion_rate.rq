PREFIX r75: <https://ggen.dev/implement/r75#>
SELECT (COUNT(DISTINCT ?generalizable) AS ?generalizable) (COUNT(DISTINCT ?promoted) AS ?promoted) WHERE { OPTIONAL { ?generalizable a r75:StructuralRealization ; r75:generalizable true . } OPTIONAL { ?promoted a r75:StructuralRealization ; r75:generalizable true ; r75:promoted ?promotion . } }
