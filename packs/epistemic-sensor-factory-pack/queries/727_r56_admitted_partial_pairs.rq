PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?admittedPartialPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:admissionStanding ?aStanding .
  ?b a esf:ConsumerAdmissionCandidate ; esf:admissionStanding ?bStanding .
  FILTER(STR(?a) < STR(?b))
  FILTER((?aStanding = "ADMITTED" && ?bStanding = "PARTIAL_ALIVE") || (?aStanding = "PARTIAL_ALIVE" && ?bStanding = "ADMITTED"))
}
