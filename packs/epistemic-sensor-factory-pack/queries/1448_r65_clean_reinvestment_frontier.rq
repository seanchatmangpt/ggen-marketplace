PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?candidate ?score WHERE { ?candidate a esf:EpistemicInvestmentCandidate ; esf:current true ; esf:exactSubjectBound true ; esf:authorityBoundedObservation true ; esf:evidenceRootCountR65 ?roots ; esf:reinvestmentScore ?score . FILTER(?roots >= 2 && ?score >= 0.6) } ORDER BY DESC(?score)
