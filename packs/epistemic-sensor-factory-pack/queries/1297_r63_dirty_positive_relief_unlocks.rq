PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e ?delta ?n WHERE { ?e a esf:DependencyReliefEvidence ; esf:reliefDelta ?delta ; esf:actionableOpportunities ?n . FILTER(?delta > 0 && ?n > 0) FILTER(!EXISTS { ?e esf:currentSubject true } || !EXISTS { ?e esf:replayVerified true } || !EXISTS { ?e esf:qualificationReceiptPresent true } || !EXISTS { ?e esf:falsifierPresent true } || !EXISTS { ?e esf:generatedProjection true }) }
