PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?receipt ?consumerHead ?merge ?defaultHead ?standing ?relief WHERE {
  ?a a esf:ProducerAssimilation ; prov:used ?receipt ; esf:assimilationStanding "ADMITTED" ; esf:dependencyRelief ?relief .
  ?receipt a esf:QualifiedConsumerReceipt ; esf:consumerHead ?consumerHead ; esf:mergeCommit ?merge ; esf:containedByDefaultHead ?defaultHead ; esf:standing ?standing ; esf:replayVerified true ; esf:noAmbientDo true .
} ORDER BY STR(?receipt)
