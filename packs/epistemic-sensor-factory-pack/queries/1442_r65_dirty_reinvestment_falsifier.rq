PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
ASK { ?obs a esf:ProductionFunctionObservation . { ?obs esf:frontierDelta ?d . FILTER(?d <= 0) } UNION { ?obs esf:downstreamOpportunityCount 0 } UNION { ?obs esf:reusedCapabilityCount 0 } UNION { ?obs esf:factorIndependentRoots ?r . FILTER(?r < 2) } UNION { ?obs esf:replayVerified false } }
