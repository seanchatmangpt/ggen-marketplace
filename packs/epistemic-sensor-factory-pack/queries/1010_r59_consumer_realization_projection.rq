PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?plan ?candidate ?family ?head ?projection ?qualification ?receipt ?replay ?rollback WHERE {
  ?plan a esf:ConsumerRealizationPlan ;
    esf:realizedFor ?candidate ;
    esf:artifactFamily ?family ;
    esf:exactTargetHead ?head ;
    esf:projectionPath ?projection ;
    esf:qualificationCommand ?qualification ;
    esf:receiptPath ?receipt ;
    esf:replayPath ?replay ;
    esf:rollbackCommand ?rollback ;
    esf:targetBound true ;
    esf:standingInherited false ;
    esf:authorityInherited false ;
    esf:noAmbientDo true .
}
ORDER BY ?family ?candidate
