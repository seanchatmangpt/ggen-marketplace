PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ((10 - COUNT(?c)) AS ?shortfall) WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:receiptReturnCapable true ; esf:publicOntologyAligned true ; esf:ggenManufacturable true ; esf:replayCapable true ; esf:dependencyClosed true ; esf:noAmbientDo true ; esf:candidateHead ?h ; esf:currentDefaultHead ?h ; esf:admittedTarget ?target . }
