PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?runtime (COUNT(?p) AS ?profiles) (SUM(IF(?standing = "ADMITTED",1,0)) AS ?admitted) WHERE { ?p a esf:ConsumerIndependenceProfile ; esf:runtimeFamily ?runtime ; esf:admissionStanding ?standing . } GROUP BY ?runtime ORDER BY ?runtime
