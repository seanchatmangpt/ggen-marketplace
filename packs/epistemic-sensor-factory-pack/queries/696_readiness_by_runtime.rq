PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?runtime (COUNT(?p) AS ?ready) WHERE { ?p a esf:ConsumerIndependenceProfile ; esf:runtimeFamily ?runtime ; esf:identityVerified true ; esf:authorityBounded true ; esf:replayCapable true ; esf:noAmbientDo true . } GROUP BY ?runtime ORDER BY DESC(?ready) ?runtime
