PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo ?head ?standing ?priority WHERE {
  ?candidate a esf:WaveCandidate ; esf:candidateRepo ?repo ; esf:candidateHead ?head ; esf:admissionStanding ?standing ; esf:priority ?priority .
  FILTER(?standing != "ALIVE")
} ORDER BY ?priority STR(?repo)
