PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (SUM(IF(?ready,1,0))/COUNT(?c) AS ?readiness_ratio) WHERE { ?c a esf:ConsumerAdmissionCandidate . BIND(EXISTS { ?c esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:receiptReturnCapable true ; esf:noAmbientDo true . } AS ?ready) }
