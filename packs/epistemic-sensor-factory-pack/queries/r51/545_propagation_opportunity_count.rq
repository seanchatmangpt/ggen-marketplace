PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(DISTINCT ?target) AS ?opportunities) WHERE { ?target a esf:ReplicationTarget ; esf:consumerHead ?head . FILTER NOT EXISTS { ?receipt a esf:ConsumerReceiptAssertion ; esf:consumerHead ?head ; esf:replayVerified true ; esf:crossRepository true . } }
