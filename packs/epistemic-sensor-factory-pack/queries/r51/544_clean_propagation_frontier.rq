PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?receipt ?head WHERE { ?receipt a esf:ConsumerReceiptAssertion ; esf:consumerHead ?head ; esf:receiptDigest ?digest ; esf:replayVerified true ; esf:crossRepository true ; esf:dependencyRelief true ; esf:evidenceRootCount ?roots . }
