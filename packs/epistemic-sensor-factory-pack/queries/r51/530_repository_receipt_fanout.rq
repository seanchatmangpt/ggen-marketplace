PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo (COUNT(?receipt) AS ?receipts) WHERE { ?target a esf:ReplicationTarget ; esf:targetRepo ?repo ; esf:consumerHead ?head . ?receipt a esf:ConsumerReceiptAssertion ; esf:consumerHead ?head . } GROUP BY ?repo ORDER BY DESC(?receipts)
