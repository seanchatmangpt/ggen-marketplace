PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(DISTINCT ?target) AS ?targets) (COUNT(DISTINCT ?receipt) AS ?qualifiedReceipts) WHERE { ?target a esf:ReplicationTarget . OPTIONAL { ?target esf:consumerHead ?head . ?receipt a esf:ConsumerReceiptAssertion ; esf:consumerHead ?head ; esf:replayVerified true ; esf:crossRepository true ; esf:dependencyRelief true . } }
