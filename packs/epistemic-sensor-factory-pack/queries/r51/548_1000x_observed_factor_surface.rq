PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(DISTINCT ?head) AS ?consumerBreadth) (COUNT(DISTINCT ?repo) AS ?repositoryBreadth) WHERE { ?target a esf:ReplicationTarget ; esf:targetRepo ?repo ; esf:consumerHead ?head . ?receipt a esf:ConsumerReceiptAssertion ; esf:consumerHead ?head ; esf:replayVerified true ; esf:crossRepository true . }
