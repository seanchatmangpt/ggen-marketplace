PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo (COUNT(DISTINCT ?receipt) AS ?receipts) WHERE { ?target a esf:ReplicationTarget ; esf:targetRepo ?repo ; esf:consumerHead ?head . OPTIONAL { ?receipt a esf:ConsumerReceiptAssertion ; esf:consumerHead ?head . } } GROUP BY ?repo
