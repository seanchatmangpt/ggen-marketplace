PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e (?memory / ?records AS ?multiplier) WHERE { ?e a esf:DependencyReliefEvidence ; esf:currentSubject true ; esf:replayVerified true ; esf:qualificationReceiptPresent true ; esf:falsifierPresent true ; esf:memoryCausedOpportunities ?memory ; esf:memoryRecordsConsumed ?records . FILTER(?records > 0 && (?memory / ?records) >= 2) }
