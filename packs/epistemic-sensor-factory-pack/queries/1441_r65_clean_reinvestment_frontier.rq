PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
ASK { ?obs a esf:ProductionFunctionObservation ; esf:multiplierAdmitted true ; esf:frontierDelta ?delta ; esf:downstreamOpportunityCount ?opps ; esf:reusedCapabilityCount ?reuse ; esf:factorIndependentRoots ?roots ; esf:factorEvidenceCount ?evidence ; esf:replayVerified true . FILTER(?delta > 0 && ?opps > 0 && ?reuse > 0 && ?roots >= 2 && ?evidence >= 3) }
