PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?c (SUM(?score) AS ?readiness_score) WHERE { ?c a esf:ConsumerAdmissionCandidate . { BIND(IF(EXISTS { ?c esf:identityVerified true },1,0) AS ?score) } UNION { BIND(IF(EXISTS { ?c esf:authorityBounded true },1,0) AS ?score) } UNION { BIND(IF(EXISTS { ?c esf:courtReusable true },1,0) AS ?score) } UNION { BIND(IF(EXISTS { ?c esf:receiptReturnCapable true },1,0) AS ?score) } UNION { BIND(IF(EXISTS { ?c esf:ggenManufacturable true },1,0) AS ?score) } UNION { BIND(IF(EXISTS { ?c esf:dependencyClosed true },1,0) AS ?score) } UNION { BIND(IF(EXISTS { ?c esf:noAmbientDo true },1,0) AS ?score) } FILTER NOT EXISTS { ?c esf:admissionStanding "ADMITTED" . } } GROUP BY ?c ORDER BY DESC(?readiness_score) ?c
