PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?c ((IF(?receipt,0,1)+IF(?ggen,0,1)+IF(?dep,0,1)+IF(?projection,0,1)) AS ?blocker_count) WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:receiptReturnCapable ?receipt ; esf:ggenManufacturable ?ggen ; esf:dependencyClosed ?dep ; esf:generatedProjectionCapable ?projection . }
