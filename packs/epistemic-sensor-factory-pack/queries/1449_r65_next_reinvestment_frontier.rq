PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?obs ?product ?delta ?opps ?reuse WHERE { ?obs a esf:ProductionFunctionObservation ; esf:multiplierAdmitted true ; esf:multiplicativeProduct ?product ; esf:frontierDelta ?delta ; esf:downstreamOpportunityCount ?opps ; esf:reusedCapabilityCount ?reuse ; esf:factorIndependentRoots ?roots ; esf:factorEvidenceCount ?evidence ; esf:replayVerified true . FILTER(?product > 1 && ?delta > 0 && ?opps > 0 && ?reuse > 0 && ?roots >= 2 && ?evidence >= 3) } ORDER BY DESC(?product) DESC(?delta) DESC(?opps) DESC(?reuse) LIMIT 25
