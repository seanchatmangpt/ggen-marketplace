PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e ?request ?execution ?receipt ?relief ?n WHERE { ?e a esf:DependencyReliefEvidence ; esf:requestObservedAt ?request ; esf:executionObservedAt ?execution ; esf:receiptObservedAt ?receipt ; esf:reliefObservedAt ?relief ; esf:actionableOpportunities ?n . FILTER(?n > 0) }
