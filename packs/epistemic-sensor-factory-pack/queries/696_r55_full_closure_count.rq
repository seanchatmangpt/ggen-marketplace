PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?c) AS ?full_closure_count) WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:receiptReturnCapable true ; esf:publicOntologyAligned true ; esf:ggenManufacturable true ; esf:replayCapable true ; esf:dependencyClosed true ; esf:noAmbientDo true ; esf:generatedProjectionCapable true ; esf:producerTargetToken ?token ; esf:qualificationPath ?path ; esf:admittedTarget ?target . }
