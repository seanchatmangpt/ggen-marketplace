PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(DISTINCT ?aliveTarget) AS ?aliveTargets) (COUNT(DISTINCT ?target) AS ?allTargets) WHERE { ?target a esf:ReplicationTarget . OPTIONAL { ?sensor a esf:ManufacturedSensor ; esf:observedInRepo ?aliveTarget ; esf:standing "ALIVE" . ?aliveTarget a esf:ReplicationTarget . } }
