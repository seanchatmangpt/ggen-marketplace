PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?measurement ?fanout ?roots ?returned ?assimilated ?yield ?relief ?score ?receiptCoverage ?assimilationCoverage WHERE {
  ?measurement a esf:RealizationCalibrationMeasurement ;
    esf:realizedConsumerFanout ?fanout ;
    esf:independentConsumerRootCount ?roots ;
    esf:returnedReceiptCount ?returned ;
    esf:assimilatedReceiptCount ?assimilated ;
    esf:realizedOpportunityYieldR66 ?yield ;
    esf:realizedDependencyReliefR66 ?relief ;
    esf:realizedEpistemicScore ?score ;
    esf:consumerReceiptCoverage ?receiptCoverage ;
    esf:receiptAssimilationCoverage ?assimilationCoverage .
} ORDER BY DESC(?score) STR(?measurement)
