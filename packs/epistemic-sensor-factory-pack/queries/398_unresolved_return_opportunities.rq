PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?consumer WHERE { ?consumer a esf:ExactSubject ; esf:standing ?standing . ?standing esf:consumerStandingValue ?value . FILTER(?value != "ALIVE") FILTER NOT EXISTS { ?receipt a esf:ConsumerReceiptAssertion ; esf:consumerHead ?head . ?consumer esf:consumerHead ?head . ?a a esf:ProducerAssimilation ; prov:used ?receipt . } }
