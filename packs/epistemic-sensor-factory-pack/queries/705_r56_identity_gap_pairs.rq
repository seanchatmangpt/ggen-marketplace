PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?identityGapPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:identityVerified ?aVerified .
  ?b a esf:ConsumerAdmissionCandidate ; esf:identityVerified ?bVerified .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aVerified != ?bVerified)
}
