PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?c) AS ?independently_admissible) WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:receiptReturnCapable true ; esf:publicOntologyAligned true ; esf:ggenManufacturable true ; esf:replayCapable true ; esf:dependencyClosed true ; esf:noAmbientDo true ; esf:admittedTarget ?target . }
