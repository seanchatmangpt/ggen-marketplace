PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?c ?repo WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:candidateRepo ?repo ; esf:adapterRequired true ; esf:admissionStanding "PARTIAL_ALIVE" ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:publicOntologyAligned true ; esf:replayCapable true ; esf:noAmbientDo true . } ORDER BY ?repo