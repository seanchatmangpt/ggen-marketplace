PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?adapterMixedPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:adapterRequired ?aAdapter .
  ?b a esf:ConsumerAdmissionCandidate ; esf:adapterRequired ?bAdapter .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aAdapter != ?bAdapter)
}
