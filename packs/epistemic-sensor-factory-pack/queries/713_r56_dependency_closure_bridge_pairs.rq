PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?closureBridgePairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:dependencyClosed ?aClosed .
  ?b a esf:ConsumerAdmissionCandidate ; esf:dependencyClosed ?bClosed .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aClosed != ?bClosed)
}
