PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ((10 - COUNT(?c)) AS ?independently_ready_shortfall) WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:admissionStanding "ADMITTED" ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:receiptReturnCapable true ; esf:publicOntologyAligned true ; esf:ggenManufacturable true ; esf:replayCapable true ; esf:dependencyClosed true ; esf:noAmbientDo true ; esf:generatedProjectionCapable true ; esf:producerTargetToken ?token ; esf:qualificationPath ?path ; esf:admittedTarget ?target . }
