PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?c ?repo ?family ?standing WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:candidateRepo ?repo ; esf:consumerFamily ?family ; esf:admissionStanding ?standing ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:publicOntologyAligned true ; esf:replayCapable true ; esf:noAmbientDo true . } ORDER BY ?standing ?family ?repo
