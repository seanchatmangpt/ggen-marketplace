PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?edge ?consumer ?consumerSha ?opportunity ?targetRepo ?confidence WHERE {
  ?edge a esf:PropagationEdge ; esf:sourceConsumer ?consumer ; esf:causedOpportunity ?opportunity ; esf:causalWitness ?witness ; esf:standingTransferred false ; esf:authorityTransferred false .
  ?consumer a esf:ExactSubject ; esf:subjectSha ?consumerSha .
  ?opportunity esf:targetRepo ?targetRepo .
  ?witness esf:causalConfidence ?confidence ; esf:independentTargetRoot ?root .
  FILTER(?confidence >= 0.5)
} ORDER BY ?targetRepo ?consumerSha
