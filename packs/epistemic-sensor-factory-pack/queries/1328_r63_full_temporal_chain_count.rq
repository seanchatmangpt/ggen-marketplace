PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?e) AS ?count) WHERE { ?e a esf:DependencyReliefEvidence ; esf:requestAt ?request ; esf:executionAt ?execution ; esf:receiptAt ?receipt ; esf:reliefObservedAt ?relief . FILTER(?request <= ?execution && ?execution <= ?receipt && ?receipt <= ?relief) }
