PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (?receipts * ?fanout AS ?observedProduct) (1000 - (?receipts * ?fanout) AS ?shortfall) WHERE { { SELECT (COUNT(DISTINCT ?r) AS ?receipts) (COUNT(DISTINCT ?c) AS ?fanout) WHERE { ?a a esf:ProducerAssimilation ; <http://www.w3.org/ns/prov#used> ?r ; esf:nextWave ?wave . ?c a esf:WaveCandidate ; esf:admittedTarget ?wave . } } }
