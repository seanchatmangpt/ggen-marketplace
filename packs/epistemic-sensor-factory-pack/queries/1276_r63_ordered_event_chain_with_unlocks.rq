PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e ?n WHERE { ?e a esf:DependencyReliefEvidence ; esf:requestObservedAt ?request ; esf:executionObservedAt ?execution ; esf:receiptObservedAt ?receipt ; esf:reliefObservedAt ?relief ; esf:actionableOpportunities ?n . FILTER(?request <= ?execution && ?execution <= ?receipt && ?receipt <= ?relief && ?n > 0) }
