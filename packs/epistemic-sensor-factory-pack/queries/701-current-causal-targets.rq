PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?edge ?consumer ?target WHERE {
  ?edge a esf:PropagationEdge ; esf:sourceConsumer ?consumer ; esf:causedOpportunity ?opportunity .
  ?opportunity esf:targetRepo ?target .
  ?consumer esf:consumerHead ?head ; esf:currentDefaultHead ?head .
}
ORDER BY ?consumer ?target ?edge
