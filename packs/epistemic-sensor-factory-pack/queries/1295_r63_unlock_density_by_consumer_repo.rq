PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo (SUM(?n) AS ?unlocks) (SUM(?delta) AS ?relief) (SUM(?n) / SUM(?delta) AS ?unlockDensity) WHERE { ?e a esf:DependencyReliefEvidence ; esf:consumerRepository ?repo ; esf:actionableOpportunities ?n ; esf:reliefDelta ?delta . FILTER(?delta > 0) } GROUP BY ?repo HAVING(SUM(?delta) > 0) ORDER BY DESC(?unlockDensity)
