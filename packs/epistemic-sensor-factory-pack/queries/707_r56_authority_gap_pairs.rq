PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?authorityGapPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:authorityBounded ?aBounded .
  ?b a esf:ConsumerAdmissionCandidate ; esf:authorityBounded ?bBounded .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aBounded != ?bBounded)
}
