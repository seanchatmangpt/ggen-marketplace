PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?positiveRelief ?positiveCapacity ?repositories WHERE { { SELECT (COUNT(?e) AS ?positiveRelief) WHERE { ?e a esf:DependencyReliefEvidence ; esf:reliefDelta ?d . FILTER(?d > 0) } } { SELECT (COUNT(?e) AS ?positiveCapacity) WHERE { ?e a esf:DependencyReliefEvidence ; esf:reliefDelta ?d ; esf:actionableOpportunities ?n . FILTER(?d > 0 && ?n > 0) } } { SELECT (COUNT(DISTINCT ?repo) AS ?repositories) WHERE { ?e a esf:DependencyReliefEvidence ; esf:consumerRepository ?repo ; esf:reliefDelta ?d ; esf:actionableOpportunities ?n . FILTER(?d > 0 && ?n > 0) } } }
