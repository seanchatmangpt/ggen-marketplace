PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?domain (COUNT(?p) AS ?profiles) (SUM(IF(?standing = "ADMITTED",1,0)) AS ?admitted) WHERE { ?p a esf:ConsumerIndependenceProfile ; esf:authorityDomain ?domain ; esf:admissionStanding ?standing . } GROUP BY ?domain ORDER BY ?domain
