PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?plan WHERE { ?plan a esf:ConsumerRealizationPlan . FILTER(!EXISTS { ?plan esf:targetBound true } || !EXISTS { ?plan esf:exactTargetHead ?h } || !EXISTS { ?plan esf:projectionPath ?p } || !EXISTS { ?plan esf:qualificationCommand ?q } || !EXISTS { ?plan esf:receiptPath ?r } || !EXISTS { ?plan esf:replayPath ?x }) }
