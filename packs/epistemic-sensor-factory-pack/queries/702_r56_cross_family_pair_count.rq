PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?crossFamilyPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:consumerFamily ?familyA .
  ?b a esf:ConsumerAdmissionCandidate ; esf:consumerFamily ?familyB .
  FILTER(STR(?a) < STR(?b))
  FILTER(?familyA != ?familyB)
}
