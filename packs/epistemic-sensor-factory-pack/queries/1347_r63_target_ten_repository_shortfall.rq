PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repositories (IF(?repositories < 10, 10 - ?repositories, 0) AS ?shortfall) WHERE { { SELECT (COUNT(DISTINCT ?repo) AS ?repositories) WHERE { ?e a esf:DependencyReliefEvidence ; esf:consumerRepository ?repo ; esf:reliefDelta ?d ; esf:actionableOpportunities ?n . FILTER(?d > 0 && ?n > 0) } } }
