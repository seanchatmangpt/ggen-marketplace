PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?e) AS ?qualifiedCandidates) (SUM(?d) AS ?totalRelief) (SUM(?opportunities) AS ?totalYield) (COUNT(DISTINCT ?repo) AS ?consumerBreadth) (COUNT(DISTINCT ?root) AS ?evidenceBreadth) WHERE { ?e a esf:DependencyReliefEvidence ; esf:currentSubject true ; esf:replayVerified true ; esf:qualificationReceiptPresent true ; esf:falsifierPresent true ; esf:generatedProjection true ; esf:consumerRepository ?repo ; esf:evidenceRoot ?root ; esf:reliefDelta ?d ; esf:actionableOpportunities ?opportunities . FILTER(?d > 0 && ?opportunities > 0) }
