PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?replayGapPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:replayCapable ?aReplay .
  ?b a esf:ConsumerAdmissionCandidate ; esf:replayCapable ?bReplay .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aReplay != ?bReplay)
}
