PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (1000 - (?fanout * ?yield * ?relief) AS ?shortfall) WHERE { ?m a esf:RealizationCalibrationMeasurement ; esf:realizedConsumerFanout ?fanout ; esf:realizedOpportunityYieldR66 ?yield ; esf:realizedDependencyReliefR66 ?relief . }
