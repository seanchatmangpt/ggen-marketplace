PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?all) AS ?subjects) (COUNT(?positive) AS ?positiveCapacity) WHERE { ?all a esf:DependencyReliefEvidence . OPTIONAL { ?positive a esf:DependencyReliefEvidence ; esf:reliefDelta ?d ; esf:actionableOpportunities ?n . FILTER(?d > 0 && ?n > 0) } }
