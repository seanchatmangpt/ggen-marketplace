PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?receipt WHERE { ?ret a esf:EvidenceReturn ; prov:used ?receipt ; prov:generated ?standing . ?standing esf:consumerStandingValue "PARTIAL_ALIVE" . FILTER NOT EXISTS { ?a a esf:ProducerAssimilation ; prov:used ?receipt . } }
