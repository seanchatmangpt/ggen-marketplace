PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?plan ?candidate WHERE { ?plan a esf:ConsumerRealizationPlan ; esf:realizedFor ?candidate ; esf:targetBound true ; esf:standingInherited false ; esf:authorityInherited false ; esf:noAmbientDo true . ?candidate esf:authorityBounded true ; esf:publicOntologyAligned true ; esf:ggenManufacturable true ; esf:dependencyClosed true . }
