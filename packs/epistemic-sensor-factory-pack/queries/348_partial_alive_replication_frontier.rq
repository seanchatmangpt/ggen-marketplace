PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo ?sha ?root WHERE { ?target a esf:ReplicationTarget ; esf:targetRepo ?repo ; esf:subjectSha ?sha ; esf:independentEvidenceRoot ?root . ?sensor a esf:ManufacturedSensor ; esf:observedInRepo ?target ; esf:standing "PARTIAL_ALIVE" . } ORDER BY ?repo
