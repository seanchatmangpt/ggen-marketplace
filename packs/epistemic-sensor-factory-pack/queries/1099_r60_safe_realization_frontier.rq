PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?candidate ?plan ?family WHERE { ?plan a esf:ConsumerRealizationPlan ; esf:realizedFor ?candidate ; esf:artifactFamily ?family ; esf:manufacturingStanding "READY" ; esf:targetBound true ; esf:standingInherited false ; esf:authorityInherited false ; esf:noAmbientDo true . ?candidate esf:authorityBounded true ; esf:noAmbientDo true ; esf:publicOntologyAligned true ; esf:dependencyClosed true . } ORDER BY ?family ?candidate
