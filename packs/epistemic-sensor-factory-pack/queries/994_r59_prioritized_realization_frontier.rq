PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?plan ?candidate ?family ?head WHERE { ?plan a esf:ConsumerRealizationPlan ; esf:realizedFor ?candidate ; esf:artifactFamily ?family ; esf:exactTargetHead ?head ; esf:targetBound true ; esf:standingInherited false ; esf:authorityInherited false ; esf:noAmbientDo true . ?candidate esf:admissionStanding "PARTIAL_ALIVE" ; esf:authorityBounded true ; esf:publicOntologyAligned true ; esf:ggenManufacturable true ; esf:dependencyClosed true ; esf:receiptReturnCapable true ; esf:replayCapable true . } ORDER BY ?family ?candidate
