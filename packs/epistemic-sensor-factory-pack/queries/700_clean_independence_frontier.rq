PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo ?head ?runtime ?language ?kernel ?failure ?authority ?receipt ?qualification ?ontology ?hosting ?standing WHERE {
  ?p a esf:ConsumerIndependenceProfile ; esf:candidateRepo ?repo ; esf:candidateHead ?head ; esf:currentDefaultHead ?head ; esf:runtimeFamily ?runtime ; esf:languageFamily ?language ; esf:executionKernel ?kernel ; esf:failureDomain ?failure ; esf:authorityDomain ?authority ; esf:receiptProtocol ?receipt ; esf:qualificationFamily ?qualification ; esf:ontologyProfile ?ontology ; esf:hostingPlane ?hosting ; esf:admissionStanding ?standing ; esf:identityVerified true ; esf:authorityBounded true ; esf:courtReusable true ; esf:publicOntologyAligned true ; esf:replayCapable true ; esf:noAmbientDo true .
}
ORDER BY ?standing ?runtime ?failure ?authority ?receipt ?qualification ?repo
