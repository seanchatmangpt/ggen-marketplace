PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?p ?repo ?head ?standing WHERE {
  ?p a esf:ConsumerIndependenceProfile ; esf:candidateRepo ?repo ; esf:candidateHead ?head ; esf:currentDefaultHead ?head ; esf:admissionStanding ?standing ; esf:identityVerified true ; esf:authorityBounded true ; esf:replayCapable true ; esf:noAmbientDo true .
} ORDER BY ?standing STR(?repo)
