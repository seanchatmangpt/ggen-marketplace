PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?candidate ?target ?standing ?adapter ?returnCapable WHERE {
  ?candidate a esf:ConsumerAdmissionCandidate ;
    esf:admittedTarget ?target ;
    esf:admissionStanding ?standing ;
    esf:adapterRequired ?adapter ;
    esf:receiptReturnCapable ?returnCapable .
  ?target esf:crossRepository true .
}
ORDER BY ?standing ?candidate
