PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e WHERE { ?e a esf:DependencyReliefEvidence ; esf:currentSubject true ; esf:replayVerified true ; esf:qualificationReceiptPresent true ; esf:falsifierPresent true ; esf:generatedProjection true ; esf:reliefDelta ?d . FILTER(?d > 0) }
