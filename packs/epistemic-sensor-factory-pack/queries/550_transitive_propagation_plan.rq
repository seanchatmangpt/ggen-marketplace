PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo ?head ?standing ?replay ?relief WHERE {
  ?target a esf:ReplicationTarget ; esf:targetRepo ?repo ; esf:consumerHead ?head ; esf:eligible true .
  OPTIONAL { ?receipt a esf:ConsumerReceiptAssertion ; esf:consumerHead ?head ; esf:consumerStandingValue ?standing ; esf:replayVerified ?replay ; esf:dependencyRelief ?relief . }
}
ORDER BY ?repo ?head
