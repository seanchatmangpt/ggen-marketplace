PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo (SUM(?d) AS ?relief) (SUM(?opportunities) AS ?yield) WHERE { ?e a esf:DependencyReliefEvidence ; esf:currentSubject true ; esf:replayVerified true ; esf:qualificationReceiptPresent true ; esf:falsifierPresent true ; esf:consumerRepository ?repo ; esf:reliefDelta ?d ; esf:actionableOpportunities ?opportunities . FILTER(?d > 0) } GROUP BY ?repo
