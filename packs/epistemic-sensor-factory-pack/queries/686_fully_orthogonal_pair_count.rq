PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?count) WHERE {
  ?a a esf:ConsumerIndependenceProfile ; esf:runtimeFamily ?ar ; esf:languageFamily ?al ; esf:executionKernel ?ak ; esf:failureDomain ?af ; esf:authorityDomain ?aa ; esf:receiptProtocol ?ap ; esf:qualificationFamily ?aq .
  ?b a esf:ConsumerIndependenceProfile ; esf:runtimeFamily ?br ; esf:languageFamily ?bl ; esf:executionKernel ?bk ; esf:failureDomain ?bf ; esf:authorityDomain ?ba ; esf:receiptProtocol ?bp ; esf:qualificationFamily ?bq .
  FILTER(STR(?a) < STR(?b) && ?ar != ?br && ?al != ?bl && ?ak != ?bk && ?af != ?bf && ?aa != ?ba && ?ap != ?bp && ?aq != ?bq)
}
