PREFIX r73: <https://ggen.dev/measure/r73#>
SELECT ?s WHERE { ?s r73:shouldBeGenerated true ; r73:usesPack ?pack ; r73:usesGenerator ?generator ; r73:producesArtifact ?artifact ; r73:hasConsumer ?consumer ; r73:hasQualification ?qualification ; r73:hasReceipt ?receipt . FILTER NOT EXISTS { ?s r73:drifted true } }