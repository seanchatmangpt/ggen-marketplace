PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?c ?t WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:admittedTarget ?t ; esf:admissionStanding "ALIVE" ; esf:authorityBounded true ; esf:noAmbientDo true ; esf:publicOntologyAligned true . ?t esf:crossRepository true . FILTER NOT EXISTS { ?s a esf:ExactSubject ; esf:receipt ?r . ?r esf:replayVerified true } }
