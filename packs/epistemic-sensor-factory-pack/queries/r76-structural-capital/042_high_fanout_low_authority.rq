PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate ?fanout ?cost WHERE { ?candidate a esf:CapitalCandidate ; esf:expectedConsumerFanout ?fanout ; esf:authorityCost ?cost . FILTER(xsd:decimal(?fanout) >= 10 && xsd:decimal(?cost) <= 2) }
