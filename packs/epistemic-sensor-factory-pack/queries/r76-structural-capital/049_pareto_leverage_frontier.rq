PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate ?commits ?fanout ?reuse ?composition ?authority ?irreversible WHERE { ?candidate a esf:CapitalCandidate ; esf:expectedCommitUnlock ?commits ; esf:expectedConsumerFanout ?fanout ; esf:expectedReuseLeverage ?reuse ; esf:expectedCompositionLeverage ?composition ; esf:authorityCost ?authority ; esf:irreversibleCost ?irreversible ; esf:admitted true . FILTER(xsd:decimal(?commits) > 0 && xsd:decimal(?fanout) > 0 && xsd:decimal(?reuse) > 0 && xsd:decimal(?composition) > 0 && xsd:decimal(?authority) <= 2 && xsd:decimal(?irreversible) <= 2) }
