PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate ?capacity ?reversibility WHERE { ?candidate a esf:CapitalCandidate ; esf:futureManufacturingCapacity ?capacity ; esf:reversibility ?reversibility . FILTER(xsd:decimal(?capacity) >= 100 && xsd:decimal(?reversibility) >= 8) }
