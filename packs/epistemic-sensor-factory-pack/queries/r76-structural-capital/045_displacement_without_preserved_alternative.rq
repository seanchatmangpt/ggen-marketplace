PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate WHERE { ?candidate a esf:CapitalCandidate ; esf:structuralDisplacementScore ?score . FILTER(xsd:decimal(?score) > 0) FILTER NOT EXISTS { ?candidate esf:preservedAlternative ?alternative } }
