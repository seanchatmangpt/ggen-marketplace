PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?candidate ?primitive ?pack ?generator ?population ?qualification ?regeneration WHERE { ?candidate a esf:CapitalCandidate ; esf:canonicalPrimitive ?primitive ; esf:packPlan ?pack ; esf:generatorPlan ?generator ; esf:consumerPopulation ?population ; esf:qualificationPlan ?qualification ; esf:regenerationPlan ?regeneration . }
