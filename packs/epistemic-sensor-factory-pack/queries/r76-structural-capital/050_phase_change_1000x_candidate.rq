PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate ?reuse ?fanout ?composition WHERE { ?candidate a esf:CapitalCandidate ; esf:expectedReuseLeverage ?reuse ; esf:expectedConsumerFanout ?fanout ; esf:expectedCompositionLeverage ?composition ; esf:admitted true . FILTER(xsd:decimal(?reuse) >= 10 && xsd:decimal(?fanout) >= 10 && xsd:decimal(?composition) >= 10) }
