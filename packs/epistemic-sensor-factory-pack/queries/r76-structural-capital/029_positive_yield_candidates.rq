PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate ?unlocks ?investment WHERE { ?candidate a esf:CapitalCandidate ; esf:yieldNumerator ?unlocks ; esf:yieldDenominator ?investment . FILTER(xsd:decimal(?unlocks) > 0 && xsd:decimal(?investment) > 0) }
