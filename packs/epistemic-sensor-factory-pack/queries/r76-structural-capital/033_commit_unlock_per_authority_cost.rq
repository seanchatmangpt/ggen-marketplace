PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate ?commits ?cost WHERE { ?candidate a esf:CapitalCandidate ; esf:expectedCommitUnlock ?commits ; esf:authorityCost ?cost . FILTER(xsd:decimal(?commits) > 0 && xsd:decimal(?cost) >= 0) }
