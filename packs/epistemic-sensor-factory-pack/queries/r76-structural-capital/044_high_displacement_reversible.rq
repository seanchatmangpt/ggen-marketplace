PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?candidate ?displacement ?reversibility WHERE { ?candidate a esf:CapitalCandidate ; esf:structuralDisplacementScore ?displacement ; esf:reversibility ?reversibility . FILTER(xsd:decimal(?displacement) >= 8 && xsd:decimal(?reversibility) >= 8) }
