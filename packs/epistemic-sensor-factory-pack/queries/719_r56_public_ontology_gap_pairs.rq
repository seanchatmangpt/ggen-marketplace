PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?ontologyGapPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:publicOntologyAligned ?aAligned .
  ?b a esf:ConsumerAdmissionCandidate ; esf:publicOntologyAligned ?bAligned .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aAligned != ?bAligned)
}
