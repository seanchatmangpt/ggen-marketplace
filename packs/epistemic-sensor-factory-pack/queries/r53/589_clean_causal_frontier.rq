PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?edge ?opportunity WHERE { ?edge a esf:PropagationEdge ; esf:sourceReceipt ?receipt ; esf:sourceConsumer ?consumer ; esf:causedOpportunity ?opportunity ; esf:causalWitness ?witness ; esf:observedAfterReceipt true ; esf:standingTransferred false ; esf:authorityTransferred false . ?receipt esf:replayVerified true . ?consumer a esf:ExactSubject ; esf:subjectSha ?sha . ?witness esf:independentTargetRoot ?root ; esf:causalConfidence ?confidence . FILTER(?confidence >= 0.5) }
