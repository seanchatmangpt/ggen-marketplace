PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?edge ?declared (COUNT(DISTINCT ?opportunity) AS ?observed) WHERE { ?edge a esf:PropagationEdge ; esf:marginalOpportunityCount ?declared ; esf:causedOpportunity ?opportunity . } GROUP BY ?edge ?declared HAVING(COUNT(DISTINCT ?opportunity) != ?declared)
