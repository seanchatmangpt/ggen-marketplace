PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(DISTINCT ?consumer) AS ?consumerFactor) (COUNT(DISTINCT ?opportunity) AS ?opportunityFactor) (MAX(?fanout) AS ?fanoutFactor) WHERE { ?edge a esf:PropagationEdge ; esf:sourceConsumer ?consumer ; esf:causedOpportunity ?opportunity ; esf:fanoutCount ?fanout ; esf:standingTransferred false ; esf:authorityTransferred false . ?edge esf:sourceReceipt ?receipt ; esf:causalWitness ?witness . ?receipt esf:replayVerified true . ?witness esf:independentTargetRoot ?root . }
