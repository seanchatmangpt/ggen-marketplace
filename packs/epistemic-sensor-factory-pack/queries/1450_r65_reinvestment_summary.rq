PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?obs) AS ?observations) (SUM(?delta) AS ?totalGain) (SUM(?opps) AS ?totalOpportunities) (SUM(?reuse) AS ?totalReuse) (MAX(?product) AS ?maxProduct) WHERE { ?obs a esf:ProductionFunctionObservation ; esf:frontierDelta ?delta ; esf:downstreamOpportunityCount ?opps ; esf:reusedCapabilityCount ?reuse ; esf:multiplicativeProduct ?product . }
