PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?exactHeadTriples) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:candidateHead ?ah ; esf:currentDefaultHead ?ad .
  ?b a esf:ConsumerAdmissionCandidate ; esf:candidateHead ?bh ; esf:currentDefaultHead ?bd .
  ?c a esf:ConsumerAdmissionCandidate ; esf:candidateHead ?ch ; esf:currentDefaultHead ?cd .
  FILTER(STR(?a) < STR(?b) && STR(?b) < STR(?c))
  FILTER(?ah = ?ad && ?bh = ?bd && ?ch = ?cd)
}
