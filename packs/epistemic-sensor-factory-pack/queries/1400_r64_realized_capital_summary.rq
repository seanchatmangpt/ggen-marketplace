PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?obs) AS ?observations) (SUM(?delta) AS ?totalFrontierDelta) (SUM(?opps) AS ?totalOpportunities) (SUM(?reuse) AS ?totalReuse) WHERE { ?obs a esf:ProductionFunctionObservation ; esf:frontierDelta ?delta ; esf:downstreamOpportunityCount ?opps ; esf:reusedCapabilityCount ?reuse . }
