PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?q ?c WHERE { ?q a dqv:QualityMeasurement ; prov:wasGeneratedBy ?r ; esf:checkConclusion ?c . ?r a esf:QualifiedConsumerReceipt . FILTER(LCASE(STR(?c)) = "unknown") }
