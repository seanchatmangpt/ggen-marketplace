PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?a ?b ?familyA ?familyB WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:consumerFamily ?familyA ; esf:identityVerified true ; esf:authorityBounded true ; esf:receiptReturnCapable true ; esf:ggenManufacturable true ; esf:dependencyClosed true ; esf:replayCapable true ; esf:noAmbientDo true ; esf:publicOntologyAligned true ; esf:courtReusable true ; esf:generatedProjectionCapable true ; esf:candidateHead ?aHead ; esf:currentDefaultHead ?aDefault .
  ?b a esf:ConsumerAdmissionCandidate ; esf:consumerFamily ?familyB ; esf:identityVerified true ; esf:authorityBounded true ; esf:receiptReturnCapable true ; esf:ggenManufacturable true ; esf:dependencyClosed true ; esf:replayCapable true ; esf:noAmbientDo true ; esf:publicOntologyAligned true ; esf:courtReusable true ; esf:generatedProjectionCapable true ; esf:candidateHead ?bHead ; esf:currentDefaultHead ?bDefault .
  FILTER(STR(?a) < STR(?b))
  FILTER(?familyA != ?familyB)
  FILTER(?aHead = ?aDefault && ?bHead = ?bDefault)
}
ORDER BY ?familyA ?familyB ?a ?b
