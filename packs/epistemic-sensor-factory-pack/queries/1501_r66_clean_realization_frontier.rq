PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?m ?fanout ?yield ?relief ?receipt ?assimilation WHERE { ?m a esf:RealizationCalibrationMeasurement ; esf:realizedConsumerFanout ?fanout ; esf:realizedOpportunityYieldR66 ?yield ; esf:realizedDependencyReliefR66 ?relief ; esf:consumerReceiptCoverage ?receipt ; esf:receiptAssimilationCoverage ?assimilation . FILTER(?receipt>=0.8 && ?assimilation>=0.8 && ?fanout>0 && ?yield>0 && ?relief>0) } ORDER BY DESC(?fanout) DESC(?yield) DESC(?relief)
