PREFIX esf:<https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo ?ref ?sha ?standing ?receipt ?replay WHERE{?r a esf:ConsumerExecutionReceipt;esf:consumerRepository ?repo;esf:consumerRef ?ref;esf:consumerSha ?sha;esf:standing ?standing;esf:receiptDigest ?receipt;esf:replayVerified ?replay.}ORDER BY ?repo ?sha