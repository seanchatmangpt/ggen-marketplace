PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?repo (COUNT(DISTINCT ?root) AS ?roots) WHERE { ?e a esf:DependencyReliefEvidence ; esf:consumerRepository ?repo ; esf:evidenceRoot ?root ; esf:reliefDelta ?delta . FILTER(?delta > 0) } GROUP BY ?repo HAVING(COUNT(DISTINCT ?root) > 1) ORDER BY DESC(?roots)
