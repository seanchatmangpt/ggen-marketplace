PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?c WHERE { ?c a esf:ConsumerAdmissionCandidate ; esf:identityVerified true ; esf:authorityBounded true ; esf:receiptReturnCapable true ; esf:ggenManufacturable true ; esf:replayCapable true ; esf:dependencyClosed true ; esf:noAmbientDo true ; esf:admissionStanding ?standing . FILTER(?standing != "ADMITTED") } ORDER BY ?c