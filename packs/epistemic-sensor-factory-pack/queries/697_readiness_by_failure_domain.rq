PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?domain (COUNT(?p) AS ?ready) WHERE { ?p a esf:ConsumerIndependenceProfile ; esf:failureDomain ?domain ; esf:identityVerified true ; esf:authorityBounded true ; esf:replayCapable true ; esf:noAmbientDo true . } GROUP BY ?domain ORDER BY DESC(?ready) ?domain
