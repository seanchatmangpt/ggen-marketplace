PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?consumer (COUNT(DISTINCT ?target) AS ?targets) WHERE {
  ?edge a esf:PropagationEdge ; esf:sourceConsumer ?consumer ; esf:causedOpportunity ?opportunity .
  ?opportunity esf:targetRepo ?target .
}
GROUP BY ?consumer
HAVING(COUNT(DISTINCT ?target) > 1)
ORDER BY DESC(?targets) ?consumer
