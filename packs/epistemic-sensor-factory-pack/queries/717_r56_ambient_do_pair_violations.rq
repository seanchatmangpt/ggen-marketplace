PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?ambientDoViolationPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:noAmbientDo ?aSafe .
  ?b a esf:ConsumerAdmissionCandidate ; esf:noAmbientDo ?bSafe .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aSafe = false || ?bSafe = false)
}
