PREFIX r75: <https://ggen.dev/implement/r75#>
SELECT ?r WHERE { ?r a r75:StructuralRealization ; r75:sourceStructure ?source ; r75:desiredStructure ?desired ; r75:usesPack ?pack ; r75:usesGenerator ?generator ; r75:generatedArtifact ?artifact ; r75:generatedIdentity ?identity ; r75:consumer ?consumer ; r75:qualification ?qualification ; r75:receipt ?receipt ; r75:standing ?standing ; r75:exactHead ?head ; r75:deterministic true ; r75:authority ?authority ; r75:consequentialDo false . }
