PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?manufacturabilityBridgePairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:ggenManufacturable ?aM .
  ?b a esf:ConsumerAdmissionCandidate ; esf:ggenManufacturable ?bM .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aM != ?bM)
}
