PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e WHERE { ?e a esf:DependencyReliefEvidence ; esf:reliefDelta ?d ; esf:actionableOpportunities ?n . FILTER NOT EXISTS { ?e esf:consumerRepository ?repo ; esf:consumerRef ?ref ; esf:requestObservedAt ?request ; esf:executionObservedAt ?execution } }
