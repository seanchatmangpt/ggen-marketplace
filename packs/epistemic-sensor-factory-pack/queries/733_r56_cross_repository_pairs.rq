PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?crossRepositoryPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:candidateRepo ?repoA .
  ?b a esf:ConsumerAdmissionCandidate ; esf:candidateRepo ?repoB .
  FILTER(STR(?a) < STR(?b))
  FILTER(?repoA != ?repoB)
}
