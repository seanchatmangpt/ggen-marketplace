PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?staleHeadPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:candidateHead ?aHead ; esf:currentDefaultHead ?aDefault .
  ?b a esf:ConsumerAdmissionCandidate ; esf:candidateHead ?bHead ; esf:currentDefaultHead ?bDefault .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aHead != ?aDefault || ?bHead != ?bDefault)
}
