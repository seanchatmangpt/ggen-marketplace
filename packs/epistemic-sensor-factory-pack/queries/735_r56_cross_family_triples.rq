PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?crossFamilyTriples) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:consumerFamily ?fa .
  ?b a esf:ConsumerAdmissionCandidate ; esf:consumerFamily ?fb .
  ?c a esf:ConsumerAdmissionCandidate ; esf:consumerFamily ?fc .
  FILTER(STR(?a) < STR(?b) && STR(?b) < STR(?c))
  FILTER(?fa != ?fb && ?fa != ?fc && ?fb != ?fc)
}
