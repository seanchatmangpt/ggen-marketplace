PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?s ?repo ?sha WHERE { ?s esf:consumerRepositoryR66 ?repo ; esf:consumerShaR66 ?sha ; esf:evidenceRootIndependent true ; esf:consumerQualificationVerified true ; esf:subjectContainmentVerified true ; esf:receiptReplayVerifiedR66 true ; esf:standingFreshness 1.0 . } ORDER BY ?repo
