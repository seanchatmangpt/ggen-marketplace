PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?e ?memory ?records ?opportunities WHERE { ?e a esf:DependencyReliefEvidence ; esf:memoryCausedOpportunities ?memory ; esf:memoryRecordsConsumed ?records ; esf:actionableOpportunities ?opportunities . FILTER(?records > 0 && ?memory > 0 && ?opportunities >= ?memory) }
