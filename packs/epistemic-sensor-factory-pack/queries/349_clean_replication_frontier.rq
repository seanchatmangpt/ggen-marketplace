PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
ASK WHERE { ?target a esf:ReplicationTarget, esf:ExactSubject ; esf:eligible true ; esf:targetRepo ?repo ; esf:subjectSha ?sha ; esf:defaultHead ?sha ; esf:independentEvidenceRoot ?root . ?sensor a esf:ManufacturedSensor ; esf:observedInRepo ?target ; esf:derivedFromSpec esf:replicationCoverageSpec ; esf:receipt ?receipt ; esf:standing ?standing . FILTER(?standing IN ("ALIVE", "PARTIAL_ALIVE")) }
