PREFIX dqv: <http://www.w3.org/ns/dqv#>
PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?receipt (COUNT(?check) AS ?checks) WHERE { ?check a dqv:QualityMeasurement ; prov:wasGeneratedBy ?receipt . ?receipt a esf:QualifiedConsumerReceipt . } GROUP BY ?receipt
