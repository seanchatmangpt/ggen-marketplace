PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?observation ?observationFactor ?reuseFactor ?opportunityFactor ?product ?delta ?roots ?admitted WHERE {
  ?observation a esf:ProductionFunctionObservation ;
    esf:observationFactor ?observationFactor ;
    esf:reuseFactor ?reuseFactor ;
    esf:opportunityFactor ?opportunityFactor ;
    esf:multiplicativeProduct ?product ;
    esf:frontierDelta ?delta ;
    esf:factorIndependentRoots ?roots ;
    esf:multiplierAdmitted ?admitted .
}
ORDER BY DESC(?product)
