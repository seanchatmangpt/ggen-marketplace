PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(?ready) AS ?ready) (COUNT(?all) AS ?total) WHERE { ?all a esf:ConsumerAdmissionCandidate . OPTIONAL { ?ready a esf:ConsumerAdmissionCandidate ; esf:receiptReturnCapable true ; esf:ggenManufacturable true ; esf:dependencyClosed true . } }
