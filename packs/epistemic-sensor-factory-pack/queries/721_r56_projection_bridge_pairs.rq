PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?projectionBridgePairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:generatedProjectionCapable ?aProjection .
  ?b a esf:ConsumerAdmissionCandidate ; esf:generatedProjectionCapable ?bProjection .
  FILTER(STR(?a) < STR(?b))
  FILTER(?aProjection != ?bProjection)
}
