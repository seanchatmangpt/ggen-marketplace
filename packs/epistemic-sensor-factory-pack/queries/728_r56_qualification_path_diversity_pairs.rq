PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT (COUNT(*) AS ?diverseQualificationPairs) WHERE {
  ?a a esf:ConsumerAdmissionCandidate ; esf:qualificationPath ?pathA .
  ?b a esf:ConsumerAdmissionCandidate ; esf:qualificationPath ?pathB .
  FILTER(STR(?a) < STR(?b))
  FILTER(?pathA != ?pathB)
}
