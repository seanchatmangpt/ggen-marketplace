PREFIX esf: <https://ggen.dev/ontology/epistemic-sensor-factory#>
SELECT ?candidate ?plan WHERE { ?plan a esf:ConsumerRealizationPlan ; esf:realizedFor ?candidate ; esf:manufacturingStanding "READY" . ?candidate esf:adapterRequired true ; esf:authorityBounded true ; esf:noAmbientDo true . } ORDER BY ?candidate
