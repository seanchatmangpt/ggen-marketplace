@prefix dfcm: <https://ggen.dev/ontology/dfcm#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dct: <http://purl.org/dc/terms/> .

dfcm:DesignForCombinatorialMaximalism a rdfs:Class ;
  rdfs:label "Design for Combinatorial Maximalism" ;
  dct:description "Preserve the maximum lawful reversible composition space before irreversible selection, bounded by ontology, capability, authority, cost, and evidence." .

dfcm:Stage a rdfs:Class .
dfcm:Operation a rdfs:Class .
dfcm:State a rdfs:Class .
dfcm:DeploymentComponent a rdfs:Class .
dfcm:EnterpriseControl a rdfs:Class .
dfcm:Invariant a rdfs:Class .
dfcm:Transition a rdfs:Class .
dfcm:Refusal a rdfs:Class .
dfcm:Receipt a rdfs:Class ; rdfs:subClassOf prov:Entity .
dfcm:AuthorityGrant a rdfs:Class ; rdfs:subClassOf odrl:Policy .

dfcm:order a rdf:Property .
dfcm:slug a rdf:Property .
dfcm:kind a rdf:Property .
dfcm:outcome a rdf:Property .
dfcm:verifier a rdf:Property .
dfcm:falsifier a rdf:Property .
dfcm:required a rdf:Property .
dfcm:from a rdf:Property .
dfcm:to a rdf:Property .
dfcm:trigger a rdf:Property .
dfcm:authority a rdf:Property .
dfcm:actuationAllowed a rdf:Property .
dfcm:requirement a rdf:Property .
dfcm:domain a rdf:Property .
dfcm:criticality a rdf:Property .
dfcm:accountableRole a rdf:Property .
dfcm:evidenceKind a rdf:Property .
dfcm:frameworkRef a rdf:Property .
dfcm:maxAgeHours a rdf:Property .
dfcm:automationLevel a rdf:Property .

dfcm:Preserve a dfcm:Stage ; dfcm:order 1 ; dfcm:slug "preserve" ; rdfs:label "Preserve" .
dfcm:Fence a dfcm:Stage ; dfcm:order 2 ; dfcm:slug "fence" ; rdfs:label "Fence / Chesterton" .
dfcm:Calculus a dfcm:Stage ; dfcm:order 3 ; dfcm:slug "calculus" ; rdfs:label "Calculus" .
dfcm:Exclusions a dfcm:Stage ; dfcm:order 4 ; dfcm:slug "exclusions" ; rdfs:label "Exclusions" .
dfcm:FalsifierStage a dfcm:Stage ; dfcm:order 5 ; dfcm:slug "falsifier" ; rdfs:label "Falsifier" .
dfcm:Extension a dfcm:Stage ; dfcm:order 6 ; dfcm:slug "extension" ; rdfs:label "Extension" .
dfcm:Operationalization a dfcm:Stage ; dfcm:order 7 ; dfcm:slug "operationalization" ; rdfs:label "Operationalization" .

dfcm:UNKNOWN a dfcm:State ; rdfs:label "UNKNOWN" .
dfcm:PARTIAL_ALIVE a dfcm:State ; rdfs:label "PARTIAL_ALIVE" .
dfcm:ALIVE a dfcm:State ; rdfs:label "ALIVE" .
dfcm:BLOCKED a dfcm:State ; rdfs:label "BLOCKED" .
dfcm:BUILD_BROKEN a dfcm:State ; rdfs:label "BUILD_BROKEN" .
dfcm:UNSUPPORTED a dfcm:State ; rdfs:label "UNSUPPORTED" .
dfcm:REFUSED a dfcm:State ; rdfs:label "REFUSED" .

dfcm:Parse a dfcm:Operation ; dfcm:order 1 ; dfcm:slug "parse" ; dfcm:actuationAllowed false .
dfcm:Route a dfcm:Operation ; dfcm:order 2 ; dfcm:slug "route" ; dfcm:actuationAllowed false .
dfcm:Admit a dfcm:Operation ; dfcm:order 3 ; dfcm:slug "admit" ; dfcm:actuationAllowed false .
dfcm:Refuse a dfcm:Operation ; dfcm:order 4 ; dfcm:slug "refuse" ; dfcm:actuationAllowed false .
dfcm:Diagnose a dfcm:Operation ; dfcm:order 5 ; dfcm:slug "diagnose" ; dfcm:actuationAllowed false .
dfcm:Repair a dfcm:Operation ; dfcm:order 6 ; dfcm:slug "repair" ; dfcm:actuationAllowed false .
dfcm:Select a dfcm:Operation ; dfcm:order 7 ; dfcm:slug "select" ; dfcm:actuationAllowed false .
dfcm:Construct a dfcm:Operation ; dfcm:order 8 ; dfcm:slug "construct" ; dfcm:actuationAllowed false .
dfcm:Do a dfcm:Operation ; dfcm:order 9 ; dfcm:slug "do" ; dfcm:actuationAllowed true ; dfcm:authority "BRCE" .
dfcm:ReceiptOp a dfcm:Operation ; dfcm:order 10 ; dfcm:slug "receipt" ; dfcm:actuationAllowed false .
dfcm:Replay a dfcm:Operation ; dfcm:order 11 ; dfcm:slug "replay" ; dfcm:actuationAllowed false .
dfcm:Hook a dfcm:Operation ; dfcm:order 12 ; dfcm:slug "hook" ; dfcm:actuationAllowed false .
dfcm:Standing a dfcm:Operation ; dfcm:order 13 ; dfcm:slug "standing" ; dfcm:actuationAllowed false .

dfcm:CanonicalGraph a dfcm:DeploymentComponent ; dfcm:order 1 ; dfcm:slug "canonical-graph" ; rdfs:label "Canonical graph" ; dfcm:kind "ontology" ; dfcm:required true ; dfcm:outcome "One authoritative RDF model; generated artifacts remain projections" ; dfcm:verifier "RDF parses and required semantic gates return zero rows" ; dfcm:falsifier "A generated projection becomes an authoritative editing surface" .
dfcm:SemanticQuotient a dfcm:DeploymentComponent ; dfcm:order 2 ; dfcm:slug "semantic-quotient" ; rdfs:label "Semantic quotient" ; dfcm:kind "admission" ; dfcm:required true ; dfcm:outcome "Equivalence and admissibility are declared before optimization" ; dfcm:verifier "Candidate intent carries an exact subject and policy identity" ; dfcm:falsifier "Adjacency or analogy is accepted as equivalence" .
dfcm:OptionGraph a dfcm:DeploymentComponent ; dfcm:order 3 ; dfcm:slug "option-graph" ; rdfs:label "Reversible option graph" ; dfcm:kind "construction" ; dfcm:required true ; dfcm:outcome "Maximum lawful reversible candidates survive until selection" ; dfcm:verifier "Failure of one edge preserves independent alternatives" ; dfcm:falsifier "One failed edge collapses the whole graph" .
dfcm:AdmissionBoundary a dfcm:DeploymentComponent ; dfcm:order 4 ; dfcm:slug "admission-boundary" ; rdfs:label "Admission boundary" ; dfcm:kind "authority" ; dfcm:required true ; dfcm:outcome "UNKNOWN never becomes admitted without an explicit grant" ; dfcm:verifier "Grant binds subject, action, policy, and artifact digest" ; dfcm:falsifier "Planner or raw input receives ambient execution authority" .
dfcm:ConstructionEngine a dfcm:DeploymentComponent ; dfcm:order 5 ; dfcm:slug "construction-engine" ; rdfs:label "Construction engine" ; dfcm:kind "construction" ; dfcm:required true ; dfcm:outcome "CONSTRUCT manufactures artifacts without DO authority" ; dfcm:verifier "Construction produces bytes and digest without invoking an actuator" ; dfcm:falsifier "Construction has an actuator handle or performs a consequence" .
dfcm:BRCEGateway a dfcm:DeploymentComponent ; dfcm:order 6 ; dfcm:slug "brce-gateway" ; rdfs:label "Bounded Receipted Chatman Equation gateway" ; dfcm:kind "actuation" ; dfcm:required true ; dfcm:outcome "Only an exact authority grant can cross into DO" ; dfcm:verifier "Positive actuation executes only through BRCE and produces a receipt" ; dfcm:falsifier "Any unreceipted or ambient actuation succeeds" .
dfcm:ReceiptLedger a dfcm:DeploymentComponent ; dfcm:order 7 ; dfcm:slug "receipt-ledger" ; rdfs:label "Receipt ledger" ; dfcm:kind "receipt" ; dfcm:required true ; dfcm:outcome "Identity, authority, consequence, and predecessor are digest-bound" ; dfcm:verifier "Receipt digest and chain predecessor verify" ; dfcm:falsifier "Tampered subject, consequence, or predecessor verifies" .
dfcm:ReplayEngine a dfcm:DeploymentComponent ; dfcm:order 8 ; dfcm:slug "replay-engine" ; rdfs:label "Replay engine" ; dfcm:kind "replay" ; dfcm:required true ; dfcm:outcome "Receipts deterministically establish whether the same admitted consequence occurred" ; dfcm:verifier "Replay validates the exact recorded receipt chain" ; dfcm:falsifier "Replay promotes metadata-only workflow state to execution" .
dfcm:StandingEvaluator a dfcm:DeploymentComponent ; dfcm:order 9 ; dfcm:slug "standing-evaluator" ; rdfs:label "Exact-subject standing evaluator" ; dfcm:kind "standing" ; dfcm:required true ; dfcm:outcome "ALIVE requires observed execution against the exact admitted subject" ; dfcm:verifier "Observed, admitted, executed, and verified are independently true" ; dfcm:falsifier "Inspection, workflow existence, or a named receipt crowns ALIVE" .
dfcm:HookBoundary a dfcm:DeploymentComponent ; dfcm:order 10 ; dfcm:slug "hook-boundary" ; rdfs:label "Intent-only hook boundary" ; dfcm:kind "extension" ; dfcm:required true ; dfcm:outcome "Hooks manufacture intents and never actuate" ; dfcm:verifier "Hook output is an Intent and actuator count does not change" ; dfcm:falsifier "A hook invokes DO directly" .
dfcm:LeanAdmissionBoundary a dfcm:DeploymentComponent ; dfcm:order 11 ; dfcm:slug "lean-admission" ; rdfs:label "Lean admission boundary" ; dfcm:kind "formal-admission" ; dfcm:required true ; dfcm:outcome "Formal propositions encode actuation separation and ALIVE evidence requirements" ; dfcm:verifier "Generated Lean source contains executable admission theorems" ; dfcm:falsifier "Rendering is represented as formal admission" .
dfcm:MfactCertificateBoundary a dfcm:DeploymentComponent ; dfcm:order 12 ; dfcm:slug "mfact-certificate" ; rdfs:label "mfact certificate boundary" ; dfcm:kind "certificate" ; dfcm:required true ; dfcm:outcome "Release promotion requires a certificate over ontology, admission, runtime receipt, replay, and standing" ; dfcm:verifier "Downstream mfact certificate binds all required proof surfaces" ; dfcm:falsifier "Release standing is inferred without a certificate" .

dfcm:TParseRoute a dfcm:Transition ; dfcm:from dfcm:Parse ; dfcm:to dfcm:Route ; dfcm:trigger "parsed" ; dfcm:authority "none" ; dfcm:actuationAllowed false .
dfcm:TRouteAdmit a dfcm:Transition ; dfcm:from dfcm:Route ; dfcm:to dfcm:Admit ; dfcm:trigger "routed" ; dfcm:authority "policy" ; dfcm:actuationAllowed false .
dfcm:TAdmitSelect a dfcm:Transition ; dfcm:from dfcm:Admit ; dfcm:to dfcm:Select ; dfcm:trigger "admitted" ; dfcm:authority "grant" ; dfcm:actuationAllowed false .
dfcm:TSelectConstruct a dfcm:Transition ; dfcm:from dfcm:Select ; dfcm:to dfcm:Construct ; dfcm:trigger "selected" ; dfcm:authority "grant" ; dfcm:actuationAllowed false .
dfcm:TConstructDo a dfcm:Transition ; dfcm:from dfcm:Construct ; dfcm:to dfcm:Do ; dfcm:trigger "constructed" ; dfcm:authority "BRCE" ; dfcm:actuationAllowed true .
dfcm:TDoReceipt a dfcm:Transition ; dfcm:from dfcm:Do ; dfcm:to dfcm:ReceiptOp ; dfcm:trigger "consequence-observed" ; dfcm:authority "BRCE" ; dfcm:actuationAllowed false .
dfcm:TReceiptReplay a dfcm:Transition ; dfcm:from dfcm:ReceiptOp ; dfcm:to dfcm:Replay ; dfcm:trigger "receipted" ; dfcm:authority "receipt" ; dfcm:actuationAllowed false .
dfcm:TReplayStanding a dfcm:Transition ; dfcm:from dfcm:Replay ; dfcm:to dfcm:Standing ; dfcm:trigger "verified" ; dfcm:authority "evidence" ; dfcm:actuationAllowed false .
dfcm:TRefusalRepair a dfcm:Transition ; dfcm:from dfcm:Refuse ; dfcm:to dfcm:Diagnose ; dfcm:trigger "typed-refusal" ; dfcm:authority "none" ; dfcm:actuationAllowed false .
dfcm:TDiagnoseRepair a dfcm:Transition ; dfcm:from dfcm:Diagnose ; dfcm:to dfcm:Repair ; dfcm:trigger "diagnosed" ; dfcm:authority "none" ; dfcm:actuationAllowed false .
dfcm:TRepairRoute a dfcm:Transition ; dfcm:from dfcm:Repair ; dfcm:to dfcm:Route ; dfcm:trigger "repair-intent" ; dfcm:authority "none" ; dfcm:actuationAllowed false .
dfcm:THookRoute a dfcm:Transition ; dfcm:from dfcm:Hook ; dfcm:to dfcm:Route ; dfcm:trigger "hook-intent" ; dfcm:authority "none" ; dfcm:actuationAllowed false .

dfcm:NoAmbientAuthority a dfcm:Invariant ; dfcm:requirement "Only BRCE may invoke an actuator" .
dfcm:SelectConstructDoSeparation a dfcm:Invariant ; dfcm:requirement "SELECT, CONSTRUCT, and DO are distinct operations" .
dfcm:ZeroUnreceiptedActuation a dfcm:Invariant ; dfcm:requirement "Every successful DO has a receipt" .
dfcm:HookIntentOnly a dfcm:Invariant ; dfcm:requirement "Hooks manufacture intents and never actuate" .
dfcm:ExactSubjectAlive a dfcm:Invariant ; dfcm:requirement "ALIVE requires execution of the exact admitted subject" .
dfcm:FailureIsTopology a dfcm:Invariant ; dfcm:requirement "One failed edge does not collapse independent lawful alternatives" .
dfcm:ProjectionNotAuthority a dfcm:Invariant ; dfcm:requirement "Generated projections are not authoritative editing surfaces" .
dfcm:Fortune5NoCertificationByReadiness a dfcm:Invariant ; dfcm:requirement "Fortune 5 readiness never implies external certification" .
dfcm:Fortune5EvidenceClosed a dfcm:Invariant ; dfcm:requirement "Every mandatory enterprise control requires exact-subject receipted evidence and a falsifier" .

# Fortune 5 readiness controls. Readiness is an internal evidence state, never an external certification.
dfcm:F5GovernancePolicyGraph a dfcm:EnterpriseControl ; dfcm:order 1 ; dfcm:slug "governance-policy-graph" ; rdfs:label "Governance policy graph" ; dfcm:domain "governance-risk" ; dfcm:criticality "critical" ; dfcm:accountableRole "Enterprise Architecture" ; dfcm:evidenceKind "policy-graph" ; dfcm:frameworkRef "NIST-CSF-2.0" ; dfcm:maxAgeHours 168 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Policy graph is versioned, admitted, and linked to control owners" ; dfcm:falsifier "Unowned or unversioned policy governs production" .
dfcm:F5EnterpriseRiskRegister a dfcm:EnterpriseControl ; dfcm:order 2 ; dfcm:slug "enterprise-risk-register" ; rdfs:label "Enterprise risk register" ; dfcm:domain "governance-risk" ; dfcm:criticality "high" ; dfcm:accountableRole "Enterprise Risk" ; dfcm:evidenceKind "risk-register" ; dfcm:frameworkRef "NIST-CSF-2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Risks have owner, treatment, due date, and evidence links" ; dfcm:falsifier "Critical risk has no owner or treatment" .
dfcm:F5AuthoritySeparation a dfcm:EnterpriseControl ; dfcm:order 3 ; dfcm:slug "authority-separation" ; rdfs:label "Authority separation" ; dfcm:domain "governance-risk" ; dfcm:criticality "critical" ; dfcm:accountableRole "Security Governance" ; dfcm:evidenceKind "authority-receipt" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 1 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "SELECT, CONSTRUCT, DO, and approval authorities are distinct and receipted" ; dfcm:falsifier "One ambient principal can construct and actuate without independent grant" .
dfcm:F5ExceptionExpiry a dfcm:EnterpriseControl ; dfcm:order 4 ; dfcm:slug "exception-expiry" ; rdfs:label "Exception expiry" ; dfcm:domain "governance-risk" ; dfcm:criticality "high" ; dfcm:accountableRole "Risk Management" ; dfcm:evidenceKind "exception-ledger" ; dfcm:frameworkRef "NIST-CSF-2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Every exception has approver, scope, compensating control, and expiry" ; dfcm:falsifier "Exception survives beyond expiry or lacks compensating control" .
dfcm:F5ExecutiveStanding a dfcm:EnterpriseControl ; dfcm:order 5 ; dfcm:slug "executive-standing" ; rdfs:label "Executive standing" ; dfcm:domain "governance-risk" ; dfcm:criticality "critical" ; dfcm:accountableRole "Executive Sponsor" ; dfcm:evidenceKind "standing-report" ; dfcm:frameworkRef "NIST-CSF-2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Executive view reports exact-subject standing and unresolved falsifiers" ; dfcm:falsifier "Dashboard reports green from inspection or workflow metadata alone" .
dfcm:F5WorkloadIdentity a dfcm:EnterpriseControl ; dfcm:order 6 ; dfcm:slug "workload-identity" ; rdfs:label "Workload identity" ; dfcm:domain "identity-access" ; dfcm:criticality "critical" ; dfcm:accountableRole "IAM" ; dfcm:evidenceKind "identity-attestation" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 1 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "Every production workload has non-human workload identity bound to subject" ; dfcm:falsifier "Shared ambient credentials actuate production" .
dfcm:F5LeastPrivilege a dfcm:EnterpriseControl ; dfcm:order 7 ; dfcm:slug "least-privilege" ; rdfs:label "Least privilege" ; dfcm:domain "identity-access" ; dfcm:criticality "critical" ; dfcm:accountableRole "IAM" ; dfcm:evidenceKind "authorization-policy" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Effective grants are minimal, scoped, and continuously evaluated" ; dfcm:falsifier "Wildcard or unused production privilege remains admitted" .
dfcm:F5PrivilegedJit a dfcm:EnterpriseControl ; dfcm:order 8 ; dfcm:slug "privileged-jit" ; rdfs:label "Just-in-time privileged access" ; dfcm:domain "identity-access" ; dfcm:criticality "critical" ; dfcm:accountableRole "IAM" ; dfcm:evidenceKind "privilege-receipt" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 1 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Privileged grants are time-bound, purpose-bound, and receipted" ; dfcm:falsifier "Standing privileged access bypasses admission" .
dfcm:F5BreakGlass a dfcm:EnterpriseControl ; dfcm:order 9 ; dfcm:slug "break-glass" ; rdfs:label "Break-glass control" ; dfcm:domain "identity-access" ; dfcm:criticality "critical" ; dfcm:accountableRole "Security Operations" ; dfcm:evidenceKind "break-glass-receipt" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 1 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Emergency authority is explicit, short-lived, audited, and post-reviewed" ; dfcm:falsifier "Emergency path becomes persistent ambient authority" .
dfcm:F5CredentialRotation a dfcm:EnterpriseControl ; dfcm:order 10 ; dfcm:slug "credential-rotation" ; rdfs:label "Credential and secret rotation" ; dfcm:domain "identity-access" ; dfcm:criticality "high" ; dfcm:accountableRole "IAM" ; dfcm:evidenceKind "rotation-evidence" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "Secrets and credentials rotate within declared cryptoperiod and revoke old material" ; dfcm:falsifier "Expired or superseded credentials remain effective" .
dfcm:F5DataClassification a dfcm:EnterpriseControl ; dfcm:order 11 ; dfcm:slug "data-classification" ; rdfs:label "Data classification" ; dfcm:domain "data-privacy" ; dfcm:criticality "critical" ; dfcm:accountableRole "Data Governance" ; dfcm:evidenceKind "classification-catalog" ; dfcm:frameworkRef "NIST-CSF-2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Every governed dataset has owner, classification, permitted uses, and lineage" ; dfcm:falsifier "Unclassified production data bypasses policy" .
dfcm:F5EncryptionAtRest a dfcm:EnterpriseControl ; dfcm:order 12 ; dfcm:slug "encryption-at-rest" ; rdfs:label "Encryption at rest" ; dfcm:domain "data-privacy" ; dfcm:criticality "critical" ; dfcm:accountableRole "Security Engineering" ; dfcm:evidenceKind "crypto-evidence" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "Protected data stores prove approved encryption and key identity" ; dfcm:falsifier "Protected data persists unencrypted" .
dfcm:F5EncryptionInTransit a dfcm:EnterpriseControl ; dfcm:order 13 ; dfcm:slug "encryption-in-transit" ; rdfs:label "Encryption in transit" ; dfcm:domain "data-privacy" ; dfcm:criticality "critical" ; dfcm:accountableRole "Security Engineering" ; dfcm:evidenceKind "transport-evidence" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 1 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "Protected service edges prove authenticated encryption" ; dfcm:falsifier "Protected traffic traverses plaintext or unauthenticated channel" .
dfcm:F5KeySeparation a dfcm:EnterpriseControl ; dfcm:order 14 ; dfcm:slug "key-separation" ; rdfs:label "Cryptographic key separation" ; dfcm:domain "data-privacy" ; dfcm:criticality "critical" ; dfcm:accountableRole "Security Engineering" ; dfcm:evidenceKind "key-policy" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Keys are separated by environment, purpose, and authority domain" ; dfcm:falsifier "One key crosses environment or incompatible purpose boundaries" .
dfcm:F5RetentionResidency a dfcm:EnterpriseControl ; dfcm:order 15 ; dfcm:slug "retention-residency" ; rdfs:label "Retention and residency policy" ; dfcm:domain "data-privacy" ; dfcm:criticality "high" ; dfcm:accountableRole "Privacy Office" ; dfcm:evidenceKind "data-policy-receipt" ; dfcm:frameworkRef "NIST-CSF-2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Data placement, retention, deletion, and legal holds match declared policy" ; dfcm:falsifier "Data remains in prohibited region or beyond admitted retention" .
dfcm:F5TenantIsolation a dfcm:EnterpriseControl ; dfcm:order 16 ; dfcm:slug "tenant-isolation" ; rdfs:label "Tenant isolation" ; dfcm:domain "platform-tenancy" ; dfcm:criticality "critical" ; dfcm:accountableRole "Platform Engineering" ; dfcm:evidenceKind "isolation-test" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 1 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "Cross-tenant access tests fail closed across compute, data, network, and control plane" ; dfcm:falsifier "Any tenant can observe or mutate another tenant without explicit grant" .
dfcm:F5EnvironmentSeparation a dfcm:EnterpriseControl ; dfcm:order 17 ; dfcm:slug "environment-separation" ; rdfs:label "Environment separation" ; dfcm:domain "platform-tenancy" ; dfcm:criticality "critical" ; dfcm:accountableRole "Platform Engineering" ; dfcm:evidenceKind "boundary-test" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 1 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "Development, test, staging, and production have distinct authority and data boundaries" ; dfcm:falsifier "Non-production identity can actuate production" .
dfcm:F5NetworkSegmentation a dfcm:EnterpriseControl ; dfcm:order 18 ; dfcm:slug "network-segmentation" ; rdfs:label "Network segmentation" ; dfcm:domain "platform-tenancy" ; dfcm:criticality "critical" ; dfcm:accountableRole "Network Security" ; dfcm:evidenceKind "network-policy-evidence" ; dfcm:frameworkRef "NIST-SP-800-53-Rev5-5.2.0" ; dfcm:maxAgeHours 1 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "East-west and north-south flows are explicitly admitted and observable" ; dfcm:falsifier "Implicit network reachability bypasses policy" .
dfcm:F5ResourceQuotas a dfcm:EnterpriseControl ; dfcm:order 19 ; dfcm:slug "resource-quotas" ; rdfs:label "Resource quotas and blast-radius bounds" ; dfcm:domain "platform-tenancy" ; dfcm:criticality "high" ; dfcm:accountableRole "Platform Engineering" ; dfcm:evidenceKind "quota-policy" ; dfcm:frameworkRef "NIST-CSF-2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "Tenant and workload resource limits bound noisy-neighbor and runaway failure impact" ; dfcm:falsifier "Single tenant can exhaust shared critical capacity" .
dfcm:F5RegionFailureDomains a dfcm:EnterpriseControl ; dfcm:order 20 ; dfcm:slug "region-failure-domains" ; rdfs:label "Regional failure domains" ; dfcm:domain "platform-tenancy" ; dfcm:criticality "critical" ; dfcm:accountableRole "Cloud Platform" ; dfcm:evidenceKind "topology-evidence" ; dfcm:frameworkRef "NIST-CSF-2.0" ; dfcm:maxAgeHours 24 ; dfcm:automationLevel "governed" ; dfcm:required true ; dfcm:verifier "Critical services demonstrate independent failure domains and declared placement policy" ; dfcm:falsifier "Nominal multi-region topology shares a hidden single failure dependency" .
dfcm:F5Sbom a dfcm:EnterpriseControl ; dfcm:order 21 ; dfcm:slug "sbom" ; rdfs:label "Software bill of materials" ; dfcm:domain "software-supply-chain" ; dfcm:criticality "high" ; dfcm:accountableRole "Product Security" ; dfcm:evidenceKind "sbom" ; dfcm:frameworkRef "NIST-SSDF-1.1" ; dfcm:maxAgeHours 0 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "Every releasable artifact has machine-readable component inventory bound to artifact digest" ; dfcm:falsifier "Release artifact lacks dependency inventory" .
dfcm:F5ProvenanceAttestation a dfcm:EnterpriseControl ; dfcm:order 22 ; dfcm:slug "provenance-attestation" ; rdfs:label "Build provenance attestation" ; dfcm:domain "software-supply-chain" ; dfcm:criticality "critical" ; dfcm:accountableRole "Build Platform" ; dfcm:evidenceKind "provenance-attestation" ; dfcm:frameworkRef "NIST-SSDF-1.1" ; dfcm:maxAgeHours 0 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "Build provenance binds source, builder, inputs, parameters, and artifact digest" ; dfcm:falsifier "Artifact origin or builder identity cannot be established" .
dfcm:F5SignedArtifacts a dfcm:EnterpriseControl ; dfcm:order 23 ; dfcm:slug "signed-artifacts" ; rdfs:label "Signed release artifacts" ; dfcm:domain "software-supply-chain" ; dfcm:criticality "critical" ; dfcm:accountableRole "Release Engineering" ; dfcm:evidenceKind "signature-verification" ; dfcm:frameworkRef "NIST-SSDF-1.1" ; dfcm:maxAgeHours 0 ; dfcm:automationLevel "automatic" ; dfcm:required true ; dfcm:verifier "Production release artifacts verify trusted signer and immutable digest" ; dfcm:falsifier "Unsigned or untrusted artifact reaches release admission" .
