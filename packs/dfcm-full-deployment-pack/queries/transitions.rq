PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
SELECT ?fromSlug ?toSlug ?trigger ?authority ?actuationAllowed
WHERE {
  ?transition a dfcm:Transition ;
    dfcm:from ?from ;
    dfcm:to ?to ;
    dfcm:trigger ?trigger ;
    dfcm:authority ?authority ;
    dfcm:actuationAllowed ?actuationAllowed .
  ?from dfcm:slug ?fromSlug .
  ?to dfcm:slug ?toSlug .
}
ORDER BY ?fromSlug ?toSlug
