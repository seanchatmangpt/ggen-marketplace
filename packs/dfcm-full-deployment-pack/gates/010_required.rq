PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?component ?missing
WHERE {
  ?component a dfcm:DeploymentComponent .
  {
    FILTER NOT EXISTS { ?component dfcm:order ?v }
    BIND("order" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?component dfcm:slug ?v }
    BIND("slug" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?component rdfs:label ?v }
    BIND("label" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?component dfcm:kind ?v }
    BIND("kind" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?component dfcm:outcome ?v }
    BIND("outcome" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?component dfcm:verifier ?v }
    BIND("verifier" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?component dfcm:falsifier ?v }
    BIND("falsifier" AS ?missing)
  }
}
