PREFIX dfcm: <https://ggen.dev/ontology/dfcm#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?control ?missing
WHERE {
  ?control a dfcm:EnterpriseControl .
  {
    FILTER NOT EXISTS { ?control dfcm:order ?v }
    BIND("order" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:slug ?v }
    BIND("slug" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control rdfs:label ?v }
    BIND("label" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:domain ?v }
    BIND("domain" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:criticality ?v }
    BIND("criticality" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:accountableRole ?v }
    BIND("accountableRole" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:evidenceKind ?v }
    BIND("evidenceKind" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:frameworkRef ?v }
    BIND("frameworkRef" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:maxAgeHours ?v }
    BIND("maxAgeHours" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:automationLevel ?v }
    BIND("automationLevel" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:verifier ?v }
    BIND("verifier" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:falsifier ?v }
    BIND("falsifier" AS ?missing)
  } UNION {
    FILTER NOT EXISTS { ?control dfcm:required true }
    BIND("required=true" AS ?missing)
  }
}
