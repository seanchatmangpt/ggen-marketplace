{
  "schema": "ggen.option-capital.metrics.v1",
  "authority": "VERIFY",
  "actuationPerformed": false,
  "metrics": [
  {%- for row in results %}
    {
      "candidateCount": {{ row.candidateCount }},
      "compositionCount": {{ row.compositionCount }},
      "capabilitySpaceDelta": {{ row.capabilitySpaceDelta }}
    }
  {%- endfor %}
  ]
}
