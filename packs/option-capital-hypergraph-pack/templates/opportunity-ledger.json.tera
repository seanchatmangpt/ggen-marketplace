{
  "schema": "ggen.option-capital.ledger.v1",
  "authority": "SELECT",
  "actuationPerformed": false,
  "edges": [
  {%- for row in rows %}
    {
      "capability": "{{ row.capability }}",
      "composition": "{{ row.composition }}",
      "candidate": "{{ row.candidate }}",
      "repository": "{{ row.repository }}",
      "marketplaceSupport": "{{ row.marketplaceSupport }}",
      "missingPrimitive": "{{ row.missingPrimitive }}",
      "qualification": "{{ row.qualification }}",
      "reversibility": {{ row.reversibility }},
      "expectedReuse": {{ row.expectedReuse }},
      "expectedCapabilitySpaceDelta": {{ row.expectedCapabilitySpaceDelta }}
    }{% if not loop.last %},{% endif %}
  {%- endfor %}
  ]
}
