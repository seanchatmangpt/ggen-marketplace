PREFIX oc: <https://ggen.dev/ontology/option-capital#>
SELECT ?edge ?capability ?composition ?candidate ?repository ?marketplaceSupport ?missingPrimitive ?qualification ?reversibility ?expectedReuse ?expectedCapabilitySpaceDelta
WHERE {
  ?edge a oc:OpportunityEdge ;
    oc:capability ?capability ;
    oc:composition ?composition ;
    oc:candidate ?candidate ;
    oc:repository ?repository ;
    oc:marketplaceSupport ?marketplaceSupport ;
    oc:missingPrimitive ?missingPrimitive ;
    oc:qualification ?qualification ;
    oc:reversibility ?reversibility ;
    oc:expectedReuse ?expectedReuse ;
    oc:expectedCapabilitySpaceDelta ?expectedCapabilitySpaceDelta .
}
ORDER BY DESC(?expectedCapabilitySpaceDelta) DESC(?expectedReuse) DESC(?reversibility) ?candidate
