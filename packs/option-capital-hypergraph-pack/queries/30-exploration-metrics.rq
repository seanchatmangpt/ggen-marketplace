PREFIX oc: <https://ggen.dev/ontology/option-capital#>
SELECT (COUNT(DISTINCT ?candidate) AS ?candidateCount)
       (COUNT(DISTINCT ?composition) AS ?compositionCount)
       (SUM(?delta) AS ?capabilitySpaceDelta)
WHERE {
  ?candidate a oc:Candidate ;
    oc:composition ?composition ;
    oc:executable true ;
    oc:dominated false ;
    oc:expectedCapabilitySpaceDelta ?delta .
}
