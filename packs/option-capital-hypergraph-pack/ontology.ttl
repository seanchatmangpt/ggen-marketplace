@prefix oc: <https://ggen.dev/ontology/option-capital#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

oc:Capability a prov:Entity .
oc:Composition a prov:Entity .
oc:Candidate a prov:Entity .
oc:Repository a prov:Entity .
oc:MarketplaceSupport a prov:Entity .
oc:Qualification a prov:Entity .
oc:OpportunityEdge a prov:Entity .

oc:explorer oc:authority "SELECT|CONSTRUCT|VERIFY" ;
  oc:actuationPerformed false ;
  oc:preservesNonDominatedAlternatives true ;
  oc:requiresExactSubject true ;
  oc:requiresReversibleSelection true ;
  oc:maxCompositionOrder 3 .

oc:r21Fanout a oc:Capability ; oc:name "manufacturing-fanout-controller" ; oc:standing "ALIVE" .
oc:lineagePropagation a oc:Capability ; oc:name "capability-lineage-propagation" ; oc:standing "ALIVE" .
oc:multicellFactory a oc:Capability ; oc:name "multicell-consumer-factory" ; oc:standing "ALIVE" .

oc:r22Composition a oc:Composition ;
  oc:member oc:r21Fanout, oc:lineagePropagation, oc:multicellFactory ;
  oc:order 3 ;
  oc:reversible true .

oc:r22Candidate a oc:Candidate ;
  oc:composition oc:r22Composition ;
  oc:repository "seanchatmangpt/ggen-marketplace" ;
  oc:marketplaceSupport "option-capital-hypergraph-pack" ;
  oc:missingPrimitive "NONE" ;
  oc:qualification "marketplace-validate+deterministic-replay" ;
  oc:reversibility 1.0 ;
  oc:expectedReuse 3 ;
  oc:expectedCapabilitySpaceDelta 6 ;
  oc:executable true ;
  oc:dominated false .

oc:edgeR22 a oc:OpportunityEdge ;
  oc:capability oc:r21Fanout ;
  oc:composition oc:r22Composition ;
  oc:candidate oc:r22Candidate ;
  oc:repository "seanchatmangpt/ggen-marketplace" ;
  oc:marketplaceSupport "option-capital-hypergraph-pack" ;
  oc:missingPrimitive "NONE" ;
  oc:qualification "marketplace-validate+deterministic-replay" ;
  oc:reversibility 1.0 ;
  oc:expectedReuse 3 ;
  oc:expectedCapabilitySpaceDelta 6 ;
  oc:authority "SELECT" ;
  oc:actuationPerformed false .
