@prefix ar: <https://ggen.dev/ontology/ash-revops-structural#> .

ar:legacyCrm a ar:ExistingStructure .
ar:ashRevOps a ar:CandidateStructure ; ar:reversible true ; ar:supersedes ar:legacyCrm ; ar:hasPackOption ar:domainPack, ar:ocelPack .
ar:domainPack a ar:PackOption .
ar:ocelPack a ar:PackOption .
ar:workspace a ar:GeneratedConsequence ; ar:revenueFrom ar:subscription ; ar:revenueFor ar:throughputGain ; ar:hasConsumer ar:customerOps .
ar:subscription a ar:RevenueFromCustomer ; ar:valueMetric "ARR" .
ar:throughputGain a ar:RevenueForCustomer ; ar:valueMetric "cycle-time" .
ar:customerOps a ar:Consumer ; ar:hasQualification ar:q1 ; ar:producesRefinement ar:r1 .
ar:q1 a ar:Qualification .
ar:r1 a ar:AgentRefinement ; ar:promotesKnowledge ar:k1 .
ar:k1 a ar:GeneralizableKnowledge ; ar:regenerates ar:customerOps .
ar:event1 a ar:OCELEvent ; ar:valueMetric "cycle-time" ; ar:proof "receipt:q1" .
