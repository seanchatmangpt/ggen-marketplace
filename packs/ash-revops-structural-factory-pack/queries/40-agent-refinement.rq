PREFIX ar: <https://ggen.dev/ontology/ash-revops-structural#>
SELECT ?consumer ?refinement ?knowledge WHERE {
  ?consumer a ar:Consumer ; ar:producesRefinement ?refinement .
  ?refinement a ar:AgentRefinement ; ar:promotesKnowledge ?knowledge .
  ?knowledge a ar:GeneralizableKnowledge .
} ORDER BY ?consumer ?refinement
