PREFIX ar: <https://ggen.dev/ontology/ash-revops-structural#>
ASK {
  FILTER NOT EXISTS {
    ?artifact a ar:GeneratedConsequence .
    FILTER NOT EXISTS { ?artifact ar:revenueFrom ?from . ?from a ar:RevenueFromCustomer . }
  }
  FILTER NOT EXISTS {
    ?artifact a ar:GeneratedConsequence .
    FILTER NOT EXISTS { ?artifact ar:revenueFor ?for . ?for a ar:RevenueForCustomer . }
  }
}
