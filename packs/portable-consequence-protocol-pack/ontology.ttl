@prefix pcp: <urn:portable-consequence:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pcp:ProtocolProfile a dcterms:Standard ;
  dcterms:identifier "portable-consequence/1" ;
  dcterms:title "Portable Consequence Protocol" ;
  dcterms:description "Authority constrains admissible consequences; receipt capability is required before consequential actuation; observed consequences are receipted and replayable." .

pcp:AuthorityDecision a skos:Concept ; skos:exactMatch odrl:Permission .
pcp:Consequence a skos:Concept ; skos:exactMatch prov:Activity .
pcp:Observation a skos:Concept ; skos:exactMatch prov:Entity .
pcp:Receipt a skos:Concept ; skos:exactMatch prov:Entity .
pcp:Verification a skos:Concept ; skos:exactMatch earl:Assertion .

# Small disposable remainder: relations not yet represented by an admitted public equivalent.
pcp:admitsDigest a rdf:Property ; dcterms:description "Binds authority to the exact consequence digest it admits." .
pcp:receiptCapability a rdf:Property ; dcterms:description "Pre-actuation capability to emit and replay an exact-consequence receipt." .
pcp:previousReceiptDigest a rdf:Property ; dcterms:description "Prior receipt identity for ordered replay." .
pcp:replayKey a rdf:Property ; dcterms:description "Idempotency identity; reuse with another consequence is refused." .
pcp:standingCode a rdf:Property ; dcterms:description "Evidence-bounded standing/refusal code; assertion alone grants no standing." .

pcp:AuthorityFragment a dcterms:Standard ; dcterms:identifier "authority/1" .
pcp:ConsequenceFragment a dcterms:Standard ; dcterms:identifier "consequence/1" .
pcp:ReceiptFragment a dcterms:Standard ; dcterms:identifier "receipt/1" .
pcp:ReplayFragment a dcterms:Standard ; dcterms:identifier "replay/1" .
