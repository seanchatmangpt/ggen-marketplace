@prefix pcp: <urn:portable-consequence:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix earl: <http://www.w3.org/ns/earl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

pcp:ProtocolProfile a dcterms:Standard ;
  dcterms:identifier "portable-consequence/1" ;
  dcterms:title "Portable Consequence Protocol" ;
  dcterms:description "Authority is represented directly as ODRL permission evidence; consequences as PROV activities; observations and receipts as PROV entities; verification as EARL assertions. Receipt capability is required before consequential actuation, and exact observed consequences are receipted and replayable." .

# Small disposable remainder: only relations not yet represented by an admitted
# public equivalent. Public classes are used directly rather than wrapped.
pcp:admitsDigest a rdf:Property ;
  rdfs:domain odrl:Permission ;
  dcterms:description "Binds authority evidence to the exact consequence digest it admits." .

pcp:receiptCapability a rdf:Property ;
  rdfs:domain prov:Activity ;
  dcterms:description "Pre-actuation capability to emit and replay an exact-consequence receipt." .

pcp:previousReceiptDigest a rdf:Property ;
  rdfs:domain prov:Entity ;
  dcterms:description "Prior receipt identity for ordered replay." .

pcp:replayKey a rdf:Property ;
  dcterms:description "Idempotency identity; reuse with another consequence is refused." .

pcp:standingCode a rdf:Property ;
  rdfs:domain earl:Assertion ;
  dcterms:description "Evidence-bounded standing/refusal code; assertion alone grants no standing." .

pcp:AuthorityFragment a dcterms:Standard ; dcterms:identifier "authority/1" .
pcp:ConsequenceFragment a dcterms:Standard ; dcterms:identifier "consequence/1" .
pcp:ReceiptFragment a dcterms:Standard ; dcterms:identifier "receipt/1" .
pcp:ReplayFragment a dcterms:Standard ; dcterms:identifier "replay/1" .
