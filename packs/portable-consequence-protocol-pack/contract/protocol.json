{
  "protocol": "portable-consequence/1",
  "fragments": ["authority/1", "consequence/1", "receipt/1", "replay/1"],
  "standing": ["UNKNOWN", "PARTIAL_ALIVE", "ALIVE", "BLOCKED", "BUILD_BROKEN", "UNSUPPORTED", "REFUSED"],
  "laws": {
    "ambient_authority": false,
    "authority_binds_exact_consequence": true,
    "receiptability_precedes_do": true,
    "planner_output_grants_authority": false,
    "constructor_output_grants_authority": false,
    "transport_grants_authority": false,
    "same_replay_key_different_consequence": "REFUSED:REPLAY_KEY_CONFLICT"
  },
  "wire": {
    "operation": ["admit", "verify_receipt", "replay"],
    "request_encoding": "application/json; one object per process invocation",
    "response_encoding": "application/json",
    "digest": {
      "semantic_role": "content identity",
      "algorithm_is_protocol_parameter": true,
      "known_algorithms": ["sha-256", "blake3-256"]
    }
  },
  "custom_remainder_policy": {
    "disposable": true,
    "replace_when_public_equivalent_is_proven": true,
    "runtime_registry_dependency": false
  }
}
