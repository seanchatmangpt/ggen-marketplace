@prefix pcp: <urn:portable-consequence:> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Only resources explicitly declaring receipt capability are in the
# consequential admission surface; ordinary PROV activities are untouched.
pcp:ConsequentialActivityShape a sh:NodeShape ;
  sh:targetSubjectsOf pcp:receiptCapability ;
  sh:property [ sh:path pcp:receiptCapability ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path pcp:replayKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

# Receipt-chain validation applies only where a previous receipt identity is
# actually asserted, avoiding a custom Receipt class solely for SHACL targeting.
pcp:ReceiptChainShape a sh:NodeShape ;
  sh:targetSubjectsOf pcp:previousReceiptDigest ;
  sh:property [ sh:path pcp:previousReceiptDigest ; sh:maxCount 1 ; sh:datatype xsd:string ] .
