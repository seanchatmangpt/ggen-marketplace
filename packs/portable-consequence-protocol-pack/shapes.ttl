@prefix pcp: <urn:portable-consequence:> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pcp:ConsequentialActivityShape a sh:NodeShape ;
  sh:targetClass prov:Activity ;
  sh:property [ sh:path pcp:receiptCapability ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path pcp:replayKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] .

pcp:ReceiptShape a sh:NodeShape ;
  sh:targetClass prov:Entity ;
  sh:property [ sh:path pcp:previousReceiptDigest ; sh:maxCount 1 ; sh:datatype xsd:string ] .
