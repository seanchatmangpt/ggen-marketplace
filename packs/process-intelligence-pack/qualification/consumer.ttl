@prefix pi: <https://ggen.dev/ontology/process-intelligence#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Minimal independent positive qualification fixture: a second, distinctly
# named event log / process model / conformance check a consumer pack could
# query against -- exercises the full Event/Object/ProcessModel/ConformanceCheck
# chain with real individuals distinct from the pack's own worked example.
# This fixture is lawful (the conformant check has real compared events) and
# must NOT trigger gates/010_conformance_requires_compared_event.rq.

pi:ConsumerObject-Ticket-001 a pi:Object ;
    pi:objectType "SupportTicket" ;
    rdfs:label "A downstream consumer's real support-ticket object" .

pi:ConsumerEvent-TicketOpened-001 a pi:Event ;
    pi:activity "TicketOpened" ;
    pi:observedAt "2026-09-10T08:00:00Z"^^xsd:dateTime ;
    pi:relatesObject pi:ConsumerObject-Ticket-001 ;
    rdfs:label "A downstream consumer's first observed event" .

pi:ConsumerEvent-TicketResolved-001 a pi:Event ;
    pi:activity "TicketResolved" ;
    pi:observedAt "2026-09-11T16:00:00Z"^^xsd:dateTime ;
    pi:relatesObject pi:ConsumerObject-Ticket-001 ;
    rdfs:label "A downstream consumer's second observed event" .

pi:ConsumerProcessModel-TicketLifecycle-001 a pi:ProcessModel ;
    pi:modelId "consumer/ticket-lifecycle/001" ;
    pi:derivedFromEvent pi:ConsumerEvent-TicketOpened-001 ;
    pi:derivedFromEvent pi:ConsumerEvent-TicketResolved-001 ;
    rdfs:label "A downstream consumer's process model, derived from its own two events" .

pi:ConsumerConformanceCheck-TicketLifecycle-001 a pi:ConformanceCheck ;
    pi:comparesEvent pi:ConsumerEvent-TicketOpened-001 ;
    pi:comparesEvent pi:ConsumerEvent-TicketResolved-001 ;
    pi:checksAgainstModel pi:ConsumerProcessModel-TicketLifecycle-001 ;
    pi:conformant true ;
    rdfs:label "A downstream consumer's conformant check, evidenced end to end" .
