    pub id_field: &'static str,
    pub time_field: &'static str,
    pub hash: &'static str,
}
pub struct RuleSpec {
    pub rule: &'static str,
    pub source: &'static str,
    pub name: &'static str,
    pub event: &'static str,
    pub object: &'static str,
    pub qualifier: &'static str,
    pub path: &'static str,
}
pub const SOURCES: &[SourceSpec] = &[
{% for r in sources %}    SourceSpec { id: "{{ r.id }}", kind: "{{ r.kind }}", name_field: "{{ r.nameField }}", id_field: "{{ r.idField }}", time_field: "{{ r.timeField }}", hash: "{{ r.algo }}" },
{% endfor %}];
pub const RULES: &[RuleSpec] = &[
{% for r in rules %}    RuleSpec { rule: "{{ r.rule }}", source: "{{ r.src }}", name: "{{ r.name }}", event: "{{ r.event }}", object: "{{ r.object }}", qualifier: "{{ r.qualifier }}", path: "{{ r.path }}" },
{% endfor %}];
pub const PHASE_OPEN: &str = "{% for r in roles %}{% if loop.first %}{{ r.id }}{% endif %}{% endfor %}";
pub const PHASE_CLOSE: &str = "{% for r in roles %}{% if loop.last %}{{ r.id }}{% endif %}{% endfor %}";
pub const PHASED: &[(&str, &str)] = &[
{% for r in phased %}    ("{{ r.type }}", "{{ r.phase }}"),
{% endfor %}];
