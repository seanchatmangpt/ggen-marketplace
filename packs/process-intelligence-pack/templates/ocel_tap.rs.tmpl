---
to: src/pi_ocel_tap/rs/tap.rs
sparql:
  eventTypes: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?id WHERE { ?t a pi:EventType ; pi:typeId ?id . } ORDER BY ?id
  objectTypes: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?id WHERE { ?t a pi:ObjectType ; pi:typeId ?id . } ORDER BY ?id
  hashes: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?id WHERE { ?l a pi:LanguageSupport ; pi:language "rs" ; pi:supportsHash ?id . } ORDER BY ?id
  sources: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?id ?kind ?nameField ?idField ?timeField ?algo WHERE {
      ?s a pi:EventSource ; pi:sourceId ?id ; pi:sourceKind ?kind ; pi:nameField ?nameField ;
         pi:idField ?idField ; pi:timeField ?timeField ; pi:chainPolicy ?p .
      ?p pi:hashAlgorithm ?algo ; pi:targetLanguage "rs" .
    } ORDER BY ?id
  rules: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?rule ?src ?name ?event ?object ?qualifier ?path WHERE {
      ?r a pi:MappingRule ; pi:ruleId ?rule ; pi:fromSource ?s ; pi:sourceEvent ?name ;
         pi:emitsEventType ?et ; pi:hasRelation ?rel .
      ?s pi:sourceId ?src ; pi:chainPolicy ?p . ?p pi:targetLanguage "rs" .
      ?et pi:typeId ?event .
      ?rel pi:relatesObjectType ?ot ; pi:hasQualifier ?q ; pi:objectIdPath ?path .
      ?ot pi:typeId ?object . ?q pi:qualifierId ?qualifier .
    } ORDER BY ?rule ?object ?qualifier ?path
  roles: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?id WHERE { ?r a pi:PhaseRole ; pi:phaseId ?id ; pi:phaseOrder ?o . } ORDER BY ?o
  phased: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?type ?phase WHERE { ?t a pi:EventType ; pi:typeId ?type ; pi:phaseRole ?r . ?r pi:phaseId ?phase . } ORDER BY ?type
  closes: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?outcome ?pending WHERE { ?o a pi:EventType ; pi:typeId ?outcome ; pi:closesEventType ?p . ?p pi:typeId ?pending . } ORDER BY ?outcome ?pending
---
// Generated OCEL 2.0 type registry, source adapter, event-tap mapper, serializer and hash chain.
// Source of truth: the consumer's pi: individuals. Do not edit. Std-only: no external crates.
#![allow(dead_code)]

pub const EVENT_TYPES: &[&str] = &[{% for r in eventTypes %}"{{ r.id }}"{% if not loop.last %}, {% endif %}{% endfor %}];
pub const OBJECT_TYPES: &[&str] = &[{% for r in objectTypes %}"{{ r.id }}"{% if not loop.last %}, {% endif %}{% endfor %}];
pub const SUPPORTED_HASHES: &[&str] = &[{% for r in hashes %}"{{ r.id }}"{% if not loop.last %}, {% endif %}{% endfor %}];

