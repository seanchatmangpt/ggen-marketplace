{% for r in closes %}    ("{{ r.outcome }}", "{{ r.pending }}"),
{% endfor %}];
{% raw %}
fn phase_of(ty: &str) -> &'static str { PHASED.iter().find(|(t, _)| *t == ty).map(|(_, p)| *p).unwrap_or("") }
fn closes_pair(outcome: &str, pending: &str) -> bool { CLOSES.iter().any(|(o, p)| *o == outcome && *p == pending) }
fn object_set(rels: &[Rel]) -> Vec<String> { let mut v: Vec<String> = rels.iter().map(|(o, _)| o.clone()).collect(); v.sort(); v }
pub const CALLBACK_KINDS: &[&str] = &["sdk-callback", "app-server-subscription"];

// ---------- minimal JSON value (std-only) ----------
#[derive(Clone, Debug, PartialEq)]
pub enum Json {
    Null,
    Bool(bool),
    Num(String),
    Str(String),
    Arr(Vec<Json>),
    Obj(Vec<(String, Json)>),
}

impl Json {
    pub fn get(&self, key: &str) -> Option<&Json> {
        match self {
            Json::Obj(kv) => kv.iter().find(|(k, _)| k == key).map(|(_, v)| v),
            _ => None,
        }
    }
    pub fn path(&self, path: &str) -> Option<&Json> {
        let mut cur = self;
        for k in path.split('.') {
            cur = cur.get(k)?;
        }
        Some(cur)
    }
    fn scalar(&self) -> Option<String> {
        match self {
            Json::Str(s) => Some(s.clone()),
            Json::Num(n) => Some(n.clone()),
            Json::Bool(b) => Some(b.to_string()),
            _ => None,
        }
    }
    fn ids(&self) -> Vec<String> {
        match self {
            Json::Arr(items) => items.iter().filter_map(|i| i.scalar()).collect(),
            Json::Null => vec![],
            other => other.scalar().into_iter().collect(),
        }
    }
}

pub fn parse_json(text: &str) -> Result<Json, String> {
    let chars: Vec<char> = text.chars().collect();
    let mut p = 0usize;
    let v = parse_value(&chars, &mut p)?;
    skip_ws(&chars, &mut p);
    if p != chars.len() {
        return Err(format!("trailing characters at {}", p));
    }
    Ok(v)
}

fn skip_ws(c: &[char], p: &mut usize) {
    while *p < c.len() && c[*p].is_whitespace() {
        *p += 1;
    }
}

fn parse_value(c: &[char], p: &mut usize) -> Result<Json, String> {
    skip_ws(c, p);
    if *p >= c.len() {
        return Err("unexpected end".to_string());
    }
    match c[*p] {
        '{' => {
            *p += 1;
            let mut kv = Vec::new();
            skip_ws(c, p);
            if *p < c.len() && c[*p] == '}' {
                *p += 1;
                return Ok(Json::Obj(kv));
            }
            loop {
                skip_ws(c, p);
                let k = match parse_value(c, p)? {
                    Json::Str(s) => s,
                    _ => return Err("object key must be a string".to_string()),
                };
                skip_ws(c, p);
                if *p >= c.len() || c[*p] != ':' {
                    return Err("expected ':'".to_string());
                }
                *p += 1;
                let v = parse_value(c, p)?;
                kv.push((k, v));
                skip_ws(c, p);
                match c.get(*p) {
                    Some(',') => *p += 1,
                    Some('}') => {
                        *p += 1;
                        return Ok(Json::Obj(kv));
                    }
                    _ => return Err("expected ',' or '}'".to_string()),
                }
            }
        }
        '[' => {
            *p += 1;
            let mut items = Vec::new();
            skip_ws(c, p);
            if *p < c.len() && c[*p] == ']' {
                *p += 1;
                return Ok(Json::Arr(items));
            }
            loop {
                items.push(parse_value(c, p)?);
                skip_ws(c, p);
                match c.get(*p) {
                    Some(',') => *p += 1,
                    Some(']') => {
                        *p += 1;
                        return Ok(Json::Arr(items));
                    }
                    _ => return Err("expected ',' or ']'".to_string()),
                }
            }
        }
        '"' => {
            *p += 1;
            let mut out = String::new();
            loop {
                let ch = *c.get(*p).ok_or("unterminated string")?;
                *p += 1;
                match ch {
                    '"' => return Ok(Json::Str(out)),
                    '\\' => {
                        let e = *c.get(*p).ok_or("bad escape")?;
                        *p += 1;
                        match e {
                            '"' => out.push('"'),
                            '\\' => out.push('\\'),
                            '/' => out.push('/'),
                            'b' => out.push('\u{8}'),
                            'f' => out.push('\u{c}'),
                            'n' => out.push('\n'),
                            'r' => out.push('\r'),
                            't' => out.push('\t'),
                            'u' => {
                                let mut code = hex4(c, p)?;
                                if (0xD800..0xDC00).contains(&code) && c.get(*p) == Some(&'\\') && c.get(*p + 1) == Some(&'u') {
                                    *p += 2;
                                    let low = hex4(c, p)?;
                                    code = 0x10000 + ((code - 0xD800) << 10) + (low.wrapping_sub(0xDC00));
                                }
                                out.push(char::from_u32(code).unwrap_or('\u{FFFD}'));
                            }
                            _ => return Err("bad escape".to_string()),
                        }
                    }
                    other => out.push(other),
                }
            }
        }
        't' | 'f' | 'n' => {
            for (lit, val) in [("true", Json::Bool(true)), ("false", Json::Bool(false)), ("null", Json::Null)] {
                let l: Vec<char> = lit.chars().collect();
                if c[*p..].starts_with(&l) {
                    *p += l.len();
                    return Ok(val);
                }
            }
            Err("bad literal".to_string())
        }
        _ => {
            let start = *p;
            while *p < c.len() && (c[*p].is_ascii_digit() || "+-.eE".contains(c[*p])) {
                *p += 1;
            }
            if start == *p {
                return Err(format!("unexpected character at {}", start));
            }
            Ok(Json::Num(c[start..*p].iter().collect()))
        }
    }
}

fn hex4(c: &[char], p: &mut usize) -> Result<u32, String> {
    if *p + 4 > c.len() {
        return Err("bad \\u escape".to_string());
    }
    let s: String = c[*p..*p + 4].iter().collect();
    *p += 4;
    u32::from_str_radix(&s, 16).map_err(|_| "bad \\u escape".to_string())
}

/// JSON string literal, escaped exactly as the other generated languages do.
pub fn jstr(s: &str) -> String {
    let mut out = String::from("\"");
    for ch in s.chars() {
        match ch {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            '\u{8}' => out.push_str("\\b"),
            '\u{c}' => out.push_str("\\f"),
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
            c => out.push(c),
        }
    }
    out.push('"');
    out
}
