---
to: src/pi_ocel_tap/ex/tap.ex
sparql:
  eventTypes: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?id WHERE { ?t a pi:EventType ; pi:typeId ?id . } ORDER BY ?id
  objectTypes: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?id WHERE { ?t a pi:ObjectType ; pi:typeId ?id . } ORDER BY ?id
  hashes: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?id WHERE { ?l a pi:LanguageSupport ; pi:language "ex" ; pi:supportsHash ?id . } ORDER BY ?id
  sources: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?id ?kind ?nameField ?idField ?timeField ?algo WHERE {
      ?s a pi:EventSource ; pi:sourceId ?id ; pi:sourceKind ?kind ; pi:nameField ?nameField ;
         pi:idField ?idField ; pi:timeField ?timeField ; pi:chainPolicy ?p .
      ?p pi:hashAlgorithm ?algo ; pi:targetLanguage "ex" .
    } ORDER BY ?id
  rules: >
    PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
    SELECT ?rule ?src ?name ?event ?object ?qualifier ?path WHERE {
      ?r a pi:MappingRule ; pi:ruleId ?rule ; pi:fromSource ?s ; pi:sourceEvent ?name ;
         pi:emitsEventType ?et ; pi:hasRelation ?rel .
      ?s pi:sourceId ?src ; pi:chainPolicy ?p . ?p pi:targetLanguage "ex" .
      ?et pi:typeId ?event .
      ?rel pi:relatesObjectType ?ot ; pi:hasQualifier ?q ; pi:objectIdPath ?path .
      ?ot pi:typeId ?object . ?q pi:qualifierId ?qualifier .
    } ORDER BY ?rule ?object ?qualifier ?path
---
# Generated OCEL 2.0 type registry, source adapter, event-tap mapper, serializer and hash chain.
# Source of truth: the consumer's pi: individuals. Do not edit. Needs OTP 27+ (:json).
defmodule PiOcelTap do
  @event_types [{% for r in eventTypes %}"{{ r.id }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  @object_types [{% for r in objectTypes %}"{{ r.id }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  @supported_hashes [{% for r in hashes %}"{{ r.id }}"{% if not loop.last %}, {% endif %}{% endfor %}]
  @sources [
{% for r in sources %}    %{id: "{{ r.id }}", kind: "{{ r.kind }}", name_field: "{{ r.nameField }}", id_field: "{{ r.idField }}", time_field: "{{ r.timeField }}", hash: "{{ r.algo }}"}{% if not loop.last %},{% endif %}
{% endfor %}  ]
  @rules [
{% for r in rules %}    %{rule: "{{ r.rule }}", source: "{{ r.src }}", name: "{{ r.name }}", event: "{{ r.event }}", object: "{{ r.object }}", qualifier: "{{ r.qualifier }}", path: "{{ r.path }}"}{% if not loop.last %},{% endif %}
{% endfor %}  ]
{% raw %}
  @callback_kinds ["sdk-callback", "app-server-subscription"]

  def event_types, do: @event_types
  def object_types, do: @object_types
  def supported_hashes, do: @supported_hashes
  def sources, do: @sources
  def rules, do: @rules

{% endraw %}{% for h in hashes %}{% if h.id == "sha256" %}  def hash_hex("sha256", data), do: :crypto.hash(:sha256, data) |> Base.encode16(case: :lower)
{% endif %}{% endfor %}{% raw %}  def hash_hex(alg, _data), do: raise(ArgumentError, "unsupported hash algorithm: " <> alg)

  # JSON string literal, escaped exactly as the other generated languages do.
  def jstr(s), do: "\"" <> esc(s, "") <> "\""

  defp esc(<<>>, acc), do: acc
  defp esc(<<?", r::binary>>, acc), do: esc(r, acc <> "\\\"")
  defp esc(<<?\\, r::binary>>, acc), do: esc(r, acc <> "\\\\")
  defp esc(<<8, r::binary>>, acc), do: esc(r, acc <> "\\b")
  defp esc(<<12, r::binary>>, acc), do: esc(r, acc <> "\\f")
  defp esc(<<10, r::binary>>, acc), do: esc(r, acc <> "\\n")
  defp esc(<<13, r::binary>>, acc), do: esc(r, acc <> "\\r")
  defp esc(<<9, r::binary>>, acc), do: esc(r, acc <> "\\t")

  defp esc(<<c::utf8, r::binary>>, acc) when c < 0x20 do
    hex = c |> Integer.to_string(16) |> String.downcase() |> String.pad_leading(4, "0")
    esc(r, acc <> "\\u" <> hex)
  end

  defp esc(<<c::utf8, r::binary>>, acc), do: esc(r, acc <> <<c::utf8>>)

  # Canonical form: keys sorted, no whitespace. Identical across all generated languages.
  def canon(%{id: id, type: type, time: time, relationships: rels}) do
    r =
      rels
      |> Enum.map(fn %{object_id: o, qualifier: q} -> "{\"objectId\":" <> jstr(o) <> ",\"qualifier\":" <> jstr(q) <> "}" end)
      |> Enum.join(",")

    "{\"id\":" <> jstr(id) <> ",\"relationships\":[" <> r <> "],\"time\":" <> jstr(time) <> ",\"type\":" <> jstr(type) <> "}"
  end

  defp get_path(raw, path) do
    Enum.reduce_while(String.split(path, "."), raw, fn k, cur ->
      case cur do
        %{^k => v} -> {:cont, v}
        _ -> {:halt, nil}
      end
    end)
  end

  defp to_s(v) when is_binary(v), do: v
  defp to_s(v) when is_float(v) and trunc(v) == v, do: Integer.to_string(trunc(v))
  defp to_s(v), do: to_string(v)

  defp ids(nil), do: []
  defp ids(v) when is_list(v), do: Enum.map(v, &to_s/1)
  defp ids(v), do: [to_s(v)]

  defp flatten_otel(%{"attributes" => attrs} = raw) when is_list(attrs) do
    flat =
      Map.new(attrs, fn %{"key" => k} = kv ->
        v =
          case Map.get(kv, "value") do
            %{} = m -> Enum.find_value(["stringValue", "intValue", "boolValue", "doubleValue"], &Map.get(m, &1))
            other -> other
          end

        {k, v}
      end)

    %{raw | "attributes" => flat}
  end

  defp flatten_otel(raw), do: raw

  # ---------- Tap: one Agent per source ----------
  def start(source_id) do
    case Enum.find(@sources, &(&1.id == source_id)) do
      nil -> {:error, "unknown source: " <> source_id}
      spec -> Agent.start_link(fn -> %{spec: spec, events: [], objects: [], last: "", sealed: false} end)
    end
  end

  @doc "stream-json: pass newline-delimited text. every other kind: pass one decoded record (string-keyed map)."
  def ingest(pid, input), do: Agent.get_and_update(pid, &do_ingest(&1, input))

  @doc "sdk-callback and app-server-subscription: hand the runtime a callback."
  def attach(pid, register) do
    kind = Agent.get(pid, & &1.spec.kind)

    if kind in @callback_kinds do
      register.(fn record -> ingest(pid, record) end)
      :ok
    else
      {:error, kind <> " has no callback attachment"}
    end
  end

  defp do_ingest(%{sealed: true} = st, _), do: {{:error, "tap sealed"}, st}

  defp do_ingest(%{spec: %{kind: "stream-json"}} = st, input) when is_binary(input) do
    records =
      input |> String.split("\n") |> Enum.reject(&(String.trim(&1) == "")) |> Enum.map(&:json.decode/1)

    append_all(st, records)
  end

  defp do_ingest(%{spec: %{kind: "stream-json"}} = st, _), do: {{:error, "stream-json expects text"}, st}
  defp do_ingest(%{spec: %{kind: kind}} = st, input) when is_binary(input), do: {{:error, kind <> " expects a decoded record"}, st}
  defp do_ingest(st, input), do: append_all(st, [input])

  defp append_all(st, records) do
    {st, out} =
      Enum.reduce(records, {st, []}, fn r, {s, acc} ->
        case append(s, r) do
          {nil, s2} -> {s2, acc}
          {ev, s2} -> {s2, [ev | acc]}
        end
      end)

    {{:ok, Enum.reverse(out)}, st}
  end

  defp append(%{spec: spec} = st, raw0) do
    raw = if spec.kind == "otel", do: flatten_otel(raw0), else: raw0
    name = get_path(raw, spec.name_field)
    id = get_path(raw, spec.id_field)
    time = get_path(raw, spec.time_field)

    with false <- is_nil(name) or is_nil(id) or is_nil(time),
         [first | _] = rs <- Enum.filter(@rules, &(&1.source == spec.id and &1.name == to_s(name))) do
      {rels, objects} =
        Enum.reduce(rs, {[], st.objects}, fn r, {rels, objs} ->
          Enum.reduce(ids(get_path(raw, r.path)), {rels, objs}, fn oid, {rl, ob} ->
            ob = if List.keymember?(ob, oid, 0), do: ob, else: ob ++ [{oid, r.object}]
            {rl ++ [%{object_id: oid, qualifier: r.qualifier}], ob}
          end)
        end)

      base = %{id: to_s(id), type: first.event, time: to_s(time), relationships: rels}
      hash = hash_hex(spec.hash, st.last <> "\n" <> canon(base))
      ev = Map.merge(base, %{parent: st.last, hash: hash, alg: spec.hash})
      {ev, %{st | events: st.events ++ [ev], objects: objects, last: hash}}
    else
      _ -> {nil, st}
    end
  end

  @doc "seal once: no further ingest; returns the head hash."
  def seal(pid) do
    Agent.get_and_update(pid, fn
      %{sealed: true} = st -> {{:error, "tap already sealed"}, st}
      st -> {{:ok, st.last}, %{st | sealed: true}}
    end)
  end

  def to_ocel(pid) do
    st = Agent.get(pid, & &1)

    %{
      "objectTypes" => Enum.map(@object_types, &%{"name" => &1, "attributes" => []}),
      "eventTypes" => Enum.map(@event_types, &%{"name" => &1, "attributes" => []}),
      "objects" => Enum.map(st.objects, fn {i, t} -> %{"id" => i, "type" => t, "attributes" => [], "relationships" => []} end),
      "events" =>
        Enum.map(st.events, fn e ->
          %{
            "id" => e.id,
            "type" => e.type,
            "time" => e.time,
            "attributes" => [
              %{"name" => "pi_parent", "value" => e.parent},
              %{"name" => "pi_hash", "value" => e.hash},
              %{"name" => "pi_hash_alg", "value" => e.alg}
            ],
            "relationships" => Enum.map(e.relationships, &%{"objectId" => &1.object_id, "qualifier" => &1.qualifier})
          }
        end)
    }
  end

  def serialize(pid), do: pid |> to_ocel() |> :json.encode() |> IO.iodata_to_binary()

  @doc "Recompute the chain over a decoded OCEL document. Returns nil when intact, else the reason."
  def verify_chain(%{"events" => events}, alg) do
    events
    |> Enum.reduce_while({:ok, ""}, fn e, {:ok, parent} ->
      attr = fn n -> Enum.find_value(e["attributes"], fn a -> if a["name"] == n, do: a["value"] end) end

      ev = %{
        id: e["id"],
        type: e["type"],
        time: e["time"],
        relationships: Enum.map(e["relationships"], &%{object_id: &1["objectId"], qualifier: &1["qualifier"]})
      }

      want = hash_hex(alg, parent <> "\n" <> canon(ev))

      cond do
        attr.("pi_parent") != parent -> {:halt, {:error, "parent mismatch at " <> e["id"]}}
        attr.("pi_hash") != want -> {:halt, {:error, "hash mismatch at " <> e["id"]}}
        true -> {:cont, {:ok, want}}
      end
    end)
    |> case do
      {:ok, _} -> nil
      {:error, reason} -> reason
    end
  end
end
{% endraw %}
