@prefix pi: <https://ggen.dev/ontology/process-intelligence#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pi:Event a rdfs:Class .
pi:Object a rdfs:Class .
pi:ProcessModel a rdfs:Class .
pi:ConformanceResult a rdfs:Class .
pi:DriftSignal a rdfs:Class .
pi:ObservationProjection a rdfs:Class .
pi:ExecutionEpisode a rdfs:Class .
pi:DeclaredBehavior a rdfs:Class .
pi:ObservedBehavior a rdfs:Class .
pi:StablePattern a rdfs:Class .

pi:relatesObject a rdf:Property .
pi:observedAt a rdf:Property .
pi:projectsTo a rdf:Property .
pi:conformsTo a rdf:Property .
pi:signalsDrift a rdf:Property .
pi:usesImplementation a rdf:Property .
pi:declaredBehavior a rdf:Property .
pi:observedBehavior a rdf:Property .
pi:stable a rdf:Property .

pi:ClosedLoopObservation a pi:ProcessModel ;
  rdfs:comment "Declared contracts and observed execution remain distinct. Repeated stable behavior may be proposed for deterministic manufacture and must be requalified before use." .
