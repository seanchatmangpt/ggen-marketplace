@prefix pi: <https://ggen.dev/ontology/process-intelligence#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pi:Event a rdfs:Class .
pi:Object a rdfs:Class .
pi:ProcessModel a rdfs:Class .
pi:ConformanceResult a rdfs:Class .
pi:DriftSignal a rdfs:Class .
pi:ObservationProjection a rdfs:Class .
pi:PPCXClosure a rdfs:Class ;
  rdfs:comment "Planning-process closure linking admitted current state, selected policy, observed consequence, evidence, and next admitted state." .

pi:relatesObject a rdf:Property .
pi:observedAt a rdf:Property .
pi:projectsTo a rdf:Property .
pi:conformsTo a rdf:Property .
pi:signalsDrift a rdf:Property .
pi:initialAdmittedState a rdf:Property .
pi:selectedPolicy a rdf:Property .
pi:observedConsequence a rdf:Property .
pi:closureEvidence a rdf:Property .
pi:nextAdmittedState a rdf:Property .
pi:closesInteraction a rdf:Property .
