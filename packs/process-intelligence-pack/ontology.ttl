@prefix pi: <https://ggen.dev/ontology/process-intelligence#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ===== CLASSES =====
# The core process-mining chain this pack enforces:
#   Event --relatesObject--> Object ; --partOf--> ProcessModel (via derivedFromEvent)
#   ProcessModel --derivedFromEvent--> Event (>= 2 required for a real model)
#   ConformanceCheck --comparesEvent--> Event ; --checksAgainstModel--> ProcessModel
#   Drift --observedIn--> ConformanceCheck (only when observed and model diverge)
# A ConformanceCheck asserted pi:conformant "false" (i.e. divergent) without a
# corresponding pi:Drift individual is incomplete reporting, but the gate
# enforced here targets the narrower, structurally checkable invariant named
# in this pack's charter: a ConformanceCheck asserted pi:conformant "true"
# must trace to at least one real compared pi:Event -- enforced structurally
# here, refused if violated by gates/010_conformance_requires_compared_event.rq.
pi:Event a rdfs:Class .
pi:Object a rdfs:Class .
pi:ProcessModel a rdfs:Class .
pi:ConformanceCheck a rdfs:Class .
pi:Drift a rdfs:Class .

# ===== PROPERTIES =====
pi:relatesObject a rdf:Property ; rdfs:domain pi:Event ; rdfs:range pi:Object .
pi:observedAt a rdf:Property ; rdfs:domain pi:Event ; rdfs:range xsd:dateTime .
pi:activity a rdf:Property ; rdfs:domain pi:Event ; rdfs:range xsd:string .
pi:objectType a rdf:Property ; rdfs:domain pi:Object ; rdfs:range xsd:string .
pi:derivedFromEvent a rdf:Property ; rdfs:domain pi:ProcessModel ; rdfs:range pi:Event .
pi:modelId a rdf:Property ; rdfs:domain pi:ProcessModel ; rdfs:range xsd:string .
pi:comparesEvent a rdf:Property ; rdfs:domain pi:ConformanceCheck ; rdfs:range pi:Event .
pi:checksAgainstModel a rdf:Property ; rdfs:domain pi:ConformanceCheck ; rdfs:range pi:ProcessModel .
pi:conformant a rdf:Property ; rdfs:domain pi:ConformanceCheck ; rdfs:range xsd:boolean .
pi:observedIn a rdf:Property ; rdfs:domain pi:Drift ; rdfs:range pi:ConformanceCheck .
pi:driftReason a rdf:Property ; rdfs:domain pi:Drift ; rdfs:range xsd:string .

# ===== REAL INDIVIDUALS: events / objects =====
pi:Object-Order-001 a pi:Object ;
    pi:objectType "PurchaseOrder" ;
    rdfs:label "Real order object observed across the worked-example event log" .

pi:Event-OrderPlaced-001 a pi:Event ;
    pi:activity "OrderPlaced" ;
    pi:observedAt "2026-09-01T09:00:00Z"^^xsd:dateTime ;
    pi:relatesObject pi:Object-Order-001 ;
    rdfs:label "First observed event: order placed" .

pi:Event-OrderShipped-001 a pi:Event ;
    pi:activity "OrderShipped" ;
    pi:observedAt "2026-09-03T14:30:00Z"^^xsd:dateTime ;
    pi:relatesObject pi:Object-Order-001 ;
    rdfs:label "Second observed event: order shipped" .

pi:Event-OrderCancelled-001 a pi:Event ;
    pi:activity "OrderCancelled" ;
    pi:observedAt "2026-09-05T11:00:00Z"^^xsd:dateTime ;
    pi:relatesObject pi:Object-Order-001 ;
    rdfs:label "Third observed event: order cancelled after shipment, diverging from the reference model" .

# ===== REAL INDIVIDUAL: process model derived from >= 2 events =====
pi:ProcessModel-OrderToShip-001 a pi:ProcessModel ;
    pi:modelId "order-to-ship/26.9.12/001" ;
    pi:derivedFromEvent pi:Event-OrderPlaced-001 ;
    pi:derivedFromEvent pi:Event-OrderShipped-001 ;
    rdfs:label "Reference process model: OrderPlaced -> OrderShipped, derived from the first two observed events" .

# ===== REAL INDIVIDUAL: conformance check comparing observed vs model (conformant) =====
pi:ConformanceCheck-OrderToShip-001 a pi:ConformanceCheck ;
    pi:comparesEvent pi:Event-OrderPlaced-001 ;
    pi:comparesEvent pi:Event-OrderShipped-001 ;
    pi:checksAgainstModel pi:ProcessModel-OrderToShip-001 ;
    pi:conformant true ;
    rdfs:label "Conformant check: the placed/shipped pair replays the reference model exactly" .

# ===== REAL INDIVIDUAL: conformance check that diverges, with a real Drift =====
pi:ConformanceCheck-OrderToShip-002 a pi:ConformanceCheck ;
    pi:comparesEvent pi:Event-OrderPlaced-001 ;
    pi:comparesEvent pi:Event-OrderCancelled-001 ;
    pi:checksAgainstModel pi:ProcessModel-OrderToShip-001 ;
    pi:conformant false ;
    rdfs:label "Divergent check: cancellation after placement does not replay the reference model" .

pi:Drift-OrderToShip-001 a pi:Drift ;
    pi:observedIn pi:ConformanceCheck-OrderToShip-002 ;
    pi:driftReason "Observed OrderCancelled where the reference model requires OrderShipped" ;
    rdfs:label "Real drift individual recording the divergence found by ConformanceCheck-OrderToShip-002" .

pi:ConformanceResult a rdfs:Class .
pi:DriftSignal a rdfs:Class .
pi:ObservationProjection a rdfs:Class .
pi:ExecutionEpisode a rdfs:Class .
pi:DeclaredBehavior a rdfs:Class .
pi:ObservedBehavior a rdfs:Class .
pi:StablePattern a rdfs:Class .

pi:PPCXClosure a rdfs:Class ;
  rdfs:comment "Planning-process closure linking admitted current state, selected policy, observed consequence, evidence, and next admitted state." .

pi:relatesObject a rdf:Property .
pi:observedAt a rdf:Property .
pi:projectsTo a rdf:Property .
pi:conformsTo a rdf:Property .
pi:signalsDrift a rdf:Property .
pi:usesImplementation a rdf:Property .
pi:declaredBehavior a rdf:Property .
pi:observedBehavior a rdf:Property .
pi:stable a rdf:Property .

pi:ClosedLoopObservation a pi:ProcessModel ;
  rdfs:comment "Declared contracts and observed execution remain distinct. Repeated stable behavior may be proposed for deterministic manufacture and must be requalified before use." .

pi:initialAdmittedState a rdf:Property .
pi:selectedPolicy a rdf:Property .
pi:observedConsequence a rdf:Property .
pi:closureEvidence a rdf:Property .
pi:nextAdmittedState a rdf:Property .
pi:closesInteraction a rdf:Property .

# ===== OCEL TAP SCHEMA (26.9.13): runtime-event -> OCEL 2.0 event + e2o relations =====
# A consumer authors individuals of these classes; the templates/ render the
# per-runtime adapter, type registry, mapper, OCEL 2.0 serializer and hash chain
# from them. No domain vocabulary lives in templates/.
pi:EventType a rdfs:Class .
pi:ObjectType a rdfs:Class .
pi:Qualifier a rdfs:Class .
pi:E2ORelation a rdfs:Class .
pi:MappingRule a rdfs:Class .
pi:EventSource a rdfs:Class ;
    rdfs:comment "A runtime's event feed. pi:sourceKind selects the adapter ingest shape." .
pi:SourceKind a rdfs:Class .
pi:RuntimeEvent a rdfs:Class ;
    rdfs:comment "A named event a runtime can emit. Must be mapped by a rule or be a pi:Unmapped with a reason." .
pi:Unmapped a rdfs:Class ;
    rdfs:comment "Type a pi:RuntimeEvent additionally to declare it deliberately unmapped; requires pi:unmappedReason." .
pi:ChainPolicy a rdfs:Class .
pi:LanguageSupport a rdfs:Class .

pi:typeId a rdf:Property ; rdfs:range xsd:string .
pi:qualifierId a rdf:Property ; rdfs:domain pi:Qualifier ; rdfs:range xsd:string .
pi:ruleId a rdf:Property ; rdfs:domain pi:MappingRule ; rdfs:range xsd:string .
pi:sourceEvent a rdf:Property ; rdfs:domain pi:MappingRule ; rdfs:range xsd:string .
pi:fromSource a rdf:Property ; rdfs:domain pi:MappingRule ; rdfs:range pi:EventSource .
pi:emitsEventType a rdf:Property ; rdfs:domain pi:MappingRule ; rdfs:range pi:EventType .
pi:hasRelation a rdf:Property ; rdfs:domain pi:MappingRule ; rdfs:range pi:E2ORelation .
pi:relatesObjectType a rdf:Property ; rdfs:domain pi:E2ORelation ; rdfs:range pi:ObjectType .
pi:hasQualifier a rdf:Property ; rdfs:domain pi:E2ORelation ; rdfs:range pi:Qualifier .
pi:objectIdPath a rdf:Property ; rdfs:domain pi:E2ORelation ; rdfs:range xsd:string ;
    rdfs:comment "Dot path into the raw runtime payload; resolves to a string or an array of strings." .

pi:sourceId a rdf:Property ; rdfs:domain pi:EventSource ; rdfs:range xsd:string ;
    rdfs:comment "Identifier matching [a-z][a-z0-9_]*." .
pi:sourceKind a rdf:Property ; rdfs:domain pi:EventSource ; rdfs:range xsd:string ;
    rdfs:comment "One of the pi:kindId values of the pi:SourceKind individuals." .
pi:nameField a rdf:Property ; rdfs:domain pi:EventSource ; rdfs:range xsd:string .
pi:idField a rdf:Property ; rdfs:domain pi:EventSource ; rdfs:range xsd:string .
pi:timeField a rdf:Property ; rdfs:domain pi:EventSource ; rdfs:range xsd:string .
pi:chainPolicy a rdf:Property ; rdfs:domain pi:EventSource ; rdfs:range pi:ChainPolicy .
pi:kindId a rdf:Property ; rdfs:domain pi:SourceKind ; rdfs:range xsd:string .
pi:runtimeEventName a rdf:Property ; rdfs:domain pi:RuntimeEvent ; rdfs:range xsd:string .
pi:emittedBy a rdf:Property ; rdfs:domain pi:RuntimeEvent ; rdfs:range pi:EventSource .
pi:unmappedReason a rdf:Property ; rdfs:domain pi:Unmapped ; rdfs:range xsd:string .
pi:hashAlgorithm a rdf:Property ; rdfs:domain pi:ChainPolicy ; rdfs:range xsd:string .
pi:targetLanguage a rdf:Property ; rdfs:domain pi:ChainPolicy ; rdfs:range xsd:string .
pi:language a rdf:Property ; rdfs:domain pi:LanguageSupport ; rdfs:range xsd:string .
pi:supportsHash a rdf:Property ; rdfs:domain pi:LanguageSupport ; rdfs:range xsd:string .

# ===== Closed vocabulary: adapter ingest shapes =====
pi:Kind-StreamJson a pi:SourceKind ; pi:kindId "stream-json" ; rdfs:comment "newline-delimited JSON text; ingest(text)" .
pi:Kind-AppServerSubscription a pi:SourceKind ; pi:kindId "app-server-subscription" ; rdfs:comment "server pushes parsed events to a subscriber; attach(register)" .
pi:Kind-Hook a pi:SourceKind ; pi:kindId "hook" ; rdfs:comment "synchronous hook payload; ingest(payload)" .
pi:Kind-Otel a pi:SourceKind ; pi:kindId "otel" ; rdfs:comment "OTel span/log record with key/value attribute list; ingest(record)" .
pi:Kind-SdkCallback a pi:SourceKind ; pi:kindId "sdk-callback" ; rdfs:comment "SDK invokes a registered callback; attach(register)" .

# ===== Per-language hash support (facts about the generated runtimes; no deps) =====
# sha256 uses each language's stdlib (rs carries a self-contained implementation).
# blake2b256 exists only where the stdlib provides a 32-byte digest.
# BLAKE3 is deliberately absent: Bun 1.3.7 lacks it and no new deps are allowed.
pi:Lang-Ts a pi:LanguageSupport ; pi:language "ts" ; pi:supportsHash "sha256" .
pi:Lang-Py a pi:LanguageSupport ; pi:language "py" ; pi:supportsHash "sha256" , "blake2b256" .
pi:Lang-Rs a pi:LanguageSupport ; pi:language "rs" ; pi:supportsHash "sha256" .
pi:Lang-Ex a pi:LanguageSupport ; pi:language "ex" ; pi:supportsHash "sha256" .

# ===== Worked example (pack-owned): an order feed delivered by a hook =====
pi:ChainPolicy-Default a pi:ChainPolicy ; pi:hashAlgorithm "sha256" ;
    pi:targetLanguage "ts" , "py" , "rs" , "ex" .

pi:Source-OrderHook a pi:EventSource ; pi:sourceId "order_hook" ; pi:sourceKind "hook" ;
    pi:nameField "event" ; pi:idField "id" ; pi:timeField "ts" ; pi:chainPolicy pi:ChainPolicy-Default .

pi:ObjectType-Order a pi:ObjectType ; pi:typeId "order" .
pi:ObjectType-Item a pi:ObjectType ; pi:typeId "item" .
pi:EventType-Place a pi:EventType ; pi:typeId "place_order" .
pi:EventType-Ship a pi:EventType ; pi:typeId "ship_order" .
pi:Qualifier-Subject a pi:Qualifier ; pi:qualifierId "subject" .
pi:Qualifier-Contains a pi:Qualifier ; pi:qualifierId "contains" .

pi:Rel-Place-Order a pi:E2ORelation ; pi:relatesObjectType pi:ObjectType-Order ; pi:hasQualifier pi:Qualifier-Subject ; pi:objectIdPath "order.id" .
pi:Rel-Place-Item a pi:E2ORelation ; pi:relatesObjectType pi:ObjectType-Item ; pi:hasQualifier pi:Qualifier-Contains ; pi:objectIdPath "items" .
pi:Rel-Ship-Order a pi:E2ORelation ; pi:relatesObjectType pi:ObjectType-Order ; pi:hasQualifier pi:Qualifier-Subject ; pi:objectIdPath "order.id" .

pi:Rule-Place a pi:MappingRule ; pi:ruleId "rule-place" ; pi:fromSource pi:Source-OrderHook ; pi:sourceEvent "order.placed" ;
    pi:emitsEventType pi:EventType-Place ; pi:hasRelation pi:Rel-Place-Order , pi:Rel-Place-Item .
pi:Rule-Ship a pi:MappingRule ; pi:ruleId "rule-ship" ; pi:fromSource pi:Source-OrderHook ; pi:sourceEvent "order.shipped" ;
    pi:emitsEventType pi:EventType-Ship ; pi:hasRelation pi:Rel-Ship-Order .

pi:RuntimeEvent-OrderPlaced a pi:RuntimeEvent ; pi:runtimeEventName "order.placed" ; pi:emittedBy pi:Source-OrderHook .
pi:RuntimeEvent-OrderShipped a pi:RuntimeEvent ; pi:runtimeEventName "order.shipped" ; pi:emittedBy pi:Source-OrderHook .
pi:RuntimeEvent-OrderAudit a pi:RuntimeEvent , pi:Unmapped ; pi:runtimeEventName "order.audit" ; pi:emittedBy pi:Source-OrderHook ;
    pi:unmappedReason "audit noise carries no process step; deliberately outside the event log" .
