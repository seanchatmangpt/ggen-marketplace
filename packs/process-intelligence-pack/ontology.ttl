@prefix pi: <https://ggen.dev/ontology/process-intelligence#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

pi:Event a rdfs:Class .
pi:Object a rdfs:Class .
pi:ProcessModel a rdfs:Class .
pi:ConformanceResult a rdfs:Class .
pi:DriftSignal a rdfs:Class .
pi:ObservationProjection a rdfs:Class .
pi:relatesObject a rdf:Property .
pi:observedAt a rdf:Property .
pi:projectsTo a rdf:Property .
pi:conformsTo a rdf:Property .
pi:signalsDrift a rdf:Property .
