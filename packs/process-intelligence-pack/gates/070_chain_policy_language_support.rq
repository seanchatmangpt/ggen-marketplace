# MESSAGE: a pi:ChainPolicy must name exactly one pi:hashAlgorithm and at least one
# pi:targetLanguage, and every targeted language must list that algorithm in its
# pi:LanguageSupport pi:supportsHash set (Bun 1.3.7 lacks BLAKE3, so it is absent
# everywhere). Rows: ?policy and the offending ?language (unbound when the policy is
# malformed rather than unsupported).
PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
SELECT DISTINCT ?policy ?language WHERE {
  ?policy a pi:ChainPolicy .
  {
    FILTER NOT EXISTS { ?policy pi:hashAlgorithm ?a . }
  } UNION {
    FILTER NOT EXISTS { ?policy pi:targetLanguage ?l . }
  } UNION {
    ?policy pi:hashAlgorithm ?algo ; pi:targetLanguage ?language .
    FILTER NOT EXISTS { ?ls a pi:LanguageSupport ; pi:language ?language ; pi:supportsHash ?algo . }
  } UNION {
    ?policy pi:hashAlgorithm ?a1 , ?a2 . FILTER(?a1 != ?a2)
  }
}
ORDER BY ?policy ?language
