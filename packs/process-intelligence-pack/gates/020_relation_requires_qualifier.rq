# MESSAGE: every pi:E2ORelation must carry a pi:hasQualifier link to a real
# pi:Qualifier; OCEL 2.0 e2o relations without a qualifier are refused.
PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
SELECT ?relation WHERE {
  ?relation a pi:E2ORelation .
  FILTER NOT EXISTS { ?relation pi:hasQualifier ?q . ?q a pi:Qualifier . }
}
ORDER BY ?relation
