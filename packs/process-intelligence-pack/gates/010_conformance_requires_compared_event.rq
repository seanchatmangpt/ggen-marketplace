# MESSAGE: any pi:ConformanceCheck asserted pi:conformant "true" must trace to
# at least one real pi:comparesEvent link to an individual actually typed
# pi:Event. A conformance claim with no compared event has nothing observed
# behind it and cannot be honored as conformant -- refused here.
#
# Each row names the offending conformance check.
PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
SELECT ?conformanceCheck WHERE {
  ?conformanceCheck a pi:ConformanceCheck ;
                     pi:conformant true .
  FILTER NOT EXISTS {
    ?conformanceCheck pi:comparesEvent ?event .
    ?event a pi:Event .
  }
}
ORDER BY ?conformanceCheck
