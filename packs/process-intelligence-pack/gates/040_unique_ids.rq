# MESSAGE: type, qualifier, rule and source ids must be unique within their class
# and each individual must have one; duplicate or missing ids are refused.
PREFIX pi: <https://ggen.dev/ontology/process-intelligence#>
SELECT DISTINCT ?subject WHERE {
  { VALUES (?c ?p) { (pi:EventType pi:typeId) (pi:ObjectType pi:typeId) (pi:Qualifier pi:qualifierId) (pi:MappingRule pi:ruleId) (pi:EventSource pi:sourceId) }
    ?subject a ?c . ?other a ?c . ?subject ?p ?id . ?other ?p ?id . FILTER(?subject != ?other) }
  UNION
  { VALUES (?c ?p) { (pi:EventType pi:typeId) (pi:ObjectType pi:typeId) (pi:Qualifier pi:qualifierId) (pi:MappingRule pi:ruleId) (pi:EventSource pi:sourceId) }
    ?subject a ?c . FILTER NOT EXISTS { ?subject ?p ?x } }
}
ORDER BY ?subject
