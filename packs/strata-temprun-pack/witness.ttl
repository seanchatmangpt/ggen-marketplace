# Known-answer test (KAT) — admissionFuel=3 sieve, ActuationArena::run/2.
# Derived honestly 2026-10-13 via a rustc driver (1.98.0-nightly) compiled
# against generated/arena.rs in /tmp/temprun-kat (sha256 of arena.rs
# 5822dc5587af82bcce40b29a1ab4fe761f8647dd58f48ea5ca73e5dd8b2a25fe):
#   a1 REFUSE final_fuel=0 msg=fuel exhausted at step 3 of 5 (lease held by a1)
#   a2 ADMIT final_fuel=0
#   a3 ADMIT final_fuel=1
<https://strata.chatman.ai/witness/strata-temprun-pack#kat-admission-fuel-3>
    a sw:KatRun ;
    sw:pack <https://strata.chatman.ai/pack/strata-temprun-pack> ;
    sw:subject "generated/arena.rs" ;
    sw:subjectSha256 "5822dc5587af82bcce40b29a1ab4fe761f8647dd58f48ea5ca73e5dd8b2a25fe" ;
    sw:admissionFuel "3" ;
    sw:finalFuel "1" ;
    sw:attempt [ a sw:Attempt ; sw:order "1" ; sw:name "a1" ;
        sw:requestFuel "3" ; sw:steps "5" ;
        sw:outcome "REFUSE" ; sw:finalFuel "0" ;
        sw:detail "fuel exhausted at step 3 of 5 (lease held by a1)" ] ;
    sw:attempt [ a sw:Attempt ; sw:order "2" ; sw:name "a2" ;
        sw:requestFuel "3" ; sw:steps "3" ;
        sw:outcome "ADMIT" ; sw:finalFuel "0" ] ;
    sw:attempt [ a sw:Attempt ; sw:order "3" ; sw:name "a3" ;
        sw:requestFuel "3" ; sw:steps "2" ;
        sw:outcome "ADMIT" ; sw:finalFuel "1" ] .
