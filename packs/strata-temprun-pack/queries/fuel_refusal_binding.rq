PREFIX st: <https://strata.chatman.ai/ontology#>

# Projection rows for the fuel ↔ valve composition binding: the pinned
# valve refusal IRI, the valve wire receipt length, and every arena that
# emits it.
SELECT ?valve_refusal_iri ?refusal_receipt_len ?arena_name WHERE {
  ?binding a st:FuelRefusalBinding ;
           st:valveRefusalIri ?valve_refusal_iri ;
           st:refusalReceiptLen ?refusal_receipt_len .
  ?arena st:emitsValveRefusal ?valve_refusal_iri ;
         st:arenaName ?arena_name .
}
ORDER BY ?valve_refusal_iri ?arena_name
