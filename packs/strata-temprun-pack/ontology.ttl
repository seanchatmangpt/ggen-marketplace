# strata-temprun-pack ontology — actuation arena vocabulary.

@prefix st:  <https://strata.chatman.ai/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ── Classes ──────────────────────────────────────────────────────────

st:ActuationArena a rdfs:Class ; rdfs:label "ActuationArena" ;
    rdfs:comment "A bounded execution arena in which actuations run under fuel leases." .

st:FuelLease a rdfs:Class ; rdfs:label "FuelLease" ;
    rdfs:comment "A leased budget of actuation fuel granted to a run." .

st:ConformanceResult a rdfs:Class ; rdfs:label "ConformanceResult" ;
    rdfs:comment "The verdict of an arena run against a conformance court." .

# ── Properties ───────────────────────────────────────────────────────

st:arenaName a rdf:Property ; rdfs:label "arena name" ;
    rdfs:domain st:ActuationArena ; rdfs:range xsd:string .

st:admissionFuel a rdf:Property ; rdfs:label "admission fuel" ;
    rdfs:comment "Minimum fuel for admission: temprun run/2 sieve charges 1 unit each for clock, coordinates, conformance (src/lib.rs) — admitted iff fuel >= 3." ;
    rdfs:domain st:ActuationArena ; rdfs:range xsd:integer .

st:maxFuel a rdf:Property ; rdfs:label "max fuel" ;
    rdfs:domain st:ActuationArena ; rdfs:range xsd:integer .

st:leaseFuel a rdf:Property ; rdfs:label "lease fuel" ;
    rdfs:domain st:FuelLease ; rdfs:range xsd:integer .

st:leaseHolder a rdf:Property ; rdfs:label "lease holder" ;
    rdfs:domain st:FuelLease ; rdfs:range xsd:string .

st:verdict a rdf:Property ; rdfs:label "verdict" ;
    rdfs:domain st:ConformanceResult ; rdfs:range xsd:string .

st:runsIn a rdf:Property ; rdfs:label "runs in" ;
    rdfs:domain st:FuelLease ; rdfs:range st:ActuationArena .

st:producesResult a rdf:Property ; rdfs:label "produces result" ;
    rdfs:domain st:ActuationArena ; rdfs:range st:ConformanceResult .

# ── Individuals ──────────────────────────────────────────────────────

st:DefaultArena a st:ActuationArena ;
    st:arenaName "default" ;
    st:maxFuel 1000000 ;
    # temprun run/2 sieve admitted iff fuel >= 3 (st:admissionFuel).
    st:admissionFuel 3 .

# ── Fuel ↔ valve refusal composition ─────────────────────────────────
# Composition law: arena fuel exhaustion emits a valve-taxonomy refusal.
# The refusal class is declared in the strata-valve-pack ontology —
# valve:FuelExhaustedRefusal (atom "fuel_exhausted", module
# "Strata.Valve.Refusals.FuelExhausted"). House style cites by IRI literal,
# no owl:imports: the union graph of both packs is not evaluable in a
# single ggen sync, so the valve IRI is PINNED here as a constant and the
# gate (gates/020_fuel_refusal_binding.rq) enforces its structural shape
# plus the valve wire constant (32-byte refusal receipt) locally.
# ──────────────────────────────────────────────────────────────────────

st:FuelRefusalBinding a rdfs:Class ; rdfs:label "FuelRefusalBinding" ;
    rdfs:comment "Pinned binding from temprun arena fuel exhaustion to the valve-pack refusal class that surfaces it on the wire." .

st:valveRefusalIri a rdf:Property ; rdfs:label "valve refusal IRI" ;
    rdfs:comment "Pinned constant: IRI of the valve-pack refusal class emitted on arena fuel exhaustion. Pinned by literal (no owl:imports); gated structurally." ;
    rdfs:domain st:FuelRefusalBinding ; rdfs:range xsd:string .

st:refusalReceiptLen a rdf:Property ; rdfs:label "refusal receipt length" ;
    rdfs:comment "Wire length in bytes of the valve's opaque RefusalReceipt; must equal the valve pack's valve:refusalReceiptLen (32)." ;
    rdfs:domain st:FuelRefusalBinding ; rdfs:range xsd:integer .

st:emitsValveRefusal a rdf:Property ; rdfs:label "emits valve refusal" ;
    rdfs:comment "Links an arena to the pinned valve refusal IRI it emits when fuel exhausts." ;
    rdfs:domain st:ActuationArena ; rdfs:range xsd:string .

st:FuelExhaustedBinding a st:FuelRefusalBinding ;
    rdfs:label "fuel_exhausted_binding" ;
    # PINNED VALVE IRI (constant, mirrored from strata-valve-pack
    # ontology.ttl valve:FuelExhaustedRefusal — a valve:RefusalClass).
    st:valveRefusalIri "https://strata.chatman.ai/ontology/valve#FuelExhaustedRefusal" ;
    st:refusalReceiptLen 32 .

st:DefaultArena st:emitsValveRefusal "https://strata.chatman.ai/ontology/valve#FuelExhaustedRefusal" .
