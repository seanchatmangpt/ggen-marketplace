/// PINNED VALVE-TAXONOMY REFUSAL CLASS IRIs — strata-valve-pack ontology.ttl
/// valve:RefusalClass individuals. Mirrored constants; gated structurally
/// by gates/020_valve_taxonomy_binding.rq.
{% for row in results %}pub const {{ row.valve_atom | upper | replace(from="-", to="_") }}_IRI: &str = "{{ row.valve_iri }}";
{% endfor %}
/// Pinned child modules (Strata.Valve.Refusals family).
{% for row in results %}pub const {{ row.valve_atom | upper | replace(from="-", to="_") }}_MODULE: &str = "{{ row.valve_module }}";
{% endfor %}
/// Emission edge: the closed stratus valve refuses with the fuel-exhausted
/// refusal class (pinned IRI literal; gated by 020_valve_taxonomy_binding).
pub const DEFAULT_VALVE_REFUSAL_IRI: &str = "https://strata.chatman.ai/ontology/valve#FuelExhaustedRefusal";

/// Fail-closed composition closure: every pinned refusal IRI must be a
/// valve-taxonomy IRI, and the default valve's emission must be one of the
/// pinned classes.
pub fn valve_taxonomy_closure() -> Result<(), String> {
    let pinned = [
        (MALFORMED_FRAME_IRI, "malformed_frame"),
        (FUEL_EXHAUSTED_IRI, "fuel_exhausted"),
        (PARENT_DISCONTINUITY_IRI, "parent_discontinuity"),
        (ARENA_FAILURE_IRI, "arena_failure"),
    ];
    for (iri, atom) in pinned {
        if !iri.starts_with("https://strata.chatman.ai/ontology/valve#") {
            return Err(format!(
                "wrong_refusal_class: {} is not a valve-taxonomy IRI",
                iri
            ));
        }
        let _ = atom;
    }
    if DEFAULT_VALVE_REFUSAL_IRI != FUEL_EXHAUSTED_IRI {
        return Err(format!(
            "wrong_emission: default valve emits {} not {}",
            DEFAULT_VALVE_REFUSAL_IRI, FUEL_EXHAUSTED_IRI
        ));
    }
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::*;

    /// COURT — the composition satisfies the taxonomy law.
    #[test]
    fn taxonomy_law_holds() {
        valve_taxonomy_closure().expect("valve bindings must satisfy the taxonomy law");
        assert_eq!(DEFAULT_VALVE_REFUSAL_IRI, FUEL_EXHAUSTED_IRI);
        assert_eq!(FUEL_EXHAUSTED_MODULE, "Strata.Valve.Refusals.FuelExhausted");
        assert_eq!(FUEL_EXHAUSTED_ATOM, "fuel_exhausted");
    }

    /// Sabotage twin — a valve-taxonomy-unbound IRI would fail the closure
    /// check; the honest pins pass on the same instance-shape.
    #[test]
    fn sabotage_twin_wrong_taxonomy_is_caught() {
        let outsider: &str = "https://strata.chatman.ai/ontology/net#X";
        assert!(!outsider.starts_with("https://strata.chatman.ai/ontology/valve#"));
        assert!(DEFAULT_VALVE_REFUSAL_IRI.starts_with("https://strata.chatman.ai/ontology/valve#"));
    }
}
