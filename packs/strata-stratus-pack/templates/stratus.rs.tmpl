---
to: src/stratus.rs
sparql:
  valves: "PREFIX st: <https://strata.chatman.ai/ontology#> SELECT ?valve_name ?valve_open WHERE { ?v a st:WitnessValve ; st:valveName ?valve_name ; st:valveOpen ?valve_open } ORDER BY ?valve_name"
  registers: "PREFIX st: <https://strata.chatman.ai/ontology#> SELECT ?register_name WHERE { ?r a st:StateRegister ; st:registerName ?register_name } ORDER BY ?register_name"
skip_if: "ggen:local-override"
---
//! Stratus witness layer — GENERATED by `ggen sync` from the
//! `strata-stratus-pack` ontology. Do not edit by hand.
{% for v in valves %}
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct WitnessValve {
    pub name: &'static str,
    pub open: bool,
}

pub const VALVE_{{ v.valve_name | upper | replace(from="-", to="_") }}: WitnessValve =
    WitnessValve { name: "{{ v.valve_name }}", open: {{ v.valve_open }} };
{% endfor %}
{% for r in registers %}
#[derive(Debug, Clone)]
pub struct StateRegister {
    pub name: &'static str,
    pub values: Vec<String>,
}

impl StateRegister {
    pub const {{ r.register_name | upper | replace(from="-", to="_") }}_NAME: &'static str = "{{ r.register_name }}";

    /// Appends a transition if the guarding witness valve is open.
    pub fn admit(&mut self, valve: WitnessValve, value: String) -> Result<(), String> {
        if !valve.open {
            return Err(format!("valve {} closed", valve.name));
        }
        self.values.push(value);
        Ok(())
    }
}
{% endfor %}
