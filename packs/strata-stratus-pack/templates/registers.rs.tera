//! Stratus state registers — GENERATED by `ggen sync run` from the
//! `strata-stratus-pack` ontology (https://strata.chatman.ai/ontology#). Do not edit by hand.

// WitnessValve is defined by the sibling stratus-valves rule (generated/valves.rs); the two outputs form one module family.
use super::valves::WitnessValve;

/// An append-only register of witnessed state transitions.
#[derive(Debug, Clone)]
pub struct StateRegister {
    pub name: &'static str,
    pub values: Vec<String>,
}

impl StateRegister {
    /// Appends a transition if the guarding witness valve is open.
    pub fn admit(&mut self, valve: WitnessValve, value: String) -> Result<(), String> {
        if !valve.open {
            return Err(format!("valve {} closed", valve.name));
        }
        self.values.push(value);
        Ok(())
    }
}

