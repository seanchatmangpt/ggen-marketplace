# strata-stratus-pack ontology — witness valve / state register vocabulary.

@prefix st:  <https://strata.chatman.ai/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ── Classes ──────────────────────────────────────────────────────────

st:WitnessValve a rdfs:Class ; rdfs:label "WitnessValve" ;
    rdfs:comment "A gate that admits or refuses a state-register transition based on witnessed evidence." .

st:StateRegister a rdfs:Class ; rdfs:label "StateRegister" ;
    rdfs:comment "An append-only register of witnessed state transitions." .

# ── Properties ───────────────────────────────────────────────────────

st:valveName a rdf:Property ; rdfs:label "valve name" ;
    rdfs:domain st:WitnessValve ; rdfs:range xsd:string .

st:valveOpen a rdf:Property ; rdfs:label "valve open" ;
    rdfs:domain st:WitnessValve ; rdfs:range xsd:boolean .

st:registerName a rdf:Property ; rdfs:label "register name" ;
    rdfs:domain st:StateRegister ; rdfs:range xsd:string .

st:guardedBy a rdf:Property ; rdfs:label "guarded by" ;
    rdfs:domain st:StateRegister ; rdfs:range st:WitnessValve .

st:registerValue a rdf:Property ; rdfs:label "register value" ;
    rdfs:domain st:StateRegister ; rdfs:range xsd:string .

# ── Individuals ──────────────────────────────────────────────────────

st:MainRegister a st:StateRegister ;
    st:registerName "main" ;
    st:guardedBy st:DefaultValve .

st:DefaultValve a st:WitnessValve ;
    st:valveName "default" ;
    st:valveOpen true .
