# strata-stratus-pack ontology — witness valve / state register vocabulary.

@prefix st:  <https://strata.chatman.ai/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ── Classes ──────────────────────────────────────────────────────────

st:WitnessValve a rdfs:Class ; rdfs:label "WitnessValve" ;
    rdfs:comment "A gate that admits or refuses a state-register transition based on witnessed evidence." .

st:StateRegister a rdfs:Class ; rdfs:label "StateRegister" ;
    rdfs:comment "An append-only register of witnessed state transitions." .

# ── Properties ───────────────────────────────────────────────────────

st:valveName a rdf:Property ; rdfs:label "valve name" ;
    rdfs:domain st:WitnessValve ; rdfs:range xsd:string .

st:valveOpen a rdf:Property ; rdfs:label "valve open" ;
    rdfs:domain st:WitnessValve ; rdfs:range xsd:boolean .

st:registerName a rdf:Property ; rdfs:label "register name" ;
    rdfs:domain st:StateRegister ; rdfs:range xsd:string .

st:guardedBy a rdf:Property ; rdfs:label "guarded by" ;
    rdfs:domain st:StateRegister ; rdfs:range st:WitnessValve .

st:registerValue a rdf:Property ; rdfs:label "register value" ;
    rdfs:domain st:StateRegister ; rdfs:range xsd:string .

st:emitsRefusalClass a rdf:Property ; rdfs:label "emits refusal class" ;
    rdfs:comment "Pinned citation (IRI literal, no owl:imports — house style) from a stratus witness valve to the strata-valve-pack taxonomy refusal class it refuses with when closed." ;
    rdfs:domain st:WitnessValve ; rdfs:range xsd:string .

# ── Individuals ──────────────────────────────────────────────────────

# ---------------------------------------------------------------------------
# Stratus <-> valve composition (third cross-pack composition in the strata
# family, after temprun<->valve 8b888e884 and net<->protocol 27ebb78c4).
#
# Derived invariant (from the actual valve-pack constants, not invented):
#   1. Every stratus witness-valve declaration must reference a
#      valve-taxonomy refusal class IRI from the strata-valve-pack's
#      Strata.Valve.Refusals child modules — the four atoms are pinned:
#      malformed_frame / fuel_exhausted / parent_discontinuity /
#      arena_failure (ground truth: valve.ex + valve-pack ontology.ttl).
#   2. Register/valve pairing must be closed: every st:guardedBy edge
#      resolves to a declared st:WitnessValve (gate 010) AND that valve
#      carries a refusal-class emission edge (gate 020).
# Pinned by IRI literal, no owl:imports. Gate: gates/020_valve_taxonomy_binding.rq
# fails closed.
# ---------------------------------------------------------------------------

st:ValveRefusalBinding a rdfs:Class ; rdfs:label "ValveRefusalBinding" ;
    rdfs:comment "Pinned binding from the stratus witness-valve layer to one strata-valve-pack refusal class: IRI + atom + child module, all mirrored by literal." .

st:valveRefusalIri a rdf:Property ; rdfs:label "valve refusal IRI" ;
    rdfs:comment "Pinned constant: IRI of a strata-valve-pack valve:RefusalClass. Pinned by literal (no owl:imports); gated structurally." ;
    rdfs:domain st:ValveRefusalBinding ; rdfs:range xsd:string .

st:valveRefusalAtom a rdf:Property ; rdfs:label "valve refusal atom" ;
    rdfs:comment "Pinned constant: the refusal atom emitted on the wire by the pinned refusal class (verbatim from valve.ex)." ;
    rdfs:domain st:ValveRefusalBinding ; rdfs:range xsd:string .

st:valveRefusalModule a rdf:Property ; rdfs:label "valve refusal module" ;
    rdfs:comment "Pinned constant: the Strata.Valve.Refusals.* child module that owns the pinned refusal atom." ;
    rdfs:domain st:ValveRefusalBinding ; rdfs:range xsd:string .

st:BINDING_MALFORMED_FRAME a st:ValveRefusalBinding ;
    rdfs:label "MALFORMED_FRAME" ;
    st:valveRefusalIri "https://strata.chatman.ai/ontology/valve#MalformedFrameRefusal" ;
    st:valveRefusalAtom "malformed_frame" ;
    st:valveRefusalModule "Strata.Valve.Refusals.MalformedFrame" ;
    rdfs:comment "Strict 64-byte header pattern-match failure, pinned from the valve taxonomy." .

st:BINDING_FUEL_EXHAUSTED a st:ValveRefusalBinding ;
    rdfs:label "FUEL_EXHAUSTED" ;
    st:valveRefusalIri "https://strata.chatman.ai/ontology/valve#FuelExhaustedRefusal" ;
    st:valveRefusalAtom "fuel_exhausted" ;
    st:valveRefusalModule "Strata.Valve.Refusals.FuelExhausted" ;
    rdfs:comment "Zero fuel lease, pinned from the valve taxonomy." .

st:BINDING_PARENT_DISCONTINUITY a st:ValveRefusalBinding ;
    rdfs:label "PARENT_DISCONTINUITY" ;
    st:valveRefusalIri "https://strata.chatman.ai/ontology/valve#ParentDiscontinuityRefusal" ;
    st:valveRefusalAtom "parent_discontinuity" ;
    st:valveRefusalModule "Strata.Valve.Refusals.ParentDiscontinuity" ;
    rdfs:comment "Parent digest misses the active register, pinned from the valve taxonomy." .

st:BINDING_ARENA_FAILURE a st:ValveRefusalBinding ;
    rdfs:label "ARENA_FAILURE" ;
    st:valveRefusalIri "https://strata.chatman.ai/ontology/valve#ArenaFailureRefusal" ;
    st:valveRefusalAtom "arena_failure" ;
    st:valveRefusalModule "Strata.Valve.Refusals.ArenaFailure" ;
    rdfs:comment "Arena result without a 256-bit commit_hash, pinned from the valve taxonomy." .

st:DefaultValve a st:WitnessValve ;
    st:valveName "default" ;
    st:valveOpen true ;
    # Emission edge: the closed stratus valve refuses with the fuel-exhausted
    # refusal class (same precedent as the temprun composition).
    st:emitsRefusalClass "https://strata.chatman.ai/ontology/valve#FuelExhaustedRefusal" .

st:MainRegister a st:StateRegister ;
    st:registerName "main" ;
    st:guardedBy st:DefaultValve .

st:DefaultValve a st:WitnessValve ;
    st:valveName "default" ;
    st:valveOpen true .
