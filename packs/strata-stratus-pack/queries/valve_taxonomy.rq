PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX st:   <https://strata.chatman.ai/ontology#>

# Projection rows for the stratus <-> valve composition: one row per pinned
# valve-taxonomy refusal binding (IRI + atom + child module).
SELECT ?valve_iri ?valve_atom ?valve_module WHERE {
  ?binding a st:ValveRefusalBinding ;
           st:valveRefusalIri ?valve_iri ;
           st:valveRefusalAtom ?valve_atom ;
           st:valveRefusalModule ?valve_module .
}
ORDER BY ?valve_iri
