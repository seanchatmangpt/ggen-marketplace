---
to: generated/forced-top25-capsules/{{ row.rank }}.json
sparql:
  capsule_ready_set: |
    PREFIX fta: <https://ggen.dev/ontology/forced-top25-admissibility#>
    SELECT ?rank ?repo ?head ?producer_head WHERE {
      ?target a fta:FanoutTarget ; fta:rank ?rank ; fta:repo ?repo ; fta:exactHead ?head ; fta:producerHead ?producer_head ; fta:compatibilityState "COMPATIBLE_READY" .
      FILTER NOT EXISTS { ?target fta:blocker ?blocker }
    }
    ORDER BY ?rank ?repo
for_each: capsule_ready_set
skip_empty: true
determinism: true
---
{"schema":"ggen.forced-top25-qualification-capsule/v1","rank":{{ row.rank }},"consumer_repo":"{{ row.repo }}","consumer_head":"{{ row.head }}","producer_repo":"seanchatmangpt/ggen-marketplace","producer_head":"{{ row.producer_head }}","producer_pack":"portfolio-epistemic-observability-pack","qualification_mode":"LOCAL_CAPSULE_OR_HOSTED_WRAPPER","authority":"VERIFY|CONSTRUCT","consequential_do":false,"hosted_wrapper_required_for_semantic_standing":false}
