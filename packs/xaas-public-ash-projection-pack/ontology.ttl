# SHACL application profile for the initial public-ontology Ash projection.
#
# Local IRIs identify SHAPES ONLY. This file declares no local owl:Class,
# rdf:Property, owl:ObjectProperty, or owl:DatatypeProperty vocabulary.
# Every sh:targetClass and sh:path is a public vocabulary term already in the
# XaaS public-ontology qualification program. These shapes are implementation
# admission constraints, not a replacement domain ontology.

@prefix shape: <https://ggen.io/profile/xaas/ash-shape#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix org:   <http://www.w3.org/ns/org#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix sosa:  <http://www.w3.org/ns/sosa/> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix fno:   <https://w3id.org/function/ontology#> .
@prefix qudt:  <http://qudt.org/schema/qudt/> .

# Capability / implementation / execution. FnO 1.0.0 explicitly distinguishes
# these classes; no equivalence to any XaaS-private capability type is asserted.
shape:Function a sh:NodeShape ;
  sh:targetClass fno:Function ;
  sh:property [ sh:path fno:name ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .

shape:Mapping a sh:NodeShape ; sh:targetClass fno:Mapping .
shape:Implementation a sh:NodeShape ; sh:targetClass fno:Implementation .
shape:Execution a sh:NodeShape ; sh:targetClass fno:Execution .

# Catalog/service projection.
shape:CatalogResource a sh:NodeShape ;
  sh:targetClass dcat:Resource ;
  sh:property [ sh:path dct:title ; sh:datatype rdf:langString ; sh:minCount 1 ] .

# Organization / actor projection.
shape:Organization a sh:NodeShape ;
  sh:targetClass org:Organization ;
  sh:property [ sh:path rdfs:label ; sh:datatype rdf:langString ] .
shape:Role a sh:NodeShape ; sh:targetClass org:Role .
shape:Membership a sh:NodeShape ; sh:targetClass org:Membership .

# Provenance/execution evidence projection.
shape:ProvEntity a sh:NodeShape ; sh:targetClass prov:Entity .
shape:ProvActivity a sh:NodeShape ; sh:targetClass prov:Activity .
shape:ProvAgent a sh:NodeShape ; sh:targetClass prov:Agent .

# Policy, observation and plan surfaces. These are descriptive/application
# resources only; their existence never grants BRCE DO authority.
shape:Policy a sh:NodeShape ; sh:targetClass odrl:Policy .
shape:Observation a sh:NodeShape ; sh:targetClass sosa:Observation .
shape:Actuation a sh:NodeShape ; sh:targetClass sosa:Actuation .
shape:Plan a sh:NodeShape ; sh:targetClass pplan:Plan .
shape:Step a sh:NodeShape ; sh:targetClass pplan:Step .

# Quantities/units. QUDT's term namespace is http://qudt.org/schema/qudt/;
# the versioned ontology document IRI is a different identifier.
shape:QuantityValue a sh:NodeShape ; sh:targetClass qudt:QuantityValue .
shape:Unit a sh:NodeShape ; sh:targetClass qudt:Unit .
