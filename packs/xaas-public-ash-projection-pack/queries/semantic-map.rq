PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT ?shape ?class ?path ?datatype ?minCount
WHERE {
  ?shape a sh:NodeShape ; sh:targetClass ?class .
  FILTER(isIRI(?class))
  OPTIONAL {
    ?shape sh:property ?propertyShape .
    ?propertyShape sh:path ?path ; sh:datatype ?datatype .
    OPTIONAL { ?propertyShape sh:minCount ?minCount . }
  }
}
ORDER BY STR(?class) STR(?path)
