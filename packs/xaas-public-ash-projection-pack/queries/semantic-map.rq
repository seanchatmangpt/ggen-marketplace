PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT ?shape ?class ?propertyShape ?path ?datatype ?minCount ?resourceName ?attributeName
WHERE {
  ?shape a sh:NodeShape ; sh:targetClass ?class .
  FILTER(isIRI(?class))
  OPTIONAL { ?shape sh:name ?resourceName . }
  OPTIONAL {
    ?shape sh:property ?propertyShape .
    ?propertyShape sh:path ?path ; sh:datatype ?datatype .
    OPTIONAL { ?propertyShape sh:name ?attributeName . }
    OPTIONAL { ?propertyShape sh:minCount ?minCount . }
  }
}
ORDER BY ?class ?path
