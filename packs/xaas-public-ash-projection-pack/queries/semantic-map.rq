PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT ?kind ?class ?path
WHERE {
  {
    ?shape a sh:NodeShape ; sh:targetClass ?class .
    FILTER(isIRI(?class))
    BIND("resource" AS ?kind)
  }
  UNION
  {
    ?shape a sh:NodeShape ; sh:targetClass ?class ; sh:property ?ps .
    ?ps sh:path ?path .
    FILTER(isIRI(?class) && isIRI(?path))
    BIND("attribute" AS ?kind)
  }
}
ORDER BY ?class ?path ?kind
