PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dct: <http://purl.org/dc/terms/>

# Deterministic semantic projection. Public class/property IRIs remain exact subjects.
# sh:name is an implementation label only; dct:isPartOf is descriptive containment.
SELECT ?class ?path ?resourceName ?attributeName ?domain
WHERE {
  ?shape a sh:NodeShape ; sh:targetClass ?class .
  FILTER(isIRI(?class))
  OPTIONAL { ?shape sh:name ?resourceName . }
  OPTIONAL { ?shape dct:isPartOf ?domain . }
  OPTIONAL {
    ?shape sh:property ?ps .
    ?ps sh:path ?path .
    FILTER(isIRI(?path))
    OPTIONAL { ?ps sh:name ?attributeName . }
  }
}
ORDER BY ?class ?path
