PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh: <http://www.w3.org/ns/shacl#>

# Deterministic semantic-map IR. Public class/property IRIs remain exact subjects.
SELECT ?phase ?kind ?class ?path ?datatype ?minCount
WHERE {
  {
    ?shape a sh:NodeShape ; sh:targetClass ?class .
    FILTER(isIRI(?class))
    BIND(10 AS ?phase)
    BIND("resource" AS ?kind)
  }
  UNION
  {
    ?shape a sh:NodeShape ; sh:targetClass ?class ; sh:property ?propertyShape .
    ?propertyShape sh:path ?path ; sh:datatype ?datatype .
    FILTER(isIRI(?class) && isIRI(?path) && isIRI(?datatype))
    OPTIONAL { ?propertyShape sh:minCount ?minCount . }
    BIND(20 AS ?phase)
    BIND("attribute" AS ?kind)
  }
}
ORDER BY ?phase ?class ?path
