PREFIX sh:      <http://www.w3.org/ns/shacl#>
PREFIX dcterms: <http://purl.org/dc/terms/>

# Canonical SHACL application-profile IR for Ash manufacture.
# One deterministic row per datatype attribute.  Consumer naming is admitted
# from sh:name; semantic identity remains the public class/property IRI.
SELECT ?domain ?resource ?class ?order ?attr ?path ?datatype ?minCount
WHERE {
  ?shape a sh:NodeShape ;
         sh:name ?resource ;
         dcterms:isPartOf ?domainShape ;
         sh:targetClass ?class ;
         sh:property ?propertyShape .
  ?domainShape sh:name ?domain .
  ?propertyShape sh:path ?path ;
                 sh:name ?attr ;
                 sh:order ?order ;
                 sh:datatype ?datatype .
  OPTIONAL { ?propertyShape sh:minCount ?minCount . }

  FILTER(isIRI(?class))
  FILTER(isIRI(?path))
}
ORDER BY ?domain ?resource ?order ?path
