PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh:  <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Generic application-profile projection. No private XaaS capability list,
# moduleName/domainModule/actionName facts, or domain vocabulary appears here.
# Public target classes determine resource identity; public datatype property
# shapes determine attributes. Object-property/Ash relationship semantics are
# deliberately absent and gated separately.
SELECT ?phase ?kind ?class ?module ?domain ?arg ?source
WHERE {
  ?shape a sh:NodeShape ;
         sh:targetClass ?class .
  FILTER(isIRI(?class))

  BIND(REPLACE(STR(?class), "^.*[#/]", "") AS ?localName)
  BIND(CONCAT("Xaas.Public.", ?localName) AS ?module)
  BIND("Xaas.Public" AS ?domain)

  {
    BIND(10 AS ?phase)
    BIND("resource" AS ?kind)
    BIND("" AS ?arg)
    BIND(STR(?class) AS ?source)
  }
  UNION
  {
    ?shape sh:property ?propertyShape .
    ?propertyShape sh:path ?path ;
                   sh:datatype ?datatype .
    FILTER(isIRI(?path))

    # ggen's declarative-config validator refuses any VALUES token in a
    # file-referenced .rq (error[E0010], ggen-config validation.rs), so the
    # XSD-to-Ash type mapping below is a nested-IF BIND instead of a VALUES
    # join. Semantics are identical to the tuple table it replaces.
    BIND(
      IF(?datatype = xsd:string || ?datatype = rdf:langString || ?datatype = xsd:anyURI, "string",
      IF(?datatype = xsd:boolean, "boolean",
      IF(?datatype = xsd:integer || ?datatype = xsd:int || ?datatype = xsd:long || ?datatype = xsd:nonNegativeInteger, "integer",
      IF(?datatype = xsd:decimal, "decimal",
      IF(?datatype = xsd:float || ?datatype = xsd:double, "float",
      IF(?datatype = xsd:date, "date",
      IF(?datatype = xsd:dateTime, "utc_datetime", ""
      ))))))) AS ?ashType)
    BIND(REPLACE(STR(?path), "^.*[#/]", "") AS ?attributeName)
    OPTIONAL { ?propertyShape sh:minCount ?minCount . }
    BIND(IF(BOUND(?minCount) && ?minCount >= 1, ":required", "") AS ?requiredModifier)
    BIND(CONCAT(?attributeName, ":", ?ashType, ?requiredModifier) AS ?arg)
    BIND(20 AS ?phase)
    BIND("attribute" AS ?kind)
    BIND(STR(?path) AS ?source)
  }
}
ORDER BY ?phase STR(?class) ?arg
