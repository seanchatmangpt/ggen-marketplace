PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT ?subject ?problem WHERE {
 { ?subject a sh:NodeShape ; sh:name ?name . }
 UNION { ?shape a sh:NodeShape ; sh:property ?subject . ?subject sh:name ?name . }
 FILTER(!REGEX(STR(?name), "^[A-Za-z][A-Za-z0-9_]*$"))
 BIND(CONCAT("unsafe-projection-name:", STR(?name)) AS ?problem)
} ORDER BY ?subject
