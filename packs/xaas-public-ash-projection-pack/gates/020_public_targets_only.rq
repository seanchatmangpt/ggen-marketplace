# MESSAGE: Every Ash resource target must be an external public vocabulary class; local shape IRIs are never resource/domain semantics.
PREFIX sh: <http://www.w3.org/ns/shacl#>

SELECT ?subject ?problem WHERE {
  ?shape a sh:NodeShape ; sh:targetClass ?subject .
  FILTER(
    !isIRI(?subject) ||
    STRSTARTS(STR(?subject), "https://ggen.io/") ||
    STRSTARTS(STR(?subject), "urn:xaas:")
  )
  BIND("nonpublic-target-class-refused" AS ?problem)
}
ORDER BY ?subject ?problem
