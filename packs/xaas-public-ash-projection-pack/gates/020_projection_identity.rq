PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT ?violation ?subject WHERE {
  { ?shape a sh:NodeShape ; sh:targetClass ?class .
    FILTER(!isIRI(?class))
    BIND("TARGET_CLASS_NOT_IRI" AS ?violation) BIND(?shape AS ?subject) }
  UNION
  { ?shape a sh:NodeShape ; sh:property ?ps . ?ps sh:path ?path .
    FILTER(!isIRI(?path))
    BIND("PROPERTY_PATH_NOT_IRI" AS ?violation) BIND(?ps AS ?subject) }
}
ORDER BY ?violation STR(?subject)
