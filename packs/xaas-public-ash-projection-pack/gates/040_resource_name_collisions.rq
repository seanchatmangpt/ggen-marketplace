PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT ?subject ?problem WHERE {
 ?shapeA a sh:NodeShape ; sh:targetClass ?subject .
 ?shapeB a sh:NodeShape ; sh:targetClass ?other .
 FILTER(STR(?subject) < STR(?other))
 OPTIONAL { ?shapeA sh:name ?explicitA . } OPTIONAL { ?shapeB sh:name ?explicitB . }
 BIND(COALESCE(STR(?explicitA), REPLACE(STR(?subject), "^.*[#/]", "")) AS ?nameA)
 BIND(COALESCE(STR(?explicitB), REPLACE(STR(?other), "^.*[#/]", "")) AS ?nameB)
 FILTER(?nameA = ?nameB)
 BIND(CONCAT("Ash-module-name-collision:", ?nameA, ":", STR(?other)) AS ?problem)
} ORDER BY ?subject ?problem
