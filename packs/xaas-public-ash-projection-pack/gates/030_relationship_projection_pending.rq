# MESSAGE: RDF object-property/cardinality semantics do not by themselves prove Ash belongs_to/has_one/has_many ownership semantics.
PREFIX sh: <http://www.w3.org/ns/shacl#>

SELECT ?subject ?problem WHERE {
  ?shape a sh:NodeShape ; sh:property ?subject .
  ?subject sh:path ?path .
  FILTER(
    EXISTS { ?subject sh:class ?class } ||
    EXISTS { ?subject sh:node ?nodeShape } ||
    !EXISTS { ?subject sh:datatype ?datatype }
  )
  BIND("object-property-ash-relationship-projection-not-admitted" AS ?problem)
}
ORDER BY ?subject ?problem
