# MESSAGE: Every projected target/path must be an exact public IRI; blank/literal subjects are refused.
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT ?subject ?problem WHERE {
  {
    ?shape a sh:NodeShape ; sh:targetClass ?subject .
    FILTER(!isIRI(?subject))
    BIND("non-iri-target-class" AS ?problem)
  }
  UNION
  {
    ?shape a sh:NodeShape ; sh:property ?ps .
    ?ps sh:path ?subject .
    FILTER(!isIRI(?subject))
    BIND("non-iri-property-path" AS ?problem)
  }
}
ORDER BY ?problem ?subject
