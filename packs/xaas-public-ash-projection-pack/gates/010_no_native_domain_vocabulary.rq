# MESSAGE: This projection pack may define local SHACL shape instances but must not invent XaaS domain classes or properties.
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?subject ?problem WHERE {
  VALUES ?kind { owl:Class rdf:Property owl:ObjectProperty owl:DatatypeProperty }
  ?subject a ?kind .
  FILTER(
    STRSTARTS(STR(?subject), "https://ggen.io/profile/xaas/") ||
    STRSTARTS(STR(?subject), "https://ggen.io/ontology/xaas") ||
    STRSTARTS(STR(?subject), "urn:xaas:")
  )
  BIND("native-xaas-domain-vocabulary-refused" AS ?problem)
}
ORDER BY ?subject ?problem
