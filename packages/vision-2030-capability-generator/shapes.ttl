@prefix v30: <https://ggen.io/marketplace/vision2030#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

v30:CapabilityShape a sh:NodeShape ;
  sh:targetClass v30:Capability ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path v30:family ; sh:minCount 1 ; sh:maxCount 1 ; sh:class v30:CapabilityFamily ] ;
  sh:property [ sh:path v30:leverageScore ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:maxInclusive 100 ] ;
  sh:property [ sh:path v30:requiredStanding ; sh:minCount 1 ; sh:maxCount 1 ] .

v30:FamilyShape a sh:NodeShape ;
  sh:targetClass v30:CapabilityFamily ;
  sh:property [ sh:path v30:problemEliminated ; sh:minCount 1 ] ;
  sh:property [ sh:path v30:primitiveRequirement ; sh:minCount 1 ] ;
  sh:property [ sh:path v30:ggenRole ; sh:minCount 1 ] ;
  sh:property [ sh:path v30:consequence2030 ; sh:minCount 1 ] .
