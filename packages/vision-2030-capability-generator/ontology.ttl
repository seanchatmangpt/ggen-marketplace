@prefix v30: <https://ggen.io/marketplace/vision2030#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

v30:Capability a rdfs:Class .
v30:CapabilityFamily a rdfs:Class .
v30:Standing a rdfs:Class .
v30:ALIVE a v30:Standing ; skos:prefLabel "ALIVE" .

v30:family-semantic a v30:CapabilityFamily ; skos:prefLabel "Semantic Substrate" ; v30:problemEliminated "semantic duplication" ; v30:primitiveRequirement "RDF + SHACL + SPARQL + PROV-O" ; v30:ggenRole "compile admitted graphs into semantic IR" ; v30:consequence2030 "one semantic truth drives many lawful projections" .
v30:family-manufacture a v30:CapabilityFamily ; skos:prefLabel "Deterministic Manufacture" ; v30:problemEliminated "handwritten build orchestration" ; v30:primitiveRequirement "manufacturing IR + content addressing + receipts" ; v30:ggenRole "compile projection DAGs and validators" ; v30:consequence2030 "reproducible manufacture replaces bespoke codegen" .
v30:family-protocol a v30:CapabilityFamily ; skos:prefLabel "Protocol Manufacture" ; v30:problemEliminated "protocol glue" ; v30:primitiveRequirement "interaction ontology + schema IR + adapters" ; v30:ggenRole "project one capability graph into protocol surfaces" ; v30:consequence2030 "protocols become replaceable projections" .
v30:family-gym a v30:CapabilityFamily ; skos:prefLabel "Gym Manufacture" ; v30:problemEliminated "hand-built benchmarks" ; v30:primitiveRequirement "GymAct + environment ontology + falsifiers + replay" ; v30:ggenRole "manufacture bounded executable gyms" ; v30:consequence2030 "any bounded system becomes a falsifiable learning environment" .
v30:family-planner a v30:CapabilityFamily ; skos:prefLabel "Planner Manufacture" ; v30:problemEliminated "single-planner lock-in" ; v30:primitiveRequirement "planner ontology + portfolio adapters + receipts" ; v30:ggenRole "manufacture planner competitions and selectors" ; v30:consequence2030 "planning abundance becomes bounded portfolio throughput" .
v30:family-formal a v30:CapabilityFamily ; skos:prefLabel "Formal Admission" ; v30:problemEliminated "proof/runtime drift" ; v30:primitiveRequirement "formal IR + Lean/SMT/model checking + negative fixtures" ; v30:ggenRole "project semantic law into independent courts" ; v30:consequence2030 "proof capacity scales with manufacture capacity" .
v30:family-receipts a v30:CapabilityFamily ; skos:prefLabel "Receipts and Authority" ; v30:problemEliminated "unreceipted actuation and stale evidence" ; v30:primitiveRequirement "PROV-O + ODRL + BRCE + canonical digests" ; v30:ggenRole "compile authority envelopes and receipt DAGs" ; v30:consequence2030 "verified consequence becomes composable and replayable" .
v30:family-enterprise a v30:CapabilityFamily ; skos:prefLabel "Enterprise and Cloud Compilation" ; v30:problemEliminated "enterprise translation layers" ; v30:primitiveRequirement "business ontology + cloud ontology + process evidence" ; v30:ggenRole "project enterprise intent into governed operating surfaces" ; v30:consequence2030 "organizations and clouds become verifiable semantic projections" .
v30:family-autonomic a v30:CapabilityFamily ; skos:prefLabel "Autonomic Learning" ; v30:problemEliminated "repeated cognition on solved work" ; v30:primitiveRequirement "GymAct + OCEL + proofs + ggen packs + receipts" ; v30:ggenRole "compile discovered invariants into deterministic machinery" ; v30:consequence2030 "intelligence budget moves to the unknown frontier" .
v30:family-physical a v30:CapabilityFamily ; skos:prefLabel "Physical Consequence" ; v30:problemEliminated "digital plans divorced from physical scarcity and legitimacy" ; v30:primitiveRequirement "SOSA + QUDT + BRCE + safety envelopes + identity" ; v30:ggenRole "manufacture guarded physical consequence and cleanup" ; v30:consequence2030 "abundant cognition cannot bypass physics authority or legitimacy" .

