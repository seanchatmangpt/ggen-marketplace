PREFIX v30: <https://ggen.io/marketplace/vision2030#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?name ?definition ?family ?problem ?primitives ?ggenRole ?score ?standing ?falsifier ?consequence WHERE {
  ?cap a v30:Capability ; skos:prefLabel ?name ; v30:family ?f ; v30:leverageScore ?score ; v30:requiredStanding ?s .
  ?f skos:prefLabel ?family ; v30:problemEliminated ?problem ; v30:primitiveRequirement ?primitives ; v30:ggenRole ?ggenRole ; v30:consequence2030 ?consequence .
  ?s skos:prefLabel ?standing .
  BIND(CONCAT(?name, " as a reusable capability for cognition-abundant systems.") AS ?definition)
  BIND(CONCAT(?name, " is falsified when its claimed invariant fails on an admitted exact subject.") AS ?falsifier)
}
ORDER BY DESC(?score) ?family ?name
