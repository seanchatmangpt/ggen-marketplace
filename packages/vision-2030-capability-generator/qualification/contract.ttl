@prefix q: <https://ggen.io/marketplace/vision2030/qualification#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

q:QualificationActivity a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    dcterms:description "Bounded deterministic qualification of one immutable Vision 2030 subject." .

q:QualificationReceipt a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    dcterms:description "Evidence projection emitted by qualification. It cannot certify its own workflow conclusion." .

q:AdmittedSubject a rdfs:Class ;
    rdfs:subClassOf prov:Entity .

q:Actuate a odrl:Action ;
    rdfs:label "perform consequential external actuation" .

q:NoAmbientDo a odrl:Prohibition ;
    odrl:action q:Actuate ;
    odrl:target q:AdmittedSubject .

q:Vision2030QualificationPolicy a odrl:Policy ;
    dcterms:title "Vision 2030 exact-subject qualification policy" ;
    q:authorityCeiling "CONSTRUCT_ONLY" ;
    q:doAuthority false ;
    q:requiresExactSubject true ;
    q:externalExecutionRequired true ;
    q:selfCertificationAllowed false ;
    odrl:prohibition q:NoAmbientDo .

q:authorityCeiling a rdf:Property .
q:doAuthority a rdf:Property ; rdfs:range xsd:boolean .
q:requiresExactSubject a rdf:Property ; rdfs:range xsd:boolean .
q:externalExecutionRequired a rdf:Property ; rdfs:range xsd:boolean .
q:selfCertificationAllowed a rdf:Property ; rdfs:range xsd:boolean .
