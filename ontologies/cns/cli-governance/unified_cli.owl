<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:cli="http://cns.io/unified-cli#"
    xmlns:otel="http://opentelemetry.io/ontology#"
    xmlns:weaver="http://opentelemetry.io/weaver#"
    xmlns:uvmgr="http://cns.io/uvmgr#"
    xmlns:shacl="http://www.w3.org/ns/shacl#">

    <!-- Ontology Declaration -->
    <owl:Ontology rdf:about="http://cns.io/unified-cli#">
        <rdfs:label>Unified CLI Ontology</rdfs:label>
        <rdfs:comment>Comprehensive ontology for unified CLI system with OTEL Weaver integration and uvmgr three-tier architecture</rdfs:comment>
        <owl:versionInfo>2.0.0</owl:versionInfo>
        <owl:imports rdf:resource="http://opentelemetry.io/ontology#"/>
        <owl:imports rdf:resource="http://opentelemetry.io/weaver#"/>
        <owl:imports rdf:resource="http://cns.io/uvmgr#"/>
    </owl:Ontology>

    <!-- =============================================================================
         CORE CLI ARCHITECTURE CLASSES
         ============================================================================= -->

    <!-- Base Command Infrastructure -->
    <owl:Class rdf:about="http://cns.io/unified-cli#Command">
        <rdfs:label>CLI Command</rdfs:label>
        <rdfs:comment>Base class for all CLI commands in the unified system</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://opentelemetry.io/ontology#Instrumentable"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#CommandGroup">
        <rdfs:label>Command Group</rdfs:label>
        <rdfs:comment>Grouping of related commands (e.g., turtle, semantic, bitactor)</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#SubApplication">
        <rdfs:label>Sub Application</rdfs:label>
        <rdfs:comment>Typer sub-application containing command groups</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#CommandGroup"/>
    </owl:Class>

    <!-- Command Priority Classes (80/20 Analysis) -->
    <owl:Class rdf:about="http://cns.io/unified-cli#CoreCommand">
        <rdfs:label>Core Command</rdfs:label>
        <rdfs:comment>High-priority commands providing 80% of value with 20% of commands</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#Command"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#ExtendedCommand">
        <rdfs:label>Extended Command</rdfs:label>
        <rdfs:comment>Specialized commands for edge cases and advanced features</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#Command"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#HeuristicCommand">
        <rdfs:label>Heuristic Command</rdfs:label>
        <rdfs:comment>Commands implementing heuristic algorithms and optimizations</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#CoreCommand"/>
    </owl:Class>

    <!-- Specific Command Groups -->
    <owl:Class rdf:about="http://cns.io/unified-cli#TurtleCommand">
        <rdfs:label>Turtle Command</rdfs:label>
        <rdfs:comment>Turtle file analysis and generation commands</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#CoreCommand"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#SemanticCommand">
        <rdfs:label>Semantic Command</rdfs:label>
        <rdfs:comment>RDF/TTL/SPARQL processing commands</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#CoreCommand"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#BitActorCommand">
        <rdfs:label>BitActor Command</rdfs:label>
        <rdfs:comment>BitActor code generation and management commands</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#CoreCommand"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#PipelineCommand">
        <rdfs:label>Pipeline Command</rdfs:label>
        <rdfs:comment>Pipeline orchestration and workflow commands</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#CoreCommand"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#DeploymentCommand">
        <rdfs:label>Deployment Command</rdfs:label>
        <rdfs:comment>Deployment and infrastructure management commands</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#ExtendedCommand"/>
    </owl:Class>

    <!-- uvmgr Three-Tier Architecture -->
    <owl:Class rdf:about="http://cns.io/unified-cli#L1Command">
        <rdfs:label>L1 Command</rdfs:label>
        <rdfs:comment>Level 1: Direct system commands with immediate execution</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:subClassOf rdf:resource="http://cns.io/uvmgr#L1Operation"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#L2Command">
        <rdfs:label>L2 Command</rdfs:label>
        <rdfs:comment>Level 2: Coordinated commands with state management</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:subClassOf rdf:resource="http://cns.io/uvmgr#L2Operation"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#L3Command">
        <rdfs:label>L3 Command</rdfs:label>
        <rdfs:comment>Level 3: Strategic commands with cross-system orchestration</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:subClassOf rdf:resource="http://cns.io/uvmgr#L3Operation"/>
    </owl:Class>

    <!-- Parameter Types -->
    <owl:Class rdf:about="http://cns.io/unified-cli#Parameter">
        <rdfs:label>Command Parameter</rdfs:label>
        <rdfs:comment>Base class for command parameters</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#Argument">
        <rdfs:label>Command Argument</rdfs:label>
        <rdfs:comment>Positional argument for CLI commands</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#Parameter"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#Option">
        <rdfs:label>Command Option</rdfs:label>
        <rdfs:comment>Named option/flag for CLI commands</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#Parameter"/>
    </owl:Class>

    <!-- OTEL Integration Classes -->
    <owl:Class rdf:about="http://cns.io/unified-cli#InstrumentedCommand">
        <rdfs:label>Instrumented Command</rdfs:label>
        <rdfs:comment>Command with OpenTelemetry instrumentation</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:subClassOf rdf:resource="http://opentelemetry.io/ontology#Span"/>
    </owl:Class>

    <owl:Class rdf:about="http://cns.io/unified-cli#MetricCommand">
        <rdfs:label>Metric Command</rdfs:label>
        <rdfs:comment>Command that generates OTEL metrics</rdfs:comment>
        <rdfs:subClassOf rdf:resource="http://cns.io/unified-cli#InstrumentedCommand"/>
    </owl:Class>

    <!-- =============================================================================
         OTEL WEAVER INTEGRATION PROPERTIES
         ============================================================================= -->

    <!-- Command Identification -->
    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#commandName">
        <rdfs:label>Command Name</rdfs:label>
        <rdfs:comment>The CLI command name (e.g., 'turtle analyze')</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#commandGroup">
        <rdfs:label>Command Group</rdfs:label>
        <rdfs:comment>The command group/sub-app (e.g., 'turtle', 'semantic')</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#helpText">
        <rdfs:label>Help Text</rdfs:label>
        <rdfs:comment>Command description for CLI help</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- OTEL Instrumentation Properties -->
    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#spanName">
        <rdfs:label>Span Name</rdfs:label>
        <rdfs:comment>OpenTelemetry span name for command execution</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#InstrumentedCommand"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#metricName">
        <rdfs:label>Metric Name</rdfs:label>
        <rdfs:comment>OpenTelemetry metric name for command performance</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#MetricCommand"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#traceName">
        <rdfs:label>Trace Name</rdfs:label>
        <rdfs:comment>OpenTelemetry trace name for distributed command execution</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#InstrumentedCommand"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- Implementation Properties -->
    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#moduleFile">
        <rdfs:label>Module File</rdfs:label>
        <rdfs:comment>Python module file containing command implementation</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#functionName">
        <rdfs:label>Function Name</rdfs:label>
        <rdfs:comment>Python function implementing the command</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- 80/20 Analysis Properties -->
    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#priority">
        <rdfs:label>Priority</rdfs:label>
        <rdfs:comment>Command priority level (high/medium/low)</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#coverage">
        <rdfs:label>Coverage</rdfs:label>
        <rdfs:comment>Percentage of use cases covered by this command (80/20 analysis)</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#usageFrequency">
        <rdfs:label>Usage Frequency</rdfs:label>
        <rdfs:comment>Expected usage frequency (daily/weekly/monthly/rare)</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- Parameter Properties -->
    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#parameterName">
        <rdfs:label>Parameter Name</rdfs:label>
        <rdfs:comment>Name of the command parameter</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Parameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#parameterType">
        <rdfs:label>Parameter Type</rdfs:label>
        <rdfs:comment>Type of the parameter (str, int, bool, Path, etc.)</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Parameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#required">
        <rdfs:label>Required</rdfs:label>
        <rdfs:comment>Whether the parameter is required</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Parameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#defaultValue">
        <rdfs:label>Default Value</rdfs:label>
        <rdfs:comment>Default value for optional parameters</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Parameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- uvmgr Integration Properties -->
    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#architectureLevel">
        <rdfs:label>Architecture Level</rdfs:label>
        <rdfs:comment>uvmgr three-tier architecture level (L1/L2/L3)</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://cns.io/unified-cli#coordinationRequired">
        <rdfs:label>Coordination Required</rdfs:label>
        <rdfs:comment>Whether command requires cross-system coordination</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://cns.io/unified-cli#hasParameter">
        <rdfs:label>Has Parameter</rdfs:label>
        <rdfs:comment>Command has a parameter</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://cns.io/unified-cli#Parameter"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cns.io/unified-cli#belongsToGroup">
        <rdfs:label>Belongs To Group</rdfs:label>
        <rdfs:comment>Command belongs to a command group</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://cns.io/unified-cli#CommandGroup"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cns.io/unified-cli#dependsOn">
        <rdfs:label>Depends On</rdfs:label>
        <rdfs:comment>Command depends on another command</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#Command"/>
        <rdfs:range rdf:resource="http://cns.io/unified-cli#Command"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cns.io/unified-cli#generatesSpan">
        <rdfs:label>Generates Span</rdfs:label>
        <rdfs:comment>Command generates an OTEL span</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#InstrumentedCommand"/>
        <rdfs:range rdf:resource="http://opentelemetry.io/ontology#Span"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://cns.io/unified-cli#generatesMetric">
        <rdfs:label>Generates Metric</rdfs:label>
        <rdfs:comment>Command generates an OTEL metric</rdfs:comment>
        <rdfs:domain rdf:resource="http://cns.io/unified-cli#MetricCommand"/>
        <rdfs:range rdf:resource="http://opentelemetry.io/ontology#Metric"/>
    </owl:ObjectProperty>

</rdf:RDF>