<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#">
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
    <!ENTITY bwp "http://bitflow.org/ontology/workflow-patterns#">
    <!ENTITY vdaalst "http://workflowpatterns.com/patterns#">
    <!ENTITY perf "http://bitflow.org/ontology/performance#">
    <!ENTITY yawl "http://www.yawlfoundation.org/ontology#">
    <!ENTITY fraud "http://bitflow.org/ontology/fraud-detection#">
]>

<rdf:RDF xmlns="http://bitflow.org/ontology/workflow-patterns#"
         xml:base="http://bitflow.org/ontology/workflow-patterns"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:bwp="http://bitflow.org/ontology/workflow-patterns#"
         xmlns:vdaalst="http://workflowpatterns.com/patterns#"
         xmlns:perf="http://bitflow.org/ontology/performance#"
         xmlns:yawl="http://www.yawlfoundation.org/ontology#"
         xmlns:fraud="http://bitflow.org/ontology/fraud-detection#">

    <owl:Ontology rdf:about="http://bitflow.org/ontology/workflow-patterns">
        <owl:versionIRI rdf:resource="http://bitflow.org/ontology/workflow-patterns/3.0"/>
        <rdfs:label>BitFlow Complete Workflow Patterns Ontology v3.0</rdfs:label>
        <rdfs:comment>Complete OWL ontology for all 43 van der Aalst workflow patterns with BitFlow implementation status, performance fraud detection (52,704x threshold), memory leak prevention (374MB), and YAWL compatibility mappings. Designed by OWL_Ontology_Architect agent for BitFlow OWL TTL YAWL integration.</rdfs:comment>
        <owl:versionInfo>3.0.0</owl:versionInfo>
        <rdfs:seeAlso rdf:resource="http://workflowpatterns.com"/>
        <rdfs:seeAlso rdf:resource="https://github.com/bitflow-engine/bitflow"/>
        <rdfs:seeAlso rdf:resource="https://www.yawlfoundation.org/"/>
        <owl:imports rdf:resource="http://www.yawlfoundation.org/ontology"/>
    </owl:Ontology>

    <!-- ===================================================================== -->
    <!-- ROOT ONTOLOGY STRUCTURE -->
    <!-- ===================================================================== -->

    <owl:Class rdf:about="&bwp;WorkflowPattern">
        <rdfs:label>Workflow Pattern</rdfs:label>
        <rdfs:comment>Abstract base class for all 43 van der Aalst workflow patterns</rdfs:comment>
        <owl:equivalentClass rdf:resource="&vdaalst;Pattern"/>
    </owl:Class>

    <owl:Class rdf:about="&bwp;ControlFlowPattern">
        <rdfs:label>Control Flow Pattern</rdfs:label>
        <rdfs:comment>Patterns describing task execution ordering and flow control (Patterns 1-43)</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;WorkflowPattern"/>
    </owl:Class>

    <!-- ===================================================================== -->
    <!-- PATTERN CATEGORIES (8 Categories covering all 43 patterns) -->
    <!-- ===================================================================== -->

    <!-- Category 1: Basic Control Flow Patterns (1-5) -->
    <owl:Class rdf:about="&bwp;BasicControlFlowPattern">
        <rdfs:label>Basic Control Flow Pattern</rdfs:label>
        <rdfs:comment>Fundamental patterns covering 80% of real-world workflows (WCP 1-5)</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;ControlFlowPattern"/>
    </owl:Class>

    <!-- Category 2: Advanced Branching and Synchronization (6-11) -->
    <owl:Class rdf:about="&bwp;AdvancedBranchingPattern">
        <rdfs:label>Advanced Branching Pattern</rdfs:label>
        <rdfs:comment>Complex branching and synchronization patterns (WCP 6-11)</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;ControlFlowPattern"/>
    </owl:Class>

    <!-- Category 3: Multiple Instance Patterns (12-15) -->
    <owl:Class rdf:about="&bwp;MultipleInstancePattern">
        <rdfs:label>Multiple Instance Pattern</rdfs:label>
        <rdfs:comment>Patterns involving multiple instances of tasks or subprocesses (WCP 12-15)</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;ControlFlowPattern"/>
    </owl:Class>

    <!-- Category 4: State-based Patterns (16-18) -->
    <owl:Class rdf:about="&bwp;StateBasedPattern">
        <rdfs:label>State-based Pattern</rdfs:label>
        <rdfs:comment>Patterns based on workflow state and conditions (WCP 16-18)</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;ControlFlowPattern"/>
    </owl:Class>

    <!-- Category 5: Cancellation Patterns (19-25) -->
    <owl:Class rdf:about="&bwp;CancellationPattern">
        <rdfs:label>Cancellation Pattern</rdfs:label>
        <rdfs:comment>Patterns for cancelling or removing tasks/instances (WCP 19-25)</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;ControlFlowPattern"/>
    </owl:Class>

    <!-- Category 6: Trigger Patterns (26-28, 40-43) -->
    <owl:Class rdf:about="&bwp;TriggerPattern">
        <rdfs:label>Trigger Pattern</rdfs:label>
        <rdfs:comment>Event-driven and external trigger patterns</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;ControlFlowPattern"/>
    </owl:Class>

    <!-- Category 7: Structural Patterns (10-11, 21-22) -->
    <owl:Class rdf:about="&bwp;StructuralPattern">
        <rdfs:label>Structural Pattern</rdfs:label>
        <rdfs:comment>Patterns involving workflow structure and cycles</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;ControlFlowPattern"/>
    </owl:Class>

    <!-- Category 8: New Control Flow Patterns (26-39) -->
    <owl:Class rdf:about="&bwp;NewControlFlowPattern">
        <rdfs:label>New Control Flow Pattern</rdfs:label>
        <rdfs:comment>Advanced patterns beyond basic van der Aalst set (WCP 26-39)</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;ControlFlowPattern"/>
    </owl:Class>

    <!-- ===================================================================== -->
    <!-- PERFORMANCE FRAUD DETECTION ONTOLOGY -->
    <!-- ===================================================================== -->

    <owl:Class rdf:about="&fraud;PerformanceFraud">
        <rdfs:label>Performance Fraud</rdfs:label>
        <rdfs:comment>Detection of 52,704x performance degradation patterns</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="&fraud;MemoryLeak">
        <rdfs:label>Memory Leak</rdfs:label>
        <rdfs:comment>Detection of 374MB+ memory leaks</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="&perf;PerformanceMetric">
        <rdfs:label>Performance Metric</rdfs:label>
        <rdfs:comment>Measurable performance characteristics</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="&perf;ThroughputMetric">
        <rdfs:label>Throughput Metric</rdfs:label>
        <rdfs:comment>Operations per second measurement</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&perf;PerformanceMetric"/>
    </owl:Class>

    <owl:Class rdf:about="&perf;LatencyMetric">
        <rdfs:label>Latency Metric</rdfs:label>
        <rdfs:comment>Response time measurement in nanoseconds</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&perf;PerformanceMetric"/>
    </owl:Class>

    <owl:Class rdf:about="&perf;MemoryMetric">
        <rdfs:label>Memory Metric</rdfs:label>
        <rdfs:comment>Memory usage measurement in bytes</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&perf;PerformanceMetric"/>
    </owl:Class>

    <!-- ===================================================================== -->
    <!-- OBJECT PROPERTIES (Relationships) -->
    <!-- ===================================================================== -->

    <owl:ObjectProperty rdf:about="&bwp;requires">
        <rdfs:label>requires</rdfs:label>
        <rdfs:comment>Pattern A requires Pattern B for implementation</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&bwp;WorkflowPattern"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&bwp;conflicts">
        <rdfs:label>conflicts</rdfs:label>
        <rdfs:comment>Pattern A conflicts with Pattern B</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&bwp;WorkflowPattern"/>
        <owl:propertyDisjointWith rdf:resource="&bwp;requires"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&bwp;composedOf">
        <rdfs:label>composed of</rdfs:label>
        <rdfs:comment>Complex pattern composed of simpler patterns</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&bwp;WorkflowPattern"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&bwp;hasPerformanceCharacteristic">
        <rdfs:label>has performance characteristic</rdfs:label>
        <rdfs:comment>Pattern has specific performance characteristics</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&perf;PerformanceMetric"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&bwp;mapsToYAWLConstruct">
        <rdfs:label>maps to YAWL construct</rdfs:label>
        <rdfs:comment>Maps BitFlow pattern to equivalent YAWL construct</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&yawl;YAWLConstruct"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&fraud;detectsPerformanceFraud">
        <rdfs:label>detects performance fraud</rdfs:label>
        <rdfs:comment>Pattern can detect performance fraud scenarios</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&fraud;PerformanceFraud"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="&fraud;detectsMemoryLeak">
        <rdfs:label>detects memory leak</rdfs:label>
        <rdfs:comment>Pattern can detect memory leak scenarios</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&fraud;MemoryLeak"/>
    </owl:ObjectProperty>

    <!-- ===================================================================== -->
    <!-- DATA PROPERTIES (Attributes) -->
    <!-- ===================================================================== -->

    <owl:DatatypeProperty rdf:about="&bwp;patternId">
        <rdfs:label>pattern ID</rdfs:label>
        <rdfs:comment>Numeric identifier for pattern (1-43)</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&bwp;vdaalstId">
        <rdfs:label>van der Aalst ID</rdfs:label>
        <rdfs:comment>Original van der Aalst pattern identifier (e.g., WCP-1)</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&bwp;bitflowImplemented">
        <rdfs:label>BitFlow implemented</rdfs:label>
        <rdfs:comment>Whether pattern is implemented in current BitFlow version</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&xsd;boolean"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&bwp;criticalForPerformance">
        <rdfs:label>critical for performance</rdfs:label>
        <rdfs:comment>Whether pattern is critical for addressing 52,704x performance issues</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&xsd;boolean"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&bwp;criticalForMemory">
        <rdfs:label>critical for memory</rdfs:label>
        <rdfs:comment>Whether pattern is critical for preventing 374MB memory leaks</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&xsd;boolean"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&bwp;performanceImpact">
        <rdfs:label>performance impact</rdfs:label>
        <rdfs:comment>Level of performance impact (LOW, MEDIUM, HIGH, CRITICAL)</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range>
            <owl:DataRange>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="&rdf;List"/>
                        <rdf:first rdf:datatype="&xsd;string">LOW</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="&rdf;List"/>
                                <rdf:first rdf:datatype="&xsd;string">MEDIUM</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="&rdf;List"/>
                                        <rdf:first rdf:datatype="&xsd;string">HIGH</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="&rdf;List"/>
                                                <rdf:first rdf:datatype="&xsd;string">CRITICAL</rdf:first>
                                                <rdf:rest rdf:resource="&rdf;nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </owl:DataRange>
        </rdfs:range>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&perf;executionComplexity">
        <rdfs:label>execution complexity</rdfs:label>
        <rdfs:comment>Big-O notation for pattern execution complexity</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&perf;memoryFootprint">
        <rdfs:label>memory footprint</rdfs:label>
        <rdfs:comment>Memory usage in bytes for pattern execution</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&perf;estimatedThroughput">
        <rdfs:label>estimated throughput</rdfs:label>
        <rdfs:comment>Estimated operations per second</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&perf;estimatedLatency">
        <rdfs:label>estimated latency</rdfs:label>
        <rdfs:comment>Estimated execution latency in nanoseconds</rdfs:comment>
        <rdfs:domain rdf:resource="&bwp;WorkflowPattern"/>
        <rdfs:range rdf:resource="&xsd;int"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fraud;performanceFraudFactor">
        <rdfs:label>performance fraud factor</rdfs:label>
        <rdfs:comment>Multiplier indicating performance degradation (52,704x threshold)</rdfs:comment>
        <rdfs:domain rdf:resource="&fraud;PerformanceFraud"/>
        <rdfs:range rdf:resource="&xsd;double"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="&fraud;memoryLeakThreshold">
        <rdfs:label>memory leak threshold</rdfs:label>
        <rdfs:comment>Memory usage threshold for leak detection (374MB = 392,167,424 bytes)</rdfs:comment>
        <rdfs:domain rdf:resource="&fraud;MemoryLeak"/>
        <rdfs:range rdf:resource="&xsd;long"/>
    </owl:DatatypeProperty>

    <!-- ===================================================================== -->
    <!-- ALL 43 VAN DER AALST WORKFLOW PATTERNS -->
    <!-- ===================================================================== -->

    <!-- CATEGORY 1: Basic Control Flow Patterns (1-5) - IMPLEMENTED -->
    
    <owl:Class rdf:about="&bwp;Sequence">
        <rdfs:label>Sequence (WCP-1)</rdfs:label>
        <rdfs:comment>Task A followed by Task B in sequential order</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;BasicControlFlowPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">1</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-1</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">true</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">false</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">false</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">LOW</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(1)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">32</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">1000000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">100</perf:estimatedLatency>
    </owl:Class>

    <owl:Class rdf:about="&bwp;ParallelSplit">
        <rdfs:label>Parallel Split (WCP-2)</rdfs:label>
        <rdfs:comment>Point where single thread splits into multiple parallel threads</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;BasicControlFlowPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">2</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-2</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">true</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">true</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">true</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">HIGH</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(n)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">64</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">500000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">200</perf:estimatedLatency>
    </owl:Class>

    <owl:Class rdf:about="&bwp;Synchronization">
        <rdfs:label>Synchronization (WCP-3)</rdfs:label>
        <rdfs:comment>Point where multiple parallel threads converge into single thread</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;BasicControlFlowPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">3</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-3</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">true</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">true</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">true</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">HIGH</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(n)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">96</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">400000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">300</perf:estimatedLatency>
    </owl:Class>

    <owl:Class rdf:about="&bwp;ExclusiveChoice">
        <rdfs:label>Exclusive Choice (WCP-4)</rdfs:label>
        <rdfs:comment>Point where single thread chooses one of several alternatives</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;BasicControlFlowPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">4</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-4</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">true</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">false</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">false</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">MEDIUM</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(1)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">48</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">800000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">150</perf:estimatedLatency>
    </owl:Class>

    <owl:Class rdf:about="&bwp;SimpleMerge">
        <rdfs:label>Simple Merge (WCP-5)</rdfs:label>
        <rdfs:comment>Point where one of several alternative branches reconverges</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;BasicControlFlowPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">5</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-5</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">true</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">false</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">false</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">MEDIUM</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(1)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">40</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">750000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">125</perf:estimatedLatency>
    </owl:Class>

    <!-- CATEGORY 2: Advanced Branching and Synchronization Patterns (6-11) - MOSTLY MISSING -->

    <owl:Class rdf:about="&bwp;MultiChoice">
        <rdfs:label>Multi-Choice (WCP-6)</rdfs:label>
        <rdfs:comment>Point where one or more branches can be chosen based on decision</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;AdvancedBranchingPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">6</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-6</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">false</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">true</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">true</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">CRITICAL</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(2^n)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">128</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">100000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">1000</perf:estimatedLatency>
    </owl:Class>

    <owl:Class rdf:about="&bwp;StructuredSynchronizingMerge">
        <rdfs:label>Structured Synchronizing Merge (WCP-7)</rdfs:label>
        <rdfs:comment>Merge pattern for multi-choice that waits for active branches</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;AdvancedBranchingPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">7</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-7</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">false</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">true</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">true</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">CRITICAL</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(n)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">256</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">80000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">1500</perf:estimatedLatency>
    </owl:Class>

    <owl:Class rdf:about="&bwp;MultiMerge">
        <rdfs:label>Multi-Merge (WCP-8)</rdfs:label>
        <rdfs:comment>Merge point that converges multiple threads without synchronization</rdfs:comment>
