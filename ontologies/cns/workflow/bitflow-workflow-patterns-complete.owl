        <perf:memoryFootprint rdf:datatype="&xsd;int">224</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">140000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">700</perf:estimatedLatency>
    </owl:Class>

    <owl:Class rdf:about="&bwp;StructuredPartialJoin">
        <rdfs:label>Structured Partial Join (WCP-28)</rdfs:label>
        <rdfs:comment>Joins N of M branches in structured context</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;NewControlFlowPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">28</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-28</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">false</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">true</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">true</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">CRITICAL</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(n)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">288</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">90000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">1100</perf:estimatedLatency>
    </owl:Class>

    <!-- Continuing with patterns 29-43... (for brevity, showing key remaining patterns) -->

    <owl:Class rdf:about="&bwp;GeneralizedAndJoin">
        <rdfs:label>Generalized AND-Join (WCP-37)</rdfs:label>
        <rdfs:comment>Waits for all active incoming branches</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;NewControlFlowPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">37</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-37</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">false</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">true</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">true</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">CRITICAL</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(2^n)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">512</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">30000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">3000</perf:estimatedLatency>
    </owl:Class>

    <!-- CATEGORY 7: Trigger Patterns (40-43) -->

    <owl:Class rdf:about="&bwp;ThreadSplit">
        <rdfs:label>Thread Split (WCP-40)</rdfs:label>
        <rdfs:comment>Point where single thread splits into multiple threads</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;TriggerPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">40</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-40</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">false</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">true</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">true</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">HIGH</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(n)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">128</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">300000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">350</perf:estimatedLatency>
    </owl:Class>

    <owl:Class rdf:about="&bwp;ExplicitTermination">
        <rdfs:label>Explicit Termination (WCP-41)</rdfs:label>
        <rdfs:comment>Workflow terminates when explicit termination condition met</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;TriggerPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">41</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-41</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">false</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">false</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">false</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">LOW</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(1)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">24</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">900000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">110</perf:estimatedLatency>
    </owl:Class>

    <owl:Class rdf:about="&bwp;ThreadMerge">
        <rdfs:label>Thread Merge (WCP-42)</rdfs:label>
        <rdfs:comment>Point where multiple threads merge into single thread</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;TriggerPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">42</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-42</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">false</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">true</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">false</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">HIGH</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(n)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">96</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">400000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">250</perf:estimatedLatency>
    </owl:Class>

    <owl:Class rdf:about="&bwp;NonLocalSynchronization">
        <rdfs:label>Non-Local Synchronization (WCP-43)</rdfs:label>
        <rdfs:comment>Synchronization across process boundaries</rdfs:comment>
        <rdfs:subClassOf rdf:resource="&bwp;TriggerPattern"/>
        <bwp:patternId rdf:datatype="&xsd;int">43</bwp:patternId>
        <bwp:vdaalstId rdf:datatype="&xsd;string">WCP-43</bwp:vdaalstId>
        <bwp:bitflowImplemented rdf:datatype="&xsd;boolean">false</bwp:bitflowImplemented>
        <bwp:criticalForPerformance rdf:datatype="&xsd;boolean">true</bwp:criticalForPerformance>
        <bwp:criticalForMemory rdf:datatype="&xsd;boolean">true</bwp:criticalForMemory>
        <bwp:performanceImpact rdf:datatype="&xsd;string">CRITICAL</bwp:performanceImpact>
        <perf:executionComplexity rdf:datatype="&xsd;string">O(n^2)</perf:executionComplexity>
        <perf:memoryFootprint rdf:datatype="&xsd;int">1024</perf:memoryFootprint>
        <perf:estimatedThroughput rdf:datatype="&xsd;int">15000</perf:estimatedThroughput>
        <perf:estimatedLatency rdf:datatype="&xsd;int">6000</perf:estimatedLatency>
    </owl:Class>

    <!-- ===================================================================== -->
    <!-- PERFORMANCE FRAUD DETECTION INSTANCES -->
    <!-- ===================================================================== -->

    <!-- Performance fraud detection threshold -->
    <fraud:PerformanceFraud rdf:about="&fraud;BitFlowPerformanceFraudThreshold">
        <rdfs:label>BitFlow Performance Fraud Threshold</rdfs:label>
        <rdfs:comment>Threshold for detecting 52,704x performance degradation in BitFlow patterns</rdfs:comment>
        <fraud:performanceFraudFactor rdf:datatype="&xsd;double">52704.0</fraud:performanceFraudFactor>
    </fraud:PerformanceFraud>

    <!-- Memory leak detection threshold -->
    <fraud:MemoryLeak rdf:about="&fraud;BitFlowMemoryLeakThreshold">
        <rdfs:label>BitFlow Memory Leak Threshold</rdfs:label>
        <rdfs:comment>Threshold for detecting 374MB+ memory leaks in BitFlow patterns</rdfs:comment>
        <fraud:memoryLeakThreshold rdf:datatype="&xsd;long">392167424</fraud:memoryLeakThreshold>
    </fraud:MemoryLeak>

    <!-- ===================================================================== -->
    <!-- PATTERN RELATIONSHIPS AND DEPENDENCIES -->
    <!-- ===================================================================== -->

    <!-- Define critical relationships between patterns -->
    <rdf:Description rdf:about="&bwp;ParallelSplit">
        <bwp:requires rdf:resource="&bwp;Synchronization"/>
        <rdfs:comment>Parallel split requires synchronization for proper completion</rdfs:comment>
    </rdf:Description>

    <rdf:Description rdf:about="&bwp;ExclusiveChoice">
        <bwp:requires rdf:resource="&bwp;SimpleMerge"/>
        <rdfs:comment>Exclusive choice requires simple merge for branch reconvergence</rdfs:comment>
    </rdf:Description>

    <rdf:Description rdf:about="&bwp;MultiChoice">
        <bwp:requires rdf:resource="&bwp;StructuredSynchronizingMerge"/>
        <rdfs:comment>Multi-choice requires structured synchronizing merge</rdfs:comment>
    </rdf:Description>

    <!-- YAWL Mappings for implemented patterns -->
    <rdf:Description rdf:about="&bwp;Sequence">
        <bwp:mapsToYAWLConstruct rdf:resource="&yawl;SequenceTask"/>
    </rdf:Description>

    <rdf:Description rdf:about="&bwp;ParallelSplit">
        <bwp:mapsToYAWLConstruct rdf:resource="&yawl;ANDSplit"/>
    </rdf:Description>

    <rdf:Description rdf:about="&bwp;Synchronization">
        <bwp:mapsToYAWLConstruct rdf:resource="&yawl;ANDJoin"/>
    </rdf:Description>

    <rdf:Description rdf:about="&bwp;ExclusiveChoice">
        <bwp:mapsToYAWLConstruct rdf:resource="&yawl;XORSplit"/>
    </rdf:Description>

    <rdf:Description rdf:about="&bwp;SimpleMerge">
        <bwp:mapsToYAWLConstruct rdf:resource="&yawl;XORJoin"/>
    </rdf:Description>

    <!-- Fraud detection relationships -->
    <rdf:Description rdf:about="&bwp;InterleavedParallelRouting">
        <fraud:detectsPerformanceFraud rdf:resource="&fraud;BitFlowPerformanceFraudThreshold"/>
        <rdfs:comment>O(n!) complexity can trigger 52,704x performance degradation</rdfs:comment>
    </rdf:Description>

    <rdf:Description rdf:about="&bwp;Recursion">
        <fraud:detectsMemoryLeak rdf:resource="&fraud;BitFlowMemoryLeakThreshold"/>
        <rdfs:comment>2048 byte footprint with O(k^n) can cause 374MB+ memory usage</rdfs:comment>
    </rdf:Description>

</rdf:RDF>