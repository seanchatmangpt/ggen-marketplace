<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#">
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
    <!ENTITY dc "http://purl.org/dc/elements/1.1/">
    <!ENTITY otel "http://opentelemetry.io/ontology#">
    <!ENTITY bitstar "http://bitstar.io/ontology#">
]>

<rdf:RDF
    xmlns:owl="&owl;"
    xmlns:rdf="&rdf;"
    xmlns:rdfs="&rdfs;"
    xmlns:xsd="&xsd;"
    xmlns:dc="&dc;"
    xmlns:otel="&otel;"
    xmlns:bitstar="&bitstar;"
    xml:base="http://bitstar.io/ontology">

    <!-- Ontology Declaration -->
    <owl:Ontology rdf:about="http://bitstar.io/ontology">
        <dc:title>BitStar Ecosystem Ontology</dc:title>
        <dc:description>Core ontology defining BitStar services, primitives, and behaviors for automated service generation</dc:description>
        <dc:creator>BitStar AI System</dc:creator>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <rdfs:comment>This ontology models the 20% of concepts that generate 80% of BitStar functionality</rdfs:comment>
    </owl:Ontology>

    <!-- Core Classes -->
    
    <!-- BitActor Hierarchy -->
    <owl:Class rdf:ID="BitActor">
        <rdfs:label>BitActor</rdfs:label>
        <rdfs:comment>Base class for all BitStar actors - fundamental computation units</rdfs:comment>
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Actor"/>
                    <owl:Class rdf:about="#Pool"/>
                    <owl:Class rdf:about="#Supervisor"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:ID="Actor">
        <rdfs:subClassOf rdf:resource="#BitActor"/>
        <rdfs:label>Actor</rdfs:label>
        <rdfs:comment>Individual computation unit that processes messages and maintains state</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="Pool">
        <rdfs:subClassOf rdf:resource="#BitActor"/>
        <rdfs:label>Actor Pool</rdfs:label>
        <rdfs:comment>Collection of actors for load balancing and scaling</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="Supervisor">
        <rdfs:subClassOf rdf:resource="#BitActor"/>
        <rdfs:label>Supervisor</rdfs:label>
        <rdfs:comment>Manages actor lifecycle, fault tolerance, and recovery strategies</rdfs:comment>
    </owl:Class>

    <!-- BitFlow Workflow System -->
    <owl:Class rdf:ID="BitFlow">
        <rdfs:label>BitFlow</rdfs:label>
        <rdfs:comment>Workflow orchestration system for multi-stage processing</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="Stage">
        <rdfs:subClassOf rdf:resource="#BitFlow"/>
        <rdfs:label>Workflow Stage</rdfs:label>
        <rdfs:comment>Individual processing stage within a BitFlow workflow</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="Transition">
        <rdfs:subClassOf rdf:resource="#BitFlow"/>
        <rdfs:label>Stage Transition</rdfs:label>
        <rdfs:comment>Conditional or sequential connection between workflow stages</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="Pattern">
        <rdfs:subClassOf rdf:resource="#BitFlow"/>
        <rdfs:label>Workflow Pattern</rdfs:label>
        <rdfs:comment>Reusable workflow templates (sequential, parallel, conditional, loop)</rdfs:comment>
    </owl:Class>

    <!-- Service Architecture -->
    <owl:Class rdf:ID="Service">
        <rdfs:label>Service</rdfs:label>
        <rdfs:comment>Base class for all BitStar services</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="RESTService">
        <rdfs:subClassOf rdf:resource="#Service"/>
        <rdfs:label>REST Service</rdfs:label>
        <rdfs:comment>HTTP REST API service with CRUD operations</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="GraphQLService">
        <rdfs:subClassOf rdf:resource="#Service"/>
        <rdfs:label>GraphQL Service</rdfs:label>
        <rdfs:comment>GraphQL query and mutation service</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="gRPCService">
        <rdfs:subClassOf rdf:resource="#Service"/>
        <rdfs:label>gRPC Service</rdfs:label>
        <rdfs:comment>High-performance RPC service with protocol buffers</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="WebSocketService">
        <rdfs:subClassOf rdf:resource="#Service"/>
        <rdfs:label>WebSocket Service</rdfs:label>
        <rdfs:comment>Real-time bidirectional communication service</rdfs:comment>
    </owl:Class>

    <!-- Data Models -->
    <owl:Class rdf:ID="DataModel">
        <rdfs:label>Data Model</rdfs:label>
        <rdfs:comment>Abstract representation of data structures and schemas</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="Entity">
        <rdfs:subClassOf rdf:resource="#DataModel"/>
        <rdfs:label>Entity</rdfs:label>
        <rdfs:comment>Business entity with attributes and relationships</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="ValueObject">
        <rdfs:subClassOf rdf:resource="#DataModel"/>
        <rdfs:label>Value Object</rdfs:label>
        <rdfs:comment>Immutable data structure defined by its values</rdfs:comment>
    </owl:Class>

    <!-- Behavioral Constraints -->
    <owl:Class rdf:ID="Constraint">
        <rdfs:label>Constraint</rdfs:label>
        <rdfs:comment>Business rules and behavioral constraints</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="ValidationRule">
        <rdfs:subClassOf rdf:resource="#Constraint"/>
        <rdfs:label>Validation Rule</rdfs:label>
        <rdfs:comment>Data validation and integrity constraints</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="BusinessRule">
        <rdfs:subClassOf rdf:resource="#Constraint"/>
        <rdfs:label>Business Rule</rdfs:label>
        <rdfs:comment>Domain-specific business logic constraints</rdfs:comment>
    </owl:Class>

    <!-- OpenTelemetry Integration -->
    <owl:Class rdf:ID="Instrumentation">
        <rdfs:label>Instrumentation</rdfs:label>
        <rdfs:comment>OpenTelemetry instrumentation configuration</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="Metric">
        <rdfs:subClassOf rdf:resource="#Instrumentation"/>
        <rdfs:label>Metric</rdfs:label>
        <rdfs:comment>Performance and business metrics</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:ID="Trace">
        <rdfs:subClassOf rdf:resource="#Instrumentation"/>
        <rdfs:label>Trace</rdfs:label>
        <rdfs:comment>Distributed tracing spans and operations</rdfs:comment>
    </owl:Class>

    <!-- Object Properties (Relationships) -->
    
    <!-- BitActor Relationships -->
    <owl:ObjectProperty rdf:ID="supervises">
        <rdfs:label>supervises</rdfs:label>
        <rdfs:domain rdf:resource="#Supervisor"/>
        <rdfs:range rdf:resource="#BitActor"/>
        <rdfs:comment>Supervisor manages lifecycle of actors</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:ID="contains">
        <rdfs:label>contains</rdfs:label>
        <rdfs:domain rdf:resource="#Pool"/>
        <rdfs:range rdf:resource="#Actor"/>
        <rdfs:comment>Pool contains multiple actor instances</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:ID="sendsMessageTo">
        <rdfs:label>sends message to</rdfs:label>
        <rdfs:domain rdf:resource="#BitActor"/>
        <rdfs:range rdf:resource="#BitActor"/>
        <rdfs:comment>Actor-to-actor communication</rdfs:comment>
    </owl:ObjectProperty>

    <!-- BitFlow Relationships -->
    <owl:ObjectProperty rdf:ID="hasStage">
        <rdfs:label>has stage</rdfs:label>
        <rdfs:domain rdf:resource="#BitFlow"/>
        <rdfs:range rdf:resource="#Stage"/>
        <rdfs:comment>Workflow contains processing stages</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:ID="transitionsTo">
        <rdfs:label>transitions to</rdfs:label>
        <rdfs:domain rdf:resource="#Stage"/>
        <rdfs:range rdf:resource="#Stage"/>
        <rdfs:comment>Stage-to-stage workflow transitions</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:ID="implementsPattern">
        <rdfs:label>implements pattern</rdfs:label>
        <rdfs:domain rdf:resource="#BitFlow"/>
        <rdfs:range rdf:resource="#Pattern"/>
        <rdfs:comment>Workflow follows specific execution patterns</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Service Relationships -->
    <owl:ObjectProperty rdf:ID="exposes">
        <rdfs:label>exposes</rdfs:label>
        <rdfs:domain rdf:resource="#Service"/>
        <rdfs:range rdf:resource="#DataModel"/>
        <rdfs:comment>Service exposes data models through its interface</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:ID="implements">
        <rdfs:label>implements</rdfs:label>
        <rdfs:domain rdf:resource="#Service"/>
        <rdfs:range rdf:resource="#BitFlow"/>
        <rdfs:comment>Service implements business logic through workflows</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Data Model Relationships -->
    <owl:ObjectProperty rdf:ID="hasRelationship">
        <rdfs:label>has relationship</rdfs:label>
        <rdfs:domain rdf:resource="#Entity"/>
        <rdfs:range rdf:resource="#Entity"/>
        <rdfs:comment>Entity-to-entity relationships</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:ID="composedOf">
        <rdfs:label>composed of</rdfs:label>
        <rdfs:domain rdf:resource="#Entity"/>
        <rdfs:range rdf:resource="#ValueObject"/>
        <rdfs:comment>Entity composition using value objects</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Constraint Relationships -->
    <owl:ObjectProperty rdf:ID="constrains">
        <rdfs:label>constrains</rdfs:label>
        <rdfs:domain rdf:resource="#Constraint"/>
        <rdfs:range rdf:resource="#DataModel"/>
        <rdfs:comment>Constraint applies to data models</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Instrumentation Relationships -->
    <owl:ObjectProperty rdf:ID="instruments">
        <rdfs:label>instruments</rdfs:label>
        <rdfs:domain rdf:resource="#Instrumentation"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Service"/>
                    <owl:Class rdf:about="#BitActor"/>
                    <owl:Class rdf:about="#BitFlow"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Instrumentation applies to services, actors, or workflows</rdfs:comment>
    </owl:ObjectProperty>

    <!-- Data Properties -->
    
    <!-- BitActor Properties -->
    <owl:DatatypeProperty rdf:ID="actorId">
        <rdfs:label>actor ID</rdfs:label>
        <rdfs:domain rdf:resource="#BitActor"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:comment>Unique identifier for actor instance</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:ID="maxInstances">
        <rdfs:label>max instances</rdfs:label>
        <rdfs:domain rdf:resource="#Pool"/>
        <rdfs:range rdf:resource="&xsd;int"/>
        <rdfs:comment>Maximum number of actors in pool</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Service Properties -->
    <owl:DatatypeProperty rdf:ID="endpoint">
        <rdfs:label>endpoint</rdfs:label>
        <rdfs:domain rdf:resource="#Service"/>
        <rdfs:range rdf:resource="&xsd;anyURI"/>
        <rdfs:comment>Service endpoint URL</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:ID="version">
        <rdfs:label>version</rdfs:label>
        <rdfs:domain rdf:resource="#Service"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:comment>Service version identifier</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Pattern Properties -->
    <owl:DatatypeProperty rdf:ID="patternType">
        <rdfs:label>pattern type</rdfs:label>
        <rdfs:domain rdf:resource="#Pattern"/>
        <rdfs:range>
            <owl:DataRange>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:PlainLiteral>sequential</rdf:PlainLiteral>
                    <rdf:PlainLiteral>parallel</rdf:PlainLiteral>
                    <rdf:PlainLiteral>conditional</rdf:PlainLiteral>
                    <rdf:PlainLiteral>loop</rdf:PlainLiteral>
                    <rdf:PlainLiteral>scatter-gather</rdf:PlainLiteral>
                </owl:oneOf>
            </owl:DataRange>
        </rdfs:range>
        <rdfs:comment>Type of workflow execution pattern</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Instrumentation Properties -->
    <owl:DatatypeProperty rdf:ID="metricName">
        <rdfs:label>metric name</rdfs:label>
        <rdfs:domain rdf:resource="#Metric"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:comment>OpenTelemetry metric name</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:ID="spanName">
        <rdfs:label>span name</rdfs:label>
        <rdfs:domain rdf:resource="#Trace"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:comment>OpenTelemetry span name</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- Cardinality Constraints -->
    
    <!-- Every Service must have exactly one endpoint -->
    <owl:Class rdf:ID="ServiceWithEndpoint">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Service"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#endpoint"/>
                        <owl:cardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:cardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- BitFlow must have at least one Stage -->
    <owl:Class rdf:ID="ValidBitFlow">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#BitFlow"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#hasStage"/>
                        <owl:minCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minCardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- Pool must contain at least one Actor -->
    <owl:Class rdf:ID="ValidPool">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class rdf:about="#Pool"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#contains"/>
                        <owl:minCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minCardinality>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

</rdf:RDF>