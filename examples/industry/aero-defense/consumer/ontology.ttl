# Consumer example ontology for industry-aero-defense.
# A minimal, pillar-lawful air-gapped design snapshot: one air-gap boundary
# (loopback only), one cleared principal, two classified artifacts in
# classification-segregated stores, sealed, plus an adjudicated AI
# contribution (P3 proposer-judge).
# Synthetic data only (example.invalid IRIs); synthetic digests.
@prefix ex: <https://example.invalid/aero-defense/> .
@prefix ad: <https://seanchatmangpt.github.io/packs/industry-aero-defense#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex:air-gap a ad:AirGapBoundary ;
    ad:endpoint "http://127.0.0.1:9443" .

ex:analyst a ad:Principal ;
    ad:clearanceLevel ad:Secret .

ex:store-secret a ad:Store .

ex:store-conf a ad:Store .

ex:wing-design-doc a ad:ClassifiedArtifact ;
    ad:classification ad:Secret ; ad:caveat "NOFORN" ;
    ad:needToKnowPrincipal ex:analyst ;
    ad:storedIn ex:store-secret ;
    ad:hasSeal ex:seal-wing .

ex:sensor-telemetry a ad:ClassifiedArtifact ;
    ad:classification ad:Confidential ; ad:caveat "REL-ID" ;
    ad:needToKnowPrincipal ex:analyst ;
    ad:storedIn ex:store-conf ;
    ad:hasSeal ex:seal-sensor .

ex:seal-wing a ad:Seal ;
    ad:sealedRoot "sha256:77772f10a9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2" .

ex:seal-sensor a ad:Seal ;
    ad:sealedRoot "sha256:88882f10a9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2" .

# P3 proposer-judge: adjudicated AI contribution proposing a caveat change.
ex:judge a ad:JudgeActivity .

ex:ai-caveat-merge a ad:AIContribution ;
    ad:proposes ex:sensor-telemetry ;
    ad:adjudicatedBy ex:judge .
