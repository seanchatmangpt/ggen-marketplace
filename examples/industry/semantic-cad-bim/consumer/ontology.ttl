# Consumer example ontology for industry-semantic-cad-bim.
# A minimal, pillar-lawful design snapshot: one project store, one artifact,
# an attested, sealed revision chain, an adjudicated AI contribution.
# Synthetic data only (example.invalid IRIs); synthetic digest.
@prefix bot:  <https://w3id.org/bot#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix cad:  <https://seanchatmangpt.github.io/packs/industry-semantic-cad-bim#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://example.invalid/cad/> .

# P1 design isolation: artifact in its per-project store.
ex:projA a cad:ProjectStore ;
    cad:journalPath "/data/smalt/journal/project_alpha/journal.log" .

ex:art1 a cad:DesignArtifact ;
    cad:artifactDigest "sha256:1111" ;
    cad:storedIn ex:projA .

# P5 seal + P2 attestation + G2 revision chain.
ex:seal0 a cad:MerkleSeal ;
    cad:receiptDigest "" .

ex:act0 a cad:AttestedActivity ; cad:attestationFingerprint "sha256:aa" .
ex:act1 a cad:AttestedActivity ; cad:attestationFingerprint "sha256:bb" .

ex:rev0 a cad:DesignRevision, cad:RootRevision ;
    cad:revisionIndex 0 ;
    cad:sealedRoot ex:seal0 ;
    prov:wasGeneratedBy ex:act0 .

ex:rev1 a cad:DesignRevision ;
    cad:revisionIndex 1 ;
    prov:wasRevisionOf ex:rev0 ;
    prov:wasGeneratedBy ex:act1 ;
    cad:revisionOfArtifact ex:art1 .

# G1 spatial structure + G3 geometry.
ex:storey1 a bot:Storey ; bot:hasElement ex:wall1 .
ex:wall1 a bot:Element ; cad:hasGeometry ex:geom1 .
ex:geom1 a cad:Geometry ; cad:geometryFormat "IFC-STEP" .

# P3 proposer-judge: adjudicated AI contribution before element mutation.
ex:judge1 a cad:JudgeActivity .
ex:ai1 a cad:AIContribution ;
    cad:mutatesElement ex:wall1 ;
    cad:adjudicatedBy ex:judge1 .
